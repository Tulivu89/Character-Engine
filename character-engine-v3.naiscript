};

// ── Default Values ────────────────────────────────────────────────────────────

// [v2.19.0 WIZARD-2.0] Starter world-canon sections, rewritten POV/genre-agnostic
// (the old set assumed a second-person text-adventure with a player-protagonist).
// Memory-target sections assemble into the static Memory block IN LIST ORDER; the two
// AN-target sections (ATTG, Style) sit last and assemble into the Author's Note
// (visually lower in context). This is the default output order — users reorder freely
// in the Memory tab. Sections past Central Conflict start disabled.
var DEFAULT_WIZARD_SECTIONS: WizardMemorySection[] = [
    { id: 'wsec_premise', label: 'Premise', enabled: true, content: '', target: 'memory',
      instructions: 'Write ONE sentence \u2014 the story\'s logline: who the central figure is, the situation they are in, and what is at stake. Specific to this story, not a theme and not a question. Do not assume a point of view or address the reader. Register to aim for: "A disgraced navigator hired to chart waters her old commander declared unmappable." "A woman who stayed in the house after the divorce because leaving would mean admitting it mattered."' },
    { id: 'wsec_setting', label: 'Setting', enabled: true, content: '', target: 'memory',
      instructions: 'State the world, place, and era the story sits in, and the scope it occupies within that world. The facts of the stage \u2014 not plot, not characters, not theme. One or two sentences.' },
    { id: 'wsec_themes', label: 'Themes', enabled: true, content: '', target: 'memory',
      instructions: 'Name the emotional register and the throughlines the story keeps returning to. Abstractions, not events. Do not restate the setting or describe specific characters.' },
    { id: 'wsec_conflict', label: 'Central Conflict', enabled: true, content: '', target: 'memory',
      instructions: 'Describe the opposing forces and what is contested between them \u2014 the shape of the pressure, not its resolution and not the individual beats.' },
    { id: 'wsec_worldrules', label: 'World Rules', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how this world works where it departs from the ordinary: the powers, technologies, or social orders in play, what they make possible, and what they cost. Rules, not instances.' },
    { id: 'wsec_intimacy', label: 'Intimacy and Consequences', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how attraction, desire, and intimacy operate in this world and what tends to follow from them \u2014 the tone and the stakes of closeness, not a specific pairing.' },
    { id: 'wsec_danger', label: 'Danger and Consequences', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how harm, violence, and danger operate in this world and what their aftermath looks like \u2014 how lethal, how lasting, how the narrative treats it. Not a specific confrontation.' },
    { id: 'wsec_stakes', label: 'Stakes', enabled: false, content: '', target: 'memory',
      instructions: 'Describe what can be won or lost at the largest scale this story reaches \u2014 the weight on the scales, not the mechanics or the plot beats.' },
    { id: 'wsec_attg', label: 'ATTG', enabled: true, content: '', target: 'an',
      instructions: 'Output ONLY a single ATTG line, enclosed in spaced brackets, in exactly this form: [ Author: <name>; Title: <title>; Tags: <comma-separated tags>; Genre: <genre> ]. Pick a well-known author whose sensibility fits this story. Output only the bracketed line \u2014 no heading, no commentary, no markdown.' },
    { id: 'wsec_style', label: 'Style', enabled: true, content: '', target: 'an',
      instructions: 'Describe the narrative voice, beginning with a two-author tonal anchor: name two authors whose combined sensibilities capture this story\'s voice, matched to emotional register and prose style rather than surface genre, the pairing set in productive tension. Then describe the resulting voice concretely: sentence rhythm, level of description, use of interiority, how the prose handles emotion. Under 100 words. No markdown.' }
];

// [v2.19.0 WIZARD-2.0] Starter topic registry. 'Initial Concept' is the general rolling
// chat that feeds context to the rest; 'World Memory' develops the canon and fans out to
// the Memory sections on commit; 'Style & Voice' develops the Author's Note voice. Entity-
// producing topics (Species, Factions, Locations, Characters, ...) follow. Instructions
// are POV/genre-agnostic and deliberately non-railroading: guide, don't dictate.
var DEFAULT_WIZARD_TOPICS: WizardTopic[] = [
    { id: 'wtopic_concept', label: 'Initial Concept', commitKind: 'concept',
      seedMessage: 'This chat shapes your story\'s foundation \u2014 the title, genre, and central premise everything else will stand on. Bring whatever you have, even a stray image or a single line, and we\'ll sharpen it together. What\'s the core idea you\'re starting from?',
      instructions: 'You are a narrative designer acting as a sounding board, helping the user develop a story\'s core concept \u2014 its title, genre, and central premise \u2014 into a cohesive foundation the rest of the world can stand on.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone; you are a creative partner, not a gatekeeper. Build on the user\'s idea with a concrete suggestion or two that push the premise forward, and follow their lead rather than steering toward any particular genre or tone. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_memory', label: 'World Memory', commitKind: 'memoryFanout',
      seedMessage: 'This chat builds the permanent facts of your world \u2014 the premise, the setting and its scope, the themes it keeps returning to, and the conflict driving everything. Once something lands here it becomes canon that holds steady for the whole story. Where should we start \u2014 the premise, or the shape of the conflict?',
      instructions: 'You are a world-builder helping the user define the static canon of their story \u2014 the permanent memory block. Its sections may include the premise (a one-sentence logline of the central figure, their situation, and what is at stake), the setting and its scope, the core themes, the central conflict, and optional world rules, intimacy, danger, and stakes. The story may be any genre and any point of view; do not assume a player-protagonist or a second-person frame.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Favour durable facts, throughlines, and world rules over plot events or character arcs. If an idea is vague, offer a couple of concrete directions to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_style', label: 'Style & Voice', commitKind: 'memoryFanout',
      seedMessage: 'This chat sets the narrative voice for your Author\'s Note \u2014 tense, perspective, tone, pacing, prose density, and the authors whose sensibilities you\'re reaching for. Describe the reading experience you\'re after, even loosely, and we\'ll pin it down. What\'s the voice you\'re hearing?',
      instructions: 'You are a prose stylist helping the user define the narrative voice for the Author\'s Note \u2014 tense, perspective, tone, pacing, and density.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Talk about writing mechanics rather than story content. A strong anchor is naming one or two authors whose combined sensibilities capture the voice \u2014 matched to emotional register and prose style, not surface genre \u2014 then describing the concrete result: sentence rhythm, description density, interiority, how the prose handles emotion. If the user\'s description is broad (e.g. "dark"), offer a few specific techniques or authorial blends to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_species', label: 'Species', commitKind: 'speciesBatch',
      seedMessage: 'This chat designs the species, peoples, or creature-types living in your world \u2014 what makes each one fundamentally distinct, not just differently dressed. Tell me about one you already picture, however roughly. What\'s the first one?',
      instructions: 'You are helping the user design distinct species, peoples, or creature-types, each of which becomes a structured lorebook entry.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Look for what makes a species fundamentally distinct: anatomy, inherent cultural drives, and its role in the world. If an idea leans on a familiar trope, offer a stranger or more grounded angle to react to rather than just flagging it. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_factions', label: 'Factions', commitKind: 'factionsBatch',
      seedMessage: 'This chat builds the factions, organizations, and power structures shaping your world \u2014 what each one claims to want, and what\'s actually driving it underneath. Tell me about a group with real stake in how things turn out. Who\'s the first one?',
      instructions: 'You are helping the user design factions, organizations, and power structures, each of which becomes a structured lorebook entry.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Dig into the gap between a faction\'s stated goals and its private realities, methods, and tensions. If a group reads as flatly good or evil, help find its legitimate claims and real flaws with a specific angle to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_locations', label: 'Locations', commitKind: 'locationsBatch',
      seedMessage: 'This chat maps the places in your world, from sweeping regions down to single rooms, pairing what a person senses on arrival with the deeper history behind it. Tell me about one place, at whatever scale feels right. Where should we begin?',
      instructions: 'You are helping the user map their setting: specific locations, their scale (region, settlement, or a single room), the immediate scene-present view, and the deeper background lore for the lorebook.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. For each place, draw out two layers: (A) the immediate description \u2014 one or two sentences of what is physically sensed on arrival, at whatever scale the place is \u2014 and (B) the hidden history, culture, or systems reserved for the lorebook entry. Keep the two from duplicating each other. Usually ask one focused question at a time, drilling into scale, atmosphere, or connections.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_characters', label: 'Characters', commitKind: 'charactersBatch',
      seedMessage: 'This chat builds a character\'s static identity \u2014 who they are at a glance, their physical presence, and what shaped them. We\'ll work through one detail at a time rather than all at once. Who\'s the character, and what\'s the first thing you see when you picture them?',
      instructions: 'You are workshopping a character with the user \u2014 their static baseline: name, age, gender, species, role, a tight one-sentence summary, a physical scene-present description, core contradictions, voice and mannerisms, and formative background.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Work one detail at a time rather than asking for every field at once. If something feels flat, offer a concrete, sensory, or grounded alternative to react to. Keep to static identity \u2014 momentary feelings, immediate goals, and shifting relationships belong in other chats. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_drama', label: 'Drama & Tension', commitKind: 'dramaSeed',
      seedMessage: 'This chat seeds the tensions your story runs on \u2014 the debts, secrets, and wants tying your established characters together. We\'re sharpening dynamics between who and what already exists, not inventing new people. What\'s a relationship or thread you want to charge with stakes?',
      instructions: 'You are a dramaturg helping the user seed the dramatic engine: the tensions characters carry, the charged dynamics between them, and the threads that drive the story.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Work with the established cast rather than introducing new named people, and tie each tension to a specific person, debt, secret, or want with concrete stakes. If a conflict feels symmetric or toothless, suggest a specific asymmetry, hidden motive, or forcing stake to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_intro', label: 'Intro / Opening', commitKind: 'introScene',
      seedMessage: 'This chat designs your opening scene \u2014 the moment the story begins and control takes hold. Tell me the situation it opens on: where things are, and what\'s already in motion.',
      instructions: 'You are a writing partner helping the user workshop the OPENING scene \u2014 the moment the story begins and interaction takes hold. Take the intro they bring on its own terms, whatever pacing or structure they picture.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Help sharpen the sensory grounding of the first moment and find where the first action or choice takes hold \u2014 whether the scene opens mid-action or eases in, both are legitimate. Usually ask one focused question at a time, developing atmosphere, the immediate situation, or where agency begins.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    // [v2.19.0 WIZARD-2.0 DEAD-PENDING] The 'Bestiary' and 'Items' topics below are residue
    // from the removed Bestiary / Item-Template systems (CE-STRIP v2.1.6 / v2.2.0); their
    // commitKinds (archetypeBatch / itemBatch) no longer have generators. Left in place
    // (harmless) and flagged for a dedicated Bestiary-residue removal pass \u2014 NOT part of
    // the wizard-2.0 cleanup, and deliberately not de-railroaded since they are slated to go.
    { id: 'wtopic_bestiary', label: 'Bestiary', commitKind: 'archetypeBatch',
      seedMessage: 'This chat stocks your bestiary of drop-in minor NPCs \u2014 the quick, disposable folk and creatures you spawn into a scene: someone to fight, someone to bribe, someone to haggle with. Each one gets a NAME and a one-line BRIEF for why they\'re here, and either can vary at spawn with {a|b|c} alternation, like "{Brittle|Rattling|Ancient} Skeleton." What\'s the first one?',
      instructions: 'You are a creature-and-cast designer helping the user stock a bestiary of MINOR, drop-in NPCs \u2014 the lightweight, disposable figures spawned into a scene (mobs to fight, folk to bargain with, ambient background people), NOT deep named characters. You author exactly two things for each archetype: the name and the brief.\n\nFORMAT:\n1. Write in pure prose. No markdown, bolding, italics, headers, or lists.\n2. Keep a warm, collaborative tone.\n3. For each archetype, help pin down two things: a short NAME or label (offer spawn-time variety with {a|b|c} alternation where it fits) and a one-line BRIEF of what they are doing here.\n4. Keep them shallow by design: a name and a one-line reason to be present, nothing more. If the user starts developing one with real depth, gently suggest promoting it to a full character instead.\n5. Ask exactly ONE focused question per turn to sharpen a specific archetype.\n\nTypically respond in 2-5 sentences; when summarizing or drawing together several already-established points for the user, a short paragraph is fine.' },
    { id: 'wtopic_items', label: 'Items', commitKind: 'itemBatch',
      seedMessage: 'This chat stocks your set of item templates \u2014 the things a player finds, carries, wields, or wears. Each one gets a NAME and a one-line DESCRIPTION, and either can vary at spawn with {a|b|c} alternation, like a "{rusty|gleaming} {iron|steel} dagger." What\'s the first one?',
      instructions: 'You are an item designer helping the user stock a set of ITEM TEMPLATES: the objects a player finds, carries, wields, or wears \u2014 weapons, garments, tools, trinkets, consumables. You author exactly two things for each item: the name and the description.\n\nFORMAT:\n1. Write in pure prose. No markdown, bolding, italics, headers, or lists.\n2. Keep a warm, collaborative tone.\n3. For each item, pin down two things: a short NAME (offer spawn-time variety with {a|b|c} alternation where colour, material, or condition could differ, e.g. a {rusty|gleaming|chipped} {iron|steel} dagger) and a one-sentence DESCRIPTION of what it is and its notable qualities.\n4. Keep them concrete and evocative but shallow: one name, one sentence, nothing more.\n5. Ask exactly ONE focused question per turn to sharpen a specific item.\n\nTypically respond in 2-5 sentences; when summarizing or drawing together several already-established points for the user, a short paragraph is fine.' }
];

// ── World-Build Wizard: chat storage + CRUD (storyStorage) ───────────────────
async function loadWizardChats(): Promise<WizardChat[]> {
    let raw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_CHATS, '[]') as string;
    try {
        let arr = JSON.parse(raw);
        if (Array.isArray(arr)) { for (let mc of arr) { if (!mc.characterIds) mc.characterIds = []; } return arr; }
        return [];
    } catch (e) {
        api.v1.error('[AE:wizard] loadWizardChats parse error:', e);
        return [];
    }
}

async function saveWizardChats(chats: WizardChat[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_WIZ_CHATS, JSON.stringify(chats || []));
}

async function loadWizardChat(id: string): Promise<WizardChat | null> {
    let chats = await loadWizardChats();
    return chats.find(function(c) { return c.id === id; }) || null;
}

async function saveWizardChat(chat: WizardChat): Promise<void> {
    if (!chat || !chat.id) return;
    let chats = await loadWizardChats();
    let idx = chats.findIndex(function(c) { return c.id === chat.id; });
    chat.updatedAt = Date.now();
    if (idx >= 0) chats[idx] = chat;
    else chats.push(chat);
    await saveWizardChats(chats);
}

async function createWizardChat(topicId: string, title: string): Promise<WizardChat> {
    // [vNEXT] Seed the topic's opening message (if any) so a new chat greets the user
    // and explains what this topic produces.
    let seedMsgs: WizardChatMessage[] = [];
    try {
        let seedCfg = await loadConfig();
        let seedTopic = getWizardTopic(seedCfg, topicId);
        if (seedTopic && (seedTopic as any).seedMessage && String((seedTopic as any).seedMessage).trim()) {
            seedMsgs.push({ role: 'assistant', content: String((seedTopic as any).seedMessage).trim() });
        }
    } catch (eSeed) { /* non-fatal: start empty */ }
    let chat: WizardChat = {
        id: 'wchat_' + generateId(),
        topicId: topicId,
        title: title || 'New Chat',
        messages: seedMsgs,
        contextChatIds: [],
        includeStory: false,
        lorebookEntryIds: [],
        characterIds: [],
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
    await saveWizardChat(chat);
    return chat;
}

async function deleteWizardChat(id: string): Promise<void> {
    let chats = await loadWizardChats();
    chats = chats.filter(function(c) { return c.id !== id; });
    await saveWizardChats(chats);
}

// ── World-Build Wizard: staging store (storyStorage) ─────────────────────────
// [v1.22.0 STAGING] Generalizes the generate -> review -> commit pattern that
// previously existed only for the intro draft (generateIntroDraft/commitIntroDraft).
// Batch generators now stage parsed output as WizardDraft records; nothing touches
// cfg.* or the lorebook until commitStagedDrafts() runs. This means a bad generation
// (CJK drift, dot-point mush, half-parsed entries) can be discarded without leaving
// orphan records and orphan lorebook entries behind.
//
// kind is one of: 'species' | 'faction' | 'archetype' | 'item' | 'location'
// fields is a flat string map so one store and one editor serve every kind; the
// per-kind shape lives in WIZ_DRAFT_FIELDS below and commit routes on kind.
interface WizardDraft {
    id: string;
    kind: string;
    fields: { [k: string]: string };
    sourceChatIds: string[];
    parentId: string | null;   // locations only; null for every other kind
    createdAt: number;
}

// [v1.22.2] WizardTombstone REMOVED — see the note above discardWizardDraft.

// [v1.22.0 STAGING] Per-kind field schema. Drives the staging editor's inputs and the
// commit routing. `multiline` selects textInput vs multilineTextInput in the native UI.
var WIZ_DRAFT_FIELDS: { [kind: string]: { key: string; label: string; multiline: boolean }[] } = {
    species:   [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Lore', multiline: true }],
    faction:   [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Lore', multiline: true }],
    archetype: [{ key: 'name', label: 'Name', multiline: false }, { key: 'brief', label: 'Brief', multiline: true }],
    item:      [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Description', multiline: true }],
    location:  [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'On arrival', multiline: true }, { key: 'lore', label: 'Lorebook', multiline: true }],
    // [v1.22.2 CHAR-STAGE] Characters previously went chat -> names -> dump -> fields ->
    // saveCharacter in one unbroken run, so a failed dump/fields call silently produced a
    // character with nothing but a name. Staging the name + concept dump gives the user a
    // visible, editable checkpoint; the structured fields are derived at commit time from
    // whatever dump is on screen then.
    character: [{ key: 'name', label: 'Name', multiline: false }, { key: 'dump', label: 'Concept', multiline: true }]
};

// Human-readable plural per kind, for toasts and headers.
function wizKindLabel(kind: string): string {
    if (kind === 'species')   return 'species';
    if (kind === 'faction')   return 'factions';
    if (kind === 'archetype') return 'archetypes';
    if (kind === 'item')      return 'items';
    if (kind === 'location')  return 'locations';
    if (kind === 'character') return 'characters';
    return kind;
}


async function loadWizardDrafts(): Promise<WizardDraft[]> {
    let raw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_DRAFTS, '[]') as string;
    try {
        let arr = JSON.parse(raw);
        if (Array.isArray(arr)) return arr;
        return [];
    } catch (eWdLoad) {
        api.v1.error('[AE:wizard] loadWizardDrafts parse error:', eWdLoad);
        return [];
    }
}

async function saveWizardDrafts(drafts: WizardDraft[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_WIZ_DRAFTS, JSON.stringify(drafts || []));
}

async function loadWizardDraftsOfKind(kind: string): Promise<WizardDraft[]> {
    let all = await loadWizardDrafts();
    return all.filter(function(d) { return d.kind === kind; });
}

// Appends parsed generator output as drafts. Returns the ids created, so a caller that
// generated-and-wants-to-commit-immediately (the legacy run*Batch wrappers) can commit
// exactly its own drafts without sweeping up anything the user already had staged.
async function addWizardDrafts(kind: string, items: { [k: string]: string }[], sourceChatIds: string[], parentId: string | null): Promise<string[]> {
    let all = await loadWizardDrafts();
    let newIds: string[] = [];
    for (let it of (items || [])) {
        let did = 'wdraft_' + generateId();
        newIds.push(did);
        all.push({
            id: did,
            kind: kind,
            fields: it,
            sourceChatIds: (sourceChatIds || []).slice(),
            parentId: parentId || null,
            createdAt: Date.now()
        });
    }
    await saveWizardDrafts(all);
    return newIds;
}

async function updateWizardDraftField(draftId: string, fieldKey: string, value: string): Promise<void> {
    let all = await loadWizardDrafts();
    let target = all.find(function(d) { return d.id === draftId; });
    if (!target) return;
    target.fields[fieldKey] = value;
    await saveWizardDrafts(all);
}

// [v1.22.2] Tombstones REMOVED. v1.22.0 recorded discarded draft names and fed them into
// each generator's "these ALREADY EXIST — do NOT recreate" list. That was wrong: a
// rejected draft is not an existing entity. If the user staged "Hogwarts", discarded it
// because the lore was bad, and regenerated, the prompt then explicitly forbade the one
// name the brainstorming chat was about — so the model invented unrelated originals
// instead. Discarding now simply deletes the draft. Only staged (still-pending) names
// feed the do-not-recreate list, which is all that was ever needed: it stops a second
// Generate press from duplicating the batch already sitting on screen.

// Discard one staged draft.
async function discardWizardDraft(draftId: string): Promise<void> {
    let all = await loadWizardDrafts();
    await saveWizardDrafts(all.filter(function(d) { return d.id !== draftId; }));
}

// Discard every staged draft of a kind.
async function discardAllWizardDrafts(kind: string): Promise<number> {
    let all = await loadWizardDrafts();
    let doomed = all.filter(function(d) { return d.kind === kind; });
    await saveWizardDrafts(all.filter(function(d) { return d.kind !== kind; }));
    return doomed.length;
}

// Remove drafts by id (used after a successful commit).
async function removeWizardDrafts(draftIds: string[]): Promise<void> {
    if (!draftIds || !draftIds.length) return;
    let all = await loadWizardDrafts();
    await saveWizardDrafts(all.filter(function(d) { return draftIds.indexOf(d.id) < 0; }));
}

// [vNEXT] Resolve a topic by id from the config registry (falls back to the seeded
// defaults if config has none yet).
function getWizardTopic(cfg: GlobalConfig, topicId: string): WizardTopic | null {
    let list = ((cfg as any).wizardTopics && (cfg as any).wizardTopics.length)
        ? (cfg as any).wizardTopics
        : DEFAULT_WIZARD_TOPICS;
    return list.find(function(t: WizardTopic) { return t.id === topicId; }) || null;
}

var DEFAULT_REL_ARCHETYPES: RelationshipArchetypeDef[] = [
    { id: 'arch_rivals',    name: 'Rivals',           stages: ['Hostile', 'Antagonistic', 'Competitive', 'Grudging Respect', 'Friendly'] },
    { id: 'arch_friends',   name: 'Friends',          stages: ['Acquaintances', 'Distant', 'Close', 'Inseparable'] },
    { id: 'arch_dating',    name: 'Dating',           stages: ['On the Rocks', 'Tentative', 'Steady', 'Committed', 'Devoted'] },
    { id: 'arch_slowburn',  name: 'Slow Burn',        stages: ['Strangers', 'Curious', 'Drawn In', 'Smitten'] },
    { id: 'arch_e2l',       name: 'Enemies to Lovers', stages: ['Enemies', 'Reluctant Allies', 'Uneasy Trust', 'Falling', 'Lovers'] },
    { id: 'arch_familial',  name: 'Strained Familial', stages: ['Estranged', 'Tense', 'Reconciling', 'Bonded'] },
    { id: 'arch_custom',    name: 'Custom',           stages: [] }
];

// [v2.7.0 CONDITIONS] Default condition set. Each stage string IS the "ConditionState"
// half of the narrative line (mild -> severe). Kept short/declarative to match the
// dossier's prose register. Author can blank a def's stages to make it pure on/off.
var DEFAULT_CONDITIONS: ConditionDef[] = [
    { id: 'cond_intoxicated', name: 'Intoxicated', stages: [
        'A little looser than usual, laughing too easily.',
        'Stumbling, loud, uninhibited.',
        'Barely coherent, movements sloppy.'
    ] },
    { id: 'cond_sick', name: 'Sick', stages: [
        'A little run down, sniffling.',
        'Flushed and aching, moving slower than usual.',
        'Too weak to be up and about.'
    ] },
    { id: 'cond_pregnant', name: 'Pregnant', stages: [
        'Not yet showing, few visible signs.',
        'Visibly pregnant, moving more carefully.',
        'Heavily pregnant, near term.'
    ] }
];

var DEFAULT_GENERAL_STYLE = 'Use punchy, direct, and efficient narrative language. Focus on actionable character details. Omit flowery adjectives. Write as a concise psychological dossier.';

// [v2.9.0 LOREFOLD] The pre-LOREFOLD fat npc template (relationship + goal + conditions
// packed into the AN). loadConfig() migrates any saved config still carrying this exact
// string to the new thoughts-only default, so those fields aren't double-injected once
// they also fold into the lorebook. Custom (hand-authored) npc strings are left alone.
var OLD_NPC_TEMPLATE_V28 = "[|name|][ — |relArchetype|, |relStage|][ with |primaryRelationship.targetName|][ (|conditionStates|)][. Goal: |midRange.currentDesire|][. Thinking: |ephemeral.compressedLine|]";

var OLD_NPC_TEMPLATE_V82 = "[|name|][. Thinking: |ephemeral.compressedLine|]";
// [v2.87.0 NPC-TPL-2LINE] v2.83.0's template joined the two clauses with ' \u2014 ', which
// renders ONE line: "Sera \u2014 thinking: X. \u2014 wants to Y." That is the exact failure the
// split was meant to fix \u2014 the intent ends up wearing the same punctuation as the
// reaction and reads as more interior monologue. parseMacroTemplate converts a literal
// backslash-n inside a bracket block into a real newline (see its final replace), so the
// second clause opens with one and re-states the name: with several characters present
// the Author's Note is a flat list where every line must self-attribute, or line 2 of
// character A reads as belonging to character B.
var OLD_NPC_TEMPLATE_V86 = "[|name|][ \u2014 thinking: |reactionLine|][ \u2014 |intentLine|]";
// [v2.88.0 NPC-TPL-1LINE] v2.87.0 put the intent on its own line, which is correct for
// legibility but multiplies badly: with 2-3 present characters the Author's Note becomes
// 4-6 stacked one-clause lines, and that block structure competes with the prose format
// the model is meant to be writing. One line per character keeps the AN a compact list.
// The separation that actually mattered is sentence-level, not line-level — see
// _ceFrameIntent.
var OLD_NPC_TEMPLATE_V87 = "[|name|][ — thinking: |reactionLine|][\\n|name| |intentLine|]";

// [v2.83.0 EPHEMERAL-REWIRE] Two independently-suppressing clauses instead of one
// 'Thinking:'-labeled blob. reactionLine is the interior first-person read; intentLine
// is the SAME model-authored desire, framed by the pursuit pressure tier
// (_ceFrameIntent) into an unlabeled declarative -- deliberately NOT called "Thinking"
// a second time, since the whole point is that this line should read as stated
// near-future fact to a narrative-trained model, not as more interior decoration
// sitting next to the first clause. eventAnchor is intentionally NOT referenced here --
// see generateEphemeral's comment: it is generation-time scaffolding only, and its
// value at injection time was near zero since the story text directly above already
// shows the beat it names.
var DEFAULT_TEMPLATES: ContextTemplates = {
    npc: "[|name|][ — thinking: |reactionLine|][ |intentLine|]",
    criticalHook: "[|name|: |hookDescription|]",
    npcWeb: "[|nameA| & |nameB| — |dynamic|]",
    // [v2.92.0 POSITION] One character's private reading of another, emitted only when
    // both are scene-present. |positionPressure| is the tier-graded clause from
    // _ceFramePosition and is EMPTY at tiers -1..1, so a Position with nothing moving
    // renders as just shape + standing and the bracket self-suppresses.
    position: "[|name| on |targetName| — |shape|.][ |standing|][ |positionPressure|]"
};

// [v2.7.0 CONDITIONS] The bracket around |stageText| self-suppresses when a condition
// has no stages (pure on/off) — renders just "X is currently Y." with no second
// sentence. The |name|/|conditionName| bracket is its own block so the whole line
// self-suppresses if either is somehow empty, rather than emitting a broken fragment.
var DEFAULT_LOREBOOK_TEMPLATES: LorebookTemplates = {
    condition:     "[|name| is currently |conditionName|.][ |stageText|]",
    equipment:     "[|name| is wearing/carrying |equipList|.]",
    // [v2.90.0 MIDRANGE-RETIRE] goal / socialMask / shiftedView removed with the layer
    // that fed them. [v2.92.0 POSITION] relationship / relTrajectory / relStatus removed
    // with theirs. All six macro families (|midRange.*|, |primaryRelationship.*|,
    // |relArchetype|, |relStage|) now resolve to nothing, so a saved custom template
    // still naming them self-suppresses via parseMacroTemplate's empty-bracket rule
    // rather than rendering a broken line. Position's own template is an AN template
    // (DEFAULT_TEMPLATES.position), not one of these.
    journal:       "[|name|'s own notes: |journalBody|]"
};

// [v2.9.0 LOREFOLD] Default include state: everything on. Uncheck individual fields
// in World Settings when a line starts to feel excessive.
var DEFAULT_LOREBOOK_FIELDS: LorebookFieldToggles = {
    equipment: true, conditions: true, journal: true
};

// [v2.92.0 POSITION] LOREBOOK_TEMPLATE_MIGRATIONS_V214 DELETED along with its consumer
// loop in loadConfig. Both of its entries (relationship, relStatus) named templates that
// no longer exist, so the map could only ever have rewritten a key nothing reads. Note
// this is a MIGRATION being retired, which is normally the dangerous kind of deletion —
// safe here precisely because the destination key is gone too: there is no save state in
// which running it would have produced a different outcome from skipping it.

// [CE-STRIP v2.6.0 CTX-CUT] OLD_DEFAULT_TEMPLATES_V0982 and its migrateConfig()
// upgrade loop deleted — both only ever served the now-removed location/
// trackedNarrative/player keys. Zero remaining callers, verified before removal.

var DEFAULT_CTX  = 4;   // default context size (story paragraphs) for image prompt architect

var DEFAULT_ARCH = "You are an expert cinematic director translating a narrative scene into a precise image generation prompt for a hybrid text-to-image AI.\n\nAnalyze the provided scene and character data, then output a prompt following this exact structure:\n\n1. CORE TAGS: Start with 10-15 comma-separated Danbooru tags establishing the baseline. Include subject counts (e.g., 1girl, 1boy), rating (e.g., rating: general), camera angles (e.g., dutch angle, from below), lighting (e.g., cinematic lighting, sunbeams), and environment traits.\n2. ACTION & ATMOSPHERE: Follow immediately with 1 to 2 vivid sentences of natural language describing exactly what the characters are doing, their expressions, the mood, and the background details.\n3. CHARACTER INTEGRATION: You MUST seamlessly integrate the specific visual traits of any identified characters into the tags or the prose.\n\nOutput ONLY the final prompt text. Do not include headers, bullet points, introductory text, or commentary.";

var DEFAULT_NOTE = "[System Note: This chat interface supports image attachments. When your character wants to send a selfie, share a picture of their surroundings, or show the user an object, append an image attachment to your message on a new line using this exact format: > [Image: comma-separated visual tags]\nThe tags must be concise visual descriptors (character name, clothing, pose, expression, setting, and lighting). Always include the character's name so their specific appearance is applied.\nExample message:\nI finally made it to the cafe! It's so cute here, wish you were with me.\n[Image: Sarah, smiling, holding a coffee cup, sitting at a cafe table, wearing a cozy oversized sweater, sunlit window background] ]";

// ── Static Field Definitions ──────────────────────────────────────────────────
// The four core character narrative fields. Used by the character editor and
// field generation pipeline. Unchanged from AE.

var STATIC_FIELD_DEFS = [
    {
        id: 'physicalDescription', key: 'physicalDescription',
        label: 'Physical Description', injectionHeader: 'Appearance',
        placeholder: 'Physical anatomy, skin, hair, eyes, and build...',
        defaultInstructions: 'Describe the physical body exactly as a camera would capture it, moving from their overall silhouette to specific details. Explicitly state their body type, physique, curves or musculature, skin tone, hair, and eye color. Lean into sensual, striking, or inhuman/monstrous anatomical details if applicable. Capture their physical essence organically; do not just list traits. DO NOT describe clothing, outfits, or armor. DO NOT describe mannerisms or movement. Avoid cliché features like facial scars unless explicitly present in the context.',
        defaultBudget: 100
    },
    {
        id: 'personalityCore', key: 'personalityCore',
        label: 'Personality Core', injectionHeader: 'Personality',
        placeholder: 'Fundamental nature and contradictions...',
        defaultInstructions: 'Define their fundamental psychological baseline and static disposition. Follow this with a core contradiction or hidden facet that gives them dimensional depth (e.g., outwardly cynical but secretly romantic, or pragmatic but fiercely loyal). Do not force a tragic backstory or trauma. Focus on *how* their mind works and their default state of being, not their fleeting goals or current mood. Be tight and declarative.',
        defaultBudget: 100
    },
    {
        id: 'voiceAndMannerisms', key: 'voiceAndMannerisms',
        label: 'Voice & Mannerisms', injectionHeader: 'Voice',
        placeholder: 'Vocal timbre and physical habits...',
        defaultInstructions: 'Describe the physical and auditory qualities of how they communicate. Name their vocal timbre, speech rhythm, and any distinct accent. Follow with one or two signature physical mannerisms or unconscious gestures that reveal their nature (e.g., how they hold their gaze, a sensual habit, or an inhuman tic). Describe the pattern and presence of their communication, not specific vocabulary.',
        defaultBudget: 75
    },
    {
        id: 'background', key: 'background',
        label: 'Background', injectionHeader: 'Background',
        placeholder: 'Formative history...',
        defaultInstructions: 'State one or two formative past events that firmly established who they are today. Focus on what shaped their current worldview or brought them to their current station. Keep it in the past tense with no flourish. Omit broad life summaries in favor of specific, defining turning points.',
        defaultBudget: 100
    }
];

// ============================================================================
// SECTION 3 — SUBSYSTEM BLOCK (see 3a–3i below)
// [v2.107.1 RESECTION] This marker used to claim it held "all mutable
// module-level state". That was true of ~44 lines out of 5,134. The rest is
// three whole subsystems (CharChat, Live Wizard Chat, Yoink) plus logging and
// diagnostics, which were invisible to `grep '^// SECTION'` and therefore
// invisible to the CE-INDEX section map. No code moved in that patch — only
// markers were added — so line order is unchanged from v2.107.0.
//   3a  LOGGING & DIAGNOSTIC CHANNELS
//   3b  DIAGNOSTIC FLAGS & SLASH COMMANDS
//   3c  GENERATION BUDGET CONSTANTS & ENGINE LOCKS
//   3d  WIZARD MODE (classic)
//   3e  LIVE WIZARD CHAT (WIZLIVE)
//   3f  CHARACTER CHAT (CHARCHAT)   <- largest single block in the file
//   3g  BUDGET & GENERATION DIAGNOSTICS
//   3h  GENERATION EXECUTION (direct wrapper + yoink pipeline)
//   3i  SCRIPT-LEVEL STATE VARIABLES (the actual ones)
// ============================================================================

// ============================================================================
// SECTION 3a — LOGGING & DIAGNOSTIC CHANNELS
// aeLog and its per-channel enable map, persisted to api.v1.storage.
// ============================================================================

// ── [DIAG v2.65.0 LOG-CHANNELS] Channelled console logger ───────────────────
// Replaces the previously undifferentiated aeLog() flood (252 call sites,
// every one of them always-on) with a channel-gated wrapper. The channel is
// auto-derived at call time from the '[AE:xxx]' or '[AE:xxx:yyy]' tag already
// present at the front of nearly every existing log message, so call SITES did
// not need their message text rewritten — only the function name changed,
// api.v1.log() to aeLog(). A ':'-delimited tag prefix-matches its base channel
// (enabling 'charchat' also enables 'charchat:resp', 'charchat:tail', etc.) so
// one toggle covers a whole subsystem's diagnostics without listing each tag.
// A message with NO recognizable [AE:xxx] tag always passes through (rare —
// mostly the /budgetlog and /gendiag dump commands, which are already
// user-invoked and low frequency, not per-turn spam).
//
// api.v1.error() calls are UNCHANGED and always visible — errors are already
// the sparse, high-signal half of this file's logging (168 sites vs. 252 for
// api.v1.log), and gating them behind a channel that could default OFF risks
// silencing a real failure. Only the noisy log() flood needed a mute switch.
//
// Persisted via api.v1.storage (global scope, not story-scoped — these are
// developer diagnostics, not story state, same scoping choice AE_DIAG_STORAGE_KEY
// below makes). Control at runtime from any wizard chat: /log <channel> on|off,
// /log all, /log none, /log list — see runWizardChatTurn's diag-command block.
var AE_LOG_STORAGE_KEY = 'ae_log_channels_v1';
// Channels ON by default — everything else is silent until explicitly enabled.
// 'charchat' stays on by default because it is the live investigation; narrow
// this once the empty-reply bug is found and closed.
var AE_LOG_DEFAULT_ON = ['charchat'];
var _aeLogEnabled: {[k: string]: boolean} = {};
for (let _aeLogDfltCh of AE_LOG_DEFAULT_ON) { _aeLogEnabled[_aeLogDfltCh] = true; }

// Fires immediately (not gated behind onScriptsLoaded) so persisted channel
// choices apply as early as possible; the tiny window before this resolves
// falls back to AE_LOG_DEFAULT_ON above, which is itself a safe, quiet default.
(async function _aeLogInit() {
    try {
        let _aeLogRaw = await api.v1.storage.getOrDefault(AE_LOG_STORAGE_KEY, '');
        if (_aeLogRaw) {
            let _aeLogParsed = JSON.parse(_aeLogRaw);
            if (_aeLogParsed && typeof _aeLogParsed === 'object') _aeLogEnabled = _aeLogParsed;
        }
    } catch (_eAeLogInit) { /* keep the coded defaults */ }
})();

function _aeLogChannelOf(first: any): string {
    if (typeof first !== 'string') return '';
    let _aeLogM = first.match(/^\[AE:([a-zA-Z0-9_-]+(?::[a-zA-Z0-9_-]+)*)\]/);
    return _aeLogM ? _aeLogM[1] : '';
}
function _aeLogChannelOn(channel: string): boolean {
    if (!channel) return true; // untagged lines always pass through — see header comment
    if (_aeLogEnabled['*']) return true; // escape hatch: /log all
    if (_aeLogEnabled[channel]) return true;
    let _aeLogBase = channel.split(':')[0];
    return !!_aeLogEnabled[_aeLogBase];
}
// Drop-in replacement for api.v1.log(...) — same variadic signature, channel-gated.
function aeLog(...args: any[]): void {
    try {
        if (!_aeLogChannelOn(_aeLogChannelOf(args[0]))) return;
        (api.v1.log as any).apply(null, args);
    } catch (_eAeLog) { /* logging must never break the caller */ }
}
async function aeLogSetChannel(channel: string, on: boolean): Promise<void> {
    _aeLogEnabled[channel] = on;
    try { await api.v1.storage.set(AE_LOG_STORAGE_KEY, JSON.stringify(_aeLogEnabled)); } catch (_eAeLogSet) {}
}
function aeLogList(): string {
    let _aeLogOn = Object.keys(_aeLogEnabled).filter(function(k) { return _aeLogEnabled[k]; });
    let _aeLogOff = Object.keys(_aeLogEnabled).filter(function(k) { return !_aeLogEnabled[k]; });
    return 'Log channels ON: ' + (_aeLogOn.length ? _aeLogOn.join(', ') : '(none)')
        + '\nKnown but OFF: ' + (_aeLogOff.length ? _aeLogOff.join(', ') : '(none)')
        + '\nAny [AE:xxx] tag never listed here is OFF by default. Prefix match applies '
        + '(e.g. "charchat" also covers "charchat:resp"). Commands: /log <channel> on|off, '
        + '/log all, /log none, /log list.';
}
// ── [DIAG LOG-CHANNELS] end ──────────────────────────────────────────────────

// ============================================================================
// SECTION 3b — DIAGNOSTIC FLAGS & SLASH COMMANDS
// CE_DIAG flag set plus the /diag and /log command handler.
// ============================================================================

// ── [DIAG v2.65.0 CE-DIAG-FLAGS] CharChat runtime kill-switches ─────────────
// Isolation switches for the CE-HANDOFF empty-reply/double-Send investigation
// (session 3). Every flag defaults to false = current, unmodified v2.64.0
// behaviour; flipping one at a time lets a failing turn be re-tested with a
// single suspect mechanism removed, without a ship cycle per hypothesis.
// Persisted via api.v1.storage (global, not story-scoped — dev switches, not
// story state). Control at runtime from any wizard chat: /diag <flag> on|off,
// /diag list — see runWizardChatTurn's diag-command block.
var AE_DIAG_STORAGE_KEY = 'ae_diag_flags_v1';
interface CEDiagFlags {
    ccRawContext: boolean;      // skip runCharChatContextOverride entirely — NAI gets the
                                 // raw story context for a chat turn. DIAGNOSTIC ONLY: this
                                 // WILL leak story scaffolding/system prompt into the chat.
    ccSkipWidgets: boolean;     // skip refreshCharChatImageWidgets' clear/rebuild pass
                                 // (called from inside refreshCharChatDecorations)
    ccSkipDecorations: boolean; // skip refreshCharChatDecorations entirely in onGenerationEnd
                                 // (this also skips widgets, since that call nests inside it —
                                 // use ccSkipWidgets instead to isolate just the widget pass)
    ccNoSeenDefer: boolean;     // onResponse: do not request re-delivery via seenData:false on
                                 // non-final chunks — accept cross-chunk misses, clean on final only
    ccNoPrime: boolean;         // disable v2.64.0's CHARCHAT-SLOT-PRIME call (Fresh Thoughts OFF path)
    ccNoThought: boolean;       // disable the post-reply ephemeral thought call (Fresh Thoughts ON path)
    ccNoImages: boolean;        // skip _charchatProcessImages() entirely for the turn
    ccNoPrefill: boolean;       // [v2.69.0 CHARCHAT-USERTOKEN] disable the dangling speaker cue at the
                                 // end of context. Set true to restore pre-v2.69.0 behaviour (context
                                 // ends on a closed '[ ... ]' block) and reproduce the empty-reply bug.
    wlNoPrefill: boolean;       // [v2.70.0 WIZLIVE-USERTOKEN] same fix, same flag pattern, for Live
                                 // Wizard Chat's onBeforeContextBuild branch.
}
var CE_DIAG: CEDiagFlags = {
    ccRawContext: false, ccSkipWidgets: false, ccSkipDecorations: false,
    ccNoSeenDefer: false, ccNoPrime: false, ccNoThought: false, ccNoImages: false,
    ccNoPrefill: false, wlNoPrefill: false
};
(async function _aeDiagInit() {
    try {
        let _aeDiagRaw = await api.v1.storage.getOrDefault(AE_DIAG_STORAGE_KEY, '');
        if (_aeDiagRaw) {
            let _aeDiagParsed = JSON.parse(_aeDiagRaw);
            if (_aeDiagParsed && typeof _aeDiagParsed === 'object') Object.assign(CE_DIAG, _aeDiagParsed);
        }
    } catch (_eAeDiagInit) { /* keep all-off defaults — unmodified behaviour */ }
})();
async function aeDiagSet(flag: string, on: boolean): Promise<string> {
    if (!(flag in CE_DIAG)) return 'Unknown diag flag: ' + flag + '. ' + aeDiagList();
    (CE_DIAG as any)[flag] = on;
    try { await api.v1.storage.set(AE_DIAG_STORAGE_KEY, JSON.stringify(CE_DIAG)); } catch (_eAeDiagSet) {}
    aeLog('[AE:diag] ' + flag + ' = ' + on);
    return flag + ' set to ' + on + '. ' + (on ? 'NON-DEFAULT behaviour is now active for this flag.' : 'Back to default behaviour for this flag.');
}
function aeDiagList(): string {
    return 'Diag flags (all default false/unmodified): '
        + Object.keys(CE_DIAG).map(function(k) { return k + '=' + (CE_DIAG as any)[k]; }).join(', ');
}
// ── [DIAG CE-DIAG-FLAGS] end ─────────────────────────────────────────────────

// ── [DIAG v2.66.0 DIAG-CMD-SHARED] Surface-independent /log and /diag handler ──
// [CORRECTED v2.66.0] v2.65.0 put /log and /diag ONLY inside runWizardChatTurn,
// reachable exclusively through the MODAL World-Build Wizard's chat panel
// (AE_WIZ_SEND). Live Wizard Chat (_aeLiveWiz, the actively-used surface) types
// straight into the story document through NAI's own Send button and never
// calls this function at all — the commands were silently unreachable from
// there. Same lesson this file already learned once for CharChat activation:
// never gate a cross-cutting facility on a UI surface that isn't guaranteed to
// exist. Pulled out here so it can be called from BOTH runWizardChatTurn (kept,
// harmless) AND the new AE_DIAG_CMD bridge message (SECTION 18), which reaches
// the engine directly regardless of what's open in the story — see the bridge's
// bridge console handle. [v2.169.0] THE HANDLE IS window.aeBridge, NOT window.CE_ENGINE --
// the latter is named in comments going back to v2.66.0 and HAS NEVER EXISTED in any
// shipped bridge (grep the bridge: the only window assignment is `window.aeBridge`). The
// working invocation, verified live, is:
//     window.aeBridge.sendToEngine('AE_DIAG_CMD', { cmd: '/ce ghost' })
// The reply arrives as an AE_DIAG_REPLY event on the console, not as a return value.
//
// Returns the reply string if cmdLower matched a recognized diag command, or
// null if it did not (caller falls through to its own normal handling).
async function aeHandleDiagCommand(rawText: string, cmdLower: string): Promise<string | null> {
    if (cmdLower === '/log' || cmdLower.indexOf('/log ') === 0) {
        let _logParts = rawText.split(/\s+/);
        let _logSub = (_logParts[1] || 'list').toLowerCase();
        if (_logSub === 'list') return aeLogList();
        if (_logSub === 'all') { await aeLogSetChannel('*', true); return 'All log channels ON.'; }
        if (_logSub === 'none') {
            for (let _logK in _aeLogEnabled) _aeLogEnabled[_logK] = false;
            await aeLogSetChannel('charchat', false); // triggers the persist write
            return 'All log channels OFF (including "*"). \'charchat\' stays off until re-enabled \u2014 it is no longer the coded default once you\'ve explicitly touched channel state.';
        }
        let _logCh = _logParts[1];
        let _logState = (_logParts[2] || '').toLowerCase();
        if (!_logCh || (_logState !== 'on' && _logState !== 'off')) {
            return 'Usage: /log list | /log all | /log none | /log <channel> on|off\n' + aeLogList();
        }
        await aeLogSetChannel(_logCh, _logState === 'on');
        return 'Channel "' + _logCh + '" set ' + _logState.toUpperCase() + '.\n' + aeLogList();
    }
    // [v2.85.0 CE-STATUS] One command that answers "is this character updating, and is
    // anything of theirs reaching context" without needing log channels on or a
    // generation to happen first. Every gate runDynamicEngine checks, in the order it
    // checks them, reported per character — because these gates fail SILENTLY and look
    // identical from outside: a character with no body, one parked in another room, one
    // over the dynamic cap, and one whose interval simply has not elapsed all produce
    // exactly the same observable result (nothing happens) and have four different fixes.
    if (cmdLower === '/ce' || cmdLower.indexOf('/ce ') === 0) {
        const ceParts = rawText.split(/\s+/);
        const ceSub = (ceParts[1] || 'status').toLowerCase();
        // [v2.127.0 WORLDMAP] Opens the World Map surface (SECTION 32). REACHED VIA
        // window.aeBridge.sendToEngine('AE_DIAG_CMD', { cmd: '/ce map' }) IN ERUDA -- same DIAG-CMD
        // path as every other /ce, /log, /diag command, and for the same reason DIAG-CMD
        // exists at all: typing into story text or a chat box never reaches this function.
        // The toolbar button ("Map") is the primary path; this is the console equivalent.
        // The string returned below is DIAG-CMD's reply payload (surfaces as a '[CE:diag]'
        // console line via AE_DIAG_REPLY), not chat output.
        if (ceSub === 'map' || ceSub === 'mapprobe') {
            ceOpenMap().catch(function() {});
            return 'Opening World Map\u2026';
        }
        // [v2.168.0 GHOST-WALK, extended v2.170.0] THE INSTRUMENT FOR THE GHOST-HEADER
        // BUG, and it exists because three rounds of reasoning-from-source produced three
        // wrong fixes. The jsxmount probe answers ONE question (was the host re-created);
        // this answers what is actually AROUND the host once a ghost is on screen.
        //
        // IT RAN AND IT SETTLED THE DOWNWARD HALF: the tree under the live host is clean
        // and single while ghosts are visible, and window mode did not change the ghost, so
        // the duplication is neither in our vdom nor in the choice of NAI container. The
        // v2.170.0 upward walk is the half that can still answer the question -- see its own
        // block below for how to read it, including the case where the parent chain is not
        // readable at all, which is itself a result and moves this probe to the bridge.
        //
        // Reads only what the mount probe already proved readable (childNodes, isConnected)
        // and guards every property access, because the whitelist here is not documented
        // and a diagnostic that throws is worse than none.
        if (ceSub === 'ghost') {
            var gwOut: string[] = [];
            var gwId: string;
            for (gwId in _ceMountCount) {
                gwOut.push('mount ' + gwId + ' x' + _ceMountCount[gwId]);
            }
            // [v2.169.0 HOST-ORPHAN] The host COUNT is now the headline number: after the
            // fix it must be 1 no matter how many mounts have fired. A count above 1 means
            // the teardown is not keeping up and the ghost is back.
            var gwHostList: any[] = _ceMountHosts['ce-shell-jsx'] || [];
            gwOut.push('tracked hosts=' + gwHostList.length + ' (1 is correct)');
            var gwHost: any = _ceMountElem['ce-shell-jsx'] || null;
            if (!gwHost) { gwOut.push('no ce-shell-jsx host recorded — open the shell first.'); return gwOut.join('\n'); }
            var gwSeen = 0;
            var gwWalk = function(node: any, path: string, depth: number): void {
                if (!node || gwSeen > 80 || depth > 4) return;
                gwSeen++;
                var tag = '?'; var kids: any = null; var n = 0; var txt = '';
                try { tag = String(node.tagName || node.nodeName || '?'); } catch (_e1) {}
                try { kids = node.childNodes || null; n = (kids && kids.length) || 0; } catch (_e2) {}
                try { txt = String(node.textContent || '').replace(/\s+/g, ' ').slice(0, 34); } catch (_e3) {}
                gwOut.push(new Array(depth + 1).join('  ') + '[' + path + '] ' + tag
                    + ' kids=' + n + (txt ? ' "' + txt + '"' : ''));
                for (var gi = 0; gi < n && gwSeen <= 80; gi++) {
                    var kid: any = null;
                    try { kid = kids[gi]; } catch (_e4) { kid = null; }
                    gwWalk(kid, path + '.' + gi, depth + 1);
                }
            };
            try { gwOut.push('host isConnected=' + String(!!gwHost.isConnected)); } catch (_e5) {}
            gwOut.push('-- DOWN from host --');
            gwWalk(gwHost, '0', 0);
            if (gwSeen > 80) gwOut.push('… truncated at 80 nodes');

            // [v2.170.0 GHOST-WALK-UP] THE HALF THAT WAS MISSING, and the reason two builds
            // of diagnostics produced nothing usable: the down-walk came back CLEAN while
            // the ghost was on screen, so the ghost is not below the host. It is beside it
            // or above it. This climbs the parent chain and, at each level, lists that
            // level's DIRECT CHILDREN with a text snippet.
            //
            // READ IT LIKE THIS. If some ancestor has SEVERAL children that each look like a
            // shell root (a nav row's worth of text, or a '\u2190 ' back label), those are
            // abandoned host wrappers NAI made and never handed us -- we cannot register
            // what we are never given, which is why the v2.169.0 teardown could not reach
            // them, and the fix becomes reaching them through this parent instead. If the
            // chain instead terminates immediately (no parentNode readable), then the
            // property is off NAI's whitelist and the DOM is simply not inspectable from
            // here -- in which case stop probing from inside the engine and put the walk in
            // the bridge, which has real page-context DOM access.
            //
            // parentNode/parentElement are NOT known to be whitelisted; every read is
            // guarded and a failure is reported rather than thrown, because that failure is
            // itself the answer to the second case above.
            // [v2.170.1 SANDBOX-DOM] THE UPWARD WALK RAN AND IT ENDED THE ENGINE-SIDE
            // INVESTIGATION, so read this before extending it. It reported:
            //     ^1 #document kids=2
            //         ^1.0 BODY kids=0
            //         ^1.1 DIV kids=1  <== the branch we came up from
            //     ^1 no readable parent (chain ends here)
            // A #document with an EMPTY BODY, our host sitting beside that body rather than
            // inside it, and no parent above it. THAT IS NOT THE PAGE. The engine renders
            // into a SYNTHETIC DOCUMENT inside the sandbox which NAI marshals out to the
            // real DOM, so render, h and every walk here operate on a private tree.
            //
            // WHICH MEANS: the engine CANNOT SEE the ghosts and cannot ever fix them from
            // here, and the clean single tree this probe keeps reporting is true of our own
            // document while saying NOTHING about what is painted. Every engine-side theory
            // that got tested and failed -- null child slots v2.167.0, orphaned render roots
            // v2.169.0, the container swap v2.168.0 -- failed for this one reason. The probe
            // moved to the bridge in bridge v2.103.0, window.aeBridge.ghost, which runs in
            // page context and pierces shadow roots. Keep this walk as the record of why;
            // do not build on it.
            gwOut.push('-- UP from host --');
            var gwUp: any = gwHost;
            var gwLvl = 0;
            while (gwLvl < 8) {
                var gwPar: any = null;
                try { gwPar = gwUp.parentNode || gwUp.parentElement || null; } catch (_e6) { gwPar = null; }
                if (!gwPar) { gwOut.push('^' + gwLvl + ' no readable parent (chain ends here)'); break; }
                gwLvl++;
                var pTag = '?'; var pKids: any = null; var pN = 0;
                try { pTag = String(gwPar.tagName || gwPar.nodeName || '?'); } catch (_e7) {}
                try { pKids = gwPar.childNodes || null; pN = (pKids && pKids.length) || 0; } catch (_e8) {}
                gwOut.push('^' + gwLvl + ' ' + pTag + ' kids=' + pN);
                for (var pi = 0; pi < pN && pi < 12; pi++) {
                    var pKid: any = null; var kTag = '?'; var kN = 0; var kTxt = ''; var kMe = '';
                    try { pKid = pKids[pi]; } catch (_e9) { pKid = null; }
                    if (!pKid) continue;
                    try { kTag = String(pKid.tagName || pKid.nodeName || '?'); } catch (_e10) {}
                    try { kN = (pKid.childNodes && pKid.childNodes.length) || 0; } catch (_e11) {}
                    try { kTxt = String(pKid.textContent || '').replace(/\s+/g, ' ').slice(0, 44); } catch (_e12) {}
                    if (pKid === gwUp) kMe = '  <== the branch we came up from';
                    gwOut.push('    ^' + gwLvl + '.' + pi + ' ' + kTag + ' kids=' + kN
                        + (kTxt ? ' "' + kTxt + '"' : '') + kMe);
                }
                if (pN > 12) gwOut.push('    … ' + (pN - 12) + ' more children at this level');
                gwUp = gwPar;
            }
            return gwOut.join('\n');
        }
        if (ceSub !== 'status') return 'Usage: /ce status | /ce map | /ce ghost';
        try {
            const stCfg   = await loadConfig();
            const stIdx   = await loadIndex();
            const stEnts  = await loadEntityIndex();
            const stCam   = await loadPlayerLocation();
            const stGen   = Number(await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0)) || 0;
            const stTok   = Number(await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0)) || 0;
            const stMode  = ((stCfg as any).dynamicIntervalMode === 'tokens') ? 'tokens' : 'gens';
            const stTokM  = (stMode === 'tokens');
            const stProg  = stTokM ? stTok : stGen;
            const stUnit  = stTokM ? 'tok' : 'gen';
            const stCap   = Number((stCfg as any).maxDynamicCharacters) || 0;
            const stAllow = computeDynamicAllowedSet(stIdx as any, stCap);
            const stCamName = stCam
                ? ((stEnts.filter(Boolean).find(function(m) { return m.id === stCam; }) || { name: '?' }).name + ' [' + stCam + ']')
                : '(none — NO CAMERA LOCATION, nothing can be scene-present)';

            const out: string[] = [];
            out.push('CADENCE  ' + stMode + '  gen=' + stGen + '  tok=' + stTok);
            out.push('CAMERA   ' + stCamName);
            out.push('CAP      ' + (stCap > 0 ? (stCap + ' (allowed this turn: ' + stAllow.size + ')') : 'none'));
            out.push('');

            const stActive = stIdx.filter(Boolean).filter(function(m) { return m.active; });
            if (stActive.length === 0) out.push('(no active characters)');

            for (const meta of stActive) {
                const c = await loadCharacter(meta.id);
                if (!c) { out.push(meta.name + ': <record failed to load>'); continue; }
                const isProt = !!c.isProtagonist;
                const isStat = !!(c as any).isStatic;
                const body   = c.entityId ? (stEnts.filter(Boolean).find(function(m) { return m.id === c.entityId; }) || null) : null;
                const room   = c.entityId ? getEffectiveRoomId(c.entityId, stEnts) : null;
                const roomNm = room ? ((stEnts.filter(Boolean).find(function(m) { return m.id === room; }) || { name: '?' }).name) : null;
                const rel    = charIsRelevant(c, new Set<string>());
                const capOut = (stCap > 0 && !stAllow.has(meta.id));

                // Name the FIRST gate that stops this character, in dispatch order — a
                // list of every failing condition is noise when only the first one matters.
                let blocker = '';
                if (isProt)            blocker = 'protagonist (never updated)';
                else if (isStat)       blocker = 'STATIC toggle';
                else if (capOut)       blocker = 'over dynamic cap';
                else if (!c.entityId)  blocker = 'NO BODY (entityId unset) — cannot ever be scene-present';
                else if (!body)        blocker = 'body id set but entity MISSING — use Generate Missing Physical Body';
                else if (room === null) blocker = 'body has no room (parentId null) — place it in a location';
                else if (!stCam)       blocker = 'no camera location set';
                else if (room !== stCam) blocker = 'in ' + roomNm + ', camera is elsewhere';
                else if (!c.scenePresent) blocker = 'scenePresent=false despite co-location (stale — runs on next generation)';
                else if (!rel)         blocker = 'not relevant';

                out.push(meta.name + (isProt ? ' [PROTAG]' : (isStat ? ' [STATIC]' : ' [dyn]')));
                out.push('  place    body=' + (c.entityId ? (body ? 'ok' : 'MISSING') : 'none')
                    + ' room=' + (roomNm || '-') + ' present=' + (c.scenePresent ? 'YES' : 'no'));
                if (blocker) {
                    out.push('  BLOCKED  ' + blocker);
                } else {
                    const lastEph  = Number(stTokM ? c.lastEphemeralTokens : c.lastEphemeralGen) || 0;
                    const lastHook = Number(stTokM ? c.lastHookTokens      : c.lastHookGen)      || 0;
                    const intEph   = Number(stTokM ? (stCfg as any).thoughtIntervalTokens : stCfg.thoughtIntervalGens) || (stTokM ? 500  : 2);
                    const intHook  = Number(stTokM ? (stCfg as any).hookIntervalTokens    : stCfg.hookIntervalGens)    || (stTokM ? 1500 : 6);
                    function due(on: boolean, last: number, iv: number): string {
                        if (!on) return 'OFF';
                        const d = stProg - last;
                        return (d >= iv ? 'DUE ' : '    ') + d + '/' + iv + stUnit;
                    }
                    // [v2.92.0 POSITION] rel= removed: Position has no cadence of its own,
                    // it rides the eph beat pass. What replaced it on this readout is the
                    // thing that DOES move -- the tier -- plus whether the target is
                    // resolved at all, which is the one migration outcome that can silently
                    // leave a Position injecting nothing.
                    out.push('  cadence  eph=' + due(!!c.autoThoughtsEnabled, lastEph, intEph)
                        + '  hook=' + due(!!c.hooksEnabled, lastHook, intHook));
                    const stPos: any = (c as any).position;
                    if (stPos && (stPos.shape || stPos.standing)) {
                        const stTid = String(stPos.targetId || '');
                        const stTier = stTid ? await _ceReadPressure(c.id, 'position_' + stTid) : 0;
                        out.push('  position ' + (String(stPos.targetName || '') || '(unnamed)')
                            + ' id=' + (stTid || 'UNRESOLVED')
                            + ' tier=' + (stTid ? String(stTier) : 'n/a'));
                    }
                }

                const cfv: any = (c as any).customFieldValues || {};
                const pat = _ceCharPatternSlots(c);
                const patName = _ceResolveCharPattern(c); // [v2.98.0] was its own inline scan
                out.push('  slots    core=' + (cfv['ce_slot_core'] ? 'y' : '-')
                    + ' pursuit=' + (cfv['ce_slot_pursuit'] ? 'y' : '-')
                    + ' pattern=' + (patName || '-')
                    + ' resist=' + (pat.resistance ? 'y' : '-')
                    + ' conduct=' + (pat.conduct ? 'y' : '-'));
                out.push('  pressure hook=t' + (await _ceReadPressure(c.id, 'hook'))
                    + ' pursuit=t' + (await _ceReadPressure(c.id, 'pursuit'))
                    // [v2.89.1 EVIDENCE-SURFACE] Last stamped classification, or '-' when the
                    // beat pass produced no usable one. Distinguishes "the model said nothing
                    // moved" from "the reply was malformed", which a tier alone cannot.
                    + ' last=' + (((c.ephemeral as any) && (c.ephemeral as any).pursuitState) || '-'));
                // The snapshot IS the injected content — no snapshot means the two AN
                // lines cannot render no matter how healthy every gate above looks.
                const eph: any = c.ephemeral;
                out.push('  snapshot ' + (eph && (eph.emotionalResponse || eph.immediateDesire)
                    ? ('yes @' + stUnit + ' ' + (eph.generatedAtGen || 0)
                        + ' | intent="' + String(eph.immediateDesire || '').substring(0, 40) + '"')
                    : 'NONE — nothing to inject'));
                out.push('');
            }
            return out.join('\n');
        } catch (eCeSt) {
            return '/ce status failed: ' + ((eCeSt && (eCeSt as any).message) || String(eCeSt));
        }
    }
    if (cmdLower === '/diag' || cmdLower.indexOf('/diag ') === 0) {
        let _diagParts = rawText.split(/\s+/);
        let _diagSub = (_diagParts[1] || 'list').toLowerCase();
        if (_diagSub === 'list') return aeDiagList();
        let _diagFlag = _diagParts[1];
        let _diagState = (_diagParts[2] || '').toLowerCase();
        if (!_diagFlag || (_diagState !== 'on' && _diagState !== 'off')) {
            return 'Usage: /diag list | /diag <flag> on|off\n' + aeDiagList();
        }
        return await aeDiagSet(_diagFlag, _diagState === 'on');
    }
    return null;
}
// ── [DIAG DIAG-CMD-SHARED] end ───────────────────────────────────────────────

// ============================================================================
// SECTION 3c — GENERATION BUDGET CONSTANTS & ENGINE LOCKS
// AE_BUDGET_* token caps and the top-level generation/broadcast locks.
// ============================================================================

// [v2.84.0 BUDGET-GATE] Each dynamic generator's dispatch gate must match that
// generator's own max_tokens, or the gate lets a call through that cannot fit its own
// request. These were hand-matched integers (220/220/200/200) until v2.83.0 raised
// generateEphemeral's max_tokens 220->240 without touching its gate, leaving a
// 220-239 window where ephemeral would be dispatched and then truncated mid-JSON —
// which fails the extractJSON parse and returns false, i.e. a silent skipped update
// rather than a visible error. Named constants so the coupling is explicit and a
// future max_tokens change has an obvious matching edit.
// [v2.92.0 POSITION] EPH 240 -> 260 for the positionState key added to the beat pass,
// in LOCKSTEP with generateEphemeral's own max_tokens literal. These two integers must
// move together or the failure is INVISIBLE: the gate admits a call the request cannot
// fit, the JSON truncates mid-object, extractJSON returns nothing and the update is
// silently skipped rather than visibly failed. That is the v2.83.0 bug and this is its
// second occurrence — grep AE_BUDGET_EPH before touching either number.
// AE_BUDGET_REL deleted with generateRelationshipUpdate.
const AE_BUDGET_EPH  = 260;   // generateEphemeral max_tokens — LOCKSTEP with its literal
const AE_BUDGET_HOOK = 200;   // generateHookUpdates max_tokens

// ── Engine State ──────────────────────────────────────────────────────────────
// ae_lock: probability engine mutex — prevents double-rolling on a single player input.
var ae_lock = false;
var ae_genInFlight = false;  // [v0.9.36] an editor.generate() is active (cleared in onGenerationEnd)

// [v2.54.0] Per-story-turn token accumulator for the token-mode dynamic cadence. onResponse
// sums the generated tokenIds across a story turn's streamed chunks; onGenerationEnd's story
// path banks the total onto STORAGE_TOKEN_COUNT and resets. _aeStoryTurnCid tracks which
// generation the running total belongs to so it self-resets on a new continuityId without
// needing a separate start-of-turn reset hook. Never touched by chat/wizard/yoink turns —
// every one of those paths returns from onResponse before the accumulator runs.
var _aeStoryTurnTokens = 0;
var _aeStoryTurnCid: string | null = null;

// ── Editor Yoink generation (budget-free) ────────────────────────────────────
// [vNEXT] The World-Build Wizard's chats and field generators must not draw on the
// script generation budget. Instead of api.v1.generate(), we hijack the normal
// editor generation path (the "yoink" method, per Yoink Editor Gen / Brainstorming
// Partner): set _yoinkState.active, swap our prompt in via onContextBuilt, capture
// + swallow the output via onResponse, and resolve the promise in onGenerationEnd.
// While active, the engine's normal context/response/end logic early-returns so a
// yoink gen never injects world-state, ticks the story counter, or fires triggers.
interface AEYoinkState {
    active: boolean;
    messages: any[];
    responseText: string;
    resolve: ((value: string) => void) | null;
    reject: ((reason: any) => void) | null;
    // [v1.22.1 YOINK-WATCHDOG] NAI's own per-generation id (present on onContextBuilt /
    // onResponse / onGenerationEnd params). Captured when a yoink's context is built;
    // checked by onResponse/onGenerationEnd before touching _aeYoink state, so a late
    // event from a generation the watchdog already gave up on (see executeYoinkGeneration)
    // cannot resolve, or corrupt the buffer of, a newer call that has since taken the slot.
    continuityId: string | null;
}
var _aeYoink: AEYoinkState = { active: false, messages: [], responseText: '', resolve: null, reject: null, continuityId: null };

// ============================================================================
// SECTION 3d — WIZARD MODE (classic)
// The modal wizard-mode switch. Mutually exclusive with WIZLIVE (3e).
// ============================================================================

// ── [v1.2.0 WIZMODE] Hard wizard mode switch ─────────────────────────────────
// [WIZMODE] The per-call _aeYoink.active bracket only isolates a SINGLE generation.
// This is a session-level switch, set true for as long as the wizard tab/modal is
// open (bridge sends AE_WIZ_MODE on tab enter/exit). While on:
//   - onGenerationRequested blocks any user/story-initiated generation outright.
//   - onResponse swallows ALL output unconditionally (not just continuityId matches),
//     so a stalled/abandoned yoink can never leak into the document.
//   - generationParameters are snapshotted and max_tokens is pinned for wizard replies,
//     restored on exit.
//   - The wizard's assembled context (buildWizardContext) is frozen per chat on first
//     use and reused for the rest of the session, so only the transcript grows per
//     turn — fewer context substitutions, whatever caching benefit that permits.
// A zombie continuityId set is the backstop: if the 90s yoink watchdog force-recovers
// a stuck generation, its id is remembered so any of its late output/end-event is still
// caught even after mode has since exited (bounded, does not block exit indefinitely).
var _aeWizardMode = false;
var _wizModeParamSnapshot: any = null;
var _wizModeExitPending = false;
var _wizFrozenCtx: { [chatId: string]: string } = {};
var _wizZombieIds: { [continuityId: string]: boolean } = {};
var AE_WIZARD_MAX_TOKENS = 300; // pinned output cap for wizard replies while mode is on

async function broadcastWizModeState(): Promise<void> {
    try { await broadcastToTM(EVT_WIZ_MODE_STATE, { active: _aeWizardMode, draining: _wizModeExitPending }); }
    catch (e) { aeLog('[AE:wizard] broadcastWizModeState failed:', e); }
}

async function aeCompleteWizardModeExit(): Promise<void> {
    _aeWizardMode = false;
    _wizModeExitPending = false;
    _wizFrozenCtx = {};
    await api.v1.tempStorage.remove(STORAGE_WIZ_MODE).catch(function() {});
    if (_wizModeParamSnapshot) {
        try {
            let r: any = { model: _wizModeParamSnapshot.model };
            if (_wizModeParamSnapshot.max_tokens !== undefined) r.max_tokens = _wizModeParamSnapshot.max_tokens;
            if (_wizModeParamSnapshot.temperature !== undefined) r.temperature = _wizModeParamSnapshot.temperature;
            if (_wizModeParamSnapshot.top_p !== undefined) r.top_p = _wizModeParamSnapshot.top_p;
            if (_wizModeParamSnapshot.top_k !== undefined) r.top_k = _wizModeParamSnapshot.top_k;
            if (_wizModeParamSnapshot.frequency_penalty !== undefined) r.frequency_penalty = _wizModeParamSnapshot.frequency_penalty;
            if (_wizModeParamSnapshot.presence_penalty !== undefined) r.presence_penalty = _wizModeParamSnapshot.presence_penalty;
            if (_wizModeParamSnapshot.min_p !== undefined) r.min_p = _wizModeParamSnapshot.min_p;
            await api.v1.generationParameters.update(r);
        } catch (e) { api.v1.error('[AE:wizard] failed to restore generation params after wizard mode exit:', e); }
        _wizModeParamSnapshot = null;
    }
    api.v1.ui.toast('Wizard mode OFF \u2014 story generation resumed', { type: 'success', autoClose: 3000 });
    await broadcastWizModeState();
}
// ── [v1.2.0 WIZMODE] end ──────────────────────────────────────────────────────

// ============================================================================
// SECTION 3e — LIVE WIZARD CHAT (WIZLIVE)
// In-document wizard chat: marker paragraph, decorations, transcript
// persistence. Shares its overall shape with CHARCHAT (3f) but NOT its
// code — see the CE-INDEX note before attempting to unify them.
// ============================================================================

// ── [v2.4.0 WIZLIVE] In-document wizard chat ──────────────────────────────────
// The chat lives IN the story document instead of a hidden yoink conversation:
//   - startLiveWizardChat appends a boundary marker + an editable protocol
//     paragraph (both source:'instruction' — NAI's native instruct blocks) and
//     an opening greeting; the user then talks in { } instruct blocks and
//     presses NAI's own Send. Replies are ordinary generations landing in the
//     document — nothing is swallowed, no onResponse capture, no watchdog.
//   - CACHING CONTRACT: the story prefix (system prompt, memory, lorebook,
//     early story text) is NEVER touched while the chat is live. The only
//     context differences on a chat turn are the Author's Note being
//     deactivated (tail of context) and the chat paragraphs growing at the
//     document tail. Ending the chat removes those paragraphs, so story
//     generation resumes with a byte-identical top of context. Committing to
//     Memory is the single deliberate exception — that is the feature.
//   - endLiveWizardChat collects the transcript (instruction-source paragraphs
//     = user turns, everything else = wizard turns), archives it as a normal
//     WizardChat record unless discarding, optionally commits raw or distilled
//     notes to Memory, then removes every paragraph from the marker down.
//   - Batch generators are untouched — they still run through
//     executeYoinkGeneration. Classic WIZMODE and WIZLIVE are mutually
//     exclusive (guards in aeSetWizardMode and startLiveWizardChat).
interface LiveWizState {
    active: boolean;
    markerId: number | null;        // sectionId of the boundary marker paragraph
    setupIds: number[];             // sectionIds of engine-authored setup paragraphs (excluded from the transcript)
    topicId: string;                // wizard topic supplying the persona; '' = generic live persona
    paramSnapshot: any;             // generationParameters snapshot restored on end (persisted so a reload can still restore)
    startedAt: number;
    sourceEntryId: string | null;   // [v2.5.0] CE-Chats lorebook entry this chat resumes/overwrites; null = a fresh chat (Save creates a new entry)
    contextEntryIds: string[];      // [v2.5.0] CE-Chats entries switched forceActivation:true for THIS session; switched back off on end
    title: string;                  // [v2.6.0] user-facing chat name — defaults to the topic label at start/resume, renameable live; NEVER carries a timestamp
}
var _aeLiveWiz: LiveWizState = { active: false, markerId: null, setupIds: [], topicId: '', paramSnapshot: null, startedAt: 0, sourceEntryId: null, contextEntryIds: [], title: '' };

const AE_WIZLIVE_RULE_MARKER  = 'ae-wizlive-marker';
const AE_WIZLIVE_RULE_USER    = 'ae-wizlive-user';   // [v2.5.0] Director (instruction) turns — cool blue
const AE_WIZLIVE_RULE_WIZ     = 'ae-wizlive-wiz';    // [v2.5.0] Wizard replies + setup paragraphs — violet
const AE_WIZLIVE_MARKER_TEXT  = '\u2501\u2501 WIZARD CHAT \u2501\u2501 The story above is reference material. Everything below this line is an out-of-story planning chat and will be removed when the chat ends.';

// [v2.5.0 CE-CHATS] Live wizard chats persist to the lorebook instead of a bespoke
// Memory sentinel. A dedicated category holds one entry per saved chat; entries carry
// NO keys, so they never activate by keyword — they only enter context when their
// forceActivation ("Always On") flag is switched true, and go dormant again when
// switched false. That is how a chat (or a batch generator) "chooses" a saved chat as
// context: turn it on for the session, off when done. Resuming pulls the entry text
// back into the story to be continued, then Save overwrites the same entry.
var WIZLIVE_CAT_NAME  = 'CE Chats';
var _aeWizChatCatId: string | null = null;   // module cache of the category id (also mirrored to storyStorage)

async function saveLiveWizState(): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_WIZLIVE, JSON.stringify(_aeLiveWiz)); }
    catch (e) { api.v1.error('[AE:wizlive] state save failed:', e); }
}

async function broadcastWizLiveState(): Promise<void> {
    try { await broadcastToTM(EVT_WIZLIVE_STATE, { active: _aeLiveWiz.active, topicId: _aeLiveWiz.topicId, startedAt: _aeLiveWiz.startedAt }); }
    catch (e) { aeLog('[AE:wizlive] state broadcast failed:', e); }
}

// ── CE-Chats lorebook store ─────────────────────────────────────────────────
// Find (or create) the "CE Chats" lorebook category. Cached in module scope and
// mirrored to storyStorage so we usually skip the categories() scan.
async function ensureWizChatCategory(): Promise<string> {
    if (_aeWizChatCatId) return _aeWizChatCatId;
    try {
        let cached = (await api.v1.storyStorage.getOrDefault(STORAGE_WIZLIVE_CAT, '')) as string;
        if (cached) {
            let c = await api.v1.lorebook.category(cached);
            if (c) { _aeWizChatCatId = cached; return cached; }
        }
    } catch (_e0) {}
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).filter(function(c: any) { return (c.name || '') === WIZLIVE_CAT_NAME; })[0];
        if (found) {
            _aeWizChatCatId = found.id;
            try { await api.v1.storyStorage.set(STORAGE_WIZLIVE_CAT, found.id); } catch (_e1) {}
            return found.id;
        }
    } catch (_e2) {}
    let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: WIZLIVE_CAT_NAME, enabled: true });
    _aeWizChatCatId = newId;
    try { await api.v1.storyStorage.set(STORAGE_WIZLIVE_CAT, newId); } catch (_e3) {}
    return newId;
}

// All CE-Chats entries (each is one saved wizard chat), newest lorebook order.
async function listWizChatEntries(): Promise<any[]> {
    try { let cat = await ensureWizChatCategory(); return (await api.v1.lorebook.entries(cat)) || []; }
    catch (e) { api.v1.error('[AE:wizlive] listWizChatEntries:', e); return []; }
}

// Serialize a transcript into a round-trippable, human-readable block. The header
// line carries the title and (optionally) the source topic so a resume restores the
// right persona. Turns are "Director:"/"Wizard:" prefixed — the same shape the chat
// already reads naturally as context when switched Always-On.
// [v2.6.0] The timestamp is stamped into this HEADER line only (a [saved:...] tag) —
// title/displayName (the lorebook entry's actual NAME) never carries a date, per design.
function serializeChatTranscript(title: string, msgs: WizardChatMessage[], topicId: string): string {
    let head = '=== ' + (title || 'Wizard Chat') + (topicId ? ' [topic:' + topicId + ']' : '') + ' [saved:' + new Date().toLocaleString() + ']' + ' ===';
    let parts: string[] = [head, ''];
    for (let i = 0; i < msgs.length; i++) {
        let m = msgs[i];
        parts.push((m.role === 'user' ? 'Director: ' : 'Wizard: ') + m.content);
        parts.push('');
    }
    return parts.join('\n').replace(/\s+$/, '');
}

// Inverse of serializeChatTranscript. String-parsed (no bracket-bearing regex) so the
// engine brace-balance check stays meaningful. Lines before the first role header are
// ignored; a role line starts a turn, and following lines accrue to it until the next
// role header — so multi-line wizard replies survive the round trip.
function parseChatTranscript(text: string): { title: string; topicId: string; msgs: WizardChatMessage[] } {
    let title = ''; let topicId = '';
    let lines = String(text || '').split('\n');
    let msgs: WizardChatMessage[] = [];
    let cur: WizardChatMessage | null = null;
    for (let i = 0; i < lines.length; i++) {
        let line = lines[i];
        let t = line.trim();
        if (t.length >= 6 && t.indexOf('===') === 0 && t.lastIndexOf('===') === t.length - 3) {
            let inner = t.substring(3, t.length - 3).trim();
            let tp = inner.indexOf('[topic:');
            if (tp >= 0) {
                let close = inner.indexOf(']', tp);
                if (close > tp) {
                    topicId = inner.substring(tp + 7, close).trim();
                    inner = (inner.substring(0, tp) + inner.substring(close + 1)).trim();
                }
            }
            // [v2.6.0] Strip the [saved:...] stamp too — it is metadata, never part of the title.
            let sp = inner.indexOf('[saved:');
            if (sp >= 0) {
                let sclose = inner.indexOf(']', sp);
                if (sclose > sp) inner = (inner.substring(0, sp) + inner.substring(sclose + 1)).trim();
            }
            title = inner;
            continue;
        }
        let role: 'user' | 'assistant' | null = null;
        let rest = '';
        if (line.indexOf('Director:') === 0) { role = 'user'; rest = line.substring(9); }
        else if (line.indexOf('Wizard:') === 0) { role = 'assistant'; rest = line.substring(7); }
        if (role) {
            if (cur) msgs.push(cur);
            if (rest.charAt(0) === ' ') rest = rest.substring(1);
            cur = { role: role, content: rest };
        } else if (cur) {
            cur.content += '\n' + line;
        }
    }
    if (cur) msgs.push(cur);
    let outM: WizardChatMessage[] = [];
    for (let k = 0; k < msgs.length; k++) {
        let c = msgs[k].content.replace(/^\s+/, '').replace(/\s+$/, '');
        if (c.length > 0) outM.push({ role: msgs[k].role, content: c });
    }
    return { title: title, topicId: topicId, msgs: outM };
}

// Create-or-overwrite a CE-Chats entry. sourceEntryId (when it still exists) is
// overwritten in place; otherwise a fresh keyless, forceActivation:false entry is made.
async function upsertChatEntry(sourceEntryId: string | null, title: string, msgs: WizardChatMessage[], topicId: string): Promise<string> {
    let cat = await ensureWizChatCategory();
    let text = serializeChatTranscript(title, msgs, topicId);
    if (sourceEntryId) {
        let existing: any = null;
        try { existing = await api.v1.lorebook.entry(sourceEntryId); } catch (_e) {}
        if (existing) {
            await api.v1.lorebook.updateEntry(sourceEntryId, { text: text, displayName: title, category: cat });
            return sourceEntryId;
        }
    }
    let id = api.v1.uuid();
    let newId = await api.v1.lorebook.createEntry({ id: id, category: cat, displayName: title, text: text, keys: [], enabled: true, forceActivation: false, hidden: false });
    return newId || id;
}

// Flip forceActivation ("Always On") for a set of entries. Turning entries on is a
// deliberate top-of-context change (like the old Memory commit was); it happens once
// at chat start and reverts once at chat end, so all turns WITHIN a chat stay
// byte-identical and the prefix cache survives the session.
async function setContextEntriesActivation(ids: string[], on: boolean): Promise<void> {
    for (let i = 0; i < ids.length; i++) {
        try { await api.v1.lorebook.updateEntry(ids[i], { forceActivation: on }); }
        catch (e) { api.v1.error('[AE:wizlive] context toggle failed:', e); }
    }
}

// ── Decorations: split Director (blue) vs Wizard (violet) ───────────────────
// Registered once with empty user/wiz scopes; refreshLiveWizDecorations recomputes
// the two id sets from the live document (called on start, restore, and each turn end).
async function _wizliveRegisterDecorations(markerId: number): Promise<void> {
    await api.v1.editor.decorations.registerRules([
        { id: AE_WIZLIVE_RULE_MARKER, type: 'node', match: '^', style: { backgroundColor: 'rgba(147, 112, 219, 0.22)', borderTop: '2px solid rgba(147, 112, 219, 0.85)', borderBottom: '1px solid rgba(147, 112, 219, 0.4)' }, scope: { sectionIds: [markerId] } },
        { id: AE_WIZLIVE_RULE_USER,   type: 'node', match: '^', style: { backgroundColor: 'rgba(74, 158, 217, 0.10)', borderLeft: '3px solid rgba(74, 158, 217, 0.60)' }, scope: { sectionIds: [] } },
        { id: AE_WIZLIVE_RULE_WIZ,    type: 'node', match: '^', style: { backgroundColor: 'rgba(147, 112, 219, 0.07)', borderLeft: '3px solid rgba(147, 112, 219, 0.45)' }, scope: { sectionIds: [] } }
    ]);
}

async function refreshLiveWizDecorations(): Promise<void> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return;
    let all: any[] = [];
    try { all = await api.v1.document.scan(); } catch (_eScan) { return; }
    let userIds: number[] = [];
    let wizIds: number[] = [];
    let seen = false;
    for (let idx = 0; idx < all.length; idx++) {
        let row = all[idx];
        if (row.sectionId === _aeLiveWiz.markerId) { seen = true; continue; }
        if (!seen) continue;
        // Engine-authored setup (protocol/greeting) reads as the wizard side.
        if (_aeLiveWiz.setupIds.indexOf(row.sectionId) >= 0) { wizIds.push(row.sectionId); continue; }
        let isUser = row.section.source === 'instruction';
        if (!isUser) {
            let org = row.section.origin || [];
            if (org.length > 0) {
                let allTyped = true;
                let anyUser = false;
                for (let o of org) {
                    if (o.data === 'user') anyUser = true;
                    if (o.data !== 'user' && o.data !== 'edit') { allTyped = false; break; }
                }
                isUser = allTyped && anyUser;
            }
        }
        if (isUser) userIds.push(row.sectionId); else wizIds.push(row.sectionId);
    }
    try {
        await api.v1.editor.decorations.updateRules([
            { id: AE_WIZLIVE_RULE_USER, scope: { sectionIds: userIds } },
            { id: AE_WIZLIVE_RULE_WIZ,  scope: { sectionIds: wizIds } }
        ]);
    } catch (e) { aeLog('[AE:wizlive] decoration refresh failed (cosmetic only):', e); }
}

// Build the persona + protocol paragraphs shared by start and resume.
function _wizliveProtocolText(cfg: GlobalConfig, topicId: string): string {
    let topic = topicId ? getWizardTopic(cfg, topicId) : null;
    let persona = topic ? topic.instructions : 'You are a warm, collaborative worldbuilding assistant helping the user develop their story. Write in pure prose \u2014 no markdown, bolding, headers, or lists. Offer one or two concrete suggestions that push the idea forward and ask exactly ONE focused question per turn. Typically respond in 2-5 sentences.';
    let protoParts: string[] = [];
    protoParts.push('WIZARD CHAT MODE. ' + persona);
    protoParts.push('The user speaks in instruction blocks like this one. Reply to their newest instruction in plain conversational prose \u2014 do NOT continue the story itself. The story text above the chat marker is reference material you may draw on.');
    if (cfg.projectName || cfg.projectGenre || cfg.projectConcept) {
        let pj: string[] = [];
        if (cfg.projectName) pj.push('Project: ' + cfg.projectName);
        if (cfg.projectGenre) pj.push('Genre: ' + cfg.projectGenre);
        if (cfg.projectConcept) pj.push('Concept: ' + cfg.projectConcept);
        protoParts.push(pj.join('. ') + '.');
    }
    return protoParts.join(' ');
}

async function startLiveWizardChat(topicId: string, ctxEntryIds?: string[]): Promise<void> {
    if (_aeLiveWiz.active) { api.v1.ui.toast('A wizard chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeWizardMode) { api.v1.ui.toast('Close the classic wizard first \u2014 the two modes are exclusive.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is open in the story \u2014 end it first.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active) { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let cfg = await loadConfig();
    let topic = topicId ? getWizardTopic(cfg, topicId) : null;
    let protoText = _wizliveProtocolText(cfg, topicId);
    let greeting = (topic && (topic as any).seedMessage && String((topic as any).seedMessage).trim())
        ? String((topic as any).seedMessage).trim()
        // [FEATURE v2.29.0 WIZLIVE-BRACE-WRAP, per user] No longer tells the user to type
        // a curly brace themselves — _wizliveNormalizeDocument wraps a Director turn in
        // braces automatically after every reply, the same "you don't have to do it
        // yourself" wording change CharChat's own greeting got in v2.26.0/v2.27.0.
        : 'I\u2019m listening \u2014 write your message in a new paragraph, then press Send.';

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs([
        { text: AE_WIZLIVE_MARKER_TEXT, source: 'instruction' },
        { text: protoText, source: 'instruction' },
        { text: greeting }
    ]);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length === 0) { api.v1.ui.toast('Could not start the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_WIZARD_MAX_TOKENS });
    } catch (eP) { aeLog('[AE:wizlive] param pin failed, continuing without pin:', eP); snap = null; }

    let ctx = Array.isArray(ctxEntryIds) ? ctxEntryIds.slice() : [];
    let startTitle = (topic && topic.label) ? topic.label : 'General Worldbuilding';
    _aeLiveWiz = { active: true, markerId: markerId, setupIds: added.slice(1), topicId: topicId || '', paramSnapshot: snap, startedAt: Date.now(), sourceEntryId: null, contextEntryIds: ctx, title: startTitle };
    await saveLiveWizState();

    if (ctx.length > 0) {
        try { await setContextEntriesActivation(ctx, true); }
        catch (eCtx) { api.v1.error('[AE:wizlive] context activation failed:', eCtx); }
    }

    try { await _wizliveRegisterDecorations(markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration registration failed (cosmetic only):', eD); }

    api.v1.ui.toast('Wizard chat open \u2014 talk in { } instruct blocks below the marker, then press Send.', { type: 'info', autoClose: 6000 });
    await broadcastWizLiveState();
}

// Pull a saved chat back into the story and go live on it. The entry it came from is
// held as sourceEntryId so Save & Close overwrites that same entry.
async function resumeLiveWizardChatFromEntry(entryId: string): Promise<void> {
    if (_aeLiveWiz.active) { api.v1.ui.toast('A wizard chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeWizardMode) { api.v1.ui.toast('Close the classic wizard first \u2014 the two modes are exclusive.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is open in the story \u2014 end it first.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active) { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let entry: any = null;
    try { entry = await api.v1.lorebook.entry(entryId); } catch (_e) {}
    if (!entry || !entry.text) { api.v1.ui.toast('Could not load that saved chat.', { type: 'error', autoClose: 4000 }); return; }
    let parsed = parseChatTranscript(entry.text);
    if (parsed.msgs.length === 0) { api.v1.ui.toast('That saved chat is empty.', { type: 'warning', autoClose: 3000 }); return; }

    let cfg = await loadConfig();
    let protoText = _wizliveProtocolText(cfg, parsed.topicId);

    // marker + protocol, then one paragraph per turn (user turns rebuilt as { } instruct blocks).
    let paras: any[] = [
        { text: AE_WIZLIVE_MARKER_TEXT, source: 'instruction' },
        { text: protoText, source: 'instruction' }
    ];
    for (let i = 0; i < parsed.msgs.length; i++) {
        let m = parsed.msgs[i];
        if (m.role === 'user') {
            // [v2.53.0 WIZLIVE-BRACE-DOUBLE] Rebuild a Director turn in the SAME bare form the
            // write pass produces -- "Director: body", source:'instruction', no literal brace.
            // The old '{ body }' wrap re-introduced the double brace AND dropped the "Director:"
            // label, so a resumed chat read differently from a live-typed one. Header-strip
            // guards a saved body that somehow still carries the prefix (mirrors CharChat's
            // CHARCHAT-RESUME-IDEMPOTENT, v2.51.2).
            let wlRB = _wizliveStripDirectorHeader(_wizliveStripBraces(m.content.replace(/\n+/g, ' ').trim()));
            paras.push({ text: 'Director: ' + wlRB, source: 'instruction' });
        } else {
            let chunks = m.content.split('\n');
            for (let j = 0; j < chunks.length; j++) {
                let c = chunks[j].replace(/^\s+/, '').replace(/\s+$/, '');
                if (c.length > 0) paras.push({ text: c });
            }
        }
    }

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs(paras);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length < 2) { api.v1.ui.toast('Could not insert the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];
    let protocolId = added[1];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_WIZARD_MAX_TOKENS });
    } catch (eP) { aeLog('[AE:wizlive] param pin failed, continuing without pin:', eP); snap = null; }

    let resumeTitle = (parsed.title || '').trim() || ((getWizardTopic(cfg, parsed.topicId) || {} as any).label) || 'General Worldbuilding';
    _aeLiveWiz = { active: true, markerId: markerId, setupIds: [protocolId], topicId: parsed.topicId || '', paramSnapshot: snap, startedAt: Date.now(), sourceEntryId: entryId, contextEntryIds: [], title: resumeTitle };
    await saveLiveWizState();

    try { await _wizliveRegisterDecorations(markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration registration failed (cosmetic only):', eD); }

    api.v1.ui.toast('Chat resumed in the story \u2014 continue below the marker. Save & Close overwrites this saved chat.', { type: 'info', autoClose: 6000 });
    await broadcastWizLiveState();
}

function _wizliveStripBraces(t: string): string {
    let s = (t || '').trim();
    if (s.length >= 2 && s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') s = s.substring(1, s.length - 1).trim();
    return s;
}

// [v2.53.0 WIZLIVE-BRACE-DOUBLE] Strip a leading "Director:" label from a turn body, so the
// canon pass is idempotent once it stopped writing the literal brace (a braceless canon that
// left the label in the body grew "Director: Director: ..." on every reopen). Mirrors
// _charchatStripHeader's shape (fixed literal label, not a per-user name; tolerates **bold**,
// tabs, and a full-width colon; two passes for a "Director:\nDirector:" split). Role is never
// inferred from text here -- _wizliveRowIsUser already classified this row as a Director turn.
function _wizliveStripDirectorHeader(body: string): string {
    let wlT = (body || '').replace(/^\s+/, '');
    let wlRx = new RegExp('^\\*{0,2}Director\\*{0,2}[ \\t]*[:\uff1a]\\s*', 'i');
    for (let wlPass = 0; wlPass < 2; wlPass++) {
        if (wlRx.test(wlT)) wlT = wlT.replace(wlRx, '');
        else break;
    }
    return wlT;
}

// [v2.29.0] Factored out of collectLiveWizTranscript's own inline copy, per user's
// new brace-auto-wrap request needing the exact same classification — same
// "one shared function, not drifting duplicates" call already made for CharChat's
// _charchatRowIsPov (grep it for the precedent). Role is NEVER inferred from text:
// instruction-source paragraphs are Director turns (NAI's { } instruct blocks); a
// paragraph whose origin metadata is entirely user/edit-typed is also a Director
// turn (they didn't use braces this time).
function _wizliveRowIsUser(section: any): boolean {
    if (section.source === 'instruction') return true;
    let wlOrg = section.origin || [];
    if (wlOrg.length === 0) return false;
    let wlAllTyped = true;
    let wlAnyUser = false;
    for (let wlO of wlOrg) {
        if (wlO.data === 'user') wlAnyUser = true;
        if (wlO.data !== 'user' && wlO.data !== 'edit') { wlAllTyped = false; break; }
    }
    return wlAllTyped && wlAnyUser;
}

// [BUGFIX v2.54.0 WIZLIVE-MERGE, per user: "wizard user messages not automatically wrapped
// / not marked as instruct"] Ports CharChat's v2.25.0 CHARCHAT-MERGE fix that
// _wizliveNormalizeDocument's own header (below) flagged as DELIBERATELY NOT PORTED, with
// the caveat "the same NAI editor mechanism underlies both chat modes, so the same bug is
// plausible here too." It is: ROOT CAUSE of the report is that when the user types a
// Director turn with no trailing paragraph break, NAI's native Send continues the Wizard
// reply DIRECTLY INTO that same paragraph. The merged section's origin then spans a
// user-typed head + an ai-generated tail, so _wizliveRowIsUser sees non-user/edit
// ('ai'/'prompt') data and returns FALSE — the turn stops being recognised as a Director
// turn, and neither _wizliveNormalizeDocument nor _wizliveCanonicalStoryOverride ever wraps
// it or stamps source:'instruction'. This is exactly why CharChat "does not have the same
// problem": it splits the glued paragraph first. Returns the offset into section.text where
// the AI-authored portion begins, or -1 if the origin is homogeneous (nothing to split).
// Byte-for-byte the logic of _charchatMergeSplitIdx (grep it for the full reasoning).
function _wizliveMergeSplitIdx(section: any): number {
    let wlOrg = (section && section.origin) || [];
    if (wlOrg.length < 2) return -1;
    let wlSorted = wlOrg.slice().sort(function(a: any, b: any) { return a.position - b.position; });
    let wlSawUser = false;
    for (let wlO of wlSorted) {
        if (wlO.data === 'user' || wlO.data === 'edit') { wlSawUser = true; continue; }
        if (wlSawUser && (wlO.data === 'ai' || wlO.data === 'prompt')) return wlO.position;
    }
    return -1;
}

// WRITE-PASS ONLY (called from _wizliveNormalizeDocument at onGenerationEnd — never the
// read-only side, which must not mutate the document, and which also runs on dryRun).
// Physically splits any Director paragraph NAI glued a Wizard reply onto into two real
// paragraphs: the user-typed head keeps the original sectionId (a legitimate, just shorter,
// Director turn that _wizliveRowIsUser now classifies correctly), and the AI-authored tail
// becomes a fresh paragraph via insertParagraphAfter with no source override — api.v1.
// document's contract gives script-written text 'script' origin, which _wizliveRowIsUser
// reads as NOT a Director turn, same as any Wizard reply. Runs BEFORE the wrap loop so
// normalisation never has to see a merged section. Mirrors _charchatSplitMergedSections.
async function _wizliveSplitMergedSections(): Promise<void> {
    if (_aeLiveWiz.markerId === null) return;
    let wlAll: any[] = [];
    try { wlAll = await api.v1.document.scan(); }
    catch (eSc) { api.v1.error('[AE:wizlive] merge-split scan failed:', eSc); return; }
    let wlSeen = false;
    for (let wlR of wlAll) {
        if (wlR.sectionId === _aeLiveWiz.markerId) { wlSeen = true; continue; }
        if (!wlSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wlR.sectionId) >= 0) continue;
        let wlFull = wlR.section.text || '';
        let wlIdx = _wizliveMergeSplitIdx(wlR.section);
        if (wlIdx <= 0 || wlIdx >= wlFull.length) continue;
        let wlHead = wlFull.substring(0, wlIdx);
        let wlTail = wlFull.substring(wlIdx);
        try {
            await api.v1.document.insertParagraphAfter(wlR.sectionId, { text: wlTail });
            await api.v1.document.updateParagraph(wlR.sectionId, { text: wlHead });
        } catch (eSp) { api.v1.error('[AE:wizlive] merge-split failed for section ' + wlR.sectionId + ':', eSp); }
    }
}

// [FEATURE v2.29.0 WIZLIVE-BRACE-WRAP, per user: "just like character chats"] Rewrites
// every Director (user) turn in the live document to "Director: body" (bare, source:'instruction'; see [v2.53.0] note below) so the user
// never has to type braces themselves — CharChat's exact selling point, ported here.
// WRITE-PASS ONLY, called from onGenerationEnd, same timing rule CharChat's own
// _charchatNormalizeDocument follows and for the same reason: mutating the document
// mid-context-build would race the generation currently building against it.
// DELIBERATE DIFFERENCE FROM CHARCHAT, not an oversight: CharChat ALSO has a read-only
// twin (_charchatCanonicalChatText) that overrides storyText.content so the model's
// view is canonical on the SAME turn it's typed. WIZLIVE does not get one — WIZLIVE's
// onBeforeContextBuild deliberately leaves the story prefix (and the live document
// text within it) completely untouched, to protect prefix caching across the chat
// (see that hook's own WIZLIVE comment). Adding a same-turn override here would mean
// reversing THAT design decision too, which nothing in this request asked for. Net
// effect: a Director turn is typed raw, reaches the model raw for THAT one reply, and
// is rewritten with braces immediately after — visible correctly from that point on,
// and correctly formatted for every SUBSEQUENT generation's raw-document read. One
// turn of lag on the very first message of a session, same trade CharChat itself
// would have if its read-only twin were ever removed.
// NOT PORTED, flagged rather than guessed at: CharChat's v2.25.0 CHARCHAT-MERGE fix
// (_charchatSplitMergedSections) for NAI gluing a completion directly onto the same
// paragraph the user just typed into, with no trailing paragraph break. The same NAI
// editor mechanism underlies both chat modes, so the same bug is plausible here too —
// untested, not addressed this pass. Watch for a Director turn that looks like it
// swallowed the start of a Wizard reply, the exact symptom that bug produced there.
// ASSUMPTION, stated rather than silently made: the literal label is "Director" (no
// per-user customizable name exists for WIZLIVE, unlike CharChat's povName) — matches
// the fixed "Director:"/"Wizard:" prefixes serializeChatTranscript already uses for
// the SAVED transcript, so this is consistent with an existing convention, not a new
// one invented for this patch.
// [v2.53.0 WIZLIVE-BRACE-DOUBLE, mirrors CHARCHAT-BRACE-DOUBLE v2.52.0] CORRECTION to the
// v2.29.0 design narrated above: a Director turn is now written BARE as "Director: body" with
// source:'instruction', NOT the literal "{Director: body}" the older text still describes. A
// Director turn is an instruction paragraph and NAI renders its OWN brace around one, so the
// literal wrap was a SECOND brace -- it re-baked "{ {Director: ...} }" on every reopen, the
// exact CharChat bug fixed in v2.52.0. The read-side twin (_wizliveCanonicalStoryOverride) and
// the resume path (resumeLiveWizardChatFromEntry) were moved to the same bare form in this
// patch; per CHARCHAT-CTX-BRACE (v2.42.0) the model's view carries the "Director:" header, not
// a brace. Old stories self-migrate: an old "{Director: body}" turn strips to "body" and
// re-canons to bare on the next reply, idempotent thereafter.
async function _wizliveNormalizeDocument(): Promise<void> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return;
    // [BUGFIX v2.54.0 WIZLIVE-MERGE] Split any Director paragraph NAI glued a Wizard reply
    // onto BEFORE scanning, so the wrap loop below sees a clean user-only Director section
    // instead of a merged one _wizliveRowIsUser rejects (which is why the turn never got
    // wrapped or instruction-stamped — the reported bug). Same split-before-normalise
    // ordering _charchatNormalizeDocument uses.
    try { await _wizliveSplitMergedSections(); } catch (eMs) { aeLog('[AE:wizlive] merge-split pass failed (non-fatal):', eMs); }
    let wlAll: any[] = [];
    try { wlAll = await api.v1.document.scan(); }
    catch (eWs) { api.v1.error('[AE:wizlive] turn scan failed:', eWs); return; }
    let wlSeen = false;
    let wlUpdates: { sectionId: number; section: any }[] = [];
    for (let wlR of wlAll) {
        if (wlR.sectionId === _aeLiveWiz.markerId) { wlSeen = true; continue; }
        if (!wlSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wlR.sectionId) >= 0) continue;
        if (!_wizliveRowIsUser(wlR.section)) continue;   // only Director turns get wrapped; Wizard replies pass through untouched
        let wlTxt = (wlR.section.text || '');
        if (!wlTxt.trim()) continue;
        let wlBody = _wizliveStripDirectorHeader(_wizliveStripBraces(wlTxt));
        if (!wlBody) continue;
        // [v2.53.0 WIZLIVE-BRACE-DOUBLE] Bare "Director: body", source:'instruction' stamped as
        // we rewrite (NAI draws the single visible brace; the stamp carries turn identity now
        // that the literal brace is gone). Re-stamp even when the text already matches, to
        // migrate a Director turn an older build left un-instruction'd.
        let wlCanon = 'Director: ' + wlBody;
        if (wlCanon !== wlR.section.text || wlR.section.source !== 'instruction') {
            wlUpdates.push({ sectionId: wlR.sectionId, section: { text: wlCanon, source: 'instruction' } });
        }
    }
    if (wlUpdates.length > 0) {
        try { await api.v1.document.updateParagraphs(wlUpdates); }
        catch (eWu) { aeLog('[AE:wizlive] brace-wrap rewrite failed (cosmetic only):', eWu); }
    }
}

// [v2.58.0 WIZLIVE-INSTRUCTION, mirrors CHARCHAT's buildCharChatInstruction] The true-bottom
// instruction for wizard chat. CharChat learned across v2.24.0-v2.51.0 that the only place
// an instruction is reliably obeyed is the TRUE BOTTOM of context — immediately before the
// generation point. WIZLIVE's protocol text (the setup paragraph) sits inside storyText at
// whatever depth NAI's budget trims it to, which means it drifts upward as the chat grows
// and the model progressively ignores it. This function replaces that reliance: the protocol
// paragraph is still useful as a greeting/framing for the USER, but the MODEL's steering now
// comes from here. Mirrors buildCharChatInstruction's four concerns: task, role constraint,
// format constraint, anti-impersonation.
function buildWizardChatInstruction(): string {
    let wlOut: string[] = [];
    // Task + anti-impersonation: tell the model exactly what to write and what NOT to write.
    // "Director" is named explicitly because the model can still see the instruction-brace
    // shape of Director turns even after v2.58.0's header strip, and naming the role it must
    // not produce is the cheapest anti-impersonation clause.
    wlOut.push('[ Instruction: Write the Wizard\u2019s next reply to the Director\u2019s latest message. '
             + 'Reply in conversational prose \u2014 do NOT continue the story text above the chat marker. '
             + 'Write ONLY the Wizard\u2019s response. Never write a "Director:" turn or any text on the Director\u2019s behalf. ]');
    // Format constraint: same "no markdown" rubric the protocol text carries, restated here
    // because it is far more effective at the bottom of context than in a setup paragraph.
    wlOut.push('[ Write in pure prose. No markdown, no bolding, no headers, no bullet lists. ]');
    return wlOut.join('\n');
}

// [FEATURE v2.51.0 WIZLIVE-BRACE-WRAP-T1, per user: "the wizard chat benefits from the same
// auto-bracket wrapping from the first message"] Closes the one-turn lag v2.29.0 documented
// and accepted (see _wizliveNormalizeDocument's header: "One turn of lag on the very first
// message of a session"). Same read-only-twin idea as CharChat's _charchatCanonicalChatText,
// but DELIBERATELY SURGICAL rather than a full region rebuild — this is the difference that
// keeps WIZLIVE's core invariant intact.
// [v2.58.0 WIZLIVE-CTX-STRIP] Now ALSO strips the "Director:" header from the model's view,
// so Director turns appear as plain body text inside NAI's instruction brace. The document
// keeps "Director: body" (the write pass _wizliveNormalizeDocument is unchanged). This is
// the model-view-only anti-impersonation fix: same principle as CHARCHAT-CTX-BRACE v2.42.0.
//
// WHY NOT CHARCHAT'S FULL REBUILD: CharChat rebuilds the entire chat region and drops the
// greeting, so its storyText diverges from the raw document at the TOP of the region. That is
// fine for CharChat (it owns its whole prefix and re-encodes once on enter/exit). WIZLIVE must
// NOT do that: its whole design is that system prompt/memory/lorebook AND the live document
// text reach the model byte-identical to a story turn, so the story prefix cache survives the
// whole chat and story generation resumes without a re-encode (see onBeforeContextBuild's
// WIZLIVE comment and CE-INDEX v2.4.0/v2.29.0). So instead of rebuilding, we take a COPY of
// params.storyText.content and rewrite ONLY the Director turns that are still unwrapped in the
// document (normally just the newest one — earlier turns were wrapped by the prior
// onGenerationEnd's _wizliveNormalizeDocument). Every other byte is untouched, so divergence
// from the cached prefix begins only at the newest turn, which is new text anyway.
//
// SAFETY OF THE IN-PLACE REPLACE: the search is anchored PAST the marker (chat region only,
// never the narrative prefix) and advances a forward cursor in document order, so a short
// Director body cannot collide with earlier prose. If the marker was trimmed out of the
// budgeted storyText, or a raw paragraph does not appear verbatim (whitespace shift), we skip
// that turn and leave it raw — degrading to exactly the pre-fix one-turn-lag behaviour, never
// worse. The DOCUMENT is not mutated here; that still happens post-generation in
// _wizliveNormalizeDocument, race-free. This only changes what the model READS this turn.
async function _wizliveCanonicalStoryOverride(params: any): Promise<string | null> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return null;
    let wcStory = (params && params.storyText && params.storyText.content) ? params.storyText.content : '';
    if (!wcStory) return null;
    let wcMarkIdx = wcStory.indexOf(AE_WIZLIVE_MARKER_TEXT);
    if (wcMarkIdx < 0) return null;   // chat region trimmed out of budget — leave story text as NAI trimmed it
    let wcFrom = wcMarkIdx + AE_WIZLIVE_MARKER_TEXT.length;

    let wcAll: any[] = [];
    try { wcAll = await api.v1.document.scan(); }
    catch (eWc) { api.v1.error('[AE:wizlive] canonical scan failed \u2014 story text left raw this turn:', eWc); return null; }

    let wcSeen = false;
    let wcChanged = false;
    for (let wcR of wcAll) {
        if (wcR.sectionId === _aeLiveWiz.markerId) { wcSeen = true; continue; }
        if (!wcSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wcR.sectionId) >= 0) continue;
        if (!_wizliveRowIsUser(wcR.section)) continue;   // only Director turns get wrapped; Wizard replies pass through untouched
        let wcRaw = (wcR.section.text || '');
        if (!wcRaw.trim()) continue;
        // [v2.53.0 WIZLIVE-BRACE-DOUBLE] Bare, header-led form matching the write pass.
        // [v2.58.0 WIZLIVE-CTX-STRIP, mirrors CHARCHAT-CTX-BRACE v2.42.0] MODEL'S VIEW
        // strips the "Director:" header entirely. The DOCUMENT keeps "Director: body" (the
        // write pass is unchanged), but in context the model sees only the bare body text
        // inside NAI's own instruction brace. This is the structural anti-impersonation
        // fix: a model that never sees "Director:" in the transcript has no prefix to
        // continue when it wants to start the user's next turn. CharChat learned this at
        // v2.42.0 (removing literal braces from the model's view of POV turns); same
        // principle, same result.
        let wcBody = _wizliveStripDirectorHeader(_wizliveStripBraces(wcRaw));
        if (!wcBody) continue;
        if (wcBody === wcRaw) continue;                   // already bare in the document — model already sees it right
        let wcIdx = wcStory.indexOf(wcRaw, wcFrom);       // anchored past the marker, advancing in document order
        if (wcIdx < 0) continue;                          // trimmed / whitespace-shifted — degrade to raw (no worse than pre-fix)
        wcStory = wcStory.substring(0, wcIdx) + wcBody + wcStory.substring(wcIdx + wcRaw.length);
        wcFrom = wcIdx + wcBody.length;
        wcChanged = true;
    }
    return wcChanged ? wcStory : null;
}

// Walk the document from the marker down and rebuild the conversation. Role mapping:
// instruction-source paragraphs are user turns (NAI's { } instruct blocks); anything
// whose origin metadata is entirely user/edit-typed is also treated as a user turn
// (they forgot the braces); everything else is the wizard. Consecutive wizard
// paragraphs merge into one turn. Engine-authored setup paragraphs are excluded.
async function collectLiveWizTranscript(): Promise<{ msgs: WizardChatMessage[]; ids: number[] }> {
    let out: WizardChatMessage[] = [];
    let ids: number[] = [];
    if (_aeLiveWiz.markerId === null) return { msgs: out, ids: ids };
    let all = await api.v1.document.scan();
    let seen = false;
    for (let row of all) {
        if (row.sectionId === _aeLiveWiz.markerId) { seen = true; ids.push(row.sectionId); continue; }
        if (!seen) continue;
        ids.push(row.sectionId);
        if (_aeLiveWiz.setupIds.indexOf(row.sectionId) >= 0) continue;
        let txt = (row.section.text || '').trim();
        if (!txt) continue;
        let isUser = _wizliveRowIsUser(row.section);
        if (isUser) {
            out.push({ role: 'user', content: _wizliveStripBraces(txt) });
        } else if (out.length > 0 && out[out.length - 1].role === 'assistant') {
            out[out.length - 1].content += '\n' + txt;
        } else {
            out.push({ role: 'assistant', content: txt });
        }
    }
    return { msgs: out, ids: ids };
}

// Run one distillation pass over the live transcript and RETURN the text without
// committing anything. The modal shows it as an editable preview the user can then
// save to the lorebook (or ignore). Replaces the old auto-commit "summarize" action.
async function previewSummarizeLiveChat(): Promise<string> {
    let collected = await collectLiveWizTranscript();
    if (collected.msgs.length === 0) return '';
    let sTranscript = collected.msgs.map(function(m) { return (m.role === 'user' ? 'USER: ' : 'WIZARD: ') + m.content; }).join('\n');
    let sOut = await executeYoinkGeneration([
        { role: 'system', content: 'Distill the following worldbuilding chat into dense, declarative canon statements suitable for a lorebook entry. Keep only established facts and decisions \u2014 drop questions, hedges, and conversational filler. Write in pure prose or short single-line statements. No markdown, no headers, no bullet lists. Be concise.' },
        { role: 'user', content: sTranscript }
    ], { tag: 'liveWizSummarize' });
    return (sOut || '').trim();
}

async function endLiveWizardChat(action: string): Promise<void> {
    if (!_aeLiveWiz.active) { api.v1.ui.toast('No wizard chat is open.', { type: 'warning', autoClose: 2500 }); return; }
    let act = (action === 'discard') ? 'discard' : 'save';

    let collected = await collectLiveWizTranscript();
    let msgs = collected.msgs;

    // Save FIRST, destroy LAST — a save failure returns early leaving the chat intact
    // in the document, so nothing is ever lost to a half-completed end.
    if (act === 'save' && msgs.length > 0) {
        try {
            let title = (_aeLiveWiz.title || '').trim() || 'Wizard Chat';
            await upsertChatEntry(_aeLiveWiz.sourceEntryId, title, msgs, _aeLiveWiz.topicId);
            api.v1.ui.toast('Chat saved to the CE Chats lorebook.', { type: 'success', autoClose: 3000 });
        } catch (eS) {
            api.v1.error('[AE:wizlive] lorebook save failed:', eS);
            api.v1.ui.toast('Save failed \u2014 the chat is still in your document, nothing was removed.', { type: 'error', autoClose: 5000 });
            return;
        }
    }

    // Switch this session's context entries back off so story mode returns to its exact
    // pre-chat prefix (preserving the story-generation cache).
    if (_aeLiveWiz.contextEntryIds && _aeLiveWiz.contextEntryIds.length > 0) {
        try { await setContextEntriesActivation(_aeLiveWiz.contextEntryIds, false); }
        catch (eCtx) { api.v1.error('[AE:wizlive] context deactivation failed:', eCtx); }
    }

    // Remove the chat region, marker included, in one call.
    try {
        if (collected.ids.length > 0) await api.v1.document.removeParagraphs(collected.ids);
    } catch (eR) { api.v1.error('[AE:wizlive] paragraph removal failed \u2014 clean up manually from the marker down:', eR); }

    try { api.v1.editor.decorations.removeRules([AE_WIZLIVE_RULE_MARKER, AE_WIZLIVE_RULE_USER, AE_WIZLIVE_RULE_WIZ]); } catch (_eDr) {}

    // Restore pinned generation params (same field-by-field shape as the WIZMODE restore).
    if (_aeLiveWiz.paramSnapshot) {
        try {
            let ps: any = _aeLiveWiz.paramSnapshot;
            let r: any = { model: ps.model };
            if (ps.max_tokens !== undefined) r.max_tokens = ps.max_tokens;
            if (ps.temperature !== undefined) r.temperature = ps.temperature;
            if (ps.top_p !== undefined) r.top_p = ps.top_p;
            if (ps.top_k !== undefined) r.top_k = ps.top_k;
            if (ps.frequency_penalty !== undefined) r.frequency_penalty = ps.frequency_penalty;
            if (ps.presence_penalty !== undefined) r.presence_penalty = ps.presence_penalty;
            if (ps.min_p !== undefined) r.min_p = ps.min_p;
            await api.v1.generationParameters.update(r);
        } catch (eRe) { api.v1.error('[AE:wizlive] param restore failed:', eRe); }
    }

    _aeLiveWiz = { active: false, markerId: null, setupIds: [], topicId: '', paramSnapshot: null, startedAt: 0, sourceEntryId: null, contextEntryIds: [], title: '' };
    try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_eRm) {}
    api.v1.ui.toast('Wizard chat closed \u2014 story mode restored.', { type: 'success', autoClose: 3000 });
    await broadcastWizLiveState();
}

// Startup rehydration: a chat left open in this story (script reload, tab close)
// comes back live IF its marker paragraph still exists; otherwise the stale state
// is cleared and any pinned params restored from the persisted snapshot. Context
// entries stay Always-On across a reload (lorebook state is story-scoped and
// persistent) and are only switched off when the chat is finally ended.
async function restoreLiveWizOnStartup(): Promise<void> {
    let raw = '';
    try { raw = (await api.v1.storyStorage.getOrDefault(STORAGE_WIZLIVE, '')) as string; } catch (_e0) {}
    if (!raw) return;
    let st: any = null;
    try { st = JSON.parse(raw); } catch (_e1) { st = null; }
    if (!st || !st.active || typeof st.markerId !== 'number') {
        try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_e2) {}
        return;
    }
    let ids: number[] = [];
    try { ids = await api.v1.document.sectionIds(); } catch (_e3) {}
    if (ids.indexOf(st.markerId) < 0) {
        if (st.paramSnapshot) {
            try {
                let rp: any = { model: st.paramSnapshot.model };
                if (st.paramSnapshot.max_tokens !== undefined) rp.max_tokens = st.paramSnapshot.max_tokens;
                await api.v1.generationParameters.update(rp);
            } catch (_e4) {}
        }
        // Stale marker: make sure any leftover Always-On context entries are switched off.
        if (Array.isArray(st.contextEntryIds) && st.contextEntryIds.length > 0) {
            try { await setContextEntriesActivation(st.contextEntryIds, false); } catch (_e4b) {}
        }
        try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_e5) {}
        aeLog('[AE:wizlive] stale chat state cleared (marker no longer in document).');
        return;
    }
    _aeLiveWiz = {
        active: true,
        markerId: st.markerId,
        setupIds: Array.isArray(st.setupIds) ? st.setupIds : [],
        topicId: st.topicId || '',
        paramSnapshot: st.paramSnapshot || null,
        startedAt: st.startedAt || Date.now(),
        sourceEntryId: (typeof st.sourceEntryId === 'string') ? st.sourceEntryId : null,
        contextEntryIds: Array.isArray(st.contextEntryIds) ? st.contextEntryIds : [],
        title: (typeof st.title === 'string' && st.title) ? st.title : 'Wizard Chat'
    };
    try { await _wizliveRegisterDecorations(st.markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration restore failed (cosmetic only):', eD); }
    api.v1.ui.toast('Wizard chat still open in this story \u2014 continue below the marker or end it from the World-Build Wizard.', { type: 'info', autoClose: 6000 });
    await broadcastWizLiveState();
}
// ── [v2.4.0 WIZLIVE] end ──────────────────────────────────────────────────────

// ============================================================================
// SECTION 3f — CHARACTER CHAT (CHARCHAT)
// [v2.21.0 CHARCHAT] IN-STORY CHARACTER CHAT (P1 — engine core)
// ----------------------------------------------------------------------------
// A texting-style conversation with ONE character, held in the document tail,
// driven by NAI's own Send/generate path. Modeled on WIZLIVE (marker paragraph +
// instruct-block turns + param pin + strip-on-end) but with one decisive
// difference: WIZLIVE deliberately leaves the top of context untouched to
// preserve the story prefix cache, whereas CHARCHAT OWNS THE WHOLE PROMPT.
//
// While a chat is active, runCharChatContextOverride() replaces, per generation:
//   systemPrompt  chat framing + "you are X" + X's folded lorebook identity +
//                 X's dynamic block + X's persona register.  (top of context)
//   lorebook      EVERY character-linked entry deactivated — both participants'
//                 (already folded into the system prompt above, so leaving them
//                 on would duplicate) and everyone else's (the persona-bleed
//                 guard: only the two chat participants are scene-present, so
//                 the NPC web between them surfaces naturally). NON-character
//                 entries (locations, factions, world lore) are left alone.
//   authorsNote   REPURPOSED as the contact's ephemeral/emotional state. Not
//                 suppressed — the AN is a near-bottom injection slot and this is
//                 exactly the sort of recency-weighted content it is for. Note it
//                 lands at the user's configured depth (~3 paragraphs from the
//                 end), i.e. INSIDE recent chat history, not after it; that is why
//                 the next-message instruction uses storyText instead.
//   storyText     "[ NARRATIVE CONTEXT ]" header prepended; the next-message
//                 instruction APPENDED (true bottom, invisible in the document).
//
// COST: overriding the system prompt changes the top of context, so the story
// prefix cache is invalidated on entering and again on exiting. That cost is
// PER-SESSION, not per-turn — mid-chat the sys prompt/memory/lorebook are
// constant and only the tail grows, so the cache behaves normally from turn 2.
// Reasoned from how prefix caching works generally, NOT from an NAI-specific
// citation — if latency/cost looks wrong in testing, look here first.
//
// NO CONTEXT POISONING: story generation cannot run while a chat is open, so any
// generation firing while _aeCharChat.active IS a chat turn, which is what makes
// applying the override unconditionally safe. That guarantee rests on the
// mutual-exclusion guards (in startCharChat / startLiveWizardChat /
// resumeLiveWizardChatFromEntry / aeSetWizardMode) plus the fact that ending a
// chat strips every chat paragraph, returning the document byte-identical.
// The override is applied on the dryRun pass too, so NAI's context viewer shows
// the real chat context — that is the debugging window for this whole subsystem.
//
// NOT IN P1 (do not assume these exist): persona-register editor/generator (P3),
// Save/Summarize to a "CE Character Chats" lorebook category + its cached-id
// storage key (P4 — deliberately NOT declared here, a key with no reader is the
// dead code this project keeps cutting), activation modes (P4). Decoration bubble
// polish (was P5) and a bridge header presence (was planned as P6's HUD panel, built
// instead as bridge v2.14.0's smaller dropdown) are DONE as of v2.47.0/bridge v2.14.0.
// endCharChat therefore ships DISCARD ONLY.
// ============================================================================
interface CharChatState {
    active: boolean;
    markerId: number | null;        // sectionId of the boundary marker paragraph
    setupIds: number[];             // engine-authored setup paragraphs (excluded from the transcript)
    // [v2.46.0 CHARCHAT-SHELL-BASELINE] stagedPovIds DELETED. It recorded the ids of POV turns
    // the ENGINE or the BRIDGE authored, because origin metadata cannot tell an engine-written
    // POV turn from an engine-written contact reply (both are 'script'). With ops 'stage',
    // 'send' and 'povclaim' gone, nothing outside NAI writes a POV turn, so there is nothing to
    // record and the premise of the field is gone with its writers. This is the deletion
    // v2.34.0's own index entry called for in advance: "If bridge text is ever made genuinely
    // user-origin, stagedPovIds becomes redundant and should be deleted, not left lying."
    // Classification reverts to _charchatRowIsPov's origin rule — the v2.31.0 behaviour, which
    // is the last one the user confirmed formatted correctly and the one that ran for every
    // version before a bridge started writing paragraphs.
    // *** THE ONE THING TO WATCH ON FIRST LIVE TEST *** this field existed to prevent the
    // "{ {Nate: ...} }" / "{ {Nate: Emotion: neutral} }" corruption class. It is only safe to
    // remove because the user genuinely types now. If that corruption reappears, the origin
    // rule is not seeing 'user' on typed text and THIS is the first place to look — do not
    // reinstate the field without first logging what NAI actually stamps.
    // Saved state from before this version still carries the key; rehydration simply no longer
    // reads it, so there is no migration and no throw.
    // [v2.38.0 CHARCHAT-THINK-FIRST] What this subsystem is doing RIGHT NOW, for the
    // bridge's status line: '' | 'thinking' | 'replying' | 'image'. Deliberately NOT
    // persisted anywhere — it describes an in-flight call, so a copy that survived a
    // reload could only ever be a lie. Broadcast-only state; saveCharChatState never
    // reads it back in because there is nothing to restore.
    busyStage: string;
    // [v2.45.0 CHARCHAT-THOUGHT-POST] thoughtPass / thoughtAnchorIds DELETED with the
    // v2.39.0-v2.44.1 native-thought design. Nothing reads them; the thought no longer rides
    // NAI's own generation, so there is no pass to flag and nothing written to the document to
    // anchor against. Old saved state may still carry both keys \u2014 harmless: restoreCharChat
    // OnStartup rebuilds this object field by field and simply never looks at them.
    contactId: string;              // the character being texted \u2014 the model speaks AS this one
    contactName: string;            // denormalized so context assembly needs no character load on the hot path
    povId: string;                  // [v2.29.0, REVERSES the old LOCKED DECISION] whose phone this is, AND now the second half of the saved-thread partition key (see charChatEntryId) — no longer label-only. '' = unset ("No POV" bucket, back-compat with pre-v2.29.0 threads).
    povName: string;
    paramSnapshot: any;             // generationParameters snapshot restored on end (persisted so a reload can still restore)
    startedAt: number;
    lastEmotion: string;            // [v2.21.0] last parsed Emotion: tag \u2014 diagnostic/bridge only; the tag itself stays in the document
}
var _aeCharChat: CharChatState = { active: false, markerId: null, setupIds: [], busyStage: '', contactId: '', contactName: '', povId: '', povName: '', paramSnapshot: null, startedAt: 0, lastEmotion: '' };
// [v2.37.0 CHARCHAT-DOM-INJECT] _aeCharChatDraft REMOVED with v2.36.0's commit-on-Send.
// The draft never reaches the engine at all now: the bridge holds it in its own memory and
// injects it into NAI's editor at pointerdown on NAI's Send (see the CE-INDEX). The engine
// only learns about the turn afterwards, via op 'povclaim', by which point it is already
// real document text NAI itself committed.

// [v2.45.0 CHARCHAT-ARM-CANCEL] The in-flight post-reply thought's cancellation signal, or
// null when none is running. A bare module var and deliberately NOT on CharChatState: it
// describes a call that is happening right now, so a copy that survived a reload could only
// be a lie (same reasoning as busyStage, which is also never persisted). Set by
// generateChatEphemeral for the life of its api.v1.generate() call and cleared in its finally;
// read ONLY by op 'arm', which cancels it because a Send is imminent. See the CE-INDEX
// v2.45.0 block for why a cancel and not a hope that the sequence is serial.
var _ccThoughtSignal: any = null;

// [DIAG v2.59.0 CHARCHAT-MERGE-RACE / CHARCHAT-RACE-DIAG, per user report: sometimes no
// reply to the first message in a chat, and a suspicion that the busy/thinking indicator
// clears before it is actually safe to Send again] One shared timestamp + logger used by
// every checkpoint in the post-reply lifecycle (reply landed -> thinking stage -> thought
// settled -> image stage -> images settled -> busy cleared -> ghost signal on/off -> next
// Send's 'arm' op), all under ONE tag so the console shows a single ordered timeline with
// the gap between each step.
// [CORRECTED v2.61.0, per user's live log] v2.60.0 wrongly declared CHARCHAT-MERGE-RACE
// ruled out. It is NOT — it is CONFIRMED, just with a longer settle window than the single
// 150ms retry tested. Live evidence: a turn's split-pass found "0 split" on BOTH the first
// scan AND the retry (150ms apart), yet a SEPARATE, LATER document.scan() (the empty-reply
// dump, itself running some hundreds of ms further out in the same handler) found the full
// reply text already present. NAI was still actively writing the reply's paragraphs when
// both split-pass scans ran; a single fixed retry is not patient enough. See
// _charchatSplitMergedSections' own v2.61.0 CHARCHAT-SETTLE-POLL rewrite below, which
// replaces the fixed retry with a bounded poll against the EXPECTED growth for a real turn,
// not mere pass-to-pass agreement (two scans can wrongly agree "nothing changed" if NAI
// simply hadn't started writing by either of them). CHARCHAT-RACE-DIAG's OWN hypothesis
// (busy indicator clearing too early) still looks genuinely ruled out — arm events keep
// arriving many seconds after busyStage clears, nowhere near a slot-release race — so the
// race-diag marks stay purely as supporting context now, not the leading suspect.
var _ccRaceDiagLastAt: number = 0;
function _ccRaceDiagMark(label: string): void {
    let ccNow = Date.now();
    let ccElapsed = _ccRaceDiagLastAt ? (ccNow - _ccRaceDiagLastAt) : 0;
    aeLog('[AE:charchat:race-diag] ' + label + ' (+' + ccElapsed + 'ms since last mark)');
    _ccRaceDiagLastAt = ccNow;
}

// [DIAG v2.60.0 CHARCHAT-EMPTY-REPLY-DIAG, per user: "nothing is showing in the story editor
// when a response never happens"] Tracks the non-setup section count left behind by the LAST
// successful turn. A real turn always adds AT LEAST 2 new sections by the time
// _charchatSplitMergedSectionsPass has run (the Director's own paragraph, plus the reply —
// merged-and-split counts as 2 same as separately-generated).
// [CORRECTED v2.61.0] This fired a CONFIRMED FALSE POSITIVE: the dump it produced showed the
// reply text fully present and correctly formed — the diagnostic's OWN comparison scan simply
// ran too early, before NAI had finished writing (see CHARCHAT-MERGE-RACE above). The
// v2.61.0 settle-poll rewrite feeds this check a section count that has already waited for
// the expected growth (or genuinely given up after a bounded number of attempts), which
// should make a real firing of this diagnostic much more trustworthy going forward — a firing
// now means the settle-poll itself gave up, not that a single short check happened to run
// early. -1 sentinel skips the check on the very first turn of a chat (no prior baseline
// exists yet). Bare module var, not on CharChatState, for the same reason _ccThoughtSignal
// isn't: it describes the state of THIS session's most recent turn, and a value that survived
// a reload would be a stale lie — reset to -1 on start/resume/end. TEMPORARY: remove once
// CHARCHAT-EMPTY-REPLY-DIAG is closed.
var _ccLastSeenSectionCount: number = -1;

// [DIAG v2.63.0 CHARCHAT-RESP-DIAG] The blind spot every previous diagnostic in this arc
// worked AROUND instead of through. CHARCHAT-RACE-DIAG watches the turn lifecycle,
// CHARCHAT-EMPTY-REPLY-DIAG watches the document afterwards — but nothing has ever watched
// the one place the reply text physically passes through on its way from NAI to the page:
// the onResponse hook. Every conclusion of the form "NAI generated nothing" has been an
// INFERENCE from an absence downstream, and it cannot distinguish the two cases that need
// different fixes:
//     calls === 0                 -> the model really did return nothing. Prompt/transport.
//     calls > 0, finalSeen false  -> text WAS delivered and we deferred it with
//                                    seenData:false, and the final call that was supposed to
//                                    re-deliver it never arrived. WE lost the reply.
// The second case has been flagged UNVERIFIED in onResponse's own comment since v2.21.0 and
// has never been tested. These four vars answer it in one turn.
// Keyed by continuityId so a stale count from the previous turn can never be misread as this
// turn's: onGenerationEnd compares its own continuityId against _ccRespCid and reports
// "onResponse never fired" when they differ, rather than reprinting old numbers.
var _ccRespCid: string = '';
var _ccRespCalls: number = 0;
var _ccRespBest: string = '';       // longest text seen this turn — seenData:false re-delivery is cumulative (script-types: "the same data in addition to any new data"), so longest === most complete
var _ccRespFinalSeen: boolean = false;

const AE_CHARCHAT_RULE_MARKER = 'ae-charchat-marker';
const AE_CHARCHAT_RULE_POV    = 'ae-charchat-pov';      // POV turns — right-justified bubble
const AE_CHARCHAT_RULE_CONTACT= 'ae-charchat-contact';  // the character's replies — left-justified bubble
// [v2.47.0 CHARCHAT-BUBBLES] INLINE, not node: the Emotion: line is the SECOND LINE of the
// SAME section as the reply body (see CHARCHAT_EMOTION_PREFIX's own comment — one section,
// two lines), so it cannot get its own node-level box. A node rule styles the whole
// paragraph; this inline rule styles only the substring its `match` pattern finds within
// that same paragraph, layered on top of the CONTACT node rule's bubble. Per user: "emotions
// become a subtle tagline after the bubble - not their own [bubble]."
const AE_CHARCHAT_RULE_EMOTION= 'ae-charchat-emotion';
// [v2.48.0 CHARCHAT-IMGWIDGET] The one string both artifacts must agree on. The bridge
// greps for this exact prefix with a TreeWalker (grep AE_CHARCHAT_IMG_SENTINEL there too
// — it is duplicated as a literal, since the two files share no module). Changing it
// is a flag-day: change BOTH or chat photos silently stop binding.
// [v2.49.0 CHARCHAT-BUBBLES2] Three more rules, all forced by one live finding: NAI
// SPLITS a section whose text contains '\n' into separate sections. _charchatFormatReply
// writes "Name: body" + '\n' + "  Emotion: word" as ONE updateParagraph call, and v2.47.0
// assumed that stayed one section with two lines (CHARCHAT_EMOTION_PREFIX's own comment
// says as much). It does not. The emotion line lands as its OWN section, inherits the
// CONTACT node rule, and renders as its own separate bubble — which is exactly what the
// user reported ("I'd prefer the emotion tags included in the bubble above them instead of
// getting their own").
//   _HEAD    a contact bubble that IS followed by an emotion line: flat bottom, no bottom
//            border, no bottom margin — so it butts against the tail below it.
//   _EMOBOX  the emotion line's own section: flat top, no top border, no top margin, same
//            background. HEAD + EMOBOX together read as ONE bubble with a tagline in it.
//   _NAME    hides the "Name: " prefix, per user ("we won't need the name headers
//            displayed"). Inline + display:none: the text STAYS in the document, which is
//            non-negotiable — _charchatRowIsPov, the transcript walk, and the save format
//            all read it. This hides it; it does not remove it.
const AE_CHARCHAT_RULE_HEAD   = 'ae-charchat-head';
const AE_CHARCHAT_RULE_EMOBOX = 'ae-charchat-emobox';
const AE_CHARCHAT_RULE_NAME   = 'ae-charchat-name';
// [v2.51.1 CHATIMG-HIDE-TAG, per user] Hides the resolved/unresolved "[Image#hex: desc]"
// tag text in a chat bubble. The tag STAYS in the document (it is the durable pointer —
// see _charchatImageRx's note) but is the raw image PROMPT, which the user should not see:
// the bridge paints the real photo from a separate widget anchor. display:none, same
// mechanism as AE_CHARCHAT_RULE_NAME hiding the "Name:" prefix.
const AE_CHARCHAT_RULE_IMGTAG = 'ae-charchat-imgtag';
const AE_CHARCHAT_IMG_SENTINEL = 'ce-chatimg:';

// ── [v2.177.0 CHAT-BUBBLE-AXES, per user] Bubble LOOK as composable axes ─────
// "I want to be able to provide a variety of style options so they could make it feel like
// a chat, terminal, scrying, telepathy, script, etc., but not the presets -- the options
// through color, shape, surface, effects."
//
// WHAT REPLACED WHAT. v2.174.0's CE_CHAT_BUBBLE_DEFS was five fixed tuples; a sixth look
// cost a sixth entry and anything BETWEEN two of them was unreachable. The five are now
// COORDINATES in a space of seven axes rather than points on a list, and the space is what
// ships. The old ids survive only in _ceCbMigrateSeed, which reads each one exactly once.
//
// THE API MAKES THIS POSSIBLE AND IT IS WORTH RECORDING WHY. DecorationRule.style is typed
// `Record<string, string>` in script-types.txt -- there is NO property whitelist. Any CSS
// declaration reaches the paragraph box, which is what lets Depth ship a two-part boxShadow
// plus a textShadow and lets Fill ship backdropFilter. The limit on this system is the seam
// below, not the API.
//
// WHAT AN AXIS IS ALLOWED TO CHANGE, and this is the same line v2.174.0 drew, redrawn one
// step further out. HEAD and EMOBOX are two SEPARATE paragraphs faking one bubble, and they
// only read as one while their box widths and HORIZONTAL PADDING agree exactly. v2.174.0
// concluded from that "a preset cannot change padding" and froze it at 12px. THAT WAS ONE
// STEP TOO STRONG: the seam requires HEAD and EMOBOX to agree WITH EACH OTHER, not to agree
// with 12. So Corner sets padX and applies it to all four rules at once, which is what lets
// Pill exist at all -- a 22px radius against 12px padding eats the first and last glyph of
// every line (reported). Alignment and max-width remain frozen: the avatar owns the lane
// the contact bubble's max-width leaves open, and moving either without the other is what
// pass 2 is for.
//
// AXES ARE NOT FULLY INDEPENDENT AND THE COMPILER SAYS SO OUT LOUD. Depth's box half needs
// a box: with Frame 'none' there is no border and no fill for a boxShadow to sit on, so
// bloom degrades to its textShadow alone rather than silently doing nothing. Corner and
// Fill are meaningless without a frame for the same reason. Those dependencies are declared
// on CE_CB_FRAME (`fill`, `edge`, `notch`, `corner`) and read BOTH by this builder and by
// the Chat surface, so the controls that would lie are not rendered at all.
//
// EVERY COLOUR IS COMPUTED FROM A HEX, NOT WRITTEN AS A LITERAL. v2.174.0's var(--token,
// literal) pairs were the fix for CE-STRIP deleting the bridge stylesheet, and the lesson
// holds -- but a var() cannot carry a user's chosen hue. The tokens therefore move OUT of
// the per-side colours (which are now user data) and stay only where they name a FAMILY
// rather than a value: the three font stacks. _ceCbRgba emits a plain rgba() that cannot
// compute to unset, which is strictly safer than what it replaces.

interface ChatFrameDef  { label: string; fill: boolean; edge: string; notch: boolean; corner: boolean; }
interface ChatCornerDef { label: string; r: string; n: string; padX: string; }

// FRAME -- what kind of box a turn is. `edge` names WHERE a border may go, which is the one
// thing that separates rule from underline from card; `corner` and `fill` are the gates.
var CE_CB_FRAME: { [k: string]: ChatFrameDef } = {
    bubble:    { label: 'Bubble',    fill: true,  edge: 'all',    notch: true,  corner: true  },
    card:      { label: 'Card',      fill: true,  edge: 'all',    notch: false, corner: true  },
    rule:      { label: 'Rule',      fill: false, edge: 'side',   notch: false, corner: false },
    underline: { label: 'Underline', fill: false, edge: 'bottom', notch: false, corner: false },
    none:      { label: 'None',      fill: false, edge: 'none',   notch: false, corner: false }
};

// CORNER -- radius, the speaker-side notch, AND the horizontal padding that keeps text off
// the curve. padX rises with r for the reason in the header note; it is applied identically
// to pov, contact, head and emobox, so the seam cannot notice.
var CE_CB_CORNER: { [k: string]: ChatCornerDef } = {
    sharp: { label: 'Sharp', r: '2px',  n: '2px', padX: '12px' },
    soft:  { label: 'Soft',  r: '6px',  n: '5px', padX: '12px' },
    round: { label: 'Round', r: '16px', n: '5px', padX: '14px' },
    pill:  { label: 'Pill',  r: '22px', n: '6px', padX: '20px' }
};

// FILL -- one alpha applied to the side's own hue. `blur` is backdropFilter, and it is the
// one value here whose result is not guaranteed: it composites against whatever NAI paints
// behind the editor, which this script cannot see. Labelled as experimental in the surface
// rather than promised.
var CE_CB_FILL: any = {
    solid:   { label: 'Solid',              a: 0.30, blur: false },
    tint:    { label: 'Tint',               a: 0.16, blur: false },
    wash:    { label: 'Wash',               a: 0.07, blur: false },
    frosted: { label: 'Frosted (beta)',     a: 0.14, blur: true  },
    none:    { label: 'None',               a: 0,    blur: false }
};

var CE_CB_EDGE: any = {
    none:     { label: 'None',     w: '0',   a: 0    },
    hairline: { label: 'Hairline', w: '1px', a: 0.42 },
    bold:     { label: 'Bold',     w: '2px', a: 0.55 },
    bright:   { label: 'Bright',   w: '1px', a: 0.88 }
};

var CE_CB_DEPTH: any = {
    flat:  { label: 'Flat'  },
    lift:  { label: 'Lift'  },
    bloom: { label: 'Bloom' },
    inset: { label: 'Inset' }
};

// The three font stacks keep their var(--ae-font-*) hook: those name a FAMILY the bridge is
// allowed to retheme, not a value the user picked.
var CE_CB_TYPE: any = {
    sans:  { label: 'Sans',      font: 'var(--ae-font-sans, system-ui, -apple-system, \u0022Segoe UI\u0022, Roboto, sans-serif)' },
    serif: { label: 'Serif',     font: 'Georgia, \u0022Iowan Old Style\u0022, \u0022Times New Roman\u0022, serif' },
    mono:  { label: 'Monospace', font: 'var(--ae-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace)' }
};

var CE_CB_VOICE: any = {
    normal: { label: 'Normal', extra: {} },
    italic: { label: 'Italic', extra: { fontStyle: 'italic' } },
    wide:   { label: 'Wide',   extra: { letterSpacing: '0.06em', lineHeight: '1.62' } },
    tight:  { label: 'Tight',  extra: { letterSpacing: '-0.01em', fontSize: '0.94em' } }
};

// LANE -- the ONE axis that is geometry, and the only reason it is allowed to be one is
// that it moves the bubble and the AVATAR TOGETHER. v2.177.0 froze width and alignment
// because bridge CSS pinned the avatar at calc(89% - size/2) -- 89 being 78 + (100-78)/2,
// the centre of the band a 78% bubble leaves on the RIGHT -- so widening the bubble alone
// put the avatar on top of the text. That number is now DERIVED and pushed across with
// everything else (see _charchatBubbleTokens), which is what makes this safe.
//
//   inset  what shipped: the bubble stops at `width` and the avatar sits in what is left.
//   full   per user ("you could make the bubble visually a whole row while keeping the
//          text from touching the avatar"): the BOX runs the full column and the avatar
//          lane is reserved as PADDING inside it. The fill goes edge to edge; the text
//          stops short of the portrait. Reserved on the contact side only -- POV turns
//          get no avatar (enforced upstream), so spending the lane there would be a
//          margin nothing occupies.
//
// `width` STILL APPLIES UNDER inset AND IS IGNORED UNDER full, which is why the surface
// hides it in that mode rather than leaving a control that sets nothing.
var CE_CB_LANE: any = {
    inset: { label: 'Inset' },
    full:  { label: 'Full row' }
};

// PALETTE is a PAIR, because the two sides are only legible as a pair -- picking them
// independently is how you get two hues nobody can tell apart at 16% alpha. The custom hex
// overrides below exist for exactly the case this table cannot serve.
var CE_CB_PALETTE: any = {
    signal: { label: 'Signal',     pov: '#4a9ed9', them: '#f0f0f5' },
    ember:  { label: 'Ember',      pov: '#e8c07d', them: '#c9a2a2' },
    aether: { label: 'Aether',     pov: '#5ec4ff', them: '#e084ff' },
    moss:   { label: 'Moss',       pov: '#7cffb0', them: '#e8c07d' },
    vellum: { label: 'Vellum',     pov: '#e8c07d', them: '#f0f0f5' },
    tide:   { label: 'Tide',       pov: '#4ad9c4', them: '#9a8ce0' },
    dusk:   { label: 'Dusk',       pov: '#9370db', them: '#d98a8a' },
    mono:   { label: 'Monochrome', pov: '#f0f0f5', them: '#f0f0f5' }
};

// ACCENT is the THIRD colour and it is deliberately separate from the pair: it paints the
// CHARACTER CHAT marker band and the Emotion tagline, neither of which belongs to a side.
var CE_CB_ACCENT: any = {
    amber:  { label: 'Amber',  hex: '#e8a04a' },
    blue:   { label: 'Blue',   hex: '#4a9ed9' },
    green:  { label: 'Green',  hex: '#7cffb0' },
    violet: { label: 'Violet', hex: '#9370db' },
    rose:   { label: 'Rose',   hex: '#e0748c' },
    cyan:   { label: 'Cyan',   hex: '#5ec4ff' },
    bone:   { label: 'Bone',   hex: '#d8d8de' }
};

// SEEDS ARE BUTTONS, NOT MODES, and that distinction is the whole point. A seed WRITES the
// nine axis values and then has no further existence: nothing stores which seed was used,
// nothing reads it back, and changing one axis afterwards does not "leave" a preset because
// there was never a preset to be in. 29,000 combinations with no starting position is a
// worse offer than a list; this is both.
var CE_CB_SEEDS: any = {
    chat:      { label: 'Chat',      frame: 'bubble',    corner: 'round', fill: 'tint',    edge: 'hairline', depth: 'lift',  type: 'sans',  voice: 'normal', palette: 'signal', accent: 'amber', lane: 'inset' },
    terminal:  { label: 'Terminal',  frame: 'rule',      corner: 'sharp', fill: 'none',    edge: 'bold',     depth: 'flat',  type: 'mono',  voice: 'tight',  palette: 'moss',   accent: 'green', lane: 'inset' },
    scrying:   { label: 'Scrying',   frame: 'bubble',    corner: 'soft',  fill: 'frosted', edge: 'bright',   depth: 'bloom', type: 'serif', voice: 'wide',   palette: 'aether', accent: 'violet', lane: 'inset' },
    telepathy: { label: 'Telepathy', frame: 'none',      corner: 'sharp', fill: 'none',    edge: 'none',     depth: 'bloom', type: 'serif', voice: 'italic', palette: 'dusk',   accent: 'violet', lane: 'inset' },
    script:    { label: 'Script',    frame: 'underline', corner: 'sharp', fill: 'none',    edge: 'hairline', depth: 'flat',  type: 'mono',  voice: 'normal', palette: 'mono',   accent: 'bone', lane: 'inset' },
    paper:     { label: 'Paper',     frame: 'card',      corner: 'soft',  fill: 'wash',    edge: 'none',     depth: 'flat',  type: 'serif', voice: 'wide',   palette: 'vellum', accent: 'amber', lane: 'inset' },
    plain:     { label: 'Plain',     frame: 'none',      corner: 'sharp', fill: 'none',    edge: 'none',     depth: 'flat',  type: 'sans',  voice: 'normal', palette: 'mono',   accent: 'amber', lane: 'inset' }
};

// Every v2.174.0 preset id maps to the seed that reproduces it.
//
// THE MIGRATION IS A READ, NOT A WRITE, and that is the whole of it -- there is no guard
// flag, no one-shot, and nothing is rewritten in anybody's config. ceChatBubbleDisplay
// resolves the SEED FIRST and then uses that seed's values as the per-axis defaults, so a
// config carrying charChatBubbleStyle:'neon' and no axis fields resolves to Scrying by
// arithmetic rather than by having been converted. A fresh config has neither and lands on
// 'chat', which is byte-identical to what 'messages' produced.
//
// WHY THAT IS BETTER THAN A WRITE MIGRATION HERE: it is idempotent by construction, it
// cannot half-apply, it needs no STORYIMG-DEFAULT-ON style reseed guard, and the moment
// the user touches ANY axis the real field is written and wins from then on. The legacy
// key is simply never read again once an axis field exists.
var CE_CB_LEGACY_SEED: any = {
    messages: 'chat', ink: 'paper', terminal: 'terminal', neon: 'scrying', plain: 'plain'
};

var CE_CHAT_BUBBLE_WIDTHS: number[] = [66, 78, 88];

// ceChatSetBubble's field name -> the GlobalConfig key it writes. A MAP RATHER THAN AN
// IF-CHAIN specifically so the Chat surface and the writer cannot drift: the surface names
// a field, this decides where it lands, and a typo is an undefined lookup that refuses the
// write instead of silently creating a config key nothing reads. 'seed' is deliberately
// ABSENT -- it writes nine keys at once and is handled before this is consulted.
var CE_CB_FIELD_KEY: any = {
    frame:   'charChatBubbleFrame',   corner:  'charChatBubbleCorner',
    fill:    'charChatBubbleFill',    edge:    'charChatBubbleEdge',
    depth:   'charChatBubbleDepth',   type:    'charChatBubbleType',
    voice:   'charChatBubbleVoice',   palette: 'charChatBubblePalette',
    accent:  'charChatBubbleAccent',  lane:    'charChatBubbleLane',
    povHex:  'charChatPovColor',      themHex: 'charChatContactColor',
    accHex:  'charChatAccentColor',   ink:     'charChatBubbleInk'
};

// -- Colour primitives --------------------------------------------------------------------
// A BAD HEX RESOLVES TO THE DEFAULT INK RATHER THAN FAILING. The hex fields are free text,
// so 'blue', '#12', and '' all reach here; every one of them has to produce a usable colour
// because the alternative is a chat with no bubbles and no error.
function _ceCbRgb(hex: string): number[] {
    var s = String(hex || '').replace('#', '').trim();
    if (s.length === 3) { s = s.charAt(0) + s.charAt(0) + s.charAt(1) + s.charAt(1) + s.charAt(2) + s.charAt(2); }
    if (!(new RegExp('^[0-9a-fA-F]{6}$')).test(s)) return [233, 233, 236];
    return [parseInt(s.slice(0, 2), 16), parseInt(s.slice(2, 4), 16), parseInt(s.slice(4, 6), 16)];
}

// Plain rgba(), never color-mix() and never a bare var(). An unresolvable var() computes the
// WHOLE declaration to unset (the v2.174.0 lesson), and color-mix has one more parser to
// disagree with; a literal rgba cannot do either.
function _ceCbRgba(hex: string, a: number): string {
    if (!(a > 0)) return 'transparent';
    var c = _ceCbRgb(hex);
    return 'rgba(' + String(c[0]) + ',' + String(c[1]) + ',' + String(c[2]) + ',' + String(a) + ')';
}

// AUTO-CONTRAST, AND ITS ONE ASSUMPTION STATED PLAINLY. The fill is translucent, so the ink
// that reads against it depends on what is BEHIND it -- which this script cannot measure:
// the editor background is NAI's, in the page, and there is no DOM here. So the fill is
// composited against an assumed dark base and the ink is chosen from the result. At every
// alpha this system offers that lands on the light ink almost always, which is correct and
// is exactly today's behaviour; the override is what the assumption being WRONG (a light
// NAI theme, or a near-white custom hue at Solid) is for. It is a text field rather than a
// toggle because "which ink" has more than two right answers.
var CE_CB_BASE_RGB: number[] = [27, 27, 31];
var CE_CB_INK_LIGHT = '#e9e9ec';
var CE_CB_INK_DARK  = '#14141a';

function _ceCbInk(hex: string, alpha: number, override: string): string {
    var ov = String(override || '').trim();
    if (ov) return ov;
    var c = _ceCbRgb(hex);
    var a = (alpha > 0) ? alpha : 0;
    var mixR = (c[0] * a) + (CE_CB_BASE_RGB[0] * (1 - a));
    var mixG = (c[1] * a) + (CE_CB_BASE_RGB[1] * (1 - a));
    var mixB = (c[2] * a) + (CE_CB_BASE_RGB[2] * (1 - a));
    var lum = ((0.2126 * mixR) + (0.7152 * mixG) + (0.0722 * mixB)) / 255;
    return (lum > 0.55) ? CE_CB_INK_DARK : CE_CB_INK_LIGHT;
}

// An id that is not a key of its own table reads as the default. Same contract every other
// resolver in this file follows: a half-written config can never reach the rule builder.
function _ceCbPick(v: any, table: any, dflt: string): string {
    var id = String(v || '');
    return table[id] ? id : dflt;
}

// The one resolver. EVERY read of the bubble config goes through here, including the Chat
// surface's own controls -- which is why the surface can never render a select whose value
// is not one of its options.
function ceChatBubbleDisplay(cfg: any): any {
    // The DEFAULT for every axis below, resolved before any of them: a legacy preset id if
    // one is present and recognised, otherwise 'chat'. See CE_CB_LEGACY_SEED's note.
    var cbSeedId = String(CE_CB_LEGACY_SEED[String((cfg && cfg.charChatBubbleStyle) || '')] || 'chat');
    var cbBase: any = CE_CB_SEEDS[cbSeedId] || CE_CB_SEEDS['chat'];
    var cbPal = _ceCbPick(cfg && cfg.charChatBubblePalette, CE_CB_PALETTE, cbBase.palette);
    var cbAcc = _ceCbPick(cfg && cfg.charChatBubbleAccent, CE_CB_ACCENT, cbBase.accent);

    // A CUSTOM HEX OVERRIDES ITS PALETTE SLOT AND NOTHING ELSE. Empty means "use the
    // palette", so clearing the field is the undo -- there is no separate "custom: on".
    var cbPovHex  = String((cfg && cfg.charChatPovColor) || '').trim();
    var cbThemHex = String((cfg && cfg.charChatContactColor) || '').trim();
    var cbAccHex  = String((cfg && cfg.charChatAccentColor) || '').trim();

    // Width SNAPS to the offered set for the same reason avatar size does -- the surface
    // renders it as a three-option ceSelect and an off-set value would show no selection
    // at all while being in effect.
    var bwRaw = Number(cfg && cfg.charChatBubbleWidth);
    var bwOut = 78;
    if (bwRaw > 0) {
        var bwBest = CE_CHAT_BUBBLE_WIDTHS[0];
        for (var bwI = 1; bwI < CE_CHAT_BUBBLE_WIDTHS.length; bwI++) {
            if (Math.abs(CE_CHAT_BUBBLE_WIDTHS[bwI] - bwRaw) < Math.abs(bwBest - bwRaw)) bwBest = CE_CHAT_BUBBLE_WIDTHS[bwI];
        }
        bwOut = bwBest;
    }

    return {
        frame:   _ceCbPick(cfg && cfg.charChatBubbleFrame,  CE_CB_FRAME,  cbBase.frame),
        corner:  _ceCbPick(cfg && cfg.charChatBubbleCorner, CE_CB_CORNER, cbBase.corner),
        fill:    _ceCbPick(cfg && cfg.charChatBubbleFill,   CE_CB_FILL,   cbBase.fill),
        edge:    _ceCbPick(cfg && cfg.charChatBubbleEdge,   CE_CB_EDGE,   cbBase.edge),
        depth:   _ceCbPick(cfg && cfg.charChatBubbleDepth,  CE_CB_DEPTH,  cbBase.depth),
        type:    _ceCbPick(cfg && cfg.charChatBubbleType,   CE_CB_TYPE,   cbBase.type),
        voice:   _ceCbPick(cfg && cfg.charChatBubbleVoice,  CE_CB_VOICE,  cbBase.voice),
        palette: cbPal,
        accent:  cbAcc,
        lane:    _ceCbPick(cfg && cfg.charChatBubbleLane, CE_CB_LANE, cbBase.lane),
        // [v2.178.0 CHAT-LANE] THE AVATAR'S OWN SIZE IS PART OF THE BUBBLE LOOK NOW, and
        // reading it through ceChatAvatarDisplay rather than off cfg is what keeps the two
        // resolvers from disagreeing about what 'Large' means. Under `full` this is the
        // width of the reserved lane; under `inset` it is unused by the rules and is still
        // sent to the bridge, which needs it to place the portrait either way.
        avSize:  ceChatAvatarDisplay(cfg).size,
        povHex:  cbPovHex  || CE_CB_PALETTE[cbPal].pov,
        themHex: cbThemHex || CE_CB_PALETTE[cbPal].them,
        accHex:  cbAccHex  || CE_CB_ACCENT[cbAcc].hex,
        povRaw:  cbPovHex, themRaw: cbThemHex, accRaw: cbAccHex,
        ink:     String((cfg && cfg.charChatBubbleInk) || ''),
        width:   bwOut
    };
}

// Compile a resolved look into the six node-rule style objects, keyed by rule id.
// ONE builder, TWO callers: _charchatRegisterDecorations (registration) and ceChatSetBubble
// (live restyle through updateRules). They must not be able to disagree about what a look
// is, which is why neither of them writes a declaration.
//
// GEOMETRY NOTES, all load-bearing, none axis-controlled (padX excepted, see the header):
//
//  * width:'fit-content' ON POV AND CONTACT is the fix for "the pov message is not fully
//    right justified anymore". A node marker styles the whole PARAGRAPH BOX, and a block
//    box with margin-left:auto and max-width:78% is still width:auto -- it fills the
//    column to 78% no matter how short the message is.
//  * HEAD AND EMOBOX ARE DELIBERATELY *NOT* fit-content. They are two separate paragraphs
//    faking a single bubble; the seam only disappears while their boxes are the SAME WIDTH,
//    and two fit-content boxes around different text never are. Merging them is not
//    available -- NAI splits a section on '\n' and there is no way to ask it not to.
//  * ALIGNMENT AND max-width STAY FROZEN. The avatar is absolutely positioned at
//    calc(89% - size/2) in bridge CSS -- the centre of the band a 78% bubble leaves on the
//    RIGHT (contact bubbles are marginLeft:0, so the free lane is the right one; the
//    v2.174.0 comment that said "on the left" was wrong and is not reproduced here). Moving
//    the bubble without moving that number puts the avatar on top of the text, which is why
//    Lane is pass 2 and not an axis today.
function _charchatBubbleRules(look: any): any {
    var cbFr = CE_CB_FRAME[look.frame]   || CE_CB_FRAME['bubble'];
    var cbCo = CE_CB_CORNER[look.corner] || CE_CB_CORNER['round'];
    var cbFi = CE_CB_FILL[look.fill]     || CE_CB_FILL['tint'];
    var cbEd = CE_CB_EDGE[look.edge]     || CE_CB_EDGE['hairline'];
    var cbTy = CE_CB_TYPE[look.type]     || CE_CB_TYPE['sans'];
    var cbVo = CE_CB_VOICE[look.voice]   || CE_CB_VOICE['normal'];
    var cbDp = String(look.depth || 'flat');

    // [v2.178.0 CHAT-LANE] THE TWO GEOMETRIES, and the second one is the whole feature.
    // Under `full` the BOX runs the full column and the avatar lane becomes padding inside
    // it, so the fill reaches the edge while the text stops short of the portrait. The
    // lane is added to the contact side ONLY -- pov, head and emobox are not symmetric
    // here because avatars are not: POV turns get none, so reserving there would be a gap
    // nothing ever fills.
    //
    // THE SEAM IS UNAFFECTED because head and emobox receive the SAME laneRight, which is
    // the only thing the seam has ever required of horizontal padding.
    var cbFull = (String(look.lane || 'inset') === 'full');
    var bMax = cbFull ? '100%' : (String(look.width || 78) + '%');
    var padX = cbFr.corner ? cbCo.padX : '0px';
    var laneW = cbFull ? (Number(look.avSize || 40) + 12) : 0;
    var padThemR = laneW > 0 ? ('calc(' + padX + ' + ' + String(laneW) + 'px)') : padX;
    var bR   = cbFr.corner ? cbCo.r : '0';
    var bN   = (cbFr.corner && cbFr.notch) ? cbCo.n : bR;

    var fillA  = cbFr.fill ? cbFi.a : 0;
    var povBg  = _ceCbRgba(look.povHex,  fillA);
    var themBg = _ceCbRgba(look.themHex, fillA);
    var povInk  = _ceCbInk(look.povHex,  fillA, look.ink);
    var themInk = _ceCbInk(look.themHex, fillA, look.ink);

    var edgeOn  = (cbEd.a > 0) && (cbFr.edge !== 'none');
    var povLine  = cbEd.w + ' solid ' + _ceCbRgba(look.povHex,  cbEd.a);
    var themLine = cbEd.w + ' solid ' + _ceCbRgba(look.themHex, cbEd.a);

    // A BOX EXISTS ONLY IF SOMETHING DRAWS ONE. boxShadow on a paragraph with no fill and
    // no full border paints a rectangle nobody asked for, which is what "bloom on Frame:
    // none" would have been. Declared once and read by all four depth branches.
    var hasBox = cbFr.fill || (edgeOn && cbFr.edge === 'all');
    var povShadow  = 'none';
    var themShadow = 'none';
    var povGlow    = '';
    var themGlow   = '';
    if (cbDp === 'lift' && hasBox) {
        povShadow  = '0 1px 3px rgba(0,0,0,0.28)';
        themShadow = povShadow;
    } else if (cbDp === 'inset' && hasBox) {
        povShadow  = 'inset 0 1px 0 rgba(255,255,255,0.09)';
        themShadow = povShadow;
    } else if (cbDp === 'bloom') {
        if (hasBox) {
            povShadow  = '0 0 14px ' + _ceCbRgba(look.povHex,  0.24);
            themShadow = '0 0 14px ' + _ceCbRgba(look.themHex, 0.24);
        }
        povGlow  = '0 0 6px ' + _ceCbRgba(look.povHex,  0.38);
        themGlow = '0 0 6px ' + _ceCbRgba(look.themHex, 0.38);
    }

    // BORDER ASSEMBLY IS EXPLICIT PER RULE RATHER THAN SHARED, because HEAD and EMOBOX each
    // have to SUPPRESS one edge to close the seam and a generic helper would have to be told
    // which one anyway. Key insertion order matters: `border` is written first and the
    // suppressions after it, so the later declaration wins when both are serialised.
    var bPov: any = {
        display: 'block', width: 'fit-content', marginLeft: 'auto', marginRight: '0', maxWidth: bMax,
        padding: '8px ' + padX,
        borderRadius: bR + ' ' + bR + ' ' + bN + ' ' + bR,
        backgroundColor: povBg, border: 'none', boxShadow: povShadow,
        color: povInk, fontFamily: cbTy.font
    };
    var bThem: any = {
        display: 'block', width: 'fit-content', marginRight: 'auto', marginLeft: '0', maxWidth: bMax,
        padding: '8px ' + padThemR + ' 8px ' + padX,
        borderRadius: bR + ' ' + bR + ' ' + bR + ' ' + bN,
        backgroundColor: themBg, border: 'none', boxShadow: themShadow,
        color: themInk, fontFamily: cbTy.font
    };
    var bHead: any = {
        display: 'block', marginRight: 'auto', marginLeft: '0', marginBottom: '0', maxWidth: bMax,
        padding: '8px ' + padThemR + ' 2px ' + padX,
        borderRadius: bR + ' ' + bR + ' 0 0',
        backgroundColor: themBg, border: 'none', boxShadow: themShadow,
        color: themInk, fontFamily: cbTy.font
    };
    var bTail: any = {
        display: 'block', marginRight: 'auto', marginLeft: '0', marginTop: '0', maxWidth: bMax,
        padding: '0 ' + padThemR + ' 7px ' + padX,
        borderRadius: '0 0 ' + bR + ' ' + bN,
        backgroundColor: themBg, border: 'none', boxShadow: themShadow,
        color: _ceCbRgba(look.accHex, 0.86), fontFamily: cbTy.font
    };

    if (edgeOn && cbFr.edge === 'all') {
        bPov.border  = povLine;
        bThem.border = themLine;
        bHead.border = themLine;  bHead.borderBottom = 'none';
        bTail.border = themLine;  bTail.borderTop    = 'none';
    } else if (edgeOn && cbFr.edge === 'side') {
        // The SIDE is the visual identity here: the speaker's own margin carries the rule.
        bPov.borderRight  = povLine;
        bThem.borderLeft  = themLine;
        bHead.borderLeft  = themLine;
        bTail.borderLeft  = themLine;
    } else if (edgeOn && cbFr.edge === 'bottom') {
        // Only the LAST paragraph of the pair underlines, or the tagline gets a rule through
        // the middle of what is meant to read as one block.
        bPov.borderBottom  = povLine;
        bThem.borderBottom = themLine;
        bTail.borderBottom = themLine;
    }

    // Under `full`, fit-content plus a large right padding would hug the text and leave the
    // avatar sitting on the editor background instead of on the bubble. The contact stack
    // therefore takes the whole row; POV keeps hugging, which is what makes the two sides
    // still readable as two sides when neither one is inset.
    if (cbFull) { bThem.width = '100%'; }

    if (cbFr.fill && cbFi.blur) {
        bPov.backdropFilter = 'blur(6px)';  bThem.backdropFilter = 'blur(6px)';
        bHead.backdropFilter = 'blur(6px)'; bTail.backdropFilter = 'blur(6px)';
    }
    if (povGlow)  { bPov.textShadow = povGlow; }
    if (themGlow) { bThem.textShadow = themGlow; bHead.textShadow = themGlow; bTail.textShadow = themGlow; }

    // Voice merges LAST so it can override anything above it -- Tight's fontSize is exactly
    // that, a declaration the shared shape has no field for.
    var cbK: string;
    for (cbK in cbVo.extra) {
        if (!Object.prototype.hasOwnProperty.call(cbVo.extra, cbK)) continue;
        bPov[cbK] = cbVo.extra[cbK]; bThem[cbK] = cbVo.extra[cbK];
        bHead[cbK] = cbVo.extra[cbK]; bTail[cbK] = cbVo.extra[cbK];
    }

    return {
        marker: {
            backgroundColor: _ceCbRgba(look.accHex, 0.16),
            borderTop: '2px solid ' + _ceCbRgba(look.accHex, 0.85),
            borderBottom: '1px solid ' + _ceCbRgba(look.accHex, 0.40)
        },
        pov: bPov, contact: bThem, head: bHead, emobox: bTail,
        emotion: {
            color: _ceCbRgba(look.accHex, 0.86),
            fontStyle: (look.type === 'mono') ? 'normal' : 'italic',
            fontSize: 'var(--ae-font-size-xs, 11px)', fontFamily: cbTy.font
        }
    };
}

// ── [v2.178.0 CHAT-LANE / CHAT-BUBBLE-STYLE] The bubble's look, for the bridge ───────────
// THREE THINGS IN THE DOCUMENT ARE PAINTED BY THE BRIDGE AND NOT BY A DECORATION RULE: the
// contact avatar, the per-turn control cluster, and the chat photo card. All three have to
// agree with the bubble, and until this version they agreed with it by having the SAME
// NUMBERS TYPED INTO BRIDGE CSS -- 78% for the photo's width, 89% for the avatar's lane
// (78 + (100-78)/2), 320px for the photo's own cap. Those were correct for exactly one
// configuration and silently wrong for every other, which is why the photo never matched a
// widened bubble and why Lane could not exist at all before this.
//
// THE FIX IS THE SAME SPLIT THE REST OF THE FILE ALREADY USES: the engine is the source,
// the bridge is the renderer. Every number above is DERIVED here from the one resolved look
// and pushed as CSS custom properties; the bridge writes them onto documentElement and its
// rules read them. Nothing over there computes a bubble value any more.
//
// AND IT IS NOT A NEW CHANNEL. registerEngineUI already authors --ae-cca-size and
// --ae-cca-h-mult exactly this way (v2.131.0 CCAV-ENGINE); this is the same idiom with more
// properties, so the "engine keeps a mirror of bridge state" trap is not in play -- nothing
// here tracks anything the bridge owns.
//
// THE PHOTO CARD IS THE INTERESTING ONE. Its widget is a NODE widget on the message's own
// section, so it lands BETWEEN the HEAD paragraph and the EMOBOX paragraph -- it has always
// been physically inside the fake bubble, and only ever looked detached because it was
// styled as if it were not. Given the fill, the side borders, the same padX and no vertical
// margin, HEAD -> photo -> EMOBOX reads as one continuous bubble with a picture in it.
// That is why the payload carries edges and radii and not just a width.
function _charchatBubbleTokens(look: any): any {
    var cbFr: any = CE_CB_FRAME[String(look.frame)] || CE_CB_FRAME['bubble'];
    var cbCo: any = CE_CB_CORNER[String(look.corner)] || CE_CB_CORNER['round'];
    var cbFi: any = CE_CB_FILL[String(look.fill)] || CE_CB_FILL['tint'];
    var cbEd: any = CE_CB_EDGE[String(look.edge)] || CE_CB_EDGE['hairline'];
    var cbTy: any = CE_CB_TYPE[String(look.type)] || CE_CB_TYPE['sans'];

    var tFull  = (String(look.lane || 'inset') === 'full');
    var tW     = Number(look.width || 78);
    var tSize  = Number(look.avSize || 40);
    var tPadX  = cbFr.corner ? String(cbCo.padX) : '0px';
    var tR     = cbFr.corner ? String(cbCo.r) : '0';
    var tN     = (cbFr.corner && cbFr.notch) ? String(cbCo.n) : tR;

    // THE AVATAR LANE, DERIVED. Under inset the portrait is centred in the band the bubble
    // leaves on the RIGHT -- (100 + W) / 2 is that band's centre, and it reduces to the old
    // hardcoded 89 at the old default of 78, which is the check that this is the same
    // geometry and not a new one. Under full the bubble has no band, so the portrait is
    // pinned to the right edge of the column instead, inside the padding reserved for it.
    var tAvaLeft = tFull
        ? 'calc(100% - var(--ae-cca-size,40px) - 6px)'
        : ('calc(' + String((100 + tW) / 2) + '% - var(--ae-cca-size,40px) / 2)');

    var tFillA = cbFr.fill ? Number(cbFi.a) : 0;
    var tEdgeOn = (Number(cbEd.a) > 0) && (cbFr.edge !== 'none');
    // The photo card carries a FULL border or none. Under a 'side' or 'bottom' frame the
    // bubble has no box for the card to continue, so it gets none and reads as a bare
    // picture -- which is what those frames look like everywhere else.
    var tPovEdge  = (tEdgeOn && cbFr.edge === 'all') ? (cbEd.w + ' solid ' + _ceCbRgba(look.povHex,  cbEd.a)) : 'none';
    var tThemEdge = (tEdgeOn && cbFr.edge === 'all') ? (cbEd.w + ' solid ' + _ceCbRgba(look.themHex, cbEd.a)) : 'none';

    return {
        maxWidth: tFull ? '100%' : (String(tW) + '%'),
        lane:     tFull ? (String(tSize + 12) + 'px') : '0px',
        avaLeft:  tAvaLeft,
        padX:     tPadX,
        radius:   tR,
        notch:    tN,
        povBg:    _ceCbRgba(look.povHex,  tFillA),
        themBg:   _ceCbRgba(look.themHex, tFillA),
        povEdge:  tPovEdge,
        themEdge: tThemEdge,
        povInk:   _ceCbInk(look.povHex,  tFillA, look.ink),
        themInk:  _ceCbInk(look.themHex, tFillA, look.ink),
        accent:   _ceCbRgba(look.accHex, 0.86),
        font:     String(cbTy.font)
    };
}

// Push the tokens. Called from THREE places and all three are necessary rather than
// defensive: registration (a chat opening), ceChatSetBubble (a live change), and the bridge
// handshake (a bridge that connected or reloaded after either of those). A bridge that has
// never been told falls back to the literal defaults baked into its own CSS, which are the
// v2.177.0 numbers -- so a stale bridge is wrong-but-working rather than blank.
function broadcastChatBubbleStyle(): Promise<any> {
    if (!isBridgeReady) return Promise.resolve(null);
    return loadConfig().then(function(cbsCfg: any) {
        return broadcastToTM('AE_CHAT_BUBBLE_STYLE', _charchatBubbleTokens(ceChatBubbleDisplay(cbsCfg)));
    }).catch(function(e: any) {
        aeLog('[AE:chatstyle] bubble token push failed (bridge keeps its last values):', e);
        return null;
    });
}

// [v2.50.0 CHARCHAT-AVATAR] Second sentinel, same channel. One anchor per CONTACT TURN
// (not per section — a three-paragraph reply gets ONE avatar, beside its first line).
// [v2.57.0 CHARCHAT-AVATAR-EMOTION] Payload is now 'contactId' OR 'contactId|emotion',
// where emotion is one of the canonical 24 (charChatParseEmotion -> resolveEmotion, read
// off the turn's own trailing "  Emotion: <word>" line). The bridge resolves that to a
// per-emotion portrait slot (charId+'_em_'+emotion) and falls back to the character's
// hardwired avatar slot (charId+'_em_Avatar', legacy charId+'_portrait') when that slot
// has no image — see _loadCharEmotionImage bridge-side. The bare no-suffix form is still
// emitted for a turn with no readable emotion and still means "just use the Avatar slot".
// Either way the bridge floats the image into the gutter the contact bubble's
// max-width:78% leaves open on the left. POV turns get NONE, per user ("avatars attached
// to character (not pov) message bubbles"). Same flag-day rule as the image sentinel: this
// literal is duplicated in the bridge, change BOTH or avatars silently stop binding — and
// the '|' suffix specifically needs bridge >= 2.47.0 (an older bridge treats the whole
// body as the id and matches no character).
const AE_CHARCHAT_AVA_SENTINEL = 'ce-chatava:';
const AE_CHARCHAT_MAX_TOKENS  = 120;                    // SMS-length DEFAULT pin — [v2.24.0] now only the fallback for a contact whose persona verbosity is 'auto'. See charChatMaxTokensFor().
// [v2.27.0] AE_CHARCHAT_THINK_TOKENS removed — CHARCHAT-THINK is gone (see the
// CE-INDEX v2.27.0 entry); its replacement, generateEphemeral(), is a fully separate
// call with its own budget and shares nothing with the reply's own max_tokens pin.
const AE_CHARCHAT_SUMMARY_MAX_TOKENS = 300;             // [v2.23.0] Matches AE_WIZARD_MAX_TOKENS's precedent for "a short prose passage" — used only transiently during previewSummarizeCharChat, never left pinned.
// [v2.45.0] AE_CHARCHAT_THINK_MS DELETED — zero callers, verified. It was v2.38.0's
// aeGenerateBounded timeout; that primitive went with v2.39.0 and the constant has sat
// orphaned ever since. The two context budgets below stay and are deliberately asymmetric:
// the transcript is what the contact is actually answering, the story is background, so the
// story gets the smaller share.
const AE_CHATEPH_STORY_TOKENS = 700;
const AE_CHATEPH_CHAT_CHARS = 2400;
const AE_CHARCHAT_MARKER_TEXT = '\u2501\u2501 CHARACTER CHAT \u2501\u2501 The story above is reference material. Everything below this line is a text-message conversation and will be removed when the chat ends.';

// [v2.21.0 CHARCHAT] Global fallback texting rubric, used when a character has no
// chatPersona of their own (or has one that is disabled/empty). Adapted from the Chat
// Simulator's proven persona rubric. P3 adds the per-character editor + generator that
// can override this.
const CHARCHAT_DEFAULT_RUBRIC = [
    'Translate this character\u2019s personality into a realistic text-messaging style based on their age, traits, habits and tech familiarity. For example:',
    '* Digital native / casual: relaxed grammar, lowercase, slang.',
    '* Professional / adult: standard punctuation, clear syntax, concise phrasing.',
    '* Senior / tech-unsavvy: overly formal grammar, or excessive punctuation ("...").',
    'Never repeat the same emoticon consecutively. Avoid cliches. Only rarely include narrative prose or actions (e.g. *sighs*). Messages must be under 32 words \u2014 keep replies SMS-length.'
].join('\n');

// ── [v2.99.0 CCINT] INTERVIEW POV ────────────────────────────────────────────
// A THIRD POV VALUE inside CharChat, not a new surface. The whole reason: CharChat
// rides NAI's native Send (api.v1.editor.generate), which costs ZERO script output
// budget — an interview is a many-turn form, and the same thing built on
// api.v1.generate() would be metered on every single question. Everything else the
// mode needs (turn scanning, brace canonicalisation, decorations, save/resume as a
// lorebook thread, summarise->journal) already exists here and would otherwise be
// rebuilt.
//
// SENTINEL SHAPE, and why it is hyphens: _charchatParseEntryId splits an entry id on
// the FIRST '_pov_', so a povId containing an underscore would round-trip wrong.
// 'ce-interview' cannot collide with a character UUID (hex-and-hyphen, 36 chars) and
// parses back cleanly out of 'ae_charchat_<cid>_pov_ce-interview'. Free and desirable
// consequence: an interview thread and a phone thread with the SAME character are
// separate lorebook entries under the existing partition scheme — no migration, no
// rekey, no new id shape.
//
// THE ONE TRAP, audited rather than assumed: povId is an opaque partition key at
// EVERY consumer except startCharChat, which calls loadCharacter(povId) and then
// zeroes the field when that returns null. Both sites are fixed below. resume /
// restore / broadcast / listCharChatThreads / upsert all pass it through untouched
// and needed nothing.
const CC_POV_INTERVIEW = 'ce-interview';

// Deliberately NOT the persona verbosity axis. charChatMaxTokensFor's ladder caps at
// 240 and is calibrated for SMS ("under 32 words"); a spoken answer under that cap is
// a stub. One flat pin instead, per user: give them room for a natural answer.
const AE_CCINT_MAX_TOKENS = 320;

// Parallel to AE_CHARCHAT_MARKER_TEXT in structure and in job — it tells the model
// where the boundary is and tells the user the region is temporary. NEVER read this
// constant directly: go through _ccMarkerText()/_ccMarkerTextFor(). A read site left
// on the phone constant does not error, it silently no-ops the canonical-chat rebuild
// (ccMarkIdx stays -1) and the model reads the raw document instead. All five sites
// are converted; keep it that way.
const AE_CCINT_MARKER_TEXT = '\u2501\u2501 INTERVIEW \u2501\u2501 The story above is the record. Everything below this line is an interview conducted outside the story and will be removed when the interview ends.';

// Replaces CHARCHAT_DEFAULT_RUBRIC wholesale in the system prompt (it does not extend
// it — a texting rubric in an interview produces a spoken deposition in lowercase
// textspeak). Four paragraphs, one job each.
// [per user, v0.5 design frame B not B+] The design's "answer the human version of a
// meta question" translation clause is DELIBERATELY NOT HERE. Consequence, accepted
// and not a bug: a meta question ("what should your goal be") gets an in-world
// non-answer rather than a usable one — questions are phrased in-world instead. The
// clause is one sentence in paragraph two if that ever reverses.
// Paragraph three is the anti-drift clause and is the reason this mode is worth
// building rather than dangerous: the model's failure mode is accommodation, and a
// character who simply agrees with the author is a mirror, not evidence.
const CCINT_RUBRIC = [
    'This is speech, not text messages. Answer aloud, in first person, in this character\u2019s own register \u2014 the vocabulary, rhythm and evasions their profile establishes. Physical action is allowed but sparing: a gesture, a pause, a look away, and only when the answer is in the body rather than the words.',
    'The interviewer is a real person sitting across from them, asking about things the character lived through. The character does not know they are in a story, has never read a manuscript, and cannot discuss chapters, plots, arcs, scenes or character development. They answer as themselves, about their own life.',
    'They are under no obligation to be helpful, forthcoming, or agreeable. They may refuse a question, change the subject, understate, or lie, and they may contradict the interviewer where the record supports them. An answer that pushes back is worth more than one that accommodates.',
    'Give the answer the room it needs \u2014 usually a few sentences, more when the question earns it, less when the honest answer is short. Do not summarise events the interviewer already knows; say what those events meant to you.'
].join('\n');

function _ccIsInterview(povId: string): boolean {
    return povId === CC_POV_INTERVIEW;
}

// Explicit-mode form. Use this at the two sites that run BEFORE _aeCharChat is
// assigned (startCharChat's append, resumeCharChatFromEntry's append) — the same
// ordering hazard charChatMaxTokensFor has, and for the same reason.
function _ccMarkerTextFor(povId: string): string {
    return _ccIsInterview(povId) ? AE_CCINT_MARKER_TEXT : AE_CHARCHAT_MARKER_TEXT;
}

// Ambient form, for anything running mid-chat (context override, story-above-marker).
function _ccMarkerText(): string {
    return _ccMarkerTextFor(_aeCharChat.povId);
}

// [v2.131.0 CCAV-ENGINE] The ONE resolver for chat-avatar display. Every read of the two
// config fields goes through here, so the defaults live in a single place and a
// half-written config can never produce a sentinel the bridge has to guess at.
// SIZE IS SNAPPED to the offered set rather than passed through: the Chat surface renders
// it as a three-option ceSelect, and a value outside the set would render as no selection
// at all \u2014 a control showing nothing while the setting is in effect is worse than a
// control showing the nearest truth. SHAPE is validated against the closed set the
// bridge's CSS knows how to draw; anything else collapses to 'round'.
const CE_CCAV_SIZES: number[] = [28, 40, 52];
const CE_CCAV_SHAPES: string[] = ['round', 'rounded', 'portrait'];
function ceChatAvatarDisplay(cfg: any): { size: number; shape: string } {
    let avRaw = Number(cfg && cfg.charChatAvatarSize);
    let avSize = 40;
    if (avRaw > 0) {
        let avBest = CE_CCAV_SIZES[0];
        for (let avI = 1; avI < CE_CCAV_SIZES.length; avI++) {
            if (Math.abs(CE_CCAV_SIZES[avI] - avRaw) < Math.abs(avBest - avRaw)) avBest = CE_CCAV_SIZES[avI];
        }
        avSize = avBest;
    }
    let avShape = String((cfg && cfg.charChatAvatarShape) || 'round');
    if (CE_CCAV_SHAPES.indexOf(avShape) < 0) avShape = 'round';
    return { size: avSize, shape: avShape };
}

async function saveCharChatState(): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_CHARCHAT, JSON.stringify(_aeCharChat)); }
    catch (e) { api.v1.error('[AE:charchat] state save failed:', e); }
}

// [v2.32.0 CHARCHAT-HUD] Now carries the TURN LIST, not just chat metadata. This is the
// one real gap that stopped the bridge from being able to paint bubbles: everything else
// it needs already existed engine-side. Turns are assembled by charChatTurnsPayload()
// from _charchatScanTurns, so the bridge never has to infer role from the DOM or from
// text — it renders exactly what the document's own section metadata says.
async function broadcastCharChatState(): Promise<void> {
    try {
        let ccTurns: any[] = [];
        if (_aeCharChat.active) {
            try { ccTurns = await charChatTurnsPayload(); }
            catch (eT) { aeLog('[AE:charchat] turn payload build failed (sending metadata only):', eT); }
        }
        let ccCfgB = await loadConfig();
        // [v2.35.0 CHARCHAT-THOUGHT] The contact's current inner state, surfaced so the
        // header can show it on demand. Same field generateEphemeral() persists and the
        // char edit modal already displays (char.ephemeral.compressedLine) — read-only
        // here, this never generates one. Empty string when there is no thought yet or
        // the character can't be loaded; the bridge hides the control on falsy.
        let ccThought = '';
        try {
            if (_aeCharChat.active && _aeCharChat.contactId) {
                let ccThChar = await loadCharacter(_aeCharChat.contactId);
                if (ccThChar && ccThChar.ephemeral && ccThChar.ephemeral.compressedLine) {
                    ccThought = String(ccThChar.ephemeral.compressedLine).trim();
                }
            }
        } catch (_eTh) { ccThought = ''; }
        await broadcastToTM(EVT_CHARCHAT_STATE, {
            active: _aeCharChat.active, contactId: _aeCharChat.contactId, contactName: _aeCharChat.contactName,
            povId: _aeCharChat.povId, povName: _aeCharChat.povName, startedAt: _aeCharChat.startedAt,
            lastEmotion: _aeCharChat.lastEmotion,
            lastThought: ccThought,
            turns: ccTurns,
            images: !!(ccCfgB && ccCfgB.charChatImages),
            freshThoughts: !!(ccCfgB && ccCfgB.charChatFreshThoughts),
            busyStage: _aeCharChat.busyStage || ''   // [v2.38.0 CHARCHAT-THINK-FIRST]
        });
    } catch (e) { aeLog('[AE:charchat] state broadcast failed:', e); }
    // [v2.131.0 CC-TRAY] The tray's Close / Summarize / Delete buttons exist only while a
    // chat is open, and api.v1.ui.register is the only way to change the button set \u2014 so
    // something has to re-register on the transition. This is the choke point every
    // start / resume / end / restore already passes through, and ceSyncToolbar is a CHANGE
    // DETECTOR, so the per-turn calls that also land here cost one boolean compare rather
    // than a full UI re-registration.
    try { await ceSyncToolbar(); } catch (_eTbSync) {}
}

// [v2.51.5 CHARCHAT-THREADS] Push the saved-thread roster to the bridge's Chat launcher.
// Deliberately thin: listCharChatThreads() already returns exactly the per-(contactId,
// povId) records the picker wants, with turnCount; we drop entryId on the wire (the bridge
// never resolves an entry id — it sends AE_CHARCHAT_START { contactId, povId } and the
// engine re-derives the deterministic id via charChatEntryId). One bulk lorebook.entries()
// call, same discipline the native picker follows — never N lookups.
async function broadcastCharChatThreads(): Promise<void> {
    try {
        let ccThreads = await listCharChatThreads();
        let ccOut = (ccThreads || []).map(function(t: any) {
            return { contactId: t.contactId, povId: t.povId, turnCount: t.turnCount };
        });
        await broadcastToTM(EVT_CHARCHAT_THREADS_RESP, { threads: ccOut });
    } catch (e) { aeLog('[AE:charchat] threads broadcast failed:', e); }
}

// [v2.38.0 CHARCHAT-THINK-FIRST] Set the in-flight stage and push it. One line at every
// call site, and it always broadcasts — the whole complaint this answers is that work
// happens with no indication, so a setter that could silently not repaint would be
// pointless. Cheap: broadcastCharChatState is already fired after every chat action.
async function _charchatSetBusy(stage: string): Promise<void> {
    if (_aeCharChat.busyStage === stage) return;
    _aeCharChat.busyStage = stage || '';
    aeLog('[AE:charchat:busy] ' + (stage || '(idle)'));
    try { await broadcastCharChatState(); } catch (_eSb) {}
}

// [v2.32.0 CHARCHAT-HUD] Contacts screen data. POV-first, mirroring the native picker's
// own flow (openCharChatPicker -> _charchatShowContactsForPov). ONE listCharChatThreads()
// call for every pair, filtered in memory — same "one bulk lorebook call, never N
// lookups" discipline the native picker already follows.
// [v2.46.0 CHARCHAT-SHELL-BASELINE] broadcastCharChatContacts() DELETED. Its only reader was
// bridge v2.12.0's contacts screen, deleted with the panel; its only sender was that screen's
// requestCharChatContacts(). AE_CHARCHAT_CONTACTS_REQ's dispatcher case goes with it (grep it
// — same pass, not left as a handler for a message nobody sends). Picking a POV and a contact
// is openCharChatPicker's job until the overlay gives it a home; that native path never went
// through this function. _charchatThreadsForPov and listCharChatThreads are UNTOUCHED and
// still have live callers (the native picker) — verified, not assumed.

// ── Decorations: POV vs contact bubbles, marker band, name/tag hiding ────────
// Same shape as _wizliveRegisterDecorations: registered once with empty scopes, then
// refreshed from the live document on start, restore, and each turn end.
// [v2.174.0 CHAT-BUBBLE-STYLE] "POV (amber) vs contact (teal)" and "bubble polish is P5"
// are both stale as of this version and are corrected here rather than left to rot: real
// bubbles shipped in v2.47.0 (amber/teal tinted highlighting was the pre-bubble state this
// comment never got updated past), and the polish itself -- five selectable presets, a
// width control, all colours literal-fallbacked against a bridge stylesheet that can
// disappear out from under them -- is what that patch added.
// [v2.177.0 CHAT-BUBBLE-AXES] AMENDED AGAIN, and the amendment is the point of the
// version: "five selectable presets" is no longer what this is. See CE_CB_FRAME and
// _charchatBubbleRules just above.
async function _charchatRegisterDecorations(markerId: number): Promise<void> {
    // [v2.47.0 CHARCHAT-BUBBLES] Real bubbles, not tinted highlighting.
    // [v2.174.0 CHAT-BUBBLE-STYLE] EVERY STYLE OBJECT BELOW IS NOW BUILT, NOT WRITTEN.
    // [v2.177.0 CHAT-BUBBLE-AXES] _charchatBubbleRules compiles the user's RESOLVED LOOK
    // (nine axes plus colour, from ceChatBubbleDisplay) into the six node rules; the same
    // builder is called by ceChatSetBubble for a live restyle, so the two paths cannot
    // drift. Read that function's header for why HEAD/EMOBOX keep a block box while
    // POV/CONTACT hug their content, and why Corner is allowed to set padding.
    //
    // THE TOKENS-ONLY POLICY OF v2.47.0 IS WITHDRAWN, and the reason is worth recording
    // rather than silently reversing. That note reasoned correctly that --ae-* custom
    // properties inherit from document.documentElement into NAI's own document, so the
    // engine never has to be handed resolved colours. True, and still true -- but it made
    // the BRIDGE's stylesheet load-bearing for the engine's own rendering, and bridge
    // v2.103.0 CE-STRIP deleted AE_CSS, which owned every --ae-chat-* definition. An
    // unresolvable var() computes the whole declaration to unset, so all of the fill, the
    // border and the radius vanished together and the bubbles degraded to indented text.
    // Every var() the builder emits now carries a literal fallback: the token still wins
    // when a bridge defines it (bridge v2.105.0 restores the block), and the bubbles no
    // longer depend on that being true.
    // UNVERIFIED, worth a live check: whether a node marker's `style` reaches the paragraph's
    // own box (so margin-left:auto / max-width actually justify it) as opposed to only an
    // inner text wrapper. script-types.txt's own wording ("node markers style entire
    // paragraphs") says box-level, and that is the assumption this rule is built on.
    let ccStyCfg: any = null;
    try { ccStyCfg = await loadConfig(); } catch (_eCcSty) { ccStyCfg = null; }
    let ccBubDisp = ceChatBubbleDisplay(ccStyCfg);
    let ccB = _charchatBubbleRules(ccBubDisp);
    // [v2.178.0 CHAT-LANE] The bridge paints the avatar, the turn controls and the photo
    // card; all three have to agree with the rules built one line up. Not awaited -- a
    // token push that fails must not stop the decorations from registering.
    broadcastChatBubbleStyle();
    await api.v1.editor.decorations.registerRules([
        { id: AE_CHARCHAT_RULE_MARKER,  type: 'node', match: '^', style: ccB.marker, scope: { sectionIds: [markerId] } }, // [v2.50.1 CHAT-TOKEN-PARITY] was 3 hardcoded rgba(232,160,74,*) literals
        // POV (yours): right-justified, hugging its own text.
        { id: AE_CHARCHAT_RULE_POV,     type: 'node', match: '^', style: ccB.pov, scope: { sectionIds: [] } },
        // Contact (theirs): left-justified, hugging its own text.
        { id: AE_CHARCHAT_RULE_CONTACT, type: 'node', match: '^', style: ccB.contact, scope: { sectionIds: [] } },
        // [v2.47.0] The Emotion: tagline. INLINE type, matched by pattern (not a fixed
        // sectionId list) — CHARCHAT_EMOTION_PREFIX is exactly two leading spaces then
        // 'Emotion: ', so the pattern below is deliberately loose (\s* not two literal
        // spaces) to survive if that whitespace ever changes without this rule going stale.
        // Scoped to contact sectionIds only (see refreshCharChatDecorations) — POV turns
        // never carry an emotion line, so scoping the pattern search to contact ids only is
        // strictly cheaper, not a correctness requirement.
        { id: AE_CHARCHAT_RULE_EMOTION, type: 'inline', match: '^\\s*Emotion:.*$', flags: 'm', style: ccB.emotion, scope: { sectionIds: [] } },
        // [v2.49.0] A contact bubble WITH an emotion tail below it. Same box as CONTACT but
        // open at the bottom, so the tail can close it.
        { id: AE_CHARCHAT_RULE_HEAD, type: 'node', match: '^', style: ccB.head, scope: { sectionIds: [] } },
        // [v2.49.0] The emotion tail. Closes the bubble the HEAD opened — same background,
        // no top border, no top margin, so the seam disappears and the two sections read as
        // one bubble with a tagline inside it.
        { id: AE_CHARCHAT_RULE_EMOBOX, type: 'node', match: '^', style: ccB.emobox, scope: { sectionIds: [] } },
        // [v2.49.0] Hide the "Name: " prefix. match is rebuilt per refresh from the live
        // names (see _charchatNameRuleMatch) — registered here with a deliberately
        // never-matching pattern so a stale rule cannot hide the wrong text before the
        // first refresh lands.
        { id: AE_CHARCHAT_RULE_NAME, type: 'inline', match: '(?!)', flags: 'm', style: { display: 'none' }, scope: { sectionIds: [] } },
        // [v2.51.1 CHATIMG-HIDE-TAG, per user] Hide the image PROMPT tag in the bubble. The
        // pattern is STATIC (both the resolved "[Image#hex: desc]" and the transient
        // unresolved "[Image: desc]" forms), so — like EMOTION above — it is registered once
        // with its real match here and only RESCOPED per refresh, never rebuilt. flags 'gi':
        // global so both tags in a two-image turn are hidden, case-insensitive so a
        // lower-case model-written "[image: ...]" is caught too (the documented flags form,
        // script-types.txt registerRules example). scope starts empty; refresh fills it.
        { id: AE_CHARCHAT_RULE_IMGTAG, type: 'inline', match: '\\[[ \\t]*Image(?:#[0-9a-f]{8})?[ \\t]*:[ \\t]*[^\\]\\n\\r]+?[ \\t]*\\]', flags: 'gi', style: { display: 'none' }, scope: { sectionIds: [] } }
    ]);
}

// [v2.49.0] The "Name: " prefix pattern for the two live speakers. Returns a
// never-matching pattern when neither name is known, rather than something like '^:' that
// could match real prose.
function _charchatNameRuleMatch(): string {
    let ccNames: string[] = [];
    if (_aeCharChat.contactName) ccNames.push(_charchatEscapeRx(_aeCharChat.contactName));
    if (_aeCharChat.povName) ccNames.push(_charchatEscapeRx(_aeCharChat.povName));
    if (!ccNames.length) return '(?!)';
    return '^(?:' + ccNames.join('|') + '):[ \\t]*';
}

// [v2.48.0 CHARCHAT-IMGWIDGET] Image anchors for the chat.
//
// WHY A WIDGET AND NOT A UIPartImage: script-types.txt is explicit about
// UIPartImage.src — "Image data as a base64 data URI... URLs are not supported for
// security reasons." So the ONLY way an engine-authored image part could show a chat
// photo is by carrying the whole base64 payload through the Worker, against
// memoryLimit: 128. It is not a preference: the platform forbids the cheap path. What
// this function creates instead is an EMPTY ANCHOR carrying a 1px transparent SENTINEL
// STRING; the BRIDGE finds that string with a TreeWalker and paints the real <img> from
// its own IndexedDB, so the bytes never enter the Worker at all. This is exactly the
// mechanism Auto-Illustrator v3 runs in production (see its createWidgets + the bridge's
// findPlaceholder/injectImage), adopted rather than re-derived.
//
// WHY THIS SOLVES DRIFT, per user ("To keep them anchored, we may need a native widget
// to keep them in place without drift"): a node widget is positioned BY NAI relative to
// its sectionId and repositioned by NAI on every document edit, and disposed by NAI when
// its section is removed. The anchoring is the platform's job, not a poll of ours —
// which is what the deleted panel's _ccStartAnchor/_ccApplyAnchor poll was for.
//
// THE SENTINEL CARRIES THE 8-HEX SHORT ID, NOT THE FULL UUID, and that is forced, not
// sloppy: _charchatProcessImages mints a full api.v1.uuid(), dispatches it to the bridge
// (which dbSaves under the FULL uuid), but writes only the 8-hex prefix into the document
// tag. The document is this function's only source of truth on a restore/reload, so the
// short id is all it can know. The bridge prefix-resolves short -> full against its own
// gallery index. Do not "fix" this by widening the document tag: the tag is prose the
// user can see, and the short form is deliberate.
//
// WIDGETS DO NOT SURVIVE A RELOAD, and this function is the rebuild: it is called from
// refreshCharChatDecorations (deliberately — that is ALREADY called on start, restore,
// and every turn end, so piggybacking guarantees the widgets and the bubble decorations
// can never drift out of sync across those seven call sites). clearWidgets() first, then
// recreate from a fresh scan — same clear-and-rebuild shape Auto-Illustrator uses. No
// tombstone list is needed here, unlike Auto-Illustrator's: this rebuilds from the
// DOCUMENT TAGS, so an image whose tag the user deleted simply is not found and cannot
// be resurrected. The document is the state.
// [v2.156.0 STORYIMG] The chat's own widget handles, and the disposer that replaced its
// blanket clearWidgets(). Same shape as _ceStoryImgHandles in SECTION 16b -- module state
// that cannot outlive a script load, which is fine because the refresher below rebuilds
// from the document on every turn.
var _ccImgHandles: any[] = [];

async function _ccImgDisposeHandles(): Promise<void> {
    let ccHs = _ccImgHandles;
    _ccImgHandles = [];
    for (let ccD = 0; ccD < ccHs.length; ccD++) {
        try { if (ccHs[ccD] && ccHs[ccD].dispose) await ccHs[ccD].dispose(); }
        catch (eCcD) { aeLog('[AE:charchat] widget dispose failed (already gone?)'); }
    }
}

async function refreshCharChatImageWidgets(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    // [v2.156.0 STORYIMG] HANDLE-TRACKED. The condition the previous note set out has
    // been met -- SECTION 16b is the second widget feature -- so this no longer calls the
    // blanket clearWidgets(), which would take every story image with it. Each feature
    // disposes its OWN handles and neither can reach the other's.
    await _ccImgDisposeHandles();

    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); } catch (_eccWs) { return; }

    let ccOpts: any[] = [];
    // [v2.57.0 CHARCHAT-AVATAR-EMOTION] Avatar options are COLLECTED here and emitted
    // after the walk, rather than pushed inline like the image sentinels below. Reason,
    // and it is a real ordering constraint rather than a style choice: the emotion a turn
    // carries is written on its OWN section BELOW the body ("  Emotion: happy" — see
    // CHARCHAT_EMOTION_PREFIX), but the avatar has to anchor on the section ABOVE the
    // body (see the sectionId note below — the bridge's gutter positioning depends on it).
    // So at the moment the anchor is chosen the emotion is still unread. Deferring lets one
    // walk do both without a lookahead index.
    // NOT a second document scan — ccAll is already in memory; this is a second loop over
    // the same array, which is why anchoring after the Emotion: line (single-pass, but it
    // would land the avatar below the message instead of beside its first line) was not
    // worth the CSS rework.
    let ccAvaRuns: any[] = [];
    let ccPendingRun: any = null;   // the run awaiting its Emotion: line; null when none is open
    let ccSeen = false;
    let ccPrevId = _aeCharChat.markerId;   // [v2.50.0] section above the current one; seeds to the marker
    // [v2.50.0 CHARCHAT-AVATAR] Track contact RUNS so exactly one avatar anchors per turn.
    // ccInContactRun is true for the 2nd..Nth section of a multi-paragraph reply, which is
    // how a three-line reply gets ONE avatar (on its first section) rather than three.
    let ccInContactRun = false;
    for (let ccI = 0; ccI < ccAll.length; ccI++) {
        let ccRow = ccAll[ccI];
        if (ccRow.sectionId === _aeCharChat.markerId) { ccSeen = true; ccInContactRun = false; ccPendingRun = null; continue; }
        if (!ccSeen) continue;
        let ccTxt = (ccRow.section && ccRow.section.text) || '';

        // Avatar anchoring is independent of the image scan below and must run even for a
        // section with no image tag, so it comes first and does not `continue` on empty text.
        if (_aeCharChat.setupIds.indexOf(ccRow.sectionId) >= 0) {
            ccInContactRun = false;                       // setup paragraphs are not turns
            ccPendingRun = null;
        } else {
            let ccEmoLine = /^[ \t]*Emotion:/.test(ccTxt);
            let ccIsPov = _charchatRowIsPov(ccRow.section, ccRow.sectionId);
            if (ccEmoLine || ccIsPov) {
                // Emotion tail belongs to the contact turn above it (not a new one); POV
                // turns get no avatar. Either way, break the run without anchoring.
                // [v2.57.0] The tail is now also where the open run LEARNS its emotion.
                // charChatParseEmotion is the shared parser (not a fourth private copy of
                // the pattern) and it already runs resolveEmotion, so the sentinel can only
                // ever carry one of the canonical 24 — exactly the vocabulary the bridge's
                // per-emotion slot lookup keys off. A malformed tail returns '' and the
                // sentinel degrades to the bare contactId form, which the bridge still
                // paints as the plain Avatar slot.
                if (ccEmoLine && ccPendingRun) {
                    ccPendingRun.emotion = charChatParseEmotion(ccTxt);
                    ccPendingRun = null;
                }
                if (ccIsPov) { ccInContactRun = false; ccPendingRun = null; }
            } else {
                // A contact BODY section. Anchor an avatar only on the FIRST of a run.
                if (!ccInContactRun) {
                    // sectionId's doc comment: the widget inserts AFTER this section, so
                    // to place the avatar BESIDE the bubble (not below it) we anchor on
                    // the PREVIOUS section and let the bridge pull it down into the
                    // gutter. ccPrevId is the section immediately above this one.
                    ccPendingRun = { anchorId: ccPrevId, emotion: '' };
                    ccAvaRuns.push(ccPendingRun);
                }
                ccInContactRun = true;
            }
        }
        ccPrevId = ccRow.sectionId;

        if (!ccTxt) continue;
        // Fresh regex per section: _charchatImageResolvedRx() is /g and therefore
        // stateful via lastIndex. Reusing one instance across sections silently skips
        // matches. (This is the same reason the scanner elsewhere rebuilds it per use.)
        let ccRx = _charchatImageResolvedRx();
        let ccM: RegExpExecArray | null;
        while ((ccM = ccRx.exec(ccTxt)) !== null) {
            // [v2.49.0 CHARCHAT-IMGWIDGET-FIX] Stripped to NAI's own documented example
            // shape. v2.48.0 sent { type, sectionId, side, display, content:[box[text]] }
            // and the main thread rejected the whole option:
            //   "createWidgets: optionsList[0] does not match any of the allowed types"
            // The OUTER shape was verified correct against DecorationCreateNodeWidgetOptions
            // (type/sectionId/side/display/content are all declared there), so the rejection
            // was inside content — and rather than guess which field the runtime validator
            // dislikes, this is now literally the shape script-types.txt's own createWidgets
            // example uses: type + sectionId + a bare text part. Nothing else. Every dropped
            // field was unproven IN A WIDGET in this file: 'box' and styled 'text' are used
            // 39x/265x here but only ever inside MODALS, and noTemplate/userSelect had
            // essentially no prior use at all.
            // DROPPING noTemplate IS SAFE ONLY BECAUSE the sentinel no longer carries the
            // desc: it is now the 8-hex id and nothing else, so there is no model prose in it
            // that could contain {{...}} for UIPartText to resolve as a storage key. The two
            // changes are one change. The bridge reads the caption from
            // EVT_CHARCHAT_STATE.turns[].images[].desc instead, which it already receives.
            // side:'after' was redundant anyway — sectionId's own doc comment reads
            // "Section to insert the widget AFTER".
            // [v2.178.0 CHAT-LANE] '|p' MARKS A POV PHOTO, and it exists because the card is
            // now styled as part of the bubble and the two sides are not the same shape. A
            // contact photo sits BETWEEN the head and the emotion tail, so it is a middle
            // segment: square top and bottom. A POV turn has no tail, so its photo is the
            // LAST segment and has to carry the bubble's bottom corners. The bridge cannot
            // work that out -- .ae-ccimg.pov has existed in its stylesheet since v2.4.0 and
            // NOTHING HAS EVER APPLIED IT, so POV photos have never been right-aligned
            // either; this is what finally sets it.
            // FLAG DAY, same rule as the avatar sentinel's '|emotion' suffix: a bridge older
            // than v2.108.0 fails its 8-hex test on the suffixed form and paints no POV
            // photo. Ship the pair.
            ccOpts.push({
                type: 'node',
                sectionId: ccRow.sectionId,
                content: [{
                    type: 'text',
                    text: AE_CHARCHAT_IMG_SENTINEL + ccM[1]
                        + (_charchatRowIsPov(ccRow.section, ccRow.sectionId) ? '|p' : ''),
                    style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
                }]
            });
        }
    }

    // [v2.57.0 CHARCHAT-AVATAR-EMOTION] Emit the avatar sentinels now that every run's
    // Emotion: tail has been read. Order within the options list does not matter — each
    // widget carries its own explicit sectionId — so appending after the image sentinels
    // is safe.
    // FLAG DAY: the '|emotion' suffix is parsed by the bridge's _ccavPaintOne (bridge
    // v2.47.0+). An OLDER bridge slices on the sentinel prefix and would read
    // "contactId|happy" as the whole id, matching no character and painting nothing —
    // so this engine wants bridge >= 2.47.0. The reverse pairing is fine: a 2.47.0
    // bridge with an older engine just sees no suffix and falls back to the Avatar slot.
    // [v2.131.0 CCAV-ENGINE] THE SENTINEL NOW CARRIES DISPLAY AS WELL AS IDENTITY:
    //     ce-chatava:<contactId>|<emotion>|<sizePx>|<shape>
    // Fields 3 and 4 are new, and they are what make avatar size/shape an ENGINE setting
    // without this file ever touching a pixel: the widget's content is ours to choose, so
    // the bridge is TOLD what to paint instead of consulting its own localStorage.
    // FLAG DAY, same rule as the '|emotion' suffix before it: an older bridge splits on the
    // FIRST '|' only and would read "happy|40|round" as the whole emotion, match no
    // per-emotion slot, and fall back to the plain Avatar image \u2014 degraded, not broken.
    // This engine wants bridge >= 2.100.0. The reverse pairing is fine: a 2.100.0 bridge
    // reading a 2-field sentinel falls back to its own defaults for the two missing fields.
    // The emotion field is now ALWAYS emitted (empty when there is none) rather than being
    // omitted with its separator, because a positional parse cannot skip a field.
    let ccAvaCfg: any = null;
    try { ccAvaCfg = await loadConfig(); } catch (_eAvCfg) { ccAvaCfg = null; }
    let ccAvaDisp = ceChatAvatarDisplay(ccAvaCfg);
    for (let ccA = 0; ccA < ccAvaRuns.length; ccA++) {
        let ccRun = ccAvaRuns[ccA];
        ccOpts.push({
            type: 'node',
            sectionId: ccRun.anchorId,
            content: [{
                type: 'text',
                text: AE_CHARCHAT_AVA_SENTINEL + (_aeCharChat.contactId || '')
                    + '|' + (ccRun.emotion || '')
                    + '|' + String(ccAvaDisp.size)
                    + '|' + ccAvaDisp.shape,
                style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
            }]
        });
    }

    if (!ccOpts.length) return;
    try {
        let ccHandles: any = await api.v1.editor.decorations.createWidgets(ccOpts);
        _ccImgHandles = (ccHandles && ccHandles.length) ? ccHandles : [];
    }
    catch (eccW) { aeLog('[AE:charchat] chat widget create failed (photos/avatars will not bind):', eccW); }
}

async function refreshCharChatDecorations(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); } catch (_eccScan) { return; }
    let povIds: number[] = [];
    let contactIds: number[] = [];
    // [v2.49.0 CHARCHAT-BUBBLES2] headIds/emoIds are DISJOINT from contactIds — a section
    // must land in exactly one node rule's scope or two boxes fight over the same paragraph.
    let headIds: number[] = [];
    let emoIds: number[] = [];
    let ccLastContact = -1;   // the contact section directly above; -1 when the run is broken
    let ccEmoLineRx = /^[ \t]*Emotion:/;
    let ccSeen = false;
    for (let ccIdx = 0; ccIdx < ccAll.length; ccIdx++) {
        let ccRow = ccAll[ccIdx];
        if (ccRow.sectionId === _aeCharChat.markerId) { ccSeen = true; continue; }
        if (!ccSeen) continue;
        if (_aeCharChat.setupIds.indexOf(ccRow.sectionId) >= 0) { contactIds.push(ccRow.sectionId); ccLastContact = -1; continue; }
        // An emotion line is its own section (NAI splits on the '\n' _charchatFormatReply
        // writes). Promote the contact bubble above it to HEAD and take this one as the tail.
        if (ccEmoLineRx.test((ccRow.section && ccRow.section.text) || '')) {
            emoIds.push(ccRow.sectionId);
            if (ccLastContact >= 0) {
                let ccK = contactIds.indexOf(ccLastContact);
                if (ccK >= 0) contactIds.splice(ccK, 1);
                headIds.push(ccLastContact);
            }
            ccLastContact = -1;
            continue;
        }
        // [v2.24.0] was an inline copy of the source/origin classifier — now shared with
        // the transcript walk and the normaliser, which is the only way all three can be
        // guaranteed to agree about who said what.
        if (_charchatRowIsPov(ccRow.section, ccRow.sectionId)) { povIds.push(ccRow.sectionId); ccLastContact = -1; }
        else {
            // [FEATURE v2.71.0 CHARCHAT-TRAILING-BLANK-COLOR, per user] The blank paragraph
            // CHARCHAT-TRAILING-BLANK (v2.70.0) leaves after a reply is genuinely
            // unclassifiable by _charchatRowIsPov — no source, no origin — so it fell
            // through to contactIds and was painted as part of the character's own bubble,
            // which is the opposite of what it's for (a place for the NEXT, user, message).
            // Detected here as "empty text AND the last section in the document" and routed
            // to povIds instead. VISUAL ONLY: this does not touch the section's actual
            // source/origin, so _charchatScanTurns and _charchatCanonicalChatText (which
            // call _charchatRowIsPov directly, not through this loop) are unaffected — the
            // model's context never sees this section as a POV turn while it's empty. The
            // moment the user types into it, its real content and classification take over
            // on the next refresh regardless of which color it briefly wore while blank.
            let ccIsTrailingBlank = (ccIdx === ccAll.length - 1) && !((ccRow.section && ccRow.section.text) || '').trim();
            if (ccIsTrailingBlank) { povIds.push(ccRow.sectionId); ccLastContact = -1; }
            else { contactIds.push(ccRow.sectionId); ccLastContact = ccRow.sectionId; }
        }
    }
    try {
        await api.v1.editor.decorations.updateRules([
            { id: AE_CHARCHAT_RULE_POV,     scope: { sectionIds: povIds } },
            { id: AE_CHARCHAT_RULE_CONTACT, scope: { sectionIds: contactIds } },
            // [v2.47.0] Same scope as CONTACT — the pattern match already restricts which
            // TEXT within those sections actually gets tagged, so reusing the list costs
            // nothing extra and stays trivially in sync with the contact classification.
            // [v2.49.0] The inline emotion text rule spans BOTH the tail sections and the
            // contact bubbles — belt and braces: if NAI ever stops splitting on '\n' and
            // the emotion line comes back inside the reply's own section, this rule still
            // styles it (and HEAD/EMOBOX simply find nothing to scope, which is harmless).
            { id: AE_CHARCHAT_RULE_EMOTION, scope: { sectionIds: contactIds.concat(headIds, emoIds) } },
            { id: AE_CHARCHAT_RULE_HEAD,    scope: { sectionIds: headIds } },
            { id: AE_CHARCHAT_RULE_EMOBOX,  scope: { sectionIds: emoIds } },
            // Names are hidden across every speaking section, both sides.
            { id: AE_CHARCHAT_RULE_NAME, match: _charchatNameRuleMatch(), flags: 'm',
              scope: { sectionIds: povIds.concat(contactIds, headIds) } },
            // [v2.51.1 CHATIMG-HIDE-TAG] Same scope as NAME — an image tag can appear in
            // either speaker's turn (the POV side attaches photos too), and HEAD is included
            // for the same belt-and-braces reason EMOTION includes it above.
            { id: AE_CHARCHAT_RULE_IMGTAG, scope: { sectionIds: povIds.concat(contactIds, headIds) } }
        ]);
    } catch (eccD) { aeLog('[AE:charchat] decoration refresh failed (cosmetic only):', eccD); }
    // [v2.48.0 CHARCHAT-IMGWIDGET] Deliberately called from HERE rather than from each of
    // this function's own seven call sites: the image anchors and the bubble decorations
    // describe the same document state, so binding them together is the only way they
    // cannot drift. Awaited but non-fatal — it has its own try/catch inside, and a
    // missing photo anchor must never take the bubbles down with it.
    // [DIAG CE-DIAG-FLAGS] ccSkipWidgets — skip the clear+rebuild widget pass but keep
    // bubble decorations (the updateRules call above still ran). Isolates the handoff's
    // untested next-step #4: the widget pass is the most document-invasive per-turn
    // operation and sits directly between "reply landed" and "next Send declared safe".
    if (CE_DIAG.ccSkipWidgets) { aeLog('[AE:diag] ccSkipWidgets ON \u2014 widget clear/rebuild skipped this turn.'); return; }
    try { await refreshCharChatImageWidgets(); } catch (_eccIw) {}
}

// ── Context assembly ────────────────────────────────────────────

// ── [v2.24.0 CHARCHAT-PERSONA] Structured texting persona ───────────────
// Three closed axes plus a free-text escape hatch, per user: STRUCTURED OPTIONS,
// NOT GENERATED. The reason is placement, not taste — the compiled persona rides the
// next-message instruction (buildCharChatInstruction), a terse block at the TRUE
// bottom of context. A generated paragraph would drown that block and be re-paid on
// every single turn; three enum lookups cost one sentence.
// 'auto' on every axis is the deliberate default and means "say nothing, let
// CHARCHAT_DEFAULT_RUBRIC in the system prompt do its job" — that rubric already tells
// the model to derive a texting style from the character's own age/traits/tech
// familiarity, which is the right behaviour until an author disagrees with it. So an
// empty compiled clause is a CORRECT output, not an unconfigured one.
// Each option's `clause` is what actually reaches the model: short, imperative, and
// written to be concatenated rather than read in isolation.
interface CharChatOpt { id: string; label: string; clause: string; }

// [v2.106.0 PERSONA-AUTO-COPY] The 'auto' rows said "Auto (from their profile)", which
// over-promised: NOTHING is compiled from the profile on this side. 'auto' emits an EMPTY
// clause on purpose (see the note above), and what actually produces a per-character
// texting voice is CHARCHAT_DEFAULT_RUBRIC in the system prompt, which asks the model to
// derive one from the character's age, traits, habits and tech familiarity. That is the
// behaviour an author wants by default \u2014 "how this character would text" \u2014 but the
// old label read as a CE feature that could be inspected and debugged, and there was
// nothing behind it to inspect. The rows now say what the state IS, not where it came from.
// Behaviour is UNCHANGED by this patch; only the strings moved.
const CHARCHAT_STYLE_OPTS: CharChatOpt[] = [
    { id: 'auto',     label: 'Default \u2014 how they would text', clause: '' },
    { id: 'casual',   label: 'Digital native / casual',   clause: 'relaxed grammar, lowercase, slang and abbreviations' },
    { id: 'standard', label: 'Standard / adult',          clause: 'standard punctuation, clear syntax, concise phrasing' },
    { id: 'formal',   label: 'Formal / tech-unsavvy',     clause: 'overly formal grammar, full sentences, heavy ellipses' },
    { id: 'clipped',  label: 'Clipped / guarded',         clause: 'short and flat, minimal punctuation, gives little away' },
    { id: 'warm',     label: 'Warm / effusive',           clause: 'affectionate, generous with words, leans into feeling' },
    { id: 'florid',   label: 'Florid / theatrical',       clause: 'ornate word choice, dramatic phrasing, deliberate flourish' }
];

// `tokens` is the whole reason verbosity is not just another clause: telling the model
// "be brief" while handing it a 240-token cap is two instructions that disagree, and
// the cap always wins. This axis sets BOTH. tokens:0 means "use AE_CHARCHAT_MAX_TOKENS".
interface CharChatVerbOpt extends CharChatOpt { tokens: number; }
const CHARCHAT_VERBOSITY_OPTS: CharChatVerbOpt[] = [
    { id: 'auto',   label: 'Default \u2014 SMS length',  clause: '',                                        tokens: 0   },
    { id: 'terse',  label: 'Terse (a few words)',      clause: 'a few words, under 10 words',             tokens: 60  },
    { id: 'short',  label: 'Short (one sentence)',     clause: 'one sentence, under 20 words',            tokens: 90  },
    { id: 'normal', label: 'Normal (SMS length)',      clause: 'SMS length, under 32 words',              tokens: 120 },
    { id: 'chatty', label: 'Chatty (two or three)',    clause: 'two or three sentences, under 50 words',  tokens: 170 },
    { id: 'long',   label: 'Long (a short paragraph)', clause: 'up to a short paragraph, under 80 words', tokens: 240 }
];

const CHARCHAT_EMOJI_OPTS: CharChatOpt[] = [
    { id: 'auto',  label: 'Default \u2014 how they would text', clause: '' },
    { id: 'none',  label: 'Never',                     clause: 'never use emoji or kaomoji' },
    { id: 'rare',  label: 'Rare',                      clause: 'emoji only rarely, and never the same one twice in a row' },
    { id: 'some',  label: 'Some',                      clause: 'occasional emoji, never the same one twice in a row' },
    { id: 'heavy', label: 'Heavy',                     clause: 'expressive emoji and kaomoji throughout, but never repeat one consecutively' }
];

function _charchatOpt(opts: CharChatOpt[], id: string): CharChatOpt {
    let ccWant = id || 'auto';
    for (let ccI = 0; ccI < opts.length; ccI++) { if (opts[ccI].id === ccWant) return opts[ccI]; }
    return opts[0];
}

// The compiled persona as ONE line for the instruction block. Empty when the persona is
// absent, disabled, or fully 'auto' — see the 'auto' note above; that is the intended
// resting state.
function buildCharChatPersonaClause(char: CharacterRecord): string {
    let cp = char.chatPersona;
    if (!cp || cp.enabled === false) return '';
    let ccBits: string[] = [];
    let ccSt = _charchatOpt(CHARCHAT_STYLE_OPTS, cp.style || 'auto').clause;
    if (ccSt) ccBits.push('Style: ' + ccSt + '.');
    let ccVb = _charchatOpt(CHARCHAT_VERBOSITY_OPTS, cp.verbosity || 'auto').clause;
    if (ccVb) ccBits.push('Length: ' + ccVb + '.');
    let ccEm = _charchatOpt(CHARCHAT_EMOJI_OPTS, cp.emoji || 'auto').clause;
    if (ccEm) ccBits.push('Emoji: ' + ccEm + '.');
    if (cp.notes && cp.notes.trim()) ccBits.push(cp.notes.trim().replace(/\s+/g, ' '));
    // [LEGACY v2.21.0] the old freeform shape, folded in as trailing notes so a
    // character authored before v2.24.0 does not silently lose their register.
    let ccLeg: string[] = [];
    if (cp.register && cp.register.trim()) ccLeg.push(cp.register.trim());
    if (cp.voice && cp.voice.trim())       ccLeg.push(cp.voice.trim());
    if (cp.content && cp.content.trim())   ccLeg.push(cp.content.trim());
    if (ccLeg.length > 0) ccBits.push(ccLeg.join(' ').replace(/\s+/g, ' '));
    return ccBits.join(' ');
}

// The output cap for THIS contact. Verbosity owns it entirely (see
// CHARCHAT_VERBOSITY_OPTS's `tokens` note). [v2.27.0] No longer tops up for
// "thinking" — CHARCHAT-THINK's inline reasoning line shared this budget with the
// reply itself; its replacement, generateEphemeral(), is a fully separate call with
// its own budget, so there is nothing left for this function to add for it.
// [v2.99.0 CCINT] povId is optional and MUST be passed at both pin sites: this
// function is called from startCharChat BEFORE _aeCharChat is assigned, so it cannot
// read the mode from module state. Pass the mode, do not read it. Omitting it (the
// char-edit persona preview) correctly yields the phone answer.
function charChatMaxTokensFor(char: CharacterRecord | null, cfg: GlobalConfig | null, povId?: string): number {
    // Interview ignores the persona verbosity ladder entirely — that axis IS the SMS
    // axis, wording and cap together, and neither half applies to someone speaking.
    if (_ccIsInterview(povId || '')) return AE_CCINT_MAX_TOKENS;
    let ccBase = AE_CHARCHAT_MAX_TOKENS;
    let ccCp = char ? char.chatPersona : null;
    if (ccCp && ccCp.enabled !== false) {
        let ccV = _charchatOpt(CHARCHAT_VERBOSITY_OPTS, ccCp.verbosity || 'auto') as CharChatVerbOpt;
        if (ccV && ccV.tokens > 0) ccBase = ccV.tokens;
    }
    return ccBase;
}

// THE steering surface. Everything the model needs to be this character, in one
// contiguous top-of-context block: framing, then "you are the following character",
// then that character's identity (their real lorebook text, folded in — which is why
// the entry itself is deactivated), their dynamic layer, and their texting register.
// Adjacency is guaranteed here in a way lorebook insertion order could never promise.
async function buildCharChatSystemPrompt(contact: CharacterRecord, cfg: GlobalConfig, povId: string): Promise<string> {
    let ccOut: string[] = [];
    // [v2.99.0 CCINT] Forks 2 and 3 (framing + rubric). Everything below the rubric —
    // identity, dynamic block, adjacency — is IDENTICAL in both modes and must stay so.
    let ccInt = _ccIsInterview(povId);
    ccOut.push(ccInt
        ? 'INTERVIEW TRANSCRIPT. You are writing one side of a recorded interview.'
        : 'SMARTPHONE MESSAGING APP. You are writing one side of a live text-message conversation.');
    ccOut.push(ccInt
        ? 'Below the record you will find an interview transcript. Write ONLY the next spoken answer, as the character defined below. Do not narrate the story, do not write the interviewer\u2019s questions, and do not continue the prose above the interview marker \u2014 that story text is the record of what this character lived through, nothing more.'
        : 'Below the narrative context you will find a chat transcript. Write ONLY the next single message, as the character defined below. Do not narrate the story, do not write the other person\u2019s messages, and do not continue the prose above the chat marker \u2014 that story text is reference material for what these two know and where they stand, nothing more.');
    // [v2.24.0 CHARCHAT-PERSONA] The GLOBAL rubric lives here and only here. The
    // character's OWN persona (style/verbosity/emoji) no longer rides the system
    // prompt — it compiles to one line on the next-message instruction instead, per
    // user, where it is most present. Two useful side effects of the split: the
    // system prompt stays identical across every contact in a story (one less thing
    // invalidating the prefix cache when switching chats), and a persona edit takes
    // effect on the very next turn rather than needing a chat restart.
    ccOut.push(ccInt ? CCINT_RUBRIC : CHARCHAT_DEFAULT_RUBRIC);
    ccOut.push('You are the following character:');

    let ccIdentity = '';
    try { ccIdentity = (await buildLorebookContent(contact)).trim(); }
    catch (eccI) { api.v1.error('[AE:charchat] identity build failed:', eccI); }
    if (ccIdentity) ccOut.push(ccIdentity);
    else ccOut.push(contact.name + (contact.briefDescription ? ('\n' + contact.briefDescription) : ''));

    let ccDyn = '';
    try { ccDyn = (await buildCharDynamicBlock(contact, cfg)).trim(); }
    catch (eccD2) { api.v1.error('[AE:charchat] dynamic block failed:', eccD2); }
    if (ccDyn) ccOut.push(ccDyn);

    return ccOut.join('\n\n');
}

// The next-message instruction. Appended to the END of storyText.content, which puts it
// at true bottom of context and keeps it invisible in the document.
// [OPEN — test this first] Whether appending to storyText.content disturbs where the
// model continues from is the single biggest unknown in this design. If it misbehaves,
// the fallback is to carry this in the Author's Note and accept AN's fixed depth.
// [v2.99.0 CCINT] The interview tail. Same five-block stack SHAPE as the phone tail
// below, same priority order, and it inherits both of that tail's non-negotiable
// invariants:
//   CHARCHAT-USERTOKEN (v2.69.0) — the context must not end on a closed bracket block
//     or the model ends its turn and returns a zero-length completion ~50% of the
//     time. The dangling '<name>:' cue is the fix; it is appended by
//     runCharChatContextOverride, not here, and applies to both modes unchanged.
//   CHARCHAT-TAIL-TERMINAL (v2.62.0) — the LAST block must be UNCONDITIONAL, so turn 1
//     (no ephemeral) and turn 2 (ephemeral present) have structurally identical tails.
//     In the phone tail the Emotion directive holds that slot.
//
// [per user, v2.99.0] THE EMOTION DIRECTIVE IS DROPPED IN THIS MODE — one less block
// competing with response quality, which is the higher demand here than a reactive
// avatar. That is safe downstream (charChatParseEmotion returns '' on no match, the
// avatar sentinel falls back to the character's Avatar slot — the documented graceful
// path) but it VACATES the terminal slot, and the ephemeral "right now" line is the
// one conditional block in the stack. So the closing voice directive below is the
// replacement terminal: unconditional, and a directive rather than a statement. Do not
// let the ephemeral line drift under it — that re-opens a bug that took four versions
// to diagnose and presents as "the second answer is always empty".
//
// Also dropped: the texting-persona clause (it compiles an SMS register — lowercase
// slang, emoji density — which would put a spoken deposition in textspeak; their
// spoken register already arrives via voiceAndMannerisms / ce_fx_speech in the
// identity block) and the photo-attachment clause (an interview does not send
// selfies). Neither has an error path, which is exactly why they are named here.
function _ccintBuildInstruction(contact: CharacterRecord): string {
    let ccName = _aeCharChat.contactName || contact.name;
    let ccOut: string[] = [];

    ccOut.push('[ Instruction: Write ' + ccName + '\u2019s next spoken answer to the interviewer. '
             + 'Answer the question that was asked \u2014 do not open a new subject, and do not interview them back. '
             + 'Write ONLY the answer body: the name header is applied automatically, so never write one yourself. '
             + 'Never write curly braces around your answer \u2014 those belong to the interviewer\u2019s questions only. ]');

    // The anti-fabrication clause. An interview invites invention in a way a text
    // thread does not (the questions are ABOUT things, and the model would rather
    // answer than admit a gap), and an invented event read back as canon is the
    // expensive failure of this mode.
    ccOut.push('[ The record: ' + ccName + ' is answering about events they lived through. '
             + 'Where the record is silent they may say they do not remember, or that they would rather not talk about it '
             + '\u2014 inventing an event that is not in the record is worse than admitting to a gap. ]');

    let ccEph = (contact.ephemeral && contact.ephemeral.compressedLine) ? String(contact.ephemeral.compressedLine).trim() : '';
    if (ccEph) ccOut.push('[ ' + ccName + ' right now: ' + ccEph + ' ]');

    // TERMINAL BLOCK — unconditional, see CHARCHAT-TAIL-TERMINAL above. Nothing may be
    // pushed after this line.
    ccOut.push('[ Answer in ' + ccName + '\u2019s own voice, and stop when the answer is finished \u2014 no closing remark, and no question back. ]');
    return ccOut.join('\n');
}

// [v2.24.0] This block grew from one line into the chat's whole steering tail, in
// deliberate priority order — task, then register, then state, then output protocol.
// Everything that used to be scattered (persona in the system prompt, ephemeral in the
// Author's Note) now lands here, because "most present" is a position, not a volume:
// the bottom of context is the only place we control precisely.
// [v2.99.0 CCINT] The interview tail is a SEPARATE builder rather than five ternaries
// through this one. Deliberate: the phone tail below is the output of a four-version
// empty-reply debugging arc (CHARCHAT-USERTOKEN / CHARCHAT-TAIL-TERMINAL) and is left
// byte-identical, so the new mode cannot regress it.
function buildCharChatInstruction(contact: CharacterRecord, povName: string, cfg: GlobalConfig | null, povId: string): string {
    if (_ccIsInterview(povId)) return _ccintBuildInstruction(contact);
    let ccName = _aeCharChat.contactName || contact.name;
    let ccAddr = povName ? (', addressed to ' + povName) : '';
    let ccOut: string[] = [];

    // [v2.22.0/v2.24.0] The name header is never requested and never trusted — it is
    // applied programmatically (charChatCleanReply on the way in, then
    // _charchatNormalizeDocument as a standing pass). Saying so explicitly is cheap and
    // stops the model spending its 120 tokens re-deriving a header we throw away.
    ccOut.push('[ Instruction: Write the next single message from ' + ccName + ccAddr + '. '
             + 'If the previous message also belongs to ' + ccName + ' \u2014 complement it rather than repeating it. '
             + 'Write ONLY the message body: the name header is applied automatically, so never write one yourself. '
             // [v2.41.0 CHARCHAT-CONTACT-BRACE] Naming the specific failure, not just forbidding
             // headers in the abstract. The model was writing a header plus a lone brace,
             // imitating the convention it can see on the POV turns above. The prohibition was
             // already there and was already losing to the shape of the context; the cleanup in
             // _charchatCanonContact is the actual guarantee, this is the cheap prevention.
             + 'Never write curly braces around your message \u2014 those belong to ' + (povName || 'the other person') + '\u2019s messages only. ]');

    let ccPersona = buildCharChatPersonaClause(contact);
    if (ccPersona) ccOut.push('[ ' + ccName + '\u2019s texting style: ' + ccPersona + ' ]');

    // [v2.24.0, per user] The ephemeral line used to ride the Author's Note. The AN
    // lands at the user's configured depth INSIDE recent history and the hook exposes no
    // depth control, so a "right now" line was always some arbitrary distance from the
    // point of generation. Here it sits at the true bottom — most present, which is
    // exactly what a right-now line wants to be. The AN is deactivated during chat as a
    // result; see runCharChatContextOverride.
    // [v2.43.0 CHARCHAT-TAIL-ORDER, per user] Read here, PUSHED LAST (see the bottom of this
    // function). v2.24.0 moved this line off the Author's Note precisely so it could be
    // most-present at the true bottom of context — and then the photo block and the emotion
    // list piled up underneath it, so the one block whose entire job is to be closest to the
    // generation point was sitting THIRD of five, behind ~110 words of usually-irrelevant
    // instruction. Per the user's own context dump, that is where the thought was buried.
    let ccEph = (contact.ephemeral && contact.ephemeral.compressedLine) ? String(contact.ephemeral.compressedLine).trim() : '';

    // [v2.27.0] CHARCHAT-THINK's inline "[Thinking: ...]" request is GONE — the model
    // no longer generates or reasons through a private line as part of this same
    // completion. Freshness comes from the ccEph block above instead.
    // [v2.45.0 CHARCHAT-THOUGHT-POST] ccEph IS one turn stale again, and that is now the
    // accepted design rather than a defect to chase. With GlobalConfig.charChatFreshThoughts
    // on, generateChatEphemeral() runs from onGenerationEnd AFTER each reply, so the line
    // below describes the moment the LAST reply landed. v2.38.0-v2.44.1 spent four versions
    // trying to make it describe THIS moment and every one of them cost the reply itself;
    // read the CE-INDEX v2.45.0 block before trying a fifth. NOTE the read below is unchanged
    // and unconditional: if thinking failed, was cancelled, or is switched off, char.ephemeral
    // simply still holds
    // the previous snapshot and it is served exactly as before. That is the silent
    // fallback the user asked for, and it needs no code here because it needs none
    // anywhere — not writing is the fallback.
    // [v2.43.0 CHARCHAT-EMOTION-LIST, per user] REVERSES v2.25.0, which spelled the 24 words
    // out here via ALL_EMOTIONS_LIST. v2.25.0's own reasoning conceded the point: it called
    // the list "encouragement, not enforcement" because resolveEmotion() normalises the
    // answer regardless. Encouragement is not free at the bottom of context — it cost 24
    // words directly in front of the generation point, ahead of the thought. The list is gone
    // and the normaliser (which was always the actual enforcement) does the work alone.
    // ALL_EMOTIONS_LIST is left DECLARED: it is still the single source of truth for the 24
    // words, and this is now simply not one of its readers.
    // [v2.32.0 CHARCHAT-IMG] Attachment clause, only when the feature is on — an
    // instruction to send photos the engine will not act on is worse than no
    // instruction, since the model would emit tags that render as literal text.
    // The model is asked for a DESCRIPTION, not for tags: the architect pass turns it
    // into a real prompt, and the character's own visual record is applied
    // programmatically (see buildCharChatImagePrompt), so asking the model to describe
    // its own appearance would just be a worse, contradictory copy of data we hold.
    // NOTE the deliberate divergence from DEFAULT_NOTE (the legacy auto-illustrator
    // story note, grep it): that one asks for comma-separated Danbooru tags including
    // the character's own name, because it had no architect in the loop. This does.
    if (cfg && cfg.charChatImages) {
        ccOut.push('[ You may attach a photo when it fits \u2014 a selfie, something you are looking at, '
                 + 'or anything ' + (povName || 'they') + ' asks you to show. Do it when it is natural, and always when asked. '
                 + 'To attach one, put this on its own line AFTER your message text: [Image: a clear description of what the photo shows] '
                 + 'Describe the shot in plain words (what you are doing, wearing, where you are, the framing). '
                 + 'Do not describe your own face or body \u2014 that is applied automatically. Never attach more than one photo per message. ]');
    }

    // [v2.43.0 CHARCHAT-EMOTION-LIST, per user] The 24-word list is GONE. It was 24 words of
    // the most expensive context in the file spent constraining an output that gets normalised
    // anyway: resolveEmotion()/EMOTION_MAP already maps 136 synonyms onto exactly those 24
    // canonical words (verified by count), every canonical word self-maps, and BOTH readers of
    // this tag — charChatParseEmotion on the way in and _charchatCanonContact on the document
    // — already run it through that map. So "annoyed" was always going to become "irritated"
    // whether or not the model was handed the list. A word that misses the map resolves to
    // 'neutral', which is the same graceful degradation the emotion-image widget already
    // depends on. Ask for one plain word; let the filter do the job it already does.
    // [v2.62.0 CHARCHAT-TAIL-TERMINAL] DELIBERATE PARTIAL REVERSAL of v2.43.0
    // CHARCHAT-TAIL-ORDER. v2.43.0 pushed the thought LAST, and it was right that the thought
    // wants to be most-present. What it did not account for is that the thought is the ONLY
    // block in this tail that is conditional, and it is a STATEMENT rather than a directive.
    // The consequence, only visible once the thought subsystem started producing reliably:
    //   turn 1 of a fresh chat  -> no ephemeral yet -> prompt ends '[ End your message ... ]'
    //   turn 2 onward           -> ephemeral exists -> prompt ends '[ Name right now: ... ]'
    // So the LAST thing the model reads changes shape permanently after the first reply, which
    // maps exactly onto the reported failure (first message always answers, every message after
    // it returns an empty completion, and switching thoughts off makes every turn behave like
    // turn 1). Whatever the mechanism, the prompt should not silently change its terminal block
    // halfway through a conversation. The thought keeps its position at the bottom of the
    // instruction stack; the Emotion directive is now unconditionally the final line, so turn 2's
    // tail is structurally identical to turn 1's. See CE-INDEX v2.62.0.
    if (ccEph) ccOut.push('[ ' + ccName + ' right now: ' + ccEph + ' ]');
    ccOut.push('[ End your message with a new line: Emotion: <a single word for how ' + ccName + ' feels right now> ]');
    return ccOut.join('\n');
}

// ── [v2.24.0 CHARCHAT-TURNS] Canonical turn formatting ──────────────────
// THE replacement for the v2.22.0 POV scaffold, per user: instead of appending a
// half-written "{user: " into the document in ADVANCE and depending on the user to
// finish it (including a closing brace they were never obliged to type), the user
// writes whatever they like and we rewrite it into canonical shape AFTERWARDS.
//   "{Hi, Sara}"  ->  "{user: Hi, Sara}"
//   "Hi, Sara"    ->  "{user: Hi, Sara}"
//   "{Hi, Sara"   ->  "{user: Hi, Sara}"     (unclosed brace closed for them)
//   "Hi, Paul"    ->  "Sara:\nHi, Paul"        (contact side)
// A header the MODEL wrote itself is stripped and re-applied rather than trusted, so a
// WRONG one (the contact's name on the POV's line, or vice versa) can never survive.
// As the format stabilises in the transcript the model will tend to produce the right
// one unprompted, per user — and this pass costs nothing on the turns where it does.
// This SUPERSEDES the v2.23.0 dangling-scaffold context strip, which fixed the same
// root cause (an unclosed "{user: " reaching the model, whose most natural
// continuation is to finish user's line rather than reply as the contact) by deleting
// the scaffold from context. That was a patch on a self-inflicted wound; there is no
// scaffold now, and every POV turn is re-emitted WITH its closing brace whether the
// user typed one or not, so a dangling "{" cannot reach the model from any source.

const CHARCHAT_EMOTION_PREFIX = '  Emotion: ';   // [v2.24.0, per user] two leading spaces. The one authored string in this subsystem whose exact whitespace is load-bearing — user's emotion-image widget matches on it.

// One shared regex builder rather than three drifting copies (the v2.23.0 file had the
// emotion pattern written out in three places, and _charchatBareBody's copy silently
// stopped matching the moment the prefix gained leading spaces).
function _charchatEmotionRx(): RegExp { return /[\n\r\s]*Emotion:[ \t]*([^\n\r]+?)[ \t]*$/i; }

// ── [v2.32.0 CHARCHAT-IMG] Image attachment tags ────────────────────────────
// TWO regexes, and the distinction is the whole mechanism:
//   UNRESOLVED  "[Image: a description]"          — what the MODEL writes. Deliberately
//               tolerant of an inner leading space (bracket-space-Image-colon) and of
//               any case, per user (both spaced and unspaced forms are caught).
//   RESOLVED    "[Image#7f3a91c2: a description]" — what WE rewrite it to once the
//               image has been dispatched, where the hex is the image uuid's prefix.
// The '#' is what separates them, and it separates them for free: the unresolved
// pattern requires ':' directly after the word, so a resolved tag can never re-match
// it. That is what makes the pass idempotent — it can run on every generation end
// without re-architecting (and re-paying for) images it already handled.
//
// WHY THE TAG STAYS IN THE DOCUMENT (deliberate, same reasoning as the Emotion
// sidecar one floor up — see charChatCleanReply's own note): the document text is the
// durable record. It is what collectCharChatTranscript serialises into the lorebook on
// Save and what resumeCharChatFromEntry reads back. Strip the tag once rendered and a
// resumed thread has a hole where the image was — the bytes are still in the bridge's
// IndexedDB but nothing points at them. Embedding the uuid IN the text means the
// pointer survives the document -> lorebook -> document round trip as plain text, with
// no side-table to keep in sync. Rendering it AS an image instead of as text is the
// bridge's job, not the document's.
function _charchatImageRx(): RegExp { return /\[[ \t]*Image[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/gi; }
function _charchatImageResolvedRx(): RegExp { return /\[[ \t]*Image#([0-9a-f]{8})[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/gi; }

// Max attachments dispatched per generation-end pass. A model that decides every
// message deserves a photo would otherwise spend real budget without bound; this is a
// backstop, not a design feature.
const AE_CHARCHAT_IMG_MAX_PER_TURN = 2;
const AE_CHARCHAT_IMG_MAX_TOKENS = 300;   // matches buildArchitectPromptFromStory's own architect cap

// Role classification, in ONE place. Previously duplicated verbatim in
// refreshCharChatDecorations and collectCharChatTranscript. Role is NEVER inferred from
// text — same guarantee WIZLIVE gives, and the reason the whole POV-optional design
// works at all.
// [BUGFIX v2.32.1 CHARCHAT-BRIDGE-ORIGIN, per user report] 'script' origin ADDED
// alongside 'user'/'edit'. Root cause of the doubled-brace / bled-together report
// ("{ {Nate: ...}Sara: ...} }"): a bridge-sent turn is appended via
// api.v1.document.appendParagraph, which gives that text origin data:'script' — NOT
// 'user'. The (correct, narrower) origin check below used to require 'user'/'edit' to
// call a paragraph POV, so a script-authored turn fell through to FALSE... except
// handleCharChatAction's 'send' op ALSO stamped source:'instruction' on it (reusing the
// setup-paragraph shortcut above), which forced it POV regardless of what NAI appended
// afterward. That shortcut is exactly what _charchatMergeSplitIdx's own v2.25.0 comment
// already named as the confirmed source of this class of bug for typed turns — the
// bridge path walked into the identical trap via a different door. Fix is two-sided:
// this function now recognises 'script' as legitimately-typed origin in its own right
// (so the source:'instruction' shortcut is no longer needed for bridge turns), AND
// handleCharChatAction's 'send' op no longer sets source:'instruction' on a real turn
// (grep CHARCHAT-BRIDGE-ORIGIN there) — that field stays reserved for actual setup/
// marker/resumed-history paragraphs. See _charchatMergeSplitIdx just below for the
// other half: it must also recognise 'script' as a valid pre-AI origin, or the merge
// this fix now correctly EXPOSES (script text + AI reply glued onto the same section)
// would still never get physically split.
// [BUGFIX v2.34.0 CHARCHAT-STAGED-IDS, per user] REVERTS v2.32.1 CHARCHAT-BRIDGE-ORIGIN's
// 'script' widening, which was self-contradicting and is the confirmed root cause of the
// "{ {Nate: ...} }" / "{ {Nate: Emotion: neutral} }" corruption. The contradiction, stated
// plainly: _charchatSplitMergedSections inserts THE CONTACT'S REPLY TAIL via
// insertParagraphAfter, and its own comment gives the reason it is safe to do so \u2014
// "script-written text gets 'script' origin, which _charchatRowIsPov correctly reads as
// NOT a POV turn". v2.32.1 made 'script' read as POV to accommodate bridge-sent turns, so
// every engine-authored contact paragraph (a split tail, an Emotion: line) started
// classifying as the POV speaking, got wrapped by _charchatCanonPov, and then re-wrapped
// when grouping joined it to the adjacent real POV turn. Origin CANNOT answer this
// question: an engine-written POV turn and an engine-written contact reply are both
// 'script'. So the engine now RECORDS what it authored (stagedPovIds) instead of trying to
// infer it back out of metadata, and this function returns to the v2.31.0 rule \u2014 the
// last version that formatted correctly, per user.
// [v2.46.0 CHARCHAT-SHELL-BASELINE] The stagedPovIds consult is GONE and this is the v2.31.0
// rule again, unaided: a section is a POV turn if NAI stamped it entirely user/edit-typed.
// That rule was correct for four years of this subsystem and only ever failed for paragraphs
// the ENGINE or the BRIDGE wrote — which no longer happens for POV turns. The sectionId
// parameter is KEPT: every caller already passes it, removing it touches five call sites for
// no gain, and the next feature that needs per-section ground truth will want it back.
function _charchatRowIsPov(section: any, sectionId?: number): boolean {
    if (section.source === 'instruction') return true;
    let ccOrg = section.origin || [];
    if (ccOrg.length === 0) return false;
    let ccAllTyped = true;
    let ccAnyUser = false;
    for (let ccO of ccOrg) {
        if (ccO.data === 'user') ccAnyUser = true;
        if (ccO.data !== 'user' && ccO.data !== 'edit') { ccAllTyped = false; break; }
    }
    return ccAllTyped && ccAnyUser;
}

// [BUGFIX v2.25.0 CHARCHAT-MERGE] Detect a section whose origin metadata crosses from
// user-typed (user/edit) to AI-generated (ai/prompt) data. This is the signature of NAI's
// native Send continuing a completion DIRECTLY INTO the same paragraph the user just
// typed into, because the cursor had no trailing paragraph break — rather than starting a
// fresh section for the reply. _charchatRowIsPov trusts a 'instruction' source for the
// WHOLE section regardless of what got appended to it afterward, so a merged section like
// this was being canonicalised as one giant POV turn: the user's own text PLUS the start
// of the contact's reply, wrapped together in POV braces. That is the confirmed source of
// both the "double brace" and "contact's header bleeding into the POV body" reports.
// Returns the character offset into section.text where the AI-authored portion begins,
// or -1 if the origin is homogeneous (nothing to split). Sorted defensively; origin spans
// are not documented as guaranteed-ordered.
// [BUGFIX v2.32.1 CHARCHAT-BRIDGE-ORIGIN] 'script' recognised as pre-AI origin — see
// _charchatRowIsPov's note just above for the full story. Without this, a bridge-sent
// turn (origin: script) that NAI glued a completion onto (origin gains ai/prompt) was
// INVISIBLE to this detector: ccSawUser only ever flipped on 'user'/'edit', so a
// script→ai boundary was never found and the merged section was never physically
// split — it was scanned, canonicalised, and re-saved as one giant blob instead.
function _charchatMergeSplitIdx(section: any): number {
    let ccOrg = (section && section.origin) || [];
    if (ccOrg.length < 2) return -1;
    let ccSorted = ccOrg.slice().sort(function(a: any, b: any) { return a.position - b.position; });
    let ccSawUser = false;
    for (let ccO of ccSorted) {
        if (ccO.data === 'user' || ccO.data === 'edit') { ccSawUser = true; continue; }
        if (ccSawUser && (ccO.data === 'ai' || ccO.data === 'prompt')) return ccO.position;
    }
    return -1;
}

// Strip a leading "Name:" header — whoever wrote it. Every name we know about is tried,
// so a header the model got WRONG is removed too rather than kept and doubled up.
function _charchatStripHeader(body: string, names: string[]): string {
    let ccT = (body || '').replace(/^\s+/, '');
    for (let ccPass = 0; ccPass < 2; ccPass++) {   // 2 passes: "Sara:\nSara: hi" happens
        let ccHit = false;
        for (let ccI = 0; ccI < names.length; ccI++) {
            if (!names[ccI]) continue;
            // [\s*] not [\r?\n?] after the colon, and the difference is a REAL bug found
            // by test, not a style choice: _charchatScanTurns joins a grouped turn with
            // '\n', so a reply NAI split as ["Sara:", "", "Hi, Paul"] arrives here as
            // "Sara:\n\nHi, Paul". Consuming at most ONE newline left the blank line in
            // place — which is precisely the "the character response adds a second
            // [newline]" report this pass is meant to fix.
            let ccRx = new RegExp('^\\*{0,2}' + _charchatEscapeRx(names[ccI]) + '\\*{0,2}[ \\t]*[:\uff1a]\\s*', 'i');
            if (ccRx.test(ccT)) { ccT = ccT.replace(ccRx, ''); ccHit = true; break; }
        }
        if (!ccHit) break;
    }
    return ccT;
}

// Unwrap our own brace wrapper, tolerating BOTH the unclosed case and the never-opened
// case — per user, the user was never obliged to type either one.
function _charchatUnwrapPov(text: string): string {
    let ccS = (text || '').trim();
    // [BUGFIX v2.42.0 CHARCHAT-POV-IDEMPOTENT, per user] Was a single strip, so a re-sent
    // turn came back double-wrapped: the user deletes their message, retypes it, and the
    // canon of an already-canonical turn nested as a second layer. Reported directly, and
    // the double wrap changed the reply's behaviour enough to be worth removing as a
    // variable rather than explaining. Loop until there is no wrapper left, so
    // canon(canon(x)) === canon(x) and re-prompting is byte-identical to prompting once.
    // Bounded rather than while(true): a pathologically nested wrapper should cost a fixed
    // of passes, not hang the worker. 8 is far past anything a human or model produces.
    for (let ccPass = 0; ccPass < 8; ccPass++) {
        let ccBefore = ccS;
        if (ccS.charAt(0) === '{') ccS = ccS.substring(1);
        if (ccS.length > 0 && ccS.charAt(ccS.length - 1) === '}') ccS = ccS.substring(0, ccS.length - 1);
        ccS = ccS.trim();
        if (ccS === ccBefore) break;
    }
    return ccS.trim();
}

// CANONICAL POV TURN. '' means "there is no turn here" (an empty brace block, a stray
// blank paragraph) — callers drop it rather than emitting an empty one.
// [BUGFIX v2.27.0 CHARCHAT-BRACE-REVERT, per user] REVERTS v2.26.0 CHARCHAT-BRACE.
// v2.26.0 theorised NAI's own editor draws the visible bracket and stopped this
// function from ALSO wrapping the text in literal '{'/'}'. User's direct test
// falsifies that: a typed "{Hi!}" still came back doubled as "{{POVname: Hi!}}", and
// a bare "Hi!" came back as bodyless "{POVname}" — not a render-only bracket at all.
// Removing our own wrap also broke turn recognition outright: with no literal brace,
// a POV paragraph had nothing marking it as a fresh instruction turn, so it read as a
// continuation (a bare newline) of the previous contact turn instead of a new one.
// Output is "{Name: body}" again, matching every version before v2.26.0.
// _charchatUnwrapPov still tolerantly STRIPS a leading/trailing brace the user or
// model wrote — that part was never the bug and stays. NOTE: the real double-brace
// root cause was already fixed in v2.25.0 (_charchatSplitMergedSections, physical
// section splitting) — this revert does not touch or undo that fix.
function _charchatCanonPov(text: string, povName: string, contactName: string): string {
    let ccBody = _charchatStripHeader(_charchatUnwrapPov(text), [povName, contactName]).replace(/\s+$/, '');
    if (!ccBody) return '';
    return '{' + (povName ? (povName + ': ' + ccBody) : ccBody) + '}';
}

// CANONICAL CONTACT TURN. The Emotion tag is split off first and re-attached last, so
// the header strip can never mistake it for body and a body strip can never eat it.
function _charchatCanonContact(text: string, contactName: string, povName: string): string {
    let ccT = (text || '');
    let ccEmotion = '';
    let ccCut = ccT.match(_charchatEmotionRx());
    if (ccCut && ccCut[1] && ccCut.index !== undefined) {
        let ccE = ccCut[1].trim();
        // [v2.25.0, per user] Canonicalise to the 24-state list rather than keeping
        // whatever synonym the model wrote — resolveEmotion() is the same normaliser the
        // image-generation pipeline already uses (EMOTION_MAP), so "annoyed" becomes
        // "irritated" etc. instead of silently missing user's emotion-image widget, which
        // keys off one of the 24 canonical words.
        if (ccE.length > 0 && ccE.length <= 40) { ccEmotion = resolveEmotion(ccE); ccT = ccT.substring(0, ccCut.index); }
    }
    let ccBody = _charchatStripHeader(ccT, [contactName, povName]).replace(/\s+$/, '');
    // [BUGFIX v2.41.0 CHARCHAT-CONTACT-BRACE, per user live test] The model writes a header
    // plus a lone opening brace. It sees Name-colon after a brace-wrapped POV turn,
    // generalises the convention, and opens a brace of its own. On one reported send it
    // emitted ONLY that and stopped, so the message never arrived at all.
    // _charchatStripHeader removes the header correctly and leaves the bare brace as the
    // body, which this function then faithfully re-emits — enshrining the model's abandoned
    // scaffold as a turn.
    // The POV path has unwrapped stray braces since v2.24.0 (_charchatUnwrapPov); the contact
    // path never needed it until the model started imitating the POV form. Unwrap here too,
    // then treat a body that is nothing but punctuation as NO body: returning '' makes
    // _charchatNormalizeDocument drop the turn (see its ccCanon check) instead of keeping it.
    if (ccBody.indexOf('{') >= 0 || ccBody.indexOf('}') >= 0) {
        // [BUGFIX v2.62.0 CHARCHAT-BRACE-LINE, per user live transcript] The v2.41.0 unwrap only
        // ever looked at the FIRST and LAST character of the joined body, so it caught
        // "{...}" and "}" alone but not the shape actually reported:
        //     Nix: }
        //     Nix: Can't you figure it out? ...
        // That is one contact TURN whose grouped text is "}\nCan't you figure it out? ..." \u2014
        // the stray brace is a whole LINE, with real message text underneath it. charAt(0) is
        // '}' (not '{') so nothing was stripped, the scaffold-only guard below never fired
        // (the body has letters), and _charchatNormalizeDocument's grow pass then stamped a
        // header onto the brace line and enshrined it as its own visible message.
        // Strip leading and trailing lines that are pure brace/punctuation FIRST, then run the
        // existing boundary unwrap on what is left.
        let ccLinesB = ccBody.split('\n');
        while (ccLinesB.length > 1 && !/[\p{L}\p{N}]/u.test(ccLinesB[0])) ccLinesB.shift();
        while (ccLinesB.length > 1 && !/[\p{L}\p{N}]/u.test(ccLinesB[ccLinesB.length - 1])) ccLinesB.pop();
        let ccDeBraced = ccLinesB.join('\n');
        if (ccDeBraced !== ccBody) {
            aeLog('[AE:charchat:contact-brace] stripped a scaffold-only line from a contact turn '
                + '(the model opened or closed a brace on its own line before writing the message).');
            ccBody = ccDeBraced;
        }
        let ccUnwrapped = _charchatUnwrapPov(ccBody);
        ccUnwrapped = _charchatStripHeader(ccUnwrapped, [contactName, povName]).replace(/\s+$/, '');
        if (ccUnwrapped !== ccBody) ccBody = ccUnwrapped;
    }
    // Scaffold-only: no letter or digit anywhere. Not merely 'is it a brace' — the observed
    // failures are all header-plus-brace or brace-only, and a body of pure punctuation is
    // never a real text message in any of them.
    if (ccBody && !/[\p{L}\p{N}]/u.test(ccBody)) {
        aeLog('[AE:charchat:contact-brace] dropped a scaffold-only contact body '
            + JSON.stringify(ccBody.substring(0, 20)) + ' — the model wrote a header/brace and no message. '
            + 'The turn is dropped rather than enshrined; if this fires every turn, the reply prompt is losing to the context shape.');
        ccBody = '';
    }
    if (!ccBody && !ccEmotion) return '';
    // [v2.25.0, per user] Header and body share a line now ("Sara: message") \u2014 a
    // real text message doesn't put the sender's name on its own line. Emotion keeps its
    // own line below (unchanged, per user): CHARCHAT_EMOTION_PREFIX's leading newline is
    // still what user's emotion-image widget scans for.
    let ccOut = (contactName || 'They') + ': ' + (ccBody || '\u2026');
    if (ccEmotion) ccOut += '\n' + CHARCHAT_EMOTION_PREFIX + ccEmotion;
    return ccOut;
}

// A logical turn = a run of CONSECUTIVE same-role paragraphs. Grouping before
// normalising is not an optimisation, it is correctness: NAI splits a returned reply
// into sections however it likes, and normalising each section in isolation would stamp
// a "Sara:" header onto every line of a three-paragraph reply. Grouping also silently
// absorbs the stray blank paragraph a trailing newline leaves behind — the "the reply
// adds a second newline" report.
async function _charchatScanTurns(): Promise<{ turns: { isPov: boolean; ids: number[]; texts: string[] }[]; ids: number[] }> {
    let ccTurns: { isPov: boolean; ids: number[]; texts: string[] }[] = [];
    let ccAllIds: number[] = [];
    if (_aeCharChat.markerId === null) return { turns: ccTurns, ids: ccAllIds };
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); }
    catch (eTs) { api.v1.error('[AE:charchat] turn scan failed:', eTs); return { turns: ccTurns, ids: ccAllIds }; }
    let ccSeen = false;
    for (let ccR of ccAll) {
        if (ccR.sectionId === _aeCharChat.markerId) { ccSeen = true; ccAllIds.push(ccR.sectionId); continue; }
        if (!ccSeen) continue;
        ccAllIds.push(ccR.sectionId);
        if (_aeCharChat.setupIds.indexOf(ccR.sectionId) >= 0) continue;

        // [BUGFIX v2.25.0 CHARCHAT-MERGE] READ-ONLY safety net. The real fix physically
        // splits a merged section in _charchatSplitMergedSections (write-pass only, since
        // this function must never mutate the document \u2014 it also runs on dryRun). If
        // that split hasn't run yet (or failed), don't let a merged section inherit ONE
        // role from a stale 'instruction' source: cut it at the same origin boundary and
        // feed the two halves to their correct turns instead. NOTE: if this ever fires
        // during the WRITE pass (i.e. the physical split above failed), both halves still
        // carry the SAME sectionId into two different turns, and _charchatNormalizeDocument
        // schedules one updateParagraphs write per turn against that id \u2014 the second
        // write wins, so the OTHER half's text is silently lost for this cycle. Accepted:
        // strictly better than the pre-v2.25.0 behaviour (which corrupted BOTH halves
        // every time), and the physical split succeeding is the common case this guards.
        let ccFullText = ccR.section.text || '';
        let ccSplitIdx = _charchatMergeSplitIdx(ccR.section);
        if (ccSplitIdx > 0 && ccSplitIdx < ccFullText.length) {
            let ccHead = ccFullText.substring(0, ccSplitIdx);
            let ccTail = ccFullText.substring(ccSplitIdx);
            let ccLastH = (ccTurns.length > 0) ? ccTurns[ccTurns.length - 1] : null;
            if (ccLastH && ccLastH.isPov) { ccLastH.ids.push(ccR.sectionId); ccLastH.texts.push(ccHead); }
            else ccTurns.push({ isPov: true, ids: [ccR.sectionId], texts: [ccHead] });
            ccTurns.push({ isPov: false, ids: [ccR.sectionId], texts: [ccTail] });
            continue;
        }

        let ccIsPov = _charchatRowIsPov(ccR.section, ccR.sectionId);
        // [DIAG v2.51.3 CHARCHAT-BRACE-DIAG] CLOSED at v2.59.0. The user's own live log
        // confirmed the hypothesis this diagnostic existed to test: origin metadata reaching
        // _charchatRowIsPov here is genuinely native ('user'/'edit'/'script'), never an
        // injected/misclassified pattern from the old DOM-INJECT panel (which was already
        // confirmed deleted at bridge v2.13.0). Per-row logging removed as promised in the
        // original comment ("TEMPORARY: remove once CHARCHAT-BRACE-DIAG is closed").
        let ccLast = (ccTurns.length > 0) ? ccTurns[ccTurns.length - 1] : null;
        if (ccLast && ccLast.isPov === ccIsPov) { ccLast.ids.push(ccR.sectionId); ccLast.texts.push(ccR.section.text || ''); }
        else ccTurns.push({ isPov: ccIsPov, ids: [ccR.sectionId], texts: [ccR.section.text || ''] });
    }
    return { turns: ccTurns, ids: ccAllIds };
}

// [BUGFIX v2.25.0 CHARCHAT-MERGE] WRITE-PASS ONLY (called from _charchatNormalizeDocument,
// onGenerationEnd — never from the read-only side, which must not mutate the document).
// Splits any section _charchatMergeSplitIdx flags as merged (see _charchatSplitMergedSectionsPass
// just below for the full mechanism).
// [v2.61.0 CHARCHAT-SETTLE-POLL, per user's live log] REPLACES v2.59.0/v2.60.0's single fixed
// 150ms retry. That approach had a confirmed failure mode: two scans 150ms apart can BOTH
// report the same too-low section count if NAI simply had not started writing the reply yet
// by either scan — "did the count change between two scans" cannot distinguish "settled" from
// "not started." Live evidence: a turn's split-pass found "0 split" on the first scan AND a
// 150ms-later retry, both agreeing on the same section count — yet a THIRD, separate scan
// (the empty-reply diagnostic's own dump, running later in the same handler) found the full
// reply text already present. NAI was still actively writing between the second and third
// scans. The fix: poll against the EXPECTED growth for a real turn (the last known section
// count + 2, for the Director's own paragraph plus a reply) rather than mere pass-to-pass
// agreement, bounded so a genuinely-failed turn does not poll forever.
const CC_SETTLE_MAX_PASSES = 5;    // hard ceiling: 1 initial scan + up to 4 retries
const CC_SETTLE_SLEEP_MS = 200;    // gap between polls
async function _charchatSplitMergedSections(): Promise<void> {
    if (_aeCharChat.markerId === null) return;
    // No baseline yet (turn 1 of a chat) — nothing to compare growth against, so do exactly
    // the single scan+split pass and record the baseline for next turn. Matches pre-v2.61.0
    // behaviour for a chat's opening turn.
    let ccExpectMin = (_ccLastSeenSectionCount >= 0) ? (_ccLastSeenSectionCount + 2) : -1;
    let ccPass = await _charchatSplitMergedSectionsPass();
    let ccFinalSeen = ccPass.seen;
    let ccPassNum = 1;
    while (ccExpectMin >= 0 && ccFinalSeen < ccExpectMin && ccPassNum < CC_SETTLE_MAX_PASSES) {
        aeLog('[AE:charchat:merge-diag] pass ' + ccPassNum + ' \u2014 seen=' + ccFinalSeen
            + ', expected at least ' + ccExpectMin + ' for a settled turn. NAI may still be '
            + 'writing \u2014 retrying after a short delay.');
        try { await api.v1.timers.sleep(CC_SETTLE_SLEEP_MS); } catch (_eSl) {}
        let ccRetry = await _charchatSplitMergedSectionsPass();
        ccFinalSeen = ccRetry.seen;
        ccPassNum++;
    }
    if (ccExpectMin >= 0 && ccFinalSeen >= ccExpectMin && ccPassNum > 1) {
        aeLog('[AE:charchat:merge-diag] settled after ' + ccPassNum + ' passes \u2014 seen='
            + ccFinalSeen + ' reached the expected ' + ccExpectMin + '. THE RACE IS REAL; a '
            + 'single fixed retry was not patient enough for this turn.');
    } else if (ccExpectMin >= 0 && ccFinalSeen < ccExpectMin) {
        aeLog('[AE:charchat:merge-diag] gave up after ' + ccPassNum + ' passes (' + (CC_SETTLE_MAX_PASSES - 1)
            + ' retries, ' + (CC_SETTLE_SLEEP_MS * (CC_SETTLE_MAX_PASSES - 1)) + 'ms total) without reaching '
            + 'the expected ' + ccExpectMin + ' \u2014 seen=' + ccFinalSeen + '. See CHARCHAT-EMPTY-REPLY-DIAG below.');
    }

    // [DIAG v2.60.0 CHARCHAT-EMPTY-REPLY-DIAG, per user: "nothing is showing in the story
    // editor when a response never happens"] Now runs AFTER the settle-poll above has already
    // waited for the expected growth (or genuinely given up), so a firing here is much more
    // trustworthy than the v2.60.0 version — that one produced a CONFIRMED false positive by
    // comparing a scan that simply ran too early. Dump whatever the newest section(s) actually
    // contain so we can see directly whether NAI wrote nothing, an empty/whitespace paragraph,
    // or something unexpected, on the turns where the poll above still could not reach the
    // expected count within its bound. -1 sentinel skips turn 1 (no baseline yet). TEMPORARY:
    // remove once CHARCHAT-EMPTY-REPLY-DIAG is closed.
    if (_ccLastSeenSectionCount >= 0 && ccFinalSeen <= _ccLastSeenSectionCount + 1) {
        aeLog('[AE:charchat:empty-reply-diag] section count still barely moved after settle-polling: was '
            + _ccLastSeenSectionCount + ', now ' + ccFinalSeen + ' \u2014 NAI likely generated NO '
            + 'reply text at all (only the Director\'s own turn landed, if that). Dumping the '
            + 'newest section(s) below.');
        try {
            let ccAllDump: any[] = await api.v1.document.scan();
            let ccSeenDump = false;
            let ccDumpRows: any[] = [];
            for (let ccD of ccAllDump) {
                if (ccD.sectionId === _aeCharChat.markerId) { ccSeenDump = true; continue; }
                if (!ccSeenDump) continue;
                if (_aeCharChat.setupIds.indexOf(ccD.sectionId) >= 0) continue;
                ccDumpRows.push(ccD);
            }
            let ccTail = ccDumpRows.slice(-3);
            if (ccTail.length === 0) {
                aeLog('[AE:charchat:empty-reply-diag] the chat region is completely empty past the marker/setup paragraphs.');
            }
            for (let ccDR of ccTail) {
                let ccDText = (ccDR.section && ccDR.section.text) || '';
                aeLog('[AE:charchat:empty-reply-diag] id=' + ccDR.sectionId
                    + ' source=' + JSON.stringify(ccDR.section.source)
                    + ' origin=' + JSON.stringify(ccDR.section.origin)
                    + ' textLen=' + ccDText.length
                    + ' text=' + JSON.stringify(ccDText));
            }
        } catch (eDump) { api.v1.error('[AE:charchat:empty-reply-diag] dump scan failed:', eDump); }
    }
    // [BUGFIX v2.62.0 CHARCHAT-EMPTY-REPLY-BASELINE] The baseline is NO LONGER recorded here.
    // This function runs BEFORE _charchatNormalizeDocument's grow/remove pass, so the count it
    // took was a PRE-grow count \u2014 while the next turn's comparison count is taken after
    // that grow has already added the 'Emotion:' line as its own section. A perfectly ordinary
    // turn therefore appeared to add +2 sections when it had only added +1, and the v2.60.0
    // empty-reply check false-passed on exactly the failure it was written to catch (see the
    // v2.61.0 addendum, which concluded the heuristic itself was unsound \u2014 it was not, its
    // baseline was measured one pass too early). _charchatNormalizeDocument now records it at
    // the end of its own writes, where the document is finally settled.
}

// Physically splits any section _charchatMergeSplitIdx flags into two real paragraphs: the
// user-typed head keeps the original sectionId and source (still a legitimate, just
// shorter, POV paragraph), and the AI-authored tail becomes a fresh paragraph via
// insertParagraphAfter with no source override — api.v1.document.append()'s own contract
// says script-written text gets 'script' origin, which _charchatRowIsPov correctly reads
// as NOT a POV turn (script data isn't 'user'/'edit'), same as any other contact reply.
// Runs BEFORE _charchatScanTurns in the write pass so grouping/canonicalisation never has
// to see a merged section at all — the in-memory fallback in _charchatScanTurns above is
// strictly a safety net for if this fails.
// [v2.59.0 CHARCHAT-MERGE-RACE] Factored out of _charchatSplitMergedSections so the outer
// function can run this pass more than once (bounded settle-poll as of v2.61.0) without
// duplicating the scan logic.
async function _charchatSplitMergedSectionsPass(): Promise<{ seen: number; split: number }> {
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); }
    catch (eSc) { api.v1.error('[AE:charchat] merge-split scan failed:', eSc); return { seen: 0, split: 0 }; }
    let ccSeen = false;
    // [DIAG v2.33.0 CHARCHAT-SPLIT-DIAG] The probe caught a section with a textbook
    // script(0-25)->ai(25-33) boundary that this pass should have split and didn't, so
    // every decision is now logged. Cheap (no generation, no extra scan) and it answers
    // the one question the probe left open: does this pass RUN, does it FIND the
    // boundary, and does the write land? Remove once CHARCHAT-MERGE is closed.
    let ccDiagSeen = 0, ccDiagSplit = 0;
    for (let ccR of ccAll) {
        if (ccR.sectionId === _aeCharChat.markerId) { ccSeen = true; continue; }
        if (!ccSeen) continue;
        if (_aeCharChat.setupIds.indexOf(ccR.sectionId) >= 0) continue;
        ccDiagSeen++;
        let ccFull = ccR.section.text || '';
        let ccIdx = _charchatMergeSplitIdx(ccR.section);
        if (ccIdx <= 0 || ccIdx >= ccFull.length) {
            if (ccIdx > 0) aeLog('[AE:charchat:split] section ' + ccR.sectionId + ' idx=' + ccIdx + ' REJECTED (>= len ' + ccFull.length + ')');
            continue;
        }
        let ccHead = ccFull.substring(0, ccIdx);
        let ccTail = ccFull.substring(ccIdx);
        aeLog('[AE:charchat:split] section ' + ccR.sectionId + ' SPLIT at ' + ccIdx
            + ' head=' + JSON.stringify(ccHead.substring(0, 40))
            + ' tail=' + JSON.stringify(ccTail.substring(0, 40)));
        try {
            await api.v1.document.insertParagraphAfter(ccR.sectionId, { text: ccTail });
            await api.v1.document.updateParagraph(ccR.sectionId, { text: ccHead });
            ccDiagSplit++;
        } catch (eSp) { api.v1.error('[AE:charchat] merge-split failed for section ' + ccR.sectionId + ':', eSp); }
    }
    aeLog('[AE:charchat:split] pass complete — ' + ccDiagSeen + ' chat sections scanned, ' + ccDiagSplit + ' split.');
    return { seen: ccDiagSeen, split: ccDiagSplit };
}

// [v2.42.0 CHARCHAT-CTX-BRACE] ccNoBrace renders the POV turn WITHOUT its brace wrapper,
// for the model's view only. See _charchatCanonicalChatText for why, and see
// _charchatNormalizeDocument (which never passes it) for why the DOCUMENT keeps its braces.
function _charchatCanonTurn(turn: { isPov: boolean; ids: number[]; texts: string[] }, povName: string, contactName: string, ccNoBrace?: boolean): string {
    let ccJoined = turn.texts.join('\n');
    if (!turn.isPov) return _charchatCanonContact(ccJoined, contactName, povName);
    let ccPov = _charchatCanonPov(ccJoined, povName, contactName);
    if (ccNoBrace && ccPov) ccPov = _charchatUnwrapPov(ccPov);
    return ccPov;
}

// WRITE PASS — onGenerationEnd ONLY, per user's "maybe we handle it after generation?".
// Deliberately NOT called from onBeforeContextBuild: mutating the document mid-context-
// build would race the very generation it is building for, and that hook also fires on
// dryRun, so a costing pass would rewrite the user's paragraphs. The read-only twin
// (_charchatCanonicalChatText) keeps the MODEL's view canonical every turn; this keeps
// the DOCUMENT's view canonical one beat later, which is all the document needs.
async function _charchatNormalizeDocument(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    // [BUGFIX v2.25.0 CHARCHAT-MERGE] Fix any section NAI glued a completion onto BEFORE
    // grouping turns \u2014 see _charchatSplitMergedSections. Failure here is non-fatal
    // (logged, falls through to _charchatScanTurns's own in-memory fallback).
    try { await _charchatSplitMergedSections(); }
    catch (eSpAll) { aeLog('[AE:charchat] merge-split pass failed (continuing with unsplit sections):', eSpAll); }
    let ccScan = await _charchatScanTurns();
    let ccUpdates: { sectionId: number; section: any }[] = [];
    let ccRemove: number[] = [];
    let ccGrow: { afterId: number; lines: string[] }[] = [];
    for (let ccT of ccScan.turns) {
        // [v2.52.0 CHARCHAT-BRACE-DOUBLE] POV turns written WITHOUT the literal brace (the
        // 'true' below is ccNoBrace). They are source:'instruction' and NAI renders its OWN
        // brace around an instruction paragraph, so the literal '{...}' this used to write was
        // a SECOND layer. _charchatScanTurns reads RAW text (never NAI's render brace), so the
        // unwrap could only see/strip the literal layer while NAI's outer one persisted -- every
        // reopen re-baked "{ {Name: ...} }". Braceless here makes the document match the model
        // view (both "Name: body") and idempotent. Full repro in CE-INDEX v2.52.0.
        let ccCanon = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName, true);
        if (!ccCanon) { for (let ccX of ccT.ids) ccRemove.push(ccX); continue; }
        let ccLines = ccCanon.split('\n');
        // Fit the canonical lines back onto the sections this turn already occupies:
        // rewrite in place where they line up, fold any overflow onto the last written
        // section, drop sections the canonical form no longer needs. This deliberately
        // does NOT force one-paragraph-per-turn — NAI owns how a returned reply is split
        // into sections and fighting that is a losing game; we only fix the text.
        let ccKeep = Math.min(ccLines.length, ccT.ids.length);
        for (let ccI = 0; ccI < ccKeep; ccI++) {
            // [v2.52.0 CHARCHAT-BRACE-DOUBLE] Force source:'instruction' on POV sections as we
            // rewrite them: it is what carries turn identity now that the literal brace is gone
            // (_charchatRowIsPov already trusts source==='instruction'). updateParagraphs takes a
            // Partial<Section>, so source is settable here (verified in script-types). Makes the
            // brace-drop safe for a POV paragraph NAI somehow left un-instruction'd, and migrates
            // a turn saved by an older build in the same pass that fixes its text.
            if (ccLines[ccI] !== ccT.texts[ccI]) {
                let ccSec: any = { text: ccLines[ccI] };
                if (ccT.isPov) ccSec.source = 'instruction';
                ccUpdates.push({ sectionId: ccT.ids[ccI], section: ccSec });
            }
        }
        for (let ccJ = ccKeep; ccJ < ccT.ids.length; ccJ++) ccRemove.push(ccT.ids[ccJ]);
        // [BUGFIX v2.34.0 CHARCHAT-GROW, per user] This pass could only ever SHRINK a turn:
        // surplus canonical lines were folded onto the last section joined by '\n', which NAI
        // renders as ONE visual line \u2014 the confirmed "Sara: ...  Emotion: bored glued onto
        // the reply" report. A canonical turn is allowed to need MORE sections than the
        // document currently gives it (body + 'Emotion:' line = 2 lines in 1 section), so grow
        // it instead. Deferred, not inserted mid-loop, because inserting here would invalidate
        // the section ids ccScan already resolved for the turns after this one.
        if (ccLines.length > ccT.ids.length && ccT.ids.length > 0) {
            ccGrow.push({ afterId: ccT.ids[ccT.ids.length - 1], lines: ccLines.slice(ccT.ids.length) });
        }
    }
    if (ccUpdates.length > 0) {
        try { await api.v1.document.updateParagraphs(ccUpdates); }
        catch (eNu) { aeLog('[AE:charchat] turn normalisation rewrite failed (cosmetic only):', eNu); }
    }
    // [BUGFIX v2.34.0 CHARCHAT-GROW] Grow AFTER the in-place rewrites (the head line is
    // canonical by then) and BEFORE the removals (which only target surplus ids this loop
    // never wrote). insertParagraphsAfter, NOT insertParagraphAfter \u2014 the latter returns
    // Promise<void> (verified in script-types.txt) and so cannot be chained by returned id;
    // the plural form takes the whole ordered surplus in one call, which is the shape needed.
    for (let ccG of ccGrow) {
        let ccSecs: any[] = [];
        for (let ccL of ccG.lines) ccSecs.push({ text: ccL });
        try { await api.v1.document.insertParagraphsAfter(ccG.afterId, ccSecs); }
        catch (eNg) { aeLog('[AE:charchat] turn grow failed (cosmetic only):', eNg); }
    }
    if (ccRemove.length > 0) {
        try { await api.v1.document.removeParagraphs(ccRemove); }
        catch (eNr) { aeLog('[AE:charchat] turn normalisation cleanup failed (cosmetic only):', eNr); }
    }
    // [BUGFIX v2.62.0 CHARCHAT-EMPTY-REPLY-BASELINE] Baseline for the next turn's empty-reply
    // check, moved here from _charchatSplitMergedSections (see the note at its old site). This is
    // the only point in the turn where the document is actually settled: after the in-place
    // rewrites, after the grow, after the removals. Counted with the same skip rules the split
    // pass uses so the two numbers are comparable.
    try {
        let ccBaseAll = await api.v1.document.scan();
        let ccBaseSeen = false, ccBaseN = 0;
        let ccLastId: number | null = null, ccLastText = '';
        for (let ccB of ccBaseAll) {
            if (ccB.sectionId === _aeCharChat.markerId) { ccBaseSeen = true; continue; }
            if (!ccBaseSeen) continue;
            if (_aeCharChat.setupIds.indexOf(ccB.sectionId) >= 0) continue;
            ccBaseN++;
            ccLastId = ccB.sectionId;
            ccLastText = ccB.section.text || '';
        }
        _ccLastSeenSectionCount = ccBaseN;
        // [FEATURE v2.70.0 CHARCHAT-TRAILING-BLANK, per user] The turn's last section is always
        // the reply's Emotion line (or the reply body, if Emotion parsing found nothing) --
        // never blank, since _charchatCanonContact drops an all-blank canon entirely. Without a
        // blank paragraph after it, the user's next keystroke lands mid-line and they have to
        // hit Enter themselves before typing their own message. One-shot per turn: only fires
        // when the last section is non-blank, so this can never stack up multiple empty
        // paragraphs turn over turn. Not currently configurable -- see the change note for how
        // to add a GlobalConfig toggle if this needs to be optional later.
        if (ccLastId !== null && ccLastText.trim()) {
            try { await api.v1.document.insertParagraphAfter(ccLastId, { text: '' }); }
            catch (eTb) { aeLog('[AE:charchat] trailing blank paragraph failed (cosmetic only):', eTb); }
        }
    } catch (eNb) { aeLog('[AE:charchat] baseline recount failed (empty-reply diag disabled this turn):', eNb); }
}

// READ-ONLY twin of _charchatNormalizeDocument, for context assembly. This is what makes
// the model's view canonical on the SAME turn the user types it — the write pass only
// runs after a generation, so without this the newest turn would reach the model raw
// (unclosed brace, no header, or a header on the wrong side), which is precisely the
// class of bug v2.23.0 chased.
// [v2.42.0 CHARCHAT-CTX-BRACE, per user] Braces are stripped from the MODEL'S VIEW. The
// user's reasoning, and it is right: the headers are what tell the model who is speaking, and
// "Nate:" / "Sara:" already do that unaided — so in the context the braces carry no
// information the header does not, while actively teaching the model a convention it then
// imitates. That imitation is the confirmed source of the header-plus-brace turn (v2.41.0)
// and it
// contributed to the thought pass writing a chat reply instead of a snapshot (v2.42.0): a
// transcript is a pattern, and every pattern in it gets copied.
// THE DOCUMENT KEEPS ITS BRACES — this function is the READ-ONLY twin and only builds
// context. v2.27.0 CHARCHAT-BRACE-REVERT established by direct test that an unbraced POV
// paragraph reads as a continuation of the previous contact turn, and _charchatRowIsPov and
// _charchatCanonPov both depend on the literal brace being there. _charchatNormalizeDocument
// (the write pass) calls _charchatCanonTurn WITHOUT the flag and so is unchanged.
async function _charchatCanonicalChatText(): Promise<string> {
    let ccScan = await _charchatScanTurns();
    let ccOut: string[] = [];
    for (let ccT of ccScan.turns) {
        let ccC = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName, true);
        if (ccC) ccOut.push(ccC);
    }
    return ccOut.join('\n\n');
}

// The whole steering thesis, in one function. Called from onBeforeContextBuild while a
// chat is active — including on dryRun, so the context viewer shows the real thing.
async function runCharChatContextOverride(params: any): Promise<any> {
    let ccResult: any = {};
    try {
        let ccCfg = await loadConfig();
        let ccContact = await loadCharacter(_aeCharChat.contactId);
        if (!ccContact) {
            api.v1.error('[AE:charchat] contact ' + _aeCharChat.contactId + ' could not be loaded \u2014 leaving context untouched this turn.');
            return undefined;
        }

        // [v2.29.0 CHARCHAT-FRESH-THOUGHTS-TIMING, per user's gen log] The pre-reply
        // ephemeral refresh that lived HERE in v2.27.0/v2.28.0 is GONE, moved to the
        // CHARCHAT branch of onGenerationEnd. ROOT CAUSE, confirmed directly by the
        // error text in the user's gen log ("A generation is already in progress"),
        // not the v2.28.0 re-entrancy theory: onBeforeContextBuild fires WHILE this
        // turn's own reply generation is already in progress (NAI's own internal
        // state, separate from this file's ae_genInFlight), so ANY nested
        // api.v1.generate() call made from in here is rejected outright — every
        // single time, hence "static," not merely stale. v2.28.0's _diagProbeActive
        // guard was still correct and necessary (it stopped the recursion the nested
        // call's re-entrant hook-firing would otherwise have caused) — it just wasn't
        // sufficient, because the very first nested call already failed before
        // recursion was ever the active problem. See onGenerationEnd for where this
        // now lives and why that timing is safe.

        // [v2.45.0 CHARCHAT-THOUGHT-POST] THE FORK IS GONE. Every generation reaching this
        // function is a REPLY again, exactly as it was in v2.37.1. The thought no longer rides
        // NAI's own generation at all \u2014 it is a direct api.v1.generate() call fired from
        // onGenerationEnd AFTER the reply lands (grep generateChatEphemeral). See the CE-INDEX
        // v2.45.0 block for the four versions of evidence that killed the fork; the short
        // version is that NAI wraps this slot in its own turn scaffold no matter what we
        // substitute here, and a labelled-line snapshot cannot survive that wrapping.

        // 1. TOP OF CONTEXT — we own it.
        ccResult.systemPrompt = { active: true, content: await buildCharChatSystemPrompt(ccContact, ccCfg, _aeCharChat.povId) };

        // 2. LOREBOOK — deactivate every character-linked entry. Participants' entries
        //    are already folded into the system prompt (duplication guard); everyone
        //    else's is the persona-bleed guard. Enumerated from the character index,
        //    NOT from params.lorebookEntries: that parameter carries current state for
        //    entries the framework already knows about this build, which is not a
        //    guaranteed enumeration of every entry. Non-character lorebook entries are
        //    deliberately untouched — world lore is still true during a text message.
        let ccSuppress: any[] = [];
        try {
            let ccIdx = await loadIndex();
            for (let ccMeta of ccIdx.filter(Boolean)) {
                let ccChar = await loadCharacter(ccMeta.id);
                if (ccChar && ccChar.lorebookEntryId) ccSuppress.push([ccChar.lorebookEntryId, { active: false }]);
            }
        } catch (eccL) { api.v1.error('[AE:charchat] lorebook suppression failed \u2014 persona bleed possible this turn:', eccL); }
        if (ccSuppress.length > 0) ccResult.lorebookEntries = ccSuppress;

        // 3. AUTHOR'S NOTE — DEACTIVATED. [v2.24.0, per user] It used to carry the
        //    contact's ephemeral line. That line now rides the next-message instruction
        //    at the true bottom of context instead (see buildCharChatInstruction): the
        //    AN lands at the user's configured depth INSIDE recent history and the hook
        //    exposes no depth control, so it could never be made "most present", which
        //    is the entire job of a right-now line. Deactivating rather than leaving it
        //    alone is deliberate — the story's own AN is about the STORY, and a text
        //    message is not a story turn (same reasoning as WIZLIVE's AN deactivation).

        // 4. STORY TEXT — narrative header at the top, the CANONICAL chat region in the
        // middle, next-message instruction at the true bottom.
        // [v2.24.0 CHARCHAT-TURNS, supersedes the v2.23.0 dangling-scaffold strip] The
        // chat region is rebuilt from the document rather than passed through: every POV
        // turn re-emitted with its closing brace, every reply with a correct header, no
        // blank paragraphs. That makes v2.23.0's targeted "strip an untouched scaffold"
        // hack unnecessary — it existed only because we ourselves put an unclosed
        // "{user: " in the document, and nothing does that anymore.
        // GUARD, and the reason this is safe: only rebuild when the marker actually
        // SURVIVES in params.storyText.content. That content is already trimmed to the
        // context budget; the document scan is not. If the marker is still present then
        // the whole chat region is present (it is the tail), so a rebuild is length-
        // neutral. If it has been trimmed away, the chat has outgrown the budget and
        // storyText is left exactly as NAI trimmed it.
        // Also deliberate: the setup/greeting paragraph is dropped on rebuild. It is
        // instructions to the USER ("start a paragraph with a curly brace"), which the
        // model has no business reading and previously did, every single turn.
        let ccStory = (params && params.storyText && params.storyText.content) ? params.storyText.content : '';
        // [v2.99.0 CCINT] Mode-correct marker. Reading the phone constant while in an
        // interview would leave ccMarkIdx at -1 and silently skip the whole canonical
        // rebuild — no error, just a worse prompt. See AE_CCINT_MARKER_TEXT's note.
        let ccMarkTxt = _ccMarkerText();
        let ccMarkIdx = ccStory.indexOf(ccMarkTxt);
        if (ccMarkIdx >= 0) {
            let ccCanonChat = '';
            try { ccCanonChat = await _charchatCanonicalChatText(); }
            catch (eCc) { api.v1.error('[AE:charchat] canonical chat rebuild failed \u2014 passing the raw region through:', eCc); ccCanonChat = ''; ccMarkIdx = -1; }
            if (ccMarkIdx >= 0) {
                ccStory = ccStory.substring(0, ccMarkIdx) + ccMarkTxt
                        + (ccCanonChat ? ('\n\n' + ccCanonChat) : '');
            }
        }
        ccStory = ccStory.replace(/\s+$/, '');
        // [v2.99.0 CCINT] Relabel only — the block is the same story text either way,
        // but "the record" is the noun the interview rubric and the instruction tail
        // both use for it, and a header that disagrees with them is free confusion.
        let ccBody = (_ccIsInterview(_aeCharChat.povId) ? '[ THE RECORD ]\n' : '[ NARRATIVE CONTEXT ]\n') + ccStory;
        ccBody += '\n\n' + buildCharChatInstruction(ccContact, _aeCharChat.povName, ccCfg, _aeCharChat.povId);
        // [BUGFIX v2.69.0 CHARCHAT-USERTOKEN, per user's token-probability capture] THE ROOT
        // CAUSE OF THE EMPTY REPLY, measured rather than inferred. NAI's own token-probability
        // viewer on a failed Send shows the single most likely next token is the chat-template
        // control token <|user|> at 42-56% raw / 53-92% after sampling settings \u2014 i.e. the
        // model is not producing a bad reply, it is ENDING ITS TURN. An immediate end-of-turn
        // token is a zero-length completion, which is exactly what onResponse reports
        // (call#1 final=true len=0) with a perfectly normal generation lifecycle around it.
        //
        // WHY it wants to end the turn, and the differential that proves it: NAI puts the TAIL
        // of storyText AFTER the <|assistant|> marker, so whatever this function ends with is
        // read by the model as its own in-progress output. In normal story mode that tail is
        // narrative prose which trails off mid-scene \u2014 nothing is finished, so continuing is
        // the only sensible move and <|user|> stays negligible. In chat mode the tail was the
        // instruction stack, whose last line is a CLOSED bracket block:
        //     [ End your message with a new line: Emotion: <...> ]
        // Nothing dangles. From the model's seat it has written a complete, well-formed thing
        // and the natural next move is to hand the turn back. Hence the coin-flip behaviour
        // (each Send re-samples: ~50% <|user|> = silence, ~90% 'N' = a reply), the "3+ presses"
        // reports, and why widgets/decorations/images/priming all made no difference \u2014 none
        // of them touch the token distribution.
        //
        // THE FIX: never end the assistant turn on a closed block. End it on a dangling speaker
        // cue, so the only coherent continuation is the message body. This is the same shape the
        // canonical transcript above already uses ('Nix: ...'), so it reads as the next line of a
        // conversation already in progress rather than as a new instruction. The user's own
        // capture of a WORKING turn shows the model's top token was 'N' at 87-93% \u2014 it was
        // already trying to write this exact header; we now write it for it and remove the gamble.
        //
        // NOT DONE VIA logit_bias / stop: both exist, but ONLY on GenerationParams, which is the
        // api.v1.generate() path. Native Send exposes neither (verified in script-types.txt, and
        // consistent with the standing note above _charchatEscapeRx). Banning <|user|> outright
        // was therefore never available for the surface that actually has the bug.
        //
        // The header is stripped-and-reapplied downstream regardless (charChatCleanReply always
        // prepends its own, _charchatStripHeader removes any it finds), so the completion arriving
        // as a bare body is exactly what the existing pipeline already expects.
        if (!CE_DIAG.ccNoPrefill) {
            ccBody += '\n\n' + (_aeCharChat.contactName || ccContact.name || 'They') + ':';
        } else {
            aeLog('[AE:diag] ccNoPrefill ON \u2014 context ends on a closed block (pre-v2.69.0 shape).');
        }
        // [DIAG v2.62.0 CHARCHAT-TAIL-DIAG] The one thing every previous diagnostic in this arc
        // inferred instead of observing: what the model literally reads immediately before the
        // generation point. Free (no scan, no generation), and it is the direct A/B for
        // CHARCHAT-TAIL-TERMINAL above \u2014 a failing turn and a working turn can now be
        // compared byte-for-byte at the only position that differs between them. dryRun is NOT
        // suppressed deliberately: NAI's own context viewer pass logs it too, which is the
        // cheapest way to inspect the tail without sending anything.
        try {
            let ccTailLog = ccBody.substring(Math.max(0, ccBody.length - 300));
            aeLog('[AE:charchat:tail] eph=' + ((ccContact.ephemeral && ccContact.ephemeral.compressedLine) ? 'yes' : 'no')
                + ' storyTextLen=' + ccBody.length + ' last300=' + JSON.stringify(ccTailLog));
        } catch (_eTail) {}
        ccResult.storyText = { active: true, content: ccBody };

    } catch (eccAll) {
        api.v1.error('[AE:charchat] context override failed \u2014 falling back to untouched context:', eccAll);
        return undefined;
    }
    return ccResult;
}

// ── Post-hoc reply cleanup ────────────────────────────────────────
// Native generation exposes no per-turn stop sequences (generationParameters.get()
// has no `stop` field — that is the api.v1.generate path only), so instruct/paragraph
// turn alternation plus this regex net is the whole anti-impersonation defence.
// Adapted from the Chat Simulator's truncation pass.
function _charchatEscapeRx(str: string): string {
    return (str || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// [DELIBERATE DEVIATION from the handoff — flagged, reverse if wrong] The handoff says
// the Emotion tag is "parsed + stripped". We parse it but DO NOT strip it. Stripping is
// what the Chat Simulator does because it renders its own bubbles and the raw text never
// reaches the document. Here the reply IS the document, and the entire stated reason for
// keeping the emotion sidecar is that user's separate emotion-image widget script reads
// `Emotion: <word>` off document text with zero changes. Strip it and that script has
// nothing left to read — the two requirements are mutually exclusive as written, and the
// synergy is the one worth keeping. Parsed value is mirrored to _aeCharChat.lastEmotion
// for diagnostics/bridge use; the tag stays in the text.
function charChatParseEmotion(raw: string): string {
    let ccM = (raw || '').match(_charchatEmotionRx());
    if (ccM && ccM[1]) {
        let ccE = ccM[1].trim();
        // [v2.25.0, per user] Canonicalise to the 24-state list via the same
        // resolveEmotion() the image pipeline already uses (EMOTION_MAP) — a synonym the
        // model writes instead (e.g. "annoyed") would otherwise reach the document
        // verbatim and silently miss user's emotion-image widget, which keys off one of
        // the 24 canonical words. resolveEmotion never returns '' (unrecognised words
        // fall back to 'neutral'), so the <=40 length guard below still governs whether
        // an emotion was found at all; normalisation only applies to guard-passing matches.
        if (ccE.length > 0 && ccE.length <= 40) return resolveEmotion(ccE);   // <=40 guard against false positives
    }
    return '';
}

// [v2.27.0] _charchatThoughtRx / charChatParseThought DELETED — CHARCHAT-THINK's
// inline "[Thinking: ...]" line is gone, so there is nothing left to strip or parse
// here (zero remaining callers verified before removal). Thoughts now come from
// generateEphemeral() instead — a real, persisted record (char.ephemeral /
// ephemeralHistory), not a line scraped out of the reply text. See the CE-INDEX
// v2.27.0 entry.

function charChatCleanReply(raw: string, contactName: string, povName: string): string {
    let ccT = (raw || '');
    if (!ccT.trim()) return ccT;

    // Split the Emotion tag off, clean the message body only, then re-attach it. Doing
    // it this way means an impersonation truncation can never eat the tag, and the tag
    // can never be mistaken for message content by the name-prefix strip.
    let ccEmotion = charChatParseEmotion(ccT);
    if (ccEmotion) {
        let ccCut = ccT.match(_charchatEmotionRx());
        if (ccCut && ccCut.index !== undefined) ccT = ccT.substring(0, ccCut.index);
    }

    // Drop a self-prefix the model added on its own — defensive only, since the
    // instruction now explicitly tells it not to write one. We prepend our OWN canonical
    // header below regardless, so a model-written one would otherwise double up.
    // [v2.24.0] Shared with the document normaliser (_charchatStripHeader) rather than
    // a second private copy of the same regex, and it now tries the POV's name too:
    // a header on the WRONG side ("user:" opening Sara's reply) was previously kept and
    // then had "Sara:" stamped on top of it.
    ccT = _charchatStripHeader(ccT, [contactName, povName]);

    // Truncate the moment the model starts speaking for the POV, or trails off with
    // their bare name (both are the model taking over the user's side of the chat).
    if (povName) {
        let ccRxList = [
            new RegExp('(?:^|\\n)\\s*\\*?\\*?' + _charchatEscapeRx(povName) + '\\*?\\*?\\s*[:\uff1a]', 'i'),
            new RegExp('(?:^|\\n)\\s*\\*?\\*?' + _charchatEscapeRx(povName) + '\\*?\\*?\\s*$', 'i')
        ];
        for (let ccRx of ccRxList) {
            let ccMt = ccT.match(ccRx);
            if (ccMt && ccMt.index !== undefined && ccMt.index > 0) ccT = ccT.substring(0, ccMt.index);
        }
    }

    ccT = ccT.replace(/\s+$/, '').replace(/^\s+/, '');

    // [v2.22.0] The name header is OURS, not the model's — same "bolted on around
    // generation" treatment Emotion already got, in the opposite direction: Emotion IS
    // requested from the model and kept; the header is NEVER requested and ALWAYS
    // applied here, so it is canonical regardless of what the model did or didn't write.
    // [v2.24.0] This is now the FIRST of two applications, not the only one:
    // _charchatNormalizeDocument re-canonicalises the same turn after generation. Both
    // exist because they cover different failure modes — this one owns the text on the
    // way in, that one owns anything the user or NAI did to it afterwards.
    let ccBody = ccT || '\u2026';   // an empty body after cleanup still gets a header + placeholder rather than vanishing silently
    // [v2.25.0, per user] Header and body share a line ("Sara: message"), matching
    // _charchatCanonContact's new format exactly — this and that function must stay in
    // sync (they cover the same shape at two different times, see the comment above).
    let ccOut = (contactName || 'They') + ': ' + ccBody;
    if (ccEmotion) ccOut += '\n' + CHARCHAT_EMOTION_PREFIX + ccEmotion;
    return ccOut;
}

// ── Session lifecycle ──────────────────────────────────────────

// [BUGFIX v2.34.0 CHARCHAT-RESUME, per user] This used to UNCONDITIONALLY append a fresh
// marker + greeting, so the bridge path (which calls straight in here) started a brand new
// thread every time \u2014 the chat menu would show "12 messages" and then hand back an empty
// chat, leaving the old thread orphaned in the lorebook. The native picker never showed this
// because IT resolves resume-vs-start in its own onSelect (openCharChatPicker \u2192
// listCharChatThreads \u2192 resumeCharChatFromEntry) before ever calling this function; the
// bridge has no such pre-step, and the bridge's contact-tap comment claiming "the engine
// resolves resume-vs-start itself" was simply false. It is true NOW: the entry id is
// deterministic (charChatEntryId), so this function does the same lookup the picker does and
// delegates. Placed ABOVE the mode guards deliberately \u2014 resumeCharChatFromEntry re-checks
// every one of them itself, so a guarded-out resume still reports the identical toast, and
// duplicating the list here would only risk the two copies drifting apart.
async function startCharChat(contactId: string, povId: string): Promise<void> {
    if (!_aeCharChat.active) {
        let ccExistingId = charChatEntryId(contactId, povId);
        let ccExisting: any = null;
        try { ccExisting = await api.v1.lorebook.entry(ccExistingId); }
        catch (_eRes) { ccExisting = null; }
        if (ccExisting && ccExisting.text) { await resumeCharChatFromEntry(ccExistingId, contactId); return; }
    }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeLiveWiz.active)  { api.v1.ui.toast('A wizard chat is open in the story \u2014 end it before starting a character chat.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeWizardMode)      { api.v1.ui.toast('Close the classic wizard first \u2014 the modes are exclusive.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active)    { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let ccContact = await loadCharacter(contactId);
    if (!ccContact) { api.v1.ui.toast('Could not load that character.', { type: 'error', autoClose: 4000 }); return; }
    let ccCfgStart = await loadConfig();
    let ccPov: CharacterRecord | null = null;
    // [v2.99.0 CCINT] The sentinel is not a character. Without this guard the load
    // returns null, ccPovName falls to '' and — worse — the povId is zeroed at the
    // record assignment below, which would silently drop the chat back into phone mode
    // and into the wrong saved-thread bucket.
    if (povId && !_ccIsInterview(povId)) { ccPov = await loadCharacter(povId); }

    // [LOCKED DECISION] POV is a LABEL ONLY. It names who the contact is texting so the
    // instruction can address them; it grants no scene presence and injects no profile.
    let ccPovName = ccPov ? ccPov.name : '';

    // [v2.24.0] Both paths get the same instructions now: there is no scaffold to
    // "finish" anymore (see the removal note at _charchatAppendPovScaffold's old site),
    // so every user starts a turn the same way. [v2.27.0 CHARCHAT-BRACE-REVERT, per
    // user] _charchatCanonPov wraps in literal braces again (see its own comment for
    // why), but the WORDING here is deliberately KEPT from v2.26.0, not reverted with
    // the code: the user never had to type a brace even before v2.26.0
    // (_charchatCanonPov re-wraps regardless of source — "Hi, Sara" and "{Hi, Sara}"
    // both come out the same), so telling them to type one was never accurate. This
    // greeting just no longer credits NAI with doing the wrapping, since that specific
    // claim is what testing disproved.
    let ccGreet = _ccIsInterview(povId)
        ? ('You are interviewing ' + ccContact.name
           + '. Write your question in a new paragraph, then press Send. They answer in their own voice, in the story\u2019s world \u2014 they do not know they are in a story, so ask about what they lived, not about the writing.')
        : ('You are now texting ' + ccContact.name
           + '. Write your message in a new paragraph, then press Send.'
           + (ccPovName ? (' Your name is added for you automatically; just write what you want to say.') : ''));

    let ccBefore = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs([
        { text: _ccMarkerTextFor(povId), source: 'instruction' },
        { text: ccGreet, source: 'instruction' }
    ]);
    let ccAfter = await api.v1.document.sectionIds();
    let ccAdded = ccAfter.slice(ccBefore.length);
    if (ccAdded.length === 0) { api.v1.ui.toast('Could not start the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let ccMarkerId = ccAdded[0];

    // Pin output short. Same snapshot->update->restore shape as WIZLIVE.
    // [v2.24.0] The cap is now this CONTACT's, not a global constant — verbosity is a
    // persona axis and it sets the token budget as well as the wording, because
    // instructing "be brief" under a 240-token cap is two instructions that disagree.
    let ccSnap: any = null;
    try {
        ccSnap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: charChatMaxTokensFor(ccContact, ccCfgStart, povId) });
    } catch (eccP) { aeLog('[AE:charchat] param pin failed, continuing without pin:', eccP); ccSnap = null; }

    _aeCharChat = {
        active: true, markerId: ccMarkerId, setupIds: ccAdded.slice(1),
        contactId: contactId, contactName: ccContact.name,
        povId: (ccPov || _ccIsInterview(povId)) ? povId : '', povName: ccPovName,   // [v2.99.0 CCINT] the sentinel has no CharacterRecord and must survive this guard
        paramSnapshot: ccSnap, startedAt: Date.now(), lastEmotion: ''
    };
    _ccLastSeenSectionCount = -1;   // [DIAG v2.60.0 CHARCHAT-EMPTY-REPLY-DIAG] fresh session, no baseline yet
    await saveCharChatState();

    try { await _charchatRegisterDecorations(ccMarkerId); await refreshCharChatDecorations(); }
    catch (eccDr) { aeLog('[AE:charchat] decoration registration failed (cosmetic only):', eccDr); }

    // [BUGFIX v2.51.3 CHARCHAT-TOAST-WRONG, per user: "the toast is wrong... user input is
    // automatically wrapped in braces for them"] Was telling the user to "write in { }
    // blocks" — wrong instruction for how this actually works: the user types a plain
    // message into NAI's own editor and presses NAI's own Send; onGenerationEnd's
    // _charchatNormalizeDocument pass (see CHARCHAT-BRACE-DIAG just above) adds the
    // braces/header afterward. The user never types a brace themselves.
    api.v1.ui.toast(_ccIsInterview(povId)
        ? ('Interviewing ' + ccContact.name + ' \u2014 type your question below the marker, then press Send.')
        : ('Texting ' + ccContact.name + ' \u2014 type your message below the marker, then press Send.'),
        { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}

// Walk the LIVE document from the marker down (mirrors collectLiveWizTranscript).
// [v2.22.0] Now returns ids AND msgs from one document.scan() — used to be ids-only
// (P1 had nowhere to save a transcript to). Role comes from row.section.source, exactly
// like WIZLIVE — NEVER from name-prefix text, so this works identically whether or not
// a POV was set. Consecutive non-POV paragraphs merge into one turn (a reply split
// across several document sections — header, body, Emotion line — becomes one logical
// turn again, regardless of whether NAI kept onResponse's returned text as one section
// or split it along the embedded newlines; both cases produce the same result here).
async function collectCharChatTranscript(): Promise<{ ids: number[]; msgs: WizardChatMessage[] }> {
    let ccScan = await _charchatScanTurns();
    let ccMsgs: WizardChatMessage[] = [];
    for (let ccT of ccScan.turns) {
        // Canonicalise on the way out too, not just on the way in: a saved thread should
        // round-trip in the same shape the live document is kept in, and a turn the user
        // edited by hand between generations has never been through the write pass.
        let ccC = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName);
        if (!ccC) continue;   // empty turn — a blank paragraph, or a brace block never typed into
        ccMsgs.push({ role: ccT.isPov ? 'user' : 'assistant', content: ccT.isPov ? _charchatStripBraces(ccC) : ccC });
    }
    return { ids: ccScan.ids, msgs: ccMsgs };
}

function _charchatStripBraces(t: string): string {
    let s = (t || '').trim();
    if (s.length >= 2 && s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') s = s.substring(1, s.length - 1).trim();
    return s;
}

// ── Saved threads (one per character PAIR) ──────────────────────────────
// [v2.29.0, REVERSES the v2.22.0 LOCKED DECISION below, per user] Was: one lorebook
// entry per CONTACT, full stop — POV was "label only" and starting a second
// conversation with someone you'd already texted just found/overwrote the same
// entry. Per user: "each character pair can have one chat between them" — POV is
// now a real partition key. charChatEntryId takes povId as a second argument;
// entries stay backward compatible with every thread saved before this pass with
// ZERO migration needed (see charChatEntryId's own comment for how).
// [v2.22.0 CHARCHAT-SAVE, HISTORICAL — no longer true, kept for context] One
// lorebook entry per CONTACT, not per session — matching how a phone actually
// works. The entry id was DETERMINISTIC (charChatEntryId), so there was no
// per-session sourceEntryId to track the way WIZLIVE needs one: Save always
// overwrote the one thread for that contact, and Clear deleted it outright.
var CHARCHAT_CAT_NAME = 'CE Character Chats';
var _aeCharChatCatId: string | null = null;

async function ensureCharChatCategory(): Promise<string> {
    if (_aeCharChatCatId) return _aeCharChatCatId;
    try {
        let cached = (await api.v1.storyStorage.getOrDefault(STORAGE_CHARCHAT_CAT, '')) as string;
        if (cached) {
            let c = await api.v1.lorebook.category(cached);
            if (c) { _aeCharChatCatId = cached; return cached; }
        }
    } catch (_e0) {}
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).filter(function(c: any) { return (c.name || '') === CHARCHAT_CAT_NAME; })[0];
        if (found) {
            _aeCharChatCatId = found.id;
            try { await api.v1.storyStorage.set(STORAGE_CHARCHAT_CAT, found.id); } catch (_e1) {}
            return found.id;
        }
    } catch (_e2) {}
    let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: CHARCHAT_CAT_NAME, enabled: true });
    _aeCharChatCatId = newId;
    try { await api.v1.storyStorage.set(STORAGE_CHARCHAT_CAT, newId); } catch (_e3) {}
    return newId;
}

// [v2.29.0] Now a function of BOTH ids. povId='' reuses the EXACT pre-v2.29.0 id
// shape ('ae_charchat_<contactId>', no suffix) — every thread saved before this
// pass is automatically and correctly the "no POV" bucket under the new scheme,
// with no rekey/migration pass needed. A real povId appends '_pov_<povId>'; UUIDs
// never contain the literal substring '_pov_', so this splits unambiguously (see
// _charchatParseEntryId, the inverse).
function charChatEntryId(contactId: string, povId: string): string {
    return 'ae_charchat_' + contactId + (povId ? ('_pov_' + povId) : '');
}

// Inverse of charChatEntryId. Returns null for anything outside our own prefix
// (defensive — the category is hidden:true but nothing stops something else from
// living in it).
function _charchatParseEntryId(eId: string): { contactId: string; povId: string } | null {
    let prefix = 'ae_charchat_';
    if (!eId || eId.indexOf(prefix) !== 0) return null;
    let rest = eId.substring(prefix.length);
    if (!rest) return null;
    let povIdx = rest.indexOf('_pov_');
    if (povIdx === -1) return { contactId: rest, povId: '' };
    return { contactId: rest.substring(0, povIdx), povId: rest.substring(povIdx + 5) };
}

// [FEATURE v2.26.0 CHARCHAT-SUMMARY-SAVE, per user] Save an edited summary preview to
// the character's own Journal, not a lorebook entry — SUPERSEDES the v2.25.0 design
// (saveCharChatSummaryToLorebook / the "CE Character Chats" lorebook category), which
// is REMOVED. Reuses charJournalAddBubble as-is: same storage, same broadcast
// (AE_CHAR_JOURNAL_STATE), same surface user already reviews bubbles from — no new
// lorebook category, no new id scheme, no new UI to build. A summary becomes one more
// journal bubble for the contact, exactly like any other journal entry.
async function saveCharChatSummaryToJournal(summaryText: string): Promise<boolean> {
    let ccBody = (summaryText || '').trim();
    if (!ccBody || !_aeCharChat.contactId) return false;
    await charJournalAddBubble(_aeCharChat.contactId, ccBody);
    return true;
}

// [FEATURE v2.25.0/v2.26.0 CHARCHAT-SUMMARY-SAVE] Replaces the old toast+log stub
// (previously flagged in the CE-INDEX as "a real review modal is P6 territory") with an
// actual editable-preview modal, mirroring buildLiveChatTab's _wizModalPreview pattern: a
// multilineTextInput bound to the pending text, Save (writes via
// saveCharChatSummaryToJournal and closes) or Discard (drops the text and closes). The
// live chat itself is untouched either way \u2014 Summarize was always a preview action
// that keeps the chat open, and still is.


// Sigil-delimited, NOT name-prefix-delimited — deliberately, so role reconstruction
// never depends on whether a POV was set. @POV/@CONTACT never appear in the live
// document; they exist only in the persisted lorebook text. Turn content is stored
// EXACTLY as it appeared live (including the contact's own "Name:" header and the
// trailing Emotion line) so a resumed thread is a lossless round trip.
// [BUGFIX v2.23.0, per user] Header simplified — plain names, no ids, no timestamp.
// contactId is NEVER stored in text at all: it's recovered from the entry's own
// deterministic id (charChatEntryId) wherever it's needed, so there is nothing to keep
// in sync here. povName is the only thing this header needs to carry for a resume —
// POV was always "label only" (see P1), so a name string is the whole of what a resume
// needs; there is no CharacterRecord field of theirs anything here ever reads.
function serializeCharChatTranscript(contactName: string, povName: string, msgs: WizardChatMessage[]): string {
    let head = '=== Texting ' + contactName + (povName ? (' (as ' + povName + ')') : '') + ' ===';
    let parts: string[] = [head, ''];
    for (let i = 0; i < msgs.length; i++) {
        parts.push(msgs[i].role === 'user' ? '@POV' : '@CONTACT');
        parts.push(msgs[i].content);
        parts.push('');
    }
    return parts.join('\n').replace(/\s+$/, '');
}

// Cheap, header-only read — no sigil walk needed. contactId is deliberately NOT parsed
// here: callers already know it (it's the deterministic entry id minus the prefix), so
// there's nothing to recover from text.
function parseCharChatEntryHeader(text: string): { povName: string } {
    let first = String(text || '').split('\n')[0] || '';
    let m = first.match(/\(as (.+?)\)/);
    return { povName: m ? m[1].trim() : '' };
}

// Inverse of serializeCharChatTranscript. Sigil lines are the ONLY thing that starts a
// new turn; everything else (including blank lines) accrues to whichever turn is
// currently open, so a multi-line contact reply (name header + body + Emotion line)
// survives the round trip as one turn — same guarantee parseChatTranscript gives WIZLIVE,
// just keyed on an unambiguous sigil instead of a fixed Director:/Wizard: prefix.
function parseCharChatTranscript(text: string): { msgs: WizardChatMessage[] } {
    let lines = String(text || '').split('\n');
    let msgs: WizardChatMessage[] = [];
    let cur: WizardChatMessage | null = null;
    for (let i = 0; i < lines.length; i++) {
        let t = lines[i].trim();
        if (t === '@POV' || t === '@CONTACT') {
            if (cur) msgs.push(cur);
            cur = { role: (t === '@POV' ? 'user' : 'assistant'), content: '' };
            continue;
        }
        if (!cur) continue; // header line / pre-first-sigil spacer
        cur.content += (cur.content ? '\n' : '') + lines[i];
    }
    if (cur) msgs.push(cur);
    let out: WizardChatMessage[] = [];
    for (let k = 0; k < msgs.length; k++) {
        let c = msgs[k].content.replace(/^\s+/, '').replace(/\s+$/, '');
        if (c.length > 0) out.push({ role: msgs[k].role, content: c });
    }
    return { msgs: out };
}

function countCharChatTurns(text: string): number {
    let m = String(text || '').match(/^@(?:POV|CONTACT)\s*$/gm);
    return m ? m.length : 0;
}

// ONE bulk lorebook.entries(cat) call, same shape as WIZLIVE's listWizChatEntries —
// never N individual entry() lookups for a roster-sized picker.
// [v2.29.0] Returns one record per (contactId, povId) PAIR now, not per contact —
// see the CE-INDEX v2.29.0 entry. contactId/povId both come straight off the
// entry's own deterministic id (_charchatParseEntryId), same "nothing to parse out
// of the header, nothing to drift out of sync" guarantee the old per-contact
// version had.
async function listCharChatThreads(): Promise<{ contactId: string; povId: string; entryId: string; turnCount: number }[]> {
    let out: { contactId: string; povId: string; entryId: string; turnCount: number }[] = [];
    try {
        let cat = await ensureCharChatCategory();
        let entries = await api.v1.lorebook.entries(cat);
        for (let e of (entries || [])) {
            let parsed = _charchatParseEntryId(e.id || '');
            if (!parsed || !parsed.contactId) continue;
            out.push({ contactId: parsed.contactId, povId: parsed.povId, entryId: e.id, turnCount: countCharChatTurns(e.text || '') });
        }
    } catch (eList) { api.v1.error('[AE:charchat] listCharChatThreads:', eList); }
    return out;
}


// Strip a self-header/Emotion line back OFF a turn's content for the distiller — the
// live document formatting is exactly what we do NOT want the summary prompt to see.
function _charchatBareBody(content: string, ownName: string): string {
    let c = _charchatStripHeader(content, [ownName]);
    // [BUGFIX v2.24.0] This used to be /\n?Emotion:.../ — a private copy of the emotion
    // pattern that assumed the tag was preceded by at most one newline and no spaces.
    // CHARCHAT_EMOTION_PREFIX now carries two leading spaces (per user), which that
    // copy would have silently stopped matching, leaking "Emotion: wistful" into every
    // summarizer prompt. Shared builder now, so the prefix can change again safely.
    c = c.replace(_charchatEmotionRx(), '');
    return c.trim();
}

// [REMOVED v2.24.0] _charchatAppendPovScaffold is GONE, along with its three
// call sites (startCharChat, resumeCharChatFromEntry, and the onGenerationEnd CHARCHAT
// branch). Flagged loudly rather than deleted quietly because it was load-bearing for
// two versions and its absence is the point of this pass.
// It appended a pre-filled "{user: " opener the user was meant to finish. Three
// separate reported bugs were all it:
//   - it assumed the user would type the closing "}" — they were never obliged to, and
//     an unclosed "{user: " reaching context is a dangling instruction block whose most
//     natural continuation is to finish user's line, not reply as the contact (the
//     "needs two clicks / wrong speaker" report; v2.23.0 patched the symptom by stripping
//     it back out of context, which is what a self-inflicted wound looks like);
//   - it appended unconditionally after every reply, so a user who typed their message
//     into a NEW paragraph instead of the scaffold accumulated a second POV header;
//   - it fought the user's own newlines rather than absorbing them.
// The replacement is the canonical turn engine above: write whatever you like, we make it
// canonical afterwards. That is strictly more general — it also fixes headers the MODEL
// invents, which no amount of scaffolding could reach.

// Create-or-overwrite THE thread for this (contact, pov) PAIR — deterministic id,
// no lookup needed to know where to write. [v2.29.0] povId param added back (was
// dropped in v2.23.0 when POV was "label only" — see the CE-INDEX v2.29.0 entry for
// why it's back and why this is a compatible change, not a breaking one).
async function upsertCharChatEntry(contact: CharacterRecord, povId: string, povName: string, msgs: WizardChatMessage[]): Promise<string> {
    let cat = await ensureCharChatCategory();
    let id = charChatEntryId(contact.id, povId);
    // [v2.99.0 CCINT] Display name only — the id is what partitions the thread, and it
    // already does. This just stops an interview and a phone thread with the same
    // character reading identically in the lorebook.
    let ccDisp = (_ccIsInterview(povId) ? 'Interview \u2014 ' : 'Texting ') + contact.name;
    let text = serializeCharChatTranscript(contact.name, povName, msgs);
    let existing: any = null;
    try { existing = await api.v1.lorebook.entry(id); } catch (_e) {}
    if (existing) {
        await api.v1.lorebook.updateEntry(id, { text: text, displayName: ccDisp, category: cat });
        return id;
    }
    // [DEVIATION from the CE-Chats pattern, deliberate] hidden:true — these entries are
    // pure archival storage for the Chat picker, never meant for manual lorebook
    // browsing/editing the way a CE Chats reference entry is.
    let newId = await api.v1.lorebook.createEntry({ id: id, category: cat, displayName: ccDisp, text: text, keys: [], enabled: true, forceActivation: false, hidden: true });
    return newId || id;
}

// Pull a saved thread back into the story. POV is read from the entry itself, not
// re-asked — an established thread already has a POV, and re-prompting would break the
// "just click and continue" flow the badge exists to enable.
async function resumeCharChatFromEntry(entryId: string, contactId: string): Promise<void> {
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeLiveWiz.active)  { api.v1.ui.toast('A wizard chat is open in the story \u2014 end it before starting a character chat.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeWizardMode)      { api.v1.ui.toast('Close the classic wizard first \u2014 the modes are exclusive.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active)    { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let ccContact = await loadCharacter(contactId);
    if (!ccContact) { api.v1.ui.toast('Could not load that character.', { type: 'error', autoClose: 4000 }); return; }
    let entry: any = null;
    try { entry = await api.v1.lorebook.entry(entryId); } catch (_e) {}
    if (!entry || !entry.text) { api.v1.ui.toast('Could not load that saved chat.', { type: 'error', autoClose: 4000 }); return; }

    // [v2.23.0] POV NAME is read straight off the header, not re-derived from a
    // loadCharacter round trip — the header never stores anything else of theirs.
    // [v2.29.0] POV ID is now ALSO needed (it's half of endCharChat's save/clear
    // target once this chat is active again) — parsed off entryId itself, the same
    // source listCharChatThreads already used to build the picker's sublabel/onSelect
    // for this exact entry, so it is guaranteed consistent with what the user picked.
    let hdr = parseCharChatEntryHeader(entry.text);
    let ccPovName = hdr.povName;
    let ccEntryParsed = _charchatParseEntryId(entryId);
    let ccPovId = ccEntryParsed ? ccEntryParsed.povId : '';
    let parsed = parseCharChatTranscript(entry.text);
    if (parsed.msgs.length === 0) { api.v1.ui.toast('That saved chat is empty.', { type: 'warning', autoClose: 3000 }); return; }

    let paras: any[] = [ { text: _ccMarkerTextFor(ccPovId), source: 'instruction' } ];   // [v2.99.0 CCINT] ccPovId is parsed above; _aeCharChat is not assigned until below
    for (let i = 0; i < parsed.msgs.length; i++) {
        let m = parsed.msgs[i];
        if (m.role === 'user') {
            // [v2.24.0] No inner padding — this is the canonical POV shape now
            // (_charchatCanonPov), and content already carries its own "Pov: " header
            // from collectCharChatTranscript. Rebuilding it any other way would just get
            // normalised back to this on the first turn anyway.
            // [BUGFIX v2.51.2 CHARCHAT-RESUME-IDEMPOTENT, per user: "reloading chats
            // sometimes leads to old POV messages being re-wrapped in curly braces"]
            // This unconditionally wrapped m.content, trusting that collectCharChatTranscript
            // (the save side) always hands back brace-free content — true for anything saved
            // by the current build, but nothing here ENFORCES it for an OLDER saved entry
            // whose content might still carry a literal wrapper from before that guarantee
            // existed. Unwrapping first makes this tolerant of both, the same fix
            // v2.42.0 CHARCHAT-POV-IDEMPOTENT already proved for the live-typing path:
            // canon(canon(x)) === canon(x) regardless of which shape x arrives in.
            // [v2.52.0 CHARCHAT-BRACE-DOUBLE] No literal brace -- the paragraph is
            // source:'instruction' and NAI draws its own. Adding one here too was a confirmed
            // cause of a resumed POV turn returning as "{ {Name: ...} }". Unwrap still runs so a
            // thread saved by an older build (which may carry a literal wrapper) normalises clean.
            paras.push({ text: _charchatUnwrapPov(m.content), source: 'instruction' });
        } else {
            let chunks = m.content.split('\n');
            for (let j = 0; j < chunks.length; j++) {
                let c = chunks[j].replace(/^\s+/, '').replace(/\s+$/, '');
                if (c.length > 0) paras.push({ text: c });
            }
        }
    }

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs(paras);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length === 0) { api.v1.ui.toast('Could not resume the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: charChatMaxTokensFor(ccContact, await loadConfig(), ccPovId) });
    } catch (eP) { aeLog('[AE:charchat] param pin failed, continuing without pin:', eP); snap = null; }

    _aeCharChat = {
        active: true, markerId: markerId, setupIds: [],
        contactId: contactId, contactName: ccContact.name,
        povId: ccPovId, povName: ccPovName,   // [v2.29.0] povId now IS persisted/functional again — see the field's own comment
        paramSnapshot: snap, startedAt: Date.now(), lastEmotion: ''
    };
    _ccLastSeenSectionCount = -1;   // [DIAG v2.60.0 CHARCHAT-EMPTY-REPLY-DIAG] resumed session, no baseline yet
    await saveCharChatState();

    try { await _charchatRegisterDecorations(markerId); await refreshCharChatDecorations(); }
    catch (eD) { aeLog('[AE:charchat] decoration registration failed (cosmetic only):', eD); }

    api.v1.ui.toast(_ccIsInterview(ccPovId)
        ? ('Interview with ' + ccContact.name + ' resumed \u2014 continue below the marker.')
        : ('Chat with ' + ccContact.name + ' resumed \u2014 continue below the marker.'),
        { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}

// Non-ending preview, mirrors previewSummarizeLiveChat. [LOCKED PURPOSE, per user] this
// is a NARRATIVE recap matching the story's own prose — no chat-transcript formatting,
// no turn labels, no Emotion lines (that's what Close/save already preserves, separately,
// for resuming). Feeds the distiller a bare role:body transcript via _charchatBareBody
// (stripping the live "Name:"/Emotion formatting back out first). DESTINATION UNDECIDED:
// this only returns text, same as WIZLIVE's own preview — whether/where it auto-lands
// (Memory? the story itself? nothing?) is deferred, not guessed at.
async function previewSummarizeCharChat(): Promise<string> {
    if (!_aeCharChat.active) return '';
    let collected = await collectCharChatTranscript();
    if (collected.msgs.length === 0) return '';
    let cfg = await loadConfig();
    let sTranscript = collected.msgs.map(function(m) {
        let who = (m.role === 'user') ? (_aeCharChat.povName || 'They') : _aeCharChat.contactName;
        return who + ': ' + _charchatBareBody(m.content, who);
    }).join('\n');
    let styleHint = [cfg.projectGenre, cfg.projectConcept].filter(Boolean).join(' \u2014 ');

    // [BUGFIX v2.23.0] ROOT CAUSE of summaries reading like truncated fragments instead
    // of prose: executeYoinkGeneration rides api.v1.editor.generate(), which uses
    // whatever generationParameters are AMBIENT right now — including AE_CHARCHAT_MAX_TOKENS
    // (120, SMS-length), still pinned because Summarize is a preview that does not end
    // the chat. Bump the cap for just this one call, then restore the chat's own pin in a
    // finally — the NEXT real chat turn still needs the SMS-length cap back in place.
    let ccSumSnap: any = null;
    try {
        ccSumSnap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_CHARCHAT_SUMMARY_MAX_TOKENS });
    } catch (ePin) { aeLog('[AE:charchat] summarize token bump failed, using whatever is ambient:', ePin); }

    let sOut = '';
    try {
        sOut = await executeYoinkGeneration([
            { role: 'system', content: 'Distill the following text-message conversation into a short third-person narrative recap, written in the story\u2019s own prose style' + (styleHint ? (' (' + styleHint + ')') : '') + '. Do NOT preserve chat formatting, turn labels, or timestamps \u2014 write it as prose summarizing what was exchanged, the way a narrator would recap it. Keep only what was actually established or decided. Be concise.' },
            { role: 'user', content: sTranscript }
        ], { tag: 'charChatSummarize' });
    } finally {
        if (ccSumSnap) {
            try { await api.v1.generationParameters.update({ max_tokens: ccSumSnap.max_tokens }); }
            catch (eUnpin) { api.v1.error('[AE:charchat] summarize token restore failed \u2014 chat may stay at the wider cap until closed:', eUnpin); }
        }
    }
    return (sOut || '').trim();
}

// [v2.22.0] 'save' (Close) now writes the one thread for this contact for real;
// 'discard' (Clear) now also DELETES that saved thread — one thread per contact means
// starting over with someone means clearing what's there, not accumulating saves.
async function endCharChat(action: string): Promise<void> {
    if (!_aeCharChat.active) { api.v1.ui.toast('No character chat is open.', { type: 'warning', autoClose: 2500 }); return; }
    let act = (action === 'save') ? 'save' : 'discard';
    let ccContactId = _aeCharChat.contactId;

    let collected: { ids: number[]; msgs: WizardChatMessage[] } = { ids: [], msgs: [] };
    try { collected = await collectCharChatTranscript(); }
    catch (eccC) { api.v1.error('[AE:charchat] transcript scan failed:', eccC); }

    // Save/delete FIRST, destroy the document LAST — a failure here returns early,
    // leaving the chat intact rather than losing it to a half-completed end.
    if (act === 'save') {
        if (collected.msgs.length > 0) {
            try {
                let ccContact = await loadCharacter(ccContactId);
                if (ccContact) {
                    await upsertCharChatEntry(ccContact, _aeCharChat.povId, _aeCharChat.povName, collected.msgs);
                    api.v1.ui.toast('Chat with ' + ccContact.name + ' saved.', { type: 'success', autoClose: 3000 });
                }
            } catch (eS) {
                api.v1.error('[AE:charchat] lorebook save failed:', eS);
                api.v1.ui.toast('Save failed \u2014 the chat is still in your document, nothing was removed.', { type: 'error', autoClose: 5000 });
                return;
            }
        }
    } else {
        // [v2.29.0] One thread per PAIR now, not per contact — clearing deletes only
        // THIS pov's thread with this contact; a different pov's thread with the same
        // contact is untouched. Non-fatal if nothing was ever saved for this pair.
        try { await api.v1.lorebook.removeEntry(charChatEntryId(ccContactId, _aeCharChat.povId)); } catch (_eDel) {}
    }

    try {
        if (collected.ids.length > 0) await api.v1.document.removeParagraphs(collected.ids);
    } catch (eccR) { api.v1.error('[AE:charchat] paragraph removal failed \u2014 clean up manually from the marker down:', eccR); }

    // [v2.174.0] AE_CHARCHAT_RULE_IMGTAG ADDED. It has been registered since v2.51.1 and
    // torn down by nothing: a rule left registered after a chat ends keeps hunting every
    // section in its scope for '[Image#hex: ...]' and hiding it, so a story that later
    // mentions an image tag outside a chat would silently lose that text. Every other rule
    // in this family was already here; this was the one omission, not a deliberate keep.
    try { api.v1.editor.decorations.removeRules([AE_CHARCHAT_RULE_MARKER, AE_CHARCHAT_RULE_POV, AE_CHARCHAT_RULE_CONTACT, AE_CHARCHAT_RULE_EMOTION, AE_CHARCHAT_RULE_HEAD, AE_CHARCHAT_RULE_EMOBOX, AE_CHARCHAT_RULE_NAME, AE_CHARCHAT_RULE_IMGTAG]); } catch (_eccDr2) {}
    // [v2.48.0 CHARCHAT-IMGWIDGET] The photo anchors go with the rules. Ending a chat
    // strips every chat paragraph, so NAI would dispose these itself on sectionRemoved —
    // this is belt-and-braces for the 'save' path and for any ordering where the clear
    // lands before the strip.
    // [v2.156.0 STORYIMG] Handle-tracked, same reason as the refresher: a chat closing
    // must not take the story's images down with it.
    await _ccImgDisposeHandles();

    // Restore pinned generation params (same field-by-field shape as the WIZLIVE restore).
    if (_aeCharChat.paramSnapshot) {
        try {
            let ccPs: any = _aeCharChat.paramSnapshot;
            let ccR: any = { model: ccPs.model };
            if (ccPs.max_tokens !== undefined) ccR.max_tokens = ccPs.max_tokens;
            if (ccPs.temperature !== undefined) ccR.temperature = ccPs.temperature;
            if (ccPs.top_p !== undefined) ccR.top_p = ccPs.top_p;
            if (ccPs.top_k !== undefined) ccR.top_k = ccPs.top_k;
            if (ccPs.frequency_penalty !== undefined) ccR.frequency_penalty = ccPs.frequency_penalty;
            if (ccPs.presence_penalty !== undefined) ccR.presence_penalty = ccPs.presence_penalty;
            if (ccPs.min_p !== undefined) ccR.min_p = ccPs.min_p;
            await api.v1.generationParameters.update(ccR);
        } catch (eccRe) { api.v1.error('[AE:charchat] param restore failed:', eccRe); }
    }

    _aeCharChat = { active: false, markerId: null, setupIds: [], contactId: '', contactName: '', povId: '', povName: '', paramSnapshot: null, startedAt: 0, lastEmotion: '' };
    _ccLastSeenSectionCount = -1;   // [DIAG v2.60.0 CHARCHAT-EMPTY-REPLY-DIAG] chat closed, clear the stale baseline
    try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_eccRm) {}
    api.v1.ui.toast(act === 'save' ? 'Story mode restored.' : 'Chat cleared \u2014 story mode restored.', { type: 'success', autoClose: act === 'save' ? 2000 : 3000 });
    await broadcastCharChatState();
}

// Startup rehydration — identical contract to restoreLiveWizOnStartup: a chat left open
// in this story comes back live IF its marker paragraph still exists, otherwise the stale
// state is cleared and any pinned params restored from the persisted snapshot. Restoring
// the pin matters more here than for WIZLIVE: a stranded 120-token cap would silently
// truncate every story generation until someone worked out why.
async function restoreCharChatOnStartup(): Promise<void> {
    let ccRaw = '';
    try { ccRaw = (await api.v1.storyStorage.getOrDefault(STORAGE_CHARCHAT, '')) as string; } catch (_ecc0) {}
    if (!ccRaw) return;
    let ccSt: any = null;
    try { ccSt = JSON.parse(ccRaw); } catch (_ecc1) { ccSt = null; }
    if (!ccSt || !ccSt.active || typeof ccSt.markerId !== 'number') {
        try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_ecc2) {}
        return;
    }
    let ccSecIds: number[] = [];
    try { ccSecIds = await api.v1.document.sectionIds(); } catch (_ecc3) {}
    if (ccSecIds.indexOf(ccSt.markerId) < 0) {
        if (ccSt.paramSnapshot) {
            try {
                let ccRp: any = { model: ccSt.paramSnapshot.model };
                if (ccSt.paramSnapshot.max_tokens !== undefined) ccRp.max_tokens = ccSt.paramSnapshot.max_tokens;
                await api.v1.generationParameters.update(ccRp);
            } catch (_ecc4) {}
        }
        try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_ecc5) {}
        aeLog('[AE:charchat] stale chat state cleared (marker no longer in document).');
        return;
    }
    _aeCharChat = {
        active: true,
        markerId: ccSt.markerId,
        setupIds: Array.isArray(ccSt.setupIds) ? ccSt.setupIds : [],
        contactId: (typeof ccSt.contactId === 'string') ? ccSt.contactId : '',
        contactName: (typeof ccSt.contactName === 'string') ? ccSt.contactName : '',
        povId: (typeof ccSt.povId === 'string') ? ccSt.povId : '',
        povName: (typeof ccSt.povName === 'string') ? ccSt.povName : '',
        paramSnapshot: ccSt.paramSnapshot || null,
        startedAt: ccSt.startedAt || Date.now(),
        lastEmotion: (typeof ccSt.lastEmotion === 'string') ? ccSt.lastEmotion : ''
    };
    // A chat whose contact was deleted between sessions would steer every generation at
    // a character that no longer exists. Fail loudly and close rather than limp.
    let ccChk = _aeCharChat.contactId ? await loadCharacter(_aeCharChat.contactId) : null;
    if (!ccChk) {
        aeLog('[AE:charchat] restored chat points at a missing character \u2014 closing it.');
        await endCharChat('discard');
        return;
    }
    try { await _charchatRegisterDecorations(ccSt.markerId); await refreshCharChatDecorations(); }
    catch (eccDr3) { aeLog('[AE:charchat] decoration restore failed (cosmetic only):', eccDr3); }
    api.v1.ui.toast((_ccIsInterview(_aeCharChat.povId) ? 'Still interviewing ' : 'Still texting ') + _aeCharChat.contactName
        + ' \u2014 continue below the marker, or end it from the Chat button.', { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}


// ── [v2.32.0 CHARCHAT-HUD] Bridge-driven chat verbs ─────────────
// Fire a chat turn the way the Send button does. api.v1.editor.generate() is documented
// as "Trigger a generation at the end of the document, as if the user clicked the Send
// button" — no DOM, no click simulation, and CONFIRMED BY MEASUREMENT to cost zero
// script output budget (the probe watched getAllowedOutput across a full append ->
// generate -> reply cycle and it never moved). That is what makes an unlimited-turn HUD
// chat viable at all.
//
// isBlocked() is checked but NOT TRUSTED as sufficient: the probe caught
// editor.generate() throwing immediately after isBlocked() returned false, which matches
// the concurrency gotcha v2.29.0 already documented for nested generates ("A generation
// is already in progress" is NAI's own internal state, separate from this file's
// ae_genInFlight and evidently not fully surfaced by isBlocked). Hence the retry.
// [BUGFIX v2.34.4 CHARCHAT-GEN-BREAK, per user test] Guarantee the cursor has a trailing
// paragraph break before firing a generation that appends NOTHING of its own.
//
// This is RC1b's root cause, at the two sites v2.34.1 did not touch. 'stage' was fixed by
// appending POV turn + a trailing empty paragraph in one call, and the user confirms
// stage -> native Send now works. 'nudge' and 'regen' both fire _charchatFireGenerate()
// with no append at all, so the cursor sits at the end of whatever paragraph is currently
// last — which after a staged/typed POV turn (nudge) or after removeParagraphs drops the
// old reply (regen) is the POV turn itself. NAI's continuation logic has no break to start
// a fresh section from, so the contact's reply lands INSIDE the POV paragraph: the exact
// reported "adds character response to pov message".
//
// Prevention, not detection — same reasoning v2.34.1 recorded for 'stage': it needs no
// origin inference on a glued section, and _charchatMergeSplitIdx cannot even be consulted
// for a stagedPovIds-marked section, so a post-hoc rescue is not available here anyway.
//
// The blank is NOT added to stagedPovIds (it carries no typed span). If the reply lands in
// it, it is genuinely a contact turn and classifies as one; if nothing lands in it,
// _charchatCanonTurn returns '' and _charchatNormalizeDocument drops it as an empty turn.
// Self-cleaning either way, which is why this is safe to fire unconditionally.
//
// Skips the append when the document already ends in an empty section — re-nudging twice
// in a row should not stack blanks the normalise pass then has to sweep.
async function _charchatEnsureTrailingBreak(): Promise<void> {
    try {
        let ccBrIds = await api.v1.document.sectionIds();
        if (ccBrIds.length) {
            // scan() with a from/to range pinned to the same id reads exactly one section.
            // (There is no api.v1.document.section(id) accessor — sectionIds() + a ranged
            // scan() is the documented way to read a single section's text.)
            let ccBrLastId = ccBrIds[ccBrIds.length - 1];
            let ccBrRows = await api.v1.document.scan(undefined, { from: ccBrLastId, to: ccBrLastId });
            let ccBrLast = (ccBrRows && ccBrRows.length) ? ccBrRows[ccBrRows.length - 1].section : null;
            if (ccBrLast && String((ccBrLast.text || '')).trim() === '') return;   // already have one
        }
        await api.v1.document.appendParagraph({ text: '' });
    } catch (eBr) {
        // Non-fatal and deliberately not a return-false: the generation should still run.
        // Worst case is the pre-v2.34.4 behaviour (a glued reply), which the normalise
        // pass's split machinery can still attempt to rescue.
        api.v1.error('[AE:charchat] trailing-break ensure failed (reply may glue):', eBr);
    }
}

async function _charchatFireGenerate(): Promise<boolean> {
    for (let ccAttempt = 0; ccAttempt < 3; ccAttempt++) {
        let ccBlocked = false;
        try { ccBlocked = await api.v1.editor.isBlocked(); } catch (_eIb) { ccBlocked = false; }
        if (!ccBlocked) {
            try { await api.v1.editor.generate(); return true; }
            catch (eG) { aeLog('[AE:charchat] editor.generate attempt ' + (ccAttempt + 1) + ' failed:', eG); }
        }
        await api.v1.timers.sleep(600);
    }
    api.v1.ui.toast('Could not start a reply — a generation may still be running.', { type: 'warning', autoClose: 3500 });
    return false;
}

// The bridge's whole write surface, in one dispatcher. Every op re-broadcasts state at
// the end so the panel repaints from the DOCUMENT rather than from an optimistic local
// copy — the document is the source of truth for this subsystem and the bridge should
// never hold a second opinion about what the transcript says.
async function handleCharChatAction(payload: any): Promise<void> {
    let ccOp = String((payload && payload.op) || '');

    // [v2.51.6 CHARCHAT-LAUNCHER-SETTINGS, per user] 'thinking' and 'images' are config-only
    // (they write GlobalConfig and re-broadcast; they touch no document), so they run BEFORE
    // the active-chat guard below — the bridge's Chat launcher now surfaces both PRE-chat,
    // matching what the native picker's own items always did by writing config directly. The
    // toast wording is contact-name-safe: '…their inner state…' when no chat is open, the
    // named form when one is.
    if (ccOp === 'thinking') {
        let ccThCfg = await loadConfig();
        let ccThWant = (payload && typeof payload.on === 'boolean') ? !!payload.on : !ccThCfg.charChatFreshThoughts;
        ccThCfg.charChatFreshThoughts = ccThWant;
        await saveConfig(ccThCfg);
        let ccThWho = _aeCharChat.active && _aeCharChat.contactName ? _aeCharChat.contactName + '’s' : 'their';
        api.v1.ui.toast('Fresh thoughts ' + (ccThWant ? 'on — ' + ccThWho + ' state refreshes after each reply.' : 'off.'), { type: 'info', autoClose: 3000 });
        await broadcastCharChatState();
        return;
    }
    if (ccOp === 'images') {
        let ccImgCfg = await loadConfig();
        let ccImgWant = (payload && typeof payload.on === 'boolean') ? !!payload.on : !ccImgCfg.charChatImages;
        ccImgCfg.charChatImages = ccImgWant;
        await saveConfig(ccImgCfg);
        api.v1.ui.toast('Photo attachments ' + (ccImgWant ? 'on — either side can send pictures.' : 'off.'), { type: 'info', autoClose: 3000 });
        await broadcastCharChatState();
        return;
    }

    // Every remaining op acts on the live document, so they require an open chat.
    if (!_aeCharChat.active) {
        aeLog('[AE:charchat] action ignored — no chat is open.');
        return;
    }

    // [v2.46.0 CHARCHAT-SHELL-BASELINE] Ops 'stage' and 'send' are DELETED, with bridge
    // v2.13.0's panel. Both existed to turn BRIDGE-HELD TEXT into a POV paragraph — 'send'
    // appended and fired the reply (the pre-v2.33.0 HUD), 'stage' appended and stopped so the
    // user's own tap on NAI's Send could fire it (v2.33.0's budget pivot). Neither has had a
    // sender since bridge v2.8.0 moved to DOM injection, and injection is gone too: under the
    // shell design the user types in NAI's own editor, so NOTHING outside NAI writes a POV
    // turn. The engine has no draft to receive. ('send' itself is deleted further down, next
    // to 'images' — it does not sit adjacent to 'stage' in this file.)
    // The '/ccprobe' origin-dump diag went with 'send' — it was typed into the panel composer
    // that no longer exists, and the question it existed to answer (does origin stay in sync
    // with text after updateParagraph?) is settled: yes — CHARCHAT-STAGED-IDS is retired on
    // the strength of it (see stagedPovIds' own deleted-comment below).
    // WHAT REMAINS is the op vocabulary the NEW UI calls: 'arm' (cancel the in-flight
    // thought), 'nudge', 'regen', 'edit', 'remove', 'images'. Every one of them acts on the
    // document or on config — none of them carries a message body. That asymmetry IS the
    // design: NAI owns composing, we own everything around it.

    if (ccOp === 'arm') {
        if (payload && payload.on === false) return;
        // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] This mark, read against the timeline the
        // onGenerationEnd marks above lay down, answers the user's question directly: did
        // this Send arrive while a thought was still genuinely in flight (see the branch
        // below), or after the busy indicator had already cleared — and if the latter, how
        // long after. A short gap here on a turn that still failed to reply would point at
        // NAI's own internal slot release lagging behind our JS-side "done" signal, not at
        // the cancellation logic itself.
        _ccRaceDiagMark('arm op received (a Send is imminent)');
        if (_ccThoughtSignal) {
            let ccArmSig = _ccThoughtSignal;
            _ccThoughtSignal = null;   // FIRST: one cancel per signal, and a second arm must not re-cancel a dead one
            try {
                ccArmSig.cancel().catch(function(eArmC1: any) {
                    api.v1.error('[AE:charchat:arm] thought cancel rejected \u2014 it may still be running. If a reply goes missing right after this line, this window is the first suspect:', eArmC1);
                });
                aeLog('[AE:charchat:arm] a Send is coming \u2014 CANCELLED the in-flight post-reply thought. '
                    + 'The previous thought stands, by design. If replies still go missing with Fresh Thoughts ON '
                    + 'and never with it OFF, cancellation is not freeing the slot in time (see the CE-INDEX v2.45.0 block).');
            } catch (eArmC2) {
                api.v1.error('[AE:charchat:arm] thought cancel threw (the send is unaffected):', eArmC2);
            }
        } else {
            // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] Nothing to cancel — either Fresh Thoughts is
            // off, or the thought had already settled before this Send's pointerdown. Logged
            // explicitly (previously silent) so the race-diag timeline shows every arm event,
            // not just the ones that found something to cancel.
            aeLog('[AE:charchat:arm] a Send is coming \u2014 no thought was in flight to cancel.');
        }
        return;
    }

    // [v2.46.0 CHARCHAT-SHELL-BASELINE] Op 'povclaim' is DELETED. It existed for exactly one
    // reason: the bridge injected the user's turn into NAI's editor with execCommand, so the
    // engine had not authored that paragraph and could not classify it from its own records —
    // povclaim scanned the whole document for the injected string and recorded the id it found
    // in stagedPovIds. No injection, no claim to make. Its sender (_ccInjectDraft) is gone.
    // It also answered, for free, the question v2.37.0 flagged as load-bearing: what origin
    // does NAI stamp on execCommand-inserted text? That question is now moot — the text is
    // typed by a human into NAI's own editor, which is the case the origin rule was written
    // for in the first place (see _charchatRowIsPov).

    // [v2.46.0 CHARCHAT-SHELL-BASELINE] Op 'send' DELETED here with 'stage' (see the note
    // above the 'arm' op): the pre-v2.33.0 HUD's "take bridge text, append it as a POV turn,
    // fire the reply" path. It had no sender after v2.33.0's budget pivot and no possible
    // sender now that nothing outside NAI composes a turn. The '/ccprobe' origin dump lived
    // inside it and goes with it — typed into a composer that no longer exists, answering
    // a question that is now settled.

    if (ccOp === 'nudge') {
        // Generate with no new message — "say something else". The instruction block at
        // the bottom of context always asks for the contact's NEXT message, so this needs
        // no special wording; it just runs a turn with nothing added on the POV side.
        // [BUGFIX v2.34.4 CHARCHAT-GEN-BREAK, per user test] ...but "nothing added on the
        // POV side" is exactly what made the reply glue onto the POV turn: no append means
        // no trailing break for NAI to start a fresh section from. See
        // _charchatEnsureTrailingBreak. This is also the path the bridge's own native-Send
        // nudge lands on (empty draft -> no stage -> user taps NAI Send), which is why the
        // user reports the Send-button nudge "does not work properly".
        await _charchatEnsureTrailingBreak();
        await _charchatFireGenerate();
        return;
    }

    if (ccOp === 'regen') {
        let ccScan = await _charchatScanTurns();
        let ccLast: { isPov: boolean; ids: number[]; texts: string[] } | null = null;
        for (let ccI = ccScan.turns.length - 1; ccI >= 0; ccI--) {
            if (!ccScan.turns[ccI].isPov) { ccLast = ccScan.turns[ccI]; break; }
        }
        if (!ccLast) { api.v1.ui.toast('Nothing to regenerate yet.', { type: 'warning', autoClose: 2500 }); return; }

        // Keep a copy in memory, drop the turn, fire. editor.generate() resolves when
        // generation STARTS, not when it finishes, so there is no await to roll back
        // against — the restore can only cover a failure to START. Accepted (per user):
        // worst case is a visible flicker, and the old reply comes back.
        let ccBackup = ccLast.texts.slice();
        try { await api.v1.document.removeParagraphs(ccLast.ids); }
        catch (eR) { api.v1.error('[AE:charchat] regen remove failed:', eR); return; }
        await broadcastCharChatState();

        // [BUGFIX v2.34.4 CHARCHAT-GEN-BREAK, per user test] Dropping the old reply leaves
        // the cursor at the end of the POV turn that preceded it — no trailing break, so
        // the regenerated reply glues onto the POV paragraph. Must run AFTER the remove
        // (the break has to be the last section) and before firing.
        await _charchatEnsureTrailingBreak();

        let ccOk = await _charchatFireGenerate();
        if (!ccOk) {
            for (let ccB of ccBackup) {
                try { await api.v1.document.appendParagraph({ text: ccB }); }
                catch (_eRb) {}
            }
            await broadcastCharChatState();
        }
        return;
    }

    if (ccOp === 'edit') {
        let ccIds: number[] = (payload && Array.isArray(payload.ids)) ? payload.ids.map(Number) : [];
        let ccText = String((payload && payload.text) || '');
        if (!ccIds.length) return;
        // Fold the edit onto the FIRST section of the turn and drop the rest: the user
        // edited one logical message, and a turn may span several sections purely because
        // of how NAI split the original reply. Re-canonicalisation below re-applies the
        // header/braces, so the bridge sends BODY text and never has to know the format.
        try {
            await api.v1.document.updateParagraph(ccIds[0], { text: ccText });
            if (ccIds.length > 1) await api.v1.document.removeParagraphs(ccIds.slice(1));
        } catch (eE) { api.v1.error('[AE:charchat] edit failed:', eE); return; }
        // Safe to normalise here: no generation is in flight (this is a user action, not
        // a hook), which is the one condition the write pass requires.
        try { await _charchatNormalizeDocument(); } catch (_eEn) {}
        try { await refreshCharChatDecorations(); } catch (_eEd) {}
        await broadcastCharChatState();
        return;
    }

    if (ccOp === 'remove') {
        let ccIds: number[] = (payload && Array.isArray(payload.ids)) ? payload.ids.map(Number) : [];
        if (!ccIds.length) return;
        try { await api.v1.document.removeParagraphs(ccIds); }
        catch (eD) { api.v1.error('[AE:charchat] remove failed:', eD); return; }
        try { await refreshCharChatDecorations(); } catch (_eDd) {}
        await broadcastCharChatState();
        return;
    }

    aeLog('[AE:charchat] unknown action op: ' + ccOp);
}

// ── [v2.32.0 CHARCHAT-IMG] Image attachments ───────────────────
// A chat-SCOPED architect pass. Deliberately NOT buildArchitectPromptFromStory, which
// reads the last N sections of the document: during a chat those sections ARE the
// texting transcript, so that function would earnestly compose an image prompt out of
// SMS banter and emotion tags. This one is given the model's own description of the
// shot and nothing else from the document.
//
// CHARACTER RESOLUTION, per user ("fills in character names too"): the speaker's visual
// record is seeded UNCONDITIONALLY rather than being left to getCharacterData's
// whole-word name match over the description. The description for a selfie is "me
// grinning, holding up the coffee" — the speaker's name appears nowhere in it, so the
// match would find nobody and the character would generate as a stranger. Anyone ELSE
// the description does name is matched normally and appended (capped at 4 to match the
// bridge picker's own cap), so "me and Nate at the bar" resolves both.
async function buildCharChatImagePrompt(description: string, speakerName: string): Promise<{ prompt: string; characters: { name: string; visuals: string; uc: string }[] } | null> {
    let ccDesc = (description || '').trim();
    if (!ccDesc) return null;
    await loadImageSettings();

    // Seed: the speaker, always. getCharacterData matches on its argument's text, so
    // passing the bare name is how we ask for "this specific character's record".
    let ccChars: { name: string; visuals: string; uc: string }[] = [];
    let ccSelf = speakerName ? getCharacterData(speakerName) : [];
    if (ccSelf.length) ccChars.push({ name: ccSelf[0].name, visuals: ccSelf[0].visuals, uc: ccSelf[0].uc });

    // Anyone else the description explicitly names.
    let ccOthers = getCharacterData(ccDesc);
    for (let ccO of ccOthers) {
        if (ccChars.some(function(c) { return c.name === ccO.name; })) continue;
        ccChars.push({ name: ccO.name, visuals: ccO.visuals, uc: ccO.uc });
        if (ccChars.length >= 4) break;
    }

    let ccNames = ccChars.map(function(c) { return c.name; }).join(', ');
    let ccUser = 'Photo description:\n' + ccDesc
        + '\n\nThis is a photo taken by ' + (speakerName || 'someone') + ' and sent in a text message \u2014 '
        + 'compose it as a casual phone snapshot (handheld framing, natural/available light), not a cinematic still, '
        + 'unless the description clearly calls for something else.'
        + (ccNames ? '\n\nCharacters identified in scene: ' + ccNames + '. Apply their specific visual tags.' : '')
        + '\n\nGenerate the image prompt:';

    try {
        let ccResp = await aeDiagGenerate('imgArchitect:charchat',
            [
                { role: 'system', content: globalSettings.architectPrompt || DEFAULT_ARCH },
                { role: 'user',   content: ccUser }
            ],
            { model: 'glm-4-6', max_tokens: AE_CHARCHAT_IMG_MAX_TOKENS }
        );
        let ccPrompt = ((ccResp.choices && ccResp.choices[0] &&
            (ccResp.choices[0].message && ccResp.choices[0].message.content || ccResp.choices[0].text)) || ccResp.text || '').trim();
        if (!ccPrompt) return null;
        return { prompt: ccPrompt, characters: ccChars };
    } catch (eCcImg) {
        aeLog('[AE:charchat] image architect failed:', eCcImg);
        return null;
    }
}

// Dispatch ONE resolved attachment to the bridge. Mirrors assembleSnapshotImage's
// EVT_GENERATE_IMAGE payload shape exactly, with kind:'charchat' so the bridge can route
// it to the chat panel instead of the gallery strip. uuid is generated HERE, not in the
// bridge, because it is also what gets written into the document tag — the two must
// agree or the bubble can never find its own image.
async function dispatchCharChatImage(uuid: string, prompt: string, chars: { name: string; visuals: string; uc: string }[], speakerName: string, isPov: boolean): Promise<void> {
    let ccCompiled = compileActiveImageFields();
    await broadcastToTM(EVT_GENERATE_IMAGE, {
        uuid:             uuid,
        prompt:           prompt,
        characters:       chars,
        extraBaseVisuals: '',
        extraBaseUC:      '',
        kind:             'charchat',
        contactId:        _aeCharChat.contactId,
        povId:            _aeCharChat.povId,
        senderName:       speakerName,
        senderIsPov:      isPov,
        settings: {
            width:    globalSettings.defaultWidth,
            height:   globalSettings.defaultHeight,
            steps:    Math.min(globalSettings.defaultSteps || 28, 28),
            scale:    globalSettings.defaultScale || 5.0,
            quality:  ccCompiled.quality,
            negative: ccCompiled.negative
        },
        autoDownload: false
    });
}

// THE PASS. Called from onGenerationEnd's CHARCHAT branch, AFTER
// _charchatNormalizeDocument — ordering matters twice over: normalisation has already
// split any section NAI glued a completion onto (so a tag can't be half in one paragraph
// and half in another) and has settled the text we are about to rewrite.
//
// WHY NOT onBeforeContextBuild: this calls api.v1.generate() (via the architect). That
// hook fires WHILE the turn's own generation is in progress and NAI rejects nested
// generate calls outright — the exact "A generation is already in progress" failure
// v2.29.0 root-caused for CHARCHAT-FRESH-THOUGHTS. onGenerationEnd is the one place in
// the lifecycle where a nested generate is proven safe, which is why the fresh-thoughts
// refresh lives there too. _diagProbeActive is required for the same reason it is
// required there: the nested call re-fires the whole hook lifecycle including THIS
// branch, and would recurse into itself without it.
//
// Per user, EITHER SIDE's tags are caught — "any [Image: is grabbed so no matter who
// sends it". So this walks every turn, not just the newest contact reply, which also
// means a tag the user typed themselves into their own message works identically.
async function _charchatProcessImages(): Promise<number> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return 0;

    let ccScan = await _charchatScanTurns();
    let ccJobs: { sectionId: number; text: string; desc: string; isPov: boolean; speaker: string }[] = [];

    for (let ccT of ccScan.turns) {
        for (let ccI = 0; ccI < ccT.ids.length; ccI++) {
            let ccText = ccT.texts[ccI] || '';
            let ccRx = _charchatImageRx();
            let ccM = ccRx.exec(ccText);
            if (!ccM) continue;
            ccJobs.push({
                sectionId: ccT.ids[ccI],
                text: ccText,
                desc: ccM[1],
                isPov: ccT.isPov,
                speaker: ccT.isPov ? (_aeCharChat.povName || '') : (_aeCharChat.contactName || '')
            });
            if (ccJobs.length >= AE_CHARCHAT_IMG_MAX_PER_TURN) break;
        }
        if (ccJobs.length >= AE_CHARCHAT_IMG_MAX_PER_TURN) break;
    }
    if (!ccJobs.length) return 0;

    // [BUGFIX v2.61.0 CHARCHAT-IMG-BUSY-FLASH, per user: "I don't know why it always shows
    // _charchatProcessImages when no images showed up"] Moved HERE from the caller in
    // onGenerationEnd, which flipped busyStage='image' unconditionally whenever the GLOBAL
    // charChatImages feature toggle was on — regardless of whether THIS reply actually
    // requested a photo. That produced a misleading "sending photo…" flash on every single
    // turn even when ccJobs came back empty a moment later. Flipping it here, now that a real
    // job is confirmed, means the badge only ever appears when there is genuinely a photo
    // being dispatched.
    try { await _charchatSetBusy('image'); } catch (_eIB) {}

    if (!isBridgeReady) {
        api.v1.ui.toast('\ud83d\udcf7 Photo skipped \u2014 image generation needs the bridge connected.', { type: 'warning', autoClose: 3500 });
        return 0;
    }

    let ccDone = 0;
    for (let ccJ of ccJobs) {
        let ccUuid = api.v1.uuid();
        let ccShort = String(ccUuid).replace(/-/g, '').substring(0, 8).toLowerCase();

        // [v2.34.3] Manual _diagProbeActive pair REMOVED \u2014 aeDiagGenerate (the sole
        // api.v1.generate() call site) now sets and RESTORES the flag itself, so this pair
        // was both redundant and a footgun: it cleared to false unconditionally, which
        // would stomp an outer guard if this ever ran nested. See CHARCHAT-OVERRIDE-LEAK.
        let ccBuilt: { prompt: string; characters: { name: string; visuals: string; uc: string }[] } | null = null;
        try { ccBuilt = await buildCharChatImagePrompt(ccJ.desc, ccJ.speaker); }
        catch (eB) { api.v1.error('[AE:charchat] image prompt build failed:', eB); }

        if (!ccBuilt) {
            // Leave the tag UNRESOLVED rather than stamping a uuid onto an image that
            // was never dispatched — a resolved tag pointing at nothing would render
            // as a permanently-spinning bubble the next pass would refuse to retry.
            aeLog('[AE:charchat] image architect returned nothing for: ' + ccJ.desc);
            continue;
        }

        try { await dispatchCharChatImage(ccUuid, ccBuilt.prompt, ccBuilt.characters, ccJ.speaker, ccJ.isPov); }
        catch (eD) { api.v1.error('[AE:charchat] image dispatch failed:', eD); continue; }

        // Rewrite ONLY the first unresolved tag in this section, and only after a
        // successful dispatch. String.replace with a non-global regex hits the first
        // match only, which is what the cap above already assumes.
        let ccNew = ccJ.text.replace(/\[[ \t]*Image[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/i,
            '[Image#' + ccShort + ': ' + ccJ.desc + ']');
        try {
            await api.v1.document.updateParagraph(ccJ.sectionId, { text: ccNew });
            ccDone++;
        } catch (eU) {
            api.v1.error('[AE:charchat] image tag rewrite failed (image still generating, bubble will not bind):', eU);
        }
    }
    return ccDone;
}

// Turn list for the bridge HUD. The bridge paints bubbles from THIS — it does not read
// the DOM for role. Role comes from _charchatScanTurns (section source/origin metadata),
// which is the same guarantee the rest of this subsystem relies on: role is NEVER
// inferred from text.
async function charChatTurnsPayload(): Promise<any[]> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return [];
    let ccScan = await _charchatScanTurns();
    let ccOut: any[] = [];
    for (let ccT of ccScan.turns) {
        let ccCanon = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName);
        if (!ccCanon) continue;

        // Split the display text into the parts the bridge renders separately. The
        // emotion tag and the image tags stay in the DOCUMENT (see _charchatImageRx's
        // note) but the bridge wants them as fields, not as literal text in a bubble.
        let ccEmotion = '';
        let ccCut = ccCanon.match(_charchatEmotionRx());
        if (ccCut && ccCut[1] && ccCut.index !== undefined) {
            ccEmotion = resolveEmotion(ccCut[1].trim());
            ccCanon = ccCanon.substring(0, ccCut.index);
        }

        let ccImgs: { uuid: string; desc: string; pending: boolean }[] = [];
        let ccRxR = _charchatImageResolvedRx();
        let ccMr: any;
        while ((ccMr = ccRxR.exec(ccCanon)) !== null) ccImgs.push({ uuid: ccMr[1], desc: ccMr[2], pending: false });
        let ccRxU = _charchatImageRx();
        let ccMu: any;
        while ((ccMu = ccRxU.exec(ccCanon)) !== null) ccImgs.push({ uuid: '', desc: ccMu[1], pending: true });

        // Body = the text with both tag forms and the leading name header removed.
        let ccBody = ccCanon
            .replace(_charchatImageResolvedRx(), '')
            .replace(_charchatImageRx(), '');
        ccBody = _charchatStripHeader(_charchatUnwrapPov(ccBody), [_aeCharChat.povName, _aeCharChat.contactName]);
        ccBody = ccBody.replace(/\n{3,}/g, '\n\n').trim();

        ccOut.push({
            ids:      ccT.ids,
            isPov:    ccT.isPov,
            speaker:  ccT.isPov ? (_aeCharChat.povName || 'You') : (_aeCharChat.contactName || 'They'),
            body:     ccBody,
            emotion:  ccEmotion,
            images:   ccImgs,
            raw:      ccCanon
        });
    }
    return ccOut;
}

// ── [v2.21.0 CHARCHAT] end ─────────────────────────────────────


// [vNEXT] Run a budget-free generation against a custom message array. Resolves with
// the captured response text. Guards against overlapping with any in-flight gen.
// [v0.9.7.12] editor.generate() shares the same script-level rate limit as
// api.v1.generate(). Long wizard sessions can exhaust this budget. Added:
//   - api.v1.editor.isBlocked() check (editor already mid-generation)
//   - api.v1.script.getAllowedOutput() floor (< 80 tokens = budget near empty)
//   - friendly error surfaced as toast when the rate limit is hit
// [v1.21.0 YOINK-HARDEN] Renamed from executeYoinkGeneration — this is now the single-
// attempt primitive. executeYoinkGeneration (below) wraps this with model pinning,
// a language guard, and one corrective retry. Do not call this directly from wizard
// code; call executeYoinkGeneration.

// ============================================================================
// SECTION 3g — BUDGET & GENERATION DIAGNOSTICS
// Token-budget probe and the generation ring-buffer log. Both are
// instrumentation only; AE_DIAG_BUDGET / AE_DIAG_GEN are kill switches.
// ============================================================================

// ── [DIAG BUDGET] Per-generation token-budget instrument ─────────────────────
// [DIAG] Additive, engine-only. Flip AE_DIAG_BUDGET=false to silence, or delete this
// block plus its call sites (all tagged [DIAG]) to remove entirely. Measures the
// api.v1.script output/input allowance deltas across each generation so we can SEE
// whether the yoink (editor.generate hijack) draws on the script budget vs a plain
// api.v1.generate(). Type /budgetprobe or /budgetlog into any wizard chat to run the
// A/B probe or dump the recent log; every real generation also logs a line + a toast.
var AE_DIAG_BUDGET = true;
var _diagProbeActive = false;      // true while ANY of our own nested api.v1.generate() calls is in flight — api.v1.generate() fires the full hook lifecycle, so every hook checks this first and no-ops rather than treating the nested call as a story/chat/wizard turn. [v2.34.2/v2.34.3] Set and RESTORED by aeDiagGenerate alone (the sole api.v1.generate() call site); the old hand-rolled true/false pairs at each caller are gone — they were redundant once the wrapper owned it, and they cleared unconditionally, which stomps an outer guard when nested.
interface DiagBudgetPre { out: number; inp: number; kind: string; continuityId: string | null; }
var _diagBudgetPre: DiagBudgetPre | null = null;
var _diagBudgetLog: string[] = [];
function diagBudO(): number { try { return api.v1.script.getAllowedOutput ? api.v1.script.getAllowedOutput() : -1; } catch (e) { return -1; } }
function diagBudI(): number { try { return api.v1.script.getAllowedInput ? api.v1.script.getAllowedInput() : -1; } catch (e) { return -1; } }
function diagReplenishSec(): number { try { let t = api.v1.script.getTimeUntilAllowedOutput ? api.v1.script.getTimeUntilAllowedOutput(1000) : -1; return t >= 0 ? Math.round(t / 1000) : -1; } catch (e) { return -1; } }
// [v2.74.0 GEN-BUDGET] Public budget snapshot for the HUD. diagBudO/diagBudI above are
// diagnostic-only and channel-gated; this one is a first-class payload the bridge shows
// to the user, so it is deliberately separate and always available.
//
// waitSec uses getTimeUntilAllowedOutput, which per script-types "does not take into
// account whether the user interaction flag is set on those tokens" — so it is a FLOOR,
// not a promise. Output replenishes only while the user has interacted with the script
// recently, which is exactly why the bridge copy tells them to advance the story rather
// than just wait. Do not present waitSec as a countdown to guaranteed availability.
//
// NOTE: this never calls waitForAllowedOutput. generateFieldContent documents why —
// these paths run from modal/bridge callbacks where that signal never fires, so awaiting
// it deadlocks. Check and report; never block.
function aeBudgetReport(needOut?: number): { out: number; inp: number; waitSec: number; need: number } {
    const bOut = diagBudO();
    const bInp = diagBudI();
    const bNeed = (typeof needOut === 'number' && needOut > 0) ? needOut : 0;
    let bWait = -1;
    try {
        if (bNeed > 0 && api.v1.script.getTimeUntilAllowedOutput) {
            const ms = api.v1.script.getTimeUntilAllowedOutput(bNeed);
            bWait = ms >= 0 ? Math.ceil(ms / 1000) : -1;
        } else {
            bWait = diagReplenishSec();
        }
    } catch (eBud) { bWait = -1; }
    return { out: bOut, inp: bInp, waitSec: bWait, need: bNeed };
}

function diagBudgetSnapshot(kind: string, continuityId: string | null): void {
    if (!AE_DIAG_BUDGET) return;
    _diagBudgetPre = { out: diagBudO(), inp: diagBudI(), kind: kind, continuityId: continuityId };
}
function diagBudgetClose(continuityId: string | null): void {
    if (!AE_DIAG_BUDGET || !_diagBudgetPre) return;
    if (continuityId && _diagBudgetPre.continuityId && continuityId !== _diagBudgetPre.continuityId) return;
    let pre = _diagBudgetPre; _diagBudgetPre = null;
    let pO = diagBudO(), pI = diagBudI();
    let dO = pO - pre.out, dI = pI - pre.inp;
    let line = '[AE:budget] ' + pre.kind
        + '  out ' + pre.out + '\u2192' + pO + ' (\u0394' + (dO >= 0 ? '+' : '') + dO + ')'
        + '  in ' + pre.inp + '\u2192' + pI + ' (\u0394' + (dI >= 0 ? '+' : '') + dI + ')'
        + '  replenish~' + diagReplenishSec() + 's';
    aeLog(line);
    _diagBudgetLog.push(line);
    if (_diagBudgetLog.length > 30) _diagBudgetLog.shift();
}
function dumpBudgetLog(): string {
    if (!_diagBudgetLog.length) return 'No budget readings yet. Run a wizard turn or /budgetprobe first.\nCurrent: out=' + diagBudO() + ' in=' + diagBudI() + ' replenish~' + diagReplenishSec() + 's';
    return 'Recent generation budget readings (newest last):\n' + _diagBudgetLog.join('\n') + '\nCurrent: out=' + diagBudO() + ' in=' + diagBudI();
}
// A/B probe: measure a tiny api.v1.generate() vs a tiny yoink, back to back, so their
// real budget cost can be compared directly. api.v1.generate is glm-4-6-only for chat
// (per docs), which is why the probe pins that model. _diagProbeActive keeps a probe
// generation from advancing story state if api.v1.generate turns out to fire the hooks.
async function runBudgetProbe(): Promise<string> {
    let L: string[] = ['Budget A/B probe (out=output allowance, in=input allowance):'];
    L.push('start:            out=' + diagBudO() + ' in=' + diagBudI());
    let a0o = diagBudO(), a0i = diagBudI(), aOk = false, aErr = '';
    // [v2.34.3] Manual _diagProbeActive pair removed \u2014 aeDiagGenerate sets/restores it.
    try {
        let r: any = await aeDiagGenerate('diag:budgetprobe:direct', [{ role: 'user', content: 'Reply with exactly one word: ping' }], { model: 'glm-4-6', max_tokens: 8, temperature: 0 });
        aOk = !!(r && r.choices && r.choices[0]);
    } catch (e) { aErr = String((e && (e as any).message) || e); }
    let a1o = diagBudO(), a1i = diagBudI();
    L.push('api.v1.generate:  ' + (aOk ? 'ok ' : ('ERR ' + aErr + ' ')) + ' out \u0394' + (a1o - a0o) + '  in \u0394' + (a1i - a0i));
    let b0o = diagBudO(), b0i = diagBudI(), bOk = false, bErr = '';
    try {
        let ry = await executeYoinkGeneration([{ role: 'system', content: 'Reply with exactly one word: ping' }, { role: 'user', content: 'ping' }], { tag: 'diag:budgetprobe' });
        bOk = !!(ry && ry.trim());
    } catch (e) { bErr = String((e && (e as any).message) || e); }
    let b1o = diagBudO(), b1i = diagBudI();
    L.push('yoink:            ' + (bOk ? 'ok ' : ('ERR ' + bErr + ' ')) + ' out \u0394' + (b1o - b0o) + '  in \u0394' + (b1i - b0i));
    L.push('end:              out=' + diagBudO() + ' in=' + diagBudI() + '  replenish~' + diagReplenishSec() + 's');
    let out = L.join('\n');
    aeLog(out);
    return out;
}
// ── [DIAG BUDGET] end ────────────────────────────────────────────────────────

// ── [DIAG GEN v1.0.0] Generation call diagnostics — engine-wide ──────────────
// [v2.20.0 GENDIAG] Root-caused report: "Generate All From Concept Dump" (and,
// less visibly, every other wizard/field generator) could die on a single
// transient failure — most often an AbortError surfacing from NAI's own
// generation pipeline on api.v1.editor.generate() — with nothing surfaced but a
// generic "Failed." toast and a bare console.error. There was also no shared
// visibility across the two call families: the budget-free YOINK path
// (executeYoinkGeneration, used by the World-Build Wizard + "Generate All") and
// the budgeted DIRECT path (api.v1.generate(), used by per-field regen,
// ephemeral/mid-range/relationship/hook updates, and image-prompt generation)
// each swallowed their own errors independently with no common record.
//
// This block gives every engine generation call — both paths — one shared,
// tagged ring buffer, so a failure of any kind can be reviewed after the fact
// via console (visible in eruda) or the in-UI viewer (Config modal's
// "🩺 Generation Diagnostics" section, and a matching entry point next to
// "Generate All From Concept Dump" in the character editor). See
// buildGenDiagContent() (Section 24 area) for the UI, and diagGenRecord() /
// aeDiagGenerate() below for the two recording points. Deliberately NOT wired
// into api.v1.storage/storyStorage — this is in-memory, session-only, cheap-by-
// design diagnostic scaffolding, not user data; it resets on script reload same
// as _diagBudgetLog above. No new storage key.
interface AEGenDiagEntry {
    id: number;
    tag: string;                 // which generator/feature (and often character) this call belongs to
    method: 'yoink' | 'direct';  // executeYoinkGeneration vs api.v1.generate
    startedAt: number;           // Date.now() when the call began
    ms: number;                  // wall-clock latency for this entry's outcome
    outcome: 'ok' | 'empty' | 'error';
    errorName: string;           // e.g. 'AbortError', 'Error' — '' when outcome !== 'error'
    errorMessage: string;
    retried: boolean;            // a same-messages retry was attempted after a thrown error (yoink only)
    driftDetected: boolean;      // non-Latin/CJK drift heuristic tripped (yoink only)
    validatorFailed: boolean;    // caller-supplied validator rejected the raw output (yoink only)
    outLen: number;              // length of the returned text, 0 on error
    budgetOut: number;
    budgetIn: number;
}
var AE_DIAG_GEN = true;          // flip-in-code kill switch, mirrors AE_DIAG_BUDGET above
var AE_DIAG_GEN_MAX = 60;        // ring buffer cap — oldest entries drop first
var _diagGenLog: AEGenDiagEntry[] = [];
var _diagGenSeq = 0;

function diagGenRecord(entry: {
    tag: string; method: 'yoink' | 'direct'; startedAt: number; ms: number;
    outcome: 'ok' | 'empty' | 'error'; errorName: string; errorMessage: string;
    retried: boolean; driftDetected: boolean; validatorFailed: boolean; outLen: number;
    budgetOut: number; budgetIn: number;
}): void {
    if (!AE_DIAG_GEN) return;
    _diagGenSeq++;
    let full: AEGenDiagEntry = { id: _diagGenSeq, tag: entry.tag, method: entry.method, startedAt: entry.startedAt,
        ms: entry.ms, outcome: entry.outcome, errorName: entry.errorName, errorMessage: entry.errorMessage,
        retried: entry.retried, driftDetected: entry.driftDetected, validatorFailed: entry.validatorFailed,
        outLen: entry.outLen, budgetOut: entry.budgetOut, budgetIn: entry.budgetIn };
    _diagGenLog.push(full);
    if (_diagGenLog.length > AE_DIAG_GEN_MAX) _diagGenLog.shift();
    let line = '[AE:gendiag] #' + full.id + ' ' + full.method + '  tag=' + full.tag
        + '  outcome=' + full.outcome
        + (full.errorName ? ('  ' + full.errorName + ': ' + full.errorMessage) : '')
        + '  ms=' + full.ms
        + (full.retried ? '  retried' : '')
        + (full.driftDetected ? '  drift' : '')
        + (full.validatorFailed ? '  validatorFailed' : '')
        + '  outLen=' + full.outLen
        + '  budget(out=' + full.budgetOut + ',in=' + full.budgetIn + ')';
    if (full.outcome === 'error') api.v1.error(line); else aeLog(line);
}

function dumpGenDiagLog(): string {
    if (!_diagGenLog.length) return 'No generation calls logged yet this session.';
    let lines = _diagGenLog.slice().reverse().map(function(e) {
        return '#' + e.id + ' [' + new Date(e.startedAt).toLocaleTimeString() + ']  ' + e.method + '  ' + e.tag
            + '\n    outcome=' + e.outcome
            + (e.errorName ? ('  ' + e.errorName + ': ' + e.errorMessage) : '')
            + '  ms=' + e.ms
            + (e.retried ? '  retried' : '')
            + (e.driftDetected ? '  drift' : '')
            + (e.validatorFailed ? '  validatorFailed' : '')
            + '  outLen=' + e.outLen
            + '  budget(out=' + e.budgetOut + ',in=' + e.budgetIn + ')';
    });
    let errCount = _diagGenLog.filter(function(e) { return e.outcome === 'error'; }).length;
    return 'Recent generation calls, newest first (' + _diagGenLog.length + ' logged, ' + errCount + ' error' + (errCount === 1 ? '' : 's') + '):\n' + lines.join('\n');
}

function clearGenDiagLog(): void { _diagGenLog = []; _diagGenSeq = 0; }

// [v2.39.0 CHARCHAT-THOUGHT-NATIVE] aeGenerateBounded() removed — its only caller was
// generateChatEphemeral. [v2.45.0] generateChatEphemeral is BACK (post-reply, direct
// api.v1.generate()) and deliberately did NOT bring this with it: it takes a cancellation
// signal instead, cancelled by op 'arm' when a Send is imminent, which is the bound that
// actually matters here. A wall-clock timeout would only abandon a call that is still
// running. It was a good primitive:
// real cancellation via api.v1.createCancellationSignal(), always awaited to settlement,
// never a Promise.race. If a future pass needs a bounded nested generation, take it from
// v2.38.0 rather than rewriting it — the invariant it protects is subtle and the naive
// version (race, abandon, proceed) reintroduces the exact collision it existed to remove.
// Deleted rather than parked: an unused generation path is how this file grew a hidden HUD.

// ============================================================================
// SECTION 3h — GENERATION EXECUTION (direct wrapper + yoink pipeline)
// aeDiagGenerate wraps the DIRECT budgeted path; executeYoinkGeneration
// is the metered/free-run path with watchdog and retry classification.
// ============================================================================

// Thin instrumented wrapper around api.v1.generate() — the DIRECT (budgeted)
// generation path. Every existing caller's messages/params pass through
// unchanged and the raw response is returned unchanged (including on success
// with empty text) so none of the callers' own parsing/fallback logic needs to
// change — this only adds a diagGenRecord() entry on the way through. Callers
// keep their own try/catch; a thrown error is recorded here AND rethrown so
// existing fallback behavior (return null/false, toast, etc.) is unaffected.
// [BUGFIX v2.34.2 CHARCHAT-OVERRIDE-LEAK, per user report] ROOT CAUSE of the instruction
// text appearing IN the document ("...not the true feeling. ]Sara: whatever u want"), and
// of nudge/regen misbehaving. onBeforeContextBuild's CHARCHAT branch claimed in its own
// comment that "story generation cannot run while a chat is open, so every generation
// reaching this line IS a chat turn — which is what makes applying the override
// unconditionally safe." That is FALSE, and this file's own budget probe already recorded
// the counter-evidence in the user's log: "onBeforeContextBuild fired (api.v1.generate
// DOES build story context)". generateEphemeral() and the imgArchitect pass are
// api.v1.generate() calls that run WHILE a chat is open, so they reached that line and had
// the full chat override applied to them — system prompt replaced, character lorebook
// suppressed, and a storyText whose tail is buildCharChatInstruction's bracket block. The
// user's leaked fragment is exactly that tail, closing ' ]' included. It also explains the
// repeated 'extractJSON failed' on the ephemeral/architect tags: those calls ask for JSON
// but were handed a context ending in "Write ONLY the message body: ... never write a name
// header", so the model answered the wrong question.
// _diagProbeActive is ALREADY the documented mechanism for exactly this ("true while ANY of
// our own nested api.v1.generate() calls is in flight ... every hook checks this first and
// no-ops rather than treating the nested call as a story/chat/wizard turn" — see its own
// declaration comment). It was simply never set for every nested call: runBudgetProbe and
// the imgArchitect loop set it by hand, generateEphemeral's other paths did not. Setting it
// HERE covers all of them at once, because this wrapper is the SOLE caller of
// api.v1.generate() in the file (verified: grep 'api.v1.generate(' — this is the only
// call site outside comments).
// SAVE/RESTORE, not a blind reset to false: two call sites (runBudgetProbe, the
// imgArchitect loop) already set the flag around a region that CONTAINS an aeDiagGenerate
// call, so clearing unconditionally on the way out would drop their guard early and
// re-expose the very window they set it for. Restoring the prior value makes nesting safe
// in either order.
// [v2.38.0 CHARCHAT-THINK-FIRST] Optional 5th-arg cancellation signal, threaded through
// to api.v1.generate(). Verified against script-types.txt: generate(messages, params,
// callback?, behaviour?, signal?) — callback and behaviour are passed as undefined so the
// existing call sites' semantics are byte-identical to before. Every current caller omits
// the argument and is unaffected; only aeGenerateBounded() supplies one.
// [v2.45.0] behaviour param KEPT (v2.44.0's collision probe added it and is otherwise
// deleted). Every other caller passes undefined and is unaffected — api.v1.generate()'s own
// default applies exactly as before. Its one live caller is now generateChatEphemeral, which
// asks for 'background': it runs after the reply has landed, while the user is reading and
// typing, and must never block the editor. Signature per script-types.txt:
// generate(messages, params, callback?, behaviour?, signal?).
async function aeDiagGenerate(tag: string, messages: any[], params: any, signal?: any, behaviour?: 'background' | 'blocking'): Promise<any> {
    // [v2.94.0 SLOT-YOINK-AUTO] Any metered call frees the next yoink run. Fire-and-forget
    // and never allowed to throw: a failure to reset a counter must not be able to take
    // down the generation it is attached to.
    _ceYoinkRunReset().catch(function() {});
    // [v2.139.0 STYLE2 GEN-RAIL] SS10.1 #3 / SS10.2: the shell-scope generation rail hangs
    // HERE and nowhere else, because this wrapper is already the sole call site of
    // api.v1.generate() in the file (see the note above -- verified by grep, and the
    // _diagProbeActive save/restore below depends on the same fact). Begin/end are
    // deliberately in the same try/finally shape as _diagProbeActive: the rail must clear
    // on the error path exactly as reliably as on the success path, or one thrown
    // generation leaves a bar running across the top of the shell for the rest of the
    // session. Both calls swallow everything internally and cannot throw in here.
    ceGenBegin();
    let t0 = Date.now();
    let b0o = diagBudO(), b0i = diagBudI();
    let ccProbePrev = _diagProbeActive;
    _diagProbeActive = true;
    try {
        let resp: any = signal
            ? await api.v1.generate(messages, params, undefined, behaviour, signal)
            : await api.v1.generate(messages, params, undefined, behaviour);
        let outText = String((resp && resp.choices && resp.choices[0] &&
            (resp.choices[0].text || (resp.choices[0].message && resp.choices[0].message.content))) || (resp && resp.text) || '');
        diagGenRecord({ tag: tag, method: 'direct', startedAt: t0, ms: Date.now() - t0,
            outcome: outText.trim() ? 'ok' : 'empty', errorName: '', errorMessage: '',
            retried: false, driftDetected: false, validatorFailed: false,
            outLen: outText.length, budgetOut: b0o, budgetIn: b0i });
        return resp;
    } catch (e) {
        diagGenRecord({ tag: tag, method: 'direct', startedAt: t0, ms: Date.now() - t0,
            outcome: 'error', errorName: String((e && (e as any).name) || 'Error'), errorMessage: String((e && (e as any).message) || e),
            retried: false, driftDetected: false, validatorFailed: false,
            outLen: 0, budgetOut: b0o, budgetIn: b0i });
        throw e;
    } finally {
        _diagProbeActive = ccProbePrev;
        ceGenEnd();
    }
}
// ── [DIAG GEN] end ────────────────────────────────────────────────────────────

function executeYoinkGenerationAttempt(messages: any[]): Promise<string> {
    return new Promise(function(resolve, reject) {
        if (_aeYoink.active) { reject(new Error('A yoink generation is already in progress')); return; }
        if (ae_genInFlight || ae_lock) { reject(new Error('Editor is busy; try again in a moment')); return; }
        // [v0.9.7.12] Budget floor: < 80 tokens remaining = rate limit imminent.
        // The runtime state generators already guard at 220; 80 is a softer floor for
        // interactive wizard calls so the user gets a clear message, not a raw API error.
        const ygBudget = api.v1.script.getAllowedOutput ? api.v1.script.getAllowedOutput() : 9999;
        if (ygBudget < 80) {
            const ygMsg = 'Script generation budget is low. Wait a moment, then try again.';
            api.v1.ui.toast(ygMsg, { type: 'warning', autoClose: 4000 });
            reject(new Error(ygMsg)); return;
        }
        _aeYoink.active = true;
        _aeYoink.messages = messages;
        _aeYoink.responseText = '';
        _aeYoink.resolve = resolve;
        _aeYoink.reject = reject;
        // [v1.22.1] Cleared here and captured in onContextBuilt, so this attempt only ever
        // accepts hook events belonging to the generation it actually started.
        _aeYoink.continuityId = null;
        diagBudgetSnapshot('YOINK', null);   // [DIAG] pre-read for this yoink; closed in onGenerationEnd
        api.v1.editor.generate().catch(function(ygErr) {
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
            // [v0.9.7.12] Surface rate-limit errors as a human-readable toast rather
            // than letting the raw NAI error bubble silently to the log.
            const ygEMsg = String((ygErr && ygErr.message) || ygErr || '');
            if (ygEMsg.toLowerCase().indexOf('limit') >= 0 || ygEMsg.toLowerCase().indexOf('budget') >= 0) {
                api.v1.ui.toast('Generation limit reached. Wait a moment before retrying.', { type: 'warning', autoClose: 5000 });
            }
            reject(ygErr);
        });
    });
}

// [v1.21.0 YOINK-HARDEN] Cheap non-Latin/CJK drift heuristic — not a language detector,
// just a signal that generation derailed into another script entirely. Users reported
// the World-Build Wizard occasionally outputting Chinese and/or bullet-pointed junk;
// root cause hypothesis is that executeYoinkGenerationAttempt rides whatever model the
// story's live generation settings currently point at, but NAI's api.v1 docs state
// role-tagged system/user/assistant messages are only currently supported by glm-4-6
// for scripted generation (see api.v1.generate / api.v1.generationParameters docs).
var AE_NONLATIN_DRIFT_RE = /[\u3040-\u30FF\u3400-\u4DBF\u4E00-\u9FFF\uAC00-\uD7AF\uF900-\uFAFF]/;

interface AEYoinkOptions {
    // Optional pass/fail check on the raw response (e.g. "contains NAME:"). A failing
    // check triggers the same one-shot corrective retry as language-drift detection.
    validator?: (raw: string) => boolean;
    // [v2.20.0 GENDIAG] Which generator/feature (and often character) this call belongs
    // to, for diagGenRecord() — see the [DIAG GEN] block above. Defaults to 'untagged'
    // when omitted; every call site in this file passes one.
    tag?: string;
}

// [v1.22.1 YOINK-WATCHDOG] Root cause of the July 2026 "wizard freezes all generation"
// report: NAI's own generation pipeline can wedge (observed as "Encoder Worker Timeout"
// in the browser console) WITHOUT ever calling onGenerationEnd. Every prior layer of
// this system — the _aeYoink.active guard, the v1.21.0 model-pin's try/finally restore,
// even the pre-existing onGenerationEnd catch-block failsafe — only runs in response to
// a NAI hook actually firing. None of them protect against NAI never calling back at
// all. A single stuck generation therefore left BOTH _aeYoink.active AND the pinned
// model (glm-4-6) stuck forever: every later normal story turn silently skipped AE's
// world-state injection (onBeforeContextBuild's `if (_aeYoink.active) return;` guard)
// AND ran on the wrong model, while every later wizard call was rejected outright.
//
// Fix has two independent parts:
//   1. A genuine client-side timeout (AE_YOINK_TIMEOUT_MS), via Promise.race against
//      api.v1.timers.sleep — NOT dependent on any NAI hook ever firing. On timeout we
//      force-recover _aeYoink ourselves rather than waiting for cleanup that may never
//      come.
//   2. Force-recovery must not corrupt a NEWER call that starts after we give up on the
//      old one. onContextBuilt/onResponse/onGenerationEnd all carry NAI's own per-
//      generation `continuityId`; we capture it when a yoink's context is built and
//      every subsequent hook checks it before touching _aeYoink, so a late event from
//      an abandoned generation is recognized as orphaned and ignored instead of
//      resolving (or corrupting the response buffer of) whatever call is active by then.
//      See onContextBuilt / onResponse / onGenerationEnd below.
var AE_YOINK_TIMEOUT_MS = 90000;

// [v1.22.1] The model pin is the prime suspect for triggering the encoder wedge in the
// first place — every yoink call was forcing a model switch (and switch-back) even
// when nothing needed it, and glm-4-6 uses a different tokenizer than most NAI story
// models, making repeated switching a plausible way to destabilize the encoder worker.
// Defaulting OFF until confirmed safe. The watchdog above is needed regardless of this
// setting — NAI's pipeline can wedge independent of any model-switching.
var AE_YOINK_MODEL_PIN_ENABLED = false;

// [v2.94.0 SLOT-YOINK-AUTO] Live testing (v2.93.0) found that editor.generate() calls do
// not draw down getAllowedOutput() the way api.v1.generate() does, but that a run of them
// stops producing after roughly three UNLESS a metered generation happens in between --
// which then frees the next run. Both are NAI's own metering of a documented API method,
// and the script-interaction requirement editor.generate() carries is already satisfied by
// every other CE generator, so alternating deliberately is ordinary use of the documented
// surface rather than a workaround.
//
// The cap is the OBSERVED number, not a derived one. If NAI changes the metering this is
// the single number to re-measure, and the auto path degrades safely if it is wrong in
// either direction: too high just means a wasted yoink attempt that falls back to direct,
// too low means leaving free generations unused.
const AE_YOINK_RUN_MAX = 3;
const STORAGE_YOINK_RUN = 'ae_yoink_run';   // tempStorage: consecutive yoink calls since the last metered one

// [v2.94.0 SLOT-YOINK-AUTO] tempStorage, not a module var: the engine is unloaded on story
// switch, and a counter that survives that would claim a run of free generations this story
// never actually made. Session-scoped is exactly the right lifetime -- losing the count is
// harmless (worst case one wasted yoink attempt that falls straight back to direct), while
// keeping a stale one is not.
async function _ceYoinkRunGet(): Promise<number> {
    try {
        const raw = await api.v1.tempStorage.getOrDefault(STORAGE_YOINK_RUN, '0') as string;
        const n = parseInt(String(raw), 10);
        return (isFinite(n) && n >= 0) ? n : 0;
    } catch (e) { return 0; }
}
async function _ceYoinkRunSet(n: number): Promise<void> {
    try { await api.v1.tempStorage.set(STORAGE_YOINK_RUN, String(Math.max(0, n))); } catch (e) {}
}

// Every metered generation resets the run, not just slot-options ones: the reset is caused
// by ANY api.v1.generate() call reaching NAI, so a story turn, a beat pass or a hook update
// frees the next run just as well. aeDiagGenerate is the single choke point all of those
// pass through, which is why the reset lives there rather than at each call site.
async function _ceYoinkRunReset(): Promise<void> { await _ceYoinkRunSet(0); }

// [v2.96.0 STUDIO-2 UNIT-C] Report the free-run state for the bridge to display. The
// counter has existed since v2.94.0 but never left the engine, so every surface that asks
// for a generation could only say "auto" -- it could not say how many more of them are
// free, which is the one number an author actually budgets against.
//
// Rides the EXISTING EVT_SLOT_OPTIONS payload (a new key, not a new message pair): the
// bridge already caches that payload's `budget` field for exactly this purpose, so the
// readout updates on the same event and cannot drift from it.
//
// `left` is derived here rather than in the bridge on purpose. AE_YOINK_RUN_MAX is an
// OBSERVED constant that is expected to be re-measured if NAI changes its metering; if the
// bridge computed max - used itself, that re-measurement would silently need a matching
// bridge release. Sending both the raw pair and the derived number costs nothing and keeps
// the arithmetic on the side that owns the constant.
async function _ceFreeRunsReport(): Promise<{ used: number; max: number; left: number }> {
    try {
        const frUsed = await _ceYoinkRunGet();
        return { used: frUsed, max: AE_YOINK_RUN_MAX, left: Math.max(0, AE_YOINK_RUN_MAX - frUsed) };
    } catch (e) {
        // Never throw into a reply path -- a missing readout is a cosmetic loss, a thrown
        // one loses the options the author just paid for.
        return { used: 0, max: AE_YOINK_RUN_MAX, left: AE_YOINK_RUN_MAX };
    }
}

function ygTimeoutRejection(ms: number): Promise<never> {
    return api.v1.timers.sleep(ms).then(function() {
        throw new Error('Yoink generation timed out after ' + Math.round(ms / 1000) + 's (encoder/generation pipeline appears stuck) \u2014 recovered automatically.');
    });
}

// Runs one attempt bounded by AE_YOINK_TIMEOUT_MS. If the timeout wins, the underlying
// attempt is NOT cancelled (NAI's api.v1 exposes no cancellation for editor.generate())
// — it may still be physically running — so we force-recover _aeYoink ourselves here
// rather than leaving that to cleanup code that may never run. Any state the abandoned
// call's own late callbacks would have touched is now guarded by continuityId (see
// hooks below), so this recovery cannot corrupt whatever call runs next.
async function ygAttemptWithWatchdog(msgs: any[], tag?: string): Promise<string> {
    try {
        return await Promise.race([executeYoinkGenerationAttempt(msgs), ygTimeoutRejection(AE_YOINK_TIMEOUT_MS)]);
    } catch (ygTimeoutErr) {
        if (_aeYoink.active) {
            api.v1.error('[AE:wizard] yoink watchdog fired (tag=' + (tag || 'untagged') + ') \u2014 force-recovering stuck generation state:', ygTimeoutErr);
            // [v1.2.0 WIZMODE] Remember this generation's id (if captured) so any late
            // output/end-event is still caught by the onResponse/onGenerationEnd zombie
            // check even after wizard mode has since exited.
            if (_aeYoink.continuityId) _wizZombieIds[_aeYoink.continuityId] = true;
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
            // [v1.2.0 WIZMODE] Don't leave a pending mode-exit blocked forever on a
            // generation that may never call back — resolve it now, bounded by this
            // same watchdog timeout.
            if (_wizModeExitPending) { aeCompleteWizardModeExit().catch(function(e) { api.v1.error('[AE:wizard] mode-exit completion after watchdog failed:', e); }); }
        }
        throw ygTimeoutErr;
    }
}

// [v2.20.0 GENDIAG] Classifies a thrown yoink error as worth one immediate same-messages
// retry. Root cause of the "Generate All From Concept Dump" report: a thrown error on the
// FIRST attempt (observed as AbortError, surfacing from NAI's own generation pipeline via
// api.v1.editor.generate() — see executeYoinkGenerationAttempt) used to skip straight past
// ALL retry logic below and fail the whole call on one transient hiccup. Excluded from
// retry: our OWN deterministic state guards (already-in-progress / editor-busy / budget-
// floor), which will reject identically on an immediate retry, and our own watchdog
// timeout, which already waited AE_YOINK_TIMEOUT_MS once — retrying blind risks doubling
// the wait for a pipeline that may be genuinely wedged. Everything else (AbortError and
// any other error NAI's pipeline can throw) is treated as transient and worth one retry.
function ygIsRetryableError(e: any): boolean {
    let msg = String((e && (e as any).message) || e || '');
    if (msg.indexOf('already in progress') >= 0) return false;
    if (msg.indexOf('Editor is busy') >= 0) return false;
    if (msg.indexOf('budget is low') >= 0) return false;
    if (msg.indexOf('timed out after') >= 0) return false;
    return true;
}

// [v1.21.0 YOINK-HARDEN, v1.22.1 YOINK-WATCHDOG, v2.20.0 GENDIAG] Orchestrates a yoink
// generation with defensive layers on top of executeYoinkGenerationAttempt, added after
// reports of the World-Build Wizard drifting into non-English output and dot-point
// formatting, batch generators silently returning zero parsed items, (v1.22.1) NAI's
// generation pipeline wedging and freezing all further generation, wizard or normal, and
// (v2.20.0) a single transient AbortError failing the whole call outright:
//
//   1. MODEL PIN (best-effort, off by default — see AE_YOINK_MODEL_PIN_ENABLED): when
//      enabled, snapshots api.v1.generationParameters, skips the update entirely if
//      already on glm-4-6 (avoids needless switching churn), pins for the duration of
//      this call, restores the snapshot in finally. The finally is now reliable even on
//      a stuck generation, because ygAttemptWithWatchdog guarantees the await it wraps
//      resolves or rejects within AE_YOINK_TIMEOUT_MS no matter what NAI's backend does.
//   2. LANGUAGE GUARD: appends an English-only instruction to the first system message,
//      once, on top of each call's existing format rules.
//   3. ERROR RETRY (new in v2.20.0): if the FIRST attempt throws (rather than returning
//      bad output), ygIsRetryableError() decides whether it's worth one same-messages
//      retry — see that function's comment. A non-retryable or twice-failing error still
//      propagates to the caller exactly as before; callers' existing catch blocks are
//      unaffected.
//   4. VALIDATE + ONE CORRECTIVE RETRY: once a response comes back (first attempt or the
//      error retry), checks the raw response against AE_NONLATIN_DRIFT_RE and the optional
//      caller-supplied validator. On failure (or an empty response), retries the SAME
//      messages once more (also watchdog-bounded) with a corrective out-of-band line
//      appended, then returns whatever that produced. Callers' existing empty/malformed-
//      output handling is unchanged.
//   5. DIAGNOSTICS (new in v2.20.0): every outcome — success, empty, or a propagated error
//      — is recorded via diagGenRecord() (tag from opts.tag, defaulting to 'untagged') so
//      it shows up in the shared ring buffer alongside the DIRECT path (aeDiagGenerate).
//      See the [DIAG GEN] block above; the viewer is the Settings surface's System tab
//      (SECTION 34).
async function executeYoinkGeneration(messages: any[], opts?: AEYoinkOptions): Promise<string> {
    let ygTag = (opts && opts.tag) || 'untagged';
    let ygT0 = Date.now();
    let ygB0o = diagBudO(), ygB0i = diagBudI();
    let ygMessages = messages.slice();
    if (ygMessages.length > 0 && ygMessages[0] && ygMessages[0].role === 'system') {
        ygMessages[0] = { role: 'system', content: String(ygMessages[0].content || '') + '\n\nRespond in English only, regardless of any other language present in the reference context.' };
    }

    let ygPrior: any = null;
    if (AE_YOINK_MODEL_PIN_ENABLED) {
        try { ygPrior = await api.v1.generationParameters.get(); }
        catch (ygGetErr) { aeLog('[AE:wizard] generationParameters.get failed, skipping model pin:', ygGetErr); }

        if (ygPrior && ygPrior.model !== 'glm-4-6') {
            try { await api.v1.generationParameters.update({ model: 'glm-4-6' }); }
            catch (ygPinErr) { aeLog('[AE:wizard] glm-4-6 pin failed, continuing on current model:', ygPinErr); ygPrior = null; }
        } else if (ygPrior) {
            ygPrior = null;   // already on glm-4-6 — nothing to restore, nothing to skip past.
        }
    }

    // [v2.140.0 STYLE2 GEN-RAIL-YOINK, per user] The generation rail was previously wired
    // ONLY to aeDiagGenerate (the direct/budgeted path). Per the user: yoink and direct are
    // used TOGETHER by design, not as alternates -- three yoink generations are available
    // between direct calls specifically to widen the effective budget -- so a silent yoink
    // is exactly the SS10 failure mode ("a silent one is the worst failure mode on the
    // surface") for a large share of real usage, not an edge case.
    // WIRED HERE, at executeYoinkGeneration, NOT at ygAttemptWithWatchdog or
    // executeYoinkGenerationAttempt: this is the one function every real caller (18 call
    // sites, grepped) goes through, and it already wraps the ERROR RETRY and CORRECTIVE
    // RETRY internally. Wiring at the attempt level would flicker the rail off between
    // retries of the SAME logical generation; wiring here shows one continuous segment for
    // one logical call, matching what the user actually asked for and did not get.
    // SAME try/finally AS THE EXISTING MODEL-PIN RESTORE, not a second try/finally around
    // it: one exit path, both cleanups guaranteed together.
    ceGenBegin();
    try {
        let ygRaw = '';
        let ygErrorRetried = false;
        try {
            ygRaw = await ygAttemptWithWatchdog(ygMessages, ygTag);
        } catch (ygFirstErr) {
            if (!ygIsRetryableError(ygFirstErr)) {
                diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
                    outcome: 'error', errorName: String((ygFirstErr && (ygFirstErr as any).name) || 'Error'),
                    errorMessage: String((ygFirstErr && (ygFirstErr as any).message) || ygFirstErr),
                    retried: false, driftDetected: false, validatorFailed: false, outLen: 0,
                    budgetOut: ygB0o, budgetIn: ygB0i });
                throw ygFirstErr;
            }
            aeLog('[AE:wizard] yoink attempt failed (' + String((ygFirstErr && (ygFirstErr as any).name) || 'Error') + ': ' + String((ygFirstErr && (ygFirstErr as any).message) || ygFirstErr) + ') \u2014 retrying once (tag=' + ygTag + ')');
            ygErrorRetried = true;
            try {
                ygRaw = await ygAttemptWithWatchdog(ygMessages, ygTag);
            } catch (ygSecondErr) {
                diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
                    outcome: 'error', errorName: String((ygSecondErr && (ygSecondErr as any).name) || 'Error'),
                    errorMessage: String((ygSecondErr && (ygSecondErr as any).message) || ygSecondErr),
                    retried: true, driftDetected: false, validatorFailed: false, outLen: 0,
                    budgetOut: ygB0o, budgetIn: ygB0i });
                throw ygSecondErr;
            }
        }

        let ygEmpty = !ygRaw || !ygRaw.trim();
        let ygDrift = !ygEmpty && AE_NONLATIN_DRIFT_RE.test(ygRaw);
        let ygInvalid = !ygEmpty && !!(opts && opts.validator) && !opts.validator(ygRaw);
        let ygCorrectiveRetried = false;
        if (ygEmpty || ygDrift || ygInvalid) {
            ygCorrectiveRetried = true;
            let ygRetryMessages = ygMessages.slice();
            ygRetryMessages.push({ role: 'user', content: '[Your previous response broke format or used non-English text. Respond in English only, in plain prose, with no bullet points, lists, or markdown. Follow the FORMAT above exactly.]' });
            try {
                let ygRetryRaw = await ygAttemptWithWatchdog(ygRetryMessages, ygTag);
                if (ygRetryRaw && ygRetryRaw.trim()) ygRaw = ygRetryRaw;
            } catch (ygRetryErr) {
                aeLog('[AE:wizard] corrective retry failed, keeping first-attempt output:', ygRetryErr);
            }
        }
        diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
            outcome: (ygRaw && ygRaw.trim()) ? 'ok' : 'empty', errorName: '', errorMessage: '',
            retried: ygErrorRetried || ygCorrectiveRetried, driftDetected: ygDrift, validatorFailed: ygInvalid,
            outLen: (ygRaw || '').length, budgetOut: ygB0o, budgetIn: ygB0i });
        return ygRaw;
    } finally {
        ceGenEnd();
        if (ygPrior) {
            let ygRestore: any = { model: ygPrior.model };
            if (ygPrior.max_tokens !== undefined) ygRestore.max_tokens = ygPrior.max_tokens;
            if (ygPrior.temperature !== undefined) ygRestore.temperature = ygPrior.temperature;
            if (ygPrior.top_p !== undefined) ygRestore.top_p = ygPrior.top_p;
            if (ygPrior.top_k !== undefined) ygRestore.top_k = ygPrior.top_k;
            if (ygPrior.frequency_penalty !== undefined) ygRestore.frequency_penalty = ygPrior.frequency_penalty;
            if (ygPrior.presence_penalty !== undefined) ygRestore.presence_penalty = ygPrior.presence_penalty;
            if (ygPrior.min_p !== undefined) ygRestore.min_p = ygPrior.min_p;
            try { await api.v1.generationParameters.update(ygRestore); }
            catch (ygRestoreErr) { api.v1.error('[AE:wizard] failed to restore generation params after yoink pin:', ygRestoreErr); }
        }
    }
}
// ============================================================================
// SECTION 3i — SCRIPT-LEVEL STATE VARIABLES
// The actual module-level mutable state: broadcast in-flight/pending
// latches, bridge-ready flag, debounce handles, modal handles, caches.
// ============================================================================

var ae_sbcInFlight = false;  // [v0.9.36] a scene-state broadcast is running
var ae_sbcPending  = false;  // [v0.9.36] another scene-state broadcast was requested while one ran
var ae_cdbInFlight = false;  // [v0.9.36] a character-data broadcast is running
var ae_cdbPending  = false;  // [v0.9.36] another character-data broadcast was requested while one ran
var ae_pendingGenerate = false; // [v0.9.37] a move effect requested generation; the top-level handler fires it once after ALL effects

// ── Bridge Communication State ────────────────────────────────────────────────
// isBridgeReady: set true after first successful EVT_HANDSHAKE_ACK.
// engineScriptId is not stored here (this IS the engine); the bridge stores it.
var isBridgeReady = false;

// Debounce timers for broadcast functions (Section 18).
// Both functions are called frequently (on every save); debouncing prevents storms.
var _charDataBroadcastTimeout: any = null;

// ── Character Visual Cache ────────────────────────────────────────────────────
// [CHANGE] Renamed from cachedCharConfigs (bridge roster data) to cachedCharVisuals
// (engine character visual fields). Now populated TWO ways:
//   1. On init: seeded from storyStorage so the HUD has data before the bridge connects.
//   2. On EVT_CHAR_SYNC_PUSH: bridge can push overrides (kept for legacy compat).
// getCharacterData() reads from this cache. Bridge reads it via EVT_CHAR_DATA_SYNC.
var cachedCharVisuals: CharacterVisualRecord[] = [];

// ── Image Settings State ──────────────────────────────────────────────────────
// Loaded from api.v1.storage (global, not story-bound) by loadImageSettings().
var imagePromptFields: ImagePromptField[] = [];
var globalSettings: GlobalImageSettings = {
    autoDownload: false,
    // [v2.175.0 STORYIMG-DEFAULT-ON, per user: "still no indicator for image generation
    // that persists until success or timeout"] THE INDICATOR ALREADY EXISTED AND THIS
    // FLAG WAS SWITCHING IT OFF. STORYIMG's pending placeholder -- the anchor pinned at
    // Generate time that the bridge paints a spinner into until the bytes land, and that
    // stays standing (deletable) if they never do -- is gated entirely on this. Default
    // false meant the mechanism shipped and never ran for anybody.
    studioPlaceInStory: true,
    contextSize: DEFAULT_CTX,
    architectPrompt: DEFAULT_ARCH,
    architectAutoSnap: true
};

// ── NAI Sidebar Modal Handles ─────────────────────────────────────────────────
// Handles for the NAI-side modal windows (GM authoring tools).
// Each is set when a modal opens and nulled when it closes.

// ============================================================================
// SECTION 4 — UTILITY FUNCTIONS
// Pure helpers and factory functions with no side effects.
// These are called throughout the script and must be defined before first use.
// ============================================================================


// ── ID Generation ─────────────────────────────────────────────────────────────

function generateId(): string {
    // Generates a collision-resistant ID from timestamp + random suffix.
    // Used for all new records (characters, entities, rules, milestones, etc.).
    return Date.now().toString(36) + Math.random().toString(36).substring(2);
}

// [v1.6.3 ICON-LIB] The entity `icon` field is free text shared by the engine and the bridge.
// The bridge can resolve a bare library name (e.g. "crown") to an SVG glyph; the engine's
// native labels can't, and would render the literal word ("crown Cave"). aeIconPfx returns a
// label prefix ONLY for glyph icons (emoji / non-ASCII symbols), suppressing bare ASCII
// library-name icons so native labels stay clean while the bridge shows the SVG. Returns the
// icon plus a trailing space, or '' when there is no glyph to show.
function aeIconPfx(icon?: string): string {
    if (!icon) return '';
    let s = String(icon).trim();
    if (!s) return '';
    // A library name is plain ASCII word characters (letters/digits/underscore/hyphen). Any
    // codepoint outside ASCII (emoji, arrows, symbols) marks a real glyph and is kept.
    let isBareName = /^[A-Za-z0-9_-]+$/.test(s);
    return isBareName ? '' : (s + ' ');
}

// ── World-Build Wizard: assemble + commit the Memory block ───────────────────
// [vNEXT] Assembles enabled, non-blank, memory-targeted sections into the static
// Memory block ("[ Label ]\n<content>", blank-separated) and returns it. Style and
// any other 'an'-targeted sections are NOT included here — they commit separately.
function assembleWizardMemory(sections: WizardMemorySection[]): string {
    let blocks: string[] = [];
    for (let s of (sections || [])) {
        if (!s || s.target !== 'memory') continue;
        if (!s.enabled) continue;
        let body = (s.content || '').trim();
        if (!body) continue;
        blocks.push('[ ' + s.label + ' ]\n' + body);
    }
    return blocks.join('\n\n');
}

// [vNEXT] Assembles 'an'-targeted sections (e.g. Style) into an Author's Note body.
function assembleWizardAuthorNote(sections: WizardMemorySection[]): string {
    let blocks: string[] = [];
    for (let s of (sections || [])) {
        if (!s || s.target !== 'an') continue;
        if (!s.enabled) continue;
        let body = (s.content || '').trim();
        if (!body) continue;
        // [v2.19.0 WIZARD-2.0] If the body is already a complete bracketed AN block
        // (e.g. a generated ATTG line "[ Author: ...; Genre: ... ]"), emit it verbatim;
        // otherwise wrap it as a labelled "[ Label: body ]" block (the Style default).
        if (body.charAt(0) === '[' && body.charAt(body.length - 1) === ']') {
            blocks.push(body);
        } else {
            blocks.push('[ ' + s.label + ': ' + body + ' ]');
        }
    }
    return blocks.join('\n\n');
}

// [v0.9.7.3 AN-FIX] Commits the assembled wizard sections to the real NAI surfaces.
// Memory sections OVERWRITE the Memory field (static world canon — stable, written once).
// AN sections (Style, etc.) are written into a NAMED REGION of the Author's Note using
// AE_WIZ_AN_SENTINEL so they coexist with the scene-state block injected at generation
// time by onBeforeContextBuild. The scene block is NEVER stored in the persisted AN —
// it is appended ephemerally per-generation. The wizard region always sits FIRST in the
// persisted AN; the scene block is appended AFTER it at generation time so it has the
// highest recency weight in the AN slot.
async function commitWizardMemory(cfg: GlobalConfig): Promise<boolean> {
    try {
        let mem = assembleWizardMemory(cfg.wizardSections || []);
        await api.v1.memory.set(mem);

        let wizAN = assembleWizardAuthorNote(cfg.wizardSections || []);

        // Read the current persisted AN and strip both managed regions before rewriting.
        // Safe to call repeatedly (idempotent). Strip scene sentinel first (defensive),
        // then strip any prior wizard region.
        let existingAN = '';
        try { existingAN = (await api.v1.an.get()) || ''; } catch (_eRead) {}

        // Strip stale scene block (defensive — should never be persisted).
        let sceneMarker = '\n\n' + AE_AN_SENTINEL;
        let sceneIdx = existingAN.lastIndexOf(sceneMarker);
        if (sceneIdx >= 0) {
            existingAN = existingAN.substring(0, sceneIdx);
        } else if (existingAN.indexOf(AE_AN_SENTINEL) === 0) {
            existingAN = '';
        }
        existingAN = existingAN.replace(/\s+$/, '');

        // Strip any prior wizard region.
        let wizMarker = '\n\n' + AE_WIZ_AN_SENTINEL;
        let wizIdx = existingAN.lastIndexOf(wizMarker);
        if (wizIdx >= 0) {
            existingAN = existingAN.substring(0, wizIdx);
        } else if (existingAN.indexOf(AE_WIZ_AN_SENTINEL) === 0) {
            existingAN = '';
        }
        existingAN = existingAN.replace(/\s+$/, '');

        // Re-assemble: any non-AE base content + wizard region (if any AN sections enabled).
        let finalAN: string;
        if (wizAN.trim()) {
            let wizRegion = AE_WIZ_AN_SENTINEL + '\n' + wizAN.trim();
            finalAN = existingAN ? (existingAN + '\n\n' + wizRegion) : wizRegion;
        } else {
            finalAN = existingAN;
        }

        await api.v1.an.set(finalAN);
        return true;
    } catch (e) {
        api.v1.error('[AE:wizard] commitWizardMemory error:', e);
        return false;
    }
}

// ── World-Build Wizard: context assembly ─────────────────────────────────────
// [vNEXT] Builds the read-only context preamble for a wizard chat from its selected
// sources: project concept fields, other wizard chats, lorebook entries, and recent
// story text. Each source is clearly delimited so the model treats it as reference.
// ── World-Build Wizard: token budget + transcript distillation (v1.23.0) ─────
// Until now buildWizardContext concatenated every linked chat's FULL raw transcript with
// no cap of any kind. That is invisible on a 28k-context account and fatal on a 12k one:
// a few long brainstorm chats linked as context sources can exceed the whole window, and
// NAI's handling of an oversized messages[] override is undocumented. Since almost every
// yoink call is [system, user] with ALL formatting rules living in the system message,
// losing the front of that array would strip the rules and produce exactly the
// ungoverned, malformed output this subsystem has been chasing.
//
// Two defences, applied together:
//   1. DISTILL — a linked chat contributes settled facts, not its deliberation. Cached on
//      the chat record; regenerated only when the chat grows.
//   2. CAP — measure the assembled blocks with the real tokenizer against the account's
//      real ceiling (api.v1.maxTokens is subscription-tier aware, so no tier is hardcoded)
//      and drop whole low-priority blocks until it fits.

// Reserve for the persona + format rules that ride in the system message alongside ctx.
var AE_CTX_RESERVE_INSTRUCTIONS = 2000;
// Reserve for the model's own output.
var AE_CTX_RESERVE_OUTPUT = 1200;
// Never hand back a budget smaller than this; below it, context is useless anyway.
var AE_CTX_MIN_BUDGET = 800;
// Chats shorter than this stay raw: distilling 3 messages costs a generation and saves
// nothing, and a short exchange is already close to "just the facts".
var AE_DISTILL_MIN_MESSAGES = 6;

// Which model's tokenizer/ceiling applies. editor.generate() runs on the story's live
// model, so ask generationParameters rather than assuming.
async function wizActiveModel(): Promise<string> {
    try {
        let gp = await api.v1.generationParameters.get();
        if (gp && gp.model) return String(gp.model);
    } catch (eModel) { aeLog('[AE:wizard] could not read active model, assuming glm-4-6:', eModel); }
    return 'glm-4-6';
}

// Real token count, with a coarse chars/4 fallback if the tokenizer is unavailable.
async function wizCountTokens(text: string, model: string): Promise<number> {
    let t = String(text || '');
    if (!t) return 0;
    try {
        let ids = await api.v1.tokenizer.encode(t, model);
        if (ids && typeof ids.length === 'number') return ids.length;
    } catch (eTok) { aeLog('[AE:wizard] tokenizer.encode failed, estimating:', eTok); }
    return Math.ceil(t.length / 4);
}

// Context tokens available for reference material, after instructions, output, and (for a
// live chat turn) the transcript that will be replayed alongside it.
async function wizContextBudget(model: string, ownMessagesTokens: number): Promise<number> {
    let ceiling = 0;
    try { ceiling = await api.v1.maxTokens(model); }
    catch (eMax) { aeLog('[AE:wizard] maxTokens unavailable, skipping context cap:', eMax); return 0; }
    if (!ceiling || ceiling <= 0) return 0;
    let budget = ceiling - AE_CTX_RESERVE_INSTRUCTIONS - AE_CTX_RESERVE_OUTPUT - (ownMessagesTokens || 0);
    if (budget < AE_CTX_MIN_BUDGET) budget = AE_CTX_MIN_BUDGET;
    return budget;
}

// A context block with a drop priority. Higher survives longer.
interface WizCtxBlock {
    text: string;
    priority: number;
    label: string;
}

// [v1.23.0] Trim whole blocks (never mid-block) until the total fits the budget. Drops
// the LOWEST priority first, and among equal priorities the LAST added first, so the
// project header and the earliest-linked chats survive longest. A budget of 0 means the
// ceiling could not be determined — in that case nothing is trimmed, matching pre-v1.23.0
// behaviour rather than guessing.
async function wizTrimBlocksToBudget(blocks: WizCtxBlock[], budget: number, model: string): Promise<{ kept: WizCtxBlock[]; dropped: string[]; tokens: number }> {
    let kept = blocks.slice();
    let dropped: string[] = [];
    if (!budget || budget <= 0) {
        let rawTotal = 0;
        for (let b of kept) rawTotal += await wizCountTokens(b.text, model);
        return { kept: kept, dropped: dropped, tokens: rawTotal };
    }

    let counts: number[] = [];
    for (let b of kept) counts.push(await wizCountTokens(b.text, model));
    let total = 0;
    for (let n of counts) total += n;

    while (total > budget && kept.length > 0) {
        // Find the drop candidate: lowest priority, latest index among ties.
        let victim = -1;
        for (let i = 0; i < kept.length; i++) {
            if (victim < 0) { victim = i; continue; }
            if (kept[i].priority < kept[victim].priority) victim = i;
            else if (kept[i].priority === kept[victim].priority) victim = i;
        }
        if (victim < 0) break;
        // The project header is priority 100 and must never be the last thing standing
        // that gets dropped; if only it remains, stop and accept the overage.
        if (kept.length === 1 || kept[victim].priority >= 100) break;
        total -= counts[victim];
        dropped.push(kept[victim].label);
        kept.splice(victim, 1);
        counts.splice(victim, 1);
    }

    return { kept: kept, dropped: dropped, tokens: total };
}

// [v1.23.0 DISTILL] Turn a chat transcript into declarative world facts. Reframed rather
// than merely constrained: the model is recording current world state, not summarizing a
// conversation. The contrastive pair targets SURFACE FORM (how a sentence is phrased),
// which is safe to name explicitly — unlike naming unwanted story CONCEPTS, which risks
// priming them. Abandoned ideas are simply absent from the output.
var AE_DISTILL_SYSTEM = [
    'You are recording the current state of a story world as established so far. You are not summarizing a conversation.',
    'Write only settled facts, in the present tense, as plain declarative prose. State each fact as though it has always been true of this world.',
    'Where a point was revised, record only the version that stands now.',
    'WRONG: "After some back-and-forth, they settled on a near-future dystopia."',
    'RIGHT: "The setting is a near-future dystopia where the water supply is privately owned."',
    'WRONG: "One idea raised was a rival guild, though it was set aside."',
    'RIGHT: (omit it entirely)',
    'Preserve every proper name, number, and concrete detail that still stands. Write in English. Use plain prose with no markdown, bullet points, headers, or numbering.',
    'Output only the world facts. No preamble, no commentary.'
].join('\n\n');

// Distill one chat, caching on the record. Returns notes text, or '' if distillation is
// unavailable — callers fall back to the raw transcript rather than losing the context.
// NOTE: this itself runs a yoink generation, so it must only ever be called BEFORE the
// caller starts its own yoink (buildWizardContext always runs first — see callers).
// allowGenerate=false returns only an existing cache and never generates, which is what
// the read-only context preview needs: pressing Preview must not spend a generation.
async function getWizardChatNotes(chat: WizardChat, allowGenerate: boolean): Promise<string> {
    if (!chat || !chat.messages || !chat.messages.length) return '';
    let msgCount = chat.messages.length;
    if (msgCount < AE_DISTILL_MIN_MESSAGES) return '';   // short chat: caller uses raw

    let cache = chat.notesCache;
    if (cache && cache.sourceMsgCount === msgCount && (cache.text || '').trim()) return cache.text;
    if (!allowGenerate) return '';   // stale or absent cache, and we may not generate

    let transcript = chat.messages.map(function(m) { return '[' + m.role.toUpperCase() + '] ' + m.content; }).join('\n');
    let notes = '';
    try {
        notes = await executeYoinkGeneration([
            { role: 'system', content: AE_DISTILL_SYSTEM },
            { role: 'user', content: transcript + '\n\nRecord the world facts established above.' }
        ], { tag: 'wizChatDistill:' + (chat.title || chat.id) });
    } catch (eDistill) {
        api.v1.error('[AE:wizard] distillation failed for chat "' + chat.title + '", falling back to raw transcript:', eDistill);
        return '';
    }
    notes = (notes || '').trim();
    if (!notes) return '';

    let fresh = await loadWizardChat(chat.id);
    if (fresh) {
        fresh.notesCache = { text: notes, sourceMsgCount: msgCount, updatedAt: Date.now() };
        await saveWizardChat(fresh);
    }
    return notes;
}

// [v1.23.0] allowDistill=false makes this a pure read (no generation), for the preview.
// The returned string is the same one the generator will receive.
async function buildWizardContext(chat: WizardChat, cfg: GlobalConfig, allowDistill?: boolean): Promise<string> {
    let res = await buildWizardContextDetailed(chat, cfg, allowDistill !== false);
    return res.text;
}

// [v1.23.0] Assembles the context as priority-tagged blocks, distills linked chats, then
// trims to the account's real token ceiling. Returns the joined text plus what was cut,
// so the preview can show it and the user can see WHY something is missing.
async function buildWizardContextDetailed(chat: WizardChat, cfg: GlobalConfig, allowDistill: boolean): Promise<{ text: string; dropped: string[]; tokens: number; budget: number; model: string }> {
    let blocks: WizCtxBlock[] = [];

    let pName = (cfg.projectName || '').trim();
    let pGenre = (cfg.projectGenre || '').trim();
    let pConcept = (cfg.projectConcept || '').trim();
    if (pName || pGenre || pConcept) {
        let head: string[] = [];
        if (pName)    head.push('Project: ' + pName);
        if (pGenre)   head.push('Genre: ' + pGenre);
        if (pConcept) head.push('Concept: ' + pConcept);
        blocks.push({ text: '--- PROJECT ---\n' + head.join('\n'), priority: 100, label: 'Project header' });
    }

    // [v1.23.0] Linked chats contribute their SETTLED FACTS, not their deliberation.
    // Falling back to the raw transcript when distillation is unavailable keeps the old
    // behaviour rather than silently dropping the chat entirely.
    let ctxIds = chat.contextChatIds || [];
    if (ctxIds.length > 0) {
        let allChats = await loadWizardChats();
        for (let cid of ctxIds) {
            let oc = allChats.find(function(c) { return c.id === cid; });
            if (!oc || !oc.messages || oc.messages.length === 0) continue;
            let notes = await getWizardChatNotes(oc, allowDistill);
            if (notes) {
                blocks.push({ text: '--- WORLD FACTS FROM: ' + oc.title + ' ---\n' + notes, priority: 80, label: 'Chat notes: ' + oc.title });
            } else {
                let transcript = oc.messages.map(function(m) { return '[' + m.role.toUpperCase() + '] ' + m.content; }).join('\n');
                blocks.push({ text: '--- CHAT: ' + oc.title + ' ---\n' + transcript, priority: 80, label: 'Chat transcript: ' + oc.title });
            }
        }
    }

    let loreIds = chat.lorebookEntryIds || [];
    for (let lid of loreIds) {
        try {
            let entry = await api.v1.lorebook.entry(lid);
            if (entry && entry.text && entry.text.trim()) {
                let lname = (entry as any).displayName || (entry as any).name || 'Lorebook Entry';
                blocks.push({ text: '--- LOREBOOK: ' + lname + ' ---\n' + entry.text.trim(), priority: 50, label: 'Lorebook: ' + lname });
            }
        } catch (e) { aeLog('[AE:wizard] lorebook context read failed for ' + lid); }
    }

    // [v0.9.99] Per-chat character context — the chat decides, independent of each
    // character's global charContextEnabled flag. Formatted straight from the record.
    let charCtxIds = chat.characterIds || [];
    for (let chCid of charCtxIds) {
        try {
            let cc = await loadCharacter(chCid);
            if (!cc) continue;
            let ccLines: string[] = [];
            if (cc.briefDescription) ccLines.push(cc.briefDescription);
            if (cc.species || cc.age || cc.gender || cc.occupationRole) ccLines.push([cc.species, cc.age, cc.gender, cc.occupationRole].filter(Boolean).join(', '));
            if (cc.personalityCore) ccLines.push('Personality: ' + cc.personalityCore);
            if (cc.background) ccLines.push('Background: ' + cc.background);
            if (ccLines.length) blocks.push({ text: '--- CHARACTER: ' + cc.name + ' ---\n' + ccLines.join('\n'), priority: 60, label: 'Character: ' + cc.name });
        } catch (eCc) { aeLog('[AE:wizard] character context read failed for ' + chCid); }
    }

    if (chat.includeStory) {
        let story = await getRecentStoryText(2000);
        if (story.trim()) blocks.push({ text: '--- RECENT STORY ---\n' + story.trim(), priority: 10, label: 'Recent story' });
    }

    // Cap against the account's REAL ceiling. maxTokens() is subscription-tier aware, so a
    // 12k Scroll account trims where a 28k account does not, with no tier hardcoded here.
    let model = await wizActiveModel();
    // One encode call, not one per message: this is only a reserve, and the transcript is
    // trimmed properly (per-message) by runWizardChatTurn.
    let ownJoined = (chat.messages || []).map(function(m) { return m.content; }).join('\n');
    let ownTokens = ownJoined ? await wizCountTokens(ownJoined, model) : 0;
    let budget = await wizContextBudget(model, ownTokens);
    let trimmed = await wizTrimBlocksToBudget(blocks, budget, model);

    if (trimmed.dropped.length) {
        aeLog('[AE:wizard] context over budget (' + budget + ' tok); dropped: ' + trimmed.dropped.join(', '));
    }

    return {
        text: trimmed.kept.map(function(b) { return b.text; }).join('\n\n'),
        dropped: trimmed.dropped,
        tokens: trimmed.tokens,
        budget: budget,
        model: model
    };
}

// ── World-Build Wizard: chat turn (yoink) ────────────────────────────────────
// [vNEXT] Appends the user's message, runs a budget-free yoink generation against
// the topic persona + assembled context + transcript, appends the assistant reply,
// and persists the chat. Returns the assistant text (or null on failure).
async function runWizardChatTurn(chatId: string, userText: string): Promise<string | null> {
    let cfg = await loadConfig();
    let chat = await loadWizardChat(chatId);
    if (!chat) return null;
    // [DIAG] Budget diagnostics via typed commands — engine-only. /budgetlog spends no budget.
    let _diagCmd = (userText || '').trim().toLowerCase();
    if (AE_DIAG_BUDGET && (_diagCmd === '/budgetprobe' || _diagCmd === '/budgetlog')) {
        let _diagOut = _diagCmd === '/budgetprobe' ? await runBudgetProbe() : dumpBudgetLog();
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _diagOut });
        await saveWizardChat(chat);
        return _diagOut;
    }
    // [v2.20.0 GENDIAG] /gendiag dumps the shared yoink+direct generation-call log (see
    // the [DIAG GEN] block near the top of the file); /gendiagclear resets it. Spends no
    // budget — pure in-memory ring buffer read/reset, same convention as /budgetlog.
    if (AE_DIAG_GEN && (_diagCmd === '/gendiag' || _diagCmd === '/gendiagclear')) {
        let _genDiagOut = _diagCmd === '/gendiagclear' ? (clearGenDiagLog(), 'Generation diagnostics log cleared.') : dumpGenDiagLog();
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _genDiagOut });
        await saveWizardChat(chat);
        return _genDiagOut;
    }
    // [DIAG v2.66.0 DIAG-CMD-SHARED] /log and /diag now live in aeHandleDiagCommand
    // (SECTION 3) so they're reachable from BOTH this modal wizard chat AND the new
    // AE_DIAG_CMD bridge message (SECTION 18) — see that function's header comment
    // for why a chat-turn-only command surface was the wrong call.
    let _sharedDiagOut = await aeHandleDiagCommand(userText.trim(), _diagCmd);
    if (_sharedDiagOut !== null) {
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _sharedDiagOut });
        await saveWizardChat(chat);
        return _sharedDiagOut;
    }
    let topic = getWizardTopic(cfg, chat.topicId);
    let persona = topic ? topic.instructions : 'You are a helpful worldbuilding assistant. Keep replies short and conversational.';

    if (userText && userText.trim()) {
        chat.messages.push({ role: 'user', content: userText.trim() });
    }

    // [v1.2.0 WIZMODE] While mode is on, assemble the source context ONCE per chat and
    // reuse it — only the transcript (appended below) grows per turn. Recomputed fresh
    // the first time a chat is used after mode turns on; cleared entirely on mode exit
    // and whenever this chat's context selection changes (AE_WIZ_SET_CHAT_CONTEXT).
    let ctx: string;
    if (_aeWizardMode && _wizFrozenCtx[chatId] !== undefined) {
        ctx = _wizFrozenCtx[chatId];
    } else {
        ctx = await buildWizardContext(chat, cfg);
        if (_aeWizardMode) _wizFrozenCtx[chatId] = ctx;
    }
    let sysParts: string[] = [persona];
    if (ctx.trim()) {
        sysParts.push('The following is READ-ONLY reference context. Use it to inform your replies, but do not quote it back verbatim.\n\n' + ctx);
    }

    let msgs: any[] = [{ role: 'system', content: sysParts.join('\n\n') }];

    // [v1.23.0] The transcript is replayed in full on every turn and grows without bound.
    // On a 12k-context account a long chat can push the system message (which carries the
    // topic persona and all formatting rules) out of the window. Keep the seed message —
    // it frames the whole topic — plus as many of the MOST RECENT turns as fit, dropping
    // from the middle. buildWizardContext has already trimmed ctx against the same ceiling.
    let turnModel = await wizActiveModel();
    let ctxTokens = await wizCountTokens(sysParts.join('\n\n'), turnModel);
    let turnCeiling = 0;
    try { turnCeiling = await api.v1.maxTokens(turnModel); }
    catch (eTurnMax) { aeLog('[AE:wizard] maxTokens unavailable, replaying full transcript:', eTurnMax); }

    let history = chat.messages.slice();
    if (turnCeiling > 0) {
        let transcriptBudget = turnCeiling - ctxTokens - AE_CTX_RESERVE_OUTPUT;
        if (transcriptBudget < AE_CTX_MIN_BUDGET) transcriptBudget = AE_CTX_MIN_BUDGET;

        // Cheap chars/4 estimate first. Only pay for per-message tokenization when we are
        // plausibly near the ceiling, so a normal-length chat costs zero extra encode calls.
        let roughChars = 0;
        for (let rm of history) roughChars += (rm.content || '').length;
        let roughTokens = Math.ceil(roughChars / 4);

        if (roughTokens > transcriptBudget * 0.8) {
            let seed = (history.length > 0 && history[0].role === 'assistant') ? history[0] : null;
            let rest = seed ? history.slice(1) : history.slice();
            let seedTokens = seed ? await wizCountTokens(seed.content, turnModel) : 0;

            let keptRev: WizardChatMessage[] = [];
            let used = seedTokens;
            for (let i = rest.length - 1; i >= 0; i--) {
                let mt = await wizCountTokens(rest[i].content, turnModel);
                if (used + mt > transcriptBudget && keptRev.length > 0) break;
                used += mt;
                keptRev.push(rest[i]);
            }
            keptRev.reverse();
            let trimmedCount = rest.length - keptRev.length;
            history = seed ? [seed].concat(keptRev) : keptRev;
            if (trimmedCount > 0) aeLog('[AE:wizard] transcript over budget; dropped ' + trimmedCount + ' older message(s) from the middle.');
        }
    }

    for (let m of history) {
        msgs.push({ role: m.role, content: m.content });
    }

    let reply = '';
    try {
        reply = await executeYoinkGeneration(msgs, { tag: 'wizChatTurn:' + (chat.title || chatId) });
    } catch (e) {
        api.v1.error('[AE:wizard] chat turn generation failed:', e);
        return null;
    }
    reply = (reply || '').trim();
    if (!reply) return null;

    chat.messages.push({ role: 'assistant', content: reply });
    await saveWizardChat(chat);
    return reply;
}

// ── World-Build Wizard: per-section generation (yoink) ───────────────────────
// [vNEXT] Generates ONE memory section's content from a chat transcript, scoped hard
// to that section's instructions so sections never bleed into each other. Already-
// written sections are passed as read-only context to avoid overlap. Returns the
// generated text (or null on failure).
async function generateWizardSection(section: WizardMemorySection, ctx: string, cfg: GlobalConfig, priorSections: WizardMemorySection[], hint?: string): Promise<string | null> {
    let sys = [
        'You are writing the "' + section.label + '" section of a story\'s static world canon.',
        section.instructions,
        'CONSTRAINT: Write ONLY the content of this section. Do not restate this section\'s name as a heading before the content. Do not write any other section\'s content. Be concise and concrete.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, italics, or bullet points. Output plain text only.'
    ].join('\n\n');

    let priorLines: string[] = [];
    for (let ps of (priorSections || [])) {
        if (ps.id === section.id) continue;
        let body = (ps.content || '').trim();
        if (body) priorLines.push('[' + ps.label + '] ' + body);
    }

    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    if (priorLines.length > 0) usrParts.push('--- ALREADY-WRITTEN SECTIONS (do not repeat these; stay in your own scope) ---\n' + priorLines.join('\n'));
    if (hint && hint.trim()) usrParts.push('--- EXTRA GUIDANCE FOR THIS REGENERATION ---\n' + hint.trim());
    usrParts.push('Now write the "' + section.label + '" section.');

    let msgs: any[] = [
        { role: 'system', content: sys },
        { role: 'user', content: usrParts.join('\n\n') }
    ];

    let result = '';
    try {
        result = await executeYoinkGeneration(msgs, { tag: 'wizSection:' + section.label });
    } catch (e) {
        api.v1.error('[AE:wizard] section generation failed (' + section.label + '):', e);
        return null;
    }
    return (result || '').trim() || null;
}

// [v2.11.0] Regenerate ONE section in place (does not commit memory). sourceChatIds
// mirrors the multi-source context model every other generator tab uses (Species/
// Factions/etc via buildWizardMultiContext) — was single-chat-only before, which also
// meant the bridge's AE_WIZ_REGEN_ENTITY handler was silently truncating its own
// already-array-shaped sourceChatIds payload down to just the first id. Writes the
// result into cfg.wizardSections.
async function regenerateWizardSection(sectionId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let section = (cfg.wizardSections || []).find(function(s) { return s.id === sectionId; });
    if (!section) return null;
    let ctx = await buildWizardMultiContext(sourceChatIds || [], cfg);
    let prior = cfg.wizardSections || [];
    let gen = await generateWizardSection(section, ctx, cfg, prior, hint);
    if (!gen) return null;
    await mutConfig(function(c) {
        let target = (c.wizardSections || []).find(function(s) { return s.id === sectionId; });
        if (target) target.content = gen;
    });
    return gen;
}

// [v0.9.81] Build wizard context from MULTIPLE source chats (multi-select). Constructs a
// synthetic chat whose contextChatIds are the selected chats, so buildWizardContext pulls
// each selected chat's transcript (as a "--- CHAT: title ---" block) plus the project header.
// includeStory is on if ANY selected chat has it; selected chats' lorebook links are unioned.
// [v1.23.0] allowDistill=false makes this a pure read (used by the context preview).
async function buildWizardMultiContext(chatIds: string[], cfg: GlobalConfig, allowDistill?: boolean): Promise<string> {
    let res = await buildWizardMultiContextDetailed(chatIds, cfg, allowDistill !== false);
    return res.text;
}

async function buildWizardMultiContextDetailed(chatIds: string[], cfg: GlobalConfig, allowDistill: boolean): Promise<{ text: string; dropped: string[]; tokens: number; budget: number; model: string }> {
    let selIds = (chatIds || []).filter(Boolean);
    let allMultiChats = await loadWizardChats();
    let anyMultiStory = false;
    let unionLore: string[] = [];
    // [v2.6.0] Ids that resolve to NEITHER a classic chat NOR (checked below) fall through
    // to a direct lorebook-entry read — this is how a CE Chats entry (or any other saved
    // lorebook source a generator tab lets the user check) becomes generator context with
    // no owning classic-chat record required.
    let directLoreBlocks: WizCtxBlock[] = [];
    for (let sid of selIds) {
        let sc = allMultiChats.find(function(c) { return c.id === sid; });
        if (sc) {
            if (sc.includeStory) anyMultiStory = true;
            for (let lid of (sc.lorebookEntryIds || [])) { if (unionLore.indexOf(lid) < 0) unionLore.push(lid); }
            continue;
        }
        try {
            let le = await api.v1.lorebook.entry(sid);
            if (le && le.text && le.text.trim()) {
                let leName = (le as any).displayName || 'Saved Chat';
                directLoreBlocks.push({ text: '--- SAVED CHAT: ' + leName + ' ---\n' + le.text.trim(), priority: 80, label: 'Saved chat: ' + leName });
            }
        } catch (eLoreDirect) { aeLog('[AE:wizard] direct lorebook source read failed for ' + sid); }
    }
    let classicIds = selIds.filter(function(id) { return allMultiChats.some(function(c) { return c.id === id; }); });
    let synthChat: WizardChat = { id: 'transient', topicId: '', title: '', messages: [], contextChatIds: classicIds, includeStory: anyMultiStory, lorebookEntryIds: unionLore, createdAt: 0, updatedAt: 0 };
    let base = await buildWizardContextDetailed(synthChat, cfg, allowDistill);
    if (directLoreBlocks.length === 0) return base;
    // Splice the directly-selected lorebook sources in alongside the already-assembled
    // (already-budgeted) base text, then re-trim the combination to the same ceiling.
    let combined: WizCtxBlock[] = directLoreBlocks.concat([{ text: base.text, priority: 70, label: 'Chat/project context' }]);
    let trimmed2 = await wizTrimBlocksToBudget(combined, base.budget, base.model);
    return {
        text: trimmed2.kept.map(function(b) { return b.text; }).join('\n\n'),
        dropped: base.dropped.concat(trimmed2.dropped),
        tokens: trimmed2.tokens,
        budget: base.budget,
        model: base.model
    };
}

// [v1.22.0 PREVIEW] Return the exact reference context a batch generation for these
// source chats would receive, plus a short header describing what is (and is not)
// present. Read-only: no generation, no storage writes, no side effects.
//
// This exists because buildWizardContext's output was previously invisible. When a
// generation comes back empty or malformed, the first question is "was any context
// actually attached?" — and neither the user nor the author could answer it. An empty
// preview is now self-evident.
async function buildWizardContextPreview(sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let res: { text: string; dropped: string[]; tokens: number; budget: number; model: string };
    try {
        // allowDistill=false: pressing Preview must never spend a generation.
        res = await buildWizardMultiContextDetailed(sourceChatIds || [], cfg, false);
    } catch (ePrev) {
        api.v1.error('[AE:wizard] context preview build failed:', ePrev);
        return 'Context preview failed to build. See the script log for details.';
    }
    let body = (res.text || '').trim();
    if (!body) {
        return 'NO CONTEXT ATTACHED.\n\nGeneration will run on the topic instructions alone, with nothing about your world.\n\nTo fix: set a project name/genre/concept in the Setup tab, or check one or more context-source chats above.';
    }

    let headLines: string[] = [];
    headLines.push('--- CONTEXT PREVIEW ---');
    headLines.push('This is the reference context the generator will receive, verbatim.');
    headLines.push('Model: ' + res.model);
    if (res.budget > 0) {
        let pct = Math.round((res.tokens / res.budget) * 100);
        headLines.push('Size: ' + res.tokens + ' of ' + res.budget + ' available context tokens (' + pct + '%).');
    } else {
        headLines.push('Size: ~' + res.tokens + ' tokens (context ceiling unavailable, so no cap is applied).');
    }
    if (res.dropped.length) {
        headLines.push('');
        headLines.push('TRIMMED TO FIT \u2014 these blocks were dropped, lowest priority first:');
        for (let dl of res.dropped) headLines.push('  - ' + dl);
    }
    // A stale/absent notes cache shows as a raw transcript here but will be distilled on
    // the real run, so the live context is usually SMALLER than this preview. Say so
    // rather than letting the number look alarming.
    if (body.indexOf('--- CHAT: ') >= 0) {
        headLines.push('');
        headLines.push('Note: chats shown as raw transcripts have not been distilled yet. They will be condensed into world facts on the next generation, which usually shrinks this considerably.');
    }
    headLines.push('');
    return headLines.join('\n') + body;
}




// ── World-Build Wizard: species / faction batch generation (yoink) ───────────
// [vNEXT] Generate a batch of named items (species or factions), each with a short
// lore description, in one budget-free pass. Output is parsed from a simple
// NAME:/LORE: block format. Returns an array of {name, description} (may be < count
// if the model returns fewer). kind is 'species' or 'faction' for prompt phrasing.
// [v1.22.0 STAGING] avoidNames carries names discarded during this staging session
// (tombstones) plus any staged-but-uncommitted names, so a regenerate after deleting a
// bad entry does not hand the same entry straight back.
async function generateEntityBatch(kind: string, count: number, sourceChatIds: string[], avoidNames?: string[]): Promise<{ name: string; description: string }[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let noun = (kind === 'faction') ? 'factions (organizations, powers, or groups)' : 'species (peoples or creature-types)';

    // [v0.9.80] Feed existing same-kind names in so the batch never recreates them.
    let batchExistingNames = ((kind === 'faction') ? (cfg.factions || []) : (cfg.species || []))
        .map(function(x: any) { return (x && x.name) ? String(x.name).trim() : ''; })
        .filter(Boolean);
    for (let avName of (avoidNames || [])) {
        if (avName && batchExistingNames.indexOf(avName) < 0) batchExistingNames.push(avName);
    }

    let batchSysLines: string[] = [
        'You are generating ' + noun + ' for a story world.',
        'Produce EXACTLY ' + count + ' distinct entries that fit the world and feel like they belong together without being repetitive.',
        'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.'
    ];
    if (batchExistingNames.length) {
        batchSysLines.push('These ' + (kind === 'faction' ? 'factions' : 'species') + ' ALREADY EXIST — do NOT recreate, rename, or duplicate any of them. Generate entirely new, distinct entries:\n' + batchExistingNames.map(function(bn) { return '- ' + bn; }).join('\n'));
    }
    batchSysLines.push('FORMAT: For each entry output exactly:\nNAME: <short proper name>\nLORE: <a full, substantial description (roughly 5-8 sentences, one or two solid paragraphs) covering what it is, what matters about it, and the specific details that distinguish it>\nSeparate entries with a line containing only ---');
    batchSysLines.push('Draw on the specific names, ideas, and details raised in the brainstorming chat below — do not stay generic.');
    batchSysLines.push('Output ONLY the entries in that format. No preamble, no numbering, no extra commentary.');
    let sys = batchSysLines.join('\n\n');

    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    usrParts.push('Generate ' + count + ' ' + (kind === 'faction' ? 'factions' : 'species') + ' now.');

    let raw = '';
    try {
        raw = await executeYoinkGeneration([{ role: 'system', content: sys }, { role: 'user', content: usrParts.join('\n\n') }], { validator: function(r) { return /NAME:/i.test(r); }, tag: 'entityBatch:' + kind });
    } catch (e) {
        api.v1.error('[AE:wizard] batch generation failed (' + kind + '):', e);
        return [];
    }

    // Parse NAME:/LORE: blocks split on --- lines.
    let out: { name: string; description: string }[] = [];
    let chunks = (raw || '').split(/\n-{3,}\n/);
    for (let ch of chunks) {
        let nameMatch = ch.match(/NAME:\s*(.+)/i);
        let loreMatch = ch.match(/LORE:\s*([\s\S]+)/i);
        if (!nameMatch) continue;
        let nm = nameMatch[1].trim();
        let lore = loreMatch ? loreMatch[1].trim() : '';
        // Trim a trailing stray --- or NAME: bleed if the split missed.
        lore = lore.replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        if (nm) out.push({ name: nm, description: lore });
    }
    return out;
}

// [vNEXT] Generate (or regenerate) the lore description for ONE named species/faction,
// scoped to that single item, with optional hint. Returns description text or null.
async function generateEntityLore(kind: string, name: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let kindNoun = (kind === 'faction') ? 'faction' : 'species';
    let sys = [
        'You are writing the lore description for a single ' + kindNoun + ' named "' + name + '" in a story world.',
        'Write a full, substantial description (roughly 5-8 sentences, one or two solid paragraphs) covering what it is, what matters about it, and the specific details that distinguish it. Stay focused on THIS ' + kindNoun + ' only, and draw on the specific ideas and details in the reference context rather than staying generic.',
        'Output ONLY the description prose. Do not begin with the name or a label.'
    ].join('\n\n');
    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    if (hint && hint.trim()) usrParts.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    usrParts.push('Write the description for "' + name + '" now.');
    let result = '';
    try {
        result = await executeYoinkGeneration([{ role: 'system', content: sys }, { role: 'user', content: usrParts.join('\n\n') }], { tag: 'entityLore:' + kind + ':' + name });
    } catch (e) {
        api.v1.error('[AE:wizard] entity lore generation failed (' + name + '):', e);
        return null;
    }
    return (result || '').trim() || null;
}

// ── World-Build Wizard: stage / commit (v1.22.0 STAGING) ─────────────────────
// [v1.22.0] Every batch kind now follows: stage*Batch (generate -> park as drafts) ->
// user reviews/edits/discards -> commitStagedDrafts (write records + lorebook, clear
// drafts + tombstones). The legacy run*Batch wrappers preserve the old one-shot
// behavior for existing callers (notably the bridge's AE_WIZ_GENERATE handler) by
// staging and then committing ONLY the ids they just created — so a one-shot call never
// sweeps up drafts the user is still reviewing in the native wizard.

// Names currently staged-but-uncommitted for a kind. Combined with tombstones to form
// the do-not-recreate list, so a second Generate pass extends the batch rather than
// duplicating it.
// [v1.22.2] Do-not-recreate list for a kind = names of drafts STILL STAGED, so a second
// Generate press extends the batch rather than duplicating what is already on screen.
// Discarded names are deliberately NOT included (see discardWizardDraft).
// excludeDraftId omits one draft's own name — used by per-draft Regenerate, which must
// be free to produce the same place/person again with better prose.
async function avoidNamesForKind(kind: string, excludeDraftId?: string): Promise<string[]> {
    let staged = await loadWizardDraftsOfKind(kind);
    let merged: string[] = [];
    for (let sd of staged) {
        if (excludeDraftId && sd.id === excludeDraftId) continue;
        let mn = (sd.fields.name || '').trim();
        if (mn && merged.indexOf(mn) < 0) merged.push(mn);
    }
    return merged;
}

// Stage N species/factions as drafts. Returns the created draft ids (empty on failure).
async function stageEntityBatch(kind: string, count: number, sourceChatIds: string[]): Promise<string[]> {
    let avoid = await avoidNamesForKind(kind);
    let items = await generateEntityBatch(kind, count, sourceChatIds, avoid);
    if (!items.length) return [];
    let rows = items.map(function(it) { return { name: it.name, description: it.description || '' }; });
    return await addWizardDrafts(kind, rows, sourceChatIds, null);
}

// Stage N minor-NPC archetypes as drafts.
// [CE-STRIP v2.1.6] stageArchetypeBatch() removed — Bestiary + Item Templates cut.

// Stage N item templates as drafts.
// [CE-STRIP v2.1.6] stageItemBatch() removed — Bestiary + Item Templates cut.

// Stage N locations as drafts under parentId. parentId rides on the draft record so a
// commit long after staging still files them in the right place in the tree.
async function stageLocationBatch(count: number, parentId: string | null, sourceChatIds: string[]): Promise<string[]> {
    let avoid = await avoidNamesForKind('location');
    let items = await generateLocationBatch(count, parentId, sourceChatIds, avoid);
    if (!items.length) return [];
    let rows = items.map(function(it) { return { name: it.name, description: it.description || '', lore: it.lore || '' }; });
    return await addWizardDrafts('location', rows, sourceChatIds, parentId || null);
}

// [v1.22.2 CHAR-STAGE] Stage N characters as name + concept-dump drafts. The expensive
// per-character field extraction is deferred to commit, so a user who dislikes a name or
// concept can fix or discard it before any generation is spent structuring it.
async function stageCharacterBatch(count: number, sourceChatIds: string[]): Promise<string[]> {
    let names = await generateCharacterNames(count, sourceChatIds);
    if (!names.length) return [];
    let rows: { [k: string]: string }[] = [];
    for (let nm of names) {
        let dump = '';
        try { dump = await generateCharacterDump(nm, sourceChatIds); }
        catch (eCharDump) { api.v1.error('[AE:wizard] character dump failed for "' + nm + '":', eCharDump); }
        rows.push({ name: nm, dump: dump || '' });
    }
    return await addWizardDrafts('character', rows, sourceChatIds, null);
}

// [v1.22.2] Regenerate a single staged draft in place, reusing the chat sources it was
// generated from. Its own name is excluded from the do-not-recreate list so the model may
// legitimately produce the same subject again with better prose. Returns false on failure
// and leaves the existing draft untouched, so a bad regen never destroys good content.
async function regenerateWizardDraft(draftId: string): Promise<boolean> {
    let all = await loadWizardDrafts();
    let target = all.find(function(d) { return d.id === draftId; });
    if (!target) return false;

    let rgKind = target.kind;
    let rgSrc = target.sourceChatIds || [];
    let rgAvoid = await avoidNamesForKind(rgKind, draftId);
    let rgFields: { [k: string]: string } | null = null;

    try {
        if (rgKind === 'species' || rgKind === 'faction') {
            let rows = await generateEntityBatch(rgKind, 1, rgSrc, rgAvoid);
            if (rows.length) rgFields = { name: rows[0].name, description: rows[0].description || '' };
        // [CE-STRIP v2.1.6] 'archetype'/'item' draft-regen branches removed — Bestiary + Item Templates cut.
        } else if (rgKind === 'location') {
            let rows = await generateLocationBatch(1, target.parentId || null, rgSrc, rgAvoid);
            if (rows.length) rgFields = { name: rows[0].name, description: rows[0].description || '', lore: rows[0].lore || '' };
        } else if (rgKind === 'character') {
            // Keep the name the user is already looking at; regenerate only the concept.
            let rgName = (target.fields.name || '').trim();
            if (!rgName) return false;
            let rgDump = await generateCharacterDump(rgName, rgSrc);
            if (rgDump && rgDump.trim()) rgFields = { name: rgName, dump: rgDump.trim() };
        }
    } catch (eRegen) {
        api.v1.error('[AE:wizard] regenerate failed for draft ' + draftId + ':', eRegen);
        return false;
    }

    if (!rgFields) return false;
    let fresh = await loadWizardDrafts();
    let live = fresh.find(function(d) { return d.id === draftId; });
    if (!live) return false;
    live.fields = rgFields;
    await saveWizardDrafts(fresh);
    return true;
}

// [v1.22.0 STAGING] The single irreversible write path. Commits staged drafts of a kind
// to real records (+ lorebook entries where that kind has them), then removes exactly
// the committed drafts and clears the kind's tombstones. Drafts with a blank name are
// skipped and LEFT STAGED rather than silently dropped, so the user can see and fix them.
//
// onlyIds restricts the commit to a specific set (used by the legacy run*Batch wrappers).
// Returns the number of records actually created.
async function commitStagedDrafts(kind: string, onlyIds?: string[]): Promise<number> {
    let drafts = await loadWizardDraftsOfKind(kind);
    if (onlyIds && onlyIds.length) {
        drafts = drafts.filter(function(d) { return onlyIds.indexOf(d.id) >= 0; });
    }
    if (!drafts.length) return 0;

    let committedIds: string[] = [];
    let made = 0;

    for (let d of drafts) {
        let dName = (d.fields.name || '').trim();
        if (!dName) continue;   // leave nameless drafts staged for the user to fix

        try {
            if (kind === 'species') {
                let spId = 'sp_' + generateId();
                await mutConfig(function(c) {
                    if (!c.species) c.species = [];
                    c.species.push({ id: spId, name: dName, description: d.fields.description || '', lorebookTags: [] });
                });
                await createLinkedSpeciesLorebookEntry(spId).catch(function() {});
            } else if (kind === 'faction') {
                let facId = 'fac_' + generateId();
                await mutConfig(function(c) {
                    if (!c.factions) c.factions = [];
                    c.factions.push({ id: facId, name: dName, description: d.fields.description || '', relationshipStates: ['Hostile', 'Wary', 'Neutral', 'Friendly', 'Allied'], lorebookTags: [] });
                });
                await createLinkedFactionLorebookEntry(facId).catch(function() {});
            } else if (kind === 'archetype') {
                let archId = 'arch_' + generateId();
                await mutConfig(function(c) {
                    if (!(c as any).npcArchetypes) (c as any).npcArchetypes = [];
                    (c as any).npcArchetypes.push({ id: archId, name: dName, briefTemplate: d.fields.brief || '', charResourceDefs: [], actionInstances: [], tagSubscriptions: [] });
                });
            } else if (kind === 'item') {
                let itmId = 'item_' + generateId();
                await mutConfig(function(c) {
                    if (!(c as any).itemArchetypes) (c as any).itemArchetypes = [];
                    (c as any).itemArchetypes.push({ id: itmId, name: dName, descriptionTemplate: d.fields.description || '', tagSubscriptions: [], spawnTarget: 'inventory' });
                });
            } else if (kind === 'location') {
                await createLocationEntity(dName, d.fields.description || '', d.fields.lore || '', d.parentId || null);
            } else if (kind === 'character') {
                // [v1.22.2 CHAR-STAGE] Structured fields are derived HERE, from the concept
                // dump as the user left it. If field extraction fails, the character is still
                // created with its name + dump rather than being lost, and the dump remains
                // visible on the record for a manual per-field regenerate.
                let chDump = d.fields.dump || '';
                let chFields: WizardCharFields | null = null;
                try { chFields = await generateCharacterFields(dName, chDump); }
                catch (eChFields) { api.v1.error('[AE:wizard] field extraction failed for "' + dName + '":', eChFields); }
                await createWizardCharacter(dName, chDump, chFields);
            } else {
                aeLog('[AE:wizard] commitStagedDrafts unknown kind: ' + kind);
                continue;
            }
            committedIds.push(d.id);
            made++;
        } catch (eCommit) {
            // Leave this draft staged so the user can retry; keep going with the rest.
            api.v1.error('[AE:wizard] commit failed for staged ' + kind + ' "' + dName + '":', eCommit);
        }
    }

    await removeWizardDrafts(committedIds);
    return made;
}

// [vNEXT] Batch-create species records from a chat: generate, push records, and
// create+link a lorebook entry (with tags = name) for each. Returns count created.
// [v1.22.0 STAGING] Now a thin stage -> commit wrapper. Commits only its own new drafts.

// [vNEXT] Batch-create faction records from a chat. Factions also get the default
// standing track (relationshipStates) so the existing index-based standing works.
// [v1.22.0 STAGING] Now a thin stage -> commit wrapper. Commits only its own new drafts.

// [vNEXT] Batch-create minor-NPC archetypes from a wizard chat: generate NAME +
// one-line BRIEF pairs and push NpcArchetypeDef records to cfg.npcArchetypes.
// Resources/tags start empty (edit in the Bestiary: "+ Default Resources", tags);
// no lorebook entry — archetypes are spawn templates, not world lore. Returns count.
// [v1.22.0 STAGING] Pure generator: parses and RETURNS archetypes, writing nothing.
// Committing to cfg.npcArchetypes is commitStagedDrafts()'s job.
// [CE-STRIP v2.1.6] generateArchetypeBatch() removed — Bestiary + Item Templates cut.

// [v1.22.0 STAGING] Legacy one-shot: stage then commit only the drafts just created.
// Retained for the bridge's AE_WIZ_GENERATE handler and any direct callers.
// [CE-STRIP v2.1.6] runWizardArchetypesBatch() removed — Bestiary + Item Templates cut.

// [v1.14.0 ITEMS] Generate item templates from a wizard chat: NAME + one-line DESC
// pairs. Mechanics (skill bonuses, actions, tags) start EMPTY by design and are filled
// in the Item Template editor \u2014 the model only authors the name + description, the
// same shallow-generation split the Bestiary uses.
// [v1.22.0 STAGING] Pure generator: parses and RETURNS item templates, writing nothing.
// Committing to cfg.itemArchetypes is commitStagedDrafts()'s job.
// [CE-STRIP v2.1.6] generateItemBatch() removed — Bestiary + Item Templates cut.

// [v1.22.0 STAGING] Legacy one-shot: stage then commit only the drafts just created.
// [CE-STRIP v2.1.6] runWizardItemsBatch() removed — Bestiary + Item Templates cut.

// [v0.9.80] Manually add a single blank species/faction record (default name, empty
// lore) and link a lorebook entry, so the user can rename it and then ⚡ Regen its
// fields — the regen path re-syncs the existing entry. Returns the new record id.
async function addBlankWizardEntity(kind: string): Promise<string> {
    let blankId = ((kind === 'faction') ? 'fac_' : 'sp_') + generateId();
    let blankName = (kind === 'faction') ? 'New Faction' : 'New Species';
    await mutConfig(function(c) {
        if (kind === 'faction') {
            if (!c.factions) c.factions = [];
            c.factions.push({ id: blankId, name: blankName, description: '', relationshipStates: ['Hostile', 'Wary', 'Neutral', 'Friendly', 'Allied'], lorebookTags: [] });
        } else {
            if (!c.species) c.species = [];
            c.species.push({ id: blankId, name: blankName, description: '', lorebookTags: [] });
        }
    });
    if (kind === 'faction') await createLinkedFactionLorebookEntry(blankId).catch(function() {});
    else await createLinkedSpeciesLorebookEntry(blankId).catch(function() {});
    return blankId;
}

// [vNEXT] Regenerate one species/faction's description in place and re-sync its
// lorebook entry. kind is 'species' or 'faction'. Returns the new text or null.
async function regenerateWizardEntity(kind: string, itemId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let list: any[] = (kind === 'faction') ? (cfg.factions || []) : (cfg.species || []);
    let item = list.find(function(x) { return x.id === itemId; });
    if (!item) return null;
    let gen = await generateEntityLore(kind, item.name, sourceChatIds, hint);
    if (!gen) return null;
    await mutConfig(function(c) {
        let arr: any[] = (kind === 'faction') ? (c.factions || []) : (c.species || []);
        let t = arr.find(function(x) { return x.id === itemId; });
        if (t) t.description = gen;
    });
    if (kind === 'faction') await syncFactionLorebookEntry(itemId).catch(function() {});
    else await syncSpeciesLorebookEntry(itemId).catch(function() {});
    return gen;
}


// [CE-STRIP v2.0.0] tierBandIndexForDepth / entryActionIdForDepth / syncTierTemplate
// removed — tier-travel cost templates cut with Actions + Travel. Locations no longer
// stamp an entryActionId.

// [v0.9.82] Yoink-generate a batch of locations as {name, description}. parentId null =
// top-level. Existing sibling names are fed in to avoid duplicates; the parent's own
// description anchors children. Multi-chat context via buildWizardMultiContext.
//
// [v1.18.0 LOCGEN] >>> PAIRED PROMPT: generateSceneLocation() (Items block, near
// >>> generateSceneItem) emits the SAME NAME/DESC/LORE contract from story context
// >>> instead of chat context, and parses it with the same regexes. If you change the
// >>> format instructions or the parse here, change them there too.
// [v1.22.0 STAGING] avoidNames carries tombstoned + staged-uncommitted names.
async function generateLocationBatch(count: number, parentId: string | null, sourceChatIds: string[], avoidNames?: string[]): Promise<{ name: string; description: string; lore: string }[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let parentEnt = parentId ? await loadEntity(parentId) : null;
    let locIdx = await loadEntityIndex();
    let existingLoc = locIdx.filter(function(m) { return m.type === 'location' && m.parentId === (parentId || null); }).map(function(m) { return m.name; }).filter(Boolean);
    for (let avLoc of (avoidNames || [])) {
        if (avLoc && existingLoc.indexOf(avLoc) < 0) existingLoc.push(avLoc);
    }
    let scopeNoun = parentEnt ? ('sub-locations inside "' + parentEnt.name + '"') : 'top-level locations (regions / major places) of the world';

    let locSysLines: string[] = [
        'You are generating ' + scopeNoun + ' for a story world.',
        'Produce EXACTLY ' + count + ' distinct locations that fit the world and belong together without being repetitive.',
        // [v1.22.2] The brainstorming chat is the AUTHORITY on which places to build, not
        // mere background flavour. Users reported discussing Hogwarts / Diagon Alley /
        // Hogsmeade and receiving unrelated inventions instead. State this first and
        // positively: name the places the chat names, and invent only to fill a shortfall.
        'The brainstorming chat below is your source of truth. If it names specific places, use those exact names and build those locations first, preserving the chat\'s own details about each. Invent additional locations only if the chat names fewer than ' + count + '.',
        'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.'
    ];
    if (parentEnt && (parentEnt.description || '').trim()) {
        locSysLines.push('They are all inside this parent location:\n' + parentEnt.name + ': ' + parentEnt.description.trim());
    }
    if (existingLoc.length) {
        // [v1.22.2] Scoped wording: these are records that already exist in the world, so
        // recreating one would make a duplicate. This list no longer contains names the
        // user merely discarded (v1.22.0 tombstones), which is what previously caused the
        // generator to be forbidden from producing the very places the chat was about.
        locSysLines.push('Locations with these names already exist in the world, so choose different ones \u2014 build any OTHER places the chat names:\n' + existingLoc.map(function(ln) { return '- ' + ln; }).join('\n'));
    }
    locSysLines.push('FORMAT: For each location output exactly:\nNAME: <short place name>\nDESC: <1-2 sentences capturing ONLY what a camera physically senses on arrival (light, texture, scale). No history.>\nLORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, culture, and tensions>\nSeparate entries with a line containing only ---');
    locSysLines.push('Draw every name and detail from the brainstorming chat. Output ONLY the entries in the exact format requested. No preamble, no numbering, no commentary.');
    let locSys = locSysLines.join('\n\n');

    let locUsr: string[] = [];
    if (ctx.trim()) locUsr.push(ctx);
    // [v1.22.2] Restate the priority immediately before generation, where it carries the
    // most recency weight, rather than relying on the system message alone.
    locUsr.push('Generate ' + count + ' locations now, starting with the places named in the chat above.');

    let locRaw = '';
    try {
        locRaw = await executeYoinkGeneration([{ role: 'system', content: locSys }, { role: 'user', content: locUsr.join('\n\n') }], { validator: function(r) { return /NAME:/i.test(r); }, tag: 'locationBatch' + (parentEnt ? (':' + parentEnt.name) : '') });
    } catch (eLocGen) {
        api.v1.error('[AE:wizard] location batch generation failed:', eLocGen);
        return [];
    }

    let locOut: { name: string; description: string; lore: string }[] = [];
    let locChunks = (locRaw || '').split(/\n-{3,}\n/);
    for (let lch of locChunks) {
        let lnm = lch.match(/NAME:\s*(.+)/i);
        let lde = lch.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
        let llo = lch.match(/LORE:\s*([\s\S]+)/i);
        if (!lnm) continue;
        let lName = lnm[1].trim();
        let lDesc = lde ? lde[1].trim() : '';
        lDesc = lDesc.replace(/\nLORE:[\s\S]*$/i, '').replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        let lLore = llo ? llo[1].trim() : '';
        lLore = lLore.replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        if (lName) locOut.push({ name: lName, description: lDesc, lore: lLore });
    }
    return locOut;
}

// [v1.18.0 LOCGEN] The ONE place a generated {name, description, lore} triple becomes a
// persisted `location` entity plus its linked lorebook entry. Two callers, deliberately:
//
//   runWizardLocationsBatch()  (directly below)  — authoring-time, wizard chat context,
//                                                  Yoink generation, N at a time.
//   spawnLocation()            (Items block, next to spawnItem/generateSceneItem) —
//                                                  in-play, story context, one at a time.
//
// >>> PAIRED CODE: if you add a field stamped onto new locations here, make sure BOTH
// >>> callers can supply it. If you change what a location needs at birth, this helper
// >>> is the only place to change it — do not re-inline entity assembly in a caller.
//
// Siblings need no connectedEntityIds edge: locationGraph derives lateral adjacency from
// a shared parentId (see "Lateral siblings" in buildSceneStatePayload).
async function createLocationEntity(name: string, description: string, lore: string, parentId: string | null): Promise<string> {
    let cle = makeDefaultEntity(name || 'New Location');
    cle.type = 'location';
    cle.parentId = parentId || null;
    cle.description = description || '';
    (cle as any).lorebookText = lore || '';
    // [CE-STRIP v2.1.5] entryActionId param/assignment removed — always dead, no consumer.
    await saveEntity(cle);
    if ((lore || '').trim()) { await createLinkedEntityLorebookEntry(cle.id).catch(function() {}); }
    return cle.id;
}

// [v0.9.82] Batch-create location entities under parentId, stamping each with the tier
// template for its depth. Returns the count created.
// [v1.22.0 STAGING] Legacy one-shot: stage then commit only the drafts just created.
// Tier/entry-action resolution now happens inside commitStagedDrafts, from the parentId
// carried on each draft record.

// [v0.9.82] Create one blank location under parentId. Returns id.
async function addBlankWizardLocation(parentId: string | null): Promise<string> {
    let le = makeDefaultEntity('New Location');
    le.type = 'location';
    le.parentId = parentId || null;
    await saveEntity(le);
    return le.id;
}

// [v0.9.83] Regenerate one location's short description AND comprehensive lorebook in a
// single pass; updates both fields and re-syncs (or creates) its lorebook entry.
async function regenerateWizardLocation(locId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let ent = await loadEntity(locId);
    if (!ent) return null;
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let parentEnt = ent.parentId ? await loadEntity(ent.parentId) : null;
    let locSys = [
        'You are writing the entry for a single location named "' + ent.name + '"' + (parentEnt ? (' inside "' + parentEnt.name + '"') : '') + ' in a story world.',
        'Output exactly two labelled blocks and nothing else:\nDESC: <1-2 sentences of scene-present description — what a person directly sees, hears, and senses on arrival. Keep it short.>\nLORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, who or what is here, how it connects to the wider world, and any secrets or tensions>',
        'Stay focused on THIS location, drawing on the specific ideas in the reference context. Do not add any other labels, preamble, or commentary.'
    ].join('\n\n');
    let locUsr: string[] = [];
    if (ctx.trim()) locUsr.push(ctx);
    if (hint && hint.trim()) locUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    locUsr.push('Write the DESC and LORE for "' + ent.name + '" now.');
    let locRes = '';
    try {
        locRes = await executeYoinkGeneration([{ role: 'system', content: locSys }, { role: 'user', content: locUsr.join('\n\n') }], { validator: function(r) { return /DESC:|LORE:/i.test(r); }, tag: 'locationRegen:' + ent.name });
    } catch (eLocReg) {
        api.v1.error('[AE:wizard] location regen failed:', eLocReg);
        return null;
    }
    let locOutRaw = (locRes || '').trim();
    if (!locOutRaw) return null;
    let rde = locOutRaw.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
    let rlo = locOutRaw.match(/LORE:\s*([\s\S]+)/i);
    let newDesc = rde ? rde[1].trim() : '';
    newDesc = newDesc.replace(/\nLORE:[\s\S]*$/i, '').trim();
    let newLore = rlo ? rlo[1].trim() : '';
    if (!newDesc && !newLore) { newLore = locOutRaw; }
    let freshEnt = await loadEntity(locId);
    if (!freshEnt) return null;
    if (newDesc) freshEnt.description = newDesc;
    if (newLore) (freshEnt as any).lorebookText = newLore;
    await saveEntity(freshEnt);
    if (newLore) {
        if ((freshEnt as any).lorebookEntryId) await syncEntityLorebookEntry(locId, true).catch(function() {});
        else await createLinkedEntityLorebookEntry(locId).catch(function() {});
    }
    return newLore || newDesc;
}

// ── World-Build Wizard: Characters (seed-and-go via comprehensive concept dump) ──
// [v0.9.84] Flow: generate names from chat (dedup) -> per character, generate a
// comprehensive concept dump from chat -> derive all dramatis-personae + static fields
// from THAT dump (not chat) -> create the character (entity body + record + lorebook).
// The dump is the persistent source; later per-field regens in the editor read it.

interface WizardCharFields {
    species: string; age: string; gender: string; occupationRole: string; briefDescription: string;
    physicalDescription: string; personalityCore: string; voiceAndMannerisms: string; background: string;
    coreValues: string[];
}

async function generateCharacterNames(count: number, sourceChatIds: string[]): Promise<string[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let charIdx = await loadIndex();
    let existingNames = charIdx.map(function(m) { return m.name; }).filter(Boolean);
    let nameSys: string[] = [
        'You are identifying distinct CHARACTERS (individual people) for a story world.',
        'Produce EXACTLY ' + count + ' character names that the brainstorming context establishes or clearly implies. Real individuals, not groups, roles, or species.'
    ];
    if (existingNames.length) nameSys.push('These characters ALREADY EXIST \u2014 do NOT repeat them:\n' + existingNames.map(function(n) { return '- ' + n; }).join('\n'));
    nameSys.push('FORMAT: one name per line, each prefixed with "NAME: ". Nothing else \u2014 no descriptions, numbering, or commentary.');
    let nameUsr: string[] = [];
    if (ctx.trim()) nameUsr.push(ctx);
    nameUsr.push('List ' + count + ' character names now.');
    let nameRaw = '';
    try { nameRaw = await executeYoinkGeneration([{ role: 'system', content: nameSys.join('\n\n') }, { role: 'user', content: nameUsr.join('\n\n') }], { validator: function(r) { return /NAME:/i.test(r); }, tag: 'charNames' }); }
    catch (eCharNames) { api.v1.error('[AE:wizard] character names failed:', eCharNames); return []; }
    let names: string[] = [];
    let nameLines = (nameRaw || '').split('\n');
    for (let nl of nameLines) {
        let mm = nl.match(/NAME:\s*(.+)/i);
        if (!mm) continue;
        let nm = mm[1].trim().replace(/^[-*0-9.\s]+/, '').trim();
        if (nm && names.indexOf(nm) < 0) names.push(nm);
    }
    return names.slice(0, count);
}

async function generateCharacterDump(name: string, sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let dumpSys = [
        'You are assembling a COMPREHENSIVE concept profile (a "concept dump") for a single character named "' + name + '" based entirely on the brainstorming context.',
        'Organize EVERYTHING the context establishes or implies about ' + name + ' into one thorough, well-structured profile: who they are, anatomical appearance, psychological contradictions, vocal timbre, formative history, relationships, and goals.',
        'CRITICAL RULE: Write entirely in plain prose. DO NOT use markdown, bolding, italics, or bullet points. DO NOT invent tragic backstories or cliché tropes unless explicitly stated in the context.',
        'Output ONLY the plain prose profile for ' + name + '. No preamble, no headers, no commentary.'
    ].join('\n\n');
    let dumpUsr: string[] = [];
    if (ctx.trim()) dumpUsr.push(ctx);
    dumpUsr.push('Write the comprehensive concept profile for "' + name + '" now.');
    let dumpRaw = '';
    try { dumpRaw = await executeYoinkGeneration([{ role: 'system', content: dumpSys }, { role: 'user', content: dumpUsr.join('\n\n') }], { tag: 'charDump:' + name }); }
    catch (eCharDump) { api.v1.error('[AE:wizard] character dump failed:', eCharDump); return ''; }
    return (dumpRaw || '').trim();
}

async function generateCharacterFields(name: string, dump: string): Promise<WizardCharFields | null> {
    if (!(dump || '').trim()) return null;
    let fieldSys = [
        'You are filling structured fields for the character "' + name + '", extracting data ONLY from the concept profile provided. Do not contradict it; where the profile is silent, infer the most fitting objective value.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, or italics. Output EXACTLY these labelled lines, in this exact order, and nothing else:\n' +
        'SPECIES: <one or two words>\n' +
        'AGE: <a number or short phrase>\n' +
        'GENDER: <short>\n' +
        'ROLE: <occupation or role, a few words>\n' +
        'BRIEF: <one tight sentence identifying who they are at a glance>\n' +
        'PHYSICAL: <Camera-view physical anatomy, skin, hair, eyes, and build. Sensual or striking details if applicable. No clothing. No mannerisms.>\n' +
        'PERSONALITY: <Psychological baseline and a core contradiction/hidden facet. No tragic tropes. Declarative.>\n' +
        'VOICE: <Vocal timbre, speech rhythm, and one signature physical mannerism.>\n' +
        'BACKGROUND: <One or two formative past events that shaped their current worldview. Past tense.>\n' +
        'VALUES: <3-5 deeply held values, semicolon-separated>'
    ].join('\n\n');
    let fieldUsr = '--- CONCEPT PROFILE ---\n' + dump.trim() + '\n\nFill the fields for "' + name + '" now.';
    let fieldRaw = '';
    try { fieldRaw = await executeYoinkGeneration([{ role: 'system', content: fieldSys }, { role: 'user', content: fieldUsr }], { validator: function(r) { return /SPECIES:|BRIEF:/i.test(r); }, tag: 'charFields:' + name }); }
    catch (eCharFields) { api.v1.error('[AE:wizard] character fields failed:', eCharFields); return null; }

    function parseCharFields(txt: string): Record<string, string> {
        let labels = ['SPECIES', 'AGE', 'GENDER', 'ROLE', 'BRIEF', 'PHYSICAL', 'PERSONALITY', 'VOICE', 'BACKGROUND', 'VALUES'];
        let result: Record<string, string> = {};
        let fLines = (txt || '').split('\n');
        let cur = '';
        for (let fl of fLines) {
            let trimmed = fl.trim();
            let up = trimmed.toUpperCase();
            let hit = '';
            for (let lb of labels) { if (up.indexOf(lb + ':') === 0) { hit = lb; break; } }
            if (hit) { result[hit] = trimmed.slice(hit.length + 1).trim(); cur = hit; }
            else if (cur && trimmed) { result[cur] = (result[cur] ? result[cur] + ' ' : '') + trimmed; }
        }
        return result;
    }

    let parsed = parseCharFields(fieldRaw);
    let valuesRaw = parsed['VALUES'] || '';
    return {
        species: parsed['SPECIES'] || '', age: parsed['AGE'] || '', gender: parsed['GENDER'] || '',
        occupationRole: parsed['ROLE'] || '', briefDescription: parsed['BRIEF'] || '',
        physicalDescription: parsed['PHYSICAL'] || '', personalityCore: parsed['PERSONALITY'] || '',
        voiceAndMannerisms: parsed['VOICE'] || '', background: parsed['BACKGROUND'] || '',
        coreValues: valuesRaw.split(';').map(function(s) { return s.trim(); }).filter(Boolean)
    };
}

async function createWizardCharacter(name: string, dump: string, fields: WizardCharFields | null): Promise<string> {
    let cfg = await loadConfig();
    let body = makeDefaultEntity(name);
    body.type = 'character';
    body.parentId = null;
    await saveEntity(body);
    let ch = makeDefaultCharacter(name, cfg);
    ch.entityId = body.id;
    ch.conceptDump = dump || '';
    if (fields) {
        ch.species = fields.species || '';
        ch.age = fields.age || '';
        ch.gender = fields.gender || '';
        ch.occupationRole = fields.occupationRole || '';
        ch.briefDescription = fields.briefDescription || '';
        ch.physicalDescription = fields.physicalDescription || '';
        ch.personalityCore = fields.personalityCore || '';
        ch.voiceAndMannerisms = fields.voiceAndMannerisms || '';
        ch.background = fields.background || '';
        ch.coreValues = fields.coreValues || [];
    }
    await saveCharacter(ch);
    try { await createLinkedLorebookEntry(ch.id); } catch (eCharLb) { /* non-fatal */ }
    return ch.id;
}

// [v0.9.84] Generate ONE character end-to-end (dump from chat -> fields from dump -> create).
async function runWizardCharacterSingle(name: string, sourceChatIds: string[]): Promise<boolean> {
    let nm = (name || '').trim();
    if (!nm) return false;
    let dump = await generateCharacterDump(nm, sourceChatIds);
    let fields = await generateCharacterFields(nm, dump);
    await createWizardCharacter(nm, dump, fields);
    return true;
}

// [v0.9.84] Batch: names from chat (dedup) -> each character end-to-end. Returns count created.
// [v1.22.2 CHAR-STAGE] Now a thin stage -> commit wrapper, committing only its own drafts.
// The per-character dump/field calls still happen, just split across the two halves.

// ── World-Build Wizard: Intro / Opening scene ────────────────────────────────
// [v0.9.85] Pick where the story opens and who is present; generate the opening
// prose (yoink, budget-free), place the player + cast there, and insert into the editor.

async function generateIntroProse(locationId: string, charIds: string[], sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let loc = locationId ? await loadEntity(locationId) : null;
    let allChars = await loadAllCharacters();
    let protag = allChars.find(function(c) { return c.isProtagonist; });
    let castLines: string[] = [];
    for (let cid of (charIds || [])) {
        let ch = allChars.find(function(c) { return c.id === cid; });
        if (!ch) continue;
        castLines.push('- ' + ch.name + (ch.briefDescription ? (': ' + ch.briefDescription) : ''));
    }
    let introSys: string[] = [
        'You are writing the OPENING of an interactive story \u2014 the very first scene, in immersive second-person present tense ("You ...") from the protagonist\'s point of view.',
        'Establish the setting, mood, and immediate situation, and bring any present characters to life through concrete action and detail. Start *in media res* (already in the location, mid-action). End on a beat that invites the player to act; do not resolve the situation.',
        'CRITICAL RULE: Avoid all backstory, lore-dumping, and exposition. DO NOT use any markdown, bolding, italics, or headings.'
    ];
    if (loc) {
        let locLore = ((loc as any).lorebookText || '').trim();
        introSys.push('SETTING (where the scene opens):\n' + loc.name + ((loc.description || '').trim() ? (' \u2014 ' + loc.description.trim()) : '') + (locLore ? ('\nBackground: ' + locLore) : ''));
    }
    if (protag) {
        introSys.push('THE PROTAGONIST ("you"):\n' + protag.name + ((protag.briefDescription || '').trim() ? (': ' + protag.briefDescription.trim()) : ''));
    }
    if (castLines.length) introSys.push('PRESENT IN THE SCENE:\n' + castLines.join('\n'));
    introSys.push('Write 2-4 vivid paragraphs. Output ONLY the opening prose \u2014 no title, headings, labels, or commentary.');
    let introUsr: string[] = [];
    if (ctx.trim()) introUsr.push(ctx);
    introUsr.push('Write the opening scene now.');
    let introRaw = '';
    try { introRaw = await executeYoinkGeneration([{ role: 'system', content: introSys.join('\n\n') }, { role: 'user', content: introUsr.join('\n\n') }], { tag: 'introProse' }); }
    catch (eIntroGen) { api.v1.error('[AE:wizard] intro generation failed:', eIntroGen); return ''; }
    return (introRaw || '').trim();
}

// [v0.9.85] Generate prose first (so a failure leaves world state untouched), then place
// the cast + player, then insert the prose into the story editor as paragraphs.
// [v1.6.3 INTRO-STAGE] The intro generator now stages its output like the other wizard
// tabs: generate -> review/edit/regenerate -> commit. generateIntroDraft yoinks the opening
// prose and stores it as an editable draft WITHOUT touching the story; commitIntroDraft
// travels the player in and writes the (possibly edited) draft, then clears it.
async function generateIntroDraft(locationId: string, sourceChatIds: string[]): Promise<boolean> {
    if (!locationId) { api.v1.ui.toast('Pick an intro location first.', { type: 'error', autoClose: 2500 }); return false; }
    let loc = await loadEntity(locationId);
    if (!loc) { api.v1.ui.toast('That location no longer exists.', { type: 'error', autoClose: 2500 }); return false; }
    // [v0.9.86] Cast placement removed — characters get intro locations set in their character cards.
    let prose = await generateIntroProse(locationId, [], sourceChatIds);
    if (!(prose || '').trim()) return false;
    // [v1.22.0 STAGING] storyStorage, not tempStorage — a staged draft the user is asked
    // to review must survive a script reload / story switch.
    await api.v1.storyStorage.set(STORAGE_WIZ_INTRO_DRAFT, JSON.stringify({ locationId: locationId, prose: prose.trim() })).catch(function() {});
    return true;
}

// [v1.22.0 STAGING] Read the staged intro draft, tolerating both the new storyStorage
// JSON string and any legacy tempStorage object left over from before the migration.
async function loadIntroDraft(): Promise<any> {
    let rawIntro = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_INTRO_DRAFT, '') as string;
    if (rawIntro && String(rawIntro).trim()) {
        try { return JSON.parse(rawIntro as string); }
        catch (eIntroParse) { api.v1.error('[AE:wizard] intro draft parse error:', eIntroParse); }
    }
    let legacyIntro = await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_INTRO_DRAFT, null) as any;
    if (legacyIntro && legacyIntro.locationId) return legacyIntro;
    return null;
}

async function commitIntroDraft(): Promise<boolean> {
    let draft = await loadIntroDraft();
    if (!draft || !draft.locationId || !((draft.prose || '') as string).trim()) { api.v1.ui.toast('No intro draft to commit.', { type: 'error', autoClose: 2500 }); return false; }
    let loc = await loadEntity(draft.locationId);
    if (!loc) { api.v1.ui.toast('That location no longer exists.', { type: 'error', autoClose: 2500 }); return false; }
    await commitTravel(draft.locationId, true);
    let introParas = String(draft.prose).split(/\n\n+/);
    for (let para of introParas) {
        if (para.trim()) { await api.v1.document.appendParagraph({ text: para.trim() }).catch(function() {}); }
    }
    await api.v1.storyStorage.remove(STORAGE_WIZ_INTRO_DRAFT).catch(function() {});
    await api.v1.tempStorage.remove(STORAGE_WIZ_INTRO_DRAFT).catch(function() {});
    return true;
}


// ── World-Build Wizard: Drama (hooks, NPC web, narrative threads) ─────────────
// [vNEXT] The Drama wizard seeds the three primitives the live Drama tab and the
// dynamic engine maintain: per-character UnresolvedHooks, bilateral WebLinks, and
// narrative-thread entities. Hooks and web links are CHARACTER-AWARE — the generators
// are fed the established roster and must resolve to real records; nothing is written
// against a person who does not exist. Seeded hooks deliberately mirror the dynamic
// engine's spawn shape (pressure 20-50, one concrete directed sentence) so they read
// identically to tension the engine raises later during play.

// Compact cast roster for drama generators: protagonist marked, each active character
// on one identifying line. Shared context so generated tensions reference real people.
function buildWizardCastContext(allChars: CharacterRecord[]): string {
    let castLines: string[] = [];
    let castProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (castProtag) {
        let pBrief = (castProtag.briefDescription || '').trim();
        castLines.push('PROTAGONIST (the player, "you"): ' + castProtag.name + (pBrief ? (' — ' + pBrief) : ''));
    }
    for (let cc of allChars) {
        if (cc.isProtagonist) continue;
        if (!cc.active) continue;
        let ccBrief = (cc.briefDescription || '').trim();
        let ccRole = (cc.occupationRole || '').trim();
        let ccTail = ccBrief ? (' — ' + ccBrief) : (ccRole ? (' — ' + ccRole) : '');
        castLines.push('- ' + cc.name + ccTail);
    }
    if (castLines.length === 0) return '';
    return '--- CAST ---\n' + castLines.join('\n');
}

// Resolve a generated target name to the canonical hook target: the protagonist maps
// to the '__player__' token (the Drama tab and injection logic expect it); an exact
// cast name/nickname maps to that name; anything else is kept verbatim (the engine
// tolerates free-text targets so a near-miss is still editable rather than dropped).
// [v2.146.0 HOOK-TARGETID] REPLACES resolveHookTarget, which returned ONE string doing two
// incompatible jobs — a display name for a cast member, but the raw id '__player__' for the
// protagonist. Every caller then had to know which it had received, and two callers didn't
// (see the UnresolvedHook comment). This returns the pair the record now stores, so no
// caller has to decide.
// UNRESOLVED IS NOT AN ERROR: a name the cast does not contain comes back as
// { id: '', name: <what the model said> }, which is exactly the free-text state the picker
// also produces. 'none' / 'n/a' come back as a fully empty ref.
function resolveHookTargetRef(raw: string, allChars: CharacterRecord[]): { id: string; name: string } {
    let rt = (raw || '').trim();
    if (!rt) return { id: '', name: '' };
    let rtLow = rt.toLowerCase();
    if (rtLow === 'none' || rtLow === 'n/a') return { id: '', name: '' };
    let rtProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (rtProtag && (rtLow === rtProtag.name.toLowerCase() || rtLow === 'the protagonist' || rtLow === 'protagonist' || rtLow === 'you' || rtLow === 'the player' || rtLow === 'player')) {
        return { id: '__player__', name: rtProtag.name || 'the player' };
    }
    for (let rc of allChars) {
        if (rc.isProtagonist) continue;
        if (rc.name.toLowerCase() === rtLow) return { id: rc.id, name: rc.name };
        if ((rc.nicknames || []).some(function(n) { return (n || '').toLowerCase() === rtLow; })) return { id: rc.id, name: rc.name };
    }
    return { id: '', name: rt };
}

// The one display resolver. '__player__' is an id and has no name of its own, so anything
// that puts a hook target in front of the model or the user resolves it HERE rather than
// hand-rolling the ternary — which is precisely how two call sites came to lack one.
function _ceHookTargetLabel(hook: any, cfg: any): string {
    if (!hook) return 'someone';
    if (String(hook.targetId || '') === '__player__') {
        return String((cfg && (cfg as any).protagonistName) || 'the player');
    }
    return String(hook.targetName || '') || 'someone';
}

// Resolve a generated name to an existing character id (protagonist included), or ''.
function findWizardCharIdByName(allChars: CharacterRecord[], raw: string): string {
    let fn = (raw || '').trim().toLowerCase();
    if (!fn) return '';
    let fProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (fProtag && (fn === 'the protagonist' || fn === 'protagonist' || fn === 'you' || fn === 'the player' || fn === 'player')) return fProtag.id;
    for (let fc of allChars) {
        if (fc.name.toLowerCase() === fn) return fc.id;
        if ((fc.nicknames || []).some(function(n) { return (n || '').toLowerCase() === fn; })) return fc.id;
    }
    return '';
}

// [vNEXT] Generate ONE starting hook for a character: a concrete unresolved tension
// directed at another existing cast member or the protagonist. Mirrors the dynamic
// engine's hook-spawn prompt for tonal parity. Returns {targetId, targetName, description,
// pressureLevel} (the target ref already resolved) or null when no clean tension exists.
async function generateCharacterHook(char: CharacterRecord, sourceChatIds: string[], hint: string): Promise<{ targetId: string; targetName: string; description: string; pressureLevel: number } | null> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let cast = buildWizardCastContext(allChars);
    let dump = (char.conceptDump || '').trim();

    let hookSys = [
        'You are a dramaturg seeding the OPENING dramatic tension for the character "' + char.name + '" at the very start of a story.',
        'Identify ONE specific, unresolved tension this character carries toward another person: a conflict, a threat they pose or face, a debt, a secret they guard, a betrayal, or an urgent unfulfilled want. Passive moods and general feelings do NOT qualify. It must be directed at a named person and demand eventual action.',
        'The target MUST be one of the established cast, named EXACTLY as written, OR the protagonist. Do not invent a new person.',
        'Write the hook as a single, punchy sentence naming the core tension in concrete terms: what happened, what is owed, what is at stake.',
        '  Wrong: "feels uneasy about her place in the household"',
        '  Right: "Owes the magister a debt she cannot pay, and the collector arrives within the week"',
        'If this character has no plausible directed tension, set the target to "None".',
        // [v2.82.0 PRESSURE] No PRESSURE line asked for or parsed — a fresh hook is
        // fixed at tier 1 by runWizardHookSingle, not guessed by the model.
        'CRITICAL RULE: DO NOT use any markdown, bolding, italics, or bullet points. Output EXACTLY these two labelled lines and nothing else:\nTARGET: <exact cast name, the protagonist, or None>\nHOOK: <one concrete sentence>'
    ].join('\n\n');

    let hookUsr: string[] = [];
    if (cast) hookUsr.push(cast);
    if (dump) hookUsr.push('--- ' + char.name.toUpperCase() + ' (concept profile) ---\n' + dump);
    if (ctx.trim()) hookUsr.push(ctx);
    if (hint && hint.trim()) hookUsr.push('--- EXTRA GUIDANCE FOR THIS REGENERATION ---\n' + hint.trim());
    hookUsr.push('Write the opening hook for "' + char.name + '" now.');

    let hookRaw = '';
    try { hookRaw = await executeYoinkGeneration([{ role: 'system', content: hookSys }, { role: 'user', content: hookUsr.join('\n\n') }], { tag: 'wizHookSeed:' + char.name }); }
    catch (eHookGen) { api.v1.error('[AE:wizard] hook generation failed (' + char.name + '):', eHookGen); return null; }

    function parseHookFields(txt: string): { target: string; hook: string } {
        let pTarget = ''; let pHookLines: string[] = []; let pCur = '';
        let pLines = (txt || '').split('\n');
        for (let pl of pLines) {
            let pt = pl.trim();
            let pu = pt.toUpperCase();
            if (pu.indexOf('TARGET:') === 0) { pTarget = pt.slice(7).trim(); pCur = 'target'; }
            else if (pu.indexOf('HOOK:') === 0) { let hb = pt.slice(5).trim(); if (hb) pHookLines.push(hb); pCur = 'hook'; }
            else if (pCur === 'hook' && pt) { pHookLines.push(pt); }
        }
        return { target: pTarget, hook: pHookLines.join(' ').trim() };
    }

    let parsedHook = parseHookFields(hookRaw);
    let resolvedTarget = resolveHookTargetRef(parsedHook.target, allChars);
    if (!resolvedTarget.name || !parsedHook.hook) return null;
    return { targetId: resolvedTarget.id, targetName: resolvedTarget.name,
             description: parsedHook.hook, pressureLevel: 25 };
}

// [vNEXT] Seed (or reseed) the single starting hook on one character. Replaces hooks[0]
// — the model is one-active-hook-per-character. Stamps lastHookGen with the current
// story gen count so the dynamic engine's escalator picks it up on schedule.
async function runWizardHookSingle(charId: string, sourceChatIds: string[], hint: string): Promise<boolean> {
    let baseChar = await loadCharacter(charId);
    if (!baseChar) return false;
    let gen = await generateCharacterHook(baseChar, sourceChatIds, hint);
    if (!gen) return false;
    let freshHookChar = await loadCharacter(charId);
    if (!freshHookChar) return false;
    let gc = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
    // [v2.82.0 PRESSURE] historyStorage is the source of truth from creation.
    await api.v1.historyStorage.set(_cePressureKey(charId, 'hook'), 1);
    freshHookChar.hooks = [{
        id: api.v1.uuid(),
        targetId: gen.targetId || '',
        targetName: gen.targetName,
        description: (gen.description || '').substring(0, 300),
        pressureLevel: 25,
        developmentNotes: [],
        resolved: false
    }];
    freshHookChar.lastHookGen = Number(gc) || 0;
    await saveCharacter(freshHookChar);
    return true;
}

// [vNEXT] Seed one hook on each selected character. Returns the count successfully seeded.
async function runWizardHooksBatch(charIds: string[], sourceChatIds: string[]): Promise<number> {
    let hookMade = 0;
    for (let hcid of (charIds || [])) {
        let hookOk = await runWizardHookSingle(hcid, sourceChatIds, '');
        if (hookOk) hookMade++;
    }
    return hookMade;
}

// [vNEXT] Generate a batch of bilateral cast dynamics (NPC web). Each names two distinct
// existing people and one concrete charged sentence between them. Parsed from labelled
// A:/B:/DYNAMIC: blocks. Mapping to ids + dedup happens in runWizardWebBatch.
// [v2.91.0 WEB-FLATTEN] The PRIORITY: key is no longer asked for or parsed. dMatch's
// terminator alternation still names it defensively so a stray line from an older
// model habit cannot be swallowed into the dynamic sentence.
async function generateWebBatch(count: number, sourceChatIds: string[]): Promise<{ aName: string; bName: string; dynamic: string }[]> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let cast = buildWizardCastContext(allChars);
    if (!cast) return [];

    let webSys: string[] = [
        'You are a dramaturg defining the web of bilateral dynamics between the established cast of a story.',
        'Produce EXACTLY ' + count + ' distinct PAIR dynamics. Each names two DIFFERENT people from the cast below (the protagonist may be one of them) and states the charged relationship between them in one concrete sentence.',
        'Focus on friction, history, and asymmetry: rivalries, old debts, unspoken attraction, divided loyalty, mutual dependence. Avoid bland "they are friends" pairings, and do not repeat the same pair twice.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, or bullet points. Output plain text only.',
        'FORMAT: for each pair output exactly:\nA: <exact cast name>\nB: <exact cast name>\nDYNAMIC: <one concrete sentence>\nSeparate pairs with a line containing only ---',
        'Output ONLY the pairs in that format. No preamble, no numbering, no commentary.'
    ];

    let webUsr: string[] = [];
    if (ctx.trim()) webUsr.push(ctx);
    webUsr.push('Generate ' + count + ' bilateral dynamics now.');

    let webRaw = '';
    try { webRaw = await executeYoinkGeneration([{ role: 'system', content: webSys.join('\n\n') }, { role: 'user', content: webUsr.join('\n\n') }], { tag: 'webBatch' }); }
    catch (eWebGen) { api.v1.error('[AE:wizard] web batch generation failed:', eWebGen); return []; }

    let webOut: { aName: string; bName: string; dynamic: string }[] = [];
    let webChunks = (webRaw || '').split(/\n-{3,}\n/);
    for (let wch of webChunks) {
        let aMatch = wch.match(/(?:^|\n)\s*A:\s*(.+)/i);
        let bMatch = wch.match(/(?:^|\n)\s*B:\s*(.+)/i);
        let dMatch = wch.match(/DYNAMIC:\s*([\s\S]+?)(?:\nPRIORITY:|$)/i);
        if (!aMatch || !bMatch) continue;
        let aNm = aMatch[1].trim();
        let bNm = bMatch[1].trim();
        let dyn = dMatch ? dMatch[1].trim().replace(/\n-{3,}[\s\S]*$/, '').trim() : '';
        if (aNm && bNm) webOut.push({ aName: aNm, bName: bNm, dynamic: dyn });
    }
    return webOut;
}

// [vNEXT] Generate web dynamics, map names to existing character ids, drop self-pairs,
// unresolved names, and pairs already present (unordered). Returns the count added.
async function runWizardWebBatch(count: number, sourceChatIds: string[]): Promise<number> {
    let allChars = await loadAllCharacters();
    let pairs = await generateWebBatch(count, sourceChatIds);
    if (pairs.length === 0) return 0;
    let web = await loadNpcWeb();
    let webMade = 0;
    for (let wp of pairs) {
        let aId = findWizardCharIdByName(allChars, wp.aName);
        let bId = findWizardCharIdByName(allChars, wp.bName);
        if (!aId || !bId || aId === bId) continue;
        let already = web.some(function(l) { return (l.charA_id === aId && l.charB_id === bId) || (l.charA_id === bId && l.charB_id === aId); });
        if (already) continue;
        web.push({ id: api.v1.uuid(), charA_id: aId, charB_id: bId, dynamic: (wp.dynamic || '').substring(0, 300) });
        webMade++;
    }
    if (webMade > 0) await saveNpcWeb(web);
    return webMade;
}

// [vNEXT] Regenerate the dynamic sentence on ONE existing web link in place (no new link).
async function regenerateWebLink(linkId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let web = await loadNpcWeb();
    let link = web.find(function(l) { return l.id === linkId; });
    if (!link) return null;
    let wa = allChars.find(function(c) { return c.id === link.charA_id; });
    let wb = allChars.find(function(c) { return c.id === link.charB_id; });
    if (!wa || !wb) return null;
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let regSys = [
        'You are writing the charged bilateral dynamic between "' + wa.name + '" and "' + wb.name + '" in a story.',
        'State their relationship in one concrete sentence — friction, history, or asymmetry. Avoid bland pairings.',
        'Output ONLY the single sentence. No names prefix, no label, no markdown.'
    ].join('\n\n');
    let regUsr: string[] = [];
    if (ctx.trim()) regUsr.push(ctx);
    if (hint && hint.trim()) regUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    regUsr.push('Write the dynamic between "' + wa.name + '" and "' + wb.name + '" now.');
    let regRaw = '';
    try { regRaw = await executeYoinkGeneration([{ role: 'system', content: regSys }, { role: 'user', content: regUsr.join('\n\n') }], { tag: 'webLinkRegen:' + wa.name + '-' + wb.name }); }
    catch (eWebReg) { api.v1.error('[AE:wizard] web regen failed:', eWebReg); return null; }
    let regTxt = (regRaw || '').trim();
    if (!regTxt) return null;
    let web2 = await loadNpcWeb();
    let t2 = web2.find(function(l) { return l.id === linkId; });
    if (t2) { t2.dynamic = regTxt.substring(0, 300); await saveNpcWeb(web2); }
    return regTxt;
}

// [vNEXT] Generate a batch of narrative-thread descriptors. Each is a short name, a
// story state (locked/active/completed), and a 1-2 sentence current-situation hook.
// Parsed from labelled NAME:/STATE:/DESC: blocks. Records are created in runWizard...Batch.
async function generateNarrativeBatch(count: number, sourceChatIds: string[]): Promise<{ name: string; state: string; description: string }[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let narrIdx = await loadEntityIndex();
    let narrExisting = narrIdx.filter(function(n) { return n.type === 'narrative'; }).map(function(n) { return n.name; }).filter(Boolean);

    let narrSys: string[] = [
        'You are a dramaturg outlining the plot threads of a story — the quests, mysteries, conflicts, and obligations that will drive play.',
        'Produce EXACTLY ' + count + ' distinct narrative threads that fit the world and connect to the established cast and tensions.',
        'For each thread give a short evocative NAME, a STATE, and a DESC of one to two sentences stating the thread\'s current situation and what it pushes the player toward — concrete and unresolved, never a summary of how it ends.',
        'STATE must be exactly one of: locked (set up but not yet in play), active (currently driving the story), completed (already resolved). Most opening threads are "locked" or "active".',
        'CRITICAL RULE: DO NOT use any markdown, bolding, or bullet points. Output plain text only.'
    ];
    if (narrExisting.length) narrSys.push('These threads ALREADY EXIST — do NOT recreate, rename, or duplicate them:\n' + narrExisting.map(function(n) { return '- ' + n; }).join('\n'));
    narrSys.push('FORMAT: for each thread output exactly:\nNAME: <short thread name>\nSTATE: <locked|active|completed>\nDESC: <1-2 concrete sentences>\nSeparate threads with a line containing only ---');
    narrSys.push('Output ONLY the threads in that format. No preamble, no numbering, no commentary.');

    let narrUsr: string[] = [];
    if (ctx.trim()) narrUsr.push(ctx);
    narrUsr.push('Generate ' + count + ' narrative threads now.');

    let narrRaw = '';
    try { narrRaw = await executeYoinkGeneration([{ role: 'system', content: narrSys.join('\n\n') }, { role: 'user', content: narrUsr.join('\n\n') }], { tag: 'narrativeBatch' }); }
    catch (eNarrGen) { api.v1.error('[AE:wizard] narrative batch generation failed:', eNarrGen); return []; }

    let narrOut: { name: string; state: string; description: string }[] = [];
    let narrChunks = (narrRaw || '').split(/\n-{3,}\n/);
    for (let nch of narrChunks) {
        let nNameMatch = nch.match(/NAME:\s*(.+)/i);
        let nStateMatch = nch.match(/STATE:\s*(\w+)/i);
        let nDescMatch = nch.match(/DESC:\s*([\s\S]+)/i);
        if (!nNameMatch) continue;
        let nName = nNameMatch[1].trim();
        let nState = nStateMatch ? nStateMatch[1].trim().toLowerCase() : 'locked';
        let nDesc = nDescMatch ? nDescMatch[1].trim() : '';
        nDesc = nDesc.replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        if (nName) narrOut.push({ name: nName, state: nState, description: nDesc });
    }
    return narrOut;
}

// [vNEXT] Create top-level narrative-thread entities from a generated batch. Mirrors the
// Drama tab's manual "+ New Thread" path exactly (entity only, no lorebook entry). The
// existing narrative tree editor handles nesting and state changes afterward.
async function runWizardNarrativesBatch(count: number, sourceChatIds: string[]): Promise<number> {
    let items = await generateNarrativeBatch(count, sourceChatIds);
    let narrCreated = 0;
    for (let nit of items) {
        if (!nit.name) continue;
        let nEnt = makeDefaultEntity(nit.name);
        nEnt.type = 'narrative';
        let nSt = (nit.state || 'locked');
        nEnt.storyState = (nSt === 'active' || nSt === 'completed') ? nSt as any : 'locked';
        nEnt.description = nit.description || '';
        nEnt.narrativeParentId = null;
        await saveEntity(nEnt);
        narrCreated++;
    }
    return narrCreated;
}

// [vNEXT] Add a single blank top-level narrative thread (rename + ⚡ Regen its situation).
async function addBlankWizardNarrative(): Promise<string> {
    let blankEnt = makeDefaultEntity('New Thread');
    blankEnt.type = 'narrative';
    blankEnt.storyState = 'locked';
    blankEnt.narrativeParentId = null;
    await saveEntity(blankEnt);
    return blankEnt.id;
}

// [vNEXT] Regenerate ONE narrative thread's situation description in place.
async function regenerateNarrativeThread(entId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let nEntity = await loadEntity(entId);
    if (!nEntity || nEntity.type !== 'narrative') return null;
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let nSys = [
        'You are writing the current situation of the narrative thread "' + nEntity.name + '" in a story.',
        'State in one to two concrete sentences what this thread is and what it pushes the player toward right now — unresolved, never a summary of how it ends.',
        'Output ONLY the description prose. No name prefix, no label, no markdown.'
    ].join('\n\n');
    let nUsr: string[] = [];
    if (ctx.trim()) nUsr.push(ctx);
    if (hint && hint.trim()) nUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    nUsr.push('Write the situation for "' + nEntity.name + '" now.');
    let nRaw = '';
    try { nRaw = await executeYoinkGeneration([{ role: 'system', content: nSys }, { role: 'user', content: nUsr.join('\n\n') }], { tag: 'narrativeRegen:' + nEntity.name }); }
    catch (eNarrReg) { api.v1.error('[AE:wizard] narrative regen failed:', eNarrReg); return null; }
    let nTxt = (nRaw || '').trim();
    if (!nTxt) return null;
    let nFresh = await loadEntity(entId);
    if (nFresh) { nFresh.description = nTxt; await saveEntity(nFresh); }
    return nTxt;
}



// ── Emotion Resolution ────────────────────────────────────────────────────────
// [CHANGE] Added from AI engine. Normalises freeform model output to the
// canonical 24-state list used by bridge portrait selection and direct chat.

function resolveEmotion(raw: any): string {
    if (!raw) return 'neutral';
    const key = String(raw).toLowerCase().trim().replace(/[^a-z_]/g, '');
    return EMOTION_MAP[key] || 'neutral';
}

// ── Entity Factory ────────────────────────────────────────────────────────────

function makeDefaultEntity(name: string): EntityRecord {
    // Returns a new EntityRecord with all required fields initialised to safe defaults.
    // callers typically override type, parentId, and description immediately after.
    return {
        id: generateId(),
        name: name,
        type: 'location',
        parentId: null,
        narrativeParentId: null,
        storyState: 'locked',
        description: '',
        atmosphere: '',
        state: 'default',
        stateDescriptions: { 'default': '' },
        connectedEntityIds: [],
        presentCharacterIds: [],
        // [CE-STRIP v2.1.5] actions/rules/skillBonuses/showActionWidget/isVehicle/gated removed — dead Actions remnants.
        // encounters: removed v0.9.25 E4
        inventoryIds: [],
        notes: '',
        knowledgeString: '',
        lorebookTags: [],
        lorebookText: '',
        locationVisuals: '',
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
}

// ── Character Factory ─────────────────────────────────────────────────────────

function makeDefaultCharacter(name: string, cfg: GlobalConfig): CharacterRecord {
    // Returns a new CharacterRecord with all required fields initialised.
    // [CHANGE] New visual fields initialised with safe empty/numeric defaults.
    // avatarWidth/Height default to 1024×1024 (square) so new records never have
    // undefined dimensions when the bridge constructs image generation requests.
    const char: CharacterRecord = {
        id: api.v1.uuid(),
        name: name,
        conceptDump: '',
        nicknames: [],
        species: '',
        age: '',
        gender: '',
        occupationRole: '',
        briefDescription: '',
        // [CHANGE] portraitKey omitted — no longer part of CharacterRecord
        // Visual identity (image generation)
        visuals: '',
        uc: '',
        sceneVisuals: '',
        avatarVisuals: '',
        avatarWidth: 1024,
        avatarHeight: 1024,
        avatarSeed: 0,
        // Flags
        scenePresent: false,
        active: true,
        followCamera: false,   // [v2.89.0 FOLLOW-CAM]
        pattern: '',           // [v2.98.0 PATTERN-STORED]
        lorebookEntryId: undefined,
        featuredForEphemeral: false,
        // Static narrative
        physicalDescription: '',
        voiceAndMannerisms: '',
        personalityCore: '',
        background: '',
        customFieldValues: {},
        coreValues: [],
        // Relationships and hooks
        position: { targetId: '', targetName: '', shape: '', standing: '' },  // [v2.92.0 POSITION]
        hooks: [],
        activeConditions: [],  // [v2.7.0 CONDITIONS]
        // Dynamic state
        ephemeral: null,
        ephemeralHistory: [],
        lastEphemeralGen: 0,  // [v0.9.24 E1]
        lastEphemeralTokens: 0, // [v2.54.0]
        lastHookGen: 0,
        lastHookTokens: 0, // [v2.54.0]
        // Equipment and resources
        equippedItemIds: [],
        charFactionRelationships: {},
        // Sheet
        sheetValues: {},
        // Engine flags
        charContextEnabled: true,
        autoThoughtsEnabled: cfg.autoThoughtsDefault,
        hooksEnabled: true,
        lastTokenEstimate: 0,
        // World graph
        entityId: undefined,
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
    return char;
}

// ============================================================================
// SECTION 4b — NATIVE MODAL HELPERS
// The last three native UIPart constructs in the file, kept because they have
// live callers outside any deleted surface. They were previously buried inside
// SECTION 18 (bridge messaging), which they have nothing to do with.
//
//   openEngineModal    wraps api.v1.ui.modal.open and tells the bridge to hide
//                      behind it. Use this, never api.v1.ui.modal.open directly.
//   openPickerModal    the one generic list-picker modal. ONE live caller left
//                      (openDynamicRankPicker); see the CAPABILITY WITHOUT A DOOR
//                      note in the file header.
//
// Everything else the author touches is a jsx surface (SECTIONS 28-37).
// ============================================================================

// openEngineModal — wraps api.v1.ui.modal.open to signal the bridge.
// Bridge adds ae-behind-modal class (display:none) on OPENED and removes on CLOSED.
// Use this instead of api.v1.ui.modal.open directly throughout the engine.
async function openEngineModal(opts: any): Promise<any> {
    // [FIX] Was calling openEngineModal(opts) recursively — infinite recursion.
    // Corrected to call api.v1.ui.modal.open(opts) which is the actual NAI API.
    broadcastToTM('AE_MODAL_OPENED', {}).catch(function() {});
    let handle: any;
    try {
        handle = await api.v1.ui.modal.open(opts);
    } catch (modalErr) {
        broadcastToTM('AE_MODAL_CLOSED', {}).catch(function() {});
        throw modalErr;
    }
    if (handle && handle.closed) {
        handle.closed.then(function() {
            broadcastToTM('AE_MODAL_CLOSED', {}).catch(function() {});
        });
    }
    return handle;
}


// ============================================================================
// UNIFIED PICKER  —  openPickerModal<T>()
//
// One modal for every "pick one item from a list" selection. Replaces the
// scattered bespoke pickers (parent, entity, resource, skill, lorebook tag, ...)
// so that search, item rendering, and selected-highlighting are consistent and
// changing them all is a one-place edit. Migrate inline pickers onto this as
// they are touched (look for leftover drawSearchablePicker / openEngineModal
// list pickers).
//
// Items render as full-width buttons: "<icon> <label>  ·  <sublabel>".
// A search box appears automatically for lists > 8 (force with searchable:true).
// The picker closes itself first, THEN runs onSelect — matching the prior
// close-then-act pattern so a reopened parent modal never stacks under it.
//
//   await openPickerModal({
//       title:       'Nest Under Entity',
//       items:       allNodes,
//       getId:       function(m) { return m.id; },
//       getLabel:    function(m) { return m.name; },
//       getIcon:     function(m) { return m.icon || '\ud83d\udccd'; },  // optional
//       getSublabel: function(m) { return m.type; },                       // optional
//       selectedId:  ent.parentId || undefined,                            // optional highlight
//       searchable:  true,                                                 // optional
//       pinnedOptions: [{ id: '__none__', label: 'None', icon: '\u2715',
//                         onSelect: function() { ... } }],                 // optional, unfiltered, on top
//       onSelect:    function(item) { ... }                               // required
//   });
// ============================================================================
interface PickerPinnedOption { id: string; label: string; icon?: string; sublabel?: string; onSelect: () => void | Promise<void>; }
interface PickerConfig {
    title: string;
    items: any[];
    getId: (item: any) => string;
    getLabel: (item: any) => string;
    getIcon?: (item: any) => string | undefined;
    getSublabel?: (item: any) => string | undefined;
    selectedId?: string;
    searchable?: boolean;
    pinnedOptions?: PickerPinnedOption[];
    onSelect: (item: any) => void | Promise<void>;
    size?: string;
    emptyText?: string;
}

async function openPickerModal(cfg: PickerConfig): Promise<void> {
    let handle: any = null;
    let term = '';
    const forceSearch = cfg.searchable === true;
    const allowSearch = cfg.searchable !== false && (forceSearch || cfg.items.length > 8);
    const pickerSize  = cfg.size || 'medium';

    // Close the picker first, then run the caller's handler. This mirrors the
    // prior bespoke order (pm.close() then reopen parent modal) so a modal a
    // handler opens never ends up stacked beneath the (still-open) picker.
    function closingCallback(fn: () => void | Promise<void>) {
        return async function() {
            try { if (handle && !handle.isClosed()) await handle.close(); } catch (e0) {}
            try { await fn(); } catch (e) { api.v1.error('[AE:picker] select handler:', e); }
        };
    }

    function itemButton(label: string, selected: boolean, fn: () => void | Promise<void>): UIPart {
        return {
            type: 'button',
            text: label,
            style: {
                width: '100%', marginBottom: '2px', textAlign: 'left', fontSize: '12px',
                backgroundColor: selected ? 'rgba(126,200,160,0.2)' : 'rgba(255,255,255,0.04)',
                border: selected ? '1px solid rgba(126,200,160,0.4)' : '1px solid rgba(255,255,255,0.08)'
            },
            callback: closingCallback(fn)
        };
    }

    function buildContent(): UIPart[] {
        const parts: UIPart[] = [];
        if (allowSearch) {
            parts.push({ type: 'textInput', placeholder: '\ud83d\udd0d Search\u2026', initialValue: term, onChange: async function(v: string) { term = v; await render(); } });
        }
        if (cfg.pinnedOptions && cfg.pinnedOptions.length > 0) {
            for (const po of cfg.pinnedOptions) {
                parts.push(itemButton(aeIconPfx(po.icon) + po.label + (po.sublabel ? '  \u00b7  ' + po.sublabel : ''), false, po.onSelect));
            }
        }
        const needle = term.trim().toLowerCase();
        const filtered = (!allowSearch || needle === '') ? cfg.items : cfg.items.filter(function(it) {
            const lbl = cfg.getLabel(it).toLowerCase();
            const sub = cfg.getSublabel ? (cfg.getSublabel(it) || '').toLowerCase() : '';
            return lbl.indexOf(needle) >= 0 || sub.indexOf(needle) >= 0;
        });
        if ((cfg.pinnedOptions && cfg.pinnedOptions.length > 0) && filtered.length > 0) {
            parts.push({ type: 'text', text: '\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500', style: { opacity: '0.2', fontSize: '10px', textAlign: 'center', marginTop: '4px', marginBottom: '4px' } });
        }
        for (const it of filtered) {
            const itemId = cfg.getId(it);
            const icon = cfg.getIcon ? cfg.getIcon(it) : undefined;
            const sub  = cfg.getSublabel ? cfg.getSublabel(it) : undefined;
            const label = aeIconPfx(icon) + cfg.getLabel(it) + (sub ? '  \u00b7  ' + sub : '');
            const isSel = cfg.selectedId !== undefined && itemId === cfg.selectedId;
            parts.push(itemButton(label, isSel, (function(captured) { return function() { return cfg.onSelect(captured); }; })(it)));
        }
        if (filtered.length === 0) {
            parts.push({ type: 'text', text: cfg.emptyText || 'No matches.', style: { opacity: '0.5', fontSize: '11px', padding: '8px', textAlign: 'center' } });
        }
        return parts;
    }

    async function render() {
        const content = buildContent();
        try {
            if (handle && !handle.isClosed()) { await handle.update({ content: content }); return; }
        } catch (e) { /* handle stale — fall through and (re)open */ }
        handle = await openEngineModal({ id: 'ae-unified-picker', title: cfg.title, size: pickerSize, content: content });
    }

    await render();
}

// ============================================================================
// SECTION 5 — STORAGE: CHARACTER DATA
// All reads and writes for CharacterRecord and the character index.
// Every function here operates on api.v1.storyStorage.
// ============================================================================

// ── Index (CharacterMeta[]) ───────────────────────────────────────────────────
// The index is the lightweight list used for sidebar rendering and fast lookups.
// Full CharacterRecord data lives in individual keys (STORAGE_CHAR_PFX + id).

async function loadIndex(): Promise<CharacterMeta[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_INDEX, []) as CharacterMeta[];
}

async function saveIndex(idx: CharacterMeta[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_INDEX, idx.filter(Boolean));
}

// ── Migration ─────────────────────────────────────────────────────────────────
// migrateCharacter runs every time a CharacterRecord is loaded from storage.
// It forward-migrates old save formats and ensures all required fields exist.
// Safe to call multiple times on the same record.

function migrateCharacter(raw: any, cfg: GlobalConfig): CharacterRecord {
    const d = makeDefaultCharacter('Unnamed', cfg);
    const c = { ...d, ...raw };

    // ── Deprecated field removal ──────────────────────────────────────────────
    delete (c as any).storyRole;
    delete (c as any).conditions;
    delete (c as any).activeConditionId;
    delete (c as any).tier;
    delete (c as any).budgetCap;
    // [CHANGE] portraitKey removed — bridge derives portrait key from char.id directly.
    delete (c as any).portraitKey;
    // [CHANGE] homeLocationId was an unimplemented idea with no read path. Removed.
    delete (c as any).homeLocationId;

    // ── Equipment migration (equippedItemId → equippedItemIds) ────────────────
    if (!c.equippedItemIds) {
        c.equippedItemIds = (c as any).equippedItemId ? [(c as any).equippedItemId] : [];
    }
    delete (c as any).equippedItemId;
    if ('equippedItems' in c) delete (c as any).equippedItems;
    if ('wardrobe' in c) delete (c as any).wardrobe;

    // ── v0.9.3 field guards ───────────────────────────────────────────────────

    if (!c.charFactionRelationships) c.charFactionRelationships = {};

    // [v0.9.89] Migrate #gold → #currency on existing character resource defs.
    if (Array.isArray(c.charResourceDefs)) {
        c.charResourceDefs = c.charResourceDefs.map(function(r: any) {
            if (r.tag === '#gold') {
                return { ...r, id: r.id === 'cres_gold' ? 'cres_currency' : r.id, name: r.name === 'Wealth' ? 'Currency' : r.name, tag: '#currency' };
            }
            return r;
        });
    }

    // ── Structural guards ─────────────────────────────────────────────────────
    if (!c.hooks) c.hooks = [];
    if (!c.ephemeralHistory) c.ephemeralHistory = [];
    // [v2.90.0 MIDRANGE-RETIRE] Mid-range salvage. currentDesire / socialMask /
    // shiftedView were the only author-visible content the layer held, and all three are
    // MODEL-authored prose -- so they migrate into this character's journal (which already
    // folds into their own lorebook entry) rather than into a genesis slot. Writing model
    // text into a genesis slot is the "goal masquerading as a core" mistake the
    // ce_slot_drive -> ce_slot_pursuit migration below already avoids. baselineView is
    // dropped, not salvaged: it was a frozen scaffold for a diff that no longer happens.
    // migrateCharacter is SYNC and charJournalAddBubble is async, so the text is stashed
    // on the record here and drained by loadCharacter; the drain writes the record back
    // without midRange, so this fires exactly once per character.
    if ((c as any).midRange) {
        let _mrSalvage: string[] = [];
        let _mrOld: any = (c as any).midRange;
        if (_mrOld.currentDesire) _mrSalvage.push('Wanted: ' + String(_mrOld.currentDesire).trim());
        if (_mrOld.socialMask)    _mrSalvage.push('Presented as: ' + String(_mrOld.socialMask).trim());
        if (_mrOld.shiftedView)   _mrSalvage.push('Came to believe: ' + String(_mrOld.shiftedView).trim());
        if (_mrSalvage.length > 0) (c as any)._ceMidRangeSalvage = _mrSalvage.join('\n');
    }
    delete (c as any).midRange;
    delete (c as any).midRangeHistory;
    delete (c as any).lastMidrangeGen;
    delete (c as any).lastMidrangeTokens;
    delete (c as any).autoUpdateEnabled;
    
    // Purge old character arc properties from database memory
    delete (c as any).arcEnabled;
    delete (c as any).arcType;
    delete (c as any).developingAspects;
    delete (c as any).arcCurrentState;
    delete (c as any).arcTrajectory;
    delete (c as any).arcEndState;
    delete (c as any).arcMilestones;

    // [v2.92.0 POSITION] primaryRelationship -> position. Six generator-owned fields
    // collapse into two author-owned ones, and the mapping is deliberately lossy in one
    // direction only: prose is CONCATENATED, never dropped, so nothing the author wrote
    // disappears — but nothing is reformatted either, because a migration that rewrites
    // an author's sentences is a migration that loses an argument with them later.
    //
    //   archetype + howItStarted                -> shape     (what it IS)
    //   currentStatus + trajectory + summary    -> standing  (where it stands)
    //   threads[]                               -> character journal, then dropped
    //   milestones[] / stageIndex / archetypeId -> dropped outright
    //
    // Tier starts at 0 and is NOT seeded. _ceSeedPressureFromLegacy wants a numeric
    // 0-100 and primaryRelationship never carried one, so any seed would be a number
    // invented here and then read back as evidence — the one thing the pressure model
    // exists to prevent.
    //
    // targetId cannot be resolved here: migrateCharacter is SYNC and the name->id lookup
    // needs the index. The old free-text targetName is stashed for loadCharacter's async
    // drain instead, same sync-stash / async-drain shape the v2.90.0 mid-range salvage
    // proved out. Both stashes are consumed by the same one-shot write.
    if ((c as any).primaryRelationship && !(c as any).position) {
        let _prOld: any = (c as any).primaryRelationship;
        let _shapeParts: string[] = [];
        if (_prOld.archetype)     _shapeParts.push(String(_prOld.archetype).trim());
        if (_prOld.howItStarted)  _shapeParts.push(String(_prOld.howItStarted).trim());
        let _standParts: string[] = [];
        if (_prOld.currentStatus) _standParts.push(String(_prOld.currentStatus).trim());
        if (_prOld.trajectory)    _standParts.push('What is pushing it: ' + String(_prOld.trajectory).trim() + '.');
        if (_prOld.summary)       _standParts.push('The knot: ' + String(_prOld.summary).trim());
        (c as any).position = {
            targetId: '',
            targetName: String(_prOld.targetName || ''),
            shape: _shapeParts.join(' \u2014 '),
            standing: _standParts.join(' ')
        };
        let _prThreads: string[] = ((_prOld.threads || []) as any[])
            .map(function(t: any) { return String(t || '').trim(); }).filter(Boolean);
        if (_prThreads.length > 0) {
            (c as any)._cePositionSalvage = 'Open threads with '
                + (String(_prOld.targetName || '').trim() || 'their primary relationship') + ':\n'
                + _prThreads.map(function(t: string) { return '- ' + t; }).join('\n');
        }
        if ((c as any).position.targetName) (c as any)._cePositionResolve = (c as any).position.targetName;
    }
    delete (c as any).primaryRelationship;
    delete (c as any).relationshipHistory;
    delete (c as any).lastArcGen;
    delete (c as any).lastArcTokens;
    if (!(c as any).position) (c as any).position = { targetId: '', targetName: '', shape: '', standing: '' };
    // [v2.146.0 HOOK-TARGETID] Hook target migration. NO STORAGE PASS NEEDED: an absent
    // targetId reads as '', which is the legal unresolved state. The ONE legacy encoding
    // that must not survive is targetName === '__player__' — a raw id sitting in the name
    // slot, which two generation-path readers were feeding to the model verbatim. It moves
    // to the id slot here and the name is left empty for _ceHookTargetLabel to resolve
    // against the live protagonist name, which is more correct than the string ever was.
    if (Array.isArray((c as any).hooks)) {
        for (var _hkI = 0; _hkI < (c as any).hooks.length; _hkI++) {
            var _hk: any = (c as any).hooks[_hkI];
            if (!_hk) continue;
            if (String(_hk.targetName || '') === '__player__') { _hk.targetId = '__player__'; _hk.targetName = ''; }
            if (typeof _hk.targetId !== 'string') _hk.targetId = '';
        }
    }
    if (!c.customFieldValues) c.customFieldValues = {};
    // [v2.81.0 CORE-PURSUIT] Drive split into Core (what they will not let go of) and
    // Pursuit (the concrete objective now). The retired ce_slot_drive instruction asked for
    // something "specific enough to act on this scene", so every saved value is
    // pursuit-shaped — it moves to ce_slot_pursuit. Core deliberately starts EMPTY and is
    // re-authored: auto-populating it from a pursuit-shaped string would seed every existing
    // character with a Core that is really a goal, which is the exact failure the split
    // exists to remove. Guarded so a hand-authored Pursuit is never overwritten.
    if (c.customFieldValues['ce_slot_drive'] !== undefined) {
        if (!c.customFieldValues['ce_slot_pursuit']) c.customFieldValues['ce_slot_pursuit'] = c.customFieldValues['ce_slot_drive'];
        delete c.customFieldValues['ce_slot_drive'];
    }
    if (!c.sheetValues) c.sheetValues = {};
    if (!c.conceptDump) c.conceptDump = '';
    // [v2.54.0] The *Tokens stamps below were DELETED here from v0.9.24 through v2.53.x
    // (per-generation cadence had fully replaced per-token). They are reintroduced as an
    // opt-in alternative unit (dynamicIntervalMode === 'tokens') — deleting them would wipe
    // token progress on every character load. Default-to-0 instead, same as the gen stamps.
    if ((c as any).lastEphemeralTokens === undefined) (c as any).lastEphemeralTokens = 0;
    if ((c as any).lastHookTokens      === undefined) (c as any).lastHookTokens      = 0;
    if (c.lastEphemeralGen === undefined) c.lastEphemeralGen = 0;
    if (c.lastHookGen      === undefined) c.lastHookGen      = 0;
    if (c.charContextEnabled === undefined) c.charContextEnabled = true;
    if (c.hooksEnabled === undefined) c.hooksEnabled = true;

    // ── Visual field guards (v1.0.0) ──────────────────────────────────────────
    // [CHANGE] New fields. Old records won't have these; default to empty strings
    // and safe numeric values so bridge image generation never receives undefined.
    if (!c.visuals)       c.visuals       = '';
    if (!c.uc)            c.uc            = '';
    if (!c.sceneVisuals)  c.sceneVisuals  = '';
    if (!c.avatarVisuals) c.avatarVisuals = '';
    if (c.avatarWidth  === undefined || c.avatarWidth  === null) c.avatarWidth  = 1024;
    if (c.avatarHeight === undefined || c.avatarHeight === null) c.avatarHeight = 1024;
    if (c.avatarSeed   === undefined || c.avatarSeed   === null) c.avatarSeed   = 0;

    return c as CharacterRecord;
}

// ── Load ──────────────────────────────────────────────────────────────────────

async function loadCharacter(id: string): Promise<CharacterRecord | null> {
    const raw = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + id);
    if (!raw) return null;
    const cfg = await loadConfig();
    const rec = migrateCharacter(raw, cfg);
    // [v2.90.0 MIDRANGE-RETIRE] One-shot drain of the salvage stashed by
    // migrateCharacter, which is sync and cannot await the journal writer. Written back
    // with storyStorage.set rather than saveCharacter: this is a legacy-field strip, and
    // saveCharacter's index + lorebook rebuild is unnecessary churn on what is often a
    // cold read. After the write, raw no longer carries midRange, so the stash is never
    // set again for this character and the branch is skipped on every later load.
    // [v2.92.0 POSITION] The same drain now also carries the relationship salvage and the
    // targetName -> targetId resolve, because both were stashed by the same sync pass and
    // both are cleared by the same single write-back. Keeping them as one block is what
    // guarantees a character can never end up with the threads journalled but the id
    // unresolved (or vice versa) after a mid-drain failure — either the write lands and
    // every stash is gone, or it does not and the whole thing is retried on next load.
    if ((rec as any)._ceMidRangeSalvage || (rec as any)._cePositionSalvage || (rec as any)._cePositionResolve) {
        const _drainMid = String((rec as any)._ceMidRangeSalvage || '');
        const _drainPos = String((rec as any)._cePositionSalvage || '');
        const _drainTgt = String((rec as any)._cePositionResolve || '');
        delete (rec as any)._ceMidRangeSalvage;
        delete (rec as any)._cePositionSalvage;
        delete (rec as any)._cePositionResolve;
        try {
            // The old target was free text typed or picked by NAME. '__player__' was
            // already a sentinel and maps straight across; anything else is matched
            // case-insensitively against the index. A miss leaves targetId empty on
            // purpose — see CharPosition: an unresolved target is a working state, and
            // guessing at one would invent a link the author never drew.
            if (_drainTgt && !((rec as any).position || {}).targetId) {
                if (_drainTgt === '__player__') {
                    (rec as any).position.targetId = '__player__';
                } else {
                    const _drainIdx = await loadIndex();
                    const _drainHit = _drainIdx.find(function(m: any) {
                        return m && String(m.name || '').toLowerCase() === _drainTgt.toLowerCase();
                    });
                    if (_drainHit) (rec as any).position.targetId = _drainHit.id;
                }
            }
            if (_drainMid) await charJournalAddBubble(id, _drainMid);
            if (_drainPos) await charJournalAddBubble(id, _drainPos);
            await api.v1.storyStorage.set(STORAGE_CHAR_PFX + id, rec);
        } catch (eSalvage) { api.v1.error('[AE:engine] legacy salvage drain:', eSalvage); }
    }
    return rec;
}


async function loadAllCharacters(): Promise<CharacterRecord[]> {
    // [CHANGE] Performance fix: original called loadCharacter() per character,
    // which called loadConfig() per character — N+1 storage reads for N characters.
    // Now loads config once and passes it into migrateCharacter directly.
    const idx = await loadIndex();
    const cfg = await loadConfig();
    const chars = await Promise.all(
        idx.filter(Boolean).map(async function(m) {
            try {
                const raw = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + m.id);
                return raw ? migrateCharacter(raw, cfg) : null;
            } catch (e) {
                api.v1.error('[AE] loadAllCharacters: failed to load char ' + m.id, e);
                return null;
            }
        })
    );
    return chars.filter(Boolean) as CharacterRecord[];
}

// ── Save ──────────────────────────────────────────────────────────────────────

async function saveCharacter(char: CharacterRecord): Promise<void> {
    const cfg = await loadConfig();

    // Derive equipped item names from equippedItemIds for the index
    const equippedItemNames: string[] = [];
    for (const itemId of (char.equippedItemIds || [])) {
        try {
            const itemEnt = await loadEntity(itemId);
            if (itemEnt) equippedItemNames.push(itemEnt.name);
        } catch (ignoredErr) { /* non-fatal — item may not exist yet */ }
    }

    // Derive the character's current location from their entity body's parentId.
    // This is the single source of truth for character location — not a stored field.
    let currentLocationId: string | undefined = undefined;
    if (char.entityId) {
        try {
            const charEntBody = await loadEntity(char.entityId);
            if (charEntBody) currentLocationId = charEntBody.parentId !== null ? charEntBody.parentId : undefined;
        } catch (ignoredErr) { /* non-fatal — entity may not exist yet */ }
    }

    // Build the lightweight index entry
    // [CHANGE] portraitKey removed from CharacterMeta — bridge derives from char.id
    const meta: CharacterMeta = {
        id: char.id,
        name: char.name,
        isProtagonist: char.isProtagonist,
        entityId: char.entityId,
        hasCriticalHook: !!(char.hooks && char.hooks.some(function(h) { return !h.resolved && h.pressureLevel >= 85; })),
        scenePresent: char.scenePresent,
        active: char.active,
        briefDescription: char.briefDescription,
        species: char.species,
        age: char.age,
        occupationRole: char.occupationRole,
        lastThought: char.ephemeral ? char.ephemeral.compressedLine : undefined,
        lastTokenEstimate: char.lastTokenEstimate,
        equippedItemNames: equippedItemNames.length > 0 ? equippedItemNames : undefined,
        currentLocationId: currentLocationId,
        isStatic: !!((char as any).isStatic),   // [v0.9.31 DYN1] propagate so card reads correct state
        dynamicPriorityRank: (typeof (char as any).dynamicPriorityRank === 'number' && (char as any).dynamicPriorityRank > 0) ? (char as any).dynamicPriorityRank : undefined  // [vNEXT] propagate rank so the cap sorts off the index
    };

    const idx = await loadIndex();
    const existingIdx = idx.findIndex(function(m) { return m.id === char.id; });
    if (existingIdx >= 0) { idx[existingIdx] = meta; } else { idx.push(meta); }

    await saveIndex(idx);
    await api.v1.storyStorage.set(STORAGE_CHAR_PFX + char.id, char);

    // Keep cfg.protagonistName in sync so __player__ resolves correctly in injections
    if (char.isProtagonist && char.name) {
        try {
            const cfgSync = await api.v1.storyStorage.get(STORAGE_CONFIG) as any;
            if (cfgSync && cfgSync.protagonistName !== char.name) {
                cfgSync.protagonistName = char.name;
                await api.v1.storyStorage.set(STORAGE_CONFIG, cfgSync);
            }
        } catch (e) { /* non-fatal */ }
    }

    // [CHANGE] Queue a debounced broadcast to keep the bridge's character visual
    // cache in sync. Defined in Section 18. Batches rapid sequential saves.
    queueCharacterDataBroadcast();
}

// ── Delete ────────────────────────────────────────────────────────────────────

async function deleteCharacter(id: string): Promise<void> {
    const char = await loadCharacter(id);
    if (char && char.entityId) {
        await deleteEntity(char.entityId); // Scrub the physical body from the world
    }
    // [v2.123.0 IMG-SLOT-CASCADE-FIX] Read the REAL slot list before anything is deleted.
    // The cascade below used to ask the bridge's own [DEAD] _getEmoSlots for which portrait
    // keys to sweep — a table nothing has written to since IMG-SLOTS moved list ownership
    // engine-side, so a custom slot added through the Images drill was invisible to it and
    // its saved image survived the character's deletion as an IndexedDB orphan. This file IS
    // now the source of truth for the slot list (loadCharImgSlots, same load-modify-persist
    // path the drill itself reads), so it can hand the bridge the real list directly instead
    // of the bridge re-deriving a stale one. Read failures fall back to an empty array rather
    // than throwing — a character whose slot record never saved still finishes deleting; the
    // bridge's own [DEAD] fallback below covers that case exactly as it did before this patch.
    var imgSlotsForCascade: string[] = [];
    try { imgSlotsForCascade = (await loadCharImgSlots(id)).slots || []; }
    catch (e) { api.v1.error('[AE:imgslots] cascade slot read failed:', e); }
    await api.v1.storyStorage.remove(STORAGE_CHAR_PFX + id);
    // The engine's OWN slot-list record is a second, separate orphan from the same gap —
    // storyStorage rather than IndexedDB, but unowned by anything once the character is
    // gone. Swept here rather than left for a future pass since it is the same feature and
    // costs nothing extra now that the record has already been read above.
    try { await api.v1.storyStorage.remove(STORAGE_CHAR_IMG_PFX + id); } catch (e) { /* non-fatal */ }
    const idx = await loadIndex();
    await saveIndex(idx.filter(function(m) { return m.id !== id; }));
    
    // Dispatch cascade event to bridge to clean up IndexedDB assets. `slots` is the real,
    // current list (Avatar + Snapshot + 24 canonical + any custom slots) — the bridge
    // handler prefers this and only falls back to its own enumeration when it is absent,
    // so an older engine build talking to this bridge still cascades exactly as before.
    await broadcastToTM('AE_DELETE_PORTRAIT_CASCADE', { charId: id, slots: imgSlotsForCascade });
}


// ============================================================================
// SECTION 6 — STORAGE: ENTITY DATA
// All reads and writes for EntityRecord and the entity index.
// Entities are the world graph: locations, items, narrative nodes, character bodies.
// ============================================================================

// ── Index (EntityMeta[]) ──────────────────────────────────────────────────────

async function loadEntityIndex(): Promise<EntityMeta[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_INDEX, []) as EntityMeta[];
}

async function saveEntityIndex(idx: EntityMeta[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, idx.filter(Boolean));
}

// ── Migration ─────────────────────────────────────────────────────────────────
// migrateEntity runs every time an EntityRecord is loaded from storage.
// Handles all legacy field shapes from prior engine versions.

function migrateEntity(raw: any): EntityRecord {
    const ent = raw as any;
    if (!ent.id) ent.id = generateId();
    if (!ent.name) ent.name = 'Unnamed Entity';

    // Force legacy spatial sub-types into the current functional type system
    if (!ent.type || ['interior', 'exterior', 'transit', 'abstract'].includes(ent.type)) {
        ent.type = 'location';
    }
    // Migrate legacy shop type → narrative
    if (ent.type === 'shop') ent.type = 'narrative';

    if (ent.narrativeParentId === undefined) ent.narrativeParentId = null;
    if (ent.parentId === undefined) ent.parentId = null;
    if (!ent.storyState) ent.storyState = 'locked';

    // [v0.9.25 E4] Encounter migration removed; delete stale field from old saves
    delete (ent as any).encounters;

    // [CE-STRIP v2.1.5] rules/skillBonuses/isVehicle field guards and the
    // migrateEntityAction() flat-action migration removed — dead Actions remnants.

    if (!ent.description) ent.description = '';
    if (!ent.atmosphere) ent.atmosphere = '';
    if (!ent.state) ent.state = 'default';
    if (!ent.stateDescriptions) ent.stateDescriptions = {};

    // Migrate old connection array key to current key
    ent.connectedEntityIds = ent.connectedEntityIds || ent.connectedLocationIds || [];
    delete ent.connectedLocationIds;

    if (!ent.presentCharacterIds) ent.presentCharacterIds = [];

    // Remove legacy commerce fields
    delete ent.price;
    if (!ent.inventoryIds) ent.inventoryIds = [];

    if (!ent.notes) ent.notes = '';
    if (!ent.lorebookTags) ent.lorebookTags = [];
    if (ent.lorebookText === undefined) ent.lorebookText = '';
    if (ent.locationVisuals === undefined) ent.locationVisuals = '';
    if (!ent.tagSubscriptions) ent.tagSubscriptions = [];
    if (!ent.createdAt) ent.createdAt = Date.now();
    if (!ent.updatedAt) ent.updatedAt = Date.now();

    // Filter null entries in all arrays for safety
    ent.connectedEntityIds  = ent.connectedEntityIds.filter(Boolean);
    ent.presentCharacterIds = ent.presentCharacterIds.filter(Boolean);

    return ent as EntityRecord;
}

// [CE-STRIP v2.1.5] migrateEntityAction() removed via brace-matched deletion.

// ── Load ──────────────────────────────────────────────────────────────────────

async function loadEntity(id: string): Promise<EntityRecord | null> {
    const raw = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + id, null);
    return raw ? migrateEntity(raw) : null;
}

// ── Save ──────────────────────────────────────────────────────────────────────

async function saveEntity(ent: EntityRecord): Promise<void> {
    ent.updatedAt = Date.now();
    // [v0.9.24 E3] Auto-clear tracking when a narrative is completed.
    // [v2.103.0 CE-SWEEP] The narrative-completed hook here existed only to clear the
    // tracking flag and toast. Nothing else lived in it, so the whole branch is gone.
    await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + ent.id, ent);

    const idx = await loadEntityIndex();
    const meta: EntityMeta = {
        id: ent.id,
        name: ent.name,
        type: ent.type,
        parentId: ent.parentId,
        narrativeParentId: ent.narrativeParentId,
        storyState: ent.storyState,
        childCount: idx.filter(function(m) { return m.parentId === ent.id; }).length,
        presentCharacterCount: ent.presentCharacterIds.filter(Boolean).length,
        state: ent.state,
        icon: ent.icon || undefined
        // [CE-STRIP v2.1.5] gated/isVehicle/hasGlobalAutoTrigger removed — dead Actions/Travel remnants.
    };

    const i = idx.findIndex(function(m) { return m.id === ent.id; });
    if (i >= 0) { idx[i] = meta; } else { idx.push(meta); }
    await saveEntityIndex(idx);

    // [CHANGE] Queue a debounced scene state broadcast. Any entity change — location
    // state, available actions, connection changes — may affect the HUD. Debouncing
    // at 200ms coalesces the storm of saves during bulk operations like imports.
    // Defined in Section 18. No-ops if bridge is not yet connected.
    queueSceneStateBroadcast();
}

// [UNIFY] migrateFactionArgsOnEntities removed - Faction standing actions are obsolete.

// ── Delete ────────────────────────────────────────────────────────────────────

async function deleteEntity(id: string): Promise<void> {
    await api.v1.storyStorage.remove(STORAGE_ENTITY_PFX + id);
    const idx = await loadEntityIndex();

    // Collect orphaned children BEFORE removing the entry from the index,
    // since we need their parentId reference while it still points to the deleted entity.
    const orphaned = idx.filter(function(m) { return m.parentId === id; });

    await saveEntityIndex(idx.filter(function(m) { return m.id !== id; }));

    // Re-parent any child entities to the world root (null parent).
    // [CHANGE] Fixes a pre-existing dead-code bug: the original code checked
    // CharacterRecord.currentLocationId which is never stored on that type
    // (it is derived and only stored in CharacterMeta). Now correctly iterates
    // child entities via their parentId relationship in the entity index.
    for (const m of orphaned) {
        try {
            const child = await loadEntity(m.id);
            if (child) { child.parentId = null; await saveEntity(child); }
        } catch (ignoredErr) { /* non-fatal */ }
    }
}

// ── Copy ──────────────────────────────────────────────────────────────────────

async function copyEntity(id: string, deep: boolean = false): Promise<void> {
    try {
        const src = await loadEntity(id);
        if (!src) return;

        const newId = generateId();
        const copy: EntityRecord = JSON.parse(JSON.stringify(src));

        copy.id = newId;
        copy.name = 'Copy of ' + src.name;
        copy.createdAt = Date.now();
        copy.updatedAt = Date.now();

        // Clear runtime state — copy starts fresh, not carrying over scene presence
        copy.connectedEntityIds = [];
        copy.presentCharacterIds = [];

        // [v0.9.25 E4] Encounter range copy removed
        if (false && (copy as any).encounters) {
            (copy as any).encounters.ranges = ((copy as any).encounters.ranges || []).map(function(r) {
                return Object.assign({}, r, { id: generateId(), triggered: false });
            });
        }

        await saveEntity(copy);

        if (deep) {
            const allMeta = await loadEntityIndex();
            const children = allMeta.filter(function(m) { return m.parentId === src.id; });

            for (const childMeta of children) {
                const childSrc = await loadEntity(childMeta.id);
                if (!childSrc) continue;

                const childCopy: EntityRecord = JSON.parse(JSON.stringify(childSrc));
                childCopy.id = generateId();
                childCopy.name = childSrc.name;
                childCopy.parentId = newId;
                childCopy.createdAt = Date.now();
                childCopy.updatedAt = Date.now();
                childCopy.connectedEntityIds = [];
                childCopy.presentCharacterIds = [];
                if (false && (childCopy as any).encounters) {
                    (childCopy as any).encounters.ranges = ((childCopy as any).encounters.ranges || []).map(function(r) {
                        return Object.assign({}, r, { id: generateId(), triggered: false });
                    });
                }
                await saveEntity(childCopy);
            }

            api.v1.ui.toast('Copied "' + src.name + '" with ' + children.length + ' child(ren).', { type: 'success' });
        } else {
            api.v1.ui.toast('Copied "' + src.name + '".', { type: 'success' });
        }

        queueSceneStateBroadcast();

    } catch (e) {
        api.v1.error('[AE] copyEntity:', e);
        api.v1.ui.toast('Copy failed.', { type: 'error' });
    }
}

// ── History (recent location breadcrumb) ─────────────────────────────────────

async function loadEntityHistory(): Promise<string[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_HISTORY, []) as string[];
}

async function saveEntityHistory(ids: string[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_ENTITY_HISTORY, ids.slice(0, 10));
}


// ============================================================================
// SECTION 7 — STORAGE: GLOBAL CONFIG
// Single GlobalConfig record per story. Governs engine intervals, field labels,
// resources, factions, skill modifiers, and generation style.
// ============================================================================

// [CE-STRIP v2.0.x] DEFAULT_TIME_BANDS removed — Clock/Calendar cut.

function makeDefaultConfig(): GlobalConfig {
    return {
        contextTemplates: JSON.parse(JSON.stringify(DEFAULT_TEMPLATES)),
        lorebookTemplates: JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_TEMPLATES)),  // [v2.7.0 CONDITIONS]
        lorebookFields: JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_FIELDS)),  // [v2.9.0 LOREFOLD]
        interfaceMode: 'native',   // [v0.9.9.6] default to the native HUD; bridge is opt-in
        thoughtIntervalGens: 2,    // [v0.9.24 E1] ephemeral every 2 generations
        hookIntervalGens: 6,       // hooks every 6 generations
        dynamicIntervalMode: 'gens', // [v2.54.0] default cadence unit (per-generation)
        thoughtIntervalTokens: 500,  // [v2.54.0] token-mode intervals — scaled ~250 tok/gen from the *Gens above
        hookIntervalTokens: 1500,
        totalGenerations: 0,
        ephemeralCap: 3,
        maxGenerationsPerTurn: 1,  // [v2.89.0 TURN-CAP] 0 = unlimited
        maxDynamicCharacters: 0,   // [vNEXT] 0 = no cap (all present dynamic chars process)
        sheetCategories: [], // [PATCH] DEFAULT_SHEET_CATEGORIES removed; full Sheet Categories cut deferred to its own pass.
        autoThoughtsDefault: true,
        showFieldHeaders: true,
        generalStyle: DEFAULT_GENERAL_STYLE,
        fieldLabels: {},
        fieldInstructions: {},
        fieldBudgets: {},
        customStaticFields: [],
        relationshipArchetypes: [...DEFAULT_REL_ARCHETYPES],
        conditions: [...DEFAULT_CONDITIONS],  // [v2.7.0 CONDITIONS]
        species: [],
        factions: [],
        projectName: '',
        projectGenre: '',
        projectConcept: '',
        wizardSections: JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS)),
        defaultBackgroundUrl: '',
        // [CE-STRIP v2.0.x] time* defaults removed — Clock/Calendar cut.
    };
}

// [UNIFY] Action/Rules system removed - Faction standing and rule-arg repair helpers removed.


// [v2.78.0 FACETS] Built-in facet library. Facets are mechanically identical to the four
// slots — same CustomFieldDef shape, same generators, same customFieldValues storage, same
// addField injection, and blanks self-suppress — so there is no facet subsystem, only this
// list and a picker. `slot` groups them in the UI and is presentational only.
//
// These SHIP rather than being imported. The import path still works for author-written
// packs, but making the stock library an import step would have meant every new story
// starts with nothing and the feature is invisible until someone finds a JSON file.
//
// Instructions are compressed relative to the slot instructions: a facet is one small
// specific thing, so each carries a task, a length, and the one cliche it attracts. The
// anti-default clause is not decoration — a narrative-trained model has a strong stock
// answer for nearly every one of these.
const BUILTIN_FACETS: { id: string; slot: string; label: string; placeholder: string; instructions: string; kind?: string }[] = [
    // ══════════════════════════════════════════════════════════════════════════
    // SLOTS — the six-slot character model (schema v0.2). Mechanically identical
    // to facets (same CustomFieldDef shape, same generator, same customFieldValues
    // storage), which is why they live in the same library rather than a parallel
    // one. They differ only in `kind: 'slot'`, which AE_GET_FACET_DEFS filters on so
    // slots never appear in the "+ Add facet" picker — slots are card-driven and
    // (for Resistance/Conduct) pattern-gated, facets are freely addable.
    //
    // Presence / Core / Pursuit are pattern-independent. Resistance and Conduct
    // exist once per pattern; the bridge resolves ce_slot_resist_<pattern> /
    // ce_slot_conduct_<pattern> from the character's chosen pattern.
    // ══════════════════════════════════════════════════════════════════════════

    // ── Fixed slots ──
    { id: 'ce_slot_presence', slot: 'presence', kind: 'slot', label: 'Presence', placeholder: 'What a stranger perceives on first sight…',
      instructions: 'Describe what a stranger perceives on first sight: build and bearing, then skin, hair, and eyes, then voice and the way they move. Two–three sentences, under 60 words. Sweep from silhouette to detail — do not hunt for one striking feature to lead with. Only what is perceivable from outside; no history, no motive. Avoid piercing eyes, easy grace, "commands attention," and invented oddities such as unusual hands, unnatural height, or scars unless the seed material establishes one.' },
    { id: 'ce_slot_core', slot: 'core', kind: 'slot', label: 'Core', placeholder: 'The one thing they will not let go of…',
      instructions: 'State the one thing this character will not let go of — the person, belief, wound, or hunger everything else bends around. One sentence, under 30 words. It must still be true if every current plan fails. Not a goal with an endpoint and not a personality trait. Avoid "freedom," "family," and anything they could simply achieve and be finished with.' },
    { id: 'ce_slot_pursuit', slot: 'pursuit', kind: 'slot', label: 'Pursuit', placeholder: 'What they are actively going after right now…',
      instructions: 'State what this character is actively going after right now — the concrete objective they could be seen working on this scene. One–two sentences, under 40 words. Name the object, not the value: "get her brother’s name off the ledger," not "seeks justice." Phrase it so it can plainly succeed or fail. Leave empty if they are chasing nothing; that is a complete character, not an unfinished one. Avoid restating the Core and avoid revenge unless the profile earns it.' },

    // ── Resistance — one per pattern. What holding the Core COSTS them. ──
    { id: 'ce_slot_resist_contradiction', slot: 'resistance', kind: 'slot', label: 'Resistance · Contradiction', placeholder: 'The second thing also true, pulling against the Core…',
      instructions: 'Name the second thing that is also true of them and pulls against the Core — a competing truth, not a flaw. Under 40 words. Both halves must show in behaviour and neither may be the "real" one. Avoid "tough but caring" and pairings that resolve too neatly.' },
    { id: 'ce_slot_resist_wantneed', slot: 'resistance', kind: 'slot', label: 'Resistance · Want / Need', placeholder: 'The substitute they chase instead…',
      instructions: 'State the substitute this character chases in place of the Core — what they sincerely believe will settle it, and why it cannot. Under 40 words. They must endorse the belief fully. Avoid making them self-aware about it, and avoid substitutes so obviously wrong that no one would hold them.' },
    { id: 'ce_slot_resist_defense', slot: 'resistance', kind: 'slot', label: 'Resistance · Defense', placeholder: 'What holding the Core exposes them to…',
      instructions: 'Name what holding the Core exposes them to — the thing they cannot afford to have seen. Under 40 words. Specific, concealable, and live now rather than a past event. Avoid generic trauma and anything already obvious from outside.' },
    { id: 'ce_slot_resist_ruleset', slot: 'resistance', kind: 'slot', label: 'Resistance · Rule set', placeholder: 'The laws they keep, and the one that will break…',
      instructions: 'State two to four laws this character keeps while pursuing the Core, phrased as they would phrase them, then name the one the Core will eventually force them to break. Under 45 words. Rules constrain behaviour; virtues do not. Avoid "never lies" and codes that cost nothing to keep.' },
    { id: 'ce_slot_resist_appetite', slot: 'resistance', kind: 'slot', label: 'Resistance · Appetite', placeholder: 'What they cannot refuse, and the one line they keep…',
      instructions: 'Name what this character cannot refuse and the one thing they will not touch. Under 40 words. The appetite serves or substitutes for the Core; the refusal is the single edge they keep. Sensory and specific. Avoid moralising, and avoid appetites with no line attached.' },
    { id: 'ce_slot_resist_mask', slot: 'resistance', kind: 'slot', label: 'Resistance · Function mask', placeholder: 'The role, and what it forbids…',
      instructions: 'State the role this character performs and what it forbids them from wanting, showing, or admitting — where the Core is the forbidden thing. Under 40 words. The conflict must be live and currently costly. Avoid roles worn lightly enough to forbid nothing.' },

    // ── Conduct — one per pattern. The standing move when the cost comes due. ──
    { id: 'ce_slot_conduct_contradiction', slot: 'conduct', kind: 'slot', label: 'Conduct · Contradiction', placeholder: 'Which side shows, and what brings the other out…',
      instructions: 'Describe which side shows by default and the specific circumstance that brings the other out. Two sentences, under 50 words. Observable behaviour for each side, not feelings. Avoid "the walls come down" and switches that happen for no reason.' },
    { id: 'ce_slot_conduct_wantneed', slot: 'conduct', kind: 'slot', label: 'Conduct · Want / Need', placeholder: 'How they pursue the substitute, and who pays…',
      instructions: 'Describe how they pursue the substitute and who pays for it. Two sentences, under 50 words. Show the pursuit as something others watch happen. Avoid clean success and avoid them learning the lesson on their own.' },
    { id: 'ce_slot_conduct_defense', slot: 'conduct', kind: 'slot', label: 'Conduct · Defense', placeholder: 'The avoidance move, and the tell that leaks…',
      instructions: 'Describe their avoidance move when the sore spot is approached, and the one tell that leaks anyway. Two sentences, under 50 words. Both observable — a deflection and a crack in it. Avoid changing the subject as the only tactic.' },
    { id: 'ce_slot_conduct_ruleset', slot: 'conduct', kind: 'slot', label: 'Conduct · Rule set', placeholder: 'How they keep the rules, and what they do when others do not…',
      instructions: 'Describe how they keep the rules day to day, and what they do when someone breaks one in front of them — enforce, withdraw, or absorb. Two sentences, under 50 words. Visible action, not stated belief. Avoid lecturing as the only response.' },
    { id: 'ce_slot_conduct_appetite', slot: 'conduct', kind: 'slot', label: 'Conduct · Appetite', placeholder: 'The manner of taking, asking, or indulging…',
      instructions: 'Describe how they go after what they want — the manner of taking, asking, or indulging, and how open or sly they are about it. Two sentences, under 50 words. Show it in action. Avoid making them purely predatory or purely restrained.' },
    { id: 'ce_slot_conduct_mask', slot: 'conduct', kind: 'slot', label: 'Conduct · Function mask', placeholder: 'The performance, and the tell that slips…',
      instructions: 'Describe the performance — tone, posture, the phrases they reach for — and the one small physical tell that slips when it costs them. Two sentences, under 50 words. Both observable. Avoid the mask dropping completely; that is a threshold event, not a habit.' },

    // ══════════════════════════════════════════════════════════════════════════
    // FACETS — optional, freely addable, grouped by the slot each one deepens.
    // ══════════════════════════════════════════════════════════════════════════
    // ── Presence ──
    { id: 'ce_fx_signature', slot: 'presence', label: 'Signature detail', placeholder: 'The one thing people describe them by\u2026',
      instructions: 'Name the single physical detail someone would use to describe this character to a stranger. One sentence, under 25 words, concrete and visible. Not a personality trait. Avoid scars, unusual eye colours, and anything already stated elsewhere in the profile.' },
    { id: 'ce_fx_carry', slot: 'presence', label: 'Clothing & carry', placeholder: 'What they wear and what is always on them\u2026',
      instructions: 'Describe what this character wears day to day and the one object always on their person. Two sentences, under 45 words. Say what the clothing is FOR — weather, work, status, concealment. Avoid hooded cloaks, and avoid describing the body itself.' },
    { id: 'ce_fx_scent', slot: 'presence', label: 'Scent & sound', placeholder: 'How they register beyond sight\u2026',
      instructions: 'Describe how this character registers to senses other than sight: what they smell of, and the sound they make moving or being nearby. Two sentences, under 35 words. Ground both in their actual life and work. Avoid generic florals, leather, and woodsmoke unless the profile earns them.' },
    { id: 'ce_fx_condition', slot: 'presence', label: 'Condition', placeholder: 'How their body is doing right now\u2026',
      instructions: 'State how this character\u2019s body is doing at this point in the story: rested or worn, fed or not, whole or carrying something. Present tense, under 35 words. This is a current state and expected to change, so avoid permanent traits and old injuries that no longer affect them.' },
    { id: 'ce_fx_bearing', slot: 'presence', label: 'Bearing', placeholder: 'How they occupy space\u2026',
      instructions: 'Describe how this character occupies space: what they do with their weight when standing still, how much room they take, where they put themselves in a room. Two sentences, under 35 words. Avoid arms crossed, leaning in doorways, and looming.' },

    // ── Drive ──
    { id: 'ce_fx_errand', slot: 'drive', label: 'Immediate errand', placeholder: 'The small task they are on this week\u2026',
      instructions: 'State the small concrete task this character is trying to finish in the next few days. Must be completable on the page. One or two sentences, under 30 words. Not their life goal — the errand. Avoid anything phrased as a quest.' },
    { id: 'ce_fx_ambition', slot: 'drive', label: 'Long ambition', placeholder: 'Where they want to be in ten years\u2026',
      instructions: 'State where this character wants to be in ten years, in the terms they would use themselves. Under 35 words. Concrete and material rather than a virtue. Avoid revenge, redemption, and any goal phrased as freedom, justice, or belonging.' },
    { id: 'ce_fx_forwhom', slot: 'drive', label: 'Who it is for', placeholder: 'The person this is actually about\u2026',
      instructions: 'Name the specific person this character\u2019s pursuit is really about, and what they want from that person that they have not asked for. Two sentences, under 40 words. It may be someone dead, absent, or unaware. Avoid making it about a group or an abstraction.' },
    { id: 'ce_fx_tried', slot: 'drive', label: 'What they have tried', placeholder: 'The approach that already failed\u2026',
      instructions: 'State what this character already tried in pursuit of what they want, how it failed, and why they still believe. Two or three sentences, under 50 words. The failure must be specific and recent enough to still sting.' },

    // [v2.95.0 STUDIO-2] The redesign asks the Pursuit slot a question the library could
    // not answer: what the failure actually costs. 'What they have tried' covers the past
    // attempt, nothing covered the consequence. Without it Pursuit states an aim with no
    // stated downside, and a model has no reason to treat losing it as expensive.
    { id: 'ce_fx_stake', slot: 'drive', label: 'What is at stake', placeholder: 'What happens if they fail this week\u2026',
      instructions: 'State the concrete consequence if this character fails at what they are currently pursuing. One or two sentences, under 40 words. It must be a specific loss to THIS character, not a general disaster \u2014 what they personally forfeit, and to whom. Avoid the world ending.' },

    // ── Position ──
    // [v2.95.0 STUDIO-2] Facets that deepen char.position (v2.92.0). These are ordinary
    // customFieldValues like every other facet and are NOT part of the CharPosition record:
    // position.shape and position.standing are the two fields the pressure tier grades, and
    // adding more prose to that record would mean more surface for the tier to be read
    // against without any of it being classified. These sit alongside it as context instead.
    { id: 'ce_fx_pos_history', slot: 'position', label: 'How it started', placeholder: 'The first thing that happened between them\u2026',
      instructions: 'State the specific event or circumstance that began this relationship, from this character\u2019s side. Two sentences, under 45 words. A concrete occasion rather than a summary of a period.' },
    { id: 'ce_fx_pos_unsaid', slot: 'position', label: 'Never said out loud', placeholder: 'The thing they will not say to them\u2026',
      instructions: 'State the one thing this character will not say to the other person, and what they say instead. Two sentences, under 40 words. It should be sayable in principle \u2014 withheld by choice, not by circumstance.' },
    { id: 'ce_fx_pos_want', slot: 'position', label: 'What they want from them', placeholder: 'What they are really after\u2026',
      instructions: 'State what this character actually wants from the other person, which may not be what they ask for. One or two sentences, under 35 words. Name the want plainly rather than describing the feeling around it.' },

    // [v2.104.0 FACET-TIES] Two gaps the Studio's Position step could not fill. Position
    // itself is ONE other character (char.position is a single record, deliberately — see
    // the v2.92.0 CharPosition note), so a character's group allegiance and their other
    // named ties had nowhere to live except a Background paragraph the model reads as
    // history rather than as live standing.
    //
    // Filed under slot 'position' because that is the Studio's relationships step and
    // `slot` is presentational grouping only. They are ordinary customFieldValues: NOT
    // part of the CharPosition record, NOT gated on both-parties-scene-present, and not
    // graded by any pressure tier — they inject like every other facet.
    { id: 'ce_fx_faction', slot: 'position', label: 'Faction & allegiance', placeholder: 'Who they answer to, and how willingly\u2026',
      instructions: 'Name the group this character belongs to or answers to \u2014 house, crew, guild, unit, family, employer \u2014 their standing inside it, and how willingly they carry it. Two sentences, under 45 words. If they belong to nothing, say what that costs them rather than leaving it blank. Avoid secret societies and shadowy organisations nobody in the story has met.' },
    { id: 'ce_fx_relations', slot: 'position', label: 'Other relationships', placeholder: 'The two or three other people who matter\u2026',
      instructions: 'Name the two or three other people who currently matter to this character and state each tie in a few words \u2014 who they are and what is between them. Under 50 words total. Named individuals with a live connection, not categories and not everyone they have ever met. Do not restate the primary relationship already recorded above.' },

    // ── Resistance ──
    { id: 'ce_fx_secret', slot: 'resistance', label: 'Secret', placeholder: 'Something true they have not told\u2026',
      instructions: 'State something true about this character that they have not told anyone, and name who would be hurt or lost if it surfaced. Two sentences, under 45 words. It must be currently dangerous rather than merely private. Avoid secret parentage, hidden powers, and concealed identities.' },
    { id: 'ce_fx_vice', slot: 'resistance', label: 'Vice', placeholder: 'The habit that costs them\u2026',
      instructions: 'Name the habit that costs this character something, and give the justification they actually use for it in their own head. Two sentences, under 40 words. Do not moralise or hint they will overcome it. Avoid drink and gambling as unmotivated stock answers.' },
    { id: 'ce_fx_debt', slot: 'resistance', label: 'Debt', placeholder: 'What they owe and to whom\u2026',
      instructions: 'State what this character owes and to whom — money, a favour, blood, or guilt — and what the holder can demand because of it. Two sentences, under 45 words. Name the creditor specifically. Avoid vague debts to organisations nobody has met.' },
    { id: 'ce_fx_grudge', slot: 'resistance', label: 'Grudge', placeholder: 'Who wronged them, and what is unfinished\u2026',
      instructions: 'Name who wronged this character, what was done, and the specific unfinished thing that remains. Two sentences, under 45 words. The wrong should be proportionate to an ordinary life unless the profile says otherwise. Avoid murdered families.' },
    { id: 'ce_fx_superstition', slot: 'resistance', label: 'Superstition', placeholder: 'A belief that is not true, acted on anyway\u2026',
      instructions: 'State a belief this character holds that is not true, and the specific thing they do because of it. Two sentences, under 35 words. It should be small, habitual, and slightly embarrassing rather than a grand delusion.' },
    { id: 'ce_fx_blindspot', slot: 'resistance', label: 'Blind spot', placeholder: 'What everyone else can see\u2026',
      instructions: 'State the thing about this character that everyone around them can see and they cannot. Two sentences, under 40 words. Write it as others would describe it, not as a diagnosis. Avoid stating that they are afraid of intimacy or cannot trust people.' },

    // ── Conduct ──
    { id: 'ce_fx_tell', slot: 'conduct', label: 'Tell', placeholder: 'What they do when uncomfortable\u2026',
      instructions: 'Name the small physical thing this character does when lying or uncomfortable, and who has noticed it. Two sentences, under 30 words. It must be specific and small. Avoid eye contact avoidance, jaw clenching, throat clearing, and touching the neck.' },
    { id: 'ce_fx_pressure', slot: 'conduct', label: 'Under pressure', placeholder: 'Their default move when things go badly\u2026',
      instructions: 'State what this character does by default when things go badly: fight, fix, flee, freeze, charm, or delegate. Name one and describe what it looks like in practice. Two sentences, under 40 words. Do not hedge across several.' },
    { id: 'ce_fx_strangers', slot: 'conduct', label: 'With strangers', placeholder: 'Someone they have no stake in\u2026',
      instructions: 'Describe how this character treats someone they have no stake in and will never see again. Two sentences, under 40 words. This is the most revealing thing about most people, so be specific rather than pleasant.' },
    { id: 'ce_fx_subordinates', slot: 'conduct', label: 'With subordinates', placeholder: 'Someone who cannot refuse them\u2026',
      instructions: 'Describe how this character treats someone who cannot refuse them — an employee, a servant, a junior, anyone dependent. Two sentences, under 40 words. Be honest rather than flattering; a decent person and a cruel one differ most here.' },
    { id: 'ce_fx_authority', slot: 'conduct', label: 'With authority', placeholder: 'Someone who outranks them\u2026',
      instructions: 'Describe how this character behaves toward someone who outranks them and knows it. Two sentences, under 40 words. State whether they comply, needle, flatter, or stonewall, and what it costs them to do it.' },
    { id: 'ce_fx_humour', slot: 'conduct', label: 'Humour', placeholder: 'What they find funny\u2026',
      instructions: 'State what this character actually finds funny and whether they let it show. Two sentences, under 35 words. Give one example of the kind of thing that would make them laugh. Avoid dry wit and sarcasm as unearned defaults.' },
    { id: 'ce_fx_anger', slot: 'conduct', label: 'Anger', placeholder: 'Loud, cold, quiet, or precise\u2026',
      instructions: 'Describe specifically what this character\u2019s anger looks like from outside, and what they do with it. Two sentences, under 40 words. Choose one register — loud, cold, quiet, precise, or displaced — and commit. Avoid seeing red and clenched fists.' },
    { id: 'ce_fx_speech', slot: 'conduct', label: 'Speech sample', placeholder: 'Three lines of their actual dialogue\u2026',
      instructions: 'Write exactly three lines of this character\u2019s dialogue, each from a different situation: one relaxed, one under pressure, one when they want something. No attribution, no narration, no quotation marks, one line each. Make the rhythm and vocabulary distinctive enough that the lines would be recognisable without a name attached.' },

    // ── History ──
    { id: 'ce_fx_formative', slot: 'history', label: 'Formative event', placeholder: 'What shaped how they operate\u2026',
      instructions: 'Describe the event that most shaped how this character operates now, and name the specific habit it left. Two or three sentences, past tense, under 50 words. Ordinary events shape people more than catastrophes; avoid war, fire, and the death of a parent unless the profile establishes them.' },
    { id: 'ce_fx_origin', slot: 'history', label: 'Where they are from', placeholder: 'Place, class, and what it left\u2026',
      instructions: 'State where this character is from, what class or station that meant, and one thing it left in how they speak or behave. Two sentences, under 45 words. Keep it consistent with the established world rather than importing a real-world region.' },
    { id: 'ce_fx_skill', slot: 'history', label: 'Skill & training', placeholder: 'What they are good at, and how they learned\u2026',
      instructions: 'State what this character is genuinely good at and how they learned it, including one thing they are notably bad at. Two or three sentences, under 50 words. Competence should match their life; avoid unexplained mastery.' },
    { id: 'ce_fx_reputation', slot: 'history', label: 'Reputation', placeholder: 'What people say when they are not there\u2026',
      instructions: 'State what people say about this character when they are not in the room, and how accurate it is. Two sentences, under 40 words. Give the actual phrasing others would use.' }
];

// [v2.105.0 FIELD-GROUPING] Facets were rendering in a block at the BOTTOM of every
// surface, detached from the slot they deepen \u2014 a Grudge is a Resistance detail, and
// six slots followed by thirty loose facets reads as thirty unrelated extras.
//
// The cause is storage order, not a display decision: cfg.customStaticFields is APPEND-ONLY
// (migrateConfig upserts missing ids onto the end), and BUILTIN_FACETS declares all the
// slots first and all the facets after, so every consumer that walks the array in order
// inherits that split. Fixing it by reordering the stored array was rejected \u2014 it would
// rewrite author config on load, and an author-added field's position is theirs.
//
// So: order at READ time, through one helper, so the lorebook entry, the HUD profile
// payload and the generation context all group identically. Bucketed rather than sorted
// so the result does not depend on Array.prototype.sort stability.
//
// NOT applied to the native character sheet's field catalog (~engine 18820), which groups
// by `kind` into 'Character slots' / 'Facets' / 'Custom fields'. That surface's grouping is
// explicit and visible, and reordering its source list would not interleave the groups
// anyway. If it should follow this model too, that is a separate change to its group
// assignment, not to its ordering.
const CE_FIELD_GROUP_ORDER: string[] = ['presence', 'drive', 'resistance', 'conduct', 'position', 'history'];

// Display names for the groups above. These are the Studio's own steps, so an author who
// built the character in the Studio meets the same six words on every other surface.
// 'history' shows as Background because that is what the Studio step is called and what the
// first-class `background` field beside it is called.
const CE_FIELD_GROUP_LABELS: Record<string, string> = {
    presence: 'Presence', drive: 'Drive', resistance: 'Resistance',
    conduct: 'Conduct', position: 'Position', history: 'Background'
};

// Mirror of the bridge's _studioFacetGroupFor(). core/pursuit fold into 'drive' because the
// stored data makes no distinction there. Returns '' for anything unrecognised \u2014
// including an author-defined field, which has no slot at all \u2014 and those trail the
// grouped ones rather than being dropped or wedged into a group they do not belong to.
function ceStaticFieldGroup(def: any): string {
    const s = String((def && def.slot) || '');
    if (s === 'core' || s === 'pursuit') return 'drive';
    return CE_FIELD_GROUP_ORDER.indexOf(s) >= 0 ? s : '';
}

function ceStaticFieldGroupLabel(group: string): string {
    return CE_FIELD_GROUP_LABELS[group] || 'Other fields';
}

// Returns a NEW array \u2014 never mutates cfg.customStaticFields, which is the stored
// config. Within a group the slot card comes first and facets follow in library order.
function ceOrderStaticFields(defs: any[]): any[] {
    if (!Array.isArray(defs)) return [];
    const buckets: Record<string, any[]> = {};
    for (const g of CE_FIELD_GROUP_ORDER) buckets[g] = [];
    const ungrouped: any[] = [];
    for (const d of defs) {
        if (!d) continue;
        const g = ceStaticFieldGroup(d);
        if (g) buckets[g].push(d); else ungrouped.push(d);
    }
    let out: any[] = [];
    for (const g of CE_FIELD_GROUP_ORDER) {
        out = out.concat(
            buckets[g].filter(function(d: any) { return String(d.kind || '') === 'slot'; }),
            buckets[g].filter(function(d: any) { return String(d.kind || '') !== 'slot'; })
        );
    }
    return out.concat(ungrouped);
}

function migrateConfig(raw: any): GlobalConfig {
    // Merges raw saved data over defaults so new fields always have values.
    // Strips deprecated keys so old saves don't carry stale data.
    const d = makeDefaultConfig();
    const c = { ...d, ...raw };

    // [v2.78.0 FACETS] Seed built-in facets. Runs inside migrateConfig for the same reason
    // the travel templates do (see loadConfig's note): migrateConfig is applied to the
    // DEFAULT as well as to saved data, so a brand-new story gets the library without any
    // import step, and an existing story picks up newly added facets on next load.
    //
    // Adds by id ONLY where absent. An author who has edited a built-in facet's label or
    // instructions keeps their version forever — re-seeding over the top would silently
    // discard tuning work, which is the whole reason this is an upsert-if-missing rather
    // than a merge.
    if (!Array.isArray(c.customStaticFields)) c.customStaticFields = [];
    for (const bf of BUILTIN_FACETS) {
        const bfExisting = c.customStaticFields.filter(function(f: any) { return f && f.id === bf.id; })[0];
        if (!bfExisting) {
            c.customStaticFields.push({ id: bf.id, slot: bf.slot, label: bf.label, placeholder: bf.placeholder, instructions: bf.instructions, kind: bf.kind || 'facet' });
            continue;
        }
        // [v2.165.0 KIND-BACKFILL, per user: "Presence, Resistance and Conduct are missing
        // fields"] THE UPSERT ABOVE ADDS BY ID ONLY, AND `kind` WAS ADDED TO THE SEED AFTER
        // THE SEED HAD ALREADY RUN. A config seeded before v2.78.0's `kind` therefore holds
        // ce_slot_presence / ce_slot_resist_* / ce_slot_conduct_* with NO kind at all, and
        // buildCharProfilePayload defaults a missing kind to 'facet'. Every one of the six
        // slots then reached the Profile classified as a facet -- which means _ceSlotsFor
        // skipped it and the sparse rule (facets self-suppress while empty) HID IT.
        //
        // That is why the symptom looked like a layout regression and was not one: the
        // condensed rewrite did not touch this path. It looked new because Drive's two slots
        // had text in them and rendered anyway (a WRITTEN facet is shown), so only the empty
        // ones vanished, and only on a config old enough to predate the field.
        //
        // BACKFILL `kind` ONLY. label/instructions/placeholder/slot stay exactly as stored,
        // because those are the fields an author may have tuned and the upsert-if-missing
        // rule above exists to protect. `kind` is machine classification -- it decides which
        // renderer and which picker a def belongs to -- and there is no author-meaningful
        // reason for a built-in's kind to differ from the library's.
        const bfKind = bf.kind || 'facet';
        if (String((bfExisting as any).kind || '') !== bfKind) { (bfExisting as any).kind = bfKind; }
    }

    // Deprecated field removal
    delete c.storyRolePresets;
    delete c.conditionPresets;
    delete (c as any).defaultBudgetCap;
    delete (c as any).globalRules;
    delete (c as any).arcTypePresets; // Purge old config properties

    // Structural guards
    // [REMOVED v2.30.0, per user] Was: [HOLDING] Seed the baked-in default player
    // faction (idempotent by id). This existed to give the Holding system's roster a
    // default source — but Holding Document authoring + the player-faction picker
    // were already CE-STRIPped out (see buildFactionsWorkspace's own removal note,
    // "[CE-STRIP v2.0.x] Holding Document authoring + player-faction picker removed").
    // Nothing has read DEFAULT_PLAYER_FACTION_ID except this seed since that strip —
    // verified zero remaining callers before deleting both the seed and the constant
    // (grep DEFAULT_PLAYER_FACTION_ID / 'fac_player' turns up nothing else). A fresh
    // config no longer gets an uneditable "The Player" faction it never asked for;
    // existing saves that already have one are UNTOUCHED (this only ever ran on
    // migration, never as a delete pass) — remove it by hand via the Factions Manager
    // if you don't want it.
    if (!c.factions) c.factions = [];
    if (!c.relationshipArchetypes) c.relationshipArchetypes = JSON.parse(JSON.stringify(DEFAULT_REL_ARCHETYPES));
    // [v2.7.0 CONDITIONS] Old saves get the default set seeded once; existing saves
    // that already have SOME conditions (even a custom, edited list) are left alone —
    // same non-destructive pattern as relationshipArchetypes above.
    if (!c.conditions) c.conditions = JSON.parse(JSON.stringify(DEFAULT_CONDITIONS));
    if (!c.lorebookTemplates) c.lorebookTemplates = JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_TEMPLATES));
    else {
        // [v2.9.0 LOREFOLD] backfill every lorebook template key so old saves gain the
        // new equipment/journal lines without clobbering customised ones.
        for (const _ltk of Object.keys(DEFAULT_LOREBOOK_TEMPLATES)) {
            if (!(c.lorebookTemplates as any)[_ltk]) (c.lorebookTemplates as any)[_ltk] = (DEFAULT_LOREBOOK_TEMPLATES as any)[_ltk];
        }
        // [v2.92.0 POSITION] The V214 reshape loop was deleted here with its map. The
        // three orphaned keys it operated on are deliberately NOT stripped from saved
        // configs: an unread key costs nothing, and a config strip is the one migration
        // that cannot be undone if the decision is ever revisited.
    }
    // [v2.9.0 LOREFOLD] Per-field include switches — default any missing key to on.
    if (!c.lorebookFields) c.lorebookFields = JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_FIELDS));
    else {
        for (const _lfk of Object.keys(DEFAULT_LOREBOOK_FIELDS)) {
            if ((c.lorebookFields as any)[_lfk] === undefined) (c.lorebookFields as any)[_lfk] = (DEFAULT_LOREBOOK_FIELDS as any)[_lfk];
        }
    }
    // Migrate legacy string[] archetypes → RelationshipArchetypeDef[]
    if (Array.isArray(c.relationshipArchetypes) && c.relationshipArchetypes.length > 0 && typeof c.relationshipArchetypes[0] === 'string') {
        c.relationshipArchetypes = (c.relationshipArchetypes as any[]).map(function(s: any) {
            return { id: 'arch_' + String(s).toLowerCase().replace(/[^a-z0-9]+/g, '_').slice(0, 24) + '_' + Math.random().toString(36).slice(2, 6), name: String(s), stages: [] };
        });
    }
    if (!c.customStaticFields)     c.customStaticFields = [];
    if (!c.fieldLabels)            c.fieldLabels = {};
    if (!c.fieldInstructions)      c.fieldInstructions = {};
    if (!c.fieldBudgets)           c.fieldBudgets = {};
    if (!c.sheetCategories)        c.sheetCategories = [];
    if (c.ephemeralCap === undefined) c.ephemeralCap = 3;

    // [CE-STRIP v2.0.x] Global/party resources migration removed — Resources cut.

    // v0.9.3 fields
    if (!c.species)  c.species  = [];
    if (!c.factions) c.factions = [];

    // [v2.54.0] Dynamic-update cadence unit + intervals. From v0.9.24 through v2.53.x the
    // token-interval fields were DELETED here on every load (per-generation cadence had
    // replaced per-token). They are now reintroduced as an OPT-IN alternative unit, so the
    // deletes are gone — stripping them would wipe the user's token settings every load. A
    // stale token value on a pre-v0.9.24 save is harmless: it is only consulted when
    // dynamicIntervalMode === 'tokens', which those old saves never set, and the defaults
    // below only fill a MISSING field, never overwrite a real one.
    if ((c as any).dynamicIntervalMode !== 'tokens' && (c as any).dynamicIntervalMode !== 'gens') (c as any).dynamicIntervalMode = 'gens';
    if (!(c as any).thoughtIntervalTokens) (c as any).thoughtIntervalTokens = 500;
    if (!(c as any).hookIntervalTokens)    (c as any).hookIntervalTokens    = 1500;
    // Ensure gen-interval fields exist (new saves via makeDefaultConfig will have them)
    if (!c.thoughtIntervalGens) c.thoughtIntervalGens = 2;
    if (!c.hookIntervalGens)    c.hookIntervalGens    = 6;
    // [v2.92.0 POSITION] arcIntervalGens / arcIntervalTokens guards deleted with the
    // relationship generator. Saved values are left in place rather than deleted, same
    // reasoning as the orphaned lorebook template keys above.
    if (c.maxGenerationsPerTurn === undefined) c.maxGenerationsPerTurn = 1;  // [v2.89.0 TURN-CAP]
    if (c.maxDynamicCharacters === undefined) c.maxDynamicCharacters = 0;  // [vNEXT] no cap by default
    if (c.totalGenerations === undefined) c.totalGenerations = 0;
    if (c.defaultBackgroundUrl === undefined) c.defaultBackgroundUrl = ''; // [v0.9.40]
    if (!c.contextTemplates) c.contextTemplates = JSON.parse(JSON.stringify(DEFAULT_TEMPLATES));
    if (typeof (c as any).interfaceMode !== 'string') (c as any).interfaceMode = 'native';  // [v0.9.9.6]
    // [CE-STRIP v2.6.0 CTX-CUT] The old v0.9.8.4 template-upgrade loop (location/
    // trackedNarrative/player/npc) is gone along with those keys. A save from before
    // this pass still has a contextTemplates object, just missing the new
    // criticalHook key — backfill it so old saves don't render a blank hook line.
    // Any orphaned location/player/npcWeb/trackedNarrative/activeNarrative string
    // values left on old saves are harmless — unread by anything now.
    if (c.contextTemplates && !(c.contextTemplates as any).criticalHook) {
        (c.contextTemplates as any).criticalHook = DEFAULT_TEMPLATES.criticalHook;
    }
    // [v2.9.0 LOREFOLD] Backfill the re-added NPC-web AN template, and migrate the
    // pre-LOREFOLD fat npc template to thoughts-only so relationship/goal/conditions
    // are not injected in BOTH the AN and the lorebook. Hand-authored npc strings
    // (anything other than the known old default) are preserved untouched.
    // [v2.92.0 POSITION] Same backfill for the new position line, so a save from before
    // this pass gets the AN template rather than an empty string (which parseMacroTemplate
    // would render as nothing at all, making Position look broken rather than unconfigured).
    if (c.contextTemplates && !(c.contextTemplates as any).position) {
        (c.contextTemplates as any).position = (DEFAULT_TEMPLATES as any).position;
    }
    if (c.contextTemplates && !(c.contextTemplates as any).npcWeb) {
        (c.contextTemplates as any).npcWeb = DEFAULT_TEMPLATES.npcWeb;
    }
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V28) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [v2.83.0 EPHEMERAL-REWIRE] Same upgrade pattern: only replaces the template if it
    // still exactly matches the pre-v2.83 stock default. A hand-edited npc template
    // (using the old |ephemeral.compressedLine| macro or anything else) is left alone.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V82) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [v2.87.0 NPC-TPL-2LINE] Same upgrade pattern again, for the one-line v2.83-v2.86
    // default. Hand-edited templates are still left alone.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V86) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [v2.88.0 NPC-TPL-1LINE] Upgrade the short-lived v2.87.0 two-line default too.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V87) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    
    // [vNEXT] Seed the World-Build Wizard's Memory section list and concept fields.
    if (!c.wizardSections) {
        c.wizardSections = JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS));
    }
    if (c.projectName === undefined) c.projectName = '';
    if (c.projectGenre === undefined) c.projectGenre = '';
    if (c.projectConcept === undefined) c.projectConcept = '';

    // [CE-STRIP v2.0.x] time* migration-fill removed — Clock/Calendar cut.

    return c as GlobalConfig;
}

async function loadConfig(): Promise<GlobalConfig> {
    const raw = await api.v1.storyStorage.getOrDefault(STORAGE_CONFIG, null);
    // [v0.9.37 SEED1] Run migrateConfig on the DEFAULT too, so a brand-new story is
    // seeded with sys_default_travel / sys_return_travel. Previously makeDefaultConfig
    // bypassed migrateConfig, leaving fresh stories with no travel templates until the
    // action editor happened to save a config -> travel silently did nothing.
    return migrateConfig(raw ? raw : makeDefaultConfig());
}

async function saveConfig(cfg: GlobalConfig): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_CONFIG, cfg);
}

// ── Relationship archetype helpers ──────────────────────────────────────────
// [v2.92.0 POSITION] findArchetypeDef and resolveArchetypeStage DELETED. They resolved
// a saved archetypeId + stageIndex into a stage label for the |relStage| macro and the
// ◀/▶ stage stepper. Both went with the ladder: an archetype is now a one-shot SEED that
// copies a name into Position.shape as editable prose, so there is no stored reference
// left to resolve and no ordered track to step along. cfg.relationshipArchetypes itself
// survives as that seed catalog (see RelationshipArchetypeDef).

// ── Unified search picker ───────────────────────────────────────────────────
// Any picker with potentially >5 options should use this. Renders a live search
// box that re-filters as the user types. items: { id, label }[]. onSelect gets the
// chosen id. Auto-omits the search box when there are 5 or fewer items.


// ============================================================================
// SECTION 8 — STORAGE: PARTY STATE, NPC WEB, QUICK ACTION PRESETS
// Three independent storyStorage records that don't fit in the character or
// entity systems but are story-persistent.
// ============================================================================


// ── NPC Web ───────────────────────────────────────────────────────────────────
// The bilateral dynamic relationship graph between NPCs (WebLink[]).
// Stored as a JSON string because it can grow large and benefits from direct
// string serialization rather than NAI's object storage path.

async function loadNpcWeb(): Promise<WebLink[]> {
    // [v2.91.0 WEB-FLATTEN] Saved links from before the flattening still carry a
    // `priority` number. Nothing reads it, but it is stripped on load so the next
    // saveNpcWeb (or world-pack export) stops carrying a dead field forever.
    const raw = await api.v1.storyStorage.get(STORAGE_NPC_WEB) as string;
    try {
        let webParsed = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(webParsed)) return [];
        for (let wStrip of webParsed) { if (wStrip) delete wStrip.priority; }
        return webParsed as WebLink[];
    } catch (eWebLoad) { return []; }
}

async function saveNpcWeb(web: WebLink[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_NPC_WEB, JSON.stringify(web));
}

// ============================================================================
// SECTION 9 — STORAGE: IMAGE SETTINGS
// Image generation presets and global image settings.
// Stored in api.v1.storage (global, not story-bound) so they persist across
// stories without being part of the adventure module export.
// ============================================================================

// NOTE FOR ASSEMBLY: EVT_IMG_FIELDS_SYNC = 'AE_IMG_FIELDS_SYNC' was missed from
// Section 2 and should be added to the Bridge Event Name Constants block there.
// Used by saveImageSettings() below. [v2.13.0] Replaces the old PRESET_SYNC /
// AE_ALL_PRESETS_SYNC pair — one message carries the whole field library plus the
// default dimensions/scale/steps, since there's no more single "active preset".

async function loadImageSettings(): Promise<void> {
    // [CHANGE] Renamed from loadSettings() to clarify scope.
    // [CHANGE] Removed tempStorage mirroring (the 20 img_p*_steps/scale/etc. writes).
    //   Those keys only fed the now-removed AI engine NAI modal. Settings live
    //   in-memory (imagePromptFields[], globalSettings) for the engine and are
    //   broadcast to the bridge via saveImageSettings() → AE_IMG_FIELDS_SYNC.
    // [CHANGE] Removed cachedCharConfigs load from old STORAGE_KEY_CHAR_CONFIGS key.
    //   Character visual data is now seeded by buildCharacterDataPayload() in
    //   onScriptsLoaded (Section 27) and kept current by saveCharacter() calls.
    // [v2.13.0 IMGFIELDS] No preset migration — starts empty on a fresh install
    // (user's explicit call), replacing the old 5-slot generateDefaultPresets().

    const sf = await api.v1.storage.get(STORAGE_KEY_PROMPT_FIELDS);
    imagePromptFields = Array.isArray(sf) ? sf : [];

    const sg = await api.v1.storage.get(STORAGE_KEY_GLOBAL);
    if (sg) globalSettings = Object.assign({}, globalSettings, sg);

    // Guard every globalSettings field so partial saves from older versions work
    if (globalSettings.contextSize        === undefined) globalSettings.contextSize        = DEFAULT_CTX;
    if (!globalSettings.architectPrompt)                  globalSettings.architectPrompt   = DEFAULT_ARCH;
    if (globalSettings.architectAutoSnap   === undefined) globalSettings.architectAutoSnap   = true;
    if (globalSettings.autoDownload        === undefined) globalSettings.autoDownload        = false;
    // [v2.175.0 STORYIMG-DEFAULT-ON] Seed flipped to true -- see the DEFAULT_GLOBAL_SETTINGS
    // note. A NEW config gets true from the line below and needs nothing else.
    if (globalSettings.studioPlaceInStory  === undefined) globalSettings.studioPlaceInStory  = true;
    // AN EXISTING CONFIG NEEDS A ONE-SHOT RE-SEED, and this is the one migration in this
    // file that deliberately overwrites a stored value. THE JUSTIFICATION IS NARROW: every
    // config written between v2.156.0 and now carries `false` because the line above PUT it
    // there, not because anyone chose it -- the toggle defaulted off and its only visible
    // effect was the generation indicator, so nobody had a reason to find it. Re-seeding
    // once restores the intended default to configs that were opted out by a default.
    // GUARDED BY ITS OWN FLAG so it can only ever run once: a user who turns it back off
    // after this keeps that choice forever. This is the KIND-BACKFILL lesson applied in the
    // other direction -- a shape change that needs a backfill line, written at the same
    // time as the change rather than discovered eighteen versions later.
    if (!globalSettings.studioPlaceReseeded) {
        globalSettings.studioPlaceInStory = true;
        globalSettings.studioPlaceReseeded = true;
    }
    if (globalSettings.defaultWidth        === undefined) globalSettings.defaultWidth        = 832;
    if (globalSettings.defaultHeight       === undefined) globalSettings.defaultHeight       = 1216;
    if (globalSettings.defaultScale        === undefined) globalSettings.defaultScale        = 5.0;
    if (globalSettings.defaultSteps        === undefined) globalSettings.defaultSteps        = 28;
}

async function saveImageSettings(): Promise<void> {
    // [CHANGE] Renamed from saveSettings() to clarify scope.
    await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, imagePromptFields);
    await api.v1.storage.set(STORAGE_KEY_GLOBAL,        globalSettings);

    // Keep bridge in sync with the field library + defaults so the Image Studio
    // widget and avatar/snapshot generation pick up changes immediately.
    if (isBridgeReady) {
        try {
            await broadcastToTM('AE_IMG_FIELDS_SYNC', {
                fields: imagePromptFields,
                defaults: { width: globalSettings.defaultWidth, height: globalSettings.defaultHeight, scale: globalSettings.defaultScale, steps: globalSettings.defaultSteps }
            });
        } catch (e) { api.v1.error('[AE] saveImageSettings: AE_IMG_FIELDS_SYNC failed:', e); }
    }
}

// [v2.133.0 IMGPRESET-JSX] THE ONE IMPLEMENTATION of every image-field mutation, lifted
// verbatim out of the AE_IMG_FIELD_ACTION case so the bridge message and the jsx Images
// surface cannot drift into two different rule sets. Both callers now do exactly
// `applyImgFieldOp(op, payload)` then `await saveImageSettings()`.
// SEMANTICS ARE UNCHANGED FROM v2.13.0 -- same six ops, same clamps, same defaults,
// same silent-ignore on an unknown id. The only thing that moved is where it lives.
// Returns false ONLY for an unrecognised op, so a caller can log it; every recognised op
// returns true even when it matched no field, because "update a field that is gone" is a
// stale-UI race, not a programming error, and the old inline version ignored it too.
function applyImgFieldOp(op: string, payload: any): boolean {
    var ifaOp = String(op || '');
    if (ifaOp === 'add') {
        imagePromptFields.push({
            id: generateId(),
            name: String(payload.name || 'New Field'),
            basePrompt: String(payload.basePrompt || ''),
            uc: String(payload.uc || ''),
            weight: 1,
            active: false
        });
    } else if (ifaOp === 'update') {
        var fU = imagePromptFields.find(function(x) { return x.id === payload.id; });
        if (fU) {
            if (payload.name       !== undefined) fU.name       = String(payload.name);
            if (payload.basePrompt !== undefined) fU.basePrompt = String(payload.basePrompt);
            if (payload.uc         !== undefined) fU.uc         = String(payload.uc);
            if (payload.weight     !== undefined) fU.weight     = Math.max(0.1, Math.min(10, Number(payload.weight) || 1));
        }
    } else if (ifaOp === 'toggle') {
        var fT = imagePromptFields.find(function(x) { return x.id === payload.id; });
        if (fT) fT.active = !fT.active;
    } else if (ifaOp === 'delete') {
        imagePromptFields = imagePromptFields.filter(function(x) { return x.id !== payload.id; });
    } else if (ifaOp === 'reorder' && Array.isArray(payload.orderedIds)) {
        var byId: { [k: string]: ImagePromptField } = {};
        imagePromptFields.forEach(function(f) { byId[f.id] = f; });
        imagePromptFields = payload.orderedIds.map(function(oid: string) { return byId[oid]; }).filter(Boolean);
    } else if (ifaOp === 'setDefaults') {
        if (payload.width  !== undefined) globalSettings.defaultWidth  = Number(payload.width)  || globalSettings.defaultWidth;
        if (payload.height !== undefined) globalSettings.defaultHeight = Number(payload.height) || globalSettings.defaultHeight;
        if (payload.scale  !== undefined) globalSettings.defaultScale  = Number(payload.scale)  || globalSettings.defaultScale;
        if (payload.steps  !== undefined) globalSettings.defaultSteps  = Number(payload.steps)  || globalSettings.defaultSteps;
    } else {
        return false;
    }
    return true;
}

// [v2.13.0 IMGFIELDS] Compiles every currently-ACTIVE field into the final
// quality/negative prompt strings. A field's weight only wraps its contribution
// in NAI's N::text:: syntax when weight != 1 (unweighted fields stay plain text,
// keeping the compiled result readable). Same compiled pair feeds every
// generation path (Auto-Snap, manual Director's Cut, Snapshot) — there's no
// per-generation selection step; "active" is a standing toggle per field.
function _compileImageFieldsWhere(pred: (f: ImagePromptField) => boolean): { quality: string; negative: string } {
    const qualityParts: string[] = [];
    const negativeParts: string[] = [];
    for (const f of (imagePromptFields || [])) {
        if (!pred(f)) continue;
        const w = (typeof f.weight === 'number' && f.weight > 0) ? Math.max(0.1, Math.min(10, f.weight)) : 1;
        const bp = (f.basePrompt || '').trim();
        const uc = (f.uc || '').trim();
        if (bp) qualityParts.push(w !== 1 ? (w + '::' + bp + '::') : bp);
        if (uc) negativeParts.push(w !== 1 ? (w + '::' + uc + '::') : uc);
    }
    return { quality: qualityParts.join(', '), negative: negativeParts.join(', ') };
}
function compileActiveImageFields(): { quality: string; negative: string } {
    return _compileImageFieldsWhere(function(f) { return !!f.active; });
}
// [v2.137.0 CEGAL-FIELDSEL] Same compile, different predicate: membership in an explicit
// id list rather than the standing `.active` flag. Used ONLY for a one-off Studio render
// override (submitDirectorPhoto's fieldIds param) -- it never reads or writes `.active`,
// so it cannot desync the Presets tab's own toggle state.
function compileImageFieldsSubset(ids: string[]): { quality: string; negative: string } {
    const idSet: { [k: string]: boolean } = {};
    for (const id of ids) { idSet[id] = true; }
    return _compileImageFieldsWhere(function(f) { return !!idSet[f.id]; });
}

// ============================================================================
// SECTION 9b — PER-CHARACTER IMAGE SLOTS  [v2.121.0 IMG-SLOTS]
// Which image slots a character has (Avatar + Snapshot + 24 canonical emotions, plus
// any custom names added) and the per-slot tag TEXT OVERRIDE for each. This is the
// engine-side replacement for the bridge's ae_emo_slots_<charId> / ae_emo_tags_<charId>
// localStorage pair — ownership moved here because the Images drill (SECTION 30) is now
// where a person edits this, and per-user decision this landed WITHOUT a migration path:
// existing bridge-side per-character overrides reset to default on first engine read.
// The bridge's own copies (_getEmoSlots/_setEmoSlots/_getEmoTags/_setEmoTags/
// _AE_EMOTION_TAGS) are [DEAD] as of bridge v2.98.0 — not deleted, per the one-sweep rule.
//
// IMAGE BYTES ARE STILL NEVER HERE. This section is text only (which slots exist, what
// tag each carries) — the pixels stay bridge-side IndexedDB, unchanged from CE-IMG-ATTR.
//
// SOFT-PIN SEMANTICS ARE DELIBERATELY PRESERVED, per user, not simplified: Avatar can
// never be removed (no delete affordance at all — same as the bridge always enforced).
// Snapshot and any custom slot, once deleted, stay gone. The 24 canonical emotion words
// are SOFT-PINNED exactly like the bridge's own _getEmoSlots merge: deleting one removes
// its entry from the list (and its stored image, via the delete action), but the next
// time this state loads, every canonical word missing from the list is silently
// re-appended. This is a faithful port of existing behaviour, not a new design — the
// bridge has shipped it since EMOSTUDIO-24DEFAULT and nothing about moving the storage
// home should also change what it does.
// ============================================================================

interface CharImageSlotState { slots: string[]; tags: Record<string, string>; }

// [v2.121.0 IMG-DEFAULT-TAGS] Canonical default tag text per emotion word, ported from the
// bridge's _AE_EMOTION_TAGS. This is STATIC REFERENCE CONTENT, not mutable per-character
// state, so duplicating it here is the same category of duplication as ALL_EMOTIONS_LIST
// itself already is (declared on both sides on purpose) — not the MIRROR pattern CE-IMG-OPTS
// warns against, which is specifically about one side trying to track the OTHER side's
// live, per-character, frequently-changing state. A default tag string changes only when
// someone edits this table by hand.
var CE_IMG_DEFAULT_TAGS: Record<string, string> = {
    neutral: 'neutral expression, calm, composed', happy: 'happy, bright smile, cheerful',
    sad: 'sad expression, downcast eyes, melancholy', angry: 'angry expression, furrowed brows, glaring',
    surprised: 'surprised, wide eyes, mouth slightly open', embarrassed: 'embarrassed, blushing cheeks, flustered',
    shy: 'shy, looking away bashfully', disgusted: 'disgusted expression, grimacing',
    laughing: 'laughing, big smile, eyes crinkled', tired: 'tired, heavy half-lidded eyes, exhausted',
    excited: 'excited, bright sparkling eyes, energetic', nervous: 'nervous, anxious, tense expression',
    confused: 'confused, head tilted, puzzled look', worried: 'worried, frowning slightly, concerned',
    scared: 'scared, wide fearful eyes, trembling', love: 'loving expression, soft smile, warm adoring eyes',
    smug: 'smug, self-satisfied smirk', bored: 'bored, disinterested, deadpan',
    irritated: 'irritated, annoyed, exasperated', determined: 'determined, focused, resolute',
    playful: 'playful, mischievous smile', hurt: 'hurt, pained emotional expression',
    aroused: 'flushed cheeks, heated gaze', thinking: 'thinking, finger to chin, contemplative'
};

// Load-modify-persist, same shape as loadCharJournal/saveCharJournal (SECTION 10c). The
// merge (ensure Avatar, ensure every canonical word) runs on EVERY read, not just first
// creation — that is what makes the soft-pin behaviour work: a word removed by a delete
// action is simply absent from storage until the next load re-adds it.
async function loadCharImgSlots(charId: string): Promise<CharImageSlotState> {
    var out: CharImageSlotState = { slots: [], tags: {} };
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_IMG_PFX + charId, null);
        if (raw && typeof raw === 'object' && Array.isArray(raw.slots)) {
            out.slots = raw.slots.filter(Boolean).map(String);
            out.tags = (raw.tags && typeof raw.tags === 'object') ? raw.tags : {};
        } else {
            out.slots = [CE_IMG_SLOT_AVATAR, 'Snapshot'].concat(CE_IMG_EMOTION_SLOTS);
        }
    } catch (e) { api.v1.error('[AE:imgslots] loadCharImgSlots:', e); out.slots = [CE_IMG_SLOT_AVATAR, 'Snapshot'].concat(CE_IMG_EMOTION_SLOTS); }

    var changed = false;
    if (out.slots.indexOf(CE_IMG_SLOT_AVATAR) === -1) { out.slots = [CE_IMG_SLOT_AVATAR].concat(out.slots); changed = true; }
    for (var i = 0; i < CE_IMG_EMOTION_SLOTS.length; i++) {
        if (out.slots.indexOf(CE_IMG_EMOTION_SLOTS[i]) === -1) { out.slots.push(CE_IMG_EMOTION_SLOTS[i]); changed = true; }
    }
    if (changed) { try { await saveCharImgSlots(charId, out); } catch (e2) { api.v1.error('[AE:imgslots] merge-save failed:', e2); } }
    return out;
}

async function saveCharImgSlots(charId: string, state: CharImageSlotState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_CHAR_IMG_PFX + charId, { slots: state.slots || [], tags: state.tags || {} });
    } catch (e) { api.v1.error('[AE:imgslots] saveCharImgSlots:', e); }
}

// Effective tag for a slot: a stored override wins, else the canonical default, else empty
// (a custom slot has no default — there is nothing to fall back to).
function charImgEffectiveTag(state: CharImageSlotState, slot: string): string {
    var t = (state.tags || {})[slot];
    if (t !== undefined && t !== null) return String(t);
    return CE_IMG_DEFAULT_TAGS[slot] || '';
}

async function charImgSetTag(charId: string, slot: string, tag: string): Promise<CharImageSlotState> {
    var state = await loadCharImgSlots(charId);
    state.tags = state.tags || {};
    state.tags[slot] = String(tag || '');
    await saveCharImgSlots(charId, state);
    return state;
}

async function charImgAddSlot(charId: string, name: string): Promise<CharImageSlotState> {
    var n = String(name || '').trim();
    var state = await loadCharImgSlots(charId);
    if (n && state.slots.indexOf(n) === -1) {
        state.slots.push(n);
        await saveCharImgSlots(charId, state);
    }
    return state;
}

// Removes a slot from the list (and its tag override, if any). Does NOT touch the stored
// image — that is bridge-side and this file has no path to it; the drill's Delete action
// sends a separate AE_CHAR_IMAGE_ACTION so the bridge can drop the actual bytes. Avatar is
// refused here as a second guard even though the drill never offers Delete for it.
async function charImgRemoveSlot(charId: string, name: string): Promise<CharImageSlotState> {
    var n = String(name || '').trim();
    var state = await loadCharImgSlots(charId);
    if (n && n !== CE_IMG_SLOT_AVATAR) {
        state.slots = state.slots.filter(function(s: string) { return s !== n; });
        if (state.tags) { delete state.tags[n]; }
        await saveCharImgSlots(charId, state);
    }
    return state;
}

// ============================================================================
// SECTION 10 — LOREBOOK HELPERS
// Functions that build, create, and sync NAI lorebook entries for characters,
// factions, and species. Lorebook entries are how static character profiles
// get injected into context via NAI's native keyword-matching system.
//
// PATTERN NOTE: All three record types (character, faction, species) share an
// identical four-function family: getKeys / buildContent / createLinked / sync.
// This is a future candidate for a generalized syncLorebookRecord<T>(spec) helper
// once the refactor stabilizes. Not changing now — the calls are simple enough
// that the abstraction would add indirection without immediate benefit.
// ============================================================================

// ── Character Lorebook ────────────────────────────────────────────────────────

function getLorebookKeys(char: CharacterRecord): string[] {
    // Returns the name + all nicknames as lorebook trigger keys.
    return [char.name, ...char.nicknames.filter(Boolean)].filter(Boolean);
}

async function buildLorebookContent(char: CharacterRecord): Promise<string> {
    // Assembles the lorebook entry text from a character's static fields.
    // showFieldHeaders controls whether field labels are prepended.
    // This is the single authoritative builder — used by both create and sync.
    const cfg = await loadConfig();
    const showHeaders = cfg.showFieldHeaders;
    const lines: string[] = [];

    function addField(label: string, value: string | undefined | null) {
        if (!value || value.trim() === '') return;
        lines.push(showHeaders ? `${label}: ${value.trim()}` : value.trim());
    }

    // [v0.9.8.5] Identity line — collapsed from five separate Name/Age/Species/
    // Gender/Role fields into a single dossier header, e.g. "Gareth — human male,
    // 34, blacksmith". Header-agnostic by design (it reads as a header itself).
    let idLeader = [char.species, char.gender].map(function(s) { return (s || '').trim(); }).filter(Boolean).join(' ');
    let idMid = [idLeader, (char.age || '').trim(), (char.occupationRole || '').trim()].filter(Boolean).join(', ');
    let identityLine = (char.name || '').trim();
    if (identityLine && idMid) identityLine += ' \u2014 ' + idMid;
    else if (!identityLine && idMid) identityLine = idMid;
    if (identityLine) lines.push(identityLine);

    // Core static fields — label keys are customisable via cfg.fieldLabels
    addField(cfg.fieldLabels['physicalDescription'] || 'Physical Description', char.physicalDescription);
    addField(cfg.fieldLabels['personalityCore']     || 'Personality Core',     char.personalityCore);
    addField(cfg.fieldLabels['voiceAndMannerisms']  || 'Voice & Mannerisms',   char.voiceAndMannerisms);
    addField(cfg.fieldLabels['background']          || 'Background',           char.background);

    // Core values
    if (char.coreValues && char.coreValues.length > 0) {
        addField('Core Values', char.coreValues.filter(Boolean).join(', '));
    }

    // Slots, facets, and author-defined custom static fields.
    // [v2.105.0 FIELD-GROUPING] Emitted in slot-group order so each facet sits under the
    // slot it deepens instead of in a block after every slot. Ordering ONLY \u2014 no group
    // headings are inserted: this string is injected context, and adding six heading lines
    // would spend tokens on every build to restate what the field labels already say.
    if (cfg.customStaticFields && char.customFieldValues) {
        for (const cf of ceOrderStaticFields(cfg.customStaticFields)) {
            addField(cf.label, char.customFieldValues[cf.id]);
        }
    }

    // [v2.9.0 LOREFOLD] Equipment (and the rest of the dynamic layer) is NOT in this
    // static builder. buildCharDynamicBlock() produces it fresh each generation and
    // buildSceneLorebookActivation() appends it onto this entry's content per-build, so
    // the STORED entry stays static identity (equip/unequip triggers no lorebook re-sync).
    return lines.join('\n');
}

// [v2.7.0 CONDITIONS] ── Dynamic Lorebook (narrative prose, NOT the wiki-style
// dossier above) ──────────────────────────────────────────────────────────────
// Deliberately a separate builder from buildLorebookContent: that one is static
// identity (labeled fields, content-stable, cache-friendly); this one is dynamic
// state (conditions today), rebuilt fresh every generation like equipment, and
// reads as prose rather than a field list per user's explicit call.

// Resolves one active condition to its narrative line, or '' if the def was
// deleted out from under an active state (orphaned reference — skip gracefully,
// don't throw) or the line template itself resolves empty.
function buildConditionLine(char: CharacterRecord, def: ConditionDef, stageIndex: number, cfg: GlobalConfig): string {
    let stageText = '';
    if (def.stages && def.stages.length > 0) {
        let idx = Math.max(0, Math.min(def.stages.length - 1, stageIndex || 0));
        stageText = def.stages[idx] || '';
    }
    const data = { name: char.name, conditionName: def.name, stageText: stageText };
    return parseMacroTemplate(cfg.lorebookTemplates.condition, data).trim();
}

// One line per active condition (user's call — not combined into one sentence).
// Returns '' if the character has no active conditions (or none resolve to text),
// so callers can skip emitting an empty temp lorebook entry.
async function buildDynamicLorebookContent(char: CharacterRecord, cfg: GlobalConfig): Promise<string> {
    const lines: string[] = [];
    const defs = cfg.conditions || [];
    for (const state of (char.activeConditions || [])) {
        const def = defs.find(function(d) { return d.id === state.defId; });
        if (!def) continue;
        const line = buildConditionLine(char, def, state.stageIndex, cfg);
        if (line) lines.push(line);
    }
    return lines.join('\n');
}

// [v2.9.0 LOREFOLD] Composite dynamic block folded into a character's lorebook entry:
// equipment + conditions + relationship + mid-range. Each line is gated by
// cfg.lorebookFields and rendered as prose via cfg.lorebookTemplates. Returns '' when
// nothing is enabled/populated so callers can skip an empty append. Rebuilt fresh every
// generation (state, not identity) — same cadence the old ae_equip_/ae_dynamic_ temp
// entries had, just consolidated into one entry so ordering is deterministic.
async function buildCharDynamicBlock(char: CharacterRecord, cfg: GlobalConfig): Promise<string> {
    const lines: string[] = [];
    const tpl = cfg.lorebookTemplates || ({} as LorebookTemplates);
    const inc = cfg.lorebookFields || ({} as LorebookFieldToggles);
    const data = Object.assign({}, char, buildCharMacroExtras(char));

    // Equipment — resolve each worn item to "name (detail)".
    if (inc.equipment && char.equippedItemIds && char.equippedItemIds.length > 0) {
        const worn: string[] = [];
        for (const itemId of char.equippedItemIds) {
            try {
                const item = await loadEntity(itemId);
                if (!item) continue;
                const detail = (item.description || '').trim() || ((item as any).atmosphere || '').trim();
                worn.push(detail ? (item.name + ' (' + detail + ')') : item.name);
            } catch (eItem) { /* non-fatal: skip unreadable item */ }
        }
        if (worn.length > 0) {
            const line = parseMacroTemplate(tpl.equipment, Object.assign({}, data, { equipList: worn.join(', ') })).trim();
            if (line) lines.push(line);
        }
    }

    // Conditions — one line per active condition (reuses the existing builder).
    if (inc.conditions) {
        const condBlock = await buildDynamicLorebookContent(char, cfg);
        if (condBlock.trim()) lines.push(condBlock.trim());
    }

    // [v2.90.0 MIDRANGE-RETIRE] The goal / socialMask / shiftedView fold lived here.
    // [v2.92.0 POSITION] So did the three relationship lines, and Position did NOT take
    // the slot back. It is a two-party statement, and this block runs whenever its owner
    // is scene-present regardless of where the other party is — which would have injected
    // one character's private reading of someone who is not in the scene. Position is
    // therefore an Author's-Note line under a both-parties-present gate, exactly like
    // npcWeb (see buildWorldStateBlock). The per-character FACET positions in the design
    // are the thing that eventually folds here; they do not exist yet, so this stays empty
    // rather than being filled with the nearest available substitute.

    // Journal — [v2.12.0 CHARJOURNAL] this character's own running notes, folded in
    // exactly like conditions: active (non-archived) bubbles only, joined as prose.
    // Unbounded on purpose (user's call) — archiving/merge-down are the user's own
    // tools for keeping this from growing unbounded, same as the main journal.
    if (inc.journal) {
        const jState = await loadCharJournal(char.id);
        const activeBubbles = (jState.bubbles || []).filter(function(b) { return !b.archived; });
        const journalBody = activeBubbles.map(function(b) { return (b.text || '').trim(); }).filter(Boolean).join('\n\n');
        if (journalBody) {
            const line = parseMacroTemplate(tpl.journal, Object.assign({}, data, { journalBody: journalBody })).trim();
            if (line) lines.push(line);
        }
    }

    return lines.join('\n');
}

// [v2.55.0 CHAR-CAT] Character lorebook entries were the one entry family created with no
// category (faction/species/entity families already file under a named one — see
// ensureLorebookCategory below, the shared find-or-create helper this reuses as-is). Own
// name, distinct from the entity system's "AE Characters" (entityLorebookCategoryName) —
// that family covers EntityRecord-typed characters (a different record shape from
// CharacterRecord), so the two are deliberately not merged into one category.
var CHAR_CAT_NAME = 'CE Characters';

async function createLinkedLorebookEntry(charId: string, silent?: boolean): Promise<void> {
    const char = await loadCharacter(charId);
    if (!char) return;
    try {
        const content  = await buildLorebookContent(char);
        const keys     = getLorebookKeys(char);
        const catId    = await ensureLorebookCategory(CHAR_CAT_NAME);
        const entrySpec: any = { displayName: char.name, text: content, keys, enabled: true };
        if (catId) entrySpec.category = catId;
        const entryId  = await api.v1.lorebook.createEntry(entrySpec);
        char.lorebookEntryId = entryId;
        await saveCharacter(char);
        if (!silent) api.v1.ui.toast(`Lorebook entry created for ${char.name}.`, { type: 'success' });
    } catch (e) {
        if (!silent) api.v1.ui.toast('Failed to create lorebook entry.', { type: 'error' });
        if (silent) throw e;
    }
}

async function syncLorebookEntry(charId: string, silent?: boolean): Promise<void> {
    const char = await loadCharacter(charId);
    if (!char?.lorebookEntryId) return;
    try {
        const content = await buildLorebookContent(char);
        // [v2.55.0 CHAR-CAT] Re-stamp category on every sync too, not just at creation —
        // entries made before this patch have none, and this is the cheapest place to
        // backfill them without a one-off migration pass.
        const catId = await ensureLorebookCategory(CHAR_CAT_NAME);
        const updateSpec: any = {
            text: content,
            keys: getLorebookKeys(char),
            displayName: char.name
        };
        if (catId) updateSpec.category = catId;
        await api.v1.lorebook.updateEntry(char.lorebookEntryId, updateSpec);
        if (!silent) api.v1.ui.toast('Lorebook entry synced.', { type: 'success' });
    } catch (e) {
        api.v1.error('[AE] syncLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to sync lorebook entry.', { type: 'error' });
    }
}

// [v0.9.8.5] Builds the per-generation lorebook activation package for the current
// scene. For every active, scene-present character (and the protagonist):
//   - permanent entry present  -> force-activate it ([id, {active:true}])
//   - permanent entry absent    -> emit its static identity as an ephemeral temp
//                                  entry (no permanent lorebook needed, no regression)
//   - equipped items present    -> emit a separate ephemeral equipment temp entry
// Returned from onBeforeContextBuild so static identity lives in the lorebook block
// while the Author's Note carries only the dynamic layer.
// [v2.9.0 LOREFOLD] paramLoreEntries is onBeforeContextBuild's params.lorebookEntries
// ([id, {active, content}][]) — used to APPEND the dynamic block onto a linked entry's
// CURRENT content (preserving any hand-edits) rather than rebuilding identity. Folding
// equipment + conditions + relationship + mid-range into the one character entry (per
// user's call) makes ordering deterministic: the dynamic layer can no longer land as a
// stray temp entry before its own character (the old ae_equip_/ae_dynamic_ ordering bug).
async function buildSceneLorebookActivation(paramLoreEntries?: any[]): Promise<{ lorebookEntries: any[]; temporaryLorebookEntries: any[] }> {
    const lorebookEntries: any[] = [];
    const temporaryLorebookEntries: any[] = [];
    try {
        const slaCfg = await loadConfig();
        const slaIdx = await loadIndex();
        const slaLoreMap = new Map<string, string>();
        for (const _pt of (paramLoreEntries || [])) {
            if (Array.isArray(_pt) && _pt.length >= 2 && _pt[0]) slaLoreMap.set(_pt[0], (_pt[1] && _pt[1].content) || '');
        }
        for (const meta of slaIdx.filter(Boolean)) {
            if (!meta.active) continue;
            if (!meta.scenePresent && !meta.isProtagonist) continue;
            const slaChar = await loadCharacter(meta.id);
            if (!slaChar) continue;

            // The full dynamic layer for this character, as one prose block.
            const slaDyn = (await buildCharDynamicBlock(slaChar, slaCfg)).trim();

            if (slaChar.lorebookEntryId) {
                // Linked: force-activate the permanent identity entry. If there's a
                // dynamic layer, override its content = current entry text + dynamic
                // block (append, don't clobber). Otherwise activate it untouched.
                if (slaDyn) {
                    let slaBase = slaLoreMap.has(slaChar.lorebookEntryId)
                        ? slaLoreMap.get(slaChar.lorebookEntryId)!
                        : await buildLorebookContent(slaChar);
                    slaBase = (slaBase || '').replace(/\s+$/, '');
                    lorebookEntries.push([slaChar.lorebookEntryId, { active: true, content: slaBase ? (slaBase + '\n\n' + slaDyn) : slaDyn }]);
                } else {
                    lorebookEntries.push([slaChar.lorebookEntryId, { active: true }]);
                }
            } else {
                // Unlinked: emit ONE ephemeral temp entry = identity + dynamic block.
                let slaStatic = (await buildLorebookContent(slaChar)).trim();
                let slaCombined = [slaStatic, slaDyn].filter(Boolean).join('\n\n');
                if (slaCombined) {
                    temporaryLorebookEntries.push({
                        id: 'ae_static_' + slaChar.id,
                        name: slaChar.name || 'Character',
                        content: slaCombined,
                        active: true,
                        appearWithPermanent: true
                    });
                }
            }
        }

        // [v1.6.3 LOC-LORE] Force-activate the player's CURRENT room's own dossier entry
        // the same way a scene-present character's entry is activated above. If the player
        // is in the Haunted House, the Haunted House's own lorebook entry activates. This
        // is immediate/single-location only — no ancestor walking up the location tree.
        try {
            const slaRoomId = await aeGetPlayerRoomId();
            if (slaRoomId) {
                const slaRoom = await loadEntity(slaRoomId);
                if (slaRoom && (slaRoom as any).lorebookEntryId) {
                    lorebookEntries.push([(slaRoom as any).lorebookEntryId, { active: true }]);
                }
            }
        } catch (eSlaLoc) { api.v1.error('[AE:context] current-location activation:', eSlaLoc); }
    } catch (eSla) { api.v1.error('[AE:context] buildSceneLorebookActivation:', eSla); }
    return { lorebookEntries: lorebookEntries, temporaryLorebookEntries: temporaryLorebookEntries };
}

// ── Faction Lorebook ──────────────────────────────────────────────────────────

function getFactionLorebookKeys(faction: FactionDef): string[] {
    return [faction.name].concat(faction.lorebookTags || []).filter(Boolean);
}

function buildFactionLorebookContent(faction: FactionDef): string {
    const lines: string[] = [];
    if (faction.name) lines.push(faction.name);
    if (faction.description?.trim()) lines.push(faction.description.trim());
    if (faction.relationshipStates && faction.relationshipStates.length > 0) {
        lines.push(`Relationship standings: ${faction.relationshipStates.join(' → ')}`);
    }
    return lines.join('\n');
}

async function createLinkedFactionLorebookEntry(factionId: string, silent?: boolean): Promise<void> {
    const cfg  = await loadConfig();
    const fIdx = (cfg.factions || []).findIndex(function(f) { return f.id === factionId; });
    if (fIdx < 0) return;
    const faction = cfg.factions[fIdx];
    try {
        let catId = await ensureLorebookCategory('AE Factions');
        let entry: any = {
            displayName: faction.name,
            text: buildFactionLorebookContent(faction),
            keys: getFactionLorebookKeys(faction),
            enabled: true
        };
        if (catId) entry.category = catId;
        const entryId = await api.v1.lorebook.createEntry(entry);
        cfg.factions[fIdx].lorebookEntryId = entryId;
        await saveConfig(cfg);
        if (!silent) api.v1.ui.toast(`Lorebook entry created for ${faction.name}.`, { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to create faction lorebook entry.', { type: 'error' }); if (silent) throw e; }
}


async function syncFactionLorebookEntry(factionId: string, silent?: boolean): Promise<void> {
    const cfg     = await loadConfig();
    const faction = (cfg.factions || []).find(function(f) { return f.id === factionId; });
    if (!faction?.lorebookEntryId) return;
    try {
        await api.v1.lorebook.updateEntry(faction.lorebookEntryId, {
            text: buildFactionLorebookContent(faction),
            keys: getFactionLorebookKeys(faction),
            displayName: faction.name
        });
        if (!silent) api.v1.ui.toast('Faction lorebook synced.', { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to sync faction lorebook.', { type: 'error' }); if (silent) throw e; }
}

async function unlinkFactionLorebookEntry(factionId: string): Promise<void> {
    const cfg = await loadConfig();
    const fIdx = (cfg.factions || []).findIndex(function(f) { return f.id === factionId; });
    if (fIdx < 0) return;
    if (cfg.factions[fIdx].lorebookEntryId) {
        try { await api.v1.lorebook.removeEntry(cfg.factions[fIdx].lorebookEntryId!); } catch(e) {}
        cfg.factions[fIdx].lorebookEntryId = undefined;
        await saveConfig(cfg);
        api.v1.ui.toast('Faction lorebook unlinked.', { type: 'info' });
    }
}

// ── Species Lorebook ──────────────────────────────────────────────────────────

function getSpeciesLorebookKeys(sp: SpeciesDef): string[] {
    return [sp.name].concat(sp.lorebookTags || []).filter(Boolean);
}

function buildSpeciesLorebookContent(sp: SpeciesDef): string {
    const lines: string[] = [];
    if (sp.name) lines.push(sp.name);
    if (sp.description?.trim()) lines.push(sp.description.trim());
    return lines.join('\n');
}

async function createLinkedSpeciesLorebookEntry(speciesId: string, silent?: boolean): Promise<void> {
    const cfg  = await loadConfig();
    const sIdx = (cfg.species || []).findIndex(function(s) { return s.id === speciesId; });
    if (sIdx < 0) return;
    const sp = cfg.species[sIdx];
    try {
        let catId = await ensureLorebookCategory('AE Species');
        let entry: any = {
            displayName: sp.name,
            text: buildSpeciesLorebookContent(sp),
            keys: getSpeciesLorebookKeys(sp),
            enabled: true
        };
        if (catId) entry.category = catId;
        const entryId = await api.v1.lorebook.createEntry(entry);
        cfg.species[sIdx].lorebookEntryId = entryId;
        await saveConfig(cfg);
        if (!silent) api.v1.ui.toast(`Lorebook entry created for ${sp.name}.`, { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to create species lorebook entry.', { type: 'error' }); if (silent) throw e; }
}

async function syncSpeciesLorebookEntry(speciesId: string, silent?: boolean): Promise<void> {
    const cfg = await loadConfig();
    const sp  = (cfg.species || []).find(function(s) { return s.id === speciesId; });
    if (!sp?.lorebookEntryId) return;
    try {
        await api.v1.lorebook.updateEntry(sp.lorebookEntryId, {
            text: buildSpeciesLorebookContent(sp),
            keys: getSpeciesLorebookKeys(sp),
            displayName: sp.name
        });
        if (!silent) api.v1.ui.toast('Species lorebook synced.', { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to sync species lorebook.', { type: 'error' }); if (silent) throw e; }
}

async function unlinkSpeciesLorebookEntry(speciesId: string): Promise<void> {
    const cfg = await loadConfig();
    const sIdx = (cfg.species || []).findIndex(function(s) { return s.id === speciesId; });
    if (sIdx < 0) return;
    if (cfg.species[sIdx].lorebookEntryId) {
        try { await api.v1.lorebook.removeEntry(cfg.species[sIdx].lorebookEntryId!); } catch(e) {}
        cfg.species[sIdx].lorebookEntryId = undefined;
        await saveConfig(cfg);
        api.v1.ui.toast('Species lorebook unlinked.', { type: 'info' });
    }
}
// ── Entity Lorebook (locations / items / narratives) ────────────────────────
// New in [WP-1]. Same getKeys/buildContent/create/sync family as the character
// lorebook above, but for world entities, filed under an "AE <Type>s" category.
// ensureLorebookCategory() is the shared find-or-create helper (reusable by the
// character/faction/species families on a later unification pass).

async function ensureLorebookCategory(name: string): Promise<string> {
    // Returns the id of the named lorebook category, creating it if absent.
    // Returns '' on failure — callers then create the entry uncategorised.
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).find(function(c) { return c.name === name; });
        if (found) return found.id;
        let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: name, enabled: true });
        return newId || '';
    } catch (e) { api.v1.error('[AE:lore] ensureLorebookCategory:', e); return ''; }
}

function entityLorebookCategoryName(ent: EntityRecord): string {
    if (ent.type === 'item')      return 'AE Items';
    if (ent.type === 'narrative') return 'AE Narratives';
    if (ent.type === 'character') return 'AE Characters';
    return 'AE Locations';
}

function getEntityLorebookKeys(ent: EntityRecord): string[] {
    // Entity name is always a key; lorebookTags add extra trigger words.
    return [ent.name].concat(ent.lorebookTags || []).filter(Boolean);
}

function buildEntityLorebookContent(ent: EntityRecord): string {
    // [WP-1] The dedicated extended-lore body, injected when a key (the entity
    // name or an added key) appears in the story. Deliberately NOT the
    // description/state — those already inject via the world-state block while
    // the player is present, so echoing them here would double them in context.
    return (ent.lorebookText || '').trim();
}

async function createLinkedEntityLorebookEntry(entId: string, silent?: boolean): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent) return;
    if (!(ent.lorebookText || '').trim()) { if (!silent) api.v1.ui.toast('Add Lorebook Entry text first, then create the entry.', { type: 'info' }); return; }
    try {
        let catId = await ensureLorebookCategory(entityLorebookCategoryName(ent));
        let entry: any = { id: api.v1.uuid(), displayName: ent.name, text: buildEntityLorebookContent(ent), keys: getEntityLorebookKeys(ent), enabled: true };
        if (catId) entry.category = catId;
        let newId = await api.v1.lorebook.createEntry(entry);
        ent.lorebookEntryId = newId;
        await saveEntity(ent);
        if (!silent) api.v1.ui.toast('Lorebook entry created for ' + ent.name + '.', { type: 'success' });
    } catch (e) {
        api.v1.error('[AE:lore] createLinkedEntityLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to create lorebook entry.', { type: 'error' });
        if (silent) throw e;
    }
}

async function syncEntityLorebookEntry(entId: string, silent?: boolean): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent || !ent.lorebookEntryId) return;
    try {
        await api.v1.lorebook.updateEntry(ent.lorebookEntryId, { text: buildEntityLorebookContent(ent), keys: getEntityLorebookKeys(ent), displayName: ent.name });
        if (!silent) api.v1.ui.toast('Lorebook entry synced.', { type: 'success' });
    } catch (e) {
        api.v1.error('[AE:lore] syncEntityLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to sync lorebook entry.', { type: 'error' });
    }
}

async function unlinkEntityLorebookEntry(entId: string): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent || !ent.lorebookEntryId) return;
    try { await api.v1.lorebook.removeEntry(ent.lorebookEntryId); }
    catch (e) { api.v1.error('[AE:lore] unlinkEntityLorebookEntry:', e); }
    ent.lorebookEntryId = undefined;
    await saveEntity(ent);
    api.v1.ui.toast('Lorebook entry unlinked.', { type: 'info' });
}

// ── Sync-All Lorebooks ──────────────────────────────────────────────────────
// [vNEXT] The individual sync helpers all early-return when a record has no
// lorebookEntryId, and none of them notice when a stored id points at an entry the
// user has since deleted in NAI. syncAllLorebooks fixes both: it never assumes an
// entry exists. It pulls the full live entry-id set ONCE (single API call), then per
// record decides create-vs-sync from that set in memory — so a run over the whole
// world costs one entries() call plus one update/create per record, no per-record
// existence probing. A record is (re)created when it has no id OR its id is stale
// (missing from the live set); otherwise it is synced. Returns per-type tallies.
//
// liveIds: pass the prebuilt Set so a single sync-all shares one snapshot across all
// four families. _ensure* helpers below are also individually callable.
async function _liveLorebookIdSet(): Promise<Set<string>> {
    let set = new Set<string>();
    try {
        let all = await api.v1.lorebook.entries();
        (all || []).forEach(function(e: any) { if (e && e.id) set.add(e.id); });
    } catch (e) { api.v1.error('[AE:lore] _liveLorebookIdSet:', e); }
    return set;
}

async function ensureCharacterLorebook(charId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let char = await loadCharacter(charId);
    if (!char) return 'skipped';
    let hasLive = !!(char.lorebookEntryId && liveIds.has(char.lorebookEntryId));
    if (hasLive) { await syncLorebookEntry(charId, true).catch(function() {}); return 'synced'; }
    // No id, or a stale id whose entry was deleted in NAI: clear + recreate.
    if (char.lorebookEntryId && !hasLive) { char.lorebookEntryId = undefined; await saveCharacter(char).catch(function() {}); }
    await createLinkedLorebookEntry(charId, true).catch(function() {});
    return 'created';
}

async function ensureFactionLorebook(factionId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let cfg = await loadConfig();
    let f = (cfg.factions || []).find(function(x) { return x.id === factionId; });
    if (!f) return 'skipped';
    let hasLive = !!(f.lorebookEntryId && liveIds.has(f.lorebookEntryId));
    if (hasLive) { await syncFactionLorebookEntry(factionId, true).catch(function() {}); return 'synced'; }
    if (f.lorebookEntryId && !hasLive) {
        // Clear the stale id before recreate so create doesn't leave a dangling ref.
        let cfg2 = await loadConfig();
        let f2i = (cfg2.factions || []).findIndex(function(x) { return x.id === factionId; });
        if (f2i >= 0) { cfg2.factions[f2i].lorebookEntryId = undefined; await saveConfig(cfg2).catch(function() {}); }
    }
    await createLinkedFactionLorebookEntry(factionId, true).catch(function() {});
    return 'created';
}

async function ensureSpeciesLorebook(speciesId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let cfg = await loadConfig();
    let s = (cfg.species || []).find(function(x) { return x.id === speciesId; });
    if (!s) return 'skipped';
    let hasLive = !!(s.lorebookEntryId && liveIds.has(s.lorebookEntryId));
    if (hasLive) { await syncSpeciesLorebookEntry(speciesId, true).catch(function() {}); return 'synced'; }
    if (s.lorebookEntryId && !hasLive) {
        let cfg2 = await loadConfig();
        let s2i = (cfg2.species || []).findIndex(function(x) { return x.id === speciesId; });
        if (s2i >= 0) { cfg2.species[s2i].lorebookEntryId = undefined; await saveConfig(cfg2).catch(function() {}); }
    }
    await createLinkedSpeciesLorebookEntry(speciesId, true).catch(function() {});
    return 'created';
}

async function ensureEntityLorebook(entId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let ent = await loadEntity(entId);
    if (!ent) return 'skipped';
    // Entity entries only carry the dedicated extended-lore body; with none there is
    // nothing to store, so skip (matches createLinkedEntityLorebookEntry's own guard).
    if (!((ent as any).lorebookText || '').trim()) return 'skipped';
    let hasLive = !!(ent.lorebookEntryId && liveIds.has(ent.lorebookEntryId));
    if (hasLive) { await syncEntityLorebookEntry(entId, true).catch(function() {}); return 'synced'; }
    if (ent.lorebookEntryId && !hasLive) { ent.lorebookEntryId = undefined; await saveEntity(ent).catch(function() {}); }
    await createLinkedEntityLorebookEntry(entId, true).catch(function() {});
    return 'created';
}

interface SyncAllTally { created: number; synced: number; skipped: number; }
async function syncAllLorebooks(): Promise<{ characters: SyncAllTally; locations: SyncAllTally; species: SyncAllTally; factions: SyncAllTally }> {
    let mk = function(): SyncAllTally { return { created: 0, synced: 0, skipped: 0 }; };
    let out = { characters: mk(), locations: mk(), species: mk(), factions: mk() };
    let bump = function(t: SyncAllTally, r: 'created' | 'synced' | 'skipped') { if (r === 'created') t.created++; else if (r === 'synced') t.synced++; else t.skipped++; };

    // One live snapshot shared by every family — the only lorebook read of the run.
    let liveIds = await _liveLorebookIdSet();

    try {
        // Characters (from the lightweight index).
        let cIdx = await loadIndex();
        for (let m of cIdx.filter(Boolean)) {
            bump(out.characters, await ensureCharacterLorebook(m.id, liveIds));
        }
    } catch (e) { api.v1.error('[AE:lore] syncAll characters:', e); }

    try {
        // Locations (location-type entities).
        let eIdx = await loadEntityIndex();
        for (let em of eIdx.filter(function(x) { return x && x.type === 'location'; })) {
            bump(out.locations, await ensureEntityLorebook(em.id, liveIds));
        }
    } catch (e) { api.v1.error('[AE:lore] syncAll locations:', e); }

    try {
        let cfg = await loadConfig();
        for (let sp of (cfg.species || [])) { bump(out.species, await ensureSpeciesLorebook(sp.id, liveIds)); }
        for (let fa of (cfg.factions || [])) { bump(out.factions, await ensureFactionLorebook(fa.id, liveIds)); }
    } catch (e) { api.v1.error('[AE:lore] syncAll species/factions:', e); }

    return out;
}



// ============================================================================
// SECTION 10b — PLAYER JOURNAL  [v1.7.0 JOURNAL]
// A player-authored running record ("The story so far") that survives context
// pressure by living in the lorebook. Bubbles are the source of truth in
// storyStorage; two lorebook entries are a *projection* of them:
//   - Active  entry: Always-On, keyless — non-archived bubbles, injected every turn.
//   - Archive entry: keyless + disabled — archived bubbles, retained but NEVER
//                    injected; unarchiving moves a bubble back to the active set.
// Renderer (native HUD) lives in Section 27; this section is pure state + lore +
// generation so the bridge can later drive the same verbs over a message pair.
// ============================================================================

async function loadJournal(): Promise<JournalState> {
    try {
        const raw = await api.v1.storyStorage.getOrDefault(STORAGE_JOURNAL, null);
        if (raw && typeof raw === 'object' && Array.isArray((raw as any).bubbles)) {
            const s = raw as JournalState;
            // [v2.116.0 JRNL-CHRONO] The single sort point for the story journal.
            s.bubbles = _ceJournalChrono(s.bubbles) as JournalBubble[];
            return s;
        }
    } catch (e) { api.v1.error('[AE:journal] loadJournal:', e); }
    return { bubbles: [] };
}

async function saveJournal(state: JournalState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_JOURNAL, {
            bubbles: (state.bubbles || []).filter(Boolean),
            activeLoreId: state.activeLoreId,
            archiveLoreId: state.archiveLoreId
        });
    } catch (e) { api.v1.error('[AE:journal] saveJournal:', e); }
}

// [v1.7.0 JOURNAL] Stamp reflects the STORY's in-world calendar at the moment the
// entry was written (captured as storyHours at creation), not wall-clock time.
// Formatted via the same clockFormatStamp the calendar/Author's-Note use.

// [v2.116.0 JRNL-CHRONO, per user report] CHRONOLOGY IS A PROPERTY OF createdAt, NOT OF
// ARRAY POSITION, and every reader of a bubble list assumed the opposite. journalMergeDown
// rebuilds the array as [merged].concat(archived), so a merge MOVES EVERY ARCHIVED BUBBLE
// TO THE END -- and an entry unarchived after a merge therefore came back at the bottom of
// the list instead of where it was written. That was the reported bug, but the UI was only
// the visible face of it: the same array order drives buildJournalBody (both lorebook
// entries), the character lorebook fold, and buildCharacterStateContext's "most recent 4"
// slice, so a merged story was quietly feeding the MODEL out-of-order recaps too.
// Sorting at the READ (loadJournal / loadCharJournal) rather than at any one consumer is
// what makes merge's reordering harmless forever: nothing downstream has to know. Storage
// is untouched -- the next save simply writes the sorted order back.
// The id tiebreak matters: two bubbles can share a millisecond, and an unstable comparator
// would let them swap places between renders.
function _ceJournalChrono(bubbles: any[]): any[] {
    var out: any[] = (bubbles || []).filter(Boolean).slice();
    out.sort(function(a: any, b: any) {
        var da = Number(a.createdAt || 0);
        var db = Number(b.createdAt || 0);
        if (da !== db) return da - db;
        var ia = String(a.id || '');
        var ib = String(b.id || '');
        return ia < ib ? -1 : (ia > ib ? 1 : 0);
    });
    return out;
}

// Ordered prose body from a bubble list. Stamped bubbles carry their in-story stamp
// inline (the only place a stamp reaches context), so a merge preserves them.
function buildJournalBody(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    // [CE-STRIP v2.0.x] In-story stamps removed — Clock cut. Plain text join only.
    return (bubbles || []).map(function(b) {
        return (b.text || '').trim();
    }).filter(Boolean).join('\n\n');
}

function buildActiveJournalText(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    const body = buildJournalBody(bubbles, cfg);
    return body ? ('The story so far:\n\n' + body) : '';
}

function buildArchiveJournalText(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    const body = buildJournalBody(bubbles, cfg);
    return body ? ('The story so far (archived):\n\n' + body) : '';
}

// Update an existing lore entry, or (re)create it if the id is missing/stale
// (e.g. the user deleted it in NAI's lorebook UI). Returns the live entry id.
async function ensureJournalEntry(existingId: string | undefined, spec: Partial<LorebookEntry>): Promise<string> {
    if (existingId) {
        try {
            const cur = await api.v1.lorebook.entry(existingId);
            if (cur) { await api.v1.lorebook.updateEntry(existingId, spec); return existingId; }
        } catch (e) { /* fall through and recreate */ }
    }
    return await api.v1.lorebook.createEntry(spec);
}

// Re-project bubbles onto the two lorebook entries. Best-effort: never throws,
// mutates state.activeLoreId / state.archiveLoreId in place. Does NOT save —
// persistJournal() owns the single authoritative save after ids settle.
async function syncJournalLore(state: JournalState): Promise<void> {
    try {
        const cfg = await loadConfig();
        const active   = (state.bubbles || []).filter(function(b) { return !b.archived; });
        const archived = (state.bubbles || []).filter(function(b) { return b.archived; });

        const activeText = buildActiveJournalText(active, cfg);
        const hasActive  = activeText.trim().length > 0;

        // The Always-On entry only force-activates when it has content; empty, it
        // is disabled so a lone "The story so far:" header never enters context.
        state.activeLoreId = await ensureJournalEntry(state.activeLoreId, {
            displayName: 'The story so far',
            keys: [],
            text: activeText,
            forceActivation: hasActive,
            enabled: hasActive
        });

        // Archive entry is created lazily — only once something is archived (or it
        // already exists) — so untouched stories don't accrue an empty keyless entry.
        if (archived.length > 0 || state.archiveLoreId) {
            state.archiveLoreId = await ensureJournalEntry(state.archiveLoreId, {
                displayName: 'Journal — Archived (unarchive to restore)',
                keys: [],
                text: buildArchiveJournalText(archived, cfg),
                forceActivation: false,
                enabled: false
            });
        }
    } catch (e) {
        api.v1.error('[AE:journal] syncJournalLore:', e);
    }
}

// Single persistence path for every mutator: project to lore, then one save.
async function persistJournal(state: JournalState): Promise<JournalState> {
    await syncJournalLore(state);
    await saveJournal(state);
    // Keep an open bridge HUD in sync when native mutates the journal (both-mode).
    if (isBridgeReady) { broadcastJournal().catch(function() {}); }
    return state;
}

// Bridge-facing projection: the bridge has no clock/cfg access, so the engine
// precomputes each bubble's in-story stampLabel here. stampLabel is always sent
async function journalPayloadForBridge(): Promise<Record<string, any>> {
    const state = await loadJournal();
    const bubbles = (state.bubbles || []).filter(Boolean).map(function(b) {
        return {
            id: b.id,
            text: b.text || '',
            archived: !!b.archived,
            createdAt: b.createdAt || 0
        };
    });
    return { bubbles: bubbles };
}

async function broadcastJournal(): Promise<void> {
    try { await broadcastToTM('AE_JOURNAL_STATE', await journalPayloadForBridge()); }
    catch (e) { api.v1.error('[AE:journal] broadcast:', e); }
}

async function journalAddBubble(text: string): Promise<JournalState> {
    const state = await loadJournal();
    const t = (text || '').trim();
    if (!t) return state;
    state.bubbles.push({ id: api.v1.uuid(), text: t, createdAt: Date.now(), archived: false });
    return await persistJournal(state);
}

async function journalUpdateBubble(id: string, text: string): Promise<JournalState> {
    const state = await loadJournal();
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.text = (text || '').trim();
    return await persistJournal(state);
}

async function journalDeleteBubble(id: string): Promise<JournalState> {
    const state = await loadJournal();
    state.bubbles = state.bubbles.filter(function(x) { return x.id !== id; });
    return await persistJournal(state);
}


async function journalSetArchived(id: string, archived: boolean): Promise<JournalState> {
    const state = await loadJournal();
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.archived = !!archived;
    return await persistJournal(state);
}

// Merge-down: append all non-archived bubbles (in order) into a single bubble.
// Archived bubbles are untouched. Inline stamps survive via buildJournalBody.
async function journalMergeDown(): Promise<JournalState> {
    const state = await loadJournal();
    const active = state.bubbles.filter(function(b) { return !b.archived; });
    if (active.length <= 1) return state;
    const mergedText = buildJournalBody(active, await loadConfig());
    const earliest = active.reduce(function(m, b) { return b.createdAt < m ? b.createdAt : m; }, active[0].createdAt);
    const merged: JournalBubble = { id: api.v1.uuid(), text: mergedText, createdAt: earliest, archived: false };
    const archived = state.bubbles.filter(function(b) { return b.archived; });
    state.bubbles = [merged].concat(archived);
    return await persistJournal(state);
}

// ── Generation verbs (story-aware, so voice matches the current model/style) ──
// Both run in 'background' mode and suppress this script's own context hooks so
// the journal doesn't re-inject itself while being rewritten.

async function journalGenerateRewrite(text: string): Promise<string | null> {
    const src = (text || '').trim();
    if (!src) return null;
    try {
        const cfg = await loadConfig();
        const sys = [
            (cfg.generalStyle || '').trim(),
            '',
            'Rewrite the player\'s journal note below in the narrative voice of this story.',
            'Absolute priority: preserve every fact, name, event, number, and decision exactly as written \u2014 invent nothing, omit nothing.',
            'Be token-efficient: tighten wording and cut filler while keeping all content.',
            'Past tense, third-person recap voice. Output ONLY the rewritten note \u2014 no preamble, no quotes, no commentary.'
        ].filter(Boolean).join('\n');
        const maxTok = Math.max(120, Math.min(700, Math.ceil(src.length / 3) + 80));
        const resp = await api.v1.generateWithStory(
            [ { role: 'system', content: sys }, { role: 'user', content: src } ],
            { model: 'glm-4-6', max_tokens: maxTok, temperature: 0.7 },
            { suppressScriptHooks: 'self', contextLimitReduction: 600 },
            undefined,
            'background'
        );
        if (resp && resp.choices && resp.choices.length > 0) return (resp.choices[0].text || '').trim() || null;
        return null;
    } catch (e) { api.v1.error('[AE:journal] rewrite:', e); return null; }
}

async function journalGenerateCompress(text: string): Promise<string | null> {
    const src = (text || '').trim();
    if (!src) return null;
    try {
        const cfg = await loadConfig();
        const sys = [
            (cfg.generalStyle || '').trim(),
            '',
            'Compress the player\'s journal note below into a shorter recap for long-term memory.',
            'Keep the load-bearing details: names, places, relationships, commitments, and outcomes. Drop atmosphere and repetition.',
            'Aim for roughly half the length or less. Past tense, plain and dense.',
            'Output ONLY the compressed recap \u2014 no preamble, no quotes, no commentary.'
        ].filter(Boolean).join('\n');
        const maxTok = Math.max(60, Math.min(400, Math.ceil(src.length / 6) + 40));
        const resp = await api.v1.generateWithStory(
            [ { role: 'system', content: sys }, { role: 'user', content: src } ],
            { model: 'glm-4-6', max_tokens: maxTok, temperature: 0.5 },
            { suppressScriptHooks: 'self', contextLimitReduction: 600 },
            undefined,
            'background'
        );
        if (resp && resp.choices && resp.choices.length > 0) return (resp.choices[0].text || '').trim() || null;
        return null;
    } catch (e) { api.v1.error('[AE:journal] compress:', e); return null; }
}

// ============================================================================
// SECTION 10c — PER-CHARACTER JOURNAL  [v2.12.0 CHARJOURNAL]
// Same bubble shape and verb set as Section 10b's player journal, scoped to one
// character instead of the whole story. The key difference: NO dedicated lorebook
// entry pair. Active bubbles fold straight into that character's OWN lorebook
// entry via buildCharDynamicBlock (see LOREFOLD, Section 6-ish) as one more
// toggleable field — same "rebuilt fresh every generation" treatment equipment/
// conditions already get, gated by cfg.lorebookFields.journal. Rewrite/compress
// reuse journalGenerateRewrite/journalGenerateCompress directly (pure text
// transforms with no journal-identity dependency — nothing to duplicate).
// Renderer lives in Section 27 (openCharJournalModal) so the bridge can drive the
// same verbs over the AE_CHAR_JOURNAL_* message pair.
// ============================================================================

async function loadCharJournal(charId: string): Promise<CharJournalState> {
    try {
        const raw = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_JOURNAL_PFX + charId, null);
        if (raw && typeof raw === 'object' && Array.isArray((raw as any).bubbles)) {
            const s = raw as CharJournalState;
            // [v2.116.0 JRNL-CHRONO] The single sort point for every character journal.
            s.bubbles = _ceJournalChrono(s.bubbles) as CharJournalBubble[];
            return s;
        }
    } catch (e) { api.v1.error('[AE:charjournal] loadCharJournal:', e); }
    return { bubbles: [] };
}

async function saveCharJournal(charId: string, state: CharJournalState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_CHAR_JOURNAL_PFX + charId, {
            bubbles: (state.bubbles || []).filter(Boolean)
        });
    } catch (e) { api.v1.error('[AE:charjournal] saveCharJournal:', e); }
}

// Single persistence path for every mutator. No lorebook-lore sync step (unlike
// the main journal's persistJournal) — buildCharDynamicBlock reads storage fresh
// every generation, same as conditions/equipment, so there's nothing to pre-sync.
async function persistCharJournal(charId: string, state: CharJournalState): Promise<CharJournalState> {
    await saveCharJournal(charId, state);
    if (isBridgeReady) { broadcastCharJournal(charId).catch(function() {}); }
    return state;
}

async function charJournalPayloadForBridge(charId: string): Promise<Record<string, any>> {
    const state = await loadCharJournal(charId);
    const bubbles = (state.bubbles || []).filter(Boolean).map(function(b) {
        return { id: b.id, text: b.text || '', archived: !!b.archived, createdAt: b.createdAt || 0 };
    });
    return { charId: charId, bubbles: bubbles };
}

async function broadcastCharJournal(charId: string): Promise<void> {
    try { await broadcastToTM('AE_CHAR_JOURNAL_STATE', await charJournalPayloadForBridge(charId)); }
    catch (e) { api.v1.error('[AE:charjournal] broadcast:', e); }
}

async function charJournalAddBubble(charId: string, text: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const t = (text || '').trim();
    if (!t) return state;
    state.bubbles.push({ id: api.v1.uuid(), text: t, createdAt: Date.now(), archived: false });
    return await persistCharJournal(charId, state);
}

async function charJournalUpdateBubble(charId: string, id: string, text: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.text = (text || '').trim();
    return await persistCharJournal(charId, state);
}

async function charJournalDeleteBubble(charId: string, id: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    state.bubbles = state.bubbles.filter(function(x) { return x.id !== id; });
    return await persistCharJournal(charId, state);
}

async function charJournalSetArchived(charId: string, id: string, archived: boolean): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.archived = !!archived;
    return await persistCharJournal(charId, state);
}

async function charJournalMergeDown(charId: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const active = state.bubbles.filter(function(b) { return !b.archived; });
    if (active.length <= 1) return state;
    const mergedText = active.map(function(b) { return (b.text || '').trim(); }).filter(Boolean).join('\n\n');
    const earliest = active.reduce(function(m, b) { return b.createdAt < m ? b.createdAt : m; }, active[0].createdAt);
    const merged: CharJournalBubble = { id: api.v1.uuid(), text: mergedText, createdAt: earliest, archived: false };
    const archived = state.bubbles.filter(function(b) { return b.archived; });
    state.bubbles = [merged].concat(archived);
    return await persistCharJournal(charId, state);
}

// ============================================================================
// SECTION 12 — CHARACTER SNAPSHOT GENERATION
//
// CHARACTER SNAPSHOT (GLM-backed — AI generation)
//    generateCharacterSnapshot: writes a present-tense appearance description
//    of a character as the protagonist encounters them. Used as scene flavor
//    text for the entity system's character-type nodes.
//
// NOTE — CONTEXT BUILDER SEPARATION:
// The injection sub-builders that feed into the Author's Note (buildCharInjection,
// buildMidRangeInjection, buildEphemeralInjection, charIsRelevant,
// buildEntityContextBlock, buildProtagonistInjection, buildDramatisPersonae)
// are NOT in this section. They live in Section 13 (Context Injection Builders)
// because they are pipeline components — the output of this section feeds them
// but they are architecturally distinct.
// ============================================================================

// ── Character Snapshot (AI generation) ───────────────────────────────────────

async function generateCharacterSnapshot(charRec: CharacterRecord, ent: EntityRecord, cfg: GlobalConfig): Promise<string | null> {
    // Generates a brief present-tense appearance description for a character
    // as encountered in their current location. Used by the entity system
    // for character-type nodes when a snapshot hasn't been generated yet.
    //
    // Uses api.v1.generateWithStory in 'background' mode so it runs without
    // surfacing a visible generation progress indicator.
    try {
        // Resolve location name for scene grounding
        let locationName = 'Unknown';
        let locationDesc = '';
        if (ent.parentId) {
            const locEnt = await loadEntity(ent.parentId);
            if (locEnt) { locationName = locEnt.name; locationDesc = locEnt.description || ''; }
        }

        // Resolve equipped item names for appearance context
        const equippedItems: string[] = [];
        for (const itemId of (charRec.equippedItemIds || [])) {
            try {
                const itemEnt = await loadEntity(itemId);
                if (itemEnt) equippedItems.push(itemEnt.name);
            } catch (ignoredErr) { /* non-fatal */ }
        }

        const idParts  = [charRec.gender, charRec.species, charRec.age, charRec.occupationRole].filter(Boolean);
        const idLine   = idParts.length > 0 ? ' (' + idParts.join(', ') + ')' : '';

        const sysPrompt = [
            cfg.generalStyle || '',
            '',
            `Write a brief present-tense description of ${charRec.name} as the protagonist notices them.`,
            '1 short paragraph. No internal thoughts, no dialogue, no summary statements.',
            '',
            'Capture:',
            '- Physical appearance including anything worn or carried',
            `- What they appear to be doing in ${locationName} (work here? live here? passing through? with the protagonist?)`,
            '- One behavioral or expressive detail reflecting their current state',
            '',
            'Concrete and specific. Show rather than tell.'
        ].join('\n');

        const userPrompt = [
            charRec.name + idLine,
            charRec.briefDescription         ? 'Brief: '     + charRec.briefDescription : '',
            charRec.physicalDescription      ? 'Appearance: ' + charRec.physicalDescription : '',
            charRec.background               ? 'Background: ' + charRec.background.slice(0, 100) : '',
            equippedItems.length > 0         ? 'Wearing/Carrying: ' + equippedItems.join(', ') : '',
            'Location: ' + locationName,
            locationDesc                     ? 'Setting: '    + locationDesc.slice(0, 80) : '',
            ent.atmosphere                   ? 'Thoughts: '   + ent.atmosphere : '',
            charRec.ephemeral?.compressedLine ? 'State: '     + charRec.ephemeral.compressedLine : ''
        ].filter(Boolean).join('\n');

        const response = await api.v1.generateWithStory(
            [
                { role: 'system', content: sysPrompt },
                { role: 'user',   content: userPrompt }
            ],
            { model: 'glm-4-6', max_tokens: 200 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );

        if (response && response.choices && response.choices.length > 0) {
            return response.choices[0].text || null;
        }
        return null;
    } catch (e) {
        api.v1.error('[AE:knowledge] generateCharacterSnapshot:', e);
        return null;
    }
}

// ============================================================================
// SECTION 13 — CONTEXT INJECTION BUILDERS
//
// All functions that construct content injected into the AI's context window.
//
// [CE-STRIP v2.6.0 CTX-CUT] Location, scene roster ("present with"), and the
// tracked-narrative quest line are REMOVED from injection entirely — dramatis
// persona / static identity are lorebook's job, and location/quest tracking now
// has no AN presence at all (the underlying Narrative Threads / STORAGE_
// TRACKED_NARRATIVE feature is untouched, only its injection is gone).
// buildTrackedNarrativeBlock and buildDramaContextBlock are deleted. Critical
// (85%+) hooks moved off the Imperative splice and into the same AN block as
// character thoughts. See the CE-INDEX PASS 9 note at the top of this file for
// full rationale and what's flagged-but-not-yet-built (urgent hooks / background
// NPC web currently have no injection destination).
//
// ── CURRENT INJECTION PIPELINE MAP ──────────────────────────────────────────
//
// onBeforeContextBuild  →  Author's Note (AN) slot
//   └── buildWorldStateBlock()
//         └── Per scene-present character (within the dynamic cap):
//               ├── Thoughts line — ephemeral + midRange (cfg.contextTemplates.npc)
//               └── Critical hook line, if pressureLevel ≥ 85 and unresolved
//                     (cfg.contextTemplates.criticalHook)
//
// onContextBuilt  →  Spliced before player input (highest recency weight)
//   └── Imperative block  [Section 26 — inline in hook]
//         ├── Pending GM note (fires once)
//         ├── Pending knowledge query (fires once)
//         (npcWeb links used to splice here too — removed v2.91.0 WEB-FLATTEN, they
//          were already in the AN block below and were injecting twice)
//
// onContextBuilt  →  Replaces player input (tag-based dice roll)
//   └── ⚠️ note: replaced probability system 
//         └── #tagname in player input → 1d6 + skill modifier → outcome line
//
// ── NOT CURRENTLY INJECTED ANYWHERE (flagged, not silently dropped) ─────────
// Urgent hooks (60–84%) and background/sub-70 NPC web links lost their
// destination when buildDramaContextBlock was deleted. Planned home: a per-scene
// temporary lorebook entry (dynamic fields + relationship web, narrative prose,
// per-field exclude option) — not built yet, separate pass.
//
// ── SUB-BUILDER STATUS ────────────────────────────────────────────────────────
// buildWorldStateBlock: called from onBeforeContextBuild (live).
// charIsRelevant: called from runDynamicEngine (live).
// buildProtagonistInjection, buildDramatisPersonae, buildEntityContextBlock,
// buildCharInjection, buildMidRangeInjection, buildEphemeralInjection:
//   defined but NOT currently called from the generation pipeline. Preserved as
//   utilities. buildDramatisPersonae is the likely starting point for the
//   to-do'd optional Dramatis Personae reference lorebook.
// ============================================================================

// Builds macro-accessible fields for a character: one entry per character resource
// keyed res_<tag> (tag '#' stripped). Discrete/track resources resolve to their current
// state label; pools to their numeric value. Blank/index-0 discrete values resolve to ''
// so the [ ... ] block self-suppresses.
// [v2.92.0 POSITION] relArchetype / relStage / primaryRelationship removed, and the cfg
// parameter went with them — it had no other reader in this function. Position does not
// come through here: it is built as its own data object in buildWorldStateBlock because
// its macros describe a PAIR (|name| and |targetName|), not one character's fields.
function buildCharMacroExtras(char: CharacterRecord): Record<string, any> {
    let extras: Record<string, any> = {};
    // Character resources → res_<tag>
    let resMap: Record<string, any> = {};
    for (const rdef of (char.charResourceDefs || [])) {
        let key = String(rdef.tag || '').replace('#', '').trim();
        if (!key) continue;
        let val = (char.charResourceValues && char.charResourceValues[rdef.id] !== undefined) ? char.charResourceValues[rdef.id] : 0;
        if (rdef.type === 'pool') {
            resMap[key] = String(val);
        } else {
            // track / discrete → state label; index 0 of a discrete is the clear/none slot → blank
            let states = rdef.states || [];
            let label = states[val] || '';
            if (rdef.type === 'discrete' && val === 0) label = '';
            resMap[key] = label;
        }
    }
    extras.res = resMap;

    // [v0.9.8.4] conditionStates: a convenience join of every active condition-type
    // resource (discrete/track with a non-blank current label), e.g. "drunk, poisoned".
    // Per-tag |res.<tag>| macros still work for precise references.
    let condParts: string[] = [];
    for (const cdef of (char.charResourceDefs || [])) {
        if (!cdef || cdef.type === 'pool') continue;
        let condVal = (char.charResourceValues && char.charResourceValues[cdef.id] !== undefined) ? char.charResourceValues[cdef.id] : 0;
        let condStates = cdef.states || [];
        let condLabel = condStates[condVal] || '';
        if (cdef.type === 'discrete' && condVal === 0) condLabel = '';
        if (condLabel) condParts.push(condLabel);
    }
    extras.conditionStates = condParts.join(', ');

    return extras;
}

function parseMacroTemplate(template: string, data: any): string {
    if (!template) return '';
    return template.replace(/\[([^\[\]]+)\]/g, function(match, inner) {
        let isValid = true;
        
        // Globally find and evaluate all |macro.path| tokens inside this specific bracket block
        const evaluatedInner = inner.replace(/\|([^\|]+)\|/g, function(macroMatch, path) {
            let val: any = data;
            const keys = path.trim().split('.');
            for (const k of keys) {
                if (val === undefined || val === null) break;
                val = val[k];
            }
            
            // If any token evaluates to empty/null, flag the entire bracket block for deletion
            if (val === undefined || val === null || String(val).trim() === '') {
                isValid = false;
                return '';
            }
            
            return String(val);
        });
        
        if (!isValid) return '';
        
        // Finalize block formatting
        return evaluatedInner.replace(/\\n/g, '\n');
    });
}


// NOTE FOR ASSEMBLY: STORAGE_RETRY_CHARS = 'ae_retry_chars' (used in Section 15's
// runDynamicEngine) was declared mid-file at line 8039 in the original alongside
// STORAGE_ENGINE_SKIP. Both belong in Section 2 constants. Add:
//   var STORAGE_RETRY_CHARS = 'ae_retry_chars';

// ── Per-character sub-builders ────────────────────────────────────────────────
// Legacy freeform injection helpers (buildProtagonistInjection, buildDramatisPersonae,
// buildCharInjection, buildMidRangeInjection, buildEphemeralInjection) retired.
// Dynamic prose values now consolidated cleanly in buildCharDynamicBlock and buildWorldStateBlock.

function charIsRelevant(c: CharacterRecord, activeEntryIds: Set<string>): boolean {
    // Returns true if a character should receive dynamic engine updates this turn.
    // A character is relevant if they are scene-present OR their lorebook entry fired.
    return c.active && c.scenePresent; // [v0.9.24 E2] removed lorebook-entry clause
}

// [vNEXT] Dynamic-priority cap. Given the already-loaded character index and the
// configured cap, returns the Set of character ids permitted to run as dynamic this
// turn. Pure in-memory over the index metas — NO storage reads, so it costs nothing
// on the generation path beyond a sort of the present-dynamic subset.
//
// Eligible pool = active, scene-present, non-protagonist, non-static (static chars
// are already excluded from dynamics by their own gate; excluding them here too means
// they never occupy a cap slot). Ordering: ranked characters first by ascending rank
// (1 = highest priority), then unranked characters by name. Unranked present-dynamic
// characters DO consume slots, after all ranked ones. cap <= 0 means no cap — every
// eligible id is returned.
function computeDynamicAllowedSet(index: CharacterMeta[], cap: number): Set<string> {
    const eligible = (index || []).filter(function(m) {
        return m && m.active && m.scenePresent && !m.isProtagonist && !(m as any).isStatic;
    });
    if (!(cap > 0) || eligible.length <= cap) {
        // No cap, or everyone fits — allow all eligible.
        return new Set(eligible.map(function(m) { return m.id; }));
    }
    eligible.sort(function(a, b) {
        const ar = (typeof (a as any).dynamicPriorityRank === 'number' && (a as any).dynamicPriorityRank > 0) ? (a as any).dynamicPriorityRank : Infinity;
        const br = (typeof (b as any).dynamicPriorityRank === 'number' && (b as any).dynamicPriorityRank > 0) ? (b as any).dynamicPriorityRank : Infinity;
        if (ar !== br) return ar - br;                       // ranked ascending; unranked (Infinity) last
        return String(a.name || '').localeCompare(String(b.name || '')); // stable tiebreak
    });
    return new Set(eligible.slice(0, cap).map(function(m) { return m.id; }));
}

// [vNEXT] Assign (or clear) a character's dynamic-priority rank, enforcing "one
// character per rank" by swapping. If another character already holds newRank, they
// inherit the assignee's OLD rank (which may be undefined -> they become unranked).
// Pass newRank <= 0 or undefined to simply clear the assignee's rank (no swap).
// Writes only the (at most) two affected records. Returns nothing; callers refresh UI.
async function assignDynamicPriorityRank(charId: string, newRank: number | undefined): Promise<void> {
    try {
        const target = await loadCharacter(charId);
        if (!target) return;
        const oldRank = (typeof (target as any).dynamicPriorityRank === 'number' && (target as any).dynamicPriorityRank > 0) ? (target as any).dynamicPriorityRank : undefined;
        const wantRank = (typeof newRank === 'number' && newRank > 0) ? Math.floor(newRank) : undefined;

        if (wantRank === oldRank) return; // no change

        // Clear case: just drop the rank.
        if (wantRank === undefined) {
            (target as any).dynamicPriorityRank = undefined;
            await saveCharacter(target);
            return;
        }

        // Find whoever currently holds wantRank (excluding the target) via the index
        // (cheap — no full character loads for the scan).
        const idx = await loadIndex();
        const holderMeta = idx.find(function(m) { return m && m.id !== charId && (m as any).dynamicPriorityRank === wantRank; });

        if (holderMeta) {
            const holder = await loadCharacter(holderMeta.id);
            if (holder) {
                // Swap: holder takes the target's old rank (may be undefined -> unranked).
                (holder as any).dynamicPriorityRank = oldRank;
                await saveCharacter(holder);
            }
        }
        (target as any).dynamicPriorityRank = wantRank;
        await saveCharacter(target);
    } catch (e) {
        api.v1.error('[AE:dynrank] assignDynamicPriorityRank:', e);
    }
}

// [vNEXT] Shared rank-picker modal for a character. Offers "Unranked" plus ranks
// 1..maxRank, where maxRank is the configured dynamic cap (or, if no cap is set, the
// count of eligible present characters, floored at a small minimum so the control is
// always usable). Shows which character currently holds each rank. onDone (optional)
// is invoked after assignment so the caller can refresh its own view.
async function openDynamicRankPicker(charId: string, onDone?: () => (void | Promise<void>)): Promise<void> {
    try {
        const cfg = await loadConfig();
        const idx = await loadIndex();
        const self = idx.find(function(m) { return m.id === charId; });
        const selfName = self ? (self.name || 'Character') : 'Character';
        const curRank = (self && typeof (self as any).dynamicPriorityRank === 'number' && (self as any).dynamicPriorityRank > 0) ? (self as any).dynamicPriorityRank : undefined;

        const cap = Number((cfg as any).maxDynamicCharacters) || 0;
        // How many rank slots to offer. With a cap, offer exactly the cap. Without a
        // cap, offer as many as there are eligible present characters (min 4 so the
        // control is meaningful even in a small scene).
        let eligibleCount = idx.filter(function(m) {
            return m && m.active && !m.isProtagonist;
        }).length;
        const maxRank = cap > 0 ? cap : Math.max(4, eligibleCount);

        // Rank -> holder name lookup (from the index; no character loads).
        const holderByRank: Record<number, string> = {};
        idx.forEach(function(m) {
            const r = (m as any).dynamicPriorityRank;
            if (typeof r === 'number' && r > 0) holderByRank[r] = m.name || 'Character';
        });

        const items: { id: string; label: string; selected?: boolean }[] = [];
        items.push({ id: '__unranked__', label: 'Unranked' + (curRank === undefined ? '  (current)' : ''), selected: curRank === undefined });
        for (let r = 1; r <= maxRank; r++) {
            let holder = holderByRank[r];
            let suffix = '';
            if (r === curRank) suffix = '  (current)';
            else if (holder && holder !== selfName) suffix = '  — held by ' + holder;
            items.push({ id: String(r), label: 'Rank ' + r + suffix, selected: r === curRank });
        }

        await openPickerModal({
            title: 'Dynamic Priority — ' + selfName,
            items: items,
            getId: function(item: any) { return item.id; },
            getLabel: function(item: any) { return item.label; },
            searchable: false,
            selectedId: curRank === undefined ? '__unranked__' : String(curRank),
            emptyText: 'No ranks available.',
            onSelect: async function(item: any) {
                const pick = item && item.id;
                if (pick === '__unranked__') await assignDynamicPriorityRank(charId, undefined);
                else await assignDynamicPriorityRank(charId, parseInt(pick, 10));
                if (onDone) await onDone();
            }
        });
    } catch (e) {
        api.v1.error('[AE:dynrank] openDynamicRankPicker:', e);
    }
}

// ── Primary builders ──────────────────────────────────────────────────────────

async function buildWorldStateBlock(protagChar: CharacterRecord | null): Promise<string> {
    // [CE-STRIP v2.6.0 CTX-CUT] Location, the present-roster line, and the quest
    // line are gone (see CE-INDEX PASS 9 / this file's Section 13 header). Static
    // identity still rides each character's force-activated lorebook entry. This
    // block is now ONLY per-character thoughts (ephemeral; midRange retired v2.90.0)
    // plus, merged
    // in per user's call, that character's critical (85%+) hook line — previously
    // injected separately via the onContextBuilt Imperative splice.
    // [pending protagonist pass] protagChar is now unused in this function body —
    // left on the signature/call site deliberately; the protag/player elimination
    // pass (flagged, not started) is where this actually gets cleaned up.
    const parts: string[] = [];
    const cfg = await loadConfig();

    const charIndex = await loadIndex();
    const presentMetas = charIndex.filter(function(m) { return m && m.active && m.scenePresent && !m.isProtagonist; });
    const _wsDynCap = Number((cfg as any).maxDynamicCharacters) || 0;
    const _wsDynAllowed = computeDynamicAllowedSet(charIndex as any, _wsDynCap);

    // ── PER-CHARACTER THOUGHTS + CRITICAL HOOK ────────────────────────────────
    try {
        const presentChars: string[] = [];
        // [v2.84.0 INJECT-TRACE] Per-character record of what was built and why, for the
        // summary log below. Built regardless of log-channel state (string ops only, no
        // storage/generation), so enabling the channel needs no re-run to become useful.
        const _wsTrace: string[] = [];
        // [v2.92.0 POSITION] Emitted as its own group after the thought lines rather than
        // interleaved with them, matching how npcWeb is grouped below. Each entry is one
        // character's private reading of another, so two characters positioned on each
        // other produce TWO lines here, deliberately — that asymmetry is the feature.
        const _wsPosLines: string[] = [];

        for (const meta of presentMetas) {
            // [vNEXT] Under a dynamic cap, only inject for characters within the cap.
            if (_wsDynCap > 0 && !_wsDynAllowed.has(meta.id)) continue;
            const char = await loadCharacter(meta.id);
            if (!char) continue;

            // [v0.9.30 HOOK-TIER] Ambient hooks (<60) remain available via the
            // |hookDescription| macro for anyone who hand-edits cfg.contextTemplates.npc
            // directly, but are omitted from the default template.
            let hookDesc = '';
            if (char.hooks && char.hooks.length > 0 && !char.hooks[0].resolved && char.hooks[0].pressureLevel < 60) {
                hookDesc = char.hooks[0].description;
            }

            // [v2.92.0 POSITION] Collected inside this loop rather than in a pass of its
            // own: the loop has already paid for loadCharacter(meta.id), so Position costs
            // one historyStorage read per character and no extra record read. It also
            // inherits the dynamic-cap skip above, which is correct — a character the cap
            // has excluded from injecting thoughts should not be injecting a read of
            // someone else either.
            try {
                const wpPos: any = (char as any).position;
                const wpTid = wpPos ? String(wpPos.targetId || '') : '';
                if (wpPos && wpTid && (wpPos.shape || wpPos.standing)) {
                    // Both parties must be in the scene. '__player__' is always present by
                    // definition (the protagonist is who the scene is being written for and
                    // is deliberately excluded from presentMetas), so it short-circuits.
                    const wpTgtHere = (wpTid === '__player__')
                        || charIndex.some(function(m: any) { return m && m.id === wpTid && m.active && m.scenePresent; });
                    if (wpTgtHere) {
                        const wpTier = await _ceReadPressure(char.id, 'position_' + wpTid);
                        // Stored name first (it is what the author actually typed or picked),
                        // index name only as a fallback for a record whose targetName was
                        // cleared but whose targetId survived.
                        let wpName = (wpTid === '__player__')
                            ? String((cfg as any).protagonistName || 'the player')
                            : String(wpPos.targetName || '');
                        if (!wpName) {
                            const wpMeta = charIndex.find(function(m: any) { return m && m.id === wpTid; });
                            wpName = wpMeta ? String((wpMeta as any).name || '') : '';
                        }
                        const wpLine = parseMacroTemplate((cfg.contextTemplates as any).position || '', {
                            name: char.name,
                            targetName: wpName,
                            shape: String(wpPos.shape || ''),
                            standing: String(wpPos.standing || ''),
                            positionPressure: _ceFramePosition(wpTier)
                        }).trim();
                        if (wpLine) _wsPosLines.push(wpLine);
                    }
                }
            } catch (ePos) { api.v1.error('[AE:context] position injection:', ePos); }

            const npcData = Object.assign({}, char, buildCharMacroExtras(char), { hookDescription: hookDesc });
            // [BUGFIX v2.28.0 WORLDSTATE-STALE-THOUGHTS, per user's report] A character
            // with auto-thoughts turned OFF must not leak a snapshot
            // that's just sitting on the record from before the toggle was flipped, or
            // from an import/migration — char.ephemeral is NOT cleared when
            // the toggle goes off, they just stop being refreshed. Omitting the field
            // here (rather than special-casing the template string) is enough:
            // parseMacroTemplate already self-suppresses a bracket block whose
            // referenced macro resolves to undefined/empty (see its own comment above).
            // Mirrors the exact same per-character gate the retry queue already uses
            // (_rcType === 'eph' && autoThoughtsEnabled).
            // Object.assign above already made npcData a fresh object, so this cannot
            // mutate the loaded character record.
            if (!char.autoThoughtsEnabled) npcData.ephemeral = null;
            // [v2.83.0 EPHEMERAL-REWIRE] Computed from npcData.ephemeral (post null-out
            // above, not char.ephemeral directly) so a character with auto-thoughts OFF
            // gets these blanked out too -- the same v2.28.0 stale-snapshot guard this
            // block already enforces for the rest of ephemeral, now covers the two new
            // fields rather than bypassing it.
            const _wsEph = npcData.ephemeral as EphemeralSnapshot | null;
            const _wsReaction = (_wsEph && _wsEph.emotionalResponse) ? _wsEph.emotionalResponse : '';
            const _wsRawIntent = (_wsEph && _wsEph.immediateDesire) ? _wsEph.immediateDesire : '';
            const _wsPursuitTier = _wsRawIntent ? await _ceReadPressure(char.id, 'pursuit') : 0;
            npcData.reactionLine = _wsReaction;
            npcData.intentLine = _wsRawIntent ? _ceFrameIntent(_wsRawIntent, _wsPursuitTier) : '';
            let thoughtsLine = parseMacroTemplate(cfg.contextTemplates.npc, npcData).trim();
            // Drop a thoughts line that rendered to nothing but the bare name.
            if (thoughtsLine === (char.name || '').trim()) thoughtsLine = '';

            // [CE-STRIP v2.6.0 CTX-CUT] Critical (85%+, unresolved) hook — now built
            // here instead of the onContextBuilt Imperative block. Urgent (60-84%)
            // hooks have no injection destination this pass (see Section 13 header).
            let hookLine = '';
            const topHook = (char.hooks && char.hooks.length > 0) ? char.hooks[0] : null;
            if (topHook && !topHook.resolved && topHook.pressureLevel >= 85 && topHook.description && topHook.description.trim()) {
                hookLine = parseMacroTemplate(cfg.contextTemplates.criticalHook, { name: char.name, hookDescription: topHook.description }).trim();
            }

            const combined = [thoughtsLine, hookLine].filter(Boolean).join('\n');
            if (combined) presentChars.push(combined);
            // [v2.84.0 INJECT-TRACE] Name the reason a character contributed nothing —
            // 'thoughts-off' and 'no-snapshot' look identical downstream but mean very
            // different things (a toggle vs. a generator that has not run or has failed).
            _wsTrace.push(char.name + '='
                + (combined ? ('ok'
                    + (npcData.intentLine ? '+intent(t' + _wsPursuitTier + ')' : '')
                    + (hookLine ? '+hook' : ''))
                  : (!char.autoThoughtsEnabled ? 'SKIP(thoughts-off)'
                     : (!char.ephemeral ? 'SKIP(no-snapshot)' : 'SKIP(empty-render)'))));
        }

        if (presentChars.length > 0) {
            parts.push(presentChars.join('\n'));
        }
        // [v2.92.0 POSITION] Own group, after the thought lines. Kept out of presentChars
        // so a character whose thought line was suppressed (auto-thoughts off, no snapshot)
        // still injects their Position — the two are independent statements and one being
        // absent is not a reason to withhold the other.
        if (_wsPosLines.length > 0) {
            parts.push(_wsPosLines.join('\n'));
        }
        // [v2.84.0 INJECT-TRACE] Until now NOTHING logged what actually reached the
        // Author's Note — '[AE:context]' appeared only inside error catches, so a
        // character silently omitted (static, over the dynamic cap, auto-thoughts off,
        // scene-absent, or simply never updated) was indistinguishable from one whose
        // line was injected and ignored by the model. Those two failures have completely
        // different fixes, which is exactly why this needs to be observable. Gated on the
        // 'context' log channel (/log context on) so it costs nothing when off.
        if (_wsTrace.length > 0) {
            aeLog('[AE:context] AN injection — ' + _wsTrace.length + ' present char(s): ' + _wsTrace.join(' | ')
                + ' | position lines=' + _wsPosLines.length);
        } else {
            aeLog('[AE:context] AN injection — no character lines built this turn.');
        }
    } catch (e) { api.v1.error('[AE:context] buildWorldStateBlock scene chars:', e); }

    // [v2.9.0 LOREFOLD] NPC web — bilateral dynamics between two scene-present
    // characters, bundled into the AN alongside thoughts (user's call). Injected only
    // when BOTH parties are present, so the shared fact appears exactly once (no
    // per-character double injection) and only when contextually relevant. Sorted by
    // [v2.91.0 WEB-FLATTEN] Unranked and unsorted: every qualifying link renders one
    // line via cfg.contextTemplates.npcWeb, in storage order. This is now the ONLY
    // npcWeb injection anywhere in the engine.
    try {
        const wsWeb = await loadNpcWeb();
        if (wsWeb && wsWeb.length > 0) {
            const wsPresentIds = new Set(presentMetas.map(function(m) { return m.id; }));
            const wsNameById = new Map<string, string>();
            for (const m of presentMetas) wsNameById.set(m.id, (m as any).name || '');
            const wsTpl = (cfg.contextTemplates as any).npcWeb || '';
            const wsLines: string[] = [];
            for (const wl of wsWeb) {
                if (!wsPresentIds.has(wl.charA_id) || !wsPresentIds.has(wl.charB_id)) continue;
                if (!wl.dynamic || !wl.dynamic.trim()) continue;
                const wsLine = parseMacroTemplate(wsTpl, {
                    nameA: wsNameById.get(wl.charA_id) || '',
                    nameB: wsNameById.get(wl.charB_id) || '',
                    dynamic: wl.dynamic
                }).trim();
                if (wsLine) wsLines.push(wsLine);
            }
            if (wsLines.length > 0) parts.push(wsLines.join('\n'));
        }
    } catch (eWeb) { api.v1.error('[AE:context] npc web injection:', eWeb); }

    return parts.join('\n\n');
}

// [CE-STRIP v2.6.0 CTX-CUT] buildTrackedNarrativeBlock and buildDramaContextBlock
// PHYSICALLY DELETED — each had exactly one caller (onBeforeContextBuild's
// questLine/dramaBlock locals), verified zero-referenced after those calls were
// removed. See CE-INDEX PASS 9 for full rationale.

// ============================================================================
// SECTION 14 — [RETIRED] legacy freeform #tag 1d6 skill-check system.
// Removed [vNEXT]: typing #force etc. directly in the story box no longer rolls.
// All skill checks now run through the Quick Action composer (2d6 fail-forward +
// the Stakes library below). UNIVERSAL_OUTCOMES / DEFAULT_OUTCOME_BANDS / rollD6 /
// getUniversalOutcome / getConsumedRoll / markRollConsumed removed with it.
// ============================================================================

// ============================================================================
// SECTION 15 — DYNAMIC ENGINE
//
// All AI generation that runs AFTER a story generation completes. This is the
// "background engine" — it updates character states (ephemeral thoughts,
// mid-range dynamics, arcs, hooks) based on the new story content.
//
// Execution order in runDynamicEngine (per character, per turn):
//   1. Retry queue — flushes characters deferred from previous budget-limited turn
//   2. Per character (active, non-protagonist, non-static):
//      a. Ephemeral thoughts, aka THE BEAT PASS (interval: thoughtIntervalTokens, ~600)
//         — also carries the pursuitState and positionState classifications
//      b. Hook update or spawn (interval: hookIntervalTokens, ~1800)
//      [v2.90.0 / v2.92.0] The mid-range and relationship steps that sat between these
//      two are gone; only two generators are dispatched from this loop now.
//
// Budget gates: checks api.v1.script.getAllowedOutput() before dispatching.
// If budget < threshold, the character is queued in STORAGE_RETRY_CHARS for
// the next generation rather than blocking this one.
//
// HELPERS IN THIS SECTION:
//   extractJSON, extractJSONArray     — GLM output parsers
//   getRecentStoryText                — story context reader
//   generateFieldContent              — character field AI generator
//   buildCharacterStateContext        — assembles character state for generator prompts
//     [v2.16.0] now async — also folds in active charJournal bubbles (Section 10c) as a
//     directed input, not just the passive lorebook fold buildCharDynamicBlock already did
//   generateArcMilestones             — milestone generator (called from UI)
// ============================================================================

// ── GLM Output Parsers ────────────────────────────────────────────────────────

function extractJSON(text: string): any {
    // Attempts multiple strategies to parse a JSON object from model output.
    // GLM sometimes omits the outer braces or wraps output in markdown fences.
    if (!text) return null;
    let clean = text.trim();

    // Fallback: model responded with key-value pairs missing the opening brace
    if (clean.startsWith('"') && !clean.includes('{')) {
        clean = '{' + clean;
        if (!clean.endsWith('}')) clean += '}';
    }

    try { return JSON.parse(clean); } catch {}
    try { const stripped = clean.replace(/```json\s*/gi, '').replace(/```\s*/gi, '').trim(); return JSON.parse(stripped); } catch {}
    try {
        const s = clean.indexOf('{'); const e = clean.lastIndexOf('}');
        if (s !== -1 && e !== -1 && e > s) return JSON.parse(clean.substring(s, e + 1));
    } catch (e) {}

    aeLog('[AE:engine] extractJSON failed on:', text.slice(0, 80));
    return null;
}

// ── Story Context Reader ──────────────────────────────────────────────────────

async function getRecentStoryText(maxTokens: number): Promise<string> {
    // Returns the most recent story text fitting within maxTokens.
    // Reads backward from the end so the freshest content is always included.
    try {
        const ids = await api.v1.document.sectionIds();
        if (ids.length === 0) return '';
        const si       = Math.max(0, ids.length - Math.ceil(maxTokens / 10) - 20);
        const sections = await api.v1.document.scan(undefined, { from: ids[si] });
        let text = ''; let used = 0;
        for (let i = sections.length - 1; i >= 0; i--) {
            const t = sections[i].section?.text || '';
            if (!t.trim()) continue;
            const enc = await api.v1.tokenizer.encode(t, 'glm-4-6');
            if (used + enc.length > maxTokens) break;
            text = t + '\n\n' + text;
            used += enc.length;
        }
        return text.trim();
    } catch { return ''; }
}

// [v2.38.0 CHARCHAT-THINK-FIRST] getRecentStoryText() reads the document tail backwards.
// During a chat the document tail IS the transcript, so that function cannot see the story
// at all — it returns chat text under a "Recent Story:" header, which is precisely the bug
// generateChatEphemeral() exists to stop feeding the model. This reads the story that sits
// ABOVE the chat marker instead: same backwards-from-the-newest, same token budget, just
// starting from the marker rather than from the end of the document.
// When no marker is present (no chat open) this is exactly getRecentStoryText's behaviour.
async function _charchatStoryTextAboveMarker(maxTokens: number): Promise<string> {
    try {
        let ccRows = await api.v1.document.scan();
        if (!ccRows || !ccRows.length) return '';
        let ccCut = ccRows.length;
        for (let ccI = 0; ccI < ccRows.length; ccI++) {
            let ccSec = ccRows[ccI] && ccRows[ccI].section;
            if (!ccSec) continue;
            if (String(ccSec.text || '').indexOf(_ccMarkerText()) >= 0) { ccCut = ccI; break; }   // [v2.99.0 CCINT] mode-correct marker
        }
        let ccText = '';
        let ccUsed = 0;
        for (let ccJ = ccCut - 1; ccJ >= 0; ccJ--) {
            let ccSec2 = ccRows[ccJ] && ccRows[ccJ].section;
            let ccT = (ccSec2 && ccSec2.text) ? String(ccSec2.text) : '';
            if (!ccT.trim()) continue;
            let ccEnc = await api.v1.tokenizer.encode(ccT, 'glm-4-6');
            if (ccUsed + ccEnc.length > maxTokens) break;
            ccText = ccT + '\n\n' + ccText;
            ccUsed += ccEnc.length;
        }
        return ccText.trim();
    } catch (eSm) {
        api.v1.error('[AE:charchat] story-above-marker read failed (thinking loses background context, not fatal):', eSm);
        return '';
    }
}

// ── Character Field Generator ─────────────────────────────────────────────────

// [v2.73.0 FIELD-CONTEXT] Shared character context for BOTH single-field generation
// and option generation. Before this, both generators saw only name, briefDescription
// and conceptDump — so a field was written without knowing the character's species,
// gender, age or role, and without seeing any SIBLING field that was already filled.
// The second half of that is the serious one: the slot instructions carry explicit
// anti-bleed clauses telling the model not to restate what belongs to another field,
// while the model had no way to see what the other fields actually said. This closes
// that: established siblings are shown, and shown as constraints.
//
// excludeLabel is matched case-insensitively against the field being written so the
// generator never sees its own current value as an established fact. Matching by LABEL
// rather than key is deliberate — neither generator takes a key, and threading one
// through would change two public signatures and every caller. The cost is that two
// fields sharing an identical label would exclude each other; labels are author-set and
// duplicates would already be confusing in the UI, so that is accepted, not overlooked.
async function buildFieldGenContext(char: CharacterRecord, excludeLabel: string): Promise<string> {
    const lines: string[] = [];
    const skip = (excludeLabel || '').trim().toLowerCase();

    // Identity line — same shape buildLorebookContent uses, so context and lorebook agree.
    const idLeader = [char.species, char.gender].map(function(s) { return (s || '').trim(); }).filter(Boolean).join(' ');
    const idMid    = [idLeader, (char.age || '').trim(), (char.occupationRole || '').trim()].filter(Boolean).join(', ');
    let identityLine = (char.name || '').trim();
    if (identityLine && idMid) identityLine += ' \u2014 ' + idMid;
    else if (!identityLine && idMid) identityLine = idMid;
    if (identityLine) lines.push('Identity: ' + identityLine);

    const nicks = (char.nicknames || []).filter(Boolean);
    if (nicks.length) lines.push('Also called: ' + nicks.join(', '));

    // Established siblings. Truncated per entry — these are meant to be short by design,
    // and a runaway hand-written field must not crowd out the rest of the context.
    const estab: string[] = [];
    function addEstab(label: string, value: string): void {
        const v = (value || '').trim();
        if (!v) return;
        if (label.trim().toLowerCase() === skip) return;
        estab.push(label + ': ' + (v.length > 240 ? v.slice(0, 240) + '\u2026' : v));
    }

    let ctxCfg: GlobalConfig | null = null;
    try { ctxCfg = await loadConfig(); } catch (eCtxCfg) { ctxCfg = null; }

    for (const fd of STATIC_FIELD_DEFS) {
        const fdLabel = (ctxCfg && ctxCfg.fieldLabels && ctxCfg.fieldLabels[fd.key]) || fd.label;
        addEstab(fdLabel, String((char as any)[fd.key] || ''));
    }
    if (char.coreValues && char.coreValues.length) addEstab('Core Values', char.coreValues.filter(Boolean).join('; '));
    // [v2.105.0 FIELD-GROUPING] Same read-time ordering as the lorebook entry. Not a
    // cosmetic change here: this list is what a generator is told is already fixed, and
    // related lines sitting together is the difference between a coherent brief and a
    // shuffled one.
    if (ctxCfg && ctxCfg.customStaticFields) {
        for (const cf of ceOrderStaticFields(ctxCfg.customStaticFields.filter(Boolean))) {
            addEstab(cf.label || cf.id, (char.customFieldValues || {})[cf.id] || '');
        }
    }

    if (estab.length) {
        lines.push('Already established about this character. Treat every line as fixed: do not contradict it, and do not restate it — each of these belongs to its own field.');
        for (const e of estab) lines.push('  - ' + e);
    }
    return lines.join('\n');
}

async function generateFieldContent(
    char: CharacterRecord,
    fieldLabel: string,
    instructions: string,
    generalStyle: string,
    hint: string,
    maxTokens: number,
    fcOpts?: { includeStory?: boolean }
): Promise<string | null> {
    // Generates content for a single character field using GLM.
    // Used by the character editor's auto-generate buttons.
    // NOTE: waitForAllowedOutput is intentionally absent — this runs from modal
    // button callbacks where the signal never fires (deadlock risk).
    // [v2.73.0 FIELD-CONTEXT] includeStory defaults TRUE here, unlike generateSlotOptions
    // where it defaults false. Not an inconsistency left lying: this function is reached
    // from the native editor's generate buttons, which have always been story-aware, and
    // flipping that default would silently change behaviour every existing user relies
    // on. Composition surfaces pass false explicitly.
    const fcStory     = !fcOpts || fcOpts.includeStory !== false;
    const recentText  = fcStory ? await getRecentStoryText(2000) : '';
    const fcContext   = await buildFieldGenContext(char, fieldLabel);
    const targetWords = Math.max(20, Math.floor(maxTokens * 0.75));

    const sys = [
        generalStyle,
        `You are writing the "${fieldLabel}" field for a character. This field has specific scope — stay inside it.`,
        instructions,
        `CONSTRAINT: Strictly under ~${targetWords} words. Finish your thought completely. ` +
        `Your output must be the content itself — do not begin with a label, header, or category name. ` +
        `Outputs that begin with words like "Voice:", "Appearance:", "Core Drive:", or any descriptor of what follows are invalid. ` +
        `Your first word must be content.`
    ].filter(Boolean).join('\n\n');

    const usrParts: string[] = [
        `Character: ${char.name}`,
        fcContext    ? fcContext : '',
        char.briefDescription ? `Anchor (do not contradict): ${char.briefDescription}` : '',
        char.conceptDump?.trim()
            ? `Reference notes (extract only what is directly relevant to the ${fieldLabel} field — ignore the rest):\n${char.conceptDump.trim()}`
            : '',
        hint?.trim() ? `Focus constraint: ${hint.trim()}` : '',
        recentText   ? `Recent story context:\n${recentText}` : '',
        `\nNow write the ${fieldLabel} field for ${char.name}.`
    ];

    try {
        const resp = await aeDiagGenerate(
            'field:' + fieldLabel + ':' + char.name,
            [{ role: 'system', content: sys }, { role: 'user', content: usrParts.filter(Boolean).join('\n\n') }],
            { model: 'glm-4-6', max_tokens: maxTokens + 30, temperature: 0.8 }
        );
        return (resp.choices[0]?.text || '').trim() || null;
    } catch (e) {
        api.v1.error('[AE:engine] generateFieldContent:', e);
        return null;
    }
}

// [v2.72.0 SLOT-OPTIONS] Generate N DIVERGENT candidate values for one field in a
// single call, for a pick-from-three UI. Deliberately NOT N calls to
// generateFieldContent: identical prompts at the same temperature mode-collapse into
// three rewordings of one idea, which is the specific failure that makes an option
// picker worthless. One call can see its own earlier options and be told to differ
// from them, and costs a third as much.
//
// Two further departures from generateFieldContent, both intentional:
//   - temperature defaults HIGHER (0.95 vs 0.8). Options want spread; a single
//     committed value wants fidelity. Same field, opposite sampling.
//   - recent story context is OFF by default. generateFieldContent always pulls 2000
//     chars of story, which is right when tuning an existing character mid-scene and
//     wrong when composing a new one — every character authored during a tense chapter
//     comes out tense. Callers opt IN via opts.includeStory.
//
// Returns null on failure or unparseable output; never throws to the caller. A short
// list is returned as-is rather than discarded — two good options beat an error.
async function generateSlotOptions(
    char: CharacterRecord,
    fieldLabel: string,
    instructions: string,
    generalStyle: string,
    hint: string,
    maxTokens: number,
    count: number,
    divergenceAxis: string,
    // [v2.93.0 SLOT-YOINK-TEST] method is an A/B test knob, not a permanent fork. 'yoink'
    // routes the single-candidate ask through executeYoinkGeneration (the editor.generate
    // hijack CharChat/the Wizard already use) instead of aeDiagGenerate (api.v1.generate).
    // The point of the test: does the SAME script-level budget (confirmed shared as far
    // back as v0.9.7.12) actually behave differently in practice for this call shape, and
    // does an independently-sampled single draw — repeated on demand — produce candidates
    // that diverge from each other MORE than one call self-differentiating three at once.
    // Both paths land in the same diagGenRecord ring buffer (Config modal's Generation
    // Diagnostics), tagged by method, so the two are directly comparable without any new
    // instrumentation.
    opts?: { temperature?: number; includeStory?: boolean; method?: 'direct' | 'yoink' | 'auto' }
): Promise<string[] | null> {
    // [v2.89.0 SLOT-COUNT] Floor lowered from 2 to 1. A single candidate is roughly a
    // third of the cost of three (see max_tokens below, which multiplies by wantCount),
    // and on a long character record that difference is the whole reason the author
    // hesitates to use the picker at all. wantCount === 1 takes a different prompt shape
    // and a different parse path — a "make them differ from each other" instruction is
    // incoherent for one candidate and actively degrades it.
    // [v2.93.0 SLOT-YOINK-TEST] yoink mode is ALWAYS wantCount 1, regardless of what count
    // was asked for. The self-differentiation instruction below ('candidates must differ
    // from each other') only means anything when one call can see its own other answers —
    // three separate yoink calls cannot see each other, so asking for three-in-one-call
    // framing across independent generations would be incoherent, not just wasteful.
    // "Unlimited regen" is the intended substitute: each click is one independent draw.
    // [v2.94.0 SLOT-YOINK-AUTO] 'auto' resolves HERE, not at the call site, because the
    // decision depends on the live run counter and must be read as late as possible --
    // another generator finishing between the handler's pre-flight and this point changes
    // the right answer. The handler still sizes its budget check for the pessimistic case
    // (see its gsoCount note), so a resolve-to-yoink after a direct-sized pre-flight is
    // safe; the reverse would not be, which is why the handler never resolves 'auto' itself.
    const _soAuto     = opts?.method === 'auto';
    const _soRun      = _soAuto ? await _ceYoinkRunGet() : 0;
    const _soYoink    = opts?.method === 'yoink' || (_soAuto && _soRun < AE_YOINK_RUN_MAX);
    const wantCount   = _soYoink ? 1 : Math.max(1, Math.min(5, count || 3));
    const targetWords = Math.max(20, Math.floor(maxTokens * 0.75));
    const temp        = (opts && typeof opts.temperature === 'number') ? opts.temperature : 0.95;
    const useStory    = !!(opts && opts.includeStory);

    const sys = [
        generalStyle,
        `You are writing the "${fieldLabel}" field for a character. This field has specific scope — stay inside it.`,
        instructions,
        wantCount > 1
            ? `You are producing ${wantCount} SEPARATE CANDIDATE VERSIONS of this field, not one answer and not a list of parts of one answer. ` +
              `Each candidate must independently satisfy everything above and be usable on its own.`
            : `You are producing ONE version of this field. It must satisfy everything above and be usable on its own.`,
        wantCount > 1
            ? (divergenceAxis
                ? `The candidates must differ from each other in kind, not in phrasing. ${divergenceAxis} ` +
                  `If two candidates could be edits of the same sentence, replace one of them.`
                : `The candidates must differ from each other in kind, not in phrasing. If two candidates could be edits of the same sentence, replace one of them.`)
            : '',
        wantCount > 1
            ? `FORMAT: separate the candidates with a line containing only three hyphens. ` +
              `Each candidate strictly under ~${targetWords} words and finishing its thought completely. ` +
              `Do not number, label, rank, introduce, or comment on the candidates. ` +
              `Do not begin any candidate with a label, header, or category name — the first word of each must be content. ` +
              `Output nothing but the ${wantCount} candidates and the separator lines between them.`
            : `FORMAT: output the field text and nothing else. ` +
              `Strictly under ~${targetWords} words, finishing the thought completely. ` +
              `Do not number, label, rank, introduce, or comment on it. ` +
              `Do not begin with a label, header, or category name — the first word must be content.`
    ].filter(Boolean).join('\n\n');

    const soContext = await buildFieldGenContext(char, fieldLabel);
    const usrParts: string[] = [
        `Character: ${char.name}`,
        soContext    ? soContext : '',
        char.briefDescription ? `Anchor (do not contradict): ${char.briefDescription}` : '',
        char.conceptDump?.trim()
            ? `Reference notes (extract only what is directly relevant to the ${fieldLabel} field — ignore the rest):\n${char.conceptDump.trim()}`
            : '',
        hint?.trim() ? `Steer toward this — the author has already written it into the field, so treat it as direction rather than as text to reuse verbatim: ${hint.trim()}` : '',
        useStory ? await getRecentStoryText(2000).then(function(t) { return t ? `Recent story context:\n${t}` : ''; }).catch(function() { return ''; }) : '',
        wantCount > 1
            ? `\nNow write ${wantCount} candidate versions of the ${fieldLabel} field for ${char.name}.`
            : `\nNow write the ${fieldLabel} field for ${char.name}.`
    ];

    // [v2.77.0 SLOT-BUSY] Retry on NAI's concurrency rejection. This is the failure
    // v2.29.0 already root-caused for CHARCHAT-FRESH-THOUGHTS: NAI rejects a generate while
    // another is in progress, and isBlocked() is NOT trustworthy — it has been observed
    // returning false immediately before generate() throws. So the remedy is the same one
    // used elsewhere in this file: try, back off, try again.
    //
    // Only 'already in progress' is retried. Every other error is a real failure and
    // retrying it just burns budget and makes the user wait for the same answer.
    //
    // Rethrows once retries are exhausted, rather than returning null as before. That
    // change is the point: a swallowed error became an indistinguishable "nothing came
    // back", which is exactly why the reported failure gave no reason.
    const soAttempts = 3;
    let soLastErr: any = null;
    for (let soTry = 0; soTry < soAttempts; soTry++) {
        try {
            // [v2.93.0 SLOT-YOINK-TEST] executeYoinkGeneration is ITSELF already retried,
            // watchdog-bounded, and drift/validator-checked internally (see its own header
            // comment) — this outer soAttempts loop only exists here to catch a genuine
            // '_aeYoink already in progress' collision (WIZLIVE/CharChat/classic wizard
            // holding the slot) and back off, exactly like the direct path's own
            // 'already in progress' handling below. Both throw that same substring, so
            // one shared retry shell covers both paths without duplicating the logic.
            const soMsgs = [{ role: 'system', content: sys }, { role: 'user', content: usrParts.filter(Boolean).join('\n\n') }];
            let soRawText: string;
            if (_soYoink) {
                soRawText = await executeYoinkGeneration(soMsgs, { tag: 'slotopts-yoink:' + fieldLabel + ':' + char.name });
                // Count the attempt, not the success. A yoink that came back empty still
                // consumed one of the run -- treating it as free would keep re-attempting a
                // path NAI has already stopped serving and turn a soft cap into a hang.
                if (_soAuto) await _ceYoinkRunSet(_soRun + 1);
                // [v2.94.0 SLOT-YOINK-AUTO] The cap is observed, not contractual, so auto
                // mode must not trust it. An empty yoink means the run ended earlier than
                // AE_YOINK_RUN_MAX predicted; fall through to a metered call rather than
                // surfacing a failure the author would have fixed by pressing More again.
                // Only in 'auto' -- explicit 'yoink' is a test setting and must stay honest
                // about what it did, or the diagnostics comparison is worthless.
                if (_soAuto && !soRawText.trim()) {
                    aeLog('[AE:engine] slotopts auto: yoink run exhausted at ' + _soRun + ', falling back to metered');
                    soRawText = String((await aeDiagGenerate(
                        'slotopts:' + fieldLabel + ':' + char.name,
                        soMsgs,
                        { model: 'glm-4-6', max_tokens: (maxTokens + 30) * wantCount + 40, temperature: temp }
                    )).choices[0]?.text || '');
                }
            } else {
                soRawText = String((await aeDiagGenerate(
                    'slotopts:' + fieldLabel + ':' + char.name,
                    soMsgs,
                    { model: 'glm-4-6', max_tokens: (maxTokens + 30) * wantCount + 40, temperature: temp }
                )).choices[0]?.text || '');
            }
            return parseSlotOptions(soRawText, wantCount);
        } catch (e) {
            soLastErr = e;
            const soMsg = String((e && (e as any).message) || e || '');
            if (soMsg.indexOf('already in progress') < 0) break;
            if (soTry < soAttempts - 1) {
                aeLog('[AE:engine] generateSlotOptions busy, retry ' + (soTry + 1) + '/' + (soAttempts - 1));
                await api.v1.timers.sleep(1200 * (soTry + 1));
            }
        }
    }
    api.v1.error('[AE:engine] generateSlotOptions:', soLastErr);
    throw soLastErr;
}

// [v2.72.0 SLOT-OPTIONS] Split a candidate block on separator lines and clean each
// entry. Tolerant on purpose — the model reliably produces the separator but is less
// reliable about NOT labelling entries, so leading "Option 2:" / "2." / "-" / "**"
// noise is stripped rather than treated as a parse failure. Falls back to blank-line
// splitting when no separator survived at all.
// Near-duplicates are dropped: two candidates opening identically are the exact
// mode-collapse this whole function exists to avoid, so returning both would be worse
// than returning fewer.
function parseSlotOptions(raw: string, wantCount: number): string[] | null {
    let txt = (raw || '').trim();
    if (!txt) return null;
    txt = txt.replace(/^```[a-zA-Z]*\s*/, '').replace(/```\s*$/, '').trim();

    // [v2.89.0 SLOT-COUNT] Single-candidate path returns the whole reply as one option.
    // Splitting first would be actively wrong here: a legitimate multi-paragraph answer
    // has no separator, so the blank-line fallback below would silently truncate it to
    // its first paragraph. The label-noise strip is kept (the model still occasionally
    // prefixes one), minus the enumeration pattern, which cannot apply to a lone answer.
    if (wantCount <= 1) {
        let solo = txt.replace(/^(?:\*\*|__)?\s*(?:option|candidate|version)\s*\d*\s*[:.\-\u2014]\s*/i, '');
        solo = solo.replace(/^[-*\u2022]\s+/, '');
        solo = solo.replace(/^(?:\*\*|__)\s*/, '').replace(/\s*(?:\*\*|__)$/, '').trim();
        return solo ? [solo] : null;
    }

    let parts = txt.split(/^[ \t]*-{3,}[ \t]*$/m);
    if (parts.length < 2) parts = txt.split(/\n[ \t]*\n[ \t]*\n+/);

    const out: string[] = [];
    const seen: Record<string, boolean> = {};
    for (let p of parts) {
        let s = (p || '').trim();
        if (!s) continue;
        // Strip enumeration / emphasis / label noise the format instruction asked for but may not get.
        // NOTE: the close-paren in this character class is written \u0029 rather than
        // literally. Written literally it is a lone unmatched closing bracket in source
        // text, and this file's only structural safety net is a bracket balance-delta
        // pass against the prior trunk — one literal character here silently poisons
        // that check for every future patch. Same reason this comment spells it out in
        // words instead of showing the character.
        s = s.replace(/^(?:\*\*|__)?\s*(?:option|candidate|version)?\s*\d+\s*[.\u0029:\-\u2014]\s*/i, '');
        s = s.replace(/^[-*\u2022]\s+/, '');
        // Emphasis is stripped from each end INDEPENDENTLY, not as a matched pair. A
        // paired unwrap fails on the common '**1. text.**' shape: the enumeration strip
        // above has already eaten the opening marker, so the pair no longer matches and
        // the trailing one survives into the option text. Caught in test, not in review.
        s = s.replace(/^(?:\*\*|__)\s*/, '');
        s = s.replace(/\s*(?:\*\*|__)$/, '');
        s = s.trim();
        if (!s) continue;
        const key = s.slice(0, 40).toLowerCase().replace(/[^a-z0-9]/g, '');
        if (seen[key]) continue;
        seen[key] = true;
        out.push(s);
        if (out.length >= wantCount) break;
    }
    return out.length ? out : null;
}

// ── Character State Context Builder ──────────────────────────────────────────

async function buildCharacterStateContext(char: CharacterRecord): Promise<string> {
    // Assembles a compact multi-line summary of a character's current dynamic state.
    // Passed as context to all generator prompts so GLM can update fields correctly.
    const lines: string[] = [];

    if (char.ephemeral && char.ephemeral.compressedLine) {
        lines.push(`Current moment (${char.name}): "${char.ephemeral.compressedLine}"`);
        if (char.ephemeral.eventAnchor)     lines.push(`  → Triggered by: ${char.ephemeral.eventAnchor}`);
        if (char.ephemeral.immediateDesire) lines.push(`  → Driving them to: ${char.ephemeral.immediateDesire}`);
    }
    // [v2.16.0 CHARJOURNAL-WEIGHT] Active (non-archived) journal bubbles are now a
    // directed generator input, not just passive lorebook filler (buildCharDynamicBlock
    // still folds them into the lorebook separately — this is additive, not a replacement).
    // Read failures here must never break a dynamic-update cycle, so they're swallowed.
    try {
        const journal = await loadCharJournal(char.id);
        const activeBubbles = (journal.bubbles || []).filter(function(b) { return !b.archived && (b.text || '').trim(); });
        if (activeBubbles.length > 0) {
            lines.push(`${char.name}'s own journal notes (weigh these — they reflect what the character considers significant):`);
            activeBubbles.slice(-4).forEach(function(b) { lines.push(`  - ${b.text.trim()}`); });
        }
    } catch (e) { api.v1.error('[AE:engine] buildCharacterStateContext journal read:', e); }
    return lines.join('\n');
}

// ── Generators ────────────────────────────────────────────────────────────────

// [v2.83.0 EPHEMERAL-REWIRE] The six CE_PATTERNS ids, hardcoded here to match both
// BUILTIN_FACETS (engine) and CE_PATTERNS (bridge) exactly.
//
// [v2.98.0 PATTERN-STORED, SUPERSEDES the note this replaces] Through v2.97.0 there was
// no stored "which pattern" field -- identity was purely implicit in which
// ce_slot_resist_<id> pair held text, on the grounds that a second field could drift from
// it. Per user direction that reasoning is retired, not the mechanism: CharacterRecord.pattern
// is now authoritative when present (see _ceResolveCharPattern), with the OLD scan kept as
// the fallback for any record saved before this version. Nothing here still assumes there
// is no stored field -- if you are reading old comments elsewhere that say otherwise, this
// note is the correction.
const CE_PATTERN_IDS: string[] = ['contradiction', 'wantneed', 'defense', 'ruleset', 'appetite', 'mask'];

// [v2.109.0 PATTERN-DEFS] The pattern display table, ported from the bridge's CE_PATTERNS
// (bridge SECTION 18) and now ENGINE-AUTHORITATIVE. It was bridge-only because the Studio
// was the only surface that rendered it; the jsx profile needs it, and the bridge Studio is
// on the deletion keep-list, so the copy moves rather than being duplicated. Do not
// re-mirror it bridge-side.
//
// `resist` and `conduct` are not decoration: they ARE the prompts for the two slots the
// pattern gates (ce_slot_resist_<id> / ce_slot_conduct_<id>), which is precisely why the
// pattern choice sits between Drive and Resistance in the build order and nowhere else.
//
// `c` is a fixed literal hue, like CE_SEM. AURA ONLY -- junction dot, gated-group rail,
// card edge. It must never be applied to body text, on either artifact.
const CE_PATTERN_ORDER: string[] = ['contradiction', 'wantneed', 'defense', 'ruleset', 'appetite', 'mask'];
const CE_PATTERN_DEFS: { [k: string]: any } = {
    contradiction: { c: '#5fc0a0', sub: 'Contradiction',
        name: 'They\u2019re one thing, and also the opposite',
        blurb: 'Two true things pulling against each other',
        resist: 'What is the second thing that is also true, and pulls the other way?',
        conduct: 'Which side shows normally, and what brings the other one out?' },
    wantneed: { c: '#e09a4f', sub: 'Want / Need',
        name: 'They\u2019re chasing the wrong thing',
        blurb: 'Convinced the substitute will fix it',
        resist: 'What do they believe will settle it, that cannot?',
        conduct: 'How do they chase it, and who ends up paying?' },
    defense: { c: '#5aa6de', sub: 'Defense',
        name: 'They\u2019re guarding a sore spot',
        blurb: 'Something they cannot afford to have seen',
        resist: 'What would it cost them to be seen clearly?',
        conduct: 'How do they steer away from it, and what leaks anyway?' },
    ruleset: { c: '#9aa8b8', sub: 'Rule set',
        name: 'They live by rules',
        blurb: 'A private code, and the day it breaks',
        resist: 'What are their rules, and which one will have to give?',
        conduct: 'How do they keep them, and what happens when someone else does not?' },
    appetite: { c: '#d55a72', sub: 'Appetite',
        name: 'They want what they want',
        blurb: 'A hunger, and the one line they hold',
        resist: 'What can they not refuse \u2014 and what will they not touch?',
        conduct: 'How do they go after it: openly, patiently, or sideways?' },
    mask: { c: '#9e7ade', sub: 'Function mask',
        name: 'The role isn\u2019t the person',
        blurb: 'A part they play that forbids something',
        resist: 'What does the role forbid them from wanting?',
        conduct: 'How do they perform it, and when does the person slip through?' }
};

// Stored value wins when it is one of the two known shapes; otherwise scan. A record with
// any slot value written is a studio character, a record with any core narrative prose is a
// classic one, and a record with neither is new -- which resolves to 'studio' because that
// is the guided path and a blank character benefits most from being walked.
function _ceResolveShape(char: any, cfg: any): string {
    var stored = String((char && char.uiShape) || '');
    if (stored === 'studio' || stored === 'classic') return stored;
    // [v2.162.0 SHAPE-CLASSIC-FIRST, per user: "the default view is the new style which
    // hides their fields and shows blank slots"] THE CLASSIC SCAN NOW RUNS FIRST.
    //
    // The old order asked "is there a slot value?" before "is there sheet prose?", which
    // is the wrong question for a record written before the studio model existed. Slot
    // values arrive on such a record by accident -- one tap in the pattern picker, one
    // Generate pressed while the surface happened to be in studio shape -- and a SINGLE
    // stray slot outvoted four fully written sheet fields. The reverse mistake is not
    // symmetric: a studio character has no path that writes physicalDescription /
    // personalityCore / voiceAndMannerisms / background behind the author's back, because
    // those fields are only reachable from the sheet renderer itself.
    //
    // coreValues counts as classic evidence too. It is a sheet-only field and a record
    // with values in it and nothing else was resolving to studio, i.e. to a screen that
    // showed none of what had been written.
    //
    // Either way this is only a GUESS for records that have never chosen. The moment the
    // author uses the switch, uiShape is stored and neither scan runs again -- and
    // the toggle at the top of the Profile makes a wrong guess correctable in one tap.
    try {
        var vals = (char && char.customFieldValues) || {};
        var j = 0;
        for (j = 0; j < STATIC_FIELD_DEFS.length; j++) {
            if (String((char as any)[STATIC_FIELD_DEFS[j].key] || '').trim() !== '') return 'classic';
        }
        if (Array.isArray((char as any).coreValues) && (char as any).coreValues.length > 0) return 'classic';
        var defs = (cfg && cfg.customStaticFields) || [];
        for (var i = 0; i < defs.length; i++) {
            var d: any = defs[i];
            if (!d || String(d.kind || '') !== 'slot') continue;
            if (String(vals[d.id] || '').trim() !== '') return 'studio';
        }
    } catch (eShape) { api.v1.error('[AE:shape] resolve failed:', eShape); }
    // [v2.163.0 SHAPE-CLASSIC-DEFAULT, per user] A record with NO evidence either way now
    // resolves to 'classic', not 'studio'. v2.162.0 had already made the classic scan run
    // first; this closes the remaining case, which is the one a brand-new character hits.
    // The old default existed because studio was "the guided path" -- but Classic now
    // carries Core and Pursuit itself (see _ceProfileClassic), so the guided extras are
    // one tap away on the shape toggle rather than something a new record is opted into.
    return 'classic';
}

// [v2.98.0 PATTERN-STORED] Resolve which pattern is active for this character. Stored
// char.pattern wins when it validates against CE_PATTERN_IDS; otherwise falls back to the
// pre-v2.98.0 scan (first customFieldValues resist slot with content), which is what makes
// every record saved before this version keep working with no migration step. A record
// that has never had a pattern touched at all correctly resolves to ''.
//
// This is now the ONE place pattern identity is resolved. _ceCharPatternSlots and the
// Generation Diagnostics dump (~line 1780) both call this rather than re-deriving it, so
// there is exactly one scan to keep in sync with CE_PATTERN_IDS, not two.
function _ceResolveCharPattern(char: CharacterRecord): string {
    const stored = String((char as any).pattern || '');
    if (stored && CE_PATTERN_IDS.indexOf(stored) >= 0) return stored;
    const cfv = (char as any).customFieldValues || {};
    for (const pid of CE_PATTERN_IDS) {
        const r = cfv['ce_slot_resist_' + pid];
        if (r && String(r).trim()) return pid;
    }
    return '';
}

// [v2.98.0 PATTERN-STORED] Reads resist/conduct text for the RESOLVED pattern rather than
// scanning for text directly. Behaviourally identical to the pre-v2.98.0 version for every
// existing record (the scan _ceResolveCharPattern falls back to is the same scan this
// function used to run inline) -- the only change in outcome is for a record whose stored
// pattern has been switched to one with empty resist/conduct text, which correctly now
// reports empty rather than falling through to whichever OTHER pair happens to have text.
function _ceCharPatternSlots(char: CharacterRecord): { resistance: string; conduct: string } {
    const pid = _ceResolveCharPattern(char);
    if (!pid) return { resistance: '', conduct: '' };
    const cfv = (char as any).customFieldValues || {};
    const r = cfv['ce_slot_resist_' + pid] || '';
    const c = cfv['ce_slot_conduct_' + pid] || '';
    return { resistance: String(r).trim(), conduct: String(c).trim() };
}

// [v2.83.0 EPHEMERAL-REWIRE] Grades the SAME model-authored immediateDesire by rule,
// never by asking the model to re-author urgency — the pressure tier changes the verb
// framing (want -> seek -> commit), the character's own words never change. This is
// the mechanism that gives a narrative-trained model an actual push toward agency: by
// tier 4 the line reads as near-future fact ("is going to X — now"), not a feeling, and
// a model conditioned on narrative prose is far more likely to carry a stated upcoming
// action into the next beat than an interior "wants X". desire arrives as a bare verb
// phrase (see the prompt's instruction) — normalized defensively here in case older
// saved data or model drift still capitalizes/punctuates it as a standalone sentence.
function _ceFrameIntent(desire: string, tier: number): string {
    let d = String(desire || '').trim().replace(/\.+$/, '');
    if (d) d = d.charAt(0).toLowerCase() + d.slice(1);
    if (!d) return '';
    // [v2.88.0 NPC-TPL-1LINE] Capitalized, because this is now a SECOND SENTENCE on the
    // same line as the reaction rather than its own line: "Name — thinking: <reaction>.
    // Wants to <desire>." Sentence separation is what keeps the intent from reading as
    // more interior monologue (the v2.83.0 em-dash join was the failure) while still
    // costing only one Author's Note line per character. It stays LAST on the line
    // deliberately — closest to the generation point is where a stated near-future
    // action has the most pull on what the model writes next.
    if (tier >= 4)      return 'Is going to ' + d + ' — now.';
    if (tier >= 2)      return 'Is looking for a way to ' + d + '.';
    return 'Wants to ' + d + '.';
}

// [v2.92.0 POSITION] The Position half of the same idea, and the same discipline: the
// model never rewrites shape or standing, it only classifies, and this turns the
// resulting tier into one short clause appended to the author's own words.
//
// The axis is OBJECTIVE, so it runs the full signed -4..+4 that _ceAxisFloor gives every
// non-hook axis. Positive is friction (the relationship is getting harder), negative is
// progress (it is getting easier) — the SAME polarity convention as pursuit, which is why
// 'blocked' and 'advanced' can mean the obvious thing here without a sign flip anywhere.
//
// Returns '' across the middle band (-1..1) on purpose. A relationship where nothing has
// moved should say nothing extra rather than assert stability it has not earned, and an
// empty macro lets the template bracket self-suppress instead of rendering a limp clause
// on every single line.
function _ceFramePosition(tier: number): string {
    if (tier >= 4)  return 'This is at breaking point.';
    if (tier >= 2)  return 'This is under strain.';
    if (tier <= -4) return 'This has settled into something steady.';
    if (tier <= -2) return 'This is easing.';
    return '';
}

async function generateEphemeral(
    char: CharacterRecord,
    cfg: GlobalConfig,
    genCount: number = 0 // [v0.9.24 E1] was tokenCount
): Promise<boolean> {
    try {
        const recentText = await getRecentStoryText(1500);
        // [v2.83.0 EPHEMERAL-REWIRE] This IS the beat pass now — the pursuitState ask
        // rides the same call rather than adding a second one (cost-neutral: same
        // context, same moment, ~5 extra output tokens for one enum word).
        const _cePatSlots = _ceCharPatternSlots(char);

        // [v2.92.0 POSITION] The positionState ask is gated TWO ways, not one. Pursuit is
        // an internal objective and is always askable if it exists; a Position is a read
        // of another party, so asking the model to classify what the beat did to it while
        // that party is nowhere in the scene invites an answer invented out of nothing —
        // and an invented classification moves a real tier, which is precisely the kind of
        // fabricated evidence the whole model is built to refuse. Absent target, no ask,
        // no tier movement, and the beat costs the same as it did before.
        const _cePos: any = (char as any).position;
        let _cePosOn = false;
        let _cePosName = '';
        const _cePosTid = _cePos ? String(_cePos.targetId || '') : '';
        if (_cePosTid && (_cePos.shape || _cePos.standing)) {
            if (_cePosTid === '__player__') {
                _cePosOn = true;
                _cePosName = String(_cePos.targetName || '') || (cfg as any).protagonistName || 'the player';
            } else {
                try {
                    const _cePosIdx = await loadIndex();
                    const _cePosHit = _cePosIdx.find(function(m: any) {
                        return m && m.id === _cePosTid && m.active && m.scenePresent;
                    });
                    if (_cePosHit) {
                        _cePosOn = true;
                        _cePosName = String(_cePos.targetName || '') || String((_cePosHit as any).name || '');
                    }
                } catch (ePosGate) {
                    api.v1.error('[AE:engine] position gate index read:', ePosGate);
                    _cePosOn = false;
                }
            }
        }

        const sys = [
            cfg.generalStyle,
            `Generate an internal snapshot for ${char.name} based on the current moment.`,
            // [v0.9.33 AIR1] Explicit isolation: when multiple characters are present,
            // each generation call must produce only this character's perspective.
            `Focus exclusively on ${char.name}. Do not generate, reference, or echo the internal states, reactions, or thoughts of any other character present in the scene.`,
            // [v2.14.0 GENESIS] Examples describe SHAPE ONLY — no sample story content to
            // copy (observed failure: output lifted the old worked examples verbatim).
            `Return ONLY valid JSON with these exact keys:`,
            `  "eventAnchor": The one concrete, observable thing in the latest story beat ${char.name} is reacting to — a specific action, object, line, or silence, never a mood or abstraction. One sentence, normal sentence case, ending with a period. This is scaffolding for you, the writer — it grounds the next two fields in something real. It is NOT shown to the reader.`,
            `  "emotionalResponse": ${char.name}'s own unspoken reaction, written as a first-person internal thought in ${char.name}'s own voice and cadence — not a third-person description of an emotion, and not an emotion-label word ('felt', 'angry', 'sad'). Do not use ${char.name}'s name. One sentence, normal sentence case, ending with a period.`,
            `  "immediateDesire": The single action ${char.name} intends right now — a bare verb phrase, under 10 words, no name/subject prefix, NO capital letter, NO trailing period (e.g. "get out before he says it", not "Get out before he says it."). This will be inserted into a sentence, so it must read as a lowercase clause fragment, not a standalone sentence.`,
            char.customFieldValues?.['ce_slot_pursuit'] ? `  "pursuitState": Given ${char.name}'s current objective (Pursuit, below), classify what the recent story just did to it. Exactly one of: "blocked" (thwarted, made harder, or closed off an easy route), "advanced" (real progress, or ground gained), "untouched" (this beat did not meaningfully touch it).` : '',
            // [v2.92.0 POSITION] Same three words as pursuitState, deliberately: _ceApplyPressure
            // takes exactly this enum, and the sign convention is shared (positive tier is
            // friction, negative is progress), so 'blocked'/'advanced' mean the obvious thing
            // on both axes and no call site anywhere needs to special-case a flip.
            _cePosOn ? `  "positionState": Given where ${char.name} stands with ${_cePosName} (Position, below), classify what the recent story just did to it. Judge it from ${char.name}'s side only. Exactly one of: "blocked" (strained it, cost trust, or pushed them further apart), "advanced" (closed distance, or ground gained between them), "untouched" (this beat did not meaningfully touch it).` : '',
            // [v2.53.1 THOUGHT-VOICE-CASE] Was three separate "Capitalized." cues, one per
            // field — that repetition is what was pushing the model to all-caps output
            // instead of sentence case. One explicit instruction, stated once, below.
            `Write emotionalResponse and eventAnchor in normal sentence case — a capital letter only at the very start, never the whole field in capitals. immediateDesire is the one exception: it stays fully lowercase per its own instruction above, since it is a fragment, not a sentence. Every detail must come from the story and character context below, never from the wording of these instructions. No markdown fences. No extra keys. Return nothing but the JSON object.`
        ].filter(Boolean).join('\n');

        // [v2.83.0 EPHEMERAL-REWIRE] Repetition guard now checks the last 2 INTENTS, not
        // the last 2 full compressedLines. A stuck character restates the same immediate
        // desire, not the same eventAnchor+reaction+desire triple — checking the whole
        // line wasted budget re-feeding old story recap to prevent an echo it wasn't
        // actually the source of. The real anti-repetition mechanism is structural: three
        // 'blocked' beats escalates the FRAMING (see _ceFrameIntent), so a character who
        // keeps wanting the same thing moves toward acting on it instead of repeating the
        // want verbatim.
        const ephHistLines = (char.ephemeralHistory || []).slice(0, 2)
            .map(function(h: any) { return h.immediateDesire || ''; }).filter(Boolean);

        const usr = [
            `Character: ${char.name}`,
            char.personalityCore       ? `Personality: ${char.personalityCore}` : '',
            char.voiceAndMannerisms    ? `Voice/manner: ${char.voiceAndMannerisms}` : '',
            // [v2.83.0 EPHEMERAL-REWIRE] midRange.currentDesire/socialMask/shiftedView
            // replaced with the schema v0.2 slots: Core (constant, threshold-only) and
            // Pursuit (the concrete objective now) are pattern-independent; Resistance
            // and Conduct are resolved from whichever pattern this character's slots were
            // authored under (_ceCharPatternSlots). Conduct in particular is new and
            // high-value here — "what they do when Drive meets Resistance" is exactly
            // what should shape an immediate desire, which is the whole point of pulling
            // it in even though it costs a few hundred bytes of input (no input budget
            // constraint, per user — only output tokens and story context are limited).
            char.customFieldValues?.['ce_slot_core']    ? `Core (won't let go of): ${char.customFieldValues['ce_slot_core']}` : '',
            char.customFieldValues?.['ce_slot_pursuit'] ? `Pursuit (going after now): ${char.customFieldValues['ce_slot_pursuit']}` : '',
            _cePatSlots.resistance ? `Resistance (what holding Core costs): ${_cePatSlots.resistance}` : '',
            _cePatSlots.conduct    ? `Conduct (their standing move when it costs them): ${_cePatSlots.conduct}` : '',
            // [v2.92.0 POSITION] Two lines instead of the old one-line relationship digest,
            // and both are the AUTHOR's text verbatim. shape is what the relationship is;
            // standing is where it currently sits. The model reads them to classify and to
            // colour the snapshot, and never to rewrite them.
            _cePosOn ? `Position on ${_cePosName} — what it is: ${_cePos.shape || 'unstated'}` : '',
            _cePosOn && _cePos.standing ? `Position on ${_cePosName} — where it stands: ${_cePos.standing}` : '',
            ephHistLines.length > 0    ? `Already intended recently (do not repeat verbatim): ${ephHistLines.join(' / ')}` : '',
            recentText                 ? `\nRecent Story:\n${recentText}` : '',
            '\n```json\n'
        ].filter(Boolean).join('\n');

        // [v2.83.0 EPHEMERAL-REWIRE] max_tokens nudged 220->240. Not a budget cut — output
        // tokens are the one real constraint here — this is headroom so the new
        // pursuitState key can never be the thing that gets truncated off the end.
        // [v2.92.0 POSITION] 240 -> 260 for positionState, the second enum key on this same
        // call. THIS LITERAL AND AE_BUDGET_EPH MUST MOVE TOGETHER — the dispatch gate is
        // that constant, so if it stays behind, the gate admits a call this request cannot
        // fit, the JSON truncates mid-object, extractJSON returns nothing, and the beat is
        // skipped with no error anywhere. Silent, not loud. Grep AE_BUDGET_EPH first.
        const resp   = await aeDiagGenerate('ephemeral:' + char.name, [{ role: 'system', content: sys }, { role: 'user', content: usr }],
            { model: 'glm-4-6', max_tokens: 260, temperature: 0.85 }
        );
        const parsed = extractJSON(resp.choices[0]?.text || '');
        if (!parsed || (!parsed.eventAnchor && !parsed.emotionalResponse && !parsed.immediateDesire)) return false;

        // [v2.83.0 PRESSURE-AXIS] Pursuit pressure is its own axis, separate from hook
        // pressure (user: "Separate pressure") — each can fire its own prompt card
        // without the two competing for one slot in a beat. Applied here, in the story
        // path only; generateChatEphemeral (CharChat's separate transport) is deliberately
        // untouched by this pass and does not feed or read this axis.
        const pursuitEvidence = ['blocked', 'advanced', 'untouched'].indexOf(parsed.pursuitState) !== -1
            ? parsed.pursuitState : 'untouched';
        await _ceApplyPressure(char.id, 'pursuit', pursuitEvidence);

        // [v2.92.0 POSITION] Second axis off the same reply. The key is per-TARGET
        // ('position_<targetId>'), which _cePressureKey already supports without change
        // since it takes an arbitrary axis string. Repointing a Position at someone else
        // therefore starts that pairing at tier 0 and orphans the old key in
        // historyStorage, which is the correct outcome and needs no reset code: evidence
        // gathered about one person is not evidence about another.
        // Only applied when the ask was actually made — otherwise every beat with an
        // absent target would coerce to 'untouched' and quietly hold the tier's decay
        // story open on a relationship nobody was in the room for.
        if (_cePosOn) {
            const positionEvidence = ['blocked', 'advanced', 'untouched'].indexOf(parsed.positionState) !== -1
                ? parsed.positionState : 'untouched';
            await _ceApplyPressure(char.id, 'position_' + _cePosTid, positionEvidence);
        }

        return await _persistEphemeralSnapshot(char.id, parsed, cfg, genCount);
    } catch (e) {
        api.v1.error('[AE:engine] generateEphemeral:', e);
        return false;
    }
}

// [v2.38.0 CHARCHAT-THINK-FIRST] Extracted verbatim from generateEphemeral's tail so
// generateChatEphemeral can share it. This is the ONLY thing the two generators have in
// common and the only thing worth sharing: they differ entirely in what they ask for and
// what context they ask it against, but a snapshot is a snapshot once it comes back, and
// two copies of the persistence rules (compose, cap, history push, sidebar) is how the
// two drift apart. Behaviour is unchanged from v2.37.1 for the story path.
async function _persistEphemeralSnapshot(charId: string, parsed: any, cfg: GlobalConfig, genCount: number): Promise<boolean> {
    const fresh = await loadCharacter(charId);
    if (!fresh) return false;

    const _ea = String(parsed.eventAnchor       || '').trim();
    const _er = String(parsed.emotionalResponse || '').trim();
    const _id = String(parsed.immediateDesire   || '').trim();
    const _composed: string = (_ea || _er || _id)
        ? [_ea, _er, _id].filter(Boolean).join(' — ')
        : String(parsed.compressedLine || '').trim();

    // [v2.89.0 EVIDENCE-STAMP] Recorded only when it is one of the three known values, so
    // the stamp can never claim the model answered when it did not. An absent stamp on a
    // story-path snapshot therefore means "no usable classification came back" and is
    // itself the diagnostic. The chat path never sends one and is unaffected.
    const _ps = String(parsed.pursuitState || '').trim();
    const _psOk = (_ps === 'blocked' || _ps === 'advanced' || _ps === 'untouched');
    // [v2.92.0 POSITION] Same rule, same reason. The chat path never sends either key and
    // is unaffected: both stamps stay undefined there, which is honest — generateChatEphemeral
    // does not classify.
    const _pos = String(parsed.positionState || '').trim();
    const _posOk = (_pos === 'blocked' || _pos === 'advanced' || _pos === 'untouched');

    const snapshot: EphemeralSnapshot = {
        eventAnchor: _ea, emotionalResponse: _er, immediateDesire: _id,
        compressedLine: _composed, generatedAtGen: genCount, // [v0.9.24 E1]
        pursuitState: _psOk ? _ps : undefined, // [v2.89.0 EVIDENCE-STAMP]
        positionState: _posOk ? _pos : undefined // [v2.92.0 POSITION]
    };

    fresh.ephemeral        = snapshot;
    fresh.ephemeralHistory = [snapshot, ...(fresh.ephemeralHistory || [])].slice(0, Number(cfg.ephemeralCap) || 3);
    fresh.lastEphemeralGen = genCount; // [v0.9.24 E1]
    fresh.lastEphemeralTokens = await _aeCurrentTokenCount(); // [v2.54.0] token-mode stamp companion
    await saveCharacter(fresh);
    // [v2.160.0 SWEEP] Was refreshSidebar(). The snapshot it repainted is on the jsx
    // Profile now, and this is the one former call site with no publish beside it.
    try { await cePublishProfile(fresh.id); } catch (ePub) {}
    return true;
}

// [v2.45.0 CHARCHAT-THOUGHT-POST] The chat-aware thinking generator, restored to the
// transport it should never have left. Called from onGenerationEnd's CHARCHAT branch AFTER the
// reply lands; produces the "right now" line the NEXT reply will carry.
//
// THIS IS generateEphemeral WITH A DIFFERENT PROMPT AND TWO ADDITIONS. That is the whole
// point: a clean two-message array through api.v1.generate(), no story context, no
// onBeforeContextBuild, and therefore none of NAI's turn scaffold ('<|assistant|><think>
// </think>', 'Write./nothink') that the v2.44.x context dump caught contaminating the native
// route twice per build. The user's own A/B probe confirmed this transport is never blocked by
// an active chat: outcome=ok, full budget, every run, every version of the saga.
//
// WHY IT IS NOT LITERALLY generateEphemeral — the finding that forced the split, unchanged
// since v2.38.0: generateEphemeral feeds getRecentStoryText(1500), which reads the document
// tail BACKWARDS. During a chat the tail IS the transcript, so it was handing the model a text
// conversation under the header "Recent Story:" and asking for "the latest story beat" while
// the actual story above the marker fell out of the window. Here the two are separated and
// labelled honestly: story-above-marker as background, transcript as the thing being replied
// to (buildChatThoughtBody), with the transcript explicitly terminated so the model does not
// simply continue it (v2.42.0 CHARCHAT-THOUGHT-SHAPE — that fix was always sound, it was just
// fighting the scaffold as well).
//
// THE TWO ADDITIONS over generateEphemeral, both about the one real risk (see the CE-INDEX
// v2.45.0 block):
//   behaviour:'background' — this runs while the user reads and types. It must not block the
//     editor. Verified param, script-types.txt: generate(messages, params, callback?,
//     behaviour?, signal?).
//   a cancellation signal — parked in _ccThoughtSignal for op 'arm' to cancel at pointerdown
//     on the next Send. api.v1.createCancellationSignal() is verified in script-types.txt
//     (cancel(): Promise<void>, dispose(), cancelled). A signal that cannot be created is not
//     fatal: the call simply becomes uncancellable, which is exactly v2.29.0's behaviour.
//
// SILENT FAILURE IS THE DESIGN, per user ("it can fail silently and keep the last thought").
// Returning false writes nothing, so char.ephemeral still holds the previous snapshot and
// buildCharChatInstruction's ccEph read serves it unchanged. A cancelled call is the same
// story. There is no fallback path to write because doing nothing IS the fallback.
//
// Style note: string concatenation, not template literals, matching the CHARCHAT subsystem's
// own idiom (buildCharChatInstruction etc.) rather than generateEphemeral's.
// [BUGFIX v2.64.0 CHARCHAT-SLOT-PRIME] The empty-first-reply fix, derived entirely from
// what v2.63.0's instrumentation ruled OUT rather than from a fresh theory. Established by
// live log:
//   * onResponse fires exactly once, final=true, len=0 — a genuine empty completion, not a
//     deferral loss (the RESCUE never fired), so nothing downstream of NAI is at fault.
//   * The prompt is byte-identical on the retry that succeeds ([AE:charchat:tail] proves it),
//     so the prompt is exonerated.
//   * The bridge no longer injects anything at Send (the DOM-inject panel was deleted at
//     bridge v2.13.0), and the arm op found "no thought in flight to cancel" on the failing
//     turns, so the bridge and the cancellation path are exonerated too.
// What remains is the one asymmetry the user identified directly: with Fresh Thoughts ON,
// an api.v1.generate() runs between turns (generateChatEphemeral) and replies mostly land;
// with it OFF, nothing runs between turns and the FIRST native Send returns empty every time,
// while a second Send — or ANY intervening generation — succeeds. The generation slot needs to
// be exercised once after our end-of-turn document mutations (normalise + clearWidgets/
// createWidgets) before NAI's native editor.generate will produce tokens against them.
//
// This is a MITIGATION of a NAI-side settling issue, honestly labelled, not a claim to have
// fixed NAI: with Fresh Thoughts on the same failure still "flashes then settles" occasionally,
// so the ceiling this buys is "off-mode as reliable as on-mode," which is the whole reported gap.
//
// It reuses generateChatEphemeral's exact proven transport — aeDiagGenerate (sets
// _diagProbeActive so onBeforeContextBuild early-returns and the chat context is untouched),
// behaviour:'background' (never blocks the editor), and a cancellation signal parked in
// _ccThoughtSignal so op 'arm' cancels it at the next Send's pointerdown just like a thought.
// max_tokens:1, output discarded: this exists for its SIDE EFFECT on the slot, not its text.
async function _charchatPrimeSlot(): Promise<void> {
    let ccpSig: any = null;
    try {
        try { ccpSig = await api.v1.createCancellationSignal(); }
        catch (_ecpSig) { ccpSig = null; }
        _ccThoughtSignal = ccpSig;
        await aeDiagGenerate('chatPrime',
            [{ role: 'user', content: 'ok' }],
            { model: 'glm-4-6', max_tokens: 1, temperature: 0 },
            ccpSig, 'background');
        aeLog('[AE:charchat:prime] slot primed (Fresh Thoughts off) \u2014 a 1-token throwaway '
            + 'generation to settle NAI\u2019s generation slot after this turn\u2019s document edits, so the '
            + 'NEXT native Send does not come back empty. See CHARCHAT-SLOT-PRIME.');
    } catch (e) {
        // Identical failure posture to the thought pass: doing nothing is a safe fallback. The
        // only cost of a failed prime is that this specific turn keeps the two-press behaviour.
        aeLog('[AE:charchat:prime] slot prime failed (this turn may still need a second Send):', e);
    } finally {
        if (_ccThoughtSignal === ccpSig) _ccThoughtSignal = null;
        if (ccpSig && ccpSig.dispose) { try { ccpSig.dispose(); } catch (_ecpD) {} }
    }
}

async function generateChatEphemeral(char: CharacterRecord, cfg: GlobalConfig, genCount: number = 0): Promise<boolean> {
    let ccteSig: any = null;
    try {
        try { ccteSig = await api.v1.createCancellationSignal(); }
        catch (_ecteSig) { ccteSig = null; }
        _ccThoughtSignal = ccteSig;

        let ccteSys = buildChatThoughtSystemPrompt(char, cfg);
        let ccteUsr = await buildChatThoughtBody(char);
        let ccteT0 = Date.now();
        let ccteResp: any = await aeDiagGenerate('chatEph:' + char.name,
            [{ role: 'system', content: ccteSys }, { role: 'user', content: ccteUsr }],
            { model: 'glm-4-6', max_tokens: 220, temperature: 0.85 },
            ccteSig, 'background');

        if (ccteSig && ccteSig.cancelled) {
            aeLog('[AE:charchat:thought] cancelled mid-flight (a Send arrived) \u2014 discarded, previous thought stands.');
            return false;
        }
        let ccteText = String((ccteResp && ccteResp.choices && ccteResp.choices[0]
            && (ccteResp.choices[0].text || (ccteResp.choices[0].message && ccteResp.choices[0].message.content))) || '');
        aeLog('[AE:charchat:thought] direct call returned ' + ccteText.length + ' chars in '
            + (Date.now() - ccteT0) + 'ms. This is the post-reply thought: it informs the NEXT reply, '
            + 'not the one that just landed.');
        if (!ccteText) return false;

        let ccteParsed = _charchatParseThought(ccteText);
        if (!ccteParsed || (!ccteParsed.eventAnchor && !ccteParsed.emotionalResponse && !ccteParsed.immediateDesire)) {
            aeLog('[AE:charchat:thought] no usable thought \u2014 keeping the previous one, silently, as designed.');
            return false;
        }
        let ccteOk = await _persistEphemeralSnapshot(char.id, ccteParsed, cfg, genCount);
        aeLog('[AE:charchat:thought] ' + (ccteOk
            ? 'persisted \u2014 the next reply\'s tail will carry it.'
            : 'persist failed \u2014 previous thought stands.'));
        return ccteOk;
    } catch (e) {
        api.v1.error('[AE:charchat:thought] generateChatEphemeral failed (previous thought stands):', e);
        return false;
    } finally {
        // Identity-checked, not a blind clear. A cancelled call can settle AFTER the next
        // reply has already started its own thought, and a blind `= null` here would wipe the
        // NEW signal, silently making that one uncancellable \u2014 the exact class of bug
        // v2.34.3 removed from the hand-rolled _diagProbeActive pairs. Only the owner clears.
        if (_ccThoughtSignal === ccteSig) _ccThoughtSignal = null;
        if (ccteSig && ccteSig.dispose) { try { ccteSig.dispose(); } catch (_ecteD) {} }
    }
}

// [BUGFIX v2.41.0 CHARCHAT-THOUGHT-PARSE] The chat thought's OWN parser. Deliberately local:
// the shared extractJSON is load-bearing for the wizard, entity batch and imgArchitect, all
// of which currently work, and the shape this has to handle is created by THIS subsystem's
// own prompt (buildChatThoughtBody ends with an open json fence to prime the model, so
// the completion legitimately arrives with no opening brace). Fixing the shared parser for a
// shape only this caller produces would put five working subsystems at risk for no gain.
//
// Order matters. Fence-strip BEFORE any brace reasoning: the fence is the reason the brace is
// missing, so repairing braces first just slices from the wrong one (extractJSON's third
// strategy does exactly that and is why this failed on every single run).
// Falls through to the shared extractJSON last, so anything that parsed before still parses.
// [v2.42.0 CHARCHAT-THOUGHT-SHAPE] THE parser for the thought pass. Labelled lines first,
// JSON second.
//
// WHY THE WIRE FORMAT CHANGED, and the answer to "why was it JSON at all": nothing downstream
// wants JSON. _persistEphemeralSnapshot wants three named strings and reads nothing else. JSON
// was one way to carry three labels and a fragile one in this position — a single unescaped
// apostrophe or a trailing comma loses the WHOLE object (both observed live: "eventAnchor":
// Nate's defensive question about being fun.), and, sitting under a chat transcript, a json
// fence reads to the model as "write a code block in the chat" rather than "stop chatting."
// Three labelled lines cannot be broken by the character's own punctuation, degrade one field
// at a time instead of all-or-nothing, and look nothing like a chat message.
//
// SCOPE: chat thoughts ONLY, per user. This has one call site (onGenerationEnd's thought
// branch). generateEphemeral and the shared extractJSON still speak JSON and are untouched.
function _charchatParseThought(raw: string): any {
    if (!raw) return null;
    let ccR = String(raw);

    // Labelled lines. Tolerant on purpose: optional markdown bold/bullets, any case, and a
    // value that may run to the end of its line. Anchored to line starts so a label MENTIONED
    // inside a value cannot hijack the parse.
    let ccPick = function(ccLabel: string): string {
        // The trailing \\**? matters and is not padding: a model that bolds the label writes
        // **EVENT:** ..., where the closing asterisks sit AFTER the colon. Consuming only the
        // leading pair leaks '**' into the value (caught by test, not by reading).
        let ccRx = new RegExp('^[ \\t>*-]*\\**[ \\t]*' + ccLabel + '[ \\t]*\\**[ \\t]*[:\\uff1a][ \\t]*\\**[ \\t]*(.+?)[ \\t]*\\**[ \\t]*$', 'im');
        let ccM = ccR.match(ccRx);
        if (!ccM || !ccM[1]) return '';
        // Strip wrapping quotes if the model quoted the value anyway, and a trailing comma if
        // it half-remembered JSON. Both are harmless to strip and common in practice.
        let ccV = ccM[1].trim().replace(/,\s*$/, '').trim();
        if (ccV.length > 1 && ccV.charAt(0) === '"' && ccV.charAt(ccV.length - 1) === '"') ccV = ccV.substring(1, ccV.length - 1);
        return ccV.trim();
    };

    let ccEa = ccPick('EVENT');
    let ccEr = ccPick('RESPONSE');
    let ccId = ccPick('DESIRE');

    if (ccEa || ccEr || ccId) {
        // [DIAG v2.67.0 CHARCHAT-THOUGHT-CONTENT] Was y/n presence only -- confirmed the pass
        // ran but hid the one thing worth seeing: session 4 found a live case of the thought
        // misattributing NIX'S OWN prior line to the POV character ("The last message from
        // Ramis was Wrong question, old man." -- that line was Nix's, not Ramis's), immediately
        // before an empty-reply turn. Untraceable without the actual text; y/n told us nothing.
        // Not gated separately -- fires once per turn (Fresh Thoughts on), same volume as the
        // line it extends.
        aeLog('[AE:charchat:thought] parsed via labelled-lines'
            + ' (EVENT=' + (ccEa ? 'y' : 'n') + ' RESPONSE=' + (ccEr ? 'y' : 'n') + ' DESIRE=' + (ccId ? 'y' : 'n') + ').'
            + ' EVENT=' + JSON.stringify(ccEa) + ' RESPONSE=' + JSON.stringify(ccEr) + ' DESIRE=' + JSON.stringify(ccId));
        return { eventAnchor: ccEa, emotionalResponse: ccEr, immediateDesire: ccId };
    }

    // JSON fallback. A model that still emits the old shape must keep working — no flag day,
    // and this is also what catches a run where the prompt cache still holds the old form.
    let ccJ = _charchatExtractThoughtJSON(raw);
    if (ccJ) {
        aeLog('[AE:charchat:thought] parsed via JSON-fallback (the model used the old wire format).'
            + ' EVENT=' + JSON.stringify(ccJ.eventAnchor) + ' RESPONSE=' + JSON.stringify(ccJ.emotionalResponse)
            + ' DESIRE=' + JSON.stringify(ccJ.immediateDesire));
        return ccJ;
    }
    return null;
}

function _charchatExtractThoughtJSON(raw: string): any {
    if (!raw) return null;
    let ccJ = String(raw).trim();
    if (!ccJ) return null;

    // 1. Drop markdown fences, opening and closing, wherever they landed. The body primed an
    //    OPEN fence, so the model's own closing fence is usually the only one present.
    ccJ = ccJ.replace(new RegExp(String.fromCharCode(96, 96, 96) + '[a-zA-Z]*', 'g'), '').trim();

    // 2. Trim anything before the first key and after the last value. The strip pass joins
    //    every new section with a newline, so stray blank lines and any prose the model added
    //    after the JSON both arrive attached.
    let ccFirstKey = ccJ.search(/"(eventAnchor|emotionalResponse|immediateDesire)"/);
    if (ccFirstKey > 0 && ccJ.lastIndexOf('{', ccFirstKey) === -1) ccJ = ccJ.substring(ccFirstKey);

    let ccTry = function(s: string, how: string): any {
        try {
            let ccP = JSON.parse(s);
            if (ccP && typeof ccP === 'object') {
                aeLog('[AE:charchat:thought] parsed via ' + how + '.');
                return ccP;
            }
        } catch (_e) {}
        return null;
    };

    let ccOut = ccTry(ccJ, 'as-is');
    if (ccOut) return ccOut;

    // 3. Brace repair, WITHOUT extractJSON's fatal not-includes-brace gate. That gate is what
    //    made this unreachable: any nested brace, or the model's own closing brace, made it
    //    false while the OPENING brace was still missing. Test what is actually true -- does
    //    it START with a brace -- not whether one exists somewhere.
    let ccBraced = ccJ;
    if (!ccBraced.startsWith('{')) ccBraced = '{' + ccBraced;
    if (!ccBraced.endsWith('}')) ccBraced = ccBraced.replace(/,\s*$/, '') + '}';
    ccOut = ccTry(ccBraced, 'brace repair');
    if (ccOut) return ccOut;

    // 4. UNQUOTED VALUE repair, for the second observed failure:
    //        "eventAnchor": Nate's defensive question about being fun.,
    //    Conservative on purpose -- only the three known string keys, only when the value is
    //    clearly bare (does not start with a quote/brace/bracket/digit), and the value is
    //    taken to the last comma-or-end on its own line. A general JSON relaxer would be a
    //    far bigger blast radius to fix a case the prompt example should now prevent anyway.
    let ccUq = ccBraced.replace(
        /("(?:eventAnchor|emotionalResponse|immediateDesire)"\s*:\s*)([^"\{\[\d\s][^\n]*?)(,?\s*)$/gm,
        function(_m: string, ccK: string, ccV: string, ccTail: string) {
            let ccClean = String(ccV).trim().replace(/,$/, '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
            return ccK + '"' + ccClean + '"' + (ccTail.indexOf(',') >= 0 ? ',' : '');
        });
    if (ccUq !== ccBraced) {
        ccOut = ccTry(ccUq, 'unquoted-value repair');
        if (ccOut) return ccOut;
    }

    // 5. Last resort: the shared parser, unchanged. If it can do something we cannot, take it.
    ccOut = extractJSON(raw);
    if (ccOut) { aeLog('[AE:charchat:thought] parsed via shared extractJSON fallback.'); return ccOut; }

    api.v1.error('[AE:charchat:thought] ALL parse strategies failed. Raw text follows -- if this '
        + 'looks like valid JSON to a human, the repair chain has a gap worth closing; if it looks '
        + 'like prose, the model ignored the prompt and the fix is upstream, not here:\n'
        + String(raw).substring(0, 300));
    return null;
}

function buildChatThoughtSystemPrompt(char: CharacterRecord, cfg: GlobalConfig): string {
    let ccPov = _aeCharChat.povName || 'the person they are texting';
    return [
        // [v2.70.0 CHARCHAT-THOUGHT-NOSTYLE, per user] cfg.generalStyle REMOVED. It is a
        // story-PROSE style guide (voice/tense/formatting for narrative writing) and this task
        // is the opposite of narrative writing: three short labelled lines in a fixed shape
        // (see CHARCHAT-THOUGHT-SHAPE below). Sitting first in the prompt, ahead of every actual
        // instruction for this task, it cost tokens and competed with the format constraint for
        // no benefit — nothing about a story's prose style should shape a private internal
        // snapshot line. Cut, not conditioned off: no config path resurrects it here.
        char.name + ' is in a live text-message conversation with ' + ccPov + '. Generate a three-part internal snapshot for ' + char.name + ' as they read the newest message and decide how to answer it.',
        'Focus exclusively on ' + char.name + '. Do not generate, reference, or echo the internal states, reactions, or thoughts of anyone else.',
        'This is a text conversation, not a scene. ' + char.name + ' is reacting to what was SAID to them \u2014 the words, the tone, the ask, or the silence. The story context below is background: who they are and what has happened to them. It is not what they are responding to.',
        // [v2.42.0 CHARCHAT-THOUGHT-SHAPE] Was "Return ONLY valid JSON with these exact keys".
        // The model does not obey it: handed a chat transcript it writes the next chat message,
        // because the SHAPE of the context outvotes the instruction every time (the same root
        // cause as the v2.41.0 brace bug). JSON also broke on the character's own apostrophes.
        // Three labelled lines instead — nothing downstream ever wanted JSON, only three named
        // strings (see _persistEphemeralSnapshot).
        // [v2.53.1 THOUGHT-VOICE-CASE] Was 'Do not write anything in char's voice' — that
        // directly fought the desired outcome (a natural internal thought in the
        // character's own voice) and, combined with 'each starting with its label in
        // capitals' plus three separate 'Capitalized.' cues below, is what was pushing the
        // model to render the whole line in capitals rather than just the label. The
        // distinction that actually matters — this is a private thought, not a reply that
        // gets sent — is kept; the voice restriction is not.
        'This is NOT a message and will never be sent to ' + ccPov + ' \u2014 it is ' + char.name + '\u2019s own private internal thought as they decide how to answer. Do not continue the conversation. Write RESPONSE the way ' + char.name + ' would actually think it: first person, in their own voice and cadence.',
        'Write EXACTLY three lines and nothing else. Each line starts with its label and a colon (only the label word itself is capitals, e.g. "EVENT:" \u2014 the rest of the line is normal sentence case, never written in all capitals):',
        'EVENT: The specific thing in the most recent message from ' + ccPov + ' that ' + char.name + ' is reacting to \u2014 an actual phrase, question, or refusal, never a mood or abstraction. One sentence, normal sentence case, ending with a period.',
        'RESPONSE: ' + char.name + '\u2019s own unspoken first-person thought \u2014 not a third-person description of an emotion, and not an emotion-label word (\u2018felt\u2019, \u2018angry\u2019, \u2018sad\u2019). Do not use ' + char.name + '\u2019s name. One sentence, normal sentence case, ending with a period.',
        'DESIRE: What ' + char.name + ' intends to do with their reply right now \u2014 a bare verb phrase, under 10 words, no name/subject prefix. Normal sentence case, ending with a period.',
        // [v2.41.0/v2.42.0] A worked example. Retained through the format change because it is
        // the cheapest possible lever on shape adherence, and re-cast into the labelled form.
        // [v2.53.1] RESPONSE line re-cast first-person to match the instruction above.
        'Example of the exact shape required (content is illustrative only \u2014 never reuse these words):',
        'EVENT: She asked if he was still coming on Friday.',
        'RESPONSE: Here we go again \u2014 like I haven\u2019t already blown this once.',
        'DESIRE: Deflect until the plan firms up.',
        'No quotes around the values. No JSON. No code blocks. No speaker name. No fourth line. Never write a line in all capitals \u2014 sentence case only. Every detail must come from the context below, never from the wording of these instructions.'
    ].filter(Boolean).join('\n');
}

async function buildChatThoughtBody(char: CharacterRecord): Promise<string> {
    let ccPov = _aeCharChat.povName || 'the person they are texting';
    let ccStory = await _charchatStoryTextAboveMarker(AE_CHATEPH_STORY_TOKENS);
    let ccChat = '';
    try { ccChat = await _charchatCanonicalChatText(); }
    catch (eCe) { api.v1.error('[AE:charchat] thought body: transcript read failed, story-only context:', eCe); ccChat = ''; }
    if (ccChat.length > AE_CHATEPH_CHAT_CHARS) ccChat = '\u2026' + ccChat.substring(ccChat.length - AE_CHATEPH_CHAT_CHARS);

    let ccEphHist = (char.ephemeralHistory || []).slice(0, 2)
        .map(function(h: any) { return (h && h.compressedLine) || ''; }).filter(Boolean);

    return [
        'Character: ' + char.name,
        char.personalityCore    ? 'Personality: ' + char.personalityCore : '',
        char.voiceAndMannerisms ? 'Voice/manner: ' + char.voiceAndMannerisms : '',
        // [v2.92.0 POSITION] Position, folded in as flat persona colour. Deliberately NOT
        // gated on scene-presence the way the story path is: a chat is not a scene, the
        // person being texted may well BE the target, and nothing here classifies or moves
        // a tier — it is context for voice only, so the fabrication risk the story-path
        // gate exists to close does not arise.
        ((char as any).position && ((char as any).position.shape || (char as any).position.standing))
            ? 'Where they stand with ' + (String((char as any).position.targetName || '') || 'their closest tie') + ': '
              + [String((char as any).position.shape || ''), String((char as any).position.standing || '')].filter(Boolean).join(' ') : '',
        'Texting with: ' + ccPov,
        ccEphHist.length > 0 ? 'Previous thoughts (do not repeat): ' + ccEphHist.join(' / ') : '',
        ccStory ? '\nStory context \u2014 background only, NOT what they are replying to:\n' + ccStory : '',
        // [v2.42.0 CHARCHAT-THOUGHT-SHAPE] THE FIX, and it is about ORDER, not wording.
        // This body used to END with the transcript, dangling on a speaker cue ('Sara:'),
        // followed by an open json fence. A transcript ending on a speaker's name is the
        // strongest continuation cue there is, so the model did the obvious thing and wrote
        // the next chat message \u2014 confirmed verbatim in the RAW diag ('Sara: really?
        // somehow I\u2019m not convinced / Emotion: smug'). The system prompt's 'return only
        // JSON' never stood a chance: the SHAPE of a context beats an instruction about it.
        // So: the transcript is explicitly TERMINATED with a sentinel (nothing is left
        // dangling to continue), and the request for the three lines is what sits at the
        // true bottom \u2014 the most present position, which is exactly where the thing we
        // actually want asked belongs. The open fence is GONE: under a chat transcript it
        // reads as 'write a code block in the chat', which is very plausibly where the
        // literal fence wrapping a chat reply came from in the first live log.
        ccChat  ? '\nText conversation so far \u2014 THIS is what ' + char.name + ' is reacting to. It is FINISHED; do not add to it:\n'
                  + ccChat + '\n[ END OF CONVERSATION \u2014 nothing follows this line ]' : '',
        '\nThe conversation above is complete. Do NOT write the next message.',
        'Write ' + char.name + '\u2019s private internal snapshot as they read that last message, as exactly three labelled lines (EVENT / RESPONSE / DESIRE) and nothing else:'
    ].filter(Boolean).join('\n');
}

// [v2.90.0 MIDRANGE-RETIRE] generateMidRange DELETED (~115 lines). It ran a two-mode
// (genesis / ongoing) free rewrite of currentDesire, socialMask and shiftedView every
// cfg.dynamicIntervalGens generations, change-gated into midRangeHistory. Nothing
// replaces it: the whole point of the pressure model is that a classifier moves a
// NUMBER and only the author rewrites prose. Its budget constant AE_BUDGET_MID, its
// 'mid' retry type, its Dynamic-tab rows and its three lorebook templates went with it.
// The relationship generator below is retired next, in step 4b.

// [v2.92.0 POSITION] generateRelationshipUpdate DELETED (~90 lines), and with it the
// last free-writing prose generator on a character record. It re-authored currentStatus,
// trajectory and summary every cfg.arcIntervalGens generations against a change gate,
// trailing every change into relationshipHistory.
//
// Nothing replaces it, and that is the whole of step 4b. A generator that rewrites the
// author's description of a relationship is a generator that will eventually disagree
// with the author about what the relationship IS — and since it re-read its own last
// output as the previous value, it also drifted against itself with no fixed point. The
// pressure model inverts that: the beat pass classifies what the story did to the
// Position (blocked / advanced / untouched), _cePressureKey banks a tier, and
// _ceFramePosition grades the FRAMING of prose only the author ever wrote.
//
// Its budget constant AE_BUDGET_REL, its 'rel' retry type, its cadence config
// (arcIntervalGens / arcIntervalTokens), its stamps (lastArcGen / lastArcTokens) and its
// Dynamic-tab Regenerate button went with it.

// [v2.82.0 PRESSURE] The generic pressure integrator (schema v0.2 §5). One counter
// PER CHARACTER (fork decision: hooks ride it, bonds will read it later rather than
// keeping a separate counter — one prompt card per beat, not several). Lives in
// historyStorage, NOT storyStorage: pressure is volatile evidence about the current
// story path, and historyStorage resolves from the closest ancestor history node, so
// an Undo naturally reverts it with zero rollback code (verified in script-types.txt).
//
// The model NEVER sets this number and NEVER rewrites prose because of it — it only
// classifies (blocked / advanced / untouched). This function does the arithmetic.
// That split is principle 1 held structurally: there is no code path by which a
// generation call can set the magnitude directly.
//
// Tiers are 0–4, not 0–100: "a layman should read the field and know what it does"
// is the standard the Change toggle set (v0.1 §3) and this follows it. Cap behaviour
// is NO DECAY (per user) — tier 4 parks until a human resolves it; nothing here ever
// walks it back down except an 'advanced' classification.
// [v2.83.0 PRESSURE-AXIS] Retrofitted to take an axis so independent pressure tracks
// never collide or share a counter. Fork decision stands (one counter per axis, not
// per bond/target) — but "hooks and Pursuit share one card" was never the design; the
// user's later call was explicit: hook-pressure and Pursuit-pressure are SEPARATE axes,
// each free to fire its own card. Only same-axis sources compete for one slot.
function _cePressureKey(charId: string, axis: string): string {
    return 'ce_pressure_' + axis + '_' + charId;
}

// [v2.89.0 PRESSURE-BIDIR] Pressure is now signed for OBJECTIVE axes: positive is
// friction, negative is progress. Fixed globally so no call site special-cases a sign.
//
// 'hook' deliberately keeps a floor of 0, and that is a different KIND of measurement
// rather than an exception being tolerated. A hook measures a TENSION, and a tension's
// zero already means resolved -- there is nothing below it. Mechanically it also mirrors
// onto 0-100 as (tier * 25), which is what lets _aePressureLabel, the manual sliders,
// hasCriticalHook and both hook injection thresholds stay untouched; a negative tier
// breaks all five at once.
//
// The ceiling stays +4 everywhere, and there is still NO DECAY at either end -- both
// bounds park until a human resolves them.
function _ceAxisFloor(axis: string): number {
    return (axis === 'hook') ? 0 : -4;
}

async function _ceReadPressure(charId: string, axis: string): Promise<number> {
    const v = await api.v1.historyStorage.getOrDefault(_cePressureKey(charId, axis), 0);
    return Math.max(_ceAxisFloor(axis), Math.min(4, Number(v) || 0));
}

async function _ceApplyPressure(charId: string, axis: string, evidence: 'blocked' | 'advanced' | 'untouched'): Promise<{ prevTier: number; tier: number }> {
    const prevTier = await _ceReadPressure(charId, axis);
    let tier = prevTier;
    if (evidence === 'blocked') tier = Math.min(4, prevTier + 1);
    else if (evidence === 'advanced') tier = Math.max(_ceAxisFloor(axis), prevTier - 1); // [v2.89.0 PRESSURE-BIDIR]
    // 'untouched' — no change, and no write, since the ancestor value already reads correct.
    if (tier !== prevTier) await api.v1.historyStorage.set(_cePressureKey(charId, axis), tier);
    return { prevTier: prevTier, tier: tier };
}

// [v2.107.0 ATTENTION] "Does this character need the author right now?" — derived from the
// banked tiers on every axis, stored nowhere.
//
// This is a READ, not a state transition, which is the whole reason it is allowed to be
// computed rather than declared: principle 1 ("the LLM never moves discrete state") is
// about writes. Nothing here writes, so nothing here can drift, and there is no second
// source of truth to reconcile against the tiers.
//
// Thresholds (the ce_prompt_cards item, engine CE-INDEX KNOWN OPEN ITEMS) are NOT built.
// 'ask' therefore fires on the condition that WILL fire a card once cards exist: an axis
// parked at +4. That is not a placeholder guess — the integrator documents NO DECAY at
// either bound ("tier 4 parks until a human resolves it"), so a +4 axis is, today, already
// a state that only a human can move. Surfacing it is honest ahead of the card.
//
// Only POSITIVE terminal raises 'ask'. -4 is the far end of PROGRESS on a bidirectional
// axis (position -4 is "settled into something steady"), and red-flagging a relationship
// for having gone well would train the author to ignore the dot. It reads as 'building'
// instead, which is true: something moved a long way.
//
// Fails toward 'calm' on ANY error, matching the project's standing rule that laziness
// fails toward stability — a degraded read must never invent an alarm.
//
// COST: 2-3 historyStorage reads per character per payload build. buildSceneStatePayload
// runs on every state change, so a crowded scene multiplies this. Measured cheap enough to
// ship unbatched; if it ever isn't, the fix is a per-broadcast memo keyed on charId, NOT a
// stored field — storing it reintroduces every problem the derivation avoids.
async function _ceDramaAttention(char: any): Promise<CharAttention> {
    const calm: CharAttention = { level: 'calm', reason: '' };
    try {
        if (!char || !char.id) return calm;
        // A static character's dynamics never run, so its tiers cannot move. Whatever is
        // banked is frozen history, not a pending decision.
        if ((char as any).isStatic) return calm;

        const axes: { key: string; label: string; tier: number }[] = [
            { key: 'pursuit', label: 'What they want', tier: await _ceReadPressure(char.id, 'pursuit') },
            { key: 'hook',    label: 'Their top hook', tier: await _ceReadPressure(char.id, 'hook') }
        ];
        // Position is the one axis that can be absent — its tier is keyed per-target, so a
        // character with no position, or an unresolved one, has no axis to read. Same rule
        // buildEntityDetailPayload already applies for positionTier.
        const pos: any = (char as any).position;
        const posTid = pos ? String(pos.targetId || '') : '';
        if (posTid) {
            axes.push({
                key: 'position',
                label: 'Where they stand with ' + (pos.targetName || 'the other party'),
                tier: await _ceReadPressure(char.id, 'position_' + posTid)
            });
        }

        for (const ax of axes) {
            if (ax.tier >= 4) {
                return { level: 'ask', axis: ax.key,
                         reason: ax.label + ' is at the top of its range and parked there. Nothing moves it back on its own.' };
            }
        }
        for (const ax of axes) {
            if (Math.abs(ax.tier) >= 2) {
                return { level: 'building', axis: ax.key,
                         reason: ax.label + (ax.tier > 0 ? ' is under real friction.' : ' has moved a long way toward settling.') };
            }
        }
        return calm;
    } catch (eAtt) {
        return calm;
    }
}

// One-time migration for a hook that predates the integrator: it has a model-authored
// 0-100 pressureLevel and no historyStorage entry yet. Seed the tier from it so
// escalation continues from roughly where the story left off instead of resetting to
// 0. Idempotent — does nothing once the key exists.
// [v2.83.0 PRESSURE-AXIS] Also checks the pre-axis v2.82.0 key ('ce_pressure_<charId>',
// no axis segment) so any pressure state accumulated during that one-patch window
// migrates forward instead of silently resetting to a legacy-derived guess.
async function _ceSeedPressureFromLegacy(charId: string, axis: string, legacyPressureLevel: number): Promise<void> {
    const key = _cePressureKey(charId, axis);
    if (await api.v1.historyStorage.has(key)) return;
    const preAxisKey = 'ce_pressure_' + charId;
    if (await api.v1.historyStorage.has(preAxisKey)) {
        const carried = await api.v1.historyStorage.get(preAxisKey);
        await api.v1.historyStorage.set(key, Math.max(0, Math.min(4, Number(carried) || 0)));
        await api.v1.historyStorage.remove(preAxisKey);
        return;
    }
    const seeded = Math.max(0, Math.min(4, Math.round((Number(legacyPressureLevel) || 0) / 25)));
    await api.v1.historyStorage.set(key, seeded);
}

async function generateHookUpdates(
    char: CharacterRecord,
    cfg: GlobalConfig,
    genCount: number // [v0.9.24 E1] was tokenCount
): Promise<boolean> {
    const recentText = await getRecentStoryText(4000);
    if (!recentText) return false;
    const charState = await buildCharacterStateContext(char);

    // SCENARIO 1: Update existing hook (the escalator)
    if (char.hooks && char.hooks.length > 0) {
        const hook = char.hooks[0];
        // [v2.82.0 PRESSURE] A resolved hook is done — it should not keep accumulating
        // pressure while it waits for "Resolve Oldest" or the array splice. Previously
        // nothing checked this and a resolved hook kept escalating silently.
        if (hook.resolved) return false;
        await _ceSeedPressureFromLegacy(char.id, 'hook', hook.pressureLevel);
        const sys = [
            // [v2.146.0 HOOK-TARGETID] WAS ${hook.targetName}, which rendered the literal
            // token '__player__' into the prompt whenever the target was the protagonist.
            `Evaluate ${char.name}'s active tension regarding ${_ceHookTargetLabel(hook, cfg)}.`,
            `Current tension: "${hook.description}"`,
            ``,
            `Classify what the recent story did to this tension. Choose exactly one:`,
            `  "blocked"   — something forced it closer to confrontation, made it worse, or closed off an easy way out.`,
            `  "advanced"  — something eased it, resolved part of it, or gave ${char.name} real ground.`,
            `  "untouched" — the recent story did not meaningfully touch this tension.`,
            ``,
            `Also give ONE short phrase (under 12 words) naming the specific thing that happened — evidence, not a verdict.`,
            ``,
            `Return ONLY valid JSON: {"classification": "blocked", "evidence": "..."}`,
            `No markdown fences.`
        ].join('\n');

        const usr = [
            charState ? `${char.name}'s current state:\n${charState}` : '',
            `Story:\n${recentText}`,
            '\n```json\n'
        ].filter(Boolean).join('\n\n');

        try {
            const resp   = await aeDiagGenerate('hookUpdate:' + char.name + ':escalate', [{ role: 'system', content: sys }, { role: 'user', content: usr }],
                { model: 'glm-4-6', max_tokens: 200, temperature: 0.6 }
            );
            const update = extractJSON(resp.choices[0]?.text || '');
            if (!update) return false;
            const classification = ['blocked', 'advanced', 'untouched'].indexOf(update.classification) !== -1
                ? update.classification : 'untouched';

            const f = await loadCharacter(char.id);
            if (!f) return false;

            const targetHook = f.hooks[0];

            // [v2.82.0 PRESSURE] The old word-overlap "surface detection" (matching hook
            // words against recent story text to auto-clear a critical hook) is REMOVED.
            // It was a string-compare heuristic on generated prose — exactly the kind of
            // ungoverned turning-point detection principle 1 forbids, and it silently
            // discarded the hook (f.hooks = []) with no author involvement. A hook at the
            // pressure cap now stays put and is resolved by the author (Drama tab Resolve
            // button → AE_RESOLVE_HOOK → resolveCharHook, or the native "Resolve Oldest"
            // control) — never by the mechanism guessing that it has "lingered enough".
            const { prevTier, tier } = await _ceApplyPressure(char.id, 'hook', classification);
            targetHook.pressureLevel = tier * 25;
            // description is genesis text, authored once at hook creation and never
            // rewritten by the escalator (v0.2 §1.2 bloat control — same discipline as
            // Core, same reason trajectory/relationshipHistory-as-cadence retired: rewriting
            // prose every update is drift bait). The model's only output here is a
            // classification and a one-line evidence note.
            if (update.evidence && String(update.evidence).trim()) {
                if (!Array.isArray(targetHook.developmentNotes)) targetHook.developmentNotes = [];
                targetHook.developmentNotes = [String(update.evidence).trim().substring(0, 120), ...targetHook.developmentNotes].slice(0, 3);
            }
            if (tier >= 4 && prevTier < 4) {
                // Just reached the cap this update — stop accumulating and hand it to the
                // author rather than silently sitting mute (§5: "Stop injecting. Raise a
                // user prompt"). No decay, per user — it stays here until resolved.
                api.v1.ui.toast('🔥 ' + char.name + '’s tension with ' + _ceHookTargetLabel(targetHook, cfg) + ' has reached a breaking point — resolve it in the Drama tab.', { type: 'warning', autoClose: 5000 });
            }
            f.lastHookGen = genCount; // [v0.9.24 E1]
                        f.lastHookTokens = await _aeCurrentTokenCount(); // [v2.54.0] token-mode stamp companion
            await saveCharacter(f);
            return true;
        } catch (e) {
            aeLog('[AE:engine] generateHookUpdates escalator error:', e);
            return false;
        }

    // SCENARIO 2: Spawn a new hook
    } else {
        const sys = [
            `Analyze the recent story for a specific, unresolved tension involving ${char.name}.`,
            ``,
            `You are looking for: a direct conflict with another person, a threat that demands response, or an urgent unfulfilled need that recent events created. Passive feelings and general mood do NOT qualify.`,
            ``,
            `If a clear tension exists, set "targetName" to the other person's name and write "description" as a single, punchy sentence naming the core conflict. Use concrete language — what happened, what is owed, what is at stake.`,
            `  Wrong: "feels betrayed by the situation"`,
            `  Right: "Cassius read the letter — he knows, and hasn't said anything yet"`,
            ``,
            `If no qualifying tension exists, set "targetName" to "None".`,
            ``,
            `Return ONLY valid JSON: {"targetName": "Name or None", "description": "..."}`,
            `No markdown fences.`
        ].join('\n');

        const usr = [
            charState ? `${char.name}'s current state:\n${charState}` : '',
            `Story:\n${recentText}`,
            '\n```json\n'
        ].filter(Boolean).join('\n\n');

        try {
            const resp  = await aeDiagGenerate('hookUpdate:' + char.name + ':spawn', [{ role: 'system', content: sys }, { role: 'user', content: usr }],
                { model: 'glm-4-6', max_tokens: 200, temperature: 0.65 }
            );
            const spawn = extractJSON(resp.choices[0]?.text || '');
            if (!spawn || !spawn.targetName || spawn.targetName.toLowerCase() === 'none') return false;

            const f = await loadCharacter(char.id);
            if (!f) return false;

            // [v2.82.0 PRESSURE] Pressure is no longer a model guess even at spawn — every
            // fresh hook starts at tier 1 ("has not had time to escalate" is now a fixed
            // fact of being new, not a number the model picks each time). historyStorage
            // is the source of truth from creation; pressureLevel below is the derived
            // display mirror the existing 0-100 UI (sliders, labels, thresholds) reads.
            await api.v1.historyStorage.set(_cePressureKey(char.id, 'hook'), 1);
            f.hooks = [{
                id:           api.v1.uuid(),
                // [v2.146.0 HOOK-TARGETID] This path parses a bare name out of model JSON
                // and has no cast list in scope, so it resolves to no id. That is the
                // documented working state, not a gap to paper over with a guess.
                targetId:     '',
                targetName:   spawn.targetName.substring(0, 50),
                description:  String(spawn.description || '').substring(0, 300),
                pressureLevel: 25,
                developmentNotes: [],
                resolved: false
            }];
            f.lastHookGen = genCount; // [v0.9.24 E1]
                        f.lastHookTokens = await _aeCurrentTokenCount(); // [v2.54.0] token-mode stamp companion
            await saveCharacter(f);
            return true;
        } catch (e) {
            aeLog('[AE:engine] generateHookUpdates spawn error:', e);
            return false;
        }
    }
}

// ── Engine Orchestrator ───────────────────────────────────────────────────────

// ── AUTO-TRIGGERS ───────────────────────────────────────────────────────────
// Scans scene-present entities for ActionInstances flagged autoTrigger, evaluates
// their conditions, and fires the ones that pass. Runs post-generation (onGenerationEnd)
// so it never recurses into the active generation. Auto-triggered actions always run
// silently (no nested api.v1.editor.generate) to avoid generation-in-generation.

// [CE-STRIP v2.0.0] Auto-trigger scanning always found zero candidates once
// getTagSubscribedActions became a stub (above) — the scan body is gone, callers
// (Schedule tick, travel/teleport, native toolbar) keep calling this harmlessly.
async function runAutoTriggers(): Promise<void> {
    return;
}

// [v2.54.0] Current persistent story token count, NaN-safe with a 0 fallback. Read by the
// generators at persist time to stamp the *Tokens companion fields, and by runDynamicEngine
// in token mode as the progress value.
async function _aeCurrentTokenCount(): Promise<number> {
    try { return Number(await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0)) || 0; }
    catch (eTc) { return 0; }
}

// [v2.89.0 TURN-CAP] Single enqueue path. The two inline copies this replaces differed
// only in variable names, and the two new cap-exhausted call sites would have made four.
// Types: 'eph' | 'mid' | 'rel' | 'hook'. Deduped, so a character due on the same
// generator two turns running queues once.
async function _ceEnqueueRetry(charId: string, kind: string): Promise<void> {
    try {
        const rqRaw = await api.v1.tempStorage.getOrDefault(STORAGE_RETRY_CHARS, '[]') as string;
        const rq: string[] = JSON.parse(rqRaw);
        const entry = charId + ':' + kind;
        if (rq.indexOf(entry) === -1) {
            rq.push(entry);
            await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, JSON.stringify(rq));
        }
    } catch (eEq) { aeLog('[AE:engine] _ceEnqueueRetry error:', eEq); }
}

async function runDynamicEngine(): Promise<void> {
    // [v0.9.24 E1] Generation-based intervals; [v2.54.0] optional token-based cadence.
    // genCount always advances per generation (the load guard below rides it regardless of
    // mode); tokenCount is only consulted when dynamicIntervalMode === 'tokens'.
    let genCount = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
    genCount = Number(genCount) || 0;
    if (genCount < 1) {
        aeLog('[AE:engine] genCount=0, skipping dynamic engine');
        return;
    }

    ae_lock = true; // [v0.9.34 LOCK1] block travel generates while background gen runs
    aeLog('[AE:TRACE] dynamic engine ACQUIRED ae_lock');
    const index = await loadIndex();
    const cfg   = await loadConfig();
    // [v2.54.0] Cadence unit + the progress value each per-character check compares against.
    const _dynMode: string = ((cfg as any).dynamicIntervalMode === 'tokens') ? 'tokens' : 'gens';
    const _dynTokenCount = (_dynMode === 'tokens') ? await _aeCurrentTokenCount() : 0;
    const _dynProgress = (_dynMode === 'tokens') ? _dynTokenCount : genCount;
    const raw   = await api.v1.tempStorage.get(STORAGE_LORE_IDS) as string | undefined;
    const activeEntryIds = new Set<string>(raw ? JSON.parse(raw) : []);

    // [v2.89.0 TURN-CAP] Hard cap on generations dispatched in ONE pass. NAI permits a
    // single generation at a time and rejects the rest outright -- generateSlotOptions
    // already carries a three-attempt backoff for exactly that rejection -- so multiple
    // generators firing in one turn were already colliding and losing SILENTLY. Default 1.
    const _dynCapTurn = Math.max(0, Number((cfg as any).maxGenerationsPerTurn ?? 1) || 0);
    let   _dynSpent   = 0;
    // Characters that already generated this pass, from EITHER the queue drain or the
    // main loop. This is the fix for the drain defect: the queue is drained FIRST (that
    // is what "starved characters get priority next turn" means) but a drained character
    // was then still eligible in the main dispatch below, so it could generate twice in
    // one pass -- an unbudgeted extra call, which is precisely what a turn cap exists to
    // prevent. Draining first and excluding here preserves the priority AND closes the
    // double-dispatch, which moving the drain after the loop would not have done.
    const _dynDone = new Set<string>();
    const _ceTurnLeft = function(): boolean { return _dynCapTurn === 0 || _dynSpent < _dynCapTurn; };

    // ── Retry queue ───────────────────────────────────────────────────────────
    const _retryRaw = await api.v1.tempStorage.getOrDefault(STORAGE_RETRY_CHARS, '[]') as string;
    const _retryQ: string[] = JSON.parse(_retryRaw);
    if (_retryQ.length > 0) {
        await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, '[]');
        const _reQueue: string[] = [];
        for (const entry of _retryQ) {
            // [v2.89.0 TURN-CAP] Anything the cap will not let run this pass goes straight
            // back on the queue rather than being dropped -- it stays due, and it is still
            // ahead of the main loop next turn.
            if (!_ceTurnLeft()) { _reQueue.push(entry); continue; }
            // [v2.84.0 BUDGET-GATE] Was a flat 220 for a queue holding BOTH eph and mid
            // entries, so the gate took the larger of the two budgets. [v2.90.0
            // MIDRANGE-RETIRE] 'mid' is gone; the gate is now just the ephemeral budget.
            // [v2.92.0 POSITION] 'rel' is gone too, and AE_BUDGET_EPH rose 240 -> 260, so
            // this gate is now the LARGEST of the two surviving budgets rather than the
            // smallest. Still correct, just for the opposite reason: a pass that clears
            // 260 trivially clears hook's 200, so no queued entry can be admitted and
            // then truncated.
            if (api.v1.script.getAllowedOutput() < AE_BUDGET_EPH) { _reQueue.push(entry); break; }
            const [_rcId, _rcType] = entry.split(':');
            const _rc = await loadCharacter(_rcId);
            if (!_rc || _rc.isProtagonist) continue;
            let _rcRan = false;
            if (_rcType === 'eph' && _rc.autoThoughtsEnabled) {
                _dynSpent++; _rcRan = true;
                const _ok = await generateEphemeral(_rc, cfg, genCount).catch(function() { return false; });
                if (_ok) api.v1.ui.toast('💭 ' + _rc.name + ': thoughts updated', { type: 'info', autoClose: 2000 });
            } else if (_rcType === 'hook' && _rc.hooksEnabled) {
                _dynSpent++; _rcRan = true;
                const _ok4 = await generateHookUpdates(_rc, cfg, genCount).catch(function() { return false; });
                if (_ok4) api.v1.ui.toast('🎯 ' + _rc.name + ': hook updated', { type: 'info', autoClose: 2000 });
            }
            // [v2.90.0 MIDRANGE-RETIRE] A 'mid' entry left in tempStorage by a pre-v2.90.0
            // session matches no branch above: _rcRan stays false, nothing is dispatched,
            // and the entry is simply consumed rather than requeued (requeue only happens
            // on the cap/budget paths). Unknown types are tolerated by construction here --
            // do NOT add an else-throw. [v2.92.0 POSITION] 'rel' entries left by a
            // pre-v2.92.0 session are now in exactly the same position and need exactly
            // the same nothing done about them.
            if (_rcRan) _dynDone.add(_rcId);
        }
        if (_reQueue.length > 0) await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, JSON.stringify(_reQueue));
        aeLog('[AE:engine] Retry queue processed. spent=' + _dynSpent + ' requeued=' + _reQueue.length);
    }

    aeLog('[AE:engine] genCount=' + genCount + ', active chars=' + index.filter(function(m: any) { return m.active; }).length);

    // [vNEXT] Dynamic-priority cap. Compute the permitted id set ONCE from the index
    // (no storage reads). When a cap is set, characters outside the top-N by rank are
    // skipped this turn without touching their records — the user's manual Static
    // toggle is untouched; they simply aren't processed while over the cap.
    const _dynCap = Number((cfg as any).maxDynamicCharacters) || 0;
    const _dynAllowed = computeDynamicAllowedSet(index as any, _dynCap);
    if (_dynCap > 0) aeLog('[AE:engine] dynamic cap=' + _dynCap + ', allowed=' + _dynAllowed.size);

    // ── Per-character dispatch ────────────────────────────────────────────────
    for (const meta of index.filter(Boolean)) {
        if (!meta.active) continue;
        if (meta.isProtagonist) continue;
        // [v0.9.34 PERF1] Skip storage read for chars flagged static in the index
        // (propagated there by saveCharacter since v0.9.31). Avoids a DB load per
        // static character per generation end.
        if ((meta as any).isStatic) { aeLog('[AE:engine] Static (index), skipping: ' + meta.name); continue; }
        // [vNEXT] Enforce the dynamic cap from the index before any storage read, so
        // a capped-out character costs nothing this turn.
        if (_dynCap > 0 && !_dynAllowed.has(meta.id)) { aeLog('[AE:engine] Over dynamic cap, skipping: ' + meta.name); continue; }
        // [v2.89.0 TURN-CAP] Already generated in the queue drain above -- skipping here
        // is what stops a dequeued character updating twice in one pass.
        if (_dynDone.has(meta.id)) { aeLog('[AE:engine] Already ran (queue), skipping: ' + meta.name); continue; }
        const char = await loadCharacter(meta.id);
        if (!char) continue;
        if ((char as any).isStatic) { aeLog('[AE:engine] Static, skipping: ' + char.name); continue; }

        const relevant = charIsRelevant(char, activeEntryIds);

        // NaN-safe — old saves without stamps default to 0 (triggers update immediately).
        // [v2.54.0] In token mode the *Tokens stamps/intervals are read instead of the *Gen
        // ones; _dynProgress (set above) is the matching progress value. Both stamp units
        // are written on every update (see the generators), so a mode switch never compares
        // a stamp against the wrong unit.
        const _tokMode = (_dynMode === 'tokens');
        const lastEph  = Number(_tokMode ? char.lastEphemeralTokens : char.lastEphemeralGen) || 0;
        const lastHook = Number(_tokMode ? char.lastHookTokens      : char.lastHookGen)      || 0;
        const intEph   = Number(_tokMode ? (cfg as any).thoughtIntervalTokens : cfg.thoughtIntervalGens) || (_tokMode ? 500  : 2);
        const intHook  = Number(_tokMode ? (cfg as any).hookIntervalTokens    : cfg.hookIntervalGens)    || (_tokMode ? 1500 : 6);
        const _unit    = _tokMode ? 'tok' : 'gen';

        aeLog('[AE:engine] ' + char.name
            + ' rel=' + relevant
            + ' eph=' + char.autoThoughtsEnabled + '(' + (_dynProgress - lastEph) + '/' + intEph + _unit + ')'
            + ' budget=' + api.v1.script.getAllowedOutput());


        // [v2.17.0 CHAREDIT-TABS] Toggle semantics split, backing the Dynamic Profile
        // tab's "Enabled" bar. Previously Midrange/Relationship/Hooks all shared ONE
        // autoUpdateEnabled flag (Ephemeral was already independent); hooksEnabled
        // (declared on every CharacterRecord since day one, serialized to the bridge, but
        // never actually read by any dispatch condition here) now genuinely gates Hooks.
        // [v2.90.0 MIDRANGE-RETIRE] autoUpdateEnabled was Midrange's sole gate and retired
        // with it. [v2.92.0 POSITION] The Relationship gate went the same way: Position has
        // no generator and therefore no dispatch condition and no toggle. Two buttons.
        if (char.autoThoughtsEnabled && relevant && (_dynProgress - lastEph) >= intEph) {
            // [v2.89.0 TURN-CAP] Cap first, budget second. A character due but capped out
            // is QUEUED, not dropped -- next pass it is ahead of this loop.
            if (!_ceTurnLeft()) {
                await _ceEnqueueRetry(char.id, 'eph');
            } else if (api.v1.script.getAllowedOutput() >= AE_BUDGET_EPH) {
                _dynSpent++; _dynDone.add(char.id);
                const ephOk = await generateEphemeral(char, cfg, genCount).catch(function(e) { aeLog('[AE:engine] Eph err:', e); return false; });
                if (ephOk) api.v1.ui.toast('💭 ' + char.name + ': thoughts updated', { type: 'info', autoClose: 2000 });
            } else {
                await _ceEnqueueRetry(char.id, 'eph');
            }
        }
        if (char.hooksEnabled && relevant && (_dynProgress - lastHook) >= intHook) {
            if (!_ceTurnLeft()) {
                await _ceEnqueueRetry(char.id, 'hook');
            } else if (api.v1.script.getAllowedOutput() >= AE_BUDGET_HOOK) {
                _dynSpent++; _dynDone.add(char.id);
                const hookOk = await generateHookUpdates(char, cfg, genCount).catch(function(e) { aeLog('[AE:engine] Hook err:', e); return false; });
                if (hookOk) api.v1.ui.toast('🎯 ' + char.name + ': hook updated', { type: 'info', autoClose: 2000 });
            } else {
                await _ceEnqueueRetry(char.id, 'hook');
            }
        }
    }

    await recalculateScenePresence();
    queueSceneStateBroadcast();
    aeLog('[AE:TRACE] dynamic engine RELEASING ae_lock');
    ae_lock = false; // [v0.9.34 LOCK1] release after all background generates complete
}

// ============================================================================
// SECTION 16 — IMAGE PROMPT GENERATION
// Assembles image prompts for auto-snap and Director's Cut, and dispatches
// generation requests to the bridge via EVT_GENERATE_IMAGE.
//
// [CHANGE] Widget system fully removed. All functions that formerly wrote to
// KEY_PENDING and called rebuildWidgets() now call broadcastToTM(EVT_GENERATE_IMAGE, payload)
// directly. No story document writes for image generation.
//
// [CHANGE] getCharacterData() now reads from cachedCharVisuals (CharacterVisualRecord[])
// instead of cachedCharConfigs. Field names updated: c.visuals (was c.characterVisuals),
// c.sceneVisuals, c.uc (was c.characterUC). baseSceneVisuals/baseSceneUC are not tracked
// in CharacterVisualRecord — extractBaseAdditions() returns empty strings naturally.
// Nickname matching added (CharacterVisualRecord includes nicknames[]).
//
// [CHANGE] loadSettings() renamed to loadImageSettings() throughout.
//
// [CHANGE] enhanceDirectorPrompt() and submitDirectorPhoto() extracted as standalone
// pure functions with explicit parameters — no modal state or module-level director vars.
// Called from handleBridgeMessage() (Section 18) when EVT_DIRECTOR_SUBMIT arrives.
//
// NOTE FOR ASSEMBLY: Add to Section 2 Bridge Event constants:
//   const EVT_DIRECTOR_ENHANCE_RESULT = 'DIRECTOR_ENHANCE_RESULT'; // engine→bridge
// ============================================================================

// ── Character Data Lookup ─────────────────────────────────────────────────────

// [v0.9.7.6] Whole-word presence test. Substring matching caused short names
// (e.g. "Nev") to fire inside longer words ("never"). Boundary = anything that
// is not an ASCII letter/digit/underscore, or string start/end. Multi-word names
// match on their outer boundaries; internal spaces are unaffected.
function _nameAppearsAsWord(hayLower: string, needleLower: string): boolean {
    if (!needleLower) return false;
    let esc = needleLower.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    let re = new RegExp('(?:^|[^a-z0-9_])' + esc + '(?:[^a-z0-9_]|$)');
    return re.test(hayLower);
}

function getCharacterData(promptText: string): { id: string; name: string; visuals: string; uc: string; baseSceneVisuals: string; baseSceneUC: string; }[] {
    // Returns an array of matched character visual records for characters mentioned in promptText.
    // [CHANGE] Reads from cachedCharVisuals (CharacterVisualRecord[]) instead of old cachedCharConfigs.
    // [CHANGE] Added nickname matching — CharacterVisualRecord includes nicknames[].
    // [CHANGE] baseSceneVisuals and baseSceneUC always return '' — not tracked in CharacterVisualRecord.
    //          extractBaseAdditions() will return empty strings for these, which is correct behaviour:
    //          the bridge receives an empty extraBaseVisuals/extraBaseUC and generates normally.
    if (!promptText || !cachedCharVisuals.length) return [];
    const lower = promptText.toLowerCase();
    return cachedCharVisuals
        .filter(function(c) {
            if (!c.name || !c.name.trim()) return false;
            if (_nameAppearsAsWord(lower, c.name.trim().toLowerCase())) return true;
            return (c.nicknames || []).some(function(nick) {
                return nick && nick.trim() && _nameAppearsAsWord(lower, nick.trim().toLowerCase());
            });
        })
        .map(function(c) {
            return {
                id:               c.id || '',
                name:             c.name,
                // Combine core visuals + scene-specific additions for character captions
                visuals:          [c.visuals, c.sceneVisuals].filter(Boolean).join(', '),
                uc:               c.uc || '',
                baseSceneVisuals: '', // not stored in CharacterVisualRecord
                baseSceneUC:      ''  // not stored in CharacterVisualRecord
            };
        });
}

function extractBaseAdditions(matchedChars: { baseSceneVisuals: string; baseSceneUC: string }[]): { extraBaseVisuals: string; extraBaseUC: string } {
    // Extracts base-level prompt additions (added to main fp/fu, not char captions).
    // Preserved verbatim — in the merged system these fields are always '' (see getCharacterData note),
    // so this function will always return { extraBaseVisuals: '', extraBaseUC: '' }.
    return {
        extraBaseVisuals: matchedChars.map(function(c) { return c.baseSceneVisuals; }).filter(Boolean).join(', '),
        extraBaseUC:      matchedChars.map(function(c) { return c.baseSceneUC;      }).filter(Boolean).join(', ')
    };
}

// ── Auto-Snap ─────────────────────────────────────────────────────────────────

async function getCurrentLocationPromptLine(): Promise<string> {
    // [WP-img] Returns "Location: <name> — <resolved description>" for the
    // protagonist's current location, or '' if none. Feeds the image architect so
    // generated scenes reflect where the player is. Uses the (state-resolved)
    // description, NOT locationVisuals — locationVisuals is reserved for renders
    // that are specifically about a location.
    try {
        let locId = await loadPlayerLocation();
        if (!locId) return '';
        let loc = await loadEntity(locId);
        if (!loc) return '';
        let desc = (loc.state && loc.state !== 'default' && loc.stateDescriptions && loc.stateDescriptions[loc.state])
            ? loc.stateDescriptions[loc.state]
            : (loc.description || '');
        desc = (desc || '').trim();
        if (!loc.name && !desc) return '';
        return 'Location: ' + (loc.name || '') + (desc ? ' — ' + desc : '');
    } catch (e) { api.v1.error('[AE:img] getCurrentLocationPromptLine:', e); return ''; }
}

// [v0.9.8.0] Reusable architect pass over the recent story. Reads the last
// `paragraphs` sections, detects characters (whole-word), runs the GLM architect,
// and returns the raw prompt plus the resolved character records. Shared by
// executeAutoSnap (generate now) and the AUTO_SNAP_PROMPT path (fill the Image
// Studio composer for the user to review/edit before generating).
async function buildArchitectPromptFromStory(paragraphs?: number): Promise<{ prompt: string; matchedChars: { id: string; name: string; visuals: string; uc: string; baseSceneVisuals: string; baseSceneUC: string; }[]; } | null> {
    await loadImageSettings();
    const nodeId = await api.v1.document.history.currentNodeId();
    const node   = await api.v1.document.history.nodeState(nodeId);
    if (!node || !node.sections) { api.v1.ui.toast('Error: Could not read document.'); return null; }

    const ctxSize = (typeof paragraphs === 'number' && paragraphs > 0) ? paragraphs : (globalSettings.contextSize || DEFAULT_CTX);
    let asContextText = '';
    const asStartIndex = Math.max(0, node.sections.length - ctxSize);
    for (let i = asStartIndex; i < node.sections.length; i++) {
        if (node.sections[i].section && node.sections[i].section.text) asContextText += node.sections[i].section.text + '\n';
    }

    const asMatched   = getCharacterData(asContextText);
    const asNames     = asMatched.map(function(c) { return c.name; }).join(', ');
    const asLocLine   = await getCurrentLocationPromptLine();
    const asCharCtx   = asNames ? '\n\nCharacters identified in scene: ' + asNames + '. Apply their specific visual tags.' : '';

    try {
        const asResp = await aeDiagGenerate('imgArchitect:manual',
            [
                { role: 'system', content: globalSettings.architectPrompt || DEFAULT_ARCH },
                { role: 'user',   content: 'Current Scene:\n' + asContextText.trim() + asCharCtx + (asLocLine ? '\n\n' + asLocLine : '') + '\n\nGenerate the image prompt:' }
            ],
            { model: 'glm-4-6', max_tokens: 300 }
        );
        const asPrompt = ((asResp.choices && asResp.choices[0] &&
            (asResp.choices[0].message && asResp.choices[0].message.content || asResp.choices[0].text)) || asResp.text || '').trim();
        if (!asPrompt) return null;
        return { prompt: asPrompt, matchedChars: asMatched };
    } catch (asErr) {
        aeLog('[AE:img] buildArchitectPromptFromStory failed:', asErr);
        return null;
    }
}

async function executeAutoSnap(): Promise<void> {
    // [CHANGE] Widget system removed. Previously wrote to KEY_PENDING + rebuildWidgets().
    //          Now broadcasts EVT_GENERATE_IMAGE directly to bridge.
    // [CHANGE] loadSettings() → loadImageSettings().
    // [CHANGE] Bridge guard added — auto-snap requires the bridge to be connected.
    api.v1.ui.toast('📸 Architect Pass: Analysing scene…');
    await loadImageSettings();

    if (!isBridgeReady) {
        api.v1.ui.toast('⚠️ Bridge not connected — auto-snap requires bridge.', { type: 'warning', autoClose: 3000 });
        return;
    }

    const nodeId = await api.v1.document.history.currentNodeId();
    const node   = await api.v1.document.history.nodeState(nodeId);
    if (!node || !node.sections) { api.v1.ui.toast('Error: Could not read document.'); return; }

    const ctxSize = globalSettings.contextSize || DEFAULT_CTX;
    let contextText = '';
    const startIndex = Math.max(0, node.sections.length - ctxSize);
    for (let i = startIndex; i < node.sections.length; i++) {
        if (node.sections[i].section && node.sections[i].section.text) contextText += node.sections[i].section.text + '\n';
    }

    const matchedChars = getCharacterData(contextText);
    const { extraBaseVisuals, extraBaseUC } = extractBaseAdditions(matchedChars);
    const charNames   = matchedChars.map(function(c) { return c.name; }).join(', ');
    const locLine     = await getCurrentLocationPromptLine();
    const charContext = charNames ? '\n\nCharacters identified in scene: ' + charNames + '. Apply their specific visual tags.' : '';

    try {
        const response = await aeDiagGenerate('imgArchitect:autosnap',
            [
                { role: 'system', content: globalSettings.architectPrompt || DEFAULT_ARCH },
                { role: 'user',   content: 'Current Scene:\n' + contextText.trim() + charContext + (locLine ? '\n\n' + locLine : '') + '\n\nGenerate the image prompt:' }
            ],
            { model: 'glm-4-6', max_tokens: 300 }
        );
        const rawPrompt = ((response.choices && response.choices[0] &&
            (response.choices[0].message && response.choices[0].message.content || response.choices[0].text)) || response.text || '').trim();
        if (!rawPrompt) throw new Error('GLM returned an empty prompt.');

        const compiled = compileActiveImageFields();
        await broadcastToTM(EVT_GENERATE_IMAGE, {
            uuid:             api.v1.uuid(),
            prompt:           rawPrompt,
            characters:       matchedChars.map(function(c) { return { name: c.name, visuals: c.visuals, uc: c.uc }; }),
            extraBaseVisuals: extraBaseVisuals,
            extraBaseUC:      extraBaseUC,
            settings: {
                width:    globalSettings.defaultWidth,
                height:   globalSettings.defaultHeight,
                steps:    Math.min(globalSettings.defaultSteps || 28, 28),
                scale:    globalSettings.defaultScale || 5.0,
                quality:  compiled.quality,
                negative: compiled.negative
            },
            autoDownload: globalSettings.autoDownload
        });
        api.v1.ui.toast('📸 Auto-Snap complete! Image generating in bridge…');
    } catch (err) {
        api.v1.ui.toast('Architect Error: ' + ((err as any).message || String(err)));
    }
}

// ── Director's Cut — Enhance & Submit ─────────────────────────────────────────

async function enhanceDirectorPrompt(
    prompt: string,
    chars: { name: string; visuals: string; uc?: string }[]
): Promise<{ enhancedPrompt: string; charVisuals: { name: string; visuals: string }[] } | null> {
    // [CHANGE] Extracted as pure function with explicit parameters.
    //          Old version mutated module-level state (currentDirectorPrompt, char1Vis_in, etc.)
    //          and called renderModal(). New version returns the enhanced data as a value
    //          so the caller (handleBridgeMessage / EVT_DIRECTOR_SUBMIT) can broadcast it back.
    // [v2.13.0 IMGFIELDS] Generalized from hardcoded char1/char2 (2-slot) to up to 4
    // characters, matching the new click-to-add picker's cap. No more fuzzy
    // getCharacterData(name) lookup here -- the bridge's picker already resolved
    // c.visuals from its own synced character cache before the user could edit it
    // (and per user's call, those edits are one-off, never written back), so
    // c.visuals IS the "known visuals" context; nothing left to re-look-up by name.
    if (!prompt.trim()) return null;

    const capped = (chars || []).slice(0, 4);
    const locLine = await getCurrentLocationPromptLine();

    const charContextLines: string[] = capped.map(function(c, i) {
        const label = 'Character ' + (i + 1) + (c.name && c.name.trim() ? ' (' + c.name.trim() + ')' : ' (unnamed)');
        return c.visuals && c.visuals.trim()
            ? '\n' + label + ': Known visuals are "' + c.visuals.trim() + '". Enhance and adapt for the scene.'
            : '\n' + label + ': No known visuals. Generate appropriate tags.';
    });

    const sysPrompt = 'You are an uncompromising art director. Output ONLY a valid JSON object, no markdown:\n{\n  "enhanced_prompt": "5-10 core tags + 1-2 sentences of observational prose. No quality tags or negative weights.",\n  "char_visuals": ["Tags for character 1 if present, else empty string", "...character 2...", "...character 3...", "...character 4..."]\n}\nThe char_visuals array must have exactly ' + capped.length + ' entries, in the same order as the characters listed below.';

    try {
        const response = await aeDiagGenerate('imgDirectorEnhance',
            [
                { role: 'system', content: sysPrompt },
                { role: 'user',   content: 'Rough Concept: ' + prompt + charContextLines.join('') + (locLine ? '\n' + locLine : '') + '\n\nOutput the JSON:' }
            ],
            { model: 'glm-4-6', max_tokens: 350, temperature: 0.7 }
        );
        let rawOutput = ((response.choices && response.choices[0] &&
            (response.choices[0].message && response.choices[0].message.content || response.choices[0].text)) || response.text || '').trim();
        const jsonMatch = rawOutput.match(/\{[\s\S]*\}/);
        if (!jsonMatch) throw new Error('No JSON block found in architect response.');
        const parsed = JSON.parse(jsonMatch[0]);
        const cv: string[] = Array.isArray(parsed.char_visuals) ? parsed.char_visuals : [];

        const enhancedChars = capped.map(function(c, i) {
            return { name: c.name, visuals: (cv[i] && String(cv[i]).trim()) ? String(cv[i]).trim() : c.visuals };
        });

        return {
            enhancedPrompt: parsed.enhanced_prompt || prompt,
            charVisuals:    enhancedChars
        };
    } catch (err) {
        aeLog('[AE:img] enhanceDirectorPrompt failed:', err);
        return null;
    }
}

// [v2.137.0 CEGAL-EQUIP] Equipped-item tags for one character, description-first (falls
// back to name when an item has no description written yet) -- same rule the retired
// bridge widget used (EQUIP-DESC-NOT-NAME), ported rather than re-derived. No round trip:
// this file already owns charRec.equippedItemIds and loadEntity.
async function ceStudioEquipTags(charId: string): Promise<string> {
    if (!charId) return '';
    try {
        const c = await loadCharacter(charId);
        const ids: string[] = (c && c.equippedItemIds) || [];
        if (!ids.length) return '';
        const names: string[] = [];
        for (const itemId of ids) {
            try {
                const it = await loadEntity(itemId);
                if (it) names.push((it.description && String(it.description).trim()) || it.name);
            } catch (e) { /* non-fatal, matches generateCharacterSnapshot's own tolerance */ }
        }
        return names.filter(Boolean).join(', ');
    } catch (e) {
        api.v1.error('[AE:jsxstudio] equip lookup failed:', e);
        return '';
    }
}

// Toggles the append for one slot. Idempotent by construction -- re-entrant taps while a
// lookup is in flight are checked against the CURRENT store state before writing, not the
// state captured when the async call started, so a toggle-off during the round trip wins.
function ceStudioToggleEquip(idx: number): void {
    var cur: any = null;
    try { var st0: any = ceImagesStore ? ceImagesStore.get() : null; cur = st0 && _ceStudioSlots(st0)[idx]; } catch (e) { cur = null; }
    if (!cur || !cur.id) return;

    if (cur._equipOn) {
        var stripped = cur._equipAppended
            ? String(cur.visuals || '').split(cur._equipAppended).join('')
            : String(cur.visuals || '');
        ceStudioPatch(function(s: any) {
            var next = _ceStudioSlots(s).slice();
            if (!next[idx]) return {};
            var row: any = {}; var k: string;
            for (k in next[idx]) { row[k] = next[idx][k]; }
            row.visuals = stripped; row._equipOn = false; row._equipAppended = '';
            next[idx] = row;
            return { slots: next };
        });
        return;
    }

    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (!next[idx]) return {};
        var row: any = {}; var k: string;
        for (k in next[idx]) { row[k] = next[idx][k]; }
        row._equipOn = true;
        next[idx] = row;
        return { slots: next };
    });

    ceStudioEquipTags(cur.id).then(function(tags: string) {
        var st1: any = null;
        try { st1 = ceImagesStore ? ceImagesStore.get() : null; } catch (e) { st1 = null; }
        var live = st1 && _ceStudioSlots(st1)[idx];
        // Toggled off again, removed, or replaced before this resolved -- do nothing.
        if (!live || !live._equipOn || live.id !== cur.id) return;
        if (!tags) {
            try { api.v1.ui.toast('No equipped items found.', { type: 'warning', autoClose: 2500 }); } catch (e2) {}
            return;
        }
        var base = String(live.visuals || '').trim();
        var appended = (base ? ', ' : '') + tags;
        ceStudioPatch(function(s: any) {
            var next = _ceStudioSlots(s).slice();
            if (!next[idx] || next[idx].id !== cur.id || !next[idx]._equipOn) return {};
            var row: any = {}; var k: string;
            for (k in next[idx]) { row[k] = next[idx][k]; }
            row.visuals = base + appended; row._equipAppended = appended;
            next[idx] = row;
            return { slots: next };
        });
    }).catch(function(e: any) { api.v1.error('[AE:jsxstudio] equip append failed:', e); });
}

async function submitDirectorPhoto(
    prompt: string,
    uc: string,
    chars: { name: string; visuals: string; uc?: string }[],
    // [v2.137.0 CEGAL-FIELDSEL] undefined/null = unchanged behaviour, compile the standing
    // active set (compileActiveImageFields). A real array -- including an EMPTY one, a
    // deliberate "fold in nothing" choice -- overrides it for this call only and never
    // touches any field's own `.active` flag. Checked with `!= null` rather than truthiness
    // specifically so [] is not treated the same as "no override".
    fieldIds?: string[] | null,
    // [v2.143.0 PHASE-H] Same contract as fieldIds one line up: null/undefined leaves the
    // globalSettings default alone, a {width,height} pair overrides THIS CALL ONLY. Every
    // other caller (Auto-Snap, Snapshot, avatar and chat-photo paths) omits it and is
    // unaffected -- verified by grep before this parameter was added.
    sizeOverride?: { width: number; height: number } | null
// [v2.156.0 STORYIMG] RETURNS THE UUID IT WAS ALREADY MINTING. This function has always
// called api.v1.uuid() and thrown the result away; the story-image anchor needs it, and
// the widget must be placed the moment Generate fires rather than after a round trip that
// never comes back. Purely additive -- every existing caller ignores the return and is
// unaffected (verified by grep before the signature changed). '' means nothing was sent.
): Promise<string> {
    // [CHANGE] Extracted as pure function with explicit parameters.
    //          Old version read module-level state (currentDirectorPrompt, char1Name_in, etc.)
    //          and wrote to KEY_PENDING + rebuildWidgets().
    //          New version takes all data from parameters and broadcasts EVT_GENERATE_IMAGE.
    // [CHANGE] Bridge guard added.
    // [v2.13.0 IMGFIELDS] No more fuzzy getCharacterData(name) re-resolution here —
    // the bridge's click-to-add picker already resolved {name, visuals, uc} from its
    // own synced character cache (or left them blank for a one-off unnamed slot) and
    // the user could edit any of it; those edits are one-off, per user's call, never
    // written back to the character record, so what the bridge sends IS final. Cap
    // raised from 2 to 4 (matching the picker's own cap). A blank/unnamed slot is a
    // legitimate one-off figure now — no longer filtered out for lacking a name.
    const rawPrompt = prompt.trim();
    if (!rawPrompt) return '';

    if (!isBridgeReady) {
        api.v1.ui.toast('⚠️ Bridge not connected — Director\'s Cut requires bridge.', { type: 'warning', autoClose: 3000 });
        return '';
    }

    const compiled = (fieldIds != null) ? compileImageFieldsSubset(fieldIds) : compileActiveImageFields();
    const finalUC = uc || compiled.negative;

    const cappedChars: { name: string; visuals: string; uc: string }[] = (chars || []).slice(0, 4).map(function(c) {
        return { name: c.name || '', visuals: c.visuals || '', uc: c.uc || '' };
    }).filter(function(c) { return c.name.trim() || c.visuals.trim() || c.uc.trim(); });

    const sdpUuid = api.v1.uuid();
    await broadcastToTM(EVT_GENERATE_IMAGE, {
        uuid:             sdpUuid,
        prompt:           rawPrompt,
        characters:       cappedChars,
        extraBaseVisuals: '',
        extraBaseUC:      '',
        settings: {
            width:    (sizeOverride && Number(sizeOverride.width) > 0)
                          ? Number(sizeOverride.width) : globalSettings.defaultWidth,
            height:   (sizeOverride && Number(sizeOverride.height) > 0)
                          ? Number(sizeOverride.height) : globalSettings.defaultHeight,
            steps:    Math.min(globalSettings.defaultSteps || 28, 28),
            scale:    globalSettings.defaultScale || 5.0,
            quality:  compiled.quality,
            negative: finalUC
        },
        autoDownload: globalSettings.autoDownload
    });
    api.v1.ui.toast('📸 Manual Snap dispatched!');
    return sdpUuid;
}


// ---- Snapshot Image (callable: button or future actions) -------------------
// Reads the stored GLM appearance snapshot for charId, resolves the character's
// cached visuals and any location visuals, and broadcasts a tagged
// EVT_GENERATE_IMAGE { entityId, kind:'snapshot' } so the bridge can land the
// result in the snapshot gallery section and the entity's top pane.
async function assembleSnapshotImage(charId: string): Promise<void> {
    try {
        if (!isBridgeReady) {
            api.v1.ui.toast('Bridge not connected - image generation requires bridge.', { type: 'warning', autoClose: 3000 });
            return;
        }
        let aChar = await loadCharacter(charId);
        if (!aChar) { aeLog('[AE:img] assembleSnapshotImage: char not found'); return; }
        let aEntId = (aChar as any).entityId || null;
        let aEnt = aEntId ? await loadEntity(aEntId) : null;
        let snapText = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_SNAP_PFX + charId, '') as string;
        if (!snapText) {
            api.v1.ui.toast('Generate a text snapshot first.', { type: 'warning', autoClose: 3000 });
            return;
        }
        let locVisuals = '';
        if (aEnt && aEnt.parentId) {
            let aLoc = await loadEntity(aEnt.parentId);
            if (aLoc && (aLoc as any).visuals) locVisuals = String((aLoc as any).visuals);
        }
        let basePrompt = [snapText, locVisuals].filter(Boolean).join(', ');
        let found = getCharacterData(aChar.name);
        let charVisuals = found.length ? found[0].visuals : '';
        let charUC = found.length ? found[0].uc : '';
        let compiled = compileActiveImageFields();
        await broadcastToTM(EVT_GENERATE_IMAGE, {
            uuid:             api.v1.uuid(),
            prompt:           basePrompt,
            characters:       charVisuals ? [{ name: aChar.name, visuals: charVisuals, uc: charUC }] : [],
            extraBaseVisuals: '',
            extraBaseUC:      '',
            charId:           aChar.id,
            entityId:         aEntId,
            kind:             'snapshot',
            settings: {
                width:    globalSettings.defaultWidth,
                height:   globalSettings.defaultHeight,
                steps:    Math.min(globalSettings.defaultSteps || 28, 28),
                scale:    globalSettings.defaultScale || 5.0,
                quality:  compiled.quality,
                negative: compiled.negative
            },
            autoDownload: globalSettings.autoDownload
        });
        api.v1.ui.toast('Generating snapshot image for ' + aChar.name + '...', { type: 'info', autoClose: 2500 });
    } catch (snapImgGenErr) {
        api.v1.error('[AE:img] assembleSnapshotImage:', snapImgGenErr);
    }
}

// [CE-STRIP v2.0.0] aeGenerateActionImage removed — action-triggered image gen
// (the 'generate_image' effect type) was only reachable through the Actions
// effects pipeline, which is gone. Auto-Snap, Snapshot, and Director's Cut image
// generation are separate paths and are untouched.


// ============================================================================
// SECTION 16b — STORY IMAGE WIDGETS  [v2.156.0 STORYIMG]
// Roadmap H2. Studio images landed in the gallery and nowhere else; this puts
// them in the story editor on the same widget channel character-chat photos
// already use, with the same card and the same three verbs.
//
// THE H2 BLOCKER WAS HANDLE-TRACKED CLEARING, AND IT IS CONSTRUCTIBLE.
// refreshCharChatImageWidgets calls a blanket clearWidgets() and its own comment
// states the condition this patch meets: "clearWidgets() is scoped to widgets
// created BY THIS SCRIPT ... If a second widget feature ever lands, this must
// become handle-tracked instead." createWidgets returns DecorationWidgetHandle[]
// with .id and .dispose() (script-types_d.txt ~2430/1793), so both features now
// dispose their OWN handles and neither can wipe the other's.
//
// ANCHORING IS DURABLE, AND THAT IS A MEASURED FACT, not an assumption:
// insertParagraphAfter's own doc comment says "section IDs are not indexes."
// A sectionId therefore survives insertions and deletions elsewhere in the
// document and only dies with its own paragraph -- so { uuid, sectionId } in
// storyStorage is a real anchor, and _ceStoryImgPrune drops the entries whose
// paragraph is gone. This is why there is NO document text tag here. Character
// chat needs one because the tag IS the character's line; a studio image is not
// something anybody said, and writing "[Image#...]" into the author's prose to
// hold a position it does not need would be pollution.
//
// PLACEMENT, per user: end of the story, followed by a fresh empty paragraph so
// typing or generating can continue immediately. The empty paragraph is inserted
// FIRST and the widget anchors on the section above it, so the image lands
// between the last prose and the new blank line.
//
// PENDING NEEDS NO NEW MESSAGE. The engine mints the uuid (submitDirectorPhoto
// always did -- it just discarded it, which is the one change made to that
// function) and anchors the widget the instant Generate fires. The bridge paints
// a placeholder while that uuid is not yet in IndexedDB and swaps in the picture
// when it lands. "Is it generating" is therefore answered by the same fact that
// answers "is it there", and there is nothing to keep in sync.
//
// WHICH ALSO MEANS A FAILED GENERATION LEAVES A PLACEHOLDER STANDING, on purpose
// -- it is true, the image never arrived. ceStoryImgClearAll is the escape
// hatch, and it is also the recovery path for the case no handle can reach: the
// script is unloaded on story switch, so handles from a previous load are gone
// while their widgets are not. That is exactly what the blanket clearWidgets()
// is still good for, and why it is kept as the second half of Clear rather than
// deleted.
//
// OPT-IN, DEFAULT OFF (per user). Nothing is emitted into the story until the
// author turns it on in the Studio, which is also what keeps this safe against
// an older bridge: no toggle, no sentinel, no stray 1px text node.
// ============================================================================

// MUST MATCH the bridge constant of the same name -- FLAG DAY if changed, same
// rule as AE_CHARCHAT_IMG_SENTINEL and AE_CHARCHAT_AVA_SENTINEL before it.
// Payload is the bare 8-hex short id, exactly like the chat sentinel: the widget
// content carries no model prose, so noTemplate is not needed and the createWidgets
// validator stays happy (see CHARCHAT-IMGWIDGET-FIX for what a richer payload cost).
var AE_STORY_IMG_SENTINEL = 'ce-storyimg:';

// The live widget handles for THIS feature. Module state, deliberately: it cannot
// survive a script unload and is not meant to -- _ceStoryImgRefresh rebuilds from
// storyStorage on load, and the stale widgets a previous load left behind are
// cleared by the blanket sweep inside ceStoryImgClearAll.
var _ceStoryImgHandles: any[] = [];

async function loadStoryImgAnchors(): Promise<any[]> {
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_STORY_IMGS, []);
        return (raw && raw.length) ? raw : [];
    } catch (e) { api.v1.error('[AE:storyimg] load failed:', e); return []; }
}

async function saveStoryImgAnchors(list: any[]): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_STORY_IMGS, (list || []).filter(Boolean)); }
    catch (e) { api.v1.error('[AE:storyimg] save failed:', e); }
}

// The 8-hex prefix the bridge prefix-resolves against its gallery index. Identical
// derivation to the bridge's _ccimgBuildIndex, which is what makes the two agree.
function _ceStoryImgShort(uuid: string): string {
    return String(uuid || '').replace(/-/g, '').substring(0, 8).toLowerCase();
}

// Drop anchors whose paragraph no longer exists. A section can be deleted; a
// sectionId cannot drift, so this is the ONLY way an anchor goes stale.
async function _ceStoryImgPrune(anchors: any[]): Promise<any[]> {
    var rows: any[] = [];
    try { rows = await api.v1.document.scan(); } catch (eScan) { return anchors || []; }
    var live: any = {};
    var i = 0;
    for (i = 0; i < (rows || []).length; i++) { live[String(rows[i].sectionId)] = 1; }
    var kept: any[] = [];
    for (i = 0; i < (anchors || []).length; i++) {
        var a: any = anchors[i];
        if (!a || !a.uuid) continue;
        if (live[String(a.sectionId)]) kept.push(a);
    }
    return kept;
}

// Dispose only OUR handles. Never clearWidgets() -- that would take the chat's
// photos and avatars with it, which is the whole point of this being handle-tracked.
async function _ceStoryImgDispose(): Promise<void> {
    var hs = _ceStoryImgHandles;
    _ceStoryImgHandles = [];
    var i = 0;
    for (i = 0; i < hs.length; i++) {
        try { if (hs[i] && hs[i].dispose) await hs[i].dispose(); }
        catch (eDisp) { aeLog('[AE:storyimg] handle dispose failed (already gone?)'); }
    }
}

// Rebuild every story-image widget from the anchor store. Cheap and idempotent:
// dispose ours, prune dead anchors, re-create. Called after a placement, after a
// removal, and once on load.
async function refreshStoryImageWidgets(): Promise<void> {
    await _ceStoryImgDispose();

    var anchors = await loadStoryImgAnchors();
    if (!anchors.length) return;
    var pruned = await _ceStoryImgPrune(anchors);
    if (pruned.length !== anchors.length) { await saveStoryImgAnchors(pruned); }
    if (!pruned.length) return;

    var opts: any[] = [];
    var i = 0;
    for (i = 0; i < pruned.length; i++) {
        opts.push({
            type: 'node',
            sectionId: Number(pruned[i].sectionId),
            content: [{
                type: 'text',
                text: AE_STORY_IMG_SENTINEL + _ceStoryImgShort(pruned[i].uuid),
                style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
            }]
        });
    }
    try {
        var handles: any = await api.v1.editor.decorations.createWidgets(opts);
        _ceStoryImgHandles = (handles && handles.length) ? handles : [];
    } catch (eW) {
        aeLog('[AE:storyimg] widget create failed (images will not appear in the story):', eW);
    }
}

// Place one image at the end of the story. Returns false when it could not, which
// the caller states rather than swallowing.
//
// ORDER IS LOAD-BEARING: the blank continuation paragraph is inserted BEFORE the
// widget is anchored, and the widget anchors on the section ABOVE it. A widget
// inserts after its section (sectionId's own doc comment), so this lands the image
// between the last prose paragraph and the new blank one -- which is what "add a
// paragraph after so it is easy to continue typing" asks for.
async function ceStoryImgPlace(uuid: string): Promise<boolean> {
    if (!uuid) return false;
    var rows: any[] = [];
    try { rows = await api.v1.document.scan(); } catch (eScan) { return false; }
    if (!rows || !rows.length) return false;
    var lastId = Number(rows[rows.length - 1].sectionId);

    // A trailing blank paragraph already there is reused rather than stacking a
    // second one -- generating three images in a row should not leave three empty
    // paragraphs behind.
    var lastTxt = String((rows[rows.length - 1].section && rows[rows.length - 1].section.text) || '');
    if (lastTxt.trim()) {
        try { await api.v1.document.insertParagraphAfter(lastId, { text: '' }); }
        catch (eIns) { aeLog('[AE:storyimg] continuation paragraph failed; anchoring anyway'); }
    } else if (rows.length > 1) {
        // The document already ends blank: anchor above that blank line instead of
        // below it, so the image still sits between prose and the place the cursor
        // wants to be.
        lastId = Number(rows[rows.length - 2].sectionId);
    }

    var anchors = await loadStoryImgAnchors();
    anchors.push({ uuid: String(uuid), sectionId: lastId, createdAt: Date.now() });
    await saveStoryImgAnchors(anchors);
    await refreshStoryImageWidgets();
    return true;
}

// Drop ONE image's anchor. Called by the bridge after a delete from the card
// (AE_STORY_IMG_DROP) -- per user, the widget goes with the image. This is the
// opposite of the chat photo rule, and correctly so: there the document tag is
// the character's own line and outlives the picture, and here there is no line.
async function ceStoryImgDrop(uuid: string): Promise<void> {
    if (!uuid) return;
    var want = String(uuid);
    var wantShort = _ceStoryImgShort(want);
    var anchors = await loadStoryImgAnchors();
    var kept: any[] = [];
    var i = 0;
    for (i = 0; i < anchors.length; i++) {
        var a: any = anchors[i];
        if (!a || !a.uuid) continue;
        // Matched on EITHER form: the card knows the full uuid, but a caller that
        // only ever saw the sentinel knows the short one.
        if (String(a.uuid) === want || _ceStoryImgShort(a.uuid) === wantShort) continue;
        kept.push(a);
    }
    await saveStoryImgAnchors(kept);
    await refreshStoryImageWidgets();
}

// The escape hatch, per user: "in case there is any issue with generation, we need
// to be able to clear the widgets from the story editor."
//
// TWO SWEEPS, AND BOTH ARE NEEDED. Disposing our handles clears what THIS load
// created. The blanket clearWidgets() then catches widgets orphaned by a previous
// load of the script -- a story switch unloads the script and takes its handles
// with it, and nothing else can reach those. That blanket call also takes the
// chat's widgets, which is acceptable ONLY because refreshCharChatImageWidgets
// rebuilds them on its own next tick; it is a repaint for the chat and a real
// clear for us.
async function ceStoryImgClearAll(): Promise<number> {
    var anchors = await loadStoryImgAnchors();
    var n = anchors.length;
    await _ceStoryImgDispose();
    try { api.v1.editor.decorations.clearWidgets(); } catch (eClr) {}
    await saveStoryImgAnchors([]);
    // Give the chat its widgets straight back rather than waiting for its next turn.
    try { await refreshCharChatImageWidgets(); } catch (eCc) {}
    return n;
}


// ============================================================================
// SECTION 18 — BRIDGE MESSAGING LAYER
// All communication between the engine (Web Worker) and bridge (Tampermonkey
// page-context script). Engine→Bridge via api.v1.messaging.broadcast().
// Bridge→Engine via the onMessage listener registered in initMessaging().
//
// Broadcast functions queue and debounce to avoid redundant round-trips when
// multiple storage writes fire in rapid succession (e.g., during runDynamicEngine).
//
// buildSceneStatePayload() is the most complex new function. It loads the
// protagonist's location + one-hop entity graph and packages the data the bridge
// needs to render the Scene HUD. Capped to one-hop range for performance (<200ms).
//
// handleBridgeMessage() is the inbound message router. New event handlers:
//   EVT_DIRECTOR_SUBMIT — bridge submitted Director's Cut (enhance or generate)
//   EVT_REQ_SCENE_STATE — bridge requests immediate SCENE_STATE_UPDATE push
//   EVT_REQ_CHAR_DATA   — bridge requests immediate CHARACTER_DATA_SYNC push
// On EVT_HANDSHAKE_ACK: immediately push char data then scene state, then AE_IMG_FIELDS_SYNC.
// ============================================================================

// ── Broadcast Primitives ──────────────────────────────────────────────────────


async function broadcastToTM(event: string, data?: Record<string, any>): Promise<void> {
    // Preserved verbatim from AI engine.
    data = data || {};
    try {
        await api.v1.messaging.broadcast(
            { type: 'MESSAGE', sid: api.v1.script.id, payload: Object.assign({ event: event }, data) },
            'hypebot'
        );
    } catch (e) {
        aeLog('[AE:bridge] broadcastToTM failed:', e);
    }
}

// [FEATURE v2.51.4 ENGINE-THINKING-SIGNAL] Reference count, not a boolean — onGenerationRequested
// and onGenerationEnd fire for EVERY api.v1.generate() call including nested ones (ephemeral
// thoughts, the image architect's own probe), per the existing _diagProbeActive guard comment
// elsewhere in this file ("it now fires every ephemeral/architect call"). If a main story
// generation is still in flight when a nested ephemeral call finishes, that call's onGenerationEnd
// must not turn the indicator off out from under the still-running outer one. Only broadcasts on
// the 0->1 and 1->0 transitions, not every call, so the bridge doesn't get spammed for the length
// of a busy scene.
let _aeThinkingRefs = 0;
async function _aeThinkingPulse(on: boolean): Promise<void> {
    let before = _aeThinkingRefs;
    _aeThinkingRefs = Math.max(0, _aeThinkingRefs + (on ? 1 : -1));
    if ((before === 0) === (_aeThinkingRefs === 0)) return; // no 0<->nonzero transition, nothing to say
    // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] Gated to an active chat so ordinary story play (where
    // this pulse fires constantly and harmlessly) doesn't get spammed. This is the GHOST GLYPH's
    // real on/off timing, which is a SEPARATE signal from busyStage's send-button badge — if the
    // user is watching the glyph specifically, this is what tells us whether IT clears before the
    // underlying generation slot is actually free, independent of what the badge says.
    if (_aeCharChat.active) _ccRaceDiagMark('ghost signal -> ' + (_aeThinkingRefs > 0 ? 'ON' : 'OFF'));
    try { await broadcastToTM(EVT_ENGINE_THINKING, { on: _aeThinkingRefs > 0 }); }
    catch (eEt) { aeLog('[AE:engine-thinking] pulse broadcast failed:', eEt); }
}

// ── Character Data Broadcast ──────────────────────────────────────────────────

async function buildCharacterDataPayload(): Promise<CharacterVisualRecord[]> {
    // Reads all active characters and packages their visual + persona fields into
    // CharacterVisualRecord[]. Also updates cachedCharVisuals in-memory so
    // getCharacterData() stays current without a round-trip on the next call.
    try {
        const chars = await loadAllCharacters();
        const result: CharacterVisualRecord[] = chars
            .filter(function(c) { return c.active !== false; })
            .map(function(c): CharacterVisualRecord {
                return {
                    id:                  c.id,
                    name:                c.name,
                    nicknames:           c.nicknames           || [],
                    visuals:             c.visuals             || '',
                    uc:                  c.uc                  || '',
                    sceneVisuals:        c.sceneVisuals        || '',
                    avatarVisuals:       c.avatarVisuals       || '',
                    avatarWidth:         c.avatarWidth         || 832,
                    avatarHeight:        c.avatarHeight        || 1216,
                    avatarSeed:          c.avatarSeed          || 0,
                    species:             c.species             || '',
                    age:                 c.age                 || '',
                    gender:              c.gender              || '',
                    briefDescription:    c.briefDescription    || '',
                    physicalDescription: c.physicalDescription || '',
                    personalityCore:     c.personalityCore     || '',
                    voiceAndMannerisms:  c.voiceAndMannerisms  || '',
                    background:          c.background          || ''
                };
            });
        cachedCharVisuals = result; // keep in-memory cache current
        return result;
    } catch (e) {
        aeLog('[AE:bridge] buildCharacterDataPayload error:', e);
        return [];
    }
}

async function broadcastCharacterData(): Promise<void> {
    if (!isBridgeReady) return;
    try {
        const payload = await buildCharacterDataPayload();
        await broadcastToTM(EVT_CHAR_DATA_SYNC, { characters: payload });
        aeLog('[AE:bridge] Character data synced:', payload.length, 'characters.');
    } catch (e) {
        aeLog('[AE:bridge] broadcastCharacterData error:', e);
    }
}

function queueCharacterDataBroadcast(): void {
    // [v0.9.36] Serialize + coalesce (same rationale as queueSceneStateBroadcast).
    // commitTravel's scene-presence loop saves several characters in a row, each of
    // which queued a broadcast; this collapses them into one.
    if (!isBridgeReady) return;
    if (ae_cdbInFlight) { ae_cdbPending = true; return; }
    ae_cdbInFlight = true;
    broadcastCharacterData()
        .catch(function(e) { aeLog('[AE:bridge] charData broadcast err:', e); })
        .then(function() {
            ae_cdbInFlight = false;
            if (ae_cdbPending) { ae_cdbPending = false; queueCharacterDataBroadcast(); }
        });
}

// ── Scene State Broadcast ─────────────────────────────────────────────────────

// [v0.9.9.2] Scan library templates (cheap, in-memory) for time conditions so the
// calendar can mark actions tied to times. One entry per template; the first time
// condition found provides the placement hint, the summary lists them all.

// [v1.13.3] Extracted from buildSceneStatePayload so the clock is readable without a
// resolved player location/protagonist. buildSceneStatePayload (and therefore
// getSceneState()) returns null on a fresh scenario before any location is set — that's a
// location precondition, not a clock precondition. openCalendarModal was piggybacking on the
// full scene-state payload just to reach `.clock`, which meant the calendar reported "no clock"
// on every brand-new scenario even though loadClock() itself has always been location-independent
// (it seeds from cfg.timeStartHours).

async function buildSceneStatePayload(): Promise<SceneStatePayload | null> {
    // Assembles the full HUD payload. Reads the current camera location, present
    // characters, party resources, and one-hop entity actions. Capped to one hop for
    // performance. Calls evaluateFieldCondition (Section 19) — forward reference, safe
    // at runtime.
    try {

        // 2. Current location entity — the camera. [v2.31.0 ROOT-LOCATION-HUD, per
        // user: "the HUD still shows No scene state available"] FIXES a gap v2.30.0
        // left: loadPlayerLocation() was fixed to return AE_ROOT_LOCATION_ID instead
        // of null when no location exists, but this function still did
        // loadEntity(locId) unconditionally right after — and the root sentinel is
        // DELIBERATELY not a real entity (see its own comment), so that load always
        // returned undefined and this function still bailed to null every time,
        // reproducing the exact same "No scene state available" the v2.30.0 patch was
        // meant to fix. This was the actual gap, not a regression in the sentinel
        // logic itself, which was and is correct — recalculateScenePresence's
        // cRoom===camRoom match already works fine with it.
        // FIX: when locId IS the root sentinel, skip loadEntity entirely and
        // synthesize a minimal stand-in with the fields this function actually reads
        // (name/description/state/parentId) — a location-less world's "scene" is just
        // "wherever everyone's unplaced bodies already are," so this describes that
        // literally rather than pretending a real location exists.
        const locId  = await loadPlayerLocation();
        if (!locId) return null;
        let locEnt: any;
        if (locId === AE_ROOT_LOCATION_ID) {
            locEnt = { id: AE_ROOT_LOCATION_ID, name: 'Unplaced', description: 'No location has been created yet.', stateDescriptions: {}, state: 'default', parentId: null, type: 'location' };
        } else {
            locEnt = await loadEntity(locId);
            if (!locEnt) return null;
        }
        aeLog('[AE:TRACE] buildSceneState cameraLoc=' + locEnt.name + '(' + locId + ')');

        // 3. Resolve state-dependent description
        const locDesc = (locEnt.stateDescriptions && locEnt.stateDescriptions[locEnt.state])
            || locEnt.description || '';

        // 4. Present characters → SceneCharacterInfo[]. [CE-STRIP vNEXT] No longer
        // force-includes the protagonist via an isProtagonist OR-clause — presence is
        // now purely "co-located with the camera" (recalculateScenePresence), same rule
        // for everyone, protagonist included.
        const allChars = await loadAllCharacters();
        // [v2.107.0 ATTENTION] Was a synchronous .map(). _ceDramaAttention reads
        // historyStorage, so this became a sequential for-loop rather than a Promise.all:
        // the reads are already serialized inside the helper, and a parallel fan-out over a
        // crowded scene would buy nothing while making a partial failure harder to read.
        const presentCharacters: SceneCharacterInfo[] = [];
        for (const c of allChars.filter(function(c2) { return c2.scenePresent; })) {
            presentCharacters.push({
                id:              c.id,
                name:            c.name,
                entityId:        c.entityId || '',
                briefDescription: c.briefDescription || '',
                compressedLine:  (c.ephemeral && c.ephemeral.compressedLine) || '',
                isProtagonist:   !!c.isProtagonist,
                attention:       await _ceDramaAttention(c)
            });
        }

        // [CE-STRIP v2.0.0] Action scope / available actions / available ActionInstances /
        // follow-state annotation removed — Actions system cut. allEntityMeta is still
        // needed below by the (simplified, awareness-only) location graph.
        const allEntityMeta = await loadEntityIndex();

        // 8. Location graph — parent (up), children (down), explicit connections (side)
        // [FIX Bug3] Added currentIcon + parentIcon so bridge can render entity icons on map nodes.
        // [CE-STRIP v2.0.0] Travel-cost annotations (resourceTag/resourceCost/resourceIcon/
        // timeCost/gated/requiresVehicle) removed — this is now awareness/adjacency only.
        const locationGraph = {
            currentName:    locEnt.name,
            currentType:    'location',
            currentIcon:    (locEnt as any).icon || undefined,
            parentId:    locEnt.parentId || null,
            parentName:  '',
            parentType:  '',
            parentIcon:  undefined as string | undefined,
            children:    [] as { id: string; name: string; type: string; hasChildren: boolean; icon?: string; }[],
            connections: [] as { id: string; name: string; label: string; oneWay: boolean; icon?: string; }[],
            siblings:    [] as { id: string; name: string; type: string; icon?: string; }[]
        };

        if (locEnt.parentId) {
            const parentMeta = allEntityMeta.find(function(m) { return m.id === locEnt.parentId; });
            if (parentMeta) { locationGraph.parentName = parentMeta.name; locationGraph.parentType = parentMeta.type; locationGraph.parentIcon = (parentMeta as any).icon || undefined; }
        }
        for (const childMeta of allEntityMeta) {
            if (childMeta.parentId === locId && childMeta.type === 'location') {
                const lgHasGrandchildren = allEntityMeta.some(function(m) { return m.parentId === childMeta.id && m.type === 'location'; });
                locationGraph.children.push({
                    id: childMeta.id, name: childMeta.name, type: childMeta.type,
                    hasChildren: lgHasGrandchildren, icon: childMeta.icon || undefined
                });
            }
        }
        for (const lgConn of (locEnt.connectedEntityIds || [])) {
            const lgConnMeta = allEntityMeta.find(function(m) { return m.id === lgConn.targetId; });
            if (lgConnMeta) {
                locationGraph.connections.push({
                    id: lgConn.targetId, name: lgConnMeta.name,
                    label: (lgConn as any).label || '', oneWay: (lgConn as any).oneWay || false,
                    icon: lgConnMeta.icon || undefined
                });
            }
        }

        // [v0.9.81] Lateral siblings: location-type entities sharing this location's parentId
        // (null parentId = shared world root, so top-level locations are mutually reachable).
        // [CE-STRIP v2.0.0] awareness only — no travel cost.
        for (const sibMeta of allEntityMeta) {
            if (sibMeta.type !== 'location' || sibMeta.id === locId) continue;
            if (sibMeta.parentId !== locEnt.parentId) continue;
            locationGraph.siblings.push({
                id: sibMeta.id, name: sibMeta.name, type: sibMeta.type,
                icon: sibMeta.icon || undefined
            });
        }

        // 8b. Present items — item-type entities whose parent is the current location
        const presentItems = allEntityMeta
            .filter(function(m) { return m.type === 'item' && m.parentId === locId; })
            .map(function(m) { return { id: m.id, name: m.name, icon: (m as any).icon || undefined }; });

        const cfg = await loadConfig();

        return {
            locationId:           locId,
            locationName:         locEnt.name,
            locationState:        locEnt.state || 'default',
            presentCharacters:    presentCharacters,
            locationGraph:        locationGraph,
            presentItems:         presentItems,
            // [CE-STRIP v2.1.x] presentMinorNpcs removed — minor-NPC tier retired, everyone is a normal character now.
            // [CE-STRIP v2.1.6] npcArchetypes/itemArchetypes removed from scene payload — Bestiary + Item Templates cut.
            defaultBgUrl:         (cfg as any).defaultBackgroundUrl || ''
        };
    } catch (e) {
        aeLog('[AE:bridge] buildSceneStatePayload error:', e);
        return null;
    }
}


async function broadcastSceneState(): Promise<void> {
    if (!isBridgeReady) return;
    try {
        const payload = await buildSceneStatePayload();
        if (payload) await broadcastToTM(EVT_SCENE_STATE, payload);
    } catch (e) {
        aeLog('[AE:bridge] broadcastSceneState error:', e);
    }
}

function queueSceneStateBroadcast(): void {
    // [v0.9.36] Serialize + coalesce. The previous fire-and-forget spawned a fresh
    // broadcastSceneState() on every call; during commitTravel that meant ~5 CONCURRENT
    // payload builds, each calling loadPlayerLocation() at a different instant, so a
    // stale 'old room' payload could land after the fresh one -> visible flicker/flap.
    // Now at most one runs at a time; requests during a run collapse into a single
    // follow-up that reflects the final settled state.
    if (!isBridgeReady) return;
    if (ae_sbcInFlight) { ae_sbcPending = true; return; }
    ae_sbcInFlight = true;
    broadcastSceneState()
        .catch(function(e) { aeLog('[AE:bridge] sceneState broadcast err:', e); })
        .then(function() {
            ae_sbcInFlight = false;
            if (ae_sbcPending) { ae_sbcPending = false; queueSceneStateBroadcast(); }
        });
}

// ── Messaging Init ────────────────────────────────────────────────────────────

async function initMessaging(): Promise<void> {
    // [v0.9.29 HSK1] onMessage registration is awaited so the handler is in place
    // before onScriptsLoaded continues (fast ACKs won't be missed).
    // The handshake itself is then retried in a detached loop so story init is not
    // blocked if the bridge proxy installed after our worker was constructed.
    try {
        await api.v1.messaging.onMessage(handleBridgeMessage);
    } catch (e) {
        aeLog('[AE:bridge] initMessaging onMessage error:', e);
        return;
    }

    // Fire-and-forget retry loop. Sends the full handshake sequence (IN + OUT + REQ)
    // every 1.5 s until the bridge ACKs (isBridgeReady) or 20 attempts are exhausted.
    // Using an anonymous IIFE avoids the named-async-in-sync-body NAI sandbox constraint.
    (async function() {
        let _hsAttempts = 0;
        while (!isBridgeReady && _hsAttempts < 20) {
            try {
                await api.v1.messaging.broadcast(
                    { type: 'HANDSHAKE', sid: api.v1.script.id, payload: { handshake: 'NAI_SCRIPT:IN' } }
                );
                await api.v1.messaging.broadcast(
                    { type: 'HANDSHAKE', sid: api.v1.script.id, payload: { handshake: 'NAI_SCRIPT:OUT' } }
                );
                await broadcastToTM(EVT_HANDSHAKE_REQ, { scriptId: api.v1.script.id });
            } catch (e2) {
                aeLog('[AE:bridge] handshake attempt', _hsAttempts, 'error:', e2);
            }
            _hsAttempts++;
            if (isBridgeReady) break;
            aeLog('[AE:bridge] Handshake attempt', _hsAttempts, '— waiting for ACK…');
            await api.v1.timers.sleep(1500);
        }
        if (isBridgeReady) {
            aeLog('[AE:bridge] Bridge connected after', _hsAttempts, 'attempt(s).');
        } else {
            aeLog('[AE:bridge] Bridge did not ACK after', _hsAttempts, 'attempts. Running engine-only.');
        }
    })().catch(function(e3) { aeLog('[AE:bridge] initMessaging loop error:', e3); });
}

async function buildEntityDetailPayload(fId: string, char: any, ent: any): Promise<any> {
    const detailPayload: any = {
        id: fId,
        name: char ? char.name : (ent ? ent.name : 'Unknown'),
        type: char ? 'character' : (ent ? ent.type : 'location'),
        compiledThought: char && char.ephemeral ? char.ephemeral.compressedLine : '',
        hooks: char ? (char.hooks || []).filter((h: any) => !h.resolved) : [],
        isEquipped: ent ? !!ent.isEquipped : false,
        equippedToCharId: ent ? ent.equippedToCharId : undefined,
        isProtagonist: !!(char && char.isProtagonist)
    };

    // [v0.9.88] For item entities, resolve the character record ID whose entity body
    // is the item's parent. AE_EQUIP_ITEM requires a character record ID (not an entity ID),
    // so we expose it as ownerCharId. equippedToCharId covers the "currently equipped to"
    // case; ownerCharId covers "which character owns / carries this item" (same as unequip).
    if (ent && ent.type === 'item' && ent.parentId) {
        const _itemAllChars = await loadAllCharacters();
        const _itemOwner = _itemAllChars.find(function(c: any) { return c.entityId === ent.parentId; });
        detailPayload.ownerCharId = _itemOwner ? _itemOwner.id : undefined;
        detailPayload.parentId = ent.parentId; // expose raw entity parentId too for reference
    }

    const targetParentId = char ? char.entityId : (ent ? ent.id : null);
    const entIdx = await loadEntityIndex();
    // [v0.9.32 FOLLOW3] Compute isFollowing: char entity parented under protagonist body.
    if (char && char.entityId && ent) {
        const _fdAllChars = await loadAllCharacters();
        const _fdProtag = _fdAllChars.find(function(c) { return !!c.isProtagonist; });
        detailPayload.isFollowing = !!(ent && _fdProtag && _fdProtag.entityId && ent.parentId === _fdProtag.entityId);
    }
    const children = [];
    if (targetParentId) {
        // [v0.9.9.7] Narrative children carry storyState/eventDayTarget so any list that
        // renders a character's or location's narrative children can show real state
        // instead of always-locked placeholders.
        // [v2.103.0 CE-SWEEP] isTracked/questTargetName dropped with quest tracking.
        const childMetas = entIdx.filter(m => m.parentId === targetParentId);
        // [BUGFIX v2.18.1] childOut.id below is cEnt.id -- the child's ENTITY/body id.
        // For a character-type child that's NOT the same id cachedCharVisuals/
        // AE_FETCH_CHAR_PROFILE/AE_OPEN_CHAR_EDIT key on (the character's own storage
        // id, char.id) -- those two ids are deliberately different (see
        // spawnSceneNpc: rec.entityId = body.id, rec.id is separate). A caller that
        // used childOut.id to focus/profile a present character was silently
        // operating on the wrong record. Resolved once, only when there's a
        // character-type child to resolve, reused for all of them below.
        const _hasCharChild = childMetas.some(m => m.type === 'character');
        const _childAllChars = _hasCharChild ? await loadAllCharacters() : [];
        for (const cm of childMetas) {
            const cEnt = await loadEntity(cm.id);
            if (cEnt) {
                const childOut: any = {
                    id: cEnt.id,
                    name: cEnt.name,
                    type: cEnt.type,
                    icon: cEnt.icon || undefined,
                    description: cEnt.description || '',
                    state: cEnt.state || 'default',
                    isEquipped: !!cEnt.isEquipped,
                    equippedToCharId: (cEnt as any).equippedToCharId,
                };
                if (cEnt.type === 'character') {
                    // [BUGFIX v2.18.1] The character's own storage id -- use THIS, not
                    // childOut.id, to focus/profile/edit a present-character child.
                    const _cMatch = _childAllChars.find(function(c: any) { return c.entityId === cEnt.id; });
                    childOut.charId = _cMatch ? _cMatch.id : undefined;
                    // [v2.107.0 ATTENTION] Second of the two surfaces that render a
                    // character avatar (the other is SceneCharacterInfo). Location
                    // inspection reaches characters through THIS path, never through the
                    // scene roster, so omitting it here would leave the dot missing on
                    // exactly the surface used to browse a location the player is not in.
                    if (_cMatch) childOut.attention = await _ceDramaAttention(_cMatch);
                }
                if (cEnt.type === 'narrative') {
                    childOut.storyState = (cEnt as any).storyState || 'locked';
                    childOut.eventDayTarget = (cEnt as any).eventDayTarget;
                }
                children.push(childOut);
            }
        }
    }
    detailPayload.children = children;

    // [v0.9.20] Per-character resources (charResourceDefs + charResourceValues)
    if (char) {
        const crdefs: any[] = char.charResourceDefs || [];
        if (crdefs.length > 0) {
            detailPayload.charResources = crdefs.map(function(def: any) {
                const val = (char.charResourceValues || {})[def.id] || 0;
                return { id: def.id, tag: def.tag, name: def.name, type: def.type, value: val,
                    hasBounds: !!def.hasBounds, min: def.min, max: def.max, states: def.states || [] };
            });
        }
    }

    // [v2.15.0 BRIDGE-CONDITIONS] Expose entityId (the bridge needs this as the
    // parent id for character-scoped item creation, see AE_HUD_SPAWN_ENTITY /
    // spawnItem's explicitParentId), plus the Conditions definitions + this
    // character's active state (CE-STRIP v2.6.0 PASS 10 shipped these engine-side
    // with no bridge exposure at the time — this is that catch-up). Definitions
    // are global (cfg.conditions), not character-specific, but only worth the
    // loadConfig() call when there's actually a character to report state for.
    if (char) {
        detailPayload.entityId = char.entityId;
        const bcCfg = await loadConfig();
        detailPayload.conditionDefs = bcCfg.conditions || [];
        detailPayload.activeConditions = char.activeConditions || [];
    }

    // [v2.18.0 BRIDGE-DRAMA] Same catch-up pattern as BRIDGE-CONDITIONS above:
    // ephemeral/position (was primaryRelationship) have lived on CharacterRecord since
    // day one but were never serialized to the bridge — nothing exposed them for the
    // flat Drama tab to read.
    // [v2.90.0 MIDRANGE-RETIRE] detailPayload.midRange dropped from this trio; the
    // bridge's matching Drama rows went in the paired bridge patch.
    // Passed through as-is; the bridge renders them read-only, no reshaping needed.
    if (char) {
        detailPayload.ephemeral = char.ephemeral || null;
        detailPayload.position = (char as any).position || null;  // [v2.92.0 POSITION] was primaryRelationship
        // [v2.107.0 ATTENTION] The character's own attention state, so the Drama tab can
        // render its header without recomputing the rule bridge-side. One rule, one place;
        // a bridge-side reimplementation would be a second source of truth that drifts the
        // first time a tier boundary moves.
        detailPayload.attention = await _ceDramaAttention(char);
        // The tier is NOT on the record — it lives in historyStorage under
        // 'position_<targetId>' so Undo reverts it for free. Sent alongside so the bridge
        // can render it without a second round trip, and sent as null when there is no
        // resolved target, which the bridge reads as "no axis" rather than "tier 0".
        try {
            const _dpPos: any = (char as any).position;
            const _dpTid = _dpPos ? String(_dpPos.targetId || '') : '';
            detailPayload.positionTier = _dpTid ? await _ceReadPressure(char.id, 'position_' + _dpTid) : null;
        } catch (eDpPos) { detailPayload.positionTier = null; }
        // [v2.86.0 LIVE-THOUGHT] The dynamics system had NO ui surface reporting whether
        // it is even running for a given character — the only switch visible in the HUD is
        // Dynamic/Static, while the actual gate for thought generation is
        // autoThoughtsEnabled, which lives in the engine's own char-edit modal. A
        // character could read "Dynamic" in the HUD and still have thoughts off, with the
        // only evidence being a suppressed console channel. That is the exact confusion
        // this exposes: liveThought.on is the REAL gate, reported next to its output.
        //
        // reaction/intent below are the two lines as buildWorldStateBlock composes them,
        // NOT the raw snapshot fields — intent especially, since _ceFrameIntent rewrites
        // its framing by pressure tier and the whole point of the panel is to show what
        // actually reaches the Author's Note.
        try {
            const _ltEph: any = char.ephemeral;
            const _ltRaw = (_ltEph && _ltEph.immediateDesire) ? _ltEph.immediateDesire : '';
            const _ltTier = _ltRaw ? await _ceReadPressure(char.id, 'pursuit') : 0;
            detailPayload.liveThought = {
                on: !!char.autoThoughtsEnabled,
                isStatic: !!(char as any).isStatic,
                scenePresent: !!char.scenePresent,
                atGen: (_ltEph && _ltEph.generatedAtGen) || 0,
                reaction: (_ltEph && _ltEph.emotionalResponse) ? _ltEph.emotionalResponse : '',
                intent: _ltRaw ? _ceFrameIntent(_ltRaw, _ltTier) : '',
                pursuitTier: _ltTier,
                hookTier: await _ceReadPressure(char.id, 'hook'),
                // [v2.87.0 LIVE-THOUGHT-EXPAND] Prior INTENTS only (not whole snapshots).
                // These are the exact strings fed back into the next generation as the
                // do-not-repeat guard, so showing them explains why a thought varied — and
                // watching the same intent recur across entries is the visible symptom of a
                // stuck character that pressure escalation is supposed to break.
                history: (char.ephemeralHistory || []).slice(0, 3).filter(Boolean).map(function(h: any) {
                    // [v2.89.1 EVIDENCE-SURFACE] state is the beat pass's own pursuit
                    // classification for that beat (v2.89.0 EVIDENCE-STAMP). An EMPTY
                    // string here is meaningful and is not the same as 'untouched': the
                    // stamp is only written when the model returned one of the three known
                    // values, so blank means no usable classification came back. Showing it
                    // is what makes a flat pressure tier readable at all.
                    return { intent: h.immediateDesire || '', atGen: h.generatedAtGen || 0, state: h.pursuitState || '' };
                }).filter(function(h: any) { return !!h.intent; })
            };
        } catch (eLt) {
            detailPayload.liveThought = { on: !!char.autoThoughtsEnabled, error: true };
        }
    }

    // [CE-STRIP v2.1.5] detailPayload.actions/actionInstances removed — dead Actions remnants, always empty.

    if (ent && ent.type === 'narrative') {
        // [CE-STRIP v2.0.0] pathNames (findTravelPath) removed with Travel.
        // [v2.103.0 CE-SWEEP] isTracked / questTarget / questTargetName removed with quest
        // tracking. pathNames stays as an empty array for one release so a bridge that has
        // not been updated in lockstep still reads a list rather than undefined.
        detailPayload.narrative = {
            pathNames: [] as string[],
            storyState: ent.storyState || 'locked',
            description: ent.description || ''
        };
    }

    return detailPayload;
}

// [CE-STRIP v2.0.0] performTravelRequest removed — Travel cut.


// [CE-STRIP v2.0.0] toggleCharFollow removed — travel/follow cut.


// [v0.9.9.7] Shared hook resolution. Extracted from AE_RESOLVE_HOOK so the native
// character inspection view can resolve a hook without a message round-trip.
async function resolveCharHook(charId: string, hookId?: string, hookIndex?: number): Promise<void> {
    try {
        if (!charId) return;
        const fresh = await loadCharacter(charId);
        if (!fresh) return;
        if (!fresh.hooks) fresh.hooks = [];

        let idx = -1;
        if (hookId) {
            idx = fresh.hooks.findIndex((h: any) => h.id === hookId);
        } else if (typeof hookIndex === 'number') {
            idx = hookIndex;
        }

        if (idx >= 0 && idx < fresh.hooks.length) {
            const hkFresh = fresh;
            const hkDesc = hkFresh.hooks[idx].description.substring(0, 50);
            hkFresh.hooks.splice(idx, 1);
            // [v2.82.0 PRESSURE] Clear the pressure counter with the hook it belonged to,
            // so the next spawned hook starts at tier 1 instead of inheriting whatever
            // tier this one capped out at.
            await api.v1.historyStorage.remove(_cePressureKey(charId, 'hook'));
            await saveCharacter(hkFresh);
            api.v1.ui.toast('✓ Resolved: ' + hkDesc, { type: 'success', autoClose: 3000 });
            await broadcastCharacterData();
            await broadcastSceneState();

            let ent = null;
            if (hkFresh.entityId) ent = await loadEntity(hkFresh.entityId);
            const detailPayload = await buildEntityDetailPayload(charId, hkFresh, ent);
            await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', detailPayload);
        }
    } catch (e) { aeLog('[AE:bridge] resolveCharHook error:', e); }
}

// [CE-STRIP v2.0.0] toggleNarrativeTracking removed — quest-tracker cut.


// [v0.9.9.7] Shared equip/unequip. Extracted from AE_EQUIP_ITEM / AE_UNEQUIP_ITEM
// (merged via the equip flag) so native item rows can toggle equip state without a
// message round-trip. Rule preserved exactly: the toggle only ever targets the
// item's own owner/parent character id passed in as charId -- callers resolve which
// character that is (owner for equip, equippedToCharId for unequip); there is no
// character picker.
async function setItemEquip(charId: string, itemId: string, equip: boolean): Promise<void> {
    try {
        if (!charId || !itemId) return;
        const char = await loadCharacter(charId);
        const item = await loadEntity(itemId);
        if (!char || !item) return;
        await aeSetEquip(item, char, equip);
        api.v1.ui.toast(equip ? ('🎒 Equipped: ' + item.name) : ('🎒 Unequipped: ' + item.name), { type: equip ? 'success' : 'info', autoClose: 2000 });
        await broadcastCharacterData();
        await broadcastSceneState();

        let ent = null;
        if (char.entityId) ent = await loadEntity(char.entityId);
        const detailPayload = await buildEntityDetailPayload(charId, char, ent);
        await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', detailPayload);
    } catch (e) { aeLog('[AE:bridge] setItemEquip error:', e); }
}

// ── Inbound Message Router ────────────────────────────────────────────────────

// [v0.9.101 ENTITIES] Normalize a kind's entities (memory sections / species / factions)
// into a uniform shape for the HUD. Reads the SAME cfg stores the engine wizard writes.

// [v0.9.97 WIZHUD] Build the wizard snapshot for the HUD: topic registry, chat list
// (lightweight), and the active chat in full (messages + context selection).
async function buildWizardStatePayload(): Promise<any> {
    let wcfg = await loadConfig();
    let topicsSrc = ((wcfg as any).wizardTopics && (wcfg as any).wizardTopics.length) ? (wcfg as any).wizardTopics : DEFAULT_WIZARD_TOPICS;
    let topics = topicsSrc.map(function(t: WizardTopic) { return { id: t.id, label: t.label, commitKind: t.commitKind }; });
    let chats = await loadWizardChats();
    let list = chats.map(function(c: WizardChat) {
        return { id: c.id, topicId: c.topicId, title: c.title, updatedAt: c.updatedAt, msgCount: (c.messages || []).length };
    }).sort(function(a: any, b: any) { return b.updatedAt - a.updatedAt; });
    let activeId = await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_ACTIVE_CHAT, '') as string;
    let active = null;
    if (activeId) {
        let ac = await loadWizardChat(activeId);
        if (ac) {
            active = {
                id: ac.id, topicId: ac.topicId, title: ac.title,
                messages: ac.messages || [],
                contextChatIds: ac.contextChatIds || [],
                lorebookEntryIds: ac.lorebookEntryIds || [],
                includeStory: !!ac.includeStory
            };
        } else { activeId = ''; }
    }
    return { topics: topics, chats: list, activeChatId: activeId, activeChat: active, project: { name: wcfg.projectName || '', genre: wcfg.projectGenre || '', concept: wcfg.projectConcept || '' } };
}

// [v0.9.97 WIZHUD] List selectable context sources for a chat: other wizard chats,
// lorebook entries, and characters (each flagged whether it already has a lore entry,
// so the picker can show 'will create on add'). Mirrors buildWizardContext's sources.
async function buildWizardSourcesPayload(chatId: string): Promise<any> {
    let chats = await loadWizardChats();
    let otherChats = chats.filter(function(c: WizardChat) { return c.id !== chatId; })
        .map(function(c: WizardChat) { return { id: c.id, title: c.title, topicId: c.topicId }; });
    let lbEntries: any[] = [];
    try {
        let entries = await api.v1.lorebook.entries();
        lbEntries = (entries || []).map(function(e: any) {
            let label = e.displayName || (e.keys && e.keys.length ? e.keys[0] : 'Untitled');
            let preview = (e.text || '').slice(0, 80);
            return { id: e.id, label: label, preview: preview };
        });
    } catch (eWlb) { lbEntries = []; }
    let chars = await loadAllCharacters();
    let charSources = chars.map(function(ch: CharacterRecord) {
        return { id: ch.id, name: ch.name, hasLoreEntry: !!ch.lorebookEntryId, lorebookEntryId: ch.lorebookEntryId || '' };
    });
    let active = chatId ? await loadWizardChat(chatId) : null;
    return {
        chatId: chatId,
        chats: otherChats,
        lorebookEntries: lbEntries,
        characters: charSources,
        selected: active ? {
            contextChatIds: active.contextChatIds || [],
            lorebookEntryIds: active.lorebookEntryIds || [],
            characterIds: active.characterIds || [],
            includeStory: !!active.includeStory
        } : { contextChatIds: [], lorebookEntryIds: [], characterIds: [], includeStory: false }
    };
}

// [v0.9.93 PROFILE] Narrative fields regenerable per-field from the concept dump alone
// (seed-and-go). These map 1:1 to generateCharacterFields' labelled output, so a per-field
// regen runs that generator and applies only the requested key.
var REGENERABLE_CHAR_FIELDS: string[] = [
    'species', 'age', 'gender', 'occupationRole', 'briefDescription',
    'physicalDescription', 'personalityCore', 'voiceAndMannerisms', 'background', 'coreValues'
];

// [v0.9.93 PROFILE] Build the full editable character profile for the HUD. Reads the SAME
// CharacterRecord the native editor reads — single source of truth, no divergence.
async function buildCharProfilePayload(char: CharacterRecord, cfg: GlobalConfig): Promise<any> {
    // Custom static fields: pair each def with its current value.
    // [v2.105.0 FIELD-GROUPING] Ordered by slot group, and each entry now carries `group`
    // (the machine key) and `groupLabel` (the display name). The bridge draws a divider
    // whenever groupLabel changes rather than one 'Dynamic fields' heading over the whole
    // run, so a facet appears under the slot it deepens on this surface too.
    //
    // The label is computed HERE, not on the bridge, for the same reason CE_FACET_HINTS is
    // computed there: the group->name mapping is engine config territory (an author can add
    // a slot value), and a second hand-maintained copy would drift silently \u2014 the
    // symptom being a divider that says the wrong thing, which nobody reports as a bug.
    let pCustom: any[] = [];
    for (let pCf of ceOrderStaticFields(cfg.customStaticFields || [])) {
        let pGrp = ceStaticFieldGroup(pCf);
        // [v2.109.0 PROFILE-SHAPE] `kind` added. It was always present on the def and always
        // dropped here, so every consumer had to guess whether an entry was a card-driven
        // slot or a freely-addable facet -- the jsx profile cannot render the slot-first
        // ordering ceOrderStaticFields already guarantees without being told which is which.
        pCustom.push({ id: pCf.id, key: 'custom.' + pCf.id, kind: String((pCf as any).kind || 'facet'), label: pCf.label, instructions: pCf.instructions || '', value: (char.customFieldValues || {})[pCf.id] || '', group: pGrp, groupLabel: ceStaticFieldGroupLabel(pGrp) });
    }

    // Faction relationships paired with display names.
    let pFactionRels: any[] = [];
    let pCfr = char.charFactionRelationships || {};
    for (let pFid of Object.keys(pCfr)) {
        let pFdef = (cfg.factions || []).find(function(x: any) { return x.id === pFid; });
        pFactionRels.push({ id: pFid, name: pFdef ? pFdef.name : pFid, value: pCfr[pFid] });
    }

    let pPos = (char as any).position || ({} as CharPosition);
    let pCp = char.chatPersona || {};

    return {
        id: char.id,
        name: char.name,
        isProtagonist: !!char.isProtagonist,
        hasLoreEntry: !!char.lorebookEntryId,
        conceptDump: char.conceptDump || '',
        nicknames: char.nicknames || [],
        species: char.species || '',
        age: char.age || '',
        gender: char.gender || '',
        occupationRole: char.occupationRole || '',
        briefDescription: char.briefDescription || '',
        physicalDescription: char.physicalDescription || '',
        personalityCore: char.personalityCore || '',
        voiceAndMannerisms: char.voiceAndMannerisms || '',
        background: char.background || '',
        coreValues: char.coreValues || [],
        // [v2.120.0 IMG-FIELDS] Visual identity + avatar generation settings. Exported so
        // the Profile's Images drill can render them; the bridge's own Visuals tab reads
        // the record directly and is unaffected by their presence here.
        visuals: char.visuals || '',
        uc: char.uc || '',
        sceneVisuals: char.sceneVisuals || '',
        avatarVisuals: char.avatarVisuals || '',
        avatarWidth: char.avatarWidth || 1024,
        avatarHeight: char.avatarHeight || 1024,
        avatarSeed: char.avatarSeed || 0,
        customFields: pCustom,
        sheet: [], // Retired legacy character sheet attribute slots
        // [v2.92.0 POSITION] The tier is deliberately NOT exported. It is volatile evidence
        // about one story path, it lives in historyStorage so Undo owns it, and carrying it
        // into another story would import a conclusion without the beats that earned it.
        position: {
            targetId: pPos.targetId || '',
            targetName: pPos.targetName || '',
            shape: pPos.shape || '',
            standing: pPos.standing || ''
        },
        factionRelationships: pFactionRels,
        // [v2.98.0 PATTERN-STORED] Always the RESOLVED id (stored if valid, else the legacy
        // scan) -- the bridge's inspection picker shows and edits this one value and does
        // not need to know which source it came from. Picking a value here, even on a
        // legacy record that had never explicitly chosen one, is what makes the picker's
        // first write on such a record a genuine confirm-or-change rather than a blind
        // guess with nothing to compare against.
        pattern: _ceResolveCharPattern(char),
        uiShape: _ceResolveShape(char, cfg),
        hooks: (char.hooks || []).filter(function(h: any) { return !h.resolved; }),
        charResources: (char.charResourceDefs || []).map(function(def: any) {
            return { id: def.id, tag: def.tag, name: def.name, type: def.type,
                value: (char.charResourceValues || {})[def.id] || 0,
                hasBounds: !!def.hasBounds, min: def.min, max: def.max, states: def.states || [] };
        }),
        flags: {
            charContextEnabled: !!char.charContextEnabled,
            autoThoughtsEnabled: !!char.autoThoughtsEnabled,
            hooksEnabled: !!char.hooksEnabled,
            followCamera: !!(char as any).followCamera
        },
        // [v2.100.0 PERSONA-BRIDGE, per user] chatPersona exported so the bridge profile tab
        // can show and edit the same four axes buildChatPersonaSection already offers in the
        // engine-native character-edit modal. `enabled` is the RESOLVED state, matching that
        // function’s own `on` expression exactly (record absent OR enabled===false reads as
        // off). The bridge deliberately cannot tell "never configured" from "switched off",
        // because applyCharFieldValue creates the object with the same defaults on the first
        // write either way -- there is no third state for it to render.
        //
        // `preview` is buildCharChatPersonaClause’s real return value, the exact string that
        // reaches the model, NOT a re-description of it. Same call the context builder makes,
        // so the bridge readout cannot drift from what is actually sent.
        chatPersona: {
            enabled: !!char.chatPersona && (char.chatPersona.enabled !== false),
            style: pCp.style || 'auto',
            verbosity: pCp.verbosity || 'auto',
            emoji: pCp.emoji || 'auto',
            notes: pCp.notes || '',
            preview: buildCharChatPersonaClause(char)
        },
        // The option LISTS ship across rather than being mirrored bridge-side as literals.
        // A mirrored copy is a flag-day pair that must be edited in two files forever and
        // breaks silently when only one is updated (CC_POV_INTERVIEW already costs exactly
        // that). Shipping them means adding an option to any of the three arrays above makes
        // it appear in BOTH UIs with no bridge change at all. Only id+label travel: `clause`
        // and the verbosity `tokens` cap are model-facing, and the bridge has no business
        // rendering or reasoning about either.
        chatPersonaOpts: {
            style:     CHARCHAT_STYLE_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; }),
            verbosity: CHARCHAT_VERBOSITY_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; }),
            emoji:     CHARCHAT_EMOJI_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; })
        },
        regenerableFields: REGENERABLE_CHAR_FIELDS
    };
}

// [v2.79.0 STUDIO-COMMIT-ATOMIC] Shared field-key router, extracted out of AE_SAVE_CHAR_FIELD
// so AE_STUDIO_COMMIT can apply a whole batch of fields in ONE load->mutate->save cycle
// instead of duplicating this routing logic a second time. Two call sites reading the same
// list here is the whole point -- see the CE-INDEX note on why the old commit flow raced.
// fieldKey routing: direct string fields | coreValues | nicknames | pattern | position.<sub> |
// chatPersona.<sub> | custom.<id> | sheet.<cat>.<fld> | flag.<name>. Returns false for an
// unrecognized key so callers can log it.
function applyCharFieldValue(char: any, key: string, value: any): boolean {
    // [v2.120.0 IMG-FIELDS] The four visual-tag fields join the direct list. They are
    // plain strings on the record already (declared since the bridge roster was retired)
    // and have simply never had an engine-side editor -- the bridge's Visuals tab was the
    // only way to reach them. Nothing about the write path is new.
    const CFV_DIRECT: string[] = ['name','conceptDump','species','age','gender','occupationRole','briefDescription','physicalDescription','personalityCore','voiceAndMannerisms','background','visuals','uc','sceneVisuals','avatarVisuals'];
    // [v2.120.0 IMG-FIELDS] The three numeric avatar-generation settings. Kept OUT of
    // CFV_DIRECT because that branch stringifies, and width/height/seed must stay numbers:
    // the bridge feeds them straight into buildRequestBody's settings object, where a
    // string silently produces a bad request rather than an error. A blank or unparseable
    // value reads as 0, which is already this record's "unset" for seed and is corrected
    // to a default by makeDefaultCharacter's own guards for the dimensions.
    const CFV_NUM: string[] = ['avatarWidth','avatarHeight','avatarSeed'];
    if (CFV_DIRECT.indexOf(key) >= 0) {
        char[key] = String(value === undefined || value === null ? '' : value);
        return true;
    } else if (CFV_NUM.indexOf(key) >= 0) {
        var cfvN = parseInt(String(value === undefined || value === null ? '' : value).replace(/[^0-9-]/g, ''), 10);
        (char as any)[key] = isNaN(cfvN) ? 0 : Math.max(0, cfvN);
        return true;
    } else if (key === 'pattern') {
        // [v2.98.0 PATTERN-STORED] Validated against the same whitelist
        // _ceResolveCharPattern trusts -- an invalid or unknown id is stored as '' (not
        // silently coerced to some other value and not rejected outright), which is
        // "no pattern chosen", the same state a character in progress is already in.
        const pStr = String(value || '');
        (char as any).pattern = (CE_PATTERN_IDS.indexOf(pStr) >= 0) ? pStr : '';
        return true;
    } else if (key === 'uiShape') {
        // [v2.109.0 PROFILE-SHAPE] Same whitelist discipline as `pattern`: an unknown
        // value stores as '' ("never chosen"), which falls through to _ceResolveShape's
        // scan rather than pinning the surface to a shape nothing can render.
        const cfvShape = String(value || '');
        (char as any).uiShape = (cfvShape === 'studio' || cfvShape === 'classic') ? cfvShape : '';
        return true;
    } else if (key === 'coreValues') {
        if (Array.isArray(value)) char.coreValues = value.map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        else char.coreValues = String(value || '').split(';').map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        return true;
    } else if (key === 'nicknames') {
        if (Array.isArray(value)) char.nicknames = value.map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        else char.nicknames = String(value || '').split(',').map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        return true;
    } else if (key.indexOf('position.') === 0) {
        // [v2.95.0 STUDIO-2] Position routed through the SAME helper as every other field
        // rather than getting a message pair of its own. Both AE_SAVE_CHAR_FIELD and
        // AE_STUDIO_COMMIT already funnel through here, so one route gives the Studio and
        // the Profile tab Position editing at once and keeps the "exactly one write path"
        // property intact -- a second path would have been a second place for the lorebook
        // sync and roster refresh to be forgotten.
        //
        // Unknown sub-keys are REJECTED (return false) rather than written. char.position is
        // a fixed four-field record, not a bag: silently accepting 'position.wharever' would
        // store a field nothing reads and that no migration knows to clean up.
        const cfvPosKey = key.slice(9);
        if (['targetId', 'targetName', 'shape', 'standing'].indexOf(cfvPosKey) < 0) return false;
        if (!char.position) char.position = { targetId: '', targetName: '', shape: '', standing: '' };
        char.position[cfvPosKey] = String(value === undefined || value === null ? '' : value);
        return true;
    } else if (key.indexOf('chatPersona.') === 0) {
        // [v2.100.0 PERSONA-BRIDGE] Same shape, and the same reasoning, as the position.*
        // branch above: ONE write path shared by AE_SAVE_CHAR_FIELD and AE_STUDIO_COMMIT,
        // and unknown sub-keys REJECTED rather than stored. chatPersona is a fixed record,
        // not a bag -- accepting 'chatPersona.whatever' would store a field nothing reads
        // and no migration knows to clean up.
        //
        // The object is created with the SAME defaults buildChatPersonaSection’s toggle uses
        // (engine ~19021). If those two default sets are ever allowed to diverge, a persona
        // first enabled from the bridge and one first enabled from the engine modal would
        // behave differently with nothing on screen to explain why. Change them together.
        //
        // The three enum axes are validated through _charchatOpt -- the engine’s OWN
        // resolver, not a copied whitelist that could fall out of step with the arrays.
        // It returns opts[0] on a miss, and opts[0].id is 'auto' in all three lists, so an
        // unrecognised id degrades to "let the rubric decide". That direction matters: a bad
        // id stored RAW would still resolve to opts[0] at read time, but would do it silently
        // on every single turn forever, and the stored record would keep lying about it.
        const cfvCpKey = key.slice(12);
        if (['enabled', 'style', 'verbosity', 'emoji', 'notes'].indexOf(cfvCpKey) < 0) return false;
        if (!char.chatPersona) char.chatPersona = { enabled: true, style: 'auto', verbosity: 'auto', emoji: 'auto' };
        if (cfvCpKey === 'enabled') { char.chatPersona.enabled = !!value; return true; }
        if (cfvCpKey === 'notes') { char.chatPersona.notes = String(value === undefined || value === null ? '' : value); return true; }
        const cfvCpOpts: CharChatOpt[] = cfvCpKey === 'style' ? CHARCHAT_STYLE_OPTS
            : (cfvCpKey === 'verbosity' ? CHARCHAT_VERBOSITY_OPTS : CHARCHAT_EMOJI_OPTS);
        char.chatPersona[cfvCpKey] = _charchatOpt(cfvCpOpts, String(value || 'auto')).id;
        return true;
    } else if (key.indexOf('custom.') === 0) {
        let cfvCfId = key.slice(7);
        if (!char.customFieldValues) char.customFieldValues = {};
        char.customFieldValues[cfvCfId] = String(value === undefined ? '' : value);
        return true;
    } else if (key.indexOf('sheet.') === 0) {
        let cfvRef = key.slice(6);
        let cfvParts = cfvRef.split('.');
        if (cfvParts.length === 2) {
            let cfvDot = cfvParts[0] + '.' + cfvParts[1];
            let cfvUnd = cfvParts[0] + '_' + cfvParts[1];
            if (!char.sheetValues) char.sheetValues = {};
            char.sheetValues[cfvDot] = String(value === undefined ? '' : value);
            char.sheetValues[cfvUnd] = char.sheetValues[cfvDot];
            return true;
        }
        return false;
    } else if (key.indexOf('flag.') === 0) {
        let cfvFlag = key.slice(5);
        let cfvBool = !!value;
        if (cfvFlag === 'charContextEnabled') char.charContextEnabled = cfvBool;
        else if (cfvFlag === 'autoThoughtsEnabled') char.autoThoughtsEnabled = cfvBool;
        else if (cfvFlag === 'hooksEnabled') char.hooksEnabled = cfvBool;
        else if (cfvFlag === 'followCamera') char.followCamera = cfvBool; // [v2.89.0 FOLLOW-CAM]
        else return false;
        return true;
    }
    return false;
}

async function handleBridgeMessage(msg: any): Promise<void> {
    try {
        const payload: any = (msg.data && msg.data.payload) ? msg.data.payload : (msg.data || {});
        const event: string = payload.event;

        switch (event) {

            case EVT_HANDSHAKE_ACK:
                // [CHANGE] On ACK: push char data first (bridge needs it for image gen lookups),
                //          then scene state (needs char data for compressedLine/socialMask),
                //          then AE_IMG_FIELDS_SYNC (bridge needs the field library + defaults
                //          for the Image Studio widget and avatar generation quality).
                isBridgeReady = true;
                aeLog('[AE:bridge] Bridge handshake confirmed.');
                api.v1.ui.toast('🔗 Bridge connected!', { type: 'success', autoClose: 2000 });
                await broadcastCharacterData();
                await broadcastSceneState();
                try {
                    // [v2.178.0 CHAT-LANE] A bridge that just connected has no bubble tokens and
                // is painting from its own literal fallbacks. Sent on every handshake for the
                // same reason the field library is: a reload is the common case, not an edge.
                try { await broadcastChatBubbleStyle(); }
                catch (eCbs) { aeLog('[AE:chatstyle] handshake token push failed:', eCbs); }
                await broadcastToTM('AE_IMG_FIELDS_SYNC', {
                        fields: imagePromptFields,
                        defaults: { width: globalSettings.defaultWidth, height: globalSettings.defaultHeight, scale: globalSettings.defaultScale, steps: globalSettings.defaultSteps }
                    });
                } catch (_) {}
                try { await broadcastJournal(); } catch (_) {}   // [v1.7.0 JOURNAL] populate HUD journal on connect
                // [v2.56.1] Story ID sync — previously only sent from the dead
                // EVT_CHAR_SYNC_PUSH handler, so activeStoryId was always empty
                // and the image gallery could never scope by story.
                try {
                    const hsStoryId = await api.v1.story.id();
                    await broadcastToTM(EVT_STORY_ID_SYNC, { storyId: hsStoryId });
                } catch (_) {}
                // [CE-STRIP v2.0.x] broadcastHolding() removed — Holding cut.
                break;

            case EVT_PING:
                await broadcastToTM(EVT_PONG, {});
                aeLog('[AE:bridge] Bridge PING → PONG.');
                break;

            case EVT_CHAR_SYNC_PUSH:
                // Legacy path: bridge pushes character configs (e.g., on reconnect from old bridge version).
                // In the merged system the engine is source of truth, but we accept the push to update
                // the cache in case bridge has newer emotion-portrait data we don't have.
                if (Array.isArray(payload.configs)) {
                    // Merge bridge configs into cachedCharVisuals without overwriting engine fields.
                    // Only update fields that the bridge is authoritative for: none in the merged system.
                    // This case is essentially a no-op for new bridges; kept for backward compatibility.
                    aeLog('[AE:bridge] EVT_CHAR_SYNC_PUSH received (', payload.configs.length, 'entries) — legacy path, no-op in merged system.');
                }
                // Still reply with story ID so bridge can key chat history correctly.
                try {
                    const syncStoryId = await api.v1.story.id();
                    await broadcastToTM(EVT_STORY_ID_SYNC, { storyId: syncStoryId });
                } catch (_) {}
                break;

            // [CE-STRIP v2.0.0] EVT_RUN_ACTION_INSTANCE / RUN_QUICK_INSTANCE removed —
            // both always hit "not found" now that actionInstances/actionTemplates are gone.

            // [CE-STRIP v2.0.x] AE_SET_SILENT removed — Silent Mode cut with Action Modal.
            case EVT_AUTOSNAP: {
                // [WP-img] Bridge ⚙️ "Auto-Snap" button → story-driven scene image.
                try { await executeAutoSnap(); } catch (e) { aeLog('[AE:bridge] EVT_AUTOSNAP error:', e); }
                break;
            }
            case EVT_AUTOSNAP_PROMPT: {
                // [v0.9.8.0] Image Studio auto-snap: architect pass over the recent story,
                // result returned to the bridge to fill the composer. payload: { paragraphs }
                try {
                    let asPara = (payload && typeof payload.paragraphs === 'number' && payload.paragraphs > 0) ? Math.floor(payload.paragraphs) : (globalSettings.contextSize || DEFAULT_CTX);
                    if (asPara !== globalSettings.contextSize) { globalSettings.contextSize = asPara; await saveImageSettings(); }
                    let asBuilt = await buildArchitectPromptFromStory(asPara);
                    if (asBuilt) {
                        await broadcastToTM('AUTO_SNAP_PROMPT_RESULT', { prompt: asBuilt.prompt, charNames: asBuilt.matchedChars.map(function(c) { return c.name; }) });
                    } else {
                        await broadcastToTM('AUTO_SNAP_PROMPT_RESULT', { error: 'Could not build a prompt from the recent story.' });
                    }
                } catch (e) { aeLog('[AE:bridge] EVT_AUTOSNAP_PROMPT error:', e); await broadcastToTM('AUTO_SNAP_PROMPT_RESULT', { error: 'Auto-snap failed.' }); }
                break;
            }
            case EVT_DIRECTOR_SUBMIT: {
                // [NEW] Bridge submitted a Director's Cut image.
                // payload: { prompt, uc, chars: [{ name, visuals }], enhance?: boolean }
                // If payload.enhance === true: run architect pass and respond with EVT_DIRECTOR_ENHANCE_RESULT.
                // Otherwise: generate and broadcast EVT_GENERATE_IMAGE via submitDirectorPhoto.
                try {
                    if (payload.enhance) {
                        const enhanced = await enhanceDirectorPrompt(payload.prompt || '', payload.chars || []);
                        if (enhanced) {
                            await broadcastToTM('DIRECTOR_ENHANCE_RESULT', {
                                enhancedPrompt: enhanced.enhancedPrompt,
                                charVisuals:    enhanced.charVisuals
                            });
                        } else {
                            await broadcastToTM('DIRECTOR_ENHANCE_RESULT', { error: 'Enhancement failed.' });
                        }
                    } else {
                        await submitDirectorPhoto(payload.prompt || '', payload.uc || '', payload.chars || []);
                    }
                } catch (e) { aeLog('[AE:bridge] EVT_DIRECTOR_SUBMIT error:', e); }
                break;
            }

            case EVT_REQ_SCENE_STATE:
                // [NEW] Bridge requests an immediate scene state push (e.g., on reconnect or HUD open).
                await broadcastSceneState();
                break;

            case EVT_REQ_CHAR_DATA:
                // [NEW] Bridge requests an immediate character data push (e.g., on reconnect).
                await broadcastCharacterData();
                // [v2.51.8 CHARCHAT-SETTINGS-DETACHED-DOM companion, per user] The bridge also
                // sends this on every Chat launcher open (see _buildCharChatLauncher). Its
                // settings header now renders immediately off whatever _charChatState it has
                // cached (bridge v2.39.0 fix) -- but on a cold session that cache can still be
                // empty/stale, showing Thoughts/Photos as "off" even if enabled in config.
                // Broadcasting charchat state here too means a freshly-opened launcher gets
                // authoritative freshThoughts/images/lastThought within one round-trip, same as
                // the roster does, rather than waiting on some unrelated chat action to trigger
                // AE_CHARCHAT_STATE first. Safe pre-chat: broadcastCharChatState() already
                // handles _aeCharChat.active === false (empty turns/thought, config-only images/
                // freshThoughts).
                await broadcastCharChatState();
                break;

            case 'AE_GEN_SNAPSHOT_TEXT': {
                // [v027] Generate the GLM appearance snapshot for a character and
                // store it under STORAGE_CHAR_SNAP_PFX. Result broadcast to bridge.
                try {
                    let stCharId = payload.charId;
                    let stChar = stCharId ? await loadCharacter(stCharId) : null;
                    if (!stChar) { aeLog('[AE:bridge] AE_GEN_SNAPSHOT_TEXT: char not found'); break; }
                    let stEntId = (stChar as any).entityId || null;
                    let stEnt = stEntId ? await loadEntity(stEntId) : null;
                    if (!stEnt) { api.v1.ui.toast('No scene context for snapshot.', { type: 'warning' }); break; }
                    let stCfg = await loadConfig();
                    let stText = await generateCharacterSnapshot(stChar, stEnt, stCfg);
                    if (stText) {
                        await api.v1.storyStorage.set(STORAGE_CHAR_SNAP_PFX + stCharId, stText);
                        await broadcastToTM('SNAPSHOT_TEXT_RESULT', { charId: stCharId, text: stText });
                    } else {
                        await broadcastToTM('SNAPSHOT_TEXT_RESULT', { charId: stCharId, error: 'Snapshot generation failed.' });
                    }
                } catch (snapTxtErr) { aeLog('[AE:bridge] AE_GEN_SNAPSHOT_TEXT error:', snapTxtErr); }
                break;
            }

            case 'AE_GEN_SNAPSHOT_IMAGE': {
                // [v027] Build an image from the stored snapshot text + character
                // visuals (+ optional location visuals) and broadcast EVT_GENERATE_IMAGE.
                try {
                    let siCharId = payload.charId;
                    if (!siCharId) { aeLog('[AE:bridge] AE_GEN_SNAPSHOT_IMAGE: no charId'); break; }
                    await assembleSnapshotImage(siCharId);
                } catch (snapImgErr) { aeLog('[AE:bridge] AE_GEN_SNAPSHOT_IMAGE error:', snapImgErr); }
                break;
            }

            case 'AE_OPEN_CHAR_EDIT': {
                // [v2.160.0 SWEEP] openCharEditModal is deleted with the native sidebar.
                // The bridge's request is honoured by the surface that replaced it: the
                // jsx Profile. The loadCharacter() round trip stays as the existence
                // check -- opening the shell on a charId that no longer resolves would
                // render an empty Profile with no way to tell the author why.
                try {
                    const ceCharId = payload.charId;
                    if (ceCharId) {
                        const ceChar = await loadCharacter(ceCharId);
                        if (ceChar) await ceOpenShell('profile', ceCharId);
                    }
                } catch (e) { aeLog('[AE:bridge] AE_OPEN_CHAR_EDIT error:', e); }
                break;
            }

            // [v2.160.0 SWEEP] AE_OPEN_ENTITY_EDIT handler removed. It had already been
            // gutted to a no-op (it read payload.entityId into an unused const and did
            // nothing with it); the jsx Entity surface is reached through ceOpenShell.

            case 'AE_OPEN_WIZARD': {
                // [v2.160.0 SWEEP] Was openWizardModal (SECTION 23, deleted). Routes to
                // the jsx Wizard surface, which superseded it in v2.155.0.
                try { await ceOpenShell('wizard'); }
                catch (e) { aeLog('[AE:bridge] AE_OPEN_WIZARD error:', e); }
                break;
            }

            // [CE-STRIP v2.0.x] AE_OPEN_CALENDAR removed — Clock/Calendar cut.

            case 'AE_ADJUST_CHAR_RESOURCE': {
                // Bridge steppers in character focus view adjust a per-character resource.
                try {
                    const acCharId = payload.charId;
                    const acTag    = payload.tag;
                    const acDelta  = payload.delta;
                    if (acCharId && acTag && typeof acDelta === 'number') {
                        await adjustCharResource(acCharId, acTag, acDelta);
                        const acFresh = await loadCharacter(acCharId);
                        let acEnt = null;
                        if (acFresh && acFresh.entityId) acEnt = await loadEntity(acFresh.entityId);
                        const acDp = await buildEntityDetailPayload(acCharId, acFresh, acEnt);
                        await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', acDp);
                        await broadcastSceneState();
                    }
                } catch (e) { aeLog('[AE:bridge] AE_ADJUST_CHAR_RESOURCE error:', e); }
                break;
            }

            case 'AE_FETCH_ENTITY_DETAIL': {
                try {
                    const fId = payload.entityId || payload.charId;
                    if (fId) {
                        let char = await loadCharacter(fId);
                        let ent = null;
                        if (char) {
                            if (char.entityId) ent = await loadEntity(char.entityId);
                        } else {
                            ent = await loadEntity(fId);
                            if (ent && ent.type === 'character') {
                                const idx = await loadIndex();
                                const match = idx.find(m => m.entityId === ent.id);
                                if (match) char = await loadCharacter(match.id);
                            }
                        }

                        if (char || ent) {
                            const detailPayload = await buildEntityDetailPayload(fId, char, ent);
                            await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', detailPayload);
                        } else {
                            await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', { id: fId, error: 'Not found' });
                        }
                    }
                } catch (e) { aeLog('[AE:bridge] AE_FETCH_ENTITY_DETAIL error:', e); }
                break;
            }

            case 'AE_SET_PRESSURE': {
                // [v2.87.0 PRESSURE-MANUAL] Testing control. The escalation ladder is the
                // core bet of the whole design (wants to -> is looking for a way to -> is
                // going to — now), but reaching tier 4 organically needs four consecutive
                // 'blocked' classifications, which can take a dozen story generations to
                // stage deliberately. This writes the tier directly so the framing change
                // can be verified in one turn.
                //
                // Deliberately NOT gated behind a diag flag: it writes the same
                // historyStorage key the integrator uses, through the same clamp, so an
                // author bumping their own character's tier is doing something the system
                // already supports — it is a manual override, not a debug backdoor. Undo
                // reverts it exactly like an earned tier, since it lives in the same store.
                try {
                    const spId = String(payload.charId || '');
                    if (!spId) break;
                    const spChar = await loadCharacter(spId);
                    // [v2.101.0 PRESSURE-CONSOLIDATE] 'position' joins 'pursuit' and 'hook'
                    // as a settable axis. It is the odd one out because its storage key is
                    // per-TARGET ('position_<targetId>', so a character carries one tier per
                    // relationship rather than one flat number), which is why the key is
                    // resolved here off the record instead of being sent by the bridge: the
                    // bridge would have to guess which target is current, and a wrong guess
                    // writes a real tier onto the wrong relationship. An UNRESOLVED position
                    // (prose but no targetId \u2014 see buildEntityDetailPayload) has no axis at
                    // all and is refused rather than silently written to 'position_'.
                    let spAxis = 'pursuit';
                    if (payload.axis === 'hook') {
                        spAxis = 'hook';
                    } else if (payload.axis === 'position') {
                        const spPos: any = spChar ? (spChar as any).position : null;
                        const spTid = spPos ? String(spPos.targetId || '') : '';
                        if (!spTid) { aeLog('[AE:bridge] AE_SET_PRESSURE: position axis has no resolved target \u2014 ignored.'); break; }
                        spAxis = 'position_' + spTid;
                    }
                    // [v2.89.1 PRESSURE-BIDIR-FIX] This clamp is a SECOND copy of the
                    // integrator's bounds and was missed when the floor went signed in
                    // v2.89.0 — it still pinned at 0, so the manual override silently could
                    // not write the negative half of a bidirectional axis, which is exactly
                    // the half that needs staging (four consecutive 'advanced' beats). Now
                    // derives the floor the same way every other clamp does. _ceAxisFloor
                    // keys off the literal 'hook' string, so a 'position_<id>' axis picks up
                    // the signed -4 floor with no extra case here.
                    const spTier = Math.max(_ceAxisFloor(spAxis), Math.min(4, Number(payload.tier) || 0));
                    await api.v1.historyStorage.set(_cePressureKey(spId, spAxis), spTier);
                    if (spChar) {
                        let spEnt = null;
                        if (spChar.entityId) spEnt = await loadEntity(spChar.entityId);
                        const spPayload = await buildEntityDetailPayload(spId, spChar, spEnt);
                        await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', spPayload);
                    }
                } catch (eSp) { aeLog('[AE:bridge] AE_SET_PRESSURE error:', eSp); }
                break;
            }

            case 'AE_RESOLVE_HOOK': {
                // [v0.9.9.7] Delegated to resolveCharHook() (shared with native char inspect).
                await resolveCharHook(payload.charId, payload.hookId, payload.hookIndex);
                break;
            }

            case 'AE_EQUIP_ITEM': {
                // [v0.9.9.7] Delegated to setItemEquip() (shared with native item rows).
                await setItemEquip(payload.charId, payload.itemId, true);
                break;
            }

            case 'AE_UNEQUIP_ITEM': {
                // [v0.9.9.7] Delegated to setItemEquip() (shared with native item rows).
                await setItemEquip(payload.charId, payload.itemId, false);
                break;
            }

            case 'AE_CHAR_CONDITION_ACTION': {
                // [v2.15.0 BRIDGE-CONDITIONS] Bridge Drama tray add/change conditions.
                // Same activeConditions mutation as buildConditionsRows (the native
                // Character Edit modal's Conditions section, now on the Overview tab,
                // CE-STRIP v2.6.0 PASS 10 / v2.17.0 CHAREDIT-TABS):
                // toggle adds/removes the whole entry (unchecking clears rather than
                // resetting to stage 0); setStage only applies to defs with stages and
                // is clamped to their bounds.
                try {
                    const ccCharId = payload.charId;
                    const ccDefId  = payload.defId;
                    const ccOp     = payload.op;
                    if (ccCharId && ccDefId && ccOp) {
                        const ccChar = await loadCharacter(ccCharId);
                        if (ccChar) {
                            if (!ccChar.activeConditions) ccChar.activeConditions = [];
                            if (ccOp === 'toggle') {
                                const ccExists = ccChar.activeConditions.some((s: any) => s.defId === ccDefId);
                                if (ccExists) {
                                    ccChar.activeConditions = ccChar.activeConditions.filter((s: any) => s.defId !== ccDefId);
                                } else {
                                    ccChar.activeConditions.push({ defId: ccDefId, stageIndex: 0 });
                                }
                            } else if (ccOp === 'setStage' && typeof payload.stageIndex === 'number') {
                                const ccCfg = await loadConfig();
                                const ccDef = (ccCfg.conditions || []).find((d: any) => d.id === ccDefId);
                                const ccState = ccChar.activeConditions.find((s: any) => s.defId === ccDefId);
                                if (ccState && ccDef) {
                                    const ccMaxIdx = Math.max(0, (ccDef.stages || []).length - 1);
                                    ccState.stageIndex = Math.max(0, Math.min(ccMaxIdx, payload.stageIndex));
                                }
                            }
                            await saveCharacter(ccChar);
                            let ccEnt = null;
                            if (ccChar.entityId) ccEnt = await loadEntity(ccChar.entityId);
                            const ccDp = await buildEntityDetailPayload(ccCharId, ccChar, ccEnt);
                            await broadcastToTM('AE_ENTITY_DETAIL_RESPONSE', ccDp);
                        }
                    }
                } catch (e) { aeLog('[AE:bridge] AE_CHAR_CONDITION_ACTION error:', e); }
                break;
            }

            // [CE-STRIP vNEXT] AE_PROMOTE_MINOR_NPC handler removed — promoteMinorNpc()
            // no longer exists (minor-NPC tier retired, nothing left to promote to).
            // Bridge still emits this message from its minor-NPC bubble's "Promote to
            // Major" button (Section 6b / _makeEntityBubbleMinor) — now a silent no-op
            // here until the bridge pass removes that button too.

            case 'AE_SET_CHAR_PRESENT': {
                try { if (payload && payload.charId) await aeSetCharScenePresent(payload.charId, !!payload.present); }
                catch (eEx) { aeLog('[AE:bridge] AE_SET_CHAR_PRESENT error:', eEx); }
                break;
            }

            case 'AE_MOVE_CHAR_TO_SCENE': {
                try { if (payload && payload.charId) await aeMoveCharToScene(payload.charId); }
                catch (eMv) { aeLog('[AE:bridge] AE_MOVE_CHAR_TO_SCENE error:', eMv); }
                break;
            }

            case 'AE_REFRESH_PRESENCE': {
                try { await aeRefreshPresence(); }
                catch (eRf) { aeLog('[AE:bridge] AE_REFRESH_PRESENCE error:', eRf); }
                break;
            }

            case 'AE_HUD_GEN_ENTITY': {
                // [v1.15.0] Bridge "Add NPC/Item" popup: generate a scene-fitting draft
                // (name + brief/desc) WITHOUT spawning; echo it back to prefill the popup.
                // [CE-STRIP v2.1.6] archetype/template lookup removed — Bestiary/Item
                // Templates cut. Always generates freeform now.
                try {
                    const geKind = (payload && payload.kind === 'item') ? 'item' : 'npc';
                    if (geKind === 'item') {
                        const geRes = await generateSceneItem();
                        await broadcastToTM('AE_HUD_GEN_RESULT', { kind: 'item', ok: !!geRes, name: geRes ? geRes.name : '', brief: geRes ? geRes.desc : '' });
                    } else {
                        const geRes = await generateSceneNpc();
                        await broadcastToTM('AE_HUD_GEN_RESULT', { kind: 'npc', ok: !!geRes, name: geRes ? geRes.name : '', brief: geRes ? geRes.brief : '' });
                    }
                } catch (eGe) {
                    aeLog('[AE:bridge] AE_HUD_GEN_ENTITY error:', eGe);
                    try { await broadcastToTM('AE_HUD_GEN_RESULT', { kind: (payload && payload.kind) || 'npc', ok: false, name: '', brief: '' }); } catch (eGe2) {}
                }
                break;
            }

            case 'AE_HUD_SPAWN_ENTITY': {
                // [v1.15.0] Bridge "Add NPC/Item" Create: spawn from typed fields at the
                // inspected location. spawn* queues a fresh scene broadcast, so every open
                // HUD refreshes on its own.
                // [CE-STRIP v2.1.6] archetype/template lookup removed — Bestiary/Item
                // Templates cut. Always spawns freeform now.
                try {
                    const seKind = (payload && payload.kind === 'item') ? 'item' : 'npc';
                    const seName = (payload && payload.name) ? String(payload.name).trim() : '';
                    const seBrief = (payload && payload.brief) ? String(payload.brief).trim() : '';
                    const seLoc = (payload && payload.locId) ? String(payload.locId) : null;
                    if (seKind === 'item') {
                        if (seName) await spawnItem(seName, seBrief, false, seLoc || '__room__');
                    } else {
                        if (seName) await spawnSceneNpc(seName, seBrief, seLoc, false);
                    }
                } catch (eSe) {
                    aeLog('[AE:bridge] AE_HUD_SPAWN_ENTITY error:', eSe);
                }
                break;
            }

            case 'AE_HUD_GEN_LOCATION': {
                // [v1.18.0 LOCGEN] Bridge Map-tab "New Location" popup: generate a
                // scene-fitting draft (name + desc + lore) WITHOUT creating anything;
                // echo it back to prefill the popup.
                //
                // >>> PAIRED with AE_HUD_GEN_ENTITY directly above: same round-trip shape,
                // >>> genuinely different payload (relation + suggestion in, 3 fields out,
                // >>> no archetype). Touch one, look at the other.
                try {
                    let glRelIn = (payload && payload.relation === 'child') ? 'child' : 'sibling';
                    let glRefIn = (payload && payload.refLocId) ? String(payload.refLocId) : null;
                    let glSugIn = (payload && payload.suggestion) ? String(payload.suggestion) : '';
                    let glResOut = await generateSceneLocation(glRelIn, glRefIn, glSugIn);
                    await broadcastToTM('AE_HUD_GEN_LOCATION_RESULT', {
                        ok: !!glResOut,
                        relation: glRelIn,
                        name: glResOut ? glResOut.name : '',
                        description: glResOut ? glResOut.description : '',
                        lore: glResOut ? glResOut.lore : ''
                    });
                } catch (eGl) {
                    aeLog('[AE:bridge] AE_HUD_GEN_LOCATION error:', eGl);
                    try { await broadcastToTM('AE_HUD_GEN_LOCATION_RESULT', { ok: false, relation: (payload && payload.relation === 'child') ? 'child' : 'sibling', name: '', description: '', lore: '' }); } catch (eGl2) {}
                }
                break;
            }

            case 'AE_HUD_SPAWN_LOCATION': {
                // [v1.18.0 LOCGEN] Bridge Map-tab "New Location" Create. spawnLocation
                // queues a fresh scene broadcast, so every open HUD map repaints itself
                // and the new sibling/child node appears without an explicit refresh.
                // >>> PAIRED with AE_HUD_SPAWN_ENTITY directly above.
                try {
                    let slNameIn = (payload && payload.name) ? String(payload.name).trim() : '';
                    let slDescIn = (payload && payload.description) ? String(payload.description).trim() : '';
                    let slLoreIn = (payload && payload.lore) ? String(payload.lore).trim() : '';
                    let slRelIn = (payload && payload.relation === 'child') ? 'child' : 'sibling';
                    let slRefIn = (payload && payload.refLocId) ? String(payload.refLocId) : null;
                    if (slNameIn) await spawnLocation(slNameIn, slDescIn, slLoreIn, slRelIn, slRefIn, false);
                } catch (eSl) {
                    aeLog('[AE:bridge] AE_HUD_SPAWN_LOCATION error:', eSl);
                }
                break;
            }

            // [CE-STRIP v2.0.0] AE_TRACK_NARRATIVE removed — quest-tracker cut.

            case 'AE_SET_DEFAULT_BG_URL': {
                // [v0.9.40] Bridge Theme Forge sets module-level scene default background.
                // Saves to GlobalConfig so it persists with the story and flows back
                // through the next buildSceneStatePayload broadcast to all open bridges.
                try {
                    let bgCfg = await loadConfig();
                    (bgCfg as any).defaultBackgroundUrl = (payload.url || '').trim();
                    await saveConfig(bgCfg);
                    await broadcastSceneState();
                    api.v1.ui.toast(
                        (bgCfg as any).defaultBackgroundUrl
                            ? '✓ Scene background URL saved.'
                            : '✓ Scene background cleared.',
                        { type: 'success', autoClose: 2000 }
                    );
                } catch (e) { api.v1.error('[AE] AE_SET_DEFAULT_BG_URL error:', e); }
                break;
            }

            case EVT_IMPORT_WORLD: {
                // [v0.9.39] Bridge-delivered adventure module (Try-the-Demo button).
                // Same importPayload() funnel as file import, then seed/refresh exactly
                // like the new-story prompt callbacks.
                try {
                    let iwModule = payload.module || payload.data || null;
                    if (!iwModule) { api.v1.ui.toast('Demo payload was empty.', { type: 'warning', autoClose: 2500 }); break; }
                    let iwResult = await importPayload(iwModule);
                    let iwParts: string[] = [];
                    if (iwResult.charCount > 0)   iwParts.push(iwResult.charCount + ' character' + (iwResult.charCount !== 1 ? 's' : ''));
                    if (iwResult.entityCount > 0) iwParts.push(iwResult.entityCount + ' node' + (iwResult.entityCount !== 1 ? 's' : ''));
                    await ensureProtagonistExists();
                    queueSceneStateBroadcast();
                    api.v1.ui.toast('Demo loaded: ' + (iwParts.length ? iwParts.join(', ') : 'world') + '.', { type: 'success', autoClose: 3000 });
                } catch (e) {
                    api.v1.error('[AE:bridge] AE_IMPORT_WORLD error:', e);
                    api.v1.ui.toast('Demo import failed.', { type: 'error', autoClose: 2500 });
                }
                break;
            }

            case EVT_DEMO_FAILED: {
                // Bridge could not fetch the module (offline / URL down). Seed a fresh
                // story so the player is never stranded on an empty fresh story.
                try {
                    await ensureProtagonistExists();
                    queueSceneStateBroadcast();
                } catch (e) { api.v1.error('[AE:bridge] AE_DEMO_FAILED fallback error:', e); }
                api.v1.ui.toast('Demo unavailable — started a fresh story instead.', { type: 'warning', autoClose: 3500 });
                break;
            }

            // [CE-STRIP v2.0.0] AE_TOGGLE_FOLLOW / AE_TRAVEL_REQUEST / AE_VEHICLE_TRAVEL_REQUEST
            // removed — Travel cut. AE_SILENT_TELEPORT (below) is the remaining way to
            // reposition the player — direct, no path-finding, no cost.

            case 'REQUEST_NODE_GRAPH': {
                // Bridge map Inspect button — returns the adjacency graph of any entity.
                // [CE-STRIP v2.0.0] awareness/adjacency only — no travel-cost annotations.
                try {
                    const ngId  = payload.entityId;
                    if (!ngId) break;
                    const ngEnt = await loadEntity(ngId);
                    if (!ngEnt) break;
                    const ngAll = await loadEntityIndex();

                    const ngChildren: any[] = [];
                    for (const ngCM of ngAll.filter(function(m) { return m.parentId === ngId && m.type === 'location'; })) {
                        const ngHasGC = ngAll.some(function(m) { return m.parentId === ngCM.id && m.type === 'location'; });
                        ngChildren.push({
                            id: ngCM.id, name: ngCM.name, type: ngCM.type, icon: ngCM.icon || undefined,
                            hasChildren: ngHasGC
                        });
                    }

                    const ngConns: any[] = [];
                    for (const ngC of (ngEnt.connectedEntityIds || [])) {
                        const ngCM2 = ngAll.find(function(m) { return m.id === ngC.targetId; });
                        ngConns.push({
                            id: ngC.targetId,
                            name:   ngCM2 ? ngCM2.name : ngC.targetId,
                            label:  (ngC as any).label   || '',
                            oneWay: (ngC as any).oneWay  || false,
                            icon:   ngCM2 ? ngCM2.icon || undefined : undefined
                        });
                    }

                    // [v0.9.89] Lateral siblings for Orbital HUD
                    const ngSiblings: any[] = [];
                    for (const sibMeta of ngAll) {
                        if (sibMeta.type !== 'location' || sibMeta.id === ngId) continue;
                        if (sibMeta.parentId !== ngEnt.parentId) continue;
                        ngSiblings.push({
                            id: sibMeta.id, name: sibMeta.name, type: sibMeta.type,
                            icon: sibMeta.icon || undefined
                        });
                    }

                    // [FIX Bug3] Added currentIcon + parentIcon to node graph response.
                    const ngGraph: any = {
                        currentName:      ngEnt.name,
                        currentType:      ngEnt.type,
                        currentIcon:      (ngEnt as any).icon      || undefined,
                        parentId: ngEnt.parentId || null, parentName: '', parentType: '', parentIcon: undefined,
                        children: ngChildren, connections: ngConns, siblings: ngSiblings
                    };
                    if (ngEnt.parentId) {
                        const ngPm = ngAll.find(function(m) { return m.id === ngEnt.parentId; });
                        if (ngPm) { ngGraph.parentName = ngPm.name; ngGraph.parentType = ngPm.type; ngGraph.parentIcon = ngPm.icon || undefined; }
                    }
                    await broadcastToTM('AE_NODE_GRAPH_RESPONSE', { entityId: ngId, graph: ngGraph });
                } catch (e) { aeLog('[AE:bridge] REQUEST_NODE_GRAPH error:', e); }
                break;
            }

            case 'AE_SILENT_TELEPORT': {
                // Bridge 📍 Teleport button — same action as the native Map's Teleport
                // button. [CE-STRIP vNEXT] Delegates to commitTravel(id, true) instead of
                // duplicating camera/body-move/presence logic inline — that duplication
                // was also protagonist-gated (silently did nothing without one); one fix
                // in commitTravel now covers both entry points.
                try {
                    const tpTargetId = payload.targetId;
                    if (!tpTargetId) break;
                    const tpTgtEnt = await loadEntity(tpTargetId);
                    if (!tpTgtEnt) break;
                    await commitTravel(tpTargetId, true);
                    api.v1.ui.toast('📍 Teleported to ' + tpTgtEnt.name, { type: 'info', autoClose: 2000 });
                } catch (e) { aeLog('[AE:bridge] AE_SILENT_TELEPORT error:', e); }
                break;
            }

            case 'AE_DELETE_CHAR': {
                // [v1.9.1] Bridge "Kill Character" — routes through the SAME confirm+delete
                // path the native character cards and the character edit modal use
                // (confirmDeleteChar -> deleteCharacter), so it scrubs the entity body and
                // fires the portrait cascade instead of leaving an orphaned body behind.
                // The confirm modal is shown engine-side; nothing is deleted until the
                // author confirms. Falls back to the old index-only removal only if the
                // character record can't be loaded (true orphan with no name).
                try {
                    const dcId = payload.charId;
                    if (!dcId) break;
                    const dcChar = await loadCharacter(dcId);
                    if (dcChar) {
                        await confirmDeleteChar(dcId, dcChar.name || 'this character');
                    } else {
                        const dcIdx = await loadIndex();
                        await saveIndex(dcIdx.filter(function(m) { return m.id !== dcId; }));
                        await api.v1.storyStorage.remove(STORAGE_CHAR_PFX + dcId);
                        api.v1.ui.toast('Orphan character removed from index.', { type: 'info', autoClose: 2000 });
                        await broadcastCharacterData();
                        await broadcastSceneState();
                    }
                } catch (e) { aeLog('[AE:bridge] AE_DELETE_CHAR error:', e); }
                break;
            }

            case 'AE_SAVE_CHAR_VISUALS': {
                // Bridge gallery saved visual overrides for a character. Merges into CharacterRecord.
                try {
                    const scvId = payload.charId; if (!scvId) break;
                    const scvChar = await loadCharacter(scvId); if (!scvChar) break;
                    if (payload.visuals       !== undefined) scvChar.visuals       = payload.visuals;
                    if (payload.uc            !== undefined) scvChar.uc            = payload.uc;
                    if (payload.avatarVisuals !== undefined) scvChar.avatarVisuals = payload.avatarVisuals;
                    if (payload.avatarWidth   !== undefined) scvChar.avatarWidth   = payload.avatarWidth;
                    if (payload.avatarHeight  !== undefined) scvChar.avatarHeight  = payload.avatarHeight;
                    if (payload.avatarSeed    !== undefined) scvChar.avatarSeed    = payload.avatarSeed;
                    await saveCharacter(scvChar);
                    api.v1.ui.toast('\u2713 Visuals saved \u2014 ' + scvChar.name, { type: 'success', autoClose: 1500 });
                } catch (e) { aeLog('[AE:bridge] AE_SAVE_CHAR_VISUALS error:', e); }
                break;
            }

            case 'AE_FETCH_CHAR_PROFILE': {
                // Bridge opened a character's combined HUD profile. Build and push the
                // full editable record (same CharacterRecord the native editor reads).
                try {
                    const fcpId = payload.charId; if (!fcpId) break;
                    const fcpChar = await loadCharacter(fcpId);
                    if (!fcpChar) { await broadcastToTM(EVT_CHAR_PROFILE, { id: fcpId, error: 'Not found' }); break; }
                    const fcpCfg = await loadConfig();
                    const fcpOut = await buildCharProfilePayload(fcpChar, fcpCfg);
                    await broadcastToTM(EVT_CHAR_PROFILE, fcpOut);
                } catch (e) { aeLog('[AE:bridge] AE_FETCH_CHAR_PROFILE error:', e); }
                break;
            }

            case 'AE_SAVE_CHAR_FIELD': {
                // Bridge wrote one field in the HUD profile. Merge into the record, keep the
                // linked lorebook entry in sync, then push a fresh profile + coalesced roster
                // refresh so every surface reflects the change. fieldKey routing:
                //   direct string fields | coreValues | nicknames | custom.<id> | sheet.<cat>.<fld> | flag.<name>
                try {
                    const scfId = payload.charId;
                    const scfKey: string = payload.fieldKey || '';
                    if (!scfId || !scfKey) break;
                    let scfChar = await loadCharacter(scfId); if (!scfChar) break;
                    const scfVal = payload.value;
                    // [v2.79.0 STUDIO-COMMIT-ATOMIC] Routing now lives in the shared
                    // applyCharFieldValue helper (also used by AE_STUDIO_COMMIT) rather than
                    // inline here -- see that helper's comment for why.
                    const scfHandled = applyCharFieldValue(scfChar, scfKey, scfVal);
                    if (!scfHandled) { aeLog('[AE:bridge] AE_SAVE_CHAR_FIELD unknown key: ' + scfKey); break; }
                    await saveCharacter(scfChar);
                    try { await syncLorebookEntry(scfChar.id, true); } catch (eScfLb) { /* non-fatal: lore sync best-effort */ }
                    const scfCfg = await loadConfig();
                    const scfOut = await buildCharProfilePayload(scfChar, scfCfg);
                    await broadcastToTM(EVT_CHAR_PROFILE, scfOut);
                    queueCharacterDataBroadcast();
                } catch (e) { aeLog('[AE:bridge] AE_SAVE_CHAR_FIELD error:', e); }
                break;
            }

            case 'AE_GET_FACET_DEFS': {
                // [v2.78.0 FACETS] Serve the facet library from config, NOT from BUILTIN_FACETS
                // directly. migrateConfig seeds the built-ins in but never overwrites an
                // author's edits, so config is the only place that reflects what they will
                // actually get. Reading the constant here would show them the stock text and
                // then generate with their edited version.
                try {
                    const fdCfg = await loadConfig();
                    // [v2.81.0 SLOT-DEFS] Slots share this library but are NOT facets: they are
                    // card-driven and (Resistance/Conduct) pattern-gated, so offering them in the
                    // "+ Add facet" picker would let an author add a second, pattern-mismatched
                    // copy of a slot they already have. Pre-v2.81 facets carry no `kind` and so
                    // pass this filter unchanged.
                    const fdDefs = (fdCfg.customStaticFields || []).filter(function(f: any) { return f && f.kind !== 'slot'; }).map(function(f: any) {
                        return { id: f.id, slot: f.slot || '', label: f.label || f.id, placeholder: f.placeholder || '' };
                    });
                    // [DIAG v2.79.0 FACET-DIAG] Temporary -- localizes whether migrateConfig's
                    // seeding actually lands at runtime (expect 27+) vs. the bridge/dispatch
                    // side. Remove once the facets-not-showing bug is confirmed fixed.
                    aeLog('[AE:diag] AE_GET_FACET_DEFS: customStaticFields=' + (fdCfg.customStaticFields || []).length + ' fdDefs=' + fdDefs.length);
                    await broadcastToTM(EVT_FACET_DEFS, { defs: fdDefs });
                } catch (e) { aeLog('[AE:bridge] AE_GET_FACET_DEFS error:', e); }
                break;
            }

            case 'AE_STUDIO_CREATE': {
                // [v2.76.0 STUDIO] Spawn a draft the Studio can hang generation off. quiet=true
                // so an unfinished character never announces itself into the scene — the
                // author has not decided they exist yet.
                try {
                    const scLoc = payload.locId ? String(payload.locId) : null;
                    const scRes = await spawnSceneNpc(String(payload.name || 'New Character'), String(payload.brief || ''), scLoc, true);
                    if (!scRes || !scRes.id) {
                        await broadcastToTM(EVT_STUDIO_CREATED, { ok: false });
                        break;
                    }
                    const scChar = await loadCharacter(scRes.id);
                    if (scChar) {
                        // Timestamp, not a boolean: the sweep needs an age to judge, and a
                        // draft abandoned two minutes ago must not be binned out from under a
                        // author who is still in another tab.
                        (scChar as any).studioDraft = Date.now();
                        await saveCharacter(scChar);
                    }
                    await broadcastToTM(EVT_STUDIO_CREATED, { ok: true, charId: scRes.id, name: scRes.name });
                } catch (e) {
                    aeLog('[AE:bridge] AE_STUDIO_CREATE error:', e);
                    try { await broadcastToTM(EVT_STUDIO_CREATED, { ok: false }); } catch (e2) {}
                }
                break;
            }

            case 'AE_STUDIO_COMMIT': {
                // [v2.76.0 STUDIO] Promote a draft to a real character: clear the draft mark
                // so the sweep can never touch it again, then sync the lorebook entry.
                // [v2.79.0 STUDIO-COMMIT-ATOMIC] payload.fields now carries every Studio field
                // value (identity + facets), applied in THIS SAME load->mutate->save cycle.
                // Previously the bridge fired a batch of separate AE_SAVE_CHAR_FIELD messages
                // immediately followed by this commit -- each of those did its OWN independent
                // load->mutate->save on the same record with no ordering guarantee against this
                // handler's cycle, so whichever finished last won and the rest were silently
                // lost. species/age/gender/occupationRole/briefDescription -- never part of
                // AE_STUDIO_CREATE's payload, only ever written via that batch -- were exactly
                // the fields that consistently disappeared. Bundling into one message and one
                // cycle removes the race structurally instead of guessing at NAI's inbound
                // message delivery/ordering, which script-types.txt does not document.
                try {
                    const smId = payload.charId; if (!smId) break;
                    const smChar = await loadCharacter(smId); if (!smChar) break;
                    const smFields = payload.fields || {};
                    for (const smKey of Object.keys(smFields)) {
                        applyCharFieldValue(smChar, smKey, smFields[smKey]);
                    }
                    delete (smChar as any).studioDraft;
                    await saveCharacter(smChar);
                    // [v2.79.0 STUDIO-LOREBOOK-CREATE, per user: "lorebooks should be created
                    // and synced at commit like when a regular character creation happens"]
                    // syncLorebookEntry is a no-op without an existing lorebookEntryId, and
                    // Studio drafts never had one (spawnSceneNpc doesn't create one either --
                    // see the CE-INDEX open item this replaces). The native roster's own
                    // "Character" add button calls createLinkedLorebookEntry at creation time
                    // under the CE Characters category; this mirrors that precedent, running
                    // AFTER the field bundle above is saved so the entry's content actually
                    // reflects species/age/gender/etc. rather than an empty shell.
                    if (smChar.lorebookEntryId) {
                        await syncLorebookEntry(smId, true);
                    } else {
                        await createLinkedLorebookEntry(smId, true);
                    }
                    api.v1.ui.toast((smChar.name || 'Character') + ' created.', { type: 'success', autoClose: 1800 });
                    await broadcastToTM(EVT_STUDIO_CREATED, { ok: true, charId: smId, name: smChar.name, committed: true });
                } catch (e) { aeLog('[AE:bridge] AE_STUDIO_COMMIT error:', e); }
                break;
            }

            case 'AE_SYNC_CHAR_LOREBOOK': {
                // [v2.79.0 LOREBOOK-MANUAL-SYNC, per user request] Manual control for the
                // bridge Profile tab's "Sync lorebook" / "Create lorebook entry" button.
                // Same create-if-missing-else-sync split as AE_STUDIO_COMMIT above, callable
                // any time so a character that ended up without a permanent entry (Quick Add,
                // pre-fix Studio drafts, a manually unlinked entry) can be given one on demand,
                // and an existing one can be refreshed after edits made elsewhere. Re-broadcasts
                // the profile afterward so hasLoreEntry updates in the UI without a manual reload.
                try {
                    const slcId = payload.charId; if (!slcId) break;
                    const slcChar = await loadCharacter(slcId); if (!slcChar) break;
                    if (slcChar.lorebookEntryId) {
                        await syncLorebookEntry(slcId, false);
                    } else {
                        await createLinkedLorebookEntry(slcId, false);
                    }
                    const slcCfg = await loadConfig();
                    const slcFresh = await loadCharacter(slcId);
                    if (slcFresh) {
                        const slcOut = await buildCharProfilePayload(slcFresh, slcCfg);
                        await broadcastToTM(EVT_CHAR_PROFILE, slcOut);
                    }
                    queueCharacterDataBroadcast();
                } catch (e) { aeLog('[AE:bridge] AE_SYNC_CHAR_LOREBOOK error:', e); }
                break;
            }

            case 'AE_STUDIO_DISCARD': {
                // [v2.76.0 STUDIO] Bin an abandoned draft with NO confirm prompt — the author
                // already said cancel, and AE_DELETE_CHAR's engine-side modal would be a
                // second question they never asked for.
                // GUARDED: only deletes while studioDraft is still set. Once committed that
                // mark is gone, so a stale or replayed discard cannot destroy a real
                // character. This guard is the whole reason discard is a separate message
                // rather than a flag on the existing delete.
                try {
                    const sdId = payload.charId; if (!sdId) break;
                    const sdChar = await loadCharacter(sdId);
                    if (!sdChar) break;
                    if (!(sdChar as any).studioDraft) {
                        aeLog('[AE:bridge] AE_STUDIO_DISCARD refused, not a draft: ' + sdId);
                        break;
                    }
                    await deleteCharacter(sdId);
                } catch (e) { aeLog('[AE:bridge] AE_STUDIO_DISCARD error:', e); }
                break;
            }

            case 'AE_GET_BUDGET': {
                // [v2.75.0 BUDGET-POLL] On-demand allowance reading. Exists because the
                // replenishment rule is not documented precisely enough to advise on: the
                // API says only that tokens refill while the user "has interacted with the
                // script recently" and never defines interaction, and advancing the story
                // was observed NOT to reset it. So the HUD stopped asserting a mechanism
                // and offers a re-check instead. Cheap: reads counters, generates nothing.
                try {
                    await broadcastToTM(EVT_BUDGET, { budget: aeBudgetReport(Number(payload.need) || 0) });
                } catch (e) { aeLog('[AE:bridge] AE_GET_BUDGET error:', e); }
                break;
            }

            case 'AE_GEN_SLOT_OPTIONS': {
                // [v2.72.0 SLOT-OPTIONS] Return N candidate values for ONE field. Resolves the
                // field's instructions from cfg.customStaticFields first (slot/facet defs live
                // there) and falls back to STATIC_FIELD_DEFS for the four core narrative fields,
                // so the same message serves both. Writes nothing — the bridge picks, then saves
                // through AE_SAVE_CHAR_FIELD like any other edit.
                try {
                    const gsoId = payload.charId;
                    const gsoKey: string = payload.fieldKey || '';
                    // [v2.97.0 SLOT-SILENT-BREAK] The two remaining silent exits. A missing
                    // id/key means the REQUEST was malformed and there is no fieldKey to
                    // address a reply to, so silence is unavoidable there -- but a missing
                    // CHARACTER is addressable and must answer, or the bridge hangs on it the
                    // same way it hung on the two cases above.
                    if (!gsoId || !gsoKey) break;
                    const gsoChar = await loadCharacter(gsoId);
                    if (!gsoChar) {
                        await broadcastToTM(EVT_SLOT_OPTIONS, {
                            charId: gsoId, fieldKey: gsoKey, label: gsoKey, options: [],
                            ok: false, reason: 'nochar',
                            detail: 'That character record could not be loaded, so there was nothing to generate against.',
                            budget: aeBudgetReport(0), freeRuns: await _ceFreeRunsReport()
                        });
                        break;
                    }
                    const gsoCfg = await loadConfig();

                    let gsoLabel = '';
                    let gsoInst  = '';
                    let gsoBudget = 150;
                    const gsoCustom = (gsoCfg.customStaticFields || []).find(function(f: any) { return f && f.id === gsoKey; });
                    if (gsoCustom) {
                        gsoLabel  = gsoCustom.label || gsoKey;
                        gsoInst   = gsoCustom.instructions || '';
                        gsoBudget = (gsoCfg.fieldBudgets && gsoCfg.fieldBudgets[gsoKey]) || 150;
                    } else {
                        const gsoDef = STATIC_FIELD_DEFS.find(function(d: any) { return d.key === gsoKey; });
                        if (!gsoDef) {
                            // [v2.97.0 SLOT-SILENT-BREAK] This used to `break` after an aeLog
                            // and send NOTHING. The bridge keeps _slotOptPending/_slotOptBusy
                            // keyed on the request and clears them only when a reply arrives,
                            // so an unanswered request left that field permanently busy: the
                            // button stayed on 'Generating...', every later click on it was
                            // swallowed by the busy guard, and there was no error anywhere.
                            // Reported from the Studio as "no output, no errors".
                            //
                            // STATIC_FIELD_DEFS holds exactly three keys
                            // (physicalDescription / personalityCore / voiceAndMannerisms), so
                            // any other non-custom field -- 'background' among them -- lands
                            // here. Every exit from this handler now answers.
                            aeLog('[AE:bridge] AE_GEN_SLOT_OPTIONS unknown field: ' + gsoKey);
                            await broadcastToTM(EVT_SLOT_OPTIONS, {
                                charId: gsoId, fieldKey: gsoKey, label: gsoKey, options: [],
                                ok: false, reason: 'nofield',
                                detail: 'No generation instructions exist for "' + gsoKey + '". It is neither a custom slot/facet nor one of the three core narrative fields, so there is nothing to generate from.',
                                budget: aeBudgetReport(0), freeRuns: await _ceFreeRunsReport()
                            });
                            break;
                        }
                        gsoLabel  = (gsoCfg.fieldLabels && gsoCfg.fieldLabels[gsoKey]) || gsoDef.label;
                        gsoInst   = (gsoCfg.fieldInstructions && gsoCfg.fieldInstructions[gsoKey]) || gsoDef.defaultInstructions;
                        gsoBudget = (gsoCfg.fieldBudgets && gsoCfg.fieldBudgets[gsoKey]) || gsoDef.defaultBudget;
                    }
                    if (!gsoInst.trim()) {
                        // [v2.97.0 SLOT-SILENT-BREAK] Same repair as above. A field that exists
                        // but carries empty instructions is an author-fixable condition (Config
                        // -> the field's instructions), which is worth saying out loud rather
                        // than swallowing.
                        aeLog('[AE:bridge] AE_GEN_SLOT_OPTIONS no instructions for: ' + gsoKey);
                        await broadcastToTM(EVT_SLOT_OPTIONS, {
                            charId: gsoId, fieldKey: gsoKey, label: gsoLabel || gsoKey, options: [],
                            ok: false, reason: 'noinstructions',
                            detail: 'The field "' + (gsoLabel || gsoKey) + '" has no generation instructions set, so there is nothing to generate from. Add instructions for it in Config.',
                            budget: aeBudgetReport(0), freeRuns: await _ceFreeRunsReport()
                        });
                        break;
                    }

                    // [v2.93.0 SLOT-YOINK-TEST] Server-side enforced, not trusted from the
                    // bridge: yoink mode is always exactly one candidate (see
                    // generateSlotOptions), so the pre-flight budget estimate below must be
                    // sized for one, not for whatever count the bridge's UI happened to have
                    // showing when the toggle was flipped.
                    // [v2.94.0 SLOT-YOINK-AUTO] 'auto' is passed straight through and
                    // resolved inside generateSlotOptions against the live run counter.
                    // gsoCount is sized for the PESSIMISTIC case (auto counts as direct)
                    // so the pre-flight never green-lights a request that a resolve-to-
                    // direct would then be too poor to afford. Over-reserving is a refused
                    // click; under-reserving is a truncated generation that looks like a
                    // model failure, and those are not equally bad.
                    const gsoMethod: 'direct' | 'yoink' | 'auto' =
                        (payload.method === 'yoink') ? 'yoink' : (payload.method === 'auto' ? 'auto' : 'direct');
                    const gsoCount = (gsoMethod === 'yoink') ? 1 : Math.max(2, Math.min(5, Number(payload.count) || 3));

                    // [v2.74.0 GEN-BUDGET] Pre-flight. generateSlotOptions asks for
                    // (budget + 30) * count + 40 output tokens; if the allowance cannot cover
                    // that, fail HERE with a reason rather than firing a call that comes back
                    // empty and looks like a model failure. A budget refusal and a bad
                    // generation need different advice, so they must not share a message.
                    const gsoNeed = (gsoBudget + 30) * gsoCount + 40;
                    const gsoBud = aeBudgetReport(gsoNeed);
                    if (gsoBud.out >= 0 && gsoBud.out < gsoNeed) {
                        api.v1.ui.toast('Not enough generation budget for ' + gsoLabel + (gsoMethod === 'direct' ? '' : ' (' + gsoMethod + ')') + '.', { id: 'ce-slotopts', type: 'warning', autoClose: 2500 });
                        await broadcastToTM(EVT_SLOT_OPTIONS, {
                            charId: gsoId, fieldKey: gsoKey, label: gsoLabel, options: [],
                            ok: false, reason: 'budget', budget: gsoBud,
                            freeRuns: await _ceFreeRunsReport()   // [v2.96.0 UNIT-C]
                        });
                        break;
                    }

                    api.v1.ui.toast(
                        (gsoMethod === 'direct' ? 'Generating ' : 'Generating (' + gsoMethod + ') ')
                            + gsoCount + ' option' + (gsoCount === 1 ? '' : 's') + ' for ' + gsoLabel + '\u2026',
                        { id: 'ce-slotopts', type: 'info', autoClose: false }
                    );
                    const gsoOut = await generateSlotOptions(
                        gsoChar, gsoLabel, gsoInst, gsoCfg.generalStyle || '', payload.hint || '',
                        gsoBudget, gsoCount, payload.divergence || '',
                        { includeStory: !!payload.includeStory, method: gsoMethod }
                    );
                    if (!gsoOut || !gsoOut.length) {
                        // Budget was sufficient at pre-flight, so an empty return is the model
                        // or the transport, not the allowance — reported as 'empty' so the
                        // bridge can say "try again" instead of "wait".
                        api.v1.ui.toast('Option generation came back empty.', { id: 'ce-slotopts', type: 'error', autoClose: 2000 });
                        await broadcastToTM(EVT_SLOT_OPTIONS, {
                            charId: gsoId, fieldKey: gsoKey, label: gsoLabel, options: [],
                            ok: false, reason: 'empty', budget: aeBudgetReport(0),
                            freeRuns: await _ceFreeRunsReport()   // [v2.96.0 UNIT-C]
                        });
                        break;
                    }
                    api.v1.ui.toast('Generated ' + gsoOut.length + '.', { id: 'ce-slotopts', type: 'success', autoClose: 1200 });
                    // Read AFTER the call, so the number reported is the state the next
                    // request will actually meet -- reading it before would be off by one
                    // for exactly the request the author is about to make.
                    await broadcastToTM(EVT_SLOT_OPTIONS, {
                        charId: gsoId, fieldKey: gsoKey, label: gsoLabel, options: gsoOut,
                        ok: true, budget: aeBudgetReport(0),
                        freeRuns: await _ceFreeRunsReport()   // [v2.96.0 UNIT-C]
                    });
                } catch (e) {
                    aeLog('[AE:bridge] AE_GEN_SLOT_OPTIONS error:', e);
                    // A throw reaches here having already passed pre-flight, so it is a real
                    // error, not an allowance problem. Report it as such and always release
                    // the bridge's busy state — a silent throw leaves the button spinning.
                    try {
                        // [v2.77.0 SLOT-BUSY] Classify before reporting. A concurrency
                        // rejection is not a failure the user can fix by retrying harder,
                        // and it is not a budget problem either — it needs its own advice,
                        // so it gets its own reason. The raw message always travels too:
                        // the first live report of this bug said only "try again later"
                        // because the detail never reached the surface.
                        const geMsg = String((e as any) && ((e as any).message || e) || '');
                        const geReason = geMsg.indexOf('already in progress') >= 0 ? 'busy' : 'error';
                        api.v1.ui.toast(geReason === 'busy'
                            ? 'Another generation is running \u2014 wait for it to finish.'
                            : 'Generation error.', { id: 'ce-slotopts', type: 'error', autoClose: 2600 });
                        await broadcastToTM(EVT_SLOT_OPTIONS, {
                            charId: payload.charId, fieldKey: payload.fieldKey || '', label: '',
                            options: [], ok: false, reason: geReason,
                            detail: geMsg, budget: aeBudgetReport(0),
                            freeRuns: await _ceFreeRunsReport()   // [v2.96.0 UNIT-C]
                        });
                    } catch (e2) { aeLog('[AE:bridge] AE_GEN_SLOT_OPTIONS error-report failed:', e2); }
                }
                break;
            }

            case 'AE_REGEN_CHAR_FIELD': {
                // Regenerate ONE narrative field from the concept dump (seed-and-go). Reuses
                // generateCharacterFields, applies only the requested key, pushes refreshed profile.
                try {
                    const rcfId = payload.charId;
                    const rcfKey: string = payload.fieldKey || '';
                    if (!rcfId || !rcfKey) break;
                    if (REGENERABLE_CHAR_FIELDS.indexOf(rcfKey) < 0) { aeLog('[AE:bridge] AE_REGEN_CHAR_FIELD non-regenerable key: ' + rcfKey); break; }
                    let rcfChar = await loadCharacter(rcfId); if (!rcfChar) break;
                    if (!(rcfChar.conceptDump || '').trim()) {
                        api.v1.ui.toast('No concept profile to regenerate from \u2014 add a concept dump first.', { type: 'warning', autoClose: 2500 });
                        break;
                    }
                    api.v1.ui.toast('Regenerating ' + rcfKey + ' for ' + rcfChar.name + '\u2026', { type: 'info', autoClose: 1500 });
                    // [v0.9.100] Per-field generation with optional hint for the four narrative
                    // fields (matches the native editor's auto-generate buttons via generateFieldContent).
                    // Other fields fall back to dump-only generateCharacterFields.
                    let rcfHint: string = (payload.hint || '').toString();
                    let rcfDef = STATIC_FIELD_DEFS.find(function(d: any) { return d.key === rcfKey; });
                    if (rcfDef) {
                        let rcfCfg = await loadConfig();
                        let rcfLabel = (rcfCfg.fieldLabels && rcfCfg.fieldLabels[rcfKey]) || rcfDef.label;
                        let rcfInst  = (rcfCfg.fieldInstructions && rcfCfg.fieldInstructions[rcfKey]) || rcfDef.defaultInstructions;
                        let rcfBudget = (rcfCfg.fieldBudgets && rcfCfg.fieldBudgets[rcfKey]) || rcfDef.defaultBudget;
                        let rcfVal = await generateFieldContent(rcfChar, rcfLabel, rcfInst, rcfCfg.generalStyle || '', rcfHint, rcfBudget);
                        if (rcfVal === null) { api.v1.ui.toast('Regeneration failed.', { type: 'error' }); break; }
                        (rcfChar as any)[rcfKey] = rcfVal;
                    } else {
                        let rcfFields = await generateCharacterFields(rcfChar.name, rcfChar.conceptDump || '');
                        if (!rcfFields) { api.v1.ui.toast('Regeneration failed.', { type: 'error' }); break; }
                        if (rcfKey === 'coreValues') rcfChar.coreValues = (rcfFields as any).coreValues || [];
                        else (rcfChar as any)[rcfKey] = (rcfFields as any)[rcfKey] || '';
                    }
                    await saveCharacter(rcfChar);
                    try { await syncLorebookEntry(rcfChar.id, true); } catch (eRcfLb) { /* non-fatal: lore sync best-effort */ }
                    const rcfCfg = await loadConfig();
                    const rcfOut = await buildCharProfilePayload(rcfChar, rcfCfg);
                    await broadcastToTM(EVT_CHAR_PROFILE, rcfOut);
                    queueCharacterDataBroadcast();
                } catch (e) { aeLog('[AE:bridge] AE_REGEN_CHAR_FIELD error:', e); }
                break;
            }

            case 'AE_WIZ_FETCH_STATE': {
                try { await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload()); }
                catch (e) { aeLog('[AE:bridge] AE_WIZ_FETCH_STATE error:', e); }
                break;
            }


            case 'AE_WIZLIVE_START': {
                // [v2.4.0 WIZLIVE] Open an in-document wizard chat. payload: { topicId? }
                try { await startLiveWizardChat(payload && payload.topicId ? String(payload.topicId) : ''); }
                catch (e) { aeLog('[AE:bridge] AE_WIZLIVE_START error:', e); }
                break;
            }

            case 'AE_WIZLIVE_END': {
                // [v2.4.0 WIZLIVE] Close it. payload: { action: 'save'|'discard' } ([v2.5.0] save -> CE Chats lorebook)
                try { await endLiveWizardChat(payload && payload.action ? String(payload.action) : 'save'); }
                catch (e) { aeLog('[AE:bridge] AE_WIZLIVE_END error:', e); }
                break;
            }

            case 'AE_WIZLIVE_FETCH': {
                // [v2.4.0 WIZLIVE] Bridge tab opened — echo current live-chat state.
                try { await broadcastWizLiveState(); }
                catch (e) { aeLog('[AE:bridge] AE_WIZLIVE_FETCH error:', e); }
                break;
            }

            // [v2.21.0 CHARCHAT; comment corrected v2.55.0] The bridge DOES drive these now:
            // the native Chat toolbar button remains a working entry point, but bridge v2.42.0's
            // chat-manager (a close button below the HUD toggle + summarize/delete controls)
            // sends AE_CHARCHAT_END and AE_CHARCHAT_SUMMARIZE. AE_CHARCHAT_START/_FETCH are
            // driven by the launcher. (The old "bridge does not send any of these yet / HUD
            // panel is P6" note was stale.)
            case 'AE_CHARCHAT_START': {
                // payload: { contactId, povId? }
                try { await startCharChat(payload && payload.contactId ? String(payload.contactId) : '', payload && payload.povId ? String(payload.povId) : ''); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_START error:', e); }
                break;
            }

            case 'AE_CHARCHAT_END': {
                // payload: { action: 'save'|'discard' }. Both ship (see EVT_CHARCHAT_END).
                // Default 'discard' guards a malformed payload — the destructive-but-recoverable
                // choice (the document is stripped either way; 'save' also banks the thread).
                try { await endCharChat(payload && payload.action ? String(payload.action) : 'discard'); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_END error:', e); }
                break;
            }

            case 'AE_CHARCHAT_SUMMARIZE': {
                // [v2.55.0 CHARCHAT-MANAGER] Bridge chat-manager "summarize" button. Same body
                // as the native Chat-button picker's 'summarize' branch: preview, then open the
                // engine's own editable summary modal. Keeps the chat open; nothing crosses back.
                // [v2.131.0 JSXCHAT-2] Repointed at the jsx summary screen (ceChatSummarize,
                // SECTION 33). Same generator (previewSummarizeCharChat) and same destination
                // (the contact's journal) as before -- the SURFACE is the only difference, and
                // it is the difference the bridge retirement needs. Consequence recorded, not
                // acted on: _charchatShowSummaryModal is now reachable ONLY from
                // openCharChatPicker, which TRAY-RETIRE already recorded as having zero
                // callers. Both are sweep candidates; neither is deleted here.
                try { await ceChatSummarize(); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_SUMMARIZE error:', e); }
                break;
            }

            case 'AE_CHARCHAT_FETCH': {
                try { await broadcastCharChatState(); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_FETCH error:', e); }
                break;
            }

            // [v2.51.5 CHARCHAT-THREADS] Bridge's Chat launcher asks for the saved-thread
            // roster (message counts per contact/POV pair). Thin wrapper over
            // listCharChatThreads via broadcastCharChatThreads — see the EVT_CHARCHAT_THREADS_*
            // constants. Bridge fetches this once per Chat-view open.
            case 'AE_CHARCHAT_THREADS_REQ': {
                try { await broadcastCharChatThreads(); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_THREADS_REQ error:', e); }
                break;
            }

            // [v2.32.0 CHARCHAT-HUD] ONE dispatcher for every chat verb, per the bridge's
            // own CE-INDEX convention ("add new verbs as new 'op' values, not new
            // sendToEngine event names, unless the payload shape genuinely differs") —
            // the same shape AE_JOURNAL_ACTION already uses.
            //   op:'stage'   { text }        [v2.33.0] append a POV turn and STOP — the
            //                                user's own tap on NAI's native Send is what
            //                                generates. This is what the bridge sends;
            //                                see CHARCHAT-NATIVE-SEND in the CE-INDEX.
            //   op:'send'    { text }        append a POV turn, then generate (native
            //                                path only — budget-capped from a postMessage)
            //   op:'nudge'   {}              generate with no new message
            //   op:'regen'   {}              drop the last contact turn, generate again
            //   op:'edit'    { ids, text }   rewrite a turn in place
            //   op:'remove'  { ids }         delete a turn
            case 'AE_CHARCHAT_ACTION': {
                try { await handleCharChatAction(payload || {}); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_ACTION error:', e); }
                break;
            }

            case 'AE_SET_PROJECT': {
                // [v0.9.7.0 SETUP] HUD Setup tab writes project name/genre/concept; echo fresh state.
                try {
                    await mutConfig(function(c) {
                        if (payload.name !== undefined)    c.projectName = String(payload.name);
                        if (payload.genre !== undefined)   c.projectGenre = String(payload.genre);
                        if (payload.concept !== undefined) c.projectConcept = String(payload.concept);
                    });
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_SET_PROJECT error:', e); }
                break;
            }

            case 'AE_WIZ_NEW_CHAT': {
                try {
                    const wncTopic = payload.topicId || (DEFAULT_WIZARD_TOPICS[0] ? DEFAULT_WIZARD_TOPICS[0].id : 'topic_concept');
                    const wncChat = await createWizardChat(wncTopic, payload.title || 'New Chat');
                    await api.v1.tempStorage.set(STORAGE_WIZ_ACTIVE_CHAT, wncChat.id);
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_NEW_CHAT error:', e); }
                break;
            }

            case 'AE_WIZ_SELECT_CHAT': {
                try {
                    if (payload.chatId) await api.v1.tempStorage.set(STORAGE_WIZ_ACTIVE_CHAT, payload.chatId);
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_SELECT_CHAT error:', e); }
                break;
            }

            case 'AE_WIZ_DELETE_CHAT': {
                try {
                    if (payload.chatId) {
                        await deleteWizardChat(payload.chatId);
                        delete _wizFrozenCtx[payload.chatId]; // [v1.2.0 WIZMODE] drop any frozen context for the deleted chat
                        let wdActive = await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_ACTIVE_CHAT, '') as string;
                        if (wdActive === payload.chatId) await api.v1.tempStorage.set(STORAGE_WIZ_ACTIVE_CHAT, '');
                    }
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_DELETE_CHAT error:', e); }
                break;
            }

            case 'AE_WIZ_RENAME_CHAT': {
                try {
                    if (payload.chatId && payload.title !== undefined) {
                        let wrChat = await loadWizardChat(payload.chatId);
                        if (wrChat) { wrChat.title = String(payload.title).slice(0, 80) || 'Untitled'; await saveWizardChat(wrChat); }
                    }
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_RENAME_CHAT error:', e); }
                break;
            }

            case 'AE_WIZ_SEND': {
                // Run one wizard chat turn (yoink generation, no budget cost). The turn
                // function persists both messages; we then push reply signal + fresh state.
                try {
                    const wsId = payload.chatId;
                    const wsText: string = payload.text || '';
                    if (!wsId) break;
                    let wsReply = await runWizardChatTurn(wsId, wsText);
                    await broadcastToTM(EVT_WIZ_REPLY, { chatId: wsId, ok: wsReply !== null, error: wsReply === null ? 'Generation failed' : '' });
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) {
                    aeLog('[AE:bridge] AE_WIZ_SEND error:', e);
                    try { await broadcastToTM(EVT_WIZ_REPLY, { chatId: payload.chatId, ok: false, error: 'Turn failed' }); } catch (eWs2) {}
                }
                break;
            }

            // [v2.66.0 DIAG-CMD] The surface-independent replacement for v2.65.0's
            // wizard-chat-only /log and /diag commands (see aeHandleDiagCommand's own
            // header comment for why that placement was wrong). No document write, no
            // generation, no budget cost — pure storage read/write plus a reply broadcast.
            case 'AE_DIAG_CMD': {
                try {
                    const dcRaw: string = String((payload && payload.cmd) || '').trim();
                    const dcLower = dcRaw.toLowerCase();
                    let dcOut = await aeHandleDiagCommand(dcRaw, dcLower);
                    if (dcOut === null) dcOut = 'Not a recognized command: "' + dcRaw + '". Try /ce status, /log list or /diag list.';
                    await broadcastToTM(EVT_DIAG_REPLY, { cmd: dcRaw, out: dcOut });
                } catch (eDc) {
                    aeLog('[AE:bridge] AE_DIAG_CMD error:', eDc);
                    try { await broadcastToTM(EVT_DIAG_REPLY, { cmd: (payload && payload.cmd) || '', out: 'Command failed \u2014 see engine console.' }); } catch (eDc2) {}
                }
                break;
            }

            case 'AE_WIZ_LIST_CONTEXT_SOURCES': {
                try { await broadcastToTM(EVT_WIZ_CONTEXT_SOURCES, await buildWizardSourcesPayload(payload.chatId || '')); }
                catch (e) { aeLog('[AE:bridge] AE_WIZ_LIST_CONTEXT_SOURCES error:', e); }
                break;
            }

            case 'AE_WIZ_SET_CHAT_CONTEXT': {
                // Persist a chat's context selection. characterIds resolve to their linked
                // lorebook entries (created lazily if missing), then merged into lorebookEntryIds
                // so buildWizardContext picks them up with no new context source.
                try {
                    const wscId = payload.chatId;
                    if (!wscId) break;
                    let wscChat = await loadWizardChat(wscId);
                    if (!wscChat) break;
                    wscChat.contextChatIds = Array.isArray(payload.contextChatIds) ? payload.contextChatIds : [];
                    wscChat.includeStory = !!payload.includeStory;
                    wscChat.lorebookEntryIds = Array.isArray(payload.lorebookEntryIds) ? payload.lorebookEntryIds : [];
                    wscChat.characterIds = Array.isArray(payload.characterIds) ? payload.characterIds : [];
                    await saveWizardChat(wscChat);
                    delete _wizFrozenCtx[wscId]; // [v1.2.0 WIZMODE] source selection changed — force a fresh context build next turn
                    await broadcastToTM(EVT_WIZ_CONTEXT_SOURCES, await buildWizardSourcesPayload(wscId));
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_SET_CHAT_CONTEXT error:', e); }
                break;
            }

            case 'AE_WIZ_EDIT_MSG': {
                try {
                    let wemChat = await loadWizardChat(payload.chatId);
                    let wemIdx = payload.index;
                    if (wemChat && wemChat.messages && wemIdx >= 0 && wemIdx < wemChat.messages.length && payload.content !== undefined) {
                        wemChat.messages[wemIdx].content = String(payload.content);
                        // [v1.23.0] notesCache keys on message COUNT, which an in-place edit
                        // does not change. Drop it so the next generation re-distills.
                        wemChat.notesCache = undefined;
                        await saveWizardChat(wemChat);
                    }
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_EDIT_MSG error:', e); }
                break;
            }

            case 'AE_WIZ_DELETE_MSG': {
                try {
                    let wdmChat = await loadWizardChat(payload.chatId);
                    let wdmIdx = payload.index;
                    if (wdmChat && wdmChat.messages && wdmIdx >= 0 && wdmIdx < wdmChat.messages.length) {
                        wdmChat.messages.splice(wdmIdx, 1);
                        await saveWizardChat(wdmChat);
                    }
                    await broadcastToTM(EVT_WIZ_STATE, await buildWizardStatePayload());
                } catch (e) { aeLog('[AE:bridge] AE_WIZ_DELETE_MSG error:', e); }
                break;
            }



            case 'AE_SYNC_LOREBOOK': {
                // [v0.9.7.6] Tab-level "Sync to Lorebook": create-or-update every entry
                // of one kind (species|factions|characters|locations). Reuses the engine's
                // existing per-item create/sync fns (silent), with one summary toast.
                try {
                    const slKind: string = payload.kind || '';
                    let slCreated = 0; let slSynced = 0; let slFailed = 0; let slSkipped = 0;
                    if (slKind === 'species') {
                        const slCfgSp = await loadConfig();
                        for (const sp of ((slCfgSp.species || []) as any[])) {
                            try {
                                if (sp.lorebookEntryId) { await syncSpeciesLorebookEntry(sp.id, true); slSynced++; }
                                else { await createLinkedSpeciesLorebookEntry(sp.id, true); slCreated++; }
                            } catch (eSp) { slFailed++; }
                        }
                    } else if (slKind === 'factions') {
                        const slCfgFa = await loadConfig();
                        for (const fa of ((slCfgFa.factions || []) as any[])) {
                            try {
                                if (fa.lorebookEntryId) { await syncFactionLorebookEntry(fa.id, true); slSynced++; }
                                else { await createLinkedFactionLorebookEntry(fa.id, true); slCreated++; }
                            } catch (eFa) { slFailed++; }
                        }
                    } else if (slKind === 'characters') {
                        const slIdx = await loadIndex();
                        for (const slCm of slIdx) {
                            try {
                                const slCh = await loadCharacter(slCm.id);
                                if (!slCh) { slSkipped++; continue; }
                                if (slCh.lorebookEntryId) { await syncLorebookEntry(slCm.id, true); slSynced++; }
                                else { await createLinkedLorebookEntry(slCm.id, true); slCreated++; }
                            } catch (eCh) { slFailed++; }
                        }
                    } else if (slKind === 'locations') {
                        const slEnts = await loadEntityIndex();
                        for (const slLm of slEnts) {
                            if ((slLm as any).type !== 'location') continue;
                            try {
                                const slLoc = await loadEntity(slLm.id);
                                if (!slLoc) { slSkipped++; continue; }
                                if ((slLoc as any).lorebookEntryId) { await syncEntityLorebookEntry(slLm.id, true); slSynced++; }
                                else if (((slLoc as any).lorebookText || '').trim()) { await createLinkedEntityLorebookEntry(slLm.id, true); slCreated++; }
                                else { slSkipped++; }
                            } catch (eLc) { slFailed++; }
                        }
                    } else {
                        api.v1.ui.toast('Unknown lorebook sync kind.', { type: 'error', autoClose: 2500 });
                        break;
                    }
                    let slMsg = 'Lorebook: ' + slCreated + ' created, ' + slSynced + ' updated';
                    if (slSkipped) slMsg += ', ' + slSkipped + ' skipped';
                    if (slFailed)  slMsg += ', ' + slFailed + ' failed';
                    slMsg += '.';
                    api.v1.ui.toast(slMsg, { type: slFailed ? 'warning' : 'success', autoClose: 3500 });
                    try { await broadcastToTM('AE_SYNC_LOREBOOK_RESULT', { kind: slKind, text: slMsg, ok: !slFailed }); } catch (eSLb) { aeLog('[AE:bridge] sync result broadcast failed'); }
                } catch (eSL) {
                    aeLog('[AE:bridge] AE_SYNC_LOREBOOK error:', eSL);
                    api.v1.ui.toast('Lorebook sync failed.', { type: 'error', autoClose: 3000 });
                }
                break;
            }






            // [v2.156.0 STORYIMG] The story-image card's Delete, bridge-side. Per user the
            // widget goes with the image -- unlike a chat photo, whose document tag is the
            // character's own line and outlives the picture. The bridge owns the bytes and
            // this side owns the anchor, so the delete has to cross once.
            case 'AE_STORY_IMG_DROP': {
                try { await ceStoryImgDrop(String((payload && payload.uuid) || '')); }
                catch (eSiD) { aeLog('[AE:storyimg] drop failed:', eSiD); }
                break;
            }

            case 'AE_GALLERY_INDEX_RESP':
                // [v2.136.0 CEGAL] The bridge's answer to AE_GALLERY_INDEX_REQ. Metadata
                // only, newest-first already (sorted bridge-side, where the ts field lives).
                await ceGalleryReceive(payload);
                break;

            // [v2.175.0 IMG-EDIT-SURFACE] The three legs of SECTION 35b that cross the
            // boundary. AE_IMG_EDIT_OPEN is the only one that ORIGINATES bridge-side: a
            // card corner in the story or the chat asks this file to open the surface,
            // because navigation is a value in ceUiStore and nothing over there can set it.
            case 'AE_IMG_EDIT_OPEN': {
                try { await ceImgEditOpen(String((payload && payload.uuid) || '')); }
                catch (eIeO) { api.v1.error('[AE:imgedit] open failed:', eIeO); }
                break;
            }

            case 'AE_IMG_META_RESP':
                ceImgEditReceive(payload);
                break;

            case 'AE_IMG_REGEN_DONE':
                ceImgEditRegenDone(payload);
                break;

            case 'AE_FETCH_GALLERY_LOCATIONS': {
                // [v0.9.94 LOCHIER] Enhanced payload: adds parentId, childCount, lorebookText,
                // icon so the bridge can build a true hierarchy navigator.
                try {
                    const listMeta = await loadEntityIndex();
                    const locations = [];
                    for (const m of listMeta) {
                        if (m.type === 'location') {
                            const rec = await loadEntity(m.id);
                            if (rec) {
                                locations.push({
                                    id: rec.id,
                                    name: rec.name,
                                    parentId: rec.parentId,
                                    description: rec.description || '',
                                    atmosphere: rec.atmosphere || '',
                                    locationVisuals: (rec as any).locationVisuals || '',
                                    lorebookText: rec.lorebookText || '',
                                    lorebookEntryId: rec.lorebookEntryId || '',
                                    icon: rec.icon || '',
                                    childCount: m.childCount || 0
                                });
                            }
                        }
                    }
                    await broadcastToTM('AE_GALLERY_LOCATIONS_RESPONSE', { locations: locations });
                } catch (e) { aeLog('[AE:bridge] AE_FETCH_GALLERY_LOCATIONS error:', e); }
                break;
            }

            case 'AE_SAVE_LOCATION_VISUALS': {
                // [v0.9.94 LOCHIER] Now accepts description + lorebookText from the HUD
                // location profile in addition to the existing visuals field.
                try {
                    const vlId = payload.locationId;
                    if (vlId) {
                        const vlRec = await loadEntity(vlId);
                        if (vlRec) {
                            if (payload.visuals     !== undefined) (vlRec as any).locationVisuals = payload.visuals;
                            if (payload.description !== undefined) vlRec.description = payload.description;
                            if (payload.lorebookText !== undefined) vlRec.lorebookText = payload.lorebookText;
                            await saveEntity(vlRec);
                            try {
                                // Re-sync the linked lorebook entry if one exists
                                if (vlRec.lorebookEntryId) {
                                    const vlEntry = await api.v1.lorebook.entry(vlRec.lorebookEntryId);
                                    if (vlEntry) {
                                        let vlText = vlRec.description || '';
                                        if (vlRec.lorebookText) vlText += '\n\n' + vlRec.lorebookText;
                                        vlEntry.text = vlText.trim();
                                        await api.v1.lorebook.updateEntry(vlRec.lorebookEntryId, vlEntry);
                                    }
                                }
                            } catch (eLocLb) { /* non-fatal: lorebook re-sync best-effort */ }
                            api.v1.ui.toast('\u2713 Location saved', { type: 'success', autoClose: 1500 });
                        }
                    }
                } catch (e) { aeLog('[AE:bridge] AE_SAVE_LOCATION_VISUALS error:', e); }
                break;
            }

            case 'AE_ASK_RESPONSE': {
                // [v0.9.23 X2] Bridge resolved an __ask__ picker; unblock the waiting Promise.
                try {
                    let askRes = _pendingBridgeResolves[payload.promptId];
                    if (askRes) { delete _pendingBridgeResolves[payload.promptId]; askRes(payload.value !== undefined ? payload.value : null); }
                } catch (e) { aeLog('[AE] AE_ASK_RESPONSE error:', e); }
                break;
            }

            case 'AE_TARGET_SELECTED': {
                // [v0.9.23 X1] Bridge resolved a target pick; unblock the waiting Promise.
                try {
                    let tgtRes = _pendingBridgeResolves[payload.promptId];
                    if (tgtRes) { delete _pendingBridgeResolves[payload.promptId]; tgtRes(payload.targetId || null); }
                } catch (e) { aeLog('[AE] AE_TARGET_SELECTED error:', e); }
                break;
            }

            case 'AE_SET_PLAYER_FLAVOR': {
                // [v0.9.22 E5] Bridge sends player flavor before firing an action.
                // Empty string clears any pending flavor.
                try {
                    let flavorTxt = String(payload.text || '').trim();
                    if (flavorTxt) {
                        await api.v1.tempStorage.set(STORAGE_PENDING_FLAVOR, flavorTxt).catch(function(_e: any) {});
                    } else {
                        await api.v1.tempStorage.remove(STORAGE_PENDING_FLAVOR).catch(function(_e: any) {});
                    }
                } catch (e) { aeLog('[AE:bridge] AE_SET_PLAYER_FLAVOR error:', e); }
                break;
            }

            case 'AE_SET_PLAYER_EMOTION': {
                try {
                    const activeEmo = payload.emotion || 'neutral';
                    await api.v1.tempStorage.set('ae_player_emotion', activeEmo);
                    aeLog('[AE:engine] Active player emotion tracked: ' + activeEmo);
                } catch (e) { aeLog('[AE:bridge] AE_SET_PLAYER_EMOTION error:', e); }
                break;
            }

            case 'AE_IMG_FIELD_ACTION': {
                // [v2.13.0 IMGFIELDS] Replaces AE_SAVE_PRESET / AE_SET_ACTIVE_PRESET.
                // Single op-based dispatcher for the click-to-add field library, mirroring
                // the journal's AE_*_ACTION convention. saveImageSettings() persists +
                // rebroadcasts AE_IMG_FIELDS_SYNC on every branch.
                // [v2.133.0 IMGPRESET-JSX] Body extracted to applyImgFieldOp (SECTION 9)
                // so this handler and the jsx Images surface share ONE rule set. Behaviour
                // here is byte-for-byte what it was; only the location changed.
                try {
                    if (!applyImgFieldOp(String(payload.op || ''), payload)) {
                        aeLog('[AE:bridge] AE_IMG_FIELD_ACTION unknown op:', String(payload.op || ''));
                    }
                    await saveImageSettings();
                    await cePublishImages();
                } catch (e) { aeLog('[AE:bridge] AE_IMG_FIELD_ACTION error:', e); }
                break;
            }


            case 'AE_PACK_TO_LOREBOOK': {
                // [v0.9.7.10] Pack full world config to a hidden lorebook entry for
                // scenario sharing. Also callable from the Worldbuilding menu buttons.
                try { await packConfigToLorebook(); }
                catch (ePkMsg) { aeLog('[AE:bridge] AE_PACK_TO_LOREBOOK error:', ePkMsg); }
                break;
            }

            // [CE-STRIP v2.0.x] AE_TIME_ADVANCE / AE_TIME_SET removed — Clock/Calendar cut.

            case 'AE_SET_NARRATIVE_DATE': {
                // [v0.9.9.2] Set/clear a narrative's absolute day target (drives the AN
                // countdown when that narrative is the tracked one). Null/empty clears it.
                try {
                    let sndId = payload.narrativeId || payload.entityId || '';
                    if (sndId) {
                        let sndEnt = await loadEntity(sndId);
                        if (sndEnt) {
                            if (payload.day === null || payload.day === undefined || payload.day === '') {
                                sndEnt.eventDayTarget = undefined;
                            } else {
                                sndEnt.eventDayTarget = Math.max(0, Math.floor(Number(payload.day) || 0));
                            }
                            await saveEntity(sndEnt);
                            await broadcastSceneState();
                            api.v1.ui.toast('Event date updated.', { type: 'success', autoClose: 1800 });
                        }
                    }
                } catch (e) { api.v1.error('[AE:bridge] AE_SET_NARRATIVE_DATE error:', e); }
                break;
            }

            // [v1.7.0 JOURNAL] Bridge → engine journal control. State mutations run the
            // same Section 10b verbs the native HUD uses, then rebroadcast AE_JOURNAL_STATE.
            case 'AE_JOURNAL_REQ': {
                await broadcastJournal();
                break;
            }

            case 'AE_JOURNAL_ACTION': {
                try {
                    const jOp = String(payload.op || '');
                    if (jOp === 'add')            await journalAddBubble(String(payload.text || ''));
                    else if (jOp === 'update')    await journalUpdateBubble(String(payload.id || ''), String(payload.text || ''));
                    else if (jOp === 'delete')    await journalDeleteBubble(String(payload.id || ''));
                    else if (jOp === 'archive')   await journalSetArchived(String(payload.id || ''), true);
                    else if (jOp === 'unarchive') await journalSetArchived(String(payload.id || ''), false);
                    else if (jOp === 'merge')     await journalMergeDown();
                    else aeLog('[AE:bridge] AE_JOURNAL_ACTION unknown op:', jOp);
                } catch (e) { api.v1.error('[AE:bridge] AE_JOURNAL_ACTION error:', e); }
                await broadcastJournal();
                break;
            }

            case 'AE_JOURNAL_GEN': {
                // Rewrite/compress a passage. Returns text only — the HUD reviews and then
                // commits via AE_JOURNAL_ACTION 'update' (mirrors the native review flow).
                const gOp = String(payload.op || '');
                const gId = String(payload.id || '');
                try {
                    const gSrc = String(payload.text || '');
                    let gOut: string | null = null;
                    if (gOp === 'rewrite')       gOut = await journalGenerateRewrite(gSrc);
                    else if (gOp === 'compress') gOut = await journalGenerateCompress(gSrc);
                    await broadcastToTM('AE_JOURNAL_GEN_RESULT', { id: gId, op: gOp, text: gOut || '', ok: !!gOut });
                } catch (e) {
                    api.v1.error('[AE:bridge] AE_JOURNAL_GEN error:', e);
                    try { await broadcastToTM('AE_JOURNAL_GEN_RESULT', { id: gId, op: gOp, text: '', ok: false }); } catch (e2) {}
                }
                break;
            }

            // [v2.12.0 CHARJOURNAL] Bridge -> engine per-character journal control. Same
            // three-message shape as AE_JOURNAL_* above (REQ/ACTION/GEN), every payload
            // additionally carries charId. State mutations run the Section 10c verbs, then
            // rebroadcast AE_CHAR_JOURNAL_STATE for that charId.
            case 'AE_CHAR_JOURNAL_REQ': {
                const cjrCharId = String(payload.charId || '');
                if (!cjrCharId) break;
                await broadcastCharJournal(cjrCharId);
                break;
            }

            case 'AE_CHAR_JOURNAL_ACTION': {
                const cjaCharId = String(payload.charId || '');
                if (!cjaCharId) break;
                try {
                    const cjaOp = String(payload.op || '');
                    if (cjaOp === 'add')            await charJournalAddBubble(cjaCharId, String(payload.text || ''));
                    else if (cjaOp === 'update')    await charJournalUpdateBubble(cjaCharId, String(payload.id || ''), String(payload.text || ''));
                    else if (cjaOp === 'delete')    await charJournalDeleteBubble(cjaCharId, String(payload.id || ''));
                    else if (cjaOp === 'archive')   await charJournalSetArchived(cjaCharId, String(payload.id || ''), true);
                    else if (cjaOp === 'unarchive') await charJournalSetArchived(cjaCharId, String(payload.id || ''), false);
                    else if (cjaOp === 'merge')     await charJournalMergeDown(cjaCharId);
                    else aeLog('[AE:bridge] AE_CHAR_JOURNAL_ACTION unknown op:', cjaOp);
                } catch (e) { api.v1.error('[AE:bridge] AE_CHAR_JOURNAL_ACTION error:', e); }
                await broadcastCharJournal(cjaCharId);
                break;
            }

            case 'AE_CHAR_JOURNAL_GEN': {
                // Rewrite/compress reuse the SAME generation functions the main journal
                // uses — pure text transforms, no per-journal identity, nothing to duplicate.
                const cjgCharId = String(payload.charId || '');
                const cjgOp = String(payload.op || '');
                const cjgId = String(payload.id || '');
                try {
                    const cjgSrc = String(payload.text || '');
                    let cjgOut: string | null = null;
                    if (cjgOp === 'rewrite')       cjgOut = await journalGenerateRewrite(cjgSrc);
                    else if (cjgOp === 'compress') cjgOut = await journalGenerateCompress(cjgSrc);
                    await broadcastToTM('AE_CHAR_JOURNAL_GEN_RESULT', { charId: cjgCharId, id: cjgId, op: cjgOp, text: cjgOut || '', ok: !!cjgOut });
                } catch (e) {
                    api.v1.error('[AE:bridge] AE_CHAR_JOURNAL_GEN error:', e);
                    try { await broadcastToTM('AE_CHAR_JOURNAL_GEN_RESULT', { charId: cjgCharId, id: cjgId, op: cjgOp, text: '', ok: false }); } catch (e2) {}
                }
                break;
            }

            // [CE-STRIP v2.0.x] AE_HOLDING_REQ / AE_HOLDING_ACTION removed — Holding cut.

            default:
                aeLog('[AE:bridge] Unhandled bridge message, event:', event, payload);
        }
    } catch (e) {
        aeLog('[AE:bridge] handleBridgeMessage error:', e);
    }
}


// ============================================================================
// SECTION 18b — LOREBOOK WORLD-PACK  [v0.9.7.9]
// packConfigToLorebook(): serialises the full AE world into a single hidden,
// disabled lorebook entry (AE_LOREBOOK_PACK_NAME). The entry travels with the
// story's .scenario export, so any user who imports the scenario gets the
// world pre-configured. The entry is NEVER injected into context (enabled:false,
// no keys, forceActivation:false). It can be re-packed at any time; the engine
// finds the existing entry by displayName and updates it in place.
//
// loadConfigFromLorebook(): called from onScriptsLoaded. If the sentinel entry
// exists AND storyStorage has no config yet (fresh story from scenario), imports
// the full world automatically and logs a summary. Non-destructive — existing
// stories are never overwritten.
// ============================================================================

async function packConfigToLorebook(): Promise<void> {
    aeLog('[AE:pack] Packing world config to lorebook...');
    try {
        // -- Gather storyStorage data -----------------------------------------
        const pkCfg   = await api.v1.storyStorage.get(STORAGE_CONFIG);
        const pkIdx   = await api.v1.storyStorage.getOrDefault(STORAGE_INDEX, []) as CharacterMeta[];
        const pkEntIdx = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_INDEX, []) as EntityMeta[];
        const pkParty  = await api.v1.storyStorage.getOrDefault(STORAGE_PARTY, null);
        const pkWebRaw = await api.v1.storyStorage.get(STORAGE_NPC_WEB) as string | undefined;
        const pkQI     = await api.v1.storyStorage.getOrDefault('ae_quick_instances', []);
        const pkWizRaw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_CHATS, '[]') as string;

        // -- Characters (sequential load) -------------------------------------
        let pkCharRecs: Record<string, any> = {};
        for (const pkCm of pkIdx) {
            try {
                const pkCh = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + pkCm.id);
                if (pkCh) pkCharRecs[pkCm.id] = pkCh;
            } catch (eChPk) { aeLog('[AE:pack] char load skip:', pkCm.id, eChPk); }
        }

        // -- Entities (sequential load) ---------------------------------------
        let pkEntRecs: Record<string, any> = {};
        for (const pkEm of pkEntIdx) {
            try {
                const pkEnt = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + pkEm.id, null);
                if (pkEnt) pkEntRecs[pkEm.id] = pkEnt;
            } catch (eEntPk) { aeLog('[AE:pack] entity load skip:', pkEm.id, eEntPk); }
        }

        // -- Image settings (in-memory, from global api.v1.storage) ----------
        // imagePromptFields/globalSettings are module-level; re-read to be safe.
        const pkImgFields = await api.v1.storage.get(STORAGE_KEY_PROMPT_FIELDS);
        const pkImgGlob   = await api.v1.storage.get(STORAGE_KEY_GLOBAL);

        // -- Assemble package -------------------------------------------------
        const pkPayload = JSON.stringify({
            v:            1,
            aeVersion:    '0.9.7.9',
            packedAt:     Date.now(),
            config:       pkCfg     || null,
            charIndex:    pkIdx,
            charRecords:  pkCharRecs,
            entIndex:     pkEntIdx,
            entRecords:   pkEntRecs,
            party:        pkParty   || null,
            npcWeb:       pkWebRaw  || null,
            quickInstances: pkQI,
            wizChats:     pkWizRaw,
            imageFields:  pkImgFields || null,
            imageGlobal:  pkImgGlob   || null
        });

        const pkBytes = pkPayload.length; // character count; JSON is mostly ASCII so ~= bytes
        aeLog('[AE:pack] Payload size:', pkBytes, 'bytes;', pkIdx.length, 'chars,', pkEntIdx.length, 'entities.');

        // -- Find existing sentinel entry or create new -----------------------
        let pkExisting: any = null;
        try {
            const pkAllEntries = await api.v1.lorebook.entries();
            pkExisting = pkAllEntries.find(function(pkE: any) { return pkE.displayName === AE_LOREBOOK_PACK_NAME; });
        } catch (eEntries) { aeLog('[AE:pack] entries() error:', eEntries); }

        if (pkExisting) {
            await api.v1.lorebook.updateEntry(pkExisting.id, { text: pkPayload });
            aeLog('[AE:pack] Updated existing lorebook entry id:', pkExisting.id);
        } else {
            const pkNewId = api.v1.uuid();
            await api.v1.lorebook.createEntry({
                id:              pkNewId,
                displayName:     AE_LOREBOOK_PACK_NAME,
                text:            pkPayload,
                keys:            [],
                enabled:         false,
                hidden:          true,
                forceActivation: false
            });
            aeLog('[AE:pack] Created new lorebook entry id:', pkNewId);
        }
        api.v1.ui.toast('World packed to lorebook (' + Math.round(pkBytes / 1024) + ' KB). Export scenario to share.', { type: 'success', autoClose: 4000 });
    } catch (ePack) {
        api.v1.error('[AE:pack] packConfigToLorebook error:', ePack);
        api.v1.ui.toast('Pack failed - see engine log.', { type: 'error', autoClose: 3000 });
    }
}

// Returns true if config was imported, false if skipped (entry missing or
// config already present). Called from onScriptsLoaded.
// Pass forced=true to import even when storyStorage already has a config.
async function loadConfigFromLorebook(forced?: boolean): Promise<boolean> {
    try {
        // -- Find sentinel entry ----------------------------------------------
        let lcEntry: any = null;
        try {
            const lcAll = await api.v1.lorebook.entries();
            lcEntry = lcAll.find(function(lcE: any) { return lcE.displayName === AE_LOREBOOK_PACK_NAME; });
        } catch (eLcList) { aeLog('[AE:pack] loadConfigFromLorebook entries() error:', eLcList); return false; }
        if (!lcEntry || !lcEntry.text) return false;

        // -- Only import if storyStorage has no config yet (fresh scenario) ---
        const lcExistingCfg = await api.v1.storyStorage.get(STORAGE_CONFIG);
        if (!forced && lcExistingCfg !== null && lcExistingCfg !== undefined) {
            aeLog('[AE:pack] Lorebook pack found but storyStorage already has config; skipping auto-import.');
            return false;
        }

        // -- Parse ------------------------------------------------------------
        let lcData: any;
        try { lcData = JSON.parse(lcEntry.text); }
        catch (eLcParse) { api.v1.error('[AE:pack] loadConfigFromLorebook: JSON parse failed:', eLcParse); return false; }

        aeLog('[AE:pack] Importing from lorebook pack v' + (lcData.v || '?') + ' packed at', lcData.packedAt, 'aeVersion', lcData.aeVersion);

        // -- Restore storyStorage: config -------------------------------------
        if (lcData.config) await api.v1.storyStorage.set(STORAGE_CONFIG, lcData.config);

        // -- Restore storyStorage: character index + records ------------------
        if (Array.isArray(lcData.charIndex) && lcData.charIndex.length > 0) {
            await api.v1.storyStorage.set(STORAGE_INDEX, lcData.charIndex);
            let lcCharCount = 0;
            const lcCharRecs = lcData.charRecords || {};
            for (const lcCharId in lcCharRecs) {
                try { await api.v1.storyStorage.set(STORAGE_CHAR_PFX + lcCharId, lcCharRecs[lcCharId]); lcCharCount++; }
                catch (eLcChar) { aeLog('[AE:pack] char restore skip:', lcCharId, eLcChar); }
            }
            aeLog('[AE:pack] Restored', lcCharCount, 'character records.');
        }

        // -- Restore storyStorage: entity index + records ---------------------
        if (Array.isArray(lcData.entIndex) && lcData.entIndex.length > 0) {
            await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, lcData.entIndex);
            let lcEntCount = 0;
            const lcEntRecs = lcData.entRecords || {};
            for (const lcEntId in lcEntRecs) {
                try { await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + lcEntId, lcEntRecs[lcEntId]); lcEntCount++; }
                catch (eLcEnt) { aeLog('[AE:pack] entity restore skip:', lcEntId, eLcEnt); }
            }
            aeLog('[AE:pack] Restored', lcEntCount, 'entity records.');
        }

        // -- Restore storyStorage: ancillary data -----------------------------
        if (lcData.party)          await api.v1.storyStorage.set(STORAGE_PARTY,         lcData.party);
        if (lcData.npcWeb)         await api.v1.storyStorage.set(STORAGE_NPC_WEB,        lcData.npcWeb);
        if (lcData.quickInstances) await api.v1.storyStorage.set('ae_quick_instances',   lcData.quickInstances);
        if (lcData.wizChats)       await api.v1.storyStorage.set(STORAGE_WIZ_CHATS,      lcData.wizChats);

        // -- Restore global api.v1.storage: image settings -------------------
        if (lcData.imageFields) await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, lcData.imageFields);
        if (lcData.imageGlobal) await api.v1.storage.set(STORAGE_KEY_GLOBAL,        lcData.imageGlobal);

        const lcCharLen  = Object.keys(lcData.charRecords || {}).length;
        const lcEntLen   = Object.keys(lcData.entRecords  || {}).length;
        aeLog('[AE:pack] Import complete:', lcCharLen, 'chars,', lcEntLen, 'entities.');
        api.v1.ui.toast('World imported from lorebook pack (' + lcCharLen + ' chars, ' + lcEntLen + ' locations). Reload to activate.', { type: 'success', autoClose: 5000 });
        return true;
    } catch (eLcMain) {
        api.v1.error('[AE:pack] loadConfigFromLorebook error:', eLcMain);
        return false;
    }
}

// Takes already-parsed lorebook pack data (packConfigToLorebook format: charIndex/
// charRecords/entIndex/entRecords) and restores the full world into storyStorage
// and api.v1.storage. 
// Distinct from importPayload(), which handles the plain-JSON export format.
async function importFromLorebookPack(data: any): Promise<void> {
    if (data.config) await api.v1.storyStorage.set(STORAGE_CONFIG, data.config);

    if (Array.isArray(data.charIndex) && data.charIndex.length > 0) {
        await api.v1.storyStorage.set(STORAGE_INDEX, data.charIndex);
        let ifpCharRecs = data.charRecords || {};
        for (let ifpCId in ifpCharRecs) {
            try { await api.v1.storyStorage.set(STORAGE_CHAR_PFX + ifpCId, ifpCharRecs[ifpCId]); } catch (eIfpC) {}
        }
    }

    if (Array.isArray(data.entIndex) && data.entIndex.length > 0) {
        await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, data.entIndex);
        let ifpEntRecs = data.entRecords || {};
        for (let ifpEId in ifpEntRecs) {
            try { await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + ifpEId, ifpEntRecs[ifpEId]); } catch (eIfpE) {}
        }
    }

    if (data.party)          await api.v1.storyStorage.set(STORAGE_PARTY,         data.party);
    if (data.npcWeb)         await api.v1.storyStorage.set(STORAGE_NPC_WEB,        data.npcWeb);
    if (data.quickInstances) await api.v1.storyStorage.set('ae_quick_instances',   data.quickInstances);
    if (data.wizChats)       await api.v1.storyStorage.set(STORAGE_WIZ_CHATS,      data.wizChats);

    if (data.imageFields) await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, data.imageFields);
    if (data.imageGlobal) await api.v1.storage.set(STORAGE_KEY_GLOBAL,        data.imageGlobal);
}

// Scans all lorebook entries for AE world packs (any entry whose text parses to
// JSON containing an aeVersion field), presents a modal picker, and calls
// importFromLorebookPack on the selected entry. Entry-point for the Import button
// in Settings → Adventure Module Management and the Characters tab header.
async function pickAndImportFromLorebook(): Promise<void> {
    let pklPacks: { entry: any; data: any }[] = [];
    try {
        let pklAll = await api.v1.lorebook.entries();
        for (let pklE of pklAll) {
            if (!pklE.text) continue;
            try {
                let pklD = JSON.parse(pklE.text);
                if (pklD && pklD.aeVersion) pklPacks.push({ entry: pklE, data: pklD });
            } catch (ePklParse) {}
        }
    } catch (ePklScan) {
        api.v1.ui.toast('Failed to scan lorebook entries.', { type: 'error' });
        return;
    }

    if (pklPacks.length === 0) {
        api.v1.ui.toast('No AE world packs found in the lorebook. Use "Pack to Lorebook" first.', { type: 'warning', autoClose: 4000 });
        return;
    }

    let pklContent: any[] = [
        { type: 'text', text: 'Select a world pack to import. This will overwrite the current world data.', style: { marginBottom: '14px', fontSize: '12px', lineHeight: '1.5' } }
    ];
    let pklModal: any;

    for (let pklI = 0; pklI < pklPacks.length; pklI++) {
        (function(pklEnt: any, pklDat: any) {
            let pklCC  = Object.keys(pklDat.charRecords || {}).length;
            let pklEC  = Object.keys(pklDat.entRecords  || {}).length;
            let pklLbl = (pklEnt.displayName || '[AE World]') + ' — ' + pklCC + ' chars, ' + pklEC + ' locations';
            pklContent.push({
                type: 'button',
                text: '📥 Import: ' + pklLbl,
                style: { width: '100%', marginBottom: '8px', backgroundColor: 'rgba(136,204,255,0.15)', border: '1px solid rgba(136,204,255,0.4)', color: '#88ccff', fontWeight: 'bold' },
                disabledWhileCallbackRunning: true,
                callback: async function() {
                    try {
                        await importFromLorebookPack(pklDat);
                        if (pklModal) pklModal.close();
                        api.v1.ui.toast('World imported. Reload the sidebar to activate.', { type: 'success', autoClose: 4000 });
                        queueSceneStateBroadcast();
                    } catch (ePklImp) {
                        api.v1.error('[AE] pickAndImportFromLorebook import failed:', ePklImp);
                        api.v1.ui.toast('Import failed — see engine log.', { type: 'error' });
                    }
                }
            });
        })(pklPacks[pklI].entry, pklPacks[pklI].data);
    }

    pklContent.push({ type: 'button', text: 'Cancel', style: { width: '100%', marginTop: '8px' }, callback: function() { if (pklModal) pklModal.close(); } });
    pklModal = await openEngineModal({ id: 'ae-pick-import', title: '📥 Import from Lorebook', size: 'small', content: pklContent });
}

// ============================================================================
// SECTION 19 — SCENE PRESENCE, LOCATION & EQUIP HELPERS
// [CE-STRIP v2.0.0] Was ACTION EXECUTION ENGINE. The AERule/ActionInstance effects
// engine (aeApplyEffects/aeCheckConditions/runActionInstance/runQuickInstance/
// aeRollResolution/aePickTarget/aeBindStakeDef/evaluateFieldCondition/etc — ~40
// functions, the AERule/ActionInstance/AEScope/AEResolution/ActionBranch/
// AEOutcomeBand/AEResOutcome interfaces, and the Travel executors executeTravelTo/
// findTravelPath/findVehicleAncestor/executeVehicleTravel/executeDestinationTravel)
// is fully removed — every remaining external call site was traced and fixed or
// confirmed unreachable (grep "CE-STRIP v2.0.0" across the file for each one).
// What's left is genuinely still needed: scene presence, location resolution,
// item equip, the equip/faction-resource read-write helpers still used from Holding,
// Schedule's NPC positioning, and commitTravel (still used for World-Build Wizard
// intro placement and the native Map's Teleport button — NOT reachable from any
// player-facing travel/action UI any more).
// ============================================================================


function composeActionPrompt(base: string, flavor: string): string {
    let b = base.trim();
    let f = flavor.trim();
    if (!f) return b;
    if (!b) { return f.charAt(0).toUpperCase() + f.slice(1); }
    let flavorComplete = /[.!?]$/.test(f);
    if (flavorComplete) { return b + ' ' + f; }
    let stripped = b.replace(/[.!?]\s*$/, '');
    return stripped + ', ' + f + '.';
}

async function aeSetEquip(itemEnt: EntityRecord | null, charRec: CharacterRecord | null, equip: boolean): Promise<void> {
    if (!itemEnt) return;
    let freshItem = await loadEntity(itemEnt.id);
    if (!freshItem) return;
    freshItem.isEquipped = equip;
    freshItem.equippedToCharId = (equip && charRec) ? charRec.id : undefined;
    await saveEntity(freshItem);
    if (charRec) {
        let freshChar = await loadCharacter(charRec.id);
        if (freshChar) {
            if (!freshChar.equippedItemIds) freshChar.equippedItemIds = [];
            if (equip) { if (freshChar.equippedItemIds.indexOf(freshItem.id) < 0) freshChar.equippedItemIds.push(freshItem.id); }
            else { freshChar.equippedItemIds = freshChar.equippedItemIds.filter(function(id) { return id !== freshItem.id; }); }
            await saveCharacter(freshChar);
            // [v0.9.8.5] No lorebook re-sync — equipment now rides an ephemeral temp entry.
        }
    }
}

// [FEATURE v2.30.0 ROOT-LOCATION, per user] Sentinel id for "the top of the entity
// graph" — every character's body starts here (parentId: null, see
// createWizardCharacter/spawnSceneNpc) and stays here until something moves it to a
// real location. Ungrouped and grouped-by-nothing used to mean the same thing as
// "unresolvable" (null), which is why a story with characters but NO location
// entities ever computed scene presence at all (loadPlayerLocation had nothing to
// fall back to but null, and recalculateScenePresence bails out entirely on a null
// camera room — see both below). Treating root as a real, comparable id instead of a
// dead end fixes that: a world with no locations now has exactly one implicit place,
// and every unplaced character is correctly co-located there together. Deliberately
// NOT a real entity — nothing should ever loadEntity() this id, which is also why it
// is namespaced away from api.v1.uuid()'s format rather than risking a collision.
var AE_ROOT_LOCATION_ID = '__ce_root__';

async function loadPlayerLocation(): Promise<string | null> {
    // [CE-STRIP vNEXT] The "camera" — what the HUD/context treats as the current
    // scene — is now independent of any character. STORAGE_PLAYER_LOC (declared long
    // ago but never actually written until now) is the single source of truth, set by
    // commitTravel/AE_SILENT_TELEPORT (the Map's Teleport action = "select a location").
    // Falls back to a protagonist's physical room if one exists and no camera has been
    // set yet (back-compat for worlds still using a protagonist), then to the first
    // location in the world so a fresh/no-protagonist world isn't permanently stuck on
    // "No scene state available." Each fallback persists into STORAGE_PLAYER_LOC so it
    // stays stable once resolved, rather than re-deriving every call.
    // [v2.30.0 ROOT-LOCATION] FINAL fallback below no longer returns null when there is
    // no location entity anywhere in the world — it returns AE_ROOT_LOCATION_ID, also
    // persisted, so this function can no longer return null at all. commitTravel still
    // overwrites STORAGE_PLAYER_LOC unconditionally the moment a real location exists
    // and gets selected, so this is a one-time bootstrap, not a permanent ceiling.
    const camLoc = await api.v1.storyStorage.getOrDefault(STORAGE_PLAYER_LOC, null) as string | null;
    if (camLoc === AE_ROOT_LOCATION_ID) return AE_ROOT_LOCATION_ID;
    if (camLoc) {
        const camEnt = await loadEntity(camLoc);
        if (camEnt) return camLoc;
        // Stale pointer (location was deleted) — fall through and re-resolve.
    }

    const idx = await loadIndex();
    const pMeta = idx.find(function(m) { return !!m.isProtagonist; });
    if (pMeta) {
        const protag = await loadCharacter(pMeta.id);
        if (protag && protag.entityId) {
            const protagBody = await loadEntity(protag.entityId);
            if (protagBody && protagBody.parentId) {
                await api.v1.storyStorage.set(STORAGE_PLAYER_LOC, protagBody.parentId);
                return protagBody.parentId;
            }
        }
    }

    const allNodes = await loadEntityIndex();
    const firstLoc = allNodes.find(function(n) { return n.type === 'location'; });
    if (firstLoc) {
        await api.v1.storyStorage.set(STORAGE_PLAYER_LOC, firstLoc.id);
        return firstLoc.id;
    }
    await api.v1.storyStorage.set(STORAGE_PLAYER_LOC, AE_ROOT_LOCATION_ID);
    return AE_ROOT_LOCATION_ID;
}

function getEffectiveRoomId(entityId: string, allNodes: EntityMeta[]): string | null {
    // Walks up the entity tree until a 'location' node is found.
    // Preserved verbatim from AE source, EXCEPT the final line — [v2.30.0 ROOT-LOCATION]
    // walking all the way to the top (parentId chain ends in null) with no 'location'
    // ancestor used to return null here, indistinguishable from "entityId doesn't exist
    // at all." Now returns AE_ROOT_LOCATION_ID instead, a real comparable id meaning
    // "this body sits at the top of the graph, ungrouped" — see that constant's own
    // comment for why this matters (recalculateScenePresence's camRoom comparison).
    // A genuinely missing node (!node) still returns null — that is a real error case
    // (a deleted/dangling entityId), not "unplaced," and stays distinguishable from it.
    if (!entityId) return null;
    let currentId: string | null = entityId;
    let sanity = 0;
    while (currentId && sanity < 10) {
        const node = allNodes.find(function(n) { return n.id === currentId; });
        if (!node) return null;
        if (node.type === 'location') return node.id;
        currentId = node.parentId || null;
        sanity++;
    }
    return currentId === null ? AE_ROOT_LOCATION_ID : currentId;
}

async function aeGetPlayerRoomId(): Promise<string | null> {
    // [CE-STRIP vNEXT] Delegates to loadPlayerLocation() — the camera already resolves
    // to a location-type node (walking up from a protagonist's body if needed), so a
    // separate walk here is redundant now that "current room" means "camera location"
    // rather than "wherever the protagonist's body specifically sits."
    try {
        return await loadPlayerLocation();
    } catch (e) { aeLog('[AE] aeGetPlayerRoomId:', e); return null; }
}

async function aeSetCharScenePresent(charId: string, present: boolean): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c) return;
        c.scenePresent = !!present;
        await saveCharacter(c);
        queueSceneStateBroadcast();
    } catch (e) { aeLog('[AE] aeSetCharScenePresent:', e); }
}

async function aeMoveCharToScene(charId: string): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c || !c.entityId) return;
        const room = await aeGetPlayerRoomId();   // co-locate in the player's actual room
        const body = await loadEntity(c.entityId);
        if (body) { body.parentId = room; await saveEntity(body); }
        await saveCharacter(c);
        await recalculateScenePresence();
        queueSceneStateBroadcast();
    } catch (e) { aeLog('[AE] aeMoveCharToScene:', e); }
}

// [v2.144.0 PHASE-G] THE MIRROR OF aeMoveCharToScene, AND IT HAD TO BE WRITTEN.
// The verification pass for this phase found aeSetCharScenePresent already sitting right
// above -- and it is NOT the exclude verb, despite looking exactly like one.
// WHY: scenePresent IS A DERIVED FLAG, NOT A STORED INTENT. recalculateScenePresence
// recomputes it for every active character from body-vs-camera co-location and has ten
// call sites, including the generation path. Setting the flag to false while the body is
// still standing in the room means the next recalculation flips it back, so an "exclude"
// built on aeSetCharScenePresent would appear to work and then silently undo itself the
// next time the story generated. That is the worst failure shape available here.
// SO EXCLUDE MOVES THE BODY, exactly the way Add does. Detaching the body from every room
// (parentId = null) makes getEffectiveRoomId return null, which makes shouldBePresent
// false on every future recalculation -- the state survives because it is expressed in the
// same terms presence is DERIVED from. This is the "No Location" path the retired bridge
// inspection view already used; it is not a new concept, only a new door to it.
// NOTE THE ASYMMETRY THAT REMAINS: Add puts them in the camera's room, Exclude puts them
// nowhere rather than in the room they came from. There is no stored "previous location"
// to restore, and inventing one would be a second source of truth about where a body is.
async function aeRemoveCharFromScene(charId: string): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c || !c.entityId) return;
        const body = await loadEntity(c.entityId);
        if (body) { body.parentId = null; await saveEntity(body); }
        await saveCharacter(c);
        await recalculateScenePresence();
        queueSceneStateBroadcast();
    } catch (e) { aeLog('[AE] aeRemoveCharFromScene:', e); }
}

async function aeRefreshPresence(): Promise<void> {
    try {
        await recalculateScenePresence();
        queueSceneStateBroadcast();
    } catch (e) { aeLog('[AE] aeRefreshPresence:', e); }
}

async function recalculateScenePresence(): Promise<void> {
    // [CE-STRIP vNEXT] Updates scenePresent for all active characters based on
    // co-location with the CAMERA location (loadPlayerLocation()) instead of the
    // protagonist's body. Previously this returned immediately if no protagonist
    // existed, so presence was never computed at all without one — root cause of
    // "No scene state available." A protagonist, if one exists, is now just another
    // character for presence purposes: present if co-located, absent otherwise, no
    // longer the anchor everyone else is measured against.
    try {
        // [v2.30.0 ROOT-LOCATION] loadPlayerLocation can no longer return null (its
        // final fallback is now AE_ROOT_LOCATION_ID, not null — see both of their own
        // comments), so this guard is believed unreachable now. Left in place as
        // defense-in-depth rather than removed — a null here would mean something
        // deeper broke, and silently proceeding with a null camRoom would make every
        // cRoom === camRoom comparison below false in a way that would look identical
        // to "nobody's present," not "something's wrong."
        const camRoom = await loadPlayerLocation();
        if (!camRoom) return;

        const allChars = await loadAllCharacters();
        const freshEntIdx = await loadEntityIndex();
        for (const c of allChars) {
            if (!c.active) continue;
            if (!c.entityId) {
                // No body in the world graph — cannot be co-located with anyone.
                if (c.scenePresent) { c.scenePresent = false; await saveCharacter(c); }
                continue;
            }
            const cRoom = getEffectiveRoomId(c.entityId, freshEntIdx);
            const shouldBePresent = (cRoom !== null) && (cRoom === camRoom);
            if (c.scenePresent !== shouldBePresent) {
                c.scenePresent = shouldBePresent;
                await saveCharacter(c);
            }
        }
    } catch (e) {
        aeLog('[AE] recalculateScenePresence error:', e);
    }
}


async function commitTravel(targetId: string, isSilent: boolean): Promise<void> {
    try {
        const ctTarget = await loadEntity(targetId);
        if (!ctTarget) return;
        aeLog('[AE:TRACE] commitTravel ENTER target=' + ctTarget.name + '(' + targetId + ') isSilent=' + isSilent + ' ae_lock=' + ae_lock);
        const ctIsSpatial = ctTarget.type === 'location';
        await api.v1.tempStorage.set(STORAGE_LAST_TRAVEL, Date.now());

        // [CE-STRIP vNEXT] Camera: set unconditionally, no protagonist required — this
        // IS the "select a location from the Map" action. Previously the whole function
        // bailed out here if no protagonist existed.
        if (ctIsSpatial) { await api.v1.storyStorage.set(STORAGE_PLAYER_LOC, targetId); }

        const ctChars  = await loadAllCharacters();
        const ctProtag = ctChars.find(function(c) { return c.isProtagonist; });
        if (ctProtag && ctProtag.entityId) {
            // Move body
            if (ctIsSpatial) {
                const ctBody = await loadEntity(ctProtag.entityId);
                if (ctBody && ctBody.id !== targetId) { aeLog('[AE:TRACE] commitTravel body move ' + ctBody.parentId + ' -> ' + targetId); ctBody.parentId = targetId; await saveEntity(ctBody); }
                else { aeLog('[AE:TRACE] commitTravel body NOT moved (ctBody=' + (ctBody ? ctBody.id : 'null') + ' target=' + targetId + ')'); }
            }

            // Legacy per-character camera field — kept in sync for any code still
            // reading it, but STORAGE_PLAYER_LOC above is the actual source of truth now.
            const ctFreshProtag = await loadCharacter(ctProtag.id);
            if (ctFreshProtag) { ctFreshProtag.currentLocationId = targetId; await saveCharacter(ctFreshProtag); }
        }

        // [v2.89.0 FOLLOW-CAM] Generalises the protagonist body-move above to any
        // character flagged followCamera. Placement ONLY: scenePresent is still derived
        // by recalculateScenePresence below (camera-anchored since CE-STRIP vNEXT), so
        // this writes a body position and lets the existing presence pass draw its own
        // conclusion rather than asserting presence directly. Skips the protagonist (the
        // block above already moved that body) and anyone with no body to move. Reuses
        // ctChars — already loaded — so the common case of zero followers costs one
        // in-memory filter and no storage reads.
        if (ctIsSpatial) {
            for (const fcChar of ctChars) {
                if (!fcChar.active || !(fcChar as any).followCamera || !fcChar.entityId) continue;
                if (ctProtag && fcChar.id === ctProtag.id) continue;
                try {
                    const fcBody = await loadEntity(fcChar.entityId);
                    if (fcBody && fcBody.id !== targetId && fcBody.parentId !== targetId) {
                        aeLog('[AE:TRACE] followCamera move ' + fcChar.name + ' ' + fcBody.parentId + ' -> ' + targetId);
                        fcBody.parentId = targetId;
                        await saveEntity(fcBody);
                    }
                } catch (eFc) { aeLog('[AE] followCamera move failed for ' + fcChar.name + ':', eFc); }
            }
        }

        // Pre-generation auto-triggers
        if (ctIsSpatial) { await runAutoTriggers(); }

        // [v0.9.9.2] Position offstage NPCs per their hourly schedule for the current
        // hour before computing who is scene-present at the destination.
        // [CE-STRIP v2.0.x] resolveSchedules() call removed — Schedule cut.

        // Scene presence — camera-anchored (recalculateScenePresence), no longer a
        // protagonist-room loop duplicated inline here.
        if (ctIsSpatial) { await recalculateScenePresence(); }

        // History
        const ctHist = await loadEntityHistory();
        ctHist.unshift(targetId);
        await saveEntityHistory(ctHist);

        // [v2.103.0 CE-SWEEP] Quest arrival check removed. Walking into a tracked
        // narrative's target location cleared the flag and fired a '🎯 Reached:' toast --
        // an objective-completion trigger, which is the game-mechanics half of the
        // narrative tree rather than the storytelling half.

        // [v0.9.25 E4] Encounter roll removed from commitTravel

        queueSceneStateBroadcast();

        if (!isSilent) {
            // [v0.9.37 DEFER1] Do NOT generate inline. move_player_to_self can sit in the
            // MIDDLE of an effects list (e.g. before inject_narrative); generating here
            // blocks the editor so any later inject_narrative/inject_message throws
            // 'editor is currently blocked' and the narrative never lands. Set a pending
            // flag; the top-level handler generates ONCE after every effect completes.
            aeLog('[AE:TRACE] commitTravel DEFER generate (target=' + targetId + ')');
            ae_pendingGenerate = true;
        } else {
            aeLog('[AE:TRACE] commitTravel SILENT SKIP generate (target=' + targetId + ')');
        }
    } catch (e) {
        aeLog('[AE] commitTravel error:', e);
    }
}

// ============================================================================
// SECTION 20 — SHARED ENTITY, CONFIG & IMPORT OPERATIONS
//
// Survivors of the v2.160.0 native-UI sweep. Every function here was declared
// inside a deleted native surface (the sidebar, the workspace shell, the
// worldbuilding/config modals) but is called from outside it — SECTION 18
// bridge handlers and the jsx surfaces — so it was moved rather than cut.
// Nothing in this section renders a native sidebar or workspace; the only
// api.v1.ui use left is confirmDeleteChar's confirm dialog and the toasts.
//
//   mutConfig                     — load/mutate/save GlobalConfig (73 call sites)
//   aeExpandAlternations          — {a|b} pick-one expansion, used by all three spawns
//   spawnSceneNpc / spawnItem / spawnLocation
//                                 — create a character/item/location body from a
//                                   name + brief. Reached from AE_HUD_SPAWN_ENTITY,
//                                   AE_HUD_SPAWN_LOCATION and AE_STUDIO_CREATE.
//   generateSceneNpc / generateSceneItem / generateSceneLocation
//                                 — generate a scene-fitting DRAFT without creating
//                                   anything. Reached from AE_HUD_GEN_ENTITY and
//                                   AE_HUD_GEN_LOCATION, which echo the draft back.
//   confirmDeleteChar             — confirm-then-deleteCharacter. AE_DELETE_CHAR.
//   importPayload + merge helpers — the smart importer. AE_IMPORT_WORLD and the
//                                   Settings surface import path.
// ============================================================================

// -- Config mutation ---------------------------------------------------------

async function mutConfig(fn: (c: GlobalConfig) => void): Promise<void> {
    const c = await loadConfig(); fn(c); await saveConfig(c);
}

// -- Scene spawns & drafts ---------------------------------------------------

function aeExpandAlternations(txt: string): string {
    let outAlt = String(txt || '');
    let guardAlt = 0;
    while (guardAlt < 24) {
        let mAlt = outAlt.match(/\{([^{}|]*(?:\|[^{}|]*)+)\}/);
        if (!mAlt) break;
        let optsAlt = mAlt[1].split('|');
        let idxAlt = 0;
        try { idxAlt = api.v1.random.roll('1d' + optsAlt.length).total - 1; } catch (eAlt) { idxAlt = 0; }
        if (idxAlt < 0 || idxAlt >= optsAlt.length) idxAlt = 0;
        let posAlt = (typeof mAlt.index === 'number') ? mAlt.index : 0;
        outAlt = outAlt.substring(0, posAlt) + optsAlt[idxAlt].trim() + outAlt.substring(posAlt + mAlt[0].length);
        guardAlt++;
    }
    return outAlt;
}

async function spawnSceneNpc(name: string, brief: string, locId: string | null, quiet?: boolean): Promise<{ id: string; name: string } | null> {
    try {
        const cfg = await loadConfig();
        if (!locId) { locId = await aeGetPlayerRoomId(); }   // [vNEXT] default to the player's actual room
        let baseName = aeExpandAlternations(name || 'Someone').trim();
        if (!baseName) baseName = 'Someone';
        let finalBrief = aeExpandAlternations(brief || '').trim();

        // Numbered suffix on collision with any active character (Skeleton, Skeleton 2...).
        const nsIdx = await loadIndex();
        let finalName = baseName;
        let nsN = 2;
        while (nsIdx.some(function(m) { return !!m && m.active && (m.name || '') === finalName; }) && nsN < 50) {
            finalName = baseName + ' ' + nsN;
            nsN++;
        }

        const body = makeDefaultEntity(finalName);
        body.type = 'character';
        body.parentId = locId ? locId : null;
        body.description = finalBrief;
        await saveEntity(body);

        const rec = makeDefaultCharacter(finalName, cfg);
        rec.entityId = body.id;
        rec.briefDescription = finalBrief;
        rec.active = true;
        rec.scenePresent = true;
        await saveCharacter(rec);

        await recalculateScenePresence();
        queueSceneStateBroadcast();
        if (!quiet) api.v1.ui.toast('Character "' + finalName + '" added.', { type: 'success', autoClose: 2000 });
        return { id: rec.id, name: finalName };
    } catch (e) {
        api.v1.error('[AE] spawnSceneNpc:', e);
        api.v1.ui.toast('Failed to add character.', { type: 'error' });
        return null;
    }
}

// [vNEXT] Scene-grounded NPC generator. Uses generateWithStory in 'background' mode
// (same path as generateCharacterSnapshot) so the model sees the live story +
// location and invents someone who fits the moment. Returns a {name, brief} for
// review/spawn; does NOT create anything itself.
async function generateSceneNpc(): Promise<{ name: string; brief: string } | null> {
    try {
        let gsLocName = 'the current location';
        let gsLocDesc = '';
        let gsLocId = await api.v1.storyStorage.getOrDefault(STORAGE_PLAYER_LOC, null) as string | null;
        if (gsLocId) {
            let gsLocEnt = await loadEntity(gsLocId);
            if (gsLocEnt) { gsLocName = gsLocEnt.name || gsLocName; gsLocDesc = gsLocEnt.description || ''; }
        }
        let gsCfg = await loadConfig();
        let gsSys: string[] = [
            gsCfg.generalStyle || '',
            '',
            'You invent ONE background character who would plausibly be present in the current scene.',
            'Base them on what is actually happening in the story right now and on the location.',
            'Output EXACTLY two lines and nothing else, no preamble:',
            'NAME: <a short name or label, e.g. Gate Guard, Mara, Hooded Vendor>',
            'DOING: <one present-tense sentence describing what they are doing here and why>'
        ];
        let gsUsr: string[] = [
            'Location: ' + gsLocName,
            gsLocDesc ? 'Setting: ' + gsLocDesc.slice(0, 160) : '',
            'Invent a fitting NPC now. Two lines only.'
        ].filter(Boolean);

        let gsResp = await api.v1.generateWithStory(
            [{ role: 'system', content: gsSys.join('\n') }, { role: 'user', content: gsUsr.join('\n') }],
            { model: 'glm-4-6', max_tokens: 120 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );
        let gsTxt = (gsResp && gsResp.choices && gsResp.choices.length > 0) ? String(gsResp.choices[0].text || '') : '';
        if (!gsTxt.trim()) return null;

        let gsName = '';
        let gsBrief = '';
        gsTxt.split('\n').forEach(function(ln) {
            let t = ln.trim();
            let up = t.toUpperCase();
            if (up.indexOf('NAME:') === 0) gsName = t.substring(5).trim();
            else if (up.indexOf('DOING:') === 0) gsBrief = t.substring(6).trim();
        });
        if (!gsName || !gsBrief) {
            let gsLines = gsTxt.split('\n').map(function(s) { return s.trim(); }).filter(Boolean);
            if (!gsName && gsLines.length > 0) gsName = gsLines[0].replace(/^NAME:\s*/i, '');
            if (!gsBrief && gsLines.length > 1) gsBrief = gsLines.slice(1).join(' ').replace(/^DOING:\s*/i, '');
        }
        gsName = gsName.replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        gsBrief = gsBrief.replace(/^["'\s\-]+/, '').slice(0, 240);
        if (!gsName) return null;
        return { name: gsName, brief: gsBrief };
    } catch (e) {
        api.v1.error('[AE] generateSceneNpc:', e);
        api.v1.ui.toast('Scene generation failed.', { type: 'error' });
        return null;
    }
}

// [CE-STRIP v2.1.6] NPC Archetype editor (aeMutateArchetype/buildArchetypeEditContent/refreshArchetypeEditModal/openArchetypeEditModal), Bestiary modal (buildBestiaryContent/refreshBestiaryModal/openBestiaryModal), and Item Template mutator (aeMutateItemArchetype) all removed — Bestiary + Item Templates cut.

// Spawn one item from a template. Target defaults to the player's inventory (parented
// to the protagonist's body); a template may instead choose the current room, where the
// loose item becomes pick-up-able via the library Pick Up action. {a|b|c} alternations
// in name/description are rolled once, here, and baked into the copy.
async function spawnItem(name: string, desc: string, quiet?: boolean, explicitParentId?: string | null): Promise<{ id: string; name: string } | null> {
    try {
        // Target resolution: an explicit entity id (e.g. the inspected room) wins; the
        // sentinels '__room__' / '__inventory__' force a mode; default is inventory (the
        // protagonist's body).
        // [FIX v1.19.0] spTarget used to be declared inside the `else` below, so the
        // explicit-parent-id branch (the exact path AE_HUD_SPAWN_ENTITY takes) skipped
        // its declaration entirely -- saveEntity succeeded but the toast line threw a
        // ReferenceError, surfacing as "Failed to add item." on a spawn that actually
        // worked. Hoisted to outer scope; explicit parent counts as 'room' (a place in
        // the world, not the protagonist's body).
        let target: string | null = null;
        let spTarget: string;
        if (explicitParentId && explicitParentId !== '__inventory__' && explicitParentId !== '__room__') {
            target = explicitParentId;
            spTarget = 'room';
        } else {
            if (explicitParentId === '__room__') spTarget = 'room';
            else spTarget = 'inventory';
            if (spTarget === 'room') {
                target = await aeGetPlayerRoomId();
            } else {
                const spChars = await loadAllCharacters();
                const spProtag = spChars.find(function(c) { return c.isProtagonist; });
                target = (spProtag && spProtag.entityId) ? spProtag.entityId : await aeGetPlayerRoomId();
            }
        }

        let baseName = aeExpandAlternations(name || 'Item').trim();
        if (!baseName) baseName = 'Item';
        let finalDesc = aeExpandAlternations(desc || '').trim();

        // Numbered suffix on collision with any item already in the same container.
        const siIdx = await loadEntityIndex();
        let finalName = baseName;
        let siN = 2;
        while (siIdx.some(function(m) { return !!m && m.type === 'item' && m.parentId === target && (m.name || '') === finalName; }) && siN < 50) {
            finalName = baseName + ' ' + siN;
            siN++;
        }

        const body = makeDefaultEntity(finalName);
        body.type = 'item';
        body.parentId = target ? target : null;
        body.description = finalDesc;
        await saveEntity(body);

        queueSceneStateBroadcast();
        if (!quiet) api.v1.ui.toast('Item \u201c' + finalName + '\u201d added' + (spTarget === 'room' ? ' to the room.' : ' to inventory.'), { type: 'success', autoClose: 2000 });
        return { id: body.id, name: finalName };
    } catch (e) {
        api.v1.error('[AE] spawnItem:', e);
        api.v1.ui.toast('Failed to add item.', { type: 'error' });
        return null;
    }
}

// Scene-grounded item generator. Same background path as generateSceneNpc: reads the
// live location, invents an item that fits the moment, returns {name, desc} for
// review/spawn. Creates nothing itself.
async function generateSceneItem(): Promise<{ name: string; desc: string } | null> {
    try {
        let giLocName = 'the current location';
        let giLocDesc = '';
        let giLocId = await api.v1.storyStorage.getOrDefault(STORAGE_PLAYER_LOC, null) as string | null;
        if (giLocId) {
            let giLocEnt = await loadEntity(giLocId);
            if (giLocEnt) { giLocName = giLocEnt.name || giLocName; giLocDesc = giLocEnt.description || ''; }
        }
        let giCfg = await loadConfig();
        let giSys: string[] = [
            giCfg.generalStyle || '',
            '',
            'You invent ONE item that would plausibly be found in the current scene.',
            'Base it on what is actually happening in the story right now and on the location.',
            'Output EXACTLY two lines and nothing else, no preamble:',
            'NAME: <a short item name, e.g. Rusted Key, Silk Scarf, Hunting Knife>',
            'DESC: <one sentence describing what it is and its notable qualities>'
        ];
        let giUsr: string[] = [
            'Location: ' + giLocName,
            giLocDesc ? 'Setting: ' + giLocDesc.slice(0, 160) : '',
            'Invent a fitting item now. Two lines only.'
        ].filter(Boolean);

        let giResp = await api.v1.generateWithStory(
            [{ role: 'system', content: giSys.join('\n') }, { role: 'user', content: giUsr.join('\n') }],
            { model: 'glm-4-6', max_tokens: 120 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );
        let giTxt = (giResp && giResp.choices && giResp.choices.length > 0) ? String(giResp.choices[0].text || '') : '';
        if (!giTxt.trim()) return null;

        let giName = '';
        let giDesc = '';
        giTxt.split('\n').forEach(function(ln) {
            let t = ln.trim();
            let up = t.toUpperCase();
            if (up.indexOf('NAME:') === 0) giName = t.substring(5).trim();
            else if (up.indexOf('DESC:') === 0) giDesc = t.substring(5).trim();
        });
        if (!giName || !giDesc) {
            let giLines = giTxt.split('\n').map(function(s2) { return s2.trim(); }).filter(Boolean);
            if (!giName && giLines.length > 0) giName = giLines[0].replace(/^NAME:\s*/i, '');
            if (!giDesc && giLines.length > 1) giDesc = giLines.slice(1).join(' ').replace(/^DESC:\s*/i, '');
        }
        giName = giName.replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        giDesc = giDesc.replace(/^["'\s\-]+/, '').slice(0, 240);
        if (!giName) return null;
        return { name: giName, desc: giDesc };
    } catch (e) {
        api.v1.error('[AE] generateSceneItem:', e);
        api.v1.ui.toast('Scene generation failed.', { type: 'error' });
        return null;
    }
}

// ============================================================================
// [v1.18.0 LOCGEN] IN-PLAY LOCATION AUTHORING
// The spatial sibling of spawnItem / generateSceneItem, directly above. Same two-step
// shape: generate a draft from live story context, hand it back for review, then create.
//
// RELATION is the whole model. There is no third case:
//   'sibling'  same tier, adjacent      -> parentId = reference location's parentId
//   'child'    contained within here    -> parentId = reference location's id
// Sibling adjacency is implicit (shared parentId); no connectedEntityIds edge is written.
//
// >>> PAIRED CODE, three ways. Change one, check the others:
// >>>   generateLocationBatch()  — the wizard's chat-context twin of the prompt below.
// >>>   createLocationEntity()   — the shared entity+lorebook birth helper both use.
// >>>   spawnItem/spawnNpc       — the popup/round-trip pattern this mirrors, and the
// >>>                              AE_HUD_GEN_ENTITY / AE_HUD_SPAWN_ENTITY message pair
// >>>                              that AE_HUD_GEN_LOCATION / AE_HUD_SPAWN_LOCATION copy.
// ============================================================================

// Scene-grounded location generator. Background generation (NOT executeYoinkGeneration —
// that hijacks the foreground editor call, which is right for an interactive wizard chat
// and wrong for a HUD button). Reads the reference location and an optional author
// suggestion; returns {name, description, lore} for review. Creates nothing itself.
async function generateSceneLocation(relation: string, refLocId?: string | null, suggestion?: string): Promise<{ name: string; description: string; lore: string } | null> {
    try {
        let glRel = (relation === 'child') ? 'child' : 'sibling';
        let glRefId = refLocId ? refLocId : (await api.v1.storyStorage.getOrDefault(STORAGE_PLAYER_LOC, null) as string | null);
        let glRefEnt = glRefId ? await loadEntity(glRefId) : null;
        let glRefName = (glRefEnt && glRefEnt.name) ? glRefEnt.name : 'the current location';
        let glRefDesc = (glRefEnt && glRefEnt.description) ? glRefEnt.description : '';
        let glParentId = (glRel === 'child') ? (glRefId || null) : (glRefEnt ? (glRefEnt.parentId || null) : null);
        let glParentEnt = (glRel === 'sibling' && glParentId) ? await loadEntity(glParentId) : null;

        let glIdx = await loadEntityIndex();
        let glExisting = glIdx
            .filter(function(m) { return m.type === 'location' && m.parentId === (glParentId || null); })
            .map(function(m) { return m.name; })
            .filter(Boolean);

        let glCfg = await loadConfig();
        let glScope = (glRel === 'child')
            ? 'a NEW place contained INSIDE \u201c' + glRefName + '\u201d \u2014 one scale-step smaller than it (a room within a house, a district within a city, a glade within a forest).'
            : 'a NEW place standing ALONGSIDE \u201c' + glRefName + '\u201d at the SAME scale' + (glParentEnt ? ', both contained within \u201c' + glParentEnt.name + '\u201d' : ', both at the top level of the world') + '.';

        let glSys: string[] = [
            glCfg.generalStyle || '',
            '',
            'You invent exactly ONE new location for a story world: ' + glScope,
            'Ground it in what is actually happening in the story right now, and in the reference location below.',
            'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.',
            'FORMAT: output exactly these three labelled blocks and nothing else, no preamble:',
            'NAME: <short place name>',
            'DESC: <1-2 sentences capturing ONLY what a camera physically senses on arrival (light, texture, scale). No history.>',
            'LORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, culture, and tensions. Never restate the DESC line.>'
        ];
        if (glExisting.length) {
            glSys.push('');
            glSys.push('These places ALREADY EXIST at that same level \u2014 do NOT recreate or duplicate them:\n' + glExisting.map(function(gn) { return '- ' + gn; }).join('\n'));
        }

        let glUsr: string[] = [
            'Reference location: ' + glRefName,
            glRefDesc ? 'Setting: ' + glRefDesc.slice(0, 240) : '',
            (glParentEnt && (glParentEnt.description || '').trim()) ? 'Containing place \u2014 ' + glParentEnt.name + ': ' + glParentEnt.description.trim().slice(0, 240) : '',
            (suggestion || '').trim() ? 'The author asks specifically for: ' + String(suggestion).trim().slice(0, 400) : '',
            'Invent the location now. Three labelled blocks only.'
        ].filter(Boolean);

        let glResp = await api.v1.generateWithStory(
            [{ role: 'system', content: glSys.join('\n') }, { role: 'user', content: glUsr.join('\n\n') }],
            { model: 'glm-4-6', max_tokens: 420 },
            { suppressScriptHooks: 'self', contextLimitReduction: 700 },
            undefined,
            'background'
        );
        let glTxt = (glResp && glResp.choices && glResp.choices.length > 0) ? String(glResp.choices[0].text || '') : '';
        if (!glTxt.trim()) return null;

        // Same three regexes generateLocationBatch uses per chunk (see PAIRED PROMPT note there).
        let glNmM = glTxt.match(/NAME:\s*(.+)/i);
        let glDeM = glTxt.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
        let glLoM = glTxt.match(/LORE:\s*([\s\S]+)/i);
        if (!glNmM) return null;
        let glName = glNmM[1].trim().replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        let glDesc = glDeM ? glDeM[1].replace(/\nLORE:[\s\S]*$/i, '').replace(/\nNAME:[\s\S]*$/i, '').trim() : '';
        let glLore = glLoM ? glLoM[1].replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim() : '';
        if (!glName) return null;
        return { name: glName, description: glDesc, lore: glLore };
    } catch (e) {
        api.v1.error('[AE] generateSceneLocation:', e);
        api.v1.ui.toast('Location generation failed.', { type: 'error' });
        return null;
    }
}

// Create one location relative to a reference location (default: the player's current
// one). Depth decides the tier travel template, exactly as the wizard batch path does.
// {a|b|c} alternations in the name/description are rolled once, here.
async function spawnLocation(name: string, description: string, lore: string, relation: string, refLocId?: string | null, quiet?: boolean): Promise<{ id: string; name: string } | null> {
    try {
        let slRel = (relation === 'child') ? 'child' : 'sibling';
        let slRefId = refLocId ? refLocId : (await api.v1.storyStorage.getOrDefault(STORAGE_PLAYER_LOC, null) as string | null);

        // [v2.51.0 ROOT-ADDLOC, per user] At the world root there is no reference ENTITY to
        // anchor to: AE_ROOT_LOCATION_ID is a sentinel (deliberately never a real entity, so
        // loadEntity() on it always returns undefined), and a location-less world has no
        // STORAGE_PLAYER_LOC target either. Both bailed here before — the sentinel hit the
        // "Reference location not found." dead end, a null ref hit "No current location..." —
        // which is exactly why a new location could not be created at root from either the
        // native map or the bridge round-trip (both funnel through this one function). At the
        // root, 'sibling' and 'child' collapse to the same result: a new TOP-LEVEL location
        // (parentId null). Handle that directly instead of loading the sentinel.
        let slIsRoot = (!slRefId) || (slRefId === AE_ROOT_LOCATION_ID);
        let slRefEnt: any = null;
        let slParentId: string | null;
        if (slIsRoot) {
            slParentId = null;
        } else {
            slRefEnt = await loadEntity(slRefId);
            if (!slRefEnt) {
                if (!quiet) api.v1.ui.toast('Reference location not found.', { type: 'error' });
                return null;
            }
            slParentId = (slRel === 'child') ? slRefId : (slRefEnt.parentId || null);
        }

        let slBase = aeExpandAlternations(name || '').trim();
        if (!slBase) slBase = 'New Location';

        // Numbered suffix on collision with any location already sharing the new parent.
        let slIdx = await loadEntityIndex();
        let slFinal = slBase;
        let slN = 2;
        while (slIdx.some(function(m) { return !!m && m.type === 'location' && m.parentId === (slParentId || null) && (m.name || '') === slFinal; }) && slN < 50) {
            slFinal = slBase + ' ' + slN;
            slN++;
        }

        let slDesc = aeExpandAlternations(description || '').trim();
        let slId = await createLocationEntity(slFinal, slDesc, (lore || '').trim(), slParentId);

        queueSceneStateBroadcast();
        if (!quiet) {
            let slWhere = slIsRoot
                ? 'at the top level of the world'
                : ((slRel === 'child')
                    ? 'inside ' + (slRefEnt.name || 'here')
                    : 'beside ' + (slRefEnt.name || 'here'));
            api.v1.ui.toast('Location \u201c' + slFinal + '\u201d created ' + slWhere + '.', { type: 'success', autoClose: 2600 });
        }
        return { id: slId, name: slFinal };
    } catch (e) {
        api.v1.error('[AE] spawnLocation:', e);
        api.v1.ui.toast('Failed to create location.', { type: 'error' });
        return null;
    }
}

// [CE-STRIP v2.1.6] Item Template editor (buildItemArchetypeEditContent/refreshItemArchetypeEditModal/openItemArchetypeEditModal/buildItemTemplateRows) removed — Item Templates cut along with Bestiary.


// ── [vNEXT] Add-NPC modal (freeform, scene-grounded) ──────────────────────────
// [v1.19.0 LOCGEN] >>> PAIRED with openAddLocationModal() (near killCharacter, below):
// >>> same three-part shape (module state / build.../ open...), spatial instead of
// -- Destructive confirm -----------------------------------------------------

async function confirmDeleteChar(id: string, name: string): Promise<void> {
    const m = await openEngineModal({ title: 'Confirm Delete', size: 'small', content: [
        { type: 'text', text: `Delete "${name}"? This cannot be undone.`, style: { marginBottom: '16px' } },
        { type: 'row', style: { gap: '8px' }, content: [
            { type: 'button', text: 'Delete', style: { flex: '1 1 0', margin: 0, color: '#ff6b6b' }, callback: async function() { await deleteCharacter(id); m.close(); try { await broadcastCharacterData(); await broadcastSceneState(); } catch (_) {} } },
            { type: 'button', text: 'Cancel', style: { flex: '1 1 0', margin: 0 }, callback: function() { m.close(); } }
        ] }
    ] });
}

// SMART IMPORTER
// ============================================================================
// importPayload(data) — accepts a parsed JSON object and imports whatever
// recognizable blocks it finds. Returns a summary of what was imported.
// All import entry-points (module button, config modal, new-story prompt)
// funnel through this single function so behaviour is always identical.
//
// Recognised top-level blocks (any combination, all optional):
//   config          — GlobalConfig object  → [v1.20.0 IMPORT-MERGE] merged field-by-
//                                            field over the CURRENT config, not the
//                                            engine defaults. Every id-keyed array
//                                            (actionTemplates, factions, species,
//                                            resources, characterResourceDefs,
//                                            relationshipArchetypes, factionResourceDefs,
//                                            stakeDefs, npcArchetypes, itemArchetypes,
//                                            customStaticFields, sheetCategories,
//                                            wizardSections) is upserted by `id` —
//                                            matched items are updated in place, new
//                                            ones appended, anything not mentioned in
//                                            the import is left alone. tierTravelDefaults
//                                            upserts by `templateId`. fieldLabels /
//                                            fieldInstructions / fieldBudgets do a
//                                            shallow key merge. Everything else
//                                            (scalars, contextTemplates, holdingDef,
//                                            time settings) only overwrites when the
//                                            key is actually present in the import, so
//                                            a hand-trimmed partial config (e.g. just
//                                            2 new action templates) merges safely
//                                            instead of resetting the rest to defaults.
//                                            totalGenerations is never imported — it's
//                                            live per-story runtime state.
//   characters      — CharacterRecord[]    → merged into character index
//   character       — CharacterRecord      → single character (not bundle)
//   entities        — EntityRecord[]       → merged into entity index
//   locations       — EntityRecord[]       → backwards-compat alias for entities
//   entity          — EntityRecord         → single entity node
//   npcWeb          — NpcWebEntry[]        → [v1.20.0 IMPORT-MERGE] upserted by `id`,
//                                            same as config arrays (was: full replace)
//   partyState      — PartyState           → [v1.20.0 IMPORT-MERGE] resourceValues is
//                                            a shallow key merge (was: full replace)
//
// Special typed wrappers (detected first, return early):
//   { type: 'character_bundle', character, entity? }
//
// Bare root-level records (no top-level array key):
//   { id, name, ...CharacterRecord }  — no `type` field  → single character
//   { id, name, type, ... }           — has `type` field → single entity
// ============================================================================

// ImportResult interface defined in Section 1 (types block).

// [v1.20.0 IMPORT-MERGE] Generic upsert-by-key merge for GlobalConfig's id-keyed
// arrays — the config-level analogue of what saveCharacter/saveEntity already do
// per-record. Matched items (by keyFn) are replaced in place with the incoming
// version; unmatched incoming items are appended; existing items absent from the
// incoming array are left untouched. Returns the merged array plus tallies so
// callers can report what actually changed.
function mergeArrayById(existing: any[] | undefined, incoming: any, keyFn: (item: any) => string | undefined): { merged: any[]; counts: ImportMergeCounts } {
    const base: any[] = Array.isArray(existing) ? existing.slice() : [];
    const counts: ImportMergeCounts = { added: 0, updated: 0 };
    if (!Array.isArray(incoming)) return { merged: base, counts: counts };
    for (const item of incoming.filter(Boolean)) {
        const key = keyFn(item);
        if (key === undefined || key === null || key === '') continue;
        const idx = base.findIndex(function(x) { return keyFn(x) === key; });
        if (idx >= 0) { base[idx] = item; counts.updated++; }
        else { base.push(item); counts.added++; }
    }
    return { merged: base, counts: counts };
}

// [v1.20.0 IMPORT-MERGE] Shallow key-merge for Record<string, any> config fields
// (fieldLabels, fieldInstructions, fieldBudgets, partyState.resourceValues) —
// incoming keys overwrite matching existing keys; every other key is preserved.
function mergeRecordShallow(existing: any, incoming: any): any {
    const base: any = (existing && typeof existing === 'object') ? { ...existing } : {};
    if (incoming && typeof incoming === 'object' && !Array.isArray(incoming)) {
        for (const k of Object.keys(incoming)) base[k] = incoming[k];
    }
    return base;
}

// [v1.20.0 IMPORT-MERGE] Builds the merged config that replaces `existing`, plus a
// per-category count summary. Deliberately starts from `existing` (the CURRENT
// story's config, already migrated) rather than a fresh default config — a partial
// import that only sets a few fields must never reset the rest to engine defaults.
function mergeConfigForImport(existing: GlobalConfig, incoming: any): { cfg: GlobalConfig; counts: { [category: string]: ImportMergeCounts } } {
    const merged: any = { ...existing };
    const counts: { [category: string]: ImportMergeCounts } = {};
    const byId = function(x: any) { return x && x.id; };

    const idArrayFields: string[] = [
        'sheetCategories', 'customStaticFields', 'relationshipArchetypes',
        'species', 'factions', 'wizardSections', 'conditions'
        // [v2.7.0 CONDITIONS] 'conditions' added — same id-keyed upsert as relationshipArchetypes.
        // [v2.102.0 CE-SWEEP] resources / characterResourceDefs / factionResourceDefs /
        // stakeDefs / actionTemplates removed from this allowlist. All five were deleted from
        // GlobalConfig by earlier CE-STRIP passes, so merging them wrote keys no reader has
        // ever looked at and inflated the per-category import summary with categories the
        // build no longer has. An import file that still carries them is simply ignored now,
        // which is the correct outcome -- there is nothing left to import them INTO.
    ];
    for (const field of idArrayFields) {
        if (incoming[field] === undefined) continue;
        const r = mergeArrayById((existing as any)[field], incoming[field], byId);
        merged[field] = r.merged;
        counts[field] = r.counts;
    }

    // [v2.102.0 CE-SWEEP] tierTravelDefaults merge block removed — Travel was cut at
    // CE-STRIP v2.0.0 and the field no longer exists on GlobalConfig. It was keyed by
    // templateId rather than id, which is why it had its own block down here and why the
    // allowlist prune above did not catch it.

    // Record<string,*> fields — shallow key merge rather than whole-object replace.
    if (incoming.fieldLabels !== undefined)       merged.fieldLabels       = mergeRecordShallow(existing.fieldLabels, incoming.fieldLabels);
    if (incoming.fieldInstructions !== undefined) merged.fieldInstructions = mergeRecordShallow(existing.fieldInstructions, incoming.fieldInstructions);
    if (incoming.fieldBudgets !== undefined)      merged.fieldBudgets      = mergeRecordShallow(existing.fieldBudgets, incoming.fieldBudgets);

    // factionResourceSections is an ordered string[], not id-keyed — union, existing
    // order first, then append any section names the import introduces.
    if (Array.isArray(incoming.factionResourceSections)) {
        const cur: string[] = Array.isArray(existing.factionResourceSections) ? existing.factionResourceSections.slice() : [];
        for (const sec of incoming.factionResourceSections) { if (cur.indexOf(sec) < 0) cur.push(sec); }
        merged.factionResourceSections = cur;
    }

    // Everything else: scalar/object fields only overwrite when the import actually
    // sets them, so an import that never mentions (say) projectGenre can't blank it.
    const passthroughFields: string[] = [
        'contextTemplates', 'lorebookTemplates', 'lorebookFields', 'interfaceMode', 'thoughtIntervalGens',
        'hookIntervalGens', 'ephemeralCap', 'maxDynamicCharacters',
        'autoThoughtsDefault', 'showFieldHeaders', 'generalStyle',
        'defaultBackgroundUrl',
        'projectName', 'projectGenre', 'projectConcept'
    ];
    for (const field of passthroughFields) {
        if (incoming[field] !== undefined) merged[field] = incoming[field];
    }

    // totalGenerations is live per-story runtime state, never imported — always keep
    // whatever the destination story already has, regardless of what the import carries.
    merged.totalGenerations = existing.totalGenerations;

    return { cfg: merged as GlobalConfig, counts: counts };
}

// [v1.20.0 IMPORT-MERGE] Totals added/updated across every category in a
// configCategoryCounts map — used for the compact one-line import summary toast.
function sumMergeCounts(map: { [k: string]: ImportMergeCounts } | undefined): ImportMergeCounts {
    const out: ImportMergeCounts = { added: 0, updated: 0 };
    if (!map) return out;
    for (const k of Object.keys(map)) { out.added += map[k].added; out.updated += map[k].updated; }
    return out;
}

// ── Import Payload (full module importer) ────────────────────────────────────
async function importPayload(data: any): Promise<ImportResult> {
    const result: ImportResult = {
        charCount: 0, entityCount: 0,
        configImported: false, npcWebImported: false, partyStateImported: false
    };

    // 1. Config block — [v1.20.0 IMPORT-MERGE] merged field-by-field over the
    //    CURRENT config (id-keyed arrays upserted, everything else only touched
    //    when the import actually sets it) rather than replaced wholesale — see
    //    the Smart Importer comment block above for the full field-by-field rules.
    if (data.config && typeof data.config === 'object' && !Array.isArray(data.config)) {
        const priorCfg = await loadConfig();
        const mergeRes = mergeConfigForImport(priorCfg, data.config);
        const newCfg = migrateConfig(mergeRes.cfg);
        await saveConfig(newCfg);
        result.configImported = true;
        result.configCategoryCounts = mergeRes.counts;
    }

    const activeCfg = await loadConfig();

    // 2. Character bundle — typed single-export format (char + optional entity)
    //    Detected first and returns early so its keys don't fall through to the
    //    generic `character` / `entity` checks below.
    if (data.type === 'character_bundle' && data.character) {
        await saveCharacter(migrateCharacter(data.character, activeCfg));
        result.charCount = 1;
        if (data.entity && typeof data.entity === 'object') {
            await saveEntity(migrateEntity(data.entity));
            result.entityCount = 1;
        }
        return result;
    }

    // 3. Characters — array, singular block, or bare root record
    if (data.characters && Array.isArray(data.characters)) {
        for (const c of data.characters.filter(Boolean)) {
            await saveCharacter(migrateCharacter(c, activeCfg));
            result.charCount++;
        }
    } else if (data.character && typeof data.character === 'object' && !Array.isArray(data.character)) {
        await saveCharacter(migrateCharacter(data.character, activeCfg));
        result.charCount = 1;
    } else if (data.id && data.name && !data.type && !data.entities && !data.locations && !data.characters) {
        // Bare root-level CharacterRecord — no `type` field distinguishes it from entity
        await saveCharacter(migrateCharacter(data, activeCfg));
        result.charCount = 1;
    }

    // 4. Entities — array (with backwards-compat alias), singular block, or bare root record
    const rawNodes: any[] = Array.isArray(data.entities) ? data.entities
                          : Array.isArray(data.locations) ? data.locations   // pre-v0.9 exports
                          : [];
    if (rawNodes.length > 0) {
        for (const n of rawNodes.filter(Boolean)) {
            await saveEntity(migrateEntity(n));
            result.entityCount++;
        }
    } else if (data.entity && typeof data.entity === 'object' && !Array.isArray(data.entity)) {
        await saveEntity(migrateEntity(data.entity));
        result.entityCount = 1;
    } else if (data.id && data.name && data.type && !data.characters && !data.entities && !data.locations) {
        // Bare root-level EntityRecord — presence of `type` (entity kind) is the signal
        await saveEntity(migrateEntity(data));
        result.entityCount = 1;
    }

    // 5. NPC Web — [v1.20.0 IMPORT-MERGE] upserted by `id`, same as the config
    //    arrays (was: full replace, which silently dropped any web link the
    //    import didn't happen to include).
    if (data.npcWeb && Array.isArray(data.npcWeb)) {
        if (typeof loadNpcWeb === 'function' && typeof saveNpcWeb === 'function') {
            const priorWeb = await loadNpcWeb();
            const webRes = mergeArrayById(priorWeb, data.npcWeb, function(x: any) { return x && x.id; });
            await saveNpcWeb(webRes.merged);
            result.npcWebCounts = webRes.counts;
        }
        result.npcWebImported = true;
    }

    return result;
}

// ============================================================================
// [v0.98] PLAIN-JSON IMPORT / EXPORT
// Uses api.v1.file.save() and api.v1.file.prompt() — no bridge required.
// Produces a human-readable, tool-friendly JSON file using the importPayload()
// schema, fully compatible with the existing smart importer.
// ============================================================================

async function exportAll(): Promise<void> {
    try {
        const xaCfg    = await loadConfig();
        const xaChars  = await loadAllCharacters();
        const xaEntIdx = await loadEntityIndex();
        const xaEnts: EntityRecord[] = [];
        for (const xaM of xaEntIdx.filter(Boolean)) {
            const xaE = await loadEntity(xaM.id);
            if (xaE) xaEnts.push(xaE);
        }
        const xaNpcWeb    = typeof loadNpcWeb    === 'function' ? await (loadNpcWeb as any)().catch(function() { return []; })    : [];

        const xaData = {
            _ae:        true,
            aeVersion:  '0.9.9.2',
            exportedAt: new Date().toISOString(),
            config:     xaCfg,
            characters: xaChars,
            entities:   xaEnts,
            npcWeb:     xaNpcWeb
        };

        const xaSafeName = ((xaCfg as any).projectName || 'ae_world').replace(/[^a-z0-9]/gi, '_').toLowerCase();
        await api.v1.file.save(xaSafeName + '_export.json', JSON.stringify(xaData, null, 2));
        api.v1.ui.toast('Exported: ' + xaChars.length + ' characters, ' + xaEnts.length + ' nodes.', { type: 'success', autoClose: 3000 });
    } catch (e) {
        api.v1.error('[AE] exportAll failed:', e);
        api.v1.ui.toast('Export failed — see engine log.', { type: 'error' });
    }
}

async function importData(): Promise<void> {
    try {
        const raw = await api.v1.file.prompt({ accept: '.json,application/json,text/plain,*/*', readAs: 'text' });
        if (!raw || typeof raw !== 'string') return;

        const data = JSON.parse(raw);
        const result = await importPayload(data);

        const parts: string[] = [];
        if (result.configImported) {
            const cc = sumMergeCounts(result.configCategoryCounts);
            parts.push((cc.added + cc.updated) > 0 ? `settings (${cc.added} added, ${cc.updated} updated)` : 'settings');
        }
        if (result.charCount > 0)      parts.push(result.charCount + ' character' + (result.charCount !== 1 ? 's' : ''));
        if (result.entityCount > 0)    parts.push(result.entityCount + ' node' + (result.entityCount !== 1 ? 's' : ''));
        if (result.npcWebImported) {
            const wc = result.npcWebCounts || { added: 0, updated: 0 };
            parts.push((wc.added + wc.updated) > 0 ? `NPC web (${wc.added} added, ${wc.updated} updated)` : 'NPC web');
        }
        if (result.partyStateImported) parts.push('party state');

        if (!parts.length) {
            api.v1.ui.toast('File loaded but no recognisable AE data found.', { type: 'warning', autoClose: 3500 });
            return;
        }
        api.v1.ui.toast('Imported: ' + parts.join(', ') + '.', { type: 'success', autoClose: 3500 });
        queueSceneStateBroadcast();
    } catch (e) {
        api.v1.error('[AE] importData failed:', e);
        api.v1.ui.toast('Import failed — check that the file is valid JSON.', { type: 'error' });
    }
}

// ============================================================================
// SECTION 26 — HOOK REGISTRATIONS
// All api.v1.hooks.register() calls.
//
//    ADVENTURE ENGINE PIPELINE:
//    onBeforeContextBuild  → world-state AN injection (AE context builder S13)
//    onLorebookEntrySelected → lore ID tracking
//    onContextBuilt        → imperative block (GM note + knowledge query) + probability
//    onGenerationEnd       → token count + runDynamicEngine (S15)
//    onHistoryNavigated    → retry/undo skip flag
//
// ============================================================================

const AE_AN_SENTINEL = '[ Scene State ]';
// [v0.9.7.3 AN-FIX] Sentinel bracketing the wizard-owned region of the persisted AN.
// Final layout of the AN slot at generation time:
//   [user manual content, if any]
//   \n\n[ World Style ]          <- AE_WIZ_AN_SENTINEL (persisted by commitWizardMemory)
//   [wizard style/tone AN sections]
//   \n\n[ Scene State ]          <- AE_AN_SENTINEL (ephemeral, appended per-generation)
//   [quest line + world state + drama]
// Style first so the model frames itself before reading the immediate scene.
// Scene last so it carries the highest recency weight inside the AN slot.
const AE_WIZ_AN_SENTINEL = '[ World Style ]';

// [v1.2.0 WIZMODE] Hard switch: block any user/story-initiated generation while the
// wizard mode is on. Our own yoink call sets _aeYoink.active BEFORE it calls
// api.v1.editor.generate() (see executeYoinkGenerationAttempt), so by the time this
// hook fires for that call, _aeYoink.active is already true and it passes through.
api.v1.hooks.register('onGenerationRequested', async function(params: any) {
    // [FEATURE v2.51.4 ENGINE-THINKING-SIGNAL] Deliberately BEFORE the probe guard below --
    // "any of our thinking" per the user's own framing covers ephemeral/architect probes too,
    // not just user-visible story generation. If that turns out too noisy live (rapid flicker
    // across a busy scene's nested calls), move this after the guard instead.
    try { await _aeThinkingPulse(true); } catch (eEtS) { aeLog('[AE:engine-thinking] start pulse failed:', eEtS); }
    if (_diagProbeActive) return; // [DIAG] api.v1.generate() probe call — not a story generation

    // [v2.37.0 CHARCHAT-DOM-INJECT] v2.36.0's commit-on-Send block is REMOVED from this hook.
    // It appended the draft here on the reading that onGenerationRequested fires "before
    // context is built" and therefore in time. Live test falsified that: the model replied
    // "..." to what was effectively an empty prompt. Rather than chase whether the hook fired
    // or whether NAI snapshots the document before it, the design stopped needing to know --
    // the bridge now writes the turn into NAI's editor at pointerdown on NAI's Send, so the
    // turn is ordinary typed document text before NAI's own click handler even runs and this
    // hook has no job in the chat send path at all. See the CE-INDEX CHARCHAT-DOM-INJECT
    // entry and op 'povclaim' in handleCharChatAction.
    //
    // NOTHING replaces it here deliberately: the whole lesson of v2.36.0 is that this hook is
    // the wrong place to put the user's turn into the document. Do not add it back.

    if (_aeWizardMode && !_aeYoink.active) {
        api.v1.ui.toast('Wizard mode is on \u2014 close it to generate story text.', { type: 'warning', autoClose: 4000 });
        return { stopGeneration: true };
    }
});

api.v1.hooks.register('onBeforeContextBuild', async function(params: any) {

    // [v2.34.2 CHARCHAT-OVERRIDE-LEAK] Nested-generate guard. One of OUR OWN
    // api.v1.generate() calls is in flight (budget probe, generateEphemeral, the image
    // architect — aeDiagGenerate sets this for all of them now). api.v1.generate() fires
    // the full hook lifecycle, so without this the call inherits whatever override the
    // branches below apply and stops being the isolated prompt its caller built. That is
    // exactly what leaked buildCharChatInstruction's bracket block into the document and
    // broke the ephemeral/architect JSON parses. The old log line here fired on every such
    // call once the guard actually covered them all; the question it was asking
    // ("does api.v1.generate build story context?" — yes, it does) is answered and settled
    // in the CE-INDEX, so it is gone rather than left to spam the console every turn.
    if (_diagProbeActive) return;

    // [vNEXT] Yoink hijack active — leave the context alone; our prompt is swapped
    // in at onContextBuilt. Returning nothing means no world-state AN injection.
    if (_aeYoink.active) return;

    // [v2.4.0 WIZLIVE] In-document wizard chat turn. The story prefix (system prompt,
    // memory, lorebook) is left completely untouched — prefix caching must survive the
    // chat — and the Author's Note is deactivated (a tail-of-context change only), per
    // the design: story style directives must not steer chat replies. No world-state
    // injection, no scene lorebook activation. Applied on the dryRun pass too so the
    // cost estimate matches the real turn.
    // [v2.51.0 WIZLIVE-BRACE-WRAP-T1] Wrap any still-unwrapped Director turn so the first
    // message is presented correctly instead of reaching the model raw for one turn.
    // [v2.58.0 WIZLIVE-CTX-STRIP + WIZLIVE-INSTRUCTION] Two structural fixes ported from
    // CharChat's hardened pipeline: (1) Director turns now have their "Director:" header
    // stripped in the model's view — the model sees plain instruction-brace text, removing
    // the prefix it was imitating (mirrors CHARCHAT-CTX-BRACE v2.42.0). (2) A true-bottom
    // instruction (buildWizardChatInstruction) is appended to storyText, immediately before
    // the generation point — mirrors buildCharChatInstruction. These are the two structural
    // decisions CharChat received across v2.24.0-v2.51.0 that WIZLIVE had never gotten.
    if (_aeLiveWiz.active) {
        let wlResult: any = { authorsNote: { active: false, content: '' } };
        // [v2.58.0 WIZLIVE-INSTRUCTION + WIZLIVE-CTX-STRIP] Two changes to storyText:
        // (1) _wizliveCanonicalStoryOverride now strips the "Director:" header from the
        //     model's view (document keeps it), so the model sees plain instruction-brace
        //     text with no prefix to imitate — mirrors CHARCHAT-CTX-BRACE v2.42.0.
        // (2) buildWizardChatInstruction is appended at the TRUE BOTTOM of storyText,
        //     immediately before the generation point — mirrors buildCharChatInstruction.
        //     This is the structural fix for both "model writes as the Director" and
        //     "user input not recognised as instruction": the only reliable position for
        //     a steering directive is the last thing the model reads before generating.
        //     The protocol text (setup paragraph) is still valuable as user-facing
        //     framing, but the model's actual constraint now comes from here.
        try {
            let wlStory = await _wizliveCanonicalStoryOverride(params);
            let wlBase = (wlStory !== null) ? wlStory
                       : ((params && params.storyText && params.storyText.content) ? params.storyText.content : '');
            if (wlBase) {
                wlBase = wlBase.replace(/\s+$/, '');
                wlBase += '\n\n' + buildWizardChatInstruction();
                // [BUGFIX v2.70.0 WIZLIVE-USERTOKEN, mirrors CHARCHAT-USERTOKEN v2.69.0] Same root
                // cause, same fix. buildWizardChatInstruction's last line is a CLOSED bracket block
                // ('[ Write in pure prose... ]'), so the model reads a complete, well-formed thing at
                // the generation point and the likely next token is the chat-template end-of-turn
                // control token \u2014 a zero-length completion with a perfectly normal lifecycle
                // around it, indistinguishable from CharChat's bug until the user's own NAI
                // token-probability capture proved it there. End on a dangling speaker cue instead.
                // UNLIKE CharChat, no companion strip is needed: _wizliveNormalizeDocument already
                // never stamps a 'Wizard:' header on Wizard's replies (only Director turns get
                // header/brace treatment \u2014 see its own comment, "Wizard replies pass through
                // untouched"), and onResponse's WIZLIVE branch does no cleanup at all (early
                // return, raw passthrough). storyText is INPUT context only, never written to the
                // document \u2014 the model's own completion continues PAST 'Wizard:' rather than
                // regenerating it, so the written document stays exactly the header-less prose it
                // always was. Nothing downstream needed to change.
                if (!CE_DIAG.wlNoPrefill) {
                    wlBase += '\n\nWizard:';
                } else {
                    aeLog('[AE:diag] wlNoPrefill ON \u2014 context ends on a closed block (pre-v2.70.0 shape).');
                }
                wlResult.storyText = { active: true, content: wlBase };
            }
        } catch (eWl) { api.v1.error('[AE:wizlive] context override failed \u2014 story text left raw this turn:', eWl); }
        return wlResult;
    }

    // [v2.21.0 CHARCHAT] In-story character chat turn. The OPPOSITE trade to WIZLIVE
    // above: we take the whole prompt (system prompt, lorebook activation, Author's
    // Note, story text) rather than protecting the prefix cache. Story generation
    // cannot run while a chat is open, so every generation reaching this line IS a
    // chat turn — which is what makes applying the override unconditionally safe.
    // Applied on the dryRun pass too, deliberately: that makes NAI's own context
    // viewer the debugging window for the whole subsystem. See the CHARCHAT section.
    if (_aeCharChat.active) {
        // [DIAG CE-DIAG-FLAGS] ccRawContext — leave NAI's context completely untouched for
        // this chat turn. DIAGNOSTIC ONLY, not a real mode: no system prompt swap, no
        // lorebook suppression, no chat-region rebuild, no instruction tail. Isolates
        // whether the override itself (rather than anything downstream of it) is
        // implicated in the empty-reply bug.
        if (CE_DIAG.ccRawContext) { aeLog('[AE:diag] ccRawContext ON \u2014 context override skipped for this chat turn.'); return undefined; }
        return await runCharChatContextOverride(params);
    }

    // ── AE path: Authors Note world-state injection ──────────────────────────
    if (params.dryRun) return;
    diagBudgetSnapshot('STORY', (params && params.continuityId) || null);   // [DIAG] pre-read for a real story turn
    await api.v1.tempStorage.set(STORAGE_LORE_IDS, '[]').catch(function() {});

    // [v0.9.8.5] Scene lorebook activation (static identity + ephemeral equipment).
    // Returned regardless of whether an AN block is produced below.
    let aeResult: any = {};
    try {
        const sceneAct = await buildSceneLorebookActivation(params.lorebookEntries);
        if (sceneAct.lorebookEntries.length > 0) aeResult.lorebookEntries = sceneAct.lorebookEntries;
        if (sceneAct.temporaryLorebookEntries.length > 0) aeResult.temporaryLorebookEntries = sceneAct.temporaryLorebookEntries;
    } catch (eAct) { api.v1.error('[AE] scene activation:', eAct); }

    try {
        // [CE-STRIP v2.6.0 CTX-CUT] Quest line (buildTrackedNarrativeBlock) and Drama
        // block (buildDramaContextBlock) are gone — both functions deleted, both had
        // exactly one caller (here). buildWorldStateBlock alone is now the whole AN
        // body: per-character thoughts + critical hooks. anProtag is still resolved
        // and passed for signature back-compat only — see buildWorldStateBlock's own
        // header comment (pending protagonist pass).
        const anIdx = await loadIndex();
        const anProtagMeta = anIdx.find(function(m: any) { return m.isProtagonist; });
        const anProtag = anProtagMeta ? await loadCharacter(anProtagMeta.id) : null;
        const worldStateBlock = await buildWorldStateBlock(anProtag);

        const fullBlock = worldStateBlock.trim();
        if (fullBlock) {
            // [v0.9.38 AN-IDEMPOTENT] Strip any prior AE region before re-appending.
            // We always append our block LAST, sentinel-prefixed, so the sentinel (or
            // the '\n\n'+sentinel join that precedes it) marks the trailing AE region.
            // Removing it first means N hook passes / N engine copies converge on one copy.
            let existingANraw = (params.authorsNote && params.authorsNote.content) ? params.authorsNote.content : '';
            let anMarker = '\n\n' + AE_AN_SENTINEL;
            let anMarkerIdx = existingANraw.lastIndexOf(anMarker);
            let baseAN = (anMarkerIdx >= 0)
                ? existingANraw.substring(0, anMarkerIdx)
                : ((existingANraw.indexOf(AE_AN_SENTINEL) === 0) ? '' : existingANraw);
            baseAN = baseAN.replace(/\s+$/, '');
            let wrappedBlock = AE_AN_SENTINEL + '\n' + fullBlock;
            aeResult.authorsNote = {
                active: true,
                content: baseAN ? (baseAN + '\n\n' + wrappedBlock) : wrappedBlock
            };
        }
    } catch (e) { api.v1.error('[AE] Author\'s Note injection error:', e); }

    return Object.keys(aeResult).length > 0 ? aeResult : undefined;
});

api.v1.hooks.register('onLorebookEntrySelected', async function(params: any) {
    try {
        if (!params.entryId) return;
        const raw = await api.v1.tempStorage.getOrDefault(STORAGE_LORE_IDS, '[]') as string;
        const ids: string[] = JSON.parse(raw);
        if (!ids.includes(params.entryId)) {
            ids.push(params.entryId);
            await api.v1.tempStorage.set(STORAGE_LORE_IDS, JSON.stringify(ids));
        }
    } catch (e) { api.v1.error('[AE] LoreTracking error:', e); }
});


api.v1.hooks.register('onResponse', async function(params: any) {
    // [DIAG] Probe guard — do not swallow; api.v1.generate returns text via its own value.
    if (_diagProbeActive) return;   // [v2.34.2] nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.
    // [vNEXT] While a yoink generation is active, buffer the streamed chunks and
    // swallow them so nothing reaches the user's document. Inert otherwise.
    // [v1.22.1] Discriminate by continuityId when we have one: a response belonging to a
    // DIFFERENT generation is either a story turn or a late chunk from a generation the
    // watchdog abandoned, and must not be swallowed into the wizard's buffer.
    //
    // FAIL-SAFE: if we never captured a continuityId (older NAI build, or the field is
    // absent), fall back to the pre-v1.22.1 behavior of swallowing while active. Leaking
    // wizard prose into the user's story is far worse than over-swallowing.
    // [v1.2.0 WIZMODE] Swallow ALL output unconditionally while wizard mode is on, and
    // for any zombie continuityId left over from a watchdog-abandoned generation, even
    // after mode has since exited. This replaces the old "leave someone else's text
    // untouched" branch — that was the exact gap that let mismatched/abandoned yoink
    // output leak into the story. Only genuinely-ours chunks get buffered; everything
    // else is swallowed silently rather than passed through.
    const ygZombie = !!(params && params.continuityId && _wizZombieIds[params.continuityId]);
    if (_aeYoink.active || _aeWizardMode || ygZombie) {
        let ygMine = _aeYoink.active && (!_aeYoink.continuityId || !params || !params.continuityId || params.continuityId === _aeYoink.continuityId);
        if (ygMine && params && params.text && Array.isArray(params.text)) {
            _aeYoink.responseText += params.text.join('');
        }
        return { text: [''] };
    }

    // [v2.21.0 CHARCHAT] Clean the reply before it lands in the document. Native
    // generation exposes no per-turn stop sequences, so this regex net plus native
    // turn alternation is the whole anti-impersonation defence.
    //
    // STREAMING: this hook can fire many times per generation with partial chunks, and
    // a cleanup pass cannot run correctly across a chunk boundary (an impersonation
    // marker can straddle two chunks). Returning { seenData: false } while !final tells
    // NAI to re-deliver the same data plus anything new on the next call, so the final
    // call carries the entire reply and we clean it once, whole. On the final call
    // seenData has no effect, per the hook contract.
    // [UNVERIFIED — watch this in P1 testing] whether deferring seenData this way also
    // defers the streamed text appearing in the editor. If replies visibly land all at
    // once instead of streaming in, this is why, and the fix is to clean only on final
    // without the seenData deferral (accepting cross-chunk misses).
    if (_aeCharChat.active) {
        // [v2.45.0 CHARCHAT-THOUGHT-POST] v2.43.0's thoughtPass passthrough is DELETED with the
        // flag it read. It existed because the thought used to arrive through THIS hook (it was
        // NAI's own generation) and was being cleaned as if it were a reply — header stamped,
        // truncated at the first POV name, emotion-parsed. That cannot happen now: the thought
        // is a direct api.v1.generate() call, aeDiagGenerate sets _diagProbeActive around it,
        // and this hook's own probe guard returns before reaching here. Everything below is a
        // reply again, unconditionally, exactly as in v2.37.1.

        // [DIAG v2.63.0 CHARCHAT-RESP-DIAG] Record every call before any early-out. The three
        // early-outs below (!final, text-not-an-array, whitespace-only) were ALL silent, which
        // is why an empty-looking turn has been indistinguishable from a lost one for five
        // versions. See the _ccRespCid declaration for what the counts mean.
        let ccRespCid = String((params && params.continuityId) || '');
        if (ccRespCid !== _ccRespCid) { _ccRespCid = ccRespCid; _ccRespCalls = 0; _ccRespBest = ''; _ccRespFinalSeen = false; }
        _ccRespCalls++;
        let ccRespChunk = (params && Array.isArray(params.text)) ? params.text.join('') : '';
        if (ccRespChunk.length > _ccRespBest.length) _ccRespBest = ccRespChunk;
        aeLog('[AE:charchat:resp] call#' + _ccRespCalls
            + ' final=' + !!(params && params.final)
            + ' isArray=' + (!!(params && Array.isArray(params.text)))
            + ' len=' + ccRespChunk.length + ' bestLen=' + _ccRespBest.length
            + ' head=' + JSON.stringify(ccRespChunk.substring(0, 60)));

        if (!params || !params.final) {
            // [DIAG CE-DIAG-FLAGS] ccNoSeenDefer — do not request re-delivery. The chunk is
            // left untouched (no seenData override) instead of asking NAI to replay it plus
            // future chunks on the next call. _ccRespBest above still tracks the longest chunk
            // seen for the diag summary either way; this only changes what NAI does with the
            // data, not what we observe. Accepts cross-chunk impersonation-marker misses in
            // exchange for testing whether the deferral itself is implicated in the empty-reply
            // failure (CE-INDEX flags this contract behaviour as unverified — see the deferral's
            // own header comment above).
            if (CE_DIAG.ccNoSeenDefer) return;
            return { seenData: false };
        }
        _ccRespFinalSeen = true;

        // [BUGFIX v2.63.0 CHARCHAT-RESP-RESCUE] The deferral safety net. seenData:false asks NAI
        // to re-deliver everything on the next call, and script-types confirms that is the
        // contract ("the same data in addition to any new data" / "if this is the final call,
        // this has no effect"). What the contract does NOT promise is that the FINAL call
        // re-delivers a buffer that was deferred by the call before it. If it does not, the
        // reply is destroyed here, silently, with a perfectly normal generation lifecycle
        // around it — which is exactly the reported symptom. So: if the final call arrives
        // without usable text but we watched real text go past on an earlier call, use what we
        // saw instead of dropping the turn. When the contract behaves as documented this branch
        // never fires and behaviour is byte-identical to v2.62.0.
        let ccFinalRaw = (params.text && Array.isArray(params.text)) ? params.text.join('') : '';
        let ccRawReply = ccFinalRaw;
        if (!ccRawReply.trim() && _ccRespBest.trim()) {
            aeLog('[AE:charchat:resp] RESCUE — the final call carried '
                + (params.text && Array.isArray(params.text) ? 'an empty text array' : 'no text array')
                + ' but ' + _ccRespBest.length + ' chars were delivered earlier this turn and deferred with '
                + 'seenData:false. Using the deferred text. THIS CONFIRMS THE DEFERRAL LOSES REPLIES — '
                + 'see CHARCHAT-RESP-DIAG; the deferral itself should now be removed rather than patched.');
            ccRawReply = _ccRespBest;
        }
        if (!ccRawReply.trim()) {
            aeLog('[AE:charchat:resp] final call and nothing was ever delivered this turn ('
                + _ccRespCalls + ' call(s), longest 0 chars). The model genuinely returned no text — '
                + 'this is NOT a document or cleanup problem, do not look downstream.');
            return;
        }
        let ccEmo = charChatParseEmotion(ccRawReply);
        if (ccEmo) { _aeCharChat.lastEmotion = ccEmo; }
        // [v2.27.0] No thought to parse out of the reply anymore — CHARCHAT-THINK is
        // gone. Whatever this contact is thinking now lives in char.ephemeral (updated
        // after each reply by onGenerationEnd's CHARCHAT branch when
        // charChatFreshThoughts is on — [v2.29.0] moved from a pre-reply call),
        // which is already persisted and already has readers, unlike the old log-only
        // stopgap this replaced.
        // [DIAG v2.67.0 CHARCHAT-OVERRUN-DIAG] Every diagnostic upstream of this point
        // truncates (60 chars in the per-call resp log above, 80 in empty-reply-diag's
        // document dump) -- so nothing in this file has ever shown the FULL raw text the
        // model actually returned. Session 4 theory: charChatCleanReply's anti-impersonation
        // guard only truncates when it finds the POV NAME as a literal header/trailing token;
        // a run-on completion that drifts into a new, UNLABELLED sentence after the Emotion
        // line sails through uncaught and gets written verbatim, leaving a dangling fragment
        // that may be poisoning the NEXT turn's context. This channel is OFF by default
        // (/log charchat:rawfull on) -- it's verbose and single-purpose, meant to be off again
        // once CHARCHAT-OVERRUN-DIAG is closed one way or the other.
        aeLog('[AE:charchat:rawfull] RAW (pre-clean), ' + ccRawReply.length + ' chars: ' + JSON.stringify(ccRawReply));
        let ccCleaned = charChatCleanReply(ccRawReply, _aeCharChat.contactName, _aeCharChat.povName);
        aeLog('[AE:charchat:rawfull] CLEANED, ' + ccCleaned.length + ' chars: ' + JSON.stringify(ccCleaned)
            + (ccCleaned.length === ccRawReply.length ? ' -- cleaning removed NOTHING, raw text was written as-is.' : ''));
        return { text: [ccCleaned] };
    }

    // [v2.54.0] STORY-TURN TOKEN ACCUMULATION (token-mode dynamic cadence). Only reached for
    // genuine story turns — every probe / yoink / wizard-mode / charchat path above has
    // already returned. onResponse streams, so sum tokenIds across the chunks of the SAME
    // generation; a change of continuityId self-resets the running total, so no separate
    // start-of-turn reset is needed. Banked once per turn by onGenerationEnd's story path.
    // Returns nothing, so native streaming behaviour is untouched. Wrapped so a counting
    // failure can never disturb a story turn.
    try {
        if (params && params.continuityId && params.continuityId !== _aeStoryTurnCid) {
            _aeStoryTurnCid = params.continuityId;
            _aeStoryTurnTokens = 0;
        }
        if (params && Array.isArray(params.tokenIds)) {
            for (let _ti = 0; _ti < params.tokenIds.length; _ti++) {
                let _row = params.tokenIds[_ti];
                if (_row && typeof _row.length === 'number') _aeStoryTurnTokens += _row.length;
            }
        } else if (params && Array.isArray(params.text)) {
            // Fallback estimate (~4 chars/token, same ratio wizCountTokens uses) if this
            // build does not populate tokenIds.
            _aeStoryTurnTokens += Math.ceil(params.text.join('').length / 4);
        }
    } catch (eTokAcc) { aeLog('[AE] story-turn token accumulation failed (non-fatal):', eTokAcc); }
});

api.v1.hooks.register('onContextBuilt', async function(params: any) {

    // [DIAG] Probe guard — leave a probe generation's context untouched (no hijack, no injection).
    if (_diagProbeActive) return;   // [v2.34.2] nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.

    // [vNEXT] Yoink hijack — replace the whole context with our prompt. Runs before
    // the dryRun gate and all normal injection so the wizard gen is fully isolated.
    // [v1.22.2 DRYRUN-FIX] onContextBuilt fires TWICE: once with dryRun:true (a costing/
    // preview pass) and once for the real generation, and the two carry DIFFERENT
    // continuityIds. v1.22.1 latched the dryRun's id, so the real generation's
    // onGenerationEnd never matched, was discarded as "foreign", and the yoink promise
    // stranded until the 90s watchdog fired. Every wizard call therefore took 90s and
    // returned nothing. Capture ONLY on the real pass; still hijack the context on both
    // so the dryRun cost estimate reflects our prompt rather than the user's story.
    if (_aeYoink.active) {
        if (!params.dryRun && !_aeYoink.continuityId && params && params.continuityId) {
            _aeYoink.continuityId = params.continuityId;
        }
        return { messages: _aeYoink.messages };
    }

    // [v2.4.0 WIZLIVE] Chat turns get no imperative/GM/knowledge injection — they are
    // conversation, not story. The pending-inject queue stays queued for the next
    // real story turn instead of being consumed here.
    if (_aeLiveWiz.active) return;

    // [v2.21.0 CHARCHAT] Same reasoning as WIZLIVE above: a text message is not a story
    // turn, so no imperative/GM/knowledge injection. The pending-inject queue stays
    // queued for the next real story turn rather than being consumed by a chat reply.
    if (_aeCharChat.active) return;

    // ── AE normal path: gate on dryRun ────────────────────────────────────────
    if (params.dryRun) return;
    const { messages } = params;
    if (!messages || messages.length === 0) return;

    // ── IMPERATIVE BLOCK ─────────────────────────────────────────────────────
    try {
        const impLines: string[] = [];
        // [v0.9.25 E4] pendingEncounter injection removed — STORAGE_PENDING_ENCOUNTER is now a tombstone
        const pendingKnowledge = await api.v1.tempStorage.get(STORAGE_PENDING_KNOWLEDGE) as any;
        if (pendingKnowledge && pendingKnowledge.charName && pendingKnowledge.snapshot) {
            await api.v1.tempStorage.remove(STORAGE_PENDING_KNOWLEDGE);
            impLines.push('[' + pendingKnowledge.charName + '\'s established knowledge of ' + pendingKnowledge.entityName + ': ' + pendingKnowledge.snapshot + ']');
        }
        const pendingInject = await api.v1.tempStorage.get(STORAGE_PENDING_INJECT) as string | undefined;
        if (pendingInject && pendingInject.trim()) {
            await api.v1.tempStorage.remove(STORAGE_PENDING_INJECT);
            impLines.push('[GM: ' + pendingInject.trim() + ']');
        }
        // [CE-STRIP v2.6.0 CTX-CUT] Critical (85%+) hook loop REMOVED from here — it
        // now builds inside buildWorldStateBlock and rides the AN block instead of
        // this splice, merged with that character's thoughts line. See CE-INDEX
        // PASS 9 / Section 13 header for the full rationale.
        // [v2.91.0 WEB-FLATTEN] The priority>=70 npcWeb splice lived here and is DELETED.
        // It was a genuine double-injection: buildWorldStateBlock's AN block already
        // emits a line for EVERY present-pair link, so a 70+ link reached the model twice
        // per generation -- once as '[A & B \u2014 dynamic]' in the AN and again as
        // '[A and B: dynamic]' spliced before the last user message. The AN path is the
        // survivor (same reasoning as the CE-STRIP v2.6.0 critical-hook move directly
        // above). Do not reintroduce a second web path here.
        if (impLines.length > 0) {
            const impBlock = impLines.join('\n');
            const lastUserForImp = messages.map(function(m: any) { return m.role; }).lastIndexOf('user');
            const insertAtImp = lastUserForImp >= 0 ? lastUserForImp : messages.length;
            messages.splice(insertAtImp, 0, { role: 'user', content: impBlock });
        }
    } catch (e) { api.v1.error('[AE] Imperative injection error:', e); }

    // ── BACKGROUND DRAMA ─────────────────────────────────────────────────────
    // [WP-0] Background drama moved to the Author's Note block in

    // ── EQUIPMENT DESCRIPTIONS ────────────────────────────────────────────────
    // [WP-0] Removed. Full equipped-item descriptions now live on each character's
    // lorebook entry (buildLorebookContent "Wearing/Carrying" section), activating
    // with the character's keys instead of loading on every generation.

    // [RETIRED vNEXT] Legacy freeform #tag 1d6 probability engine removed — all skill
    // checks now run through the Quick Action composer (2d6 fail-forward + Stakes).
    return { messages };
});

// ── onGenerationEnd ───────────────────────────────────────────────────────────
api.v1.hooks.register('onGenerationEnd', async function(params: any) {
    try {
        // [FEATURE v2.51.4 ENGINE-THINKING-SIGNAL] First line, deliberately outside every branch
        // below (yoink/orphaned/probe/normal) so it fires exactly once per onGenerationEnd call
        // no matter which of those paths the rest of this handler takes -- pairs 1:1 with the
        // start pulse in onGenerationRequested regardless of how this particular generation ends.
        try { await _aeThinkingPulse(false); } catch (eEtE) { aeLog('[AE:engine-thinking] end pulse failed:', eEtE); }
        // [DIAG] Probe guard — a probe api.v1.generate() must never advance story state.
        if (_diagProbeActive) return;   // [v2.34.2] nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.
        // [vNEXT] Yoink generation finished — hand the captured text back to the
        // awaiting caller and STOP. Must return before the gen counter, auto-triggers,
        // and dynamic engine so a wizard gen never advances story state.
        // [v1.22.1] Only if this end event belongs to OUR generation. A late end event
        // from a watchdog-abandoned generation must not resolve the newer call that has
        // since taken the slot. Same fail-safe as onResponse: with no continuityId
        // captured, behave exactly as before.
        if (_aeYoink.active) {
            let ygEndMine = !_aeYoink.continuityId || !params || !params.continuityId || params.continuityId === _aeYoink.continuityId;
            if (ygEndMine) {
                ae_genInFlight = false;
                if (_aeYoink.resolve) _aeYoink.resolve(_aeYoink.responseText);
                _aeYoink.active = false;
                _aeYoink.resolve = null;
                _aeYoink.reject = null;
                _aeYoink.continuityId = null;
                diagBudgetClose((params && params.continuityId) || null);   // [DIAG] close the YOINK reading
                if (_wizModeExitPending) { await aeCompleteWizardModeExit(); } // [v1.2.0 WIZMODE] resolve a deferred exit now that the yoink is done
                return;
            }
            // An orphaned generation ended. Do not touch _aeYoink; also do not run the
            // story-advancing logic below on its behalf.
            if (params && params.continuityId && _wizZombieIds[params.continuityId]) {
                delete _wizZombieIds[params.continuityId]; // [v1.2.0 WIZMODE] zombie finally resolved — stop tracking it
                aeLog('[AE:wizard] zombie generation ' + params.continuityId + ' ended \u2014 cleaned up.');
            } else {
                aeLog('[AE:wizard] ignoring generation-end from an abandoned/foreign generation.');
            }
            return;
        }

        // [v2.4.0 WIZLIVE] A finished chat turn is not a story turn: release the gen
        // guard, retint the freshly grown chat region, and skip the counter, auto-
        // triggers, and dynamic engine entirely.
        if (_aeLiveWiz.active) {
            ae_genInFlight = false;
            diagBudgetClose((params && params.continuityId) || null);
            // [FEATURE v2.29.0 WIZLIVE-BRACE-WRAP] Runs BEFORE the decoration refresh so
            // the tint is computed against the paragraphs that actually survive the pass —
            // same ordering CharChat's normalize-then-decorate already uses.
            try { await _wizliveNormalizeDocument(); } catch (eWn) { aeLog('[AE:wizlive] brace-wrap pass failed (chat still usable, formatting may be off):', eWn); }
            try { await refreshLiveWizDecorations(); } catch (eLd) { aeLog('[AE:wizlive] decoration refresh failed:', eLd); }
            return;
        }

        // [v2.21.0 CHARCHAT] A finished text message is not a story turn either: release
        // the gen guard, retint the freshly grown chat region, and skip the gen counter,
        // auto-triggers, and the dynamic engine entirely. Letting the dynamic engine run
        // here would let chat turns silently drive ephemeral/mid-range updates — exactly
        // the context poisoning this design promises not to do.
        if (_aeCharChat.active) {
            ae_genInFlight = false;
            diagBudgetClose((params && params.continuityId) || null);
            // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] t0 for this turn's timeline — see the mark
            // helper's own header comment near _ccThoughtSignal for what this whole trace is for.
            _ccRaceDiagMark('main reply landed (outer onGenerationEnd start)');
            // [DIAG v2.63.0 CHARCHAT-RESP-DIAG] The one line that settles "did NAI produce
            // anything at all this turn". Compared by continuityId so a silent turn reports
            // zero rather than reprinting the previous turn's numbers.
            try {
                let ccEndCid = String((params && params.continuityId) || '');
                if (ccEndCid && ccEndCid !== _ccRespCid) {
                    aeLog('[AE:charchat:resp] turn summary \u2014 onResponse NEVER FIRED for this '
                        + 'generation (cid ' + ccEndCid + '). NAI ran a full generation lifecycle and '
                        + 'delivered no response callback at all. Nothing downstream of here can be at '
                        + 'fault; look at the prompt or the generation slot.');
                } else {
                    aeLog('[AE:charchat:resp] turn summary \u2014 calls=' + _ccRespCalls
                        + ' finalSeen=' + _ccRespFinalSeen + ' longestChunk=' + _ccRespBest.length + ' chars.');
                }
            } catch (_eRs) {}

            // [v2.24.0, per user: "maybe we handle it after generation?"] This is that
            // "after". The scaffold-append that used to live here is gone; instead the
            // whole chat region is re-canonicalised now that both this turn's POV message
            // and the reply are in the document — headers applied, stray blank paragraphs
            // dropped, unclosed braces closed. Runs BEFORE the decoration refresh so the
            // tint is computed against the paragraphs that actually survive the pass.
            try { await _charchatNormalizeDocument(); } catch (eNz) { aeLog('[AE:charchat] turn normalisation failed (chat still usable, formatting may be off):', eNz); }
            // [DIAG CE-DIAG-FLAGS] ccSkipDecorations — skips BOTH the bubble-styling pass and
            // the widget clear/rebuild nested inside it (refreshCharChatImageWidgets is only
            // ever called from here). Use ccSkipWidgets instead if only the widget half needs
            // isolating.
            if (CE_DIAG.ccSkipDecorations) {
                aeLog('[AE:diag] ccSkipDecorations ON \u2014 decoration + widget refresh skipped this turn.');
            } else {
                try { await refreshCharChatDecorations(); } catch (eCd) { aeLog('[AE:charchat] decoration refresh failed:', eCd); }
            }
            _ccRaceDiagMark('normalisation + decoration refresh settled');
            let ccCfgEnd = await loadConfig();
            // [v2.45.0 CHARCHAT-THOUGHT-POST] THE THOUGHT FIRES HERE — after the reply, on the
            // transport that never stopped working. This is where v2.29.0 put it, and after
            // v2.38.0-v2.44.1 spent four versions failing to do better, it is where it belongs.
            // Read the CE-INDEX v2.45.0 block before moving it again.
            //   ORDER: after normalisation (the transcript this reads must be settled and
            //   un-merged first) and BEFORE the image pass, so the two nested api.v1.generate()
            //   calls are serialised and _diagProbeActive's scope stays unambiguous — the same
            //   reason the image pass's own comment gives for sitting last.
            //   ONE TURN STALE, BY DESIGN: this describes the reply that just landed and informs
            //   the NEXT one, via buildCharChatInstruction's ccEph read. That is the accepted
            //   trade, not a bug. [CORRECTED v2.62.0] It is NO LONGER "pinned last in context by
            //   v2.43.0 CHARCHAT-TAIL-ORDER" — the Emotion directive is the unconditional final
            //   block now (CHARCHAT-TAIL-TERMINAL); the thought sits directly above it.
            //   AWAITED, not fire-and-forget: the reply is already in the document and
            //   normalised before this starts, so nothing this call does can corrupt it. What it
            //   can still race is the user's NEXT Send — nothing gates NAI's Send button — and
            //   that race is handled by op 'arm' cancelling this call at pointerdown (grep
            //   CHARCHAT-ARM-CANCEL), not by assuming it cannot happen.
            //   Fresh Thoughts OFF is the control: it restores the plain v2.37.1 path exactly.
            if (ccCfgEnd && ccCfgEnd.charChatFreshThoughts && !CE_DIAG.ccNoThought) {
                await _charchatSetBusy('thinking');
                // [DIAG v2.59.0 CHARCHAT-RACE-DIAG, per user's "the thinking indicator might be
                // ending too quickly" hypothesis] This mark is the moment the UI is FIRST told
                // "busy — thinking". Compare its gap from the previous mark (should be near-zero:
                // nothing async happens between normalisation settling and this call) against the
                // gap the NEXT mark shows once the thought call actually returns.
                _ccRaceDiagMark('busyStage=thinking set, calling generateChatEphemeral');
                try {
                    let ccEndThChar = await loadCharacter(_aeCharChat.contactId);
                    if (ccEndThChar) {
                        let ccEndThGen = 0;
                        try { ccEndThGen = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number; }
                        catch (_eEndThG) { ccEndThGen = 0; }
                        await generateChatEphemeral(ccEndThChar, ccCfgEnd, ccEndThGen);
                    } else {
                        aeLog('[AE:charchat:thought] contact could not be loaded \u2014 no thought this turn, previous one stands.');
                    }
                } catch (eEndTh) {
                    // Non-fatal by design, same rule the image pass follows: a failed thought must
                    // never take down a chat whose reply has already landed correctly.
                    api.v1.error('[AE:charchat:thought] post-reply thought failed (chat unaffected, previous thought stands):', eEndTh);
                }
                // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] The gap this mark reports is the thought
                // call's real wall-clock duration — compare against the [AE:gendiag] ms field
                // for the same call to confirm they agree (they should; this is measuring the
                // same await from the outside).
                _ccRaceDiagMark('generateChatEphemeral settled (cancelled, errored, or completed)');
            } else {
                // [DIAG CE-DIAG-FLAGS] This branch is now reached two ways: Fresh Thoughts is
                // genuinely OFF, or ccNoThought forced a skip of the thought call above while
                // Fresh Thoughts is ON. Either way ccNoPrime independently controls whether THIS
                // call fires, so the two flags combine cleanly: ccNoThought+ccNoPrime together
                // isolate a turn with neither nested generate() running at all.
                // [BUGFIX v2.64.0 CHARCHAT-SLOT-PRIME] Fresh Thoughts OFF was the turn that always
                // needed a second Send. With no thought firing between turns, NAI's generation slot
                // was never exercised after this turn's document edits, and the next native Send
                // came back empty. Prime it with a 1-token throwaway on the same cancellable
                // background transport the thought uses. This runs ONLY in the OFF branch: when
                // thoughts are on, generateChatEphemeral above has already exercised the slot, and
                // priming again would just be a second redundant call. See _charchatPrimeSlot.
                if (CE_DIAG.ccNoPrime) {
                    aeLog('[AE:diag] ccNoPrime ON \u2014 slot-prime call skipped this turn.');
                } else {
                    _ccRaceDiagMark('Fresh Thoughts off \u2014 priming the generation slot instead');
                    try { await _charchatPrimeSlot(); }
                    catch (eEndPr) { aeLog('[AE:charchat:prime] prime pass threw (chat unaffected):', eEndPr); }
                }
                _ccRaceDiagMark('slot prime settled (cancelled, errored, or completed)');
            }
            // [v2.32.0 CHARCHAT-IMG] Attachment pass. AFTER normalisation (the text it
            // rewrites must be settled and un-merged first) and after the ephemeral
            // refresh (both make nested api.v1.generate() calls; serialising them keeps
            // the _diagProbeActive guard's scope unambiguous). Non-fatal by design — a
            // failed photo must never take down a working chat.
            if (ccCfgEnd && ccCfgEnd.charChatImages && !CE_DIAG.ccNoImages) {
                // [v2.38.0 CHARCHAT-THINK-FIRST] Staged, so the panel says "sending photo…"
                // instead of sitting silent through an architect call plus a bridge image
                // generation.
                // [BUGFIX v2.61.0 CHARCHAT-IMG-BUSY-FLASH] The busyStage='image' flip moved
                // INTO _charchatProcessImages itself (only once it confirms a real job exists)
                // — this call site used to flip it unconditionally just because the FEATURE
                // was on, flashing "sending photo…" on every turn even when nothing was
                // actually being sent.
                _ccRaceDiagMark('calling _charchatProcessImages (may or may not find a job)');
                try {
                    let ccImgN = await _charchatProcessImages();
                    if (ccImgN > 0) {
                        try { await refreshCharChatDecorations(); } catch (_eccId) {}
                    }
                } catch (eccImg) { api.v1.error('[AE:charchat] image attachment pass failed (chat unaffected):', eccImg); }
                _ccRaceDiagMark('_charchatProcessImages settled');
            }
            // [v2.38.0 CHARCHAT-THINK-FIRST] Idle again — set before the final broadcast so
            // that repaint carries it. _charchatSetBusy broadcasts too, but its
            // no-op-on-same-value guard makes the redundant push free.
            await _charchatSetBusy('');
            // [DIAG v2.59.0 CHARCHAT-RACE-DIAG] The gap from the last checkpoint to HERE, plus
            // the arm handler's own mark (see op 'arm' below), is the number that answers the
            // user's question directly: how long after the UI says "safe to send" does the
            // NEXT Send's arm signal actually arrive, and was anything still in flight when it did.
            _ccRaceDiagMark('busyStage cleared \u2014 turn fully idle, next Send is expected to be safe now');
            // [v2.32.0 CHARCHAT-HUD] Push the grown transcript to the bridge panel. Last,
            // so the payload includes this turn's reply, its normalisation, and any
            // image tag the pass above just resolved.
            try { await broadcastCharChatState(); } catch (_eccBc) {}
            return;
        }

        ae_genInFlight = false; // [v0.9.36] generation finished — release the generate guard
        diagBudgetClose((params && params.continuityId) || null);   // [DIAG] close the STORY reading (no-op if none pending)
        // Skip on inline generations (tooltips, etc.) and retry/undo flagged turns
        if (params?.inlineGeneration) return;
        const skipFlag = await api.v1.tempStorage.get(STORAGE_ENGINE_SKIP) as string | undefined;
        if (skipFlag === 'true') {
            await api.v1.tempStorage.remove(STORAGE_ENGINE_SKIP);
            aeLog('[AE] Engine skipped this turn (retry/undo).');
            return;
        }

        // [v0.9.24 E1] Increment persistent generation count (replaces token estimation).
        try {
            let _genC = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
            _genC = (Number(_genC) || 0) + 1;
            await api.v1.storyStorage.set(STORAGE_GEN_COUNT, _genC);
            aeLog('[AE] Generation count: ' + _genC);
        } catch (e) { api.v1.error('[AE] Gen count increment error:', e); }

        // [v2.54.0] Bank this story turn's tokens onto the persistent counter (token-mode
        // dynamic cadence). _aeStoryTurnTokens was summed across this generation's onResponse
        // chunks; reset both accumulators after banking so the next turn starts clean. The
        // counter advances every turn regardless of mode — cheap, and it means switching to
        // token mode mid-story has a meaningful counter already in place.
        try {
            let _tokAdd = Number(_aeStoryTurnTokens) || 0;
            if (_tokAdd > 0) {
                let _tokC = await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0) as number;
                _tokC = (Number(_tokC) || 0) + _tokAdd;
                await api.v1.storyStorage.set(STORAGE_TOKEN_COUNT, _tokC);
                aeLog('[AE] Token count: ' + _tokC + ' (+' + _tokAdd + ')');
            }
        } catch (eTokBank) { api.v1.error('[AE] Token count bank error:', eTokBank); }
        _aeStoryTurnTokens = 0;
        _aeStoryTurnCid = null;

        // [CE-STRIP v2.0.x] Time auto-advance removed — Clock/Calendar cut.

        aeLog('[AE] Generation complete — running auto-triggers...');
        await runAutoTriggers();
        aeLog('[AE] Generation complete — engaging dynamic engine...');
        await runDynamicEngine();
    } catch (e) {
        api.v1.error('[AE] onGenerationEnd error:', e);
        // [vNEXT] Failsafe — never leave the yoink lock stuck on error.
        if (_aeYoink.active) {
            if (_aeYoink.reject) _aeYoink.reject(e);
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
        }
    }
});

// Skip engine on retry and undo — token stamps shouldn't update when story reverts
api.v1.hooks.register('onHistoryNavigated', async function(params: any) {
    ae_genInFlight = false; // [v0.9.36] safety release if a generation was aborted/navigated
    if (params?.cause === 'retry' || params?.cause === 'undo') {
        await api.v1.tempStorage.set(STORAGE_ENGINE_SKIP, 'true');
    }
});


// [v0.9.22 E5] Intercepts direct player TA-box input and composes any pending
// player flavor into inputText before it is written to the story document.
// Only fires for actual player key-submissions; not triggered by generate().
api.v1.hooks.register('onTextAdventureInput', async function(params: any) {
    try {
        let taFlavor = await api.v1.tempStorage.get(STORAGE_PENDING_FLAVOR) as string | undefined;
        if (taFlavor && taFlavor.trim()) {
            await api.v1.tempStorage.remove(STORAGE_PENDING_FLAVOR);
            let taInput = String((params && params.inputText) || '');
            return { inputText: composeActionPrompt(taInput, taFlavor.trim()) };
        }
    } catch (_e) {}
});

// ============================================================================
// SECTION 27 — UI REGISTRATION & STARTUP
//
// registerEngineUI is the ONLY api.v1.ui.register() call in the file. It builds
// the toolbar button set: one icon-only button per CE_SHELL_ROUTES entry that has
// not opted out with tray:false, plus the three chat-active controls. There is no
// sidebar panel and no native tray (v2.160.0 SWEEP). register() replaces the whole
// set, so ceSyncToolbar re-registers only when the chat-active group needs to
// appear or disappear rather than on every chat turn.
//
// The onScriptsLoaded hook below is the startup sequence, in order:
//   1. registerEngineUI            toolbar buttons
//   2. permissions                 file, lorebook, story, document, decorations
//   3. loadImageSettings           imagePromptFields[] + globalSettings
//   3b. loadConfigFromLorebook     world-pack auto-import, fresh stories only
//   4. buildCharacterDataPayload   seeds cachedCharVisuals before the bridge connects
//   5. initMessaging               HANDSHAKE_REQUEST to the bridge
//   5b-5d. three rehydrations      WIZLIVE, CharChat, story image widgets — each
//                                  re-verified against the live document
// ============================================================================

async function registerEngineUI(): Promise<void> {
    // [v2.160.0 SWEEP] cfg.interfaceMode IS NOW VESTIGIAL EVERYWHERE, not just here. It
    // gated which HUD renderer mounted (bridge / native / both); the native renderer is
    // deleted and setInterfaceMode went with it, so nothing reads the field any more. The
    // GlobalConfig field and its migration default are DELIBERATELY LEFT IN PLACE -- they
    // are persisted record shape, and dropping them would rewrite every stored config for
    // no gain. Do not add a new reader without deciding what the second mode would be.
    // [v2.160.0 SWEEP] THE ce-panel sidebarPanel IS GONE. It mounted buildSidebar,
    // which is deleted with SECTION 20; leaving the registration would have re-registered
    // a panel whose only content was the literal 'Loading' placeholder forever.
    let ext: any[] = [];
    // ONE TRAY BUTTON PER SURFACE, built from CE_SHELL_ROUTES so a new surface costs one
    // line. Icon only, per user -- no `text`, so nothing renders but the glyph. A route
    // opts out with `tray: false` (Settings does; see the array's own comment).
    //
    // THE TRAY AND ceShellNav ARE NOT REDUNDANT: the tray gets you IN from the story, the
    // nav row moves you AROUND without closing the shell. Different jobs, same words.
    //
    // KNOWN GAP, not closed: there is no path to an OFF-SCENE character from the toolbar.
    // Scene's own "show all characters" toggle is what closes it and is not built yet.
    for (let ceTbI = 0; ceTbI < CE_SHELL_ROUTES.length; ceTbI++) {
        if (CE_SHELL_ROUTES[ceTbI].tray === false) continue;
        ext.push((function(rt: any) {
            return { type: 'toolbarButton', id: 'ce-tb-' + rt.id, iconId: rt.icon,
                callback: function() { ceOpenShell(rt.id).catch(function(e) { api.v1.error('[AE:jsxshell] open ' + rt.id + ':', e); }); } };
        })(CE_SHELL_ROUTES[ceTbI]));
    }

    // [v2.131.0 CC-TRAY, per user] Chat-active controls. The bridge's floating chat manager
    // (_ccMgrEl -- Close / Summarize / Delete, anchored under the HUD toggle) dies with the
    // bridge HUD, and all three of its verbs are engine functions already, so they move
    // here. The tray is the right home specifically because it is the only chrome reachable
    // WITHOUT opening a modal, which is exactly what "close the chat I am looking at" needs.
    // DELETE IS DELIBERATELY NOT A ONE-TAP TRAY BUTTON. It opens the Chat surface with the
    // confirm ARMED, so the confirmed action renders as a control that did not exist at the
    // moment of the first press -- DESTRUCTIVE-NEVER-IN-PLACE, which governs every
    // destructive action in this file and not only the jsx ones. The bridge used
    // window.confirm() here; there is none in this sandbox, and inventing a second confirm
    // idiom for the tray would be worse than routing to the one that already exists.
    if (_aeCharChat.active) {
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-close', text: 'Close chat', iconId: 'close',
            callback: function() { endCharChat('save').catch(function(e) { api.v1.error('[AE:charchat] tray close:', e); }); } });
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-summ', text: 'Summarize', iconId: 'align-left',
            callback: function() { ceChatSummarize().catch(function(e) { api.v1.error('[AE:charchat] tray summarize:', e); }); } });
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-del', text: 'Delete chat', iconId: 'trash',
            callback: function() { ceOpenChatConfirmDelete().catch(function(e) { api.v1.error('[AE:charchat] tray delete:', e); }); } });
    }
    await api.v1.ui.register(ext);
}

// [v2.131.0 CC-TRAY] Re-register the UI extension set ONLY when the chat-active button
// group needs to appear or disappear. api.v1.ui.register replaces the whole set, so there
// is no way to add three buttons without rebuilding all of them -- and the one choke point
// that reliably sees every chat transition (broadcastCharChatState) also fires on every
// turn. Hence a change detector rather than an unconditional call: the set changes twice
// per chat, not twice per message. Seeded null so the FIRST sync after startup registers
// once regardless of which state the restored chat is in.
var _ceTrayChatActive: boolean | null = null;
async function ceSyncToolbar(): Promise<void> {
    try {
        let tbWant = !!_aeCharChat.active;
        if (_ceTrayChatActive === tbWant) return;
        _ceTrayChatActive = tbWant;
        await registerEngineUI();
    } catch (e) { aeLog('[AE:hud] tray sync failed:', e); }
}

api.v1.hooks.register('onScriptsLoaded', async function() {
    try {
        // 1. Register NAI UI: one toolbar button per jsx shell route. There is no
        //    sidebar panel and no native tray any more (v2.160.0 SWEEP).
        await registerEngineUI();

        // 2. Permissions
        await api.v1.permissions.request(['fileInput', 'fileDownload', 'lorebookEdit', 'storyEdit', 'documentEdit', 'editorDecorations']);
        await api.v1.timers.sleep(300);

        // 2b. [v2.78.0 FACETS] The v2.76.0 abandoned-draft sweep was REMOVED here. It walked
        //     and loaded every character on every startup to catch a case an ordinary delete
        //     button already handles, and v2.59.0's lazy creation had already reduced that
        //     case to near nothing — a draft now only exists once the author has generated
        //     into it or committed, at which point it is a real character in the roster with
        //     a real delete control. Do not reinstate it: a startup pass over the full cast
        //     is a real cost, and the thing it guarded against is now visible and removable.

        // 3. [CHANGE] Load image settings before bridge connects so auto-snap is ready.
        await loadImageSettings();

        // 3b. [v0.9.7.9] Lorebook world-pack auto-import. Runs only when storyStorage
        //     has no config (fresh story created from a packed scenario). Non-destructive:
        //     existing stories are always skipped. Runs before bridge handshake so the
        //     first SCENE_STATE_UPDATE already reflects the imported world.
        try { await loadConfigFromLorebook(); } catch (eLcInit) { aeLog('[AE:pack] init import error:', eLcInit); }

        // 4. [CHANGE] Pre-seed cachedCharVisuals from storage so getCharacterData() works
        //    immediately on the first generation, even before bridge handshake completes.
        await buildCharacterDataPayload();

        // 5. [CHANGE] initMessaging() — sends HANDSHAKE_REQUEST to bridge. When bridge
        //    ACKs, handleBridgeMessage → broadcastCharacterData + broadcastSceneState.
        await initMessaging();

        // 5b. [v2.4.0 WIZLIVE] Rehydrate an in-document wizard chat left open in this
        //     story (marker re-verified against the live document; stale state cleared).
        try { await restoreLiveWizOnStartup(); } catch (eLw) { aeLog('[AE:wizlive] startup restore error:', eLw); }

        // 5c. [v2.21.0 CHARCHAT] Same rehydration contract for an in-story character chat
        //     (marker re-verified against the live document; stale state cleared and the
        //     pinned max_tokens restored — a stranded 120-token cap would otherwise
        //     silently truncate every story generation).
        try { await restoreCharChatOnStartup(); } catch (eCc) { aeLog('[AE:charchat] startup restore error:', eCc); }

        // 5d. [v2.156.0 STORYIMG] Third rehydration on the same contract: widgets do not
        //     survive a script unload but their anchors do, so the story images are rebuilt
        //     from storyStorage here. _ceStoryImgPrune drops any whose paragraph is gone.
        try { await refreshStoryImageWidgets(); } catch (eSi) { aeLog('[AE:storyimg] startup rebuild error:', eSi); }

        // 6. Story init path
        const rawIndex = await api.v1.storyStorage.get(STORAGE_INDEX);
        const isFreshStory = !rawIndex || (Array.isArray(rawIndex) && (rawIndex as any[]).length === 0);

        if (isFreshStory) {
            queueSceneStateBroadcast();
        }

        aeLog('[AE] Adventure Engine initialized.');
    } catch (e) {
        api.v1.error('[AE] Init error:', e);
    }
});


// ============================================================================
// SECTION 28 — CE UI FOUNDATION (jsx)  [v2.108.0 JSXKIT]
// Stores, the idempotency latch, and the primitive kit that every jsx surface
// is built from. Purely additive: nothing in Sections 1-27 reads anything here.
//
// THREE RULES THIS SECTION EXISTS TO ENFORCE, each paid for by a live probe:
//   1. NO jsx part may trigger api.v1.ui.update() of a tree containing itself.
//      Panel/modal content is registered ONCE; every repaint after that happens
//      inside Preact via store subscription. Violating this is an infinite
//      mount loop, not a slow render - it was hit for real in probe v0.3.1
//      (a useEffect that refreshed its own host panel).
//   2. EVERY POINTER HANDLER GOES THROUGH ceTap(), AND every side-effecting
//      handler goes through ceAction(). Probe v0.2.0 proved onClick fires
//      TWICE per physical tap. These two are NOT interchangeable and v2.109.0
//      shipped believing they were: ceAction holds its latch only for the
//      DURATION of fn(), so it covers a slow write and covers nothing at all
//      for an instant one. ceTap is the guard that does not depend on how
//      long the work takes. See the block above ceTap for the full autopsy.
//   3. EVERY text input is UNCONTROLLED and deduped on value. Probe v0.3.0
//      showed onInput firing three times at word boundaries, twice carrying a
//      STALE pre-keystroke value. Binding value= to state re-enters that race;
//      accumulating in an input handler (count = count + 1) over-counted by 32%
//      in the probe. Read e.target.value, compare, commit once.
//
// ── CE-INDEX v2.139.0 STYLE2 — the kit rebuilt to CE-STYLE v2.0 ─────────────
// Phase C of the roadmap. Scope is SECTIONS 28-35 (the jsx surfaces) ONLY; the native
// Section 17-27 menus are slated for retirement and were deliberately NOT touched, so a
// grep that finds `fontFamily: 'monospace'` or an off-ladder opacity BELOW section 28 is
// finding retired code, not drift.
//
// TOKENS ADDED: lhProse/lhTight (SS3 -- missing from the first CE_T pass), CE_FILL2 (the
// pressed ground, SS3 12%), CE_RING (the focus ring; SS9.1 writes it as "<hue>", but see
// its own note for why chrome must not borrow a character's identity hue).
//
// PRIMITIVES ADDED: ceGroup, ceRow, ceChip, ceMeter, ceCard, ceIconBtn, ceIcon, ceBusy.
// ceGroup/ceRow/ceChip/ceMeter/ceCard/ceIcon HAVE ZERO CALL SITES ON PURPOSE — they are
// what the Phase D re-skin sweep migrates INTO, exactly the status ceField shipped with in
// v2.108.0. DO NOT DELETE THEM IN A DEAD-CODE SWEEP; they are forward dependencies.
//
// ceBtn / ceToggle ARE COMPONENTS NOW (_ceBtnC / _ceToggleC) BEHIND UNCHANGED WRAPPERS.
// SS9 requires press and focus states; there are no CSS interaction pseudo-classes here,
// so state means a hook, and a hook inside a bare helper joins its CALLER's hook list —
// fatal, because surfaces render buttons conditionally and in loops. The wrapper keeps all
// 113 ceBtn and 9 ceToggle call sites byte-identical. ceTap is unaffected and is still the
// only duplicate-tap guard.
//
// THREE CORRECTIONS TO CE-STYLE v2.0 ITSELF, all verified against the typings this patch:
//   - onPointerCancel DOES NOT EXIST (SS2 and SS9.1 both assume it). The pointer family is
//     Down/Up/Move/Over/Out/Enter/Leave. Press release is Up + Leave + onTouchCancel.
//   - SS8's 44px hit wrapper is applied VERTICALLY ONLY. Four-sided expansion overlaps the
//     hit boxes of adjacent buttons in an s2-gap row by 4px. See _ceHit.
//   - SS10.1's progressive busy label (Enhance -> Enhancing) is implemented as an optional
//     per-call-site argument, defaulting to `label + ellipsis`. Mechanical -ing conversion
//     produces garbage on most of the 113 real labels in this file.
//
// GENERATION RAIL (SS10): ceGenStore + a self-rescheduling setTimeout ticker, hung on
// aeDiagGenerate — the sole api.v1.generate() call site — in the same try/finally shape as
// _diagProbeActive so it clears on the error path too. Cancellation is FLAG-CHECKED via
// _ceGenTickGen, never clearTimeout-raced: api.v1.timers.setTimeout returns a
// Promise<number>, so the id always arrives after the callback is scheduled.
// ceBusy IS THE ONLY PERMITTED SUBSCRIBER TO ceGenStore (SS10.2) — a surface subscribing
// repaints several times a second for the whole generation.
// [v2.140.0, per user] GAP CLOSED: executeYoinkGeneration is now wired to the same rail.
// Per the user, yoink and direct are used TOGETHER by design (three yoink runs available
// between direct calls, to widen the effective budget) -- not an edge path, a large share
// of real usage. Traced the full lifecycle before wiring rather than guessing: exactly one
// begin (executeYoinkGenerationAttempt, right before api.v1.editor.generate()) and three
// possible ends (the onGenerationEnd success path, the immediate-reject path inside the
// same function, and ygAttemptWithWatchdog's timeout force-recovery) -- but the wiring
// itself sits ONE LEVEL UP, at executeYoinkGeneration, the single real entry point (18
// call sites) that already wraps error-retry and corrective-retry in one try/finally
// alongside the model-pin restore. Wiring at the attempt level would flicker the rail
// between retries of one logical call; wiring here shows one continuous segment.
//
// NEW STORAGE KEY: 'ce_reduce_motion' on api.v1.storage (ACCOUNT-global, not story). It is
// a property of the reader, not the story file. ceMotionApply MUTATES CE_T's duration
// tokens rather than exposing an accessor, deliberately — see its note; mutation is total
// and cannot miss a call site, which is what SS9.2 actually asks for.
//
// NO BRIDGE MESSAGE ADDED OR CHANGED THIS PATCH.
//
// ── PHASE D SLICE, same patch, per user ("proceed with the sonnet re-skin") ─────────────
// SCOPE: the density reclassification only -- every ceSection() call site sorted into
// Read or Field per SS7's own test ("is this prose, or fields, or records?"), grounded in
// SS7's own worked examples (Profile hero/Journal entries/Position = Read; Profile slots/
// Presets/Settings rows/Studio composer = Field). NOT done this slice: migrating hand-
// rolled record lists (Scene character rows, Settings preset entries, Gallery items) onto
// ceCard -- that is a second, larger, separate risk surface and stayed out on purpose.
//
// COUNT CORRECTED FIRST: an earlier comment claimed "281 call sites" without ever grepping
// it. The real, verified number was 38 real call sites (see the corrected note at ceH1).
//
// ceSection ITSELF WAS WRONG, not just its call sites. SS7.1 specifies "ceD2 head + a
// hairline rule running to the right edge. No box" -- the function was routing through
// ceH3 (the Field eyebrow) for EVERY caller, so Read-density surfaces (Journal, Scene's
// location text, Profile's concept notes) had no visual distinction from a Settings toggle
// row. Rebuilt to ceD2 + trailing rule; every surface that stays on ceSection picks up the
// correct treatment automatically, no per-site edit needed beyond the classification.
//
// 27 OF 38 RECLASSIFIED TO ceGroup (Field): all of Settings (13 -- matches SS7.2's own
// "Settings rows"/"Presets" examples exactly), Profile's Slots/Add a slot/Look/Generation/
// Authoring/Behaviour/Texting persona (7 -- verified by READING each one, not the label:
// "Authoring"/"Behaviour"/"Texting persona" sound like prose but actually wrap
// ceSettingRow toggle clusters), Studio's Default Generation Settings/Describe/Who is in
// it/Render/Prompt Fields (5), Chat's Options/To (2).
// 11 OF 38 STAYED ceSection (Read): Scene's Location/Present, Profile's Concept notes (the
// one genuinely free-text field among Profile's four "prose-sounding" labels), Journal's
// New entry/Entries, Chat's Open chat header, Studio's Compiled Output/Prompt/Gallery x3
// (read-only displayed content, not data entry).
//
// NO THEME VARIABLE IS EVER NAMED HERE. Probe v0.3.1 found the jsx mount
// element has no ownerDocument, so getComputedStyle is unreachable and NAI's
// --theme-* names cannot be read at runtime. Everything derives from inherited
// currentColor instead, which works on light and dark themes alike without the
// kit knowing which is active. If color-mix is unsupported in the sandbox the
// declaration is simply dropped, yielding no border rather than a wrong one.
// ============================================================================

// -- Tokens: sizes only. There is deliberately no color token. ---------------
// [v2.139.0 STYLE2, per user] REBUILT against CE-STYLE v2.0. Two things changed for a
// real reason, not a refresh:
//   fs 13->14, fsSm 11->12.5 -- both were failing legibility in practice ("headers are
//   tiny and dim"), and both are load-bearing enough (fs: 19 call sites: fsSm: 88) that
//   fixing the TOKEN fixes every surface at once, which is the entire point of a token.
//   fsXs is GONE, not renamed -- every one of its 14 call sites got a real role (fsSm,
//   fsKey, or fsMono) in this same patch. See CE-INDEX STYLE2-SWEEP for the reasoning
//   per site; nothing here approximates "small metadata" as a bare pixel value anymore.
// s5/rCard/rPill/ctl/fsD1/fsD2/fsH/fsKey/fsMono/mFast/mBase/mSlow/ease are NEW and
// ADDITIVE -- nothing before this line depended on them, so nothing broke by adding them.
var CE_T = {
    s1: '4px', s2: '8px', s3: '12px', s4: '16px', s5: '24px',
    tap: '44px',        // MINIMUM HIT AREA. Not the same thing as visual size -- see ceIconBtn.
    ctl: '32px',        // standard VISUAL height of an icon control, inside a 44px hit area
    r: '4px', rCard: '10px', rPill: '999px',
    fs: '14px', fsSm: '12.5px',
    // named roles for the new primitives (SS5) -- ceD1/ceD2/ceH/ceKey/ceMono read these
    fsD1: '25px', fsD2: '19px', fsH: '15px', fsKey: '10.5px', fsMono: '11.5px',
    // line-height (SS3). MISSING from the earlier CE_T rebuild -- added here because
    // ceGroup/ceRow (Field density, SS7.2) need lhTight and ceSection prose (SS7.1) needs
    // lhProse, and neither existed as a token before this pass.
    lhProse: '1.6', lhTight: '1.35',
    // motion (SS9). 80ms matches NovelAI's own theme (`transitions.interactive: 0.08s`) --
    // do not retune mFast in isolation, it is deliberately borrowed, not chosen fresh.
    mFast: '80ms', mBase: '140ms', mSlow: '240ms', ease: 'ease-in-out'
};
// The opacity ladder (SS4). THREE VALUES. A fourth anywhere in SECTIONS 28-35 is a bug --
// see CE-STYLE v2.0 SS12 check 2. Kept as a real object (not just documented literals)
// so ceGenBusy/ceMeter/future primitives can reference it directly; existing call sites
// still write the literal ('0.74'/'0.58') per the audit's own grep pattern, and that is
// unchanged and intentional, not a second, competing convention.
var CE_OP = { t1: '1', t2: '0.74', t3: '0.58' };
var CE_DISP = 'Eczar, Georgia, "Times New Roman", serif';   // display face stack, SS5
var CE_MONO_FONT = '"Source Code Pro", Menlo, Consolas, monospace';

// -- Reduced motion (SS9.2) --------------------------------------------------
// `prefers-reduced-motion` IS NOT DETECTABLE HERE -- there is no matchMedia in the worker
// sandbox -- so the switch is an explicit preference, and CE-STYLE v2.0 SS9.2 specifies the
// mechanism precisely: "drops every duration to 0ms by swapping one token. Because
// durations are tokens, that switch is a one-line change and cannot miss a call site."
//
// IT IS IMPLEMENTED AS A MUTATION OF CE_T RATHER THAN A ceDur() ACCESSOR, deliberately.
// An accessor is the tidier shape but it is OPT-IN: every future primitive has to remember
// to call it, and the one that forgets animates through the switch. Mutating the token
// object is TOTAL -- every reader of CE_T.mFast/mBase/mSlow, written before or after this
// line, past or future, gets '0ms' with no call site aware that anything happened. That is
// the property SS9.2 is actually asking for, and it is worth the mild ugliness.
// Safe because every read is at RENDER time (a style object is built per render), never
// captured once at module load, and flipping the switch patches a store, which repaints.
var CE_MOTION = { mFast: '80ms', mBase: '140ms', mSlow: '240ms' };   // the real durations
var CE_REDUCE_MOTION = false;
function ceMotionApply(reduce: boolean): void {
    CE_REDUCE_MOTION = !!reduce;
    CE_T.mFast = reduce ? '0ms' : CE_MOTION.mFast;
    CE_T.mBase = reduce ? '0ms' : CE_MOTION.mBase;
    CE_T.mSlow = reduce ? '0ms' : CE_MOTION.mSlow;
}
// ACCOUNT-LEVEL, not story-level: this is a property of the person reading the screen, not
// of the story file, so it rides api.v1.storage (global script settings) rather than
// GlobalConfig/storyStorage like every other Settings row. Same load/save shape as CE_DIAG
// above -- module var, IIFE loader, async setter -- which is this file's established
// pattern for exactly this tier.
var CE_MOTION_STORAGE_KEY = 'ce_reduce_motion';
(async function _ceMotionInit() {
    try {
        var raw = await api.v1.storage.getOrDefault(CE_MOTION_STORAGE_KEY, '');
        if (String(raw) === '1') ceMotionApply(true);
    } catch (_eMoInit) { /* keep motion on -- the default is the unmodified behaviour */ }
})();
async function ceMotionSet(reduce: boolean): Promise<void> {
    ceMotionApply(reduce);
    try { await api.v1.storage.set(CE_MOTION_STORAGE_KEY, reduce ? '1' : '0'); }
    catch (_eMoSet) { api.v1.error('[AE:jsxkit] reduce-motion persist failed'); }
}

// [v2.168.0 SHELL-WINDOW] WHICH CONTAINER THE SHELL OPENS IN: NAI's full-size modal
// (default, unchanged) or a floating, resizable window. ACCOUNT-LEVEL, same tier and same
// load/save shape as CE_REDUCE_MOTION above and for the same reason -- it is a property of
// the person and the screen they are on, not of the story file.
//
// IT IS TWO THINGS AT ONCE and both are wanted. First, the feature: a full-size modal
// covers the document, which is why _ceWizChatCloseShell has to close the whole shell
// before WIZLIVE writes its marker into the story, and why Chat's contact rows do the
// same. A window makes that hand-off unnecessary rather than merely tolerable.
// Second, the diagnostic: the window swaps NAI's modal content wrapper for a different
// one, so if the ghost-header duplication is happening ABOVE our jsx host it should change
// character or disappear entirely in window mode. That is a cleaner discriminator than any
// probe we can write from inside the host.
//
// TAKES EFFECT ON THE NEXT OPEN, not immediately. The toggle lives on the Settings surface
// INSIDE the shell, so applying it live would mean destroying the container the switch is
// painted in mid-tap; the row says so and the setter toasts it.
//
// THE ONE THING TO WATCH is the height chain. ceJsxPart hard-codes height:100%/minHeight:0
// and ceScreen is a height:100% grid; a modal gives that a definite height to resolve
// against and a resizable window may not. `minPx` on ceJsxPart is the floor that keeps a
// surface from collapsing to nothing if it does not -- it is passed ONLY in window mode, so
// modal behaviour is byte-identical to v2.167.0.
var CE_SHELL_WINDOW = false;
var CE_SHELL_WINDOW_KEY = 'ce_shell_window';
var CE_SHELL_WINDOW_MIN_PX = 420;
(async function _ceShellWindowInit() {
    try {
        var rawW = await api.v1.storage.getOrDefault(CE_SHELL_WINDOW_KEY, '');
        CE_SHELL_WINDOW = (String(rawW) === '1');
    } catch (_eWinInit) { /* keep the modal -- the default is the unmodified behaviour */ }
})();
async function ceShellWindowSet(useWindow: boolean): Promise<void> {
    CE_SHELL_WINDOW = !!useWindow;
    try { await api.v1.storage.set(CE_SHELL_WINDOW_KEY, useWindow ? '1' : '0'); }
    catch (_eWinSet) { api.v1.error('[AE:jsxkit] shell-window persist failed'); }
}

// -- Type scale --------------------------------------------------------------
// [v2.139.0 STYLE2] REBUILT against CE-STYLE v2.0, and this is the one primitive change
// in this patch that is NOT purely additive -- read the whole comment before touching it.
//
// ceH1 and ceH2 are UPGRADED IN PLACE, same name, same call sites, new values -- safe
// because their DOCUMENTED ROLE never changed ("surface title, once per surface" IS
// ceD1's role; "the load-bearing line of a card" IS ceH's role). Every existing caller
// gets the fix for free, which is the point of a token system, and there was no per-site
// judgment call to make: the role was already correct, only the treatment was dated.
//
// ceH3 is DELIBERATELY LEFT ALONE beyond the opacity-ladder sweep already applied to it.
// CE-STYLE v2.0 splits its one job into TWO roles that render differently -- ceD2 (a
// Read-density section head, 19px serif, no uppercase) and ceKey (a Field-density group
// label, 10.5px uppercase, exactly what ceH3 already does). Every existing ceSection()
// call site uses ceH3 for BOTH jobs today, and nothing in the code says which is which --
// that is a per-surface density call (CE-STYLE v2.0 SS7's own test: "is this prose, or
// fields, or records?"), not a mechanical one. Reclassifying these call sites into a
// density is the re-skin sweep (roadmap Phase D), not this pass. ceD2 and ceKey are
// built below as NEW, independently callable primitives so that work has something to
// migrate TO -- they are not wired into ceSection, and ceSection's behaviour is
// unchanged apart from the opacity fix everything else in SECTION 28-35 already got.
// [v2.140.0 STYLE2-D, per user] CORRECTED COUNT: an earlier pass wrote "281 call sites"
// here without grep-verifying it -- exactly the failure this project's own "read before
// patching" rule exists to catch. The real, verified number going into Phase D was 38 real
// call sites. A raw grep for the bare token returns a higher number because it also
// matches this function's own definition and any comment that mentions it by name --
// including this one -- so the count that matters is call SHAPES: a bare invocation, a
// return statement, a body.push, or an assignment, each ending in an open paren the way an
// actual call site does. That is what was actually counted here.
// (Note for future edits: do not quote an unmatched fragment like the ones above, verbatim,
// inside a comment in this file. This exact mistake broke the balance-delta gate once
// already this patch -- see the ceIconBtn note nearby -- and a comment counts exactly as
// much as code for that gate.)
// Left as a record of the mistake rather than silently corrected, since a wrong number
// that was never checked is worth knowing happened at all.
function ceH1(text: any): any {
    return h('div', { style: { fontFamily: CE_DISP, fontSize: CE_T.fsD1, fontWeight: '600',
        letterSpacing: '-0.01em', lineHeight: '1.1' } }, text);
}
function ceH2(text: any): any {
    return h('div', { style: { fontSize: CE_T.fsH, fontWeight: '600', letterSpacing: '-0.005em', lineHeight: '1.3' } }, text);
}
function ceH3(text: any): any {
    return h('div', { style: { fontSize: CE_T.fsKey, fontWeight: '500', letterSpacing: '0.09em',
        textTransform: 'uppercase', opacity: CE_OP.t3 } }, text);
}
// -- NEW roles, additive. Not yet consumed by any existing surface -- see the comment
// above. ceD1/ceH are aliases for the (unchanged-role) primitives above, so new code can
// use either the historical name or the CE-STYLE v2.0 name and get the same function.
var ceD1 = ceH1;
var ceH = ceH2;
// ceD2 -- a Read-density section head (CE-STYLE v2.0 SS5, SS7.1). Serif, no uppercase, no
// tracking: this is a HEADING over prose, not an eyebrow labelling fields.
function ceD2(text: any): any {
    return h('div', { style: { fontFamily: CE_DISP, fontSize: CE_T.fsD2, fontWeight: '600', lineHeight: '1.2' } }, text);
}
// ceKey -- a Field-density group label (CE-STYLE v2.0 SS5, SS7.2). Identical treatment to
// ceH3 today by construction (ceH3 already had this exact job for half its call sites);
// declared as its own function so a call site can say what density it means rather than
// inheriting whichever job ceH3 happened to be doing that day.
function ceKey(text: any): any {
    return h('div', { style: { fontSize: CE_T.fsKey, fontWeight: '600', letterSpacing: '0.1em',
        textTransform: 'uppercase', opacity: CE_OP.t3 } }, text);
}
// ceMono -- numbers, ids, counts, timestamps (CE-STYLE v2.0 SS5). Never prose.
// [v2.139.0 STYLE2 MONO-COMPLIANCE] `opts` is NEW and additive -- every existing bare
// ceMono(text) call is unaffected. Added because three Settings call sites (the
// condition/lorebook macro-hint lines, the diagnostics log dump) needed opacity and/or
// whiteSpace on top of the monospace treatment and had started hand-writing
// `fontFamily: 'monospace'` + `fontSize: CE_T.fsMono` at the call site instead -- the
// generic 'monospace' fallback (not CE_MONO_FONT's Source Code Pro stack) was itself
// drift. SS1's own rule ("A surface composes primitives. It does not write style. If a
// surface needs a value that isn't a token, either the token set is incomplete or the
// primitive is.") says the fix belongs here, not as a comment excusing three call sites.
function ceMono(text: any, opts?: { opacity?: string; style?: any }): any {
    var style: any = { fontFamily: CE_MONO_FONT, fontSize: CE_T.fsMono };
    if (opts && opts.opacity) { style.opacity = opts.opacity; }
    if (opts && opts.style) { for (var k in opts.style) { style[k] = opts.style[k]; } }
    return h('div', { style: style }, text);
}
var CE_LINE = 'color-mix(in srgb, currentColor 14%, transparent)';
// [v2.109.0] A second, heavier hairline. Needed because the accordion's expanded rail and
// a selected card edge have to read as stronger than a divider, and opacity cannot do it --
// the rail sits on the same background as the divider it must out-weigh.
var CE_LINE2 = 'color-mix(in srgb, currentColor 30%, transparent)';
var CE_FILL = 'color-mix(in srgb, currentColor 6%, transparent)';
// [v2.139.0 STYLE2] The pressed/hover ground (SS3, 12%). NEW, and it is what makes SS9.1's
// press state possible at all: a press has to read as a step ABOVE CE_FILL on a control
// whose rest ground may ALREADY be CE_FILL (every 'primary' ceBtn), so a press cannot be
// expressed by reusing the same fill and cannot be expressed by opacity either -- SS4
// reserves opacity for text tiers and this is a ground, not text.
var CE_FILL2 = 'color-mix(in srgb, currentColor 12%, transparent)';
// [v2.139.0 STYLE2] The focus ring (SS9.1: "boxShadow: 0 0 0 2px <hue> -- a real ring,
// never a colour swap"; SS11: "Focus is always visible"). NEW.
// SS9.1 writes the ring colour as "<hue>", which is right for a control that HAS an
// identity hue -- but most controls in the kit have none (SS6.3: "A character with no
// pattern has no hue. That is information; do not fill it with grey."). A focus ring is
// chrome, not identity, so borrowing a character's pattern hue for it would be saying
// something false. 45% currentColor is the neutral answer: heavier than CE_LINE2 so it
// reads as a ring rather than a border thickening, and theme-independent like everything
// else derived from currentColor. A control that DOES own a hue may pass its own.
var CE_RING = 'color-mix(in srgb, currentColor 45%, transparent)';
// [v2.115.0 WRITE-WELL, per user] THE ONE BLACK IN THE KIT, and it is a deliberate
// exception to "no color token" rather than a slip. Every other surface treatment derives
// from currentColor, which TINTS TOWARD THE TEXT -- on a dark theme CE_FILL is LIGHTER
// than its background, so it cannot express a recess at all. A well has to read as depth,
// and depth is black on every theme in existence: a translucent black inset darkens a
// light surface and deepens a dark one, which is exactly the one behaviour needed here.
// USE IT ONLY FOR A DEDICATED WRITE SURFACE -- an input the author composes INTO, as
// opposed to stored prose that happens to be editable. If it starts appearing on read
// surfaces it has stopped meaning anything. 0.14 is tuned for a dark theme; if it reads
// as a grey slab on light, drop it, do not add a second value.
var CE_WELL = 'rgba(0,0,0,0.14)';
// Semantic color is content identity, not chrome - same reasoning as the six
// pattern hues. These stay fixed literals and do NOT track any theme.
// [v2.109.0 SEM-KEY-FIX] 'watch' renamed to 'building'. _ceDramaAttention returns
// 'ask' | 'building' | 'calm', and ceSceneRoot passes att.level straight into ceDot, so
// CE_SEM['building'] was an undefined lookup falling through to 'transparent' -- the amber
// mid-state has never rendered on any surface. The v2.108.0 live test only exercised 'ask',
// which is why it read as working. The key now matches the vocabulary the engine already
// produces, rather than the kit draft's private synonym.
var CE_SEM: { [k: string]: string } = { ask: '#ff6b6b', building: '#e8c07d', calm: 'transparent' };

// -- The image anchor ---------------------------------------------------------
// [v2.117.0 CE-IMG-ATTR, v2.119.0 relocated here from SECTION 30 -- Scene needs this too,
// which makes it kit-level, not Profile-specific, same status as ceField itself] A jsx
// surface names its own elements, so an image anchor here is an ATTRIBUTE, not hidden
// text. jsx-typings_d.txt declares
//     [key: `data-${string}`]: string | number | boolean | undefined
// on ScriptHTMLAttributes — arbitrary data-* attributes are whitelisted on every element.
// THAT IS WHY THIS IS NOT THE CHAT PAINTER'S MECHANISM. AE_CHARCHAT_IMG_SENTINEL and
// AE_CHARCHAT_AVA_SENTINEL hide a magic string in a text node because their anchors are
// NAI DOCUMENT WIDGETS, where the engine can put text inside an element but cannot label
// one. Nothing about that constraint applies in here, and porting it anyway would have
// shipped a bug: the bridge's bounded-climb heuristic ("climb while the ancestor's text is
// only the sentinel") stops on the 1px wrapper the sentinel sat in, because the frame
// above it also holds the '+' placeholder. It would have painted a portrait into a
// one-pixel square.
//
// FLAG-DAY LITERAL, and now there is exactly one: 'data-ce-img' is duplicated bridge-side
// as CE_IMG_ATTR. Change it in one file only and every surface image silently stops
// binding, with no error anywhere.
//
// PAYLOAD IS 'charId|slotName', AND slotName IS A STORAGE SLOT, NOT A RATIO. The v2.111.0
// draft carried the box ratio ('portrait' / 'avatar' / 'scene'), which says which BOX to
// fill but never which IMAGE goes in it. Slot names are the bridge's own vocabulary
// (Avatar, Snapshot, and the 24 canonical emotions — the same 24 the Emotion contract
// pins) and they are already the IndexedDB key suffix, so 'Avatar' or 'Joy' resolves with
// no translation table. GEOMETRY STAYS HERE: this file draws the box, the bridge covers
// it. Ratios are a sizing decision for the surface, not a lookup key.
const CE_IMG_ATTR = 'data-ce-img';
const CE_IMG_SLOT_AVATAR = 'Avatar';

// [v2.136.0 CEGAL] THE SECOND ANCHOR FORM, and the reason the Gallery was blocked until
// now: every anchor before this one was 'charId|slot', and a GALLERY RECORD HAS NEITHER --
// it is keyed by uuid in the bridge's IndexedDB. The KIND therefore rides the charId
// position as an opaque sentinel ('ce-gallery|<uuid>'), which keeps ONE attribute, ONE
// query per root per tick, and leaves the options field working unchanged. Same shape as
// CC_POV_INTERVIEW riding the povId position.
// FLAG-DAY LITERAL: also declared bridge-side as CE_IMG_GAL (bridge v2.101.0). It is
// deliberately not a possible character id.
const CE_IMG_GAL = 'ce-gallery';

// [v2.118.0 CE-IMG-OPTS] A third, optional payload field: 'charId|slot|k=v,k=v'. The
// bridge ignores tokens it does not know, so a fourth option later is additive and needs
// no flag day — only the ATTRIBUTE NAME is a flag-day literal.
//   CE_IMG_COLLAPSE  when the slot is EMPTY, the anchor leaves layout entirely
//   CE_IMG_CONTAIN   show the whole image rather than cover-cropping it
//
// WHY EMPTINESS IS THE BRIDGE'S CALL AND NOT A GATE AT EMISSION HERE. The plan of record
// was for this file to withhold the anchor for a character with no avatar, so no space is
// reserved for a picture that does not exist. THIS FILE CANNOT KNOW THAT. Image bytes live
// only in the bridge's IndexedDB and nothing has ever told the engine what is in there.
// Keeping a record here of "who has an image" would be a MIRROR of that store, and the
// mirror's failure mode is silent and points the wrong way: an image that exists but is
// missing from the record NEVER PAINTS, because the anchor is never emitted. The drift is
// not hypothetical — every portrait already made in the bridge's Portrait Studio predates
// any such record, bridge-side deletes and AE_DELETE_PORTRAIT_CASCADE bypass it, and
// IndexedDB is per-browser-profile while storyStorage follows the account.
// So: ALWAYS EMIT THE ANCHOR, and pass CE_IMG_COLLAPSE when an empty box would waste
// space. display:none removes the element from flex layout INCLUDING its gap, so the
// result is identical to withholding it — decided by the party that actually knows.
// A COSMETIC hint (a launcher cell's weight, a "7 of 26" count) may still be kept
// engine-side if it is ever worth it; a LOAD-BEARING gate may not.
const CE_IMG_COLLAPSE = 'collapse=1';
// [v2.120.0] Same intent as CE_IMG_COLLAPSE for the opposite contents. COLLAPSE is for an
// anchor with nothing inside it (remove the element). SHRINK is for an anchor that WRAPS A
// FALLBACK -- it drops the anchor's own box (size, border, background, radius) and leaves
// the child standing, so an empty avatar frame becomes exactly the glyph it was wrapping.
const CE_IMG_SHRINK = 'shrink=1';
const CE_IMG_CONTAIN = 'fit=contain';

// Folds the anchor onto a props object so every call site (26 Profile slots, Scene's
// present-roster thumbs, and whatever comes after) spells the attribute the same way.
// Returns the SAME object it was handed — call it around the props literal, never on a
// shared one. `opts` is a comma-joined list of the CE_IMG_* tokens above, or omitted.
function ceImgAnchor(charId: string, slot: string, props: any, opts?: string): any {
    var out: any = props || {};
    var v = String(charId || '') + '|' + String(slot || '');
    if (opts) { v = v + '|' + String(opts); }
    out[CE_IMG_ATTR] = v;
    return out;
}

// -- Stores ------------------------------------------------------------------
// Split by CHANGE FREQUENCY, not by feature: ScriptStore.subscribe takes a
// zero-argument listener and useStoreValue returns the whole value, so there is
// no selector layer - every subscriber of a store repaints on any change to it.
// One monolithic store would mean a keystroke in Settings repaints the Map.
//
// These are READ PROJECTIONS. Views never write them; actions write storage and
// then publish. They die with the engine on story switch, which is correct -
// nothing lives only here.
var ceUiStore: any = null;
var ceSceneStore: any = null;

function ceStoresInit(): void {
    if (ceUiStore) return;
    try {
        // [v2.109.0, RENAMED v2.132.0 OPEN-MAP-RENAME] open / profileDrill / profileStep
        // are pure session UI, the same call tempStorage-vs-storyStorage already makes for
        // the field reveal list. They live here rather than in ceProfileStore because
        // navigating must not repaint the record.
        // [v2.114.0 NAV-BACK] `back` is a ONE-DEEP return address, not a history stack:
        // { surface, entityId, label }. It exists because the Journal surface is the first
        // one reachable from two places (Scene and a Profile launcher), so no surface can
        // hard-code where its own Back goes any more. One deep is enough while every
        // screen in this shell is one step from the shell root, and a real stack is not
        // worth its bugs until something is three deep.
        // [v2.145.0 PICKER] `picker` is the SEVENTH-SURFACE SLOT and it lives here, not on
        // profileDrill, because a reference field is chosen from more than one surface --
        // see the block above _cePickerSurface for the full argument. Shape:
        // { kind, ctx } | null, where kind indexes CE_PICKER_DEFS.
        // [v2.152.0 PHOTO-VIEW] `photo` is the EIGHTH-SURFACE-SLOT, shaped and handled
        // exactly like `picker` (see the block above CE_PICKER_DEFS): a full swap over
        // whatever is underneath, intercepted in ceRoot, cleared by ceNav. { charId, slot,
        // label } | null.
        // [v2.161.0 GEN-INLINE] `slotOpts` is the OPEN FIELD GENERATOR, and it is NOT a
        // surface slot -- it renders INLINE under the field it writes to (_ceGenBtn), not
        // as a swap over whatever is underneath. It is still cleared by ceNav for the same
        // reason `picker` is: nothing is written until a candidate is tapped. Shape:
        // { charId, fieldKey, label, instructions, budget, count, method, status,
        //   options[], note } | null. One open at a time, keyed by (charId, fieldKey).
        ceUiStore = createStore({ surface: 'scene', entityId: '', tab: '', sheet: null, busy: {},
                                  open: {}, profileDrill: '', profileStep: 0, back: null,
                                  picker: null, photo: null, slotOpts: null });
        // [v2.149.0 PHASE-G-PRIME] locationImgW/H are the PROJECTED render shape of the
        // location's own image (EntityRecord.imgWidth/imgHeight). 0 means "not read yet or
        // never set" and the view falls back to the same landscape default the Entity
        // surface uses -- absence is the default in both places, stored in neither.
        ceSceneStore = createStore({ ready: false, locationId: '', locationName: '', locationDesc: '',
                                     locationImgW: 0, locationImgH: 0, present: [], away: [] });
    } catch (e) {
        api.v1.error('[AE:jsxkit] store init failed:', e);
    }
}

// -- The idempotency latch ---------------------------------------------------
// opId is PER TARGET, not per verb - 'save:char:'+id, never 'save' - or an
// action on one record blocks the same action on a different one.
// Lives in the store rather than a module var because the button that fired
// must render disabled while in flight, and that is the same fact. Two copies
// of one fact drift.
// [v2.108.1] SHALLOW MERGE, not reconstruction. Every earlier setter rebuilt the
// whole uiStore object by listing its keys, which meant adding one key (`sheet`)
// silently dropped it on the next action. A merge cannot have that bug.
function ceUiPatch(fn: (u: any) => any): void {
    if (!ceUiStore) return;
    try {
        ceUiStore.set(function(u: any) {
            var next: any = {}; var k: string;
            for (k in u) { next[k] = u[k]; }
            var partial = fn(u) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxkit] ui patch failed:', e); }
}

async function ceAction(opId: string, fn: () => Promise<void>): Promise<void> {
    if (!ceUiStore) return;
    try {
        var cur = ceUiStore.get();
        if (cur && cur.busy && cur.busy[opId]) return;       // second fire: drop
        ceUiPatch(function(u: any) {
            var b: any = {}; for (var k in u.busy) { b[k] = u.busy[k]; }
            b[opId] = true;
            return { busy: b };
        });
    } catch (e) { api.v1.error('[AE:jsxkit] latch acquire failed:', e); return; }

    try { await fn(); }
    catch (e) { api.v1.error('[AE:jsxkit] action ' + opId + ' failed:', e); }
    finally {
        try {
            ceUiPatch(function(u: any) {
                var b: any = {}; for (var k in u.busy) { if (k !== opId) { b[k] = u.busy[k]; } }
                return { busy: b };
            });
        } catch (e2) { api.v1.error('[AE:jsxkit] latch release failed:', e2); }
    }
}

// -- The generation rail: the ticker and its store ----------------------------
// [v2.139.0 STYLE2] CE-STYLE v2.0 SS10 states the requirement bluntly: "it must always be
// obvious when the engine is spending a generation. These are metered calls -- the user is
// paying for them -- and a silent one is the worst failure mode on the surface."
//
// SS10.1 asks for three scopes. TWO OF THEM ALREADY EXIST: control scope is ceBtn's busy
// state (rebuilt this patch to keep the label rather than saying "Working..."), and
// surface scope is each surface's own placeholder. THIS IS THE THIRD, SHELL SCOPE, and
// SS10.1 calls it the one that matters most, for a reason worth restating: a generation
// OUTLIVES the surface it was started on. Tap Enhance on a Profile, navigate to Scene, and
// every other indicator is gone -- the button unmounted, the section unmounted. The rail
// is the only thing that survives navigation, because it lives above the router.
//
// IT HAS ITS OWN STORE, and that is a hard requirement rather than tidiness (SS10.2):
// "The ticker owns its own store, and only ceBusy subscribes to it. If a surface
// subscribes, the whole surface repaints several times a second while a generation runs.
// This is the difference between an indicator and a performance bug." Do not merge this
// into ceUiStore -- every surface subscribes to that one.
var ceGenStore: any = null;
var _ceGenLive = 0;          // metered calls currently in flight
var _ceGenTickGen = 0;       // bumped to invalidate an in-flight ticker chain
var _ceGenPhase = 0;

function ceGenStoreInit(): void {
    if (ceGenStore) return;
    try { ceGenStore = createStore({ live: 0, phase: 0 }); }
    catch (e) { api.v1.error('[AE:jsxkit] gen store init failed:', e); }
}

// THE TICKER (SS10.2). No @keyframes, no SMIL, no setInterval, no requestAnimationFrame --
// none of them exist here -- so indeterminate motion is a SELF-RESCHEDULING setTimeout
// chain flipping a value that a CSS transition then glides between.
//
// CANCELLATION IS FLAG-CHECKED, NEVER clearTimeout-RACED. This is the sharp edge:
// api.v1.timers.setTimeout returns a Promise<number> (verified in script-types_d.txt --
// `function setTimeout(callback: () => void, delay: number): Promise<number>`), so the
// timer id arrives AFTER the callback has already been scheduled. A canceller holding that
// id can always lose the race. Instead every tick re-reads _ceGenTickGen at the top and
// returns if it has moved, which cannot lose a race because it is a plain read of a value
// the canceller has already written.
async function _ceGenTick(myGen: number): Promise<void> {
    if (myGen !== _ceGenTickGen) return;          // superseded -- this chain is dead
    if (_ceGenLive <= 0) return;                  // SS10.2: stops when nothing is in flight
    _ceGenPhase = (_ceGenPhase + 1) % 4;
    try { if (ceGenStore) ceGenStore.set({ live: _ceGenLive, phase: _ceGenPhase }); } catch (e) {}
    try {
        await api.v1.timers.setTimeout(function() { _ceGenTick(myGen).catch(function() {}); }, 240);
    } catch (e) { /* a failed reschedule ends the chain; the rail falls back to static */ }
}

// Called by aeDiagGenerate ONLY -- see its own body for why there is exactly one wiring
// point. Both are fire-and-forget and neither may ever throw into the generation it is
// attached to: an indicator failing to appear must not be able to take down the call it
// was meant to indicate.
function ceGenBegin(): void {
    try {
        ceGenStoreInit();
        _ceGenLive++;
        if (ceGenStore) ceGenStore.set({ live: _ceGenLive, phase: _ceGenPhase });
        if (_ceGenLive === 1) {
            // First metered call starts the chain. REDUCED MOTION SKIPS THE TICKER
            // ENTIRELY rather than ticking at 0ms -- a 0ms transition would make the bar
            // teleport between phases four times a second, which is worse than the motion
            // it replaces. The rail still renders, as a static bar; see _ceGenRail.
            if (!CE_REDUCE_MOTION) {
                _ceGenTickGen++;
                _ceGenTick(_ceGenTickGen).catch(function() {});
            }
        }
    } catch (e) { /* never throws into a generation */ }
}
function ceGenEnd(): void {
    try {
        if (_ceGenLive > 0) _ceGenLive--;
        if (_ceGenLive === 0) _ceGenTickGen++;    // invalidate the chain; no clearTimeout
        if (ceGenStore) ceGenStore.set({ live: _ceGenLive, phase: _ceGenPhase });
    } catch (e) { /* never throws into a generation */ }
}

// -- The physical-tap guard --------------------------------------------------
// [v2.110.0 TAP-GUARD] ceAction is an IN-FLIGHT latch, not a duplicate-tap
// guard, and v2.109.0 shipped conflating the two. It acquires busy[opId], then
// awaits fn(). For a storage write or a generation the second fire lands while
// fn is still running and is correctly dropped. For an instant handler -- a
// synchronous store patch returning Promise.resolve() -- the latch is released
// on the very next microtask, long before the duplicate arrives, so the
// duplicate runs in full. ceAction's protection was never idempotency; it was
// the duration of the work, and instant work has none.
//
// That is the whole v2.109.0 surface bug. Every accordion head toggled open and
// then shut again on one tap (ceToggleOpen is its own inverse). Worse, the
// drill Back button left the character entirely: between the two fires Preact
// re-rendered and, because both headers render a ceBtn into the same slot of
// ceHeader, PATCHED THE onClick PROP ON THE REUSED <button> NODE. Fire one ran
// 'clear the drill'; fire two ran 'go to Scene' off the same physical element.
// Handlers that happened to be idempotent (a drill set to a fixed value) came
// through unharmed, which is exactly why the launcher grid looked fine and hid
// how general the fault was.
//
// Two properties of that failure fix the shape of the guard:
//   - IT CANNOT BE KEYED ON opId. The back button's opId differs between the
//     two fires ('nav:profileback' then 'nav:scene'), so a per-op guard misses
//     the worst case. One physical tap is one action, whatever that action
//     turns out to be. The guard is global.
//   - IT BELONGS AT THE EVENT BOUNDARY AND NOWHERE ELSE. Never nest it. An
//     outer ceTap that accepts stamps the clock, so an inner ceTap sees dt~0
//     and drops the real work. Guard where the event enters (ceBtn, ceListRow,
//     a raw onClick), never inside the state function it calls.
//
// CE_TAP_MS IS PROVISIONAL AND DELIBERATELY INSTRUMENTED. Probe v0.2.0 recorded
// THAT onClick fires twice, never how far apart -- the only measured number in
// this family is the sibling onInput probe's ~10ms machine-speed gap. 120ms is
// ~10x that and still under a deliberate double-tap (~150ms+), so the +/-
// pressure steppers stay usable. Run `/log tapguard` on a live session, read
// the real gap off the accept/drop lines, and tighten this to evidence. Do not
// leave it inferred forever.
var CE_TAP_MS = 120;
var _ceTapAt = 0;
var _ceTapLastOp = '';

function ceTap(opId: string, fn: () => void): void {
    var now = Date.now();
    var dt = now - _ceTapAt;
    if (_ceTapAt && dt >= 0 && dt < CE_TAP_MS) {
        aeLog('[AE:tapguard] DROP ' + opId + ' ' + dt + 'ms after ' + _ceTapLastOp);
        return;
    }
    aeLog('[AE:tapguard] pass ' + opId + ' +' + (_ceTapAt ? dt : 0) + 'ms');
    _ceTapAt = now;
    _ceTapLastOp = opId;
    try { fn(); }
    catch (e) { api.v1.error('[AE:jsxkit] tap ' + opId + ' failed:', e); }
}

// [v2.134.0 TAB-SCOPED, per user] ceUiStore.tab IS SHELL-GLOBAL -- one slot shared by
// every surface -- so a raw tab id is ambiguous the moment a SECOND surface wants tabs.
// Left as-is, leaving Settings on 'system' and then opening Images would hand Images a
// tab id it does not own; Settings degrades safely today only because it falls back on an
// unrecognised value, which is luck, not design.
// THE FIX IS THE CHEAP ONE, taken while there is still exactly one consumer: the stored
// value is NAMESPACED as '<surface>:<tabId>', and a surface only ever sees its own.
// Chosen over moving `tab` per-surface-store because it is two helpers rather than a new
// field on every future surface store, and it keeps ceNav's existing optional `tab`
// argument meaningful (a nav can still deep-link straight to a tab).
// A stored value with no prefix, or one belonging to another surface, reads as the
// fallback -- so no migration is needed and a stale value can never cross surfaces.
function ceTabGet(surface: string, fallback: string): string {
    var raw = '';
    try { var u: any = ceUiStore ? ceUiStore.get() : null; raw = String((u && u.tab) || ''); } catch (e) { raw = ''; }
    if (!raw) return fallback;
    var cut = raw.indexOf(':');
    if (cut < 0) return fallback;
    if (raw.slice(0, cut) !== String(surface)) return fallback;
    var id = raw.slice(cut + 1);
    return id || fallback;
}
function ceTabSet(surface: string, id: string): void {
    if (!ceUiStore) return;
    try { ceUiPatch(function() { return { tab: String(surface) + ':' + String(id || '') }; }); }
    catch (e) { api.v1.error('[AE:jsxkit] tab set failed:', e); }
}

function ceNav(surface: string, entityId?: string, tab?: string, back?: any): void {
    // Routing is a VALUE, not a call stack. Any card action navigates by setting
    // this, which is what replaces DOM-host focus hacks.
    // [v2.114.0 NAV-BACK] `back` is OPTIONAL and clearing: a nav that does not pass one
    // is a nav to a top-level place, and it must wipe the previous return address rather
    // than inherit it, or Back eventually points at a screen nobody came from.
    if (!ceUiStore) return;
    try {
        ceUiPatch(function() {
            // [v2.145.0 PICKER] A nav CLOSES an open picker, same clearing reason `sheet`
            // has: the picker commits on the tap that chooses, so there is no staged state
            // to lose and leaving is identical to Cancel. A picker left set across a nav
            // would re-open over the destination surface.
            // slotOpts clears for the same reason and with the same guarantee: nothing is
            // written until a candidate is tapped, so leaving loses only generated
            // candidates, never authored text.
            return { surface: surface, entityId: entityId || '', tab: tab || '',
                     sheet: null, picker: null, photo: null, slotOpts: null, back: back || null };
        });
    } catch (e) { api.v1.error('[AE:jsxkit] nav failed:', e); }
}

// -- The shell nav ------------------------------------------------------------
// [v2.129.0 SHELL-NAV] ONE DOOR, N SURFACES. Before this, every jsx surface needed its own
// toolbar button AND its own modal opener. The tray had reached EIGHT buttons with TWO of
// them labelled "Map" (native `ae-tb-map` and jsx `ce-tb-map`) -- a live collision
// introduced by v2.127.0. Adding Chat, Settings and Images the same way would have made
// eleven, with duplicate Journal and Chat as well. It also gives Journal a top-level door
// (it was previously reachable ONLY from Scene or a character Profile) WITHOUT spending a
// ninth button on it.
//
// SHAPE FOLLOWS THE LAUNCHER (CE-STYLE 10.2), NOT THE BUTTON (9): a wrapping row of text
// links at label scale, no icons. 10.2's reasoning -- "six abstract nouns do not have six
// unambiguous glyphs" -- applies verbatim here, to very nearly the same six words. Active
// reads at FULL and inactive at FAINT, which is the launcher's own has/has-not treatment
// reused rather than a second idiom invented for the same job.
//
// KNOWN STYLE TENSION, FLAGGED RATHER THAN SILENTLY RESOLVED: CE-STYLE 4 calls 44px "a hard
// floor for anything tappable" and "not negotiable per surface", while 10.2 DECIDES the
// launcher is a compact text-link row (~19px at fsSm) and 12's audit has no tap-height
// check at all. Both cannot be followed here. This follows 10.2 because it is the closer
// precedent (same shape, same words, same job) and the more recent decision, and because a
// 44px nav plus a 44px header would spend a quarter of a phone's vertical budget on chrome
// before any content. THE AUTHOR SHOULD SETTLE WHICH RULE GOVERNS -- and whichever wins
// should govern the launcher and this row together, because they are now visibly the same
// component rendered twice.
//
// ADDING A SURFACE IS ONE LINE HERE plus one branch in ceRoot. That is the entire point:
// Chat, Settings and Images are each a two-line change instead of a button, an opener, a
// modal id and a second shell to keep in sync.
//
// [v2.131.0 SHELL-TRAY] AMENDED, one claim only: the line above about Chat/Settings/Images
// adding "ZERO further buttons" no longer holds -- registerEngineUI now generates one tray
// button PER ROUTE in this list, per user. What survives intact is the part that mattered:
// the opener, the modal id and the shell are still shared, so a surface still costs one
// line here and one branch in ceRoot, and the tray button comes along for free rather than
// being hand-registered. The nav row itself is unchanged and still not redundant with the
// tray -- see registerEngineUI's own note on which one does which job.
// [v2.131.0 SHELL-TRAY] `icon` is new and is consumed by registerEngineUI, NOT by
// ceShellNav -- the nav row is deliberately iconless (CE-STYLE 10.2: "six abstract nouns
// do not have six unambiguous glyphs"), but a NATIVE toolbarButton takes an iconId and
// looks broken without one. Every value here is checked against the IconId union in
// script-types_d.txt; do not add a route with an invented icon name.
// ONE ROUTE = ONE NAV ITEM + ONE TRAY BUTTON + ONE ceRoot BRANCH. That is still the whole
// cost of a new surface.
// [v2.138.0 TOOLBAR-REORG, per user] Order is now the surface list's order (map, scene,
// chat, journal, images, settings) rather than build order -- this array drives BOTH
// ceShellNav (the in-shell tab row, unfiltered, every route) AND the native toolbar tray
// loop in registerEngineUI (filtered on `tray`), so reordering it here reorders both at
// once, which is what was asked for ("order... in the toolbar and menu").
// `tray: false` (Settings only) keeps a route ON the nav row but OFF the native tray --
// per user: "remove from toolbar but keep on tabs row." Every other route defaults to
// tray-visible; omit the key rather than writing `tray: true` everywhere.
// Scene's icon is 'users' now, not 'compass' -- per user, "Scene should be the people
// icon." This only touches the native tray button; ceShellNav is deliberately iconless
// (CE-STYLE 10.2) and never reads `.icon`.
var CE_SHELL_ROUTES: any[] = [
    { id: 'map',      label: 'Map',      icon: 'map' },
    { id: 'scene',    label: 'Scene',    icon: 'users' },
    { id: 'chat',     label: 'Chat',     icon: 'message-circle' },
    { id: 'journal',  label: 'Journal',  icon: 'book' },
    { id: 'images',   label: 'Images',   icon: 'image' },
    // [v2.155.0 JSXWIZARD] SECTION 37. Placed before Settings because that is the surface
    // list's own order. `tray: false` is surface_list line 43 verbatim -- nav row only.
    { id: 'wizard',   label: 'Wizard',   icon: 'star', tray: false },
    // [v2.132.0 SETTINGS-JSX] Fifth route. [v2.138.0] Off the tray, on the nav row -- see
    // the note above this array. Last in the list per the surface list's own ordering,
    // which puts Settings after Wizard; Wizard is not a CE_SHELL_ROUTES entry (still
    // native, see registerEngineUI), so this is simply last among the jsx routes.
    // [v2.166.0 GLYPH-SWAP] `glyph` is read ONLY by ceShellNav and ONLY to decide whether
    // this cell paints an icon instead of its word. `label` stays and is still the
    // aria-label/title, so the route is never nameless to a screen reader or a long-press.
    // `icon` is the NATIVE tray's IconId and is a different registry -- do not merge them.
    { id: 'settings', label: 'Settings', icon: 'settings', tray: false, glyph: 'settings' }
];

function ceShellNav(active: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_SHELL_ROUTES.length; i++) {
        kids.push((function(rt: any) {
            var on = (rt.id === active);
            var glyph = (String(rt.glyph || '') === 'settings');
            return h('div', {
                key: 'shellnav_' + rt.id,
                role: 'button', tabIndex: 0,
                'aria-label': rt.label,
                'aria-current': on ? 'page' : undefined,
                // The word cells carry their own label, so a title there is redundant
                // chrome; the glyph cell has no visible word and needs one.
                title: glyph ? rt.label : undefined,
                onClick: function() {
                    // ceTap at the event boundary, per TAP-GUARD -- never nested inside.
                    ceTap('shellnav:' + rt.id, function() {
                        // Re-navigating to the surface you are already on would wipe
                        // entityId/back for no reason; a no-op is the honest response.
                        if (!on) { ceNav(rt.id); }
                    });
                },
                style: {
                    // [v2.166.0 NAV-ONELINE, per user "the main header menu tabs has started
                    // to wrap"] flexShrink 0 + nowrap on the label is what makes the row's
                    // overflow behaviour PREDICTABLE: without it the flex items squash and
                    // hyphenate before the container ever scrolls, which is the ugly middle
                    // state between one line and two.
                    cursor: 'pointer', fontSize: CE_T.fsSm, letterSpacing: '0.01em',
                    display: 'flex', alignItems: 'center',
                    flex: '0 0 auto', whiteSpace: 'nowrap',
                    padding: CE_T.s1 + ' 0',
                    // Opacity ladder (CE-STYLE v2.0 SS4): full for the active
                    // destination, t3 for the rest -- SS4 names "inactive tabs" as the
                    // literal example of t3. 0.42 was v1.2's `faint`, which SS4 measured
                    // at 3.9:1 and failed outright.
                    opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, glyph ? ceIconSettings() : rt.label);
        })(CE_SHELL_ROUTES[i]));
    }
    // [v2.166.0 NAV-ONELINE, per user] THE ROW WRAPPED BECAUSE IT GREW, not because it was
    // badly built: it was five routes at v2.132.0 and is seven now (Wizard landed in
    // v2.155.0), and seven words at gap s4 measure past a portrait phone. Three changes,
    // each doing a measurable share and none of them shrinking the type -- "compact while
    // legible" rules out the one lever that would have been easiest:
    //   gap s4 -> s3            six gaps, 24px back
    //   letterSpacing .04 -> .01em   ~20px back across 39 characters
    //   Settings word -> gear   ~38px back, and see ceIconSettings for why the gear is the
    //                           one label allowed to become a glyph here
    // TOGETHER THOSE FIT SEVEN ROUTES ON ONE LINE at a nominal 360px surface. nowrap +
    // overflowX is the SAFETY NET, not the fix -- an eighth route, a wider word, or a large
    // system font scrolls rather than silently going back to two rows, and a row that
    // scrolls is a state the author can SEE and act on. A wrapped row is not.
    return h('div', {
        style: {
            display: 'flex', flexWrap: 'nowrap', gap: CE_T.s3,
            alignItems: 'center', overflowX: 'auto',
            padding: CE_T.s2 + ' ' + CE_T.s3,
            borderBottom: '1px solid ' + CE_LINE,
            flex: '0 0 auto'
        }
    }, kids);
}

// Reuses the EXISTING payload builder rather than reimplementing it. That is
// what makes each surface's AE_* message pair deletable later: the builder gets
// re-pointed at a store instead of at broadcastToTM.
// NOTE: deliberately does NOT go through queueSceneStateBroadcast(), which
// opens with `if (!isBridgeReady) return;` and so never runs for a bridge-less
// user - exactly backwards for an engine-native surface.
async function cePublishScene(): Promise<void> {
    if (!ceSceneStore) return;
    try {
        var p: any = await buildSceneStatePayload();
        if (!p) {
            ceSceneStore.set(function(s: any) {
                return { ready: true, locationId: '', locationName: '', locationDesc: '',
                         locationImgW: 0, locationImgH: 0,
                         present: s.present, away: s.away || [] };
            });
            return;
        }
        // [v2.144.0 PHASE-G] THE AWAY LIST AND THE CARD FIELDS ARE BUILT HERE, NOT IN
        // buildSceneStatePayload. That function's output is ALSO the bridge broadcast
        // (queueSceneStateBroadcast), and SceneCharacterInfo is a typed contract shared with
        // it; widening it to carry role/pattern for one jsx surface would put this surface's
        // display needs into a cross-artifact payload. This is the jsx PROJECTION, which is
        // where projection-only fields belong. loadAllCharacters is already a cheap engine
        // read that buildSceneStatePayload just did -- one more is not worth a plumbing
        // change that reaches the bridge.
        var chars: any[] = [];
        try { chars = await loadAllCharacters(); } catch (eA) { chars = []; }
        var byId: any = {};
        for (var ci = 0; ci < (chars || []).length; ci++) {
            if (chars[ci] && chars[ci].id) { byId[String(chars[ci].id)] = chars[ci]; }
        }
        // Present: the payload's own list (it carries the attention read), enriched.
        var pres: any[] = [];
        var rawPres: any[] = p.presentCharacters || [];
        for (var pi = 0; pi < rawPres.length; pi++) {
            var rp: any = rawPres[pi];
            var src0: any = byId[String(rp.id)] || {};
            pres.push({
                id: rp.id, name: rp.name, entityId: rp.entityId || '',
                briefDescription: rp.briefDescription || '',
                isProtagonist: !!rp.isProtagonist,
                attention: rp.attention || { level: 'calm', reason: '' },
                role: String(src0.occupationRole || ''),
                pattern: String(src0.pattern || '')
            });
        }
        // Away: every ACTIVE character who is not present. Archived characters stay out --
        // "show all" means all of the cast, not all of the history.
        var away: any[] = [];
        for (var ai = 0; ai < (chars || []).length; ai++) {
            var ac: any = chars[ai];
            if (!ac || !ac.id) continue;
            if (ac.active === false) continue;
            if (ac.scenePresent) continue;
            away.push({
                id: String(ac.id), name: String(ac.name || 'Unnamed'),
                entityId: String(ac.entityId || ''),
                briefDescription: String(ac.briefDescription || ''),
                isProtagonist: !!ac.isProtagonist,
                attention: { level: 'calm', reason: '' },
                role: String(ac.occupationRole || ''),
                pattern: String(ac.pattern || '')
            });
        }
        // [v2.149.0 PHASE-G-PRIME] THE LOCATION'S IMAGE SHAPE, READ HERE AND NOWHERE ELSE.
        // Projection-only for exactly the reason role/pattern above are: EntityMeta does not
        // carry imgWidth/imgHeight, and widening SceneStatePayload to reach them would put a
        // jsx surface's display need into the payload the bridge also consumes.
        // WHY THE SHAPE AT ALL RATHER THAN A FIXED LANDSCAPE BOX: the frame is drawn here and
        // the image is painted over it by the bridge with object-fit:cover, so a frame that
        // disagrees with the stored shape does not letterbox -- it CROPS, silently, and the
        // user's only clue is that the picture they generated is missing its edges.
        // THE ROOT SENTINEL IS SKIPPED, NOT LOADED. AE_ROOT_LOCATION_ID deliberately has no
        // entity behind it (buildSceneStatePayload synthesises a stand-in), so loadEntity
        // would be a guaranteed miss on every publish in a location-less world.
        var locImgW = 0; var locImgH = 0;
        try {
            if (p.locationId && p.locationId !== AE_ROOT_LOCATION_ID) {
                var locEntRec: any = await loadEntity(String(p.locationId));
                if (locEntRec) {
                    locImgW = Number(locEntRec.imgWidth) || 0;
                    locImgH = Number(locEntRec.imgHeight) || 0;
                }
            }
        } catch (eLI) { locImgW = 0; locImgH = 0; }
        ceSceneStore.set({
            ready: true,
            locationId: p.locationId || '',
            locationImgW: locImgW,
            locationImgH: locImgH,
            locationName: p.locationName || '',
            locationDesc: p.locationDescription || '',
            present: pres,
            away: away
        });
    } catch (e) {
        // Failure leaves the PREVIOUS value in place. Laziness fails toward
        // stability - a stale view beats a blank one.
        api.v1.error('[AE:jsxkit] scene publish failed:', e);
    }
}

// -- Kit primitives ----------------------------------------------------------

// [v2.157.0 GHOST-HEADER-PROBE] DIAGNOSTIC ONLY -- remove once the ghost-header bug is
// closed. Reported symptom: Profile -> Images drill -> drill's own back button leaves the
// drill's '\u2190 Profile' header rendered UNDER the real header, unclickable, and it
// COMPOUNDS -- re-entering Images stacks a second ghost. Nothing in ceUiPatch /
// _ceProfileDrill touches ceUiStore.back, and that '\u2190 Profile' string exists at
// exactly one call site (ceProfileRoot's dBack), so what is on screen is a STALE RENDER of
// the drill header, not a second live one. A null-vs-element diff at a fixed tree position
// is something Preact removes cleanly, and a ghost that ACCUMULATES is not reconciliation
// behaviour at all -- it is the signature of render() being called into a NEW host element
// while the previous host is still in the DOM (the old tree is then orphaned from Preact's
// diff but still painted).
//
// This probe answers exactly that, and nothing else: how many times onMount fires per part
// id, whether it is handed the SAME element each time, whether that element already had
// children before we rendered into it, and whether the PREVIOUS element is still connected.
// Off by default (aeLog channel); turn on with `/log jsxmount on`, reproduce, read the log.
//
// READING IT: one mount per id per shell open is correct. A second mount for 'ce-shell-jsx'
// with same=false and prevConnected=true is the bug, and the count will track the number of
// ghosts on screen.
var _ceMountCount: { [id: string]: number } = {};
var _ceMountElem: { [id: string]: any } = {};

// [v2.169.0 HOST-ORPHAN -- REAL, BUT NOT THE GHOST. See the v2.170.0 amendment at the end
// of this block before believing anything in the middle of it.] `/ce ghost` after six drill
// cycles reported:
//
//     mount ce-shell-jsx x6
//     [0] DIV kids=1 -> [0.0] DIV kids=2 -> nav row (7) + body
//
// SIX MOUNTS FOR ONE SHELL OPEN, and the tree inside the newest host CORRECT AND SINGLE.
// So nothing was ever wrong with what we render. NAI calls onMount again -- once per drill
// transition -- with a NEW host element each time, and the previous host is left in the
// document still painting the tree we last rendered into it. Preact is not at fault and
// cannot help: each host is a separate render root, and unmounting one is not something
// the diff of another will ever do.
//
// That is also why the ghost is UNCLICKABLE and why it COMPOUNDS one per cycle, why it hit
// every Profile drill rather than just Images, and why WINDOW MODE DID NOT CHANGE IT --
// the container above us is irrelevant when the duplication is our own render roots.
//
// THE FIX IS TO OWN THE TEARDOWN, because nobody else can. Every host this id has ever
// been handed is kept here; on each remount, every earlier one gets `render(null, host)`
// -- the documented unmount call (see the jsx typings: `render(vnode | null, parent)`) --
// and is then hidden, so an emptied host cannot hold layout either. The registry is then
// collapsed to the live host, so this is O(1) per mount and not a leak of its own.
//
// DO NOT TRUST isConnected HERE. The v2.168.0 walk reported isConnected=false for the
// NEWEST host, which cannot be true of the one the user is interacting with; the property
// is almost certainly not on NAI's whitelist and reads undefined. Teardown is therefore
// unconditional on connectedness and keyed only on identity (host !== elem).
//
// IF THIS EVER BLANKS THE SHELL, the failure signature is unmistakable -- an empty surface
// immediately on open -- and the cause would be that NAI mounts a throwaway host AFTER the
// live one, so we tore down the visible tree. The fix in that case is to keep the registry
// but hide rather than unmount. Recorded so the next reader does not have to re-derive it.
//
// [v2.170.0 AMENDMENT -- THE ABOVE IS TRUE AND DID NOT FIX THE GHOST.] The teardown works:
// the next reproduction reported `tracked hosts=1` with mounts at x2, so orphaned roots are
// being released as designed. THE GHOST WAS STILL ON SCREEN. And the down-walk in that same
// run showed the tree inside the live host CLEAN AND SINGLE -- one nav row, one body, THREE
// body children, and NO HEADER ROW AT ALL, stacked or otherwise.
//
// WHICH MEANS THE GHOSTS ARE NOT IN THIS HOST. They are painted somewhere our walker has
// never looked, because it has only ever walked DOWNWARD from the host. Whatever is on
// screen is a SIBLING or an ANCESTOR of it -- most likely earlier host wrappers of NAI's
// own that we were never handed and therefore never registered, which would also explain
// why the mount count stopped tracking the ghost count (x6 one run, x2 the next, ghosts
// both times). KEEP THE TEARDOWN -- releasing dead roots is correct regardless -- but do
// not credit it with closing the bug. `/ce ghost` gained the upward walk in v2.170.0 for
// exactly this reason; read that output before the next attempt.
var _ceMountHosts: { [id: string]: any[] } = {};

function _ceReleaseStaleHosts(id: string, elem: any): number {
    var freed = 0;
    var hosts: any[] = _ceMountHosts[id] || [];
    for (var i = 0; i < hosts.length; i++) {
        var host: any = hosts[i];
        if (!host || host === elem) continue;
        try { render(null, host); freed++; } catch (_eRel) { /* a dead host must not break the live mount */ }
        try { host.style.display = 'none'; } catch (_eHide) {}
    }
    _ceMountHosts[id] = [elem];
    return freed;
}

function ceJsxPart(id: string, Root: any, minPx?: number): UIPart {
    // Scroll containment boilerplate, verified working. Without the minHeight
    // pair the shadow host grows to content instead of scrolling, and the
    // element assignments must happen BEFORE render(), not after.
    return {
        type: 'jsx',
        id: id,
        // [v2.168.0 SHELL-WINDOW] minPx is the WINDOW-MODE FLOOR and is undefined in modal
        // mode, where the style below is byte-identical to every version before it. See the
        // CE_SHELL_WINDOW block for why a resizable container may not give height:100%
        // anything to resolve against.
        style: { display: 'grid', gridTemplateRows: 'minmax(0,1fr)', height: '100%',
                 minHeight: minPx ? (String(minPx) + 'px') : '0' },
        onMount: function(elem: any) {
            try {
                // [v2.157.0 GHOST-HEADER-PROBE] see the block above this function.
                try {
                    _ceMountCount[id] = (_ceMountCount[id] || 0) + 1;
                    var _gpPrev: any = _ceMountElem[id] || null;
                    var _gpSame = (_gpPrev === elem);
                    var _gpPrevConn = 'n/a';
                    if (_gpPrev && !_gpSame) {
                        try { _gpPrevConn = String(!!_gpPrev.isConnected); } catch (_e1) { _gpPrevConn = '?'; }
                    }
                    var _gpKids = '?';
                    try { _gpKids = String((elem.childNodes && elem.childNodes.length) || 0); } catch (_e2) {}
                    aeLog('[AE:jsxmount] id=' + id
                        + ' mount#' + _ceMountCount[id]
                        + ' sameElem=' + (_gpPrev ? String(_gpSame) : 'first')
                        + ' kidsBeforeRender=' + _gpKids
                        + ' prevStillConnected=' + _gpPrevConn);
                    _ceMountElem[id] = elem;
                } catch (_eGp) { /* a probe must never break the mount */ }
                // [v2.169.0 HOST-ORPHAN] BEFORE the style writes and BEFORE render(), for
                // the same ordering reason the original boilerplate note gives: nothing
                // touches the live host until every dead one is off the board.
                try {
                    var _hoFreed = _ceReleaseStaleHosts(id, elem);
                    if (_hoFreed > 0) {
                        aeLog('[AE:jsxmount] id=' + id + ' released ' + _hoFreed + ' orphaned host(s)');
                    }
                } catch (_eHo) { api.v1.error('[AE:jsxkit] host release failed:', _eHo); }
                elem.style.height = '100%';
                elem.style.minHeight = minPx ? (String(minPx) + 'px') : '0';
                render(h(Root, null), elem);
            } catch (e) { api.v1.error('[AE:jsxkit] mount failed:', e); }
        }
    } as UIPart;
}

// [v2.171.0 SCREEN-KEYED] THE GHOST IS HERE, AND THE PAGE-SIDE DUMP FINALLY SHOWED IT.
// window.aeBridge.ghost() (bridge v2.104.0) on a Profile drill printed THIS under the body:
//
//     DIV h=562                       <- this function's root
//       DIV h=49  "\u2190 Profile"     <- header
//       DIV h=17  "\u2190 Profile"     <- header
//       DIV h=49  "\u2190 Profile"     <- header
//       DIV h=465 "+Johnny Test..."   <- the scroller
//
// FOUR CHILDREN, and five on the Images drill. This function emits EXACTLY TWO. So the
// stacked headers are real children of this element, they are in the engine's own tree as
// well as the page's, and the earlier /ce ghost runs were reporting them all along -- the
// "kids=3 / kids=4 / kids=5" line at [0.0.1.0] that got read as varying body content was
// the header stack. The engine-side walk was never blind; it was misread.
//
// SO: the diff INSERTS a new header and does not remove the old one, and it can only do
// that if this child list is UNKEYED -- which it was, and which is the one property every
// previous attempt left alone. v2.167.0 made the header a component and still ghosted
// because a component in an unkeyed list is matched BY POSITION exactly like an element is.
// The key is the missing half, not the component.
//
// BOTH CHILDREN ARE NOW KEYED and the header slot is always occupied (ceHeader returns a
// component that renders null rather than a bare null -- v2.167.0's change, reinstated here
// because keys need a stable vnode to sit on). Preact matches keyed children by key across
// the whole list instead of by index, so slot 0 can never be filled twice.
//
// IF THIS STILL GHOSTS, stop: it means removals are being dropped in NAI's marshalling and
// no arrangement of our vdom will help. The fallback is structural and already agreed --
// delete the submenu header entirely and carry the back affordance some other way.
function ceScreen(header: any, children: any): any {
    // [v2.172.0 HEADER-INFLOW] gridTemplateRows drops from 'auto minmax(0,1fr)' to one
    // track, because there is no longer a second thing to place. The header is prepended to
    // the scroller's own child list -- and only when it exists, so an absent header changes
    // the list LENGTH rather than leaving a hole in it, which is the arrangement the body
    // list has always used without ghosting.
    var kids: any[] = (children === null || children === undefined) ? []
        : (Array.isArray(children) ? children.slice() : [children]);
    if (header) kids.unshift(header);
    return h('div', { style: { display: 'grid', gridTemplateRows: 'minmax(0,1fr)', height: '100%', minHeight: '0' } },
        h('div', { style: { overflowY: 'auto', minHeight: '0', padding: CE_T.s3, display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids)
    );
}

// [v2.146.0 NOHEADER, per user] THE TITLE IS GONE AND SO IS THE ROW WHEN IT IS EMPTY.
// This is surface_list line 2, open since CE-ROADMAP v0.1 §4 question 2 and now decided:
// "the top tab row has made the header for each surface redundant... submenus can have a
// return button but the header as a whole can go."
//
// WHY THE TITLE WAS ALWAYS REDUNDANT: SHELL-NAV renders the surface names directly above
// this, with the current one marked. A surface that also printed its own name printed it
// twice, five pixels apart. The drills are the only screens the nav does not name, and
// every one of them is self-evident from its own body — a field list headed Name / Role /
// Species does not need the word "Identity" over it.
//
// IT RENDERS null WHEN THERE IS NOTHING TO PUT IN IT, which is what actually removes the
// row rather than emptying it: ceScreen's grid is `auto minmax(0,1fr)`, so a null first
// child collapses the track to zero and the body starts at the top of the surface. An
// empty-but-present bar would have left the hairline and the padding behind — the exact
// "redundant chrome" this change exists to delete.
//
// SIGNATURE CHANGED, not stubbed. Keeping a dead `title` parameter would be the same lie
// the dead `roster` parameter on _ceProfilePositionKids was; all 23 call sites are updated
// in this patch.
//
// [v2.167.0 NULL-SLOT-ORPHAN -- FALSIFIED, REVERTED IN v2.168.0] RECORDED SO IT IS NOT
// RE-TRIED. v2.167.0 replaced the bare `return null` below with a component that renders
// null (h(_ceHeaderC, { actions })), on the theory that ceScreen's first child slot was
// changing TYPE across drill transitions -- element -> null leaving a drill, null ->
// element re-entering -- and that the removal was not reaching the DOM, leaving the node
// orphaned from the diff but still painted. ceBusy was cited as the control case: a
// component that returns null at a fixed slot in ceRoot, which has never ghosted.
//
// IT DID NOT FIX IT. The ghost survived the change unaltered, still one further copy per
// drill cycle, and the reporter confirms it happens on EVERY Profile submenu rather than
// just Images. So the null-in-a-child-slot theory is dead: whatever is leaving those rows
// on screen is not this slot's type changing, and h() and render() here are real Preact
// (see the jsx typings), which removes nodes correctly when it is asked to.
//
// WHAT THIS RULES OUT, which is the value of writing it down: the cause is NOT the
// element-vs-null child slot, and it is NOT specific to the h()-mounted Images drill
// (every other drill body is called bare and every one of them ghosts too). The next
// question is what the DOM under the shell host actually looks like once a ghost exists,
// which is what /ce ghost (v2.168.0, SECTION 3b) was added to answer. Do not attempt a
// third fix before reading that output.
// [v2.171.0 SCREEN-KEYED] The component form is BACK, and this time it is load-bearing for
// a different reason than v2.167.0 gave. A key has to sit on a vnode; a bare null cannot
// carry one, so an always-present component is the only way to keep 'ce-hdr' in the list on
// every render. Rendering null from inside it still collapses the grid track to zero, so
// NOHEADER's behaviour below is unchanged. All 29 call sites are untouched.
// [v2.172.0 HEADER-INFLOW] THE HEADER ROW IS NO LONGER A ROW. Five fixes failed against
// the ghost -- bare null, component, keyed component, host teardown, container swap -- and
// every one of them left the same thing standing: a DEDICATED GRID SLOT above the scroller
// whose occupant toggles between something and nothing as you enter and leave a drill.
// That slot is now DELETED. ceScreen has ONE child, permanently, and whatever ceHeader
// returns is folded in as the FIRST ORDINARY ITEM of the scroller's content instead.
//
// WHY THAT SHOULD HOLD WHERE KEYS DID NOT. The scroller's children have been swapped
// wholesale on every surface change since the JSX pivot -- different lengths, different
// types, different components -- and have NEVER ghosted once. Whatever is dropping removals
// does not do it there. So rather than keep theorising about why one child list misbehaves
// and the other does not, the back affordance moves into the list that demonstrably works.
//
// THE COST, stated plainly because it is a real regression and was accepted knowingly: the
// back button SCROLLS WITH THE CONTENT instead of staying pinned. If that turns out to
// matter more than expected, the fix is `position:sticky; top:0` on the row below plus a
// solid background -- NOT a return to a separate grid track.
//
// Styling changed with the structure: no horizontal padding (the scroller already pads) and
// the rule below the row is now paddingBottom + borderBottom rather than a full-bleed edge.
// The signature is unchanged and all 29 call sites are untouched.
function ceHeader(actions: any): any {
    if (!actions) return null;
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2, paddingBottom: CE_T.s2, borderBottom: '1px solid ' + CE_LINE } },
        actions
    );
}

// [v2.140.0 STYLE2-D] REBUILT to SS7.1's actual spec: "ceD2 head + a hairline rule running
// to the right edge. No box." Previously routed through ceH3 -- the Field-density eyebrow
// -- which meant every Read-density surface (Journal entries, Scene's location text,
// Profile's own concept notes) carried the exact same tiny uppercase micro-label as a
// Settings toggle row, with nothing distinguishing the two densities visually at all.
// Flat vocabulary preserved: still no border, no background, no box-in-box -- the rule
// trails the heading rather than wrapping the section.
function ceSection(label: string, children: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3 } },
            ceD2(label),
            h('div', { style: { flex: '1 1 auto', height: '1px', background: CE_LINE } })
        ),
        children
    );
}

// ceGroup -- the Field-density counterpart to ceSection (CE-STYLE v2.0 SS7.2, SS8): a
// ceKey group head with a full-width rule under it, then rows -- as opposed to
// ceSection's bare label with no rule. Same "flat vocabulary, no box" spirit; the rule
// under the head is what stands in for ceSection's row underline at this density.
function ceGroup(label: string, children: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { paddingBottom: CE_T.s1, borderBottom: '1px solid ' + CE_LINE } }, ceKey(label)),
        children
    );
}

// -- Interaction state, and why these are components now ----------------------
// [v2.139.0 STYLE2] SS9 requires every control to carry press and focus states, and SS9's
// own framing is the important part: "This belongs in the primitive, never at a call site
// -- that is the difference between a system and 200 hand-wired buttons." There is no
// `style` element in this environment, so there is no `:active` and no `:focus-visible`;
// every state is JS state driving an inline style, and JS state means a hook.
//
// THAT IS THE WHOLE REASON FOR THE WRAPPER SHAPE BELOW, and it is worth stating plainly
// because it looks like indirection for its own sake. `useState` inside a bare
// `ceBtn(...)` helper would join the hook list of whatever Root happened to call it, and
// surfaces render buttons CONDITIONALLY and IN LOOPS -- exactly the two things ceField's
// own header warns are fatal to hook order. So the state lives in a real component
// (_ceBtnC) with its own hook scope, where the order is trivially stable, and `ceBtn`
// stays a plain function that returns `h(_ceBtnC, props)`.
//
// THE PAYOFF IS THAT ALL 113 ceBtn CALL SITES ARE UNCHANGED. Not one surface knows this
// happened. The same shape applies to ceToggle (9 call sites) below.
//
// TAP-GUARD IS UNAFFECTED. Its autopsy is about Preact reusing one <button> node across
// two different logical buttons in ceHeader's action slot and patching onClick between the
// two fires of one physical tap. Component form does not change that -- the same node is
// still reused at the same tree position -- and ceTap is still the global boundary guard
// that catches it. Nothing here is a substitute for ceTap.
function _ceBtnC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    var variant = p.variant;
    var col = variant === 'danger' ? CE_SEM.ask : 'inherit';
    var restBg = variant === 'primary' ? CE_FILL : 'transparent';
    return h('button', {
        onClick: function() { ceTap('btn:' + p.opId, function() { ceAction(p.opId, p.fn); }); },
        // SS9.1's point stands -- "without them a press that slides off the control stays
        // visually stuck down forever" -- but its ROSTER IS WRONG, and this is a correction
        // to CE-STYLE v2.0 verified against jsx-typings_d.txt this patch, not a shortcut.
        // SS2 lists "onPointerDown/Up/Cancel" as available. THERE IS NO onPointerCancel in
        // ScriptDOMAttributes: the pointer family is Down/Up/Move/Over/Out/Enter/Leave and
        // stops there. onTouchCancel DOES exist and covers the case that actually matters
        // on a phone -- a press interrupted by a system gesture, an incoming call, a scroll
        // taking over the touch -- so the release set is Up + Leave + TouchCancel, which
        // closes every path a press can end on without inventing an API.
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        disabled: busy,
        // SS10.1 control scope + SS11: a busy control announces itself rather than only
        // looking faded.
        'aria-busy': busy ? 'true' : undefined,
        style: {
            // [v2.112.1 BTN-SHRINK] flexShrink and whiteSpace are NOT cosmetic here. Every
            // ceBtn that lives in a flex ROW next to a growing label -- ceSettingRow's
            // control slot, ceHeader's action slot, the empty-state action -- is a flex item
            // with default flex-shrink:1, so the row's text takes the space and the button
            // wraps its own label mid-word. Settings' shape button was the visible case;
            // it was never a Settings bug. Fixed in the kit so no call site has to know.
            //
            // [v2.139.0 STYLE2] HEIGHT IS NOW ctl (32px), NOT tap (44px). This is SS8's
            // headline correction -- "v1.2 set minHeight: 44px on the button itself, which
            // is why a row of buttons dominates every screen" -- and the 44px hit area it
            // gives up is restored by the wrapper below, not lost.
            minHeight: CE_T.ctl, padding: CE_T.s1 + ' ' + CE_T.s3,
            flexShrink: '0', whiteSpace: 'nowrap',
            fontSize: CE_T.fs, color: col,
            // SS9.1 press: ground to CE_FILL2 + scale(0.97). The ground steps ABOVE whatever
            // rest is, which is why CE_FILL2 had to exist -- a 'primary' button already
            // rests on CE_FILL and would otherwise have no press state at all.
            background: pressed ? CE_FILL2 : restBg,
            transform: pressed ? 'scale(0.97)' : 'none',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
            // SS9.1 focus: a real ring, never a colour swap.
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            // SS4: busy sits on the ladder at t3 like any other label-about-content, and
            // carries aria-busy above rather than relying on the dimming to communicate.
            opacity: busy ? CE_OP.t3 : CE_OP.t1, cursor: 'pointer',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    },
        // [v2.139.0 STYLE2] SS10.1: "Never a generic 'Working...' -- the label must still
        // say WHICH thing is running." The old code replaced every busy label with the
        // literal string 'Working...', which is the exact failure SS10.1 names.
        // THE DEFAULT IS `label + ellipsis`, NOT A DERIVED PROGRESSIVE FORM, and that is a
        // deliberate narrowing of SS10.1's own example. Mechanically converting a verb to
        // its -ing form works for the single-word case the doc cites (Enhance -> Enhancing)
        // and produces garbage for most of the 113 real labels in this file ("Reset to
        // default", "Run A/B probe (yoink vs direct)", "Copy log"). An ellipsis satisfies
        // the actual REQUIREMENT -- the label still names the thing -- and cannot produce
        // broken English. A call site with a clean single verb may pass `busyLabel` to get
        // the nicer progressive form; the generation buttons are where that is worth it.
        busy ? (p.busyLabel ? p.busyLabel : (p.label + '\u2026')) : p.label);
}

// The wrapper that restores the 44px hit area SS8/SS11 require around a 32px control.
// SS8 specifies "padding: 6px; margin: -6px" on all four sides. THIS IS VERTICAL-ONLY,
// deliberately, and the deviation is a correctness fix rather than a preference: buttons
// in this kit sit in flex ROWS at gap s2 (8px), so a 6px horizontal expansion on each of
// two neighbours overlaps their hit boxes by 4px and a tap in the seam lands on whichever
// happens to paint on top. Vertically there is no such neighbour -- rows are stacked at
// s3 (12px) or more, so 6px each side closes exactly to touching and never overlaps.
// The horizontal shortfall is also the one that does not exist in practice: s3 padding
// plus a word already carries every button in the file well past 44px wide.
function _ceHit(child: any): any {
    return h('div', { style: { display: 'inline-flex', flexShrink: '0', padding: '6px 0', margin: '-6px 0' } }, child);
}

// UNCHANGED SIGNATURE. All 113 existing call sites keep working verbatim; the only new
// thing is the optional 5th argument for SS10.1's progressive busy label.
function ceBtn(label: string, opId: string, fn: any, variant?: string, busyLabel?: string): any {
    return _ceHit(h(_ceBtnC, { label: label, opId: opId, fn: fn, variant: variant, busyLabel: busyLabel }));
}

// ceIconBtn -- an action with no room for a word (CE-STYLE v2.0 SS6.4, SS8). 17px glyph,
// 32px visual control, 44px hit area.
// `ariaLabel` IS THE FIRST POSITIONAL ARGUMENT ON PURPOSE. SS12 check 6 greps every
// ceIconBtn call site for a missing aria label, and says outright that the primitive
// "should make the label a required positional argument so this check can only fail by
// deliberate edit". An options bag with an optional `ariaLabel` key would let an
// unlabelled icon button be written by accident; this shape cannot.
// (Note for future edits: the audit's grep pattern is deliberately NOT quoted verbatim
// here -- it carries an unbalanced parenthesis, and this file is verified by a brace and
// paren balance-delta pass in which a comment counts exactly as much as code.)
function _ceIconBtnC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    return h('button', {
        onClick: function() { ceTap('ibtn:' + p.opId, function() { ceAction(p.opId, p.fn); }); },
        // See _ceBtnC for why there is no onPointerCancel here.
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        disabled: busy,
        'aria-label': p.ariaLabel,
        'aria-busy': busy ? 'true' : undefined,
        title: p.ariaLabel,
        style: {
            width: CE_T.ctl, height: CE_T.ctl, flexShrink: '0',
            display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            padding: '0', color: p.variant === 'danger' ? CE_SEM.ask : 'inherit',
            background: pressed ? CE_FILL2 : 'transparent',
            transform: pressed ? 'scale(0.97)' : 'none',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            opacity: busy ? CE_OP.t3 : CE_OP.t1, cursor: 'pointer',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, p.icon);
}
function ceIconBtn(ariaLabel: string, icon: any, opId: string, fn: any, variant?: string): any {
    return _ceHit(h(_ceIconBtnC, { ariaLabel: ariaLabel, icon: icon, opId: opId, fn: fn, variant: variant }));
}

// ceIcon -- the one stroke weight for the whole set (SS6.4): stroke currentColor, no fill,
// 1.7 weight, round caps and joins, 17px in a 32px control. Every icon in the kit is built
// through this so a mixed-weight set is not possible by accident.
// `paths` is an array of SVG child elements (h('path', { d: ... }) and friends) -- the
// primitive owns the frame and the stroke contract, the caller owns the shape only.
function ceIcon(paths: any): any {
    return h('svg', {
        width: '17', height: '17', viewBox: '0 0 24 24',
        fill: 'none', stroke: 'currentColor', 'stroke-width': '1.7',
        'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true'
    }, paths);
}

// [v2.142.0 STYLE2-F] THE FIRST THREE ICONS. ceIcon has been a zero-call-site forward
// dependency since v2.139.0; these are its first real consumers (the portrait slot card's
// row verbs). SS6.4 is the reason they exist at all: "a row/section-level verb (edit,
// delete, add, download) -- Icon only", which is what frees a portrait card from carrying
// four full-width word buttons under a 96px image. They are declared HERE, beside ceIcon,
// rather than at the call site, so a second surface needing "delete" cannot draw a second
// trash can at a different stroke weight -- the mixed-weight set SS6.4 warns about is only
// possible if the shapes live at call sites.
function ceIconEdit(): any {
    return ceIcon([
        h('path', { key: 'e1', d: 'M12 20h9' }),
        h('path', { key: 'e2', d: 'M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z' })
    ]);
}
function ceIconDownload(): any {
    return ceIcon([
        h('path', { key: 'd1', d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4' }),
        h('path', { key: 'd2', d: 'M7 10l5 5 5-5' }),
        h('path', { key: 'd3', d: 'M12 15V3' })
    ]);
}
// [v2.144.0 PHASE-G] The scene roster's two verbs. Same stroke contract as the other
// three; declared here for the same reason they were.
function ceIconUserPlus(): any {
    return ceIcon([
        h('path', { key: 'up1', d: 'M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' }),
        h('circle', { key: 'up2', cx: '8.5', cy: '7', r: '4' }),
        h('path', { key: 'up3', d: 'M19 8v6' }),
        h('path', { key: 'up4', d: 'M22 11h-6' })
    ]);
}
function ceIconUserMinus(): any {
    return ceIcon([
        h('path', { key: 'um1', d: 'M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' }),
        h('circle', { key: 'um2', cx: '8.5', cy: '7', r: '4' }),
        h('path', { key: 'um3', d: 'M22 11h-6' })
    ]);
}
// [v2.145.0 PICKER] The picker's selected-row lead. Same stroke contract, declared here
// for the same reason the other five are.
function ceIconCheck(): any {
    return ceIcon([
        h('path', { key: 'ck1', d: 'M20 6L9 17l-5-5' })
    ]);
}
// [v2.166.0 GLYPH-SWAP, per user "every 'Delete' or 'Delete...' button with trash svg"]
// ONE RULE DECIDES WHICH DELETE BUTTONS BECOME THIS ICON, and it is the file's own existing
// DESTRUCTIVE-NEVER-IN-PLACE split, not a new one:
//   ASK / row-level verb  -> ceIconBtn + ceIconTrash. It is a verb in a row of verbs, it is
//                            not destructive on its own, and SS6.4 names exactly this case:
//                            "a row/section-level verb (edit, delete, add, download) --
//                            Icon only". The entity avatar's delete already shipped this
//                            way in v2.142.0; this generalises that precedent.
//   CONFIRM               -> STAYS THE WORD "Delete". A confirm strip exists to be read: it
//                            carries a sentence saying what is about to be lost, a Keep, and
//                            the irreversible one. Reducing the irreversible one to an
//                            unlabelled 17px glyph beside a full-width Keep inverts the
//                            weight of the choice, which is the opposite of what a confirm
//                            is for. Do not "finish the job" by swapping these later.
function ceIconTrash(): any {
    return ceIcon([
        h('path', { key: 't1', d: 'M3 6h18' }),
        h('path', { key: 't2', d: 'M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2' }),
        h('path', { key: 't3', d: 'M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6' })
    ]);
}
// [v2.166.0 GLYPH-SWAP, per user] The gear. It is declared here with the rest of the set,
// for the reason stated above ceIconEdit: a second surface wanting "settings" must not
// draw its own at a different stroke weight.
// WHY A GEAR IS ALLOWED ON THE NAV ROW AND THE OTHER SIX LABELS ARE NOT. CE-STYLE 10.2's
// argument is "six abstract nouns do not have six unambiguous glyphs" -- that is an
// argument about AMBIGUITY, not an argument against icons, and the gear is the single
// exception the whole convention rests on: it is the one control in this kit whose glyph
// is more universally read than its word. Map/Scene/Chat/Journal/Images/Wizard stay words
// because none of them clears that bar. Do not read this as permission to icon the rest.
function ceIconSettings(): any {
    return ceIcon([
        h('circle', { key: 'g1', cx: '12', cy: '12', r: '3' }),
        h('path', { key: 'g2', d: 'M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z' })
    ]);
}

// [v2.114.0 NAV-BACK] The back control, so that no surface hand-writes its own return
// address. Reads ceUiStore.back -- set by whoever navigated here -- and falls back to the
// label passed in when there is none (arrived at top level). It is a ceBtn, so it inherits
// the physical-tap guard, and that matters more here than anywhere else on the surface:
// TAP-GUARD's autopsy is specifically about two DIFFERENT back buttons sharing one reused
// <button> node in ceHeader's action slot.
// [v2.146.0 NOHEADER] RETURNS null WHEN THERE IS NO RETURN ADDRESS, and the fallback label
// is gone with it. A surface reached from the nav has no "back" — the nav IS how you got
// there and it is still on screen — so the old '\u2190 Scene' fallback was a second door
// beside an identical first one. What survives is the case NAV-BACK was actually built
// for: Journal reached FROM a Profile launcher, where Profile is not on the nav and the
// return address is the only way back to it.
function ceBack(): any {
    var b: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; b = (u && u.back) || null; } catch (e) {}
    if (!b || !b.surface) return null;
    return ceBtn('\u2190 ' + String(b.label || 'Back'), 'nav:back', function() {
        ceNav(String(b.surface), String(b.entityId || ''));
        return Promise.resolve();
    });
}

// [v2.112.0 TOGGLE, per user] A boolean was rendered as a button reading "Toggle" or
// "Switch" -- the control named the verb instead of showing the state, so the row said
// "Context injection / On" and then offered a button whose label was the same for both
// directions. This is a switch: the state IS the control. ceBtn stays for actions that
// are not booleans.
// [v2.139.0 STYLE2] Component form, same wrapper reasoning as _ceBtnC above -- all 9 call
// sites are unchanged.
// SS9.1 gives ceToggle a feedback contract the other controls do not have: OPTIMISTIC.
// A boolean is the one control where the user already knows what the result will be, so
// waiting for a storage round-trip before moving the knob makes the control feel broken
// even when it is working. `optimistic` holds the pending value and is what the knob
// renders from while the write is in flight; it clears the moment the real prop catches
// up, so a FAILED write snaps the knob back rather than lying about the stored state.
// Note it is keyed off `p.on` changing, not off the busy latch clearing -- ceAction
// releases the latch when the write RESOLVES, which for a rejected write is also when it
// failed, and reading the latch would leave the knob showing the value that did not save.
function _ceToggleC(p: any): any {
    var optState = useState(null); var optimistic = optState[0]; var setOptimistic = optState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    // The real value has landed (or reverted) -- drop the optimistic overlay.
    useEffect(function() { setOptimistic(null); }, [p.on]);
    var on = (optimistic === null) ? !!p.on : !!optimistic;
    return h('div', {
        onClick: function() {
            // CAPTURED AT RENDER TIME, per CEGAL-IDEMP: an instant handler that inverts
            // state must not read the live value at fire time.
            var next = !p.on;
            ceTap('tgl:' + p.opId, function() { setOptimistic(next); ceAction(p.opId, p.fn); });
        },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        // SS11: "State is never colour alone." aria-pressed makes the boolean readable to
        // anything that is not looking at the knob's position.
        role: 'switch', tabIndex: 0,
        'aria-pressed': on ? 'true' : 'false',
        'aria-label': p.ariaLabel,
        'aria-busy': busy ? 'true' : undefined,
        style: {
            flex: '0 0 auto', width: '40px', height: '24px', borderRadius: CE_T.rPill,
            border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
            background: on ? CE_FILL : 'transparent',
            display: 'flex', alignItems: 'center',
            justifyContent: on ? 'flex-end' : 'flex-start',
            // SS12 check 4's own allowlist names this exact value: "the toggle track's
            // '0 3px'". It is the knob's inset, not a spacing decision.
            padding: '0 3px', cursor: 'pointer',
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    },
        h('div', { style: {
            width: '16px', height: '16px', borderRadius: '50%',
            // SS4: the knob is NON-TEXT, so its on/off weight is a color-mix, not an
            // opacity rung -- that is the whole reason the two vocabularies are kept
            // apart. Previously this was opacity 0.9/0.35, two values on no ladder at all.
            background: on ? 'currentColor' : CE_LINE2,
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        } })
    );
}
function ceToggle(on: boolean, opId: string, fn: any, ariaLabel?: string): any {
    return h(_ceToggleC, { on: on, opId: opId, fn: fn, ariaLabel: ariaLabel });
}

// A labelled settings line: heading, optional explanation, control on the right.
// One shape for every row on every settings surface, so spacing cannot drift per row.
function ceSettingRow(label: string, hint: string, control: any): any {
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3,
        minHeight: CE_T.tap, padding: CE_T.s2 + ' 0', borderBottom: '1px solid ' + CE_LINE } },
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '3px' } },
            h('div', { style: { fontSize: CE_T.fs } }, label),
            hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } }, hint) : null
        ),
        control || null
    );
}

// ceRow -- a Field-density row: key . value . trailing verbs (CE-STYLE v2.0 SS7.2, SS8).
// Distinct from ceSettingRow (a Settings-shaped label+hint+control line): this is the
// dense per-field row a Profile slot / pressure readout / preset list wants, three flex
// slots instead of two, key column always ceKey and never bespoke.
// zebra (optional): CE_STYLE SS7.2 names CE_FILL-on-even-rows as "the one legitimate use
// of a fill as a grouping device" at this density. Pass the row's own index (0-based) and
// ceRow applies it on every odd index; omit it and the row renders with no fill, which is
// correct for a lone row or a list that doesn't want zebra banding.
function ceRow(key: string, value: any, trail: any, zebraIndex?: number): any {
    var zebra = (typeof zebraIndex === 'number') && (zebraIndex % 2 === 1);
    return h('div', { style: {
        display: 'flex', alignItems: 'center', gap: CE_T.s3,
        padding: CE_T.s2 + ' ' + CE_T.s3, lineHeight: CE_T.lhTight,
        background: zebra ? CE_FILL : 'transparent'
    } },
        h('div', { style: { flex: '0 0 auto' } }, ceKey(key)),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fsSm } }, value),
        trail ? h('div', { style: { flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: CE_T.s1 } }, trail) : null
    );
}

// ceChip -- a STATE label, not a verb (CE-STYLE v2.0 SS8). Read/Object density. Distinct
// from ceToggle (a boolean whose state IS the control) and from the profile flag chip
// this kit already had inline (SECTION 30's `chip()` closure) -- that one is a per-surface
// helper wired to ceProfileWrite and stays put; this is the general-purpose primitive for
// anywhere else a state label is needed. Press feedback deliberately NOT wired -- see the
// SS9.1/SS14 note on ceIconBtn below; this primitive is in the same boat.
function ceChip(label: string, on: boolean, onTap?: () => void): any {
    return h('div', {
        onClick: onTap ? function() { ceTap('chip:' + label, onTap); } : undefined,
        style: {
            display: 'inline-flex', alignItems: 'center', minHeight: '26px', padding: '0 ' + CE_T.s2,
            fontSize: CE_T.fsKey, letterSpacing: '0.06em', textTransform: 'uppercase',
            cursor: onTap ? 'pointer' : 'default',
            borderRadius: CE_T.rPill, border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
            background: on ? CE_FILL : 'transparent', opacity: on ? CE_OP.t1 : CE_OP.t3
        }
    }, label);
}

// ceMeter -- a 0-100 bar in a semantic or pattern hue (CE-STYLE v2.0 SS8, Field density).
// `hue` is a CE_SEM or CE_PATTERN_DEFS[id].c value, passed in rather than looked up here --
// this primitive doesn't know which axis it's rendering, only how to draw one. Per SS6.3
// #4 ("meter fill") the hue is never dimmed by opacity; the TRACK is CE_LINE (a color-mix
// value, not opacity) so the fill/track vocabulary stays the one SS4 keeps separate from
// the opacity ladder.
// ceCard -- the Object-density container (CE-STYLE v2.0 SS7.3, SS8). THE ONE DENSITY THAT
// DRAWS A BOX, and the reason is stated in SS7.3: the records are distinct THINGS, so the
// box is grouping rather than chrome.
//
// THE LEFT BORDER IS THE IDENTITY HUE, 3px, AND IT REPLACES THE DOT (SS6.3 #2). Scene
// character cards previously carried an 8px ceDot for pattern identity; that dot is now
// wrong on two counts -- SS8 says ceDot is "Not for pattern identity any more", and the
// dot cost a whole row of vertical space that the card's own padding now pays for.
// A card whose subject has NO pattern gets NO hue (SS6.3: "A character with no pattern has
// no hue. That is information; do not fill it with grey"), so the left border falls back
// to the same CE_LINE as the other three edges rather than to a neutral accent.
//
// THE INSET TOP HIGHLIGHT is what makes one container read correctly on both theme
// polarities: a 1px lit edge on a dark ground, a soft bevel on a light one. It is the only
// place in the kit that mixes a highlight into a shadow, and it belongs to this primitive
// alone -- a call site reaching for it means it wanted a card.
//
// DO NOT NEST. SS7.3: "Object density containers never nest. A card inside a card means
// the inner content was fields (Field) or prose (Read)."
function _ceCardC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var tappable = !!p.onClick;
    return h('div', {
        onClick: tappable ? function() { ceTap('card:' + String(p.opId || p.key || ''), p.onClick); } : undefined,
        onPointerDown: tappable ? function() { setPressed(true); } : undefined,
        onPointerUp: tappable ? function() { setPressed(false); } : undefined,
        onPointerLeave: tappable ? function() { setPressed(false); } : undefined,
        onTouchCancel: tappable ? function() { setPressed(false); } : undefined,
        style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s1,
            padding: CE_T.s3, borderRadius: CE_T.rCard,
            background: pressed ? CE_FILL2 : CE_WELL,
            border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + (p.hue || CE_LINE),
            boxShadow: 'inset 0 1px 0 color-mix(in srgb, currentColor 9%, transparent)',
            transform: pressed ? 'scale(0.99)' : 'none',
            cursor: tappable ? 'pointer' : 'default',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, p.children);
}
// `hue` is a CE_PATTERN_DEFS[id].c value or empty. `children` is the card's contents --
// ceH for the record's name, ceSm for its sub-line (SS7.3).
// [v2.142.0 STYLE2-F] `key` IS FORWARDED NOW. The first two consumers (chat contacts,
// portrait slots) both render N cards from an array, and without a key Preact reuses one
// component instance across two logical cards at the same tree position -- the exact node
// reuse TAP-GUARD's autopsy is about. Additive: every keyless call site is unaffected.
function ceCard(opts: any): any {
    return h(_ceCardC, { key: opts.key, hue: opts.hue, onClick: opts.onClick,
                         opId: opts.opId, children: opts.children });
}

function ceDot(level: string): any {
    var c = CE_SEM[level] || 'transparent';
    // 'calm' renders transparent rather than absent so rows do not reflow when
    // a character settles.
    return h('div', { style: {
        width: '8px', height: '8px', borderRadius: '50%', flex: '0 0 auto',
        background: c, border: c === 'transparent' ? '1px solid ' + CE_LINE : 'none'
    } });
}

function ceListRow(opts: any): any {
    return h('div', {
        onClick: opts.onClick ? function() { ceTap('row:' + String(opts.label || ''), function() { opts.onClick(); }); } : undefined,
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: CE_T.tap, padding: CE_T.s2 + ' 0',
            borderBottom: '1px solid ' + CE_LINE,
            cursor: opts.onClick ? 'pointer' : 'default'
        }
    },
        opts.lead || null,
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '2px' } },
            h('div', { style: { fontSize: CE_T.fs } }, opts.label),
            opts.sub ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, opts.sub) : null
        ),
        opts.trail ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', flex: '0 0 auto' } }, opts.trail) : null
    );
}

// ceBusy -- the shell-scope generation rail (CE-STYLE v2.0 SS10.1 #3, SS8).
// THE ONLY SUBSCRIBER TO ceGenStore, by contract (SS10.2). If a second component ever
// subscribes, read that rule again before doing it.
//
// 2px across the top of the shell, in CE_SEM.building. Present whenever ANY metered call
// is in flight and absent otherwise -- it renders null rather than a transparent 2px
// strip, because unlike ceDot's 'calm' there is no row here whose reflow matters, and a
// permanent empty strip at the top of every surface is chrome that means nothing.
//
// aria-live="polite" per SS11: the rail's appearance is ANNOUNCED, not merely visual --
// which is the whole point for a user who cannot see that they are being metered.
// The hue is never dimmed (SS6.2/SS4: "Semantic and pattern colours never take an
// opacity"); the track it runs on is CE_LINE, a color-mix, keeping the two vocabularies
// separate exactly as SS4 requires.
function ceBusy(): any {
    ceGenStoreInit();
    var g = useStoreValue(ceGenStore);
    var live = (g && g.live) || 0;
    if (live <= 0) return null;
    var phase = (g && g.phase) || 0;
    // Indeterminate motion without keyframes: the segment's own `left` is transitioned
    // between four resting places, so the browser interpolates the travel for us. Under
    // reduced motion the ticker never runs (see ceGenBegin), phase stays put, and the
    // segment renders full-width and static -- still unmistakably "something is running".
    var lefts = ['0%', '30%', '60%', '30%'];
    var seg = CE_REDUCE_MOTION
        ? { left: '0%', width: '100%' }
        : { left: lefts[phase % 4], width: '40%' };
    return h('div', {
        role: 'status', 'aria-live': 'polite',
        'aria-label': live > 1 ? (live + ' generations running') : 'Generating',
        style: {
            position: 'relative', height: '2px', width: '100%', flex: '0 0 auto',
            background: CE_LINE, overflow: 'hidden'
        }
    },
        h('div', { style: {
            position: 'absolute', top: '0', height: '100%',
            left: seg.left, width: seg.width,
            background: CE_SEM.building,
            transition: 'left ' + CE_T.mSlow + ' ' + CE_T.ease
        } }),
        // SS10.1: "The rail also carries a count when more than one call is live
        // (ceMono, right-aligned)." Only when it is actually ambiguous -- a count of 1
        // beside a running bar is noise.
        live > 1 ? h('div', { style: {
            position: 'absolute', right: CE_T.s1, top: '0', lineHeight: '2px'
        } }, ceMono(String(live), { opacity: CE_OP.t3 })) : null
    );
}

function ceEmpty(msg: string, action: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', alignItems: 'center', gap: CE_T.s2, padding: CE_T.s4, opacity: '0.74', fontSize: CE_T.fsSm, textAlign: 'center' } },
        h('div', null, msg),
        action || null
    );
}

// [v2.108.0 JSXKIT] DELIBERATELY UNUSED THIS PASS. The Scene surface is
// read-only, so nothing renders a field yet - but this primitive carries the
// most hard-won constraints in the kit and lands with them rather than being
// reinvented under deadline by the first authoring surface. DO NOT DELETE in a
// dead-code sweep; it is a forward dependency, not an orphan.
//
// TWO SHARP EDGES, both consequences of it calling useRef:
//   (a) it MUST be invoked during a component render (as ceField(p) inside a
//       Root, or via h(ceField, p)) - never outside one;
//   (b) hook order must be stable, so it must NOT be called conditionally or in
//       a variable-length loop. If a surface ever needs a dynamic field list,
//       convert it to a real component first: h(ceField, props) with a key.
function ceField(p: any): any {
    // UNCONTROLLED, and every clause below is now MEASURED rather than inherited.
    // Probe v0.4.0 mounted ten fields at once; see FIELD-SEED in the CE-INDEX.
    //
    // [v2.113.0 FIELD-SEED] `defaultValue` DOES NOTHING IN THIS ENVIRONMENT. It is not a
    // whitelisted prop -- script-types_d.txt states outright that only specific attributes
    // are allowed on a jsx tree, and neither ScriptInputAttributes nor
    // ScriptTextareaAttributes declares it. Every name in those interfaces is the HTML
    // ATTRIBUTE spelling (`readonly`, `maxlength`, `spellcheck`), which is what a
    // props-to-attributes serializer across the worker boundary looks like, and
    // `defaultValue` has no attribute form for such a serializer to emit. Probe A1 (input)
    // and A4 (textarea) both rendered BLANK. So the field was never showing a stale value;
    // it was never showing ANY value, and v2.112.0's staleness fix addressed a real second
    // problem while leaving the first one untouched.
    //
    // THE SEED IS NOW AN IMPERATIVE WRITE THROUGH A ref CALLBACK. `el` is a proxy across
    // the worker boundary (probe A3 -- nodeName INPUT but tagName undefined, no
    // ownerDocument, no focus method), so nothing about this was safe to assume. What was
    // measured: `el.value = x` followed by an immediate read returns x (READBACK-OK), and
    // a later read returns TEXT THE USER HAS SINCE TYPED. The proxy is read-through and
    // write-through on `value`.
    //
    // THREE PROPERTIES OF THE ref THAT THE SHAPE OF THIS FUNCTION DEPENDS ON:
    //   (1) A STABLE ref FIRES EXACTLY ONCE PER MOUNT. Probe A3 stayed at fire #1 across
    //       repeated re-renders. cbRef therefore holds ONE function for the life of the
    //       component -- an inline `ref: function(el){...}` is a new identity every render,
    //       which Preact re-invokes every render (probe A6), and that would overwrite
    //       whatever the user was mid-way through typing.
    //   (2) BECAUSE IT ONLY FIRES ON MOUNT, IT CANNOT SEE A CHANGED VALUE ON ITS OWN.
    //       Probe: changing the seed did not update A3. v2.112.0 closed that gap by bumping
    //       the ELEMENT KEY to force a remount; [v2.116.0 FIELD-KEYLESS] closes it with an
    //       imperative write through the ref instead, and the key bump is GONE. See the
    //       block above the useEffect below for why.
    //   (3) THE CALLBACK MUST READ REFS, NEVER CLOSURE VARIABLES. It is created on the
    //       first render and never again, so anything captured by value is frozen at that
    //       render forever. The probe demonstrated the trap directly: its own A7 log line
    //       printed `key=k0` after three key bumps because it closed over `gen` instead of
    //       reading a ref. lastRef.current is read at call time and cannot go stale.
    //
    // AND `value=` IS NOW RULED OUT ON EVIDENCE, not on inference. Probe A8 bound value= to
    // a store field; text typed into it and not yet blurred was DESTROYED by an unrelated
    // re-render, while A3 under the ref seed survived the same re-render intact. That is
    // the controlled-render race of JSX-PROBE-RESULTS (2), observed directly. Do not
    // "simplify" this back to value=.
    //
    // COMMIT READS THE ELEMENT, NOT THE EVENT. e.target is a serialized ScriptEventTarget
    // snapshot, and this environment is already on record for delivering stale values in
    // one (probe v0.3.0, onInput at word boundaries). The live proxy read is strictly more
    // trustworthy; the event stays as a fallback for the case where the ref never landed.
    // [v2.116.0 FIELD-KEYLESS, per user report] THE ELEMENT KEY NO LONGER BUMPS. It used to
    // bump on every external value change -- which is every commit, on every surface -- and
    // the Journal is simply the first surface where the cost was VISIBLE: adding an entry
    // left the old composer standing and mounted a fresh one beside it, one more per add,
    // until leaving the surface remounted the part and swept them. A leaked node inside a
    // collapsed accordion is invisible, which is why the Profile never reported it.
    // WHAT REPLACES IT: an imperative write through elRef, which FIELD-SEED already measured
    // to be retained and write-through on `value`. No remount, so nothing can leak.
    // THE OBJECTION THAT BLOCKED THIS BEFORE was that the key bump was only safe because a
    // commit fires on blur, so the replaced element is never the focused one -- and there is
    // no way to check focus here (no el.focus, no ownerDocument, no activeElement).
    // THE ANSWER IS THAT FOCUS WAS NEVER THE QUESTION. What must not be destroyed is
    // UNCOMMITTED TEXT, and that is directly readable: if el.value has drifted from
    // lastRef.current, the author has typed something this field has not committed yet, and
    // the incoming external value loses. A focus test would get both edges wrong -- a
    // focused field with nothing typed is safe to overwrite, an unfocused one holding
    // uncommitted text is not.
    var incoming = (p.value == null) ? '' : String(p.value);
    // `seed` is an EXPLICIT RESET TOKEN and the one case the value comparison cannot cover:
    // a field whose `value` prop never changes (the Journal composer is always '') has
    // nothing for this function to detect. Bump it and the field is force-cleared to
    // `value`, uncommitted text included -- that is the point, it means "the surface has
    // consumed what was in here."
    var seedSig = (p.seed == null) ? '' : String(p.seed);
    var lastRef = useRef(incoming);
    var seenRef = useRef(incoming);
    var seedRef = useRef(seedSig);
    var elRef = useRef(null as any);
    var wantRef = useRef(null as any);
    if (seedSig !== seedRef.current) {
        seedRef.current = seedSig;
        seenRef.current = incoming;
        wantRef.current = { text: incoming, force: true };
    } else if (incoming !== seenRef.current) {
        seenRef.current = incoming;
        wantRef.current = { text: incoming, force: false };
    }
    var cbRef = useRef(null as any);
    if (!cbRef.current) {
        cbRef.current = function(el: any) {
            // Preact calls this with null on unmount, element on mount. Now that the key is
            // stable this fires exactly once for the life of the component, which is what
            // makes lastRef the only seed path.
            elRef.current = el;
            if (!el) return;
            try { el.value = lastRef.current; }
            catch (e) { api.v1.error('[AE:jsxkit] field seed failed:', e); }
        };
    }
    // The re-seed. Deliberately runs AFTER render (the element must exist and the props
    // must already be applied) and deliberately has NO dependency array -- the decision was
    // made during render and parked on wantRef, so this only has to drain it.
    useEffect(function() {
        var want: any = wantRef.current;
        if (!want) return;
        wantRef.current = null;
        var el: any = elRef.current;
        if (!el) { lastRef.current = String(want.text); return; }
        var cur = '';
        var ok = false;
        try { cur = (el.value == null) ? '' : String(el.value); ok = true; }
        catch (e1) { ok = false; }
        // Uncommitted typing wins. lastRef is NOT advanced here on purpose: leaving it
        // stale is what makes the eventual blur still look like a change and commit.
        if (ok && !want.force && cur !== lastRef.current) return;
        if (ok && cur === String(want.text)) { lastRef.current = String(want.text); return; }
        try { el.value = String(want.text); lastRef.current = String(want.text); }
        catch (e2) { api.v1.error('[AE:jsxkit] field reseed failed:', e2); }
    });
    function commit(e: any) {
        var v = '';
        var read = false;
        var el = elRef.current;
        if (el) {
            try { v = (el.value == null) ? '' : String(el.value); read = true; }
            catch (e1) { read = false; }
        }
        if (!read) { v = (e && e.target && e.target.value != null) ? String(e.target.value) : ''; }
        if (v === lastRef.current) return;
        lastRef.current = v;
        ceAction('field:' + p.k, function() { return p.onCommit(v); });
    }
    // [v2.115.0 FIELD-SCRATCH] onType is a SCRATCHPAD TAP, not a second commit path, and
    // it exists because CLICK IS DELIVERED BEFORE BLUR IN THIS ENVIRONMENT -- measured, see
    // CLICK-BEFORE-BLUR. A button that reads a value the field commits on blur reads the
    // PREVIOUS value on its first press, which is precisely the Journal "Add" bug.
    // THE HARD RULE: an onType handler may write a MODULE VARIABLE and nothing else. It may
    // not touch a store. [v2.116.0] The original reason -- a store write re-renders, a
    // re-render changes p.value, and a changed p.value remounted the input -- no longer
    // applies, because FIELD-KEYLESS skips the re-seed whenever the element holds
    // uncommitted text. The rule stands anyway on the OTHER two grounds, which were always
    // the stronger ones: a store write repaints every subscriber of that store on every
    // keystroke, and onInput also multi-fires with
    // stale values at word boundaries (JSX-PROBE-RESULTS 2), which is harmless for a
    // scratchpad -- the last event carries the truth -- and would be corrupting for state.
    function scratch(e: any) {
        if (!p.onType) return;
        var v = '';
        var el = elRef.current;
        if (el) { try { v = (el.value == null) ? '' : String(el.value); } catch (e1) { el = null; } }
        if (!el) { v = (e && e.target && e.target.value != null) ? String(e.target.value) : ''; }
        try { p.onType(v); } catch (e2) { api.v1.error('[AE:jsxkit] field onType failed:', e2); }
    }
    // [v2.115.0 WRITE-WELL, per user] A read surface that happens to be editable and a
    // dedicated write box are different objects and must not look identical. The underline
    // is the editable-prose treatment; the well is "compose here".
    // [v2.141.0 STYLE2-E, per user] THE DEFAULT PATH NOW CARRIES A GROUND. The comment
    // directly above stated the rule -- a read surface that happens to be editable and a
    // dedicated write box must not look identical -- but only the `well` branch ever acted
    // on it. The default was `background: transparent` over a CE_LINE borderBottom, and
    // CE_LINE is the SAME 14% hairline every plain divider on every surface uses, so an
    // unfocused non-well field was indistinguishable from static text sitting above a rule.
    // WHAT DISTINGUISHES THEM NOW is a two-part treatment, and both parts are needed:
    // a faint CE_FILL ground (this is a surface you type ON) and a CE_LINE2 underline
    // (heavier than any divider, so the writing line still reads as a writing line). The
    // top corners round and the bottom two do not -- the underline stays the anchor.
    // THE WELL IS STILL A DIFFERENT OBJECT: CE_WELL is translucent BLACK (a recess, on
    // either theme polarity), where CE_FILL is currentColor-derived and tints toward the
    // text. A ground is "editable"; a recess is "compose here". Three states, not two.
    var inputStyle: any = {
        width: '100%', boxSizing: 'border-box', minHeight: CE_T.tap,
        fontSize: CE_T.fs, color: 'inherit', background: CE_FILL,
        border: 'none', borderBottom: '1px solid ' + CE_LINE2,
        borderRadius: CE_T.r + ' ' + CE_T.r + ' 0 0',
        padding: CE_T.s2 + ' ' + CE_T.s2
    };
    if (p.well) {
        inputStyle.background = CE_WELL;
        inputStyle.border = '1px solid ' + CE_LINE;
        inputStyle.borderBottom = '1px solid ' + CE_LINE;
        inputStyle.borderRadius = CE_T.r;
        inputStyle.padding = CE_T.s3;
        inputStyle.lineHeight = '1.6';
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        // [v2.109.0] An empty label renders nothing rather than an empty row. The profile's
        // slot card supplies its own heading, so a second blank one would open a gap.
        p.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, p.label) : null,
        h(p.multiline ? 'textarea' : 'input', {
            ref: cbRef.current,
            onBlur: commit,
            onInput: p.onType ? scratch : undefined,
            rows: p.multiline ? (p.rows || 3) : undefined,
            placeholder: p.placeholder || '',
            style: inputStyle
        }),
        p.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, p.hint) : null
    );
}

// [v2.113.0 SELECT] The kit's missing enum control. CE-UI-KIT v0.1 section 2.7 specified it and
// nothing built it, which is the whole reason the three texting-persona axes shipped
// unwired -- the data has been in buildCharProfilePayload since v2.100.0 (chatPersona +
// chatPersonaOpts, id/label pairs shipped from the engine's own option arrays so a new
// option appears in every UI with no per-surface edit).
//
// UNLIKE ceField THIS BINDS value= AND THAT IS CORRECT, not an inconsistency. The reason
// value= is forbidden on a text field is that a re-render mid-typing destroys uncommitted
// keystrokes (probe v0.4.0 A8). A select has no uncommitted intermediate state: it is
// either showing the stored option or a newly chosen one, so a re-render resetting it to
// the store is the DESIRED behaviour rather than data loss. Probe A9 confirmed value=
// preselects correctly; A10 confirmed the option-level `selected` attribute also works,
// and value= is preferred because it keeps one source of truth instead of pushing the
// current selection down into the options loop.
//
// HOOK-FREE BY CONTRACT. ceField cannot be called in a loop because it calls useRef and
// hook order must be stable; this deliberately calls nothing, so a surface may render N of
// them from an array -- which is exactly what the persona block does. ADDING A HOOK HERE IS
// A BREAKING CHANGE, not a refactor.
//
// The guard is ceTap, not ceAction. onChange has never been measured in this environment,
// but onClick is on record for double-firing (JSX-PROBE-RESULTS 1) and ceAction demonstrably
// does not cover an instant handler (TAP-GUARD). One physical selection is one action, so
// the global event-boundary guard is the right shape and the value dedupe backs it up.
function ceSelect(p: any): any {
    var cur = (p.value == null) ? '' : String(p.value);
    var list: any[] = p.options || [];
    var opts: any[] = [];
    var i = 0;
    for (i = 0; i < list.length; i++) {
        var o: any = list[i];
        var oid = String((o && o.id != null) ? o.id : o);
        var olab = String((o && o.label != null) ? o.label : oid);
        opts.push(h('option', { key: 'o' + oid, value: oid }, olab));
    }
    var sel = h('select', {
        value: cur,
        onChange: function(e: any) {
            var v = (e && e.target && e.target.value != null) ? String(e.target.value) : '';
            if (v === cur) return;
            ceTap('sel:' + p.k, function() { ceAction('sel:' + p.k, function() { return p.onCommit(v); }); });
        },
        style: {
            minHeight: CE_T.tap, padding: CE_T.s2 + ' ' + CE_T.s3,
            flexShrink: '0', maxWidth: '100%',
            fontSize: CE_T.fs, color: 'inherit', background: 'transparent',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r, cursor: 'pointer'
        }
    }, opts);
    // Bare control when unlabelled, so a call site can compose it into ceSettingRow's
    // control slot without a second heading fighting the row's own label.
    if (!p.label && !p.hint) return sel;
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        p.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, p.label) : null,
        sel,
        p.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, p.hint) : null
    );
}



// ============================================================================
// -- THE PICKER: a reference is CHOSEN, never typed ---------------------------
// [v2.145.0 PICKER] CE-STYLE v2.0 SS13's primitive and the last entry on the kit's own
// "open, deliberately not built" list (SS14). It is also the single item CE-ROADMAP v0.2
// SS4 names as gating Phase E (entity edit), which in turn gates G-prime and F -- which is
// why it lands as its own patch rather than inside the surface that first needs it.
//
// THE RULE IT ENFORCES (SS13, unchanged in substance since v1.2 SS11): if a field's value
// names something the world already knows about -- another character, a species, a
// faction, a location, an archetype -- it is a REFERENCE, and a reference is chosen from
// what exists. Store the id, carry the name alongside as a denormalized label, and write
// both IN THE SAME COMMIT. Every picker offers "not in the list", which stores free text:
// a world half-built must not be a wall.
//
// A DECLARATIVE REGISTRY, NOT A CALLBACK PARKED ON THE STORE. Two reasons; the second is
// the load-bearing one:
//   1. `sheet: {kind, payload}` already established the shape in this file -- a string
//      discriminant the router resolves -- and a def table is greppable in a way a stored
//      closure is not. CE_PATTERN_DEFS and CE_SHELL_ROUTES are the same idiom.
//   2. A callback captured at OPEN time captures its OPTION LIST at open time.
//      `options(ctx, src)` is evaluated at RENDER time against live stores, so a picker
//      can never show a cast that has since changed underneath it.
//
// THE DEFS LIVE HERE, IN THE KIT, even though today's three all read profile data. Same
// argument as ceIconEdit/ceIconTrash sitting beside ceIcon rather than at their call
// sites: one table is the only way a second surface needing "choose a character" cannot
// quietly grow a second, differently-behaved chooser.
//
// IT INTERCEPTS ABOVE THE SURFACE ROUTER, not on profileDrill. Three call sites already
// exist and Phase E adds at least location-parent and item-owner on a different surface; a
// per-surface drill value would mean every surface re-implementing this router. ceRoot
// intercepts `picker` before the surface switch, exactly as it would for a real seventh
// surface, and SHELL-NAV stays visible underneath for the same reason it stays visible
// over a Profile drill -- the way out of anywhere is always on screen.
//
// LEAVING IS ALWAYS SAFE, and that is what makes the visible nav legal here. The commit
// fires on the tap that chooses, so there is no staged state to abandon: navigating away
// mid-pick is identical to Cancel. This is the ONLY reason ceNav clears `picker`.
//
// THE QUERY IS useState, AND THIS IS THE FIRST onType -> useState CONSUMER IN THE FILE.
// ceField's FIELD-SCRATCH rule -- "an onType handler may write a MODULE VARIABLE and
// nothing else" -- is aimed squarely at STORE writes, because a store write repaints every
// subscriber of that store on every keystroke. useState repaints ONE component, and while
// the picker is up that component IS the body. The rule's other ground, onInput
// multi-firing with stale values at word boundaries, is precisely the case ceField's own
// comment calls harmless for a scratchpad because the last event carries the truth: a
// transiently wrong FILTER self-corrects on the next keystroke in a way a transiently
// wrong STORED VALUE never does. The free-text draft below is a plain CLICK-BEFORE-BLUR
// scratchpad and is the same shape STUDIO-DRAFTS already uses.
//
// THE SEARCH FIELD BINDS value:'' PERMANENTLY, on purpose. A field whose `value` prop
// never changes never sets wantRef, so FIELD-KEYLESS's re-seed path never runs and a
// per-keystroke re-render cannot reach into the element the user is typing in. The query
// lives only in useState. Do NOT "fix" this to value:q.
// ============================================================================

// Below this many options a search field is noise, so it does not render. The hook that
// backs it is called unconditionally regardless -- only the rendering is conditional.
var CE_PICK_SEARCH_MIN = 10;

// The free-text draft. A MODULE VAR because a button reads it, and in this environment a
// click is delivered BEFORE the blur it causes (CLICK-BEFORE-BLUR) -- a commit-on-blur
// value would be one keystroke stale on the button's first press, every time.
var _cePickDraft = '';

// Cast options, shared by every picker whose referent is a person.
// INCLUDES THE PROTAGONIST as '__player__'. CharPosition's own interface comment names
// that id as a first-class legal target ("'__player__' for the protagonist"), and the chip
// list this replaces offered only the roster -- so a Position against the player, the
// model's most common case, was literally unreachable from the UI. That is a fix, not a
// feature: nothing downstream needed changing, the id was already the supported one.
function _cePickCast(src: any): any[] {
    var out: any[] = [];
    var cfg: any = (src && src.profile && src.profile.cfg) || null;
    out.push({ id: '__player__', label: String((cfg && cfg.protagonistName) || 'You'),
               sub: 'the protagonist' });
    var roster: any[] = (src && src.profile && src.profile.roster) || [];
    for (var i = 0; i < roster.length; i++) {
        if (!roster[i]) continue;
        out.push({ id: String(roster[i].id), label: String(roster[i].name || 'Unnamed'), sub: '' });
    }
    return out;
}

// Each def:
//   title            surface heading
//   hint             one line under it, or ''
//   freeLabel        heading of the "not in the list" block ('' suppresses it entirely)
//   freePlaceholder  its field placeholder
//   clearLabel       label of the "unset" row ('' suppresses it)
//   options(ctx,src) -> [{ id, label, sub }] evaluated at RENDER time
//   current(ctx,src) -> the currently-chosen OPTION ID, or '' for none/free text
//   commit(ctx,id,label) -> Promise. ONE commit, both halves. id is '' for free text.
var CE_PICKER_DEFS: { [k: string]: any } = {

    // A VOCABULARY REFERENCE, not an entity one: there is no species record anywhere, so
    // the id IS the label and there is nothing to denormalize. It is still a reference by
    // SS13's test -- the value names something the world already knows about -- and it is
    // one of the two standing check-5 violations the rule was written to close.
    species: {
        title: 'Species',
        hint: 'Drawn from what the cast already uses, so two characters of the same kind read as the same kind.',
        freeLabel: 'Something else',
        freePlaceholder: 'Name it\u2026',
        clearLabel: 'Leave unset',
        options: function(ctx: any, src: any): any[] {
            var list: any[] = (src && src.profile && src.profile.vocabSpecies) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                out.push({ id: String(list[i]), label: String(list[i]), sub: '' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            return String((p && p.species) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileWrite(String(ctx.charId || ''), 'species', label);
        }
    },

    // THE REFERENCE IMPLEMENTATION SS13 CITES, now actually written as one. The chip list
    // this replaces wrote targetId and targetName through TWO sequential ceProfileWrite
    // calls -- two load/apply/save/publish round trips -- so a failure between them left
    // an id with the wrong name beside it. ceProfileWritePair makes it one commit, which
    // is what SS13 asked for in the first place.
    positionTarget: {
        title: 'Positioned against',
        hint: 'One primary counterpart. Secondaries and factions are static lorebook facets, not positions \u2014 a second primary would mean two answers to the same question.',
        freeLabel: 'Someone not in the cast',
        freePlaceholder: 'Their name\u2026',
        clearLabel: 'No position',
        options: function(ctx: any, src: any): any[] { return _cePickCast(src); },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            var pos: any = (p && p.position) || {};
            return String(pos.targetId || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileWritePair(String(ctx.charId || ''), [
                { k: 'position.targetId', v: id },
                { k: 'position.targetName', v: label }
            ]);
        }
    },

    // [v2.146.0 HOOK-TARGETID] Now a FULL reference, id and all — UnresolvedHook gained
    // targetId in the same patch. `current` reads the id directly instead of the v2.145.0
    // label match, so a target whose name was later edited elsewhere still reads as chosen.
    hookTarget: {
        title: 'Toward',
        hint: 'Who the tension is directed at.',
        freeLabel: 'Someone not in the cast',
        freePlaceholder: 'Their name\u2026',
        clearLabel: 'Leave unset',
        options: function(ctx: any, src: any): any[] { return _cePickCast(src); },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            var hooks: any[] = (p && p.hooks) || [];
            for (var i = 0; i < hooks.length; i++) {
                if (hooks[i] && hooks[i].id === ctx.hookId) return String(hooks[i].targetId || '');
            }
            return '';
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileHookOp(String(ctx.charId || ''), 'target',
                                   String(ctx.hookId || ''), { id: id, name: label });
        }
    },

    // [v2.147.0 JSXENTITY] The world graph's three references. All read ceEntityStore's
    // published `index` (id/name/type, already resolved at publish time) rather than
    // calling loadEntityIndex from a render path -- options() is synchronous by contract.
    // SELF IS ALWAYS EXCLUDED: an entity nested under itself is the one input
    // ceMapWouldCycle exists to reject, and offering it is offering a mistake.
    entityParent: {
        title: 'Nest inside',
        hint: 'A child sits physically inside its parent. Entering a room moves the scene down the tree.',
        freeLabel: '',
        clearLabel: 'Top of the world',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var out: any[] = [];
            // Built ONCE, not per candidate: this runs on every render of the picker and
            // rebuilding the map inside the loop is O(n^2) over the whole world index.
            var byId: any = {};
            for (var k = 0; k < idx.length; k++) { byId[idx[k].id] = idx[k]; }
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id) continue;
                // A parent that is one of this node's own descendants would close a loop.
                // The map's guard is the authority on that question, so it is the one asked.
                if (ceMapWouldCycle(byId, String(ctx.id), String(idx[i].id))) continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: idx[i].type });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var e: any = (src && src.entity && src.entity.ent) || null;
            return String((e && e.parentId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceEntityWrite(String(ctx.id || ''), 'parentId', id);
        }
    },

    // Narrative nesting is a SECOND, PARALLEL tree on the same records (plot inside plot),
    // which is why narrativeParentId exists beside parentId at all. Only narratives are
    // offered -- nesting a plot under a room would be a category error the graph has no
    // reader for.
    narrativeParent: {
        title: 'Part of',
        hint: 'Plots nest inside plots. This is separate from where the entity physically sits.',
        freeLabel: '',
        clearLabel: 'A root plot',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var out: any[] = [];
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id) continue;
                if (idx[i].type !== 'narrative') continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: '' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var e: any = (src && src.entity && src.entity.ent) || null;
            return String((e && e.narrativeParentId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceEntityWrite(String(ctx.id || ''), 'narrativeParentId', id);
        }
    },

    // [v2.150.0 PHASE-F] The SECOND picker that adds rather than sets -- see
    // entityConnection below for the shape's own reasoning, which is identical here: an
    // inventory is a list, not a field, so there is no `current` and no clear row.
    // NO FREE TEXT, DELIBERATELY, and this is the one place SS13's "not in the list is not
    // optional" does not apply: a typed name here could only mean "make a new item", and
    // an item made from a bare string would be a record with nothing on it and no way
    // back to it. The drill's own "New item" button does that job properly -- it creates
    // AND LANDS ON the record, which is the whole premise of Phase E.
    equipAdd: {
        title: 'Add an item',
        hint: 'Moves an existing item into this character\u2019s hands. Anything currently worn by someone else is taken off them first.',
        freeLabel: '',
        clearLabel: '',
        options: function(ctx: any, src: any): any[] {
            var eq: any = (src && src.profile && src.profile.equip) || null;
            var list: any[] = (eq && eq.candidates) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                out.push({ id: list[i].id, label: list[i].name,
                           sub: list[i].where ? ('in ' + list[i].where) : 'loose in the world' });
            }
            return out;
        },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceProfileEquipAdd(String(ctx.charId || ''), id);
        }
    },

    // THE ONE PICKER THAT ADDS RATHER THAN SETS, and so the one with no `current` selection
    // and no clear row: routes are a list, not a field. Targets already routed to are
    // filtered out, which is what makes a second tap on the same place impossible rather
    // than merely idempotent.
    entityConnection: {
        title: 'Route to',
        hint: 'Somewhere the parent/child tree does not already reach \u2014 a road, a door, a teleporter.',
        freeLabel: '',
        clearLabel: '',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var conns: any[] = (src && src.entity && src.entity.conns) || [];
            var taken: any = {};
            for (var c = 0; c < conns.length; c++) { taken[conns[c].targetId] = 1; }
            var out: any[] = [];
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id || taken[idx[i].id]) continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: idx[i].type });
            }
            return out;
        },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceEntityConnOp(String(ctx.id || ''), 'add', id, 'Go to ' + label);
        }
    },

    // [v2.155.0 JSXWIZARD] The intro tab's opening-location choice. Reads the WIZARD
    // store's index, not the Entity surface's: this picker opens with no entity loaded, so
    // ceEntityStore.index is empty every time it matters. Commit writes tempStorage rather
    // than a record because the choice is staging state for a generation, not world data --
    // the same tier the native branch used.
    wizIntroLoc: {
        title: 'Opening location',
        hint: 'Where the first scene happens. The draft is written from this place.',
        freeLabel: '',
        clearLabel: 'No location yet',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.wiz && src.wiz.entIndex) || [];
            var byId: any = {};
            var k = 0;
            for (k = 0; k < idx.length; k++) { byId[idx[k].id] = idx[k]; }
            var out: any[] = [];
            var i = 0;
            for (i = 0; i < idx.length; i++) {
                if (idx[i].type !== 'location') continue;
                var par: any = idx[i].parentId ? byId[idx[i].parentId] : null;
                out.push({ id: idx[i].id, label: idx[i].name, sub: par ? ('in ' + par.name) : 'top of the world' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            return String((src && src.wiz && src.wiz.introLocId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_INTRO_LOC, String(id || '')))
                .catch(function(e: any) { api.v1.error('[AE:jsxwizard] intro loc write failed:', e); })
                .then(cePublishWiz);
        }
    }
};

function cePickerOpen(kind: string, ctx: any): void {
    if (!CE_PICKER_DEFS[kind]) {
        api.v1.error('[AE:jsxpick] unknown picker kind: ' + String(kind));
        return;
    }
    ceUiPatch(function() { return { picker: { kind: String(kind), ctx: ctx || {} } }; });
}

function cePickerClose(): void {
    ceUiPatch(function() { return { picker: null }; });
}

// [v2.152.0 PHOTO-VIEW] Opens the full-screen viewer for one image slot. No `kind`
// registry the way pickers have one -- there is exactly one thing to view (an anchored
// image), not a family of referential fields, so a table would describe nothing a
// parameter does not already say.
function cePhotoOpen(charId: string, slot: string, label: string): void {
    ceUiPatch(function() { return { photo: { charId: String(charId || ''), slot: String(slot || ''),
                                            label: String(label || slot || 'Image') } }; });
}
function cePhotoClose(): void {
    ceUiPatch(function() { return { photo: null }; });
}

// -- Slot options  [v2.157.0 SLOT-OPTIONS-JSX] --------------------------------
// THE STATE BEHIND THE INLINE GENERATOR STRIP. The renderer is _ceGenBtn; these five
// verbs are the whole surface area (Open / Close / Patch / Run / Commit).
//
// IT CALLS generateSlotOptions DIRECTLY, no message round trip. The bridge only ever
// reached that function by posting AE_GEN_SLOT_OPTIONS and waiting for EVT_SLOT_OPTIONS
// back; the engine is where it lives, so this just calls it.
//
// _ceGenSpec RESOLVES instructions + the DEFAULT budget, the same way the
// AE_GEN_SLOT_OPTIONS handler does, and the call site passes what it resolved. From there
// the author can change the budget on the strip; the resolution policy itself stays in
// one place.
//
// METHOD IS NO LONGER 'auto'. It defaults to 'direct' and is a control on the strip. See
// ceSlotOptsRun for why 'auto' had to go: it resolved against a tempStorage run counter
// that resets on every story load, so the free-yoink branch won nearly every time and
// forced wantCount to 1 no matter what the author asked for.
var _ceSlotOptsHint = '';   // CLICK-BEFORE-BLUR: draft steer text is a module var, never store state

function ceSlotOptsOpen(charId: string, fieldKey: string, label: string,
                        instructions: string, budget: number): void {
    _ceSlotOptsHint = '';
    ceUiPatch(function() {
        return { slotOpts: {
            charId: String(charId || ''), fieldKey: String(fieldKey || ''),
            label: String(label || fieldKey || 'Field'),
            instructions: String(instructions || ''), budget: Number(budget) || 150,
            // [v2.161.0 GEN-INLINE] method DEFAULTS TO 'direct', not 'auto'. See
            // ceSlotOptsRun's note: 'auto' silently collapsed the count to 1 while free
            // yoink runs remained, so the count select was decorative most of the time.
            count: 3, method: 'direct', status: 'idle', options: [], note: ''
        } };
    });
}

// TRUE when the strip belongs to THIS field. Reads the store directly rather than taking
// a parameter, the same hook-free shape _ceGuideOpen uses and for the same reason: the
// Root that renders it subscribes, so a patch repaints and this is re-invoked.
function _ceSlotOptsFor(charId: string, fieldKey: string): any {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; }
    catch (e) { st = null; }
    if (!st) return null;
    if (String(st.charId) !== String(charId) || String(st.fieldKey) !== String(fieldKey)) return null;
    return st;
}

function ceSlotOptsClose(): void {
    _ceSlotOptsHint = '';
    ceUiPatch(function() { return { slotOpts: null }; });
}

function ceSlotOptsPatch(partial: any): void {
    ceUiPatch(function(u: any) {
        var cur: any = (u && u.slotOpts) || null;
        if (!cur) return {};
        var next: any = {}; var k: string;
        for (k in cur) { next[k] = cur[k]; }
        for (k in (partial || {})) { next[k] = partial[k]; }
        return { slotOpts: next };
    });
}

// Laziness fails toward stability: a failed or empty generation leaves the field alone and
// says so. Nothing here writes the character record -- only ceSlotOptsCommit does.
async function ceSlotOptsRun(): Promise<void> {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; } catch (e) { st = null; }
    if (!st || !st.charId) return;
    ceSlotOptsPatch({ status: 'running', note: '', options: [] });
    try {
        var c: any = await loadCharacter(st.charId);
        if (!c) { ceSlotOptsPatch({ status: 'error', note: 'Character not found.' }); return; }
        var cfg: any = await loadConfig();
        // [v2.161.0 GEN-INLINE] METHOD IS THE AUTHOR'S, NOT 'auto'. Passing 'auto' let
        // generateSlotOptions resolve to a single-candidate yoink draw whenever free runs
        // remained (AE_YOINK_RUN_MAX, a tempStorage counter that resets on every story
        // load) -- so asking for three candidates produced one, nearly every time, and the
        // count select apologised for itself in its own hint. The knob is now on the
        // strip: 'direct' is a metered call that honours the count, 'yoink' is a free draw
        // and is ALWAYS one candidate (three separate draws cannot see each other, so
        // asking one call for three differing answers is incoherent there).
        var soMethod = (String(st.method || 'direct') === 'yoink') ? 'yoink' : 'direct';
        var out: any = await generateSlotOptions(
            c, String(st.label || ''), String(st.instructions || ''),
            (cfg && cfg.generalStyle) || '', _ceSlotOptsHint || '',
            Number(st.budget) || 150, Number(st.count) || 3, '',
            { includeStory: false, method: soMethod }
        );
        if (!out || !out.length) {
            ceSlotOptsPatch({ status: 'error', note: 'Came back empty \u2014 try again, or lower the count.' });
            return;
        }
        ceSlotOptsPatch({ status: 'done', options: out, note: '' });
    } catch (e) {
        var msg = String((e as any) && ((e as any).message || e) || '');
        // Same classification the AE_GEN_SLOT_OPTIONS handler makes: a concurrency refusal
        // is not a retry-harder failure and needs different advice.
        var busy = msg.indexOf('already in progress') >= 0;
        api.v1.error('[AE:jsxprofile] slot options failed:', e);
        ceSlotOptsPatch({ status: 'error',
            note: busy ? 'Another generation is running \u2014 wait for it to finish.'
                       : ('Generation error. ' + msg) });
    }
}

async function ceSlotOptsCommit(text: string): Promise<void> {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; } catch (e) { st = null; }
    if (!st || !st.charId || !st.fieldKey) return;
    await ceProfileWrite(st.charId, String(st.fieldKey), String(text || ''));
    ceSlotOptsClose();
}

// THE CALL-SITE HALF, and the reason SS12 check 5 becomes auditable rather than a
// judgement call: a referential field renders THIS, never a ceField, so the two shapes are
// distinguishable by grep and by eye. HOOK-FREE BY CONTRACT, same as ceSelect -- it is
// rendered inside the hooks loop and inside CE_IDENTITY_FIELDS' loop, so adding a hook
// here is a breaking change, not a refactor.
function cePickerRow(opts: any): any {
    var def: any = CE_PICKER_DEFS[opts.kind] || null;
    var shown = String(opts.value || '');
    var title = String(opts.label || (def && def.title) || 'Choose');
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        opts.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, opts.label) : null,
        h('div', {
            onClick: function() {
                ceTap('pick:open:' + String(opts.kind), function() {
                    cePickerOpen(String(opts.kind), opts.ctx || {});
                });
            },
            role: 'button', tabIndex: 0,
            // SS11: the row states what it is AND what is in it, because the chevron alone
            // means nothing to anything that is not looking at it.
            'aria-label': title + ': ' + (shown || 'not set') + '. Choose.',
            style: {
                display: 'flex', alignItems: 'center', gap: CE_T.s2,
                minHeight: CE_T.tap, padding: CE_T.s2 + ' ' + CE_T.s3, cursor: 'pointer',
                // Same two-part editable-ground treatment ceField's default path carries
                // (STYLE2-E): a CE_FILL ground says "this is a surface you act on".
                background: CE_FILL, borderRadius: CE_T.r,
                border: '1px solid ' + CE_LINE, fontSize: CE_T.fs
            }
        },
            h('div', { style: { flex: '1 1 auto', minWidth: '0',
                                opacity: shown ? CE_OP.t1 : CE_OP.t3 } },
              shown || String(opts.placeholder || 'Choose\u2026')),
            h('div', { style: { flex: '0 0 auto', opacity: CE_OP.t3, fontSize: CE_T.fsSm } }, '\u203a')
        ),
        opts.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                                        lineHeight: CE_T.lhProse } }, opts.hint) : null
    );
}

// A REAL COMPONENT, mounted via h() from ceRoot -- it holds four hooks of its own, and the
// same reasoning _ceProfileImagesDrill's header sets out applies: hooks belong in their own
// scope, never folded into a caller's sequence by a bare function call.
function _cePickerSurface(props: any): any {
    // Straight-line and idempotent, so it adds no hook and cannot shift the sequence below
    // it -- same construction _ceProfileImagesDrill uses for ceImgSlotStoreInit.
    ceProfileStoreInit();
    // [v2.147.0 JSXENTITY] A def reading a store adds ONE unconditional subscription here.
    // Over-subscription is cheap in this component specifically -- the picker is a full
    // surface swap, so nothing else is mounted while it is up -- but it must stay
    // unconditional or the hook sequence shifts between kinds.
    ceEntityStoreInit();
    // [v2.155.0 JSXWIZARD] Third store, same unconditional-subscription rule as the note
    // above: wizIntroLoc reads the entity index the WIZARD published, not the one the
    // Entity surface publishes, because the intro picker is reachable with no entity open.
    ceWizStoreInit();
    var ui: any = useStoreValue(ceUiStore);
    var prof: any = useStoreValue(ceProfileStore);
    var entSrc: any = useStoreValue(ceEntityStore);
    var wizSrc: any = useStoreValue(ceWizStore);
    var qS: any = useState(''); var q = String(qS[0] || ''); var setQ = qS[1];
    var dS: any = useState(''); var setDraft = dS[1];
    // The free-text draft is read by a BUTTON, so it cannot live in the state the button
    // renders from -- CLICK-BEFORE-BLUR. It is a module var written by onType, exactly as
    // STUDIO-DRAFTS does. setDraft exists only to force the repaint that reveals the
    // commit button once something has been typed.
    var draft = String(_cePickDraft || '');

    var pk: any = (ui && ui.picker) || null;
    var kind = String((pk && pk.kind) || props.kind || '');
    var ctx: any = (pk && pk.ctx) || props.ctx || {};
    var def: any = CE_PICKER_DEFS[kind];
    // AFTER every hook, never before: an early return that skips a hook is the one thing
    // this environment's own header calls fatal.
    if (!def) return null;

    var src: any = { profile: prof, entity: entSrc, wiz: wizSrc };
    var all: any[] = [];
    try { all = def.options(ctx, src) || []; }
    catch (e) { api.v1.error('[AE:jsxpick] options failed:', e); all = []; }
    var cur = '';
    try { cur = String(def.current(ctx, src) || ''); }
    catch (e2) { api.v1.error('[AE:jsxpick] current failed:', e2); }

    function choose(id: string, label: string) {
        ceAction('pick:' + kind, function() {
            return Promise.resolve(def.commit(ctx, String(id || ''), String(label || '')))
                .then(function() { _cePickDraft = ''; cePickerClose(); });
        });
    }

    var needle = q.trim().toLowerCase();
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) {
        var o: any = all[i];
        var lab = String((o && o.label) || '');
        if (!lab) continue;
        if (needle && lab.toLowerCase().indexOf(needle) < 0) continue;
        rows.push((function(oo: any, ll: string) {
            var on = (String(oo.id) === cur) && !!cur;
            return ceListRow({
                // The check is the ONLY selection signal that survives a colour-blind
                // reading (SS11: state is never colour alone). The ground reinforces it.
                lead: h('div', { style: { width: '17px', height: '17px', flex: '0 0 auto',
                                          display: 'flex', alignItems: 'center',
                                          opacity: on ? CE_OP.t1 : CE_OP.t3 } },
                        on ? ceIconCheck() : null),
                label: ll,
                sub: String(oo.sub || ''),
                onClick: function() { choose(String(oo.id), ll); }
            });
        })(o, lab));
    }

    var body: any[] = [];

    if (def.hint) {
        body.push(h('div', { key: 'pk_hint', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                                                      lineHeight: CE_T.lhProse } }, String(def.hint)));
    }

    if (all.length >= CE_PICK_SEARCH_MIN) {
        body.push(h(ceField, {
            key: 'pk_q', k: 'pick:q:' + kind, label: '',
            // PERMANENTLY '' -- see the block header. Not a bug, do not bind q here.
            value: '', multiline: false,
            placeholder: 'Filter\u2026',
            onType: function(v: string) { setQ(String(v || '')); },
            onCommit: function(v: string) { setQ(String(v || '')); return Promise.resolve(); }
        }));
    }

    if (rows.length) {
        body.push(h('div', { key: 'pk_rows', style: { display: 'flex', flexDirection: 'column' } }, rows));
    } else {
        body.push(h('div', { key: 'pk_none' },
            ceEmpty(all.length ? 'Nothing matches that.' : 'Nothing to choose from yet.', null)));
    }

    if (def.clearLabel) {
        body.push(h('div', { key: 'pk_clear' },
            ceBtn(String(def.clearLabel), 'pick:clear:' + kind, function() {
                choose('', '');
                return Promise.resolve();
            })));
    }

    // "NOT IN THE LIST" IS NOT OPTIONAL (SS13). A world half-built must not be a wall, and
    // for a vocabulary picker like species it is the ONLY way the first value ever gets in.
    if (def.freeLabel) {
        body.push(h('div', { key: 'pk_free', style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s2,
            paddingTop: CE_T.s3, borderTop: '1px solid ' + CE_LINE
        } },
            ceKey(String(def.freeLabel)),
            h(ceField, {
                key: 'pk_free_f', k: 'pick:free:' + kind, label: '',
                value: '', multiline: false,
                placeholder: String(def.freePlaceholder || 'Type it\u2026'),
                onType: function(v: string) { _cePickDraft = String(v || ''); setDraft(_cePickDraft); },
                onCommit: function(v: string) { _cePickDraft = String(v || ''); setDraft(_cePickDraft); return Promise.resolve(); }
            }),
            draft.trim()
                ? ceBtn('Use \u201c' + _ceTrim(draft.trim(), 24) + '\u201d', 'pick:free:' + kind, function() {
                    choose('', draft.trim());
                    return Promise.resolve();
                  })
                : null
        ));
    }

    return ceScreen(
        // [v2.146.0 NOHEADER] The picker's title goes with every other one. What a picker
        // is choosing is already stated by the row that opened it and by def.hint, which
        // renders as the first thing in the body.
        ceHeader(
            ceBtn('Cancel', 'pick:cancel', function() {
                _cePickDraft = '';
                cePickerClose();
                return Promise.resolve();
            })),
        body
    );
}

// -- Full-screen photo viewer  [v2.152.0 PHOTO-VIEW] -------------------------
// surface_list line 16: "avatars should be larger and open full screen when clicked. They
// are too small to see their quality." Scoped to the Images drill's 26 slot thumbnails
// (64x96px) -- sizing was already fixed in the STYLE2-F pass; this is the other half.
//
// A FULL SURFACE SWAP, NOT AN OVERLAY, for the same reason the picker is one: there is no
// color token in this environment to paint an opaque floating panel with (see the
// ceSheetOpen [DEAD] note). HOOK-FREE, so it is called bare rather than through h() --
// same rule every other drill follows.
//
// CE_IMG_CONTAIN, NOT THE DEFAULT COVER-CROP. The whole point is seeing the image's own
// quality, and a cover-cropped frame hides exactly the edges a cropped thumbnail already
// hid. Frame height is fixed px, not aspect-ratio, same constraint _ceEntityImage's own
// note gives (the painter's <img> is position:absolute height:100%); the number is bigger
// than Scene's/Entity's because this surface has nothing else competing for room.
function _cePhotoSurface(charId: string, slot: string, label: string): any {
    var frame = h('div', ceImgAnchor(charId, slot, {
        style: { width: '100%', height: '520px', borderRadius: CE_T.r,
            background: CE_WELL, border: '1px solid ' + CE_LINE,
            position: 'relative', overflow: 'hidden' }
    }, CE_IMG_CONTAIN));
    var labelNode = h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2,
        textAlign: 'center', paddingTop: CE_T.s2 } }, label);
    return ceScreen(
        ceHeader(ceBtn('Close', 'photo:close', function() { cePhotoClose(); return Promise.resolve(); })),
        [frame, labelNode]
    );
}


// ============================================================================
// SECTION 29 — SCENE SURFACE (jsx)  [v2.108.0 JSXSCENE]
// First surface built on SECTION 28. Renders the same SceneStatePayload the
// bridge HUD consumes: current location plus the present roster with attention
// dots. Read-only in this pass, by design - the point of landing it now is to
// evaluate the kit on a real screen before any authoring affordances are built
// on top of it.
//
// PUBLISHES ON OPEN, not on state change. Wiring automatic publish into the
// scene-change choke point is deferred deliberately: queueSceneStateBroadcast()
// is bridge-gated and re-pointing its call sites is a separate, non-additive
// change that should land after the layout is settled.
// ============================================================================

function ceSceneRoot(): any {
    var scene = useStoreValue(ceSceneStore);
    var ui = useStoreValue(ceUiStore);

    useEffect(function() {
        // Fires once per mount. Does NOT call api.v1.ui.update - see rule 1.
        cePublishScene();
    }, []);

    var refreshBtn = ceBtn('Refresh', 'scene:refresh', function() { return cePublishScene(); });

    // [v2.114.0 JSXJOURNAL] The story journal's only engine-side door. Both header
    // branches below render this SAME node, so the loading state is not a dead end and
    // so Preact never patches a Journal handler onto a Refresh button.
    // [v2.146.0 NOHEADER] The 'Journal' button is DELETED. Journal is on the shell nav,
    // rendered directly above this row -- it was a second door beside an identical first
    // one, and the only thing it added was a return address that ceBack now correctly
    // renders nothing for when arriving via the nav instead.
    var sceneActions = refreshBtn;

    // [v2.112.0 SCENE-NEWCHAR, per user] Reuses createWizardCharacter, which is the one
    // function that does the whole job: makeDefaultEntity + saveEntity, makeDefaultCharacter
    // + saveCharacter, then createLinkedLorebookEntry. Passing fields=null makes a blank
    // record rather than a generated one -- generation belongs to the profile's own
    // Generate buttons now, and a character created from nothing has no seed to generate
    // from anyway. Navigates straight into the new profile, because an empty character
    // created and then left on a list is a character nobody finishes.
    var newBtn = ceBtn('New character', 'scene:newchar', function() {
        return (async function() {
            try {
                var newId: string = await createWizardCharacter('New character', '', null);
                await cePublishScene();
                if (newId) { ceNav('profile', newId); }
            } catch (e) {
                api.v1.error('[AE:jsxscene] create character failed:', e);
                try { api.v1.ui.toast('Could not create character.', { type: 'error', autoClose: 2000 }); } catch (e2) {}
            }
        })();
    }, 'primary');

    if (!scene || !scene.ready) {
        return ceScreen(ceHeader(sceneActions), ceEmpty('Loading scene...', null));
    }

    var body: any[] = [];

    // [v2.149.0 PHASE-G-PRIME, per surface_list lines 24, 28 and 29] SCENE IMAGE AT THE TOP,
    // AN EDIT BUTTON BESIDE THE NAME, THE DESCRIPTION UNDER THE IMAGE. All three are the
    // LOCATION's, which is precisely why CE-ROADMAP SS3 moved them out of Phase G and behind
    // Phase E: there was nothing to point at until a location had its own image slot and its
    // own edit surface. Both exist now (v2.147.0 JSXENTITY, v2.148.0 ENT-IMAGE) and this adds
    // NO storage, NO verb and NO bridge message -- it is a second VIEW of the same
    // '<entityId>|Avatar' anchor the Entity surface already draws.
    //
    // "UNLESS BLANK" IS TWO DIFFERENT MISSES AND THEY ARE ANSWERED IN TWO DIFFERENT PLACES.
    //   - SLOT IS EMPTY -> CE_IMG_COLLAPSE. This file cannot know what is in the bridge's
    //     IndexedDB and must not keep a mirror of it; CE-IMG-OPTS states that argument in
    //     full and it is unchanged here. Collapse hands the question to the party that knows
    //     and removes the element from flex layout INCLUDING its gap, which is identical to
    //     never emitting it.
    //   - THERE IS NO BRIDGE -> gated here, on isBridgeReady. That fact IS engine-known: it
    //     is the handshake, not a guess about storage contents. Without this gate a
    //     bridge-less user gets a permanently empty box at the top of their main surface,
    //     because nothing is ever going to run the collapse that would have hidden it.
    // The two are NOT redundant and neither one covers the other's case.
    //
    // ROOT IS NOT AN ENTITY. AE_ROOT_LOCATION_ID is a deliberate sentinel with no record
    // behind it, so it gets neither frame nor edit button -- navigating to 'entity' with that
    // id would land on "That entity is no longer in the world."
    //
    // THE FRAME IS NOT TAPPABLE, for the same reason the roster card below is built from
    // siblings: the edit button is the door (line 28 asked for a button), and an onClick on
    // the frame would put a second target on one element. SS8: ceTap is never nested.
    var locId = String(scene.locationId || '');
    var locReal = !!locId && locId !== AE_ROOT_LOCATION_ID;
    // Same three heights as _ceEntityImage, and deliberately COPIED rather than shared: the
    // painter needs a real height (its <img> is position:absolute, height:100%), aspectRatio
    // has no precedent in this file, and two surfaces that currently agree about a box are
    // not yet one fact. Extract it if a third asks.
    var locImgW = Number(scene.locationImgW) || 1216;
    var locImgH = Number(scene.locationImgH) || 832;
    var locFrameH = (locImgH > locImgW) ? '320px' : ((locImgH === locImgW) ? '260px' : '200px');
    if (locReal && isBridgeReady) {
        body.push(h('div', ceImgAnchor(locId, CE_IMG_SLOT_AVATAR, {
            key: 'scene_img',
            style: {
                width: '100%', height: locFrameH, borderRadius: CE_T.r,
                background: CE_WELL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_COLLAPSE)));
    }

    body.push(ceSection('Location',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
            h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fs } },
                    scene.locationName || 'Nowhere'),
                locReal
                    ? ceIconBtn('Edit ' + (scene.locationName || 'this location'), ceIconEdit(),
                        'scene:locedit', function() {
                            // One-deep return address, the shape NAV-BACK defines. Scene is a
                            // top-level route so entityId is deliberately blank.
                            ceNav('entity', locId, '', { surface: 'scene', entityId: '', label: 'Scene' });
                            return Promise.resolve();
                        })
                    : null
            ),
            scene.locationDesc
                ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.45' } }, scene.locationDesc)
                : null
        )
    ));

    // [v2.144.0 PHASE-G, per surface_list lines 25-27 and 30] ONE CARD RENDERER, BOTH
    // LISTS. Present and away differ by exactly two things -- which verb the trailing
    // control offers, and whether attention is meaningful -- so they are one function with
    // a flag rather than two that drift apart.
    //
    // THE CARD IS NOT TAPPABLE, AND THAT IS DELIBERATE. It holds TWO targets (open the
    // profile; add/exclude), and CE-STYLE SS8 says ceTap is "Never nested" -- a ceCard with
    // an onClick wraps its whole box in one, so an icon button inside it would fire the
    // button's handler AND the card's on a single physical tap. So the card draws the box
    // and the hue, and the two targets are SIBLINGS inside it: a tappable identity region
    // and a ceIconBtn. The chat contact card stays tappable because it has no inner control.
    //
    // WHAT LEFT THE CARD (surface_list line 27): compressedLine -- the recent thought -- and
    // the attention WORD trail. The sub-line is identity now (the one-liner, else the role),
    // which is what the list asked for and is also the only thing on a roster row that says
    // who a person IS rather than what they last did.
    // WHAT STAYED: the attention ring + ceDot inside the avatar frame (v2.120.0, whose own
    // reasoning is preserved verbatim below). It is not the "ephemeral status" the list
    // asked to drop -- that was the text -- and SS11 requires state to be shape AND colour,
    // which the dot-inside-ring already satisfies.
    // TWO HUES ON ONE CARD, ON PURPOSE: the left border is PATTERN (identity, SS6.3 #2) and
    // the avatar ring is CE_SEM (attention). Different vocabularies, never the same pixel,
    // and collapsing them would make "who this is" and "do they need you" indistinguishable.
    function sceneCard(c: any, inScene: boolean): any {
        var att = c.attention || { level: 'calm', reason: '' };
        // [v2.120.0 SCENE-AVATAR-RING, per user] THE DOT LIVES INSIDE THE AVATAR FRAME AND
        // THE ATTENTION HUE BECOMES THE FRAME'S RING. WHY THIS WORKS WITHOUT THE ENGINE
        // KNOWING WHETHER AN AVATAR EXISTS -- which it still does not, and still must not
        // mirror: the dot is the anchor's OWN CHILD, so it is the empty state, exactly like
        // the hero frame's '+'. A painted image is absolutely positioned over the whole
        // frame and simply covers it. CE_IMG_SHRINK then handles the miss. One anchor, both
        // states, no second attribute and no inventory.
        // 'calm' has no hue by design (CE_SEM.calm is transparent), so the ring falls back
        // to the hairline rather than drawing attention a calm character has not earned.
        var attCol = CE_SEM[att.level || 'calm'] || 'transparent';
        var pat = CE_PATTERN_DEFS[String(c.pattern || '')] || null;
        var sub = String(c.briefDescription || '').trim() || String(c.role || '').trim();
        return ceCard({
            key: 'sc_' + c.id,
            hue: pat ? pat.c : '',
            children: h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3 } },
                h('div', {
                    onClick: (function(cid) { return function() {
                        ceTap('scene:prof:' + cid, function() { ceNav('profile', cid); });
                    }; })(c.id),
                    style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                        alignItems: 'center', gap: CE_T.s3, cursor: 'pointer' }
                },
                    // surface_list line 30: "avatars default square with rounded corners",
                    // and larger. 30px circle -> 48px rounded square.
                    h('div', ceImgAnchor(c.id, CE_IMG_SLOT_AVATAR, {
                        style: {
                            flex: '0 0 auto', width: '48px', height: '48px', borderRadius: CE_T.r,
                            background: CE_FILL, overflow: 'hidden', position: 'relative',
                            border: '2px solid ' + (attCol === 'transparent' ? CE_LINE : attCol),
                            display: 'flex', alignItems: 'center', justifyContent: 'center'
                        }
                    }, CE_IMG_SHRINK),
                        ceDot(att.level || 'calm')
                    ),
                    h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                        ceH(c.name + (c.isProtagonist ? ' (you)' : '')),
                        sub ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                            overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, sub) : null
                    )
                ),
                inScene
                    ? ceIconBtn('Take ' + c.name + ' out of the scene', ceIconUserMinus(),
                        'scene:out:' + c.id, (function(cid) { return function() {
                            return aeRemoveCharFromScene(cid).then(function() { return cePublishScene(); });
                        }; })(c.id))
                    : ceIconBtn('Bring ' + c.name + ' into the scene', ceIconUserPlus(),
                        'scene:in:' + c.id, (function(cid) { return function() {
                            return aeMoveCharToScene(cid).then(function() { return cePublishScene(); });
                        }; })(c.id))
            )
        });
    }

    var present = scene.present || [];
    var awayList = scene.away || [];
    var showAll = !!(ui && ui.open && ui.open['scene:showall']);
    var rows: any[] = [];
    for (var i = 0; i < present.length; i++) { rows.push(sceneCard(present[i], true)); }
    var awayRows: any[] = [];
    if (showAll) {
        for (var ax = 0; ax < awayList.length; ax++) { awayRows.push(sceneCard(awayList[ax], false)); }
    }

    body.push(ceSection('Present (' + present.length + ')',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            rows.length
                ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, rows)
                : ceEmpty('Nobody is in the scene.', null),
            // [v2.144.0 PHASE-G, per surface_list line 25] "show all characters" REPLACES THE
            // DEDICATED ROSTER, whose toolbar button was removed AHEAD of its replacement in
            // v2.138.0 -- the roadmap's own SS0 flagged that gap, and this closes it.
            // State is ceUiStore.open, the same map every disclosure in the shell uses; a
            // dedicated store field would be a second mechanism for one boolean.
            awayList.length
                ? ceSettingRow('Show all characters',
                    awayList.length + (awayList.length === 1 ? ' character is' : ' characters are')
                        + ' not in this scene',
                    ceToggle(showAll, 'scene:showall', function() {
                        ceToggleOpen('scene:showall'); return Promise.resolve();
                    }, 'Show characters who are not in this scene'))
                : null,
            (showAll && awayRows.length)
                ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, awayRows)
                : null,
            newBtn
        )
    ));

    return ceScreen(ceHeader(sceneActions), body);
}

var _ceSceneHandle: any = null;

function ceRoot(): any {
    // ONE jsx tree for the whole shell. Surfaces are a VALUE (uiStore.surface),
    // not separate modals - so navigation never opens or updates a modal, which
    // is what keeps us clear of the self-update loop.
    var ui = useStoreValue(ceUiStore);
    var surface = ui ? ui.surface : 'scene';
    var body: any;
    // [v2.145.0 PICKER] INTERCEPTED BEFORE THE SURFACE SWITCH, exactly as a seventh surface
    // would be. It renders INSTEAD of the surface (a full swap, not an overlay -- overlays
    // remain non-constructible here, see the ceSheetOpen [DEAD] note) while SHELL-NAV below
    // stays visible, which is legal only because the picker has no staged state to lose.
    var pick: any = (ui && ui.picker) || null;
    // [v2.152.0 PHOTO-VIEW] Checked alongside the picker, same precedence reasoning:
    // both are full swaps with nothing staged to lose, so which one wins when (in
    // practice never, since nothing opens both) is not a real question.
    var photo: any = (ui && ui.photo) || null;
    // [v2.161.0 GEN-INLINE] slotOpts IS NO LONGER INTERCEPTED HERE. It used to be the
    // third member of the picker/photo full-swap family; it is now an INLINE strip that
    // renders under the field it writes to (see _ceGenBtn). The store slot is unchanged
    // and ceNav still clears it -- only the rendering location moved.
    if (pick && pick.kind && CE_PICKER_DEFS[pick.kind]) {
        body = h(_cePickerSurface, { kind: pick.kind, ctx: pick.ctx || {} });
    }
    else if (photo && photo.charId) {
        body = _cePhotoSurface(photo.charId, photo.slot, photo.label);
    }
    else if (surface === 'profile') { body = h(ceProfileRoot, null); }
    // [v2.147.0 JSXENTITY] SECTION 36. Hangs off Map exactly as Profile hangs off Scene:
    // a surface VALUE with an entityId, deliberately absent from CE_SHELL_ROUTES because
    // it is a detail view reached FROM a surface, not a destination of its own.
    else if (surface === 'entity') { body = h(_ceEntityRoot, null); }
    else if (surface === 'journal') { body = h(ceJournalRoot, null); }
    // [v2.128.0, per user] Map was WRONGLY given its own separate modal in v2.127.0 --
    // exactly the pattern this comment already warns against. Consequence, reported live:
    // the map's "Scene" back button called ceNav('scene'), which only patches
    // ceUiStore.surface -- a value nothing inside the Map's own standalone modal was
    // subscribed to, so the button did nothing and the map modal never closed. Fixed by
    // routing Map through this SAME switch, exactly like Profile and Journal.
    else if (surface === 'map') { body = h(_ceMapRoot, null); }
    // [v2.130.0 JSXCHAT] SECTION 33. One line here plus one in CE_SHELL_ROUTES -- the
    // whole point of SHELL-NAV, and the first surface added since it landed.
    else if (surface === 'chat') { body = h(_ceChatRoot, null); }
    // [v2.132.0 SETTINGS-JSX] SECTION 34.
    else if (surface === 'settings') { body = h(_ceSettingsRoot, null); }
    // [v2.133.0 IMGPRESET-JSX] SECTION 35.
    else if (surface === 'images') { body = h(_ceImagesRoot, null); }
    // [v2.155.0 JSXWIZARD] SECTION 37.
    else if (surface === 'wizard') { body = h(_ceWizRoot, null); }
    // [v2.175.0 IMG-EDIT-SURFACE] SECTION 35b. Deliberately absent from CE_SHELL_ROUTES,
    // for the same reason Profile and Entity are: it is a detail view of one record,
    // reached FROM somewhere (a gallery cell, a story card, a chat photo), not a
    // destination you would pick off a nav bar with nothing selected.
    else if (surface === 'imgedit') { body = h(_ceImgEditRoot, null); }
    else { body = h(ceSceneRoot, null); }

    // [v2.176.0 ROUTE-KEY, per user: "you either have to implement the parts in another way
    // that won't carry over, or we have to disconnect the menus in some fashion"] THIS IS
    // THE DISCONNECT, AND IT IS ONE LINE BECAUSE IT IS THE SAME FIX AS TABBODY-KEY ONE
    // LEVEL UP. v2.175.0 keyed each surface's TAB body and that closed the recycle path
    // WITHIN a surface; the slot below is the identical unkeyed-fixed-position shape
    // BETWEEN surfaces, and it had the identical hole.
    //
    // WHY IT BITES EVEN THOUGH THE ROUTER SWAPS COMPONENT TYPES. Most swaps here do change
    // vnode type (h(_ceImagesRoot) -> h(_ceImgEditRoot)) and Preact unmounts correctly for
    // those. TWO OF THE FIVE BRANCHES DO NOT: _cePhotoSurface(...) is CALLED, not wrapped,
    // so it contributes a bare h('div') -- and every ceScreen returns a bare h('div') too.
    // Any transition between two of those is div-to-div at a fixed index, which is reuse,
    // not replacement. The key makes the whole family behave like the typed branches.
    //
    // entityId IS IN THE KEY DELIBERATELY. Profile-to-Profile for a different character and
    // imgedit-to-imgedit for a different record both keep `surface` constant while changing
    // everything on screen, and both mount a ceImgAnchor -- the exact node the bridge
    // appends a foreign <img> into (CESURF-RECYCLE). ceNav is the ONLY writer of entityId
    // (verified by grep this pass), so nothing can bump this key mid-surface and remount a
    // screen out from under a user's typing.
    //
    // THIS IS NOT A SEVENTH RUN AT THE HEADER GHOST (v2.167-v2.172). That one lived inside
    // ceScreen's own child list and was settled by HEADER-INFLOW; this is the router's slot,
    // one level above it, and it has never been keyed at all.
    var routeKey: string = (pick && pick.kind && CE_PICKER_DEFS[pick.kind])
        ? ('picker:' + String(pick.kind))
        : ((photo && photo.charId)
            ? ('photo:' + String(photo.charId) + ':' + String(photo.slot || ''))
            : ('surf:' + String(surface || 'scene') + ':' + String((ui && ui.entityId) || '')));

    // [v2.129.0 SHELL-NAV] The nav lives HERE, in the router, and not in ceScreen or in
    // each surface's own header. Three reasons, in order of weight:
    //   1. ONE PLACE. Surface number five cannot forget to include it. A per-surface
    //      call site is a rule you have to remember; this is a rule you cannot break.
    //   2. It is app chrome, and the router is what owns app chrome. ceScreen is a
    //      LAYOUT primitive used by drills too, and a drill must not offer a way out
    //      that skips its own commit path.
    //   3. Profile and the drills sit UNDER this, so the nav stays visible at depth --
    //      the way out of anywhere is always on screen. No nav item highlights while on
    //      Profile, which is correct: Profile is a detail view reached FROM a surface,
    //      not a destination of its own (CE-SURFACE-COLLAPSE 2, "not a seventh surface").
    // minHeight:'0' on both the column and the body slot is load-bearing: ceScreen below
    // is a height:100% grid, and without it a flex child refuses to shrink and the
    // surface's own scroll container never engages.
    // [v2.139.0 STYLE2] The generation rail mounts HERE, above the nav, for the same
    // reason the nav itself lives in the router (SS10.1 #3): a generation outlives the
    // surface that started it, so the one indicator that must survive navigation cannot
    // live inside anything this switch can replace. It is `flex: 0 0 auto` and renders
    // null when idle, so it costs no layout at rest.
    return h('div', { style: { display: 'flex', flexDirection: 'column', height: '100%', minHeight: '0' } },
        h(ceBusy, null),
        ceShellNav(surface),
        h('div', { key: routeKey, style: { flex: '1 1 auto', minHeight: '0' } }, body)
    );
}

// [v2.131.0 SHELL-TRAY] THE ONE MODAL OPENER. ceOpenScene and ceOpenMap were two
// near-identical copies of this body, and with a tray button per surface a third and
// fourth copy were about to be written; they would not have stayed in sync (MAP-NAV-FIX is
// the record of what a second opener costs). Both survive below as one-line wrappers
// because they have named callers.
// EVERYTHING TRUE OF BOTH ORIGINALS IS TRUE HERE:
//   - ONE modal id. A second call while the shell is open only patches the store and lets
//     ceRoot re-render in place; opening another would stack two shells. ceOpenScene did
//     NOT have this guard and ceOpenMap did -- the guard is correct and is now universal.
//   - The full store-init list runs FIRST, even for a surface that keeps no state of its
//     own, because the kit's primitives have a hard dependency on ceUiStore
//     (STORE-BEFORE-HOOK, third variant: ceAction's first line is `if (!ceUiStore) return;`
//     and every ceBtn on the surface silently no-ops without it).
//   - Registered ONCE with a single jsx part. The tree repaints from its own store
//     subscriptions; nothing here ever calls handle.update().
async function ceOpenShell(surface: string, entityId?: string): Promise<void> {
    ceStoresInit();
    ceGenStoreInit();          // [v2.139.0 STYLE2 GEN-RAIL] the rail's own store (SS10.2)
    ceProfileStoreInit();
    ceJournalStoreInit();
    ceImgSlotStoreInit();
    ceMapStoreInit();
    ceChatStoreInit();
    ceSettingsStoreInit();
    ceImagesStoreInit();
    ceEntityStoreInit();
    ceWizStoreInit();
    if (!ceUiStore || !ceSceneStore) {
        try { api.v1.ui.toast('CE jsx UI failed to initialise.', { type: 'error' }); } catch (e) {}
        return;
    }
    ceNav(String(surface || 'scene'), entityId || '');
    if (_ceSceneHandle) return;
    try {
        // [v2.168.0 SHELL-WINDOW] ONE BRANCH, TWO CONTAINERS. The two APIs return the SAME
        // handle shape ({ update, close, isClosed, closed }), so everything downstream --
        // the _ceSceneHandle guard, the .closed reset, _ceWizChatCloseShell -- is untouched
        // and does not know or care which one it got. The jsx part is the same part; only
        // the floor differs (see ceJsxPart's minPx).
        if (CE_SHELL_WINDOW) {
            _ceSceneHandle = await api.v1.ui.window.open({
                id: 'ce-scene-surface',
                title: 'Character Engine',
                defaultWidth: '46%',
                defaultHeight: '82%',
                minWidth: 360,
                minHeight: CE_SHELL_WINDOW_MIN_PX,
                resizable: true,
                content: [ceJsxPart('ce-shell-jsx', ceRoot, CE_SHELL_WINDOW_MIN_PX)]
            });
        } else {
            _ceSceneHandle = await api.v1.ui.modal.open({
                id: 'ce-scene-surface',
                title: 'Character Engine',
                size: 'full',
                content: [ceJsxPart('ce-shell-jsx', ceRoot)]
            });
        }
        if (_ceSceneHandle && _ceSceneHandle.closed && typeof _ceSceneHandle.closed.then === 'function') {
            _ceSceneHandle.closed.then(function() { _ceSceneHandle = null; });
        }
    } catch (e) {
        _ceSceneHandle = null;
        api.v1.error('[AE:jsxshell] open failed:', e);
        try { api.v1.ui.toast('Could not open the engine UI. ' + String(e), { type: 'error' }); } catch (e2) {}
    }
}

// [v2.131.0 SHELL-TRAY] ceOpenScene is DELETED, not kept as a wrapper. Its only caller was
// the 'ce-tb-shell' toolbar button, which this patch replaced with the per-route loop; a
// zero-caller wrapper sitting beside ceOpenMap (which '/ce map' genuinely still calls)
// would read as a live entry point on the next audit. Verified zero callers in this file,
// zero references in the bridge, and not on the window.aeBridge console surface.
// Anything that wants it calls ceOpenShell('scene').


// ============================================================================
// SECTION 30 — PROFILE SURFACE (jsx)
// The character editor. Everything about one character is authored here.
//
// NO OVERLAY SHEETS. There is no color token in this environment to paint an
// opaque floating panel with: `background:'inherit'` resolves to nothing
// through an absolutely-positioned parent, and color-mix is translucent by
// construction. A "sheet" here is a FULL SURFACE SWAP driven by
// ceUiPatch({profileDrill}), a value on the store exactly like `surface` is.
// No z-index, no backdrop. This constraint is measured, not stylistic.
//
// SECTIONS EXPAND IN PLACE AND MORE THAN ONE CAN BE OPEN AT ONCE. Authoring one
// field while unable to see the field it must agree with is the failure any
// modal shape guarantees. That is the argument for the accordion.
//
// THE SIX GROUPS ARE NOT INVENTED HERE. They are CE_FIELD_GROUP_ORDER /
// CE_FIELD_GROUP_LABELS — Presence, Drive, Resistance, Conduct, Position,
// Background — which are the Studio's own six steps. ceOrderStaticFields
// already guarantees the slot card sorts before its facets inside a group, so
// this surface renders that order rather than re-deriving it.
//
// PATTERN IS A JUNCTION, NOT A GROUP. It sits between Drive and Resistance
// because that is where it does its work: CE_PATTERN_DEFS[id].resist and
// .conduct ARE the prompts for the two steps after it. Its hue is aura only —
// junction dot, and the rail of the two groups it gates. Never body text, same
// rule the bridge's STUDIO-2 set.
//
// TWO SHAPES, NEVER MIXED. `uiShape` selects between the classic character
// sheet (STATIC_FIELD_DEFS + coreValues) and the studio slot/facet model. They
// describe the same person by different means, so rendering both would hand
// the model two answers to every question. Resolution mirrors
// _ceResolveCharPattern: a stored value wins, otherwise the record is scanned.
//
// EDIT IS NOT A SEPARATE DENSITY. An expanded section is editable; touching a
// field commits on blur. The read/edit mode switch the draft implied never had
// a reason to exist.
//
// ceField CALLS useRef, so every dynamic list here goes through
// h(ceField, props) with a key — never a bare ceField(p) inside a loop. This
// is the conversion SECTION 28's own comment predicted would be forced by the
// first surface with a variable-length field list. It was.
// ============================================================================

var ceProfileStore: any = null;

function ceProfileStoreInit(): void {
    if (ceProfileStore) return;
    // [v2.150.0 PHASE-F] `equip` is the equipment projection:
    //   { entityId, bodyOk, carried[], candidates[] }
    // It is a PROJECTION for the same reason roster and vocabSpecies are, and for one
    // more that is specific to it: char.entityId is not on buildCharProfilePayload and
    // must not be added there, because that payload is the BRIDGE's too.
    // [v2.151.0 PHASE-COND] `conds` is the PER-CHARACTER half of the conditions system:
    //   { active: [{defId, stageIndex}], lines: [string], injects: bool }
    // The DEFINITIONS half already lives on cfg.conditions (Settings > World, built
    // v2.132.0) and is deliberately NOT copied here -- one list, one owner.
    try { ceProfileStore = createStore({ ready: false, charId: '', p: null, tiers: null, cfg: null,
                                         roster: [], vocabSpecies: [],
                                         equip: { entityId: '', bodyOk: false, carried: [], candidates: [] },
                                         conds: { active: [], lines: [], injects: true } }); }
    catch (e) { api.v1.error('[AE:jsxprofile] store init failed:', e); }
}

// Pressure tiers are read at publish time rather than exported from
// buildCharProfilePayload, deliberately. That payload also serves the bridge
// and the v2.92.0 note there is still correct: the tier is volatile evidence
// belonging to historyStorage, and baking it into a portable payload would
// carry a conclusion without the beats that earned it. Reading it into a UI
// projection is a different act from exporting it.
async function _ceReadProfileTiers(char: any): Promise<any> {
    var out: any = { hook: 0, pursuit: 0, position: 0, hasPosition: false, targetName: '',
                      hookNotes: [], pursuitHist: [], positionHist: [] };
    try {
        out.hook = await _ceReadPressure(char.id, 'hook');
        out.pursuit = await _ceReadPressure(char.id, 'pursuit');
        var pos: any = char.position || {};
        var tid = String(pos.targetId || '');
        if (tid) {
            out.hasPosition = true;
            out.targetName = String(pos.targetName || 'them');
            out.position = await _ceReadPressure(char.id, 'position_' + tid);
        }
        // [v2.157.0 PROFILE-THOUGHT-HIST, per user: "hooks, pursuit, position menu missing
        // thoughts history that showed blocking, etc for each"] Read projections only --
        // both sources already live on the loaded record, so this is zero new storage and
        // zero new bridge messages.
        //
        // Hook: generateHookUpdates' own evidence phrases (SECTION 12) -- the exact array
        // the retired native modal rendered (SECTION 20, hk.developmentNotes bullet list)
        // with no jsx counterpart until now.
        var topHook: any = (char.hooks && char.hooks.length) ? char.hooks[0] : null;
        out.hookNotes = (topHook && Array.isArray(topHook.developmentNotes))
            ? topHook.developmentNotes.filter(Boolean).slice(0, 3) : [];
        // Pursuit/Position: char.ephemeralHistory (EVIDENCE-STAMP, SECTION 12) carries a
        // classification per beat alongside the intent that earned it. An entry with no
        // stamp means no usable classification came back that beat -- filtered out rather
        // than shown as an 'untouched' guess, same honesty rule EVIDENCE-STAMP states.
        var eh: any[] = char.ephemeralHistory || [];
        var pu: any[] = []; var po: any[] = [];
        for (var ehI = 0; ehI < eh.length && (pu.length < 3 || po.length < 3); ehI++) {
            var snap: any = eh[ehI]; if (!snap) continue;
            var desire = String(snap.immediateDesire || '').trim();
            if (!desire) continue;
            if (pu.length < 3 && snap.pursuitState) { pu.push({ state: snap.pursuitState, note: desire }); }
            if (po.length < 3 && snap.positionState) { po.push({ state: snap.positionState, note: desire }); }
        }
        out.pursuitHist = pu;
        out.positionHist = po;
    } catch (e) { api.v1.error('[AE:jsxprofile] tier read failed:', e); }
    return out;
}

async function cePublishProfile(charId: string): Promise<void> {
    // buildCharProfilePayload takes a LOADED RECORD, not an id — v2.108.1
    // passed the bare charId and threw on char.customStaticFields. Every real
    // call site resolves first; so does this one.
    ceProfileStoreInit();
    if (!ceProfileStore || !charId) return;
    try {
        var char: any = await loadCharacter(charId);
        if (!char) { ceProfileStore.set({ ready: true, charId: charId, p: null, tiers: null }); return; }
        var cfg: any = await loadConfig();
        var payload: any = await buildCharProfilePayload(char, cfg);
        var tiers: any = await _ceReadProfileTiers(char);
        // [v2.111.0] cfg is carried so the classic sheet can resolve fieldInstructions /
        // fieldBudgets without a second loadConfig per render, and roster so Position can
        // offer a target. Roster is id+name ONLY -- the whole cast's records would make
        // this store repaint every profile on any character's edit, which is exactly the
        // change-frequency split JSXKIT-STORE-SPLIT exists to prevent.
        var roster: any[] = [];
        // [v2.145.0 PICKER] vocabSpecies is harvested from the WHOLE cast including this
        // character, unlike roster which excludes self -- the species picker's job is to
        // show the vocabulary in use, and a character's own current value is part of it.
        // Still id+name-scale data (a short string list), so JSXKIT-STORE-SPLIT's reason
        // for keeping whole records out of this store is untouched.
        var vocabSpecies: string[] = [];
        var seenSp: any = {};
        try {
            var all: any[] = await loadAllCharacters();
            for (var ri = 0; ri < (all || []).length; ri++) {
                if (!all[ri]) continue;
                var sp = String(all[ri].species || '').trim();
                if (sp && !seenSp[sp.toLowerCase()]) { seenSp[sp.toLowerCase()] = 1; vocabSpecies.push(sp); }
                if (all[ri].id === charId) continue;
                roster.push({ id: all[ri].id, name: all[ri].name || 'Unnamed' });
            }
        } catch (eR) { api.v1.error('[AE:jsxprofile] roster read failed:', eR); }
        vocabSpecies.sort();

        // [v2.150.0 PHASE-F] THE EQUIPMENT PROJECTION. One loadEntityIndex, one pass, both
        // lists -- what this character carries and what could be moved to them.
        //
        // AN ITEM IS "CARRIED" WHEN ITS parentId IS THE CHARACTER'S BODY ENTITY. That is the
        // world graph's own answer and it is the one buildEquipmentRows has always used;
        // char.equippedItemIds is a different question (WORN, not held) and is read only for
        // the per-row flag. Two questions, two reads, and conflating them is what
        // EQUIP-STATE-SYNC was the autopsy of.
        //
        // bodyOk IS NOT `!!entityId`, AND THE DIFFERENCE IS A REAL STATE, not defensiveness.
        // A character can hold an entityId whose entity no longer exists -- the native
        // diagnostics have a named blocker for exactly that ("body id set but entity
        // MISSING") -- and parenting an item to a dangling id would file it somewhere
        // nothing can ever list. The index is already loaded here, so the check is a lookup
        // rather than a second storage read.
        var equip: any = { entityId: String(char.entityId || ''), bodyOk: false, carried: [], candidates: [] };
        try {
            var eqIdx: any[] = await loadEntityIndex();
            var eqNames: any = {};
            var eqi = 0;
            for (eqi = 0; eqi < (eqIdx || []).length; eqi++) {
                if (!eqIdx[eqi]) continue;
                eqNames[String(eqIdx[eqi].id)] = String(eqIdx[eqi].name || 'Unnamed');
                if (equip.entityId && String(eqIdx[eqi].id) === equip.entityId) { equip.bodyOk = true; }
            }
            if (equip.bodyOk) {
                var eqWorn: any = {};
                var eqIds: any[] = char.equippedItemIds || [];
                for (eqi = 0; eqi < eqIds.length; eqi++) { eqWorn[String(eqIds[eqi])] = 1; }
                for (eqi = 0; eqi < (eqIdx || []).length; eqi++) {
                    var em: any = eqIdx[eqi];
                    if (!em || em.type !== 'item') continue;
                    if (String(em.parentId || '') === equip.entityId) {
                        equip.carried.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                                             icon: String(em.icon || ''),
                                             worn: !!eqWorn[String(em.id)] });
                    } else {
                        // `where` is not decoration. Adding an item MOVES it, so an author
                        // about to take the tavern's only lantern should be able to see that
                        // is what they are doing before they tap.
                        equip.candidates.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                                                icon: String(em.icon || ''),
                                                where: em.parentId ? (eqNames[String(em.parentId)] || '') : '' });
                    }
                }
            }
        } catch (eEq) { api.v1.error('[AE:jsxprofile] equipment read failed:', eEq); }

        // [v2.151.0 PHASE-COND] THE CONDITIONS PROJECTION. char.activeConditions is not on
        // buildCharProfilePayload and is not being added to it -- same rule as equip.entityId,
        // same reason: that payload is the bridge's too.
        //
        // `lines` IS COMPUTED HERE AND NOT IN THE RENDERER, and that is the load-bearing part.
        // buildConditionLine needs the CHARACTER RECORD (the |name| macro) and the CONFIG (the
        // template), and a render path has neither -- it has a payload. Computing it here also
        // means the preview is produced by the SAME function the lorebook builder calls, so it
        // cannot drift into being a pretty approximation of what actually gets injected.
        //
        // `injects` IS NOT COSMETIC. cfg.lorebookFields.conditions can switch the whole channel
        // off, and a preview shown without saying so is a lie about what the model will see.
        var conds: any = { active: [], lines: [], injects: true };
        try {
            var cDefs: any[] = (cfg && cfg.conditions) || [];
            var cAct: any[] = char.activeConditions || [];
            for (var cai = 0; cai < cAct.length; cai++) {
                if (!cAct[cai]) continue;
                var cDefId = String(cAct[cai].defId || '');
                var cStage = Number(cAct[cai].stageIndex) || 0;
                conds.active.push({ defId: cDefId, stageIndex: cStage });
                for (var cdj = 0; cdj < cDefs.length; cdj++) {
                    if (!cDefs[cdj] || cDefs[cdj].id !== cDefId) continue;
                    var cLine = buildConditionLine(char, cDefs[cdj], cStage, cfg);
                    if (cLine) conds.lines.push(cLine);
                    break;
                }
            }
            // `!== false` rather than a truthy test, matching the Settings toggle's own read:
            // an absent key on an older config means ON, not off.
            conds.injects = !!(cfg && cfg.lorebookFields && (cfg.lorebookFields as any).conditions !== false);
        } catch (eCn) { api.v1.error('[AE:jsxprofile] conditions read failed:', eCn); }

        ceProfileStore.set({ ready: true, charId: charId, p: payload || null, tiers: tiers,
                             cfg: cfg || null, roster: roster, vocabSpecies: vocabSpecies,
                             equip: equip, conds: conds });
    } catch (e) {
        // Previous value survives a failed publish — stale beats blank.
        api.v1.error('[AE:jsxprofile] publish failed:', e);
    }
}

// -- The character-storage chain  [v2.154.0 PROFILE-CHAIN-GAP] ---------------
// CharacterRecord storage had NO equivalent of ceEntityOp (SECTION 36): every writer
// on it was a bare load-modify-save, and two commits landing close together could
// silently discard one -- the identical failure ceEntityOp already prevents for
// entities. This is that same chain for character storage. ONE FIXED GLOBAL ORDER
// where a verb needs both: ceEntityOp OUTER, ceProfileOp INNER, never the reverse --
// see ceProfileEquipSet/EquipAdd/EnsureBody below, the only three that do.
//
// A GENERATION MUST NEVER RUN INSIDE THIS CHAIN. ceProfileScanHook holds a model call
// between its load and its save; only its tail (from the second load onward) is
// wrapped. ceProfileGenField needs no change at all -- it already delegates its write
// to ceProfileWrite, so it is chained for free.
var _ceProfChain: Promise<any> = Promise.resolve();
function ceProfileOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceProfChain.then(fn);
    _ceProfChain = run.catch(function() { return null; });
    return run;
}

// -- The single write path from this surface ---------------------------------
// Load, route through applyCharFieldValue, save, republish. One function so the
// lorebook sync and roster refresh saveCharacter performs cannot be forgotten
// by a second caller, which is the same reason AE_SAVE_CHAR_FIELD and
// AE_STUDIO_COMMIT both funnel through applyCharFieldValue rather than writing
// the record themselves.
// [v2.173.0 PROFILE-LORE] EVERY PROFILE COMMIT NOW RE-WRITES THE LOREBOOK ENTRY, which
// it did not before and which is the whole bug. saveCharacter writes the index, the story
// storage record and a bridge broadcast, AND NOTHING ELSE -- it has never touched the
// lorebook. syncLorebookEntry exists and is correct, but every one of its callers is a
// bridge message handler or the sync-all sweep; the jsx profile surface, which is now the
// only way anyone edits a character, was not among them. So edits landed on the record and
// the lorebook kept serving whatever it was built with, indefinitely.
//
// COMMIT-SCOPED, which is the granularity asked for: ceField commits on blur, so this
// fires when a field is left, not per keystroke. Both write paths go through here.
//
// SILENT AND NON-FATAL. `silent` is true because a toast per field would be unusable, and
// the catch is deliberate -- a lorebook that cannot be written must not lose the character
// edit that was already saved a line above. syncLorebookEntry no-ops on an unlinked
// character by itself (it returns early on a missing lorebookEntryId), so the guard here is
// belt-and-braces rather than the real check.
async function _ceSyncProfileLore(c: any): Promise<void> {
    try {
        if (c && c.id && c.lorebookEntryId) await syncLorebookEntry(c.id, true);
    } catch (eLore) { aeLog('[AE:jsxprofile] lorebook sync failed (non-fatal):', eLore); }
}

async function ceProfileWrite(charId: string, key: string, value: any): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            var ok = applyCharFieldValue(c, key, value);
            if (!ok) { api.v1.error('[AE:jsxprofile] unrouted field key: ' + key); return; }
            await saveCharacter(c);
            await _ceSyncProfileLore(c);
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] write failed:', e); }
    });
}

// [v2.145.0 PICKER] THE PAIRED WRITE. CE-STYLE SS13 requires a reference's id and its
// denormalized name to be written IN THE SAME COMMIT, and until now Position wrote them
// through two sequential ceProfileWrite calls -- two full load/apply/save/publish round
// trips, with a window between them where the record held an id and the previous name.
// This is that same act done once. It is NOT a general batch helper and should not grow
// into one: it exists because a reference is two fields of ONE fact.
async function ceProfileWritePair(charId: string, pairs: any[]): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            for (var i = 0; i < (pairs || []).length; i++) {
                var ok = applyCharFieldValue(c, pairs[i].k, pairs[i].v);
                if (!ok) { api.v1.error('[AE:jsxprofile] unrouted field key: ' + pairs[i].k); return; }
            }
            await saveCharacter(c);
            await _ceSyncProfileLore(c);
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] paired write failed:', e); }
    });
}

async function ceProfileSetTier(charId: string, axis: string, tier: number): Promise<void> {
    // Takes the BARE axis word. Position resolves to position_<targetId> here,
    // engine-side, exactly as the AE_SET_PRESSURE handler does — the UI never
    // sends a resolved key, because it has no business knowing the target id.
    // [v2.154.0] Chained for consistency with the rest of the surface even though this
    // one never calls saveCharacter -- the write lands in historyStorage, a separate
    // key/value tier, not the record. Cheap insurance, not a correctness fix here.
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            var ax = axis;
            if (axis === 'position') {
                var pos: any = c ? c.position : null;
                var tid = pos ? String(pos.targetId || '') : '';
                if (!tid) return;
                ax = 'position_' + tid;
            }
            var clamped = Math.max(_ceAxisFloor(ax), Math.min(4, Number(tier) || 0));
            await api.v1.historyStorage.set(_cePressureKey(charId, ax), clamped);
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] tier write failed:', e); }
    });
}

// -- Equipment verbs  [v2.150.0 PHASE-F] --------------------------------------
// ALL THREE RUN INSIDE ceEntityOp, WHICH LIVES IN SECTION 36 AND IS NOT A LAYERING
// MISTAKE. That chain serialises ENTITY STORAGE, not the Entity surface. Entity records
// are load-modify-save with no compare-and-swap, so a second, surface-local chain here
// would be two queues over one store -- which is not serialisation at all, it is two
// writers that happen to each be orderly. The Profile is simply the second surface that
// writes entities; it joins the existing queue rather than starting a rival one.
//
// aeSetEquip IS THE ONLY EQUIP VERB, here as everywhere. It moves BOTH halves of the fact
// (the item's isEquipped/equippedToCharId AND the character's equippedItemIds), and
// EQUIP-STATE-SYNC is the autopsy of what writing only one of them cost: equipping from
// the character sheet never reached the bridge's "append equipped items" prompt feature,
// silently, for several versions.
//
// [v2.154.0 PROFILE-CHAIN-GAP] ALSO ENTERS ceProfileOp NOW, NESTED INSIDE ceEntityOp --
// entity outer, profile inner, never the reverse. All three write a character record
// too (aeSetEquip saves the owner it is given; EnsureBody saves the character
// directly), so once ceProfileOp existed, leaving these three outside it would be a
// second writer bypassing the new chain -- exactly what having two chains was supposed
// to prevent. Fixed order everywhere is what makes this safe: nothing anywhere ever
// acquires profile-then-entity, so the two chains cannot deadlock against each other.
async function ceProfileEquipSet(charId: string, itemId: string, on: boolean): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                var it: any = await loadEntity(itemId);
                if (!c || !it) return;
                await aeSetEquip(it, c, !!on);
                try { await broadcastCharacterData(); } catch (eB) {}
                try { await broadcastSceneState(); } catch (eB2) {}
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] equip set failed:', e); }
        });
    });
}

// ADDING AN ITEM IS A MOVE, AND A MOVE CAN STEAL. surface_list line 20 asks for "ability
// to select items to add", and the item picked may currently be WORN BY SOMEONE ELSE.
// Reparenting it without taking it off them first leaves the previous owner's
// equippedItemIds still listing it and the item's own equippedToCharId still naming them
// -- the exact shape of EQUIP-STATE-SYNC, arrived at from the other direction. So the
// unequip runs FIRST, through aeSetEquip with the PREVIOUS owner passed, and the record is
// re-read afterwards because aeSetEquip loads and saves its own copy.
// IT LANDS CARRIED, NOT WORN. Moving a thing into someone's hands and putting it on them
// are two decisions, and the toggle is right there.
async function ceProfileEquipAdd(charId: string, itemId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                if (!c || !c.entityId) return;
                var it: any = await loadEntity(itemId);
                if (!it) return;
                var prevId = String(it.equippedToCharId || '');
                if (prevId && prevId !== charId) {
                    var prev: any = await loadCharacter(prevId);
                    if (prev) {
                        await aeSetEquip(it, prev, false);
                        it = await loadEntity(itemId);
                        if (!it) return;
                    }
                }
                it.parentId = String(c.entityId);
                await saveEntity(it);
                try { await broadcastCharacterData(); } catch (eB) {}
                try { queueSceneStateBroadcast(); } catch (eB2) {}
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] equip add failed:', e); }
        });
    });
}

// THE BODY REPAIR, PORTED. The native Settings tab has had this since v2.17.0 and the jsx
// Profile never got it, which was survivable only while the native modal was still
// reachable. It is not a nicety: without a body entity a character cannot hold anything at
// all, and the Equipment drill would otherwise be a dead end whose only exit is a surface
// this collapse is retiring. Same three writes the native button makes, in the same order.
async function ceProfileEnsureBody(charId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                if (!c) return;
                // A live body is left alone. This repairs BOTH "no id" and "id set, entity
                // gone" -- see bodyOk in cePublishProfile for why those are one state here.
                if (c.entityId) {
                    var existing: any = await loadEntity(String(c.entityId));
                    if (existing) return;
                }
                var body: any = makeDefaultEntity(c.name || 'Unnamed');
                body.type = 'character';
                body.parentId = null;
                await saveEntity(body);
                var fresh: any = await loadCharacter(charId);
                if (!fresh) return;
                fresh.entityId = body.id;
                await saveCharacter(fresh);
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] body repair failed:', e); }
        });
    });
}

// -- Condition verbs  [v2.151.0 PHASE-COND] -----------------------------------
// THESE WRITE THE CHARACTER RECORD, NOT AN ENTITY, so they are shaped like
// ceProfileHookOp (one load, one mutate, one save, one publish) and NOT like the
// equipment verbs -- ceEntityOp would be the wrong queue, not merely an unnecessary one.
// [v2.154.0 PROFILE-CHAIN-GAP] Now serialised through ceProfileOp, same as every other
// plain character write.
//
// UNCHECKING CLEARS THE ENTRY RATHER THAN RESETTING IT TO STAGE 0. That is the existing
// behaviour of BOTH prior implementations (buildConditionsRows and the bridge's
// AE_CHAR_CONDITION_ACTION 'toggle'), and a third surface quietly choosing to remember a
// severity across an off/on cycle would make the same tap mean two things depending on
// where it was made.
async function ceProfileCondSet(charId: string, defId: string, on: boolean): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            if (!c.activeConditions) c.activeConditions = [];
            var found = false;
            var i = 0;
            for (i = 0; i < c.activeConditions.length; i++) {
                if (c.activeConditions[i] && c.activeConditions[i].defId === defId) { found = true; break; }
            }
            if (on) {
                if (found) return;
                c.activeConditions.push({ defId: String(defId), stageIndex: 0 });
            } else {
                if (!found) return;
                var kept: any[] = [];
                for (i = 0; i < c.activeConditions.length; i++) {
                    if (c.activeConditions[i] && c.activeConditions[i].defId === defId) continue;
                    kept.push(c.activeConditions[i]);
                }
                c.activeConditions = kept;
            }
            await saveCharacter(c);
            try { await broadcastCharacterData(); } catch (eB) {}
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] condition set failed:', e); }
    });
}

// CLAMPED AGAINST THE DEF, NOT AGAINST THE VALUE PASSED IN. The stage list is editable in
// Settings, so a character can be sitting on stageIndex 2 of a def that was later cut back
// to two stages -- the bridge handler already clamps for exactly this reason and so does
// buildConditionLine's own read. Clamping at the write keeps the record from carrying an
// index nothing can resolve.
async function ceProfileCondStage(charId: string, defId: string, idx: number): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c || !c.activeConditions) return;
            var cfg: any = await loadConfig();
            var def: any = null;
            var defs: any[] = (cfg && cfg.conditions) || [];
            for (var j = 0; j < defs.length; j++) { if (defs[j] && defs[j].id === defId) { def = defs[j]; break; } }
            if (!def || !def.stages || !def.stages.length) return;
            var maxIdx = def.stages.length - 1;
            var next = Math.max(0, Math.min(maxIdx, Number(idx) || 0));
            var hit = false;
            for (var i = 0; i < c.activeConditions.length; i++) {
                if (!c.activeConditions[i] || c.activeConditions[i].defId !== defId) continue;
                if (c.activeConditions[i].stageIndex === next) return;
                c.activeConditions[i].stageIndex = next;
                hit = true;
                break;
            }
            if (!hit) return;
            await saveCharacter(c);
            try { await broadcastCharacterData(); } catch (eB) {}
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] condition stage failed:', e); }
    });
}

// -- Image slot actions -------------------------------------------------------
// [v2.121.0 IMG-ACTIONS] Four ops, TWO different transports, on purpose:
//   generate  rides the EXISTING EVT_GENERATE_IMAGE channel with kind:'charSlot' —
//             assembleSnapshotImage (a few hundred lines above) is the proven precedent
//             for "engine assembles a prompt from character fields, broadcasts, bridge
//             generates and saves." Reusing it is the handoff's own "match what the
//             bridge already ships rather than reinventing it" rule, applied to itself.
//   delete / download / edit  have no existing inbound-message equivalent (nothing before
//             this touched a SINGLE already-saved slot image from the engine side), so
//             they get one new small message: AE_CHAR_IMAGE_ACTION { charId, slot, op }.
// Bridge already has every implementation these four need — _generateAvatarImage's
// pipeline (via generateCommentImage, the same function 'snapshot' already calls),
// _deletePortrait, _downloadAsPng, openPromptEditor. This is wiring, not new capability.
async function ceImgSlotGenerate(charId: string, slot: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected \u2014 image generation requires bridge.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
        return;
    }
    try {
        var c: any = await loadCharacter(charId);
        if (!c) return;
        var slotState = await loadCharImgSlots(charId);
        var tag = charImgEffectiveTag(slotState, slot);
        // Same composition _generateAvatarImage already uses bridge-side: base visuals +
        // avatar-only visuals + this slot's tag, one string, one character entry. fp/fu
        // carry ONLY the global preset (compileActiveImageFields) -- character-specific
        // description belongs in the characters[] array, never folded into the base prompt,
        // same rule buildRequestBody's v4.5 per-character captions already depend on.
        var charVisuals = [c.visuals || '', c.avatarVisuals || '', tag || ''].filter(Boolean).join(', ');
        var chars = charVisuals ? [{ name: c.name, visuals: charVisuals, uc: c.uc || '' }] : [];
        var seed = (c.avatarSeed && c.avatarSeed !== 0) ? c.avatarSeed : Math.floor(Math.random() * 4294967295);
        var compiled = compileActiveImageFields();
        await broadcastToTM(EVT_GENERATE_IMAGE, {
            uuid: api.v1.uuid(),
            prompt: '',
            characters: chars,
            extraBaseVisuals: '',
            extraBaseUC: '',
            charId: c.id,
            entityId: null,
            kind: 'charSlot',
            slot: slot,
            settings: {
                width: c.avatarWidth || 1024,
                height: c.avatarHeight || 1024,
                steps: Math.min(globalSettings.defaultSteps || 28, 28),
                scale: globalSettings.defaultScale || 5.0,
                seed: seed,
                quality: compiled.quality,
                negative: compiled.negative
            },
            autoDownload: false
        });
        try { api.v1.ui.toast('Generating ' + slot + '\u2026', { type: 'info', autoClose: 2000 }); } catch (e1) {}
    } catch (e) { api.v1.error('[AE:imgslots] generate failed:', e); }
}

async function ceImgSlotAction(charId: string, slot: string, op: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
        return;
    }
    try { await broadcastToTM('AE_CHAR_IMAGE_ACTION', { charId: charId, slot: slot, op: op }); }
    catch (e) { api.v1.error('[AE:imgslots] action ' + op + ' failed:', e); }
}

// -- Field-catalog projection ------------------------------------------------
// p.customFields already arrives ordered by group with slot-before-facet inside
// each group (ceOrderStaticFields) and now carries `kind`. This only buckets;
// it does not re-sort, so the two surfaces cannot disagree about order.
function _ceGroupFields(p: any, group: string): any[] {
    var out: any[] = [];
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && list[i].group === group) out.push(list[i]);
    }
    return out;
}
function _ceHasValue(f: any): boolean {
    return String((f && f.value) || '').trim() !== '';
}
function _ceCountWritten(list: any[]): number {
    var n = 0;
    for (var i = 0; i < list.length; i++) { if (_ceHasValue(list[i])) n = n + 1; }
    return n;
}
function _ceTrim(text: string, max: number): string {
    var t = String(text || '').replace(new RegExp('\\s+', 'g'), ' ').trim();
    if (!t) return '';
    if (t.length <= max) return t;
    return t.slice(0, max - 1) + '\u2026';
}

// -- Local UI state ----------------------------------------------------------
// Which accordion rows are open, and which drill is showing. Both are pure
// session UI, so they live on ceUiStore rather than anywhere persistent — the
// same call tempStorage-vs-storyStorage already makes for the field reveal
// list. `open` is a plain map so a future key cannot be dropped, for the
// same reason ceUiPatch shallow-merges.
// [v2.132.0 OPEN-MAP-RENAME, per user] RENAMED. The kit's own [OPEN v2.114.0] item said
// this was the shell's generic open-map wearing the name of the only surface that had one
// when it was written, and named the trigger: rename when a THIRD surface uses it.
// Settings is that third surface (Profile, Journal, now Settings), so the rename lands
// here rather than adding a fourth caller to the old name. Mechanical: two symbols, every
// call site updated in the same patch, no behaviour change.
function ceToggleOpen(id: string): void {
    ceUiPatch(function(u: any) {
        var open: any = {}; var k: string;
        for (k in (u.open || {})) { open[k] = u.open[k]; }
        if (open[id]) { delete open[id]; } else { open[id] = true; }
        return { open: open };
    });
}
// [v2.164.0 OPEN-SET] ceToggleOpen flips; these two SET and READ. A picker that must
// close on choice cannot use a toggle, because a toggle re-opens it when the tapped value
// was already the current one. Direct store read for the same reason _ceGuideOpen does it:
// no hook, so it stays legal inside the loops the profile column runs in.
function _ceSetOpen(id: string, on: boolean): void {
    ceUiPatch(function(u: any) {
        var open: any = {}; var k: string;
        for (k in (u.open || {})) { open[k] = u.open[k]; }
        if (on) { open[id] = true; } else { delete open[id]; }
        return { open: open };
    });
}
function _ceOpenIs(id: string): boolean {
    var o: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; o = (u && u.open) || null; }
    catch (e) { o = null; }
    return !!(o && o[id]);
}
var CE_PAT_OPEN: string = 'pat:pick';

function _ceProfileDrill(kind: string, step: number): void {
    ceUiPatch(function() { return { profileDrill: kind, profileStep: step || 0 }; });
}

// -- Pattern gating ----------------------------------------------------------
// [v2.111.0 SLOT-GATE] Resistance and Conduct exist ONCE PER PATTERN in
// BUILTIN_FACETS (ce_slot_resist_<pattern> / ce_slot_conduct_<pattern>), and the
// library's own header says so: "the bridge resolves ce_slot_resist_<pattern> /
// ce_slot_conduct_<pattern> from the character's chosen pattern." v2.109.0's
// profile never did that resolution — it rendered every slot in the group, so a
// character showed six Resistance cards and six Conduct cards and was invited to
// answer all twelve. That is not a display bug alone: filling more than one
// hands the model competing answers to the same question, which is the exact
// failure `uiShape` exists to prevent between the two shapes.
//
// The gate is a SUFFIX MATCH on the slot id, not a new field, because the
// library already encodes the pattern in the id and adding a `pattern:` key
// would be a second source of truth for the same fact.
function _ceGatedGroup(groupId: string): boolean {
    return groupId === 'resistance' || groupId === 'conduct';
}
function _ceSlotsFor(rows: any[], groupId: string, patternId: string): any[] {
    var out: any[] = [];
    var gated = _ceGatedGroup(groupId);
    var suffix = '_' + String(patternId || '');
    for (var i = 0; i < rows.length; i++) {
        if (String(rows[i].kind || '') !== 'slot') continue;
        if (gated) {
            if (!patternId) continue;
            var id = String(rows[i].id || '');
            if (id.length <= suffix.length) continue;
            if (id.slice(id.length - suffix.length) !== suffix) continue;
        }
        out.push(rows[i]);
    }
    return out;
}
function _ceFacetsFor(rows: any[]): any[] {
    var out: any[] = [];
    for (var i = 0; i < rows.length; i++) {
        if (String(rows[i].kind || '') === 'slot') continue;
        out.push(rows[i]);
    }
    return out;
}
// [v2.111.0 SLOT-GATE] Takes the pattern now. Without it a studio character read
// as permanently unfinished: the five UNUSED pattern variants in each gated group
// are empty by design and can never be filled, so the old "every slot has a value"
// test could not return true for Resistance or Conduct on any character at all.
// [v2.163.0] DEAD -- its only caller was _ceProfileGroup's accordion summary, which the
// condensed rewrite removed. Retained un-deleted this pass rather than removed blind.
function _ceSlotDoneDEAD(p: any, group: string, patternId: string): boolean {
    var rows = _ceGroupFields(p, group);
    var slots = _ceSlotsFor(rows, group, patternId);
    if (!slots.length) {
        if (_ceGatedGroup(group)) return false;   // no pattern chosen yet = not done
        return _ceCountWritten(rows) > 0;
    }
    for (var j = 0; j < slots.length; j++) { if (!_ceHasValue(slots[j])) return false; }
    return true;
}

// -- Accordion ---------------------------------------------------------------
// Collapsed, this row carries exactly what the v2.108.1 spine row carried:
// label, one-line summary, filled indicator. Nothing was lost by making it open
// in place rather than open a sheet.
function ceAccordion(opts: any): any {
    var open = !!opts.open;
    var head = h('div', {
        onClick: function() { ceTap('acc:' + opts.id, function() { ceToggleOpen(opts.id); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s3,
            minHeight: CE_T.tap, padding: CE_T.s2 + ' 0', cursor: 'pointer',
            borderBottom: open ? 'none' : '1px solid ' + CE_LINE
        }
    },
        // [v2.121.0] Optional leading visual, additive -- no existing call site sets it,
        // so every prior ceAccordion call renders exactly as before. Added for the Images
        // drill's per-slot rows, where the row's own thumbnail belongs in the header, not
        // buried inside the expanded content where a collapsed row could never show it.
        opts.lead || null,
        // [v2.115.0 CARET-HUE, per user] The caret carries the character's pattern hue when
        // the group HAS one -- CE-STYLE section 2.3's own proposal, which said the hue is
        // available for more than an 8px dot and named the accordion rail as a place to
        // spend it. The rail only exists while OPEN; the caret is visible in both states,
        // so this is where the colour actually earns something. Semantic colour takes no
        // opacity (section 2.2), so a tinted caret drops to t3 (0.58) rather than dimming a
        // hue. [v2.139.0 STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): the
        // 8px caret triangle is a control glyph, not a text heading.
        h('div', { style: { flex: '0 0 auto', width: '10px', fontSize: '8px',
            color: opts.rail ? opts.rail : 'inherit',
            opacity: opts.rail ? '1' : '0.58',
            transform: open ? 'rotate(90deg)' : 'none' } }, '\u25B6'),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '2px' } },
            h('div', { style: { fontSize: CE_T.fsSm, fontWeight: '500', letterSpacing: '0.09em',
                textTransform: 'uppercase', opacity: open ? '1' : '0.58' } }, opts.label),
            (!open && opts.summary)
                ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', overflow: 'hidden',
                    textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, opts.summary)
                : null
        ),
        opts.meta ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: '0.58' } }, opts.meta) : null
    );
    if (!open) return h('div', null, head);
    return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } },
        head,
        h('div', { style: {
            borderLeft: '2px solid ' + (opts.rail || CE_LINE2),
            paddingLeft: CE_T.s4, margin: '0 0 ' + CE_T.s4 + ' 4px',
            display: 'flex', flexDirection: 'column', gap: CE_T.s4
        } }, opts.children)
    );
}

// -- Expand row  [v2.153.0 PHASE-D-PRIME] -------------------------------------
// CE-ROADMAP Phase D'. ceAccordion is Field-density (SS7.2/7.3: one record's own
// fields disclosing under an eyebrow label) and every Settings list -- Species,
// Archetypes, Conditions, Factions, static-field instructions -- was reusing it for
// SS7.3's OTHER case instead: "many distinct records", which the Chat surface's own
// STYLE2-LIST-SPLIT note already named as the misuse ceAccordion should not be doing.
// This is the object-density counterpart: ceCard's box/hue treatment (SS7.3's own
// prescription -- ceH for the record's name, not an uppercase eyebrow) with
// ceAccordion's open/toggle mechanics underneath, so every list row still expands in
// place exactly as it does today.
//
// SAME CONTRACT AS ceAccordion ON PURPOSE: id/label/open/summary/children mean what
// they already mean, so every call site becomes a rename, not a rewrite. `hue`
// replaces `rail` (ceCard's own name for the same idea) since nothing here has
// ceAccordion's other two fields (`lead`, `meta`) to carry forward -- none of the six
// call sites this lands on used them.
//
// A REAL COMPONENT, same shape as _ceCardC/_ceBtnC (SS9: press state lives in the
// primitive), because every call site is inside a list loop and needs its own hook
// scope there for the same reason ceCard's already does.
function _ceExpandRowC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var open = !!p.open;
    var head = h('div', {
        onClick: function() { ceTap('exp:' + p.id, function() { ceToggleOpen(p.id); }); },
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap,
                 cursor: 'pointer' }
    },
        p.lead || null,
        h('div', { style: { flex: '0 0 auto', width: '10px', fontSize: '8px',
            color: p.hue ? p.hue : 'inherit', opacity: p.hue ? '1' : CE_OP.t3,
            transform: open ? 'rotate(90deg)' : 'none' } }, '\u25B6'),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                            flexDirection: 'column', gap: '2px' } },
            ceH(p.label || 'Unnamed'),
            (!open && p.summary)
                ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, overflow: 'hidden',
                    textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, p.summary)
                : null
        ),
        p.meta ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, p.meta) : null
    );
    return h('div', {
        style: {
            display: 'flex', flexDirection: 'column', gap: open ? CE_T.s3 : '0',
            padding: CE_T.s2 + ' ' + CE_T.s3, borderRadius: CE_T.rCard,
            background: pressed ? CE_FILL2 : CE_WELL,
            border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + (p.hue || CE_LINE),
            marginBottom: CE_T.s2,
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, head, open ? p.children : null);
}
function ceExpandRow(opts: any): any {
    return h(_ceExpandRowC, { key: opts.key || opts.id, id: opts.id, label: opts.label,
        summary: opts.summary, open: opts.open, hue: opts.hue, lead: opts.lead,
        meta: opts.meta, children: opts.children });
}

// -- Guidance ----------------------------------------------------------------
// [v2.111.0 GUIDE-FROM-INSTRUCTIONS, per user] The v2.109.0 build drill carried a
// hand-written `why` line per step. Those were invented for the mockup and read as
// filler. BUILTIN_FACETS already carries a real, argued instruction string for every
// slot and facet — task, length, and the specific cliche that slot attracts — and
// buildCharProfilePayload already exports it as `instructions`. That IS the guide;
// writing a second one alongside it means two descriptions of one field that can
// drift. This renders the real one.
// [v2.141.0 STYLE2-E GUIDE-COLLAPSE, per user] COLLAPSED BY DEFAULT. Every one of these
// strings is a real, argued instruction (60-70 words for Presence), and rendering six of
// them permanently open on a phone buried the six fields they describe. The text is still
// worth having -- it is the only place the task, the length, and the specific cliche to
// avoid are written down -- so this hides it behind an affordance rather than truncating
// it, which would put a second, shorter description of one field into the world and let
// the two drift. That was the exact failure GUIDE-FROM-INSTRUCTIONS (v2.111.0) was created
// to end, and it is not being reintroduced as an ellipsis.
//
// THE OPEN STATE IS ceUiStore.open, the same map every accordion already uses. No new
// storage key, no new store, and the guide's open/closed state is session-scoped for the
// same reason accordion state is -- it is UI, not record.
//
// THE KEY IS DERIVED FROM THE TEXT, which is why no call site had to change its signature.
// A guide is identified by its own content; two fields sharing an instruction string share
// an open state, which is correct rather than a collision. djb2 over the string, base36 --
// this is a UI key, not a checksum, and it never leaves the session.
function _ceGuideKey(text: string): string {
    var s = String(text || ''); var hh = 5381; var i = 0;
    for (i = 0; i < s.length; i++) { hh = (((hh << 5) + hh) + s.charCodeAt(i)) | 0; }
    return 'gd:' + (hh >>> 0).toString(36);
}
// Reads the store DIRECTLY rather than taking an openMap parameter. That is the same shape
// _ceBtnC/_ceIconBtnC already use for their busy state (ceUiStore.get() inside render), and
// it is safe for the same reason: the Root that renders this subscribes via useStoreValue,
// so a toggle repaints the tree and this function is re-invoked with the new value. It
// calls NO hook, so it stays legal inside the loops _ceSlotCard/_ceFacetField run in.
function _ceGuideOpen(text: string): boolean {
    var o: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; o = (u && u.open) || null; }
    catch (e) { o = null; }
    return !!(o && o[_ceGuideKey(text)]);
}
// The bar: an optional Field-density key, and the '?' affordance on the right.
// THE WHOLE ROW IS THE HIT TARGET, not the 18px glyph. A 44px-square icon button would
// out-weigh the field it labels at this density, and a glyph-sized one would fail SS11's
// hit-area floor; a full-width row at CE_T.ctl height satisfies both and is the more
// discoverable affordance on a phone besides.
// `label` MAY BE EMPTY -- that is the duplicate-heading case (see _ceSlotCard), and the
// bar then renders as the affordance alone rather than reserving a blank heading row.
// [v2.166.0 GUIDE-NO-ORPHAN, per user "the ? button that shows instructions shouldn't have
// its own line -- it should either be inline with header or generate button"] THE GLYPH IS
// EXTRACTED so it has two homes instead of one.
//
// THE ORPHAN CASE IS EXACTLY ONE CALLER, and it was already documented as a special case
// elsewhere: _ceSlotCard suppresses its heading when the slot's label duplicates the group's
// (v2.141.0 STYLE2-E correction 1). _ceGuideBar's own note says "label MAY BE EMPTY -- the
// bar then renders as the affordance alone" -- and that is the line the user is looking at:
// a full-width row containing nothing but an 18px '?' floated right, above a textarea.
//
// `standalone` DECIDES WHO OWNS THE TAP, and it is not decoration. Inside the bar, the ROW
// is the hit target (see the note below on why), so the glyph must be inert -- a second
// onClick there bubbles into the row's and fires the toggle twice, surviving only on
// ceTap's inferred CE_TAP_MS window. Outside the bar there is no row, so the glyph carries
// its own handler and its own 44px vertical hit area via _ceHit, the same wrapper every
// ceBtn/ceIconBtn already gets.
function _ceGuideChip(text: string, standalone: boolean): any {
    var t = String(text || '').trim();
    if (!t) return null;
    var open = _ceGuideOpen(t);
    var id = _ceGuideKey(t);
    var glyph = h('div', {
        role: standalone ? 'button' : undefined,
        tabIndex: standalone ? 0 : undefined,
        'aria-label': standalone ? (open ? 'Hide guidance' : 'Show guidance') : undefined,
        'aria-expanded': standalone ? (open ? 'true' : 'false') : undefined,
        'aria-hidden': standalone ? undefined : 'true',
        onClick: standalone
            ? function() { ceTap(id, function() { ceToggleOpen(id); }); }
            : undefined,
        style: {
            flex: '0 0 auto', width: '18px', height: '18px',
            display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            fontSize: CE_T.fsKey, fontWeight: '600', lineHeight: '1',
            cursor: standalone ? 'pointer' : 'inherit',
            borderRadius: CE_T.rPill,
            border: '1px solid ' + (open ? CE_LINE2 : CE_LINE),
            background: open ? CE_FILL : 'transparent',
            opacity: open ? CE_OP.t1 : CE_OP.t3,
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, '?');
    return standalone ? _ceHit(glyph) : glyph;
}
function _ceGuideBar(label: string, text: string): any {
    var lab = String(label || '').trim();
    var t = String(text || '').trim();
    if (!lab && !t) { return null; }
    if (!t) { return ceKey(lab); }
    var open = _ceGuideOpen(t);
    var id = _ceGuideKey(t);
    return h('div', {
        role: 'button', tabIndex: 0,
        'aria-label': (open ? 'Hide guidance' : 'Show guidance') + (lab ? (' for ' + lab) : ''),
        'aria-expanded': open ? 'true' : 'false',
        onClick: function() { ceTap(id, function() { ceToggleOpen(id); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: CE_T.ctl, cursor: 'pointer'
        }
    },
        lab ? ceKey(lab) : null,
        h('div', { style: { flex: '1 1 auto', minWidth: '0' } }),
        _ceGuideChip(t, false)
    );
}
// The body. `inline` = the caller already rendered a bar (via _ceGuideBar) and wants only
// the text; the default is self-contained and supplies its own bar, which is what keeps the
// three Position call sites working verbatim -- they gain the collapse for free.
function _ceGuide(text: string, inline?: boolean): any {
    var t = String(text || '').trim();
    if (!t) return null;
    var open = _ceGuideOpen(t);
    var body = open ? h('div', { style: {
        fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse,
        borderLeft: '1px solid ' + CE_LINE, paddingLeft: CE_T.s3
    } }, t) : null;
    if (inline) { return body; }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        _ceGuideBar('', t), body);
}


// [v2.112.0 GEN-BUDGET, per user] Budgets are NOT invented here. v2.111.0 guessed 120
// for facets and 150 for slots; the AE_GENERATE_SLOT handler already resolves both, and
// this now matches it literally: a custom field (slot OR facet -- they are the same
// record shape) takes cfg.fieldBudgets[<def id>] with a 150 floor, and a static sheet
// field takes cfg.fieldBudgets[<key>] else that def's own defaultBudget. Instructions
// resolve the same way. One resolution, two call sites.
function _ceGenSpec(cfg: any, f: any): any {
    var id = String(f.id || '');
    return {
        instructions: String(f.instructions || ''),
        budget: (cfg && cfg.fieldBudgets && cfg.fieldBudgets[id]) || 150
    };
}

// [v2.157.0 GEN-ALWAYS, per user: "the character profile generators should always be
// available, they are supposed to use the fields as guidance for generation so removing if
// filled makes no sense"] THE hasSeed GATE IS GONE, and it was backwards.
//
// It required conceptDump or briefDescription to be non-empty before offering ANY field
// generator, on the reasoning that "without a concept dump or existing prose the model has
// nothing but the name". That reasoning ignored what generateFieldContent actually sends:
// buildCharacterStateContext hands it the character's OWN written fields -- Core, Pursuit,
// Resistance, Conduct, pattern, identity, the lot. Those ARE the guidance. So the gate
// punished exactly the wrong character: someone six steps into the walkthrough with five
// slots written and no concept dump got no generator at all, while the model had more to
// work from than at any earlier point.
//
// `instructions` remains the only condition, and it is a real one: with no instructions
// there is genuinely no field scope to generate against, which is what the
// AE_GENERATE_SLOT handler's own 'noinstructions' branch says too.
//
// `p` is retained in the signature -- it is still read by the Options flow below and every
// call site already passes it.
// [v2.161.0 GEN-INLINE, per user: "the generators are an additional popup, the option to
// generate 3 options still only generates one, it doesn't have the token budget or the
// direct/yoink options"] ONE VERB, EXPANDING IN PLACE. All three complaints have the same
// root: the candidate flow was a NINTH SURFACE (ceRoot intercepted `slotOpts` above the
// router), so pressing it left the character entirely, and the two knobs that decide what
// comes back -- the token budget and direct-vs-yoink -- were resolved silently behind it.
//
// WHAT CHANGED:
//   - "Generate" and "Options..." collapse into ONE "Generate" that opens a strip UNDER
//     the field. The field stays on screen while its own replacement is being written,
//     which is the whole point: a candidate is judged against the fields it has to agree
//     with, and those were off-screen.
//   - The strip carries the budget and the method as real controls. Budget was
//     cfg.fieldBudgets[<id>] with a silent 150 floor; method was hardcoded 'auto', which
//     resolved to a one-candidate yoink draw while free runs remained and made the count
//     select a lie. See ceSlotOptsRun.
//   - Candidates render as tappable cards in the same strip. Nothing is written until one
//     is tapped, so Cancel is genuinely free.
//
// HOOK-FREE BY CONTRACT, like everything else rendered from inside _ceSlotCard's and
// _ceFacetField's loops. State is on ceUiStore.slotOpts, the steer draft is a module var
// (CLICK-BEFORE-BLUR: Generate is a click and would otherwise read the PREVIOUS value on
// first press), and ceField/ceSelect/ceNumField/ceBtn are each mounted through h() so
// their own hooks stay in their own scope.
//
// ONE STRIP AT A TIME, keyed by (charId, fieldKey). That is not a limitation to work
// around: generation is serialised engine-side anyway, and two open strips would offer a
// second Generate that can only refuse.
// [v2.166.0 GUIDE-NO-ORPHAN] `guide` is the SECOND HOME for the '?' glyph and is empty at
// every call site that already rendered a guide bar of its own. It is the generate row
// rather than the field label because the field label is the thing that was missing in the
// first place -- see _ceSlotCard. This row always exists when there is a guide to show:
// both are gated on the SAME `instructions` string, so the glyph can never be handed to a
// row that returned null above it.
function _ceGenBtn(p: any, charId: string, writeKey: string, label: string,
                   instructions: string, budget: number, guide?: string): any {
    if (!instructions) return null;
    var st: any = _ceSlotOptsFor(charId, writeKey);
    var chip: any = _ceGuideChip(String(guide || ''), true);
    if (!st) {
        return h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap',
            alignItems: 'center' } },
            ceBtn('Generate', 'genopt:' + charId + ':' + writeKey, function() {
                ceSlotOptsOpen(charId, writeKey, label, instructions, budget);
                return Promise.resolve();
            }),
            chip
        );
    }

    var running = (st.status === 'running');
    var opts: any[] = st.options || [];
    var yoink = (String(st.method || 'direct') === 'yoink');
    var kids: any[] = [];

    // The steer. onType writes the module var on every keystroke with NO render -- the
    // same contract the Images Studio prompt drafts run on.
    kids.push(h('div', { key: 'g_hint' }, h(ceField, {
        key: 'g_hint_f', k: 'slotopt:hint:' + writeKey, label: 'Steer (optional)', value: '',
        seed: String(writeKey), multiline: true, rows: 2, well: true,
        placeholder: 'Push it in a direction \u2014 e.g. \u201cmake it about the debt, not the brother\u201d',
        onType: function(v: string) { _ceSlotOptsHint = String(v || ''); },
        // NOT optional decoration: ceField's commit() calls p.onCommit unguarded on blur,
        // so a field without one throws the moment focus leaves it.
        onCommit: function(v: string) { _ceSlotOptsHint = String(v || ''); return Promise.resolve(); }
    })));

    var controls: any[] = [];
    controls.push(h('div', { key: 'g_m', style: { flex: '1 1 140px', minWidth: '0' } }, ceSelect({
        k: 'slotopt:method:' + writeKey,
        label: 'Draw',
        value: yoink ? 'yoink' : 'direct',
        options: [{ id: 'direct', label: 'Metered' }, { id: 'yoink', label: 'Free' }],
        onCommit: function(v: string) { ceSlotOptsPatch({ method: String(v || 'direct') }); return Promise.resolve(); }
    })));
    // The count control is HIDDEN, not disabled, on a free draw. A disabled control that
    // still shows "3" is the same lie the old hint was written to apologise for.
    if (!yoink) {
        controls.push(h('div', { key: 'g_c', style: { flex: '0 1 100px', minWidth: '0' } }, ceSelect({
            k: 'slotopt:count:' + writeKey,
            label: 'How many',
            value: String(Number(st.count) || 3),
            options: [{ id: '1', label: '1' }, { id: '2', label: '2' }, { id: '3', label: '3' },
                      { id: '4', label: '4' }, { id: '5', label: '5' }],
            onCommit: function(v: string) { ceSlotOptsPatch({ count: Number(v) || 3 }); return Promise.resolve(); }
        })));
    }
    controls.push(h('div', { key: 'g_b', style: { flex: '0 1 120px', minWidth: '0' } }, ceNumField({
        k: 'slotopt:budget:' + writeKey,
        label: 'Tokens',
        value: Number(st.budget) || 150,
        min: 40, max: 600,
        onCommit: function(n: number) { ceSlotOptsPatch({ budget: Number(n) || 150 }); return Promise.resolve(); }
    })));
    kids.push(h('div', { key: 'g_ctl', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap',
        alignItems: 'flex-end' } }, controls));

    kids.push(h('div', { key: 'g_note0', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
        lineHeight: CE_T.lhProse } },
        yoink
            ? 'A free draw costs no allowance and always returns ONE candidate. Press again for another.'
            : 'A metered call spends allowance and returns the number you asked for, written to differ from each other.'));

    // The chip rides the run row too, not just the collapsed one: expanding the generator
    // is when the field's own instructions are MOST worth re-reading, and losing the only
    // affordance on expand would be the same orphan bug in reverse.
    kids.push(h('div', { key: 'g_run', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap',
        alignItems: 'center' } },
        ceBtn(running ? 'Generating\u2026' : (opts.length ? 'Again' : 'Generate'),
              'slotopt:run:' + writeKey, function() { return ceSlotOptsRun(); }, 'primary'),
        ceBtn('Cancel', 'slotopt:close:' + writeKey, function() { ceSlotOptsClose(); return Promise.resolve(); }),
        chip
    ));

    if (st.note) {
        kids.push(h('div', { key: 'g_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2,
            lineHeight: CE_T.lhProse, color: CE_SEM.ask } }, String(st.note)));
    }

    if (opts.length) {
        var cards: any[] = [];
        for (var i = 0; i < opts.length; i++) {
            cards.push((function(text: string, idx: number) {
                return h('div', {
                    key: 'g_opt_' + idx,
                    role: 'button', tabIndex: 0,
                    'aria-label': 'Use candidate ' + (idx + 1),
                    onClick: function() {
                        ceTap('slotopt:pick:' + writeKey + ':' + idx, function() {
                            ceAction('slotopt:commit:' + writeKey + ':' + idx, function() { return ceSlotOptsCommit(text); });
                        });
                    },
                    style: {
                        cursor: 'pointer', border: '1px solid ' + CE_LINE, borderRadius: CE_T.rCard,
                        padding: CE_T.s3, background: CE_FILL, fontSize: CE_T.fs,
                        lineHeight: CE_T.lhProse, whiteSpace: 'pre-wrap'
                    }
                }, text);
            })(String(opts[i] || ''), i));
        }
        kids.push(h('div', { key: 'g_opts' }, ceSection('Tap one to use it \u00b7 ' + opts.length,
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, cards))));
    }

    return h('div', {
        style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s3,
            padding: CE_T.s3, borderRadius: CE_T.rCard,
            background: CE_WELL, border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + CE_LINE2
        }
    }, kids);
}

// -- Slot card ---------------------------------------------------------------
// [v2.111.0 SLOT-HEADING, per user] The slot's name is now a real subheading, not a
// 9px uppercase eyebrow indistinguishable from every other label on the surface.
// A slot is the load-bearing line of its group and has to read as one. The library
// label for a gated slot is "Resistance \u00b7 Contradiction"; the group heading above it
// already says Resistance, so only the tail after the middle dot is shown here.
// [v2.141.0 STYLE2-E, per user] TWO CORRECTIONS, both reported from the live surface.
//
// (1) THE HEADING WAS PRINTED TWICE. A non-gated group renders exactly one slot whose
// label IS the group's label, so the accordion said "Presence" and the card under it said
// "Presence" again, with a paragraph wedged between them. `groupLabel` is now passed in and
// a heading identical to it is SUPPRESSED. A gated slot is unaffected and keeps its head:
// its short label is the pattern ("Contradiction") and the group's is "Resistance", so the
// two carry different information and both are worth the row. The test is equality, not a
// hard-coded list of which groups have one slot -- if a label is ever renamed, the
// suppression follows it instead of going stale.
//
// (2) THE BOX IS GONE. This is Field density (SS7.2: "many fields of one record"), and
// SS7.3 is explicit that the box belongs to Object density alone -- "a box that contains a
// section of one thing is chrome". It was also a box-in-box: _ceProfileGroup's accordion
// already draws a rail down the expanded content, and this drew a SECOND rail plus a
// CE_FILL ground inside it. The rail is retained here only for the caller that has no
// accordion around it (the build drill), and _ceProfileGroup now passes '' -- see there.
function _ceSlotCard(charId: string, p: any, cfg: any, f: any, rail: string, groupLabel?: string): any {
    var label = String(f.label || '');
    var dot = label.indexOf(' \u00b7 ');
    var shortLabel = dot > 0 ? label.slice(dot + 3) : label;
    var gl = String(groupLabel || '').trim();
    var head = (gl && shortLabel.toLowerCase() === gl.toLowerCase()) ? '' : shortLabel;
    // [v2.166.0 GUIDE-NO-ORPHAN, per user] THE HEADING SUPPRESSION ABOVE IS WHAT CREATED THE
    // ORPHAN ROW. With no head there is no label for the guide bar to sit beside, so the bar
    // rendered as a lone right-floated '?' occupying a full row of its own above the
    // textarea. When that happens the bar is skipped entirely and the glyph is handed to the
    // generate row instead (_ceGenBtn's `guide` argument).
    // THE GUIDANCE TEXT FOLLOWS ITS OWN TOGGLE, never the other one. A '?' at the bottom of
    // the card that opened a paragraph at the TOP of it would be worse than the orphan row.
    // Hence the two mirrored ternaries rather than one _ceGuide call in a fixed position.
    var spec = _ceGenSpec(cfg, f);
    var bar = head ? _ceGuideBar(head, f.instructions) : null;
    return h('div', { style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s1,
        paddingLeft: rail ? CE_T.s3 : '0',
        borderLeft: rail ? ('2px solid ' + rail) : 'none'
    } },
        bar,
        bar ? _ceGuide(f.instructions, true) : null,
        h(ceField, {
            key: 'slot_' + f.id, k: 'slot:' + charId + ':' + f.id,
            label: '', value: f.value, multiline: true, rows: 4,
            placeholder: 'Not written yet.',
            onCommit: function(v: string) { return ceProfileWrite(charId, f.key, v); }
        }),
        _ceGenBtn(p, charId, f.key, shortLabel, spec.instructions, spec.budget,
                  bar ? '' : String(f.instructions || '')),
        bar ? null : _ceGuide(f.instructions, true)
    );
}

// -- One facet ---------------------------------------------------------------
// [v2.141.0 STYLE2-E] Same two corrections as _ceSlotCard, minus the heading suppression:
// a facet's label never duplicates its group's, so it always keeps its head. The label
// moves from a bespoke 14px/500 line to ceKey, which is what SS7.2 says a Field-density key
// column is -- it was one of the hand-written type treatments SS1 exists to prevent.
function _ceFacetField(charId: string, p: any, cfg: any, f: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        _ceGuideBar(String(f.label || ''), f.instructions),
        _ceGuide(f.instructions, true),
        h(ceField, {
            key: 'facet_' + f.id, k: 'facet:' + charId + ':' + f.id,
            label: '', value: f.value, multiline: true, rows: 2, placeholder: 'Empty',
            onCommit: function(v: string) { return ceProfileWrite(charId, f.key, v); }
        }),
        _ceGenBtn(p, charId, f.key, String(f.label || ''), _ceGenSpec(cfg, f).instructions, _ceGenSpec(cfg, f).budget)
    );
}

// -- One group ---------------------------------------------------------------
function _ceProfileGroup(charId: string, p: any, cfg: any, g: any, extra: any[]): any {
    var patId = String(p.pattern || '');
    var pat = CE_PATTERN_DEFS[patId] || null;
    var gated = _ceGatedGroup(g.id);
    var rail = (gated && pat) ? pat.c : '';
    var rows = _ceGroupFields(p, g.id);
    var slots = _ceSlotsFor(rows, g.id, patId);
    var kids: any[] = [];

    // [v2.111.0] Position's record fields (targetId/shape/standing) arrive here as
    // `extra` rather than replacing this renderer, because the position GROUP also owns
    // five library facets. Replacing the group dropped them.
    for (var x = 0; x < (extra || []).length; x++) { kids.push(extra[x]); }

    for (var i = 0; i < slots.length; i++) {
        // [v2.141.0 STYLE2-E] rail is '' HERE ON PURPOSE: the ceAccordion this group
        // returns already draws the pattern rail down its own expanded content, and a
        // second rail 12px inside the first is the box-in-box SS7.3 forbids. The card
        // keeps its rail parameter for the build drill, which has no accordion.
        kids.push(_ceSlotCard(charId, p, cfg, slots[i], '', g.label));
    }
    if (gated && !pat) {
        // [v2.164.0 GATED-EMPTY, per user: "resistance and conduct are missing fields"] They
        // were not missing -- a gated group has NO slot until a pattern is chosen, so the
        // section rendered a head, one sentence, and nothing to write in. The sentence stays
        // and now carries the control that resolves it, instead of naming a fix that lives
        // two sections up the column.
        kids.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
                'No field here yet \u2014 the pattern decides which question this step asks.'),
            ceBtn('Choose a pattern', 'gatepat:' + charId + ':' + g.id, function() {
                _ceSetOpen(CE_PAT_OPEN, true);
                return Promise.resolve();
            })
        ));
    }

    // Facets with content. Empty ones stay behind the picker — the same
    // sparse rule buildCharStaticTab already runs (STATIC-SPARSE), not a
    // second policy invented here.
    var facets = _ceFacetsFor(rows);
    var shown: any[] = [];
    for (var j = 0; j < facets.length; j++) { if (_ceHasValue(facets[j])) shown.push(facets[j]); }
    for (var k = 0; k < shown.length; k++) { kids.push(_ceFacetField(charId, p, cfg, shown[k])); }

    var unwritten = facets.length - shown.length;
    if (unwritten > 0) {
        kids.push(ceBtn('Add to ' + g.label + ' (' + unwritten + ')', 'addfacet:' + charId + ':' + g.id, function() {
            _ceProfileDrill('addfacet:' + g.id, 0);
            return Promise.resolve();
        }));
    }

    // [v2.163.0 CONDENSED, per user] ceSection, not ceAccordion. A group is a section of ONE
    // record, so CE-STYLE SS7.1 applies: a ceD2 head with a rule running to the edge, no box
    // and no disclosure triangle. The summary/meta/openMap machinery goes with the collapse
    // -- a summary line exists to describe content that is not on screen, and all of it is
    // now on screen. The pattern rail survives because it is SS6.3's identity rail, which is
    // the one thing the accordion was carrying that was never about disclosure.
    return ceSection(g.label, h('div', { style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s4,
        borderLeft: rail ? ('3px solid ' + rail) : 'none',
        paddingLeft: rail ? CE_T.s3 : '0'
    } }, kids));
}

// -- Add-facet picker --------------------------------------------------------
// [v2.111.0 ADDFACET] Was a "no engine-side renderer yet" stub. There is no new data
// model here: the unwritten facets for a group ARE the library entries with no value,
// which _ceGroupFields already returns. A facet becomes "added" by acquiring content,
// so the picker renders each one as an editable field rather than as a button that
// writes a presence marker — a marker would be a second way for a facet to exist and
// _ceHasValue would then disagree with it.
function _ceProfileAddFacet(charId: string, p: any, cfg: any, groupId: string): any {
    var rows = _ceGroupFields(p, groupId);
    var facets = _ceFacetsFor(rows);
    var kids: any[] = [];
    for (var i = 0; i < facets.length; i++) {
        if (_ceHasValue(facets[i])) continue;
        kids.push(_ceFacetField(charId, p, cfg, facets[i]));
    }
    if (!kids.length) {
        return ceEmpty('Every ' + ceStaticFieldGroupLabel(groupId) + ' facet already has something in it.', null);
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.6' } },
            'Write into any of these and it joins the ' + ceStaticFieldGroupLabel(groupId)
            + ' section. Leave the rest empty \u2014 an unused facet costs nothing.'),
        kids
    );
}

// -- Identity ----------------------------------------------------------------
// [v2.111.0 IDENTITY, per user] The hero row displayed name/role/species/gender and
// offered no way to change any of them. Every one of these is a CFV_DIRECT key, so
// they route through the existing ceProfileWrite with no new write path.
var CE_IDENTITY_FIELDS: any[] = [
    { k: 'name', label: 'Name', ml: false },
    { k: 'occupationRole', label: 'Role', ml: false },
    // [v2.145.0 PICKER] `pick` routes this row to cePickerRow instead of ceField. This is
    // one of SS13's two named standing violations; the descriptor-array form is why SS12
    // check 5 needed a second grep, and that grep now expects this line to carry `pick`.
    { k: 'species', label: 'Species', ml: false, pick: 'species' },
    { k: 'age', label: 'Age', ml: false },
    { k: 'gender', label: 'Gender', ml: false },
    { k: 'briefDescription', label: 'In one line', ml: true }
];
// [v2.112.0 IDENTITY-INLINE, per user] Was an accordion sitting above the body. Wrong on
// two counts: it duplicated the hero (which already displays exactly these values), and a
// section is the wrong affordance for "edit the thing you are looking at". The hero's
// identity block is now the control -- tapping the name or the lines under it opens this
// as a drill. Nothing is displayed twice, and the edit path is where the reader's eye
// already is.
function _ceProfileIdentityDrill(charId: string, p: any): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_IDENTITY_FIELDS.length; i++) {
        kids.push((function(fd: any) {
            // cePickerRow is hook-free by contract, so this branch is legal inside the
            // loop; ceField is a keyed h() child and keeps its own hook scope either way.
            if (fd.pick) {
                return cePickerRow({
                    label: fd.label, value: p[fd.k] || '',
                    kind: fd.pick, ctx: { charId: charId },
                    placeholder: 'Choose\u2026'
                });
            }
            return h(ceField, {
                key: 'id_' + fd.k, k: 'ident:' + charId + ':' + fd.k,
                label: fd.label, value: p[fd.k] || '', multiline: !!fd.ml, rows: 2,
                placeholder: '\u2014',
                onCommit: function(v: string) { return ceProfileWrite(charId, fd.k, v); }
            });
        })(CE_IDENTITY_FIELDS[i]));
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Images --------------------------------------------------------------------
// [v2.119.0 CE-IMG-GRID, v2.121.0 IMG-SLOT-ROWS, per user] Per-slot tag editing, add-slot,
// and the generate / edit / download / delete controls, replacing v2.119.0's read-only
// grid. UPLOAD IS STILL NOT HERE AND NEVER WILL BE: a file picker is DOM and the worker
// has none, so that one control stays on the bridge's own Portraits screen however far the
// rest of this menu moves — noted again because it is the one gap a future pass could
// forget to route around.
//
// 26 SLOTS ON FIRST LOAD, USER-EXTENSIBLE AFTER: Avatar + Snapshot + the 24 canonical
// emotion words, derived from ALL_EMOTIONS_LIST rather than a second hand-typed list (same
// reasoning CANON_EMOTION_SLOTS uses bridge-side for the identical derivation). Storage-key
// casing is preserved exactly on purpose: 'Avatar' / 'Snapshot' capitalised, every emotion
// word lowercase, because the slot name is a literal IndexedDB key suffix with no
// normalisation on either side of the boundary. See SECTION 9b (loadCharImgSlots) for the
// storage and the soft-pin semantics: Avatar can never be removed; the 24 canonical words
// come back on the next load even if deleted; Snapshot and custom slots stay gone. That is
// a faithful port of behaviour the bridge already shipped, kept on purpose, not simplified.
//
// A ROW, NOT A GRID CELL. Per user: the thumbnail, the tag field, and the four controls
// belong together as one collapsible unit, so a 26-entry list stays scannable instead of
// showing 26 open textareas at once — same READ-FIRST reasoning the Journal already
// settled, applied to a list where the "read" state is a thumbnail instead of prose.
// EVERY CHILD IS KEYED, same discipline FIELD-KEYLESS and the Journal both paid for: a
// variable-length list of ceField instances with no key is exactly the shape that leaked a
// node before.
var CE_IMG_EMOTION_SLOTS: string[] = ALL_EMOTIONS_LIST.split(',').map(function(s: string) { return s.trim(); }).filter(Boolean);

// -- Store, publish, op-chain -------------------------------------------------
// Same three-part shape SECTION 31 (Journal) already settled for a variable-length,
// individually-editable list: a dedicated store (tag edits happen far more often than
// anything else on this surface, so this must not live on ceUiStore or a keystroke-commit
// repaints Scene and the rest of Profile too); a serialising op-chain (OP-CHAIN's reasoning
// applies unchanged -- storage here is also load-modify-persist with no compare-and-swap,
// so two tag commits landing close together would silently discard one without it); a
// draft module var for the add-slot composer (CLICK-BEFORE-BLUR's fix, not its cause --
// the fix generalises to any button reading a field's value, and this surface has one).
var ceImgSlotStore: any = null;
function ceImgSlotStoreInit(): void {
    if (ceImgSlotStore) return;
    try { ceImgSlotStore = createStore({ ready: false, charId: '', slots: [], tags: {}, confirm: '', addGen: 0 }); }
    catch (e) { api.v1.error('[AE:imgslots] store init failed:', e); }
}
function ceImgSlotPatch(fn: (s: any) => any): void {
    if (!ceImgSlotStore) return;
    try {
        ceImgSlotStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:imgslots] patch failed:', e); }
}
var _ceImgSlotChain: Promise<any> = Promise.resolve();
function ceImgSlotOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceImgSlotChain.then(fn);
    _ceImgSlotChain = run.catch(function() { return null; });
    return run;
}
var _ceImgSlotDraft: string = '';

async function cePublishImgSlots(charId: string): Promise<void> {
    ceImgSlotStoreInit();
    if (!ceImgSlotStore) return;
    try {
        var state = await loadCharImgSlots(charId);
        ceImgSlotPatch(function(s: any) {
            var fresh = (String(s.charId || '') !== charId);
            var conf = fresh ? '' : String(s.confirm || '');
            if (conf && state.slots.indexOf(conf) === -1) { conf = ''; }
            if (fresh) { _ceImgSlotDraft = ''; }
            return { ready: true, charId: charId, slots: state.slots, tags: state.tags || {}, confirm: conf };
        });
    } catch (e) { api.v1.error('[AE:imgslots] publish failed:', e); }
}

// -- One slot row --------------------------------------------------------------
// [v2.142.0 STYLE2-F, per user] "Character portraits absolutely should not be drill down
// carrots. Each one is a single item and a write-only surface." BOTH HALVES OF THAT ARE
// STRUCTURAL, not cosmetic, and they land as one change:
//
// (1) NOT A DISCLOSURE. A caret is the right affordance for content you might not want to
// read. A portrait is not read -- it is looked at, and it is the one thing on this surface
// that cannot be summarised into a collapsed row. The old shape hid the image behind a
// 36px thumbnail beside a caret and put the only field that MAKES the image (its tags)
// behind a tap. So there is no `open` parameter any more, no ceUiStore.open entry, and no
// collapsed state to be in: every slot renders complete, always.
//
// (2) A SINGLE ITEM = OBJECT DENSITY (SS7.3: "many distinct records"). Each slot is a
// distinct thing with its own image, its own tags and its own verbs, which is exactly what
// ceCard is for and is the same call SS7.3 makes for the Scene roster. The 36px thumbnail
// becomes a 64x96 preview at the record's own 2:3 portrait frame -- the image is the
// record, so it gets the surface area.
//
// THE FOUR WORD-BUTTONS BECOME ONE WORD AND THREE ICONS, per SS6.4's row-verb rule.
// Generate is the primary action of the card and keeps its word; edit/download/delete are
// row verbs and are icon-only with mandatory aria-labels, which is what makes a card with
// a 96px image still fit on a phone. The labels name the SLOT, not just the verb, because
// there are N of these cards on one screen and "Delete" alone is ambiguous to a screen
// reader. Avatar still gets no delete -- unchanged rule, not a new one.
function _ceImgSlotCard(charId: string, slot: string, tag: string, isAvatar: boolean, confirming: boolean): any {
    // [v2.152.0 PHOTO-VIEW] Tap opens the full-screen viewer. The click target is this
    // anchor alone (a sibling of the tag field and the action row below, never a
    // wrapping card with its own onClick), so there is no nested-tap question.
    var preview = h('div', ceImgAnchor(charId, slot, {
        onClick: function() { ceTap('imgslot:view:' + slot, function() { cePhotoOpen(charId, slot, slot); }); },
        role: 'button', tabIndex: 0, 'aria-label': 'View the ' + slot + ' image full screen',
        style: { flex: '0 0 auto', width: '64px', height: '96px', borderRadius: CE_T.r,
            background: CE_WELL, border: '1px solid ' + CE_LINE, position: 'relative',
            overflow: 'hidden', cursor: 'pointer' }
    }));

    var kids: any[] = [];
    kids.push(h(ceField, {
        key: 'imgtag_' + slot, k: 'imgtag:' + charId + ':' + slot,
        label: 'Tags', value: tag, multiline: true, rows: 2,
        placeholder: isAvatar ? 'upper body, looking at viewer, plain background\u2026' : 'expression, pose\u2026',
        onCommit: function(v: string) {
            return ceImgSlotOp(function() { return charImgSetTag(charId, slot, v); })
                .then(function() { return cePublishImgSlots(charId); });
        }
    }));

    var acts: any[] = [];
    acts.push(ceBtn('Generate', 'imgslot:gen:' + slot, function() { return ceImgSlotGenerate(charId, slot); }, 'primary'));
    acts.push(ceIconBtn('Edit the ' + slot + ' image', ceIconEdit(), 'imgslot:edit:' + slot,
        function() { return ceImgSlotAction(charId, slot, 'edit'); }));
    acts.push(ceIconBtn('Download the ' + slot + ' image', ceIconDownload(), 'imgslot:dl:' + slot,
        function() { return ceImgSlotAction(charId, slot, 'download'); }));
    // [v2.121.0 DESTRUCTIVE-NEVER-IN-PLACE] Same rule the Journal's delete button follows:
    // this button ASKS and never deletes, and keeps the same handler in both states, so the
    // double-fire that reuses the physical node (TAP-GUARD) can never land the confirmed
    // branch off the first tap. Avatar gets no Delete at all -- it is not a confirm-guarded
    // action, it is not offered, same as the bridge's own Portrait Studio.
    if (!isAvatar) {
        acts.push(ceIconBtn('Delete the ' + slot + ' slot', ceIconTrash(), 'imgslot:delask:' + slot, function() {
            ceImgSlotPatch(function() { return { confirm: slot }; });
            return Promise.resolve();
        }, 'danger'));
    }
    kids.push(h('div', { key: 'imga_' + slot, style: { display: 'flex', flexWrap: 'wrap',
        alignItems: 'center', gap: CE_T.s2 } }, acts));

    if (confirming) {
        kids.push(h('div', { key: 'imgc_' + slot, style: {
            display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3
        } },
            h('div', { key: 'imgcm_' + slot, style: { flex: '1 1 180px', fontSize: CE_T.fsSm,
                opacity: '0.74', lineHeight: '1.4' } },
                'Delete the \u201C' + slot + '\u201D slot and its saved image? This canonical slot ' +
                'will reappear empty the next time this screen loads \u2014 only its image and tag are removed.'),
            ceBtn('Delete', 'imgslot:del:' + slot, function() {
                return ceImgSlotOp(function() { return charImgRemoveSlot(charId, slot); })
                    .then(function() { return ceImgSlotAction(charId, slot, 'delete'); })
                    .then(function() { ceImgSlotPatch(function() { return { confirm: '' }; }); return cePublishImgSlots(charId); });
            }, 'danger'),
            ceBtn('Keep', 'imgslot:keep:' + slot, function() {
                ceImgSlotPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    // The preview sits BESIDE the authoring column, not above it: at 2:3 the image is taller
    // than it is wide, and stacking it would push the tag field -- the thing you are here to
    // write -- below the fold on every card.
    return ceCard({ key: 'imgcard_' + slot, children: h('div', {
        style: { display: 'flex', alignItems: 'flex-start', gap: CE_T.s3 }
    },
        preview,
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
            flexDirection: 'column', gap: CE_T.s2 } },
            ceH(slot),
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids)
        )
    ) });
}

// -- Root component ------------------------------------------------------------
// A REAL COMPONENT, mounted via h(_ceProfileImagesDrill, {charId}) at the drill router --
// never called bare. It calls useStoreValue/useEffect, and those hooks must live in their
// OWN isolated instance (Preact gives h(Component, props) exactly that), not inlined into
// ceProfileRoot's own hook sequence the way a bare function call would. Every OTHER drill
// body is a plain function precisely because none of them holds hooks of their own --
// _ceProfileIdentityDrill's h(ceField, ...) calls are isolated the same way, one level
// deeper. This is the first drill whose OWN top level needs a hook, so it is the first one
// that has to be the component rather than the function.
function _ceProfileImagesDrill(props: any): any {
    var charId = String((props && props.charId) || '');
    // [v2.122.0 STORE-BEFORE-HOOK, live report] A STORE MUST EXIST BEFORE THE FIRST RENDER
    // OF ANYTHING THAT SUBSCRIBES TO IT, and useEffect IS TOO LATE TO CREATE IT. v2.121.0
    // created ceImgSlotStore lazily inside cePublishImgSlots, which this component calls
    // from useEffect -- and an effect runs AFTER the render that scheduled it. So the very
    // first render reached useStoreValue(null), which throws inside the render pass:
    // the drill painted as a BLANK SURFACE with nothing in the console, because a throw
    // inside NAI's jsx marshalling is swallowed rather than reported.
    // TWO GUARDS, both cheap, because they fail differently: the shell opener now inits this
    // store alongside the others (the real fix -- the store simply exists before any
    // surface opens), and this call covers a future entry path that does not come through
    // it. [v2.131.0 SHELL-TRAY] That opener is ceOpenShell now; ceOpenScene, which this
    // comment used to name, is deleted. It is STRAIGHT-LINE, NOT CONDITIONAL, so it adds no hook and cannot
    // shift the hook sequence below it; ceImgSlotStoreInit is idempotent by its own guard.
    // GENERAL RULE: every createStore in this file belongs in an init function called from
    // the surface opener. Lazy-create-on-first-publish is safe only for a store nothing
    // renders from.
    ceImgSlotStoreInit();
    // [v2.142.0 STYLE2-F] THE ceUiStore SUBSCRIPTION IS GONE. Its only consumer here was
    // the per-slot openMap lookup, and portrait slots have no collapsed state any more.
    // Removing a hook from a component is safe -- hook order is per-instance and this is
    // unconditional, at the top, on every render -- and the surface still repaints on
    // ceUiStore changes because ceProfileRoot, which mounts this drill, subscribes to it
    // for the drill router itself. A subscription with no reader is not free: every
    // ceUiStore write (every accordion tap anywhere in the shell) was repainting this
    // component for nothing.
    var st = useStoreValue(ceImgSlotStore);
    // [v2.121.0] SUBSCRIBED, not a one-time .get(). _ceImgVisualFields writes through
    // ceProfileWrite -> cePublishProfile, same as every other field on this surface -- a
    // one-time read here would show the ratio select (ceSelect, CONTROLLED) its OWN prior
    // value forever after a commit, because nothing would ever tell this component to
    // re-render with the fresh record. The tag fields below are uncontrolled and would
    // have hidden this: a ceField shows what was just typed into it regardless of whether
    // its parent re-renders, so this gap would only have shown up on the ratio select and
    // easily have gone unnoticed in a quick pass.
    var prof = useStoreValue(ceProfileStore);

    useEffect(function() {
        cePublishImgSlots(charId);
    }, [charId]);

    if (!st || !st.ready || st.charId !== charId) {
        return ceEmpty('Loading\u2026', null);
    }

    var p = (prof && prof.p) || {};
    var slots: string[] = st.slots || [];
    var confirm = String(st.confirm || '');
    var rows: any[] = [];
    for (var i = 0; i < slots.length; i++) {
        var slot = slots[i];
        var isAvatar = (slot === CE_IMG_SLOT_AVATAR);
        var tag = charImgEffectiveTag({ slots: slots, tags: st.tags }, slot);
        rows.push(_ceImgSlotCard(charId, slot, tag, isAvatar, confirm === slot));
    }

    var addRow = h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h(ceField, {
            key: 'imgadd_' + String(st.addGen || 0), k: 'imgadd:' + charId,
            label: '', value: '', multiline: false, rows: 1, well: true,
            placeholder: 'New slot name \u2014 Combat, Formal, Injured\u2026',
            onType: function(v: string) { _ceImgSlotDraft = v; },
            onCommit: function(v: string) { _ceImgSlotDraft = v; return Promise.resolve(); }
        }),
        ceBtn('Add slot', 'imgslot:add:' + charId, function() {
            var name = _ceImgSlotDraft;
            if (!String(name || '').trim()) {
                try { api.v1.ui.toast('Name the slot first.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
                return Promise.resolve();
            }
            return ceImgSlotOp(function() { return charImgAddSlot(charId, name); }).then(function() {
                _ceImgSlotDraft = '';
                ceImgSlotPatch(function(s: any) { return { addGen: Number(s.addGen || 0) + 1 }; });
                return cePublishImgSlots(charId);
            });
        })
    );

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        _ceImgVisualFields(charId, p),
        ceGroup('Slots (' + slots.length + ')',
            // s2 between cards, per SS7.3. Was s1, which was correct for stacked accordion
            // rows sharing a hairline and is too tight for boxes.
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, rows)
        ),
        ceGroup('Add a slot', addRow)
    );
}

// -- The visual fields -------------------------------------------------------
// [v2.120.0 IMG-FIELDS, per user] These SEVEN fields have existed on CharacterRecord since
// the bridge roster was retired and have never had an engine-side editor -- the bridge's
// Visuals tab was the only way to reach any of them. Nothing here is new data and nothing
// here is a new write path: all four text fields are CFV_DIRECT keys and the three numeric
// ones go through applyCharFieldValue's CFV_NUM branch, so every one routes through the
// same ceProfileWrite every other field on this surface uses.
//
// THE FOUR TAG FIELDS ARE FOUR SCOPES, NOT FOUR STYLES, and the hints say so because
// getting them confused is what produces a character whose avatar and whose scene art
// disagree about their own hair colour:
//   visuals        every generation of this character, everywhere
//   uc             every generation of this character, everywhere (negative)
//   avatarVisuals  portraits and emotion slots only
//   sceneVisuals   scene illustrations only
//
// RATIO IS A SELECT, NOT TWO NUMBER FIELDS. The three shapes are the ones already settled
// in design and already used by every image surface in the project (portrait 832x1216,
// avatar 1024x1024, scene 1216x832) -- offering free-form width and height would invite
// dimensions NAI rejects and would be a fourth place the same three numbers are written
// down. A record carrying some other pair from an older bridge-side edit still renders:
// the current value is appended as its own option rather than being silently snapped to
// the nearest of the three.
// [v2.148.0 RATIO-COLLISION] RENAMED FROM CE_IMG_RATIOS, WHICH WAS A LIVE BUG, NOT A
// tidy-up. SECTION 35 declares a SECOND top-level `var CE_IMG_RATIOS` with an incompatible
// shape ({label,w,h} rather than {id,label}). Two `var`s of one name in one script are one
// binding, and the LAST assignment at load time wins -- so this array never existed at
// runtime. The consequence was silent and shipped in v2.143.0: the select below rendered
// three options with `undefined` ids, `known` could never become true so a bogus "Custom"
// row was always appended, and committing any option wrote undefined width/height.
// The two are NOT merged, because they are genuinely different objects: this one is a
// SELECT OPTION LIST keyed by the '<w>x<h>' string a record stores, SECTION 35's is a
// BUTTON SET carrying the numbers. Merging would make one of them derive its shape from
// the other's use, which is how they collided in the first place.
var CE_IMG_RATIO_OPTS: any[] = [
    { id: '832x1216', label: 'Portrait \u2014 832\u00d71216 (2:3)' },
    { id: '1024x1024', label: 'Square \u2014 1024\u00d71024 (1:1)' },
    { id: '1216x832', label: 'Landscape \u2014 1216\u00d7832 (3:2)' }
];

function _ceImgVisualFields(charId: string, p: any): any {
    var w = Number(p.avatarWidth || 1024);
    var hgt = Number(p.avatarHeight || 1024);
    var cur = String(w) + 'x' + String(hgt);
    var opts: any[] = [];
    var known = false;
    for (var i = 0; i < CE_IMG_RATIO_OPTS.length; i++) {
        opts.push(CE_IMG_RATIO_OPTS[i]);
        if (CE_IMG_RATIO_OPTS[i].id === cur) known = true;
    }
    if (!known) { opts.push({ id: cur, label: 'Custom \u2014 ' + String(w) + '\u00d7' + String(hgt) }); }

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        ceGroup('Look',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
                h(ceField, {
                    key: 'img_visuals', k: 'img:' + charId + ':visuals',
                    label: 'Always', value: p.visuals || '', multiline: true, rows: 3,
                    placeholder: 'silver hair, green eyes, tall\u2026',
                    hint: 'Applied to every image of this character, everywhere.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'visuals', v); }
                }),
                h(ceField, {
                    key: 'img_avatarVisuals', k: 'img:' + charId + ':avatarVisuals',
                    label: 'Portraits only', value: p.avatarVisuals || '', multiline: true, rows: 2,
                    placeholder: 'upper body, looking at viewer, plain background\u2026',
                    hint: 'Added on top of Always, for the slots below only.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'avatarVisuals', v); }
                }),
                h(ceField, {
                    key: 'img_sceneVisuals', k: 'img:' + charId + ':sceneVisuals',
                    label: 'Scene art only', value: p.sceneVisuals || '', multiline: true, rows: 2,
                    placeholder: 'full body, in costume\u2026',
                    hint: 'Added on top of Always, for story illustrations only.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'sceneVisuals', v); }
                }),
                h(ceField, {
                    key: 'img_uc', k: 'img:' + charId + ':uc',
                    label: 'Never', value: p.uc || '', multiline: true, rows: 2,
                    placeholder: 'glasses, hat\u2026',
                    hint: 'Kept out of every image of this character.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'uc', v); }
                })
            )
        ),
        ceGroup('Generation',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                ceSettingRow('Shape', 'The frame every slot below is generated at.',
                    ceSelect({
                        k: 'img:' + charId + ':ratio',
                        value: cur,
                        options: opts,
                        onCommit: function(v: string) {
                            var bits = String(v || '').split('x');
                            return (async function() {
                                await ceProfileWrite(charId, 'avatarWidth', bits[0] || '1024');
                                await ceProfileWrite(charId, 'avatarHeight', bits[1] || '1024');
                            })();
                        }
                    })
                ),
                h(ceField, {
                    key: 'img_seed', k: 'img:' + charId + ':seed',
                    label: 'Seed', value: String(p.avatarSeed || 0), multiline: false, rows: 1,
                    placeholder: '0',
                    hint: 'Zero picks a new seed each time. A fixed number keeps the same face across slots \u2014 set it once the look is right.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'avatarSeed', v); }
                })
            )
        )
    );
}

// -- Position ----------------------------------------------------------------
// [v2.111.0 POSITION-WIRED, per user] The Position group rendered as an empty
// accordion because position is NOT a customField — it is char.position, a fixed
// four-field record (targetId / targetName / shape / standing) written through the
// position.* branch of applyCharFieldValue.
//
// Both prose fields, per the locked design: `shape` is genesis-permanent (how this
// standing came to be), `standing` is threshold-rewritable (where it sits now).
// targetId and targetName are written TOGETHER and always as a pair, which is the
// CharPosition rule — an unresolved targetId is a working state, not an error, so
// the name travels with it rather than being looked up later.
// [v2.145.0 PICKER] `roster` DROPPED FROM THE SIGNATURE. It fed the chip list only; the
// picker reads the cast from ceProfileStore at render time (_cePickCast), so a parameter
// still saying "this function needs the roster" would be a lie the next reader has to
// disprove. All three call sites updated in the same patch.
function _ceProfilePositionKids(charId: string, p: any): any[] {
    var pos: any = p.position || {};
    var tid = String(pos.targetId || '');
    var kids: any[] = [];

    // [v2.145.0 PICKER] WAS AN INLINE WRAPPING CHIP LIST. Replaced by the kit picker for
    // three reasons, in order of weight:
    //   1. It wrote targetId and targetName as TWO commits. SS13 requires one. See
    //      ceProfileWritePair.
    //   2. The list is UNBOUNDED -- SS13's own test for "full surface swap, not a
    //      dropdown, and never a wrapping row of chips that pushes the fields it must
    //      agree with off screen."
    //   3. It could not offer '__player__', so a Position against the protagonist -- the
    //      model's most common case, and named in CharPosition's own interface comment --
    //      had no route through the UI at all. _cePickCast puts it first.
    kids.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { fontSize: CE_T.fs, fontWeight: '500' } }, 'Who they are positioned against'),
        cePickerRow({
            label: '', value: String(pos.targetName || ''),
            kind: 'positionTarget', ctx: { charId: charId },
            placeholder: 'Choose a counterpart\u2026',
            hint: 'One primary counterpart. Secondaries and factions are static lorebook facets, not positions \u2014 a second primary would mean two answers to the same question.'
        })
    ));

    if (tid) {
        kids.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            ceH2('Shape'),
            _ceGuide('How this standing came to be. Written once at genesis and left alone \u2014 a threshold rewrites where they stand, never how it started.'),
            h(ceField, {
                key: 'pos_shape', k: 'pos:' + charId + ':shape',
                label: '', value: pos.shape || '', multiline: true, rows: 3,
                placeholder: 'What put these two in this relation to each other\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'position.shape', v); }
            })
        ));
        kids.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            ceH2('Standing'),
            _ceGuide('Where it sits right now. This is the field a threshold rewrites, so keep it to the current state rather than the history.'),
            h(ceField, {
                key: 'pos_standing', k: 'pos:' + charId + ':standing',
                label: '', value: pos.standing || '', multiline: true, rows: 3,
                placeholder: 'Where the two of them stand as of this scene\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'position.standing', v); }
            })
        ));
    }

    return kids;
}
// Summary line for the Position accordion head. Lives here rather than inline so the
// group renderer stays generic and does not learn about char.position.
// [v2.163.0] DEAD -- its only callers were _ceProfileGroup accordion summaries, removed
// by the condensed rewrite. Retained un-deleted this pass.
function _cePositionSummaryDEAD(p: any): string {
    var pos: any = p.position || {};
    if (!String(pos.targetId || '')) return 'Not set';
    return String(pos.targetName || 'someone') + ' \u2014 '
        + _ceTrim(String(pos.standing || pos.shape || ''), 44);
}

// -- Hooks -------------------------------------------------------------------
// [v2.111.0 HOOKS-WIRED, per user] Hooks are not a field, so they cannot route through
// applyCharFieldValue — this is a second write path and it is deliberate, kept to ONE
// function so the saveCharacter/republish pair cannot be forgotten by a second caller.
// The legacy modal already mutated char.hooks directly (engine ~18707), so this is the
// same act with the surrounding discipline attached.
//
// NOTE ON SCAN: runWizardHookSingle is NOT reused even though it exists and generates
// exactly this. It ASSIGNS char.hooks = [one hook], wiping any hooks already present —
// correct at wizard time when there are none, destructive from a profile where the user
// may have written three. This calls generateCharacterHook and APPENDS.
// [v2.154.0 PROFILE-CHAIN-GAP] Now serialised through ceProfileOp.
async function ceProfileHookOp(charId: string, op: string, hookId: string, value: any): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            if (!c.hooks) c.hooks = [];
            if (op === 'add') {
                c.hooks.push({ id: api.v1.uuid(), targetId: '', targetName: '', description: '',
                               pressureLevel: 25, developmentNotes: [], resolved: false });
            } else if (op === 'remove') {
                var kept: any[] = [];
                for (var i = 0; i < c.hooks.length; i++) { if (c.hooks[i].id !== hookId) kept.push(c.hooks[i]); }
                c.hooks = kept;
            } else if (op === 'resolve' || op === 'desc' || op === 'target') {
                for (var j = 0; j < c.hooks.length; j++) {
                    if (c.hooks[j].id !== hookId) continue;
                    if (op === 'resolve') { c.hooks[j].resolved = true; }
                    else if (op === 'desc') { c.hooks[j].description = String(value || '').substring(0, 300); }
                    // [v2.146.0 HOOK-TARGETID] 'target' now carries the REF, not a string, and
                    // writes both halves inside the single load/save this function already
                    // owns — CE-STYLE SS13's "same commit" rule, satisfied structurally rather
                    // than by a caller remembering to make two calls in order.
                    else {
                        var tv: any = value || {};
                        c.hooks[j].targetId = String(tv.id || '');
                        c.hooks[j].targetName = String(tv.name || '');
                    }
                    break;
                }
            } else { return; }
            await saveCharacter(c);
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] hook op failed:', e); }
    });
}

// [v2.154.0 PROFILE-CHAIN-GAP] Only the TAIL (from the second load onward) is chained.
// generateCharacterHook is a model call and must never sit inside ceProfileOp -- that
// would block every other field commit on the surface for as long as it runs.
async function ceProfileScanHook(charId: string): Promise<void> {
    try {
        var c: any = await loadCharacter(charId);
        if (!c) return;
        api.v1.ui.toast('Looking for a tension\u2026', { id: 'ce-hookscan', autoClose: false, type: 'info' });
        var gen: any = await generateCharacterHook(c, [], '');
        if (!gen) {
            api.v1.ui.toast('No clean tension found.', { id: 'ce-hookscan', type: 'error', autoClose: 2500 });
            return;
        }
        await ceProfileOp(async function() {
            var fresh: any = await loadCharacter(charId);
            if (!fresh) return;
            if (!fresh.hooks) fresh.hooks = [];
            fresh.hooks.push({ id: api.v1.uuid(), targetId: gen.targetId || '', targetName: gen.targetName || '',
                               description: String(gen.description || '').substring(0, 300),
                               pressureLevel: 25, developmentNotes: [], resolved: false });
            await saveCharacter(fresh);
            api.v1.ui.toast('Hook added.', { id: 'ce-hookscan', type: 'success', autoClose: 1500 });
            await cePublishProfile(charId);
        });
    } catch (e) {
        api.v1.error('[AE:jsxprofile] hook scan failed:', e);
        try { api.v1.ui.toast('Scan failed.', { id: 'ce-hookscan', type: 'error', autoClose: 2000 }); } catch (e2) {}
    }
}

// [v2.146.0 HOOK-TARGETID] `cfg` added: a hook whose targetId is '__player__' has no
// name in the record and resolves against the live protagonist name.
function _ceProfileHooks(charId: string, p: any, cfg: any): any {
    var hooks = p.hooks || [];
    var kids: any[] = [];
    for (var i = 0; i < hooks.length; i++) {
        kids.push((function(hk: any) {
            return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2,
                paddingBottom: CE_T.s3, borderBottom: '1px solid ' + CE_LINE } },
                h(ceField, {
                    key: 'hk_d_' + hk.id, k: 'hook:' + hk.id + ':desc',
                    label: 'Tension', value: hk.description || '', multiline: true, rows: 2,
                    placeholder: 'What is unresolved between them\u2026',
                    onCommit: function(v: string) { return ceProfileHookOp(charId, 'desc', hk.id, v); }
                }),
                // [v2.145.0 PICKER] SS13's other standing check-5 violation, closed. Still
                // stores a NAME and not an id -- UnresolvedHook has no targetId field and
                // nothing keys a hook axis off one, so inventing the column here would be a
                // migration with zero readers. See the hookTarget def and KNOWN OPEN ITEMS.
                cePickerRow({
                    label: 'Toward',
                    // '__player__' is an id and has no name in the record, so the row
                    // resolves it the same way every other reader does.
                    value: (String(hk.targetId || '') === '__player__')
                        ? String((cfg && cfg.protagonistName) || 'the player')
                        : String(hk.targetName || ''),
                    kind: 'hookTarget', ctx: { charId: charId, hookId: hk.id },
                    placeholder: 'Who it is directed at\u2026'
                }),
                h('div', { style: { display: 'flex', gap: CE_T.s2 } },
                    ceBtn('Resolve', 'hookres:' + hk.id, function() {
                        return ceProfileHookOp(charId, 'resolve', hk.id, null);
                    }),
                    ceIconBtn('Delete this hook', ceIconTrash(), 'hookdel:' + hk.id, function() {
                        return ceProfileHookOp(charId, 'remove', hk.id, null);
                    }, 'danger')
                )
            );
        })(hooks[i]));
    }
    if (!kids.length) {
        kids.push(h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.6' } },
            'No unresolved hooks. A hook is a directed, unresolved tension \u2014 something owed, '
            + 'threatened, hidden, or wanted from a specific person. It is what gives the character '
            + 'a reason to act before the story hands them one.'));
    }
    kids.push(h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
        ceBtn('Scan for one', 'hookscan:' + charId, function() { return ceProfileScanHook(charId); }),
        ceBtn('Add blank', 'hookadd:' + charId, function() { return ceProfileHookOp(charId, 'add', '', null); })
    ));
    return ceSection('Hooks', h('div', { style: { display: 'flex', flexDirection: 'column',
        gap: CE_T.s4 } }, kids));
}

// -- Pattern junction --------------------------------------------------------
// [v2.163.0 CONDENSED, per user: "I don't like any of the drill down formatting"] The
// pattern was a tappable row opening a full-surface drill to choose one of six. Six chips
// fit on the surface they belong to, so the drill is gone and the picker renders inline.
// _cePatternPicker is UNCHANGED and still serves the build flow, which does want a step.
function _ceProfilePatternSection(charId: string, p: any): any {
    var pat = CE_PATTERN_DEFS[String(p.pattern || '')] || null;
    var open = _ceOpenIs(CE_PAT_OPEN);
    var head = h('div', {
        role: 'button', tabIndex: 0,
        'aria-expanded': open ? 'true' : 'false',
        'aria-label': open ? 'Hide pattern choices' : 'Change pattern',
        onClick: function() { ceTap(CE_PAT_OPEN, function() { _ceSetOpen(CE_PAT_OPEN, !open); }); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3,
            minHeight: CE_T.ctl, cursor: 'pointer' }
    },
        h('div', { style: { flex: '0 0 auto', width: '10px', height: '10px', borderRadius: '50%',
            background: pat ? pat.c : 'transparent',
            border: pat ? 'none' : '1px solid ' + CE_LINE2 } }),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fsSm,
            opacity: pat ? CE_OP.t2 : CE_OP.t3, overflow: 'hidden',
            textOverflow: 'ellipsis', whiteSpace: 'nowrap' } },
            pat ? (pat.sub + ' \u2014 ' + pat.blurb)
                : 'Not chosen \u2014 Resistance and Conduct stay generic until it is'),
        h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: CE_OP.t3 } },
            open ? 'Close' : (pat ? 'Change' : 'Choose'))
    );
    return ceSection('Pattern', h('div', { style: { display: 'flex', flexDirection: 'column',
        gap: CE_T.s3 } },
        head,
        open ? _cePatternPicker(charId, p, false, CE_PAT_OPEN) : null
    ));
}
function _ceProfilePatternRowLEGACY(p: any): any {
    var pat = CE_PATTERN_DEFS[String(p.pattern || '')] || null;
    return h('div', {
        onClick: function() { ceTap('drill:pattern', function() { _ceProfileDrill('pattern', 0); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap,
            cursor: 'pointer', padding: CE_T.s2 + ' 0', borderBottom: '1px solid ' + CE_LINE
        }
    },
        h('div', { style: {
            flex: '0 0 auto', width: '10px', height: '10px', borderRadius: '50%', marginLeft: '1px',
            background: pat ? pat.c : 'transparent', border: pat ? 'none' : '1px solid ' + CE_LINE2
        } }),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '2px' } },
            h('div', { style: { fontSize: CE_T.fsSm, fontWeight: '500', letterSpacing: '0.09em',
                textTransform: 'uppercase', opacity: '0.58' } }, 'Pattern'),
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', overflow: 'hidden',
                textOverflow: 'ellipsis', whiteSpace: 'nowrap' } },
                pat ? (pat.sub + ' \u2014 ' + pat.blurb) : 'Not chosen \u2014 Resistance and Conduct stay generic')
        ),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, '\u203A')
    );
}

// -- Drills ------------------------------------------------------------------
// Full surface swaps, not overlays. See the header note on why an opaque
// floating panel is not constructible here.
function _cePatternPicker(charId: string, p: any, fromBuild: boolean, closeId?: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_PATTERN_ORDER.length; i++) {
        kids.push((function(pid: string) {
            var d = CE_PATTERN_DEFS[pid];
            var on = String(p.pattern || '') === pid;
            return h('div', {
                onClick: function() {
                  ceTap('pick:pattern:' + pid, function() {
                    ceAction('pattern:' + charId, function() {
                        return ceProfileWrite(charId, 'pattern', pid).then(function() {
                            // [v2.164.0 PAT-COLLAPSE, per user] Choosing IS the dismissal.
                            // Six cards are worth the space while deciding and worth none
                            // afterwards, and the section head keeps showing the answer.
                            if (closeId) _ceSetOpen(closeId, false);
                            if (!fromBuild) _ceProfileDrill('', 0);
                        });
                    });
                  });
                },
                style: {
                    cursor: 'pointer', padding: CE_T.s3, borderRadius: CE_T.r,
                    background: on ? CE_FILL : 'transparent',
                    border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
                    borderLeft: '3px solid ' + d.c,
                    display: 'flex', flexDirection: 'column', gap: '3px'
                }
            },
                h('div', { style: { fontSize: CE_T.fsKey, letterSpacing: '0.09em', textTransform: 'uppercase', opacity: '0.58' } }, d.sub),
                h('div', { style: { fontSize: CE_T.fs, lineHeight: '1.45' } }, d.name),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } }, d.blurb)
            );
        })(CE_PATTERN_ORDER[i]));
    }
    return h('div', { style: {
        display: 'grid', gap: CE_T.s2,
        gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))'
    } }, kids);
}

// -- Pressure strip ----------------------------------------------------------
// Persistent, not behind a disclosure triangle. This is the highest-frequency
// control on the surface and burying it one tap deep is the exact failure the
// old Drama modal represented.
function _ceTierBar(axis: string, tier: number, tall: boolean): any {
    var floor = _ceAxisFloor(axis);
    var cells: any[] = [];
    for (var i = floor; i <= 4; i++) {
        var on = (tier >= 0) ? (i >= 0 && i <= tier) : (i <= 0 && i >= tier);
        cells.push(h('div', { style: {
            flex: '1 1 0', height: tall ? '3px' : '2px', borderRadius: '2px',
            // [v2.139.0 STYLE2] These cells are NON-TEXT, so their weight is a color-mix,
            // not an opacity rung -- SS4: "Non-text dimming (rules, fills, decorative
            // glyphs) uses CE_LINE/CE_FILL, which are color-mix values, not opacity --
            // keeping the two vocabularies separate is what makes the audit able to tell a
            // dimmed label from a hairline." The old `opacity: 0.65` on a lit cell was the
            // one place a fill borrowed a text rung. The top-tier CE_SEM.ask cell is
            // untouched and still undimmed (SS6: semantic colours never take an opacity).
            background: on
                ? (tier >= 4 ? CE_SEM.ask : 'color-mix(in srgb, currentColor 65%, transparent)')
                : CE_LINE,
            outline: (i === 0 && floor < 0) ? '1px solid ' + CE_LINE2 : 'none'
        } }));
    }
    return h('div', { style: { display: 'flex', gap: '2px', alignItems: 'center' } }, cells);
}
function _ceTierStepper(charId: string, axis: string, label: string, tier: number): any {
    // [v2.139.0 STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): this sizes
    // the +/- stepper button glyph, not a heading.
    var stepStyle = {
        width: '32px', height: '32px', fontSize: '15px', lineHeight: '1', color: 'inherit',
        background: 'transparent', border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
        cursor: 'pointer', flex: '0 0 auto'
    };
    function bump(d: number) {
        ceAction('tier:' + charId + ':' + axis, function() {
            return ceProfileSetTier(charId, axis, tier + d);
        });
    }
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap } },
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '5px' } },
            h('div', { style: { display: 'flex', fontSize: CE_T.fsSm } },
                h('div', { style: { flex: '1 1 auto', letterSpacing: '0.06em', textTransform: 'uppercase', opacity: '0.58' } }, label),
                h('div', { style: { opacity: '0.74' } }, (tier > 0 ? '+' : '') + tier)
            ),
            _ceTierBar(axis, tier, true),
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                axis === 'hook' ? '0 to +4' : '\u22124 progress \u00b7 +4 friction')
        ),
        h('button', { onClick: function() { ceTap('step:' + axis + ':dn', function() { bump(-1); }); }, style: stepStyle }, '\u2212'),
        h('button', { onClick: function() { ceTap('step:' + axis + ':up', function() { bump(1); }); }, style: stepStyle }, '+')
    );
}
// -- Axis thought history -----------------------------------------------------
// [v2.157.0 PROFILE-THOUGHT-HIST] Read-only trail under a pressure axis -- the same
// evidence the tier arithmetic consumed, so a flat tier reads as more than a number
// that moved for no visible reason. `list` is either hookNotes (bare phrases) or a
// pursuitHist/positionHist entry ({state, note}) from _ceReadProfileTiers. Renders
// nothing when empty rather than an empty heading -- same rule ceHeader follows.
function _ceAxisHistory(list: any[]): any {
    if (!list || !list.length) return null;
    var rows: any[] = [];
    for (var i = 0; i < list.length; i++) {
        var it: any = list[i];
        var line = (typeof it === 'string') ? it : (it.note || '');
        if (it && it.state) { line = '[' + it.state + '] ' + line; }
        if (!line) continue;
        rows.push(h('div', { key: 'axhist_' + i,
            style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: CE_T.lhProse } },
            '\u2022 ' + line));
    }
    if (!rows.length) return null;
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: '2px' } }, rows);
}

function _ceProfilePressure(charId: string, tiers: any, open: boolean): any {
    if (!tiers) return null;
    function mini(label: string, axis: string, tier: number) {
        return h('div', { style: { flex: '1 1 0', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '3px' } },
            h('div', { style: { display: 'flex', gap: CE_T.s1, fontSize: CE_T.fsSm, opacity: '0.58' } },
                h('div', { style: { flex: '1 1 auto', letterSpacing: '0.06em', textTransform: 'uppercase',
                    overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, label),
                h('div', null, (tier > 0 ? '+' : '') + tier)
            ),
            _ceTierBar(axis, tier, false)
        );
    }
    var level = 'calm';
    if (tiers.hook >= 4 || tiers.pursuit >= 4 || (tiers.hasPosition && tiers.position >= 4)) { level = 'ask'; }
    else if (Math.abs(tiers.hook) >= 2 || Math.abs(tiers.pursuit) >= 2 || (tiers.hasPosition && Math.abs(tiers.position) >= 2)) { level = 'building'; }

    var head = h('div', {
        onClick: function() { ceTap('acc:pressure', function() { ceToggleOpen('pressure'); }); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, cursor: 'pointer', padding: CE_T.s3 + ' 0' }
    },
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', gap: CE_T.s3 } },
            mini('Hook', 'hook', tiers.hook),
            mini('Pursuit', 'pursuit', tiers.pursuit),
            tiers.hasPosition ? mini(tiers.targetName, 'position', tiers.position) : null
        ),
        ceDot(level)
    );
    if (!open) return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } }, head);
    return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } }, head,
        h('div', { style: { paddingBottom: CE_T.s3, display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            _ceTierStepper(charId, 'hook', 'Hook', tiers.hook),
            _ceAxisHistory(tiers.hookNotes),
            _ceTierStepper(charId, 'pursuit', 'Pursuit', tiers.pursuit),
            _ceAxisHistory(tiers.pursuitHist),
            tiers.hasPosition ? _ceTierStepper(charId, 'position', 'With ' + tiers.targetName, tiers.position) : null,
            tiers.hasPosition ? _ceAxisHistory(tiers.positionHist) : null
        )
    );
}

// -- Portrait anchor ---------------------------------------------------------
// [v2.111.0 PROFILE-IMG-ANCHOR] The engine does not and will not carry image bytes.
// It carries an ANCHOR the bridge paints onto — the same arrangement chat avatars
// already run in production (AE_CHARCHAT_AVA_SENTINEL, engine ~3065): the engine emits
// a sentinel string, the bridge finds it and floats the real image over it. This is the
// profile-surface member of that family.
//
// FLAG-DAY LITERAL, same rule as the other two: this string is duplicated in the bridge
// as a plain literal (the two files share no module). Change it in one place only and
// portraits silently stop binding, with no error anywhere.
//
// Payload is 'charId|slot' where slot is one of the three ratios settled in design:
//   portrait  832x1216 (2:3)   avatar  1024x1024 (1:1)   scene  1216x832 (3:2)
// The frame element carries the target box; the bridge is responsible for the
// arithmetic cover-crop, because the bridge has real DOM and can read intrinsic
// dimensions, and because object-fit is still unverified in this sandbox.
//
// [v2.117.0 DEAD, v2.119.0 CE-IMG-ATTR moved to SECTION 28 (kit-level, Scene needs it
// too) — superseded and by bridge v2.95.0 CESURF-IMGPAINT, the half that was never built.
// Zero callers. Retained un-deleted only because deletion in this project is a single
// end-of-migration sweep, never piecemeal.]
const AE_PROFILE_IMG_SENTINEL = 'ce-profimg:';

// -- Hero --------------------------------------------------------------------
// Identity, the three state chips, and the portrait frame. Active is NOT here:
// it is a rarely-touched master switch and lives in the settings drill. Follow
// camera takes that slot because it is the one that gets flipped mid-scene.
// -- Conditions drill  [v2.151.0 PHASE-COND] ----------------------------------
// The 'conditions' launcher has read has:false with no renderer since v2.109.0. It is not
// on surface_list -- per user, it was simply forgotten -- and this is it.
//
// THE SYSTEM HAS TWO HALVES AND ONLY ONE OF THEM WAS MISSING. The DEFINITIONS
// (cfg.conditions: name + ordered stages) have had a full jsx editor since v2.132.0, in
// Settings > World, which is the right home for them: a condition is world vocabulary, not
// a property of one character. What had no engine-side jsx surface was the PER-CHARACTER
// half -- which of those conditions are live on this person, and how far along. That is
// all this drill does, and it is why the empty state sends the author to Settings rather
// than offering to define one here: two editors for one list is the bug the whole collapse
// exists to remove.
//
// STAGES ARE A ceSelect, NOT THE NATIVE'S ◀/▶ STEPPER, and the change is deliberate. The
// stage strings are PROSE ('Stumbling, loud, uninhibited.'), so a stepper can only show
// one of them at a time and forces N taps to reach the last; the native used arrows
// because it had nothing better. A short ordered closed set is exactly what CE-STYLE SS8
// reserves ceSelect for, it is hook-free so it is legal inside this loop, and it shows the
// author every severity they are choosing between at once.
//
// THE PREVIEW IS THE REAL LINE. conds.lines comes from buildConditionLine at publish time
// -- the same function buildDynamicCharacterBlock calls -- so what is shown here is what
// is injected, not a rendering of it. And when the channel is switched off
// (cfg.lorebookFields.conditions === false) THAT IS SAID, because a preview with no
// caveat over a disabled channel is worse than no preview at all.
function _ceProfileCondDrill(charId: string, p: any, cfg: any, cd: any): any {
    var defs: any[] = (cfg && cfg.conditions) || [];
    var st: any = cd || { active: [], lines: [], injects: true };
    var active: any[] = st.active || [];

    if (!defs.length) {
        return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
                'No conditions exist in this world yet. They are defined once and then '
                + 'switched on per character \u2014 drunk, wounded, pregnant, hunted \u2014 so the '
                + 'list lives in Settings rather than here.'),
            ceBtn('Define conditions', 'cond:tosettings:' + charId, function() {
                ceNav('settings', '', 'settings:world',
                      { surface: 'profile', entityId: charId, label: p.name || 'Profile' });
                return Promise.resolve();
            }, 'primary')
        );
    }

    var byDef: any = {};
    var ai = 0;
    for (ai = 0; ai < active.length; ai++) {
        if (active[ai]) { byDef[String(active[ai].defId)] = Number(active[ai].stageIndex) || 0; }
    }

    var rows: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        rows.push((function(def: any) {
            var did = String(def.id || '');
            var on = Object.prototype.hasOwnProperty.call(byDef, did);
            var stages: any[] = def.stages || [];
            // Clamped for DISPLAY as well as at the write: a def whose stage list was cut
            // back in Settings leaves live characters holding an index past its end.
            var cur = on ? Math.max(0, Math.min(stages.length - 1, byDef[did])) : 0;
            var opts: any[] = [];
            for (var s = 0; s < stages.length; s++) {
                opts.push({ id: String(s), label: (s + 1) + '. ' + String(stages[s] || '') });
            }
            return h('div', {
                key: 'cond_' + did,
                style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2,
                         padding: CE_T.s2 + ' 0', borderBottom: '1px solid ' + CE_LINE }
            },
                h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2,
                                    minHeight: CE_T.tap } },
                    h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                        h('div', { style: { fontSize: CE_T.fs } }, def.name || 'Unnamed'),
                        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3 } },
                            stages.length
                                ? (stages.length + ' stage' + (stages.length === 1 ? '' : 's'))
                                : 'On/off only')
                    ),
                    ceToggle(on, 'cond:on:' + charId + ':' + did, function() {
                        return ceProfileCondSet(charId, did, !on);
                    }, (on ? 'Clear ' : 'Set ') + (def.name || 'this condition'))
                ),
                // Only when it is BOTH on and graded. An on/off condition has no severity to
                // choose and an inactive one has nothing to apply it to.
                (on && stages.length)
                    ? ceSelect({
                        k: 'cond:stage:' + charId + ':' + did,
                        value: String(cur), options: opts,
                        onCommit: function(v: string) {
                            return ceProfileCondStage(charId, did, Number(v) || 0);
                        }
                      })
                    : null
            );
        })(defs[i]));
    }

    var kids: any[] = [
        ceGroup('Conditions (' + active.length + ' active)',
            h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows))
    ];

    if (!st.injects) {
        kids.push(h('div', { key: 'cond_off', style: {
            fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse,
            paddingLeft: CE_T.s3, borderLeft: '2px solid ' + CE_LINE2
        } }, 'Conditions are switched off in Settings \u2014 nothing below reaches the model '
           + 'until that is turned back on.'));
    }

    if ((st.lines || []).length) {
        var lineNodes: any[] = [];
        for (var li = 0; li < st.lines.length; li++) {
            lineNodes.push(h('div', { key: 'cl' + li, style: {
                fontSize: CE_T.fsSm, opacity: st.injects ? CE_OP.t2 : CE_OP.t3,
                fontStyle: 'italic', lineHeight: CE_T.lhProse
            } }, st.lines[li]));
        }
        kids.push(ceGroup('What the model reads',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } }, lineNodes)));
    }

    kids.push(h('div', { key: 'cond_note', style: {
        fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse
    } }, 'Any number can be active at once. They ride a temporary lorebook entry rebuilt '
       + 'every generation, not the Author\u2019s Note, so switching one off takes effect '
       + 'on the next turn with nothing to clean up. The wording of the line itself is a '
       + 'template in Settings.'));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Equipment drill  [v2.150.0 PHASE-F] --------------------------------------
// CE-ROADMAP v0.2 Phase F, closing surface_list lines 19-22. Line 23 (the item entity
// edit modal) was E's and is already SECTION 36, which is why every row here is a door to
// it rather than a second item editor.
//
// TWO STATES PER ITEM AND THEY ARE NOT THE SAME STATE. CARRIED is a graph fact (the item's
// parentId is this character's body) and is what the list membership means. WORN is
// char.equippedItemIds and is what the toggle means. The native sheet has always drawn it
// this way; the mistake worth naming is treating the toggle as removal, which it is not --
// unequipping leaves the thing in their hands.
//
// NO "DROP" VERB, ON PURPOSE. Taking an item OUT of someone's hands is a reparent, and
// reparenting has one editor already: the Entity surface's own Placement picker, which
// every row here taps through to. A second control for the same write, on a surface that
// does not show the destination tree, is how two answers to one question start.
//
// THE ROW IS SIBLINGS, NOT A TAPPABLE CARD, for the reason SS8 gives and the scene roster
// settled: it holds two targets (open the item; wear it), and one ceTap around both would
// fire both handlers on a single physical tap.
//
// LEAVING FOR THE ITEM DOES NOT CLOSE THIS DRILL, and that is deliberate rather than
// incidental: ceNav patches surface/entityId/back and never touches profileDrill, so the
// Entity surface's Back lands here again instead of on the profile root. Equipping a
// character is a loop -- open a thing, read it, come back, wear it -- and the alternative
// costs a tap on every pass through it.
function _ceProfileEquipDrill(charId: string, p: any, eq: any): any {
    var backAddr: any = { surface: 'profile', entityId: charId, label: p.name || 'Profile' };
    var e: any = eq || {};

    if (!e.bodyOk) {
        // STATED, NOT DIMMED (SS4's disabled rule): the reason is on screen and the repair
        // is one tap, because "no body entity" is not a thing an author did wrong.
        return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
                (p.name || 'This character') + ' has no physical body in the world yet, so there is '
                + 'nothing for an item to be inside. Everything else about them works; only '
                + 'carrying does not.'),
            ceBtn('Give them a body', 'eq:body:' + charId, function() {
                return ceProfileEnsureBody(charId);
            }, 'primary')
        );
    }

    var carried: any[] = e.carried || [];
    var rows: any[] = [];
    var wornCount = 0;
    for (var i = 0; i < carried.length; i++) {
        if (carried[i] && carried[i].worn) wornCount++;
        rows.push((function(it: any) {
            var worn = !!it.worn;
            return h('div', {
                key: 'eq_' + it.id,
                style: {
                    display: 'flex', alignItems: 'center', gap: CE_T.s2,
                    minHeight: CE_T.tap, padding: CE_T.s2 + ' 0',
                    borderBottom: '1px solid ' + CE_LINE
                }
            },
                h('div', {
                    onClick: function() {
                        ceTap('eq:open:' + it.id, function() {
                            ceNav('entity', it.id, '', backAddr);
                        });
                    },
                    style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                             alignItems: 'center', gap: CE_T.s2, cursor: 'pointer' }
                },
                    it.icon ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fs } }, it.icon) : null,
                    h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                        h('div', { style: { fontSize: CE_T.fs, overflow: 'hidden',
                                            textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, it.name),
                        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3 } },
                            worn ? 'Worn' : 'Carried')
                    )
                ),
                ceToggle(worn, 'eq:worn:' + charId + ':' + it.id, function() {
                    return ceProfileEquipSet(charId, it.id, !worn);
                }, (worn ? 'Take off ' : 'Put on ') + it.name)
            );
        })(carried[i]));
    }

    var listNode: any = rows.length
        ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows)
        : ceEmpty('Carrying nothing.', null);

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        ceGroup('Carried (' + carried.length + (wornCount ? (', ' + wornCount + ' worn') : '') + ')',
            listNode),
        h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
            ceBtn('Add an item', 'eq:add:' + charId, function() {
                cePickerOpen('equipAdd', { charId: charId });
                return Promise.resolve();
            }),
            // Creation lands ON the new record (Phase E's premise), parented straight into
            // the body -- so the item is already carried by the time its editor opens and
            // there is no second trip to file it.
            ceBtn('New item', 'eq:new:' + charId, function() {
                return ceEntityCreate('item', String(e.entityId || ''), backAddr);
            }, 'primary')
        ),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Worn items are the ones the story and the image prompt know about. '
            + 'To put something down, open it and change what it is inside.')
    );
}

function _ceProfileHero(p: any, charId: string): any {
    var sub: string[] = [];
    if (p.occupationRole) sub.push(p.occupationRole);
    if (p.age) sub.push(p.age);
    var idb: string[] = [];
    if (p.species) idb.push(p.species);
    if (p.gender) idb.push(p.gender);
    var flags = p.flags || {};

    function chip(label: string, on: boolean, key: string, next: any) {
        return h('div', {
            onClick: function() {
                ceTap('flag:' + charId + ':' + key, function() {
                    ceAction('flag:' + charId + ':' + key, function() { return ceProfileWrite(charId, key, next); });
                });
            },
            style: {
                display: 'inline-flex', alignItems: 'center', minHeight: '26px', padding: '0 ' + CE_T.s2,
                fontSize: CE_T.fsKey, letterSpacing: '0.06em', textTransform: 'uppercase', cursor: 'pointer',
                borderRadius: CE_T.r, border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
                background: on ? CE_FILL : 'transparent', opacity: on ? '1' : '0.58'
            }
        }, label);
    }

    return h('div', { style: { display: 'flex', gap: CE_T.s4, alignItems: 'flex-start', paddingBottom: CE_T.s3 } },
        // [v2.117.0 CE-IMG-ATTR] The frame IS the anchor. The '+' is the empty state and
        // stays in the tree: the bridge paints an absolutely-positioned <img> OVER it when
        // the Avatar slot has an image and leaves it alone when it does not, so "no
        // portrait yet" needs no second branch on either side.
        // [v2.152.0 HERO-DIM-FIX, per user report "avatar is dim/faint/transparent"] The
        // frame's own style carried opacity:'0.58' alongside its background/border. CSS
        // opacity applies to the whole subtree, and the bridge paints its <img> as a CHILD
        // of this exact node -- so every real portrait rendered at 58% opacity too, not
        // just the '+' it was written for. Moved onto the glyph's own div, which is what
        // every other avatar frame in this file already does (Images grid, Scene roster).
        h('div', ceImgAnchor(charId, CE_IMG_SLOT_AVATAR, {
            onClick: function() { ceTap('drill:images', function() { _ceProfileDrill('images', 0); }); },
            style: {
                flex: '0 0 auto', width: '84px', height: '126px', borderRadius: CE_T.r,
                background: CE_FILL, cursor: 'pointer', position: 'relative', overflow: 'hidden',
                display: 'flex', alignItems: 'center', justifyContent: 'center'
            }
        }),
            // [v2.139.0 STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): this
            // sizes the '+' empty-avatar placeholder glyph, not a heading.
            h('div', { style: { fontSize: '20px', opacity: '0.58' } }, '+')
        ),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '6px' } },
            h('div', {
                onClick: function() { ceTap('drill:identity', function() { _ceProfileDrill('identity', 0); }); },
                style: { cursor: 'pointer', display: 'flex', flexDirection: 'column', gap: '4px' }
            },
                ceH1((p.name || 'Unnamed') + (p.isProtagonist ? ' (you)' : '')),
                sub.length ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, sub.join(' \u00b7 ')) : null,
                idb.length ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, idb.join(' \u00b7 ')) : null
            ),
            h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s1, paddingTop: CE_T.s1 } },
                chip('Follow', !!flags.followCamera, 'flag.followCamera', !flags.followCamera),
                // [v2.173.0 DEAD-DYNAMIC] THIS CHIP WAS BOUND TO A FLAG NOTHING READS.
                // charContextEnabled is declared on CharacterRecord, defaulted, migrated,
                // serialized to the bridge and settable from two places -- and there is NOT
                // ONE dispatch condition, context builder or generator anywhere in this file
                // that reads it. Grep it: decl, default, migration, payload, setter, and
                // these two controls. Toggling Dynamic/Static did nothing at all, silently,
                // for as long as the chip has existed.
                //
                // REPOINTED TO autoThoughtsEnabled, which is the flag that already does
                // everything Dynamic/Static was believed to do, on both sides:
                //   GENERATION -- it gates generateEphemeral (the dispatch condition and the
                //     retry-queue branch), and generateEphemeral is what applies PURSUIT and
                //     POSITION pressure off its own reply. Off means those two axes stop
                //     moving; Hook is unaffected, since hooksEnabled gates that separately.
                //   INJECTION -- `if (!char.autoThoughtsEnabled) npcData.ephemeral = null`,
                //     which is what makes the trace read SKIP(thoughts-off). So a stale
                //     snapshot cannot sit in context behind a switched-off character.
                // Both halves were already correct and already wired. The only thing wrong
                // was which flag the visible switch moved.
                //
                // charContextEnabled IS NOW A CONFIRMED ORPHAN. It is left on the record --
                // it is persisted shape and dropping it would rewrite every stored character
                // for nothing -- but it has no control and no reader. Do not add one back
                // without deciding what the second gate would be for.
                chip(flags.autoThoughtsEnabled ? 'Thoughts on' : 'Thoughts off', !!flags.autoThoughtsEnabled,
                     'flag.autoThoughtsEnabled', !flags.autoThoughtsEnabled),
                chip(flags.hooksEnabled ? 'Hooks on' : 'Hooks off', !!flags.hooksEnabled,
                     'flag.hooksEnabled', !flags.hooksEnabled)
            )
        )
    );
}

// -- Launcher grid -----------------------------------------------------------
// [v2.111.0 LAUNCHER-QUIET, per user] Was a 2x3 block of 42px filled cells that read as
// the loudest element on a surface where it is the least important — six doors, none of
// which is where the work happens. Now one wrapping row of quiet text links. Having
// content still shows as weight rather than a badge (there is still no color token to
// spend on state), but the whole strip sits at label scale instead of button scale.
// [v2.131.0 POV-REMEMBERED] Takes `cfg` now, for one cell only: Chat reads the remembered
// pov out of it so a tap can start the thread instead of asking a question this surface
// already knows the answer to.
function _ceProfileLaunchers(p: any, cfg: any, eq: any, cd: any, shape: string): any {
    var cells: any[] = [
        // [v2.152.0 PROFILE-WALKTHROUGH, per user "the button that opened profile
        // walkthrough is gone"] It never left -- the guided build's only door (the
        // Continue bar) is CONDITIONAL on an unanswered step, so it disappears the moment
        // a build is finished, with nothing left to reopen it from. This is that door,
        // permanent, in the launcher row rather than an inline bar that can vanish.
        // Studio shape ONLY: _ceProfileBuild renders CE_FIELD_GROUP_ORDER slot cards and
        // patterns, which classic-shape characters do not have.
        (shape === 'studio')
            ? { id: 'build', label: 'Walkthrough', has: true, build: true }
            : null,
        // [v2.119.0] `has` flips false -> true on the SAME rule Settings already uses, not a
        // new one: this cell used to be false because "no engine-side renderer yet" (see
        // equipment/conditions below, still true for that reason). It now HAS a real
        // renderer -- _ceProfileImagesDrill always shows the full 26-slot grid -- so it is
        // unconditional the same way Settings is, not a data check. It CANNOT be a data
        // check: whether any slot is actually filled lives in the bridge's IndexedDB, not
        // here, and the withdrawn IMAGE-INDEX entry in the index is the record of why this
        // file must not try to mirror that to answer the question.
        { id: 'images', label: 'Images', has: true },
        // [v2.114.0 JSXJOURNAL] `nav` makes this cell a route rather than a drill. The
        // journal is reachable from Scene too and carries its own scope, so it cannot be
        // a value on profileDrill without two places owning which journal is showing.
        { id: 'journal', label: 'Journal', has: true, nav: 'journal' },
        // [v2.131.0 POV-REMEMBERED, per user] Chat is a ONE-TAP START, not a drill and not
        // a trip through the Chat surface. The pov is remembered (cfg.charChatPovId), so
        // there is nothing left to ask: this goes straight to the thread for (this
        // character, that pov) and startCharChat resolves start-vs-resume itself from the
        // deterministic entry id. `has` is now whether texting is POSSIBLE rather than
        // whether a chatPersona was authored -- the engine has never required one to text
        // someone, so the old condition was dimming a door that always worked.
        { id: 'chat', label: 'Chat', has: true, chat: true },
        // [v2.150.0 PHASE-F] `has` IS A REAL DATA CHECK HERE, unlike Images. Whether a
        // character is carrying anything is engine-known -- it is the entity graph -- so
        // this is the ladder's has/has-not doing the job it was described as doing, not a
        // stand-in for "a renderer exists". A body-less character reads has:false too,
        // which is honest: there is nothing there, and the drill says why.
        { id: 'equipment', label: 'Equipment', has: !!(eq && eq.carried && eq.carried.length) },
        // [v2.151.0 PHASE-COND] Real data check, same as Equipment's: whether anything
        // is live on this character is a field on the record. A world with no condition
        // DEFS also reads has:false, which is honest -- the drill then explains that and
        // points at Settings.
        { id: 'conditions', label: 'Conditions', has: !!(cd && cd.active && cd.active.length) },
        { id: 'settings', label: 'Settings', has: true }
    ];
    var kids: any[] = [];
    for (var i = 0; i < cells.length; i++) {
        if (!cells[i]) continue;
        kids.push((function(c: any) {
            return h('div', {
                onClick: function() {
                    ceTap('drill:' + c.id, function() {
                        if (c.build) {
                            _ceProfileDrill('build', 0);
                        } else if (c.chat) {
                            // ceAction, not a bare call: starting a chat writes the document
                            // and handlers double-fire (JSX-PROBE-RESULTS 1), so without the
                            // in-flight latch one tap appends two markers.
                            ceAction('profile:chat:' + String(p.id || ''), function() {
                                return startCharChat(String(p.id || ''), ceChatSavedPov(cfg, String(p.id || '')))
                                    .then(function() {
                                        // Hand off to the story document, same as the Chat
                                        // surface's own contact rows: the conversation lives
                                        // in the story on native Send, never in a modal.
                                        try {
                                            if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); }
                                        } catch (_eClP) {}
                                    });
                            });
                        } else if (c.nav) {
                            ceNav(String(c.nav), String(p.id || ''), '',
                                  { surface: 'profile', entityId: String(p.id || ''),
                                    label: p.name || 'Profile' });
                        } else { _ceProfileDrill(c.id, 0); }
                    });
                },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fsSm, letterSpacing: '0.04em',
                    // Ladder: these are labels ABOUT content, so a group holding
                    // something sits at t2 and an empty one at t3 -- presence is the
                    // difference between two tiers of equal importance, which is exactly
                    // what SS4 says opacity is still allowed to express.
                    padding: CE_T.s1 + ' 0', opacity: c.has ? CE_OP.t2 : CE_OP.t3,
                    borderBottom: '1px solid ' + (c.has ? CE_LINE2 : CE_LINE)
                }
            }, c.label);
        })(cells[i]));
    }
    return h('div', { style: {
        display: 'flex', flexWrap: 'wrap', gap: CE_T.s4,
        padding: CE_T.s3 + ' 0', borderBottom: '1px solid ' + CE_LINE
    } }, kids);
}

// -- Classic character sheet -------------------------------------------------
// [v2.111.0 SHEET-GEN, per user] The five static fields, each with a Generate button
// that fills from the concept dump. Instruction and budget resolution is cfg-override-
// else-def, the same order the AE_GENERATE_SLOT handler uses — not a second policy.
var CE_SHEET_FIELDS: any[] = [
    { k: 'physicalDescription', label: 'Physical Description' },
    { k: 'personalityCore', label: 'Personality Core' },
    { k: 'voiceAndMannerisms', label: 'Voice & Mannerisms' },
    { k: 'background', label: 'Background' }
];
function _ceSheetDef(key: string): any {
    for (var i = 0; i < STATIC_FIELD_DEFS.length; i++) {
        if (STATIC_FIELD_DEFS[i].key === key) return STATIC_FIELD_DEFS[i];
    }
    return null;
}
// [v2.163.0 DRIVE-IN-CLASSIC, per user] The two pattern-INDEPENDENT slots now live on the
// classic sheet. This is the whole reason the two shapes stopped being rivals.
//
// generateEphemeral reads ce_slot_core and ce_slot_pursuit by id, and pursuitState -- the
// classification that moves the pursuit tier, which is what _ceFrameIntent escalates on --
// is gated on ce_slot_pursuit existing at all. A sheet-only character therefore still
// THINKS (personalityCore, voiceAndMannerisms, position and story all still reach the beat
// prompt) but never escalates from wanting to acting, because the axis has nothing to
// classify. Two fields close that, and neither of them needs a pattern chosen.
//
// Presence is deliberately NOT here: it is a restatement of Physical Description and would
// be the one duplicated field on a surface whose entire redesign was about not showing the
// same writing twice.
var CE_DRIVE_SLOTS: string[] = ['ce_slot_core', 'ce_slot_pursuit'];
function _ceCustomById(p: any, id: string): any {
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && String(list[i].id || '') === id) return list[i];
    }
    return null;
}

// [v2.163.0 CONDENSED, per user: "the classic sheet shouldn't be one collapsed sheet"] Was
// a single ceAccordion holding all five fields, so reaching Background meant one tap and a
// scroll past everything above it. Now two ceSections, everything on screen, each field a
// guide bar + textarea + generator. Read density, per CE-STYLE SS7.1: this is prose the
// author wrote, and the writing is the interface.
// [v2.164.0 SHEET-BLOCK] Extracted from _ceProfileClassic so Profile Plus can render a
// sheet field too. `background` is the case that forced it: the history group is SLOTLESS
// (BUILTIN_FACETS defines no slot for it) and its facets self-suppress while empty, so the
// Background section in Plus was a heading with nothing under it -- while the record's own
// `background` prose, which every context builder already reads, sat unreachable on the
// other shape. Record prose is shape-independent; only the SLOT model is Plus-only.
function _ceSheetFieldBlock(charId: string, p: any, cfg: any, fd: any): any {
    var def = _ceSheetDef(fd.k);
    var inst = (cfg && cfg.fieldInstructions && cfg.fieldInstructions[fd.k])
        || (def ? def.defaultInstructions : '');
    var budget = (cfg && cfg.fieldBudgets && cfg.fieldBudgets[fd.k])
        || (def ? def.defaultBudget : 150);
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        _ceGuideBar(fd.label, inst),
        _ceGuide(inst, true),
        h(ceField, {
            key: 'sheet_' + fd.k, k: 'sheet:' + charId + ':' + fd.k,
            label: '', value: p[fd.k] || '', multiline: true, rows: 4,
            placeholder: def ? def.placeholder : '',
            onCommit: function(v: string) { return ceProfileWrite(charId, fd.k, v); }
        }),
        _ceGenBtn(p, charId, fd.k, fd.label, inst, budget)
    );
}
function _ceSheetFieldByKey(key: string): any {
    for (var i = 0; i < CE_SHEET_FIELDS.length; i++) {
        if (CE_SHEET_FIELDS[i].k === key) return CE_SHEET_FIELDS[i];
    }
    return null;
}
function _ceProfileClassic(charId: string, p: any, cfg: any): any {
    var sheetKids: any[] = [];
    var i = 0;
    for (i = 0; i < CE_SHEET_FIELDS.length; i++) {
        sheetKids.push(_ceSheetFieldBlock(charId, p, cfg, CE_SHEET_FIELDS[i]));
    }
    sheetKids.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        ceKey('Core Values'),
        h(ceField, {
            key: 'sheet_coreValues', k: 'sheet:' + charId + ':coreValues',
            label: '', value: (p.coreValues || []).join('\n'), multiline: true, rows: 3,
            placeholder: 'One value per line\u2026',
            onCommit: function(v: string) {
                return ceProfileWrite(charId, 'coreValues',
                    String(v || '').split('\n').map(function(s2: string) { return s2.trim(); })
                        .filter(function(s2: string) { return !!s2; }));
            }
        })
    ));

    var driveKids: any[] = [];
    driveKids.push(h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
        lineHeight: CE_T.lhProse } },
        'The two lines the per-beat pass reads. Without them a character still thinks \u2014 '
        + 'their intent just never escalates from wanting to acting.'));
    for (i = 0; i < CE_DRIVE_SLOTS.length; i++) {
        var df = _ceCustomById(p, CE_DRIVE_SLOTS[i]);
        if (df) driveKids.push(_ceSlotCard(charId, p, cfg, df, '', ''));
    }

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s5 } },
        ceSection('The sheet', h('div', { style: { display: 'flex', flexDirection: 'column',
            gap: CE_T.s4 } }, sheetKids)),
        (driveKids.length > 1)
            ? ceSection('Drive', h('div', { style: { display: 'flex', flexDirection: 'column',
                gap: CE_T.s4 } }, driveKids))
            : null
    );
}

// [v2.163.0 SHAPE-TOGGLE, per user] The shape switch moves OUT of the Settings drill and
// onto the profile, above the field column.
//
// It was buried because switching used to be a COMMITMENT: the two shapes were mutually
// exclusive renderings, so whichever was inactive rendered nothing and a wrong choice
// looked like data loss. That is what v2.162.0's _ceShapeStrandedNote existed to warn
// about, and that note is DELETED here rather than fixed -- its slot count was correct,
// it was the exclusivity underneath it that was wrong. Classic now carries Core and
// Pursuit, so Profile Plus is strictly ADDITIVE (Presence, Pattern, and the pattern-gated
// Resistance/Conduct pair) and switching can no longer hide written work.
//
// PER-CHARACTER, per user. uiShape already lives on the record; this introduces no second
// home for it and no global default to fall out of step with.
function _ceShapeToggle(charId: string, shape: string): any {
    var defs: any[] = [
        { id: 'classic', label: 'Classic' },
        { id: 'studio',  label: 'Profile Plus' }
    ];
    var kids: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        kids.push((function(o: any) {
            var on = (shape === o.id);
            return ceBtn(o.label, 'shape:' + charId + ':' + o.id, function() {
                if (on) return Promise.resolve();
                return ceProfileWrite(charId, 'uiShape', o.id);
            }, on ? 'primary' : '');
        })(defs[i]));
    }
    return h('div', { style: {
        display: 'flex', alignItems: 'center', gap: CE_T.s2, flexWrap: 'wrap',
        padding: CE_T.s3 + ' 0', borderBottom: '1px solid ' + CE_LINE
    } },
        h('div', { style: { flex: '1 1 auto', minWidth: '0' } }, ceKey('Profile')),
        h('div', { style: { flex: '0 0 auto', display: 'flex', gap: CE_T.s2 } }, kids)
    );
}

// [v2.113.0 PERSONA-WIRED] Split out rather than inlined so the loop is obvious and so a
// fourth axis is one array entry. Labels are the user's words, not the storage keys: the
// stored sub-key is `verbosity` and the row says Length, because nothing on this surface
// should make someone learn a field name to use it.
var CE_PERSONA_AXES: any[] = [
    { sub: 'style',     label: 'Style',  hint: 'How they phrase things.' },
    { sub: 'verbosity', label: 'Length', hint: 'How much they write per message.' },
    { sub: 'emoji',     label: 'Emoji',  hint: '' }
];

function _cePersonaAxisRows(charId: string, persona: any, opts: any): any {
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < CE_PERSONA_AXES.length; i++) {
        var ax: any = CE_PERSONA_AXES[i];
        var list: any[] = opts[ax.sub] || [];
        // An empty option list means the payload did not ship one; render nothing rather
        // than an empty control the user can neither read nor change.
        if (!list.length) continue;
        rows.push(ceSettingRow(ax.label, ax.hint,
            ceSelect({
                k: 'persona:' + charId + ':' + ax.sub,
                value: persona[ax.sub] || 'auto',
                options: list,
                onCommit: (function(sub: string) {
                    return function(v: string) { return ceProfileWrite(charId, 'chatPersona.' + sub, v); };
                })(ax.sub)
            })));
    }
    if (!rows.length) return null;
    return h('div', null, rows);
}

function _ceProfileSettings(charId: string, p: any): any {
    var flags = p.flags || {};
    var persona = p.chatPersona || {};
    var personaOpts = p.chatPersonaOpts || {};

    // [v2.112.0 SETTINGS-REBUILD, per user] Rebuilt on ceH3 / ceSettingRow / ceToggle
    // rather than three locally-invented row shapes. What was wrong, specifically:
    //   - booleans were BUTTONS LABELLED WITH A VERB ("Toggle", "Switch"), so the control
    //     never showed the state and read the same in both directions;
    //   - "Texting persona" was a dim uppercase eyebrow with a row labelled "Persona"
    //     directly beneath it at body size and full brightness, so the subhead outweighed
    //     the head, and the two words said the same thing;
    //   - spacing came from a different gap value in each of the three sections.
    // Every section here is ceSection (which is ceH3) and every line is ceSettingRow, so
    // there is exactly one spacing rule and one hierarchy on this surface. See TYPE-SCALE.
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        // [v2.163.0 SHAPE-TOGGLE] The Authoring group lived here and is gone. The shape
        // switch is now _ceShapeToggle, on the profile itself -- see there for why it no
        // longer needs to be a deliberate, buried decision.
        ceGroup('Behaviour', h('div', null,
            // [v2.173.0 DEAD-DYNAMIC] The 'Context injection' row is GONE, not renamed. It
            // drove charContextEnabled, which nothing reads, and its hint ("off means this
            // character is never injected into context") described behaviour that has never
            // existed. Leaving a switch that lies is worse than having no switch: it is the
            // control someone reaches for when a character is over-injecting, and it would
            // have kept not working. The real gate is the row below. See the chip in
            // _ceProfileHero for the full grep.
            ceSettingRow('Auto thoughts',
                'Generate a per-beat internal state for them as the story runs, and inject it. Off also stops Pursuit and Position pressure from moving, since both are read off the same update, and keeps the last snapshot out of context rather than leaving it there stale.',
                ceToggle(!!flags.autoThoughtsEnabled, 'thoughts:' + charId, function() {
                    return ceProfileWrite(charId, 'flag.autoThoughtsEnabled', !flags.autoThoughtsEnabled);
                })),
            ceSettingRow('Hooks',
                'Let the dynamic engine escalate and spawn their unresolved tensions.',
                ceToggle(!!flags.hooksEnabled, 'hooks:' + charId, function() {
                    return ceProfileWrite(charId, 'flag.hooksEnabled', !flags.hooksEnabled);
                })),
            ceSettingRow('Lorebook entry', '',
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                    p.hasLoreEntry ? 'Linked' : 'Not linked'))
        )),
        // [v2.112.0 PERSONA-TO-SETTINGS] The texting persona is a chat SETTING, matching the
        // call the bridge profile tab already made in v2.93.0 PERSONA-MOVE.
        // [v2.113.0 PERSONA-WIRED] The three enum axes are surfaced now. v2.112.0 left them
        // out because there was no Select primitive to render them with, and that absence
        // was recorded as a preference; it was not one. The payload has carried both the
        // values and the option lists since v2.100.0. They are gated behind Enabled for the
        // same reason the notes field is -- a disabled persona compiles to nothing, so
        // offering three controls that change nothing would be a lie about what is live.
        //
        // The three rows are rendered from an array, which ceSelect permits and ceField does
        // not: ceField calls useRef, so a variable-length loop of them would break hook
        // order. That constraint is why this list is Selects and the notes field below it is
        // a single explicit call.
        ceGroup('Texting persona', h('div', null,
            ceSettingRow('Enabled',
                'Shapes how they write in Character Chat. Off compiles to nothing.',
                ceToggle(!!persona.enabled, 'persona:' + charId, function() {
                    return ceProfileWrite(charId, 'chatPersona.enabled', !persona.enabled);
                })),
            persona.enabled ? _cePersonaAxisRows(charId, persona, personaOpts) : null,
            persona.enabled ? h('div', { style: { paddingTop: CE_T.s3 } },
                h(ceField, {
                    key: 'persona_notes', k: 'persona:' + charId + ':notes',
                    label: '', value: persona.notes || '', multiline: true, rows: 3,
                    placeholder: 'Anything specific about how they text\u2026',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'chatPersona.notes', v); }
                })
            ) : null,
            // The exact clause the model receives, not a re-description of it -- `preview`
            // is buildCharChatPersonaClause's own return value, so this readout cannot drift
            // from what is actually sent. It is the only place on any surface that shows it.
            (persona.enabled && persona.preview) ? h('div', {
                style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.55', paddingTop: CE_T.s2 }
            }, 'Sends: ' + persona.preview) : null
        )),
        // [v2.112.0 CONCEPT-IN-SETTINGS] Raw seed material rather than authored profile
        // content, so it sits here rather than in a group. Every Generate button on this
        // surface reads from it, which is why a character with nothing here has none.
        ceSection('Concept notes', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.55' } },
                'Not injected into the story and not part of the profile. Every Generate button reads from here.'),
            h(ceField, {
                key: 'conceptDump', k: 'concept:' + charId,
                label: '', value: p.conceptDump || '', multiline: true, rows: 6,
                placeholder: 'Anything you know about them, in any order\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'conceptDump', v); }
            })
        ))
    );
}

// -- The guided build --------------------------------------------------------
// [v2.111.0 BUILD-REGROUP, per user] Three changes, all corrections of invented
// structure rather than layout preference:
//
//   1. CORE AND PURSUIT ARE ONE STEP. They are both Drive — ceStaticFieldGroup already
//      maps both slots to the 'drive' group (engine ~9683) and the walk was the only
//      thing splitting them. Two fields, two prompts, one page. Drive counts as answered
//      when CORE is written: the Pursuit instruction explicitly says an empty Pursuit is
//      a complete character, so requiring it would mark finished characters unfinished.
//   2. THE DENOMINATOR IS DERIVED, not the literal 6. It is however many steps carry
//      counted:true, so merging or adding a step cannot leave a stale number behind.
//      Position and Background still mark their rail node without counting, per the
//      bridge Studio's STUDIO-2 UNIT-B rule.
//   3. THE `why` LINES ARE GONE. They were written for the mockup and read as filler.
//      Guidance now comes from the slot's own `instructions` (see _ceGuide) for every
//      step that has a slot. Only the two steps with NO single slot behind them —
//      Pattern and Position — keep a hand-written line, and those are stated in the
//      user's own terms rather than re-derived.
var CE_BUILD_STEPS: any[] = [
    { id: 'presence', group: 'presence', label: 'Presence', counted: true },
    { id: 'drive', group: 'drive', label: 'Drive', counted: true },
    { id: 'pattern', group: '', label: 'Pattern', counted: true,
      q: 'What complicates them?',
      why: 'Not a personality type and not a summary of who they are. This picks HOW the '
         + 'next two steps push against the Core \u2014 by contradicting it, substituting for '
         + 'it, guarding it, ruling it, feeding it, or hiding it. It is the only step that '
         + 'changes the questions that follow.' },
    { id: 'resistance', group: 'resistance', label: 'Resistance', counted: true },
    { id: 'conduct', group: 'conduct', label: 'Conduct', counted: true },
    { id: 'position', group: 'position', label: 'Position', counted: false,
      q: 'Where do they stand with someone who matters?',
      why: 'Optional. Sets the third pressure axis, so it is worth doing if they already '
         + 'have a counterpart in the cast.' },
    { id: 'history', group: 'history', label: 'Background', counted: false }
];
function _ceBuildCounted(): number {
    var n = 0;
    for (var i = 0; i < CE_BUILD_STEPS.length; i++) { if (CE_BUILD_STEPS[i].counted) n = n + 1; }
    return n;
}
function _ceBuildAnswered(p: any, step: any): boolean {
    if (step.id === 'pattern') return !!String(p.pattern || '');
    if (step.id === 'position') return !!String((p.position || {}).targetId || '');
    if (!step.group) return false;
    var patId = String(p.pattern || '');
    var gRows = _ceGroupFields(p, step.group);
    var slots = _ceSlotsFor(gRows, step.group, patId);
    // [v2.112.0 SLOTLESS-STEP] A slotless group (Background) is answered when ANY of its
    // facets is written. Testing slots for a group that has none returned false forever.
    if (!slots.length) {
        if (_ceGatedGroup(step.group)) return false;
        return _ceCountWritten(_ceFacetsFor(gRows)) > 0;
    }
    // Drive holds Core and Pursuit; CORE alone decides. Every other group has one
    // gated slot, so "the first one" and "all of them" are the same test there.
    if (step.id === 'drive') {
        for (var i = 0; i < slots.length; i++) {
            if (String(slots[i].id || '') === 'ce_slot_core') return _ceHasValue(slots[i]);
        }
        return _ceHasValue(slots[0]);
    }
    for (var j = 0; j < slots.length; j++) { if (!_ceHasValue(slots[j])) return false; }
    return true;
}
function _ceBuildProgress(p: any): number {
    var n = 0;
    for (var i = 0; i < CE_BUILD_STEPS.length; i++) {
        if (CE_BUILD_STEPS[i].counted && _ceBuildAnswered(p, CE_BUILD_STEPS[i])) n = n + 1;
    }
    return n;
}

function _ceProfileBuild(charId: string, p: any, cfg: any, roster: any[], idx: number): any {
    var i = Math.max(0, Math.min(CE_BUILD_STEPS.length - 1, Number(idx) || 0));
    var step = CE_BUILD_STEPS[i];
    var patId = String(p.pattern || '');
    var pat = CE_PATTERN_DEFS[patId] || null;
    var rail = (_ceGatedGroup(step.group) && pat) ? pat.c : '';

    var railKids: any[] = [];
    for (var r = 0; r < CE_BUILD_STEPS.length; r++) {
        railKids.push((function(s: any, si: number) {
            var cur = si === i;
            var ans = _ceBuildAnswered(p, s);
            var isPat = s.id === 'pattern';
            return h('div', {
                onClick: function() { ceTap('drill:build:' + si, function() { _ceProfileDrill('build', si); }); },
                style: {
                    flex: '1 1 0', height: isPat ? '6px' : '4px', borderRadius: '3px', cursor: 'pointer',
                    background: cur ? 'currentColor' : (ans ? ((isPat && pat) ? pat.c : CE_LINE2) : CE_LINE)
                }
            });
        })(CE_BUILD_STEPS[r], r));
    }

    // Body. A step with a group renders its gated slot cards plus that group's
    // written facets and its add-more button — the same content the group accordion
    // shows, so the walk and the profile never disagree about what a step contains.
    var body: any[] = [];
    var heading = step.q || '';
    if (step.id === 'pattern') {
        body.push(_cePatternPicker(charId, p, true));
    } else if (step.id === 'position') {
        var posKids = _ceProfilePositionKids(charId, p);
        for (var pk = 0; pk < posKids.length; pk++) { body.push(posKids[pk]); }
    } else if (step.group) {
        var rows = _ceGroupFields(p, step.group);
        var slots = _ceSlotsFor(rows, step.group, patId);
        if (!slots.length && _ceGatedGroup(step.group)) {
            body.push(h('div', { style: { fontSize: CE_T.fs, opacity: '0.74', lineHeight: '1.6' } },
                'Choose a pattern first \u2014 it decides which question this step asks.'));
        }
        // [v2.141.0 STYLE2-E] step.label is the drill's own heading, so it is the
        // duplicate to suppress against here -- same job g.label does in the profile.
        for (var sc = 0; sc < slots.length; sc++) { body.push(_ceSlotCard(charId, p, cfg, slots[sc], rail, step.label)); }
        var facets = _ceFacetsFor(rows);
        var written: any[] = [];
        for (var fw = 0; fw < facets.length; fw++) { if (_ceHasValue(facets[fw])) written.push(facets[fw]); }
        for (var fx = 0; fx < written.length; fx++) { body.push(_ceFacetField(charId, p, cfg, written[fx])); }
        // [v2.112.0 SLOTLESS-STEP, per user] Background rendered an EMPTY step with nothing
        // to type into. Not every group has a slot: BUILTIN_FACETS defines slots for
        // presence/core/pursuit and the twelve pattern variants only, so history (Background)
        // and position own FACETS ALONE. The old body showed written facets and hid the rest
        // behind an add button, which for a slotless group means a brand-new character sees
        // a step with no field at all. When a group has no slot, its facets ARE the step and
        // all of them render open.
        if (!slots.length && !_ceGatedGroup(step.group)) {
            for (var fu = 0; fu < facets.length; fu++) {
                if (_ceHasValue(facets[fu])) continue;
                body.push(_ceFacetField(charId, p, cfg, facets[fu]));
            }
        } else {
            var left = facets.length - written.length;
            if (left > 0) {
                body.push(ceBtn('Add a ' + step.label + ' facet (' + left + ' available)',
                    'bfacet:' + charId + ':' + step.group, function() {
                        _ceProfileDrill('addfacet:' + step.group, 0);
                        return Promise.resolve();
                    }));
            }
        }
        if (!heading) { heading = step.label; }
    }

    // [v2.111.0, per user] Next/Back at the BOTTOM. They were at the bottom of the
    // step body already, but above the facets and the add button, so on any step with
    // content they sat in the middle of the page. They are now the last thing in the
    // column, unconditionally.
    var nav: any[] = [];
    if (i > 0) {
        nav.push(ceBtn('\u2190 Back', 'build:back:' + i, function() {
            _ceProfileDrill('build', i - 1); return Promise.resolve();
        }));
    }
    if (i < CE_BUILD_STEPS.length - 1) {
        nav.push(ceBtn('Next \u2192', 'build:next:' + i, function() {
            _ceProfileDrill('build', i + 1); return Promise.resolve();
        }, 'primary'));
    } else {
        nav.push(ceBtn('Done', 'build:done', function() {
            _ceProfileDrill('', 0); return Promise.resolve();
        }, 'primary'));
    }

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { style: { display: 'flex', gap: '3px', alignItems: 'center', paddingBottom: CE_T.s2 } }, railKids),
        // [v2.113.1 TYPE-AUDIT] Was a hand-written eyebrow at fsXs/0.45 with a 17px/600
        // heading under it -- a FIFTH type level, invented by accident, sitting one line
        // above an eyebrow that did not match the kit's own (fsSm/0.55). Both now route
        // through the scale. See CE-STYLE v1 section 6.
        ceH3('Step ' + (i + 1) + ' of ' + CE_BUILD_STEPS.length + (step.counted ? '' : ' \u00b7 optional') +
            ' \u2014 ' + _ceBuildProgress(p) + ' of ' + _ceBuildCounted() + ' answered'),
        heading ? ceH2(heading) : null,
        step.why ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.65' } }, step.why) : null,
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, body),
        h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2, paddingTop: CE_T.s3,
            borderTop: '1px solid ' + CE_LINE } }, nav)
    );
}

// -- Root --------------------------------------------------------------------
function ceProfileRoot(): any {
    var ui = useStoreValue(ceUiStore);
    var prof = useStoreValue(ceProfileStore);
    var charId = ui ? ui.entityId : '';

    useEffect(function() {
        if (charId) { cePublishProfile(charId); }
    }, [charId]);

    // [v2.146.0 NOHEADER] WAS a hard-coded '\u2190 Scene' that ignored ceUiStore.back
    // entirely — so a Profile opened from Chat or Map sent you to Scene instead of back
    // where you came from, which is the exact bug NAV-BACK exists to prevent. It now uses
    // the shared control like Journal does. With no return address it renders nothing and
    // the nav (which carries Scene) is the way out.
    var back: any = ceBack();

    if (!prof || !prof.ready || prof.charId !== charId) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    if (!prof.p) {
        return ceScreen(ceHeader(back), ceEmpty('Character not found.', null));
    }

    var p = prof.p;
    var cfg = prof.cfg || null;
    var roster = prof.roster || [];
    var openMap = (ui && ui.open) || {};
    var drill = (ui && ui.profileDrill) || '';
    var shape = p.uiShape || 'studio';
    var patId = String(p.pattern || '');

    // Drill: full surface swap with its own header. Back clears the value.
    if (drill) {
        var dBack = ceBtn('\u2190 Profile', 'nav:profileback', function() {
            _ceProfileDrill('', 0); return Promise.resolve();
        });
        var dTitle = 'Profile';
        var dBody: any = null;
        if (drill === 'build') { dTitle = 'Build'; dBody = _ceProfileBuild(charId, p, cfg, roster, (ui && ui.profileStep) || 0); }
        else if (drill === 'pattern') { dTitle = 'Pattern'; dBody = _cePatternPicker(charId, p, false); }
        else if (drill === 'settings') { dTitle = 'Settings'; dBody = _ceProfileSettings(charId, p); }
        else if (drill === 'identity') { dTitle = 'Identity'; dBody = _ceProfileIdentityDrill(charId, p); }
        // [v2.121.0] Mounted via h(), not called bare -- this drill's own top level uses
        // hooks (useStoreValue/useEffect) and needs Preact's isolated per-instance hook
        // space, which only h(Component, props) provides. See the component's own header
        // comment for why it is the exception among the drills.
        else if (drill === 'images') { dTitle = 'Images'; dBody = h(_ceProfileImagesDrill, { charId: charId }); }
        // [v2.150.0 PHASE-F] Called BARE, not through h(): it uses no hooks, so it is a
        // plain renderer like every drill except Images. See that one's header for why it
        // is the exception rather than the rule.
        else if (drill === 'equipment') { dTitle = 'Equipment'; dBody = _ceProfileEquipDrill(charId, p, prof.equip); }
        // [v2.151.0 PHASE-COND] Also hook-free, also called bare.
        else if (drill === 'conditions') { dTitle = 'Conditions'; dBody = _ceProfileCondDrill(charId, p, cfg, prof.conds); }
        else if (drill === 'addcustom') {
            dTitle = 'Add a custom field';
            dBody = _ceProfileAddCustomDrill(charId, p, cfg);
        }
        else if (drill.indexOf('addfacet:') === 0) {
            var gid2 = drill.slice(9);
            dTitle = 'Add to ' + ceStaticFieldGroupLabel(gid2);
            dBody = _ceProfileAddFacet(charId, p, cfg, gid2);
        } else {
            dTitle = drill.charAt(0).toUpperCase() + drill.slice(1);
            dBody = ceEmpty(dTitle + ' has no engine-side renderer yet.', null);
        }
        return ceScreen(ceHeader(dBack), [dBody]);
    }

    var body: any[] = [];
    body.push(_ceProfileHero(p, charId));
    body.push(_ceProfilePressure(charId, prof.tiers, !!openMap.pressure));
    body.push(_ceProfileLaunchers(p, cfg, prof.equip, prof.conds, shape));
    body.push(_ceShapeToggle(charId, shape));

    var rows: any[] = [];
    if (shape === 'classic') {
        rows.push(_ceProfileClassic(charId, p, cfg));
    } else {
        // [v2.164.0, per user] THE CONTINUE BAR IS GONE. It restated the walkthrough launcher
        // sitting a few pixels above it in _ceProfileLaunchers, and it did so in the one place
        // on the surface reserved for the character's own writing. Two doors to one drill, one
        // of them permanently marked "unanswered", is a nag rather than a route.
        // _ceBuildAnswered / _ceBuildProgress / _ceBuildCounted are untouched -- the build
        // drill itself still uses all three.
        for (var gi = 0; gi < CE_FIELD_GROUP_ORDER.length; gi++) {
            var gid = CE_FIELD_GROUP_ORDER[gi];
            if (gid === 'resistance') { rows.push(_ceProfilePatternSection(charId, p)); }
            var gExtra: any[] = [];
            if (gid === 'position') { gExtra = _ceProfilePositionKids(charId, p); }
            // [v2.164.0 SHEET-BLOCK] Background's record prose, which the slot model never
            // had a home for. See _ceSheetFieldBlock.
            else if (gid === 'history') {
                var bgFd = _ceSheetFieldByKey('background');
                if (bgFd) gExtra = [_ceSheetFieldBlock(charId, p, cfg, bgFd)];
            }
            rows.push(_ceProfileGroup(charId, p, cfg, { id: gid, label: ceStaticFieldGroupLabel(gid) },
                                      gExtra));
        }
    }

    // [v2.112.0, per user] Position and Hooks are shape-INDEPENDENT. They are story state
    // (a counterpart, an unresolved tension), not two competing ways of describing a
    // person, so the uiShape exclusivity rule that governs slots-vs-sheet does not apply
    // to them. A classic character gets both.
    if (shape === 'classic') {
        rows.push(_ceProfileGroup(charId, p, cfg, { id: 'position', label: 'Position' },
                                  _ceProfilePositionKids(charId, p)));
    }
    rows.push(_ceProfileHooks(charId, p, cfg));
    rows.push(_ceProfileCustomGroup(charId, p, cfg));
    // [v2.163.0 CONDENSED] s5 between sections is CE-STYLE SS7.1's Read-density spacing.
    // The old zero-gap column was correct for a stack of accordion HEADS and wrong the
    // moment every section renders its content.
    body.push(h('div', { style: { display: 'flex', flexDirection: 'column',
        gap: CE_T.s5, paddingTop: CE_T.s4 } }, rows));

    return ceScreen(ceHeader(back), body);
}

// [v2.161.0 CUSTOM-SLOT / REBUILT v2.162.0 CUSTOM-PICK, per user: "clicking to add a
// custom slot opens the settings tab instead of selecting from custom fields that have
// already been made"] TWO SEPARATE JOBS, AND v2.161.0 CONFLATED THEM.
//
// DEFINING a custom field is global and belongs on Settings. PUTTING ONE ON THIS
// CHARACTER is per-character and belongs here, and it is what was actually asked for.
// v2.161.0 built a button that did the first and called it the second.
//
// THE REAL BUG UNDERNEATH: a user-defined field is stored with slot:'custom', and
// ceStaticFieldGroup returns '' for any slot outside CE_FIELD_GROUP_ORDER. The profile
// body loops over those six groups only, so every custom field an author ever created was
// INVISIBLE ON THIS SURFACE -- there was nothing to pick from because nothing rendered.
// That is why the Settings blurb promising "a character's + Add field picker" read as
// stale copy: the picker it described had never existed here.
//
// SO: ungrouped custom fields get their own group at the foot of the column, written ones
// shown, and an Add button opening a drill of the EMPTY ones. Same shape as the per-group
// "Add a <group> facet" flow, which is the pattern this surface already uses for exactly
// this question -- writing into a field is what adds it, so there is no separate
// attach/detach state to keep and nothing to clean up when a def is deleted in Settings.
function _ceUngroupedCustom(p: any): any[] {
    var out: any[] = [];
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && !String(list[i].group || '')) out.push(list[i]);
    }
    return out;
}

function _ceProfileCustomGroup(charId: string, p: any, cfg: any): any {
    var all = _ceUngroupedCustom(p);
    var written: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) { if (_ceHasValue(all[i])) written.push(all[i]); }
    // Nothing defined and nothing written: render the door alone rather than an empty
    // accordion, so a project with no custom fields still has one obvious way to get one.
    if (!all.length) {
        return h('div', { key: 'prof_customdoor', style: { paddingTop: CE_T.s3 } },
            ceBtn('Define a custom field\u2026', 'prof:cfdefine', function() {
                // ceNav writes `tab` itself (tab || ''), so a ceTabSet before it would be
                // wiped. The namespaced form ceTabGet parses goes in ceNav's third arg.
                ceNav('settings', '', 'settings:system');
                return Promise.resolve();
            }));
    }
    var kids: any[] = [];
    for (i = 0; i < written.length; i++) { kids.push(_ceFacetField(charId, p, cfg, written[i])); }
    var left = all.length - written.length;
    if (left > 0) {
        kids.push(ceBtn('Add a custom field (' + left + ' available)', 'prof:cfadd', function() {
            _ceProfileDrill('addcustom', 0);
            return Promise.resolve();
        }));
    } else {
        kids.push(ceBtn('Define another\u2026', 'prof:cfdefine2', function() {
            ceNav('settings', '', 'settings:system');
            return Promise.resolve();
        }));
    }
    return ceSection('Custom fields', h('div', { style: { display: 'flex',
        flexDirection: 'column', gap: CE_T.s4 } }, kids));
}

function _ceProfileAddCustomDrill(charId: string, p: any, cfg: any): any {
    var all = _ceUngroupedCustom(p);
    var kids: any[] = [];
    for (var i = 0; i < all.length; i++) {
        if (_ceHasValue(all[i])) continue;
        kids.push(_ceFacetField(charId, p, cfg, all[i]));
    }
    var toSettings = ceBtn('Define a new one in Settings\u2026', 'prof:cfdefine3', function() {
        ceNav('settings', '', 'settings:system');
        return Promise.resolve();
    });
    if (!kids.length) {
        return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
            ceEmpty('Every custom field you have defined already has something in it.', null),
            toSettings);
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.6' } },
            'These are the custom fields defined for this project. Write into any of them '
            + 'and it joins this character\u2019s profile. Leave the rest empty \u2014 an unused '
            + 'field costs nothing.'),
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids),
        toSettings
    );
}


// ============================================================================
// SECTION 31 — JOURNAL SURFACE (jsx)
// ONE surface for both journals: the story journal and every character's own.
// They share the bubble record and all six verbs; the only real difference is
// where the active bubbles are injected from, which is one sentence of copy.
//
// SCOPE IS A ROUTE, NOT A MODE. ceUiStore.entityId carries it: '' is the story
// journal, a charId is that character's. The character journal is reached from
// the profile launcher, the story journal from the Scene header, and the picker
// at the top switches between them without either being "inside" the other.
// Nothing here holds a second copy of which journal is showing.
//
// THREE KIT-LEVEL RULES THIS SURFACE ESTABLISHED:
//   1. A VARIABLE-LENGTH LIST OF EDITABLE FIELDS. Every bubble is an in-place
//      textarea, so this is the dynamic field list SECTION 28's own comment
//      predicted. It goes through h(ceField, props) with a per-bubble key —
//      never a bare ceField(p) in a loop, which would break hook order.
//   2. A DESTRUCTIVE ACTION. See DESTRUCTIVE-NEVER-IN-PLACE below: the confirm
//      does NOT swap the Delete button's own handler, because the double-fire
//      would then run the confirmed branch off the first physical tap.
//   3. A REVIEWED GENERATION. Rewrite/Compress never overwrite. The result
//      lands in `pending` and the author accepts or discards it, which is the
//      same contract the legacy modal had (generate into an edit draft, commit
//      only on Save) and the same rule as everywhere else in this engine: the
//      model proposes, the author moves the state.
// ============================================================================

var ceJournalStore: any = null;

function ceJournalStoreInit(): void {
    if (ceJournalStore) return;
    try {
        // draft / pending / confirm are session UI and live HERE rather than on
        // ceUiStore, deliberately: they change on almost every interaction with this
        // surface and nothing else subscribes to them, so putting them on the shared
        // ui store would repaint Scene and Profile on every keystroke-commit. That is
        // the change-frequency split the two-store design exists to make.
        // [v2.115.0] `draft` is GONE from the store on purpose -- see _ceJrnlDraft below.
        // `editing` is the id of the one entry open for editing (READ-FIRST); `composerGen`
        // is bumped to clear the composer -- [v2.116.0] as ceField's `seed` prop, no longer
        // as its component key. `seq` guards against a slow publish landing on top of a
        // newer one.
        ceJournalStore = createStore({ ready: false, scope: '', title: 'Story',
                                       bubbles: [], roster: [],
                                       editing: '', composerGen: 0, seq: 0,
                                       pending: null, confirm: '' });
    } catch (e) { api.v1.error('[AE:jsxjournal] store init failed:', e); }
}

// Shallow merge, same shape and same reason as ceUiPatch: a publish must not
// wipe a pending proposal, and a draft write must not wipe the bubble list.
function ceJournalPatch(fn: (s: any) => any): void {
    if (!ceJournalStore) return;
    try {
        ceJournalStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxjournal] patch failed:', e); }
}

// [v2.115.0 CLICK-BEFORE-BLUR, per user report] THE COMPOSER DRAFT IS A MODULE VARIABLE
// AND MUST STAY ONE. Measured behaviour: the first press of Add toasted "Nothing to add"
// and the second press worked, which means the click was delivered BEFORE the blur it
// caused, so Add read the draft one keystroke-session stale. Putting the draft in the
// store cannot fix that (the button still reads whatever landed first) and putting it in
// the store is independently forbidden: a store write re-renders, and a re-render on every
// keystroke repaints every subscriber of that store. [v2.116.0] The sharper original
// reason -- that a re-render bumped the field key and remounted the input mid-typing -- is
// retired with FIELD-KEYLESS; the repaint cost is not, and it is enough on its own.
// So: ceField.onType writes here on every keystroke with NO render, and Add reads here.
// The engine is unaffected by event ordering because nothing is waiting on an event any more.
var _ceJrnlDraft: string = '';

// [v2.115.0 PUBLISH-SEQ] Every publish takes a ticket and a publish whose ticket is older
// than the one already applied is DROPPED. cePublishJournal reads the whole roster
// (loadAllCharacters) plus the journal, so it is slow enough that two of them overlap
// easily -- and when the slower, older one wins the race it writes a PRE-EDIT bubble list
// over a post-edit one. That is the shape of the reported ghost entry: an entry visible on
// screen, absent from the merge count, and gone after leaving and returning. This does not
// prove that was the mechanism, but it makes it impossible.
var _ceJrnlSeq: number = 0;

// [v2.115.0 OP-CHAIN] Journal ops run one at a time. Each verb is load-modify-persist
// against storyStorage with no compare-and-swap underneath it, so two overlapping ops read
// the same list and the second silently discards the first's change. Serialising also
// means publishes cannot interleave. The chain never rejects -- a failed op must not
// poison every op after it.
var _ceJrnlChain: Promise<any> = Promise.resolve();

// Read projection. Reuses loadJournal / loadCharJournal rather than the two
// *PayloadForBridge builders — those exist to cross the worker boundary and
// this does not, but the projected shape is deliberately identical so the two
// can be unified when the bridge pair is retired.
async function cePublishJournal(scope: string): Promise<void> {
    ceJournalStoreInit();
    if (!ceJournalStore) return;
    var sc = String(scope || '');
    _ceJrnlSeq = _ceJrnlSeq + 1;
    var ticket = _ceJrnlSeq;
    try {
        var roster: any[] = [];
        try {
            var all: any[] = await loadAllCharacters();
            for (var ri = 0; ri < (all || []).length; ri++) {
                if (!all[ri]) continue;
                roster.push({ id: all[ri].id, name: all[ri].name || 'Unnamed' });
            }
        } catch (eR) { api.v1.error('[AE:jsxjournal] roster read failed:', eR); }

        var raw: any = sc ? await loadCharJournal(sc) : await loadJournal();
        var list: any[] = (raw && raw.bubbles) ? raw.bubbles : [];
        var bubbles: any[] = [];
        var seen: any = {};
        var i = 0;
        for (i = 0; i < list.length; i++) {
            var b: any = list[i];
            if (!b || !b.id) continue;
            seen[String(b.id)] = true;
            bubbles.push({ id: String(b.id), text: b.text || '',
                           archived: !!b.archived, createdAt: b.createdAt || 0 });
        }

        var title = 'Story';
        if (sc) {
            title = 'Character';
            for (i = 0; i < roster.length; i++) {
                if (roster[i].id === sc) { title = roster[i].name; break; }
            }
        }

        ceJournalPatch(function(s: any) {
            // [v2.115.0 PUBLISH-SEQ] An older snapshot never overwrites a newer one.
            if (Number(s.seq || 0) > ticket) {
                aeLog('[AE:jsxjournal] stale publish dropped (' + ticket + ' < ' + s.seq + ')');
                return {};
            }
            // A scope change resets the transient trio. Doing it here rather than at the
            // nav call site means EVERY route into this surface gets it, including a
            // future one that has not been written yet.
            var fresh = (String(s.scope || '') !== sc) || !s.ready;
            var pend = fresh ? null : (s.pending || null);
            // A proposal whose bubble no longer exists can never be accepted or
            // discarded — it would sit invisible and block the next one.
            if (pend && !seen[String(pend.id || '')]) { pend = null; }
            var conf = fresh ? '' : String(s.confirm || '');
            if (conf && !seen[conf]) { conf = ''; }
            var edit = fresh ? '' : String(s.editing || '');
            if (edit && !seen[edit]) { edit = ''; }
            if (fresh) { _ceJrnlDraft = ''; }
            return { ready: true, scope: sc, title: title, bubbles: bubbles, roster: roster,
                     seq: ticket, pending: pend, confirm: conf, editing: edit,
                     composerGen: fresh ? 0 : Number(s.composerGen || 0) };
        });
    } catch (e) {
        // Previous value survives a failed publish — stale beats blank.
        api.v1.error('[AE:jsxjournal] publish failed:', e);
    }
}

// -- The single write path from this surface ---------------------------------
// One function, one scope branch, same discipline as ceProfileWrite: the
// story/character fork exists in exactly one place, so a seventh verb cannot be
// added to one half and forgotten in the other. Every branch ends in a
// republish, so the surface never renders a value it did not read back.
function ceJournalOp(scope: string, op: string, id: string, value: any): Promise<void> {
    // [v2.115.0 OP-CHAIN] Queue, never run directly. The catch is on the chain itself so a
    // rejected op cannot break the link for everything after it.
    var run = _ceJrnlChain.then(function() { return _ceJournalOpRun(scope, op, id, value); });
    _ceJrnlChain = run.catch(function() { return null; });
    return run;
}

async function _ceJournalOpRun(scope: string, op: string, id: string, value: any): Promise<void> {
    var sc = String(scope || '');
    var isChar = !!sc;
    var bid = String(id || '');
    try {
        if (op === 'add') {
            var t = String(value || '').trim();
            if (!t) {
                try { api.v1.ui.toast('Nothing to add.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
                return;
            }
            if (isChar) { await charJournalAddBubble(sc, t); } else { await journalAddBubble(t); }
            // [v2.116.0 FIELD-KEYLESS] Bumping composerGen bumps the composer's `seed`
            // prop, which force-clears the field through the ref it already holds. This
            // used to bump a component KEY and remount, which leaked the old node.
            _ceJrnlDraft = '';
            ceJournalPatch(function(st: any) { return { composerGen: Number(st.composerGen || 0) + 1 }; });
        } else if (op === 'update' || op === 'replace') {
            if (isChar) { await charJournalUpdateBubble(sc, bid, String(value || '')); }
            else { await journalUpdateBubble(bid, String(value || '')); }
            if (op === 'replace') { ceJournalPatch(function() { return { pending: null }; }); }
        } else if (op === 'archive') {
            if (isChar) { await charJournalSetArchived(sc, bid, !!value); }
            else { await journalSetArchived(bid, !!value); }
        } else if (op === 'delete') {
            if (isChar) { await charJournalDeleteBubble(sc, bid); } else { await journalDeleteBubble(bid); }
            ceJournalPatch(function() { return { confirm: '', editing: '' }; });
        } else if (op === 'merge') {
            if (isChar) { await charJournalMergeDown(sc); } else { await journalMergeDown(); }
        } else {
            api.v1.error('[AE:jsxjournal] unknown op: ' + op);
            return;
        }
        await cePublishJournal(sc);
    } catch (e) { api.v1.error('[AE:jsxjournal] op ' + op + ' failed:', e); }
}

// -- Reviewed generation -----------------------------------------------------
// journalGenerateRewrite / journalGenerateCompress are shared by both journals
// already (they are pure text transforms with no journal identity), so there is
// nothing to fork here. The result is PROPOSED, never written: a rewrite that
// silently replaced the author's own words would be unrecoverable, since
// storyStorage has no undo.
async function ceJournalGen(scope: string, id: string, kind: string, src: string): Promise<void> {
    var s = String(src || '').trim();
    if (!s) {
        try { api.v1.ui.toast('Nothing to work with.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
        return;
    }
    try {
        api.v1.ui.toast(kind === 'rewrite' ? 'Rewriting\u2026' : 'Compressing\u2026',
                        { id: 'ce-jrnlgen', autoClose: false, type: 'info' });
    } catch (e1) {}
    var out: string | null = null;
    try {
        out = (kind === 'rewrite') ? await journalGenerateRewrite(s) : await journalGenerateCompress(s);
    } catch (e2) { api.v1.error('[AE:jsxjournal] gen failed:', e2); }
    if (!out || !String(out).trim()) {
        try { api.v1.ui.toast('Generation failed.', { id: 'ce-jrnlgen', type: 'error', autoClose: 2000 }); } catch (e3) {}
        return;
    }
    try { api.v1.ui.toast('Ready \u2014 review it.', { id: 'ce-jrnlgen', type: 'success', autoClose: 1500 }); } catch (e4) {}
    ceJournalPatch(function() {
        return { pending: { id: String(id || ''), kind: kind, text: String(out) } };
    });
}

// -- Sizing ------------------------------------------------------------------
// [v2.115.0 FIELD-FITS-CONTENT, per user] NO UPPER CAP. The v2.114.0 version capped at 14
// rows, which put a two-paragraph entry into a short scrolling well while a one-sentence
// entry got the same box -- the field dictating to the content instead of the reverse.
// THE RULE, now in CE-STYLE: a field is sized BY its content and the SURFACE scrolls, not
// the field. A nested scroller inside a scrolling surface is two scrollbars competing for
// the same gesture, and on touch the inner one wins by accident.
// Hard-wrapped lines are counted individually so paragraph breaks are not averaged away.
function _ceJrnlRows(text: string): number {
    var t = String(text || '');
    var lines = t.split('\n');
    var n = 0;
    for (var i = 0; i < lines.length; i++) {
        n = n + Math.max(1, Math.ceil(lines[i].length / 48));
    }
    return Math.max(3, n + 1);
}

// -- One entry ---------------------------------------------------------------
// [v2.115.0 READ-FIRST, per user] AN ENTRY IS PROSE UNTIL IT IS TAPPED. v2.114.0 rendered
// every entry as an always-live textarea with a row of buttons under each one, so a page of
// journal read as a stack of forms separated by chrome -- the controls were the loudest
// thing on a surface whose whole purpose is reading back what you wrote. Now: prose at full
// strength, one tap opens exactly ONE entry for editing, and the verbs appear below the open
// entry and nowhere else. A closed entry carries no controls at all.
// ONE OPEN AT A TIME is not a restriction, it is what makes the list read continuously: with
// N live textareas there is no visual difference between an entry and the gap after it.
// EVERY CHILD HERE IS KEYED. Mixing keyed and unkeyed siblings in one array is the standard
// way to get a node that survives a diff it should not have -- and an entry that stayed on
// screen after it left the data is exactly what was reported.
function _ceJournalBubble(scope: string, b: any, pending: any, confirmId: string, editingId: string): any {
    var id = String(b.id || '');
    var editing = (editingId === id);
    var text = String(b.text || '');
    var kids: any[] = [];

    if (!editing) {
        kids.push(h('div', {
            key: 'jr_' + id,
            onClick: function() {
                ceTap('jrnl:open:' + id, function() {
                    ceJournalPatch(function() { return { editing: id, confirm: '' }; });
                });
            },
            style: {
                fontSize: CE_T.fs, lineHeight: '1.65', whiteSpace: 'pre-wrap',
                // Ladder: the author's own words are t1 by definition; the empty-state
                // prompt is a label about content, t3. 0.24 measured 2.2:1 -- the prompt
                // telling a new user what to do was the least readable text on the screen.
                cursor: 'pointer', opacity: text.trim() ? CE_OP.t1 : CE_OP.t3
            }
        }, text.trim() ? text : 'Empty entry \u2014 tap to write'));
    } else {
        kids.push(h(ceField, {
            key: 'jb_' + id,
            k: 'jrnl:' + (scope || 'story') + ':' + id,
            label: '',
            value: text,
            multiline: true,
            rows: _ceJrnlRows(text),
            placeholder: 'Write this entry\u2026',
            onCommit: function(v: string) { return ceJournalOp(scope, 'update', id, v); }
        }));

        var acts: any[] = [];
        acts.push(ceBtn('Done', 'jrnl:done:' + id, function() {
            ceJournalPatch(function() { return { editing: '' }; });
            return Promise.resolve();
        }));
        acts.push(ceBtn(b.archived ? 'Unarchive' : 'Archive', 'jrnl:arch:' + id, function() {
            return ceJournalOp(scope, 'archive', id, !b.archived);
        }));
        acts.push(ceBtn('Rewrite', 'jrnl:rw:' + id, function() {
            return ceJournalGen(scope, id, 'rewrite', text);
        }));
        acts.push(ceBtn('Compress', 'jrnl:cp:' + id, function() {
            return ceJournalGen(scope, id, 'compress', text);
        }));
        // [v2.114.0 DESTRUCTIVE-NEVER-IN-PLACE] This button ASKS and never deletes, and it
        // keeps the same handler in both states on purpose. Swapping it to a confirmed
        // Delete would put the destructive handler on the element the second fire of the
        // SAME physical tap lands on -- the reused-node path TAP-GUARD documents -- guarded
        // only by CE_TAP_MS, which is still an inferred number. Asking twice is idempotent.
        acts.push(ceIconBtn('Delete this entry\u2026', ceIconTrash(), 'jrnl:delask:' + id, function() {
            ceJournalPatch(function() { return { confirm: id }; });
            return Promise.resolve();
        }));
        kids.push(h('div', { key: 'ja_' + id,
            style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, acts));

        if (confirmId === id) {
            kids.push(h('div', { key: 'jc_' + id, style: {
                display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3
            } },
                h('div', { key: 'jcm_' + id, style: { flex: '1 1 180px', fontSize: CE_T.fsSm,
                    opacity: '0.74', lineHeight: '1.4' } },
                    'Delete this entry? There is no undo for journal storage.'),
                ceBtn('Delete', 'jrnl:del:' + id, function() {
                    return ceJournalOp(scope, 'delete', id, null);
                }, 'danger'),
                ceBtn('Keep', 'jrnl:keep:' + id, function() {
                    ceJournalPatch(function() { return { confirm: '' }; });
                    return Promise.resolve();
                })
            ));
        }
    }

    // A proposal renders in BOTH states: a rewrite fired from the open entry stays visible
    // if the entry closes underneath it, and an unreviewed proposal must never be silent.
    if (pending && String(pending.id || '') === id) {
        kids.push(h('div', { key: 'jp_' + id, style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3
        } },
            ceH3((pending.kind === 'rewrite' ? 'Rewritten' : 'Compressed') + ' \u2014 not saved'),
            h('div', { key: 'jpt_' + id, style: { fontSize: CE_T.fs, lineHeight: '1.6',
                whiteSpace: 'pre-wrap' } }, String(pending.text || '')),
            h('div', { key: 'jpa_' + id, style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                ceBtn('Replace', 'jrnl:acc:' + id, function() {
                    return ceJournalOp(scope, 'replace', id, String(pending.text || ''));
                }, 'primary'),
                ceBtn('Discard', 'jrnl:disc:' + id, function() {
                    ceJournalPatch(function() { return { pending: null }; });
                    return Promise.resolve();
                })
            )
        ));
    }

    return h('div', { key: 'jw_' + id, style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s2,
        padding: (editing ? CE_T.s3 : CE_T.s2) + ' 0',
        borderBottom: '1px solid ' + CE_LINE,
        // Ladder: an archived bubble is still the author's own writing, just no longer
        // injected -- secondary content, t2, not a label.
        opacity: b.archived ? CE_OP.t2 : CE_OP.t1
    } }, kids);
}

// -- Root --------------------------------------------------------------------
function ceJournalRoot(): any {
    var ui = useStoreValue(ceUiStore);
    var j = useStoreValue(ceJournalStore);
    var scope = ui ? String(ui.entityId || '') : '';

    useEffect(function() {
        // [v2.115.0 LATCH-SWEEP] Clear any journal latch left standing by a previous visit.
        // ceAction releases in a `finally`, so a busy flag that outlives its action means
        // fn() NEVER SETTLED -- and the only candidate in this path is a hung await inside
        // the lorebook sync persistJournal performs. This does not fix that; it makes it
        // SELF-HEALING on navigation, which is the workaround the user found by hand
        // ("leaving the screen and returning causes it to disappear"). The log line is the
        // evidence trail: if it prints on a normal visit, something really is hanging.
        ceUiPatch(function(u: any) {
            var kept: any = {}; var k: string; var n = 0;
            for (k in (u.busy || {})) {
                if (k.indexOf('jrnl:') >= 0) { n = n + 1; continue; }
                kept[k] = u.busy[k];
            }
            if (n > 0) { aeLog('[AE:jsxjournal] swept ' + n + ' stale latch(es) on mount'); }
            return { busy: kept };
        });
        cePublishJournal(scope);
    }, [scope]);

    var back = ceBack();

    if (!j || !j.ready || String(j.scope || '') !== scope) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    var bubbles: any[] = j.bubbles || [];
    var active: any[] = [];
    var archived: any[] = [];
    var i = 0;
    for (i = 0; i < bubbles.length; i++) {
        if (bubbles[i].archived) { archived.push(bubbles[i]); } else { active.push(bubbles[i]); }
    }

    var body: any[] = [];

    // Scope: the title IS the surface title (ceH1, once), and the picker sits under it
    // as a route control rather than a field. A roster select is legitimate here and
    // does NOT violate the referential-field rule: nothing is stored, the value is a
    // destination.
    var scopeOpts: any[] = [{ id: '', label: 'Story journal' }];
    var roster: any[] = j.roster || [];
    for (i = 0; i < roster.length; i++) {
        scopeOpts.push({ id: roster[i].id, label: roster[i].name });
    }
    body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        ceH1(scope ? (j.title + '\u2019s journal') : 'The story so far'),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.6' } },
            scope
                ? 'Active entries fold into this character\u2019s own lorebook entry, alongside their conditions and equipment. Archived entries are kept and never injected.'
                : 'Active entries stay Always-On in the lorebook as \u201CThe story so far\u201D, so they survive context pressure. Archived entries are kept and never injected.'),
        ceSelect({
            k: 'jrnl:scope',
            value: scope,
            options: scopeOpts,
            onCommit: function(v: string) {
                // Carries the return address forward, so switching scope does not strand
                // someone who arrived here from a profile.
                ceNav('journal', String(v || ''), '', (ui && ui.back) || null);
                return Promise.resolve();
            }
        })
    ));

    // Composer. [v2.115.0] The draft is a MODULE VARIABLE written by onType, not store
    // state -- see CLICK-BEFORE-BLUR. Add reads it directly, so it no longer matters
    // whether the blur this click caused is delivered before or after the click itself.
    // The well marks it as a place to WRITE, distinct from the entries below it, which are
    // a place to READ that happens to accept edits.
    var tools: any[] = [];
    tools.push(ceBtn('Add entry', 'jrnl:add:' + (scope || 'story'), function() {
        return ceJournalOp(scope, 'add', '', _ceJrnlDraft);
    }, 'primary'));
    if (active.length > 1) {
        tools.push(ceBtn('Merge all (' + active.length + ')', 'jrnl:merge:' + (scope || 'story'), function() {
            return ceJournalOp(scope, 'merge', '', null);
        }));
    }
    body.push(ceSection('New entry',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h(ceField, {
                // [v2.116.0 FIELD-KEYLESS, per user report] `seed`, NOT a bumped component
                // key. This field's `value` is always '', so nothing inside ceField can
                // detect a change to re-seed from -- but remounting the whole component to
                // say so is what left one dead composer standing per Add. seed carries the
                // SCOPE as well as the generation, so switching journals clears the box too;
                // composerGen alone resets to 0 on a scope change and would not fire.
                seed: (scope || 'story') + ':' + String(j.composerGen || 0),
                k: 'jrnl:new:' + (scope || 'story'),
                label: '',
                value: '',
                multiline: true,
                rows: 3,
                well: true,
                placeholder: 'Write what just happened\u2026',
                onType: function(v: string) { _ceJrnlDraft = v; },
                onCommit: function(v: string) { _ceJrnlDraft = v; return Promise.resolve(); }
            }),
            h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, tools)
        )
    ));

    var editingId = String(j.editing || '');
    var activeNodes: any[] = [];
    for (i = 0; i < active.length; i++) {
        activeNodes.push(_ceJournalBubble(scope, active[i], j.pending, String(j.confirm || ''), editingId));
    }
    body.push(ceSection('Entries (' + active.length + ')',
        active.length
            ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, activeNodes)
            : ceEmpty('Nothing written yet.', null)
    ));

    if (archived.length) {
        // ceAccordion writes ceUiStore.open -- the shell's generic open-map [v2.132.0
        // OPEN-MAP-RENAME], renamed now that a third surface (Settings) uses it -- see
        // ceToggleOpen's own comment.
        var openMap: any = (ui && ui.open) || {};
        var archNodes: any[] = [];
        for (i = 0; i < archived.length; i++) {
            archNodes.push(_ceJournalBubble(scope, archived[i], j.pending, String(j.confirm || ''), editingId));
        }
        body.push(ceAccordion({
            id: 'jrnl:archived',
            label: 'Archived',
            open: !!openMap['jrnl:archived'],
            summary: _ceTrim(String(archived[0].text || ''), 68),
            meta: String(archived.length),
            children: h('div', { style: { display: 'flex', flexDirection: 'column' } }, archNodes)
        }));
    }

    return ceScreen(ceHeader(back), body);
}


// ============================================================================
// SECTION 32 — WORLD MAP SURFACE (jsx)  [v2.127.0 WORLDMAP]
// ============================================================================
// A nested-circle map of the location hierarchy. Supersedes the v2.124.0-v2.126.0
// WORLD-MAP-PROBE, whose six questions are all answered and whose scaffolding
// (hand-placed demo circles, the P1-P6 readout panel) is deleted here rather than
// left to rot as a second half-real map.
//
// WHAT THE PROBE SETTLED, so none of it is re-derived:
//   - SVG renders in a jsx surface (<svg viewBox>/<g transform>/<circle>/<text>),
//     including counter-scaled stroke-width and font-size.
//   - TWO CONCURRENT POINTERS FIRE, so pinch-to-zoom is real. It is reconstructed
//     from pointerId tracking, NOT from touch events: ScriptTouchEvent carries no
//     touch positions at all, so pointer tracking is the only route to multi-touch.
//   - touch-action:'none' alone stops native scroll. preventDefault does not exist.
//   - onPointerDown/Up are 1:1 (down=35/up=35 measured). This does NOT overturn
//     JSX-PROBE-RESULTS (1)'s onClick double-fire, which was a different element in
//     a different context -- every BUTTON here still goes through ceTap/ceAction.
//   - Pointer events survive leaving the element, so the absent setPointerCapture
//     costs nothing.
//   - onPointerLeave fires constantly (127 against 35 real downs), so its handler
//     must not write state for a pointer it was never tracking.
//
// GEOMETRY IS d3.pack's ALGORITHM, HAND-PORTED, because d3 cannot be imported into
// the Worker sandbox. Two parts: front-chain sibling packing (Wang et al.) and
// Welzl's smallest-enclosing-circle. Ported and UNIT-TESTED OUTSIDE THIS FILE
// first (17 checks: no sibling overlap, children contained by parent, finite
// geometry, determinism, degenerate inputs, fill ratio) because a geometry bug in
// here is a BLANK SURFACE WITH NO CONSOLE LINE -- see STORE-BEFORE-HOOK.
//
// SIZING RULE, per user: a leaf counts 1 and a parent is the SUM of its children,
// so a node with more descendants claims more of its parent, and an empty circle's
// size is simply whatever share its siblings leave it. No separate "importance"
// field to keep in sync with anything.
//
// PADDING IS IN OUTPUT UNITS AND NEEDS TWO PACKING PASSES. Internally a leaf has
// radius sqrt(value) = 1, so applying the caller's padding directly would inflate
// every leaf several times over and leave parents looking almost empty (measured
// during the port: leaves at r=12.6 inside a parent at r=108.8, a 0.116 fill
// ratio). Pass 1 packs unpadded purely to learn root.r in internal units; that
// ratio converts output-unit padding into internal units for pass 2. The unit test
// carries a fill-ratio check specifically so this cannot regress silently.
//
// THE ONE UNMEASURABLE CONSTANT, and it is honest rather than hidden:
// CE_MAP_FONT_VB. Label legibility wants to know how big text is IN PIXELS, and
// this environment cannot find out -- the jsx mount has no ownerDocument, so there
// is no getBoundingClientRect and no way to learn the viewBox-to-pixel ratio (see
// JSX-PROBE-RESULTS (4)). Everything else here is resolution-independent: circle
// diameter and font size both live in viewBox units inside the same transform, so
// "does this name fit inside this circle" is a pure ratio and needs no pixel
// knowledge. Only the absolute floor (is 12px text readable) needs the ratio, so
// CE_MAP_FONT_VB is calibrated once for a nominal ~360px-wide mobile viewport and
// documented as such. It degrades gracefully: wrong by 30% means slightly large or
// small text, not a broken layout.
// ============================================================================

var CE_MAP_VB       = 1000;    // viewBox is CE_MAP_VB x CE_MAP_VB, all geometry in these units
var CE_MAP_PAD      = 10;      // sibling padding, in viewBox units (see two-pass note above)
var CE_MAP_FONT_VB  = 34;      // apparent label size in viewBox units -- the calibrated constant
var CE_MAP_CHAR_W   = 0.55;    // average glyph width as a fraction of font size, for fit math
var CE_MAP_VIEW_H_PX = 380;    // map viewport height IN PIXELS, as a NUMBER -- see PAN-SCALE below
var CE_MAP_VIEW_H   = CE_MAP_VIEW_H_PX + 'px'; // same value, as a CSS string, for the style prop
var CE_MAP_ROOT_ID  = '__ce_map_root__';
// [PAN-SCALE, per user "panning is a little slow"] A SECOND HONEST-APPROXIMATION CONSTANT,
// same category as CE_MAP_FONT_VB and for the identical reason: this environment cannot
// read the SVG's actual rendered pixel size (no ownerDocument, no getBoundingClientRect --
// JSX-PROBE-RESULTS (4)), so the CSS-pixel-to-viewBox-unit ratio cannot be measured, only
// assumed. The bug this fixes: onMove's pan handler was adding raw clientX/Y deltas (CSS
// pixels) directly onto camera.x/y (viewBox units) with an IMPLICIT 1:1 ratio -- but the
// <g transform> lives in viewBox space, which is CE_MAP_VB units mapped onto however many
// CSS pixels the SVG actually renders at, roughly CE_MAP_VIEW_H_PX on a typical portrait
// phone (the square viewBox is constrained by whichever container dimension is smaller,
// and width is usually >= height on this surface). So 1 CSS pixel of finger movement was
// only moving the map (CE_MAP_VIEW_H_PX / CE_MAP_VB) of a viewBox unit -- roughly 38% of
// what the finger travelled -- which reads exactly as "sluggish." The fix multiplies every
// pointer-pixel delta by this ratio before adding it to camera.x/y. This conversion is
// INDEPENDENT of camera.k: translate() in `translate(camera.x,camera.y) scale(camera.k)`
// shifts the whole group by that many viewBox units regardless of the group's own scale,
// so no k-dependent term belongs here -- confirmed by the transform math, not guessed.
var CE_MAP_VB_PER_PX = CE_MAP_VB / CE_MAP_VIEW_H_PX;

// -- Deterministic RNG --------------------------------------------------------
// Seeded identically on every call so a given world always packs to the SAME
// layout. A map whose circles rearranged themselves on each render would be
// unusable, and Welzl's algorithm wants a shuffle for its expected-linear time.
function ceMapLcg(): any {
    var s = 1;
    return function() { s = (1664525 * s + 1013904223) % 4294967296; return s / 4294967296; };
}

function ceMapShuffle(arr: any[], random: any): any[] {
    var a = arr.slice(), m = a.length, t: any, i: number;
    while (m) { i = Math.floor(random() * m--); t = a[m]; a[m] = a[i]; a[i] = t; }
    return a;
}

// -- Smallest enclosing circle (Welzl, randomized incremental) ----------------
function ceMapEnclosesNot(a: any, b: any): boolean {
    var dr = a.r - b.r, dx = b.x - a.x, dy = b.y - a.y;
    return dr < 0 || dr * dr < dx * dx + dy * dy;
}

function ceMapEnclosesWeak(a: any, b: any): boolean {
    var dr = a.r - b.r + Math.max(a.r, b.r, 1) * 1e-9, dx = b.x - a.x, dy = b.y - a.y;
    return dr > 0 && dr * dr > dx * dx + dy * dy;
}

function ceMapEnclosesWeakAll(a: any, B: any[]): boolean {
    for (var i = 0; i < B.length; i++) { if (!ceMapEnclosesWeak(a, B[i])) return false; }
    return true;
}

function ceMapBasis1(a: any): any { return { x: a.x, y: a.y, r: a.r }; }

function ceMapBasis2(a: any, b: any): any {
    var x1 = a.x, y1 = a.y, r1 = a.r, x2 = b.x, y2 = b.y, r2 = b.r,
        x21 = x2 - x1, y21 = y2 - y1, r21 = r2 - r1,
        l = Math.sqrt(x21 * x21 + y21 * y21);
    return { x: (x1 + x2 + x21 / l * r21) / 2, y: (y1 + y2 + y21 / l * r21) / 2, r: (l + r1 + r2) / 2 };
}

function ceMapBasis3(a: any, b: any, c: any): any {
    var x1 = a.x, y1 = a.y, r1 = a.r, x2 = b.x, y2 = b.y, r2 = b.r, x3 = c.x, y3 = c.y, r3 = c.r,
        a2 = x1 - x2, a3 = x1 - x3, b2 = y1 - y2, b3 = y1 - y3, c2 = r2 - r1, c3 = r3 - r1,
        d1 = x1 * x1 + y1 * y1 - r1 * r1,
        d2 = d1 - x2 * x2 - y2 * y2 + r2 * r2,
        d3 = d1 - x3 * x3 - y3 * y3 + r3 * r3,
        ab = a3 * b2 - a2 * b3,
        xa = (b2 * d3 - b3 * d2) / (ab * 2) - x1,
        xb = (b3 * c2 - b2 * c3) / ab,
        ya = (a3 * d2 - a2 * d3) / (ab * 2) - y1,
        yb = (a2 * c3 - a3 * c2) / ab,
        A = xb * xb + yb * yb - 1,
        B = 2 * (r1 + xa * xb + ya * yb),
        C = xa * xa + ya * ya - r1 * r1,
        r = -(Math.abs(A) > 1e-6 ? (B + Math.sqrt(B * B - 4 * A * C)) / (2 * A) : C / B);
    return { x: x1 + xa + xb * r, y: y1 + ya + yb * r, r: r };
}

function ceMapEncloseBasis(B: any[]): any {
    if (B.length === 1) return ceMapBasis1(B[0]);
    if (B.length === 2) return ceMapBasis2(B[0], B[1]);
    return ceMapBasis3(B[0], B[1], B[2]);
}

function ceMapExtendBasis(B: any[], p: any): any[] {
    var i: number, j: number;
    if (ceMapEnclosesWeakAll(p, B)) return [p];
    for (i = 0; i < B.length; i++) {
        if (ceMapEnclosesNot(p, B[i]) && ceMapEnclosesWeakAll(ceMapBasis2(B[i], p), B)) return [B[i], p];
    }
    for (i = 0; i < B.length - 1; i++) {
        for (j = i + 1; j < B.length; j++) {
            if (ceMapEnclosesNot(ceMapBasis2(B[i], B[j]), p)
                && ceMapEnclosesNot(ceMapBasis2(B[i], p), B[j])
                && ceMapEnclosesNot(ceMapBasis2(B[j], p), B[i])
                && ceMapEnclosesWeakAll(ceMapBasis3(B[i], B[j], p), B)) {
                return [B[i], B[j], p];
            }
        }
    }
    // d3 throws here. This file must not: an exception during render is a blank
    // surface with nothing in the console. Return a safe superset instead --
    // slightly loose packing beats no map at all.
    return B.concat([p]);
}

function ceMapPackEnclose(circles: any[], random: any): any {
    var list = ceMapShuffle(circles, random);
    var i = 0, n = list.length, B: any[] = [], p: any, e: any = null;
    while (i < n) {
        p = list[i];
        if (e && ceMapEnclosesWeak(e, p)) { i++; }
        else { B = ceMapExtendBasis(B, p); e = ceMapEncloseBasis(B); i = 0; }
    }
    return e;
}

// -- Front-chain sibling packing (Wang et al.) --------------------------------
function ceMapPlace(b: any, a: any, c: any): void {
    var dx = b.x - a.x, x: number, a2: number,
        dy = b.y - a.y, y: number, b2: number,
        d2 = dx * dx + dy * dy;
    if (d2) {
        a2 = a.r + c.r; a2 *= a2;
        b2 = b.r + c.r; b2 *= b2;
        if (a2 > b2) {
            x = (d2 + b2 - a2) / (2 * d2);
            y = Math.sqrt(Math.max(0, b2 / d2 - x * x));
            c.x = b.x - x * dx - y * dy;
            c.y = b.y - x * dy + y * dx;
        } else {
            x = (d2 + a2 - b2) / (2 * d2);
            y = Math.sqrt(Math.max(0, a2 / d2 - x * x));
            c.x = a.x + x * dx - y * dy;
            c.y = a.y + x * dy + y * dx;
        }
    } else { c.x = a.x + c.r; c.y = a.y; }
}

function ceMapIntersects(a: any, b: any): boolean {
    var dr = a.r + b.r - 1e-6, dx = b.x - a.x, dy = b.y - a.y;
    return dr > 0 && dr * dr > dx * dx + dy * dy;
}

function ceMapChainScore(node: any): number {
    var a = node._, b = node.next._, ab = a.r + b.r,
        dx = (a.x * b.r + b.x * a.r) / ab,
        dy = (a.y * b.r + b.y * a.r) / ab;
    return dx * dx + dy * dy;
}

function ceMapChainNode(circle: any): any { return { _: circle, next: null, previous: null }; }

function ceMapPackSiblings(circles: any[], random: any): number {
    var n = circles.length, a: any, b: any, c: any, aa: number, ca: number,
        i: number, j: any, k: any, sj: number, sk: number;
    if (!n) return 0;

    a = circles[0]; a.x = 0; a.y = 0;
    if (n <= 1) return a.r;

    b = circles[1]; a.x = -b.r; b.x = a.r; b.y = 0;
    if (n <= 2) return a.r + b.r;

    c = circles[2];
    ceMapPlace(b, a, c);

    a = ceMapChainNode(a); b = ceMapChainNode(b); c = ceMapChainNode(c);
    a.next = c.previous = b;
    b.next = a.previous = c;
    c.next = b.previous = a;

    pack: for (i = 3; i < n; i++) {
        ceMapPlace(a._, b._, circles[i]);
        c = ceMapChainNode(circles[i]);
        j = b.next; k = a.previous; sj = b._.r; sk = a._.r;
        do {
            if (sj <= sk) {
                if (ceMapIntersects(j._, c._)) { b = j; a.next = b; b.previous = a; i--; continue pack; }
                sj += j._.r; j = j.next;
            } else {
                if (ceMapIntersects(k._, c._)) { a = k; a.next = b; b.previous = a; i--; continue pack; }
                sk += k._.r; k = k.previous;
            }
        } while (j !== k.next);

        c.previous = a; c.next = b; a.next = b.previous = b = c;
        aa = ceMapChainScore(a);
        while ((c = c.next) !== b) {
            ca = ceMapChainScore(c);
            if (ca < aa) { a = c; aa = ca; }
        }
        b = a.next;
    }

    var chain: any[] = [b._];
    c = b;
    while ((c = c.next) !== b) chain.push(c._);
    var e = ceMapPackEnclose(chain, random);
    for (i = 0; i < n; i++) { circles[i].x -= e.x; circles[i].y -= e.y; }
    return e.r;
}

// -- Hierarchy walk + layout --------------------------------------------------
function ceMapSumValues(node: any): number {
    var kids = node.children || [];
    if (!kids.length) { node.value = 1; return 1; }
    var total = 0;
    for (var i = 0; i < kids.length; i++) total += ceMapSumValues(kids[i]);
    node.value = total;
    return total;
}

function ceMapEachAfter(node: any, fn: any): void {
    var kids = node.children || [];
    for (var i = 0; i < kids.length; i++) ceMapEachAfter(kids[i], fn);
    fn(node);
}

function ceMapEachBefore(node: any, fn: any): void {
    fn(node);
    var kids = node.children || [];
    for (var i = 0; i < kids.length; i++) ceMapEachBefore(kids[i], fn);
}

// [SINGLE-CHILD-OFFSET, per user] A container with exactly one child, packed and centered
// normally, is visually indistinguishable from a leaf: with n=1 the enclosing circle wraps
// the child edge-to-edge (parent.value === child.value, same total, so the natural
// enclosing radius equals the child's own radius, concentric). Deliberately broken here:
// the child gets HALF the parent's radius and is pushed off-center, so a single-child
// container always reads as "one thing inside a container," never as a leaf.
// Unit-tested standalone first (9 checks: ratio, offset, containment, nested case,
// value-proportionality, multi-child regression, determinism, non-stickiness).
var CE_MAP_SOLO_SCALE = 0.5;   // per user: "the child should have half the radius"
var CE_MAP_SOLO_ANGLE = -0.7;  // fixed, deterministic direction -- a lone child jumping to
                                // a new offset on every publish would be its own bug.

function ceMapPackChildren(node: any, padInternal: number, random: any): void {
    var kids = node.children || [];
    if (!kids.length) return;
    var i: number, r = padInternal || 0;

    if (kids.length === 1) {
        var only = kids[0];
        // PARENT RADIUS STILL COMES FROM THE NODE'S OWN VALUE, sqrt(node.value) -- the same
        // formula that sizes any node -- NOT from the (now-shrunk) child's enclosing circle.
        // Deriving it from the child would make a single-child location SMALLER than a
        // same-value sibling that happens to have two children, which is wrong: size is a
        // fact about subtree value, not about how many direct children hold that value.
        var parentR = Math.sqrt(node.value);
        only.r = parentR * CE_MAP_SOLO_SCALE;
        var maxOffset = parentR - only.r - r;
        if (maxOffset < 0) maxOffset = 0;
        var offset = maxOffset * 0.55; // inside the padded boundary with room to spare
        only.x = offset * Math.cos(CE_MAP_SOLO_ANGLE);
        only.y = offset * Math.sin(CE_MAP_SOLO_ANGLE);
        node.r = parentR + r;
        return;
    }

    if (r) for (i = 0; i < kids.length; i++) kids[i].r += r;
    var e = ceMapPackSiblings(kids, random);
    if (r) for (i = 0; i < kids.length; i++) kids[i].r -= r;
    node.r = e + r;
}

function ceMapPackHierarchy(root: any, size: number, padding: number): any {
    var random = ceMapLcg();
    var padOut = Number(padding) || 0;

    ceMapSumValues(root);
    ceMapEachBefore(root, function(node: any) {
        if (!node.children || !node.children.length) node.r = Math.sqrt(node.value);
    });

    // Pass 1: unpadded, purely to learn root.r in internal units.
    ceMapEachAfter(root, function(node: any) { ceMapPackChildren(node, 0, random); });

    // Pass 2: repack with the caller's output-unit padding converted to internal.
    if (padOut && root.r > 0) {
        var toInternal = root.r / size;
        ceMapEachAfter(root, function(node: any) { ceMapPackChildren(node, padOut * toInternal, random); });
    }

    var k = (root.r > 0) ? ((size / 2) / root.r) : 1;
    root.x = size / 2; root.y = size / 2;
    ceMapEachBefore(root, function(node: any) {
        node.r *= k;
        if (node.parent) {
            node.x = node.parent.x + k * node.x;
            node.y = node.parent.y + k * node.y;
        }
    });
    return root;
}

// -- Building the tree from real entities -------------------------------------
// Reads the ENTITY INDEX only (EntityMeta carries id/name/type/parentId/icon), so
// a whole world costs one storyStorage read rather than one loadEntity per node.
function ceMapWouldCycle(byId: any, childId: string, parentId: string): boolean {
    var seen: any = {}, cur: any = parentId, guard = 0;
    while (cur && guard++ < 100000) {
        if (cur === childId) return true;
        if (seen[cur]) return true;
        seen[cur] = true;
        cur = byId[cur] ? byId[cur].parentId : null;
    }
    return false;
}

function ceMapBuildTree(metas: any[]): any {
    var byId: any = {}, order: string[] = [], i: number;
    for (i = 0; i < (metas || []).length; i++) {
        var m = metas[i];
        if (!m || !m.id || m.type !== 'location') continue;
        if (byId[m.id]) continue;
        byId[m.id] = {
            id: String(m.id), name: String(m.name || 'Unnamed'), icon: String(m.icon || ''),
            parentId: m.parentId ? String(m.parentId) : null,
            children: [], parent: null, depth: 0
        };
        order.push(String(m.id));
    }

    var roots: any[] = [];
    for (i = 0; i < order.length; i++) {
        var n = byId[order[i]];
        var pid = n.parentId;
        // A parent outside the location set (an item, a deleted node) makes this a
        // root rather than an orphan we drop -- a location must always be reachable.
        if (pid && byId[pid] && !ceMapWouldCycle(byId, n.id, pid)) {
            byId[pid].children.push(n);
            n.parent = byId[pid];
        } else {
            roots.push(n);
        }
    }

    if (!roots.length) return null;

    var root: any;
    if (roots.length === 1) {
        root = roots[0];
    } else {
        // Several top-level places: give them one synthetic container so the map has
        // a single frame. It is NOT selectable and carries no entity.
        root = { id: CE_MAP_ROOT_ID, name: 'World', icon: '', parentId: null, children: roots, parent: null, depth: 0 };
        for (i = 0; i < roots.length; i++) roots[i].parent = root;
    }
    ceMapEachBefore(root, function(node: any) {
        node.depth = node.parent ? (node.parent.depth + 1) : 0;
    });
    return root;
}

// -- Store, publish -----------------------------------------------------------
var ceMapStore: any = null;
function ceMapStoreInit(): void {
    if (ceMapStore) return;
    try {
        ceMapStore = createStore({
            ready: false, nodes: [], focusId: '', selectedId: '', camLocId: '',
            camera: { x: 0, y: 0, k: 1 }, note: ''
        });
    } catch (e) { api.v1.error('[AE:map] store init failed:', e); }
}

function ceMapPatch(fn: (s: any) => any): void {
    if (!ceMapStore) return;
    try {
        ceMapStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:map] patch failed:', e); }
}

async function cePublishMap(): Promise<void> {
    ceMapStoreInit();
    if (!ceMapStore) return;
    try {
        var metas: any[] = await loadEntityIndex();
        var camLoc: any = await loadPlayerLocation();
        var tree = ceMapBuildTree(metas);
        if (!tree) {
            ceMapPatch(function() {
                return { ready: true, nodes: [], camLocId: String(camLoc || ''), note: 'No locations in this world yet.' };
            });
            return;
        }
        ceMapPackHierarchy(tree, CE_MAP_VB, CE_MAP_PAD);

        var flat: any[] = [];
        ceMapEachBefore(tree, function(n: any) {
            flat.push({
                id: n.id, name: n.name, icon: n.icon, parentId: n.parentId,
                depth: n.depth, value: n.value, childCount: (n.children || []).length,
                x: n.x, y: n.y, r: n.r
            });
        });
        // Parents first so children paint over them.
        flat.sort(function(a: any, b: any) { return a.depth - b.depth; });

        ceMapPatch(function(s: any) {
            var focus = String(s.focusId || '');
            var stillThere = false;
            for (var i = 0; i < flat.length; i++) { if (flat[i].id === focus) { stillThere = true; break; } }
            // Default focus to wherever the camera is, so opening the map lands on the
            // current scene rather than on an arbitrary root.
            if (!stillThere) {
                focus = '';
                for (var j = 0; j < flat.length; j++) { if (flat[j].id === String(camLoc || '')) { focus = flat[j].id; break; } }
                if (!focus) focus = flat[0].id;
            }
            return { ready: true, nodes: flat, camLocId: String(camLoc || ''), focusId: focus, note: '' };
        });
    } catch (e) {
        api.v1.error('[AE:map] publish failed:', e);
        ceMapPatch(function() { return { ready: true, nodes: [], note: 'Could not read the world.' }; });
    }
}

// -- Label rules --------------------------------------------------------------
// TWO INDEPENDENT GATES, deliberately not one k-to-depth lookup table. A table
// keyed on depth would need retuning every time a world's shape changed, and this
// project's hierarchies are explicitly variable (a story scoped to one house is
// three levels; a world is six).
//   FIT      -- is the circle currently big enough on screen to hold the text?
//               Pure ratio of two viewBox quantities, so it needs no pixel data.
//   BAND     -- is this node near the FOCUS in the tree (an ancestor, the focus
//               itself, or one of its children)? This is the user's "current and
//               adjacent levels", anchored to focus rather than to zoom, so
//               zooming to a node moves the band for free.
// A label draws only when BOTH pass.
function ceMapBandFor(nodes: any[], focusId: string): any {
    var byId: any = {}, i: number;
    for (i = 0; i < nodes.length; i++) byId[nodes[i].id] = nodes[i];
    var band: any = {};
    var f = byId[focusId];
    if (!f) return band;
    band[f.id] = 'focus';
    var cur = f.parentId ? byId[f.parentId] : null;
    var guard = 0;
    while (cur && guard++ < 100000) {
        band[cur.id] = 'ancestor';
        cur = cur.parentId ? byId[cur.parentId] : null;
    }
    for (i = 0; i < nodes.length; i++) {
        if (nodes[i].parentId === focusId) band[nodes[i].id] = 'child';
    }
    return band;
}

// How many characters fit across this circle at the current zoom, or 0 for none.
function ceMapFitChars(r: number, k: number): number {
    var apparentDiameter = 2 * r * k;
    var glyph = CE_MAP_FONT_VB * CE_MAP_CHAR_W;
    if (glyph <= 0) return 0;
    return Math.floor((apparentDiameter * 0.86) / glyph);
}

// [ZOOM-ANCHOR, per user "pinch always zooms to the top-left corner"] Cause: changing
// camera.k while holding camera.x/y fixed pins whatever point is CURRENTLY at local (0,0)
// -- which, at the default camera {x:0,y:0}, is the viewBox's own top-left corner. This
// is not a pinch-specific bug; the +/- buttons had it too (same fix applied there).
// THE FULLY-CORRECT FIX -- keep the exact point under the pinching fingers fixed on
// screen -- IS NOT ACHIEVABLE HERE, for the same reason CE_MAP_FONT_VB and CE_MAP_VB_PER_PX
// are approximations: it requires knowing where the SVG's rendered box sits on the actual
// page (an absolute offset), which needs getBoundingClientRect, which does not exist in
// this environment (JSX-PROBE-RESULTS (4), no ownerDocument). The math was worked through
// by hand: an anchor derived from an arbitrary CLIENT coordinate needs that unknown offset
// and it does NOT cancel out algebraically once k actually changes (it only cancels for a
// pure pan, k constant, which is exactly why the panning fix above needed no such offset).
// THE ACHIEVABLE, EXACT SUBSTITUTE: anchor to the viewBox's OWN center (CE_MAP_VB/2), which
// needs no unknown offset at all -- it is a constant BY DEFINITION of viewBox +
// preserveAspectRatio:'xMidYMid', regardless of container size or position on the page.
// This is not a hack standing in for the real fix; it is the same policy zoomTo() and the
// tap-a-circle interaction already use (center the thing you're focusing on), applied
// consistently to pinch and the +/- buttons instead of leaving them as the one place that
// still zoomed around an arbitrary, uncontrolled point.
function ceMapZoomAroundCenter(camera: any, newK: number): any {
    var c = CE_MAP_VB / 2;
    var oldK = camera.k || 1;
    return {
        x: c - newK * (c - camera.x) / oldK,
        y: c - newK * (c - camera.y) / oldK,
        k: newK
    };
}

// -- The surface --------------------------------------------------------------
function _ceMapRoot(): any {
    ceMapStoreInit();
    var st = useStoreValue(ceMapStore);
    var panRef = useRef(null as any);
    var pinchRef = useRef(null as any);
    if (!panRef.current) panRef.current = { activeId: null, lastX: 0, lastY: 0 };
    if (!pinchRef.current) pinchRef.current = { ids: [], lastDist: 0 };

    useEffect(function() { cePublishMap(); }, []);

    // [v2.128.0] ceNav('scene') was ALWAYS the right call -- the bug was that this surface
    // used to live in its own separate modal (see ceRoot's 'map' branch), where nothing
    // was subscribed to the store value this patches. Now that Map is a route in the same
    // shell as Scene/Profile/Journal, this works exactly like Journal's identical back
    // button (line ~26403). No entityId is passed, and none is needed: Scene independently
    // re-derives its OWN location from loadPlayerLocation() on every fresh mount
    // (ceSceneRoot's useEffect, empty deps -- "fires once per mount," and navigating away
    // then back is a fresh mount), so this lands on whichever location is actually the
    // scene/camera location, never on whatever the Map happened to have selected.
    // [v2.146.0 NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    if (!st.nodes || !st.nodes.length) {
        // [v2.166.0 MAP-EMPTY-DOOR, per user "when starting a new story with no location,
        // the map tab is blank and provides no ability to create an initial one"] THE
        // "New place" BUTTON EXISTS -- it is in the toolbar strip below the canvas -- and
        // this early return lands ABOVE it, so on the one world where a location is most
        // needed the only door was unreachable. This is the same ceEntityCreate call the
        // toolbar makes, with an empty parent: nothing is selected because nothing exists,
        // so the first place is created at the top of the world.
        return ceScreen(ceHeader(back), ceEmpty(st.note || 'No locations in this world yet.',
            ceBtn('Create the first place', 'map:new0', function() {
                return ceEntityCreate('location', '', { surface: 'map', entityId: '', label: 'Map' });
            }, 'primary')));
    }

    var cam = st.camera || { x: 0, y: 0, k: 1 };
    var nodes: any[] = st.nodes;
    // Typed local, same reason `nodes` already is one: `st` comes off useStoreValue on a
    // store variable typed `any`, and TS's generic inference on an `any` argument yields
    // `unknown` rather than `any` at the property-read site (measured -- see
    // STORE-BEFORE-HOOK's sibling entries). Reading st.camLocId three separate times below
    // would repeat that against every one; one typed extraction fixes all three.
    var camLocId: string = String(st.camLocId || '');
    var band = ceMapBandFor(nodes, String(st.focusId || ''));

    function onDown(e: any) {
        var id = e.pointerId;
        ceMapPatch(function(s: any) {
            var nextDown: any = {}, k: string;
            for (k in (s.down || {})) nextDown[k] = s.down[k];
            nextDown[id] = { x: e.clientX, y: e.clientY };
            var ids: string[] = [];
            for (k in nextDown) ids.push(k);
            if (ids.length === 1) {
                panRef.current = { activeId: id, lastX: e.clientX, lastY: e.clientY };
            } else if (ids.length === 2) {
                var a = nextDown[ids[0]], b = nextDown[ids[1]];
                pinchRef.current = { ids: [ids[0], ids[1]],
                    lastDist: Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2)) };
            }
            return { down: nextDown };
        });
    }

    function onMove(e: any) {
        var id = e.pointerId;
        ceMapPatch(function(s: any) {
            var down = s.down || {};
            if (!(String(id) in down)) return {};
            var ids: string[] = [], k: string;
            for (k in down) ids.push(k);
            var nextCam = s.camera;
            if (ids.length >= 2 && pinchRef.current.ids.length === 2) {
                var idA = pinchRef.current.ids[0], idB = pinchRef.current.ids[1];
                var a = (String(id) === String(idA)) ? { x: e.clientX, y: e.clientY } : down[idA];
                var b = (String(id) === String(idB)) ? { x: e.clientX, y: e.clientY } : down[idB];
                if (a && b) {
                    var dist = Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
                    if (pinchRef.current.lastDist > 0) {
                        var f = dist / pinchRef.current.lastDist;
                        var newK = Math.max(0.4, Math.min(40, s.camera.k * f));
                        nextCam = ceMapZoomAroundCenter(s.camera, newK);
                    }
                    pinchRef.current.lastDist = dist;
                }
            } else if (String(panRef.current.activeId) === String(id)) {
                var dx = (e.clientX - panRef.current.lastX) * CE_MAP_VB_PER_PX;
                var dy = (e.clientY - panRef.current.lastY) * CE_MAP_VB_PER_PX;
                nextCam = { x: s.camera.x + dx, y: s.camera.y + dy, k: s.camera.k };
                panRef.current.lastX = e.clientX; panRef.current.lastY = e.clientY;
            }
            var nextDown: any = {};
            for (k in down) nextDown[k] = down[k];
            nextDown[id] = { x: e.clientX, y: e.clientY };
            return { camera: nextCam, down: nextDown };
        });
    }

    // [measured] onPointerLeave fires ~4x as often as a real interaction (127 vs 35),
    // including plain mouse-outs with nothing held. Writing state on each one is a
    // full re-render of every circle. The id is checked against the LIVE snapshot
    // inside the patch, never the outer render-time `st` -- that would be a stale
    // read of the very map being mutated.
    function clearPointer(id: any) {
        if (String(panRef.current.activeId) === String(id)) panRef.current = { activeId: null, lastX: 0, lastY: 0 };
        pinchRef.current = { ids: [], lastDist: 0 };
        ceMapPatch(function(s: any) {
            var down = s.down || {};
            if (!(String(id) in down)) return {};
            var nextDown: any = {}, k: string;
            for (k in down) { if (k !== String(id)) nextDown[k] = down[k]; }
            return { down: nextDown };
        });
    }

    function zoomTo(node: any) {
        // Frame the node at ~78% of the viewport, then centre it.
        var k = Math.max(0.4, Math.min(40, (CE_MAP_VB * 0.78) / (node.r * 2)));
        ceMapPatch(function() {
            return { camera: { x: CE_MAP_VB / 2 - node.x * k, y: CE_MAP_VB / 2 - node.y * k, k: k },
                     focusId: node.id, selectedId: node.id };
        });
    }

    var circles: any[] = [];
    var labels: any[] = [];
    var i: number;
    for (i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var isRoot = (n.id === CE_MAP_ROOT_ID);
        var isLeaf = n.childCount === 0;
        var isCam = (n.id === camLocId);
        var isSel = (n.id === st.selectedId);
        var inBand = !!band[n.id];

        circles.push(h('circle', {
            key: 'mc_' + n.id,
            cx: n.x, cy: n.y, r: n.r,
            fill: isCam ? 'rgba(232,192,125,0.14)' : (isLeaf ? 'rgba(255,255,255,0.05)' : 'rgba(255,255,255,0.02)'),
            stroke: isSel ? CE_SEM.building : (isCam ? CE_SEM.building : 'currentColor'),
            'stroke-width': (isSel ? 3 : (isCam ? 2.5 : 1.2)) / cam.k,
            'stroke-opacity': isSel || isCam ? '1' : (inBand ? '0.55' : '0.22'),
            style: { cursor: isRoot ? 'default' : 'pointer' },
            onClick: isRoot ? null : (function(nn: any) {
                return function() { ceMapPatch(function() { return { selectedId: nn.id, focusId: nn.id }; }); };
            })(n)
        }));

        if (!inBand) continue;
        var chars = ceMapFitChars(n.r, cam.k);
        if (chars < 3) continue;
        var label = n.name;
        if (n.icon) label = n.icon + ' ' + label;
        if (label.length > chars) label = label.slice(0, Math.max(1, chars - 1)) + '\u2026';
        // A parent's name rides near its top edge so it does not sit on top of its
        // children; a leaf has nothing inside it, so its name goes in the middle.
        var ly = isLeaf ? (n.y + CE_MAP_FONT_VB / (cam.k * 3)) : (n.y - n.r + (CE_MAP_FONT_VB * 1.1) / cam.k);
        labels.push(h('text', {
            key: 'ml_' + n.id,
            x: n.x, y: ly,
            'text-anchor': 'middle',
            fill: 'currentColor',
            // Ladder: an ancestor label is context for where you are, not the thing
            // itself -- t3. The current band is the content, t1.
            opacity: (band[n.id] === 'ancestor') ? CE_OP.t3 : CE_OP.t1,
            'font-size': CE_MAP_FONT_VB / cam.k,
            'font-weight': isLeaf ? '400' : '600',
            'pointer-events': 'none'
        }, label));
    }

    var selected: any = null;
    for (i = 0; i < nodes.length; i++) { if (nodes[i].id === st.selectedId) { selected = nodes[i]; break; } }

    var actionBar: any;
    if (selected && selected.id !== CE_MAP_ROOT_ID) {
        var isHere = (selected.id === camLocId);
        actionBar = h('div', {
            style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, flexWrap: 'wrap',
                padding: CE_T.s3 + ' 0', borderTop: '1px solid ' + CE_LINE }
        },
            h('div', { style: { flex: '1 1 140px', minWidth: '0' } },
                h('div', { style: { fontSize: CE_T.fs, fontWeight: '600' } },
                    (selected.icon ? selected.icon + ' ' : '') + selected.name),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                    (isHere ? 'Scene is here' : 'Depth ' + selected.depth) +
                    (selected.childCount ? ' \u00b7 ' + selected.childCount + ' inside' : ''))
            ),
            ceBtn('Zoom to', 'map:zoom:' + selected.id, function() { zoomTo(selected); return Promise.resolve(); }),
            // [v2.147.0 JSXENTITY] The door into the entity surface, and the surface list's
            // "add/edit location button" for the Map half. The return address is set HERE
            // rather than defaulted there, which is the whole NAV-BACK contract.
            ceBtn('Edit', 'map:edit:' + selected.id, function() {
                ceNav('entity', selected.id, '', { surface: 'map', entityId: '', label: 'Map' });
                return Promise.resolve();
            }),
            isHere ? null : ceBtn('Set scene location', 'map:travel:' + selected.id, function() {
                return commitTravel(selected.id, true).then(function() {
                    try { api.v1.ui.toast('Scene moved to ' + selected.name + '.', { type: 'success', autoClose: 1800 }); } catch (e) {}
                    return cePublishMap();
                });
            }, 'primary')
        );
    } else {
        actionBar = ceEmpty('Tap a place to select it.', null);
    }

    return ceScreen(ceHeader(back), [
        h('div', {
            style: { position: 'relative', width: '100%', height: CE_MAP_VIEW_H, overflow: 'hidden',
                borderRadius: CE_T.r, border: '1px solid ' + CE_LINE, background: CE_FILL,
                touchAction: 'none', cursor: 'grab' },
            onPointerDown: onDown,
            onPointerMove: onMove,
            onPointerUp: function(e: any) { clearPointer(e.pointerId); },
            onPointerLeave: function(e: any) { clearPointer(e.pointerId); }
        },
            h('svg', {
                viewBox: '0 0 ' + CE_MAP_VB + ' ' + CE_MAP_VB,
                preserveAspectRatio: 'xMidYMid meet',
                style: { width: '100%', height: '100%', display: 'block' }
            },
                h('g', { transform: 'translate(' + cam.x + ',' + cam.y + ') scale(' + cam.k + ')' },
                    circles, labels)
            )
        ),
        h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', padding: CE_T.s2 + ' 0' } },
            ceBtn('\u2212', 'map:zoomout', function() {
                ceMapPatch(function(s: any) {
                    return { camera: ceMapZoomAroundCenter(s.camera, Math.max(0.4, s.camera.k * 0.8)) };
                });
                return Promise.resolve();
            }),
            ceBtn('+', 'map:zoomin', function() {
                ceMapPatch(function(s: any) {
                    return { camera: ceMapZoomAroundCenter(s.camera, Math.min(40, s.camera.k * 1.25)) };
                });
                return Promise.resolve();
            }),
            // Creation lands ON the new record rather than dropping the user back here --
            // see ceEntityCreate. Nested under whatever is selected, or at the top of the
            // world when nothing is.
            ceBtn('New place', 'map:new', function() {
                var sel = (st && st.selectedId && st.selectedId !== CE_MAP_ROOT_ID) ? String(st.selectedId) : '';
                return ceEntityCreate('location', sel, { surface: 'map', entityId: '', label: 'Map' });
            }),
            ceBtn('Reset view', 'map:reset', function() {
                ceMapPatch(function() { return { camera: { x: 0, y: 0, k: 1 } }; });
                return Promise.resolve();
            }),
            ceBtn('Go to scene', 'map:tocam', function() {
                var target: any = null;
                for (var q = 0; q < nodes.length; q++) { if (nodes[q].id === camLocId) { target = nodes[q]; break; } }
                if (target) zoomTo(target);
                else { try { api.v1.ui.toast('The scene location is not on this map.', { type: 'info', autoClose: 1800 }); } catch (e) {} }
                return Promise.resolve();
            })
        ),
        actionBar
    ]);
}

// [v2.128.0, per user] Map shares the ONE shell modal every other surface uses, via
// ceNav('map') + ceRoot's switch -- it does NOT open its own, which is what v2.127.0 did
// and exactly why its "Scene" back button did nothing (MAP-NAV-FIX).
// [v2.131.0 SHELL-TRAY] Reduced to a wrapper: the body it used to hold IS ceOpenShell.
// Kept as a named function because '/ce map' calls it by name.
async function ceOpenMap(): Promise<void> { await ceOpenShell('map'); }


// ============================================================================
// SECTION 33 — CHAT SURFACE (jsx)
// ============================================================================
// The chat LAUNCHER and the chat-in-progress CONTROLS, in one surface: who you are
// texting, who you are texting AS, the per-thread message counts, the four display
// options, and Close / Summarize / Delete while a chat is live.
//
// THE ORDER OF THE SURFACE, top to bottom:
//   1. Open chat   -- ONLY while a chat is live: who, and Summarize / Close / Delete
//   2. \u201cText as\u201d  -- ONE remembered selector, not a strip (see POV-REMEMBERED below)
//   3. \u201cTo\u201d       -- contact list with per-(contact, pov) message counts
//   4. Last thought -- inline, read-only, never generates; only while a chat is open
//   5. Options     -- collapsed: Thoughts, Photos, avatar Size/Shape, bubble Style/Width
// (The numbered list above is the RENDER order, set at the bottom of ceChatBody. The
// section comments inside that function are still numbered in their old build order,
// which is a different thing and deliberately not renumbered -- they mark where each
// block is CONSTRUCTED, not where it lands.)
//
// [v2.131.0 POV-REMEMBERED, per user] POV IS A PERSISTED SELECTION (cfg.charChatPovId),
// rendered as a ceSelect. It was a row-per-candidate strip holding povId as STORE state,
// which reset to \u201cNo POV\u201d on every mount -- so every chat cost a POV pick even though the
// answer is nearly always the same one. Persisting it is also what makes the Profile
// launcher's Chat cell a one-tap start: there is nothing left to ask, so that path does
// not route through this surface at all. cfg is the single owner; the store's povId is a
// published COPY, never an independent value that could disagree with it.
// ceSelect is HOOK-FREE BY CONTRACT, which is why the pov control can be a select while
// the summary editor (ceField, which uses hooks) has to be its own component.
//
// [v2.131.0 CCAV-ENGINE, per user] AVATAR SIZE AND SHAPE ARE ENGINE SETTINGS. v2.130.0's
// note calling them \u201cunportable by construction\u201d is WITHDRAWN as wrong; the reasoning it
// missed: the engine authors the avatar WIDGET, so it chooses that widget's own content,
// so it can write display INTO the sentinel and the bridge paints what it is told. That
// is not the CE-IMG-OPTS mirror trap -- nothing here tracks the bridge's live state --
// it is engine-is-source / bridge-is-renderer, the same split as every other
// cross-artifact value. Changing either setting RE-EMITS the widgets for a live chat
// (ceChatSetAvatar), because the sentinels already in the document carry the old values
// and would otherwise not update until the next turn.
//
// MESSAGE COUNTS PARTITION BY (contactId, povId) EXACTLY, mirroring _ccLauncherCount
// including its empty-string normalisation on povId: a contact with a thread under a
// DIFFERENT pov reads as fresh, which is the engine's own \u201cone chat per pair\u201d rule and is
// what stops an interview thread leaking into the No POV bucket. Counts come from
// listCharChatThreads(), the same call AE_CHARCHAT_THREADS_REQ already serves -- one
// source of truth, no new message pair.
//
// STARTING A CHAT hands off to startCharChat(contactId, povId) and closes the shell. The
// conversation lives in the STORY DOCUMENT on native Send. That is a hard rule, not a
// phase: CharChat costs zero script budget precisely because it rides native Send, and
// there is no preventDefault in this environment to build a composer with.
//
// THE SUMMARY SCREEN IS A FULL SURFACE SWAP on ceChatStore.summary, never an overlay
// (JSXPROFILE-NO-OVERLAY: overlay sheets are not constructible in this environment). Its
// draft rides the MODULE VARIABLE _ceChatSummaryDraft through ceField.onType, not store
// state -- Save is a button reading a value the field commits on blur, which is exactly
// the CLICK-BEFORE-BLUR shape, and a store write would remount the textarea mid-typing.
//
// DELETE IS TWO CONTROLS, NEVER ONE THAT CHANGES ITS MIND (DESTRUCTIVE-NEVER-IN-PLACE):
// \u201cDelete chat\u201d arms and is idempotent in both states; the confirmed \u201cDelete permanently\u201d
// renders as a SEPARATE control that did not exist at the moment of the first fire. The
// tray's own Delete button routes here ARMED rather than carrying a second confirm idiom.
// ============================================================================

var ceChatStore: any = null;
function ceChatStoreInit(): void {
    if (ceChatStore) return;
    try {
        ceChatStore = createStore({
            ready: false, povId: '', roster: [], threads: [],
            freshThoughts: false, images: false,
            avSize: 40, avShape: 'round',
            // [v2.177.0 CHAT-BUBBLE-AXES] null until the first publish; every reader below
            // guards, so a pre-publish render shows the block with no controls rather than
            // throwing on a missing axis.
            bubLook: null,
            active: false, contactId: '', contactName: '', lastThought: '', note: '',
            // '' = no summary screen. summaryGen is the ceField re-seed token: a SECOND
            // summarize has to replace the textarea's contents, and FIELD-KEYLESS says that
            // is a `seed` change, not a component key bump.
            summary: '', summaryGen: 0,
            confirmDel: false
        });
    } catch (e) { api.v1.error('[AE:jsxchat] store init failed:', e); }
}

function ceChatPatch(fn: (s: any) => any): void {
    if (!ceChatStore) return;
    try {
        ceChatStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxchat] patch failed:', e); }
}

// OP-CHAIN, same reasoning as the Journal's and the image slots': every write below is
// load-modify-persist against GlobalConfig with no compare-and-swap, so two taps landing
// close together would silently discard one.
// ONE STANDING HAZARD, stated because the shape invites it: cePublishChat MUST NOT be
// wrapped in ceChatOp. Callers run it as `ceChatOp(fn).then(cePublishChat)` -- outside the
// chain -- and moving it inside would deadlock the chain against itself.
var _ceChatChain: Promise<any> = Promise.resolve();
function ceChatOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceChatChain.then(fn);
    _ceChatChain = run.catch(function() { return null; });
    return run;
}

// [v2.131.0] The summary draft. A MODULE VARIABLE, not store state, per CLICK-BEFORE-BLUR:
// in this environment a click is delivered BEFORE the blur it causes, so a Save button
// reading a blur-committed field reads the PREVIOUS value. onType writes here on every
// keystroke with no render; Save reads here.
var _ceChatSummaryDraft: string = '';

async function cePublishChat(): Promise<void> {
    ceChatStoreInit();
    if (!ceChatStore) return;
    try {
        var chars: any[] = await loadAllCharacters();
        var cfg: any = await loadConfig();
        var threads: any[] = await listCharChatThreads();

        // The bridge's own roster for this strip is cachedCharVisuals, which is the ACTIVE
        // roster -- match that rather than listing archived characters as textable.
        // Protagonist included: you can text as or to them.
        var roster: any[] = [];
        for (var i = 0; i < (chars || []).length; i++) {
            var c = chars[i];
            if (!c || !c.id) continue;
            if (c.active === false) continue;
            // [v2.142.0 STYLE2-F] pattern and role ride along so the contact CARD can
            // carry the identity hue (SS6.3 #2: in Object density the hue IS the
            // container's left border) and a sub-line that says who the person is when
            // there is no message count yet. Both come from the record already loaded
            // here -- no extra read, no new storage.
            roster.push({ id: String(c.id), name: String(c.name || 'Unknown'),
                          pattern: String(c.pattern || ''), role: String(c.occupationRole || '') });
        }

        // [v2.131.0 POV-REMEMBERED] cfg is the source. A pov naming someone deleted or
        // deactivated is CLEARED BACK TO CONFIG here, not merely dropped from this render,
        // because the Profile launcher reads the same field and the two must not disagree
        // about which thread a tap lands in.
        // NOT routed through ceChatOp on purpose: this is a corrective write racing
        // nothing, and cePublishChat is called from inside `.then()` on that chain (see
        // the hazard note on ceChatOp) -- chaining here is the one shape that could bite.
        var pov = String(cfg.charChatPovId || '');
        if (pov && pov !== CC_POV_INTERVIEW) {
            var stillThere = false;
            for (var j = 0; j < roster.length; j++) { if (roster[j].id === pov) { stillThere = true; break; } }
            if (!stillThere) {
                pov = '';
                try { await mutConfig(function(cc: any) { cc.charChatPovId = ''; }); }
                catch (_ePv) { api.v1.error('[AE:jsxchat] stale pov clear failed:', _ePv); }
            }
        }

        // lastThought is READ-ONLY and is derived exactly as the EVT_CHARCHAT_STATE
        // broadcast derives it. This never generates a thought.
        var lastThought = '';
        var contactName = '';
        var active = !!_aeCharChat.active;
        if (active && _aeCharChat.contactId) {
            contactName = String(_aeCharChat.contactName || '');
            try {
                var thChar: any = await loadCharacter(_aeCharChat.contactId);
                if (thChar && thChar.ephemeral && thChar.ephemeral.compressedLine) {
                    lastThought = String(thChar.ephemeral.compressedLine).trim();
                }
            } catch (_eTh) { lastThought = ''; }
        }

        var disp = ceChatAvatarDisplay(cfg);
        // [v2.174.0 CHAT-BUBBLE-STYLE] Same one-resolver discipline as disp above: the
        // surface never reads cfg.charChatBubble* directly, so a select can never render a
        // value the decoration rules are not actually using.
        var bub = ceChatBubbleDisplay(cfg);

        ceChatPatch(function(s: any) {
            return {
                ready: true, roster: roster, threads: threads, povId: pov,
                freshThoughts: !!(cfg && cfg.charChatFreshThoughts),
                images: !!(cfg && cfg.charChatImages),
                avSize: disp.size, avShape: disp.shape,
                // The WHOLE resolved look, not two ids: the surface renders one control per
                // axis and gates on CE_CB_FRAME, and re-deriving that from a config copy
                // would be a second resolver to keep in step with the first.
                bubLook: bub,
                active: active,
                contactId: String(_aeCharChat.contactId || ''),
                contactName: contactName, lastThought: lastThought, note: '',
                // A chat that ended (from the tray, or from the story) while the confirm was
                // armed must not leave a live Delete control standing over nothing.
                confirmDel: active ? !!s.confirmDel : false
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsxchat] publish failed:', e);
        ceChatPatch(function() { return { ready: true, note: 'Could not read the chat roster.' }; });
    }
}

// Message count for one (contactId, povId) pair. Mirrors _ccLauncherCount exactly,
// including the empty-string normalisation on povId.
function ceChatCount(threads: any[], contactId: string, povId: string): number {
    for (var i = 0; i < (threads || []).length; i++) {
        var t = threads[i];
        if (t && t.contactId === contactId && String(t.povId || '') === String(povId || '')) {
            return Number(t.turnCount) || 0;
        }
    }
    return 0;
}

// [v2.131.0 POV-REMEMBERED] The saved pov resolved FOR ONE CONTACT. Two callers -- this
// surface and the Profile launcher's one-tap Chat cell -- and they must not disagree about
// which thread a tap lands in, so the \u201cyou cannot text as and to the same person\u201d rule
// lives here rather than being restated at each site. The interview sentinel is exempt: it
// is not a character, so it can never collide with a contactId.
function ceChatSavedPov(cfg: any, contactId: string): string {
    var pv = String((cfg && cfg.charChatPovId) || '');
    if (!pv) return '';
    if (pv !== CC_POV_INTERVIEW && pv === String(contactId || '')) return '';
    return pv;
}

function ceChatSetPov(id: string): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) { c.charChatPovId = String(id || ''); });
    }).then(function() { return cePublishChat(); });
}

// [v2.131.0 CCAV-ENGINE] Write a display setting, then RE-EMIT the widgets. The re-emit is
// the non-obvious half: the sentinels already in the document carry the values that were
// current when they were written, so without this the change is invisible until the next
// turn happens to rebuild them. refreshCharChatImageWidgets is clear-and-rebuild from the
// document tags and early-returns with no chat open, so this is cheap and idempotent.
function ceChatSetAvatar(field: string, value: any): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) {
            if (field === 'size') { c.charChatAvatarSize = Number(value) || 40; }
            else { c.charChatAvatarShape = String(value || 'round'); }
        });
    }).then(function() {
        return refreshCharChatImageWidgets().catch(function(e: any) {
            aeLog('[AE:jsxchat] avatar widget re-emit failed (change lands next turn):', e);
            return null;
        });
    }).then(function() { return cePublishChat(); });
}

// [v2.174.0 CHAT-BUBBLE-STYLE, per user] Write a bubble setting, then RESTYLE THE LIVE
// CHAT IN PLACE. The re-apply is the non-obvious half and it is a different mechanism from
// ceChatSetAvatar's above, for a structural reason worth stating: an avatar is a WIDGET
// whose content was written into the document when it was created, so changing it means
// re-emitting the widgets. A bubble is a RULE, and decorations.updateRules takes a partial
// rule including `style` (verified in script-types.txt: `(Partial<DecorationRule> & { id:
// string })[]`), so the restyle is one call that touches no document content at all and
// leaves every scope exactly as refreshCharChatDecorations last set it. Passing style
// WITHOUT scope is what makes that true -- adding a scope here would silently blow away
// the section classification.
//
// NO-OP WHEN NO CHAT IS OPEN, and that is correct rather than a missed case: the rules are
// registered by _charchatRegisterDecorations at chat start, which reads config through the
// same resolver, so a setting changed while closed is picked up by the next chat anyway.
// [v2.177.0 CHAT-BUBBLE-AXES] ONE WRITER FOR THIRTEEN FIELDS PLUS THE SEED. The restyle
// half below is unchanged and is still the non-obvious part; what changed is only WHAT gets
// written before it.
//
// A SEED CLEARS THE HEX OVERRIDES, and that is the one judgement call in this function.
// Tapping Terminal while carrying a custom magenta POV hex would otherwise give you
// Terminal-but-magenta and no way to tell which half you were looking at -- the seed is a
// WHOLE LOOK, so it sets the whole look. The hex fields are one keystroke to put back and
// are visibly empty afterwards, so nothing is lost silently.
function ceChatSetBubble(field: string, value: any): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) {
            if (field === 'seed') {
                var cbSd: any = CE_CB_SEEDS[String(value || '')] || CE_CB_SEEDS['chat'];
                c.charChatBubbleFrame   = cbSd.frame;
                c.charChatBubbleCorner  = cbSd.corner;
                c.charChatBubbleFill    = cbSd.fill;
                c.charChatBubbleEdge    = cbSd.edge;
                c.charChatBubbleDepth   = cbSd.depth;
                c.charChatBubbleType    = cbSd.type;
                c.charChatBubbleVoice   = cbSd.voice;
                c.charChatBubblePalette = cbSd.palette;
                c.charChatBubbleAccent  = cbSd.accent;
                c.charChatPovColor      = '';
                c.charChatContactColor  = '';
                c.charChatAccentColor   = '';
                return;
            }
            if (field === 'width') { c.charChatBubbleWidth = Number(value) || 78; return; }
            var cbKey = String(CE_CB_FIELD_KEY[String(field || '')] || '');
            if (!cbKey) { aeLog('[AE:jsxchat] unknown bubble field ignored: ' + String(field)); return; }
            c[cbKey] = String(value == null ? '' : value).trim();
        });
    }).then(function() {
        // [v2.178.0 CHAT-LANE] The TOKEN push is NOT gated on an open chat, unlike the rule
        // restyle below it: the bridge's CSS variables are page-level and a photo card from
        // a previous chat is still on screen after it closes.
        if (!_aeCharChat.active) return broadcastChatBubbleStyle();
        return loadConfig().then(function(bcCfg: any) {
            var bcD = ceChatBubbleDisplay(bcCfg);
            var bcB = _charchatBubbleRules(bcD);
            return api.v1.editor.decorations.updateRules([
                { id: AE_CHARCHAT_RULE_MARKER,  style: bcB.marker },
                { id: AE_CHARCHAT_RULE_POV,     style: bcB.pov },
                { id: AE_CHARCHAT_RULE_CONTACT, style: bcB.contact },
                { id: AE_CHARCHAT_RULE_EMOTION, style: bcB.emotion },
                { id: AE_CHARCHAT_RULE_HEAD,    style: bcB.head },
                { id: AE_CHARCHAT_RULE_EMOBOX,  style: bcB.emobox }
            ]).then(function() { return broadcastChatBubbleStyle(); });
        }).catch(function(e: any) {
            aeLog('[AE:jsxchat] bubble restyle failed (change lands on the next chat):', e);
            return null;
        });
    }).then(function() { return cePublishChat(); });
}

// [v2.131.0] The jsx replacement for _charchatShowSummaryModal, and the entry point for
// BOTH the tray's Summarize button and the surface's own. Same generator, same
// destination; the surface is the only difference. Keeps the chat open -- Summarize was
// always a preview action and still is.
async function ceChatSummarize(): Promise<void> {
    if (!_aeCharChat.active) {
        try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e0) {}
        return;
    }
    try { api.v1.ui.toast('Summarizing\u2026', { type: 'info', autoClose: 2000 }); } catch (_e1) {}
    var ccSum = '';
    try { ccSum = await previewSummarizeCharChat(); }
    catch (e) { api.v1.error('[AE:jsxchat] summarize failed:', e); ccSum = ''; }
    if (!ccSum) {
        try { api.v1.ui.toast('Nothing to summarize yet.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return;
    }
    _ceChatSummaryDraft = ccSum;
    ceChatStoreInit();
    ceChatPatch(function(s: any) {
        return { summary: ccSum, summaryGen: (Number(s.summaryGen) || 0) + 1, confirmDel: false };
    });
    await ceOpenShell('chat');
}

// [v2.131.0 CC-TRAY] The tray's Delete button lands here: it ARMS the confirm and opens the
// surface, so the destructive control the user finally presses is one they can see in
// context (who the chat is with, how many messages) rather than a bare tray glyph.
async function ceOpenChatConfirmDelete(): Promise<void> {
    if (!_aeCharChat.active) {
        try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e0) {}
        return;
    }
    ceChatStoreInit();
    ceChatPatch(function() { return { confirmDel: true, summary: '' }; });
    await ceOpenShell('chat');
}

// -- Summary screen -----------------------------------------------------------
// A REAL COMPONENT, mounted with h(), not a bare call -- for the same reason
// _ceProfileImagesDrill is (IMG-SLOT-COMPONENT): it renders a ceField, ceField uses hooks,
// and it is reached CONDITIONALLY from _ceChatRoot. A conditional bare call would make the
// root's hook order depend on whether a summary exists, which is the one thing hooks
// cannot tolerate. Mounted through h() it gets its own isolated hook space and the root's
// own two hooks stay unconditional.
function _ceChatSummaryScreen(props: any): any {
    var sumWho = String(props.contactName || 'them');
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.5' } },
            'A prose recap of the conversation so far, written in the story\u2019s own voice \u2014 not a '
          + 'transcript. Edit it, then keep it as a journal entry for ' + sumWho + ', or discard it. '
          + 'The chat stays open either way.'),
        h(ceField, {
            // FIELD-KEYLESS: a second Summarize has to replace what is in the box, and the
            // reset token is `seed`, not a bumped component key.
            seed: 'ccsum:' + String(props.gen || '0'),
            k: 'ccsum',
            label: '',
            value: String(props.text || ''),
            multiline: true,
            rows: 8,
            well: true,
            onType: function(v: string) { _ceChatSummaryDraft = v; },
            onCommit: function(v: string) { _ceChatSummaryDraft = v; return Promise.resolve(); }
        }),
        h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
            ceBtn('Save to journal', 'ccsum:save', function() {
                // Reads the SCRATCHPAD, not the record and not the field -- see the
                // _ceChatSummaryDraft declaration for why the obvious version is wrong.
                return saveCharChatSummaryToJournal(_ceChatSummaryDraft).then(function(ok: boolean) {
                    if (!ok) {
                        try { api.v1.ui.toast('Nothing to save.', { type: 'warning', autoClose: 3000 }); } catch (_eS0) {}
                        return null;
                    }
                    try { api.v1.ui.toast('Summary saved to ' + sumWho + '\u2019s journal.', { type: 'success', autoClose: 3000 }); } catch (_eS1) {}
                    _ceChatSummaryDraft = '';
                    ceChatPatch(function() { return { summary: '' }; });
                    return null;
                });
            }, 'primary'),
            ceBtn('Discard', 'ccsum:discard', function() {
                _ceChatSummaryDraft = '';
                ceChatPatch(function() { return { summary: '' }; });
                return Promise.resolve();
            })
        )
    );
}

// [v2.177.0 CHAT-BUBBLE-AXES] Options for one axis table, in the table's own key order.
// Built FROM the table rather than listed at the call site, so a new value is one edit in
// one place and this select can never offer an id the builder does not know.
function _ceCbOpts(table: any): any[] {
    var out: any[] = [];
    var k: string;
    for (k in table) {
        if (!Object.prototype.hasOwnProperty.call(table, k)) continue;
        out.push({ id: k, label: String(table[k].label || k) });
    }
    return out;
}

// The bubble block. GATING IS THE POINT OF THE FRAME LOOKUP: a control that cannot change
// anything is NOT RENDERED, rather than rendered and ignored. Pick Frame 'none' and Corner,
// Fill and Edge leave the list, because with no box there is no radius, no fill and no
// border for them to set -- and a select that visibly does nothing is worse than an absent
// one. Depth stays under every frame because its bloom branch degrades to a textShadow,
// which needs no box (see _charchatBubbleRules).
//
// EVERY ROW IS KEYED, and that is not decoration. Gating CHANGES THE LENGTH of this child
// list, and an unkeyed list is matched by position -- the same failure TABBODY-KEY and
// ROUTE-KEY closed one and two levels up. Without keys, hiding Corner would hand the Fill
// select the Corner select's DOM node and its committed value.
function _ceChatBubbleBlock(look: any): any {
    if (!look) return ceEmpty('Bubble settings load with the chat list.', null);
    var cbFr: any = CE_CB_FRAME[String(look.frame)] || CE_CB_FRAME['bubble'];

    var cbSeeds: any[] = [];
    var cbSk: string;
    for (cbSk in CE_CB_SEEDS) {
        if (!Object.prototype.hasOwnProperty.call(CE_CB_SEEDS, cbSk)) continue;
        cbSeeds.push((function(sid: string, slab: string) {
            return ceBtn(slab, 'chat:bub:seed:' + sid, function() { return ceChatSetBubble('seed', sid); });
        })(cbSk, String(CE_CB_SEEDS[cbSk].label)));
    }

    var rows: any[] = [];
    var addRow = function(key: string, label: string, hint: string, control: any) {
        rows.push(h('div', { key: 'cb:' + key }, ceSettingRow(label, hint, control)));
    };
    var axisRow = function(key: string, label: string, hint: string, table: any, cur: string) {
        addRow(key, label, hint, ceSelect({
            k: 'chat:bub:' + key, value: String(cur), options: _ceCbOpts(table),
            onCommit: function(v: string) { return ceChatSetBubble(key, v); }
        }));
    };

    axisRow('frame', 'Frame', 'What kind of box a message is drawn in.', CE_CB_FRAME, look.frame);
    if (cbFr.corner) {
        axisRow('corner', 'Corner', 'Rounding. Also sets the padding that keeps text off the curve.',
            CE_CB_CORNER, look.corner);
    }
    if (cbFr.fill) {
        axisRow('fill', 'Fill', 'How strongly the message is tinted. Frosted blurs what is behind it \u2014 experimental.',
            CE_CB_FILL, look.fill);
    }
    if (cbFr.edge !== 'none') {
        axisRow('edge', 'Edge', 'Weight of the outline.', CE_CB_EDGE, look.edge);
    }
    axisRow('depth', 'Depth', 'Shadow, inner highlight, or an outward glow.', CE_CB_DEPTH, look.depth);
    axisRow('type', 'Typeface', 'The lettering messages are set in.', CE_CB_TYPE, look.type);
    axisRow('voice', 'Voice', 'Slant, letter spacing and size.', CE_CB_VOICE, look.voice);
    axisRow('palette', 'Palette', 'The pair of colours \u2014 yours and theirs.', CE_CB_PALETTE, look.palette);
    axisRow('accent', 'Accent', 'The divider line and the emotion tagline.', CE_CB_ACCENT, look.accent);
    axisRow('lane', 'Lane', 'Inset leaves room beside a message for the portrait. Full row fills the '
        + 'column and keeps the text clear of it instead.', CE_CB_LANE, look.lane);

    // Gated like the rest: Full row IS the width, so a width control under it would set
    // nothing. Same rule as Corner under Frame 'none'.
    if (String(look.lane) !== 'full') {
        addRow('width', 'Width', 'How far a long message runs before it wraps.',
            ceSelect({
                k: 'chat:bub:width', value: String(look.width || 78),
                options: [{ id: '66', label: 'Narrow' }, { id: '78', label: 'Medium' }, { id: '88', label: 'Wide' }],
                onCommit: function(v: string) { return ceChatSetBubble('width', Number(v)); }
            }));
    }

    // FREE COLOUR, and it is a text field rather than a swatch grid for a measured reason:
    // this shell has no usable colour input. type='range' is recorded as untrustworthy here
    // and type='color' is ruled out, so the only honest ways to reach an arbitrary hue are a
    // grid of fixed swatches (which is just a longer palette list) or the hex itself.
    // EMPTY IS THE UNDO -- clearing the box hands the slot back to the palette.
    var hexRow = function(key: string, label: string, cur: string) {
        rows.push(h('div', { key: 'cb:' + key }, h(ceField, {
            k: 'chat:bub:' + key, seed: 'cb:' + key + ':' + String(cur || ''),
            label: label, value: String(cur || ''), placeholder: 'palette',
            onCommit: function(v: string) { return ceChatSetBubble(key, v); }
        })));
    };
    hexRow('povHex',  'Your colour (hex)',      look.povRaw);
    hexRow('themHex', 'Their colour (hex)',     look.themRaw);
    hexRow('accHex',  'Accent colour (hex)',    look.accRaw);
    hexRow('ink',     'Text colour (hex)',      look.ink);

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { key: 'cb:seedhint', style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
            'Start from one of these, then change anything. They set the controls below \u2014 they are not modes.'),
        h('div', { key: 'cb:seeds', style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, cbSeeds),
        h('div', { key: 'cb:rows', style: { display: 'flex', flexDirection: 'column' } }, rows)
    );
}

function _ceChatRoot(): any {
    ceChatStoreInit();
    // BOTH HOOKS RUN UNCONDITIONALLY, before every branch below. Everything conditional on
    // this surface is either a plain element or a component mounted with h().
    var st = useStoreValue(ceChatStore);
    // [v2.142.0 STYLE2-F] SUBSCRIBED, not .get(). The Options group is a ceAccordion now and
    // its open state lives in ceUiStore.open; without this subscription ceToggleOpen would
    // write the map and nothing on this surface would ever repaint to read it. Placed with
    // the other hook, above every branch, per this function's own opening rule.
    var ui = useStoreValue(ceUiStore);
    useEffect(function() { cePublishChat(); }, []);

    // [v2.146.0 NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    // -- Summary: FULL SURFACE SWAP, never an overlay -------------------------
    if (st.summary) {
        var sBack = ceBtn('\u2190 Chat', 'chat:sum:back', function() {
            ceChatPatch(function() { return { summary: '' }; });
            return Promise.resolve();
        });
        return ceScreen(
            ceHeader(sBack),
            [h(_ceChatSummaryScreen, {
                text: String(st.summary),
                gen: String(st.summaryGen || 0),
                contactName: st.contactName
            })]
        );
    }

    var povId: string = String(st.povId || '');
    var roster: any[] = st.roster || [];
    var threads: any[] = st.threads || [];
    var i: number;

    // -- 1. Open chat ---------------------------------------------------------
    // [v2.131.0 CC-TRAY] The bridge chat manager's three verbs, rendered only while there
    // is a chat to act on. Close saves the thread and strips the document; Summarize is a
    // preview that keeps the chat open; Delete discards the thread AND strips the document.
    var openBlock: any = null;
    if (st.active) {
        var mgr: any[] = [];
        mgr.push(ceBtn('Close chat', 'chat:mgr:close', function() {
            return endCharChat('save').then(function() { return cePublishChat(); });
        }, 'primary'));
        mgr.push(ceBtn('Summarize', 'chat:mgr:summ', function() { return ceChatSummarize(); }));
        // DESTRUCTIVE-NEVER-IN-PLACE: this control keeps ONE idempotent handler in both
        // states (arming twice costs nothing), so the second of a double-fire cannot land
        // on a handler that was swapped in between the two.
        mgr.push(ceIconBtn('Delete chat', ceIconTrash(), 'chat:mgr:arm', function() {
            ceChatPatch(function() { return { confirmDel: true }; });
            return Promise.resolve();
        }, 'danger'));
        if (st.confirmDel) {
            mgr.push(ceBtn('Delete permanently', 'chat:mgr:del', function() {
                return endCharChat('discard').then(function() {
                    ceChatPatch(function() { return { confirmDel: false }; });
                    return cePublishChat();
                });
            }, 'danger'));
            mgr.push(ceBtn('Keep it', 'chat:mgr:keep', function() {
                ceChatPatch(function() { return { confirmDel: false }; });
                return Promise.resolve();
            }));
        }
        openBlock = ceSection('Open chat \u2014 ' + (st.contactName || 'someone'),
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                st.confirmDel
                    ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.5', color: CE_SEM.ask } },
                        'Deleting removes the conversation from your story and deletes its saved thread. This cannot be undone.')
                    : null,
                h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, mgr)
            ));
    }

    // -- 2. Options -----------------------------------------------------------
    // Thoughts and Photos are the same two config toggles the bridge's settings row owns,
    // same labels, same ON/off casing. Both work PRE-chat (they sit above the engine's
    // active-chat guard), which is why they are here rather than inside an open chat.
    var optionRow = h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
        ceBtn('Thoughts: ' + (st.freshThoughts ? 'ON' : 'off'), 'chat:opt:thoughts', function() {
            return ceChatOp(function() {
                return mutConfig(function(c: any) { c.charChatFreshThoughts = !c.charChatFreshThoughts; });
            }).then(function() { return cePublishChat(); });
        }, st.freshThoughts ? 'primary' : undefined),
        ceBtn('Photos: ' + (st.images ? 'ON' : 'off'), 'chat:opt:images', function() {
            return ceChatOp(function() {
                return mutConfig(function(c: any) { c.charChatImages = !c.charChatImages; });
            }).then(function() { return cePublishChat(); });
        }, st.images ? 'primary' : undefined)
    );

    // [v2.177.0 CHAT-BUBBLE-AXES] The bubble block moved OUT of avatarRows and into its own
    // accordion below: eleven controls is a surface, not a row in somebody else's list.
    var avatarRows = h('div', { style: { display: 'flex', flexDirection: 'column' } },
        ceSettingRow('Avatar size', 'How wide avatars are painted beside each reply.',
            ceSelect({
                k: 'chat:av:size', value: String(st.avSize),
                options: [{ id: '28', label: 'Small' }, { id: '40', label: 'Medium' }, { id: '52', label: 'Large' }],
                onCommit: function(v: string) { return ceChatSetAvatar('size', Number(v)); }
            })),
        ceSettingRow('Avatar shape', 'Portrait matches the 832\u00d71216 image frame; size stays the width.',
            ceSelect({
                k: 'chat:av:shape', value: String(st.avShape),
                options: [{ id: 'round', label: 'Round' }, { id: 'rounded', label: 'Rounded' }, { id: 'portrait', label: 'Portrait' }],
                onCommit: function(v: string) { return ceChatSetAvatar('shape', v); }
            }))
    );

    // -- 3. Last thought ------------------------------------------------------
    // Persistent inline display, matching the bridge's v2.53.1 THOUGHT-INLINE-DISPLAY
    // decision (it was a tap-to-toast before that, and the popup was removed on purpose).
    // Three states, same as the bridge: no chat open / open but nothing yet / the thought.
    var thoughtHas = !!(st.active && st.lastThought);
    var thoughtBody = !st.active
        ? 'No chat open.'
        : (thoughtHas ? String(st.lastThought) : 'No thought yet.');
    var thoughtBlock = h('div', {
        style: { display: 'flex', flexDirection: 'column', gap: '2px',
            borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3 }
    },
        ceH3('Last thought' + (st.active && st.contactName ? ' \u2014 ' + st.contactName : '')),
        h('div', {
            style: { fontSize: CE_T.fsSm, lineHeight: '1.5',
                // Ladder: model-produced text is t1; the empty state is SS10.1's
                // "placeholder in t3 italic" exactly, and the italic is already below.
                opacity: thoughtHas ? CE_OP.t1 : CE_OP.t3,
                fontStyle: thoughtHas ? 'normal' : 'italic' }
        }, thoughtBody)
    );

    // -- 4. \u201cText as\u201d ---------------------------------------------------------
    // [v2.131.0 POV-REMEMBERED] ONE selector that remembers itself, replacing the
    // row-per-candidate strip. No POV and Interview are pinned first, then every active
    // character -- the bridge's order, preserved. Committing writes cfg and republishes;
    // there is no round trip for the counts, which are already in `threads` for every pair.
    var povOpts: any[] = [
        { id: '', label: 'No POV \u2014 text as yourself' },
        // [CCINT] The interview POV is a sentinel id, not a character, and its counts
        // partition like any other pov.
        { id: CC_POV_INTERVIEW, label: 'Interview \u2014 out of story' }
    ];
    for (i = 0; i < roster.length; i++) { povOpts.push({ id: roster[i].id, label: roster[i].name }); }
    // [v2.142.0 STYLE2-F] A ceRow, not a ceSettingRow. This is not a setting sitting among
    // other settings -- it is the SCOPE OF THE LIST BELOW IT (the contact list filters the
    // POV out of itself, and the message counts are per pair), so it belongs directly above
    // that list at the list's own density, in one dense line rather than a label + a
    // two-clause hint + a control. The dropped hint said the choice is remembered; it is,
    // and one use of the control demonstrates that better than a permanent sentence does.
    var povBlock = ceRow('Text as',
        ceSelect({ k: 'chat:pov', value: povId, options: povOpts,
            onCommit: function(v: string) { return ceChatSetPov(v); } }),
        null);

    // -- 5. Contact list (\u201cTo\u201d) -----------------------------------------------
    // Every active character EXCEPT whoever is the POV -- you cannot text as and to the
    // same person. Counts are per (contact, pov).
    // [v2.142.0 STYLE2-F, per user] "This is supposed to replicate a phone's contacts list"
    // and the contacts are THE FEATURE of this surface. Two changes follow from that:
    //
    // (1) EACH CONTACT IS A ceCard, not a hairline row. SS7.3's test is mechanical -- these
    // are many DISTINCT RECORDS, which is Object density, which is the one density that
    // draws a box. It is the same call already made for the Scene roster. The avatar grows
    // to 44px (a contacts list is a list of faces), the name is ceH, and the identity hue
    // becomes the card's left border per SS6.3 #2 rather than an 8px dot -- a contacts list
    // is precisely where knowing whose screen this is has to be readable at a glance.
    //
    // (2) THE SUB-LINE FALLS BACK TO WHO THEY ARE. Previously an unstarted chat read
    // "Start a chat" on every single row -- N copies of one instruction where the row's own
    // identity could have gone. The verb is what tapping a card obviously does; the role is
    // information you cannot get any other way on this surface.
    var contactRows: any[] = [];
    for (i = 0; i < roster.length; i++) {
        contactRows.push((function(vis: any) {
            if (vis.id === povId) return null;
            var count = ceChatCount(threads, vis.id, povId);
            var pat = CE_PATTERN_DEFS[String(vis.pattern || '')] || null;
            var sub = (count > 0)
                ? (count + (count === 1 ? ' message' : ' messages'))
                : (String(vis.role || '').trim()
                    || ((povId === CC_POV_INTERVIEW) ? 'Start an interview' : 'Start a chat'));
            return ceCard({
                key: 'chatto_' + vis.id,
                hue: pat ? pat.c : '',
                opId: 'chat:start:' + vis.id,
                onClick: function() {
                    // ceAction IS STILL HERE, INSIDE the handler. ceCard's own guard is
                    // ceTap (the event boundary), which is the double-fire guard and is NOT
                    // an in-flight latch -- TAP-GUARD says so outright. The pre-card row
                    // wrapped this call in both, and starting a chat writes to the story
                    // document and then closes the shell, so losing the latch would have
                    // been a real regression rather than a tidy-up.
                    return ceAction('chat:start:' + vis.id, function() {
                        // Hands off to the story document and closes the shell -- the
                        // conversation lives in the story on native Send, never here.
                        return startCharChat(vis.id, povId).then(function() {
                            try {
                                if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); }
                            } catch (_eCl) {}
                        });
                    });
                },
                children: h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3 } },
                    h('div', ceImgAnchor(vis.id, CE_IMG_SLOT_AVATAR, {
                        style: { flex: '0 0 auto', width: '44px', height: '44px', borderRadius: CE_T.rPill,
                            background: CE_FILL, position: 'relative', overflow: 'hidden' }
                    }, CE_IMG_SHRINK)),
                    h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                        ceH(vis.name),
                        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                            overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, sub)
                    ),
                    count > 0
                        ? h('div', { style: { flex: '0 0 auto' } }, ceMono(String(count), { opacity: CE_OP.t2 }))
                        : null
                )
            });
        })(roster[i]));
    }
    var anyContact = false;
    for (i = 0; i < contactRows.length; i++) { if (contactRows[i]) { anyContact = true; break; } }

    // [v2.142.0 STYLE2-F, per user] THE ORDER IS THE FIX. Options used to be the SECOND
    // thing on the surface and the contact list the LAST, so four toggles and two selects
    // stood between opening Chat and doing the only thing Chat is for. Reading order now
    // matches importance: whatever is live, then who you can talk to, then the settings
    // that shape it.
    //   1. the open chat, if there is one -- it is the only thing more urgent than the list
    //   2. Text as (the list's scope) + the contact list itself
    //   3. the last thought, ONLY while a chat is open. It previously rendered "No chat
    //      open." as a permanent block on a surface whose whole job is starting one; an
    //      empty state for a thing you have not started yet is chrome, not information.
    //   4. Options, COLLAPSED. Thoughts/Photos/avatar size/shape are set rarely and changed
    //      almost never. ceAccordion is the correct primitive here and not the one
    //      STYLE2-LIST-SPLIT ruled against: this is ONE record that expands to show its own
    //      fields, which is exactly its job -- it is a LIST of records that was the misuse.
    //
    // [v2.174.0 CHAT-POV-ABOVE-TO, per user] "Text as" SITS ABOVE "To", not inside it.
    // It used to be the first child of ceGroup('To', ...), which put the group's own "To"
    // head ABOVE the pov selector and read backwards: you were asked who to text, then
    // interrupted by who you are texting AS, then given the list. The two are read in the
    // order they are decided -- identity first, then recipient -- and the v2.142.0 note
    // above is unaffected: pov is still the list's SCOPE and still directly adjacent to it,
    // just on the other side of the group head.
    var body: any[] = [];
    if (openBlock) { body.push(openBlock); }
    body.push(povBlock);
    body.push(ceGroup('To',
        anyContact
            ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, contactRows)
            : ceEmpty('No characters to text yet.', null)));
    if (st.active) { body.push(thoughtBlock); }
    body.push(ceAccordion({
        id: 'chat:opts', label: 'Options', open: !!(ui && ui.open && ui.open['chat:opts']),
        summary: 'Thoughts ' + (st.freshThoughts ? 'on' : 'off')
               + ' \u00b7 Photos ' + (st.images ? 'on' : 'off'),
        children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            optionRow, avatarRows)
    }));
    // [v2.177.0 CHAT-BUBBLE-AXES] Its own accordion rather than more rows inside Options:
    // eleven controls under a heading called 'Options' is where a settings list stops
    // being scannable. Collapsed by default, and the summary says what is set so the
    // current look is legible without opening it.
    body.push(ceAccordion({
        id: 'chat:bubble', label: 'Bubble style', open: !!(ui && ui.open && ui.open['chat:bubble']),
        summary: st.bubLook
            ? (String((CE_CB_FRAME[String(st.bubLook.frame)] || {}).label || '\u2014')
               + ' \u00b7 ' + String((CE_CB_PALETTE[String(st.bubLook.palette)] || {}).label || '\u2014')
               + ' \u00b7 ' + String((CE_CB_TYPE[String(st.bubLook.type)] || {}).label || '\u2014'))
            : 'Loading\u2026',
        children: _ceChatBubbleBlock(st.bubLook)
    }));
    if (st.note) { body.unshift(ceEmpty(String(st.note), null)); }

    return ceScreen(ceHeader(back), body);
}

// ============================================================================
// SECTION 34 — SETTINGS SURFACE (jsx)  [v2.132.0 JSXSETTINGS]
// ============================================================================
// Everything global: the world vocabulary, the factions, and the engine's own knobs.
// THREE TABS —
//   World    Species / Relationship Archetypes / Conditions / Lorebook Additions
//   Factions faction records and their linked lorebook entries
//   System   Timing / Generation Style / Static Field Settings / Scene Background /
//            Generation Diagnostics / Interface
//
// TABS ARE ceTabGet / ceTabSet (SECTION 28), NOT ceNav. ceNav resets entityId/back on
// every call, which is correct for SURFACE navigation and wrong for a tab switch within
// the surface you are already on. The pair namespaces the stored value as
// '<surface>:<tabId>' so a second tabbed surface cannot read this one's tab out of the
// shared slot. Both patch ui.tab alone, through the same shallow-merge ceUiPatch every
// other local-state write uses.
//
// NO LIVE
// SLIDER. The native surface used sliderInput for every interval/budget/cap value;
// script-types_d.txt's ScriptInputAttributes DOES declare min/max/step, so a
// type='range' input is syntactically legal here, but NOTHING about its behaviour in
// this jsx sandbox has ever been measured — no probe, no live report. ceField's entire
// design (uncontrolled, ref-seeded, blur-commit) exists because value= was MEASURED to
// destroy uncommitted keystrokes on a re-render (JSX-PROBE-RESULTS 2, probe A8) and
// onInput was MEASURED to multi-fire with stale values at word boundaries. A range
// input's natural shape is continuous onInput plus a controlled value= — the exact
// combination already on record as unsafe for text, and untested for range. ceNumField
// below is a clamped, blur-commit TEXT field instead. A live slider stays open for
// whoever probes onInput's behaviour on a range input first.
//
// DESTRUCTIVE-NEVER-IN-PLACE, all five deletes. Species / Relationship Archetype /
// Condition / Faction / Custom Field all use the same two-step arm-then-confirm shape
// (_ceSettingsDeleteBtn / _ceSettingsConfirmRow).
//
// KNOWN GAP: Species/Faction deletion does NOT unlink the associated lorebook entry, so
// an orphaned entry is left behind. Recorded, not fixed.
// ============================================================================

var ceSettingsStore: any = null;
function ceSettingsStoreInit(): void {
    if (ceSettingsStore) return;
    try {
        ceSettingsStore = createStore({
            ready: false, cfg: null,
            confirm: '',              // delete-confirm target key, e.g. 'species:sp_123'
            diagLog: '', diagCount: 0, diagErr: 0
        });
    } catch (e) { api.v1.error('[AE:jsxsettings] store init failed:', e); }
}

function ceSettingsPatch(fn: (s: any) => any): void {
    if (!ceSettingsStore) return;
    try {
        ceSettingsStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxsettings] patch failed:', e); }
}

// OP-CHAIN, same reasoning as Journal / Image Slots / Chat: every write here is
// load-modify-persist against GlobalConfig with no compare-and-swap, and this surface
// has FIVE independently-editable lists (species, archetypes, conditions, factions,
// custom fields) plus the system tab's scalars all sharing the one config object, so the
// overlap hazard is wider here than on any prior surface. One chain for the whole
// surface, not one per list — two edits in DIFFERENT lists landing close together are
// exactly as capable of racing each other as two edits in the same one.
var _ceSettingsChain: Promise<any> = Promise.resolve();
function ceSettingsOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceSettingsChain.then(fn);
    _ceSettingsChain = run.catch(function() { return null; });
    return run;
}

async function cePublishSettings(): Promise<void> {
    ceSettingsStoreInit();
    if (!ceSettingsStore) return;
    try {
        var cfg: any = await loadConfig();
        var errCount = _diagGenLog.filter(function(e: any) { return e.outcome === 'error'; }).length;
        ceSettingsPatch(function() {
            return {
                ready: true, cfg: cfg,
                diagLog: dumpGenDiagLog(),
                diagCount: _diagGenLog.length, diagErr: errCount
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsxsettings] publish failed:', e);
        ceSettingsPatch(function() { return { ready: true }; });
    }
}

// -- Local primitives ----------------------------------------------------------------
// [v2.132.0 SETTINGS-NUMFIELD] See the section header's flagged note. Renders through
// ceField (uncontrolled, blur-commit) rather than value=, exactly like every text field
// on this shell; the only addition is numeric coercion and min/max clamping on commit.
// A malformed or out-of-range entry silently clamps rather than rejecting outright —
// matching sliderInput's own behaviour, which could never produce an out-of-range value
// in the first place.
// [v2.134.0 NUMFIELD-DECIMALS, per user bug report] `decimals` IS REQUIRED IN PRACTICE
// FOR ANY CONTINUOUS VALUE. v2.132.0 rounded EVERY committed number with a bare
// Math.round, which was right for the eight integer call sites it was written against
// (intervals, caps, token budgets, steps) and silently wrong for the two continuous ones
// that arrived later: image Scale and field Weight both accept 0.1-10 and both had every
// decimal destroyed on commit -- typing 5.5 stored 6, typing 0.5 stored 1 (and 0.4 stored
// 0, which the min clamp then pushed back to 0.1).
// THE ROUNDING IS STILL DELIBERATE, not removed: it is what stops a pasted 3.7 becoming a
// token budget of 3.7, and float input in a text field otherwise accepts anything. What
// changed is that the PRECISION is now stated per call site instead of assumed to be zero.
//   decimals omitted / 0 -> integer (unchanged behaviour for every existing caller)
//   decimals: 1          -> one decimal place, which is what a 0.1 step means
// CLAMP ORDER MATTERS AND IS UNCHANGED: clamp first, quantise second. Quantising first
// could push a value back outside the range it was just clamped into.
function ceNumField(p: any): any {
    var curStr = (p.value == null) ? '' : String(p.value);
    var dp = Number(p.decimals) || 0;
    return h(ceField, {
        k: p.k, label: p.label || '', hint: p.hint || '',
        value: curStr, placeholder: p.placeholder || '',
        onCommit: function(v: string) {
            var n = Number(v);
            if (!isFinite(n)) n = Number(p.value) || 0;
            if (p.min != null) n = Math.max(p.min, n);
            if (p.max != null) n = Math.min(p.max, n);
            if (dp > 0) {
                // toFixed then back through Number, so 0.30000000000000004 does not reach
                // storage and the value that redisplays is the value that was stored.
                var q = Math.pow(10, dp);
                n = Number((Math.round(n * q) / q).toFixed(dp));
            } else {
                n = Math.round(n);
            }
            return p.onCommit(n);
        }
    });
}

// [v2.132.0 SETTINGS-INDEXED-STATES] jsx port of aeRenderIndexedStatesEditor (SECTION
// 27) — an ordered string list with reorder/remove/add, used by Relationship
// Archetypes' stages, Conditions' stages, and Factions' relationshipStates. Rendered as
// h(ceField, {key, ...}) per row inside a loop, which is the kit's own documented
// escape hatch for a dynamic field list (ceField's own header comment: "convert it to a
// real component first: h(ceField, props) with a key" — this already IS that shape, no
// further wrapping needed since nothing here calls a hook of its own). Local to this
// surface for now since it has exactly one consumer file section; promotable to
// SECTION 28 if a second surface ever needs it.
function ceIndexedStates(states: string[], onCommitList: (next: string[]) => Promise<any>, label: string, keyPrefix: string): any {
    var rows: any[] = [];
    var i: number;
    for (i = 0; i < states.length; i++) {
        (function(idx: number) {
            rows.push(h('div', {
                key: keyPrefix + ':row:' + idx,
                style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 }
            },
                h('div', { style: { flex: '1 1 auto', minWidth: '0' } }, h(ceField, {
                    k: keyPrefix + ':' + idx, label: '', value: states[idx] || '',
                    onCommit: function(v: string) {
                        var next = states.slice(); next[idx] = v; return onCommitList(next);
                    }
                })),
                ceBtn('\u2191', keyPrefix + ':up:' + idx, function() {
                    if (idx === 0) return Promise.resolve();
                    var next = states.slice(); var tmp = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = tmp;
                    return onCommitList(next);
                }),
                ceBtn('\u2193', keyPrefix + ':dn:' + idx, function() {
                    if (idx === states.length - 1) return Promise.resolve();
                    var next = states.slice(); var tmp = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = tmp;
                    return onCommitList(next);
                }),
                // A single-tap remove, no confirm -- matching the native editor's own
                // behaviour exactly (unlike the definition-level deletes below, this is a
                // prose-list edit, not a referential delete; nothing else in the config
                // points at "stage 2" by index in a way removal could orphan).
                ceBtn('\u00d7', keyPrefix + ':rm:' + idx, function() {
                    var next = states.slice(); next.splice(idx, 1); return onCommitList(next);
                }, 'danger')
            ));
        })(i);
    }
    rows.push(ceBtn('+ Add ' + label, keyPrefix + ':add', function() {
        var next = states.slice(); next.push('New ' + label); return onCommitList(next);
    }));
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, rows);
}

// [v2.132.0 SETTINGS-DELETE] Shared two-step confirm shape for the five definition
// deletes on this surface. Same handler in both states on the asking control
// (DESTRUCTIVE-NEVER-IN-PLACE); the confirmed action is a control that does not exist
// until confirm === key.
function _ceSettingsDeleteBtn(key: string, opLabel: string): any {
    return ceBtn(opLabel || 'Delete\u2026', 'set:delask:' + key, function() {
        ceSettingsPatch(function() { return { confirm: key }; });
        return Promise.resolve();
    }, 'danger');
}
function _ceSettingsConfirmRow(key: string, activeConfirm: string, message: string, onDelete: () => Promise<any>): any {
    if (activeConfirm !== key) return null;
    return h('div', {
        key: 'setconfirm:' + key,
        style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
    },
        h('div', { style: { flex: '1 1 180px', fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.4' } }, message),
        ceBtn('Delete', 'set:del:' + key, onDelete, 'danger'),
        ceBtn('Keep', 'set:keep:' + key, function() {
            ceSettingsPatch(function() { return { confirm: '' }; });
            return Promise.resolve();
        })
    );
}

// -- Tab strip -----------------------------------------------------------------------
var CE_SETTINGS_TABS: any[] = [
    { id: 'world',    label: 'World' },
    { id: 'factions', label: 'Factions' },
    { id: 'system',   label: 'System' }
];
function _ceSettingsTabRow(active: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_SETTINGS_TABS.length; i++) {
        kids.push((function(t: any) {
            var on = t.id === active;
            return h('div', {
                key: 'stab_' + t.id,
                onClick: function() {
                    ceTap('settings:tab:' + t.id, function() { if (!on) ceTabSet('settings', t.id); });
                },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fs, fontWeight: on ? '600' : 'normal',
                    // Ladder: SS4's own example of t3 is "inactive tabs".
                    padding: CE_T.s2 + ' ' + CE_T.s3, opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, t.label);
        })(CE_SETTINGS_TABS[i]));
    }
    return h('div', { style: { display: 'flex', flexWrap: 'wrap', borderBottom: '1px solid ' + CE_LINE, flex: '0 0 auto' } }, kids);
}

// ======================================================================================
// -- WORLD TAB: Species -----------------------------------------------------------------
// ======================================================================================
function _ceSettingsSpecies(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = cfg.species || [];
    var kids: any[] = [];
    var i: number;
    for (i = 0; i < list.length; i++) {
        (function(sp: any) {
            var spId = String(sp.id);
            var accId = 'set:species:' + spId;
            var open = !!openMap[accId];
            var keys = getSpeciesLorebookKeys(sp);
            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: sp.name || '',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.species || []).find(function(x: any) { return x.id === spId; });
                            if (t) t.name = v;
                        }); }).then(cePublishSettings);
                    } }),
                h(ceField, { k: accId + ':desc', label: 'Description', value: sp.description || '', multiline: true, rows: 3,
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.species || []).find(function(x: any) { return x.id === spId; });
                            if (t) t.description = v;
                        }); }).then(cePublishSettings);
                    } })
            ];
            // Lorebook link block -- same two states as Species/Faction share natively.
            if (sp.lorebookEntryId) {
                body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, '\u2713 Lorebook entry linked'),
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Keys: ' + keys.join(', ')),
                    h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                        ceBtn('Sync', accId + ':sync', function() {
                            return ceSettingsOp(function() { return syncSpeciesLorebookEntry(spId); }).then(cePublishSettings);
                        }),
                        ceBtn('Unlink', accId + ':unlink', function() {
                            return ceSettingsOp(function() { return unlinkSpeciesLorebookEntry(spId); }).then(cePublishSettings);
                        })
                    )
                ));
            } else {
                body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'No lorebook entry. Create one to inject this species\u2019 profile.'),
                    ceBtn('+ Create & link lorebook entry', accId + ':create', function() {
                        return ceSettingsOp(function() { return createLinkedSpeciesLorebookEntry(spId); }).then(cePublishSettings);
                    })
                ));
            }
            // Trigger keys (lorebookTags) -- separate from the derived `keys` above, which
            // is name+tags combined for display; this list edits the tags array itself.
            var tagRows: any[] = [];
            (sp.lorebookTags || []).forEach(function(tg: string, ti: number) {
                tagRows.push(h('div', { key: accId + ':tag:' + ti, style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                    h('div', { style: { flex: '1 1 auto', fontSize: CE_T.fsSm } }, '\u2022 ' + tg),
                    ceBtn('\u00d7', accId + ':tagrm:' + ti, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.species || []).find(function(x: any) { return x.id === spId; });
                            if (t && t.lorebookTags) t.lorebookTags.splice(ti, 1);
                        }); }).then(cePublishSettings);
                    }, 'danger')
                ));
            });
            body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Trigger keys'),
                tagRows.length ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: '2px' } }, tagRows) : null,
                h('div', { style: { display: 'flex', gap: CE_T.s2 } },
                    h('div', { style: { flex: '1 1 auto' } }, h(ceField, {
                        k: accId + ':newtag', label: '', placeholder: 'Add key\u2026', value: '',
                        seed: accId + ':newtag:' + String(sp.lorebookTags ? sp.lorebookTags.length : 0),
                        onType: function(v: string) { _ceSettingsTagDraft = v; },
                        onCommit: function(v: string) { _ceSettingsTagDraft = v; return Promise.resolve(); }
                    })),
                    ceBtn('+', accId + ':tagadd', function() {
                        var v = (_ceSettingsTagDraft || '').trim();
                        if (!v) return Promise.resolve();
                        _ceSettingsTagDraft = '';
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.species || []).find(function(x: any) { return x.id === spId; });
                            if (t) { if (!t.lorebookTags) t.lorebookTags = []; if (t.lorebookTags.indexOf(v) < 0) t.lorebookTags.push(v); }
                        }); }).then(cePublishSettings);
                    })
                )
            ));
            body.push(_ceSettingsDeleteBtn(accId, 'Delete species\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (sp.name || 'this species') + '\u201d? Any linked lorebook entry is left behind, not removed. This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var di = (c.species || []).findIndex(function(x: any) { return x.id === spId; });
                        if (di >= 0) c.species.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));
            kids.push(ceExpandRow({
                id: accId, label: sp.name || 'Unnamed species', open: open,
                summary: (sp.description || '').trim(),
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            }));
        })(list[i]);
    }
    var addBtn = ceBtn('+ Add species', 'set:species:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            if (!c.species) c.species = [];
            c.species.push({ id: 'sp_' + Date.now(), name: 'New Species', description: '', lorebookTags: [] });
        }); }).then(cePublishSettings);
    });
    return ceGroup('Species (' + list.length + ')', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', marginBottom: CE_T.s1 } },
            'Available as a selector on character cards. Create lorebook entries to give the AI detailed knowledge of each.'),
        list.length ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, kids) : ceEmpty('No species defined.', null),
        addBtn
    ));
}
// Module-var scratchpad for the "add key" fields across Species/Factions (CLICK-BEFORE-
// BLUR: a button reads this, never the field it commits from). One shared variable is
// safe because only one add-key row is ever mid-entry at a time on this surface.
var _ceSettingsTagDraft: string = '';

// ======================================================================================
// -- WORLD TAB: Relationship Archetypes ---------------------------------------------
// ======================================================================================
function _ceSettingsArchetypes(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = cfg.relationshipArchetypes || [];
    var kids: any[] = [];
    var i: number;
    for (i = 0; i < list.length; i++) {
        (function(def: any) {
            var aId = String(def.id);
            var accId = 'set:arch:' + aId;
            var open = !!openMap[accId];
            var stageCount = (def.stages || []).length;
            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: def.name || '',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.relationshipArchetypes || []).find(function(x: any) { return x.id === aId; });
                            if (t) t.name = v;
                        }); }).then(cePublishSettings);
                    } }),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Stages (cold \u2192 warm, blank = label only):'),
                ceIndexedStates(def.stages || [], function(next: string[]) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var t = (c.relationshipArchetypes || []).find(function(x: any) { return x.id === aId; });
                        if (t) t.stages = next;
                    }); }).then(cePublishSettings);
                }, 'Stage', accId + ':stage')
            ];
            body.push(_ceSettingsDeleteBtn(accId, 'Delete archetype\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (def.name || 'this archetype') + '\u201d? This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var di = (c.relationshipArchetypes || []).findIndex(function(x: any) { return x.id === aId; });
                        if (di >= 0) c.relationshipArchetypes.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));
            kids.push(ceExpandRow({
                id: accId, label: def.name || 'Unnamed archetype', open: open,
                summary: stageCount ? (stageCount + ' stage' + (stageCount === 1 ? '' : 's')) : 'Label only',
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            }));
        })(list[i]);
    }
    var addBtn = ceBtn('+ Add archetype', 'set:arch:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            c.relationshipArchetypes.push({ id: 'arch_' + Date.now(), name: 'New Archetype', stages: ['Stage 1', 'Stage 2', 'Stage 3'] });
        }); }).then(cePublishSettings);
    });
    return ceGroup('Relationship Archetypes (' + list.length + ')', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', marginBottom: CE_T.s1 } },
            'A pick-from-N seed for a character\u2019s Position \u2014 the picker copies the chosen name into Position as editable prose. Leave stages blank for a label-only archetype.'),
        list.length ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, kids) : ceEmpty('No archetypes defined.', null),
        addBtn
    ));
}

// ======================================================================================
// -- WORLD TAB: Conditions ------------------------------------------------------------
// ======================================================================================
function _ceSettingsConditions(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = cfg.conditions || [];
    var kids: any[] = [];
    var i: number;
    for (i = 0; i < list.length; i++) {
        (function(def: any) {
            var cId = String(def.id);
            var accId = 'set:cond:' + cId;
            var open = !!openMap[accId];
            var stageCount = (def.stages || []).length;
            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: def.name || '',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.conditions || []).find(function(x: any) { return x.id === cId; });
                            if (t) t.name = v;
                        }); }).then(cePublishSettings);
                    } }),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Stages (mild \u2192 severe, blank = on/off only):'),
                ceIndexedStates(def.stages || [], function(next: string[]) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var t = (c.conditions || []).find(function(x: any) { return x.id === cId; });
                        if (t) t.stages = next;
                    }); }).then(cePublishSettings);
                }, 'Stage', accId + ':stage')
            ];
            body.push(_ceSettingsDeleteBtn(accId, 'Delete condition\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (def.name || 'this condition') + '\u201d? This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var di = (c.conditions || []).findIndex(function(x: any) { return x.id === cId; });
                        if (di >= 0) c.conditions.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));
            kids.push(ceExpandRow({
                id: accId, label: def.name || 'Unnamed condition', open: open,
                summary: stageCount ? (stageCount + ' stage' + (stageCount === 1 ? '' : 's')) : 'On/off only',
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            }));
        })(list[i]);
    }
    var addBtn = ceBtn('+ Add condition', 'set:cond:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            c.conditions.push({ id: 'cond_' + Date.now(), name: 'New Condition', stages: [] });
        }); }).then(cePublishSettings);
    });
    // Template + live preview -- ONE per tab, not per condition, matching the native
    // layout exactly (the template governs how EVERY active condition renders, so it is
    // config-level, not per-definition).
    var sample = list[0] || { name: 'Intoxicated', stages: ['Tipsy, giggly, and warm to the touch.'] };
    var preview = parseMacroTemplate(cfg.lorebookTemplates.condition,
        { name: 'Aria', conditionName: sample.name, stageText: (sample.stages || [])[0] || '' });
    var templateBlock = h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2, marginTop: CE_T.s3 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, 'Lorebook line template'),
        ceMono('Macros: |name|  |conditionName|  |stageText|', { opacity: CE_OP.t3 }),
        h(ceField, { k: 'set:cond:tpl', label: '', multiline: true, rows: 2, well: true,
            value: cfg.lorebookTemplates.condition,
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.lorebookTemplates.condition = v; }); }).then(cePublishSettings);
            } }),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', fontStyle: 'italic' } }, 'Preview: ' + (preview || '(Blank)'))
    );
    return ceGroup('Conditions (' + list.length + ')', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', marginBottom: CE_T.s1 } },
            'A character can have multiple active at once. Injects into a temporary per-character lorebook entry while active, not the Author\u2019s Note.'),
        list.length ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, kids) : ceEmpty('No conditions defined.', null),
        addBtn,
        templateBlock
    ));
}

// ======================================================================================
// -- WORLD TAB: Lorebook Additions ----------------------------------------------------
// ======================================================================================
function _ceSettingsLorefold(cfg: any): any {
    var lf: any = cfg.lorebookFields || {};
    var lt: any = cfg.lorebookTemplates || {};
    var LF_FIELDS = [
        { key: 'equipment', label: 'Equipment', macros: '|name|  |equipList|', sample: { name: 'Aria', equipList: 'a worn leather coat, an iron dagger' } },
        { key: 'journal',   label: 'Journal',   macros: '|name|  |journalBody|', sample: { name: 'Aria', journalBody: 'Found the letter behind the loose brick. Said nothing to the others yet.' } }
    ];
    var rows: any[] = LF_FIELDS.map(function(fd) {
        var fk = fd.key;
        var preview = parseMacroTemplate(lt[fk] || '', fd.sample);
        return h('div', { key: 'lf:' + fk, style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2, borderBottom: '1px solid ' + CE_LINE, paddingBottom: CE_T.s3 } },
            h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                ceToggle(lf[fk] !== false, 'lf:' + fk, function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookFields as any)[fk] = !(lf[fk] !== false); }); }).then(cePublishSettings);
                }),
                h('div', { style: { fontSize: CE_T.fs } }, fd.label)
            ),
            ceMono('Macros: ' + fd.macros, { opacity: CE_OP.t3 }),
            h(ceField, { k: 'lf:' + fk + ':tpl', label: '', multiline: true, rows: 2, well: true,
                value: lt[fk] || '',
                onCommit: function(v: string) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookTemplates as any)[fk] = v; }); }).then(cePublishSettings);
                } }),
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', fontStyle: 'italic' } }, 'Preview: ' + (preview || '(Blank)'))
        );
    });
    rows.push(h('div', { key: 'lf:conditions', style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
            ceToggle(lf.conditions !== false, 'lf:conditions', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookFields as any).conditions = !(lf.conditions !== false); }); }).then(cePublishSettings);
            }),
            h('div', { style: { fontSize: CE_T.fs } }, 'Conditions')
        ),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Template + definitions live in Conditions, above.')
    ));
    return ceGroup('Lorebook Additions', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Which dynamic character fields fold into that character\u2019s own lorebook entry each generation. Uncheck any that feel excessive; the underlying data is kept, just not injected.'),
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, rows)
    ));
}

function _ceSettingsWorldTab(cfg: any, openMap: any, confirm: string): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        _ceSettingsSpecies(cfg, openMap, confirm),
        _ceSettingsArchetypes(cfg, openMap, confirm),
        _ceSettingsConditions(cfg, openMap, confirm),
        _ceSettingsLorefold(cfg)
    );
}

// ======================================================================================
// -- FACTIONS TAB ----------------------------------------------------------------------
// ======================================================================================
function _ceSettingsFactionsTab(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = cfg.factions || [];
    var kids: any[] = [];
    var i: number;
    for (i = 0; i < list.length; i++) {
        (function(fac: any) {
            var fId = String(fac.id);
            var accId = 'set:fac:' + fId;
            var open = !!openMap[accId];
            var keys = getFactionLorebookKeys(fac);
            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: fac.name || '',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.factions || []).find(function(x: any) { return x.id === fId; });
                            if (t) t.name = v;
                        }); }).then(cePublishSettings);
                    } }),
                h(ceField, { k: accId + ':desc', label: 'Description', value: fac.description || '', multiline: true, rows: 3,
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.factions || []).find(function(x: any) { return x.id === fId; });
                            if (t) t.description = v;
                        }); }).then(cePublishSettings);
                    } }),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Relationship states (cold \u2192 warm):'),
                ceIndexedStates(fac.relationshipStates || [], function(next: string[]) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var t = (c.factions || []).find(function(x: any) { return x.id === fId; });
                        if (t) t.relationshipStates = next;
                    }); }).then(cePublishSettings);
                }, 'Standing', accId + ':state')
            ];
            if (fac.lorebookEntryId) {
                body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, '\u2713 Lorebook entry linked'),
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Keys: ' + keys.join(', ')),
                    h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                        ceBtn('Sync', accId + ':sync', function() {
                            return ceSettingsOp(function() { return syncFactionLorebookEntry(fId); }).then(cePublishSettings);
                        }),
                        ceBtn('Unlink', accId + ':unlink', function() {
                            return ceSettingsOp(function() { return unlinkFactionLorebookEntry(fId); }).then(cePublishSettings);
                        })
                    )
                ));
            } else {
                body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'No lorebook entry. Create one to inject this faction\u2019s profile.'),
                    ceBtn('+ Create & link lorebook entry', accId + ':create', function() {
                        return ceSettingsOp(function() { return createLinkedFactionLorebookEntry(fId); }).then(cePublishSettings);
                    })
                ));
            }
            var tagRows: any[] = [];
            (fac.lorebookTags || []).forEach(function(tg: string, ti: number) {
                tagRows.push(h('div', { key: accId + ':tag:' + ti, style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                    h('div', { style: { flex: '1 1 auto', fontSize: CE_T.fsSm } }, '\u2022 ' + tg),
                    ceBtn('\u00d7', accId + ':tagrm:' + ti, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.factions || []).find(function(x: any) { return x.id === fId; });
                            if (t && t.lorebookTags) t.lorebookTags.splice(ti, 1);
                        }); }).then(cePublishSettings);
                    }, 'danger')
                ));
            });
            body.push(h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Trigger keys'),
                tagRows.length ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: '2px' } }, tagRows) : null,
                h('div', { style: { display: 'flex', gap: CE_T.s2 } },
                    h('div', { style: { flex: '1 1 auto' } }, h(ceField, {
                        k: accId + ':newtag', label: '', placeholder: 'Add key\u2026', value: '',
                        seed: accId + ':newtag:' + String(fac.lorebookTags ? fac.lorebookTags.length : 0),
                        onType: function(v: string) { _ceSettingsTagDraft = v; },
                        onCommit: function(v: string) { _ceSettingsTagDraft = v; return Promise.resolve(); }
                    })),
                    ceBtn('+', accId + ':tagadd', function() {
                        var v = (_ceSettingsTagDraft || '').trim();
                        if (!v) return Promise.resolve();
                        _ceSettingsTagDraft = '';
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.factions || []).find(function(x: any) { return x.id === fId; });
                            if (t) { if (!t.lorebookTags) t.lorebookTags = []; if (t.lorebookTags.indexOf(v) < 0) t.lorebookTags.push(v); }
                        }); }).then(cePublishSettings);
                    })
                )
            ));
            body.push(_ceSettingsDeleteBtn(accId, 'Delete faction\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (fac.name || 'this faction') + '\u201d? Any linked lorebook entry is left behind, not removed. This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var di = (c.factions || []).findIndex(function(x: any) { return x.id === fId; });
                        if (di >= 0) c.factions.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));
            kids.push(ceExpandRow({
                id: accId, label: fac.name || 'Unnamed faction', open: open,
                summary: (fac.relationshipStates || []).length + ' states',
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            }));
        })(list[i]);
    }
    var addBtn = ceBtn('+ Add faction', 'set:fac:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            if (!c.factions) c.factions = [];
            c.factions.push({ id: 'fac_' + Date.now(), name: 'New Faction', description: '',
                relationshipStates: ['Hostile', 'Wary', 'Neutral', 'Friendly', 'Allied'], lorebookTags: [] });
        }); }).then(cePublishSettings);
    });
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        ceGroup('Factions (' + list.length + ')', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', marginBottom: CE_T.s1 } },
                'Each character\u2019s standing with a faction is set from their own Profile.'),
            list.length ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, kids) : ceEmpty('No factions defined.', null),
            addBtn
        ))
    );
}

// ======================================================================================
// -- SYSTEM TAB: Timing -----------------------------------------------------------------
// ======================================================================================
function _ceSettingsTiming(cfg: any): any {
    var isTok = ((cfg as any).dynamicIntervalMode === 'tokens');
    var body: any[] = [
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'How much story progress must pass before each update type fires \u2014 measured in generations (replies) or in context tokens.'),
        ceSettingRow('Cadence unit', '',
            ceSelect({ k: 'set:timing:mode', value: isTok ? 'tokens' : 'gens',
                options: [{ id: 'gens', label: 'Per Generation' }, { id: 'tokens', label: 'Per Tokens' }],
                onCommit: function(v: string) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).dynamicIntervalMode = v; }); }).then(cePublishSettings);
                } }))
    ];
    if (!isTok) {
        body.push(
            ceNumField({ k: 'set:timing:thought_g', label: 'Ephemeral (Thoughts) interval', hint: 'generations, 1\u201320',
                value: cfg.thoughtIntervalGens, min: 1, max: 20,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.thoughtIntervalGens = n; }); }).then(cePublishSettings); } }),
            ceNumField({ k: 'set:timing:hook_g', label: 'Hook scan interval', hint: 'generations, 1\u201330',
                value: cfg.hookIntervalGens, min: 1, max: 30,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.hookIntervalGens = n; }); }).then(cePublishSettings); } })
        );
    } else {
        body.push(
            ceNumField({ k: 'set:timing:thought_t', label: 'Ephemeral (Thoughts) interval', hint: 'tokens, 100\u20135000',
                value: Number((cfg as any).thoughtIntervalTokens) || 500, min: 100, max: 5000,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).thoughtIntervalTokens = n; }); }).then(cePublishSettings); } }),
            ceNumField({ k: 'set:timing:hook_t', label: 'Hook scan interval', hint: 'tokens, 100\u201315000',
                value: Number((cfg as any).hookIntervalTokens) || 1500, min: 100, max: 15000,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).hookIntervalTokens = n; }); }).then(cePublishSettings); } })
        );
    }
    body.push(
        ceNumField({ k: 'set:timing:ephcap', label: 'Max ephemeral injections per generation', hint: '1\u20136',
            value: cfg.ephemeralCap, min: 1, max: 6,
            onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.ephemeralCap = n; }); }).then(cePublishSettings); } }),
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Dynamic character cap: how many present characters stay dynamic at once (0 = no cap). Ranked characters fill slots first; set a rank from a character\u2019s card.'),
        ceNumField({ k: 'set:timing:maxdyn', label: 'Max dynamic characters', hint: '0\u201320, 0 = off',
            value: Number(cfg.maxDynamicCharacters) || 0, min: 0, max: 20,
            onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).maxDynamicCharacters = Math.max(0, n); }); }).then(cePublishSettings); } })
    );
    return ceGroup('Dynamic Updates Timing', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body));
}

// ======================================================================================
// -- SYSTEM TAB: Generation Style -------------------------------------------------------
// ======================================================================================
function _ceSettingsStyle(cfg: any): any {
    return ceGroup('Generation Style', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Injected at the top of every generation prompt. Controls overall tone and register.'),
        h(ceField, { k: 'set:style', label: '', multiline: true, rows: 5, well: true, value: cfg.generalStyle,
            onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.generalStyle = v; }); }).then(cePublishSettings); } }),
        ceBtn('Reset to default', 'set:style:reset', function() {
            return ceSettingsOp(function() { return mutConfig(function(c: any) { c.generalStyle = DEFAULT_GENERAL_STYLE; }); }).then(cePublishSettings);
        })
    ));
}

// ======================================================================================
// -- SYSTEM TAB: Static Field Settings ---------------------------------------------------
// ======================================================================================
var _ceSettingsNewFieldDraft: string = '';
function _ceSettingsFields(cfg: any, openMap: any, confirm: string): any {
    var body: any[] = [
        ceSettingRow('Show field headers in context injection', '',
            ceToggle(!!cfg.showFieldHeaders, 'set:fields:headers', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.showFieldHeaders = !cfg.showFieldHeaders; }); }).then(cePublishSettings);
            }))
    ];
    var builtins: any[] = [];
    STATIC_FIELD_DEFS.forEach(function(def: any) {
        var accId = 'set:field:' + def.key;
        var open = !!openMap[accId];
        var label = cfg.fieldLabels[def.key] || def.label;
        var inst = cfg.fieldInstructions[def.key] || def.defaultInstructions;
        var budget = cfg.fieldBudgets[def.key] || def.defaultBudget;
        builtins.push(ceExpandRow({
            id: accId, label: label, open: open, summary: budget + ' token budget',
            children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
                h(ceField, { k: accId + ':label', label: 'Display label', value: label,
                    onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldLabels[def.key] = v; }); }).then(cePublishSettings); } }),
                h(ceField, { k: accId + ':inst', label: 'Generation instructions', multiline: true, rows: 4, value: inst,
                    onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldInstructions[def.key] = v; }); }).then(cePublishSettings); } }),
                ceNumField({ k: accId + ':budget', label: 'Generation token budget', hint: '50\u2013500', value: budget, min: 50, max: 500,
                    onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldBudgets[def.key] = n; }); }).then(cePublishSettings); } }),
                ceBtn('Reset instructions', accId + ':reset', function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldInstructions[def.key] = def.defaultInstructions; c.fieldBudgets[def.key] = def.defaultBudget; }); }).then(cePublishSettings);
                })
            )
        }));
    });
    body.push(ceGroup('Built-in fields', h('div', { style: { display: 'flex', flexDirection: 'column' } }, builtins)));

    var cfDefs: any[] = (cfg.customStaticFields || []).filter(function(f: any) {
        var k = f ? String(f.kind || 'facet') : 'facet';
        return !!f && k !== 'slot' && k !== 'facet';
    });
    var cfKids: any[] = [];
    cfDefs.forEach(function(cfDef: any) {
        var cfId = String(cfDef.id);
        var accId = 'set:cf:' + cfId;
        var open = !!openMap[accId];
        var cfBody: any[] = [
            h(ceField, { k: accId + ':label', label: 'Display label', value: cfDef.label || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.label = v;
                }); }).then(cePublishSettings); } }),
            h(ceField, { k: accId + ':ph', label: 'Placeholder (editor hint only)', value: cfDef.placeholder || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.placeholder = v;
                }); }).then(cePublishSettings); } }),
            h(ceField, { k: accId + ':inst', label: 'Generation instructions', multiline: true, rows: 4, value: cfDef.instructions || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.instructions = v;
                }); }).then(cePublishSettings); } }),
            ceNumField({ k: accId + ':budget', label: 'Generation token budget', hint: '50\u2013500', value: cfg.fieldBudgets[cfId] || 150, min: 50, max: 500,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldBudgets[cfId] = n; }); }).then(cePublishSettings); } })
        ];
        cfBody.push(_ceSettingsDeleteBtn(accId, 'Delete field\u2026'));
        cfBody.push(_ceSettingsConfirmRow(accId, confirm,
            'Delete \u201c' + (cfDef.label || 'this field') + '\u201d? It disappears from every character\u2019s editor. Text already written into it is kept, not erased.',
            function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    c.customStaticFields = (c.customStaticFields || []).filter(function(f: any) { return !f || f.id !== cfId; });
                }); }).then(function() {
                    ceSettingsPatch(function() { return { confirm: '' }; });
                    return cePublishSettings();
                });
            }));
        cfKids.push(ceExpandRow({
            id: accId, label: cfDef.label || '(unnamed field)', open: open,
            summary: (cfg.fieldBudgets[cfId] || 150) + ' token budget',
            children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, cfBody)
        }));
    });
    var addField = h('div', { style: { display: 'flex', gap: CE_T.s2, marginTop: CE_T.s2 } },
        h('div', { style: { flex: '1 1 auto' } }, h(ceField, {
            k: 'set:cf:newname', label: '', placeholder: 'New field name\u2026', value: '',
            seed: 'set:cf:newname:' + String(cfDefs.length),
            onType: function(v: string) { _ceSettingsNewFieldDraft = v; },
            onCommit: function(v: string) { _ceSettingsNewFieldDraft = v; return Promise.resolve(); }
        })),
        ceBtn('+ Add', 'set:cf:add', function() {
            var newLabel = (_ceSettingsNewFieldDraft || '').trim();
            if (!newLabel) { try { api.v1.ui.toast('Name the field first.', { type: 'warning', autoClose: 2000 }); } catch (_e) {} return Promise.resolve(); }
            _ceSettingsNewFieldDraft = '';
            var newId = 'ce_cf_' + generateId();
            return ceSettingsOp(function() { return mutConfig(function(c: any) {
                if (!Array.isArray(c.customStaticFields)) c.customStaticFields = [];
                c.customStaticFields.push({ id: newId, slot: 'custom', kind: 'custom', label: newLabel, placeholder: '',
                    instructions: 'Write the ' + newLabel + ' for this character in two or three sentences, consistent with everything already established about them. Be specific and concrete rather than summarising.' });
                c.fieldBudgets[newId] = 150;
            }); }).then(cePublishSettings);
        })
    );
    body.push(ceGroup('Custom Fields (' + cfDefs.length + ')', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Fields you define yourself. Same generator, same token budget, same lorebook injection as the built-ins. Once defined, they appear on every character\u2019s profile under \u201cCustom fields\u201d \u2014 write into one there and it joins that character.'),
        cfDefs.length ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, cfKids) : h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'None yet.'),
        addField
    )));

    return ceGroup('Static Field Settings', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, body));
}

// ======================================================================================
// -- SYSTEM TAB: Scene Default Background -----------------------------------------------
// ======================================================================================
function _ceSettingsBackground(cfg: any): any {
    return ceGroup('Scene Default Background', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Fallback image shown in the scene banner when a location has no portrait. Shared across anyone who loads this story. Leave blank for the default gradient.'),
        h(ceField, { k: 'set:bg', label: 'Image URL', value: (cfg as any).defaultBackgroundUrl || '',
            onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).defaultBackgroundUrl = v.trim(); }); }).then(cePublishSettings); } }),
        ceBtn('Clear', 'set:bg:clear', function() {
            return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).defaultBackgroundUrl = ''; }); }).then(function() {
                try { api.v1.ui.toast('Scene background cleared.', { type: 'success', autoClose: 2000 }); } catch (_e) {}
                return cePublishSettings();
            });
        })
    ));
}

// ======================================================================================
// -- SYSTEM TAB: Generation Diagnostics --------------------------------------------------
// ======================================================================================
function _ceSettingsDiagnostics(st: any): any {
    return ceGroup('Generation Diagnostics', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
            'Every engine generation call, logged as it happens. Session-only \u2014 resets on script reload.'),
        h('div', { style: { fontSize: CE_T.fsSm, fontWeight: '600', color: st.diagErr > 0 ? CE_SEM.ask : 'inherit' } },
            st.diagCount + ' call' + (st.diagCount === 1 ? '' : 's') + ' logged this session \u00b7 ' + st.diagErr + ' error' + (st.diagErr === 1 ? '' : 's')),
        h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
            ceBtn('Refresh', 'set:diag:refresh', function() { return cePublishSettings(); }),
            ceBtn('Copy log', 'set:diag:copy', function() {
                return api.v1.permissions.request('clipboardWrite', 'Copy the generation diagnostics log to your clipboard.').then(function(granted: boolean) {
                    if (!granted) { try { api.v1.ui.toast('Clipboard permission denied.', { type: 'warning' }); } catch (_e) {} return null; }
                    return api.v1.clipboard.writeText(dumpGenDiagLog()).then(function() {
                        try { api.v1.ui.toast('Copied to clipboard.', { type: 'success', autoClose: 2000 }); } catch (_e2) {}
                        return null;
                    });
                }).catch(function(eCp: any) {
                    try { api.v1.ui.toast('Copy failed: ' + String((eCp && eCp.message) || eCp), { type: 'error' }); } catch (_e3) {}
                    return null;
                });
            }),
            ceBtn('Clear', 'set:diag:clear', function() { clearGenDiagLog(); return cePublishSettings(); }, 'danger')
        ),
        ceBtn('Run A/B probe (yoink vs direct)', 'set:diag:probe', function() {
            try { api.v1.ui.toast('Running probe\u2026', { id: 'ce-genprobe', autoClose: false, type: 'info' }); } catch (_e) {}
            return runBudgetProbe().then(function() {
                try { api.v1.ui.toast('Probe complete \u2014 see log below.', { id: 'ce-genprobe', type: 'success', autoClose: 2000 }); } catch (_e2) {}
                return cePublishSettings();
            });
        }),
        h('div', { style: { background: CE_WELL, border: '1px dashed ' + CE_LINE, padding: CE_T.s3, borderRadius: CE_T.r, maxHeight: '320px', overflowY: 'auto' } },
            ceMono(st.diagLog, { opacity: CE_OP.t2, style: { whiteSpace: 'pre-wrap' } })
        )
    ));
}

// ======================================================================================
// -- SYSTEM TAB: Interface -------------------------------------------------------------
// ======================================================================================
// [v2.139.0 STYLE2] CE-STYLE v2.0 SS9.2: `prefers-reduced-motion` is NOT DETECTABLE in
// this sandbox -- there is no matchMedia -- so an explicit switch is the substitute, not a
// preference we can read. The kit's motion budget is deliberately small enough to be safe
// by default; this is for people for whom "small" is still too much.
//
// THIS ROW IS THE ONE SETTING ON THIS SURFACE THAT IS NOT STORED IN GlobalConfig, and the
// asymmetry is deliberate rather than an oversight: it is a property of the person reading
// the screen, not of the story file, so it rides api.v1.storage (account-global) and
// follows them into every story instead of being re-set per story. That is also why it
// does not go through ceSettingsOp/mutConfig/cePublishSettings like its neighbours -- it
// has no config to chain against. The ceSettingsPatch call is only there to force a
// repaint so the switch moves; nothing about the value lives in that store.
function _ceSettingsInterface(): any {
    return ceGroup('Interface', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        ceSettingRow('Reduce motion',
            'Turns off the small transitions on buttons, switches and the generation bar. Applies everywhere, and to every story.',
            ceToggle(CE_REDUCE_MOTION, 'set:ui:reducemotion', function() {
                return ceMotionSet(!CE_REDUCE_MOTION).then(function() {
                    ceSettingsPatch(function() { return {}; });
                });
            }, 'Reduce motion')),
        // [v2.168.0 SHELL-WINDOW] Sits beside Reduce motion because it is the same tier of
        // setting -- account-global, about the screen rather than the story -- and so it
        // does not go through ceSettingsOp/mutConfig either. The ceSettingsPatch call is
        // only there to move the switch.
        ceSettingRow('Open in a window',
            'Opens the engine in a floating, resizable window instead of a full-screen panel, so the story stays visible beside it. Applies the next time you open the engine, and to every story.',
            ceToggle(CE_SHELL_WINDOW, 'set:ui:shellwindow', function() {
                return ceShellWindowSet(!CE_SHELL_WINDOW).then(function() {
                    try {
                        api.v1.ui.toast(CE_SHELL_WINDOW
                            ? 'Window mode on \u2014 close and reopen the engine to see it.'
                            : 'Full-screen mode on \u2014 close and reopen the engine to see it.',
                            { type: 'info', autoClose: 4000 });
                    } catch (_eWinToast) {}
                    ceSettingsPatch(function() { return {}; });
                });
            }, 'Open in a window'))
    ));
}

// Import / export, calling the four existing native functions directly -- no jsx port of
// their logic, since all four are already self-contained (api.v1.file.save/.prompt,
// api.v1.ui.toast) with no NAI-UIPart-modal dependency to translate.
function _ceSettingsImportExport(): any {
    return ceGroup('Import / export', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Pack the world into a hidden lorebook entry that travels with your .scenario export, or use plain JSON for backups and external tools.'),
        h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
            ceBtn('Pack to lorebook', 'settings:packlore', function() { return packConfigToLorebook(); }),
            ceBtn('Import from lorebook', 'settings:importlore', function() { return pickAndImportFromLorebook(); }),
            ceBtn('Export JSON', 'settings:exportjson', function() { return exportAll(); }),
            ceBtn('Import JSON', 'settings:importjson', function() { return importData(); })
        )
    ));
}

// [v2.173.0 SYNCALL-PORT] syncAllLorebooks HAD ZERO CALLERS. The function is intact and
// correct -- it takes one live snapshot of the lorebook and, for every character, location,
// species and faction, creates a missing entry, re-syncs a live one, or skips -- and the
// section map at the top of this file still lists it as reaching Settings. Its Settings
// button was in the native surface that SECTION 20 took with it, and the jsx port never
// picked it up, so the repair path for a lorebook that has drifted or been hand-deleted in
// NAI has been unreachable for the whole JSX era.
//
// It is a REPAIR TOOL, not a routine one -- v2.173.0 PROFILE-LORE means ordinary edits now
// keep themselves in sync -- so it gets a plain button and a tally rather than a switch,
// and the hint says what it is for. The tally is the function's own return value, printed
// rather than summarised, because "created 3" and "skipped 3" mean very different things to
// someone who has just deleted entries by hand.
function _ceSettingsLorebooks(): any {
    return ceGroup('Lorebooks', h('div', null,
        ceSettingRow('Sync all lorebooks',
            'Checks every character, location, species and faction against the lorebook: re-writes entries that have drifted, re-creates any that were deleted in NovelAI, and leaves the rest alone. Safe to run at any time.',
            ceBtn('Sync all', 'settings:syncall', function() {
                return (async function() {
                    try {
                        var t: any = await syncAllLorebooks();
                        var line = function(n: string, x: any) {
                            return n + ' ' + x.created + '/' + x.synced + '/' + x.skipped;
                        };
                        api.v1.ui.toast('Lorebooks (created/synced/skipped) \u2014 '
                            + line('characters', t.characters) + ', '
                            + line('locations', t.locations) + ', '
                            + line('species', t.species) + ', '
                            + line('factions', t.factions),
                            { type: 'success', autoClose: 8000 });
                    } catch (eSa) {
                        api.v1.error('[AE:jsxsettings] syncAllLorebooks failed:', eSa);
                        try { api.v1.ui.toast('Lorebook sync failed \u2014 see console.', { type: 'error', autoClose: 3000 }); } catch (eSa2) {}
                    }
                })();
            })
        )
    ));
}

function _ceSettingsSystemTab(cfg: any, openMap: any, confirm: string, st: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        _ceSettingsInterface(),
        _ceSettingsLorebooks(),
        _ceSettingsImportExport(),
        _ceSettingsTiming(cfg),
        _ceSettingsStyle(cfg),
        _ceSettingsFields(cfg, openMap, confirm),
        _ceSettingsBackground(cfg),
        _ceSettingsDiagnostics(st)
    );
}

// ======================================================================================
// -- Root --------------------------------------------------------------------------------
// ======================================================================================
function _ceSettingsRoot(): any {
    ceSettingsStoreInit();
    var st = useStoreValue(ceSettingsStore);
    var ui = useStoreValue(ceUiStore);
    useEffect(function() { cePublishSettings(); }, []);

    // [v2.146.0 NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready || !st.cfg) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    var cfg = st.cfg;
    var openMap: any = (ui && ui.open) || {};
    var confirm = String(st.confirm || '');
    // [v2.134.0 TAB-SCOPED] Reads only THIS surface's tab; anything else reads as 'world'.
    // `ui` stays subscribed via useStoreValue above, so a tab change still repaints --
    // ceTabGet's own read is a plain store get, not a second subscription.
    var tab = ceTabGet('settings', 'world');

    var resolvedTab = (tab === 'factions' || tab === 'system') ? tab : 'world';
    var body: any;
    if (resolvedTab === 'factions') { body = _ceSettingsFactionsTab(cfg, openMap, confirm); }
    else if (resolvedTab === 'system') { body = _ceSettingsSystemTab(cfg, openMap, confirm, st); }
    else { body = _ceSettingsWorldTab(cfg, openMap, confirm); }

    // [v2.132.0] ceScreen, same as every other top-level surface (Chat/Map/Journal) --
    // header row plus one scrollable padded body. The tab row scrolls away with the rest
    // rather than staying pinned; a sticky secondary nav bar is a layout shape nothing
    // else on this shell uses, and inventing one here under a "mechanical port" banner
    // would be a bigger design departure than the tabs themselves.
    // [v2.175.0 TABBODY-KEY] Same slot, same fix as Images -- see the long note there.
    // No bridge-painted content lives on Settings today, so this is prophylactic rather
    // than corrective; it costs one vnode and closes the same door before something
    // paintable lands on a tab here.
    return ceScreen(ceHeader(back), [_ceSettingsTabRow(resolvedTab),
        h('div', { key: 'settab:' + resolvedTab }, body)]);
}

// ============================================================================
// SECTION 35 — IMAGES SURFACE (jsx)  [v2.133.0 IMGPRESET-JSX]
// ============================================================================
// THE IMAGE PROMPT-FIELD LIBRARY AND THE GENERATION DEFAULTS. This is the jsx
// replacement for the bridge's _buildImageFieldsBody (its "Presets" tab, reached from
// openImageGenModal({tab:'presets'}), the Image Studio widget's "Presets & Gallery"
// link, and the per-entity "Image Gen Settings" button). Built now, ahead of the rest of
// Images, because the field library is what the Image Studio is TESTED AGAINST -- there
// is no way to exercise a generation path without something to generate with.
//
// WHAT IS HERE -- all six engine ops, which is every function the bridge panel had:
//   add / update / toggle / delete / setDefaults        (all four bridge-reachable)
//   reorder                                             (see NEW-REORDER below)
// Plus the compiled-output preview, which the bridge never showed at all.
//
// WHAT IS DELIBERATELY NOT HERE, so this is not mistaken for the finished Images
// surface: the GALLERY (image browsing//deletion, IndexedDB-backed, bridge-side bytes)
// and the STUDIO COMPOSER (base prompt, character slots, Enhance/Auto-Snap/Generate).
// Both were already scoped as their own design session -- the plan of record's own words
// are that Images "is not a port." Nothing in this section presupposes their shape.
//
// [v2.133.0] ONE RULE SET, TWO CALLERS. The mutation logic is NOT reimplemented here.
// applyImgFieldOp (SECTION 9) was lifted verbatim out of the AE_IMG_FIELD_ACTION case,
// and both that message handler and this surface now call it. The alternative -- a jsx
// copy of six ops with their own clamps -- is the exact shape that produced CE-IMG-OPTS'
// mirror trap, except worse, because both copies would be in the same file and would
// look consistent right up until one of them was edited.
//
// [v2.133.0 IMGPRESET-NO-CACHE] THIS SURFACE READS ENGINE MODULE STATE DIRECTLY.
// imagePromptFields / globalSettings are already in memory (loadImageSettings runs at
// startup), so cePublishImages copies them into the store rather than re-reading
// api.v1.storage. The bridge had to keep IMG_FIELDS_LS_KEY as an offline cache because
// it is a separate process that can render before the handshake; the engine has no such
// problem and a second cache here would be a mirror of state this file already owns.
// EVERY WRITE STILL GOES THROUGH saveImageSettings(), which persists to api.v1.storage
// AND rebroadcasts AE_IMG_FIELDS_SYNC -- so the bridge's Image Studio chips and the
// bridge's own generation paths stay live while both UIs coexist during the migration.
//
// [v2.133.0 NEW-REORDER] REORDER GETS ITS FIRST UI EVER. The engine has accepted a
// 'reorder' op with an orderedIds payload since v2.13.0 and NOTHING has ever sent one --
// verified by grepping the bridge for the op name: zero hits. It was reachable only by
// hand-crafting a message. Field order is not cosmetic: compileActiveImageFields joins
// in array order, so it decides the order of fragments in the final prompt, which NAI
// weights positionally. Exposing it costs two buttons per row.
//
// [v2.133.0 IMGPRESET-STEPS-28] The Steps input is capped at 28 and says so. That is not
// a UI opinion -- generateSnapshotImage and the bridge's own request builder both do
// Math.min(steps||28, 28) before the call, so a stored 50 was already silently 28. The
// native panel's label ("Steps (max 28)") was the only place this was ever stated; the
// clamp is now enforced at the input as well as at the call site.
//
// GLOBAL, NOT STORY-SCOPED. These live in api.v1.storage (account-level, 4MB cap), not
// storyStorage -- a prompt library is a preference that follows the author across every
// story, and that is why it is NOT in the Settings surface's GlobalConfig-backed tabs
// despite reading like a settings screen.
// ============================================================================

var ceImagesStore: any = null;
function ceImagesStoreInit(): void {
    if (ceImagesStore) return;
    try {
        ceImagesStore = createStore({
            ready: false,
            fields: [], defaults: { width: 832, height: 1216, scale: 5.0, steps: 28 },
            quality: '', negative: '',
            confirm: '',           // delete-confirm target field id
            // [v2.135.0 IMGSTUDIO-JSX] Composer state. `prompt`/`uc` are the AUTHORITATIVE
            // text (what a generator wrote); the live typing lives in module vars -- see
            // STUDIO-DRAFTS. promptGen is the ceField seed reset token, not a key bump.
            prompt: '', uc: '', promptGen: 0,
            // one-off character overrides, cap 4, never persisted. Each slot also carries
            // `id` (character id, '' for a blank one-off) so equipment lookup can find them,
            // and picks up `_equipOn`/`_equipAppended` only once that slot's toggle is used.
            slots: [],
            picker: '',            // '' | 'char' | 'loc' -- full surface swap, not an overlay
            roster: [], locations: [],
            // [v2.137.0 CEGAL-FIELDSEL] null = this render uses whichever Presets fields are
            // currently active, same as before this existed. A real array (including []) is
            // an explicit per-render override that never mutates any field's `.active` flag.
            studioFieldSel: null,
            // [v2.143.0 PHASE-H] Per-render ratio override. EXACTLY the studioFieldSel
            // shape and for the same reason: null means "never touched, use the Presets
            // defaults", a real value overrides THIS RENDER ONLY and never writes back to
            // globalSettings. Two different questions (what this image is, what every
            // image defaults to) must not share one record.
            studioSize: null,
            // [v2.136.0 CEGAL] Gallery. galImages is METADATA ONLY (uuid/prompt/storyId/
            // createdAt) -- the pixels never cross the boundary and are painted over each
            // anchored cell by the bridge. galReady is separate from `ready` because the
            // field library is engine-owned and instant while this list is a round trip
            // that may never answer (no bridge = no gallery, stated rather than spinning).
            galImages: [], galReady: false, galAsked: false, galStoryId: '',
            galAll: false,         // scope toggle: this story only vs every story
            galView: '',           // uuid of the full-view swap, '' = grid
            galConfirm: '',        // delete-confirm target uuid
            // [v2.175.0 IMG-EDIT-SURFACE] SECTION 35b's slice. Parked on THIS store rather
            // than a seventh one: the edit surface is reached from the gallery, shares its
            // anchor form and its download action, and a separate store would need its own
            // init call on a route the bridge can enter cold. edGen is the ceField seed
            // reset token (FIELD-KEYLESS), not a key bump.
            edUuid: '', edReady: false, edFound: false, edBusy: false,
            edPrompt: '', edFp: '', edFu: '', edMeta: null, edGen: 0
        });
    } catch (e) { api.v1.error('[AE:jsximages] store init failed:', e); }
}

function ceImagesPatch(fn: (s: any) => any): void {
    if (!ceImagesStore) return;
    try {
        ceImagesStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsximages] patch failed:', e); }
}

// OP-CHAIN. saveImageSettings is two awaited api.v1.storage.set calls plus a broadcast,
// with no compare-and-swap, and this surface can fire one per keystroke-commit across N
// fields -- the same load-modify-persist race every other surface here chains against.
var _ceImagesChain: Promise<any> = Promise.resolve();
function ceImagesOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceImagesChain.then(fn);
    _ceImagesChain = run.catch(function() { return null; });
    return run;
}

// [v2.133.0] The single verb this surface has. Mutate through the shared rule set, then
// persist+rebroadcast, then republish. Callers never touch imagePromptFields directly.
function ceImgOp(op: string, payload: any): Promise<any> {
    return ceImagesOp(function() {
        try {
            if (!applyImgFieldOp(op, payload || {})) {
                aeLog('[AE:jsximages] unknown op:', op);
                return Promise.resolve(null);
            }
        } catch (e) {
            api.v1.error('[AE:jsximages] op failed:', e);
            return Promise.resolve(null);
        }
        return saveImageSettings();
    }).then(function() { return cePublishImages(); });
}

async function cePublishImages(): Promise<void> {
    ceImagesStoreInit();
    if (!ceImagesStore) return;
    try {
        // Copied, not referenced: the store must not hand the surface a live alias of the
        // module array, or a render could read a half-applied mutation.
        var copy: any[] = [];
        for (var i = 0; i < (imagePromptFields || []).length; i++) {
            var f: any = imagePromptFields[i];
            if (!f) continue;
            copy.push({
                id: String(f.id), name: String(f.name || ''),
                basePrompt: String(f.basePrompt || ''), uc: String(f.uc || ''),
                weight: Number(f.weight) || 1, active: !!f.active
            });
        }
        var compiled = compileActiveImageFields();
        ceImagesPatch(function(s: any) {
            return {
                ready: true, fields: copy,
                defaults: {
                    width:  Number(globalSettings.defaultWidth)  || 832,
                    height: Number(globalSettings.defaultHeight) || 1216,
                    scale:  Number(globalSettings.defaultScale)  || 5.0,
                    steps:  Number(globalSettings.defaultSteps)  || 28
                },
                quality: compiled.quality, negative: compiled.negative,
                // A confirm armed against a field that has since gone (deleted from the
                // bridge's copy of this panel while both UIs are live) must not survive.
                confirm: _ceImgHasField(copy, String(s.confirm || '')) ? s.confirm : ''
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsximages] publish failed:', e);
        ceImagesPatch(function() { return { ready: true }; });
    }
}
function _ceImgHasField(list: any[], id: string): boolean {
    if (!id) return false;
    for (var i = 0; i < list.length; i++) { if (list[i].id === id) return true; }
    return false;
}

// The three ratios every image surface in this project already offers -- the Presets
// panel, the Emotion Studio and (since v2.49.0) the Image Studio composer all use this
// exact set. Free-form width/height is deliberately NOT offered: it can produce a
// dimension NAI rejects, which is why the composer's raw inputs were retired.
var CE_IMG_RATIOS: any[] = [
    { label: 'Portrait',  w: 832,  h: 1216 },
    { label: 'Square',    w: 1024, h: 1024 },
    { label: 'Landscape', w: 1216, h: 832 }
];

// -- Defaults block ------------------------------------------------------------------
function _ceImagesDefaults(d: any): any {
    var ratioBtns: any[] = [];
    for (var i = 0; i < CE_IMG_RATIOS.length; i++) {
        ratioBtns.push((function(sz: any) {
            var on = (d.width === sz.w && d.height === sz.h);
            return ceBtn(sz.label, 'img:ratio:' + sz.label, function() {
                if (on) return Promise.resolve();
                return ceImgOp('setDefaults', { width: sz.w, height: sz.h });
            }, on ? 'primary' : undefined);
        })(CE_IMG_RATIOS[i]));
    }
    return ceGroup('Default Generation Settings',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                'Applied to every generation that does not override them \u2014 the studio composer, avatars, chat photos and Auto-Snap all start here.'),
            ceSettingRow('Ratio', d.width + '\u00d7' + d.height,
                h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, ratioBtns)),
            ceNumField({ k: 'img:def:scale', label: 'Scale', hint: '0.1\u201310 in steps of 0.1, 5 is the default',
                value: d.scale, min: 0.1, max: 10, decimals: 1,
                onCommit: function(n: number) { return ceImgOp('setDefaults', { scale: n }); } }),
            // See IMGPRESET-STEPS-28 in the header: the clamp is real, not advisory.
            ceNumField({ k: 'img:def:steps', label: 'Steps', hint: '1\u201328 \u2014 higher values are clamped to 28 before the request',
                value: d.steps, min: 1, max: 28,
                onCommit: function(n: number) { return ceImgOp('setDefaults', { steps: n }); } })
        ));
}

// -- Compiled preview ----------------------------------------------------------------
// [v2.133.0] The bridge never showed this. Weighting is the one part of the field model
// nobody can predict by reading the rows -- a weight of 1 compiles plain, anything else
// wraps as NAI's `w::text::` -- so the only way to know what the library actually emits
// was to generate something and look at it.
function _ceImagesCompiled(st: any): any {
    var activeCount = 0;
    for (var i = 0; i < (st.fields || []).length; i++) { if (st.fields[i].active) activeCount++; }
    function block(label: string, text: string): any {
        return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, label),
            h('div', { style: {
                background: CE_WELL, border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
                padding: CE_T.s3
            } }, ceMono(text || '(empty)', {
                // Ladder: compiled output is content, t1; the empty placeholder is t3.
                opacity: text ? CE_OP.t1 : CE_OP.t3,
                style: { whiteSpace: 'pre-wrap', lineHeight: '1.5' }
            })));
    }
    return ceSection('Compiled Output',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                activeCount + ' active field' + (activeCount === 1 ? '' : 's')
                + ' \u2014 exactly what gets appended to every generation, in this order. A weight of 1 compiles plain; anything else wraps as weight::text::'),
            block('Prompt', st.quality),
            block('Negative / UC', st.negative)
        ));
}

// -- One field row -------------------------------------------------------------------
function _ceImagesField(f: any, idx: number, total: number, openMap: any, confirm: string, orderedIds: string[]): any {
    var accId = 'img:field:' + f.id;
    var open = !!openMap[accId];
    var w = Number(f.weight) || 1;

    function moveTo(newIdx: number): Promise<any> {
        if (newIdx < 0 || newIdx >= total) return Promise.resolve();
        var next = orderedIds.slice();
        var cur = next.splice(idx, 1)[0];
        next.splice(newIdx, 0, cur);
        return ceImgOp('reorder', { orderedIds: next });
    }

    var body: any[] = [
        h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
            // Active is a TOGGLE, not a verb button -- ceToggle exists precisely because a
            // button labelled with an action reads the same in both directions (v2.112.0).
            // The bridge rendered this as a star-prefixed "Active"/"Inactive" button.
            ceBtn(f.active ? 'Active' : 'Inactive', accId + ':toggle', function() {
                return ceImgOp('toggle', { id: f.id });
            }, f.active ? 'primary' : undefined),
            ceBtn('\u2191', accId + ':up', function() { return moveTo(idx - 1); }),
            ceBtn('\u2193', accId + ':dn', function() { return moveTo(idx + 1); })
        ),
        h(ceField, { k: accId + ':name', label: 'Name', value: f.name || '', placeholder: 'Field name',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, name: v }); } }),
        ceNumField({ k: accId + ':weight', label: 'Weight', hint: '0.1\u201310 in steps of 0.1 \u2014 1 compiles plain, anything else wraps as weight::text::',
            value: w, min: 0.1, max: 10, decimals: 1,
            onCommit: function(n: number) { return ceImgOp('update', { id: f.id, weight: n }); } }),
        h(ceField, { k: accId + ':bp', label: 'Prompt fragment', value: f.basePrompt || '',
            multiline: true, rows: 3, well: true, placeholder: 'Base prompt fragment\u2026',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, basePrompt: v }); } }),
        h(ceField, { k: accId + ':uc', label: 'Negative / UC fragment', value: f.uc || '',
            multiline: true, rows: 2, well: true, placeholder: 'UC / undesired fragment\u2026',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, uc: v }); } })
    ];

    // DESTRUCTIVE-NEVER-IN-PLACE. The bridge deleted a field on a single tap of a bin
    // icon with no confirm at all; a prompt fragment someone tuned by hand is worth one
    // more tap. Same arm/confirm shape as every other delete on this shell.
    body.push(ceIconBtn('Delete this field\u2026', ceIconTrash(), accId + ':delask', function() {
        ceImagesPatch(function() { return { confirm: f.id }; });
        return Promise.resolve();
    }, 'danger'));
    if (confirm === f.id) {
        body.push(h('div', {
            key: accId + ':confirm',
            style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
        },
            h('div', { style: { flex: '1 1 180px', fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.4' } },
                'Delete \u201c' + (f.name || 'this field') + '\u201d? This cannot be undone.'),
            ceBtn('Delete', accId + ':del', function() {
                return ceImgOp('delete', { id: f.id }).then(function() {
                    ceImagesPatch(function() { return { confirm: '' }; });
                    return null;
                });
            }, 'danger'),
            ceBtn('Keep', accId + ':keep', function() {
                ceImagesPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    var summaryBits: string[] = [];
    if (w !== 1) summaryBits.push('\u00d7' + w);
    var frag = String(f.basePrompt || '').trim();
    if (frag) summaryBits.push(frag);
    return ceAccordion({
        id: accId,
        label: f.name || '(unnamed field)',
        open: open,
        // Semantic dot rather than a word: active/inactive is the one thing worth reading
        // off a collapsed row, and ceDot is how this shell says state at a glance.
        lead: ceDot(f.active ? 'building' : 'calm'),
        summary: summaryBits.join(' \u00b7 '),
        meta: f.active ? 'on' : '',
        children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
    });
}

// ======================================================================================
// -- STUDIO TAB  [v2.135.0 IMGSTUDIO-JSX] ----------------------------------------------
// ======================================================================================
// The composer: describe an image, optionally name who is in it, and render it. This is
// the jsx replacement for the bridge's Image Studio widget form.
//
// EVERY VERB HERE WAS ALREADY AN ENGINE FUNCTION, which is why this tab needed no new
// message pair and no bridge change at all:
//   Auto-Snap -> buildArchitectPromptFromStory(paragraphs)   (architect pass over story)
//   Enhance   -> enhanceDirectorPrompt(prompt, chars)        (returns a value)
//   Generate  -> submitDirectorPhoto(prompt, uc, chars)      (broadcasts EVT_GENERATE_IMAGE)
// The bridge reached all three by round-tripping EVT_DIRECTOR_SUBMIT / EVT_AUTOSNAP_PROMPT
// and waiting for a reply broadcast. This surface calls them directly and skips the round
// trip entirely -- the message handlers stay untouched and still work for the bridge.
//
// GENERATION STILL REQUIRES THE BRIDGE, and that is not something this surface can route
// around: submitDirectorPhoto's own first guard is `if (!isBridgeReady)`, because the
// actual pixels come from a fetch to NAI's image endpoint and there is no fetch in this
// sandbox. So Generate is DISABLED with a stated reason when the bridge is absent, rather
// than firing into silence. Auto-Snap and Enhance are pure engine generation and stay
// available either way -- there is no reason to gate prompt-building on the byte pipeline.
//
// [v2.135.0 STUDIO-ONEOFF] CHARACTER SLOTS ARE ONE-OFF OVERRIDES AND ARE NEVER WRITTEN
// BACK, which is the engine's own existing rule (submitDirectorPhoto's comment says so
// outright: "those edits are one-off, per user's call, never written back"). Picking a
// character PREFILLS name/visuals/uc from the record; editing any of them changes this
// generation only. The slots therefore live in the STORE, not in ceProfileWrite -- there
// is no persistence path out of this tab by design, and adding one later would silently
// change what a decade of muscle memory expects a studio slot to do.
// Cap is 4, matching submitDirectorPhoto's own slice(0, 4) -- a fifth slot would be
// accepted by the UI and then silently dropped at the call, which is worse than refusing.
// A slot with no name is legitimate (an unnamed figure in the frame), so nothing filters
// on name being present.
//
// [v2.135.0 STUDIO-DRAFTS] The prompt and UC boxes ride MODULE VARIABLES via onType, not
// store state -- CLICK-BEFORE-BLUR, the same reason the Journal composer and the chat
// summary editor do. Generate/Enhance are buttons that read a value the field commits on
// blur, and in this environment the click lands first. The store still holds the
// AUTHORITATIVE prompt (so Auto-Snap and Enhance can replace it) plus a `promptGen`
// counter, which is the ceField `seed` reset token -- FIELD-KEYLESS, not a key bump.
//
// PICKERS ARE FULL SURFACE SWAPS (JSXPROFILE-NO-OVERLAY -- overlay sheets are not
// constructible in this environment). Both the character picker and the location picker
// replace the whole surface and return to it, rather than floating over it.
// ======================================================================================

// Live text, never store state -- see STUDIO-DRAFTS above.
var _ceStudioPromptDraft: string = '';
var _ceStudioUcDraft: string = '';

function ceStudioPatch(fn: (s: any) => any): void { ceImagesPatch(fn); }

// Replace the prompt from a GENERATOR (Auto-Snap / Enhance). Bumps the seed so the
// textarea reseeds, and syncs the draft so an immediate Generate reads the new text
// rather than whatever was typed before.
function _ceStudioSetPrompt(text: string): void {
    _ceStudioPromptDraft = String(text || '');
    ceStudioPatch(function(s: any) {
        return { prompt: String(text || ''), promptGen: (Number(s.promptGen) || 0) + 1 };
    });
}

// Append to the prompt without discarding what is already there -- used by the location
// picker, which adds visuals to a description rather than replacing it.
function _ceStudioAppendPrompt(text: string): void {
    var add = String(text || '').trim();
    if (!add) return;
    var cur = String(_ceStudioPromptDraft || '').trim();
    _ceStudioSetPrompt(cur ? (cur + ', ' + add) : add);
}

function _ceStudioSlots(s: any): any[] { return (s && s.slots) ? s.slots : []; }

function ceStudioAddSlot(ch: any): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (next.length >= 4) return {};
        next.push({
            id:      ch ? String(ch.id || '') : '',
            name:    ch ? String(ch.name || '') : '',
            visuals: ch ? String(ch.visuals || '') : '',
            uc:      ch ? String(ch.uc || '') : ''
        });
        return { slots: next, picker: '' };
    });
}
function ceStudioSetSlot(idx: number, field: string, value: string): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (!next[idx]) return {};
        var row: any = {}; var k: string;
        for (k in next[idx]) { row[k] = next[idx][k]; }
        row[field] = String(value || '');
        next[idx] = row;
        return { slots: next };
    });
}
function ceStudioRemoveSlot(idx: number): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        next.splice(idx, 1);
        return { slots: next };
    });
}

// -- Per-render field selection [v2.137.0 CEGAL-FIELDSEL] --------------------------------
// The selection a Generate call will actually use, whether or not the user has touched the
// picker yet: falls back to the Presets tab's own active set until they diverge from it.
function _ceStudioFieldSel(s: any): string[] {
    if (Array.isArray(s.studioFieldSel)) return s.studioFieldSel;
    var out: string[] = [];
    var fl: any[] = s.fields || [];
    for (var i = 0; i < fl.length; i++) { if (fl[i].active) out.push(String(fl[i].id)); }
    return out;
}
function ceStudioToggleField(fieldId: string): void {
    if (!fieldId) return;
    ceStudioPatch(function(s: any) {
        var base = _ceStudioFieldSel(s).slice();
        var i = base.indexOf(fieldId);
        if (i === -1) { base.push(fieldId); } else { base.splice(i, 1); }
        return { studioFieldSel: base };
    });
}
function ceStudioResetFieldSel(): void {
    ceStudioPatch(function() { return { studioFieldSel: null }; });
}
// [v2.143.0 PHASE-H] The ratio override, mirroring the three functions above.
// RETURNS THE DEFAULTS WHEN UNSET rather than a hard-coded pair -- the whole point is that
// an untouched studio still follows Presets, so there is no second place the default size
// is written down.
// The three shapes already settled across every image surface in this project, plus the
// CURRENT value appended when it is none of them -- the same rule CE_IMG_RATIO_OPTS follows for
// the avatar frame, so a preset carrying some other pair renders instead of being silently
// snapped to the nearest of three.
function _ceStudioSizeOpts(sz: any): any[] {
    var out: any[] = [
        { id: '832x1216', label: 'Portrait \u2014 832\u00d71216' },
        { id: '1024x1024', label: 'Square \u2014 1024\u00d71024' },
        { id: '1216x832', label: 'Landscape \u2014 1216\u00d7832' }
    ];
    var cur = String(sz.width) + 'x' + String(sz.height);
    var known = false;
    for (var i = 0; i < out.length; i++) { if (out[i].id === cur) { known = true; break; } }
    if (!known) { out.push({ id: cur, label: 'Custom \u2014 ' + String(sz.width) + '\u00d7' + String(sz.height) }); }
    return out;
}
function _ceStudioSize(s: any): any {
    var d: any = (s && s.defaults) || {};
    var o: any = s && s.studioSize;
    if (o && Number(o.width) > 0 && Number(o.height) > 0) {
        return { width: Number(o.width), height: Number(o.height) };
    }
    return { width: Number(d.width) || 832, height: Number(d.height) || 1216 };
}
function ceStudioSetSize(v: string): void {
    var parts = String(v || '').split('x');
    var w = Number(parts[0] || 0); var hgt = Number(parts[1] || 0);
    if (!(w > 0) || !(hgt > 0)) { ceStudioPatch(function() { return { studioSize: null }; }); return; }
    ceStudioPatch(function() { return { studioSize: { width: w, height: hgt } }; });
}

// -- Actions ---------------------------------------------------------------------------
function ceStudioAutoSnap(): Promise<any> {
    return ceImagesOp(function() {
        var paras = Number(globalSettings.contextSize) || DEFAULT_CTX;
        return buildArchitectPromptFromStory(paras).then(function(built: any) {
            if (!built || !built.prompt) {
                try { api.v1.ui.toast('Could not build a prompt from the recent story.', { type: 'warning', autoClose: 3000 }); } catch (_e) {}
                return null;
            }
            _ceStudioSetPrompt(built.prompt);
            // Auto-Snap resolves which characters the story just mentioned, so it fills the
            // slots too -- the same matchedChars the bridge used to receive as charNames and
            // then have to re-resolve against its own cache. Here the records are in hand.
            var matched: any[] = (built.matchedChars || []).slice(0, 4);
            ceStudioPatch(function() {
                return { slots: matched.map(function(c: any) {
                    return { id: String(c.id || ''), name: String(c.name || ''), visuals: String(c.visuals || ''), uc: String(c.uc || '') };
                }) };
            });
            try { api.v1.ui.toast('Prompt built from the recent story.', { type: 'success', autoClose: 2500 }); } catch (_e2) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] auto-snap failed:', e);
            try { api.v1.ui.toast('Auto-snap failed.', { type: 'error', autoClose: 3000 }); } catch (_e3) {}
            return null;
        });
    });
}

function ceStudioEnhance(): Promise<any> {
    var prompt = String(_ceStudioPromptDraft || '').trim();
    if (!prompt) {
        try { api.v1.ui.toast('Write something to enhance first.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    var slots: any[] = [];
    try { var st: any = ceImagesStore ? ceImagesStore.get() : null; slots = _ceStudioSlots(st); } catch (e) { slots = []; }
    return ceImagesOp(function() {
        return enhanceDirectorPrompt(prompt, slots).then(function(res: any) {
            if (!res || !res.enhancedPrompt) {
                try { api.v1.ui.toast('Enhancement failed.', { type: 'error', autoClose: 3000 }); } catch (_e2) {}
                return null;
            }
            _ceStudioSetPrompt(res.enhancedPrompt);
            // enhanceDirectorPrompt returns adapted per-character visuals alongside the
            // prompt; writing them back into the slots is what makes a second Enhance build
            // on the first rather than re-deriving from the original record.
            var cv: any[] = res.charVisuals || [];
            if (cv.length) {
                ceStudioPatch(function(s: any) {
                    var next = _ceStudioSlots(s).slice();
                    for (var i = 0; i < next.length && i < cv.length; i++) {
                        var row: any = {}; var k: string;
                        for (k in next[i]) { row[k] = next[i][k]; }
                        if (cv[i] && cv[i].visuals) row.visuals = String(cv[i].visuals);
                        next[i] = row;
                    }
                    return { slots: next };
                });
            }
            try { api.v1.ui.toast('Prompt enhanced.', { type: 'success', autoClose: 2500 }); } catch (_e3) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] enhance failed:', e);
            try { api.v1.ui.toast('Enhancement failed.', { type: 'error', autoClose: 3000 }); } catch (_e4) {}
            return null;
        });
    });
}

function ceStudioGenerate(): Promise<any> {
    var prompt = String(_ceStudioPromptDraft || '').trim();
    if (!prompt) {
        try { api.v1.ui.toast('Describe the image first.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    if (!isBridgeReady) {
        // Stated, not silent. submitDirectorPhoto would toast this itself, but the button
        // is also visibly disabled so the reason is legible before the tap.
        try { api.v1.ui.toast('Generating needs the bridge connected.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return Promise.resolve();
    }
    var slots: any[] = [];
    try { var st: any = ceImagesStore ? ceImagesStore.get() : null; slots = _ceStudioSlots(st); } catch (e) { slots = []; }
    var uc = String(_ceStudioUcDraft || '').trim();
    // null when the user has never touched the picker -- submitDirectorPhoto treats that
    // the same as no argument at all and falls back to the standing active set.
    var fieldSel: string[] | null = null;
    var sizeSel: any = null;
    try {
        var stf: any = ceImagesStore ? ceImagesStore.get() : null;
        fieldSel = (stf && Array.isArray(stf.studioFieldSel)) ? stf.studioFieldSel : null;
        // [v2.143.0 PHASE-H] Read the RAW override, not _ceStudioSize's resolved value: a
        // resolved value is never null, so passing it would make every render an explicit
        // override and silently pin the size the first time the studio opened.
        sizeSel = (stf && stf.studioSize) ? stf.studioSize : null;
    } catch (e) { fieldSel = null; sizeSel = null; }
    // [v2.156.0 STORYIMG] Read at the moment of the tap, not from the render closure: the
    // toggle sits on this same tab and the two must not be able to disagree by one paint.
    var placeIt = !!globalSettings.studioPlaceInStory;
    return ceImagesOp(function() {
        return submitDirectorPhoto(prompt, uc, slots, fieldSel, sizeSel).then(function(newUuid: string) {
            // The image itself lands bridge-side (EVT_GENERATE_IMAGE -> fetch -> IndexedDB).
            // [v2.156.0 STORYIMG] What DOES come back now is the uuid, which is enough to
            // pin the widget immediately -- so the anchor exists while the picture is still
            // generating and the bridge paints a placeholder into it. That is the whole
            // "indication of generating until success" mechanism: no second message, no
            // pending flag to keep in sync, just an anchor whose image is not there yet.
            if (placeIt && newUuid) {
                return ceStoryImgPlace(newUuid).then(function(ok: boolean) {
                    try {
                        api.v1.ui.toast(ok ? 'Generating \u2014 it will appear at the end of your story.'
                                           : 'Sent to the image pipeline\u2026',
                            { type: 'info', autoClose: 2500 });
                    } catch (_e3a) {}
                    return null;
                });
            }
            // Unchanged when the toggle is off: this does NOT claim the image exists yet.
            try { api.v1.ui.toast('Sent to the image pipeline\u2026', { type: 'info', autoClose: 2500 }); } catch (_e3) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] generate failed:', e);
            try { api.v1.ui.toast('Could not start generation.', { type: 'error', autoClose: 3000 }); } catch (_e4) {}
            return null;
        });
    });
}

// -- Pickers (full surface swaps) ------------------------------------------------------
async function cePublishStudioPickers(): Promise<void> {
    // Loaded on demand rather than kept in the store permanently: the roster and the
    // location list are both already-cheap engine reads, and holding a copy would be one
    // more thing to invalidate when a character is renamed elsewhere in the shell.
    try {
        var chars: any[] = await loadAllCharacters();
        var roster: any[] = [];
        for (var i = 0; i < (chars || []).length; i++) {
            var c = chars[i];
            if (!c || !c.id) continue;
            if (c.active === false) continue;
            roster.push({ id: String(c.id), name: String(c.name || 'Unknown'),
                visuals: String(c.visuals || ''), uc: String(c.uc || '') });
        }
        var metas: any[] = await loadEntityIndex();
        var locs: any[] = [];
        for (var j = 0; j < (metas || []).length; j++) {
            if (!metas[j] || metas[j].type !== 'location') continue;
            var rec: any = await loadEntity(metas[j].id);
            if (!rec) continue;
            locs.push({ id: String(rec.id), name: String(rec.name || 'Unnamed'),
                visuals: String(rec.locationVisuals || '') });
        }
        ceImagesPatch(function() { return { roster: roster, locations: locs }; });
    } catch (e) {
        api.v1.error('[AE:jsxstudio] picker publish failed:', e);
    }
}

function _ceStudioPickerScreen(st: any, back: any): any {
    var kind = String(st.picker || '');
    var rows: any[] = [];
    var i: number;
    if (kind === 'char') {
        var roster: any[] = st.roster || [];
        for (i = 0; i < roster.length; i++) {
            rows.push((function(ch: any) {
                return ceListRow({
                    label: ch.name,
                    sub: ch.visuals ? _ceTrim(ch.visuals, 68) : 'No visuals written yet',
                    onClick: function() { ceStudioAddSlot(ch); }
                });
            })(roster[i]));
        }
        rows.push(ceListRow({
            label: 'Unnamed figure',
            sub: 'An empty slot to describe by hand',
            onClick: function() { ceStudioAddSlot(null); }
        }));
        return ceScreen(ceHeader(back),
            [h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows)]);
    }
    var locs: any[] = st.locations || [];
    var locRows: any[] = [];
    for (i = 0; i < locs.length; i++) {
        locRows.push((function(l: any) {
            return ceListRow({
                label: l.name,
                sub: l.visuals ? _ceTrim(l.visuals, 68) : 'No scene visuals set',
                onClick: function() {
                    if (!l.visuals) {
                        try { api.v1.ui.toast(l.name + ' has no scene visuals set.', { type: 'warning', autoClose: 3000 }); } catch (_e) {}
                        return;
                    }
                    _ceStudioAppendPrompt(l.visuals);
                    ceImagesPatch(function() { return { picker: '' }; });
                }
            });
        })(locs[i]));
    }
    return ceScreen(ceHeader(back),
        [locRows.length
            ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, locRows)
            : ceEmpty('No locations in this world yet.', null)]);
}

// -- The tab ---------------------------------------------------------------------------
function _ceImagesStudioTab(st: any): any {
    var d = st.defaults || {};
    var slots = _ceStudioSlots(st);
    var i: number;

    var slotNodes: any[] = [];
    for (i = 0; i < slots.length; i++) {
        slotNodes.push((function(sl: any, idx: number) {
            var kp = 'img:slot:' + idx;
            return h('div', { key: kp, style: {
                display: 'flex', flexDirection: 'column', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3
            } },
                h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                    h('div', { style: { flex: '1 1 auto', minWidth: '0' } }, h(ceField, {
                        k: kp + ':name', label: '', value: sl.name || '', placeholder: 'Name (optional)',
                        onCommit: function(v: string) { ceStudioSetSlot(idx, 'name', v); return Promise.resolve(); }
                    })),
                    ceBtn('Remove', kp + ':rm', function() { ceStudioRemoveSlot(idx); return Promise.resolve(); }, 'danger')
                ),
                // [v2.143.0 PHASE-H] 'Visuals' -> 'Character Base Prompt'. Says WHAT it is
                // (a prompt fragment) and WHOSE it is, where 'Visuals' said neither.
                h(ceField, { k: kp + ':vis', label: 'Character Base Prompt', value: sl.visuals || '',
                    multiline: true, rows: 2, well: true, placeholder: '1girl, brown hair, red dress\u2026',
                    onCommit: function(v: string) { ceStudioSetSlot(idx, 'visuals', v); return Promise.resolve(); } }),
                // [v2.137.0 CEGAL-EQUIP] Ported from the retired bridge widget. Disabled for
                // a blank one-off slot -- there is no character id to look equipment up for.
                h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2 } },
                    ceToggle(!!sl._equipOn, kp + ':equip', function() { ceStudioToggleEquip(idx); return Promise.resolve(); }),
                    // Ladder + SS4's disabled rule: a disabled control gets t3 AND a
                    // stated reason, never dimming alone. The reason is the label itself
                    // ("pick a character first"), which is why this row was already
                    // halfway compliant; only the rungs were off.
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: sl.id ? CE_OP.t1 : CE_OP.t3 } },
                        sl.id ? 'Append equipped items' : 'Append equipped items (pick a character first)')
                ),
                // [v2.143.0 PHASE-H] 'Negative' -> 'Character UC'.
                h(ceField, { k: kp + ':uc', label: 'Character UC (optional)', value: sl.uc || '',
                    onCommit: function(v: string) { ceStudioSetSlot(idx, 'uc', v); return Promise.resolve(); } })
            );
        })(slots[i], i));
    }

    // [v2.143.0 PHASE-H] Resolved size for display: the override if there is one, the
    // Presets default if not.
    var sz = _ceStudioSize(st);
    var genLabel = isBridgeReady ? 'Generate' : 'Generate (needs bridge)';

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        // [v2.143.0 PHASE-H, per surface_list] 'Describe' -> 'Base Prompt'. NAI's own term.
        ceGroup('Base Prompt', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                'Auto-Snap builds a prompt from what just happened in the story. Enhance rewrites a rough description into a fuller one, pulling in whoever is listed below. Generate renders it with the fields selected below (defaulting to whichever are active on the Presets tab) and the size/scale defaults from there too.'),
            h(ceField, {
                seed: 'studio:prompt:' + String(st.promptGen || 0),
                k: 'studio:prompt', label: '', value: String(st.prompt || ''),
                multiline: true, rows: 4, well: true,
                placeholder: 'e.g. two knights duel on a rain-soaked bridge at dusk',
                onType: function(v: string) { _ceStudioPromptDraft = v; },
                onCommit: function(v: string) { _ceStudioPromptDraft = v; return Promise.resolve(); }
            }),
            h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                ceBtn('Auto-Snap', 'studio:autosnap', function() { return ceStudioAutoSnap(); }),
                ceBtn('Enhance', 'studio:enhance', function() { return ceStudioEnhance(); }),
                ceBtn('+ Location visuals', 'studio:pick:loc', function() {
                    ceImagesPatch(function() { return { picker: 'loc' }; });
                    return cePublishStudioPickers();
                })
            ),
            h(ceField, {
                seed: 'studio:uc:' + String(st.promptGen || 0),
                // [v2.143.0 PHASE-H] 'Negative / unwanted' -> 'Unwanted Content', NAI's term.
                k: 'studio:uc', label: 'Unwanted Content (optional)', value: String(st.uc || ''),
                multiline: true, rows: 2, well: true,
                placeholder: 'Leave blank to use the active fields\u2019 negatives',
                onType: function(v: string) { _ceStudioUcDraft = v; },
                onCommit: function(v: string) { _ceStudioUcDraft = v; return Promise.resolve(); }
            })
        )),

        ceGroup('Who is in it (' + slots.length + ' of 4)',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                    'Optional. Picking someone fills their visuals from their profile; anything you change here applies to this image only and is never written back to them.'),
                slotNodes.length
                    ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, slotNodes)
                    : null,
                slots.length < 4
                    ? ceBtn('+ Add character', 'studio:pick:char', function() {
                        ceImagesPatch(function() { return { picker: 'char' }; });
                        return cePublishStudioPickers();
                    })
                    : h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Four is the maximum the generator accepts.')
            )),

        ceGroup('Render', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            // [v2.143.0 PHASE-H, per surface_list] THE PRESETS BUTTON IS GONE -- there is a
            // Presets TAB one row above it, so the button was a second door to a room already
            // visible from here. What replaces it is the thing the list actually asked for:
            // the ratio is editable, as a per-render override of the preset.
            // SCALE AND STEPS STAY READ-ONLY on this row and stay pointed at Presets. They
            // are not what a single image wants changed -- ratio is a compositional choice
            // (this shot is a portrait, that one is a landscape) where scale and steps are
            // engine tuning you set once. Adding all three here would rebuild the Presets
            // tab inside the composer.
            ceSettingRow('Ratio', 'Overrides the preset for this render only \u00b7 scale '
                    + d.scale + ' \u00b7 ' + d.steps + ' steps',
                ceSelect({
                    k: 'studio:size', value: String(sz.width) + 'x' + String(sz.height),
                    options: _ceStudioSizeOpts(sz),
                    onCommit: function(v: string) { ceStudioSetSize(v); return Promise.resolve(); }
                })),
            (st.studioSize)
                ? ceBtn('Reset ratio to Presets', 'studio:size:reset', function() {
                    ceStudioSetSize(''); return Promise.resolve();
                })
                : null,
            // [v2.137.0 CEGAL-FIELDSEL] Per-render field selection. Defaults to whichever
            // Presets fields are standing-active (compileActiveImageFields' own rule) until
            // a chip here is tapped, at which point it becomes an explicit override that
            // never writes back to any field's `.active` flag -- Presets stays the source
            // of truth for every OTHER generation path (Auto-Snap, Snapshot).
            (st.fields || []).length
                ? h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Fields for this render'),
                    h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                        (function() {
                            var sel = _ceStudioFieldSel(st);
                            var chips: any[] = [];
                            for (var fi = 0; fi < st.fields.length; fi++) {
                                (function(f: any) {
                                    var on = sel.indexOf(String(f.id)) !== -1;
                                    chips.push(ceBtn(f.name || '(untitled)', 'studio:field:' + f.id, function() {
                                        ceStudioToggleField(String(f.id)); return Promise.resolve();
                                    }, on ? 'primary' : undefined));
                                })(st.fields[fi]);
                            }
                            return chips;
                        })()
                    ),
                    Array.isArray(st.studioFieldSel)
                        ? ceBtn('Reset to Presets\u2019 active set', 'studio:field:reset', function() {
                            ceStudioResetFieldSel(); return Promise.resolve();
                        })
                        : null
                )
                : null,
            // [v2.156.0 STORYIMG] OPT-IN, DEFAULT OFF, per user. Nothing is written into the
            // document until this is on, which is also what makes the feature safe against a
            // bridge older than v2.102.0: with no toggle there is no sentinel to leave
            // unpainted. globalSettings, not the store -- it is a standing preference, the
            // same tier autoDownload sits on, not a per-render override like studioSize.
            ceSettingRow('Put it in the story',
                'The finished picture is pinned at the end of your story with a fresh line under it, ready to keep writing.',
                ceToggle(!!globalSettings.studioPlaceInStory, 'studio:instory', function() {
                    var next = !globalSettings.studioPlaceInStory;
                    globalSettings.studioPlaceInStory = next;
                    return Promise.resolve(saveImageSettings()).then(function() {
                        ceImagesPatch(function(s: any) { return { promptGen: Number(s.promptGen) || 0 }; });
                        return null;
                    });
                }, 'Put generated images in the story')),
            ceBtn(genLabel, 'studio:generate', function() { return ceStudioGenerate(); },
                isBridgeReady ? 'primary' : undefined),
            // The escape hatch, per user. Deliberately always present rather than shown only
            // when an anchor exists: the case it is FOR is the one where the store and the
            // document disagree -- a widget orphaned by a story switch, which this side
            // cannot see and cannot count.
            ceBtn('Clear images from the story', 'studio:clearstory', function() {
                return Promise.resolve(ceStoryImgClearAll()).then(function(n: number) {
                    try {
                        api.v1.ui.toast(n > 0 ? ('Cleared ' + n + ' image' + (n === 1 ? '' : 's') + ' from the story.')
                                              : 'Cleared. Your pictures are all still in the gallery.',
                            { type: 'info', autoClose: 2500 });
                    } catch (_eCl) {}
                    return null;
                });
            }, 'danger'),
            !isBridgeReady
                ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                    'The picture itself is fetched and stored by the bridge userscript, so rendering needs it running. Writing and enhancing prompts works without it.')
                : h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                    'The finished image is saved by the bridge and appears in its gallery. Clearing only removes it from the page \u2014 nothing in the gallery is deleted.')
        ))
    );
}

// ======================================================================================
// -- GALLERY TAB  [v2.136.0 CEGAL] ------------------------------------------------------
// ======================================================================================
// Every image this project has ever generated, browsable from the engine surface. This
// was the ONE piece of Images that could not be a jsx-only patch, and the index carried
// its spec as IMGGALLERY-BLOCKED until this pass; the blocker and its four pieces are
// resolved here plus bridge v2.101.0.
//
// THE SPLIT, which is the same CE-IMG-ATTR split already proven on 26 character slots:
//   METADATA travels    -- AE_GALLERY_INDEX_REQ / AE_GALLERY_INDEX_RESP carry
//                          { uuid, prompt, storyId, createdAt }, no bytes at all.
//   PIXELS DO NOT       -- this file draws an EMPTY anchored box per record
//                          (CE_IMG_GAL|uuid) and the bridge's painter covers it. Bytes
//                          crossing a message would mean a canvas round trip, which
//                          destroys PNG metadata and webp animation (session 5 s1), and
//                          there is no IndexedDB in this sandbox to read them from anyway.
//   ACTIONS ARE ASKED FOR -- AE_GALLERY_ACTION { uuid, op } mirrors AE_CHAR_IMAGE_ACTION
//                          exactly: this file owns the confirm, the bridge owns the row.
//
// WHY DELETE DOES NOT MUTATE THE LIST HERE: the bridge re-sends the index after a delete.
// Optimistically splicing the local copy would be a MIRROR of a store this file cannot
// read, with the same silent one-directional failure the CE-IMG-ATTR entry warns about --
// a delete that failed bridge-side would leave a record visible nowhere but here.
//
// DOWNLOAD IS BRIDGE-SIDE OUTRIGHT (it needs the blob) and so is Edit (openPromptEditor
// reads the bridge's own prompt cache). Both are requests from here, not implementations.
// 'Use as prompt' is the one action that is purely local -- the prompt text is already in
// the index, so it can seed the Studio composer with no round trip.
//
// SCOPE: records are stamped with the story that generated them. The default view is THIS
// story, because a gallery that opens on 400 images from every story anyone has ever
// written is not a gallery, it is an archive. The toggle says which one is showing.
// ======================================================================================

// Ask the bridge for the index. Cheap enough to re-ask on every entry to the tab -- it is
// one IndexedDB getAll bridge-side and the answer replaces the list wholesale, so there is
// no staleness window to reason about.
function ceGalleryRequest(): Promise<any> {
    if (!isBridgeReady) {
        // Answered, not left spinning. The tab states the reason itself.
        ceImagesPatch(function() { return { galReady: true, galAsked: true, galImages: [] }; });
        return Promise.resolve();
    }
    ceImagesPatch(function() { return { galAsked: true }; });
    return broadcastToTM('AE_GALLERY_INDEX_REQ', {}).catch(function(e: any) {
        api.v1.error('[AE:jsxgallery] index request failed:', e);
        ceImagesPatch(function() { return { galReady: true }; });
        return null;
    });
}

async function ceGalleryReceive(payload: any): Promise<void> {
    ceImagesStoreInit();
    var list: any[] = [];
    try {
        var raw: any[] = (payload && payload.images) || [];
        for (var i = 0; i < raw.length; i++) {
            var r: any = raw[i];
            if (!r || !r.uuid) continue;
            list.push({
                uuid: String(r.uuid), prompt: String(r.prompt || ''),
                storyId: String(r.storyId || ''), createdAt: Number(r.createdAt) || 0
            });
        }
    } catch (e) { api.v1.error('[AE:jsxgallery] receive failed:', e); }
    // Story id from THIS side, not from the payload: the bridge's activeStoryId is a copy
    // of a value this engine sent it, and a copy can be stale (it is blank until the first
    // EVT_STORY_ID_SYNC lands). Fall back to the bridge's only if the direct read fails.
    var sid = '';
    try { sid = String(await api.v1.story.id() || ''); } catch (e2) { sid = ''; }
    if (!sid) { sid = String((payload && payload.storyId) || ''); }
    ceImagesPatch(function(s: any) {
        // A view or a confirm armed against a record that has since been deleted must not
        // survive the refresh that reported the deletion.
        var stillThere = function(id: string): boolean {
            if (!id) return false;
            for (var j = 0; j < list.length; j++) { if (list[j].uuid === id) return true; }
            return false;
        };
        return {
            galImages: list, galReady: true, galStoryId: sid,
            galView: stillThere(String(s.galView || '')) ? s.galView : '',
            galConfirm: stillThere(String(s.galConfirm || '')) ? s.galConfirm : ''
        };
    });
}

function ceGalleryAction(uuid: string, op: string): Promise<any> {
    if (!uuid) return Promise.resolve();
    if (!isBridgeReady) {
        try { api.v1.ui.toast('That needs the bridge connected.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    return broadcastToTM('AE_GALLERY_ACTION', { uuid: uuid, op: op }).catch(function(e: any) {
        api.v1.error('[AE:jsxgallery] action ' + op + ' failed:', e);
        return null;
    });
}

// The records currently in view, after the scope toggle.
function _ceGalleryScoped(st: any): any[] {
    var all: any[] = st.galImages || [];
    var sid = String(st.galStoryId || '');
    if (st.galAll || !sid) return all;
    var out: any[] = [];
    for (var i = 0; i < all.length; i++) { if (String(all[i].storyId || '') === sid) out.push(all[i]); }
    return out;
}

function _ceGalleryFind(st: any, uuid: string): any {
    var all: any[] = st.galImages || [];
    for (var i = 0; i < all.length; i++) { if (all[i].uuid === uuid) return all[i]; }
    return null;
}

// dd Mon yyyy from a ms stamp -- no locale API assumptions, same style the rest of the
// shell uses for stamps.
var CE_GAL_MONTHS: string[] = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function _ceGalleryStamp(ms: number): string {
    if (!ms) return '';
    try {
        var dte = new Date(ms);
        return dte.getDate() + ' ' + CE_GAL_MONTHS[dte.getMonth()] + ' ' + dte.getFullYear();
    } catch (e) { return ''; }
}

// -- One grid cell ---------------------------------------------------------------------
// The box is EMPTY by design: the bridge paints the image over it. A record whose bytes
// are gone therefore reads as an empty frame rather than a broken one, which is honest --
// IndexedDB is per-browser-profile while the metadata follows the account, so a record
// with no local bytes is a real state, not an error.
function _ceGalleryCell(rec: any): any {
    return h('div', {
        key: 'gal_' + rec.uuid,
        onClick: function() { ceTap('gal:open:' + rec.uuid, function() {
            ceImagesPatch(function() { return { galView: rec.uuid, galConfirm: '' }; });
        }); },
        style: {
            flex: '1 1 96px', maxWidth: '160px', cursor: 'pointer',
            display: 'flex', flexDirection: 'column', gap: CE_T.s1
        }
    },
        h('div', ceImgAnchor(CE_IMG_GAL, rec.uuid, {
            style: {
                width: '100%', height: '128px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        })),
        h('div', { style: {
            fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.3',
            overflow: 'hidden', whiteSpace: 'nowrap', textOverflow: 'ellipsis'
        } }, rec.prompt ? _ceTrim(rec.prompt, 40) : '(no prompt saved)')
    );
}

// -- Full view (surface swap, JSXPROFILE-NO-OVERLAY) ------------------------------------
function _ceGalleryViewScreen(st: any, back: any): any {
    var rec = _ceGalleryFind(st, String(st.galView || ''));
    if (!rec) return ceScreen(ceHeader(back), [ceEmpty('That image is no longer in the gallery.', null)]);
    var confirming = (String(st.galConfirm || '') === rec.uuid);

    var acts: any[] = [
        ceBtn('Use as prompt', 'gal:use:' + rec.uuid, function() {
            if (!rec.prompt) {
                try { api.v1.ui.toast('This image has no saved prompt.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
                return Promise.resolve();
            }
            _ceStudioSetPrompt(rec.prompt);
            ceImagesPatch(function() { return { galView: '' }; });
            ceTabSet('images', 'studio');
            try { api.v1.ui.toast('Prompt loaded into the Studio.', { type: 'success', autoClose: 2500 }); } catch (_e2) {}
            return Promise.resolve();
        }, 'primary'),
        // [v2.175.0 IMG-EDIT-SURFACE] WAS A DEAD ROUTE. This asked the bridge to open
        // openPromptEditor, which v2.103.0 deleted -- the bridge answered with a toast
        // saying editing had moved, and it had not moved anywhere yet. It has now.
        ceBtn('Edit\u2026', 'gal:edit:' + rec.uuid, function() {
            return ceImgEditOpen(rec.uuid, { surface: 'images', entityId: '', label: 'Images' });
        }),
        ceBtn('Download', 'gal:dl:' + rec.uuid, function() { return ceGalleryAction(rec.uuid, 'download'); }),
        // DESTRUCTIVE-NEVER-IN-PLACE: this button only ever ASKS, in both states.
        ceIconBtn('Delete this image\u2026', ceIconTrash(), 'gal:delask:' + rec.uuid, function() {
            ceImagesPatch(function() { return { galConfirm: rec.uuid }; });
            return Promise.resolve();
        })
    ];

    var body: any[] = [
        h('div', ceImgAnchor(CE_IMG_GAL, rec.uuid, {
            key: 'galview_' + rec.uuid,
            style: {
                width: '100%', height: '320px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_CONTAIN)),
        h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, acts)
    ];

    if (confirming) {
        body.push(h('div', {
            key: 'galconf_' + rec.uuid,
            style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
        },
            h('div', { style: { flex: '1 1 180px', fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.4' } },
                'Delete this image? It is removed from local storage and cannot be recovered.'),
            ceBtn('Delete', 'gal:del:' + rec.uuid, function() {
                return ceGalleryAction(rec.uuid, 'delete').then(function() {
                    // The list is NOT spliced here -- the bridge re-sends the index and
                    // ceGalleryReceive clears both the view and the confirm for a record
                    // that is really gone. This only leaves the dead screen.
                    ceImagesPatch(function() { return { galView: '', galConfirm: '' }; });
                    return null;
                });
            }, 'danger'),
            ceBtn('Keep', 'gal:keep:' + rec.uuid, function() {
                ceImagesPatch(function() { return { galConfirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    var stamp = _ceGalleryStamp(rec.createdAt);
    body.push(ceSection('Prompt',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            stamp ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, stamp) : null,
            h('div', { style: {
                background: CE_WELL, border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
                padding: CE_T.s3
            } }, ceMono(rec.prompt || '(no prompt saved with this image)', {
                opacity: rec.prompt ? CE_OP.t1 : CE_OP.t3,
                style: { whiteSpace: 'pre-wrap', lineHeight: '1.5' }
            })))));

    return ceScreen(ceHeader(back),
        [h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, body)]);
}

// -- The tab ---------------------------------------------------------------------------
function _ceImagesGalleryTab(st: any): any {
    if (!st.galReady) {
        return ceSection('Gallery', ceEmpty('Loading\u2026', null));
    }
    if (!isBridgeReady) {
        return ceSection('Gallery',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                    'Saved images live in the bridge userscript\u2019s local database, so browsing them needs it running. Everything else on this surface works without it.'),
                ceBtn('Try again', 'gal:retry', function() { return ceGalleryRequest(); })));
    }

    var recs = _ceGalleryScoped(st);
    var total = (st.galImages || []).length;
    var cells: any[] = [];
    for (var i = 0; i < recs.length; i++) { cells.push(_ceGalleryCell(recs[i])); }

    var scopeLabel = st.galAll
        ? (total + ' image' + (total === 1 ? '' : 's') + ' across every story')
        : (recs.length + ' image' + (recs.length === 1 ? '' : 's') + ' in this story');

    var head = h('div', { style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2 } },
        h('div', { style: { flex: '1 1 140px', fontSize: CE_T.fsSm, opacity: '0.58' } }, scopeLabel),
        // [v2.137.0 CEGAL-IDEMP] Target captured HERE, at render time, not inverted from
        // live state inside the patch closure. This is an instant handler (no await), so
        // ceAction's busy latch clears before a real duplicate fire could land -- only
        // ceTap's time guard protects it, and that guard is provisional (see CE_TAP_MS).
        // A duplicate fire against `!s.galAll` reads the ALREADY-flipped value and flips
        // it back, which is exactly the bug reported: toggle, then immediately revert.
        // Capturing `target` makes a duplicate fire idempotent instead -- the fast case
        // (second event lands before Preact re-renders) is now silently harmless. The slow
        // case (second event lands after a re-render hands it a fresh closure) is not fixed
        // by this alone; see the lesson entry for why and what full fix would take.
        ceBtn(st.galAll ? 'This story' : 'All stories', 'gal:scope', function() {
            var target = !st.galAll;
            ceImagesPatch(function() { return { galAll: target }; });
            return Promise.resolve();
        }, st.galAll ? 'primary' : undefined),
        ceBtn('Refresh', 'gal:refresh', function() { return ceGalleryRequest(); })
    );

    var grid = cells.length
        ? h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s3 } }, cells)
        : ceEmpty(st.galAll
            ? 'No images saved yet. Generate one from the Studio tab.'
            : 'No images for this story yet \u2014 tap \u201cAll stories\u201d to browse older ones.', null);

    return ceSection('Gallery',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
            head,
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                'Tap an image to see its prompt, reuse it in the Studio, download it or delete it.'),
            grid));
}

// -- Root ------------------------------------------------------------------------------
function _ceImagesRoot(): any {
    ceImagesStoreInit();
    var st = useStoreValue(ceImagesStore);
    var ui = useStoreValue(ceUiStore);
    // [v2.136.0 CEGAL] Read BEFORE the early returns and BESIDE the other hooks: the tab
    // gate below decides which effect runs, so the tab value cannot be computed after a
    // conditional return without moving a hook behind one. ceTabGet is a plain store get,
    // and this component is already subscribed to ceUiStore above, so tab clicks repaint.
    var tab = ceTabGet('images', 'studio');
    useEffect(function() { cePublishImages(); }, []);
    // Asks once per entry to the tab, not once per render. galAsked is reset by nothing --
    // the Refresh button and the post-delete re-send are the other two paths in.
    useEffect(function() {
        if (tab === 'gallery' && !(st && st.galAsked)) { ceGalleryRequest(); }
    }, [tab]);

    // [v2.146.0 NOHEADER] Same deletion as Map/Chat/Settings — Images is on the shell nav.
    // `back` stays as a name because the gallery detail and the two pickers below are NOT
    // nav destinations and still need a way out; ceBack supplies one only when a real
    // return address was set, and those screens set their own action instead.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    // [v2.135.0] The picker is a FULL SURFACE SWAP (JSXPROFILE-NO-OVERLAY), so it
    // replaces everything below the header rather than floating over it. Checked before
    // the tab strip renders -- while picking, the tabs are not the navigation that matters.
    if (st.picker) {
        var pickBack = ceBtn('\u2190 Studio', 'img:pick:back', function() {
            ceImagesPatch(function() { return { picker: '' }; });
            return Promise.resolve();
        });
        return _ceStudioPickerScreen(st, pickBack);
    }

    // [v2.136.0 CEGAL] Same rule as the picker: the full image view REPLACES the surface
    // rather than floating over it (overlay sheets are not constructible here).
    if (st.galView) {
        var galBack = ceBtn('\u2190 Gallery', 'gal:back', function() {
            ceImagesPatch(function() { return { galView: '', galConfirm: '' }; });
            return Promise.resolve();
        });
        return _ceGalleryViewScreen(st, galBack);
    }

    var openMap: any = (ui && ui.open) || {};
    var confirm = String(st.confirm || '');
    var fields: any[] = st.fields || [];
    var orderedIds: string[] = [];
    var i: number;
    for (i = 0; i < fields.length; i++) { orderedIds.push(fields[i].id); }

    // [v2.135.0 TAB-SCOPED] Studio first: it is what someone opens Images to DO, and the
    // field library is the thing it is configured with. Defaults live on Presets beside
    // the fields they compile with, and the Studio's Render row links across to them
    // rather than restating them in two places. [v2.136.0] Gallery last -- it is what the
    // other two PRODUCE, and it is the only tab that can be empty on a fresh install.
    // `tab` is read at the top of this function, beside the hooks.
    var body: any[];
    if (tab === 'presets') {
        var rows: any[] = [];
        for (i = 0; i < fields.length; i++) {
            rows.push(_ceImagesField(fields[i], i, fields.length, openMap, confirm, orderedIds));
        }
        var addBtn = ceBtn('+ Add field', 'img:add', function() {
            return ceImgOp('add', { name: 'New Field' });
        });
        body = [
            _ceImagesDefaults(st.defaults || {}),
            ceGroup('Prompt Fields (' + fields.length + ')',
                h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                        'Reusable prompt fragments. Each has a positive fragment, a negative fragment and a weight; every ACTIVE one is folded into every generation until you switch it off. Order matters \u2014 fragments compile top to bottom.'),
                    fields.length
                        ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows)
                        : ceEmpty('No prompt fields yet. Add one to start building a library.', null),
                    addBtn)),
            _ceImagesCompiled(st)
        ];
    } else if (tab === 'gallery') {
        body = [_ceImagesGalleryTab(st)];
    } else {
        body = [_ceImagesStudioTab(st)];
    }

    var activeTab = (tab === 'presets' || tab === 'gallery') ? tab : 'studio';
// [v2.175.0 TABBODY-KEY, per user report: "blank squares in the studio, duplicated in the
// gallery on return"] THE TAB BODY IS NOW A KEYED SLOT, and this is NOT a sixth attempt at
// the header ghost (v2.167-v2.172) -- it is a different failure with a different signature
// and it is reachable from here, which that one never was.
//
// THE MECHANISM. The body sat at a FIXED POSITION in ceScreen's child list with NO KEY, and
// every tab puts an h('div') there. Preact matches unkeyed children by position and type,
// so switching tabs did not unmount anything: it REUSED the same DOM subtree and diffed
// gallery cells against studio rows in place. That is invisible for engine-owned content
// (the props all get rewritten) and destructive for BRIDGE-OWNED content, because the
// bridge appends real <img> children this tree knows nothing about. CESURF-RECYCLE already
// documents the second half from the bridge's side: the recycled node keeps the foreign
// <img> while losing data-ce-img, the sweep correctly strips it, and the user is left
// looking at an empty bordered box in a tab that never had an image in it.
//
// A DISTINCT KEY PER TAB FORCES UNMOUNT/MOUNT instead of reuse, which is the whole fix:
// nothing survives the switch to be recycled, so there is nothing for a foreign child to
// ride. The wrapper carries ceScreen's own s3 gap so spacing is unchanged.
    return ceScreen(ceHeader(back), [
        _ceImagesTabRow(activeTab),
        h('div', { key: 'imgtab:' + activeTab,
                   style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
    ]);
}

// Same shape as the Settings tab strip. Not promoted to the kit yet: two call sites with
// identical code is the point at which extraction is arguable, not the point at which it
// is obviously right, and a third would settle it. Recorded so it is a decision rather
// than an oversight.
var CE_IMAGES_TABS: any[] = [
    { id: 'studio',  label: 'Studio' },
    { id: 'presets', label: 'Presets' },
    { id: 'gallery', label: 'Gallery' }
];
function _ceImagesTabRow(active: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_IMAGES_TABS.length; i++) {
        kids.push((function(t: any) {
            var on = t.id === active;
            return h('div', {
                key: 'itab_' + t.id,
                onClick: function() { ceTap('images:tab:' + t.id, function() { if (!on) ceTabSet('images', t.id); }); },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fs, fontWeight: on ? '600' : 'normal',
                    // Ladder: SS4's own example of t3 is "inactive tabs".
                    padding: CE_T.s2 + ' ' + CE_T.s3, opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, t.label);
        })(CE_IMAGES_TABS[i]));
    }
    return h('div', { style: { display: 'flex', flexWrap: 'wrap', borderBottom: '1px solid ' + CE_LINE } }, kids);
}


// ============================================================================
// SECTION 35b — IMAGE EDIT SURFACE (jsx)  [v2.175.0 IMG-EDIT-SURFACE]
//
// ONE PLACE TO RE-PROMPT AN IMAGE, reachable from every card that shows one: the story
// widget, the chat photo, and the gallery's full view. Requested as a surface rather than
// a Gallery drill precisely so the two in-document cards are ONE tap from it -- routing
// them through Gallery would have been three (open Images, find the record, open it), and
// the record you want is the one you are already looking at.
//
// WHAT v2.103.0 ACTUALLY DELETED, and why this is not simply a restore. The bridge's
// openPromptEditor died with the bridge studio, and both AE_GALLERY_ACTION op:'edit' and
// AE_CHAR_IMAGE_ACTION op:'edit' were left answering with a toast that told the user
// editing had moved somewhere it had not yet arrived. The verb was never wrong; it had no
// destination. This is the destination.
//
// THE FIELDS ARE fp AND fu, NOT prompt AND uc, AND THAT IS THE DESIGN DECISION HERE.
// A stored record carries both: `prompt` is what the author typed, `fp`/`fu` are what was
// actually sent after the active preset fields, quality string and character captions were
// compiled in. Editing `prompt` would mean RE-COMPILING at regeneration time against
// TODAY'S preset fields -- so an image made six months ago would come back changed by
// edits to a field library it never used, and the user would have no way to see why.
// Editing the compiled text is what-you-see-is-what-is-sent, which is the only version of
// this that can be reasoned about. `prompt` is still shown, read-only, as provenance.
//
// REGENERATION OVERWRITES THE SAME UUID. Every surface addresses an image by uuid -- story
// anchor, chat tag, gallery cell, character slot -- so new bytes under the old key update
// all of them with nothing rewritten. See the bridge's AE_IMG_REGEN note for the full
// reasoning and for why a failed regeneration cannot lose the original.
//
// CROSS-ARTIFACT: three new messages, all added in bridge v2.106.0 in the same pass --
// AE_IMG_META_REQ/AE_IMG_META_RESP (one record's editable fields, deliberately absent from
// the gallery index because that is sent for every image at once) and AE_IMG_REGEN /
// AE_IMG_REGEN_DONE. AE_IMG_EDIT_OPEN travels the other way: the bridge's card corners ask
// THIS side to open, because only this side owns navigation.
// ============================================================================

// Live typing, module-level, same STUDIO-DRAFTS contract as the composer: the store holds
// the authoritative text and these hold what is in the box right now. Both handlers are
// set on every field -- ceField.commit() calls onCommit unguarded and a field with only
// onType throws on blur.
var _ceImgEditFpDraft: string = '';
var _ceImgEditFuDraft: string = '';

// Open the surface for one uuid. Called by the gallery's Edit button and by the bridge's
// AE_IMG_EDIT_OPEN. Navigates FIRST and asks second, so the surface is on screen in its
// loading state rather than after a round trip that may never answer.
//
// [v2.176.0 IMGEDIT-DOOR, per user: "the edit image button in the top right corner of
// images ... does not open a prompt editing/regenerating menu"] IT NAVIGATED WITHOUT
// OPENING THE DOOR, and that is fatal for exactly one of the two callers.
//
// ceNav sets a VALUE on ceUiStore. Something has to be MOUNTED and subscribed for a value
// to become a screen, and that is ceOpenShell's job -- the shell modal is the only mount
// point in this file. The gallery's Edit button is fine either way because the shell is
// already open when you press it. THE BRIDGE'S CARD CORNERS ARE THE OPPOSITE CASE BY
// CONSTRUCTION: the whole reason those corners exist is to edit the picture you are
// looking at IN THE STORY, which means the shell is closed, which means the surface this
// navigated to had nothing rendering it. The tap was received, the state was correct, and
// nothing appeared -- the worst shape a bug can have.
//
// ceOpenShell IS THE RIGHT CALL RATHER THAN A SECOND modal.open: it initialises every
// store first (this route can be entered COLD, from a page where no surface has ever been
// opened, so ceImagesStore may not exist yet), it is idempotent when the shell is already
// up (`if (_ceSceneHandle) return`), and it navigates on the way through.
//
// `back` IS RE-APPLIED AFTER, not passed through: ceOpenShell's internal ceNav takes no
// back address and NAV-BACK's clearing rule means it wipes the previous one. Setting it
// afterwards is the only order that leaves Back pointing where this function promised.
async function ceImgEditOpen(uuid: string, back?: any): Promise<any> {
    var want = String(uuid || '');
    if (!want) return Promise.resolve();
    ceImagesStoreInit();
    _ceImgEditFpDraft = '';
    _ceImgEditFuDraft = '';
    ceImagesPatch(function(s: any) {
        // [v2.176.0 IMGEDIT-DOOR] galView/galConfirm CLEARED HERE, and this is the second
        // reported symptom rather than tidiness. The gallery's full view is a sub-screen of
        // the Images surface gated on galView, and nothing was clearing it -- so Back from
        // here landed on the Images surface and found galView still holding the record you
        // had just left, re-rendering the full view (and its own anchored box) instead of
        // the grid the Back label promised. Reported as "its blank image space is left in
        // the gallery after backing to it"; it is not a ghost node, it is state outliving
        // its screen. Same clearing discipline ceNav already applies to sheet/picker/photo.
        // edBusy is reset for the same reason: a regeneration abandoned by navigating away
        // would otherwise leave the next record's Regenerate button reading "Rendering...".
        return { edUuid: want, edReady: false, edFound: false, edPrompt: '', edFp: '', edFu: '',
                 edMeta: null, edBusy: false, galView: '', galConfirm: '',
                 edGen: Number(s.edGen || 0) + 1 };
    });

    var backTo: any = back || { surface: 'images', entityId: '', label: 'Images' };
    try { await ceOpenShell('imgedit', want); }
    catch (eOpen) { api.v1.error('[AE:imgedit] shell open failed:', eOpen); }
    try { ceUiPatch(function() { return { back: backTo }; }); }
    catch (eBack) { api.v1.error('[AE:imgedit] back address failed:', eBack); }

    if (!isBridgeReady) {
        // Answered, not left spinning -- same rule ceGalleryRequest follows.
        ceImagesPatch(function() { return { edReady: true, edFound: false }; });
        return Promise.resolve();
    }
    return broadcastToTM('AE_IMG_META_REQ', { uuid: want }).catch(function(e: any) {
        api.v1.error('[AE:imgedit] meta request failed:', e);
        ceImagesPatch(function() { return { edReady: true, edFound: false }; });
        return null;
    });
}

// The bridge's answer. IGNORED WHEN IT IS FOR A DIFFERENT UUID than the one now open --
// two opens in quick succession would otherwise let the first answer overwrite the second.
function ceImgEditReceive(payload: any): void {
    ceImagesStoreInit();
    var uuid = String((payload && payload.uuid) || '');
    if (!uuid) return;
    ceImagesPatch(function(s: any) {
        if (String(s.edUuid || '') !== uuid) return {};
        if (!(payload && payload.found)) return { edReady: true, edFound: false };
        var fp = String(payload.fp || '');
        var fu = String(payload.fu || '');
        _ceImgEditFpDraft = fp;
        _ceImgEditFuDraft = fu;
        return {
            edReady: true, edFound: true,
            edPrompt: String(payload.prompt || ''), edFp: fp, edFu: fu,
            edMeta: { chars: payload.chars || [], settings: payload.settings || {},
                      storyId: String(payload.storyId || ''), createdAt: Number(payload.createdAt) || 0 },
            edGen: Number(s.edGen || 0) + 1
        };
    });
}

// Regeneration finished (or failed). The BYTES are already in place bridge-side and every
// painted card has been forced to repaint from there, so there is nothing to fetch -- this
// only releases the busy state and re-reads the record, since fp/fu are now whatever was
// actually sent.
function ceImgEditRegenDone(payload: any): void {
    ceImagesStoreInit();
    var uuid = String((payload && payload.uuid) || '');
    ceImagesPatch(function(s: any) {
        if (String(s.edUuid || '') !== uuid) return {};
        return { edBusy: false };
    });
}

function ceImgEditRegen(): Promise<any> {
    var st: any = null;
    try { st = ceImagesStore ? ceImagesStore.get() : null; } catch (e) { st = null; }
    if (!st || !st.edUuid) return Promise.resolve();
    var fp = String(_ceImgEditFpDraft || '').trim();
    if (!fp) {
        try { api.v1.ui.toast('The prompt is empty \u2014 nothing to render.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Regenerating needs the bridge connected.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return Promise.resolve();
    }
    ceImagesPatch(function() { return { edBusy: true }; });
    return broadcastToTM('AE_IMG_REGEN', {
        uuid: String(st.edUuid), fp: fp, fu: String(_ceImgEditFuDraft || '').trim(),
        prompt: String(st.edPrompt || '')
    }).then(function() {
        try { api.v1.ui.toast('Regenerating \u2014 the picture updates in place when it lands.',
                              { type: 'info', autoClose: 3000 }); } catch (_e3) {}
        return null;
    }).catch(function(e: any) {
        api.v1.error('[AE:imgedit] regen failed:', e);
        ceImagesPatch(function() { return { edBusy: false }; });
        return null;
    });
}

function _ceImgEditRoot(): any {
    ceImagesStoreInit();
    var st = useStoreValue(ceImagesStore);
    var ui = useStoreValue(ceUiStore);
    var back: any = ceBack();

    // The uuid on the ROUTE wins over the one in the store: ceNav wrote it, and a store
    // still holding the previous record for one paint must not render as if that record
    // were this one.
    var uuid = String((ui && ui.entityId) || (st && st.edUuid) || '');
    if (!uuid) return ceScreen(ceHeader(back), [ceEmpty('No image selected.', null)]);
    if (!st || !st.edReady || String(st.edUuid || '') !== uuid) {
        return ceScreen(ceHeader(back), [ceEmpty('Loading image\u2026', null)]);
    }
    if (!st.edFound) {
        return ceScreen(ceHeader(back), [
            ceEmpty('That image is not in local storage. Records follow your account, but the '
                  + 'pictures themselves live in this browser only \u2014 it was probably generated '
                  + 'somewhere else.', null)
        ]);
    }

    var busy = !!st.edBusy;
    var meta: any = st.edMeta || {};
    var chars: any[] = meta.chars || [];
    var stamp = _ceGalleryStamp(Number(meta.createdAt) || 0);

    var body: any[] = [
        // The same anchored box the gallery's full view uses, so the bridge paints it with
        // no new anchor form -- and after a regeneration the forced repaint bridge-side
        // swaps the picture under it with nothing asked of this file.
        h('div', ceImgAnchor(CE_IMG_GAL, uuid, {
            key: 'edview:' + uuid,
            style: {
                width: '100%', height: '280px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_CONTAIN)),

        ceGroup('Prompt', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                'This is the prompt exactly as it was sent \u2014 preset fields, quality settings and '
              + 'character captions already compiled in. Editing it here changes what is sent and '
              + 'nothing else; your field library is not consulted again.'),
            h(ceField, {
                seed: 'imgedit:fp:' + uuid + ':' + String(st.edGen || 0),
                k: 'imgedit:fp', label: '', value: String(st.edFp || ''),
                multiline: true, rows: 5, well: true,
                placeholder: 'What the image should show',
                onType: function(v: string) { _ceImgEditFpDraft = v; },
                onCommit: function(v: string) { _ceImgEditFpDraft = v; return Promise.resolve(); }
            }),
            h(ceField, {
                seed: 'imgedit:fu:' + uuid + ':' + String(st.edGen || 0),
                k: 'imgedit:fu', label: 'Unwanted Content', value: String(st.edFu || ''),
                multiline: true, rows: 3, well: true,
                placeholder: 'What it should not show',
                onType: function(v: string) { _ceImgEditFuDraft = v; },
                onCommit: function(v: string) { _ceImgEditFuDraft = v; return Promise.resolve(); }
            })
        )),

        ceGroup('Regenerate', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
                'The new picture REPLACES this one everywhere it appears \u2014 in the story, in any '
              + 'chat that showed it, and in the gallery \u2014 because they all point at the same '
              + 'record. A new seed is used, so the same prompt gives a different image. If the '
              + 'render fails, the picture you have now is untouched.'),
            h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } },
                ceBtn(busy ? 'Rendering\u2026' : (isBridgeReady ? 'Regenerate' : 'Regenerate (needs bridge)'),
                      'imgedit:regen:' + uuid,
                      function() { return busy ? Promise.resolve() : ceImgEditRegen(); }, 'primary'),
                ceBtn('Use as new prompt', 'imgedit:use:' + uuid, function() {
                    _ceStudioSetPrompt(String(_ceImgEditFpDraft || st.edFp || ''));
                    ceNav('images');
                    ceTabSet('images', 'studio');
                    try { api.v1.ui.toast('Loaded into the Studio as a new image.', { type: 'success', autoClose: 2500 }); } catch (_e) {}
                    return Promise.resolve();
                }),
                ceBtn('Download', 'imgedit:dl:' + uuid, function() { return ceGalleryAction(uuid, 'download'); })
            )
        ))
    ];

    // Provenance, last and quiet: what this image was BEFORE the preset compile, who was in
    // it, and when. Read-only on purpose -- rewriting the original prompt would make the
    // record disagree with the pixels it is stamped on.
    var prov: any[] = [];
    if (st.edPrompt) {
        prov.push(h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } },
            'Originally described as: ' + _ceTrim(String(st.edPrompt), 300)));
    }
    if (chars.length) {
        var names: string[] = [];
        for (var ci = 0; ci < chars.length; ci++) {
            names.push(String((chars[ci] && (chars[ci].name || chars[ci].id)) || 'someone'));
        }
        prov.push(h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            'Characters: ' + names.join(', ')));
    }
    if (stamp) {
        prov.push(h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, 'Generated ' + stamp));
    }
    if (prov.length) {
        body.push(ceGroup('About this image',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } }, prov)));
    }

    return ceScreen(ceHeader(back), body);
}


// ============================================================================
// SECTION 36 — ENTITY SURFACE (jsx)  [v2.147.0 JSXENTITY]
// Phase E of CE-ROADMAP v0.2. Replaces openEntityEditModal (SECTION 20) AND the
// three openAdd*Modal creation popups with ONE surface that does both jobs, which
// is what the surface list actually asked for: "collapse the popup location
// creator into the edit modal for a combined creation/editing surface."
//
// IT HANGS OFF MAP EXACTLY AS PROFILE HANGS OFF SCENE, per user. That means a
// ceUiStore.surface VALUE ('entity') plus ceUiStore.entityId, routed in ceRoot and
// deliberately ABSENT from CE_SHELL_ROUTES — it is a detail view reached FROM a
// surface, not a destination of its own. Same status Profile has had since
// v2.109.0, same reason: the nav names places you can go, and "the thing I just
// tapped" is not one.
//   - The way back is ceUiStore.back, set by whoever navigated here. Map sets
//     { surface:'map', label:'Map' }; a child row inside this surface sets
//     { surface:'entity', entityId:<parent> }, so tapping down the tree and back
//     up works one deep — which is all NAV-BACK promises and all this needs,
//     because the Contents list also renders the parent as a row.
//
// ITS OWN STORE, on the JSXKIT-STORE-SPLIT rule (change frequency, not feature): a
// field commit here would otherwise repaint the Map's whole packed-circle SVG on
// every blur. cePublishEntity is the only writer.
//
// ONE WRITE PATH, ceEntityWrite, and it is SERIALISED (ceEntityOp). Entity storage
// is load-modify-save with no compare-and-swap, exactly like the Journal and the
// image slots, and this surface has more simultaneously-editable fields than
// either — two blurs landing close together would silently discard one. The
// legacy modal held ONE `ent` object across the whole modal's life and wrote it
// back from every handler, which is the same bug with a longer window.
//
// THE TYPE SWITCH IS ceSelect, NOT A ROW OF BUTTONS. Four fixed kinds is the
// textbook closed enum CE-STYLE SS8 reserves ceSelect for, and it is hook-free so
// it stays legal anywhere. The legacy four-button row re-opened the whole modal on
// every press.
//
// REFERENCES GO THROUGH THE PICKER (SS13). parentId, narrativeParentId and a new
// connection's target are all "names something the world already knows about", so
// all three are CE_PICKER_DEFS entries rather than the four hand-rolled
// openPickerModal / openEngineModal list popups the legacy modal carried.
//
// WHAT IS DELIBERATELY NOT HERE, AND WHY:
//   - [SUPERSEDED v2.148.0] v2.147.0 recorded the LOCATION IMAGE SLOT here as a
//     cross-artifact build that could not land engine-side. That was WRONG, and the
//     error is worth keeping rather than deleting: it was reasoned from the anchor
//     FORMAT ('<charId>|<slot>') instead of from the bridge's actual resolver, which
//     never looks the id up as a character. A location is just another id. The slot
//     is built — see _ceEntityImage — with no bridge change at all.
//   - Copy / Deep Copy. copyEntity(id, deep) survives untouched in SECTION 20 with
//     its native call sites; it is not a superseded-surface concern and duplicating
//     an entity is not an editing verb.
//   - The legacy modal is NOT deleted. Same discipline as every other surface here
//     (CE-SURFACE-COLLAPSE SS4): superseded, swept at the end, never piecemeal.
// ============================================================================

var CE_ENTITY_TYPES: any[] = [
    { id: 'location',  label: 'Location' },
    { id: 'item',      label: 'Item' },
    { id: 'narrative', label: 'Narrative' },
    { id: 'character', label: 'Character' }
];
var CE_ENTITY_STORY_STATES: any[] = [
    { id: 'locked',    label: 'Locked' },
    { id: 'active',    label: 'Active' },
    { id: 'completed', label: 'Done' }
];

// -- Store, publish, op-chain -------------------------------------------------
var ceEntityStore: any = null;
var _ceEntChain: Promise<any> = Promise.resolve();
// The lorebook-key composer draft. Module var, read by a button — CLICK-BEFORE-BLUR.
var _ceEntKeyDraft = '';

function ceEntityStoreInit(): void {
    if (ceEntityStore) return;
    try {
        ceEntityStore = createStore({
            ready: false, id: '', ent: null, index: [],
            parentName: '', narrParentName: '', children: [], presentChars: [],
            conns: [], confirm: '', keyGen: 0
        });
    } catch (e) { api.v1.error('[AE:jsxentity] store init failed:', e); }
}

function ceEntityPatch(fn: (s: any) => any): void {
    if (!ceEntityStore) return;
    try {
        ceEntityStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxentity] patch failed:', e); }
}

function ceEntityOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceEntChain.then(fn);
    _ceEntChain = run.catch(function() { return null; });
    return run;
}

async function cePublishEntity(id: string): Promise<void> {
    ceEntityStoreInit();
    if (!ceEntityStore || !id) return;
    try {
        var ent: any = await loadEntity(id);
        if (!ent) { ceEntityPatch(function() { return { ready: true, id: id, ent: null }; }); return; }
        var metas: any[] = await loadEntityIndex();

        var index: any[] = [];
        var children: any[] = [];
        var parentName = '';
        var narrParentName = '';
        var i = 0;
        for (i = 0; i < (metas || []).length; i++) {
            var m: any = metas[i];
            if (!m) continue;
            // parentId IS LOAD-BEARING, not decoration: ceMapWouldCycle walks byId[x].parentId
            // to reject a parent that is one of this node's own descendants. Without it the
            // guard silently returns false for every candidate and the picker offers loops.
            index.push({ id: String(m.id), name: String(m.name || 'Unnamed'),
                         type: String(m.type || ''), icon: String(m.icon || ''),
                         parentId: (m.parentId == null) ? null : String(m.parentId) });
            if (m.id === ent.parentId) parentName = String(m.name || 'Unnamed');
            if (m.id === ent.narrativeParentId) narrParentName = String(m.name || 'Unnamed');
            if (m.parentId === ent.id) {
                children.push({ id: String(m.id), name: String(m.name || 'Unnamed'),
                                type: String(m.type || ''), icon: String(m.icon || '') });
            }
        }

        // Characters standing in this entity. currentLocationId is the CharacterMeta
        // field, not a CharacterRecord one -- loadIndex is the right read here and
        // deleteEntity's own [CHANGE] note is the record of what reading the wrong one
        // costs.
        var presentChars: any[] = [];
        try {
            var cIdx: any[] = await loadIndex();
            for (i = 0; i < (cIdx || []).length; i++) {
                if (!cIdx[i] || cIdx[i].currentLocationId !== ent.id) continue;
                presentChars.push({ id: String(cIdx[i].id), name: String(cIdx[i].name || 'Unnamed') });
            }
        } catch (eC) { api.v1.error('[AE:jsxentity] char index read failed:', eC); }

        // Connection rows carry the resolved target name so the list renderer never
        // has to search the index per row.
        var conns: any[] = [];
        var raw: any[] = ent.connectedEntityIds || [];
        for (i = 0; i < raw.length; i++) {
            if (!raw[i]) continue;
            var tName = '';
            for (var j = 0; j < index.length; j++) {
                if (index[j].id === raw[i].targetId) { tName = index[j].name; break; }
            }
            conns.push({ targetId: String(raw[i].targetId || ''),
                         label: String(raw[i].label || ''),
                         name: tName || 'Missing entity' });
        }

        ceEntityPatch(function(s: any) {
            return { ready: true, id: id, ent: ent, index: index, children: children,
                     parentName: parentName, narrParentName: narrParentName,
                     presentChars: presentChars, conns: conns,
                     confirm: (s.id === id) ? s.confirm : '' };
        });
    } catch (e) {
        // Previous value survives a failed publish -- stale beats blank, same as Profile.
        api.v1.error('[AE:jsxentity] publish failed:', e);
    }
}

// -- The single write path ----------------------------------------------------
// Load, mutate, save, republish, and tell the rest of the app. The three
// side-effects at the end are the ones the legacy modal called by hand at each of
// its ~20 handlers and therefore sometimes did not: refreshSidebar (native shell),
// queueSceneStateBroadcast (bridge HUD), and a lorebook resync when the entity has
// a linked entry whose body this field feeds.
async function ceEntityWrite(id: string, key: string, value: any): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (key === 'icon') { e.icon = String(value || '').trim() || undefined; }
            else if (key === 'parentId' || key === 'narrativeParentId') {
                e[key] = String(value || '') || null;
            } else { e[key] = value; }
            await saveEntity(e);
            // NAME AND lorebookText ARE THE LOREBOOK'S OWN INPUTS -- the name is the
            // primary trigger key and lorebookText is the body -- so an edit to either
            // that is not resynced leaves the injected entry disagreeing with the record.
            if (e.lorebookEntryId && (key === 'name' || key === 'lorebookText' || key === 'description')) {
                try { await syncEntityLorebookEntry(id, true); } catch (eL) { api.v1.error('[AE:jsxentity] lore sync failed:', eL); }
            }
            await cePublishEntity(id);
            try { queueSceneStateBroadcast(); } catch (eB) {}
        } catch (e2) { api.v1.error('[AE:jsxentity] write failed:', e2); }
    });
}

// [v2.148.0 ENT-IMAGE] Width and height are two fields of ONE fact (the render shape), so
// they commit together for the same reason ceProfileWritePair exists for a reference's
// id+name. Not a general batch helper; do not grow it into one.
async function ceEntityWritePair(id: string, pairs: any[]): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            for (var i = 0; i < (pairs || []).length; i++) { e[pairs[i].k] = pairs[i].v; }
            await saveEntity(e);
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] paired write failed:', e2); }
    });
}

// Connection edits are an ARRAY mutation, not a field, so they get their own verb for
// the same reason ceProfileHookOp is separate from ceProfileWrite: routing them through
// a generic key/value setter would mean the caller assembling the array, and two callers
// assembling it is how one of them ends up dropping an element.
async function ceEntityConnOp(id: string, op: string, targetId: string, value: any): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (!Array.isArray(e.connectedEntityIds)) e.connectedEntityIds = [];
            if (op === 'add') {
                for (var a = 0; a < e.connectedEntityIds.length; a++) {
                    if (e.connectedEntityIds[a] && e.connectedEntityIds[a].targetId === targetId) return;
                }
                e.connectedEntityIds.push({ targetId: targetId, label: String(value || ''), resourceCost: 0 });
            } else {
                var kept: any[] = [];
                for (var i = 0; i < e.connectedEntityIds.length; i++) {
                    var c: any = e.connectedEntityIds[i];
                    if (!c) continue;
                    if (c.targetId === targetId) {
                        if (op === 'remove') continue;
                        if (op === 'label') c.label = String(value || '');
                    }
                    kept.push(c);
                }
                e.connectedEntityIds = kept;
            }
            await saveEntity(e);
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] conn op failed:', e2); }
    });
}

async function ceEntityKeyOp(id: string, op: string, value: string): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (!Array.isArray(e.lorebookTags)) e.lorebookTags = [];
            var t = String(value || '').trim();
            if (op === 'add') {
                if (!t) return;
                if (e.lorebookTags.indexOf(t) >= 0) return;
                e.lorebookTags.push(t);
            } else {
                var kept: string[] = [];
                for (var i = 0; i < e.lorebookTags.length; i++) {
                    if (e.lorebookTags[i] !== t) kept.push(e.lorebookTags[i]);
                }
                e.lorebookTags = kept;
            }
            await saveEntity(e);
            if (e.lorebookEntryId) {
                try { await syncEntityLorebookEntry(id, true); } catch (eL) { api.v1.error('[AE:jsxentity] lore sync failed:', eL); }
            }
            _ceEntKeyDraft = '';
            ceEntityPatch(function(s: any) { return { keyGen: (Number(s.keyGen) || 0) + 1 }; });
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] key op failed:', e2); }
    });
}

// The item equip toggle. NOT a plain field write: isEquipped and the owning
// character's equippedItemIds are two halves of one fact, and EQUIP-STATE-SYNC is the
// autopsy of what writing only the first one costs. aeSetEquip is the canonical verb
// the bridge and the AE_EQUIP_ITEM handler both already use; the owner is resolved by
// entityId match, which is the correction that bugfix made and the reason this is not
// loadCharacter(parentId).
async function ceEntitySetEquip(id: string, on: boolean): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var fe: any = await loadEntity(id);
            if (!fe) return;
            var owner: any = null;
            if (fe.parentId) {
                var all: any[] = await loadAllCharacters();
                for (var i = 0; i < (all || []).length; i++) {
                    if (all[i] && all[i].entityId === fe.parentId) { owner = all[i]; break; }
                }
            }
            await aeSetEquip(fe, owner, on);
            if (owner) {
                try { await broadcastCharacterData(); } catch (eB) {}
                try { await broadcastSceneState(); } catch (eB2) {}
            }
            await cePublishEntity(id);
        } catch (e) { api.v1.error('[AE:jsxentity] equip failed:', e); }
    });
}

// CREATION AND EDITING ARE THE SAME SURFACE, which is the whole point of the phase:
// make the record, then land on it. The three openAdd*Modal popups each collected a
// name up front and then dropped the user back where they started, so a new place was
// always followed by a second trip to describe it.
async function ceEntityCreate(type: string, parentId: string, back: any): Promise<void> {
    try {
        var ent: any = makeDefaultEntity('New ' + String(type || 'location'));
        ent.type = String(type || 'location');
        ent.parentId = String(parentId || '') || null;
        await saveEntity(ent);
        ceNav('entity', ent.id, '', back || null);
        await cePublishEntity(ent.id);
    } catch (e) {
        api.v1.error('[AE:jsxentity] create failed:', e);
        try { api.v1.ui.toast('Could not create that.', { type: 'error', autoClose: 2000 }); } catch (e2) {}
    }
}

async function ceEntityDelete(id: string, back: any): Promise<void> {
    try {
        await deleteEntity(id);
        try { queueSceneStateBroadcast(); } catch (eB) {}
        await cePublishMap();
        if (back && back.surface) { ceNav(String(back.surface), String(back.entityId || '')); }
        else { ceNav('map'); }
    } catch (e) { api.v1.error('[AE:jsxentity] delete failed:', e); }
}

// -- Sections -----------------------------------------------------------------

function _ceEntityPlacement(id: string, ent: any, st: any): any {
    var kids: any[] = [];
    kids.push(cePickerRow({
        label: 'Inside', value: String(st.parentName || ''),
        kind: 'entityParent', ctx: { id: id },
        placeholder: 'Nowhere \u2014 top of the world',
        hint: 'A child is physically inside its parent. Entering a room moves the scene down the tree; an item or a person parented to a place is in that place.'
    }));
    if (ent.type === 'narrative') {
        kids.push(cePickerRow({
            label: 'Part of', value: String(st.narrParentName || ''),
            kind: 'narrativeParent', ctx: { id: id },
            placeholder: 'Nothing \u2014 a root plot'
        }));
        kids.push(h('div', { key: 'ent_state', style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, 'Story state'),
            ceSelect({
                k: 'ent:state:' + id, value: String(ent.storyState || 'locked'),
                options: CE_ENTITY_STORY_STATES,
                onCommit: function(v: string) { return ceEntityWrite(id, 'storyState', v); }
            })
        ));
    }
    if (ent.type === 'item') {
        kids.push(ceSettingRow('Equipped', 'Folds this item into the wearer\u2019s own lorebook entry, rebuilt every generation.',
            ceToggle(!!ent.isEquipped, 'ent:equip:' + id, function() {
                return ceEntitySetEquip(id, !ent.isEquipped);
            }, 'Equipped')));
    }
    return ceGroup('Placement', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids));
}

function _ceEntityLore(id: string, ent: any, st: any): any {
    var linked = !!ent.lorebookEntryId;
    var tags: string[] = ent.lorebookTags || [];
    var keyRows: any[] = [];
    for (var i = 0; i < tags.length; i++) {
        keyRows.push((function(tg: string) {
            return ceListRow({
                label: tg,
                trail: ceIconBtn('Remove the key ' + tg, ceIconTrash(), 'ent:keydel:' + tg, function() {
                    return ceEntityKeyOp(id, 'remove', tg);
                }, 'danger')
            });
        })(tags[i]));
    }
    var kids: any[] = [
        h(ceField, {
            key: 'ent_lore', k: 'ent:lore:' + id, label: 'Entry',
            value: ent.lorebookText || '', multiline: true, rows: 4, well: true,
            placeholder: 'Extended info NOT already in the description \u2014 history, secrets, rules, reputation\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'lorebookText', v); }
        }),
        h('div', { key: 'ent_lore_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            linked
                ? 'Linked. Injects when the name or one of the keys below appears in the story.'
                : 'Not linked, so none of this reaches the story yet.'),
        h('div', { key: 'ent_lore_keyhead', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } },
            'Keys \u00b7 ' + ent.name + (tags.length ? '' : ' (the name is always a key)')),
        keyRows.length ? h('div', { key: 'ent_lore_keys', style: { display: 'flex', flexDirection: 'column' } }, keyRows) : null,
        h(ceField, {
            key: 'ent_key_add', k: 'ent:keyadd:' + id, label: '',
            value: '', seed: String(st.keyGen || 0),
            placeholder: 'Another trigger word or phrase\u2026',
            onType: function(v: string) { _ceEntKeyDraft = String(v || ''); },
            onCommit: function(v: string) { _ceEntKeyDraft = String(v || ''); return Promise.resolve(); }
        }),
        h('div', { key: 'ent_lore_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
            ceBtn('Add key', 'ent:keyadd:' + id, function() {
                return ceEntityKeyOp(id, 'add', _ceEntKeyDraft);
            }),
            ceBtn(linked ? 'Resync' : 'Link to lorebook', 'ent:lorelink:' + id, function() {
                var p = linked ? syncEntityLorebookEntry(id) : createLinkedEntityLorebookEntry(id);
                return Promise.resolve(p).then(function() { return cePublishEntity(id); });
            }, linked ? undefined : 'primary'),
            linked ? ceBtn('Unlink', 'ent:loreunlink:' + id, function() {
                return unlinkEntityLorebookEntry(id).then(function() { return cePublishEntity(id); });
            }, 'danger') : null
        )
    ];
    return ceGroup('Lorebook', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids));
}

function _ceEntityConns(id: string, st: any): any {
    var conns: any[] = st.conns || [];
    var kids: any[] = [];
    for (var i = 0; i < conns.length; i++) {
        kids.push((function(c: any) {
            return h('div', { key: 'ent_conn_' + c.targetId, style: {
                display: 'flex', alignItems: 'flex-end', gap: CE_T.s2,
                paddingBottom: CE_T.s2, borderBottom: '1px solid ' + CE_LINE
            } },
                h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                    h(ceField, {
                        key: 'ent_connf_' + c.targetId, k: 'ent:conn:' + id + ':' + c.targetId,
                        label: '\u2192 ' + c.name, value: c.label,
                        placeholder: 'How this route reads, e.g. \u201chead to the market\u201d',
                        onCommit: function(v: string) { return ceEntityConnOp(id, 'label', c.targetId, v); }
                    })),
                ceIconBtn('Remove the route to ' + c.name, ceIconTrash(), 'ent:conndel:' + c.targetId, function() {
                    return ceEntityConnOp(id, 'remove', c.targetId, null);
                }, 'danger')
            );
        })(conns[i]));
    }
    if (!kids.length) {
        kids.push(h('div', { key: 'ent_conn_none', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Parents and children already connect themselves. A route here is for somewhere the tree does not reach \u2014 a road, a door, a teleporter.'));
    }
    kids.push(cePickerRow({
        label: '', value: '', kind: 'entityConnection', ctx: { id: id },
        placeholder: 'Add a route\u2026'
    }));
    return ceGroup('Routes', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids));
}

// The surface list asked for this by name: "when a location is selected, add a list at
// bottom of characters and loose items with that location as their parentID." Children
// and standing characters are the same question asked of the graph twice, so they are
// one list with a kind sub-line rather than two headed blocks.
function _ceEntityContents(id: string, ent: any, st: any): any {
    var rows: any[] = [];
    var kids: any[] = st.children || [];
    var i = 0;
    for (i = 0; i < kids.length; i++) {
        rows.push((function(k: any) {
            return ceListRow({
                lead: k.icon ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fs } }, k.icon) : null,
                label: k.name, sub: k.type,
                onClick: function() {
                    ceNav('entity', k.id, '', { surface: 'entity', entityId: id, label: ent.name || 'Back' });
                }
            });
        })(kids[i]));
    }
    var pcs: any[] = st.presentChars || [];
    for (i = 0; i < pcs.length; i++) {
        rows.push((function(c: any) {
            return ceListRow({
                label: c.name, sub: 'standing here',
                onClick: function() {
                    ceNav('profile', c.id, '', { surface: 'entity', entityId: id, label: ent.name || 'Back' });
                }
            });
        })(pcs[i]));
    }
    if (!rows.length) {
        rows.push(h('div', { key: 'ent_cont_none', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3 } }, 'Nothing in here yet.'));
    }
    var adders = h('div', { key: 'ent_cont_add', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', paddingTop: CE_T.s2 } },
        ceBtn('New place', 'ent:new:location:' + id, function() {
            return ceEntityCreate('location', id, { surface: 'entity', entityId: id, label: ent.name || 'Back' });
        }),
        ceBtn('New item', 'ent:new:item:' + id, function() {
            return ceEntityCreate('item', id, { surface: 'entity', entityId: id, label: ent.name || 'Back' });
        })
    );
    return ceGroup('Contents',
        h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows.concat([adders])));
}


// -- The image slot -----------------------------------------------------------
// [v2.148.0 ENT-IMAGE, per user: "locations use the character visual architecture, it just
// has a different UI since it doesn't need a bunch of images"] THERE IS NO LOCATION IMAGE
// PATH AND THERE MUST NOT BE ONE. v2.147.0 deferred this as a cross-artifact build; that
// was wrong, and checking the bridge rather than reasoning from the anchor format is what
// showed it. THE BRIDGE'S IMAGE LAYER IS ENTIRELY ID-AGNOSTIC:
//   - _ceSurfImgResolve(charId, slot) ends at _loadPortrait(charId + '_em_' + slot). It
//     never looks the id up as a character.
//   - The EVT_GENERATE_IMAGE kind:'charSlot' branch saves to p.charId + '_em_' + p.slot,
//     with the comment "p.slot is the raw slot name... never re-derived here".
//   - AE_CHAR_IMAGE_ACTION builds the same key for delete / download / edit.
// So an ENTITY id in the charId position simply works. Zero bridge changes.
//
// THE SLOT IS 'Avatar', AND THAT CHOICE IS LOAD-BEARING RATHER THAN ARBITRARY. Avatar is
// the one slot _ceSurfImgResolve routes through _loadCharAvatarImage, which tries
// '<id>_em_Avatar' and THEN falls back to the pre-2.3.0 '<id>_portrait'. The bridge's old
// location sheet wrote location images to exactly '<locId>_portrait' (its "Generate Scene"
// button). Picking Avatar therefore makes every location image the user already has appear
// on this surface with no migration. Any other slot name would have shown them an empty
// frame beside a file they know exists.
//
// THE PROMPT IS BASE, NOT A CHARACTER ENTRY. ceImgSlotGenerate puts a character's visuals
// in characters[], which is what drives NAI's v4.5 per-character captions -- correct for a
// person, wrong for a room, and the bridge's own retired location generator agrees: it
// composed [quality, locationVisuals] into the base prompt with an empty characters array.
// This reproduces that through extraBaseVisuals, which buildRequestBody already folds into
// fp at the same position.
async function ceEntityImgGenerate(id: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected \u2014 image generation requires bridge.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
        return;
    }
    try {
        var e: any = await loadEntity(id);
        if (!e) return;
        var vis = String(e.locationVisuals || '').trim();
        if (!vis) {
            try { api.v1.ui.toast('Write some visuals first \u2014 there is nothing to draw from.', { type: 'warning', autoClose: 3000 }); } catch (e1) {}
            return;
        }
        var compiled = compileActiveImageFields();
        await broadcastToTM(EVT_GENERATE_IMAGE, {
            uuid: api.v1.uuid(),
            prompt: '',
            characters: [],
            extraBaseVisuals: vis,
            extraBaseUC: '',
            charId: e.id,
            entityId: e.id,
            kind: 'charSlot',
            slot: CE_IMG_SLOT_AVATAR,
            settings: {
                width: Number(e.imgWidth) || 1216,
                height: Number(e.imgHeight) || 832,
                steps: Math.min(globalSettings.defaultSteps || 28, 28),
                scale: globalSettings.defaultScale || 5.0,
                seed: Math.floor(Math.random() * 4294967295),
                quality: compiled.quality,
                negative: compiled.negative
            },
            autoDownload: false
        });
        try { api.v1.ui.toast('Generating\u2026', { type: 'info', autoClose: 2000 }); } catch (e2) {}
    } catch (e3) { api.v1.error('[AE:jsxentity] image generate failed:', e3); }
}

function _ceEntityImage(id: string, ent: any, st: any): any {
    // ONE FRAME, NOT A GRID. That is the whole UI difference the user named: the
    // architecture is shared, the surface is not. Landscape by default because a place
    // usually is; 16:9-ish box so the frame matches what will land in it.
    var w = Number(ent.imgWidth) || 1216;
    var hh = Number(ent.imgHeight) || 832;
    var cur = String(w) + 'x' + String(hh);
    var opts: any[] = [];
    var known = false;
    for (var i = 0; i < CE_IMG_RATIO_OPTS.length; i++) {
        opts.push(CE_IMG_RATIO_OPTS[i]);
        if (CE_IMG_RATIO_OPTS[i].id === cur) known = true;
    }
    if (!known) { opts.push({ id: cur, label: 'Custom \u2014 ' + String(w) + '\u00d7' + String(hh) }); }

    // A FIXED PIXEL HEIGHT, NOT aspect-ratio. The painter appends its <img> as
    // position:absolute with height:100%, so the anchor must have a real height of its own;
    // `aspectRatio` would probably supply one, but it has no precedent anywhere in this
    // file and nothing here is built on a CSS property this environment has not been
    // observed handling. Three heights matching the three shapes is the boring version that
    // cannot surprise anyone, and it is what every other image frame in the kit already does.
    var frameH = (hh > w) ? '320px' : ((hh === w) ? '260px' : '200px');
    var frame = h('div', ceImgAnchor(id, CE_IMG_SLOT_AVATAR, {
        style: { width: '100%', height: frameH,
            borderRadius: CE_T.r, background: CE_WELL, border: '1px solid ' + CE_LINE,
            position: 'relative', overflow: 'hidden' }
    }));

    var confirming = (String(st.confirm || '') === 'img');
    var acts: any[] = [
        ceBtn('Generate', 'ent:imggen:' + id, function() { return ceEntityImgGenerate(id); }, 'primary'),
        ceIconBtn('Edit this image\u2019s prompt', ceIconEdit(), 'ent:imgedit:' + id,
            function() { return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'edit'); }),
        ceIconBtn('Download this image', ceIconDownload(), 'ent:imgdl:' + id,
            function() { return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'download'); }),
        // DESTRUCTIVE-NEVER-IN-PLACE: this button asks, and the handler is the same in both
        // states, so TAP-GUARD's double-fire cannot land the confirmed branch off one tap.
        confirming
            ? ceBtn('Delete it', 'ent:imgdel:' + id, function() {
                ceEntityPatch(function() { return { confirm: '' }; });
                return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'delete');
              }, 'danger')
            : ceIconBtn('Delete this image', ceIconTrash(), 'ent:imgdelask:' + id, function() {
                ceEntityPatch(function() { return { confirm: 'img' }; });
                return Promise.resolve();
              }, 'danger')
    ];

    return ceGroup('Image', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        frame,
        h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', alignItems: 'center' } }, acts),
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, 'Shape'),
            ceSelect({
                k: 'ent:ratio:' + id, value: cur, options: opts,
                onCommit: function(v: string) {
                    var cut = String(v || '').indexOf('x');
                    if (cut < 0) return Promise.resolve();
                    var nw = Number(String(v).slice(0, cut)) || 1216;
                    var nh = Number(String(v).slice(cut + 1)) || 832;
                    return ceEntityWritePair(id, [{ k: 'imgWidth', v: nw }, { k: 'imgHeight', v: nh }]);
                }
            })
        ),
        // The gap the frame cannot fill by itself. Deliberately stated rather than left as
        // an empty box: submitDirectorPhoto's own first guard is isBridgeReady, because the
        // pixels come from a fetch that does not exist in this sandbox.
        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Drawn from the visuals above. Generating needs the bridge; an image made by an older version of the location sheet already shows here.')
    ));
}

// -- Root ---------------------------------------------------------------------
function _ceEntityRoot(): any {
    ceEntityStoreInit();
    var ui = useStoreValue(ceUiStore);
    var st = useStoreValue(ceEntityStore);
    var id = ui ? String(ui.entityId || '') : '';

    useEffect(function() { if (id) { cePublishEntity(id); } }, [id]);

    var back: any = ceBack();
    var backAddr: any = (ui && ui.back) || null;

    if (!st || !st.ready || st.id !== id) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    if (!st.ent) {
        return ceScreen(ceHeader(back), ceEmpty('That entity is no longer in the world.', null));
    }

    var ent: any = st.ent;
    var body: any[] = [];

    // Identity. Name and icon share a row because the icon is one glyph and a full-width
    // field for it would claim the same weight as the name.
    body.push(h('div', { key: 'ent_id', style: { display: 'flex', gap: CE_T.s2, alignItems: 'flex-end' } },
        h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
            h(ceField, {
                key: 'ent_name', k: 'ent:name:' + id, label: 'Name',
                value: ent.name || '', placeholder: 'What it is called\u2026',
                onCommit: function(v: string) { return ceEntityWrite(id, 'name', v); }
            })),
        h('div', { style: { flex: '0 0 68px' } },
            h(ceField, {
                key: 'ent_icon', k: 'ent:icon:' + id, label: 'Icon',
                value: ent.icon || '', placeholder: '\ud83c\udf0d',
                onCommit: function(v: string) { return ceEntityWrite(id, 'icon', v); }
            }))
    ));

    body.push(h('div', { key: 'ent_type', style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, 'Kind'),
        ceSelect({
            k: 'ent:type:' + id, value: String(ent.type || 'location'),
            options: CE_ENTITY_TYPES,
            onCommit: function(v: string) { return ceEntityWrite(id, 'type', v); }
        })
    ));

    body.push(h('div', { key: 'ent_place' }, _ceEntityPlacement(id, ent, st)));

    var descKids: any[] = [
        h(ceField, {
            key: 'ent_desc', k: 'ent:desc:' + id, label: '',
            value: ent.description || '', multiline: true, rows: 4, well: true,
            placeholder: 'What is sensed on arrival\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'description', v); }
        })
    ];
    if (ent.type === 'location') {
        descKids.push(h(ceField, {
            key: 'ent_vis', k: 'ent:vis:' + id, label: 'Visuals',
            value: ent.locationVisuals || '', multiline: true, rows: 2,
            placeholder: 'Image tags for how this place looks \u2014 \u201cstone tavern interior, fireplace, wooden beams\u201d',
            onCommit: function(v: string) { return ceEntityWrite(id, 'locationVisuals', v); }
        }));
        descKids.push(h('div', { key: 'ent_vis_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'These tags are what a picture of this place is generated from \u2014 see Image, below.'));
    }
    body.push(h('div', { key: 'ent_descg' }, ceGroup('Description', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, descKids))));

    // Locations only. An item or a plot has no scene to draw, and a 'character' entity is
    // the BODY of a CharacterRecord whose real image surface is the Profile's Images drill
    // -- offering a second one here would be two editors for one set of slots.
    if (ent.type === 'location') {
        body.push(h('div', { key: 'ent_img' }, _ceEntityImage(id, ent, st)));
    }

    if (ent.type !== 'character') {
        body.push(h('div', { key: 'ent_loreg' }, _ceEntityLore(id, ent, st)));
    }
    body.push(h('div', { key: 'ent_conng' }, _ceEntityConns(id, st)));
    body.push(h('div', { key: 'ent_contg' }, _ceEntityContents(id, ent, st)));

    // Delete confirms IN PLACE rather than through confirmDeleteEntity's native modal --
    // a jsx surface that opens a UIPart modal to ask a yes/no question is the overlay
    // pattern JSXPROFILE-NO-OVERLAY rules out, and the Images gallery already settled the
    // in-surface shape (galConfirm).
    var confirming = (String(st.confirm || '') === id);
    body.push(h('div', { key: 'ent_del', style: {
        display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', alignItems: 'center',
        paddingTop: CE_T.s4, borderTop: '1px solid ' + CE_LINE
    } },
        confirming
            ? h('div', { style: { flex: '1 1 160px', fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
                'Delete ' + (ent.name || 'this') + '? Anything inside it moves to the top of the world rather than going with it.')
            : null,
        confirming
            ? ceBtn('Delete', 'ent:del:' + id, function() { return ceEntityDelete(id, backAddr); }, 'danger')
            : ceIconBtn('Delete ' + (ent.name || 'this'), ceIconTrash(), 'ent:delask:' + id, function() {
                ceEntityPatch(function() { return { confirm: id }; });
                return Promise.resolve();
              }, 'danger'),
        confirming
            ? ceBtn('Keep it', 'ent:delno:' + id, function() {
                ceEntityPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
              })
            : null
    ));

    return ceScreen(ceHeader(back), body);
}

// ============================================================================
// SECTION 37 — WIZARD SURFACE (jsx)
// World generation: species, factions, locations, narratives, the cast, the intro.
//
// THE GENERATORS ARE NOT HERE. Every one of them is a free function with no UI
// dependency, and this section only renders them. A pass on this section that
// edits a generator body has drifted.
//
// A ROUTE WITH tray:false, like Settings.
//
// FOUR STRUCTURAL RULES:
//   1. The context checklist and the count-and-Generate row are ONE component
//      each, reused by every tab.
//   2. Staging is ONE component driven by WIZ_DRAFT_FIELDS.
//   3. COMMITTED RECORDS ARE EDITED WHERE THEY LIVE, NOT HERE. Species and
//      factions on Settings, locations and narratives on the Entity surface.
//      What stays is the part only the wizard has -- the per-record Regen
//      against chosen context -- plus a row that navigates to the real editor.
//   4. Project Name / Genre / Initial Concept live on the Setup tab. They are
//      the seed EVERY generator on this surface reads through
//      buildWizardMultiContext.
//
// TABS ARE ceTabGet / ceTabSet.
//
// PUBLISH IS TAB-SCOPED. cePublishWiz reads the active tab and loads only what
// that tab renders: loadAllCharacters and loadNpcWeb are Drama's alone, the
// entity index is Locations/Intro/Drama's. A tab change republishes. The native
// surface reloaded everything on every keystroke-driven redraw; this does not.
//
// WRITE CHAINS, BY STORAGE, NOT BY SURFACE: config -> ceSettingsOp (it is the
// config chain and Settings already owns it; a second chain over one store is
// the bug both chains exist to prevent), entities -> ceEntityOp, characters ->
// ceProfileOp, drafts/web/intro -> ceWizOp. Where a verb needs two, the fixed
// global order holds: ceEntityOp OUTER, ceProfileOp INNER.
//
// WHAT IS DELIBERATELY ABSENT:
//   - A Help tab (it was an icon catalogue for build-time reference).
//   - Creating a classic wizard chat. loadWizardChats and its siblings are
//     DEAD-PENDING; existing chats are offered as context sources and nothing
//     here offers to make one.
//   - DEFAULT_WIZARD_TOPICS' 'Bestiary' and 'Items', DEAD-PENDING since v2.19.0
//     with their generators already removed.
//   - Per-item regen hints in tempStorage. The hint is a module var here and
//     dies with the tap.
// ============================================================================

var CE_WIZ_TABS: any[] = [
    { id: 'setup',      label: 'Setup' },
    // [v2.157.0 JSXWIZCHAT, per user] SECTION 3e's WIZLIVE, which v2.155.0 deliberately
    // left out ("reachable from outside the wizard, NOT a superseded view") and routed to
    // the Chat surface instead. THAT ROUTING WAS WRONG IN PRACTICE: CharChat is a character
    // texting you, WIZLIVE is a planning conversation whose saved output becomes the context
    // every generator on the other seven tabs reads. Sending an author to CharChat for that
    // job left the whole surface with no way to make the thing it consumes -- which is also
    // why the generator tabs read as "missing context selection": _ceWizSources was fine,
    // it just had nothing to list. Second position, directly after Setup, because it feeds
    // everything to its right.
    { id: 'chat',       label: 'Chat' },
    { id: 'memory',     label: 'Memory' },
    { id: 'species',    label: 'Species' },
    { id: 'factions',   label: 'Factions' },
    { id: 'locations',  label: 'Locations' },
    { id: 'characters', label: 'Characters' },
    { id: 'drama',      label: 'Drama' },
    { id: 'intro',      label: 'Intro' }
];

// The tempStorage token per tab, and it is NOT always the tab id: the native species and
// factions branch writes the singular DRAFT kind while characters and locations write the
// plural TAB id. Load-bearing while the native surface is alive, since both read the same
// keys. Verified against the native branches at 20859, 20933, 21036, 21156, 21239, 21444.
var CE_WIZ_SRC_KIND: { [tab: string]: string } = {
    memory: 'memory', species: 'species', factions: 'faction',
    locations: 'locations', characters: 'characters', drama: 'drama', intro: 'intro'
};
var CE_WIZ_COUNT_DEFAULT: { [tab: string]: number } = {
    species: 3, factions: 3, locations: 3, characters: 2, web: 3, narrative: 3
};

// -- Store, publish, op-chain -------------------------------------------------
var ceWizStore: any = null;
var _ceWizChain: Promise<any> = Promise.resolve();
// Read by BUTTONS, so they cannot live in the state the button renders from --
// CLICK-BEFORE-BLUR, the same shape and reason as _ceEntKeyDraft and _cePickDraft.
var _ceWizAddName = '';
var _ceWizHints: { [id: string]: string } = {};

// [v2.157.0 JSXWIZCHAT] Chat-tab drafts. Same CLICK-BEFORE-BLUR rule as every other draft
// on this surface: module vars, never store state, because Start/Save are CLICKS and a
// click is delivered before the blur that would commit a ceField.
//   _ceWizChatPersona  — the topic id chosen for a NOT-YET-STARTED chat ('' = general)
//   _ceWizChatCtxPick  — { entryId: true } context preselected for a not-yet-started chat
//                        (the native _wizModalCtxPick, verbatim in role)
//   _ceWizChatTitle    — rename draft for a LIVE chat
//   _ceWizChatSummary  — the editable summary preview before it is banked
var _ceWizChatPersona = '';
var _ceWizChatCtxPick: { [id: string]: boolean } = {};
var _ceWizChatTitle = '';
var _ceWizChatSummary = '';

function ceWizStoreInit(): void {
    if (ceWizStore) return;
    try {
        ceWizStore = createStore({
            ready: false, tab: '', cfg: null,
            chats: [], ceEntries: [], drafts: [], roster: [],
            activeChatId: '', srcSel: {}, counts: {},
            entIndex: [], locParent: '', locParentName: '', locParentUp: '',
            chars: [], web: [], hookSel: [],
            introLocId: '', introLocName: '', introProse: '',
            // [v2.157.0 JSXWIZCHAT] `live` is a PROJECTION of _aeLiveWiz (SECTION 3e), not a
            // second copy of it: the module var stays authoritative and this is refreshed by
            // cePublishWiz like everything else here. `summary` holds a generated preview
            // awaiting the author's Save -- it is deliberately store state and not a module
            // var, unlike the draft above, because its ARRIVAL must repaint.
            live: null, summary: '',
            preview: null, confirm: '', addGen: 0, draftGen: 0
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] store init failed:', e); }
}

function ceWizPatch(fn: (s: any) => any): void {
    if (!ceWizStore) return;
    try {
        ceWizStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] patch failed:', e); }
}

// Serialises this surface's own load-modify-save writes: the draft list, the NPC web and
// the intro draft, each of which is rewritten whole. Config, entity and character writes
// go to their own chains instead -- see the header.
//
// A GENERATION NEVER RUNS INSIDE IT, which is why Generate, Regen and Commit are not
// wrapped. See the note above _ceWizCommit.
function ceWizOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceWizChain.then(fn);
    _ceWizChain = run.catch(function() { return null; });
    return run;
}

function _ceWizReadSrc(tab: string, chats: any[], entries: any[]): Promise<string[]> {
    var token = CE_WIZ_SRC_KIND[tab] || tab;
    return Promise.resolve(api.v1.tempStorage.getOrDefault(STORAGE_WIZ_TAB_SRC + token, ''))
        .then(function(raw: any) {
            var ids: string[] = [];
            try {
                var parsed = JSON.parse(String(raw || '') || '[]');
                var pi = 0;
                for (pi = 0; pi < (parsed || []).length; pi++) { if (parsed[pi]) ids.push(String(parsed[pi])); }
            } catch (eSrc) { ids = []; }
            var live: string[] = [];
            var li = 0;
            for (li = 0; li < ids.length; li++) {
                var wanted = ids[li];
                var found = false;
                var ci = 0;
                for (ci = 0; ci < (chats || []).length; ci++) { if (chats[ci] && chats[ci].id === wanted) found = true; }
                var ei = 0;
                for (ei = 0; ei < (entries || []).length; ei++) { if (entries[ei] && entries[ei].id === wanted) found = true; }
                if (found) live.push(wanted);
            }
            return live;
        })
        .catch(function() { return []; });
}

function _ceWizReadCount(token: string, fallback: number): Promise<number> {
    return Promise.resolve(api.v1.tempStorage.getOrDefault(STORAGE_WIZ_GEN_COUNT + token, fallback))
        .then(function(v: any) {
            var n = Number(v);
            if (!isFinite(n)) n = fallback;
            return Math.max(1, Math.min(8, Math.round(n)));
        })
        .catch(function() { return fallback; });
}

function _ceWizReadIdList(key: string): Promise<string[]> {
    return Promise.resolve(api.v1.tempStorage.getOrDefault(key, ''))
        .then(function(raw: any) {
            var out: string[] = [];
            try {
                var parsed = JSON.parse(String(raw || '') || '[]');
                var i = 0;
                for (i = 0; i < (parsed || []).length; i++) { if (parsed[i]) out.push(String(parsed[i])); }
            } catch (eList) { out = []; }
            return out;
        })
        .catch(function() { return []; });
}

// ONE LOAD, SCOPED TO THE ACTIVE TAB. Sequential awaits throughout -- no Promise.all.
async function cePublishWiz(): Promise<void> {
    ceWizStoreInit();
    if (!ceWizStore) return;
    try {
        var tab = ceTabGet('wizard', 'setup');

        var cfg: any = null;
        try { cfg = await loadConfig(); } catch (eCfg) { cfg = null; }
        var chats: any[] = [];
        try { chats = (await loadWizardChats()) || []; } catch (eChats) { chats = []; }
        var entries: any[] = [];
        try { entries = (await listWizChatEntries()) || []; } catch (eEntries) { entries = []; }
        var drafts: any[] = [];
        try { drafts = (await loadWizardDrafts()) || []; } catch (eDrafts) { drafts = []; }
        var activeId = '';
        try { activeId = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_ACTIVE_CHAT, '')) || ''); }
        catch (eActive) { activeId = ''; }

        var srcSel: any = {};
        var counts: any = {};
        if (CE_WIZ_SRC_KIND[tab]) {
            srcSel[tab] = await _ceWizReadSrc(tab, chats, entries);
        }
        if (CE_WIZ_COUNT_DEFAULT[tab]) {
            counts[tab] = await _ceWizReadCount(CE_WIZ_SRC_KIND[tab] || tab, CE_WIZ_COUNT_DEFAULT[tab]);
        }

        var roster: any[] = [];
        if (tab === 'characters') {
            try { roster = (await loadIndex()) || []; } catch (eRoster) { roster = []; }
        }

        // The entity index backs three tabs and the intro picker; nothing else reads it.
        var entIndex: any[] = [];
        if (tab === 'locations' || tab === 'intro' || tab === 'drama') {
            try { entIndex = (await loadEntityIndex()) || []; } catch (eIdx) { entIndex = []; }
        }

        var locParent = '';
        var locParentName = '';
        var locParentUp = '';
        if (tab === 'locations') {
            try { locParent = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_LOC_PARENT, '')) || ''); }
            catch (eLp) { locParent = ''; }
            if (locParent) {
                var pMeta: any = null;
                var pi2 = 0;
                for (pi2 = 0; pi2 < entIndex.length; pi2++) { if (String(entIndex[pi2].id) === locParent) pMeta = entIndex[pi2]; }
                if (!pMeta) {
                    // The parent was deleted out from under the breadcrumb. Reset rather
                    // than render a dead crumb, exactly as the native branch does.
                    locParent = '';
                    try { await api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, ''); } catch (eLpr) {}
                } else {
                    locParentName = String(pMeta.name || 'Unnamed');
                    locParentUp = String(pMeta.parentId || '');
                }
            }
        }

        var chars: any[] = [];
        var web: any[] = [];
        var hookSel: string[] = [];
        if (tab === 'drama') {
            try { chars = (await loadAllCharacters()) || []; } catch (eChars) { chars = []; }
            try { web = (await loadNpcWeb()) || []; } catch (eWeb) { web = []; }
            hookSel = await _ceWizReadIdList(STORAGE_WIZ_HOOK_CHARS);
            var liveSel: string[] = [];
            var hi = 0;
            for (hi = 0; hi < hookSel.length; hi++) {
                var hOk = false;
                var hj = 0;
                for (hj = 0; hj < chars.length; hj++) { if (chars[hj] && chars[hj].id === hookSel[hi]) hOk = true; }
                if (hOk) liveSel.push(hookSel[hi]);
            }
            hookSel = liveSel;
            counts['web'] = await _ceWizReadCount('web', 3);
            counts['narrative'] = await _ceWizReadCount('narrative', 3);
        }

        var introLocId = '';
        var introLocName = '';
        var introProse = '';
        if (tab === 'intro') {
            try { introLocId = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_INTRO_LOC, '')) || ''); }
            catch (eIl) { introLocId = ''; }
            if (introLocId) {
                var iFound = false;
                var ii2 = 0;
                for (ii2 = 0; ii2 < entIndex.length; ii2++) {
                    if (String(entIndex[ii2].id) === introLocId) { iFound = true; introLocName = String(entIndex[ii2].name || 'Unnamed'); }
                }
                if (!iFound) {
                    introLocId = '';
                    try { await api.v1.tempStorage.set(STORAGE_WIZ_INTRO_LOC, ''); } catch (eIlr) {}
                }
            }
            var idr: any = null;
            try { idr = await loadIntroDraft(); } catch (eId) { idr = null; }
            introProse = String((idr && idr.prose) || '');
        }

        // [v2.157.0 JSXWIZCHAT] Live WIZLIVE state, projected. Read UNCONDITIONALLY rather
        // than under `if (tab === 'chat')` like the other tab-scoped reads above: a chat
        // being open is a constraint on the WHOLE surface (startLiveWizardChat refuses while
        // one is active, and so does the classic wizard), so a tab that cannot see it would
        // offer buttons that can only fail. It costs nothing -- _aeLiveWiz is a module var,
        // not a storage read.
        var live: any = null;
        try {
            live = {
                active: !!_aeLiveWiz.active,
                title: String(_aeLiveWiz.title || ''),
                topicId: String(_aeLiveWiz.topicId || ''),
                startedAt: Number(_aeLiveWiz.startedAt || 0),
                ctxIds: (_aeLiveWiz.contextEntryIds || []).slice()
            };
        } catch (eLive) { live = null; }

        ceWizPatch(function(s: any) {
            return { ready: true, tab: tab, cfg: cfg, chats: chats, ceEntries: entries,
                     drafts: drafts, roster: roster, activeChatId: activeId,
                     srcSel: srcSel, counts: counts, entIndex: entIndex,
                     locParent: locParent, locParentName: locParentName, locParentUp: locParentUp,
                     chars: chars, web: web, hookSel: hookSel,
                     introLocId: introLocId, introLocName: introLocName, introProse: introProse,
                     live: live, summary: String(s.summary || ''),
                     draftGen: Number(s.draftGen || 0) + 1 };
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] publish failed:', e); }
}

// -- Shared helpers -----------------------------------------------------------
// The ids a generator on this tab will actually receive: whatever is checked, else the
// active classic chat if one exists, else nothing and the generator runs on the project
// concept alone. Identical fallback chain to every native branch.
function _ceWizEffSrc(st: any, tab: string): string[] {
    var sel: string[] = ((st && st.srcSel && st.srcSel[tab]) || []) as string[];
    if (sel.length) return sel.slice();
    var act = String((st && st.activeChatId) || '');
    if (act) return [act];
    return [];
}

function _ceWizDraftsOf(st: any, kind: string): any[] {
    var all: any[] = (st && st.drafts) || [];
    var out: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) { if (all[i] && all[i].kind === kind) out.push(all[i]); }
    return out;
}

// Writes tempStorage AND patches the store rather than republishing: a republish would
// re-read the lorebook and the whole draft list to move one checkmark.
function _ceWizToggleSrc(tab: string, id: string): Promise<any> {
    var token = CE_WIZ_SRC_KIND[tab] || tab;
    var cur: string[] = [];
    try {
        var s: any = ceWizStore ? ceWizStore.get() : null;
        cur = ((s && s.srcSel && s.srcSel[tab]) || []).slice();
    } catch (eCur) { cur = []; }
    var at = cur.indexOf(id);
    if (at >= 0) { cur.splice(at, 1); } else { cur.push(id); }
    var next = cur;
    ceWizPatch(function(s2: any) {
        var sel: any = {}; var k: string;
        for (k in (s2.srcSel || {})) { sel[k] = s2.srcSel[k]; }
        sel[tab] = next;
        // The preview is a snapshot of the OLD selection the moment this lands, so it is
        // dropped rather than left on screen lying about what would be sent.
        return { srcSel: sel, preview: null };
    });
    return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_TAB_SRC + token, JSON.stringify(next)))
        .catch(function(e: any) { api.v1.error('[AE:jsxwizard] source write failed:', e); });
}

function _ceWizSetCount(token: string, n: number): Promise<any> {
    var clamped = Math.max(1, Math.min(8, Math.round(Number(n) || 1)));
    ceWizPatch(function(s: any) {
        var c: any = {}; var k: string;
        for (k in (s.counts || {})) { c[k] = s.counts[k]; }
        c[token] = clamped;
        return { counts: c };
    });
    return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_GEN_COUNT + token, clamped))
        .catch(function(e: any) { api.v1.error('[AE:jsxwizard] count write failed:', e); });
}

// THE CONTEXT CHECKLIST, ONCE. Chips rather than checkbox rows: this is a multi-select
// over short labels, which is what CE-STYLE gives ceChip for, and a column of full-width
// 44px rows for six saved chats would push Generate off a phone screen before it was
// reachable.
function _ceWizSources(tab: string, st: any): any {
    var chats: any[] = (st && st.chats) || [];
    var entries: any[] = (st && st.ceEntries) || [];
    var sel: string[] = ((st && st.srcSel && st.srcSel[tab]) || []) as string[];
    var chips: any[] = [];
    var i = 0;
    for (i = 0; i < chats.length; i++) {
        chips.push((function(c: any) {
            var cid = String(c.id);
            return ceChip(String(c.title || 'Untitled chat'), sel.indexOf(cid) >= 0, function() {
                ceAction('wiz:src:' + tab + ':' + cid, function() { return _ceWizToggleSrc(tab, cid); });
            });
        })(chats[i]));
    }
    for (i = 0; i < entries.length; i++) {
        chips.push((function(e: any) {
            var eid = String(e.id);
            return ceChip(String(e.displayName || 'Untitled chat'), sel.indexOf(eid) >= 0, function() {
                ceAction('wiz:src:' + tab + ':' + eid, function() { return _ceWizToggleSrc(tab, eid); });
            });
        })(entries[i]));
    }

    var act = String((st && st.activeChatId) || '');
    var actName = '';
    for (i = 0; i < chats.length; i++) { if (chats[i] && String(chats[i].id) === act) actName = String(chats[i].title || ''); }
    var hint = sel.length
        ? (sel.length + ' selected.')
        : (actName ? ('Nothing selected \u2014 using the active chat \u201c' + actName + '\u201d.')
                   : 'Nothing selected \u2014 generating from the project concept only.');

    var body: any[] = [];
    if (chips.length) {
        body.push(h('div', { key: 'wsrc_chips', style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2 } }, chips));
    } else {
        body.push(h('div', { key: 'wsrc_none', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'No saved chats in this story. Generation uses the project concept only \u2014 fill in Setup if it is blank.'));
    }
    body.push(h('div', { key: 'wsrc_hint', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } }, hint));
    body.push(h('div', { key: 'wsrc_pv' }, _ceWizPreview(tab, st)));
    return ceGroup('Context', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } }, body));
}

// Preview, IN SURFACE. The native version opens a UIPart modal over the wizard, which is
// the overlay pattern JSXPROFILE-NO-OVERLAY rules out for this shell.
function _ceWizPreview(tab: string, st: any): any {
    var pv: any = (st && st.preview) || null;
    var showing = !!(pv && pv.tab === tab);
    var acts = h('div', { key: 'wpv_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
        showing
            ? ceBtn('Hide context', 'wiz:pv:hide:' + tab, function() {
                ceWizPatch(function() { return { preview: null }; });
                return Promise.resolve();
              })
            : ceBtn('Preview context', 'wiz:pv:' + tab, function() {
                var ids = _ceWizEffSrc(st, tab);
                return Promise.resolve(buildWizardContextPreview(ids)).then(function(text: string) {
                    ceWizPatch(function() { return { preview: { tab: tab, text: String(text || '') } }; });
                });
              })
    );
    if (!showing) return acts;
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        acts,
        h('div', { key: 'wpv_body', style: {
            background: CE_WELL, border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
            padding: CE_T.s3, maxHeight: '320px', overflowY: 'auto',
            fontSize: CE_T.fsSm, lineHeight: CE_T.lhProse, whiteSpace: 'pre-wrap'
        } }, String(pv.text || '(nothing would be sent)'))
    );
}

// THE COUNT-AND-GENERATE ROW, ONCE. `token` is the tempStorage suffix, which is the tab
// for most callers but 'web' / 'narrative' inside Drama -- one tab, three generators.
function _ceWizGenRow(token: string, st: any, label: string, run: () => Promise<any>): any {
    var n = Number((st && st.counts && st.counts[token]) || CE_WIZ_COUNT_DEFAULT[token] || 3);
    return h('div', { style: { display: 'flex', gap: CE_T.s3, alignItems: 'flex-end', flexWrap: 'wrap' } },
        h('div', { key: 'wgen_cnt', style: { flex: '0 0 96px' } },
            ceNumField({
                k: 'wiz:count:' + token, label: 'How many', value: n, min: 1, max: 8,
                onCommit: function(v: number) { return _ceWizSetCount(token, v); }
            })),
        h('div', { key: 'wgen_go', style: { flex: '1 1 160px' } },
            ceBtn(label, 'wiz:gen:' + token, run, 'primary'))
    );
}

// The one-shot regen instruction. Session-scoped by design: it describes THIS press, not
// a preference, and the native surface persisting it in tempStorage gave it a lifetime
// nothing wanted.
function _ceWizHintField(id: string): any {
    return h(ceField, {
        key: 'whint_' + id, k: 'wiz:hint:' + id, label: '',
        value: String(_ceWizHints[id] || ''),
        placeholder: 'Optional \u2014 what to change this time\u2026',
        onType: function(v: string) { _ceWizHints[id] = String(v || ''); },
        onCommit: function(v: string) { _ceWizHints[id] = String(v || ''); return Promise.resolve(); }
    });
}

function _ceWizHint(id: string): string { return String(_ceWizHints[id] || ''); }

// Toast-wrapped generation. Every Regen in this surface has the identical shape and the
// identical failure contract -- the record is left untouched -- so it is written once.
function _ceWizRun(opLabel: string, toastId: string, work: () => Promise<any>, okMsg: string, failMsg: string): Promise<any> {
    try { api.v1.ui.toast(opLabel, { id: toastId, autoClose: false, type: 'info' }); } catch (eR1) {}
    return Promise.resolve(work()).then(function(ok: any) {
        try { api.v1.ui.toast(ok ? okMsg : failMsg, { id: toastId, type: ok ? 'success' : 'error', autoClose: 2400 }); }
        catch (eR2) {}
        return cePublishWiz();
    }).catch(function(e: any) {
        api.v1.error('[AE:jsxwizard] ' + toastId + ' failed:', e);
        try { api.v1.ui.toast(failMsg, { id: toastId, type: 'error', autoClose: 2400 }); } catch (eR3) {}
        return cePublishWiz();
    });
}

// THE STAGING REVIEW, ONCE AND SCHEMA-DRIVEN. Fields render as h(ceField, ...) with a key,
// which is ceField's own documented escape hatch for a dynamic field list -- calling it
// bare in a loop would put its useRef calls into this surface's hook list at a count that
// changes with the number of drafts.
//
// NOTHING HERE WRITES A RECORD. Edits land on the draft; only Commit calls
// commitStagedDrafts. That is the staging model and it is kept intact.
function _ceWizStaging(kind: string, st: any): any {
    var drafts: any[] = _ceWizDraftsOf(st, kind);
    if (!drafts.length) return null;
    var schema: any[] = WIZ_DRAFT_FIELDS[kind] || [];
    var confirm = String((st && st.confirm) || '');
    var cards: any[] = [];
    var i = 0;

    for (i = 0; i < drafts.length; i++) {
        cards.push((function(d: any) {
            var did = String(d.id);
            var kids: any[] = [];
            var fi = 0;
            for (fi = 0; fi < schema.length; fi++) {
                kids.push((function(fld: any) {
                    var fkey = String(fld.key);
                    return h(ceField, {
                        key: did + ':' + fkey,
                        k: 'wiz:d:' + did + ':' + fkey,
                        label: String(fld.label || ''),
                        value: String((d.fields && d.fields[fkey]) || ''),
                        seed: String(st.draftGen || 0),
                        multiline: !!fld.multiline,
                        rows: fld.multiline ? 6 : undefined,
                        well: !!fld.multiline,
                        placeholder: String(fld.label || '').toLowerCase(),
                        onCommit: function(v: string) {
                            return ceWizOp(function() { return updateWizardDraftField(did, fkey, v); });
                        }
                    });
                })(schema[fi]));
            }
            kids.push(h('div', { key: did + ':acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
                ceBtn('Regenerate', 'wiz:regen:' + did, function() {
                    return _ceWizRun('Regenerating\u2026', 'wiz-regen',
                        function() { return regenerateWizardDraft(did); },
                        'Regenerated.', 'Regeneration failed \u2014 draft left unchanged.');
                }),
                ceBtn('Discard', 'wiz:drop:' + did, function() {
                    return ceWizOp(function() { return discardWizardDraft(did); }).then(cePublishWiz);
                }, 'danger')
            ));
            return h('div', { key: 'wizd_' + did, style: {
                display: 'flex', flexDirection: 'column', gap: CE_T.s3,
                border: '1px solid ' + CE_LINE, borderRadius: CE_T.rCard,
                padding: CE_T.s3, background: CE_FILL
            } }, kids);
        })(drafts[i]));
    }

    // DESTRUCTIVE-NEVER-IN-PLACE: ask and confirm are two buttons with two opIds, so
    // TAP-GUARD's double-fire cannot land the confirmed branch off one physical tap.
    var asking = (confirm === 'stage:' + kind);
    var footer: any[] = [
        ceBtn('Commit all \u00b7 ' + drafts.length, 'wiz:commit:' + kind, function() {
            return _ceWizCommit(kind);
        }, 'primary')
    ];
    if (asking) {
        footer.push(ceBtn('Discard all \u00b7 ' + drafts.length, 'wiz:dropall:' + kind, function() {
            ceWizPatch(function() { return { confirm: '' }; });
            return ceWizOp(function() { return discardAllWizardDrafts(kind); }).then(cePublishWiz);
        }, 'danger'));
        footer.push(ceBtn('Keep them', 'wiz:dropallno:' + kind, function() {
            ceWizPatch(function() { return { confirm: '' }; });
            return Promise.resolve();
        }));
    } else {
        footer.push(ceBtn('Discard all', 'wiz:dropallask:' + kind, function() {
            ceWizPatch(function() { return { confirm: 'stage:' + kind }; });
            return Promise.resolve();
        }, 'danger'));
    }

    var body: any[] = [
        h('div', { key: 'wstg_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'None of this is in your world yet. Edit freely; committing is what writes records and lorebook entries.'),
        h('div', { key: 'wstg_cards', style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, cards),
        h('div', { key: 'wstg_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } }, footer)
    ];
    return ceSection('Staged \u00b7 ' + wizKindLabel(kind) + ' \u00b7 ' + drafts.length,
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body));
}

// COMMIT IS DELIBERATELY NOT WRAPPED IN ceProfileOp, AND THIS IS THE ARGUMENT.
// commitStagedDrafts for kind 'character' calls generateCharacterFields per draft -- a
// model call -- between loading the drafts and writing the records. PROFILE-CHAIN-GAP
// states the rule for that chain outright: a generation must never run inside it, which
// is why ceProfileScanHook wraps only its tail. Wrapping the whole commit would stall
// every character write in the shell across N field extractions -- a worse and more
// visible failure than the race it closes.
//
// THE RACE IT LEAVES OPEN, STATED RATHER THAN HIDDEN: a commit running while the author
// navigates to a Profile and blurs a field can lose that field, because
// createWizardCharacter is a bare load-modify-save. Closing it means splitting
// commitStagedDrafts so only the write is inside the chain -- generator-layer work, which
// this section is out of scope for. KNOWN OPEN ITEM.
function _ceWizCommit(kind: string): Promise<any> {
    try { api.v1.ui.toast('Committing ' + wizKindLabel(kind) + '\u2026', { id: 'wiz-commit', autoClose: false, type: 'info' }); }
    catch (eC1) {}
    return Promise.resolve(commitStagedDrafts(kind)).then(function(made: number) {
        return Promise.resolve(loadWizardDraftsOfKind(kind)).then(function(left: any[]) {
            var msg = made > 0 ? ('Committed ' + made + ' ' + wizKindLabel(kind) + '.') : 'Nothing committed.';
            if ((left || []).length) { msg += ' ' + left.length + ' still staged \u2014 those need a name.'; }
            try { api.v1.ui.toast(msg, { id: 'wiz-commit', type: made > 0 ? 'success' : 'error', autoClose: 3000 }); }
            catch (eC2) {}
            return cePublishWiz();
        });
    }).catch(function(e: any) {
        api.v1.error('[AE:jsxwizard] commit failed:', e);
        try { api.v1.ui.toast('Commit failed.', { id: 'wiz-commit', type: 'error', autoClose: 2500 }); } catch (eC3) {}
        return cePublishWiz();
    });
}

// A row that navigates to wherever a committed record is actually edited, carrying the
// return address. THE ONE MEASURED CROSS-LINK the sweep was waiting on -- the native
// Drama tab called openEntityEditModal directly at engine ~21421.
function _ceWizGoBack(): any { return { surface: 'wizard', label: 'Wizard' }; }

// -- Setup --------------------------------------------------------------------
// THE THREE PROJECT FIELDS LIVE HERE NOW. They were the top of buildSidebar, which the
// sweep retires, and a straight port would have orphaned them -- which would have
// silently degraded all eight tabs, since buildWizardMultiContext folds project name,
// genre and concept into EVERY generator's context (see the cfg.projectName branch at
// engine ~2356). They are the seed, so they open the surface.
function _ceWizSetup(st: any): any {
    var cfg: any = (st && st.cfg) || {};
    var chats: any[] = (st && st.chats) || [];

    var fields = ceGroup('Project', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
        h(ceField, {
            key: 'wiz_pname', k: 'wiz:proj:name', label: 'Name',
            value: String(cfg.projectName || ''), placeholder: 'Untitled project',
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.projectName = v; }); })
                    .then(cePublishWiz);
            }
        }),
        h(ceField, {
            key: 'wiz_pgenre', k: 'wiz:proj:genre', label: 'Genre',
            value: String(cfg.projectGenre || ''), placeholder: 'dark fantasy, cyberpunk noir\u2026',
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.projectGenre = v; }); })
                    .then(cePublishWiz);
            }
        }),
        h(ceField, {
            key: 'wiz_pconcept', k: 'wiz:proj:concept', label: 'Initial concept',
            value: String(cfg.projectConcept || ''), multiline: true, rows: 5, well: true,
            placeholder: 'The working idea your world starts from\u2026',
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.projectConcept = v; }); })
                    .then(cePublishWiz);
            }
        }),
        h('div', { key: 'wiz_pnote', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'These three go into every generator on this surface, whether or not a chat is selected. If nothing else is set, they are the whole context.')
    ));

    var chatBody: any[] = [
        h('div', { key: 'wiz_ch_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            chats.length
                ? ('Talking an idea through gives the generators far more to work with than the concept alone. ' + chats.length + ' saved ' + (chats.length === 1 ? 'chat is' : 'chats are') + ' available as context on the tabs below.')
                : 'Talking an idea through gives the generators far more to work with than the concept alone. Anything you save from a chat becomes selectable context on the tabs below.'),
        // [v2.157.0 JSXWIZCHAT] WAS ceNav('chat') -- the CharChat surface, which is a
        // character texting you and has nothing to do with worldbuilding. The wizard chat
        // is now a tab on this same surface, so this is a tab switch, not a navigation.
        ceBtn('Open Chat', 'wiz:tochat', function() {
            ceTabSet('wizard', 'chat');
            return cePublishWiz();
        })
    ];

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { key: 'wsu_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'Start here. Everything the other tabs generate is built on what is in this box.'),
        h('div', { key: 'wsu_f' }, fields),
        h('div', { key: 'wsu_c' }, ceGroup('Brainstorming',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3, alignItems: 'flex-start' } }, chatBody)))
    );
}

// -- Chat  [v2.157.0 JSXWIZCHAT] ----------------------------------------------
// SECTION 3e's WIZLIVE, given the door v2.155.0 left it without. Layout follows the native
// buildLiveChatTab (SECTION 27) because that is the reference surface, same rule JSXCHAT
// followed for the bridge's launcher.
//
// THE CONVERSATION ITSELF IS NOT HERE AND CANNOT BE. WIZLIVE is an IN-DOCUMENT chat: the
// engine appends a marker plus a protocol paragraph and the author talks in native { }
// instruct blocks and presses NAI's own Send. This tab opens, names, contextualises, banks
// and closes a session -- exactly the split the Chat surface (SECTION 33) already runs
// under for CharChat, and for the same hard reason: there is no preventDefault here to
// build a composer against.
//
// THE FOUR PRECONDITIONS ARE NOT RE-CHECKED HERE. startLiveWizardChat already refuses when
// a chat is live, the classic wizard is open, a CharChat is running, or a yoink is in
// flight, each with its own toast. Duplicating those tests in the view would mean two
// places deciding the same thing and drifting -- the verb owns the refusal, this only
// offers the button.

// Serialised through ceWizOp like every other drafts/web/intro write on this surface.
// The lorebook writes inside endLiveWizardChat / upsertChatEntry are that function's own
// business; what is chained here is this surface's republish.
//
// BOTH START AND RESUME CLOSE THE SHELL, and that is not a nicety. WIZLIVE puts the marker
// and the protocol paragraph in the STORY DOCUMENT and the author answers with NAI's own
// Send -- so leaving a full-size modal open over the document would hide the very thing
// that just appeared. The Chat surface's own contact rows already do exactly this after
// startCharChat(), for exactly this reason; same hand-off, same one-line close.
function _ceWizChatCloseShell(): void {
    try { if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); } }
    catch (e) { /* the chat is already in the document; a stuck modal must not fail the start */ }
}

async function _ceWizChatStart(): Promise<void> {
    var ctx: string[] = [];
    var k: string;
    for (k in _ceWizChatCtxPick) { if (_ceWizChatCtxPick[k]) ctx.push(k); }
    var started = false;
    try {
        // startLiveWizardChat owns all four refusals (chat live / classic wizard open /
        // CharChat running / yoink in flight) and toasts its own reason. It returns void
        // either way, so the shell must not close on a refusal -- read _aeLiveWiz.active
        // afterwards to tell the two apart rather than assuming success.
        await startLiveWizardChat(String(_ceWizChatPersona || ''), ctx);
        started = !!_aeLiveWiz.active;
        if (started) { _ceWizChatCtxPick = {}; _ceWizChatTitle = ''; }
    } catch (e) { api.v1.error('[AE:jsxwizard] chat start failed:', e); }
    await cePublishWiz();
    if (started) { _ceWizChatCloseShell(); }
}

async function _ceWizChatResume(entryId: string): Promise<void> {
    var resumed = false;
    try {
        await resumeLiveWizardChatFromEntry(String(entryId || ''));
        resumed = !!_aeLiveWiz.active;
    } catch (e) { api.v1.error('[AE:jsxwizard] chat resume failed:', e); }
    await cePublishWiz();
    if (resumed) { _ceWizChatCloseShell(); }
}

async function _ceWizChatEnd(action: string): Promise<void> {
    try { await endLiveWizardChat(String(action || 'save')); }
    catch (e) { api.v1.error('[AE:jsxwizard] chat end failed:', e); }
    _ceWizChatSummary = '';
    _ceWizChatTitle = '';
    ceWizPatch(function() { return { summary: '', confirm: '' }; });
    await cePublishWiz();
}

// Summarize PROPOSES into `summary` and never writes the lorebook on its own -- the same
// propose-don't-overwrite contract the Journal's Rewrite/Compress runs under.
async function _ceWizChatSummarize(): Promise<void> {
    try {
        var s: any = await previewSummarizeLiveChat();
        if (!s) {
            try { api.v1.ui.toast('Nothing to summarize yet \u2014 send a turn first.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
            return;
        }
        _ceWizChatSummary = String(s);
        ceWizPatch(function() { return { summary: String(s) }; });
    } catch (e) {
        api.v1.error('[AE:jsxwizard] summarize failed:', e);
        try { api.v1.ui.toast('Summarize failed \u2014 try again.', { type: 'error', autoClose: 3000 }); } catch (e2) {}
    }
}

async function _ceWizChatBankSummary(st: any): Promise<void> {
    var text = String(_ceWizChatSummary || (st && st.summary) || '').trim();
    if (!text) return;
    try {
        var live: any = (st && st.live) || {};
        // CLICK-BEFORE-BLUR, and this is the case the draft var exists for: renaming the
        // chat and then pressing Save summary is ONE gesture to the author, but the click
        // is delivered BEFORE the rename field's blur, so live.title still holds the
        // PREVIOUS name at this moment. The draft is what the author actually typed, so it
        // wins when set; live.title is the fallback for the untouched case.
        var rawTitle = String(_ceWizChatTitle || live.title || '').trim();
        var title = (rawTitle || 'Wizard Chat') + ' \u2014 Summary';
        await upsertChatEntry(null, title, [{ role: 'assistant', content: text }], String(live.topicId || ''));
        try { api.v1.ui.toast('Summary saved to the CE Chats lorebook.', { type: 'success', autoClose: 2500 }); } catch (e1) {}
        _ceWizChatSummary = '';
        ceWizPatch(function() { return { summary: '' }; });
    } catch (e) {
        api.v1.error('[AE:jsxwizard] bank summary failed:', e);
        try { api.v1.ui.toast('Could not save the summary.', { type: 'error', autoClose: 3000 }); } catch (e2) {}
    }
    await cePublishWiz();
}

function _ceWizChat(st: any, openMap: any): any {
    var live: any = (st && st.live) || null;
    var entries: any[] = (st && st.ceEntries) || [];
    var cfg: any = (st && st.cfg) || {};
    var confirm = String((st && st.confirm) || '');
    var kids: any[] = [];
    var i = 0;

    if (live && live.active) {
        kids.push(h('div', { key: 'wch_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'A wizard chat is live in your story, below the violet marker. Write in a new paragraph '
            + 'and press Send \u2014 no need to type curly braces, they are added for you. Blue paragraphs '
            + 'are your directions, violet are the wizard\u2019s. Close it here when you are done.'));

        kids.push(h('div', { key: 'wch_name' }, ceGroup('Chat name',
            h(ceField, {
                key: 'wch_name_f', k: 'wizchat:title', label: '',
                value: String(live.title || ''), seed: String(live.startedAt || ''),
                placeholder: 'Name this chat\u2026',
                onType: function(v: string) { _ceWizChatTitle = String(v || ''); },
                onCommit: function(v: string) {
                    _ceWizChatTitle = String(v || '');
                    // _aeLiveWiz is the authority; this writes THROUGH to it and persists,
                    // exactly as the native field did. The store's copy is a projection and
                    // is refreshed by the republish.
                    return ceWizOp(function() {
                        _aeLiveWiz.title = String(v || '');
                        return saveLiveWizState();
                    }).then(cePublishWiz);
                }
            })
        )));

        if (entries.length) {
            var ctxRows: any[] = [];
            for (i = 0; i < entries.length; i++) {
                ctxRows.push((function(e: any) {
                    var eid = String(e.id);
                    var on = !!e.forceActivation;
                    return ceSettingRow(String(e.displayName || 'Untitled chat'), '',
                        ceToggle(on, 'wizchat:ctx:' + eid, function() {
                            return ceWizOp(function() {
                                return Promise.resolve(setContextEntriesActivation([eid], !on)).then(function() {
                                    if (!on) {
                                        if (_aeLiveWiz.contextEntryIds.indexOf(eid) < 0) _aeLiveWiz.contextEntryIds.push(eid);
                                    } else {
                                        _aeLiveWiz.contextEntryIds = _aeLiveWiz.contextEntryIds.filter(function(x: string) { return x !== eid; });
                                    }
                                    return saveLiveWizState();
                                });
                            }).then(cePublishWiz);
                        }));
                })(entries[i]));
            }
            kids.push(h('div', { key: 'wch_ctx' }, ceAccordion({
                id: 'wizchat:ctx', label: 'Context lorebooks', open: !!(openMap && openMap['wizchat:ctx']),
                summary: 'Saved chats switched Always-On for this session',
                meta: (live.ctxIds || []).length ? ((live.ctxIds || []).length + ' on') : '',
                children: h('div', { style: { display: 'flex', flexDirection: 'column' } }, ctxRows)
            })));
        }

        var summaryText = String((st && st.summary) || '');
        if (summaryText) {
            kids.push(h('div', { key: 'wch_sum' }, ceSection('Summary preview',
                h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
                        'Edit freely. Nothing is in the lorebook until you save it.'),
                    h(ceField, {
                        key: 'wch_sum_f', k: 'wizchat:summary', label: '',
                        value: summaryText, multiline: true, rows: 6, well: true,
                        onType: function(v: string) { _ceWizChatSummary = String(v || ''); },
                        onCommit: function(v: string) { _ceWizChatSummary = String(v || ''); return Promise.resolve(); }
                    }),
                    ceBtn('Save summary to CE Chats', 'wizchat:bank', function() {
                        return _ceWizChatBankSummary(st);
                    }, 'primary')
                ))));
        }

        var acts: any[] = [
            ceBtn('Summarize \u2192 preview', 'wizchat:sum', function() { return _ceWizChatSummarize(); }),
            ceBtn('Save & close', 'wizchat:save', function() { return _ceWizChatEnd('save'); }, 'primary')
        ];
        // DESTRUCTIVE-NEVER-IN-PLACE: ask and confirm are two buttons with two opIds, so
        // TAP-GUARD's double-fire cannot land the discard off one physical tap. This
        // replaces the native's 4-second armed timer, which needed api.v1.timers and could
        // disarm itself underneath the author.
        if (confirm === 'wizchat:discard') {
            acts.push(ceBtn('Discard \u2014 the chat is deleted, not saved', 'wizchat:discardyes', function() {
                ceWizPatch(function() { return { confirm: '' }; });
                return _ceWizChatEnd('discard');
            }, 'danger'));
            acts.push(ceBtn('Keep it', 'wizchat:discardno', function() {
                ceWizPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            }));
        } else {
            acts.push(ceBtn('Discard chat', 'wizchat:discardask', function() {
                ceWizPatch(function() { return { confirm: 'wizchat:discard' }; });
                return Promise.resolve();
            }, 'danger'));
        }
        kids.push(h('div', { key: 'wch_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } }, acts));

        return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
    }

    // -- Not live: choose a persona, preselect context, start ------------------
    kids.push(h('div', { key: 'wch_lede0', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
        'Start a wizard chat that lives right in your story document. Pick a persona and it drops '
        + 'in below a marker \u2014 write in a new paragraph and press Send. Saved chats live in the '
        + '\u201cCE Chats\u201d lorebook category: resume them here, or switch them on as context for any '
        + 'generator on the tabs to the right.'));

    // Persona. A CLOSED, ORDERED SET, which is what SS8 reserves ceSelect for -- not the
    // picker, which SS13 reserves for unbounded referential fields. The native used a
    // searchable picker modal because it had one; a dozen fixed topics do not need one.
    var topics: any[] = (cfg && cfg.wizardTopics && cfg.wizardTopics.length) ? cfg.wizardTopics : DEFAULT_WIZARD_TOPICS;
    var tOpts: any[] = [{ id: '', label: 'General worldbuilding' }];
    for (i = 0; i < topics.length; i++) {
        tOpts.push({ id: String(topics[i].id), label: String(topics[i].label || topics[i].id) });
    }
    var personaHint = '';
    for (i = 0; i < topics.length; i++) {
        if (String(topics[i].id) === String(_ceWizChatPersona)) {
            personaHint = _ceTrim(String(topics[i].seedMessage || ''), 150);
        }
    }
    kids.push(h('div', { key: 'wch_persona' }, ceSelect({
        k: 'wizchat:persona',
        label: 'Persona',
        value: String(_ceWizChatPersona || ''),
        options: tOpts,
        hint: personaHint || 'Sets what the wizard is for. General is a good default.',
        onCommit: function(v: string) {
            _ceWizChatPersona = String(v || '');
            // The persona drives the hint line above, so this one DOES have to repaint --
            // which is why it is a commit and not an onType scratchpad.
            return cePublishWiz();
        }
    })));

    if (entries.length) {
        var preRows: any[] = [];
        for (i = 0; i < entries.length; i++) {
            preRows.push((function(e: any) {
                var eid = String(e.id);
                return ceSettingRow(String(e.displayName || 'Untitled chat'), '',
                    ceToggle(!!_ceWizChatCtxPick[eid], 'wizchat:pre:' + eid, function() {
                        if (_ceWizChatCtxPick[eid]) { delete _ceWizChatCtxPick[eid]; }
                        else { _ceWizChatCtxPick[eid] = true; }
                        return cePublishWiz();
                    }));
            })(entries[i]));
        }
        kids.push(h('div', { key: 'wch_pre' }, ceAccordion({
            id: 'wizchat:pre', label: 'Include saved chats as context',
            open: !!(openMap && openMap['wizchat:pre']),
            summary: 'Optional \u2014 switched Always-On for the new session',
            meta: '', children: h('div', { style: { display: 'flex', flexDirection: 'column' } }, preRows)
        })));
    }

    kids.push(h('div', { key: 'wch_start', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
        ceBtn('Start chat', 'wizchat:start', function() { return _ceWizChatStart(); }, 'primary')));

    // Resume. Every saved chat is a row; tapping pulls it back into the story and goes live
    // on it, and Save & Close will overwrite that same entry (sourceEntryId).
    var resumeRows: any[] = [];
    for (i = 0; i < entries.length; i++) {
        resumeRows.push((function(e: any) {
            var eid = String(e.id);
            return h('div', {
                key: 'wch_r_' + eid,
                onClick: function() {
                    ceTap('wizchat:resume:' + eid, function() {
                        ceAction('wizchat:resume:' + eid, function() { return _ceWizChatResume(eid); });
                    });
                },
                style: {
                    display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap,
                    cursor: 'pointer', borderBottom: '1px solid ' + CE_LINE, fontSize: CE_T.fs
                }
            },
                h('div', { style: { flex: '1 1 auto', minWidth: '0', overflow: 'hidden',
                    textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, String(e.displayName || 'Untitled chat')),
                h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3 } }, 'Resume \u203a')
            );
        })(entries[i]));
    }
    kids.push(h('div', { key: 'wch_res' }, ceGroup('Saved chats \u00b7 ' + entries.length,
        entries.length
            ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, resumeRows)
            : ceEmpty('No saved chats yet \u2014 start one above, then Save & close to bank it here.', null))));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Memory -------------------------------------------------------------------
// The world-canon sections that assemble into the static Memory block and the Author's
// Note. Section rows are ceExpandRow -- many distinct records, which is the case SS7.3
// gives ceExpandRow rather than ceAccordion.
function _ceWizMemory(st: any, openMap: any): any {
    var cfg: any = (st && st.cfg) || {};
    var list: any[] = cfg.wizardSections || [];
    var eff = _ceWizEffSrc(st, 'memory');
    var rows: any[] = [];
    var i = 0;

    for (i = 0; i < list.length; i++) {
        rows.push((function(sec: any, si: number) {
            var sid = String(sec.id);
            var accId = 'wiz:sec:' + sid;
            var open = !!openMap[accId];
            var body: any[] = [
                // Every field write below re-finds the section BY ID inside mutConfig
                // rather than trusting the render-time index: a reorder or a delete between
                // this render and the blur would otherwise write to a different section.
                // The move buttons are index-based because they are immediate, not deferred.
                ceSettingRow('Include in Memory',
                    (sec.target === 'an' ? 'Goes to the Author\u2019s Note.' : 'Goes to the Memory block.'),
                    ceToggle(!!sec.enabled, 'wiz:secon:' + sid, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.enabled = !sec.enabled;
                        }); }).then(cePublishWiz);
                    }, 'Include ' + String(sec.label || 'this section'))),
                h(ceField, {
                    key: accId + ':label', k: accId + ':label', label: 'Section name',
                    value: String(sec.label || ''),
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.label = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                h(ceField, {
                    key: accId + ':content', k: accId + ':content', label: 'Text',
                    value: String(sec.content || ''), multiline: true, rows: 5, well: true,
                    placeholder: 'Generated by Regen, or written here directly\u2026',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.content = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                h(ceField, {
                    key: accId + ':instr', k: accId + ':instr', label: 'What this section covers',
                    value: String(sec.instructions || ''), multiline: true, rows: 3,
                    placeholder: 'Describe ONLY this section\u2019s scope\u2026',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.instructions = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                _ceWizHintField(sid),
                h('div', { key: accId + ':acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', alignItems: 'center' } },
                    ceBtn('Regenerate', 'wiz:secregen:' + sid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(sec.label || '') + '\u201d\u2026', 'wiz-secregen',
                            function() { return regenerateWizardSection(sid, eff, _ceWizHint(sid)); },
                            'Regenerated \u201c' + String(sec.label || '') + '\u201d.', 'Regeneration failed.');
                    }),
                    ceBtn('Move up', 'wiz:secup:' + sid, function() {
                        if (si === 0) return Promise.resolve();
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var a = c.wizardSections; var t = a[si - 1]; a[si - 1] = a[si]; a[si] = t;
                        }); }).then(cePublishWiz);
                    }),
                    ceBtn('Move down', 'wiz:secdn:' + sid, function() {
                        if (si >= list.length - 1) return Promise.resolve();
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var a = c.wizardSections; var t = a[si + 1]; a[si + 1] = a[si]; a[si] = t;
                        }); }).then(cePublishWiz);
                    }),
                    ceIconBtn('Delete this section', ceIconTrash(), 'wiz:secdel:' + sid, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var di = (c.wizardSections || []).findIndex(function(x: any) { return x.id === sid; });
                            if (di >= 0) c.wizardSections.splice(di, 1);
                        }); }).then(cePublishWiz);
                    }, 'danger')
                )
            ];
            var written = String(sec.content || '').trim();
            return ceExpandRow({
                id: accId, label: String(sec.label || 'Unnamed section'), open: open,
                summary: written ? _ceTrim(written, 72) : 'Nothing written yet',
                // NESTED-TAP: `lead` and `meta` sit INSIDE ceExpandRow's own clickable head,
                // so neither may carry a control -- a tap would fire the control's ceTap and
                // then the head's, and only TAP-GUARD's 120ms window would stop the row
                // toggling underneath it. State goes in `meta` as text; the switch lives in
                // the body. Same reason ceAccordion's `lead` has only ever held a thumbnail.
                meta: (sec.enabled ? 'ON' : 'off') + ' \u00b7 ' + (sec.target === 'an' ? 'AN' : 'MEM'),
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            });
        })(list[i], i));
    }

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { key: 'wm_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'The permanent facts of your world. Switched-on sections are assembled into Memory and the Author\u2019s Note when you commit \u2014 which is the only step here that touches the story.'),
        h('div', { key: 'wm_src' }, _ceWizSources('memory', st)),
        h('div', { key: 'wm_rows' }, ceGroup('Sections \u00b7 ' + list.length,
            list.length
                ? h('div', { style: { display: 'flex', flexDirection: 'column' } }, rows)
                : ceEmpty('No sections defined.', null))),
        h('div', { key: 'wm_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
            ceBtn('Add section', 'wiz:secadd', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    if (!c.wizardSections) c.wizardSections = [];
                    c.wizardSections.push({ id: 'wsec_' + generateId(), label: 'New Section', enabled: false,
                                            content: '', instructions: 'Describe ONLY this section\u2019s scope.', target: 'memory' });
                }); }).then(cePublishWiz);
            }),
            ceBtn('Commit to Memory', 'wiz:memcommit', function() {
                return Promise.resolve(loadConfig()).then(function(fresh: any) {
                    return Promise.resolve(commitWizardMemory(fresh)).then(function(ok: boolean) {
                        try { api.v1.ui.toast(ok ? 'Committed to Memory and the Author\u2019s Note.' : 'Commit failed.',
                            { type: ok ? 'success' : 'error', autoClose: 2400 }); } catch (eMC) {}
                        return cePublishWiz();
                    });
                });
            }, 'primary'))
    );
}

// -- Species / Factions -------------------------------------------------------
// ONE BODY FOR BOTH, exactly as the native branch was -- they differ only in the noun and
// the config array. The committed-record EDITOR is gone: Settings edits both fully
// (_ceSettingsSpecies, _ceSettingsFactionsTab) and a second divergent editor here was
// duplication, not capability. What survives is what only the wizard has: Regen against
// the chosen context, and Sync Lore.
function _ceWizEntities(tab: string, st: any, openMap: any): any {
    var kind = (tab === 'factions') ? 'faction' : 'species';
    var noun = (kind === 'faction') ? 'factions' : 'species';
    var cfg: any = (st && st.cfg) || {};
    var list: any[] = (kind === 'faction') ? (cfg.factions || []) : (cfg.species || []);
    var eff = _ceWizEffSrc(st, tab);
    var rows: any[] = [];
    var i = 0;

    for (i = 0; i < list.length; i++) {
        rows.push((function(item: any) {
            var iid = String(item.id);
            var accId = 'wiz:ent:' + iid;
            var open = !!openMap[accId];
            var desc = String(item.description || '').trim();
            var body: any[] = [
                h('div', { key: accId + ':desc', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
                    desc || 'No lore written yet.'),
                _ceWizHintField(iid),
                h('div', { key: accId + ':acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
                    ceBtn('Regenerate', 'wiz:entregen:' + iid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(item.name || '') + '\u201d\u2026', 'wiz-entregen',
                            function() { return regenerateWizardEntity(kind, iid, eff, _ceWizHint(iid)); },
                            'Regenerated \u201c' + String(item.name || '') + '\u201d.', 'Regeneration failed.');
                    }),
                    ceBtn('Sync lorebook', 'wiz:entsync:' + iid, function() {
                        var p = (kind === 'faction') ? syncFactionLorebookEntry(iid) : syncSpeciesLorebookEntry(iid);
                        return Promise.resolve(p).catch(function() { return null; });
                    }),
                    ceBtn('Edit in Settings', 'wiz:entedit:' + iid, function() {
                        // ceNav CLEARS tab by contract, so the tab is set after the nav,
                        // never before -- the reverse order silently lands on World.
                        ceNav('settings', '', '', _ceWizGoBack());
                        ceTabSet('settings', (kind === 'faction') ? 'factions' : 'world');
                        return Promise.resolve();
                    }),
                    ceIconBtn('Delete this entry', ceIconTrash(), 'wiz:entdel:' + iid, function() {
                        var un = (kind === 'faction') ? unlinkFactionLorebookEntry(iid) : unlinkSpeciesLorebookEntry(iid);
                        return Promise.resolve(un).catch(function() { return null; }).then(function() {
                            return ceSettingsOp(function() { return mutConfig(function(c: any) {
                                var arr: any[] = (kind === 'faction') ? c.factions : c.species;
                                var di = arr.findIndex(function(x: any) { return x.id === iid; });
                                if (di >= 0) arr.splice(di, 1);
                            }); });
                        }).then(cePublishWiz);
                    }, 'danger')
                )
            ];
            return ceExpandRow({
                id: accId, label: String(item.name || 'Unnamed'), open: open,
                summary: desc ? _ceTrim(desc, 72) : 'No lore yet',
                children: h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, body)
            });
        })(list[i]));
    }

    var gen = _ceWizGenRow(tab, st, 'Generate ' + noun, function() {
        var n = Number((st && st.counts && st.counts[tab]) || 3);
        return _ceWizRun('Generating ' + n + ' ' + noun + '\u2026', 'wiz-batch',
            function() {
                return Promise.resolve(stageEntityBatch(kind, n, eff)).then(function(ids: string[]) {
                    return (ids || []).length;
                });
            },
            'Staged \u2014 review below.', 'Generation failed.');
    });

    var kids: any[] = [
        h('div', { key: 'we_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            (kind === 'faction'
                ? 'Organisations, powers and groups. Existing factions are fed to the generator so new ones do not duplicate them.'
                : 'Peoples and creature-types. Existing species are fed to the generator so new ones do not duplicate them.')),
        h('div', { key: 'we_src' }, _ceWizSources(tab, st)),
        h('div', { key: 'we_gen' }, gen)
    ];
    var staged = _ceWizStaging(kind, st);
    if (staged) kids.push(h('div', { key: 'we_stage' }, staged));
    kids.push(h('div', { key: 'we_list' }, ceGroup('In this world \u00b7 ' + list.length,
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            list.length
                ? h('div', { key: 'we_rows', style: { display: 'flex', flexDirection: 'column' } }, rows)
                : ceEmpty('None yet.', null),
            ceBtn('Add a blank one', 'wiz:entblank:' + kind, function() {
                return Promise.resolve(addBlankWizardEntity(kind)).then(cePublishWiz);
            })))));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Locations ----------------------------------------------------------------
// The two-pass tree: generate at the current level, step into any child, generate again.
// The committed-record editor is gone -- the Entity surface (SECTION 36) is the editor
// for a location, and it is one tap away on every row.
function _ceWizLocations(st: any): any {
    var eff = _ceWizEffSrc(st, 'locations');
    var parentId = String((st && st.locParent) || '');
    var parentName = String((st && st.locParentName) || '');
    var idx: any[] = (st && st.entIndex) || [];

    var kidsList: any[] = [];
    var i = 0;
    for (i = 0; i < idx.length; i++) {
        var m: any = idx[i];
        if (!m || m.type !== 'location') continue;
        if (String(m.parentId || '') !== parentId) continue;
        kidsList.push(m);
    }

    function childCount(id: string): number {
        var n = 0;
        var j = 0;
        for (j = 0; j < idx.length; j++) {
            if (idx[j] && idx[j].type === 'location' && String(idx[j].parentId || '') === id) n++;
        }
        return n;
    }

    var crumb = h('div', { style: { display: 'flex', gap: CE_T.s2, alignItems: 'center', flexWrap: 'wrap' } },
        h('div', { key: 'wl_here', style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fs } },
            parentId ? ('Inside ' + parentName) : 'The top of the world'),
        parentId
            ? ceBtn('Step out', 'wiz:locup', function() {
                var up = String((st && st.locParentUp) || '');
                return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, up)).then(cePublishWiz);
              })
            : null
    );

    var rows: any[] = [];
    for (i = 0; i < kidsList.length; i++) {
        rows.push((function(km: any) {
            var kid = String(km.id);
            var grand = childCount(kid);
            return ceListRow({
                label: String(km.name || 'Unnamed'),
                sub: grand ? (grand + ' inside') : 'nothing inside yet',
                // NESTED-TAP: no row onClick, because this row carries buttons. A tap on a
                // trailing button would fire twice -- the button's ceTap and then the row's --
                // and only TAP-GUARD's 120ms window would stop the second one landing. Every
                // verb here is its own button instead.
                trail: h('div', { style: { display: 'flex', gap: CE_T.s2, alignItems: 'center', flexWrap: 'wrap' } },
                    ceBtn('Into', 'wiz:locinto:' + kid, function() {
                        return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, kid)).then(cePublishWiz);
                    }),
                    ceBtn('Open', 'wiz:locopen:' + kid, function() {
                        ceNav('entity', kid, '', _ceWizGoBack());
                        return Promise.resolve();
                    }),
                    ceBtn('Regenerate', 'wiz:locregen:' + kid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(km.name || '') + '\u201d\u2026', 'wiz-locregen',
                            function() { return regenerateWizardLocation(kid, eff, _ceWizHint(kid)); },
                            'Regenerated \u201c' + String(km.name || '') + '\u201d.', 'Regeneration failed.');
                    }))
            });
        })(kidsList[i]));
    }

    var gen = _ceWizGenRow('locations', st, 'Generate places', function() {
        var n = Number((st && st.counts && st.counts['locations']) || 3);
        return _ceWizRun('Generating ' + n + ' place' + (n === 1 ? '' : 's') + '\u2026', 'wiz-loc',
            function() {
                return Promise.resolve(stageLocationBatch(n, parentId || null, eff)).then(function(ids: string[]) {
                    return (ids || []).length;
                });
            },
            'Staged \u2014 review below.', 'Generation failed.');
    });

    var kids: any[] = [
        h('div', { key: 'wl_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            parentId
                ? ('New places will be built inside ' + parentName + '. Tap any place below to step into it and build a level deeper.')
                : 'New places will sit at the top of the world. Tap any place below to step into it and build what is inside.'),
        h('div', { key: 'wl_crumb' }, crumb),
        h('div', { key: 'wl_src' }, _ceWizSources('locations', st)),
        h('div', { key: 'wl_gen' }, gen)
    ];
    var staged = _ceWizStaging('location', st);
    if (staged) kids.push(h('div', { key: 'wl_stage' }, staged));
    kids.push(h('div', { key: 'wl_list' }, ceGroup(parentId ? ('Inside ' + parentName) : 'Top of the world',
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            rows.length
                ? h('div', { key: 'wl_rows', style: { display: 'flex', flexDirection: 'column' } }, rows)
                : ceEmpty('Nothing here yet.', null),
            ceBtn('Add a blank one', 'wiz:locblank', function() {
                return Promise.resolve(addBlankWizardLocation(parentId || null)).then(cePublishWiz);
            })))));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Characters ---------------------------------------------------------------
function _ceWizCharacters(st: any): any {
    var eff = _ceWizEffSrc(st, 'characters');
    var roster: any[] = (st && st.roster) || [];

    var gen = _ceWizGenRow('characters', st, 'Generate characters', function() {
        var n = Number((st && st.counts && st.counts['characters']) || 2);
        return _ceWizRun('Writing ' + n + ' character' + (n === 1 ? '' : 's') + ' \u2014 several passes each\u2026', 'wiz-char',
            function() {
                return Promise.resolve(stageCharacterBatch(n, eff)).then(function(ids: string[]) {
                    return (ids || []).length;
                });
            },
            'Staged \u2014 review below.', 'Generation failed.');
    });

    // Add by name does NOT stage: naming the character IS the review step that staging
    // exists to give a batch nobody asked for by name. Native behaviour, kept.
    var addRow = h('div', { style: { display: 'flex', gap: CE_T.s3, alignItems: 'flex-end', flexWrap: 'wrap' } },
        h('div', { key: 'wc_addf', style: { flex: '1 1 180px' } },
            h(ceField, {
                key: 'wc_addname', k: 'wiz:char:addname', label: 'Or name one yourself',
                value: '', seed: String((st && st.addGen) || 0),
                placeholder: 'A character this world needs\u2026',
                onType: function(v: string) { _ceWizAddName = String(v || ''); },
                onCommit: function(v: string) { _ceWizAddName = String(v || ''); return Promise.resolve(); }
            })),
        h('div', { key: 'wc_addb', style: { flex: '0 0 auto' } },
            ceBtn('Create', 'wiz:char:add', function() {
                var nm = String(_ceWizAddName || '').trim();
                if (!nm) {
                    try { api.v1.ui.toast('Enter a name first.', { type: 'error', autoClose: 2000 }); } catch (eA1) {}
                    return Promise.resolve();
                }
                return _ceWizRun('Writing \u201c' + nm + '\u201d\u2026', 'wiz-char1',
                    function() {
                        return Promise.resolve(runWizardCharacterSingle(nm, eff)).then(function(ok: boolean) {
                            if (ok) {
                                _ceWizAddName = '';
                                ceWizPatch(function(s: any) { return { addGen: Number(s.addGen || 0) + 1 }; });
                            }
                            return ok;
                        });
                    },
                    'Created \u201c' + nm + '\u201d.', 'Generation failed.');
            }))
    );

    var rosterRows: any[] = [];
    var ri = 0;
    for (ri = 0; ri < roster.length; ri++) {
        rosterRows.push((function(cm: any) {
            var cid = String(cm.id);
            return ceListRow({
                label: String(cm.name || 'Unnamed'),
                sub: String(cm.occupationRole || (cm.isProtagonist ? 'the protagonist' : '')),
                onClick: function() { ceNav('profile', cid, '', _ceWizGoBack()); }
            });
        })(roster[ri]));
    }

    var kids: any[] = [
        h('div', { key: 'wc_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'Each character is written as one comprehensive concept dump first \u2014 everything the chosen context establishes about them. Their fields are derived from that dump when you commit, so the dump is the thing worth editing below.'),
        h('div', { key: 'wc_src' }, _ceWizSources('characters', st)),
        h('div', { key: 'wc_gen' }, gen),
        h('div', { key: 'wc_add' }, addRow)
    ];
    var staged = _ceWizStaging('character', st);
    if (staged) kids.push(h('div', { key: 'wc_stage' }, staged));
    kids.push(h('div', { key: 'wc_list' }, ceGroup('Already in this story \u00b7 ' + roster.length,
        h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
            h('div', { key: 'wc_rnote', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
                'Generation is told about these and will not recreate them.'),
            rosterRows.length
                ? h('div', { key: 'wc_rrows', style: { display: 'flex', flexDirection: 'column' } }, rosterRows)
                : ceEmpty('No characters yet.', null)))));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Drama --------------------------------------------------------------------
// Three generators, one shared context selection: directed hooks, bilateral web dynamics,
// narrative threads. THE NARRATIVE ROW IS THE CROSS-LINK the deletion sweep was gated on
// -- the native version called openEntityEditModal here; this navigates to the Entity
// surface with a return address, which is the last reference that kept the sweep waiting.
function _ceWizDrama(st: any): any {
    var eff = _ceWizEffSrc(st, 'drama');
    var chars: any[] = (st && st.chars) || [];
    var web: any[] = (st && st.web) || [];
    var hookSel: string[] = (st && st.hookSel) || [];
    var idx: any[] = (st && st.entIndex) || [];
    var i = 0;

    function charName(id: string): string {
        var j = 0;
        for (j = 0; j < chars.length; j++) { if (chars[j] && chars[j].id === id) return String(chars[j].name || '?'); }
        return '?';
    }

    function toggleHook(id: string): Promise<any> {
        var cur = hookSel.slice();
        var at = cur.indexOf(id);
        if (at >= 0) { cur.splice(at, 1); } else { cur.push(id); }
        ceWizPatch(function() { return { hookSel: cur }; });
        return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_HOOK_CHARS, JSON.stringify(cur)))
            .catch(function(e: any) { api.v1.error('[AE:jsxwizard] hook sel write failed:', e); });
    }

    // ---- Hooks
    var hookRows: any[] = [];
    for (i = 0; i < chars.length; i++) {
        if (!chars[i] || !chars[i].active) continue;
        hookRows.push((function(hc: any) {
            var hid = String(hc.id);
            var cur = (hc.hooks && hc.hooks.length) ? hc.hooks[0] : null;
            var target = cur ? (String(cur.targetId || '') === '__player__' ? 'the player' : String(cur.targetName || '?')) : '';
            var sub = cur
                ? (target + ' \u00b7 ' + cur.pressureLevel + '% \u2014 ' + String(cur.description || ''))
                : 'no hook yet';
            var on = hookSel.indexOf(hid) >= 0;
            // NESTED-TAP: selection is a ceToggle in the trail, not a tap on the row. The
            // row carries buttons, so a row handler would double-fire against them.
            return ceListRow({
                label: (hc.isProtagonist ? '\u2605 ' : '') + String(hc.name || 'Unnamed'),
                sub: sub,
                trail: h('div', { style: { display: 'flex', gap: CE_T.s2, alignItems: 'center', flexWrap: 'wrap' } },
                    ceToggle(on, 'wiz:hooksel:' + hid, function() { return toggleHook(hid); },
                        'Seed a hook for ' + String(hc.name || 'this character')),
                    ceBtn('Reseed', 'wiz:hook1:' + hid, function() {
                        return _ceWizRun('Seeding a hook for ' + String(hc.name || '') + '\u2026', 'wiz-hook1',
                            function() { return runWizardHookSingle(hid, eff, ''); },
                            'Hook seeded for ' + String(hc.name || '') + '.', 'No clean tension found.');
                    }),
                    cur ? ceBtn('Clear', 'wiz:hookclr:' + hid, function() {
                        return ceProfileOp(function() {
                            return Promise.resolve(loadCharacter(hid)).then(function(fh: any) {
                                if (!fh) return null;
                                fh.hooks = [];
                                return saveCharacter(fh);
                            });
                        }).then(cePublishWiz);
                    }, 'danger') : null)
            });
        })(chars[i]));
    }

    var hooks = ceGroup('Hooks', h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { key: 'wd_hnote', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'One directed opening tension per character, at the same pressure the engine spawns mid-play. Tap to choose who to seed.'),
        hookRows.length
            ? h('div', { key: 'wd_hrows', style: { display: 'flex', flexDirection: 'column' } }, hookRows)
            : ceEmpty('No active characters yet \u2014 build the cast on the Characters tab first.', null),
        hookRows.length
            ? ceBtn('Seed ' + (hookSel.length ? (hookSel.length + ' hook' + (hookSel.length === 1 ? '' : 's')) : 'hooks'), 'wiz:hooks', function() {
                if (!hookSel.length) {
                    try { api.v1.ui.toast('Choose at least one character first.', { type: 'info', autoClose: 2000 }); } catch (eH1) {}
                    return Promise.resolve();
                }
                return _ceWizRun('Seeding ' + hookSel.length + ' hook' + (hookSel.length === 1 ? '' : 's') + '\u2026', 'wiz-hooks',
                    function() { return runWizardHooksBatch(hookSel.slice(), eff); },
                    'Hooks seeded.', 'No clean tensions found.');
              }, 'primary')
            : null
    ));

    // ---- Web
    var webRows: any[] = [];
    for (i = 0; i < web.length; i++) {
        webRows.push((function(wl: any) {
            var wid = String(wl.id);
            return ceListRow({
                label: charName(String(wl.charA_id)) + ' \u21c4 ' + charName(String(wl.charB_id)),
                sub: String(wl.dynamic || 'no dynamic yet'),
                trail: h('div', { style: { display: 'flex', gap: CE_T.s2, alignItems: 'center' } },
                    ceBtn('Regenerate', 'wiz:webregen:' + wid, function() {
                        return _ceWizRun('Regenerating the dynamic\u2026', 'wiz-webregen',
                            function() { return regenerateWebLink(wid, eff, _ceWizHint(wid)); },
                            'Dynamic updated.', 'Regeneration failed.');
                    }),
                    ceBtn('Remove', 'wiz:webdel:' + wid, function() {
                        return ceWizOp(function() {
                            return Promise.resolve(loadNpcWeb()).then(function(fresh: any[]) {
                                var di = (fresh || []).findIndex(function(x: any) { return x.id === wid; });
                                if (di >= 0) { fresh.splice(di, 1); return saveNpcWeb(fresh); }
                                return null;
                            });
                        }).then(cePublishWiz);
                    }, 'danger'))
            });
        })(web[i]));
    }

    var webBlock = ceGroup('Web \u00b7 ' + web.length, h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { key: 'wd_wnote', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Two-way dynamics between cast members. Generated pairs are matched to real characters; self-pairs and duplicates are skipped.'),
        _ceWizGenRow('web', st, 'Generate dynamics', function() {
            if (chars.length < 2) {
                try { api.v1.ui.toast('Need at least two characters.', { type: 'error', autoClose: 2000 }); } catch (eW1) {}
                return Promise.resolve();
            }
            var wn = Number((st && st.counts && st.counts['web']) || 3);
            return _ceWizRun('Generating ' + wn + ' dynamic' + (wn === 1 ? '' : 's') + '\u2026', 'wiz-web',
                function() { return runWizardWebBatch(wn, eff); },
                'Web links added.', 'No new links resolved.');
        }),
        webRows.length
            ? h('div', { key: 'wd_wrows', style: { display: 'flex', flexDirection: 'column' } }, webRows)
            : ceEmpty('No links yet.', null)
    ));

    // ---- Narratives
    var narrRows: any[] = [];
    for (i = 0; i < idx.length; i++) {
        var nmv: any = idx[i];
        if (!nmv || nmv.type !== 'narrative') continue;
        if (String(nmv.narrativeParentId || '')) continue;
        narrRows.push((function(nm: any) {
            var nid = String(nm.id);
            var state = String(nm.storyState || 'locked');
            return ceListRow({
                label: String(nm.name || 'Unnamed thread'),
                sub: (state === 'active' ? 'running' : (state === 'completed' ? 'done' : 'not started yet')),
                trail: h('div', { style: { display: 'flex', gap: CE_T.s2, alignItems: 'center' } },
                    ceBtn('Regenerate', 'wiz:narrregen:' + nid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(nm.name || '') + '\u201d\u2026', 'wiz-narrregen',
                            function() { return regenerateNarrativeThread(nid, eff, _ceWizHint(nid)); },
                            'Updated \u201c' + String(nm.name || '') + '\u201d.', 'Regeneration failed.');
                    }),
                    // THE CROSS-LINK the deletion sweep was gated on. The native row called
                    // openEntityEditModal(nm.id) at engine ~21421; this is that call site,
                    // now pointing at the jsx Entity surface with a return address.
                    // A button, not a row onClick -- NESTED-TAP, as above.
                    ceBtn('Open', 'wiz:narropen:' + nid, function() {
                        ceNav('entity', nid, '', _ceWizGoBack());
                        return Promise.resolve();
                    }),
                    ceBtn('Remove', 'wiz:narrdel:' + nid, function() {
                        return ceEntityOp(function() { return Promise.resolve(deleteEntity(nid)); }).then(cePublishWiz);
                    }, 'danger'))
            });
        })(nmv));
    }

    var narrBlock = ceGroup('Threads \u00b7 ' + narrRows.length, h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { key: 'wd_nnote', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse } },
            'Opening plots \u2014 quests, mysteries, obligations. Created at the top level; nest them from the thread\u2019s own screen.'),
        _ceWizGenRow('narrative', st, 'Generate threads', function() {
            var nn = Number((st && st.counts && st.counts['narrative']) || 3);
            return _ceWizRun('Generating ' + nn + ' thread' + (nn === 1 ? '' : 's') + '\u2026', 'wiz-narr',
                function() { return runWizardNarrativesBatch(nn, eff); },
                'Threads created.', 'Generation failed.');
        }),
        narrRows.length
            ? h('div', { key: 'wd_nrows', style: { display: 'flex', flexDirection: 'column' } }, narrRows)
            : ceEmpty('No threads yet.', null),
        ceBtn('Add a blank thread', 'wiz:narrblank', function() {
            return ceEntityOp(function() { return Promise.resolve(addBlankWizardNarrative()); }).then(cePublishWiz);
        })
    ));

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } },
        h('div', { key: 'wd_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'The pressure the story opens under. All three generators below read the cast plus whatever context you choose.'),
        h('div', { key: 'wd_src' }, _ceWizSources('drama', st)),
        h('div', { key: 'wd_hooks' }, hooks),
        h('div', { key: 'wd_web' }, webBlock),
        h('div', { key: 'wd_narr' }, narrBlock)
    );
}

// -- Intro --------------------------------------------------------------------
// Generate a draft opening, edit it, then commit it into the document. The one tab whose
// commit writes PROSE rather than records.
function _ceWizIntro(st: any): any {
    var eff = _ceWizEffSrc(st, 'intro');
    var locId = String((st && st.introLocId) || '');
    var locName = String((st && st.introLocName) || '');
    var prose = String((st && st.introProse) || '');
    var hasDraft = !!prose.trim();

    var locRow = ceSettingRow('Opening location',
        locId ? '' : 'Pick where the story starts. The draft is written from this place.',
        ceBtn(locId ? locName : 'Pick a place', 'wiz:introloc', function() {
            cePickerOpen('wizIntroLoc', {});
            return Promise.resolve();
        }, locId ? undefined : 'primary'));

    var genBtn = ceBtn(hasDraft ? 'Write it again' : 'Write the opening', 'wiz:introgen', function() {
        if (!locId) {
            try { api.v1.ui.toast('Pick an opening location first.', { type: 'error', autoClose: 2400 }); } catch (eI1) {}
            return Promise.resolve();
        }
        return _ceWizRun('Writing the opening\u2026', 'wiz-intro',
            function() { return generateIntroDraft(locId, eff); },
            'Draft ready \u2014 read it below.', 'Could not write the opening.');
    }, hasDraft ? undefined : 'primary');

    var kids: any[] = [
        h('div', { key: 'wi_lede', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2, lineHeight: CE_T.lhProse } },
            'The first words of the story. Who is present comes from where each character is standing \u2014 set that on their own screen, not here.'),
        h('div', { key: 'wi_loc' }, locRow),
        h('div', { key: 'wi_src' }, _ceWizSources('intro', st)),
        h('div', { key: 'wi_gen' }, genBtn)
    ];

    if (hasDraft) {
        kids.push(h('div', { key: 'wi_draft' }, ceGroup('The draft',
            h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s3 } },
                h(ceField, {
                    key: 'wi_prose', k: 'wiz:intro:prose', label: '',
                    value: prose, seed: String((st && st.draftGen) || 0),
                    multiline: true, rows: 12, well: true,
                    placeholder: 'The opening prose\u2026',
                    onCommit: function(v: string) {
                        return ceWizOp(function() {
                            return Promise.resolve(loadIntroDraft()).then(function(cur: any) {
                                var next: any = (cur && typeof cur === 'object') ? cur : { locationId: '', prose: '' };
                                next.prose = v;
                                return Promise.resolve(api.v1.storyStorage.set(STORAGE_WIZ_INTRO_DRAFT, JSON.stringify(next)))
                                    .catch(function() { return null; });
                            });
                        });
                    }
                }),
                h('div', { key: 'wi_acts', style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap' } },
                    ceBtn('Put it in the story', 'wiz:introcommit', function() {
                        return _ceWizRun('Inserting the opening\u2026', 'wiz-intro-commit',
                            function() { return commitIntroDraft(); },
                            'The opening is in the story.', 'Commit failed.');
                    }, 'primary'),
                    ceBtn('Throw it away', 'wiz:introdrop', function() {
                        return ceWizOp(function() {
                            return Promise.resolve(api.v1.storyStorage.remove(STORAGE_WIZ_INTRO_DRAFT))
                                .catch(function() { return null; })
                                .then(function() {
                                    return Promise.resolve(api.v1.tempStorage.remove(STORAGE_WIZ_INTRO_DRAFT))
                                        .catch(function() { return null; });
                                });
                        }).then(cePublishWiz);
                    }, 'danger'))
            ))));
    }

    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s4 } }, kids);
}

// -- Tab row ------------------------------------------------------------------
// A tab change REPUBLISHES, because the publish is tab-scoped -- see cePublishWiz. This
// is the only place a tab is set on this surface, so that pairing cannot be forgotten.
function _ceWizTabRow(active: string): any {
    var kids: any[] = [];
    var i = 0;
    for (i = 0; i < CE_WIZ_TABS.length; i++) {
        kids.push((function(t: any) {
            var on = t.id === active;
            return h('div', {
                key: 'wtab_' + t.id,
                onClick: function() {
                    ceTap('wizard:tab:' + t.id, function() {
                        if (on) return;
                        ceTabSet('wizard', t.id);
                        cePublishWiz();
                    });
                },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fs, fontWeight: on ? '600' : 'normal',
                    padding: CE_T.s2 + ' ' + CE_T.s3, opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, t.label);
        })(CE_WIZ_TABS[i]));
    }
    return h('div', { style: { display: 'flex', flexWrap: 'wrap', borderBottom: '1px solid ' + CE_LINE, flex: '0 0 auto' } }, kids);
}

// -- Root ---------------------------------------------------------------------
function _ceWizRoot(): any {
    ceWizStoreInit();
    var ui = useStoreValue(ceUiStore);
    var st = useStoreValue(ceWizStore);

    useEffect(function() { cePublishWiz(); }, []);

    var back: any = ceBack();
    var tab = ceTabGet('wizard', 'setup');
    var openMap: any = (ui && ui.open) || {};

    // The store still holds the PREVIOUS tab's data until the republish lands, so the body
    // is held back rather than rendered against the wrong slice -- Drama reading a store
    // published for Setup would show an empty cast rather than a loading state.
    if (!ui || !st || !st.ready || st.tab !== tab) {
        return ceScreen(ceHeader(back), [_ceWizTabRow(tab), ceEmpty('Loading\u2026', null)]);
    }

    var body: any;
    if (tab === 'chat')            { body = _ceWizChat(st, openMap); }
    else if (tab === 'memory')     { body = _ceWizMemory(st, openMap); }
    else if (tab === 'species')    { body = _ceWizEntities('species', st, openMap); }
    else if (tab === 'factions')   { body = _ceWizEntities('factions', st, openMap); }
    else if (tab === 'locations')  { body = _ceWizLocations(st); }
    else if (tab === 'characters') { body = _ceWizCharacters(st); }
    else if (tab === 'drama')      { body = _ceWizDrama(st); }
    else if (tab === 'intro')      { body = _ceWizIntro(st); }
    else                           { body = _ceWizSetup(st); }

    // [v2.175.0 TABBODY-KEY] Same slot, same fix as Images -- see the long note there.
    // Wizard DOES paint (character thumbs on the Characters tab), so this one is
    // corrective, not prophylactic.
    return ceScreen(ceHeader(back), [_ceWizTabRow(tab),
        h('div', { key: 'wiztab:' + tab }, body)]);
}
