// [ICON-LIB] The three questions every call site asks about an icon
// string, answered in ONE place so no surface has to know the prefix rule.
function ceIconIsSvg(icon: any): boolean {
    return String(icon || '').indexOf(CE_ICON_PREFIX) === 0;
}
function ceIconKeyOf(icon: any): string {
    var s = String(icon || '');
    return ceIconIsSvg(s) ? s.slice(CE_ICON_PREFIX.length) : '';
}
function ceIconDef(icon: any): any {
    var k = ceIconKeyOf(icon);
    return (k && CE_ICON_LIB[k]) ? CE_ICON_LIB[k] : null;
}

// The shared half of both renderers: the <path> children. Returns [] for an
// unknown key -- a library entry that was deleted or a story written against a
// newer build must degrade to NO ICON, never to a thrown render.
function _ceIconPaths(def: any, keyPrefix: string): any[] {
    var out: any[] = [];
    var parts: any[] = (def && def.parts) || [];
    for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        if (!p || !p.d) continue;
        var op = CE_ICON_OP[String(p.t || 's0')];
        if (op === undefined) op = 1;
        // [THEME-SLOT] THE TIER IS A CUSTOM-PROPERTY NAME, AND THE ATTRIBUTE BELOW IS
        // THE FALLBACK IF THE PROPERTY MECHANISM IS NOT AVAILABLE.
        //
        // WHY A CUSTOM PROPERTY AND NOT A CLASS. This surface mounts in an OPEN SHADOW
        // ROOT (measured bridge-side, SHADOW-ROOT-OPEN). A stylesheet in document.head --
        // which is what a NovelAI custom theme is -- DOES NOT APPLY inside one, so no
        // class, id or data-attribute a theme could name would ever match. CSS CUSTOM
        // PROPERTIES DO INHERIT ACROSS THE BOUNDARY. They are not the best mechanism
        // available; they are the only one, and the bridge already relies on exactly this
        // for its own --ae-* tokens.
        //
        // BELT AND BRACES, DELIBERATELY. The presentation attribute keeps its literal
        // value and the STYLE carries the var(). Style beats a presentation attribute, so
        // when var() resolves the theme wins; if the style property is filtered out or
        // the var() is invalid, the attribute is still there and the icon renders exactly
        // as it does today. THE FAILURE MODE OF A BARE fill='var(...)' IS BLACK, which is
        // why it is not written that way -- an unresolvable paint on an SVG falls to the
        // initial value, not to the previous one.
        var slot = String(p.t || 's0');
        var node = h('path', {
            key: keyPrefix + '_p' + i,
            d: String(p.d),
            fill: 'currentColor',
            'fill-opacity': op,
            // A STYLE STRING, NOT A STYLE OBJECT, AND THAT IS THE FIX. The object form goes
            // through the jsx layer's per-property handling, which is the same path
            // `object-fit` was found missing from -- so `fill` and `fill-opacity`, which no
            // ordinary HTML element has, are exactly the kind of property that gets dropped
            // there. A string is serialised straight into the style attribute and never asks
            // permission. The presentation attributes above remain the floor: if the whole
            // style attribute were discarded the icon still renders as it does today.
            style: 'fill:var(--ce-ic-' + slot + ',currentColor);'
                 + 'fill-opacity:var(--ce-ic-' + slot + '-o,' + op + ')',
            // Every authored path above is a closed filled shape EXCEPT
            // 'plain', whose grass blades are open strokes. Rather than special-
            // case it, both are always set: a closed path ignores the stroke it
            // has no room for, and an open one needs it to be visible at all.
            // [ICON-WEIGHT] A DESCRIPTOR MAY ASK FOR WEIGHT, and the medieval set is why.
            // Every other group is geometric solid shapes on a 24-unit grid; that set is LINE
            // ART on 100x125 whose ~1-unit outlines are authored as fills. One unit out of
            // 125 is a quarter of a pixel at map size, so it goes sub-pixel and washes out --
            // it is the least faint set by paint (it uses only s0, opacity 1) and the hardest
            // to see. Stroking the same path in the same colour fattens the line without
            // touching the drawing. `sw` IS IN SOURCE UNITS so it scales with the icon, which
            // is the only way one number can be right at every zoom.
            stroke: 'currentColor',
            'stroke-opacity': op,
            'stroke-width': (def && def.sw !== undefined) ? Number(def.sw)
                          : (p.d.indexOf('Z') >= 0 ? 0 : 1.6),
            'stroke-linecap': 'round'
        });
        out.push(p.tf ? h('g', { key: keyPrefix + '_g' + i, transform: String(p.tf) }, node) : node);
    }
    return out;
}

// STANDALONE, for any ordinary surface. Sized in px, inherits colour from its
// parent, and is aria-hidden because it always sits beside a real text label --
// an icon announced separately would read the place's name twice.
// TAKES AN EXPLICIT KEY, and every call site passes one. The map readout's ghost
// trail (READOUT-GHOST) was an unkeyed <svg> subtree surviving a swap it should not have;
// the surviving call sites are all stable lists rather than swaps, but this is a cheap way
// to make sure they stay that way rather than a thing to rediscover.
function ceIconSvg(icon: any, px: number, key?: string): any {
    var def = ceIconDef(icon);
    if (!def) return null;
    // [ICON-FIT] THE SAME BOX THE MAP FITS TO, expressed as a square viewBox centred on it,
    // so an icon fills its button here for the same reason it fills a hex there. Two fitters
    // disagreeing about where an icon's middle is would put the picker's preview and the map
    // at different sizes for one descriptor.
    var vf = _ceIconFit(def);
    return h('svg', {
        key: String(key || ('icsvg_' + ceIconKeyOf(icon))),
        viewBox: [vf.cx - vf.span / 2, vf.cy - vf.span / 2, vf.span, vf.span].join(' '),
        width: px, height: px,
        'aria-hidden': 'true',
        style: { display: 'block', flex: '0 0 auto', color: 'currentColor' }
    }, _ceIconPaths(def, 'ic'));
}

// IN-MAP, and NOT a nested <svg>. The map is already inside a camera transform
// in viewBox units, so an icon has to arrive in those same units or it would
// have to be counter-scaled twice -- once for the camera and once for its own
// coordinate system. A <g> with an explicit translate+scale keeps ONE
// coordinate story: `size` is the drawn height in map units and everything
// else follows from the descriptor's own vb, so an imported 512-box icon and
// an authored 24-box icon land identically without either knowing about the
// other.
// [ICON-FIT] WHAT AN ICON IS FITTED TO, and it is the DECLARED box only when nothing better
// is on the descriptor. Square-fitting `vb` assumes the artwork fills it; an imported icon
// whose content sits in 88x90 of a 100x125 box then renders at 72% of the size asked for AND
// twelve units high, because the box's centre is not the drawing's centre. Both faults were
// live on the medieval set: they read as faint partly because they were also small and
// off-centre. `cb` states where the ink actually is, and one box is shared across a SET
// rather than measured per icon -- fitting each one to its own bounds would blow a flag up
// to the size of a castle and the set would lose its internal scale.
function _ceIconFit(def: any): any {
    var vb = (def && def.vb) || [0, 0, 24, 24];
    var box = (def && def.cb) || vb;
    var x = Number(box[0]) || 0, y = Number(box[1]) || 0;
    var w = Number(box[2]) || 24, h = Number(box[3]) || 24;
    var span = Math.max(w, h) || 24;
    return { x: x, y: y, w: w, h: h, span: span, cx: x + w / 2, cy: y + h / 2 };
}

function ceIconMapGroup(icon: any, cx: number, cy: number, size: number, key: string): any {
    var def = ceIconDef(icon);
    if (!def) return null;
    var fit = _ceIconFit(def);
    var k = size / fit.span;                   // square-fit, so wide icons are not stretched
    var tx = cx - fit.cx * k;
    var ty = cy - fit.cy * k;
    return h('g', {
        key: key,
        transform: 'translate(' + tx + ',' + ty + ') scale(' + k + ')',
        'pointer-events': 'none'
    }, _ceIconPaths(def, key));
}

// The picker's own source of truth. Grouped, in a fixed order, so the Entity
// surface renders whatever is in the table without carrying its own copy of
// the list -- adding an icon above is genuinely the only step.
// [MAP-KIND] How much of a vector icon's nominal size an EMOJI gets. See the emoji branch
// in the map renderer for why the two are not the same number.
var CE_MAP_EMOJI_SCALE = 0.74;

var CE_ICON_GROUPS: any[] = [
    { id: 'built', label: 'Built' },
    { id: 'medieval', label: 'Medieval' },
    { id: 'city',  label: 'City' },
    { id: 'wild',  label: 'Wild' },
    { id: 'space', label: 'Space' },
    { id: 'mark',  label: 'Marks' }
];

function ceIconKeysIn(group: string): string[] {
    var out: string[] = [], k: string;
    for (k in CE_ICON_LIB) { if (String(CE_ICON_LIB[k].group) === group) out.push(k); }
    return out;
}

// ============================================================================
// SECTION 32 — WORLD MAP SURFACE (jsx)
// ============================================================================
// A nested-circle map of the location hierarchy.
//
// MEASURED POINTER FACTS, none re-derivable from the typings:
//   - SVG renders in a jsx surface, including counter-scaled stroke-width and font-size.
//   - TWO CONCURRENT POINTERS FIRE, so pinch is real. Reconstructed from pointerId
//     tracking, NOT touch events: ScriptTouchEvent carries no touch positions at all.
//   - touch-action:'none' alone stops native scroll. preventDefault does not exist.
//   - onPointerDown/Up are 1:1 here (35/35 measured). This does NOT overturn the onClick
//     double-fire; every BUTTON still goes through ceTap/ceAction.
//   - Pointer events survive leaving the element, so the absent setPointerCapture is free.
//   - onPointerLeave fires constantly (127 against 35 real downs), so its handler must not
//     write state for a pointer it was never tracking.
//
// GEOMETRY IS d3.pack's ALGORITHM, HAND-PORTED -- d3 cannot be imported into the Worker
// sandbox. Front-chain sibling packing (Wang et al.) plus Welzl's smallest-enclosing-circle,
// unit-tested outside this file first (17 checks) because a geometry bug in here is A BLANK
// SURFACE WITH NO CONSOLE LINE.
//
// SIZING: a leaf counts 1, a parent is the SUM of its children. No separate "importance"
// field to keep in sync with anything.
//
// PADDING IS IN OUTPUT UNITS AND NEEDS TWO PACKING PASSES. Internally a leaf has radius
// sqrt(value) = 1, so applying the caller's padding directly inflates every leaf several
// times over and leaves parents nearly empty (measured: 0.116 fill ratio). Pass 1 packs
// unpadded purely to learn root.r in internal units; that ratio converts output-unit padding
// for pass 2. The unit test carries a fill-ratio check so this cannot regress silently.
//
// THE ONE UNMEASURABLE CONSTANT: CE_MAP_FONT_VB. Label legibility wants text size IN PIXELS
// and the mount has no ownerDocument, so there is no getBoundingClientRect and no way to
// learn the viewBox-to-pixel ratio. Everything else is resolution-independent -- diameter
// and font size share a transform, so "does this name fit" is a pure ratio. Only the
// absolute floor needs pixels, so this is calibrated for a nominal ~360px viewport.
// Degrades gracefully: wrong by 30% means slightly large or small text, not a broken layout.
// ============================================================================

var CE_MAP_VB       = 1000;    // viewBox is CE_MAP_VB x CE_MAP_VB, all geometry in these units
var CE_MAP_PAD      = 26;      // sibling padding, in viewBox units (see two-pass note above)
// [earlier MAP-LEGIBILITY, per user: "smaller circles with bigger siblings can sit out in
// space to give them more room, siblings don't have to hug each other"] 10 -> 26.
// PADDING IS THE ONLY LEVER THAT DOES THIS, and it is worth saying why the obvious
// alternative is wrong: d3.pack's front-chain packing places each sibling tangent to the
// chain, so "push the small ones outward" is not a parameter of it -- the only thing that
// separates siblings at all is the pad added to every radius before packing. Raising it
// pushes ALL siblings apart, which is what was actually asked for; the small ones simply
// gain the most, because the same absolute gap is a larger share of a small circle's own
// diameter.
// It costs fill ratio -- every circle is slightly smaller inside its parent -- and that is
// the trade being made deliberately: overlapping names were the reported problem and a
// denser packing was what caused them. The two-pass converter (see above) already handles
// the unit conversion, so this number needs no other change.
var CE_MAP_FONT_VB  = 34;      // apparent label size in viewBox units -- the calibrated constant
var CE_MAP_CHAR_W   = 0.55;    // average glyph width as a fraction of font size, for fit math
var CE_MAP_VIEW_H_PX = 380;    // map viewport height IN PIXELS, as a NUMBER -- see PAN-SCALE below
var CE_MAP_VIEW_H   = CE_MAP_VIEW_H_PX + 'px'; // same value, as a CSS string, for the style prop
var CE_MAP_ROOT_ID  = '__ce_map_root__';
// [PAN-SCALE, per user "panning is a little slow"] A SECOND HONEST-APPROXIMATION CONSTANT,
// same category as CE_MAP_FONT_VB and for the identical reason: this environment cannot
// read the SVG's actual rendered pixel size (no ownerDocument, no getBoundingClientRect --
// JSX-PROBE-RESULTS (4)), so the CSS-pixel-to-viewBox-unit ratio cannot be measured, only
// assumed. The bug this fixes: onMove's pan handler was adding raw clientX/Y deltas (CSS
// pixels) directly onto camera.x/y (viewBox units) with an IMPLICIT 1:1 ratio -- but the
// <g transform> lives in viewBox space, which is CE_MAP_VB units mapped onto however many
// CSS pixels the SVG actually renders at, roughly CE_MAP_VIEW_H_PX on a typical portrait
// phone (the square viewBox is constrained by whichever container dimension is smaller,
// and width is usually >= height on this surface). So 1 CSS pixel of finger movement was
// only moving the map (CE_MAP_VIEW_H_PX / CE_MAP_VB) of a viewBox unit -- roughly 38% of
// what the finger travelled -- which reads exactly as "sluggish." The fix multiplies every
// pointer-pixel delta by this ratio before adding it to camera.x/y. This conversion is
// INDEPENDENT of camera.k: translate() in `translate(camera.x,camera.y) scale(camera.k)`
// shifts the whole group by that many viewBox units regardless of the group's own scale,
// so no k-dependent term belongs here -- confirmed by the transform math, not guessed.
var CE_MAP_VB_PER_PX = CE_MAP_VB / CE_MAP_VIEW_H_PX;

// -- Deterministic RNG --------------------------------------------------------
// Seeded identically on every call so a given world always packs to the SAME
// layout. A map whose circles rearranged themselves on each render would be
// unusable, and Welzl's algorithm wants a shuffle for its expected-linear time.
function ceMapLcg(): any {
    var s = 1;
    return function() { s = (1664525 * s + 1013904223) % 4294967296; return s / 4294967296; };
}

function ceMapShuffle(arr: any[], random: any): any[] {
    var a = arr.slice(), m = a.length, t: any, i: number;
    while (m) { i = Math.floor(random() * m--); t = a[m]; a[m] = a[i]; a[i] = t; }
    return a;
}

// -- Smallest enclosing circle (Welzl, randomized incremental) ----------------
function ceMapEnclosesNot(a: any, b: any): boolean {
    var dr = a.r - b.r, dx = b.x - a.x, dy = b.y - a.y;
    return dr < 0 || dr * dr < dx * dx + dy * dy;
}

function ceMapEnclosesWeak(a: any, b: any): boolean {
    var dr = a.r - b.r + Math.max(a.r, b.r, 1) * 1e-9, dx = b.x - a.x, dy = b.y - a.y;
    return dr > 0 && dr * dr > dx * dx + dy * dy;
}

function ceMapEnclosesWeakAll(a: any, B: any[]): boolean {
    for (var i = 0; i < B.length; i++) { if (!ceMapEnclosesWeak(a, B[i])) return false; }
    return true;
}

function ceMapBasis1(a: any): any { return { x: a.x, y: a.y, r: a.r }; }

function ceMapBasis2(a: any, b: any): any {
    var x1 = a.x, y1 = a.y, r1 = a.r, x2 = b.x, y2 = b.y, r2 = b.r,
        x21 = x2 - x1, y21 = y2 - y1, r21 = r2 - r1,
        l = Math.sqrt(x21 * x21 + y21 * y21);
    return { x: (x1 + x2 + x21 / l * r21) / 2, y: (y1 + y2 + y21 / l * r21) / 2, r: (l + r1 + r2) / 2 };
}

function ceMapBasis3(a: any, b: any, c: any): any {
    var x1 = a.x, y1 = a.y, r1 = a.r, x2 = b.x, y2 = b.y, r2 = b.r, x3 = c.x, y3 = c.y, r3 = c.r,
        a2 = x1 - x2, a3 = x1 - x3, b2 = y1 - y2, b3 = y1 - y3, c2 = r2 - r1, c3 = r3 - r1,
        d1 = x1 * x1 + y1 * y1 - r1 * r1,
        d2 = d1 - x2 * x2 - y2 * y2 + r2 * r2,
        d3 = d1 - x3 * x3 - y3 * y3 + r3 * r3,
        ab = a3 * b2 - a2 * b3,
        xa = (b2 * d3 - b3 * d2) / (ab * 2) - x1,
        xb = (b3 * c2 - b2 * c3) / ab,
        ya = (a3 * d2 - a2 * d3) / (ab * 2) - y1,
        yb = (a2 * c3 - a3 * c2) / ab,
        A = xb * xb + yb * yb - 1,
        B = 2 * (r1 + xa * xb + ya * yb),
        C = xa * xa + ya * ya - r1 * r1,
        r = -(Math.abs(A) > 1e-6 ? (B + Math.sqrt(B * B - 4 * A * C)) / (2 * A) : C / B);
    return { x: x1 + xa + xb * r, y: y1 + ya + yb * r, r: r };
}

function ceMapEncloseBasis(B: any[]): any {
    if (B.length === 1) return ceMapBasis1(B[0]);
    if (B.length === 2) return ceMapBasis2(B[0], B[1]);
    return ceMapBasis3(B[0], B[1], B[2]);
}

function ceMapExtendBasis(B: any[], p: any): any[] {
    var i: number, j: number;
    if (ceMapEnclosesWeakAll(p, B)) return [p];
    for (i = 0; i < B.length; i++) {
        if (ceMapEnclosesNot(p, B[i]) && ceMapEnclosesWeakAll(ceMapBasis2(B[i], p), B)) return [B[i], p];
    }
    for (i = 0; i < B.length - 1; i++) {
        for (j = i + 1; j < B.length; j++) {
            if (ceMapEnclosesNot(ceMapBasis2(B[i], B[j]), p)
                && ceMapEnclosesNot(ceMapBasis2(B[i], p), B[j])
                && ceMapEnclosesNot(ceMapBasis2(B[j], p), B[i])
                && ceMapEnclosesWeakAll(ceMapBasis3(B[i], B[j], p), B)) {
                return [B[i], B[j], p];
            }
        }
    }
    // d3 throws here. This file must not: an exception during render is a blank
    // surface with nothing in the console. Return a safe superset instead --
    // slightly loose packing beats no map at all.
    return B.concat([p]);
}

function ceMapPackEnclose(circles: any[], random: any): any {
    var list = ceMapShuffle(circles, random);
    var i = 0, n = list.length, B: any[] = [], p: any, e: any = null;
    while (i < n) {
        p = list[i];
        if (e && ceMapEnclosesWeak(e, p)) { i++; }
        else { B = ceMapExtendBasis(B, p); e = ceMapEncloseBasis(B); i = 0; }
    }
    return e;
}

// -- Front-chain sibling packing (Wang et al.) --------------------------------
function ceMapPlace(b: any, a: any, c: any): void {
    var dx = b.x - a.x, x: number, a2: number,
        dy = b.y - a.y, y: number, b2: number,
        d2 = dx * dx + dy * dy;
    if (d2) {
        a2 = a.r + c.r; a2 *= a2;
        b2 = b.r + c.r; b2 *= b2;
        if (a2 > b2) {
            x = (d2 + b2 - a2) / (2 * d2);
            y = Math.sqrt(Math.max(0, b2 / d2 - x * x));
            c.x = b.x - x * dx - y * dy;
            c.y = b.y - x * dy + y * dx;
        } else {
            x = (d2 + a2 - b2) / (2 * d2);
            y = Math.sqrt(Math.max(0, a2 / d2 - x * x));
            c.x = a.x + x * dx - y * dy;
            c.y = a.y + x * dy + y * dx;
        }
    } else { c.x = a.x + c.r; c.y = a.y; }
}

function ceMapIntersects(a: any, b: any): boolean {
    var dr = a.r + b.r - 1e-6, dx = b.x - a.x, dy = b.y - a.y;
    return dr > 0 && dr * dr > dx * dx + dy * dy;
}

function ceMapChainScore(node: any): number {
    var a = node._, b = node.next._, ab = a.r + b.r,
        dx = (a.x * b.r + b.x * a.r) / ab,
        dy = (a.y * b.r + b.y * a.r) / ab;
    return dx * dx + dy * dy;
}

function ceMapChainNode(circle: any): any { return { _: circle, next: null, previous: null }; }

function ceMapPackSiblings(circles: any[], random: any): number {
    var n = circles.length, a: any, b: any, c: any, aa: number, ca: number,
        i: number, j: any, k: any, sj: number, sk: number;
    if (!n) return 0;

    a = circles[0]; a.x = 0; a.y = 0;
    if (n <= 1) return a.r;

    b = circles[1]; a.x = -b.r; b.x = a.r; b.y = 0;
    if (n <= 2) return a.r + b.r;

    c = circles[2];
    ceMapPlace(b, a, c);

    a = ceMapChainNode(a); b = ceMapChainNode(b); c = ceMapChainNode(c);
    a.next = c.previous = b;
    b.next = a.previous = c;
    c.next = b.previous = a;

    pack: for (i = 3; i < n; i++) {
        ceMapPlace(a._, b._, circles[i]);
        c = ceMapChainNode(circles[i]);
        j = b.next; k = a.previous; sj = b._.r; sk = a._.r;
        do {
            if (sj <= sk) {
                if (ceMapIntersects(j._, c._)) { b = j; a.next = b; b.previous = a; i--; continue pack; }
                sj += j._.r; j = j.next;
            } else {
                if (ceMapIntersects(k._, c._)) { a = k; a.next = b; b.previous = a; i--; continue pack; }
                sk += k._.r; k = k.previous;
            }
        } while (j !== k.next);

        c.previous = a; c.next = b; a.next = b.previous = b = c;
        aa = ceMapChainScore(a);
        while ((c = c.next) !== b) {
            ca = ceMapChainScore(c);
            if (ca < aa) { a = c; aa = ca; }
        }
        b = a.next;
    }

    var chain: any[] = [b._];
    c = b;
    while ((c = c.next) !== b) chain.push(c._);
    var e = ceMapPackEnclose(chain, random);
    for (i = 0; i < n; i++) { circles[i].x -= e.x; circles[i].y -= e.y; }
    return e.r;
}

// -- Hierarchy walk + layout --------------------------------------------------
function ceMapSumValues(node: any): number {
    var kids = node.children || [];
    if (!kids.length) { node.value = 1; return 1; }
    var total = 0;
    for (var i = 0; i < kids.length; i++) total += ceMapSumValues(kids[i]);
    node.value = total;
    return total;
}

function ceMapEachAfter(node: any, fn: any): void {
    var kids = node.children || [];
    for (var i = 0; i < kids.length; i++) ceMapEachAfter(kids[i], fn);
    fn(node);
}

function ceMapEachBefore(node: any, fn: any): void {
    fn(node);
    var kids = node.children || [];
    for (var i = 0; i < kids.length; i++) ceMapEachBefore(kids[i], fn);
}

// [MAP-SELF, per user: "maybe it gets its own space like being an additional child"] THE
// PARENT IS PACKED AMONG ITS OWN CHILDREN, AS ONE MORE CIRCLE. Two complaints, one shape: a
// parent's icon and name sat at the top edge of its circle and landed on whatever the packer
// had already put there, and a container holding one child read as a leaf. A node that holds
// things needs somewhere to BE that is not somewhere its children are, and the packer is the
// only thing in this file that knows where that is.
// IT IS NOT A NODE AND IT IS NOT DRAWN. No id, no entity, no hit target, nothing in `nodes`
// that a search or an occupant list could trip over -- three numbers hung on the node
// (sx, sy, sr) that the render loop centres the icon-and-name block on. CLICKS ARE
// UNCHANGED: the parent's own circle already takes every press that is not a child's,
// because children are painted after parents and carry their own handler.
// SIZED OFF THE CHILDREN, as the circle with the AVERAGE CHILD'S AREA. A fixed fraction of
// the parent is a speck in a crowded place and swallows a sparse one; "one more of these"
// is the only measure that reads correctly at both extremes.
var CE_MAP_SELF_SCALE = 0.85;

// [MAP-SCALE, per user: "the relative size of children is a little severe, causing smaller
// siblings to become visually insignificant"] SIBLING RADII ARE COMPRESSED BEFORE PACKING.
// Size is emergent here: a leaf is radius 1 and a node holding twenty leaves comes out near
// sqrt(20), so a small sibling beside a big one is not merely smaller, it is unreadable.
// Raising each radius to a power under 1 keeps the ORDER exact and pulls the spread in, and
// because (a/b)^g is the ratio of the powers, the compression a given pair receives does not
// depend on how deep in the tree the pair sits.
// AT EVERY LEVEL, NOT ONCE AT THE TOP, because the disparity compounds down the tree and a
// single correction at the root would leave every branch below it as severe as before.
// RADII AT OR BELOW 1 ARE LEFT ALONE. A leaf is exactly 1 and the curve would not move it,
// but anything arriving under 1 would be INFLATED by that same curve -- the one input where
// this transform reverses its own meaning.
// MEASURED AT 0.7, on a root holding a 20-leaf branch, a 4-leaf branch and three bare
// siblings, packed into the standard 1000-unit frame:
//   radius ratio 20-leaf : leaf   6.46 -> 3.65
//   radius ratio  4-leaf : leaf   3.01 -> 2.13
//   a bare sibling's own radius   51.7 -> 84.0
// The last line is the complaint: the small sibling is not merely relatively larger, it is
// absolutely larger, because the frame no longer has to make room for the big one.
var CE_MAP_SIZE_GAMMA = 0.7;

function _ceMapDamp(r: number): number {
    var v = Number(r) || 0;
    if (!(v > 1)) return v;
    return Math.pow(v, CE_MAP_SIZE_GAMMA);
}

// [SINGLE-CHILD-OFFSET] DELETED, WITH CE_MAP_SOLO_SCALE AND CE_MAP_SOLO_ANGLE. It existed so
// a one-child container did not read as a leaf -- with n=1 the enclosing circle wraps the
// child edge-to-edge and the two come out concentric -- and it bought that by halving the
// child and shoving it off-centre on a fixed bearing. MAP-SELF turns n=1 into n=2 before the
// packer ever sees it, so the case it defended against cannot arise, and a special case for
// one arity is a second geometry to keep in step with the first.
// ITS PARENT-RADIUS RULE GOES WITH IT (parentR = sqrt(node.value) rather than the packed
// enclosure), which was there to stop a one-child node coming out smaller than a same-value
// two-child sibling. That is handled the ordinary way now: both pack the same total child
// area plus one slot, so they land at comparable sizes by construction rather than by
// exception.
function ceMapPackChildren(node: any, padInternal: number, random: any): void {
    var kids = node.children || [];
    node._sx = 0; node._sy = 0; node._sr = 0;
    if (!kids.length) return;
    var i: number, r = padInternal || 0;

    // [MAP-SCALE] The damped radius and the factor that produced it. `_f` converts the
    // child's OWN frame into this node's: the child's descendants were laid out against its
    // intrinsic radius, so shrinking the child here has to shrink everything under it, and
    // the final walk is where that is paid.
    var area = 0;
    for (i = 0; i < kids.length; i++) {
        var ir = Number(kids[i].r) || 0;
        var dr = _ceMapDamp(ir);
        kids[i]._dr = dr;
        kids[i]._f = (ir > 0) ? (dr / ir) : 1;
        area += dr * dr;
    }

    // [MAP-SELF] The slot, padded exactly as a child is so that a place with one room does
    // not get a tighter gap around it than a place with six.
    var selfR = Math.sqrt(area / kids.length) * CE_MAP_SELF_SCALE;
    if (!(selfR > 0)) selfR = 1;
    var slot: any = { r: selfR + r, x: 0, y: 0 };

    var pack: any[] = [];
    for (i = 0; i < kids.length; i++) { kids[i].r = kids[i]._dr + r; pack.push(kids[i]); }
    pack.push(slot);
    var e = ceMapPackSiblings(pack, random);
    for (i = 0; i < kids.length; i++) kids[i].r = kids[i]._dr;
    node.r = e + r;
    node._sx = slot.x; node._sy = slot.y; node._sr = selfR;
}

function ceMapPackHierarchy(root: any, size: number, padding: number): any {
    var random = ceMapLcg();
    var padOut = Number(padding) || 0;

    ceMapSumValues(root);
    function _ceMapSeedLeaves(node: any): void {
        if (!node.children || !node.children.length) node.r = Math.sqrt(node.value);
    }
    ceMapEachBefore(root, _ceMapSeedLeaves);

    // Pass 1: unpadded, purely to learn root.r in internal units.
    ceMapEachAfter(root, function(node: any) { ceMapPackChildren(node, 0, random); });

    // Pass 2: repack with the caller's output-unit padding converted to internal.
    // [MAP-SCALE] THE LEAVES ARE RE-SEEDED FIRST, and this line is the whole cost of
    // damping. A pack now WRITES the damped radius back onto each child, and a leaf has
    // nothing beneath it to recompute its radius from -- so a second pass reading whatever
    // pass 1 left would damp an already-damped number and apply the compression twice. Every
    // other node is rebuilt from its own children by its own pack call, which runs before
    // its parent's in the eachAfter order, so leaves are the only gap.
    if (padOut && root.r > 0) {
        var toInternal = root.r / size;
        ceMapEachBefore(root, _ceMapSeedLeaves);
        ceMapEachAfter(root, function(node: any) { ceMapPackChildren(node, padOut * toInternal, random); });
    }

    // [MAP-SCALE] THE SCALE IS PER-NODE NOW RATHER THAN ONE GLOBAL k. `_S` converts a node's
    // OWN local frame -- the units its children were packed in -- into output units. One
    // factor sufficed while nothing rescaled a subtree after packing it; damping does exactly
    // that, so each node's frame is `_f` smaller than its parent's and this walk carries the
    // running product. Pre-order is what makes it legal: the parent's `_S` and centre are
    // already final when a child reads them.
    var k = (root.r > 0) ? ((size / 2) / root.r) : 1;
    ceMapEachBefore(root, function(node: any) {
        if (!node.parent) {
            node._S = k;
            node.x = size / 2; node.y = size / 2;
            node.r = node.r * k;
        } else {
            var pS = Number(node.parent._S) || k;
            node.x = node.parent.x + pS * node.x;
            node.y = node.parent.y + pS * node.y;
            node.r = pS * node.r;
            node._S = pS * (Number(node._f) || 1);
        }
        // [MAP-SELF] The slot rides the same transform a child would, because that is what
        // it is: a circle expressed in this node's local frame.
        if (node._sr > 0) {
            node.sx = node.x + node._S * node._sx;
            node.sy = node.y + node._S * node._sy;
            node.sr = node._S * node._sr;
        } else {
            node.sx = node.x; node.sy = node.y; node.sr = 0;
        }
    });
    return root;
}

// -- Building the tree from real entities -------------------------------------
// Reads the ENTITY INDEX only (EntityMeta carries id/name/type/parentId/icon), so
// a whole world costs one storyStorage read rather than one loadEntity per node.
function ceMapWouldCycle(byId: any, childId: string, parentId: string): boolean {
    var seen: any = {}, cur: any = parentId, guard = 0;
    while (cur && guard++ < 100000) {
        if (cur === childId) return true;
        if (seen[cur]) return true;
        seen[cur] = true;
        cur = byId[cur] ? byId[cur].parentId : null;
    }
    return false;
}

function ceMapBuildTree(metas: any[]): any {
    var byId: any = {}, order: string[] = [], i: number;
    for (i = 0; i < (metas || []).length; i++) {
        var m = metas[i];
        if (!m || !m.id || m.type !== 'location') continue;
        // [MAP-HIDDEN] Skipped BEFORE packing, so a hidden place contributes nothing
        // to any ancestor's value and cannot distort sibling sizes. Its own children, if it
        // ever has any, fall through to the existing "parent outside the location set"
        // branch below and become roots -- which is the honest outcome: a place whose
        // container is off the map has to be reachable somehow.
        if (ceMapKindOf(m.mapKind) === 'hidden') continue;
        if (byId[m.id]) continue;
        byId[m.id] = {
            id: String(m.id), name: String(m.name || 'Unnamed'), icon: String(m.icon || ''),
            mapKind: ceMapKindOf(m.mapKind),
            // [HEX-LOCCOLOR] THE AUTHORED COLOUR REACHES THIS MAP TOO. It is a fact about the
            // PLACE, not about one drawing of it -- an author who says the docks are green
            // has not said "green on the hex map only". '' where nobody chose: this map has
            // no derived fallback and does not want one, since a circle already reads by
            // position and a hex does not.
            mapColor: String((m as any).mapColor || ''),
            parentId: m.parentId ? String(m.parentId) : null,
            children: [], parent: null, depth: 0
        };
        order.push(String(m.id));
    }

    var roots: any[] = [];
    for (i = 0; i < order.length; i++) {
        var n = byId[order[i]];
        var pid = n.parentId;
        // A parent outside the location set (an item, a deleted node) makes this a
        // root rather than an orphan we drop -- a location must always be reachable.
        if (pid && byId[pid] && !ceMapWouldCycle(byId, n.id, pid)) {
            byId[pid].children.push(n);
            n.parent = byId[pid];
        } else {
            roots.push(n);
        }
    }

    if (!roots.length) return null;

    var root: any;
    if (roots.length === 1) {
        root = roots[0];
    } else {
        // Several top-level places: give them one synthetic container so the map has
        // a single frame. It is NOT selectable and carries no entity.
        root = { id: CE_MAP_ROOT_ID, name: 'World', icon: '', parentId: null, children: roots, parent: null, depth: 0 };
        for (i = 0; i < roots.length; i++) roots[i].parent = root;
    }
    ceMapEachBefore(root, function(node: any) {
        node.depth = node.parent ? (node.parent.depth + 1) : 0;
    });
    return root;
}

// -- Store, publish -----------------------------------------------------------
var ceMapStore: any = null;
function ceMapStoreInit(): void {
    if (ceMapStore) return;
    try {
        ceMapStore = createStore({
            ready: false, nodes: [], focusId: '', selectedId: '', camLocId: '',
            camera: { x: 0, y: 0, k: 1 }, note: '',
            // [MAP-FIND] STORE-BEFORE-HOOK: these three must exist in the INITIAL
            // shape, not only after the first publish, or the first render reads undefined
            // off a store the surface is already subscribed to.
            occupants: {}, findables: [], hidden: [], showHidden: false,
            // [TAB-ENTS] STORE-BEFORE-HOOK, fourth time. The Entities tab is subscribed
            // from its first render and a list reading undefined is a blank tab with no
            // console line -- the same failure the three lists above are seeded against.
            entList: [],
            // [SPEC-CTX] Absent means ON for both switches, matching loadCastLore's own
            // rule, so the Species tab renders correctly on the frame before the first
            // publish lands rather than flashing two switched-off lists.
            pplOn: true, bstOn: true, pplExclude: [], bstExclude: [],
            pplText: '', bstText: '',
            // [SEC:SCHED] STORE-BEFORE-HOOK again, same rule as the three above: the Time
            // tab is subscribed to this store from its first render, and a tab reading
            // undefined off a store is a blank surface with no console line.
            clockT: 0, clockStamp: '', clockBand: '', schedRows: [], dated: [],
            // [F-2] STORE-BEFORE-HOOK, third time: the month grid renders on the Time tab's
            // first paint and a surface reading undefined off a subscribed store is a blank
            // panel with no console line.
            selDay: 0, selStamp: '', selIsToday: true, monthLabel: '', monthCols: 0,
            monthDayNames: [], prevMonthDay: 0, nextMonthDay: 0,
            monthCells: [], elsewhere: [],
            // [SEC:TRAVEL] STORE-BEFORE-HOOK, fourth time. The action bar prices the
            // selected place on the very first paint, and ceTravelQuote over an undefined
            // node list is a crash where an empty one is simply an unpriced world.
            travelNodes: [], travelTiers: [], travelResId: '', travelResName: '', travelResHave: 0,
            // [TRAVEL-MODE] STORE-BEFORE-HOOK. The action bar reads it before the first publish.
            travelMode: 'circle',
            // [MAP-VEHICLE] THE OPT-IN, AND IT STORES AN ID RATHER THAN A BOOLEAN. A
            // boolean would survive the camera leaving the ship: walk ashore, walk back
            // aboard a different one, and the mode is silently still on for a vessel the
            // author never chose. Holding the id makes "engaged" mean `travelVehId ===
            // the vehicle the camera is in right now`, so every way of disengaging --
            // stepping off, changing ships, deleting one -- disengages by arithmetic and
            // needs no reset plumbing anywhere.
            // STORE-BEFORE-HOOK, fifth time: the action bar reads it on the first paint.
            travelVehId: ''
        });
    } catch (e) { api.v1.error('[AE:map] store init failed:', e); }
}

function ceMapPatch(fn: (s: any) => any): void {
    if (!ceMapStore) return;
    try {
        ceMapStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:map] patch failed:', e); }
}

// [F-2] BROWSING IS READ-ONLY WITH RESPECT TO THE WORLD, and these two variables are what
// keeps it that way. A selected day is UI state and nothing else: if a tapped cell called
// ceClockSet it would fire ceSchedResolve and physically move every off-camera character,
// so paging back through last month would silently rearrange the world.
// -1 MEANS "FOLLOW THE CLOCK" for both, which is why they are not seeded to a day number:
// a stored 0 would pin the surface to story-day-zero forever once the clock advanced.
//   _ceMapSelDay    the day being read
//   _ceMapMonthDay  any day inside the month being SHOWN, so month nav can page away from
//                   the selection without moving it
var _ceMapSelDay = -1;
var _ceMapMonthDay = -1;

// [T-21] THE SET-CLOCK DRAFT. -1 means "follow the clock", which is why these are not
// simply seeded from it: a field seeded on publish would fight the author's own typing
// every time anything else republished the surface.
//
// STAGED, AND THAT IS THE WHOLE DESIGN. ceClockSet fires ceSchedResolve on every write
// (T-13), so committing an hour and a minute separately would move the entire cast
// through an intermediate time the author never chose -- and moving people is not
// undoable by setting the clock back, because the stops that fired have already fired.
// So the controls write scratch, and ONE button performs ONE ceClockSet.
//
// THE DAY IS NOT HERE. It is _ceMapSelDay above: the calendar grid already selects a day
// and a second day control would be two answers to one question. Tapping a cell IS
// setting the date, and the button below is what makes it take.
// [T-21b] -1 / '' mean "follow the clock". A field seeded from the clock on publish would
// fight the author's typing every time anything else republished the surface.
var _ceMapSetD = -1;
var _ceMapSetMon = -1;
var _ceMapSetY = -1;
var _ceMapSetTime = '';

// [TAB-ENTS] THE WHOLE INDEX AS ONE PRE-ORDERED LIST, and it is a pure function of the
// metas so both of cePublishMap's returns can call it -- including the no-locations one,
// where a world of threads and items would otherwise project nothing at all.
// EVERY ROW SURVIVES, WHATEVER THE GRAPH DOES TO IT. Three things the world graph permits
// at rest would each silently drop an entity from a list called "everything":
//   an ORPHAN     -- parentId naming a deleted record. Treated as a root, not skipped:
//                    an entity you cannot see is one you cannot re-parent.
//   a CYCLE       -- ceMapWouldCycle only blocks these at the picker, so they exist. The
//                    visited set stops the walk; the sweep afterwards re-enters the ring
//                    at an arbitrary member so its rows still print.
//   a CHARACTER   -- a body has no catalog and is skipped by the map's findables on
//                    purpose. It is kept here: where a person hangs IS the hierarchy.
// SORTED BY NAME AT EACH LEVEL. There is no authored order on the entity index (G-03's
// category order is a different list), so the alternative is storage order, which is
// creation order, which reads as unsorted.
function _ceEntListBuild(metas: any[]): any[] {
    var out: any[] = [];
    try {
        var byId: any = {};
        var kids: any = {};
        var roots: any[] = [];
        var i = 0;
        for (i = 0; i < (metas || []).length; i++) {
            if (metas[i] && metas[i].id) byId[String(metas[i].id)] = metas[i];
        }
        for (i = 0; i < (metas || []).length; i++) {
            var m: any = metas[i];
            if (!m || !m.id) continue;
            var pid = String(m.parentId || '');
            if (!pid || !byId[pid]) { roots.push(m); continue; }
            if (!kids[pid]) kids[pid] = [];
            kids[pid].push(m);
        }
        var byName = function(a: any, b: any): number {
            var an = String((a && a.name) || '').toLowerCase();
            var bn = String((b && b.name) || '').toLowerCase();
            return (an < bn) ? -1 : ((an > bn) ? 1 : 0);
        };
        roots.sort(byName);
        var seen: any = {};
        var walk = function(node: any, depth: number): void {
            if (!node || !node.id) return;
            var nid = String(node.id);
            if (seen[nid]) return;
            seen[nid] = 1;
            var pn = node.parentId ? String((byId[String(node.parentId)] || {}).name || '') : '';
            out.push({ id: nid, name: String(node.name || 'Unnamed'),
                       type: String(node.type || ''), icon: String(node.icon || ''),
                       depth: depth, parentName: pn,
                       // [F-32] Carried off the meta, which already has both. The Species tab
                       // reads THIS list rather than getting a store key of its own: it wants
                       // the same records in the same shape, already built once per publish,
                       // and a second projection of one index is a second thing to keep in
                       // step. The Entities tab ignores both fields.
                       speciesList: ceSpeciesList(node),
                       kindWord: String(node.locationType || ''),
                       childCount: Number(node.childCount) || 0 });
            var ks: any[] = (kids[nid] || []).slice();
            ks.sort(byName);
            for (var k = 0; k < ks.length; k++) walk(ks[k], depth + 1);
        };
        for (i = 0; i < roots.length; i++) walk(roots[i], 0);
        // The cycle sweep. Anything a root could not reach is entered here at depth 0.
        for (i = 0; i < (metas || []).length; i++) {
            if (metas[i] && metas[i].id && !seen[String(metas[i].id)]) walk(metas[i], 0);
        }
    } catch (eEl) { api.v1.error('[AE:map] entity list build:', eEl); }
    return out;
}

// [SPEC-CTX] THE SPECIES-ENTRY HALF OF THE MAP PROJECTION, and the preview comes off
// lastPplText/lastBstText rather than out of buildCastLoreTexts. That pair is the dirty
// check's own record of what was last WRITTEN to the lorebook, so it is by construction the
// text the model is being sent -- and reading it costs the one storyStorage read this
// function was going to make anyway, where rebuilding would cost an index walk plus one
// record read per species on every repaint of a surface whose other three tabs never ask.
async function _ceMapSpeciesCtx(): Promise<any> {
    try {
        var cl: any = await loadCastLore();
        return { pplOn: cl.pplOn !== false, bstOn: cl.bstOn !== false,
                 pplExclude: cl.pplExclude || [], bstExclude: cl.bstExclude || [],
                 pplText: String(cl.lastPplText || ''), bstText: String(cl.lastBstText || '') };
    } catch (e) {
        api.v1.error('[AE:map] species context read failed:', e);
        return { pplOn: true, bstOn: true, pplExclude: [], bstExclude: [],
                 pplText: '', bstText: '' };
    }
}

async function cePublishMap(): Promise<void> {
    ceMapStoreInit();
    if (!ceMapStore) return;
    try {
        var metas: any[] = await loadEntityIndex();
        var mSpx: any = await _ceMapSpeciesCtx();
        var camLoc: any = await loadProtagonistLocation();
        // [MAP-FIND] ONE character-index read serves TWO features: who is standing in
        // the selected place (the readout), and characters as search targets that resolve to
        // the place they are in. currentLocationId is the CharacterMeta field maintained by
        // buildCharMeta -- the same read the Entity surface's presentChars makes, so the two
        // panels cannot disagree about who is where.
        // NO ACTIVE FILTER, deliberately. The dead and the archived are exactly who you come
        // to a map looking for, and the Graveyard is only a way back if it lists them.
        var cIdx: any[] = [];
        try { cIdx = await loadIndex(); } catch (eCI) { cIdx = []; }
    // [SEC:SCHED] BUILT BEFORE THE SET, and non-fatally: a schedule that cannot be read
    // must not cost the map its geometry. Every failure leaves the empty defaults, which
    // the Time tab renders as "nobody keeps one" rather than as a broken surface.
    var mClockT = 0; var mClockStamp = ''; var mClockBand = '';
    var mSchedRows: any[] = []; var mDated: any[] = [];
    // [SEC:TRAVEL] Declared out here with the rest of the projection so a failure inside
    // the try leaves an unpriced world rather than a broken surface -- the same reason the
    // clock and month vars are declared here and not where they are filled.
    var mTravNodes: any[] = []; var mTravTiers: any[] = [];
    var mTravResId = ''; var mTravResName = ''; var mTravHave = 0;
    // [F-2] Declared beside the rest of the projection so a failure inside the try leaves
    // every one of them at its empty default, which the Time tab renders as "no grid".
    var mSelDay = 0; var mSelT = 0; var mSelStamp = ''; var mSelIsToday = true;
    // [T-21] What the Set control would land on. See the draft vars for why the hour and
    // minute follow the clock while the day follows the selection.
    var mSetT = 0; var mSetDay = 1; var mSetMon = 0; var mSetYear = 1;
    var mSetTime = ''; var mSetMonths: any[] = [];
    var mMonthLabel = ''; var mMonthCols = 0;
    var mPrevMonthDay = 0; var mNextMonthDay = 0;
    var mMonthCells: any[] = []; var mElsewhere: any[] = []; var mMonthDayNames: string[] = [];
    try {
        var mCfg = await loadConfig();
        var mCal = ceCalendar(mCfg);

        // [SEC:TRAVEL] THE PRICING PROJECTION. Its own try: a travel price must not be able
        // to cost the map its clock, and vice versa.
        //
        // BUILT FROM `metas`, NOT FROM `flat`, AND THAT DIVERGENCE IS DELIBERATE. `flat`
        // has already dropped every mapKind:'hidden' place, because hidden is a DRAWING
        // rule -- and a route is not a drawing. The Graveyard is hidden and is still
        // somewhere a story goes; a journey passing through a hidden container must be
        // priced for the hop it actually makes. Pricing off `flat` would silently shorten
        // any path crossing one.
        // REDUCED TO THE FIVE FIELDS ceTravelGraph READS rather than shipped whole:
        // JSXKIT-STORE-SPLIT's rule is that a projection carries what the surface draws,
        // and the surface draws a price, not an index.
        // [MAP-VEHICLE] mapKind IS THE FIFTH, and it rides here rather than being read off
        // `flat` for the same reason the whole list does: `flat` has dropped every hidden
        // place, and a ship moored inside one would then have no chain to walk.
        try {
            var mtI = 0;
            for (mtI = 0; mtI < (metas || []).length; mtI++) {
                var mtM: any = metas[mtI];
                if (!mtM || !mtM.id || mtM.type !== 'location') continue;
                mTravNodes.push({ id: String(mtM.id), name: String(mtM.name || 'Unnamed'),
                                  type: 'location',
                                  parentId: mtM.parentId ? String(mtM.parentId) : null,
                                  mapKind: mtM.mapKind,
                                  travelTier: mtM.travelTier });
            }
            mTravTiers = ceTravelTiers(mCfg);
            var mtDef = ceTravelState(mCfg);
            if (mtDef) {
                mTravResId = String(mtDef.id || '');
                mTravResName = String(mtDef.name || '');
                // WHAT THE TRAVELLER ACTUALLY HOLDS. Read here rather than in the renderer
                // for the obvious reason and one less obvious one: a def whose scope has no
                // owner refuses a ref, and "no ref" has to read as "cannot be spent" on the
                // surface rather than as a holding of zero.
                var mtRef = await ceTravelRef(mCfg, mtDef);
                if (mtRef) mTravHave = await stateRead(mtRef);
                else mTravResName = '';
            }
        } catch (eTv) { api.v1.error('[AE:map] travel projection:', eTv); }
        mClockT = await ceClockLoad();
        mClockStamp = ceClockStamp(mCal, mClockT);
        mClockBand = ceClockBand(mCal, mClockT);
        var mDay = ceClockDay(mClockT);
        // [F-2] THE DAY BEING READ, which is today unless the author has tapped a cell.
        // Everything below -- the strips, the entry list, the grid's own highlight -- is
        // resolved against THIS, not against the clock.
        mSelDay = (_ceMapSelDay >= 0) ? _ceMapSelDay : mDay;
        mSelIsToday = (mSelDay === mDay);
        // Resolution takes an arbitrary `t` already, so reading a different day is free.
        // Midday rather than midnight: a plan resolves per-day, and a stamp built at 00:00
        // would read as "the small hours" on a surface that is talking about a whole day.
        mSelT = mSelDay * CE_MINS_DAY + Math.floor(CE_MINS_DAY / 2);
        mSelStamp = ceClockStamp(mCal, mSelT);
        var mSelPhrase = ceClockDatePhrase(mCal, mSelT);
        if (mSelPhrase) mSelStamp = mSelStamp.split(' ')[0] + ', ' + mSelPhrase;

        // [T-21b] WHAT THE ROW WOULD LAND ON. Resolved here because a renderer cannot
        // await a calendar, and because the day walk (ceClockDayOf) is the same one the
        // month grid uses -- two answers to \u201cwhich absolute day is the 3rd of Harvest\u201d
        // is exactly the drift F-2 wrote its round-trip note about.
        //   UNTOUCHED FIELDS FOLLOW THE SELECTION, NOT THE CLOCK. Tapping a cell in the
        //   grid above fills this row in, so \u201cthis day, at the time it already is\u201d
        //   needs no typing at all.
        var mSelMo = ceClockMonth(mCal, mSelT);
        mSetMon = (_ceMapSetMon >= 0) ? _ceMapSetMon : (mSelMo ? mSelMo.index : 0);
        mSetYear = (_ceMapSetY >= 1) ? _ceMapSetY : (mSelMo ? mSelMo.year : 1);
        mSetDay = (_ceMapSetD >= 1) ? _ceMapSetD : (mSelMo ? (mSelMo.dayOfMonth + 1) : (mSelDay + 1));
        for (var mmi = 0; mmi < (mCal.months || []).length; mmi++) {
            mSetMonths.push({ id: String(mmi), label: String(mCal.months[mmi].name || '') });
        }
        // The time field is TEXT, so it is parsed rather than trusted. Anything
        // unreadable falls back to the clock's own time: a half-typed '1' must not
        // silently mean midnight.
        var mSetHM = _ceMapSetTime ? _ceMapSetTime.split(':') : [];
        var mSetHh = (mSetHM.length === 2) ? Math.round(Number(mSetHM[0])) : NaN;
        var mSetMm = (mSetHM.length === 2) ? Math.round(Number(mSetHM[1])) : NaN;
        if (!isFinite(mSetHh) || mSetHh < 0 || mSetHh > 23) mSetHh = ceClockHour(mClockT);
        if (!isFinite(mSetMm) || mSetMm < 0 || mSetMm > 59) mSetMm = ceClockMinute(mClockT);
        mSetTime = _cePad2(mSetHh) + ':' + _cePad2(mSetMm);
        var mSetAbs = mSelMo
            ? ceClockDayOf(mCal, mSetYear, mSetMon, mSetDay - 1)
            : Math.max(0, mSetDay - 1);
        if (mSetAbs < 0) mSetAbs = mSelDay;
        mSetT = mSetAbs * CE_MINS_DAY + mSetHh * CE_MINS_HOUR + mSetMm;

        var mDE: any[] = ((mCfg as any).datedEntries || []);
        var mByDay: any = {};
        for (var mdi = 0; mdi < mDE.length; mdi++) {
            var mde: any = mDE[mdi];
            if (!mde) continue;
            var mdeDay = Math.round(Number(mde.day) || 0);
            mByDay[String(mdeDay)] = 1;
            var mdeRow: any = { id: String(mde.id || ''), title: String(mde.title || 'Untitled'),
                                note: String(mde.note || ''), day: mdeDay,
                                today: mdeDay === mDay,
                                inDays: mdeDay - mDay };
            // THE EDITABLE LIST IS THE SELECTED DAY'S, and everything else goes to
            // `elsewhere` -- a jump list, not a second editor. Two editors for one record
            // is how a surface comes to promise one thing and write another.
            if (mdeDay === mSelDay) mDated.push(mdeRow);
            else mElsewhere.push(mdeRow);
        }
        mDated.sort(function(a: any, b: any) { return a.day - b.day; });
        // Nearest first, measured from the day being READ rather than from today: an author
        // paged forward to next month wants what is near THERE.
        mElsewhere.sort(function(a: any, b: any) {
            return Math.abs(a.day - mSelDay) - Math.abs(b.day - mSelDay);
        });
        mElsewhere = mElsewhere.slice(0, 6);

        // [F-2] THE GRID. NO WEEK MEANS NO GRID -- ceClockWeekday's -1 and ceClockMonth's
        // null are the two sentinels that decide it, and both leave mMonthCells empty so the
        // Time tab falls through to the dated list rather than drawing an invented week.
        var mAnchor = (_ceMapMonthDay >= 0) ? _ceMapMonthDay : mSelDay;
        var mMo: any = ceClockMonth(mCal, mAnchor * CE_MINS_DAY);
        mMonthCols = (mCal.dayNames || []).length;
        if (mMo && mMonthCols > 0) {
            mMonthLabel = String(mMo.name) + ' \u00b7 Year ' + String(mMo.year);
            var mFirst = ceClockMonthStart(mCal, mAnchor);
            var mLen = Math.max(1, Number((mCal.months[mMo.index] || {}).days) || 1);
            var mLead = ceClockWeekday(mCal, mFirst * CE_MINS_DAY);
            if (mLead < 0) mLead = 0;
            mMonthDayNames = (mCal.dayNames || []).slice();
            // THE TWO NAV TARGETS. Walking back through the day BEFORE this month's first
            // avoids needing the previous month's length -- so a calendar of ragged months
            // pages correctly in both directions with one rule.
            mPrevMonthDay = (mFirst <= 0) ? 0 : ceClockMonthStart(mCal, mFirst - 1);
            mNextMonthDay = mFirst + mLen;
            var mBi = 0;
            for (mBi = 0; mBi < mLead; mBi++) mMonthCells.push({ blank: true, key: mBi });
            for (mBi = 0; mBi < mLen; mBi++) {
                var mAbs = mFirst + mBi;
                mMonthCells.push({
                    day: mAbs, label: String(mBi + 1),
                    today: mAbs === mDay, selected: mAbs === mSelDay,
                    marked: !!mByDay[String(mAbs)],
                    title: ceClockStamp(mCal, mAbs * CE_MINS_DAY).split(' ')[0]
                           + ' \u00b7 ' + String(mBi + 1) + ' ' + String(mMo.name)
                });
            }
        }
        var mNames: any = {};
        var mIdx: any[] = await loadEntityIndex();
        for (var mni = 0; mni < (mIdx || []).length; mni++) {
            if (mIdx[mni]) mNames[String(mIdx[mni].id)] = String(mIdx[mni].name || 'Unnamed');
        }
        var mChars: any[] = await loadAllCharacters();
        for (var mci = 0; mci < mChars.length; mci++) {
            var mc: any = mChars[mci];
            if (!mc || !mc.id || mc.active === false) continue;
            var mSch = ceSchedOf(mc);
            if (!mSch) continue;
            // [F-2] AGAINST THE SELECTED DAY, not the clock. This is the whole payoff of
            // the grid: the strips answer "where is everyone on THAT day".
            var mRes = ceSchedResolvePlan(mSch, mCal, mSelT);
            var mSegs = mRes ? ceSchedSegments(mRes.plan) : [];
            var mOut: any[] = [];
            for (var msi = 0; msi < mSegs.length; msi++) {
                mOut.push({ from: mSegs[msi].from, to: mSegs[msi].to,
                            locationId: mSegs[msi].locationId,
                            name: mNames[String(mSegs[msi].locationId)] || '',
                            doing: mSegs[msi].doing, wrapped: !!mSegs[msi].wrapped });
            }
            mSchedRows.push({ id: String(mc.id), name: String(mc.name || 'Unnamed'),
                              enabled: !!mSch.enabled,
                              planName: mRes ? String(mRes.plan.name || '') : '',
                              present: !!mc.scenePresent, segs: mOut });
        }
    } catch (eSch) { api.v1.error('[AE:map] schedule projection:', eSch); }

        // [MISPLACED-ANCHOR] THE BLOCK ABOVE SHIPPED INSIDE ceMapBuildTree IN 3.2.2 AND THE
        // SCRIPT WOULD NOT PARSE -- "unexpected 'await' keyword" at load, so the whole engine
        // was dead, not just the Time tab. The anchor it was inserted against was genuinely
        // unique; it simply sat in a synchronous helper rather than in this async function,
        // and its variables were then read from a scope that could not see them.
        // A UNIQUE ANCHOR ASSERTION PROVES UNIQUENESS, NOT PLACEMENT. That is the whole
        // lesson and it is the same shape as the clean-tsc-diff one: the check that passed
        // was not the check that mattered. Anchor on something inside the function you mean,
        // and confirm the enclosing function by name before writing.
        var tree = ceMapBuildTree(metas);
        if (!tree) {
            ceMapPatch(function() {
                // [SPEC-CTX] THE SPECIES HALF RIDES THIS BRANCH TOO. A world with no
                // LOCATIONS still has species, and the Species tab is rendered from this
                // same store -- omitting it here would blank the tab for exactly the story
                // that has only started with its peoples.
                return { ready: true, nodes: [], camLocId: String(camLoc || ''), note: 'No locations in this world yet.',
                         occupants: {}, findables: [], hidden: [], entList: _ceEntListBuild(metas),
                         pplOn: mSpx.pplOn, bstOn: mSpx.bstOn,
                         pplExclude: mSpx.pplExclude, bstExclude: mSpx.bstExclude,
                         pplText: mSpx.pplText, bstText: mSpx.bstText };
            });
            return;
        }
        ceMapPackHierarchy(tree, CE_MAP_VB, CE_MAP_PAD);

        var flat: any[] = [];
        ceMapEachBefore(tree, function(n: any) {
            flat.push({
                id: n.id, name: n.name, icon: n.icon, mapKind: n.mapKind,
                mapColor: n.mapColor, parentId: n.parentId,
                depth: n.depth, value: n.value, childCount: (n.children || []).length,
                x: n.x, y: n.y, r: n.r,
                // [MAP-SELF] Three more numbers, not a fourth list. sr is 0 for a leaf,
                // which is the render's whole test for "does this node have a slot".
                sx: n.sx, sy: n.sy, sr: n.sr
            });
        });
        // Parents first so children paint over them.
        flat.sort(function(a: any, b: any) { return a.depth - b.depth; });

        // [MAP-FIND] THE OFF-MAP PROJECTIONS. Three lists, one pass each, all built
        // from data already in hand.
        //   occupants  -- locationId -> [{id,name}] for the readout panel.
        //   findables  -- things that are NOT locations but that a search should find, each
        //                 resolved to the nearest DRAWN location so a hit has somewhere to
        //                 centre on. Walking up beats reading parentId directly: a sword in
        //                 a chest in a room has to resolve to the room.
        //   hidden     -- locations ceMapBuildTree skipped, which is the ONLY list they
        //                 appear on. `flat` cannot carry them; they have no geometry.
        var onMap: any = {};
        var i2 = 0;
        for (i2 = 0; i2 < flat.length; i2++) { onMap[flat[i2].id] = 1; }
        var metaById: any = {};
        for (i2 = 0; i2 < (metas || []).length; i2++) {
            if (metas[i2] && metas[i2].id) metaById[String(metas[i2].id)] = metas[i2];
        }
        // Nearest ancestor that is actually drawn. Guarded against the cycles the world
        // graph permits at rest -- ceMapWouldCycle only blocks them at the picker.
        function nearestDrawn(startId: string): string {
            var cur = String(startId || '');
            var guard = 0;
            while (cur && guard++ < 1000) {
                if (onMap[cur]) return cur;
                var m: any = metaById[cur];
                if (!m) return '';
                cur = String(m.parentId || '');
            }
            return '';
        }

        var occupants: any = {};
        var findables: any[] = [];
        for (i2 = 0; i2 < (cIdx || []).length; i2++) {
            var cm: any = cIdx[i2];
            if (!cm || !cm.id) continue;
            var cLoc = String(cm.currentLocationId || '');
            if (cLoc) {
                if (!occupants[cLoc]) occupants[cLoc] = [];
                occupants[cLoc].push({ id: String(cm.id), name: String(cm.name || 'Unnamed'),
                                       active: cm.active !== false });
            }
            var cHit = cLoc ? nearestDrawn(cLoc) : '';
            if (cHit) {
                findables.push({ id: String(cm.id), name: String(cm.name || 'Unnamed'),
                                 kind: 'character', locId: cHit,
                                 locName: String((metaById[cHit] || {}).name || '') });
            }
        }
        var hidden: any[] = [];
        for (i2 = 0; i2 < (metas || []).length; i2++) {
            var em: any = metas[i2];
            if (!em || !em.id) continue;
            if (em.type === 'location') {
                if (ceMapKindOf(em.mapKind) === 'hidden') {
                    hidden.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                                  where: em.parentId ? String((metaById[String(em.parentId)] || {}).name || '') : '' });
                }
                continue;
            }
            // Character BODIES are skipped: the character index above already offers the
            // person by name, and offering the body too would list everyone twice under
            // two ids that go to the same place.
            if (em.type === 'character') continue;
            var eHit = em.parentId ? nearestDrawn(String(em.parentId)) : '';
            if (!eHit) continue;
            findables.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                             kind: String(em.type || 'thing'), locId: eHit,
                             locName: String((metaById[eHit] || {}).name || '') });
        }

        ceMapPatch(function(s: any) {
            var focus = String(s.focusId || '');
            var stillThere = false;
            for (var i = 0; i < flat.length; i++) { if (flat[i].id === focus) { stillThere = true; break; } }
            // Default focus to wherever the camera is, so opening the map lands on the
            // current scene rather than on an arbitrary root.
            if (!stillThere) {
                focus = '';
                for (var j = 0; j < flat.length; j++) { if (flat[j].id === String(camLoc || '')) { focus = flat[j].id; break; } }
                if (!focus) focus = flat[0].id;
            }
            return { ready: true, nodes: flat, camLocId: String(camLoc || ''), focusId: focus, note: '',
                     occupants: occupants, findables: findables, hidden: hidden,
                     // [TAB-ENTS] Built from the metas already in hand -- no second read.
                     entList: _ceEntListBuild(metas),
                     // [SPEC-CTX] The two entries' switches, exclusions and last-written
                     // text. See _ceMapSpeciesCtx for why the text is read and not rebuilt.
                     pplOn: mSpx.pplOn, bstOn: mSpx.bstOn,
                     pplExclude: mSpx.pplExclude, bstExclude: mSpx.bstExclude,
                     pplText: mSpx.pplText, bstText: mSpx.bstText,
                     // [SEC:SCHED] Everyone's day, resolved once here rather than per row in
                     // the renderer -- a renderer cannot await, and this needs the clock and
                     // the calendar. `segs` carries the LOCATION NAME already resolved: the
                     // Time tab has no index of its own and JSXKIT-STORE-SPLIT's rule says a
                     // projection ships what the surface draws, not the records behind it.
                     clockT: mClockT, clockStamp: mClockStamp, clockBand: mClockBand,
                     travelNodes: mTravNodes, travelTiers: mTravTiers,
                     travelMode: ceTravelMode(mCfg),
                     travelResId: mTravResId, travelResName: mTravResName,
                     travelResHave: mTravHave,
                     schedRows: mSchedRows, dated: mDated,
                     selDay: mSelDay, selStamp: mSelStamp, selIsToday: mSelIsToday,
                     setT: mSetT, setDay: mSetDay, setMon: mSetMon, setYear: mSetYear,
                     setTime: mSetTime, setMonths: mSetMonths,
                     monthLabel: mMonthLabel, monthCols: mMonthCols,
                     monthDayNames: mMonthDayNames,
                     prevMonthDay: mPrevMonthDay, nextMonthDay: mNextMonthDay,
                     monthCells: mMonthCells, elsewhere: mElsewhere };
        });
    } catch (e) {
        api.v1.error('[AE:map] publish failed:', e);
        ceMapPatch(function() { return { ready: true, nodes: [], note: 'Could not read the world.' }; });
    }
}

// -- Label rules --------------------------------------------------------------
// TWO INDEPENDENT GATES, deliberately not one k-to-depth lookup table. A table
// keyed on depth would need retuning every time a world's shape changed, and this
// project's hierarchies are explicitly variable (a story scoped to one house is
// three levels; a world is six).
//   FIT      -- is the circle currently big enough on screen to hold the text?
//               Pure ratio of two viewBox quantities, so it needs no pixel data.
//   BAND     -- is this node near the FOCUS in the tree (an ancestor, the focus
//               itself, or one of its children)? This is the user's "current and
//               adjacent levels", anchored to focus rather than to zoom, so
//               zooming to a node moves the band for free.
// A label draws only when BOTH pass.
// [MAP-VERBS] The containment path, outermost first, excluding the node itself and
// the synthetic root. '' when the node sits at the top of the world.
function _ceMapWhere(nodes: any[], node: any): string {
    var byId: any = {}, i: number;
    for (i = 0; i < nodes.length; i++) byId[nodes[i].id] = nodes[i];
    var chain: string[] = [];
    var cur = (node && node.parentId) ? byId[node.parentId] : null;
    var guard = 0;
    while (cur && guard++ < 1000) {
        if (cur.id !== CE_MAP_ROOT_ID) chain.unshift(String(cur.name || ''));
        cur = cur.parentId ? byId[cur.parentId] : null;
    }
    if (!chain.length) return '';
    // Deepest container first reads better in a one-line readout than outermost first:
    // "in the Cellar, under Ashfell Keep" is how someone would say it out loud.
    chain.reverse();
    return 'in ' + chain.join(', under ');
}

// [MAP-KIND] ─────────────────────────────────────────────────────────────────────
// THE ROLES, AND THE REGISTER OF WHICH ONES DO MORE THAN PAINT. Everything about how a
// place is drawn hangs off this table, so adding another is an entry here plus a branch in
// the render loop's kind block -- not a hunt through it.
//
// MOST OF THESE ARE PAINT. 'hidden', 'interior' and 'vehicle' are not, and each says so in
// its own entry below. If a value ever gains a rule, the rule is written AT THE ENTRY: a reader
// asking "what does this kind actually do" must not have to grep for the answer.
//
//   region     A circle. The default, and what every place created before this patch is,
//              because 'region' is what the old unconditional circle already was -- an
//              existing world redraws identically.
//   structure  A building. NO RING UNLESS IT IS THE FOCUS: from a hilltop you see a town,
//              not the floor plan of its inn. A structure at rest is its icon and its name,
//              drawn large. Focus it and it becomes an ordinary place -- ring, normal icon,
//              top-anchored name -- because that is the moment its inside starts to matter.
//   interior   A room. Drawn only while the focus is inside its container. Rooms are always
//              PACKED (geometry stays stable, so nothing shifts when one appears) and
//              merely not painted.
//              NOT PAINT: a hop PRICED AT an interior costs nothing -- see ceTravelHopFree.
//              Moving between rooms is not travel.
//   vehicle    A structure that moves. Drawn exactly as a structure -- same `bare` test,
//              same icon sizing, no second branch anywhere in the render loop -- and the
//              whole of its difference lives on the Map's action bar and in [SEC:TRAVEL].
//
// KIND CHANGES PAINT AND NEVER GEOMETRY. earlier drew squares for the latter two
// and that is reverted: the packer reserves circles, so a square inside one is a second
// geometry whose containment and overlap must be reconciled with the first, and they
// disagree at the corners. Anything added to this table gets a different ring, fill, icon
// size or visibility rule -- not a different outline.
var CE_MAP_KINDS: any[] = [
    { id: 'region',    label: 'Region',    hint: 'The default. Always drawn, with a ring around it \u2014 land, water, a district, anything you look at from outside and keep looking into.' },
    { id: 'structure', label: 'Structure', hint: 'A building. Just its icon, drawn large, with no ring \u2014 until you focus it, when it becomes an ordinary place and its rooms appear.' },
    { id: 'interior',  label: 'Interior',  hint: 'A room. Hidden until you are looking inside the place that holds it \u2014 and free to walk into or out of, since moving between rooms is not travel.' },
    // [earlier MAP-HIDDEN, per user: "purely functional, so I don't want it clogging up the
    // map"] OFF THE MAP ENTIRELY -- not drawn, and not PACKED either, which is the half
    // that matters. A functional place given a real circle does not merely take up room;
    // ceMapSumValues makes a parent's size the sum of its children, so a Graveyard sitting
    // at the top of the world would pull the whole layout toward itself for as long as it
    // existed. Skipping it in ceMapBuildTree removes it from the geometry, not just the
    // paint.
    //
    // A FOURTH KIND RATHER THAN A NEW BOOLEAN, and this is the load-bearing choice.
    // ceMapKindOf already normalises anything it does not recognise to 'region', so every
    // record ever written reads as 'region' whether or not it carries the field -- which
    // means widening the ALLOWED SET needs no migration and no backfill. A `mapHidden`
    // boolean on EntityRecord would have needed a migrateEntity line, and forgetting one is
    // precisely the KIND-BACKFILL bug class. Same field, same normaliser, no new shape.
    //
    // GENERAL, NOT A GRAVEYARD SPECIAL CASE. Anything the author wants to exist without
    // drawing -- a Backstage, a Limbo, an offstage holding room -- is this, and the Map's
    // "Hidden places" door reaches all of them rather than one hardcoded id.
    { id: 'hidden',    label: 'Hidden',    hint: 'Not on the map at all, and not counted in any parent\u2019s size. For functional places \u2014 a graveyard, a holding room \u2014 reached through the map\u2019s Hidden places button instead.' },
    // [MAP-VEHICLE] THE ONE KIND THAT MOVES, and the second one in this table that is not
    // purely paint. It draws as a structure and shares that branch rather than adding one:
    // a ship at anchor IS a building you walk into, and the day it stops being one is the
    // day it is under way, which is a thing the author does on the action bar rather than
    // a thing the map paints differently.
    //
    // WHAT IT ACTUALLY GATES, stated here because [MAP-KIND]'s register says a kind with a
    // rule declares the rule at its entry: when the camera is anywhere inside a vehicle,
    // the Map offers to move the HULL to the selected place instead of moving the camera.
    // Nothing else in the file reads this value. It is not a travel tier, it is not a
    // containment rule, and it does not change what a route costs -- only which end of the
    // journey is the thing that travels.
    //
    // ITS CONTENTS COME ALONG BECAUSE CONTAINMENT IS parentId AND NOTHING ELSE. The hull's
    // parentId changes and every cabin, crate and body under it is still under it. There is
    // no manifest to keep, no cargo list to walk, and adding one would be a second source
    // of truth about where things are.
    { id: 'vehicle',   label: 'Vehicle',   hint: 'A structure that travels. Drawn like a building, but while the scene is aboard it the map offers to move the whole place \u2014 and everything inside it \u2014 to somewhere else.' }
];

function ceMapKindOf(v: any): string {
    var s = String(v || 'region');
    return (s === 'structure' || s === 'interior' || s === 'hidden' || s === 'vehicle') ? s : 'region';
}

// _ceMapSquare WAS HERE AND IS DELETED. It returned a square inscribed in a
// node's reserved circle, for the structure/interior shapes earlier drew. Removed on the
// user's call, and the reasoning is worth keeping because it applies to anything else
// tempted to draw a second shape here: the packer reserves CIRCLES, so a square inside one
// is a second geometry whose containment and overlap have to be checked against the first,
// and the two disagree at the corners. Kind changes paint only. One shape, one set of
// maths, one unit-test suite.

function ceMapBandFor(nodes: any[], focusId: string): any {
    var byId: any = {}, i: number;
    for (i = 0; i < nodes.length; i++) byId[nodes[i].id] = nodes[i];
    var band: any = {};
    var f = byId[focusId];
    if (!f) return band;
    band[f.id] = 'focus';
    var cur = f.parentId ? byId[f.parentId] : null;
    var guard = 0;
    while (cur && guard++ < 100000) {
        band[cur.id] = 'ancestor';
        cur = cur.parentId ? byId[cur.parentId] : null;
    }
    for (i = 0; i < nodes.length; i++) {
        if (nodes[i].parentId === focusId) band[nodes[i].id] = 'child';
    }
    // [MAP-OUTLINE, per user: "when the view is at the world level, the top level locations
    // should have their names displayed"] THE COARSEST TIER IS ALWAYS NAMED. The four bands
    // above are all relative to the focus, so drilling into one country left every OTHER
    // country unlabelled -- they are neither the focus, nor an ancestor of it, nor a child of
    // it. Zooming out then showed a world of anonymous circles, which is the report.
    // A FIFTH VALUE RATHER THAN MARKING THEM 'ancestor'. The band is read for three separate
    // things -- whether to label at all, how dim, and whether this node's CHILDREN are
    // labelled -- and only the first two are true here. Calling an unrelated top-level place
    // an ancestor would tell the render its rooms are on screen, and its name would go into
    // its self slot beside children nobody can read.
    // DEPTH 1 IS THE TEST, and depth 0 needs no clause: a single real root is an ancestor of
    // anything focused inside it and is already banded, and a synthetic 'World' container is
    // the frame rather than a place.
    for (i = 0; i < nodes.length; i++) {
        if (Number(nodes[i].depth) === 1 && !band[nodes[i].id]) band[nodes[i].id] = 'outline';
    }
    return band;
}

// [earlier MAP-LEGIBILITY, per user: "phrases can wrap but words should not be cut off and
// can be allowed to cross border"] GREEDY WORD WRAP, AND A WORD IS NEVER BROKEN.
//
// The rule this replaces truncated to one line with an ellipsis, so "The Drowned Chapel"
// read as "The Drowne\u2026" -- which is worse than useless on a map, because the two places
// whose names share a prefix become indistinguishable at exactly the zoom where you are
// trying to tell them apart.
//
// A WORD LONGER THAN THE LINE IS LEFT WHOLE AND ALLOWED TO OVERFLOW THE CIRCLE. That is
// deliberate and it is the user's call: an overflowing name is still readable and still
// unambiguous, whereas a broken one is neither. Overlap between NEIGHBOURS is the thing
// worth avoiding, and that is what the padding bump above addresses -- not this.
//
// Capped at CE_MAP_LINES. Past that the name is genuinely too long for the circle at this
// zoom and the honest signal is an ellipsis on its own, appended to the last kept line
// rather than cut into it.
var CE_MAP_LINES = 3;

function ceMapWrapLabel(name: string, chars: number): string[] {
    var words = String(name || '').split(/\s+/);
    var lines: string[] = [];
    var cur = '';
    var w = 0;
    for (w = 0; w < words.length; w++) {
        var word = words[w];
        if (!word) continue;
        if (!cur) { cur = word; continue; }
        if ((cur.length + 1 + word.length) <= chars) { cur = cur + ' ' + word; continue; }
        lines.push(cur);
        cur = word;
        if (lines.length >= CE_MAP_LINES) break;
    }
    if (cur && lines.length < CE_MAP_LINES) lines.push(cur);
    // Truncated: say so at the end of the last line we kept. Never inside a word.
    if (lines.length === CE_MAP_LINES) {
        var kept = 0;
        for (w = 0; w < lines.length; w++) kept += lines[w].split(' ').length;
        var totalWords = 0;
        for (w = 0; w < words.length; w++) { if (words[w]) totalWords++; }
        if (kept < totalWords) lines[CE_MAP_LINES - 1] = lines[CE_MAP_LINES - 1] + '\u2026';
    }
    return lines;
}

// How many characters fit across this circle at the current zoom, or 0 for none.
function ceMapFitChars(r: number, k: number): number {
    var apparentDiameter = 2 * r * k;
    var glyph = CE_MAP_FONT_VB * CE_MAP_CHAR_W;
    if (glyph <= 0) return 0;
    return Math.floor((apparentDiameter * 0.86) / glyph);
}

// [ZOOM-ANCHOR, per user "pinch always zooms to the top-left corner"] Cause: changing
// camera.k while holding camera.x/y fixed pins whatever point is CURRENTLY at local (0,0)
// -- which, at the default camera {x:0,y:0}, is the viewBox's own top-left corner. This
// is not a pinch-specific bug; the +/- buttons had it too (same fix applied there).
// THE FULLY-CORRECT FIX -- keep the exact point under the pinching fingers fixed on
// screen -- IS NOT ACHIEVABLE HERE, for the same reason CE_MAP_FONT_VB and CE_MAP_VB_PER_PX
// are approximations: it requires knowing where the SVG's rendered box sits on the actual
// page (an absolute offset), which needs getBoundingClientRect, which does not exist in
// this environment (JSX-PROBE-RESULTS (4), no ownerDocument). The math was worked through
// by hand: an anchor derived from an arbitrary CLIENT coordinate needs that unknown offset
// and it does NOT cancel out algebraically once k actually changes (it only cancels for a
// pure pan, k constant, which is exactly why the panning fix above needed no such offset).
// THE ACHIEVABLE, EXACT SUBSTITUTE: anchor to the viewBox's OWN center (CE_MAP_VB/2), which
// needs no unknown offset at all -- it is a constant BY DEFINITION of viewBox +
// preserveAspectRatio:'xMidYMid', regardless of container size or position on the page.
// This is not a hack standing in for the real fix; it is the same policy zoomTo() and the
// tap-a-circle interaction already use (center the thing you're focusing on), applied
// consistently to pinch and the +/- buttons instead of leaving them as the one place that
// still zoomed around an arbitrary, uncontrolled point.
function ceMapZoomAroundCenter(camera: any, newK: number): any {
    var c = CE_MAP_VB / 2;
    var oldK = camera.k || 1;
    return {
        x: c - newK * (c - camera.x) / oldK,
        y: c - newK * (c - camera.y) / oldK,
        k: newK
    };
}

// -- The surface --------------------------------------------------------------
function _ceMapRoot(): any {
    ceMapStoreInit();
    ceHexStoreInit();
    var st = useStoreValue(ceMapStore);
    // [TAB-REPAINT] SUBSCRIBED TO ceUiStore ONLY SO THE TAB ROW WORKS, and without it the
    // Time tab was unreachable: ceTabSet writes ceUiStore, ceTabGet reads it with a PLAIN
    // STORE GET (not a subscription), and this component was subscribed to ceMapStore alone
    // -- so tapping a tab changed the stored value and repainted nothing at all.
    // _ceSettingsRoot gets this for free because it already reads `ui` for its open-map;
    // Map has never needed ceUiStore before, so the dependency is new and explicit.
    // ABOVE BOTH EARLY RETURNS, per the rule the next line's own comment states.
    // [SPEC-CTX] AND NOW FOR ITS `open` MAP TOO, which is the second reader this
    // subscription has ever had: the Species tab's preview is an accordion, and every
    // accordion in the shell keeps its open state here.
    var mapUi: any = useStoreValue(ceUiStore);
    // [HEX-WRONGSTORE] THE HEX TAB NEEDS ITS OWN STORE VALUE, and it has to be read HERE.
    // Reported live as "the selector and button do not work, they flicker to the other
    // state and flicker back", WITH NOTHING IN THE CONSOLE -- because nothing threw. The
    // tab was handed `st`, which is ceMapStore, so every field it reads (exists, radius,
    // tier, brushLoc) was undefined and it rendered its create-a-map branch forever; and
    // ceHexPatch writes ceHexStore, which NO COMPONENT WAS SUBSCRIBED TO, so a committed
    // change repainted nothing. The flicker was the native <select> showing the choice for
    // one frame before the next ceMapStore render reset it.
    //
    // A SIBLING OF STORE-BEFORE-HOOK WITH THE SAME SIGNATURE -- a live surface with no
    // console line -- and worth naming separately: that one is a store whose shape is
    // incomplete, this one is a complete store nobody is listening to. A seeded initial
    // shape cannot catch it, because the shape was never the problem.
    //
    // UNCONDITIONAL AND ABOVE EVERY EARLY RETURN, for the reason the ref block below
    // states: a hook skipped on any render is a shifted sequence, not a saved hook. It is
    // read on every Map render, including the four tabs that never look at it, which is
    // the same bargain mapUi already makes one line up.
    var hexSt: any = useStoreValue(ceHexStore);
    // [MAP-FIND] Above BOTH early returns below -- the loading branch and the
    // no-locations branch -- for the reason ceSceneRoot's own note gives: a hook skipped on
    // any render is a shifted sequence, not a saved hook.
    var qS: any = useState(''); var q = String(qS[0] || ''); var setQ = qS[1];
    // [TAB-ENTS] A SECOND, SEPARATE DRAFT. The two searches have different scopes and
    // different ceField keys, so one shared value would leave a query showing in one box
    // and filtering the other. Unconditional, above every early return, for the reason the
    // line above states.
    var eqS: any = useState(''); var eq = String(eqS[0] || ''); var setEq = eqS[1];
    // [F-32] A THIRD, for the reason TAB-ENTS states directly above rather than in spite of
    // it: the Species tab is a third scope with a third ceField key, so reusing the Entities
    // draft would leave a query visible in one box and filtering the other. Unconditional
    // and above every early return, same as the two above -- a hook skipped on any render is
    // a shifted sequence, not a saved hook.
    var sqS: any = useState(''); var sq = String(sqS[0] || ''); var setSq = sqS[1];
    var panRef = useRef(null as any);
    var pinchRef = useRef(null as any);
    if (!panRef.current) panRef.current = { activeId: null, lastX: 0, lastY: 0 };
    if (!pinchRef.current) pinchRef.current = { ids: [], lastDist: 0 };

    // [HEXMAP] BOTH PUBLISH ON MOUNT, unconditionally and in one effect. Publishing
    // the hex projection only when its tab is active would make the hook conditional --
    // the same shifted-sequence fault the ref-lending comment below guards against --
    // and the read is one loadEntityIndex either way.
    useEffect(function() { cePublishMap(); cePublishHex(); }, []);

    // ceNav('scene') was ALWAYS the right call -- the bug was that this surface
    // used to live in its own separate modal (see ceRoot's 'map' branch), where nothing
    // was subscribed to the store value this patches. Now that Map is a route in the same
    // shell as Scene/Profile/Journal, this works exactly like Journal's identical back
    // button (line ~26403). No entityId is passed, and none is needed: Scene independently
    // re-derives its OWN location from loadProtagonistLocation() on every fresh mount
    // (ceSceneRoot's useEffect, empty deps -- "fires once per mount," and navigating away
    // then back is a fresh mount), so this lands on whichever location is actually the
    // scene/camera location, never on whatever the Map happened to have selected.
    // [NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    // [SEC:SCHED] MAP GROWS TABS. World is the canvas; Time is the clock, everyone's day and
    // what is on the calendar. A TAB AND NOT A ROUTE (D-49: it renders here, so it is a tab
    // and not a launcher), which also keeps the shell nav from growing an eighth cell -- the
    // bill H-04 has already been paid once.
    // [TAB-ENTS] MOVED ABOVE THE NO-LOCATIONS RETURN, and that return is why. It lands on
    // an empty `nodes` -- which is a fact about the CANVAS -- and it was swallowing the tab
    // strip with it, so in a world of threads and items with nowhere drawn yet the Time tab
    // was unreachable and the Entities tab would have been born unreachable. The two
    // non-canvas tabs read `st` and nothing else, so they belong above a canvas check.
    // STILL BELOW THE READY GATE: a tab body reading an unpublished store is the blank
    // surface with no console line that STORE-BEFORE-HOOK names.
    var mapTab = ceTabGet('map', 'world');
    // [F-32] Resolved through a lookup rather than a ternary chain -- three non-default
    // values is where the chain stops being readable, and an unrecognised stored value must
    // still fall to 'world' rather than rendering nothing.
    var mapResolved = 'world';
    if (mapTab === 'time' || mapTab === 'list' || mapTab === 'species' || mapTab === 'hex') { mapResolved = mapTab; }
    if (mapResolved !== 'world') {
        // [TABBODY-KEY] Same slot, same fix as Settings and Images -- the bodies are
        // entirely different subtrees at one tree position.
        var mapBody: any = null;
        if (mapResolved === 'time') { mapBody = _ceMapTimeTab(st); }
        else if (mapResolved === 'species') { mapBody = _ceMapSpeciesTab(st, sq, setSq, (mapUi && mapUi.open) || {}); }
        // [HEXMAP] THE REFS ARE PASSED IN, NOT DECLARED THERE. _ceMapHexTab is a plain
        // call inside a branch, so a useRef in its body would be a CONDITIONAL HOOK in
        // _ceMapRoot -- a shifted sequence, not a saved hook. The two refs this surface
        // needs are already declared unconditionally at the top of _ceMapRoot for the
        // circle map, and only one tab renders at a time, so they are lent rather than
        // duplicated.
        else if (mapResolved === 'hex') { mapBody = _ceMapHexTab(hexSt, panRef, pinchRef); }
        else { mapBody = _ceMapEntsTab(st, eq, setEq); }
        return ceScreen(ceHeader(back), [
            _ceMapTabRow(mapResolved),
            ceWrap({ key: 'maptab:' + mapResolved }, [ mapBody ])
        ]);
    }

    if (!st.nodes || !st.nodes.length) {
        // [earlier MAP-EMPTY-DOOR, per user "when starting a new story with no location,
        // the map tab is blank and provides no ability to create an initial one"] THE
        // "New place" BUTTON EXISTS -- it is in the toolbar strip below the canvas -- and
        // this early return lands ABOVE it, so on the one world where a location is most
        // needed the only door was unreachable. This is the same ceEntityCreate call the
        // toolbar makes, with an empty parent: nothing is selected because nothing exists,
        // so the first place is created at the top of the world.
        // [TAB-ENTS] THE STRIP RIDES THIS RETURN TOO. Moving the tab branches above this
        // check is only half the fix: an empty state that renders without the strip is a
        // screen you cannot leave by tab, on exactly the world where the other two tabs are
        // the only ones with anything in them.
        return ceScreen(ceHeader(back), [
            _ceMapTabRow('world'),
            ceEmpty(st.note || 'No locations in this world yet.',
                ceBtn('Create the first place', 'map:new0', function() {
                    return ceEntityCreate('location', '', { surface: 'map', entityId: '', label: 'World' });
                }, 'primary'))
        ]);
    }

    var cam = st.camera || { x: 0, y: 0, k: 1 };
    var nodes: any[] = st.nodes;
    // Typed local, same reason `nodes` already is one: `st` comes off useStoreValue on a
    // store variable typed `any`, and TS's generic inference on an `any` argument yields
    // `unknown` rather than `any` at the property-read site (measured -- see
    // STORE-BEFORE-HOOK's sibling entries). Reading st.camLocId three separate times below
    // would repeat that against every one; one typed extraction fixes all three.
    var camLocId: string = String(st.camLocId || '');
    var band = ceMapBandFor(nodes, String(st.focusId || ''));

    function onDown(e: any) {
        var id = e.pointerId;
        ceMapPatch(function(s: any) {
            var nextDown: any = {}, k: string;
            for (k in (s.down || {})) nextDown[k] = s.down[k];
            nextDown[id] = { x: e.clientX, y: e.clientY };
            var ids: string[] = [];
            for (k in nextDown) ids.push(k);
            if (ids.length === 1) {
                panRef.current = { activeId: id, lastX: e.clientX, lastY: e.clientY };
            } else if (ids.length === 2) {
                var a = nextDown[ids[0]], b = nextDown[ids[1]];
                pinchRef.current = { ids: [ids[0], ids[1]],
                    lastDist: Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2)) };
            }
            return { down: nextDown };
        });
    }

    function onMove(e: any) {
        var id = e.pointerId;
        ceMapPatch(function(s: any) {
            var down = s.down || {};
            if (!(String(id) in down)) return {};
            var ids: string[] = [], k: string;
            for (k in down) ids.push(k);
            var nextCam = s.camera;
            if (ids.length >= 2 && pinchRef.current.ids.length === 2) {
                var idA = pinchRef.current.ids[0], idB = pinchRef.current.ids[1];
                var a = (String(id) === String(idA)) ? { x: e.clientX, y: e.clientY } : down[idA];
                var b = (String(id) === String(idB)) ? { x: e.clientX, y: e.clientY } : down[idB];
                if (a && b) {
                    var dist = Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
                    if (pinchRef.current.lastDist > 0) {
                        var f = dist / pinchRef.current.lastDist;
                        var newK = Math.max(0.4, Math.min(40, s.camera.k * f));
                        nextCam = ceMapZoomAroundCenter(s.camera, newK);
                    }
                    pinchRef.current.lastDist = dist;
                }
            } else if (String(panRef.current.activeId) === String(id)) {
                var dx = (e.clientX - panRef.current.lastX) * CE_MAP_VB_PER_PX;
                var dy = (e.clientY - panRef.current.lastY) * CE_MAP_VB_PER_PX;
                nextCam = { x: s.camera.x + dx, y: s.camera.y + dy, k: s.camera.k };
                panRef.current.lastX = e.clientX; panRef.current.lastY = e.clientY;
            }
            var nextDown: any = {};
            for (k in down) nextDown[k] = down[k];
            nextDown[id] = { x: e.clientX, y: e.clientY };
            return { camera: nextCam, down: nextDown };
        });
    }

    // [measured] onPointerLeave fires ~4x as often as a real interaction (127 vs 35),
    // including plain mouse-outs with nothing held. Writing state on each one is a
    // full re-render of every circle. The id is checked against the LIVE snapshot
    // inside the patch, never the outer render-time `st` -- that would be a stale
    // read of the very map being mutated.
    function clearPointer(id: any) {
        if (String(panRef.current.activeId) === String(id)) panRef.current = { activeId: null, lastX: 0, lastY: 0 };
        pinchRef.current = { ids: [], lastDist: 0 };
        ceMapPatch(function(s: any) {
            var down = s.down || {};
            if (!(String(id) in down)) return {};
            var nextDown: any = {}, k: string;
            for (k in down) { if (k !== String(id)) nextDown[k] = down[k]; }
            return { down: nextDown };
        });
    }

    function zoomTo(node: any) {
        // Frame the node at ~78% of the viewport, then centre it.
        var k = Math.max(0.4, Math.min(40, (CE_MAP_VB * 0.78) / (node.r * 2)));
        ceMapPatch(function() {
            return { camera: { x: CE_MAP_VB / 2 - node.x * k, y: CE_MAP_VB / 2 - node.y * k, k: k },
                     focusId: node.id, selectedId: node.id };
        });
    }

    // [earlier, per user: "need to make sure text is always on top and legible over svgs
    // they may overlap"] THREE LAYERS, PAINTED IN THIS ORDER. Two was not enough: icons
    // used to share the label array, so ordering was per-NODE rather than per-KIND and a
    // child's icon -- pushed later, because children come after parents -- painted over the
    // parent's name. SVG has no z-index; paint order is the only lever, so the layers have
    // to be separate arrays rather than separate intentions.
    var circles: any[] = [];
    var icons: any[] = [];
    var labels: any[] = [];
    var i: number;
    for (i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var isRoot = (n.id === CE_MAP_ROOT_ID);
        var isLeaf = n.childCount === 0;
        var isCam = (n.id === camLocId);
        var isSel = (n.id === st.selectedId);
        var inBand = !!band[n.id];

        // [MAP-KIND] ── visibility, then shape, then label ──
        var kind = ceMapKindOf(n.mapKind);
        var isFocus = (n.id === st.focusId);

        // [earlier, per user: "interiors are disappearing on the map visually when in
        // focus"] THE OLD RULE ASKED ABOUT THE ROOM AND SHOULD HAVE ASKED ABOUT THE
        // BUILDING. It was `parentId === focusId`, which is true for a room whose structure
        // you are looking at and FALSE for the room you have walked into -- so focusing a
        // room made it vanish, taking its own label and hit target with it. It was also
        // false for every sibling room, so stepping between two rooms in one building
        // emptied the building.
        //
        // The right question is whether the FOCUS IS INSIDE THIS ROOM'S CONTAINER. The band
        // already answers it: ceMapBandFor marks the focus and every ancestor of it, so a
        // room is drawn exactly when its parent is one of those. That single test covers
        // all four cases at once -- parent focused, this room focused, a sibling focused,
        // and something deeper inside this room focused -- because in every one of them the
        // parent is on the focus chain.
        if (kind === 'interior') {
            var pBand = String(band[String(n.parentId || '')] || '');
            if (pBand !== 'focus' && pBand !== 'ancestor') continue;
        }

        // [earlier, per user: "I don't like the squares... I don't want to combine square
        // graphing math within circle graphing"] SQUARES ARE GONE, AND _ceMapSquare WITH
        // THEM. Everything is a circle again. The objection was the right one: the packer
        // reserves a circle, so a square drawn inside it is a second shape whose containment
        // and overlap have to be reasoned about against the first, and the two answers do
        // not agree at the corners. Kind now changes only PAINT -- whether there is a ring
        // and how big the icon is -- and never geometry, so there is exactly one set of
        // maths on this surface.
        //
        // A structure at rest has no ring. It still has to be tappable, so it is drawn in
        // fully transparent paint rather than fill:'none' -- 'none' is not painted and
        // therefore not hit-tested, which would make every building unselectable.
        //
        // [earlier, per user: "when in focus, structures no longer need to be centered and
        // scaled up, they should display like default in focus"] `bare` is the ONLY thing
        // that separates a structure from a region now, and it turns off the moment the
        // structure is focused or selected. A focused building is just a place.
        // [MAP-VEHICLE] A VEHICLE TAKES THIS BRANCH RATHER THAN GETTING ITS OWN. The two
        // kinds are the same drawing instruction and the difference between them is a verb
        // on the action bar, not a paint. A second branch here would be a second thing to
        // keep in step with the first for no visible gain.
        var bare = ((kind === 'structure' || kind === 'vehicle') && !isFocus && !isSel);

        // [THEME-VAR] The map's four paints, named so a theme can drive them: the ring a
        // place is drawn with, the ring the SELECTED or CAMERA place is drawn with, and the
        // two fills that separate a leaf from a branch. Defaults are the literals that were
        // here. `bare` stays fully transparent rather than themed -- it is a hit target, not
        // a paint, and a theme colouring it would make every structure a visible disc.
        var shFill = bare ? 'rgba(0,0,0,0)'
            : (isCam ? ceVar('map-fill-camera', 'rgba(232,192,125,0.14)')
                     : (isLeaf ? ceVar('map-fill-leaf', 'rgba(255,255,255,0.05)')
                               : ceVar('map-fill-branch', 'rgba(255,255,255,0.02)')));
        // [HEX-LOCCOLOR] AN AUTHORED COLOUR PAINTS THE RING, and it loses to selection and to
        // the camera rather than winning over them: those two say WHERE YOU ARE and what you
        // are acting on, and a place whose author picked amber must not become unfindable by
        // being amber already. It is not derived here -- see the projection's note.
        var shOwn = ceColorNorm(n.mapColor);
        var shStroke = (isSel || isCam)
            ? ceVar('map-line-select', CE_SEM.building)
            : (shOwn || ceVar('map-line', 'currentColor'));
        var shWidth = bare ? 0 : (isSel ? 3 : (isCam ? 2.5 : 1.2)) / cam.k;
        var shOpacity = bare ? '0' : (isSel || isCam ? '1' : (inBand ? '0.55' : '0.22'));

        circles.push(h('circle', {
            key: 'mc_' + n.id,
            cx: n.x, cy: n.y, r: n.r,
            fill: shFill, stroke: shStroke,
            'stroke-width': shWidth, 'stroke-opacity': shOpacity,
            style: { cursor: isRoot ? 'default' : 'pointer' },
            onClick: isRoot ? null : (function(nn: any) {
                return function() { ceMapPatch(function() { return { selectedId: nn.id, focusId: nn.id }; }); };
            })(n)
        }));

        if (!inBand) continue;

        var bandKind = String(band[n.id] || '');
        // Which nodes have LABELLED children falls out of the band: labels are drawn for the
        // focus, its ancestors, its direct children and the outline tier, so a node's own
        // children are named exactly when that node is the focus or an ancestor of it.
        var hasLabelledKids = !isLeaf && (bandKind === 'focus' || bandKind === 'ancestor');

        // [MAP-SELF] THE NODE'S OWN SPACE, AND ONLY WHERE ITS CHILDREN ARE ON SCREEN, per
        // user: "the map change should only be when the region is in focus. If it isn't, the
        // location should still dominate its own circle." The slot exists to keep a name off
        // the things drawn inside the circle; where nothing legible is drawn inside it there
        // is nothing to keep off, and retreating into a small inner circle would give up the
        // circle the place owns. So a place you are looking INTO steps aside for its rooms,
        // and a place you are looking AT fills itself.
        // THE GEOMETRY IS RESERVED EITHER WAY. The slot is packed for every node with
        // children whether or not it is painted in -- the same rule interiors are packed
        // under -- so focus changes what is drawn and never where anything sits. A layout
        // that reflowed on focus would move every circle under the author's finger.
        // A BARE STRUCTURE IS ALREADY EXCLUDED BY hasLabelledKids, since its rooms are not
        // drawn, so `bare` needs no clause of its own here.
        var useSelf = hasLabelledKids && Number(n.sr) > 0;
        var boxR = useSelf ? Number(n.sr) : n.r;
        var boxX = useSelf ? Number(n.sx) : n.x;
        var boxY = useSelf ? Number(n.sy) : n.y;

        var chars = ceMapFitChars(boxR, cam.k);
        // Floor lowered from 3 to 2 now that wrapping exists: at 2 a two-word name simply
        // takes two lines instead of vanishing, which is more useful than an empty circle.
        if (chars < 2) continue;

        var fs = CE_MAP_FONT_VB / cam.k;
        var lineH = fs * 1.12;
        var lines = ceMapWrapLabel(n.name, chars);
        if (!lines.length) continue;

        // [MAP-SELF] THE TOP-EDGE RULE IS RETIRED. A name sat at the circle's top edge only to
        // stay off the children drawn inside it; where those children are drawn the slot is
        // that clearance now, and where they are not the name centres in the circle as it
        // always did. bandKind and hasLabelledKids are computed further up, where the box is
        // chosen, because choosing the box is the first thing that needs them.

        // The icon is its own element now, centred directly above the name,
        // rather than a prefix glued onto the first line. As a prefix it shifted the name
        // off-centre by half a glyph, it counted against the character budget so an
        // icon cost the name two or three letters, and it could be the thing an ellipsis
        // truncated.
        //
        // [MAP-KIND] SIZED OFF THE CIRCLE, NOT
        // OFF THE LABEL. Tying it to font size was the mistake: the label counter-scales
        // with zoom so it stays ~constant on screen, which meant the icon stayed a marker
        // no matter how much room the place actually had. Sized off n.r it grows with the
        // circle, so a detailed imported icon has somewhere to be detailed.
        //
        // A BARE STRUCTURE GETS MOST OF ITS CIRCLE, because for a building at rest the icon
        // is the ONLY thing drawn -- there is no ring, so anything smaller reads as a speck
        // in empty space. The test is `bare`, not `kind === 'structure'`: a
        // focused building is drawn as an ordinary place, and an ordinary place's icon is a
        // marker above its name rather than the place itself.
        // Floored at the old label-relative size so a small circle keeps its icon at all.
        var iconSize = 0;
        if (n.icon) {
            var iconWant = bare ? (boxR * 1.30) : (boxR * 0.52);
            iconSize = Math.max(fs * 1.25, Math.min(iconWant, boxR * 1.4));
        }
        var iconGap  = n.icon ? (fs * 0.30) : 0;
        var blockH   = (n.icon ? (iconSize + iconGap) : 0) + lines.length * lineH;

        // topY is the top of the whole block (icon included), and there is ONE rule now:
        // the block is centred in its box. Which box that is was decided above -- the
        // node's own slot where it has one, its circle where it does not.
        var topY = boxY - blockH / 2;

        // [MAP-OUTLINE] The outline tier reads as CONTEXT rather than as the thing being
        // looked at, so it dims with the ancestors: it is the coarsest ring on a screen whose
        // subject is somewhere inside it.
        var dim = (bandKind === 'ancestor' || bandKind === 'outline') ? CE_OP.t3 : CE_OP.t1;

        if (n.icon) {
            // [ICON-LIB] Two kinds of icon, one slot. A library key draws
            // as vector paths and an emoji still draws as text -- the emoji path
            // is byte-for-byte what shipped in earlier, because an author who
            // typed a globe into that field years ago should see no change at
            // all. The opacity band applies to both, so a vector icon recedes on
            // an ancestor exactly as its label does.
            var iconNode = ceIconMapGroup(n.icon, boxX, topY + iconSize / 2, iconSize, 'mi_' + n.id);
            if (iconNode) {
                icons.push(h('g', { key: 'mig_' + n.id, opacity: dim }, iconNode));
            } else {
                // AN EMOJI IS DRAWN SMALLER THAN A VECTOR ICON AT THE SAME NOMINAL SIZE,
                // per author ("emojis are a little too big"). Not a fudge: a library icon is
                // a thin currentColor stroke inside its viewBox and reads as a marker, while
                // an emoji is a filled, full-bleed colour glyph that fills the same box
                // completely -- so equal font-size is not equal visual weight.
                // ONLY THIS BRANCH IS SCALED. Vector icons keep the size the circle gives
                // them, so nothing an author placed from the icon library moves.
                var emSize = iconSize * CE_MAP_EMOJI_SCALE;
                icons.push(h('text', {
                    key: 'mi_' + n.id,
                    // Centred in the box the block already reserved, rather than sitting on
                    // its old baseline: shrinking the glyph without re-centring would leave
                    // it hanging low against the name under it. 0.36 is half of a glyph's
                    // ~0.72 cap height.
                    x: boxX, y: topY + iconSize / 2 + emSize * 0.36,
                    'text-anchor': 'middle',
                    fill: 'currentColor', opacity: dim,
                    'font-size': emSize,
                    'pointer-events': 'none'
                }, n.icon));
            }
        }

        var lineTop = topY + (n.icon ? (iconSize + iconGap) : 0);
        var li = 0;
        for (li = 0; li < lines.length; li++) {
            // ONE <text> PER LINE, not one <text> with <tspan dy>. tspan/dy is the usual
            // SVG idiom and is avoided here on purpose: every y in this file is already
            // computed in viewBox units inside the camera transform, so an absolute y per
            // line is the same arithmetic the rest of the map uses, while dy would
            // introduce a second, relative coordinate convention that the zoom counter-
            // scaling would then have to be reasoned about twice.
            labels.push((function(txt: string, idx: number) {
                return h('text', {
                    key: 'ml_' + n.id + '_' + idx,
                    x: boxX, y: lineTop + idx * lineH + fs * 0.80,
                    'text-anchor': 'middle',
                    fill: 'currentColor',
                    // Ladder: an ancestor label is context for where you are, not the
                    // thing itself -- t3. The current band is the content, t1.
                    opacity: dim,
                    'font-size': fs,
                    'font-weight': hasLabelledKids ? '600' : (isLeaf ? '400' : '500'),
                    // A HALO, painted first, so a name stays readable where it
                    // crosses a detailed icon. paint-order:'stroke' is what makes this a
                    // halo rather than an outline -- without it the stroke draws ON TOP of
                    // the fill and the letters come out hollow. The stroke is the map's own
                    // background colour, so it reads as the text pushing the icon aside
                    // rather than as a second colour entering the surface.
                    stroke: ceVar('map-label-halo', CE_FILL),
                    'stroke-width': fs * 0.22,
                    'stroke-opacity': 0.85,
                    'stroke-linejoin': 'round',
                    'paint-order': 'stroke',
                    'pointer-events': 'none'
                }, txt);
            })(lines[li], li));
        }
    }

    var selected: any = null;
    for (i = 0; i < nodes.length; i++) { if (nodes[i].id === st.selectedId) { selected = nodes[i]; break; } }

    // [SEC:TRAVEL] ONE QUOTE PER RENDER, read by three things below: the button face, the
    // leg breakdown, and the holding line. Computing it here rather than inside each is
    // what stops the face and the breakdown ever disagreeing about a price.
    // SAFE IN A RENDERER BECAUSE IT TOUCHES NO STORAGE -- see the travel core's header.
    // Selection changes do NOT republish (the tap patches selectedId and nothing else), so
    // a projection could not have carried this; it has to be computed on the render side.
    // [MAP-VEHICLE] WHO IS TRAVELLING, DECIDED BEFORE THE QUOTE IS TAKEN, because the
    // answer changes which end the quote starts from. One graph build over the list the
    // pricing already uses; O(n) against a repaint that draws every circle in the world.
    var tvById: any = ceTravelGraph(st.travelNodes || []);
    var tvVehId: string = ceTravelVehicleOf(tvById, String(camLocId || ''));
    var tvVehName: string = (tvVehId && tvById[tvVehId]) ? String(tvById[tvVehId].name || '') : '';
    var tvVehAt: string = (tvVehId && tvById[tvVehId]) ? String(tvById[tvVehId].parentId || '') : '';

    // OFFERED ONLY WHERE IT WOULD MEAN SOMETHING, which is four exclusions and every one of
    // them is a place where the ORDINARY verb is the right one:
    //   the vehicle itself      -- walking up on deck
    //   anywhere inside it      -- walking to your cabin
    //   where it is already moored -- stepping ashore
    //   where the camera is     -- already handled by isHere
    // A control that appears everywhere and does nothing in most of those places teaches
    // the author to stop reading it.
    var tvCan = !!(tvVehId && selected && selected.id !== CE_MAP_ROOT_ID
                   && String(selected.id) !== String(camLocId || '')
                   && String(selected.id) !== tvVehId
                   && String(selected.id) !== tvVehAt
                   && !ceTravelInside(tvById, String(selected.id), tvVehId));
    var tvOn = tvCan && (String(st.travelVehId || '') === tvVehId);

    var tQuote: any = null;
    if (selected && selected.id !== CE_MAP_ROOT_ID && String(selected.id) !== String(camLocId || '')) {
        // [TRAVEL-MODE] THE CIRCLE MAP STOPS QUOTING when the hex map is the pricer. Per
        // user, and it is the only honest arrangement: this surface has no cells, so a
        // number here would be the tier walk's answer to a question the tiers no longer
        // decide -- two prices for one journey, which is exactly what the mode exists to
        // end. The travel VERBS stay; only the quote goes, and ceTravelGo prices them
        // correctly because it reads the map itself.
        tQuote = (String((st as any).travelMode || '') === 'hex') ? null : ceTravelQuote(st.travelTiers || [], st.travelNodes || [],
                               tvOn ? tvVehId : String(camLocId || ''), String(selected.id));
    }
    var tPriced = !!(tQuote && (tQuote.mins > 0 || tQuote.cost > 0));
    var tPhrase = tPriced ? ceTravelCostPhrase(tQuote, String(st.travelResName || '')) : '';

    var actionBar: any;
    if (selected && selected.id !== CE_MAP_ROOT_ID) {
        var isHere = (selected.id === camLocId);
        actionBar = h('div', {
            style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, flexWrap: 'wrap',
                padding: CE_T.s3 + ' 0', borderTop: '1px solid ' + CE_LINE }
        },
            ceGrow({ basis: '140px' }, [
                // [earlier READOUT-GHOST, per user: "each time another icon is left behind
                // and it creates a trail of icons behind the location name"] NO INLINE SVG
                // HERE ANY MORE.
                //
                // earlier put a ceIconSvg beside the name so a library key would not be
                // shown raw. The name is a plain text child and the icon is an <svg> with a
                // whole subtree under it, and swapping selection replaced the text while
                // leaving the previous svg mounted -- one more every time, exactly the
                // trail reported. It is the same family as HOST-ORPHAN: an abandoned
                // subtree that keeps painting because nothing tore it down.
                //
                // A keyed element would probably have fixed it, and that is precisely why
                // it is not what was done. This icon was decoration -- the map beside it is
                // already showing the icon at size, so the readout was saying the same
                // thing twice -- and a decorative element is not worth a fix that has to
                // hold against a reconciler this file has already been bitten by twice.
                // The raw-key problem it was solving is solved instead by not printing the
                // key: an svg: value contributes nothing to this line rather than leaking
                // storage format into it.
                h('div', { style: { fontSize: CE_T.fs, fontWeight: '600' } },
                    (ceIconIsSvg(selected.icon) ? '' :
                        (selected.icon ? selected.icon + ' ' : '')) + selected.name),
                // [MAP-VERBS] 'Depth 3' is graph language for a thing the user is
                // looking at as a map. What a map says instead is WHERE something is, so
                // this walks the parent chain and prints the containment path. Built from
                // `nodes`, which is already in hand and already carries parentId -- no new
                // read, and it cannot disagree with what is drawn because it is derived
                // from the same array.
                ceSub('t3',
                    (isHere ? 'The scene is here' : (_ceMapWhere(nodes, selected) || 'Top of the world')) +
                    (selected.childCount ? ' \u00b7 ' + selected.childCount + ' inside' : '')),
                // [MAP-FIND] WHO IS STANDING HERE, the same list the
                // location's own edit page already shows. It is one line rather than the
                // Entity surface's rows because this panel sits under a canvas and is a
                // readout, not a drill -- Edit is right beside it and is where the rows are.
                // ARCHIVED AND DEAD ARE MARKED, not hidden. On the Graveyard this line is
                // the entire point of the panel, and an unmarked list would read as a room
                // full of living people.
                _ceMapOccupantLine(st, selected.id)
            ]),
            // [MAP-VERBS] THREE VERBS,
            // TWO KINDS, AND THE OLD NAMES HID THE DIFFERENCE. 'Zoom to', 'Go to scene' and
            // 'Set scene location' all read as going somewhere; two of them only move the
            // CAMERA and the third moves the STORY. Renamed so the kind is audible:
            //   Centre           -- camera, onto the selected place
            //   Centre to Camera -- camera, back onto wherever the scene actually is
            //   Travel here      -- the world. This is the only one that writes anything.
            // 'Travel here' also matches what it does downstream (commitTravel), so the
            // button, the function and the toast finally say the same word.
            ceBtn('Centre', 'map:zoom:' + selected.id, function() { zoomTo(selected); return Promise.resolve(); }),
            // [JSXENTITY] The door into the entity surface, and the surface list's
            // "add/edit location button" for the Map half. The return address is set HERE
            // rather than defaulted there, which is the whole NAV-BACK contract.
            ceBtn('Edit', 'map:edit:' + selected.id, function() {
                ceNav('entity', selected.id, '', { surface: 'map', entityId: '', label: 'World' });
                return Promise.resolve();
            }),
            // [MAP-VEHICLE] THE MODE SWITCH, IMMEDIATELY LEFT OF THE TWO VERBS IT AIMS. It
            // is a switch and not a fifth button because it does not do anything -- it
            // changes what the buttons beside it MEAN, and both of them repaint the moment
            // it flips (the price on the face is recomputed from the hull instead of from
            // the camera). A button that silently re-aims another button is what this
            // avoids; a switch that sits next to them says so by where it is.
            //
            // THE LABEL IS THE VEHICLE'S NAME AND NOTHING ELSE. "Travel by the Sea Wasp"
            // beside a button reading "Travel -- 8h" is the same sentence twice; the name
            // next to a switch that is on is already the whole statement. The ARIA label
            // carries the long form, because a reader who cannot see the arrangement is
            // exactly the reader the arrangement was doing the work for.
            //
            // NO KEY, DELIBERATELY. H-01 is satisfied the other way -- the null branch holds
            // the position, so this list's LENGTH NEVER MOVES -- and every sibling in this
            // bar is unkeyed. One keyed child among unkeyed ones is the mixed-key case that
            // rule warns about, so the fix is to stay consistent, not to key one node.
            //
            // '0 0 auto' AND nowrap: SS8b's collapse class is text in a slot that can be
            // squeezed. This cell cannot shrink and the bar already wraps, so a narrow
            // viewport moves the switch to its own line rather than shredding the name into
            // a column of single letters.
            tvCan ? h('div', {
                style: { flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: CE_T.s2 }
            },
                ceToggle(tvOn, 'map:byveh:' + tvVehId, function() {
                    var tvNext = tvOn ? '' : tvVehId;
                    ceMapPatch(function() { return { travelVehId: tvNext }; });
                    return Promise.resolve();
                }, 'Travel by ' + tvVehName),
                h('div', { style: { fontSize: CE_T.fs, whiteSpace: 'nowrap' } }, tvVehName)
            ) : null,
            // [SEC:TRAVEL] TWO VERBS WHERE THERE IS A PRICE, ONE WHERE THERE IS NOT.
            // The free move is not removed and is not going to be -- every limit in this
            // system is one the author set on themselves, so the override stays a tap away
            // -- but it is RENAMED once a price exists, because "Travel here" beside
            // "Travel -- 8h, -2 Fuel" reads as two ways to do one thing rather than as a
            // move and an override. "Skip the journey" says what it actually is.
            // THE PRICE IS THE BUTTON FACE, not a confirmation step. A cost the author has
            // to open something to see is a cost they will stop reading.
            // [MAP-VEHICLE] THE OVERRIDE FOLLOWS THE MODE. With the switch on, this moves the
            // HULL for free rather than the camera for free -- an override that quietly
            // reverted to the other kind of move would be the worst button on the surface,
            // because the price is the only thing that looks different and the price is
            // exactly what an override is skipping.
            isHere ? null : ceBtn(tPriced ? 'Skip the journey' : 'Travel here', 'map:travel:' + selected.id, function() {
                if (tvOn) {
                    return ceVehicleMove(tvVehId, String(selected.id)).then(function(okV: boolean) {
                        try {
                            api.v1.ui.toast(okV
                                ? (tvVehName + ' is now at ' + selected.name + '.')
                                : (tvVehName + ' cannot be moved there.'),
                                { type: okV ? 'success' : 'error', autoClose: 1800 });
                        } catch (e) {}
                        return cePublishMap();
                    });
                }
                return commitTravel(selected.id, true).then(function() {
                    try { api.v1.ui.toast('Scene moved to ' + selected.name + '.', { type: 'success', autoClose: 1800 }); } catch (e) {}
                    return cePublishMap();
                });
            }, tPriced ? '' : 'primary'),
            // THE RECEIPT IS THE TOAST AND IT REPORTS THE MOVEMENT, NOT THE ASK. If the
            // purse came up short the toast says so and the journey still happened; see
            // ceTravelGo for why there is no gate in front of this.
            // [MAP-VEHICLE] ONE FACE FOR BOTH MODES, and the switch beside it is what says
            // which. The price on it is already mode-specific -- tQuote was taken from the
            // hull when the switch is on -- so the button is never showing a number that
            // belongs to the other kind of journey. The RECEIPT is where the vehicle is
            // named, because that is where a reader is looking for what actually happened.
            (isHere || !tPriced) ? null : ceBtn('Travel \u2014 ' + tPhrase, 'map:travelpay:' + selected.id, function() {
                if (tvOn) {
                    return ceTravelVehicleGo(tvVehId, String(selected.id)).then(function(rv: any) {
                        try {
                            var tvParts: string[] = [];
                            if (rv.mins > 0) tvParts.push(ceTravelDuration(rv.mins) + ' under way');
                            if (rv.spent > 0) tvParts.push(String(rv.spent) + ' ' + String(rv.resName || 'spent'));
                            if (rv.short > 0) tvParts.push(String(rv.short) + ' short');
                            api.v1.ui.toast(rv.moved
                                ? (String(rv.vehName || tvVehName) + ' reached ' + String(rv.name || selected.name)
                                   + (tvParts.length ? ' \u2014 ' + tvParts.join(', ') : '') + '.')
                                : (String(rv.vehName || tvVehName) + ' cannot be moved there.'),
                                { type: !rv.moved ? 'error' : ((rv.short > 0) ? 'warning' : 'success'),
                                  autoClose: 3200 });
                        } catch (e) {}
                        return cePublishMap();
                    });
                }
                return ceTravelGo(String(selected.id)).then(function(r: any) {
                    try {
                        var tParts: string[] = [];
                        if (r.mins > 0) tParts.push(ceTravelDuration(r.mins) + ' on the road');
                        if (r.spent > 0) tParts.push(String(r.spent) + ' ' + String(r.resName || 'spent'));
                        if (r.short > 0) tParts.push(String(r.short) + ' short');
                        api.v1.ui.toast('Arrived at ' + String(r.name || selected.name)
                                        + (tParts.length ? ' \u2014 ' + tParts.join(', ') : '') + '.',
                                        { type: (r.short > 0) ? 'warning' : 'success', autoClose: 3200 });
                    } catch (e) {}
                    return cePublishMap();
                });
            }, 'primary')
        );
    } else {
        actionBar = ceEmpty('Tap a place to select it.', null);
    }

    // [SEC:TRAVEL] THE LEG BREAKDOWN, AND IT IS THE POINT OF THE WHOLE FEATURE. A tiered
    // total cannot explain itself: "1d 16h 30m" over five hops is a number the author has
    // to trust, and this file does not ask anyone to trust a number it could have shown the
    // working for. The rows say which place, at which tier, for how much -- so a price that
    // looks wrong is immediately readable as a tier that is wrong, which is a thing the
    // author can go and fix.
    // IT ALSO DOES THE JOB A GATE WOULD HAVE DONE, better. The reason AE needed explicit
    // links and locks was that the shape of the world was invisible; a route printed hop by
    // hop makes it visible, and an author who can see the shape does not need to be stopped
    // by it.
    // ONLY WHEN THERE IS A PRICE. An unpriced world gets no cost furniture at all -- see
    // ceTravelCostPhrase for why "free" and "not priced yet" must not look the same.
    var travelBlock: any = null;
    if (tPriced && tQuote) {
        var legRows: any[] = [];
        var lgi = 0;
        for (lgi = 0; lgi < (tQuote.legs || []).length; lgi++) {
            legRows.push((function(lg: any, ix: number) {
                var per = ceTravelCostPhrase(lg, String(st.travelResName || ''));
                return ceListRow({
                    key: 'tleg_' + String(ix),
                    label: String(lg.name || ''),
                    sub: (lg.free ? 'inside' : 'tier ' + String(lg.tier))
                         + ' \u00b7 ' + (per || 'free')
                });
            })(tQuote.legs[lgi], lgi));
        }
        travelBlock = ceStack({ key: 'map_travel', rule: 'top', padTop: CE_T.s3 }, [
            // [MAP-VEHICLE] THE HEADER NAMES THE TRAVELLER when it is not the camera. The
            // legs below are hops out of the ship's berth, not hops out of the room the
            // author is standing in, and a breakdown whose first row is somewhere they did
            // not expect to leave from is a breakdown that reads as a bug.
            ceKey((tvOn ? (tvVehName + ' \u00b7 ') : '')
                  + String(tQuote.steps) + (tQuote.steps === 1 ? ' step' : ' steps')
                  + (tPhrase ? ' \u00b7 ' + tPhrase : '')),
            ceStack(null, legRows),
            // THE HOLDING LINE, and it is not a warning. It states what is in the purse and
            // leaves the arithmetic to the reader, which is the same posture the rest of
            // this feature takes: show the limit, do not enforce it.
            (st.travelResName && tQuote.cost > 0)
                ? ceSub('t3', String(st.travelResName) + ': ' + String(st.travelResHave || 0)
                              + ' in hand, ' + String(tQuote.cost) + ' for this trip')
                : null
        ]);
    }

    // The hidden-places list, opened by the toolbar button when there is more than one.
    // Rendered UNDER the action bar rather than over the canvas: this file has no opaque
    // panel colour to float anything on (see the ceSheetOpen [DEAD] note), so lists go
    // in the flow.
    var hiddenBlock: any = null;
    if (st.showHidden && (st.hidden || []).length > 1) {
        var hRows: any[] = [];
        for (var hi = 0; hi < st.hidden.length; hi++) {
            hRows.push((function(hp: any) {
                return ceListRow({
                    key: 'mh_' + hp.id,
                    label: String(hp.name || 'Unnamed'),
                    sub: hp.where ? ('in ' + hp.where) : 'off the map',
                    onClick: function() {
                        ceNav('entity', String(hp.id), '', { surface: 'map', entityId: '', label: 'World' });
                    }
                });
            })(st.hidden[hi]));
        }
        hiddenBlock = ceStack({ key: 'map_hidden', rule: 'top', padTop: CE_T.s3 }, [ ceKey('Hidden places'), ceStack(null, hRows)]);
    }

    // [MAP-FIND] SEARCH RESULTS ARE ROWS ABOVE THE CANVAS, NOT A HIGHLIGHT ON IT.
    // Highlighting matches in the geometry would only help for what is already on screen at
    // a legible size, which is precisely the case that does not need a search. A row that
    // says WHAT was found and WHERE it is, and centres on tap, works at every zoom.
    // ONE TAP DOES BOTH JOBS: zoomTo sets focusId AND selectedId, so finding a thing also
    // selects the place holding it and fills the readout below with it.
    var mNeedle = ceFilterNeedle(q);
    var findRows: any[] = [];
    if (mNeedle) {
        var seenHit: any = {};
        var fi = 0;
        // Locations first: searching for a place should not have to scroll past everyone
        // standing in it.
        for (fi = 0; fi < nodes.length && findRows.length < 12; fi++) {
            var fn: any = nodes[fi];
            if (!fn || fn.id === CE_MAP_ROOT_ID) continue;
            if (!ceFilterMatch(mNeedle, [String(fn.name || '')])) continue;
            seenHit[fn.id] = 1;
            findRows.push((function(node: any) {
                return ceListRow({
                    key: 'mf_' + node.id,
                    label: String(node.name || ''),
                    sub: _ceMapWhere(nodes, node) || 'top of the world',
                    onClick: function() { ceTap('map:find:' + node.id, function() { zoomTo(node); }); }
                });
            })(fn));
        }
        var finds: any[] = (st.findables || []);
        for (fi = 0; fi < finds.length && findRows.length < 12; fi++) {
            var fd: any = finds[fi];
            if (!fd) continue;
            if (!ceFilterMatch(mNeedle, [String(fd.name || '')])) continue;
            findRows.push((function(hit: any) {
                var target: any = null;
                for (var q2 = 0; q2 < nodes.length; q2++) {
                    if (nodes[q2].id === hit.locId) { target = nodes[q2]; break; }
                }
                return ceListRow({
                    key: 'mfx_' + hit.id,
                    label: String(hit.name || ''),
                    // The KIND and the PLACE, because a hit on something that is not a
                    // location has to say why it is in a list of places.
                    sub: String(hit.kind || 'thing') + (hit.locName ? (' \u00b7 in ' + hit.locName) : ''),
                    onClick: function() {
                        if (!target) return;
                        ceTap('map:findx:' + hit.id, function() { zoomTo(target); });
                    }
                });
            })(fd));
        }
    }

    var searchBlock = ceStack({ gap: CE_T.s1, key: 'map_find', padBottom: CE_T.s2 }, [
        ceFilterField('map', 'Find a place, person or thing\u2026', setQ),
        (mNeedle && findRows.length)
            ? ceStack(null, findRows)
            : null,
        (mNeedle && !findRows.length)
            ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, padding: CE_T.s1 + ' ' + CE_T.s2 } },
                'Nothing by that name.')
            : null
    ]);

    return ceScreen(ceHeader(back), [
        _ceMapTabRow('world'),
        ceWrap({ key: 'maptab:world' }, [ ceStack(null, [
        searchBlock,
        h('div', {
            style: { position: 'relative', width: '100%', height: CE_MAP_VIEW_H, overflow: 'hidden',
                borderRadius: CE_T.r, border: '1px solid ' + CE_LINE, background: CE_FILL,
                touchAction: 'none', cursor: 'grab' },
            onPointerDown: onDown,
            onPointerMove: onMove,
            onPointerUp: function(e: any) { clearPointer(e.pointerId); },
            onPointerLeave: function(e: any) { clearPointer(e.pointerId); }
        },
            h('svg', {
                viewBox: '0 0 ' + CE_MAP_VB + ' ' + CE_MAP_VB,
                preserveAspectRatio: 'xMidYMid meet',
                style: { width: '100%', height: '100%', display: 'block' }
            },
                h('g', { transform: 'translate(' + cam.x + ',' + cam.y + ') scale(' + cam.k + ')' },
                    circles, icons, labels)
            )
        ),
        h('div', { style: { display: 'flex', gap: CE_T.s2, flexWrap: 'wrap', padding: CE_T.s2 + ' 0' } },
            ceBtn('\u2212', 'map:zoomout', function() {
                ceMapPatch(function(s: any) {
                    return { camera: ceMapZoomAroundCenter(s.camera, Math.max(0.4, s.camera.k * 0.8)) };
                });
                return Promise.resolve();
            }),
            ceBtn('+', 'map:zoomin', function() {
                ceMapPatch(function(s: any) {
                    return { camera: ceMapZoomAroundCenter(s.camera, Math.min(40, s.camera.k * 1.25)) };
                });
                return Promise.resolve();
            }),
            // Creation lands ON the new record rather than dropping the user back here --
            // see ceEntityCreate. Nested under whatever is selected, or at the top of the
            // world when nothing is.
            ceBtn('+ Location', 'map:new', function() {
                var sel = (st && st.selectedId && st.selectedId !== CE_MAP_ROOT_ID) ? String(st.selectedId) : '';
                return ceEntityCreate('location', sel, { surface: 'map', entityId: '', label: 'World' });
            }),
            ceBtn('Reset view', 'map:reset', function() {
                ceMapPatch(function() { return { camera: { x: 0, y: 0, k: 1 } }; });
                return Promise.resolve();
            }),
            ceBtn('Centre to Camera', 'map:tocam', function() {
                var target: any = null;
                for (var qh = 0; qh < nodes.length; qh++) { if (nodes[qh].id === camLocId) { target = nodes[qh]; break; } }
                if (target) zoomTo(target);
                else { try { api.v1.ui.toast('The scene location is not on this map.', { type: 'info', autoClose: 1800 }); } catch (e) {} }
                return Promise.resolve();
            }),
            // [MAP-HIDDEN] ALWAYS RENDERED,
            // never a primary. It is the only door to a mapKind:'hidden' place -- by
            // definition those are not on the canvas, so without this they would be
            // reachable from nowhere at all, and a door that appears only once something is
            // behind it is a door nobody knows exists until they need it.
            // NOT A PICKER, and the difference is real: a picker CHOOSES a value for a
            // field, and this NAVIGATES. Nothing is being set. One hidden place goes
            // straight there; several open a list, which is the same shape the readout's
            // Edit button uses.
            ceBtn('Hidden places', 'map:hidden', function() {
                var hid: any[] = (st.hidden || []);
                if (!hid.length) {
                    try { api.v1.ui.toast('No hidden places yet. A graveyard is made the first time someone dies.', { type: 'info', autoClose: 3200 }); } catch (e) {}
                    return Promise.resolve();
                }
                if (hid.length === 1) {
                    ceNav('entity', String(hid[0].id), '', { surface: 'map', entityId: '', label: 'World' });
                    return Promise.resolve();
                }
                ceMapPatch(function(sm: any) { return { showHidden: !sm.showHidden }; });
                return Promise.resolve();
            })
        ),
        actionBar,
        travelBlock,
        hiddenBlock
    ])])]);
}

// [SEC:SCHED][F-32] Four tabs. Still declared here rather than as a module const: four
// literal entries with no options is not a registry either, and CE_SETTINGS_TABS earns one
// at seven.
function _ceMapTabRow(active: string): any {
    // [TAB-WORLD] The INNER tab is "Map" now that the outer one is "World". World >
    // World > the map was two names for one thing and no name for the other. Ids are
    // untouched for the same reason the outer one's is.
    // [F-32] Species sits between Entities and Time because it is the other CONTENT tab --
    // Map draws the world, Entities indexes it, Species is the vocabulary it is made of, and
    // Time is the clock. A TAB AND NOT A ROUTE, per D-49: it renders here.
    // [HEXMAP] FIVE. Hex sits beside Map because it is the same world drawn the other
    // way -- the circle map answers what contains what, the hex map answers what is NEXT
    // TO what, and neither can be derived from the other. Ids untouched, per the rule two
    // comments up.
    return ceTabRow('map', [{ id: 'world', label: 'Map' },
                            { id: 'hex', label: 'Hex' },
                            { id: 'list', label: 'Entities' },
                            { id: 'species', label: 'Species' },
                            { id: 'time', label: 'Time' }],
                    active, function() { return; });
}

// ── MAP TAB: Entities  [TAB-ENTS] ────────────────────────────────────────────
// EVERY entity, in parent order, with a search bar. The canvas next door draws LOCATIONS
// and only the ones ceMapBuildTree could place: a faction, a thread, an item inside a
// chest and a hidden room are all invisible there, and for most of them the only door was
// already knowing where they hung. This is that door, and it is a TAB rather than a route
// for D-49's reason -- it renders here.
//
// INDENTED, NOT NESTED ACCORDIONS. An accordion per level charges a tap per level to reach
// a room's contents, and "I cannot get at it" is the thing this tab exists to fix.
// [TREE-INDENT] THE INDENT AND ITS CAP ARE THE KIT'S NOW (ceIndentLead / CE_TREE_INDENT_MAX).
// This tab wrote both first and its reasoning is unchanged -- a spacer rather than padding so
// the rule stays flush, capped because a phone runs out of inline axis long before a world
// runs out of depth. Diplomacy became the second tree and copied it, which is the point at
// which a private number stops being private.
//
// SEARCH FLATTENS, AND THAT IS NOT A SHORTCUT. A filtered TREE has to keep every ancestor
// of every hit or the hits have nowhere to hang, so a two-word query paints branches that
// matched nothing. The thread list already made this call; it prints "-- from <parent>"
// and this prints "-- in <parent>".
// The catalog owns the word, which is ITEM-CAT's rule: nothing here names a type.
function _ceEntsNoun(type: string): string {
    var c = ceEntityCatalog(type);
    if (c && c.noun) return String(c.noun);
    // A body has no catalog BY DESIGN -- a graph object whose profile column would ask
    // nothing. It still gets a word, because it still gets a row.
    var ty = String(type || '');
    return ty ? ty : 'thing';
}

function _ceEntsRow(e: any, flat: boolean, backAddr: any): any {
    var isChar = String(e.type || '') === 'character';
    var bits: string[] = [_ceEntsNoun(String(e.type || ''))];
    if (flat && e.parentName) {
        bits.push('\u2014 in ' + String(e.parentName));
    } else if (!flat && Number(e.childCount) > 0) {
        bits.push(String(e.childCount) + ' inside');
    }
    // [TREE-INDENT] ceIndentLead owns the spacer and the cap now; SEARCH STILL FLATTENS,
    // which is this tab's own decision and stays here -- the kit knows about depth, not
    // about queries.
    var lead: any[] = [];
    var indNode = ceIndentLead(flat ? 0 : (Number(e.depth) || 0));
    if (indNode) lead.push(indNode);
    // [ICON-LIB] The two forms an icon string may take are answered by the library, not
    // here: a vector rides the lead slot, an emoji rides the label.
    var svg = ceIconSvg(e.icon, 16, 'eic_' + String(e.id));
    if (svg) lead.push(svg);
    var glyph = (!svg && !ceIconIsSvg(e.icon) && String(e.icon || '')) ? (String(e.icon) + ' ') : '';
    return ceListRow({
        key: 'entl_' + String(e.id),
        opId: 'map:ents:' + String(e.id),
        lead: lead.length
            ? h('div', { key: 'ld', style: { display: 'flex', alignItems: 'center',
                                             gap: CE_T.s1, flex: '0 0 auto' } }, lead)
            : null,
        label: glyph + String(e.name || 'Unnamed'),
        sub: bits.join('  \u00b7  '),
        onClick: function() {
            // [ENT-ID1] A BODY'S ID IS THE CHARACTER'S ID, so a body row opens the PROFILE.
            // Sending it to the entity surface would open a page with no catalog behind it,
            // which reads as a broken row rather than as a design decision.
            ceNav(isChar ? 'profile' : 'entity', String(e.id), '', backAddr);
        }
    });
}

function _ceMapEntsTab(st: any, q: string, setQ: any): any {
    var list: any[] = (st.entList || []);
    var needle = ceFilterNeedle(q);
    var backAddr: any = { surface: 'map', entityId: '', label: 'World' };
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < list.length; i++) {
        var e: any = list[i];
        if (!e || !e.id) continue;
        // Name, KIND and PARENT are all matched, per ceFilterMatch's own note: a filter
        // that ignores half of what it renders reads as broken data.
        if (needle && !ceFilterMatch(needle, [String(e.name || ''),
                                              _ceEntsNoun(String(e.type || '')),
                                              String(e.parentName || '')])) continue;
        rows.push(_ceEntsRow(e, !!needle, backAddr));
    }
    var kids: any[] = [];
    kids.push(ceWrap({ key: 'ents_flt' }, [
        ceFilterField('mapents', 'Search every entity\u2026', setQ) ]));
    if (!list.length) {
        kids.push(ceEmpty('Nothing in this world yet.', null));
    } else if (!rows.length) {
        kids.push(ceEmpty('Nothing by that name.', null));
    } else {
        kids.push(ceSection(needle ? ('Found (' + rows.length + ')')
                                   : ('Everything (' + rows.length + ')'),
                            ceStack(null, rows)));
    }
    return ceStack(CE_T.s2, kids);
}

// [F-32] MAP TAB: Species  [SPEC-LIST]
// THE TWO LISTS, ON ONE TAB. A second tab for the bestiary would be a tab strip whose two
// bodies are this renderer with a different filter, and the thing that decides which list a
// record is on is a toggle ON THE RECORD -- so the split belongs inside the body, as two
// sections, and not in the strip.
//
// IT READS st.entList, the projection the Entities tab already gets. Same records, same
// shape, already built once per publish; a store key of its own would be a second projection
// of one index and a second thing to keep in step.
//
// TWO ADD BUTTONS, ONE PER SECTION, and that is what the sections are for beyond grouping:
// the list a species is on is a decision, and making it at the moment of creation is one tap
// where finding the toggle afterwards is three. It is still only a default -- the toggle on
// the profile moves a record across at any time.
//
// SEARCH FLATTENS INTO ONE RESULT SET, per the Entities tab's own note: a filtered pair of
// headed sections paints a heading that matched nothing. The list-word rides each row's
// sub-line instead, so a search result still says which side it came from.
// [SPEC-CTX] AND THE TWO ENTRIES ARE CONFIGURED HERE, WHICH IS WHY THE CONTEXT TAB'S
// SPECIES GROUPS ARE DELETED RATHER THAN MIRRORED. Two doors onto one state record is how
// two surfaces come to disagree about what is switched on, and this is the door an author
// is already standing at when the question occurs to them.
// THE SWITCH IS ABOVE THE LIST IT GOVERNS; the per-record exclusion is a toggle in that
// record's own card, because which records a list names is a fact about each record and not
// a checkbox column somewhere else; and the preview is COLLAPSED, because it is long by
// nature, read once, and would otherwise push the list itself off a phone.
function _ceMapSpeciesTab(st: any, q: string, setQ: any, openMap: any): any {
    var list: any[] = (st.entList || []);
    var needle = ceFilterNeedle(q);
    var backAddr: any = { surface: 'map', entityId: '', label: 'World' };
    var buckets: any = { people: [], bestiary: [] };
    var hits: any[] = [];
    var total = 0;
    var i = 0;
    // The exclusion sets, as lookups. Read off the map projection rather than storage: a
    // renderer cannot await, and this is the same shape every other projection on this
    // surface ships.
    var spEx: any = { people: {}, bestiary: {} };
    var exP: string[] = (st.pplExclude || []);
    var exB: string[] = (st.bstExclude || []);
    for (i = 0; i < exP.length; i++) spEx.people[String(exP[i])] = 1;
    for (i = 0; i < exB.length; i++) spEx.bestiary[String(exB[i])] = 1;
    var spOn: any = { people: (st.pplOn !== false), bestiary: (st.bstOn !== false) };
    for (i = 0; i < list.length; i++) {
        var e: any = list[i];
        if (!e || !e.id || String(e.type || '') !== 'species') continue;
        total++;
        var lId = String(e.speciesList || 'people');
        if (!buckets[lId]) lId = 'people';
        var lIn = !spEx[lId][String(e.id)];
        if (needle) {
            if (!ceFilterMatch(needle, [String(e.name || ''), String(e.kindWord || ''),
                                        String(ceSpeciesListDef(lId).label || '')])) continue;
            hits.push(_ceSpeciesRow(e, lId, true, backAddr, lIn, !!spOn[lId]));
        } else {
            buckets[lId].push(_ceSpeciesRow(e, lId, false, backAddr, lIn, !!spOn[lId]));
        }
    }

    var kids: any[] = [];
    kids.push(ceWrap({ key: 'sp_flt' }, [
        ceFilterField('mapspecies', 'Search every kind\u2026', setQ) ]));
    if (!total) {
        // THE EMPTY STATE CARRIES BOTH DOORS. A world with no species is exactly the world
        // where the only way in is this screen, which is the lesson MAP-EMPTY-DOOR cost a
        // version to learn one tab over.
        kids.push(ceEmpty('Nothing written yet. A species is a kind of person or creature \u2014 what they are, what they cannot do, and how they carry on.',
            ceInline({ gap: CE_T.s2 }, [
                _ceSpeciesAddBtn('people', backAddr, 'primary'),
                _ceSpeciesAddBtn('bestiary', backAddr, '')
            ])));
        return ceStack(CE_T.s2, kids);
    }
    if (needle) {
        kids.push(hits.length
            ? ceSection('Found (' + hits.length + ')', ceStack(null, hits))
            : ceEmpty('Nothing by that name.', null));
        return ceStack(CE_T.s2, kids);
    }
    for (i = 0; i < CE_SPECIES_LISTS.length; i++) {
        (function(def: any) {
            var rows: any[] = buckets[def.id] || [];
            var isP = (String(def.id) === 'people');
            var secOn = !!spOn[def.id];
            var pvText = String((isP ? st.pplText : st.bstText) || '');
            var pvId = 'mapspx:pv:' + String(def.id);
            kids.push(ceWrap({ key: 'sp_sec_' + def.id }, [
                ceSection(String(def.label) + ' (' + rows.length + ')', ceStack(CE_T.s2, [
                    // [SPEC-CTX] THE SWITCH FIRST, because everything under it is qualified
                    // by it: with the entry off, which records are on the list is a question
                    // about nothing.
                    ceSettingRow('Include this entry',
                        isP
                            ? 'One always-on lorebook entry naming every kind of person here, with the one-line description you wrote for each. It is what tells the model they exist at all \u2014 a species\u2019 own entry only fires when something says its name.'
                            : 'The same, for everything that is not a person. The model knows the creature exists before anything in the story has named it.',
                        ceToggle(secOn, 'map:spxon:' + def.id, function() {
                            return _ceCastLoreWrite(function(x: CastLoreState) {
                                if (isP) { x.pplOn = !secOn; } else { x.bstOn = !secOn; }
                            }).then(cePublishMap);
                        }, (secOn ? 'Stop including ' : 'Include ') + String(def.label))),
                    rows.length ? ceStack(CE_T.s2, rows)
                                : ceSub('t3', 'None on this list yet.'),
                    _ceSpeciesAddBtn(def.id, backAddr, ''),
                    // COLLAPSED, AND ONLY WHILE THE ENTRY IS ON. A preview of an entry that
                    // is not being written is a preview of nothing, and the summary line
                    // says the size rather than the first words: the first words of this
                    // entry are its heading and are the same on every story.
                    secOn ? ceAccordion({
                        id: pvId, label: 'What the model sees',
                        open: !!(openMap && openMap[pvId]),
                        summary: pvText.trim()
                            ? (String(pvText.trim().length) + ' characters')
                            : 'nothing right now',
                        children: _ceCastLorePreview(pvText,
                            'Nothing right now \u2014 everything on this list is left out.')
                    }) : null
                ]))
            ]));
        })(CE_SPECIES_LISTS[i]);
    }
    return ceStack(CE_T.s2, kids);
}

// [F-32] The row. `flat` names the list on the sub-line, which a search result needs and a
// row already sitting under its own heading does not.
// [CARD-ONE] A CARD, THE SAME ONE Scene AND Chat DRAW. A species has an avatar (SPEC-IMG
// gave it the character image architecture) and it was the one record type still rendering
// as a bare line of text, which is exactly the inconsistency the author reported one type
// over. The icon rides the frame's empty state rather than a lead slot, so a species with a
// picture shows the picture and one without still shows its icon.
// [SPEC-CTX] THE TRAIL CARRIES THE EXCLUSION, and it is a ceToggle rather than an icon verb
// because it is a boolean with two named states and there is no glyph in the library that
// says "in the lorebook entry". It is legal here for the reason CARD-ONE states: the card
// is not tappable, so the toggle's ceTap is not nested inside another.
// OFFERED ONLY WHILE THE LIST IS ON. A control whose effect is switched off elsewhere is
// chrome, and this one would silently record an intent against an entry nothing is writing.
function _ceSpeciesRow(e: any, listId: string, flat: boolean, backAddr: any,
                       included: boolean, listOn: boolean): any {
    var bits: string[] = [];
    var kw = String(e.kindWord || '').trim();
    if (kw) bits.push(kw);
    if (flat) bits.push(String(ceSpeciesListDef(listId).label || ''));
    if (listOn && !included) bits.push('left out of the entry');
    // [ICON-LIB] The two forms an icon string may take are answered by the library, not
    // here: a vector is a vnode, an emoji is a character.
    var svg = ceIconSvg(e.icon, 20, 'spc_' + String(e.id));
    var glyph = (!svg && !ceIconIsSvg(e.icon) && String(e.icon || '')) ? String(e.icon) : '';
    // [STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): this sizes the
    // record's emoji icon inside the avatar frame, matching the '+' placeholder beside it
    // in ceImgFrame. It is not a heading.
    var mark: any = svg
        ? svg
        : (glyph ? h('div', { style: { fontSize: '20px', opacity: CE_OP.t2 } }, glyph) : null);
    var nm = String(e.name || 'Unnamed');
    var isP = (String(listId) === 'people');
    return ceRecordCard({
        key: 'spl_' + String(e.id),
        imgId: String(e.id), imgSlot: CE_IMG_SLOT_AVATAR,
        mark: mark,
        title: nm,
        sub: bits.join('  \u00b7  '),
        openOpId: 'map:spec:' + String(e.id),
        onOpen: function() { ceNav('entity', String(e.id), '', backAddr); },
        trail: [
            listOn
                ? ceToggle(included, 'map:spxin:' + String(e.id), function() {
                    return _ceCastLoreWrite(function(x: CastLoreState) {
                        if (isP) { x.pplExclude = _ceCastLoreToggleId(x.pplExclude || [], String(e.id)); }
                        else { x.bstExclude = _ceCastLoreToggleId(x.bstExclude || [], String(e.id)); }
                    }).then(cePublishMap);
                }, (included ? 'Leave ' : 'Put back ') + nm)
                : null
        ]
    });
}

// [F-32] ONE CREATE VERB, PRESET. ceEntityCreate mints the record and navigates to it; the
// list is written straight afterwards through the same ceEntityWrite every field on that
// surface uses, so there is no second create path and nothing here knows how a record is
// saved. parentId is '' because a species is not in the containment tree -- see the record.
function _ceSpeciesAddBtn(listId: string, backAddr: any, kind: string): any {
    var def = ceSpeciesListDef(listId);
    return ceBtn('+ New ' + String(def.noun), 'map:spadd:' + String(def.id), function() {
        return ceEntityCreate('species', '', backAddr, { speciesList: String(def.id) });
    }, kind || '');
}

// ── MAP TAB: Time  [SEC:CLOCK][SEC:SCHED] ────────────────────────────────────────
// THREE LIVE THINGS, so this is not a door onto an empty room: the clock and its bigger
// jumps, everyone's day at once, and dated entries whose one behaviour is an injection.
//
// THE STACK IS WHAT A ROW LIST CANNOT SHOW. Three people converging on one room at 19:00 is
// visible at a glance here and invisible in a table -- which is the whole argument for the
// strip being a drawing rather than a list, and the reason this earns a tab.
// ONE now-MARKER ACROSS ALL THE STRIPS, drawn on the shared relative host rather than per
// row: six positions read against one instant. A per-strip highlight would make you check
// six separate places for the same fact.
function _ceMapTimeTab(st: any): any {
    var clockT = Number(st.clockT) || 0;
    var rows: any[] = (st.schedRows || []);
    var dated: any[] = (st.dated || []);
    var kids: any[] = [];

    var bump = function(mins: number, opId: string, label: string): any {
        return ceBtn(label, opId, function() {
            return ceClockNudge(mins).then(function() {
                return cePublishMap();
            }).then(function() { return cePublishScene(); });
        });
    };

    kids.push(ceBar({ gap: CE_T.s2, rule: 'bottom', padBottom: CE_T.s2 }, [
        ceGrow(null, [ ceStack(CE_T.s1, [
            ceMono(String(st.clockStamp || ''), { style: { fontSize: CE_T.fs, fontWeight: '600' } }),
            st.clockBand ? ceSub('t2', 'It is ' + String(st.clockBand)) : null
        ])])
    ]));

    // [F-2] THE GRID SITS DIRECTLY UNDER THE CLOCK, above the entry list, so it is never
    // behind a scroll of events. Selecting a day writes UI state and RE-PUBLISHES; it never
    // touches ceClockSet, which would fire ceSchedResolve and move the cast.
    var selDay = Number(st.selDay) || 0;
    var monthCells: any[] = (st.monthCells || []);
    var repub = function(): Promise<any> { return cePublishMap(); };
    var pickDay = function(d: number): void {
        _ceMapSelDay = Math.max(0, Math.round(Number(d) || 0));
        _ceMapMonthDay = -1;
        repub();
    };
    // THE TWO STEPS ARE PROJECTED, NOT COMPUTED HERE. Paging needs the month list and a
    // renderer cannot await loadConfig, so cePublishMap ships the absolute day either
    // button lands on -- which also makes ragged month lengths somebody else's arithmetic.
    var pageMonth = function(target: any): Promise<any> {
        _ceMapMonthDay = Math.max(0, Math.round(Number(target) || 0));
        return repub();
    };

    if (monthCells.length && Number(st.monthCols) > 0) {
        kids.push(ceStack(CE_T.s2, [
            // PROSE BETWEEN TWO CONTROLS, UNDER SS8c's MEASURED EXEMPTION. The rule exists
            // to stop a flexible cell absorbing a shortfall it cannot survive; here the
            // non-shrinking content is two 32px icon controls plus two gaps = 80px, so the
            // label keeps ~280px on the 360px floor and there is no shortfall to absorb.
            // BELT AND BRACES ANYWAY: nowrap + ellipsis means the worst case is a truncated
            // month name, never the one-letter column SS8c is named for.
            ceBar({ gap: CE_T.s2 }, [
                ceIconBtn('Previous month', ceIconLeft(), 'map:cal:prev', function() { return pageMonth(st.prevMonthDay); }),
                ceGrow(null, [ ceSub('t1', String(st.monthLabel || ''), { style: {
                    textAlign: 'center', whiteSpace: 'nowrap',
                    overflow: 'hidden', textOverflow: 'ellipsis'
                } }) ]),
                ceIconBtn('Next month', ceIconRight(), 'map:cal:next', function() { return pageMonth(st.nextMonthDay); })
            ]),
            ceMonthGrid(monthCells, Number(st.monthCols) || 1, (st.monthDayNames || []), pickDay),
            // THE WAY BACK. Paging far from today is cheap and finding the way home should
            // be too; without this the only route is counting months backwards.
            ceBar({ gap: CE_T.s2 }, [
                ceGrow(null, [ ceSub(st.selIsToday ? 't2' : 't1', String(st.selStamp || '')) ]),
                st.selIsToday ? null : ceBtn('Back to today', 'map:cal:today', function() {
                    _ceMapSelDay = -1; _ceMapMonthDay = -1;
                    return repub();
                })
            ])
        ]));
    }

    // [T-21b] ONE ROW: day, month, year, time, Resolve. THE EARLIER VERSION WAS A
    // SECTION HEADER OVER THREE FULL-WIDTH CONTROLS INCLUDING A PICKER FOR MINUTES,
    // which is a screen of furniture for something an author does by typing a date. A
    // minute has sixty values and no author scans a list to find one -- it is typed,
    // like the day and the year beside it.
    //   TIME IS ONE FIELD, NOT TWO. '14:30' is how a time is written; splitting it into
    //   an hour and a minute makes the author fill two boxes to say one thing.
    //   MONTH IS THE ONE PICKER, because it is a closed short enum whose members are
    //   named by the world (CE-STYLE 13) -- an author cannot be expected to know that
    //   Harvest is month 7.
    //   STILL STAGED BEHIND THE BUTTON. ceClockSet fires ceSchedResolve on every write
    //   (T-13), so committing the day and then the month would march the whole cast
    //   through a date nobody chose -- and stops that have fired do not un-fire when the
    //   clock goes back. The fields write scratch; Resolve performs ONE ceClockSet.
    var setCells: any[] = [];
    setCells.push(ceFixed({ basis: '72px' }, [ ceNumField({
        k: 'map:set:d', label: 'Day', value: Number(st.setDay) || 1, min: 1,
        onCommit: function(v: any) { _ceMapSetD = Math.max(1, Math.round(Number(v) || 1)); return repub(); }
    }) ]));
    if ((st.setMonths || []).length) {
        setCells.push(ceFixed({ basis: '132px' }, [ ceSelect({
            k: 'map:set:mo', label: 'Month', value: String(Number(st.setMon) || 0),
            options: (st.setMonths || []),
            onCommit: function(v: string) { _ceMapSetMon = Math.max(0, Math.round(Number(v) || 0)); return repub(); }
        }) ]));
        setCells.push(ceFixed({ basis: '84px' }, [ ceNumField({
            k: 'map:set:y', label: 'Year', value: Number(st.setYear) || 1, min: 1,
            onCommit: function(v: any) { _ceMapSetY = Math.max(1, Math.round(Number(v) || 1)); return repub(); }
        }) ]));
    }
    setCells.push(ceFixed({ basis: '84px' }, [ ceField({
        k: 'map:set:t', label: 'Time', value: String(st.setTime || ''), placeholder: '14:30',
        onCommit: function(v: string) { _ceMapSetTime = String(v || ''); return repub(); }
    }) ]));
    setCells.push(ceBtn('Resolve', 'map:set:go', function() {
        return ceClockSet(Math.max(0, Math.round(Number(st.setT) || 0))).then(function() {
            // Cleared on the way out so the fields fall back to following the clock they
            // just set; held drafts would make the next visit look like an edit in progress.
            _ceMapSetD = -1; _ceMapSetMon = -1; _ceMapSetY = -1; _ceMapSetTime = '';
            _ceMapSelDay = -1; _ceMapMonthDay = -1;
            return cePublishMap();
        }).then(function() { return cePublishScene(); });
    }, 'primary'));
    // ceInline WRAPS. On a phone the row becomes two, which is the honest behaviour for
    // five cells at a 360px floor -- and every cell has a fixed basis, so none of them
    // collapses into the column of single letters CE-STYLE 8c is named for.
    kids.push(ceInline(CE_T.s2, setCells));

    kids.push(ceInline(CE_T.s2, [
        bump(-60, 'map:clk:h-', '\u2212 1 hour'),
        bump(60, 'map:clk:h+', '+ 1 hour'),
        bump(480, 'map:clk:d8', '+ 8 hours'),
        bump(1440, 'map:clk:d1', '+ 1 day'),
        // RESOLVE NOW PASSES beforeT = -1, which makes every segment a crossing. The escape
        // hatch for any occasion the edge rule does not fire -- and the button an author
        // reaches for after editing a timetable, when nothing has moved because no window
        // boundary was crossed.
        ceBtn('Resolve now', 'map:sched:now', function() {
            return ceSchedResolveNow().then(function(n: number) {
                try {
                    api.v1.ui.toast(n
                        ? ('Moved ' + String(n) + (n === 1 ? ' person.' : ' people.'))
                        : 'Everyone is already where their day says.',
                        { type: 'success', autoClose: 2400 });
                } catch (e) {}
                return cePublishMap();
            }).then(function() { return cePublishScene(); });
        }, 'primary')
    ]));

    // ── Everyone's day ──────────────────────────────────────────────────────────
    var stackKids: any[] = [];
    for (var i = 0; i < rows.length; i++) {
        (function(r: any) {
            stackKids.push(ceBar({ gap: CE_T.s2, key: 'mts:' + r.id }, [
                // A FIXED NAME COLUMN, and it is fixed on purpose: the strips have to share a
                // left edge or the marker line crosses them at different hours. 88px is the
                // narrowest column that holds a short first name at fsSm.
                ceFixed({ basis: '88px' }, [
                    ceSub(r.enabled ? 't2' : 't3', String(r.name || ''))
                ]),
                ceGrow(null, [
                    r.enabled
                        ? ceDayStrip(r.segs, {
                            compact: true,
                            // [F-2] NO NOW-HOUR ON A DAY THAT IS NOT TODAY. A lit segment
                            // on last Tuesday would be a claim about where somebody is.
                            nowHour: (r.present || !st.selIsToday) ? -1 : ceClockHour(clockT),
                            nameOf: function(id: string) {
                                for (var q = 0; q < r.segs.length; q++) {
                                    if (String(r.segs[q].locationId) === String(id)) return String(r.segs[q].name || '');
                                }
                                return '';
                            },
                            emptyLabel: 'No stops' })
                        // ONE NODE EITHER WAY. A branch that rendered nothing would change
                        // this list's length on a fact that is not its length.
                        : ceDayStrip([], { compact: true, emptyLabel: 'Schedule paused' })
                ])
            ]));
        })(rows[i]);
    }
    if (!rows.length) {
        stackKids.push(ceSub('t3', 'Nobody keeps a schedule yet. Open a character\u2019s profile and '
            + 'start one from the Schedule door.', { key: 'mts:none' }));
    }
    kids.push(ceSection(st.selIsToday ? 'Everyone\u2019s day' : ('Everyone\u2019s day \u00b7 ' + String(st.selStamp || '')),
        ceStack(CE_T.s2, [
        // THE RULER AND THE MARKER SIT ON THE SHARED HOST so one line crosses every strip.
        // The 88px offset matches the name column exactly; a marker over the names would
        // point at the wrong hour on every row.
        h('div', { style: { position: 'relative', paddingTop: '14px' } },
            ceStack(CE_T.s2, stackKids),
            ceBar({ gap: CE_T.s2 }, [
                ceFixed({ basis: '88px' }, []),
                ceGrow(null, [ ceDayRuler() ])
            ]),
            (rows.length && st.selIsToday)
                ? h('div', { style: { position: 'absolute', top: '0', bottom: '18px',
                                      left: '88px', right: '0', pointerEvents: 'none' } },
                    ceDayNow(clockT, {}))
                : null
        )
    ])));

    // ── On the calendar ─────────────────────────────────────────────────────────
    // EDITED IN PLACE, NOT THROUGH A PICKER OR A DRILL. Three fields and a delete is not
    // enough to be worth a surface swap, and a picker is for CHOOSING A REFERENT (CE-STYLE
    // 13) -- none of these fields names another record.
    // EACH ENTRY IS ITS OWN KEYED STACK, and the fields are stacked rather than lined up:
    // a title, a day number and a note in one row is exactly the shape that produced the
    // column of single letters (CE-STYLE 8c).
    var dateKids: any[] = [];
    var _deMut = function(fn: (list: any[]) => void): Promise<any> {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                if (!Array.isArray((c as any).datedEntries)) (c as any).datedEntries = [];
                fn((c as any).datedEntries);
            });
        }).then(function() { return cePublishMap(); });
    };
    for (var di = 0; di < dated.length; di++) {
        (function(d: any) {
            var dk = 'mtd:' + d.id;
            var whenTxt = d.today ? 'Today'
                : (d.inDays > 0
                    ? ('in ' + String(d.inDays) + (d.inDays === 1 ? ' day' : ' days'))
                    : (String(-d.inDays) + (d.inDays === -1 ? ' day ago' : ' days ago')));
            dateKids.push(ceStack({ gap: CE_T.s2, key: dk }, [
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ h(ceField, {
                        k: dk + ':t', label: '', value: String(d.title || ''),
                        seed: dk + ':' + String(d.title || ''),
                        onCommit: function(v: string) {
                            return _deMut(function(l: any[]) {
                                for (var q = 0; q < l.length; q++) { if (l[q].id === d.id) { l[q].title = v; return; } }
                            });
                        }
                    })]),
                    ceIconBtn('Delete ' + (d.title || 'this entry'), ceIconTrash(), dk + ':rm', function() {
                        return _deMut(function(l: any[]) {
                            for (var q = 0; q < l.length; q++) { if (l[q].id === d.id) { l.splice(q, 1); return; } }
                        });
                    }, 'danger')
                ]),
                ceBar({ gap: CE_T.s2 }, [
                    ceFixed({ basis: '110px' }, [ ceNumField({
                        k: dk + ':d', label: 'Day', value: Number(d.day) || 0, min: 0, max: 999999,
                        onCommit: function(n: number) {
                            return _deMut(function(l: any[]) {
                                for (var q = 0; q < l.length; q++) { if (l[q].id === d.id) { l[q].day = Math.max(0, Math.round(n)); return; } }
                            });
                        } })]),
                    ceGrow(null, [ ceSub(d.today ? 't1' : 't3', whenTxt) ])
                ]),
                h(ceField, {
                    k: dk + ':n', label: '', multiline: true, rows: 2,
                    placeholder: 'What the story should be told on that day\u2026',
                    value: String(d.note || ''),
                    seed: dk + ':n:' + String(d.note || ''),
                    onCommit: function(v: string) {
                        return _deMut(function(l: any[]) {
                            for (var q = 0; q < l.length; q++) { if (l[q].id === d.id) { l[q].note = v; return; } }
                        });
                    }
                })
            ]));
        })(dated[di]);
    }
    if (!dated.length) {
        dateKids.push(ceSub('t3', 'Nothing on this day.', { key: 'mtd:none' }));
    }
    dateKids.push(ceWrap({ key: 'mtd:add' }, [
        // SEEDED ON THE DAY BEING READ, which is today until a cell is tapped. Day zero is
        // the first day of the story, and a new entry reading "412 days ago" is a form
        // somebody has to correct before they can use it.
        ceBtn('+ Add an entry on this day', 'map:dated:add', function() {
            return _deMut(function(l: any[]) {
                l.push({ id: _ceSchedNewId('de'), title: 'New entry', note: '',
                         day: selDay });
            });
        })
    ]));
    // [F-2] THE JUMP LIST, NOT A SECOND EDITOR. Scoping the editable list to one day would
    // otherwise make an entry on an unvisited month unreachable -- the grid only marks days
    // in the month it is showing. These rows SELECT their day and nothing else; the entry is
    // then edited in the one editor above, so there are never two doors onto one record.
    var elsewhere: any[] = (st.elsewhere || []);
    if (elsewhere.length) {
        var elseKids: any[] = [];
        for (var ei = 0; ei < elsewhere.length; ei++) {
            (function(e: any) {
                var away = e.day - selDay;
                var awayTxt = (away > 0 ? ('in ' + String(away)) : (String(-away) + ' before'))
                            + (Math.abs(away) === 1 ? ' day' : ' days');
                elseKids.push(ceTapRow('mte:' + String(e.id), String(e.title || 'Untitled'),
                    awayTxt, 'map:cal:jump:' + String(e.id), function() { pickDay(e.day); }));
            })(elsewhere[ei]);
        }
        dateKids.push(ceStack({ gap: CE_T.s1, key: 'mte:list' }, [
            ceSub('t3', 'Elsewhere on the calendar'),
            ceStack(CE_T.s1, elseKids)
        ]));
    }
    kids.push(ceSection(st.selIsToday ? 'On this day' : ('On ' + String(st.selStamp || 'this day')),
        ceStack(CE_T.s2, dateKids)));
    kids.push(ceSub('t3', 'A dated entry adds its note to the Author\u2019s Note on its own day, and '
        + 'does nothing else.'));

    return ceStack(CE_T.s5, kids);
}

// [MAP-FIND] Reads the occupants projection for one place. Returns null rather than
// an empty node when nobody is there, so an empty room costs no line and no gap.
function _ceMapOccupantLine(st: any, locId: string): any {
    var list: any[] = ((st && st.occupants) || {})[String(locId)] || [];
    if (!list.length) return null;
    var names: string[] = [];
    for (var i = 0; i < list.length; i++) {
        if (!list[i]) continue;
        names.push(String(list[i].name || 'Unnamed') + (list[i].active === false ? ' (inactive)' : ''));
    }
    if (!names.length) return null;
    return h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3, paddingTop: '2px' } },
        (names.length === 1 ? 'Here: ' : 'Here: ') + names.join(', '));
}

// [earlier, per user] Map shares the ONE shell modal every other surface uses, via
// ceNav('map') + ceRoot's switch -- it does NOT open its own, which is what earlier did
// and exactly why its "Scene" back button did nothing (MAP-NAV-FIX).
// [SHELL-TRAY] Reduced to a wrapper: the body it used to hold IS ceOpenShell.
// Kept as a named function because '/ce map' calls it by name.
async function ceOpenMap(): Promise<void> { await ceOpenShell('map'); }


// ============================================================================
// SECTION 32c — HEX MAP SURFACE (jsx)  [HEXMAP]
// ============================================================================
// The same location tree Section 32 packs into circles, drawn as a grid instead.
// The circle map answers WHAT CONTAINS WHAT. This answers WHAT IS NEXT TO WHAT,
// which containment cannot express at any depth.
//
// A HEX STORES ONE LOCATION ID. NOT A STACK, AND THIS IS THE WHOLE DESIGN.
// The tier stack -- Town > House > Room -- is the record's own parentId chain,
// walked by ceHexAtTier. Storing the stack per hex would be a second copy of a
// relationship the entity index already holds, which is a KIND-BACKFILL waiting
// to happen: paint a room, later reparent its house, and every hex still claims
// the old town. There is no second copy here to disagree with the first.
//
// It also makes the zoom-out behaviour free. Six hexes holding six rooms of one
// house all resolve to that house at its tier, so they merge into one region
// with no merge code anywhere -- they were never separate.
//
// THE COORDINATE SPACE IS CSS PIXELS, WITH NO viewBox, AND THAT IS THE ONE PLACE
// THIS SURFACE IS EXACT WHERE SECTION 32 CAN ONLY APPROXIMATE. Both of that
// section's honest-approximation constants (CE_MAP_FONT_VB, CE_MAP_VB_PER_PX)
// exist because a square viewBox under preserveAspectRatio:'xMidYMid meet' is
// mapped onto the container by a ratio this environment cannot measure -- no
// ownerDocument, so no getBoundingClientRect. Painting needs the INVERSE of that
// unmeasurable mapping on every single pointer event, so inheriting it was never
// an option.
// Dropping viewBox makes one svg user unit exactly one CSS pixel. Then:
//   - offsetX/offsetY on the container are already in the transform's own space,
//     so hit-testing is arithmetic with no unknown offset;
//   - panning is 1:1 with the finger by construction, needing no VB_PER_PX;
//   - pinch anchors at the actual midpoint between the fingers, which ZOOM-ANCHOR
//     documents as unachievable on the circle map for exactly the missing-offset
//     reason.
// The cost is that nothing auto-fits, which this surface does not want anyway:
// the camera is explicit because painting is.
//
// THE SVG CARRIES pointerEvents:'none' AND EVERY HANDLER IS ON THE CONTAINER.
// offsetX is relative to the event's TARGET, not its currentTarget, so a polygon
// under the finger would report coordinates inside that polygon and the whole
// hit-test would silently paint the wrong cell. Making the svg untargetable
// forces target === currentTarget on every event, which is what makes offsetX
// mean what this code assumes it means. It costs nothing: no polygon needs a
// handler when every cell is found by arithmetic.
//
// GEOMETRY WAS UNIT TESTED OUTSIDE THIS FILE FIRST (47 checks), for the reason
// Section 32's header gives about the packing port: a geometry bug on an svg
// surface is A BLANK SURFACE WITH NO CONSOLE LINE. The two that matter are a
// 15,840-point jitter sweep proving every point inside a hex resolves to that
// hex -- the test naive rounding fails -- and an assertion that edge i faces
// neighbour i, which is what lets borders be an index lookup instead of a search.
// ============================================================================

var CE_HEX_SIZE      = 34;    // hex circumradius in CSS px at k=1
// [HEX-ICON-ANCHOR] HOW MUCH OF A CELL A MARK FILLS, as a multiple of the circumradius. A
// pointy-top hex is 1.73r across the flats and 2r tall, and a SQUARE icon box is what has to
// fit inside that: much past 1.2 and the box's corners leave the hex at the top and bottom
// points, which reads as the icon overflowing into its neighbours.
var CE_HEX_ICON_FILL = 1.2;
var CE_HEX_VIEW_H_PX = 380;   // same viewport height as the circle map
var CE_HEX_VIEW_H    = CE_HEX_VIEW_H_PX + 'px';
var CE_HEX_TAP_SLOP  = 10;   // px a finger may wander and still count as a tap
// WHERE 0,0 IS PUT when the view is reset. Not a centre: the container width is not
// measurable in this environment (see the section header), so this is the one inset both
// Origin and Find camera aim at, which at least makes them agree with each other.
var CE_HEX_HOME_X    = 150;
var CE_HEX_MIN_K     = 0.35;
var CE_HEX_MAX_K     = 3.5;
// [HEX-TIER-SCALE] THE TIER VOCABULARY IS GONE, and its absence is the decision.
// v3.7.17 shipped eight hardcoded names -- World / Region / Settlement / ... -- which is
// a setting, not a scale. Per user: "some settings could be in space with sectors and
// planets." A world of sectors and planets is not a world of towns and rooms wearing the
// wrong labels, and any fixed list makes one genre correct and every other genre wrong.
// THE COUNT IS DERIVED from the deepest chain the world actually has (see cePublishHex),
// so the dial has exactly as many stops as the author has built and no empty ones below
// them. Tiers read as "Level N" because a number is honest where a guessed noun is not:
// per F-20's neighbour, a guessed field reads as authored.
var CE_HEX_TIER_MAX  = 12;   // a ceiling for the dial, not a vocabulary

// [HEXMAP] THE PALETTE IS COLOUR, NOT MEANING, and that is the same decision again.
// Naming these Water / Forest / Desert would be the tier vocabulary's mistake in another
// coat: a swatch called Forest is wrong on a starmap and wrong under an ocean. They are
// named for what they look like, and the author decides what that means in their world.
// THEME SLOTS, per CE-STYLE SS3.1: a colour decision is not finished until it is one, so
// each rides ceVar and a theme can restate the whole palette.
var CE_HEX_PALETTE = [
    { id: 1, label: 'Blue',   v: 'hex-pal-1', c: '#3b7dd8' },
    { id: 2, label: 'Teal',   v: 'hex-pal-2', c: '#2fa39b' },
    { id: 3, label: 'Green',  v: 'hex-pal-3', c: '#4f9d4f' },
    { id: 4, label: 'Olive',  v: 'hex-pal-4', c: '#7d8a3a' },
    { id: 5, label: 'Sand',   v: 'hex-pal-5', c: '#c2a35c' },
    { id: 6, label: 'Rust',   v: 'hex-pal-6', c: '#b4643a' },
    { id: 7, label: 'Violet', v: 'hex-pal-7', c: '#8060b8' },
    { id: 8, label: 'Slate',  v: 'hex-pal-8', c: '#6b7280' }
];

// [HEX-CAMERA] THE CAMERA'S OWN COLOUR, so the marker is not one more currentColor outline
// among the region borders it has to be told apart from at a glance.
var CE_HEX_CAM = ceVar('hex-cam', '#e8c07d');

// [HEX-LOCCOLOR] AUTHORED IF THERE IS ONE, DERIVED IF THERE IS NOT, and the two answers are
// different KINDS of value rather than two settings of one.
//
// DERIVING IS THE DEFAULT AND STAYS IT. Everything grey is indistinguishable, and worse over
// terrain that is not; hashing the id gives every place a colour that differs from its
// neighbour for no storage and no authoring step, and it is STABLE -- the same place is the
// same colour next session and on another device, because the id does not change. That is
// still the right answer for a world nobody has coloured, which is every world at first.
// SO THE OVERRIDE IS NEVER REQUIRED, which was the condition the retired hex-map TODO set:
// one optional field consulted before the hash, absent by default, and absent is what asks
// for the hash.
// A DERIVED COLOUR IS A THEME SLOT AND AN AUTHORED ONE IS NOT (CE-STYLE SS3.1). The engine
// chose the first, so a theme may restate it; the author chose the second, so restating it
// would be overwriting their work. That is why one returns ceVar and the other a literal.
// byId IS THE PROJECTION, not the record: this runs once per region per repaint, so it
// reads the index the surface already holds and never storage.
function ceHexLocColor(byId: any, id: string): string {
    var s = String(id || ''), n = 0, i: number;
    if (!s) return '';
    var au = ceColorNorm((byId && byId[s] && byId[s].color) || '');
    if (au) return au;
    for (i = 0; i < s.length; i++) { n = (n * 31 + s.charCodeAt(i)) >>> 0; }
    var e = CE_HEX_PALETTE[n % CE_HEX_PALETTE.length];
    return ceVar(e.v, e.c);
}

// ceHexPaletteColor WAS HERE AND IS DELETED, and so are ceHexColorAt and ceHexColorIdx that
// briefly replaced it. All three answered "what colour is this cell" against a table that
// moved; ceColorAt answers it against one that does not. CE_HEX_PALETTE now has exactly ONE
// live reader, ceHexLocColor, which hashes into it for DERIVED region colours -- chrome the
// engine chose, so they stay theme slots. Its eight literals are read once more in
// ceHexMigrateColors, as the meaning of a v1 record's indices, and nowhere else.

// [HEX-COLORS] A CELL STORES AN INDEX INTO THE SHELL'S PALETTE. It is `pt`, it is 1-based,
// 0 means unpainted, and ceColorAt is the only thing that resolves it.
// AN INDEX RATHER THAN A LITERAL, for the reason it always was: '#3b7dd8' on every one of an
// r30 map's 2,791 hexes is 2,791 copies of seven bytes, and an index is one. This is the
// opposite call to the one made for location ids, and the difference is that an id IS the
// reference and appears once per hex, where a colour is a value that repeats.
//
// THE INDEX IS INTO A CONSTANT, AND THAT IS THE PART THAT CHANGED. A per-map colors[] was
// built and is deleted. Every problem it had came from the table being DATA: it had to be
// seeded or old indices meant nothing, the seed reserved eight slots nobody asked for, it
// accumulated as an author painted, it travelled on the record, an export would have had to
// carry it -- and two save paths (resize, start over) already dropped it, which silently
// blanked every painted cell on the map. NONE OF THAT SURVIVES A CONSTANT. The palette is
// 66 entries, which is small enough to simply be the vocabulary; the index needs no seed, no
// migration on write, and no interning at export because it is already global.
// WHAT IT COSTS is a colour outside the palette: a hex typed into the picker's box snaps to
// the nearest swatch (ceColorIdx). The map shows the snapped colour immediately, so what an
// author got is never in doubt -- and terrain wanting a 67th colour is a smaller loss than a
// table that six code paths have to remember to carry.
// Radii offered at creation. 4/6/8/10 -> 61/127/217/331 cells.
// Up to r30 -- 2,791 cells, which is the agreed ceiling. The render is a fixed 13 nodes
// at any radius (HEX-NODECOUNT), so what actually grows is the rebuild loop and the stored
// record, and r30 is where both are still comfortable.
var CE_HEX_RADII = [6, 10, 16, 22, 30];
// [HEX-COLORS] WHICH LIGHTNESS ROW OF THE PALETTE THE BRUSH STRIP SHOWS, 0-based into
// CE_COLOR_LIGHTS. The middle band: the lightest wash out under the region borders drawn
// over them and the darkest are hard to tell apart on a dark ground.
var CE_HEX_QUICK_LIGHT = 2;
var STORAGE_HEXMAP = 'ce_hexmap';

// dir i points at 60*i degrees. See the edge-indexing note in ceHexBorders.
var CE_HEX_DIRS = [[1, 0], [0, 1], [-1, 1], [-1, 0], [0, -1], [1, -1]];

function ceHexKey(q: number, r: number): string { return q + ',' + r; }

function ceHexParse(key: string): any {
    var p = String(key).split(',');
    return { q: Number(p[0]), r: Number(p[1]) };
}

function ceHexToPixel(q: number, r: number, size: number): any {
    return { x: size * Math.sqrt(3) * (q + r / 2), y: size * 1.5 * r };
}

function ceHexCorners(size: number): any[] {
    var pts: any[] = [], i: number, a: number;
    for (i = 0; i < 6; i++) {
        a = (Math.PI / 180) * (60 * i - 30);
        pts.push({ x: size * Math.cos(a), y: size * Math.sin(a) });
    }
    return pts;
}

function ceHexPolygonPoints(size: number): string {
    var c = ceHexCorners(size), out: string[] = [], i: number;
    for (i = 0; i < c.length; i++) out.push(c[i].x.toFixed(2) + ',' + c[i].y.toFixed(2));
    return out.join(' ');
}

// CUBE ROUND. Rounding fractional cube coordinates and repairing whichever axis
// took the largest correction is the only method that lands on the right hex near
// a shared edge; Math.round on q and r independently does not, and its failure is
// invisible until a drag skips cells along boundaries.
function ceHexRound(qf: number, rf: number): any {
    var xf = qf, zf = rf, yf = -xf - zf;
    var rx = Math.round(xf), ry = Math.round(yf), rz = Math.round(zf);
    var dx = Math.abs(rx - xf), dy = Math.abs(ry - yf), dz = Math.abs(rz - zf);
    if (dx > dy && dx > dz) { rx = -ry - rz; }
    else if (dy > dz) { ry = -rx - rz; }
    else { rz = -rx - ry; }
    return { q: rx, r: rz };
}

function ceHexFromPixel(x: number, y: number, size: number): any {
    return ceHexRound((Math.sqrt(3) / 3 * x - y / 3) / size, (2 / 3 * y) / size);
}

function ceHexNeighbor(q: number, r: number, dir: number): any {
    var d = CE_HEX_DIRS[((dir % 6) + 6) % 6];
    return { q: q + d[0], r: r + d[1] };
}

function ceHexDistance(aq: number, ar: number, bq: number, br: number): number {
    var ay = -aq - ar, by = -bq - br;
    return Math.max(Math.abs(aq - bq), Math.abs(ay - by), Math.abs(ar - br));
}

// THE BRUSH. n is a cube RADIUS: 0 is one hex, 1 is seven, 2 is nineteen. The UI
// offers sizes 1/2/3 and converts once, here, rather than at each call site.
function ceHexRange(cq: number, cr: number, n: number): any[] {
    var out: any[] = [], dq: number, dr: number, lo: number, hi: number;
    for (dq = -n; dq <= n; dq++) {
        lo = Math.max(-n, -dq - n);
        hi = Math.min(n, -dq + n);
        for (dr = lo; dr <= hi; dr++) out.push({ q: cq + dq, r: cr + dr });
    }
    return out;
}

function ceHexInMap(q: number, r: number, radius: number): boolean {
    return ceHexDistance(q, r, 0, 0) <= radius;
}

function ceHexBrush(cq: number, cr: number, n: number, radius: number): any[] {
    var all = ceHexRange(cq, cr, n), out: any[] = [], i: number;
    for (i = 0; i < all.length; i++) {
        if (ceHexInMap(all[i].q, all[i].r, radius)) out.push(all[i]);
    }
    return out;
}

// The parentId chain, root first. Guarded: a cycle in the index must cost a wrong
// label, never a hung worker.
function ceHexChain(byId: any, startId: string): string[] {
    var chain: string[] = [], cur = String(startId || ''), guard = 0, m: any;
    while (cur && guard++ < 1000) {
        chain.unshift(cur);
        m = byId[cur];
        if (!m) break;
        cur = String(m.parentId || '');
    }
    return chain;
}

// Deliberately the same contract as _ceAncestorAtTier: tier 1 is the ROOT.
function ceHexAtTier(byId: any, startId: string, tier: number): string {
    if (tier <= 0) return '';
    var chain = ceHexChain(byId, startId);
    return (chain.length >= tier) ? chain[tier - 1] : '';
}

// THE PAINT GUARD, and it is the reason a single stored id cannot go wrong.
// Painting X onto a hex is legal iff the hex is empty, already X, an ancestor of X,
// or a descendant of X. Everything else -- a room dropped into a house it does not
// belong to, a house painted over its neighbour's room -- would create a hex whose
// stored id contradicts the tier the author was looking at. An illegal stroke
// simply does not take; nothing is raised and nothing is toasted per cell, because
// a drag crosses many cells and most refusals are the brush overhanging an edge.
function ceHexCanPaint(byId: any, hexLocId: string, brushLocId: string): boolean {
    var cur = String(hexLocId || ''), brush = String(brushLocId || '');
    if (!brush) return true;
    if (!cur) return true;
    if (cur === brush) return true;
    if (ceHexChain(byId, brush).indexOf(cur) >= 0) return true;
    if (ceHexChain(byId, cur).indexOf(brush) >= 0) return true;
    return false;
}

// [HEX-TIER-SCALE] DEEPEST AT OR ABOVE THE TIER. ceHexAtTier -- exact depth -- is now
// only the paint guard's business, and this is what every drawn layer uses.
//
// REPORTED LIVE: "a house could be in the country and be considered same tier as a city
// in country", and drilling past a hex's own depth left it blank. Both are the same
// mistake: DEPTH IS NOT SCALE. A house standing in open country and a city inside that
// same country are both depth 2, so an exact-depth layer draws them as peers, and then
// erases the house entirely the moment the view goes one level finer -- so the finer the
// view, the less of the world is on it, which is backwards.
//
// Clamping the index to the end of the chain means a hex always shows THE FINEST THING IT
// ACTUALLY HOLDS. At the maximum tier every hex shows its own deepest, which is the map
// someone moving hex to hex actually needs -- the country house and the city house appear
// together, at the same size, because to a traveller they are the same kind of thing. At
// tier 1 the same world collapses to its roots. NO SETTING IS EVER BLANK, and the tier
// control stops being a stack of separate maps and becomes what it should always have
// been: a coarseness dial on one map.
function ceHexResolveAt(byId: any, startId: string, tier: number): string {
    var chain = ceHexChain(byId, startId);
    if (!chain.length) return '';
    var idx = Math.min(Math.max(1, tier), chain.length) - 1;
    return chain[idx];
}

function ceHexDepth(byId: any, startId: string): number {
    return ceHexChain(byId, startId).length;
}

function ceHexLayer(hexes: any, byId: any, tier: number): any {
    var out: any = {}, k: string, id: string;
    for (k in hexes) {
        id = ceHexResolveAt(byId, (hexes[k] && hexes[k].loc) || '', tier);
        if (id) out[k] = id;
    }
    return out;
}

// BORDERS ARE WHAT MAKE A ZOOMED-OUT TIER READ AS TWO HOUSES IN A TOWN rather than
// as a grid of identical swatches.
// EDGE INDEXING IS ASSERTED, NOT ASSUMED (unit test 4): vertex i sits at 60i-30
// degrees, so the edge from vertex i to vertex i+1 has its midpoint at exactly 60i
// degrees -- which is the direction of CE_HEX_DIRS[i]. Edge i is therefore the edge
// shared with neighbour i, and "draw a border where my neighbour differs" is an
// index lookup with no search. O(6n). Off by one here would have drawn borders on
// the wrong sides: a map that looks subtly wrong with nothing to grep for.
function ceHexBorders(layer: any, size: number): any[] {
    var corners = ceHexCorners(size), segs: any[] = [];
    var k: string, h2: any, c: any, i: number, nb: any, nk: string;
    for (k in layer) {
        h2 = ceHexParse(k);
        c = ceHexToPixel(h2.q, h2.r, size);
        for (i = 0; i < 6; i++) {
            nb = ceHexNeighbor(h2.q, h2.r, i);
            nk = ceHexKey(nb.q, nb.r);
            if (layer[nk] === layer[k]) continue;
            segs.push({ id: layer[k],
                        x1: c.x + corners[i].x, y1: c.y + corners[i].y,
                        x2: c.x + corners[(i + 1) % 6].x, y2: c.y + corners[(i + 1) % 6].y });
        }
    }
    return segs;
}

// Connected components of equal id, so a region gets ONE label rather than one per
// hex. The centroid is the mean of member centres: for a concave region that can sit
// slightly off-centre, which reads as a placed label rather than as a fault.
function ceHexRegions(layer: any, size: number): any[] {
    var seen: any = {}, out: any[] = [], k: string;
    for (k in layer) {
        if (seen[k]) continue;
        var id = layer[k], queue: string[] = [k], members: string[] = [], sx = 0, sy = 0;
        var px: number[] = [], py: number[] = [];
        seen[k] = 1;
        while (queue.length) {
            var cur = String(queue.pop()), hh = ceHexParse(cur), cc = ceHexToPixel(hh.q, hh.r, size);
            members.push(cur); sx += cc.x; sy += cc.y;
            px.push(cc.x); py.push(cc.y);
            for (var i = 0; i < 6; i++) {
                var nb = ceHexNeighbor(hh.q, hh.r, i), nk = ceHexKey(nb.q, nb.r);
                if (!seen[nk] && layer[nk] === id) { seen[nk] = 1; queue.push(nk); }
            }
        }
        // [HEX-ICON-ANCHOR] THE MARK LANDS ON A CELL, NOT ON THE CENTROID. A centroid is the
        // mean of the members and is not required to be one of them: for an L-shaped or
        // ring-shaped region it sits in the hole, which is somebody else's cell, and two
        // neighbours whose means fall close draw their icons on top of each other. The
        // member NEAREST the mean keeps the label where the region reads as being while
        // making the position a cell -- and a cell belongs to exactly one region in a layer,
        // so anchored icons cannot collide by construction.
        // TIES BROKEN BY ORDER, which is the traversal order and therefore stable for a
        // given layer: a mark that hopped between two equally central cells between renders
        // would read as a fault.
        var mcx = sx / members.length, mcy = sy / members.length;
        var ax = mcx, ay = mcy, bestD = -1;
        for (var mi = 0; mi < members.length; mi++) {
            var dx = px[mi] - mcx, dy = py[mi] - mcy, dd = dx * dx + dy * dy;
            if (bestD < 0 || dd < bestD) { bestD = dd; ax = px[mi]; ay = py[mi]; }
        }
        out.push({ id: id, cx: mcx, cy: mcy, ax: ax, ay: ay, size: members.length });
    }
    return out;
}

// -- Auto-fill -----------------------------------------------------------------
// [HEX-AUTO] THE RECORD SHAPE DECIDES THE ALGORITHM, and it is not the one this looks
// like from the outside. A hex holds ONE location id -- the deepest -- so there is no
// kingdom layer to paint and then a city layer to paint over it. What runs is a
// PARTITION: each node is handed a set of cells, splits it among its children, and only
// the deepest claimant is ever written. Every coarser tier is then ceHexResolveAt's
// business, exactly as it is for hand-painted cells, which is why a generated map zooms
// out for free and why a parent can never be torn -- a child's domain is a SUBSET of its
// parent's by construction, not by a check afterwards.
// ceHexCanPaint IS NOT CONSULTED, and that is not a bypass: the guard exists because a
// brush stroke can contradict the tree, and a top-down partition cannot. Existing cells
// are honoured through `lock` instead, which is the same fact from the other end.
//
// EVERYTHING IS CLAIMED. Per user, unclaimed ground is not wilderness -- it does not
// exist -- so the top level always divides the whole disc between its roots and the
// remainder at every level below belongs to the parent. That is what makes "you can be
// in a house without being in one of its rooms" true on the map as well as in the tree.
//
// THE SIZES ARE THE USER'S, stated once here because three functions read them:
// an interior is ONE cell plus whatever is nested inside it; a structure is its contents
// PLUS ONE for itself; a region needs at least its contents and takes more if it can.
//
// WHAT IS OFF THE MAP is CE_MAP_KINDS' business and not a second list here. `hidden` is
// skipped with its whole subtree, for the reason its own entry gives about ceMapSumValues
// -- a functional place must not pull the layout toward itself. A `vehicle` is skipped
// with its subtree too, and that one is load-bearing: a hull is ONE cell on its own `vh`
// layer and its depth is derived from a parent that changes every voyage, so counting a
// ship's cabins in the world's footprint would make the whole map want to be redrawn the
// moment it sailed.
//
// UNIT TESTED OUTSIDE THIS FILE FIRST (28 checks), for the reason the section header
// gives: a generator fault on an svg surface is a wrong-looking map with no console line.
// The ones that matter are the void rule (every cell of an r30 disc claimed, 2,791 of
// 2,791), containment (no child cell outside its parent, across an 824-location world),
// and determinism (same seed, byte-identical map).

// PADDING ON A REGION'S ISLAND, so a town is not painted skin-tight to its own buildings.
// Ignored in bordered mode, where regions divide everything and there is nothing to pad.
var CE_HEX_AUTO_PAD: any   = { packed: 1.0, balanced: 1.7, sparse: 2.8 };
// HOW MUCH THE GROWTH CARES ABOUT ITS OWN EDGE. 1 takes the most-surrounded cell every
// time, which is a disc; near 0 it takes whatever is on the frontier, which sprawls.
var CE_HEX_AUTO_SHAPE: any = { blobby: 1.0, natural: 0.6, sprawling: 0.22 };
// A CEILING ON SIBLINGS CONSIDERED AT ONE LEVEL. Not a limit on world size -- it is the
// point past which a parent has more children than its ground has cells to give them, so
// the ones beyond it would be dropped by the quota pass anyway, more slowly.
var CE_HEX_AUTO_MAXCH = 64;

// [HEX-AUTO] A SEEDED PRNG, because api.v1.random HAS NO SEED -- bool, float, int and
// roll, and none of them take one (verified against script-types, not remembered). Reroll
// and "give me that layout back" both need the same seed to mean the same map, so the
// generator carries its own. mulberry32: one 32-bit word of state, and the same arithmetic
// the palette hash next door already uses.
function ceHexRng(seed: number): any {
    var a = (seed >>> 0) || 1;
    return function(): number {
        a = (a + 0x6D2B79F5) >>> 0;
        var t = a;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

// [HEX-AUTO] THE PLACEABLE FOREST. Not the entity tree: hidden and vehicle subtrees are
// gone, anything past the depth cap is gone, and what is left is re-rooted so a node whose
// parent was dropped becomes a root rather than an orphan pointing at nothing.
// SORTED BY NAME. The order children are considered in decides which seed lands where, so
// leaving it as object-key order would make the map depend on entity creation order --
// same seed, different layout, no way to tell why.
function ceHexAutoTree(byId: any, cap: number): any {
    var id: string, i: number, ok: any = {}, kids: any = {}, roots: string[] = [];
    var lim = Math.max(1, Number(cap) || 1);
    for (id in byId) {
        if (!Object.prototype.hasOwnProperty.call(byId, id)) continue;
        var chain = ceHexChain(byId, id);
        if (!chain.length || chain.length > lim) continue;
        var bad = false;
        for (i = 0; i < chain.length; i++) {
            var kd = ceMapKindOf((byId[chain[i]] || {}).kind);
            if (kd === 'hidden') { bad = true; break; }
            if (kd === 'vehicle' && chain[i] !== id) { bad = true; break; }
        }
        if (bad || ceMapKindOf((byId[id] || {}).kind) === 'vehicle') continue;
        ok[id] = true;
    }
    for (id in ok) {
        if (!Object.prototype.hasOwnProperty.call(ok, id)) continue;
        var par = String((byId[id] || {}).parentId || '');
        if (par && ok[par]) { (kids[par] = kids[par] || []).push(id); }
        else roots.push(id);
    }
    var byName = function(a: string, b: string): number {
        var an = String((byId[a] || {}).name || ''), bn = String((byId[b] || {}).name || '');
        if (an !== bn) return an < bn ? -1 : 1;
        return a < b ? -1 : (a > b ? 1 : 0);
    };
    roots.sort(byName);
    for (id in kids) {
        if (Object.prototype.hasOwnProperty.call(kids, id)) kids[id].sort(byName);
    }
    return { ok: ok, kids: kids, roots: roots };
}

// [HEX-AUTO] THE MINIMUM FOOTPRINT, bottom-up. Memoised, and the memo is seeded with 1
// BEFORE the recursion so a cycle in the index costs a wrong number rather than a hung
// worker -- ceHexChain's guard, one level up.
function ceHexAutoWeight(tree: any, byId: any, id: string, memo: any): number {
    if (memo[id] !== undefined) return memo[id];
    memo[id] = 1;
    var ch: string[] = tree.kids[id] || [], sum = 0, i: number;
    for (i = 0; i < ch.length; i++) sum += ceHexAutoWeight(tree, byId, ch[i], memo);
    var w = (ceMapKindOf((byId[id] || {}).kind) === 'region') ? Math.max(1, sum) : (sum + 1);
    memo[id] = w;
    return w;
}

// [HEX-AUTO] GREEDY FARTHEST-POINT, and it replaces the trigonometric ring seeding this
// feature was sketched with. A ring divides 360 degrees by the number of claims, which
// only means anything when the domain is the whole disc -- true at the top level and false
// at every level below it, where the domain is whatever shape the parent came out as.
// This works on any set, needs only ceHexDistance, and on a disc it converges to roughly
// the ring anyway. ONE SEEDER, so there is no second one to disagree with it.
// RUNNING MINIMUM, not a rescan: dm[j] is j's distance to the nearest chosen seed and is
// updated once per pick, which makes this O(cells * seeds) rather than O(cells * seeds^2).
// `taken` is where the already-placed cells enter -- a locked capital is a seed, so its
// siblings are seeded away from it rather than on top of it.
function ceHexAutoSeeds(cells: string[], want: number, rng: any, taken: string[]): string[] {
    var out: string[] = [], i: number, j: number, n = cells.length;
    if (!n || want <= 0) return out;
    var pts: any[] = [], dm: number[] = [];
    for (i = 0; i < n; i++) { pts.push(ceHexParse(cells[i])); dm.push(1e9); }
    var used: any = {};
    for (i = 0; i < (taken || []).length; i++) used[taken[i]] = true;
    var absorb = function(key: string): void {
        var p = ceHexParse(key), d: number;
        for (j = 0; j < n; j++) {
            d = ceHexDistance(pts[j].q, pts[j].r, p.q, p.r);
            if (d < dm[j]) dm[j] = d;
        }
    };
    for (i = 0; i < (taken || []).length; i++) absorb(taken[i]);
    while (out.length < want) {
        var best = -1, bestSc = -1;
        for (j = 0; j < n; j++) {
            if (used[cells[j]]) continue;
            var sc = (dm[j] >= 1e9 ? 1e6 : dm[j]) + rng() * 0.75;
            if (sc > bestSc) { bestSc = sc; best = j; }
        }
        if (best < 0) break;
        used[cells[best]] = true;
        out.push(cells[best]);
        absorb(cells[best]);
    }
    return out;
}

// [HEX-AUTO] COMPETITIVE GROWTH. Every claim expands one cell per round, so regions take
// turns rather than one of them crossing the map before the next starts -- which is the
// whole difference between a set of blobs and a set of stripes.
// THE SCORE IS COHESION PLUS NOISE. A frontier cell already touching three of my own cells
// scores three; `cw` decides how much that beats the dice. This is the shape control and
// there is nothing else in here that changes what a region looks like.
// A CLAIM WHOSE FRONTIER RUNS DRY IS DONE, not re-seeded elsewhere: a second component
// would be a region drawn with two labels (ceHexRegions groups by connectivity), which
// reads as a fault rather than as an archipelago.
// pre IS INVIOLABLE and is applied before any seeding, so a cell an author placed by hand
// is where growth starts rather than something growth has to be told to avoid.
function ceHexAutoGrow(cells: string[], claims: any[], pre: any, cw: number, rng: any): any {
    var i: number, j: number, k: string, owner: any = {}, inDom: any = {};
    var count: any = {}, front: any = {};
    for (i = 0; i < cells.length; i++) inDom[cells[i]] = true;
    for (i = 0; i < claims.length; i++) { count[claims[i].id] = 0; front[claims[i].id] = []; }

    var take = function(cid: string, key: string): void {
        owner[key] = cid;
        count[cid] = (count[cid] || 0) + 1;
        var p = ceHexParse(key), t: number;
        for (t = 0; t < 6; t++) {
            var nb = ceHexNeighbor(p.q, p.r, t), nk = ceHexKey(nb.q, nb.r);
            if (inDom[nk] && !owner[nk]) front[cid].push(nk);
        }
    };
    for (k in (pre || {})) {
        if (!Object.prototype.hasOwnProperty.call(pre, k)) continue;
        if (!inDom[k] || owner[k] || count[pre[k]] === undefined) continue;
        take(pre[k], k);
    }
    var free: string[] = [];
    for (i = 0; i < cells.length; i++) if (!owner[cells[i]]) free.push(cells[i]);
    var placed: string[] = [];
    for (k in owner) {
        if (Object.prototype.hasOwnProperty.call(owner, k)) placed.push(k);
    }
    var needSeed: number[] = [];
    for (i = 0; i < claims.length; i++) if (!count[claims[i].id]) needSeed.push(i);
    var seeds = ceHexAutoSeeds(free, needSeed.length, rng, placed);
    for (i = 0; i < needSeed.length && i < seeds.length; i++) {
        take(claims[needSeed[i]].id, seeds[i]);
    }

    var live = true, round = 0;
    while (live) {
        live = false;
        round++;
        // The loop cannot outlive the domain: every round that does anything consumes a
        // cell. The margin is for the rounds that only prune dead frontier.
        if (round > cells.length + 16) break;
        for (i = 0; i < claims.length; i++) {
            // ROTATED START, so the same claim does not get first refusal every round.
            var c = claims[(i + round) % claims.length];
            if (count[c.id] >= c.quota) continue;
            var f: string[] = front[c.id], bestI = -1, bestSc = -1;
            for (j = 0; j < f.length; j++) {
                if (owner[f[j]]) continue;
                var p2 = ceHexParse(f[j]), own = 0, d: number;
                for (d = 0; d < 6; d++) {
                    var nb2 = ceHexNeighbor(p2.q, p2.r, d);
                    if (owner[ceHexKey(nb2.q, nb2.r)] === c.id) own++;
                }
                var sc2 = own * cw + rng() * (1 - cw) * 6;
                if (sc2 > bestSc) { bestSc = sc2; bestI = j; }
            }
            if (bestI < 0) { front[c.id] = []; continue; }
            var key2 = f[bestI];
            f.splice(bestI, 1);
            take(c.id, key2);
            live = true;
        }
    }
    return { owner: owner, count: count };
}

// [HEX-AUTO] THE VOID RULE, enforced after growth rather than during it. Rounding a set of
// quotas to whole cells always leaves a few over, and a pocket the frontier never reached
// is unowned however careful the arithmetic was. Both are the same answer: give the cell
// to whichever neighbouring claim holds most of its edges, repeat until nothing moves, and
// hand anything still stranded to the nearest claim by centroid. Only called in fill mode
// -- in islands mode the leftover IS the parent's own ground and must stay unowned here.
function ceHexAutoClose(cells: string[], owner: any, claims: any[]): any {
    var i: number, j: string, k: string, changed = true, guard = 0;
    var ids: any = {};
    for (i = 0; i < claims.length; i++) ids[claims[i].id] = true;
    while (changed && guard++ < 64) {
        changed = false;
        // COLLECTED THEN APPLIED, so one pass cannot cascade across the map in scan order.
        var next: any = {};
        for (i = 0; i < cells.length; i++) {
            k = cells[i];
            if (owner[k]) continue;
            var p = ceHexParse(k), tally: any = {}, best = '', bestN = 0, d: number;
            for (d = 0; d < 6; d++) {
                var nb = ceHexNeighbor(p.q, p.r, d);
                var o = owner[ceHexKey(nb.q, nb.r)];
                if (!o || !ids[o]) continue;
                tally[o] = (tally[o] || 0) + 1;
                if (tally[o] > bestN) { bestN = tally[o]; best = o; }
            }
            if (best) { next[k] = best; changed = true; }
        }
        for (k in next) owner[k] = next[k];
    }
    var cent: any = {}, cnt: any = {};
    for (k in owner) {
        var pp = ceHexParse(k);
        if (!cent[owner[k]]) { cent[owner[k]] = { q: 0, r: 0 }; cnt[owner[k]] = 0; }
        cent[owner[k]].q += pp.q; cent[owner[k]].r += pp.r; cnt[owner[k]]++;
    }
    for (k in cent) {
        cent[k].q = Math.round(cent[k].q / cnt[k]);
        cent[k].r = Math.round(cent[k].r / cnt[k]);
    }
    for (i = 0; i < cells.length; i++) {
        k = cells[i];
        if (owner[k]) continue;
        var q2 = ceHexParse(k), pick = '', pd = 1e9;
        for (j in cent) {
            var dd = ceHexDistance(q2.q, q2.r, cent[j].q, cent[j].r);
            if (dd < pd) { pd = dd; pick = j; }
        }
        if (pick) owner[k] = pick;
    }
    return owner;
}

// [HEX-AUTO] STRANDED CELLS, and this is not cosmetic. ceHexRegions groups a layer into
// CONNECTED COMPONENTS, so a single cell of one region sitting inside another draws that
// region's name and icon a SECOND time, in the wrong place. Five of six edges against one
// neighbour is the threshold; a claim is never emptied, so smoothing cannot delete a place.
function ceHexAutoSmooth(cells: string[], owner: any, rounds: number): any {
    var i: number, d: number, k: string, pass: number;
    for (pass = 0; pass < (rounds || 0); pass++) {
        var next: any = {}, moved = 0, tot: any = {};
        for (k in owner) tot[owner[k]] = (tot[owner[k]] || 0) + 1;
        for (i = 0; i < cells.length; i++) {
            k = cells[i];
            var mine = owner[k];
            if (!mine || tot[mine] <= 1) continue;
            var p = ceHexParse(k), tally: any = {}, best = '', bestN = 0;
            for (d = 0; d < 6; d++) {
                var nb = ceHexNeighbor(p.q, p.r, d);
                var o = owner[ceHexKey(nb.q, nb.r)];
                if (!o || o === mine) continue;
                tally[o] = (tally[o] || 0) + 1;
                if (tally[o] > bestN) { bestN = tally[o]; best = o; }
            }
            if (best && bestN >= 5) { next[k] = best; tot[mine]--; tot[best]++; moved++; }
        }
        for (k in next) owner[k] = next[k];
        if (!moved) break;
    }
    return owner;
}

// [HEX-AUTO] THE ONE DOOR. PURE: it takes the cells, the projection and the options and
// returns a NEW hexes object. It reads no store, writes no storage and moves nothing, which
// is what makes Preview possible at all -- the surface shows the return value and saves it
// only if the author says so, which matters because storyStorage has no undo.
// TERRAIN AND HULLS SURVIVE. `pt` is authored and `vh` is a fact about where a ship is;
// neither is the generator's to decide, and blanking them would be the guessed-field
// failure F-20 names -- generated output that reads as authored.
// IT DOES NOT WRITE `pt` AT ALL, for the same reason. A colour on this map means whatever
// the author decided it means, so choosing one for them is choosing a fact.
function ceHexAutoFill(hexes: any, byId: any, radius: number, opts: any): any {
    var o = opts || {};
    var cap = Math.max(1, Number(o.cap) || 1);
    var pad = CE_HEX_AUTO_PAD[String(o.room || 'balanced')] || 1.7;
    var cw = CE_HEX_AUTO_SHAPE[String(o.shape || 'natural')];
    if (cw === undefined) cw = 0.6;
    var rng = ceHexRng(Number(o.seed) || 1);
    var tree = ceHexAutoTree(byId, cap);
    var memo: any = {}, i: number, k: string;

    var disc = ceHexRange(0, 0, radius), all: string[] = [];
    for (i = 0; i < disc.length; i++) all.push(ceHexKey(disc[i].q, disc[i].r));

    var need = 0;
    for (i = 0; i < tree.roots.length; i++) need += ceHexAutoWeight(tree, byId, tree.roots[i], memo);
    if (!tree.roots.length) return { ok: false, why: 'empty', need: 0, have: all.length };
    // REFUSED WITH BOTH NUMBERS, not truncated. A world that does not fit is a decision the
    // author has to make -- a bigger map or a shallower fill -- and quietly dropping the
    // places that did not fit would make the map lie about what the world contains.
    if (need > all.length) return { ok: false, why: 'small', need: need, have: all.length };

    // [HEX-AUTO] AN EXISTING CELL IS A LOCK AND A SEED. It pins its whole ancestor chain:
    // a hand-placed capital keeps its cell, and its nation is grown from there rather than
    // from wherever the seeder would have started. Clamped to the cap by the same rule
    // ceHexResolveAt uses, so a room's cell locks its house when rooms are not being placed.
    var lock: any = {};
    if (o.keep) {
        for (k in (hexes || {})) {
            if (!Object.prototype.hasOwnProperty.call(hexes, k)) continue;
            var lid = String((hexes[k] || {}).loc || '');
            if (!lid) continue;
            var ch0 = ceHexChain(byId, lid);
            if (!ch0.length) continue;
            var leaf = ch0[Math.min(cap, ch0.length) - 1];
            if (!tree.ok[leaf]) continue;
            var p0 = ceHexParse(k);
            if (!ceHexInMap(p0.q, p0.r, radius)) continue;
            lock[k] = leaf;
        }
    }

    var owner: any = {}, unplaced: string[] = [];

    var step = function(parentId: string, domain: string[], depth: number): void {
        // LOCAL COUNTERS. step recurses, so a shared i/j would let an inner level rewind
        // the loop its caller was in the middle of.
        var i: number, j: number, m: number, w: number, kd: string, qn: number;
        var sc: number, tot: number, worst: number, lk: string, lc: string[], oi: string;
        if (!domain.length || depth > 32) return;
        var ch: string[] = (parentId ? (tree.kids[parentId] || []) : tree.roots)
                             .slice(0, CE_HEX_AUTO_MAXCH);
        // THE PARENT TAKES ITS DOMAIN FIRST and its children overwrite what they claim.
        // That single line is "everything is claimed": a cell no child wanted is the
        // parent's own ground, and at the top level there is no parent, so the roots are
        // required to divide the disc between them.
        for (i = 0; i < domain.length; i++) if (parentId) owner[domain[i]] = parentId;
        if (!ch.length) return;

        var fill = !parentId || String(o.spread || 'islands') === 'bordered';
        var claims: any[] = [], fixedTot = 0, regW = 0, regs: any[] = [];
        for (i = 0; i < ch.length; i++) {
            w = ceHexAutoWeight(tree, byId, ch[i], memo);
            kd = ceMapKindOf((byId[ch[i]] || {}).kind);
            // A REGION DIVIDES OR ISLANDS; EVERYTHING ELSE TAKES EXACTLY ITS FOOTPRINT.
            // A house is the size of its rooms plus itself whatever the map does around it.
            if (kd === 'region') { regs.push({ id: ch[i], w: w }); regW += w; }
            else { claims.push({ id: ch[i], quota: w }); fixedTot += w; }
        }
        var room = domain.length - fixedTot;
        if (room < 0) {
            // The fixed footprints do not fit. Shrink them in proportion with a floor of
            // one, rather than letting the first few take everything in list order.
            sc = Math.max(0, domain.length - regs.length) / Math.max(1, fixedTot);
            fixedTot = 0;
            for (i = 0; i < claims.length; i++) {
                claims[i].quota = Math.max(1, Math.floor(claims[i].quota * sc));
                fixedTot += claims[i].quota;
            }
            room = Math.max(0, domain.length - fixedTot);
        }
        for (i = 0; i < regs.length; i++) {
            if (fill) qn = Math.max(1, Math.round(room * (regs[i].w / Math.max(1, regW))));
            else qn = Math.max(1, Math.min(room, Math.round(regs[i].w * pad)));
            claims.push({ id: regs[i].id, quota: qn });
        }
        // NEVER PROMISE MORE GROUND THAN EXISTS. Trimmed from the largest claim down, so
        // the thing that loses a cell is the thing that had most, and a claim that reaches
        // zero is REPORTED rather than silently absent from the map.
        tot = 0;
        for (i = 0; i < claims.length; i++) tot += claims[i].quota;
        while (tot > domain.length && claims.length) {
            worst = 0;
            for (i = 1; i < claims.length; i++) if (claims[i].quota > claims[worst].quota) worst = i;
            if (claims[worst].quota <= 1) {
                unplaced.push(claims[worst].id);
                tot -= claims[worst].quota;
                claims.splice(worst, 1);
            } else { claims[worst].quota--; tot--; }
        }
        if (!claims.length) return;

        var pre: any = {};
        for (i = 0; i < domain.length; i++) {
            lk = lock[domain[i]];
            if (!lk) continue;
            lc = ceHexChain(byId, lk);
            for (j = 0; j < lc.length; j++) {
                for (m = 0; m < claims.length; m++) {
                    if (claims[m].id === lc[j]) { pre[domain[i]] = lc[j]; break; }
                }
                if (pre[domain[i]]) break;
            }
        }
        var res = ceHexAutoGrow(domain, claims, pre, cw, rng);
        var own = res.owner;
        if (fill) own = ceHexAutoClose(domain, own, claims);
        own = ceHexAutoSmooth(domain, own, (String(o.shape || 'natural') === 'blobby') ? 3 : 1);

        var buckets: any = {};
        for (i = 0; i < claims.length; i++) buckets[claims[i].id] = [];
        for (i = 0; i < domain.length; i++) {
            oi = own[domain[i]];
            if (!oi || !buckets[oi]) continue;
            owner[domain[i]] = oi;
            buckets[oi].push(domain[i]);
        }
        for (i = 0; i < claims.length; i++) step(claims[i].id, buckets[claims[i].id], depth + 1);
    };

    step('', all, 0);

    // PAINTED HEXES ONLY still holds on the way out: a cell with nothing on it is dropped
    // rather than stored empty, which is what an erase already does.
    var out: any = {}, cells = 0;
    for (i = 0; i < all.length; i++) {
        k = all[i];
        var was: any = (hexes || {})[k] || null;
        var id2 = String(owner[k] || '');
        var cell: any = { loc: id2, pt: Number((was && was.pt) || 0) };
        if (was && was.vh) cell.vh = was.vh;
        if (!cell.loc && !cell.pt && !cell.vh) continue;
        out[k] = cell;
        if (cell.loc) cells++;
    }
    return { ok: true, hexes: out, cells: cells, need: need, have: all.length,
             unplaced: unplaced.length };
}

// -- Storage ------------------------------------------------------------------
// ONE MAP PER STORY, no root selector. A grid whose tier-1 cells are simply
// different top-level locations already holds several worlds side by side, so a
// per-root record would have been a second thing to choose before anything could
// be drawn.
// PAINTED HEXES ONLY. An empty cell is derived from `radius`, never stored, which
// is what keeps a radius-10 map (331 cells) at a few KB rather than a payload.

// [HEX-COLORS] THE ONE-TIME REMAP OF A v1 RECORD, and it is a WRITE rather than a
// read-through because it cannot be idempotent: after it runs, the cells no longer mean what
// the old table said, so a second pass over the same record would remap the remapping.
// `v` is the gate for exactly that reason -- the shape alone cannot tell a migrated record
// from an unmigrated one, since both are just cells holding numbers.
// WHAT THE OLD INDICES MEANT, in the two forms a v1 record takes: a colors[] on the record
// if it was written after the per-map table existed, and CE_HEX_PALETTE's eight slots if it
// was written before. Both resolve to a literal, and the literal resolves to a palette index
// -- exactly where the author picked from the grid, nearest where they did not (the eight
// legacy literals are not grid swatches and land close rather than equal).
// MEMOISED PER OLD INDEX. A distinct colour is looked up once, not once per hex, which on an
// r30 map is eight lookups instead of 2,791.
function ceHexMigrateColors(rec: any): void {
    var old: string[] = [], i: number;
    if (rec.colors && rec.colors.length) {
        for (i = 0; i < rec.colors.length; i++) old.push(String(rec.colors[i] || ''));
    } else {
        for (i = 0; i < CE_HEX_PALETTE.length; i++) old.push(String(CE_HEX_PALETTE[i].c));
    }
    var seen: any = {}, k: string, cell: any, pt: number;
    for (k in (rec.hexes || {})) {
        if (!Object.prototype.hasOwnProperty.call(rec.hexes, k)) continue;
        cell = rec.hexes[k];
        pt = Number((cell && cell.pt) || 0);
        if (pt <= 0) continue;
        if (seen[pt] === undefined) {
            seen[pt] = (pt <= old.length) ? ceColorIdx(old[pt - 1]) : 0;
        }
        cell.pt = seen[pt];
        // A cell that held ONLY a colour the old table could not name is not a cell.
        if (!cell.pt && !String(cell.loc || '')) delete rec.hexes[k];
    }
    if (rec.colors) delete rec.colors;
}

async function ceHexLoad(): Promise<any> {
    var raw = '';
    try { raw = (await api.v1.storyStorage.getOrDefault(STORAGE_HEXMAP, '')) as string; }
    catch (e) { raw = ''; }
    if (!raw) return null;
    try {
        var rec = JSON.parse(raw);
        if (!rec || typeof rec !== 'object') return null;
        rec.radius = Number(rec.radius) || 6;
        rec.hexes = rec.hexes || {};
        // [HEX-COLORS] THE MIGRATION RUNS HERE AND SAVES, and KIND-BACKFILL is why it is on
        // the read rather than in an upsert: a migration that only fires when a record is
        // next written never reaches the maps nobody edits. The save is what makes the `v`
        // gate true on the next load -- see ceHexMigrateColors for why it must not re-run.
        // A FAILED SAVE LEAVES THE RECORD AT v1 and the remap simply happens again next
        // load, which is the right failure: the alternative is a session drawing indices
        // nothing on disk agrees with.
        if (Number(rec.v || 1) < 2) {
            ceHexMigrateColors(rec);
            rec.v = 2;
            await ceHexSave(rec);
        }
        return rec;
    } catch (e2) { api.v1.error('[AE:hex] map record unreadable:', e2); return null; }
}

// [MAP-VEHICLE-HEX] THE HULL FOLLOWS THE CAMERA. A vehicle is one hex and it is the BOTTOM
// TIER of wherever it is, so arriving somewhere means two writes and they must not come apart:
// the hex moves to where the destination is painted, and the record reparents so containment
// agrees with the picture.
// IT IS A NO-OP FOR ALMOST EVERY MOVE, and cheaply: the camera is only aboard a vehicle when
// the destination's chain contains one, which is one walk up the parents.
// THE DESTINATION'S HEX IS THE TARGET, not the destination's own cell if it has none -- a
// cabin is unpainted and a ship sailing to a cabin is a ship sailing to whatever hex that
// cabin is inside. ceHexOf already answers exactly that.
// IF THE DESTINATION IS ON NO HEX AT ALL, the record still reparents and the hull simply
// keeps the cell it had. A half-painted world must not be able to lose a ship.
async function ceHexCarryVehicle(byId: any, vehicleId: string, toId: string, destKey?: string): Promise<void> {
    try {
        var cvV = String(vehicleId || ''), cvT = String(toId || '');
        if (!cvV) return;
        var rec: any = await ceHexLoad();
        if (!rec) return;
        var hexes: any = rec.hexes || {};
        // [HEX-VH] THE CELL THE AUTHOR TAPPED, WHEN THERE IS ONE. Resolving the destination
        // from the target LOCATION landed the hull on whichever of that place's cells sorted
        // first, which is the same fault the camera pin was written to fix. The surface knows
        // the cell; ceHexOf is the fallback for a caller that does not.
        var dest = String(destKey || '') || (cvT ? ceHexOf(hexes, byId, cvT) : '');
        if (!dest) return;
        var k: string, cell: any;
        for (k in hexes) {
            if (!Object.prototype.hasOwnProperty.call(hexes, k)) continue;
            if (String((hexes[k] || {}).vh || '') !== cvV) continue;
            if (k === dest) continue;
            // [HEX-VH] ONLY THE VEHICLE LAYER IS CLEARED. The cell keeps its location and its
            // colour, because the ship was never what that cell WAS -- it was what was sitting
            // on it. The old version wrote the hull into `loc` and had to blank the cell to
            // move it, which is why a departing ship took the sea with it.
            cell = hexes[k];
            delete cell.vh;
            if (!String(cell.loc || '') && !Number(cell.pt || 0)) delete hexes[k];
        }
        if (!hexes[dest]) hexes[dest] = { loc: '', pt: 0 };
        hexes[dest].vh = cvV;
        rec.hexes = hexes;
        await ceHexSave(rec);
        await cePublishHex();
    } catch (e) { api.v1.error('[AE:hex] vehicle carry failed:', e); }
}

// [HEX-CAMERA] WHERE THE CAMERA ACTUALLY IS ON THE GRID. One value for the whole map, not a
// coordinate stapled to every record: a location's cells are already in `hexes` and a second
// copy on the record would be the per-map colour table's mistake again -- data that six paths
// have to remember to keep in step. The camera is the only thing that has a POSITION rather
// than an extent, so the camera is the only thing that stores one.
// '' CLEARS IT, which is what travelling from anywhere but a cell should do: the scan then
// answers, and answering roughly is better than pointing at a stale cell confidently.
async function ceHexSetCam(key: string): Promise<void> {
    try {
        var rec: any = await ceHexLoad();
        if (!rec) return;
        rec.camHex = String(key || '');
        await ceHexSave(rec);
    } catch (e) { api.v1.error('[AE:hex] camera cell:', e); }
}

async function ceHexSave(rec: any): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_HEXMAP, JSON.stringify(rec || {})); }
    catch (e) { api.v1.error('[AE:hex] save failed:', e); }
}

// -- Store --------------------------------------------------------------------
// [MAP-VEHICLE-HEX] THE FALLBACK HULL GLYPH, one constant rather than a literal at the draw
// site, so an author-set icon and the engine's stand-in are the same kind of value.
var CE_HEX_VH_GLYPH = '\u25C6';

var ceHexStore: any = null;
function ceHexStoreInit(): void {
    if (ceHexStore) return;
    try {
        ceHexStore = createStore({
            // STORE-BEFORE-HOOK, and this file has paid that bill five times already:
            // every key the surface reads exists in the INITIAL shape, not only after the
            // first publish. A tab subscribed from its first render that reads undefined
            // off this store is a blank panel with no console line.
            ready: false, exists: false, radius: 6, hexes: {},
            locs: [], byId: {}, note: '', maxTier: 1,
            tier: 1, brush: 1, brushLoc: '', brushPt: 0, brushKind: 'loc', paint: false,
            // [HEX-AUTO] EVERY KNOB THE GENERATOR READS, IN THE INITIAL SHAPE, on
            // STORE-BEFORE-HOOK's rule: the options block draws on the first frame the
            // author arms it, and a ceSelect handed undefined renders blank with nothing
            // on the console. autoCap 0 means "every level" and resolves against maxTier
            // at the call, so the default cannot go stale as the world deepens.
            // autoBack IS THE UNDO storyStorage does not have: it holds the map as it was
            // while a preview is on screen, and Discard puts it back.
            autoCap: 0, autoSpread: 'islands', autoRoom: 'balanced', autoShape: 'natural',
            autoKeep: true, autoSeed: 1, autoPrev: false, autoBack: null, autoNote: '',
            // [HEX-RUNAWAY] `rev` IS THE RENDER CACHE'S KEY and the reason it can be
            // trusted: hexes is a large object and hashing it on every render would cost
            // more than the render it is meant to skip, so the store states outright when
            // its content changed rather than being asked to prove it.
            rev: 0,
            // [HEX-VNODE-REUSE] Bumped once when a gesture ends, purely to ask for the
            // render that settles the frozen zoom. It is state nothing draws, which is
            // why it is a counter and not a flag: a flag would need clearing.
            gest: 0,
            // [HEX-SELECT] The selected hex KEY, not a location id: two hexes may hold the
            // same place, and a panel that could not tell them apart would put the travel
            // button on the wrong one of a six-hex house.
            sel: '', confirm: '',
            // [SEC:TRAVEL] The five fields ceTravelGraph reads, plus the tiers and where the
            // camera stands. Reduced rather than shipped whole, per JSXKIT-STORE-SPLIT: the
            // surface draws a price, not an index. Mirrors ceMapStore's own projection so
            // the two surfaces can never quote different numbers for one journey.
            travelNodes: [], travelTiers: [], camLocId: '',
            // [TRAVEL-MODE] STORE-BEFORE-HOOK: the panel reads all three on its first render.
            travelMode: 'circle', hexMins: 0, hexCost: 0,
            // STORE-BEFORE-HOOK: the cell panel reads both on its first render.
            mbOpen: false, camHex: '', travelVehId: '',
            // `down` IS NO LONGER HERE. See onMove: pointer bookkeeping renders nothing,
            // and keeping it in the store cost a store write plus a full repaint on every
            // single pointermove.
            camera: { x: 0, y: 0, k: 1 }
        });
    } catch (e) { api.v1.error('[AE:hex] store init failed:', e); }
}

function ceHexPatch(fn: (s: any) => any): void {
    if (!ceHexStore) return;
    try {
        ceHexStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:hex] patch failed:', e); }
}

// The projection. JSXKIT-STORE-SPLIT's rule: it carries what the surface DRAWS --
// names, chains and depths -- not the entity index behind them.
async function cePublishHex(): Promise<void> {
    ceHexStoreInit();
    if (!ceHexStore) return;
    try {
        var metas: any[] = await loadEntityIndex();
        var byId: any = {}, locs: any[] = [], i: number;
        for (i = 0; i < (metas || []).length; i++) {
            var m: any = metas[i];
            if (!m || !m.id || String(m.type || '') !== 'location') continue;
            // THE GLYPH IS ALREADY ON THE RECORD and the circle map already draws it, so a
            // region icon costs one propagated field rather than a new one. It is text, not
            // svg -- the field's own comment calls it an emoji or short glyph -- which is
            // why it can ride in a <text> node at the centroid and never touches the node
            // count that HEX-NODECOUNT exists to hold down.
            // [HEX-LOCCOLOR] `color` is the AUTHORED one or '', never the derived one --
            // deriving is ceHexLocColor's job and doing half of it here would put the fallback
            // in two places. '' is the whole of "nobody chose".
            byId[String(m.id)] = { id: String(m.id), name: String(m.name || 'Unnamed'),
                                   icon: String((m as any).icon || ''),
                                   color: String((m as any).mapColor || ''),
                                   // [MAP-VEHICLE-HEX] The paint reads the kind, so the kind
                                   // rides the projection with the rest.
                                   kind: ceMapKindOf((m as any).mapKind),
                                   parentId: m.parentId ? String(m.parentId) : null };
        }
        var kk: string, maxTier = 1;
        for (kk in byId) {
            var dep = ceHexDepth(byId, byId[kk].id);
            if (dep > maxTier) maxTier = dep;
            locs.push({ id: byId[kk].id, name: byId[kk].name, depth: dep });
        }
        // [HEX-TIER-SCALE] THE DIAL HAS AS MANY STOPS AS THE WORLD HAS DEPTH, and one
        // spare so a newly created child is reachable the moment it exists.
        maxTier = Math.max(1, Math.min(CE_HEX_TIER_MAX, maxTier + 1));
        locs.sort(function(a: any, b: any) {
            if (a.depth !== b.depth) return a.depth - b.depth;
            return a.name < b.name ? -1 : (a.name > b.name ? 1 : 0);
        });
        // [SEC:TRAVEL] Its own try, for the reason the map's pricing projection gives at its
        // own entry: a travel price must not be able to cost the map its clock, or the map
        // its render.
        var hxNodes: any[] = [], hxTiers: any[] = [], hxCam = '';
        var hxMode = 'circle', hxRate: any = { mins: 0, cost: 0 };
        try {
            for (i = 0; i < (metas || []).length; i++) {
                var tn: any = metas[i];
                if (!tn || !tn.id || String(tn.type || '') !== 'location') continue;
                hxNodes.push({ id: String(tn.id), name: String(tn.name || 'Unnamed'),
                               type: 'location',
                               parentId: tn.parentId ? String(tn.parentId) : null,
                               mapKind: tn.mapKind, travelTier: tn.travelTier });
            }
            var hxCfg: any = await loadConfig();
            hxTiers = ceTravelTiers(hxCfg);
            hxMode = ceTravelMode(hxCfg);
            hxRate = ceTravelHexRate(hxCfg);
            hxCam = String((await loadProtagonistLocation()) || '');
        } catch (eT) { api.v1.error('[AE:hex] travel projection failed:', eT); }

        var rec = await ceHexLoad();
        ceHexPatch(function(s: any) {
            // A BRUSH THAT NO LONGER EXISTS IS CLEARED HERE rather than checked at every
            // paint: deleting a location while it is the selected brush would otherwise
            // leave a stroke writing a dangling id into hexes.
            var bl = String(s.brushLoc || '');
            if (bl && !byId[bl]) bl = '';
            return { ready: true, exists: !!rec,
                     radius: rec ? Number(rec.radius) : 6,
                     hexes: rec ? (rec.hexes || {}) : {},
                     // [HEX-AUTO] A PREVIEW DOES NOT SURVIVE A REPUBLISH, and it must not
                     // LOOK as though it did. This overwrites `hexes` from the record, so
                     // leaving autoPrev standing would show Apply over a map that had
                     // already reverted -- the surface promising something it no longer
                     // holds. `confirm` is deliberately left alone: publish also runs after
                     // a journey, and closing an open dialog under the author's hand is a
                     // different bug.
                     autoPrev: false, autoBack: null, autoNote: '',
                     rev: Number(s.rev || 0) + 1,
                     locs: locs, byId: byId, brushLoc: bl, maxTier: maxTier,
                     travelNodes: hxNodes, travelTiers: hxTiers, camLocId: hxCam,
                     travelMode: hxMode, hexMins: hxRate.mins, hexCost: hxRate.cost,
                     camHex: String((rec && rec.camHex) || ''),
                     tier: Math.max(1, Math.min(maxTier, Number(s.tier) || 1)),
                     note: locs.length ? '' : 'No locations in this world yet.' };
        });
    } catch (e) {
        api.v1.error('[AE:hex] publish failed:', e);
        ceHexPatch(function() { return { ready: true, note: 'Could not read the world.' }; });
    }
}

// WRITE-THROUGH: the store is patched first so the stroke is on screen this frame,
// then the record is persisted. The reverse order would make every cell wait on
// storage, which at drag speed is a visible lag behind the finger.
function ceHexWrite(hexes: any, radius: number): void {
    ceHexPatch(function(s: any) {
        return { hexes: hexes, exists: true, radius: radius,
                 rev: Number(s.rev || 0) + 1 };
    });
    ceHexSave({ v: 2, radius: radius, hexes: hexes });
}

// [HEX-VNODE-REUSE] THE CACHE HOLDS GEOMETRY, NOT VNODES, AND THAT DISTINCTION IS THE
// WHOLE ENTRY. v3.7.19 cached the built vnode arrays and handed the same instances back on
// the next render. PREACT VNODES ARE SINGLE-USE: an instance that has already been mounted
// carries its own realised DOM, and diffing it a second time in a later tree corrupts that
// tree rather than reusing it.
//
// REPORTED LIVE as "it creates a duplicate of the selector that can be interacted with"
// plus "the tiers no longer change", and both are one fault. The duplicate was an ORPHANED
// control left behind by the corrupted diff, and the visible one was no longer wired to the
// current render's handlers -- so the label and hint above it came from one pass while the
// select came from another, which is why the two disagreed on screen. NOTHING THREW, again:
// this is the third fault on this surface whose only symptom was a live surface behaving
// wrongly with a silent console.
//
// THE RULE, stated so this cannot come back: a cache on a render path may hold DATA -- the
// results of the expensive computation -- and must build fresh vnodes from it every pass.
// Vnode construction is cheap; walking parent chains for every hex, packing regions and
// emitting borders is not, and that is the part worth keeping.
//
// KEYED ON rev + radius + tier + zoom, DELIBERATELY NOT ON x/y, because nothing inside the
// group depends on the pan -- only the <g transform> does.
// ZOOM IS FROZEN FOR THE DURATION OF A GESTURE. Stroke widths and font sizes are
// counter-scaled by k, so a moving k invalidates the geometry on every single pinch event,
// which made this cache useless for exactly the interaction that needed it most. Holding
// the last built k while fingers are down costs strokes that are momentarily a little thick
// or thin mid-pinch, and buys one rebuild per gesture instead of one per event. The release
// settles it (see clearPointer).
var _ceHexGeo: any = { sig: '', kAt: 0, grid: '', fills: null, edges: null, dots: '', labels: null, icons: null };

// [HEX-NODECOUNT] THE FAULT BEHIND THREE FAILED FIXES, AND IT WAS MEASURABLE ALL ALONG BY
// COMPARING THIS SURFACE TO THE ONE NEXT DOOR THAT WORKS.
//
// Section 32 has NO cache, mutates its pan ref inside the store reducer, and keeps its
// pointer bookkeeping in the store -- every pattern v3.7.19 "fixed" here on the theory that
// one of them caused the stutter. It is smooth anyway. It draws ONE CIRCLE PER DRAWN
// LOCATION, with interiors culled unless they are on the focus band: tens of nodes, on a
// world of any size.
//
// This surface drew a polygon for EVERY CELL IN THE RADIUS whether or not anything was on
// it, a dot for every cell holding something deeper, and a separate <line> for every border
// edge. At radius 6 that is ~500 SVG nodes re-diffed on every pointermove; at radius 10 it
// is ~1300. No amount of caching the arithmetic helps, because the arithmetic was never the
// cost -- v3.7.19 and v3.7.20 both optimised the wrong half and the symptom did not move.
//
// THE FIX IS TO DRAW THE SAME PICTURE WITH THE SAME NODE COUNT AS THE CIRCLE MAP. A path's
// `d` may hold any number of disjoint subpaths, and every cell sharing a fill is one
// subpath of one node:
//     grid outlines      1 path      (was one polygon per cell)
//     fills              <=9 paths   (one per distinct colour actually present)
//     parent borders     1 path      (was one line per edge)
//     own borders        1 path
//     child dots         1 path
//     region labels      a handful of <text>, one per region
// Roughly fifteen nodes at any radius, against five hundred. THE CACHE STAYS, because
// building those strings is the expensive part and pan does not change them -- but it is
// now guarding work that is genuinely worth guarding rather than standing in for this.
function _ceHexCellPath(cx: number, cy: number, corners: any[]): string {
    var d = 'M' + (cx + corners[0].x).toFixed(1) + ',' + (cy + corners[0].y).toFixed(1);
    for (var i = 1; i < 6; i++) {
        d += 'L' + (cx + corners[i].x).toFixed(1) + ',' + (cy + corners[i].y).toFixed(1);
    }
    return d + 'Z';
}


// -- The surface ---------------------------------------------------------------
// panRef/pinchRef are LENT BY _ceMapRoot. See the call site: a useRef in here would
// be a conditional hook.
function _ceMapHexTab(st: any, panRef: any, pinchRef: any): any {
    if (!st || !st.ready) return ceEmpty('Loading\u2026', null);

    var radius: number = Number(st.radius) || 6;
    var hexes: any = st.hexes || {};
    var byId: any = st.byId || {};
    var maxTier: number = Math.max(1, Number(st.maxTier) || 1);
    var tier: number = Math.max(1, Math.min(maxTier, Number(st.tier) || 1));
    var brushN: number = Math.max(0, Math.min(2, (Number(st.brush) || 1) - 1));
    var brushKind: string = String(st.brushKind || 'loc');
    var brushLoc: string = String(st.brushLoc || '');
    var brushPt: number = Number(st.brushPt) || 0;
    var brushHex: string = ceColorAt(brushPt);
    var painting: boolean = !!st.paint;
    var cam: any = st.camera || { x: 0, y: 0, k: 1 };

    if (!st.exists) {
        return ceEmpty('No hex map yet. Choose a size to start one.',
            ceStack({ gap: CE_T.s2 }, [
                ceSelect({ k: 'hexnewr', value: String(radius),
                    options: CE_HEX_RADII.map(function(n: number) {
                        return { id: String(n), label: 'Radius ' + n + '  \u00b7  ' +
                                 ceHexRange(0, 0, n).length + ' cells' };
                    }),
                    onCommit: function(v: string) {
                        ceHexPatch(function() { return { radius: Number(v) || 6 }; });
                        return Promise.resolve();
                    } }),
                ceBtn('Create map', 'hex:new', function() {
                    ceHexWrite({}, radius);
                    ceHexPatch(function() {
                        return { camera: { x: CE_HEX_HOME_X, y: CE_HEX_VIEW_H_PX / 2, k: 1 } };
                    });
                    return Promise.resolve();
                }, 'primary')
            ]));
    }

    // Locations paintable at this tier. EXACT DEPTH, not the resolved view: the guard is
    // about where a record belongs in the tree, which is the one place depth still means
    // what it used to.
    var tierLocs: any[] = [];
    for (var li = 0; li < (st.locs || []).length; li++) {
        // [HEX-VH] A VEHICLE IS OFFERED AT EVERY TIER, because its depth is not a fact about
        // the map -- it is derived from a parent that CHANGES every time the hull sails, so a
        // ship built at the root vanished from this list the moment the level control moved,
        // and a ship that had travelled appeared at a level the author had no reason to be
        // looking at. It does not live in the tier stack at all: `vh` is its own layer and is
        // drawn at every level, so the brush that reaches it is available at every level too.
        if (String((byId[String(st.locs[li].id)] || {}).kind || '') === 'vehicle') {
            tierLocs.push(st.locs[li]);
            continue;
        }
        if (Number(st.locs[li].depth) === tier) tierLocs.push(st.locs[li]);
    }

    // ── PAINTING READS THE LIVE SNAPSHOT, NEVER THE RENDER CLOSURE ──
    // [HEX-RUNAWAY] The v3.7.17 version forked `next` from the render-time `hexes`, so a
    // drag crossing five cells before the next paint produced five forks of the SAME base
    // and kept only the last one. Every mutation now happens inside the patch, against
    // whatever the store holds at that instant, and the record is persisted from the
    // result. The camera is read live for the same reason: a stroke during a pinch would
    // otherwise hit-test against a stale zoom.
    // [MAP-VEHICLE-HEX] A VEHICLE IS ONE HEX AND PAINTING IT MOVES IT.
    // A hull travels, so the question a hex map can answer about it is WHERE IT IS, not what
    // shape it is: keeping the outline of a six-cell ship while it sails means rewriting six
    // cells per move and forbidding a rotation the grid cannot express. One cell moves for
    // free and is exact.
    // ITS INTERIOR IS THE CIRCLE MAP'S, and that is not a consolation. The two maps answer
    // different questions -- the circle says what CONTAINS what, the hex says what is NEXT TO
    // what -- and a ship's cabins are a containment fact. They never wanted to be here.
    // ENFORCED AT THE PAINT, NOT ON THE RECORD. There is no per-vehicle "one hex" flag to go
    // stale, and the map is repaired by the next stroke rather than by a migration.
    function hexIsVehicle(locId: string): boolean {
        var vb: any = byId[String(locId || '')];
        return !!vb && String(vb.kind || '') === 'vehicle';
    }

    function paintAt(px: number, py: number) {
        var saveMe: any = null, savedCam = '';
        // [MAP-VEHICLE-HEX] WHAT THE STROKE PUT A HULL ON, carried out of the reducer so the
        // reparent can run after the save. See the write below for why it is not done inside.
        var vhPaint = '', vhPaintKey = '';
        ceHexPatch(function(s: any) {
            var c = s.camera || { x: 0, y: 0, k: 1 };
            var hit = ceHexFromPixel((px - c.x) / c.k, (py - c.y) / c.k, CE_HEX_SIZE);
            if (!ceHexInMap(hit.q, hit.r, radius)) return {};
            var cells = ceHexBrush(hit.q, hit.r, brushN, radius);
            var cur: any = s.hexes || {};
            var next: any = {}, k: string, changed = false;
            for (k in cur) next[k] = cur[k];
            for (var i = 0; i < cells.length; i++) {
                var ck = ceHexKey(cells[i].q, cells[i].r);
                var cell: any = next[ck] || null;
                var curLoc = String((cell && cell.loc) || '');
                var curPt = Number((cell && cell.pt) || 0);
                // [HEX-VH] THE HULL SURVIVES EVERY REBUILD BELOW. Each branch constructs a
                // FRESH cell object rather than editing this one, so a field none of them
                // mention is a field every stroke deletes -- the same trap camHex fell into
                // one save path over. Recolouring a cell must not sink the ship on it.
                var curVh = String((cell && cell.vh) || '');
                // A var-held closure, not a declaration: this sits inside the cell loop and
                // a named declaration in a block is the one shape this transpiler is least
                // predictable about.
                var keepVh = function(o: any): any { if (curVh) o.vh = curVh; return o; };
                // [HEX-ERASE] ERASE IS AN OPTION ON EACH BRUSH, NOT A MODE OF ITS OWN.
                // Reported live: a single erase mode "nukes the whole cell". It did, and
                // that was wrong, because a hex holds two independent things -- the place
                // it is part of and the colour it was painted -- and wanting one gone has
                // never implied wanting the other gone. A brush that clears exactly what
                // that brush would otherwise have set is the only version where the
                // author can predict the result before lifting a finger. The empty
                // option on each brush IS the eraser for that brush.
                if (brushKind === 'pt') {
                    // COLOUR IS INDEPENDENT OF CONTAINMENT and answers to no guard: a
                    // hex may be coloured before anything is placed in it, and recolouring
                    // never disturbs the location underneath.
                    if (curPt === brushPt) continue;
                    next[ck] = keepVh({ loc: curLoc, pt: brushPt });
                    changed = true;
                    // A cell holding neither is not a cell. Dropped here rather than
                    // stored empty, so PAINTED HEXES ONLY stays true after an erase and a
                    // map that has been cleared costs what an unpainted one costs.
                    if (!curLoc && !brushPt && !curVh) delete next[ck];
                    continue;
                }
                if (!brushLoc) {
                    // The place brush's empty option: clears the place, KEEPS THE COLOUR.
                    // [HEX-VH] AND IT REACHES THE VEHICLE LAYER, which had no eraser at all --
                    // a ship could be put on the map and never taken off it. "Clear" means
                    // nothing is here, and a hull sitting on the cell is something that is
                    // here; clearing one layer and leaving the other would be an eraser that
                    // is silently partial, which is worse than one that takes both.
                    if (!curLoc && !curVh) continue;
                    next[ck] = { loc: '', pt: curPt };
                    changed = true;
                    if (!curPt) delete next[ck];
                    continue;
                }
                // [HEX-VH] A VEHICLE IS PAINTED INTO ITS OWN LAYER, AND BEFORE BOTH GUARDS.
                // Writing a hull into `loc` evicted whatever region owned the cell -- the sea
                // stopped being sea under the ship, and when the ship left, the cell came back
                // empty rather than wet. `vh` sits beside `loc` and `pt` and disturbs neither.
                // THE CONTAINMENT GUARD DOES NOT APPLY TO IT. ceHexCanPaint asks whether one
                // location may sit inside another, which is the right question for the region
                // layer and the wrong one here: a ship is not being nested in the sea, it is
                // being placed ON it, and the hull's containment is written by ceVehicleMove
                // from the cell's own loc. A ship must be able to cross water it does not
                // belong to.
                if (hexIsVehicle(brushLoc)) {
                    var vk: string, vcell: any;
                    for (vk in next) {
                        if (!Object.prototype.hasOwnProperty.call(next, vk)) continue;
                        if (String((next[vk] || {}).vh || '') !== brushLoc) continue;
                        vcell = { loc: String(next[vk].loc || ''), pt: Number(next[vk].pt || 0) };
                        if (!vcell.loc && !vcell.pt) delete next[vk]; else next[vk] = vcell;
                    }
                    next[ck] = { loc: curLoc, pt: curPt, vh: brushLoc };
                    // ONLY WHERE THE PARENT ACTUALLY CHANGES. A stroke is a drag, and a hull
                    // brush dragged across six cells of one sea would otherwise queue six
                    // reparents -- each an index load, a record write and a full republish,
                    // which is the per-event rebuild HEX-RUNAWAY was written about. Comparing
                    // the cell's loc against the parent the projection already carries
                    // collapses that to one write per region crossed, and none at all for a
                    // ship being nudged around inside the water it already belongs to.
                    if (String((byId[brushLoc] || {}).parentId || '') !== curLoc) {
                        vhPaint = brushLoc; vhPaintKey = ck;
                    }
                    changed = true;
                    // ONE CELL, whatever the brush size says. The size control is about how
                    // much ground a region covers and a hull covers one.
                    break;
                }
                if (!ceHexCanPaint(byId, curLoc, brushLoc)) continue;
                if (curLoc === brushLoc) continue;
                next[ck] = keepVh({ loc: brushLoc, pt: curPt });
                changed = true;
            }
            if (!changed) return {};
            saveMe = next;
            savedCam = String(s.camHex || '');
            return { hexes: next, exists: true, rev: Number(s.rev || 0) + 1 };
        });
        // [HEX-CAMERA] camHex RIDES EVERY PAYLOAD THAT REBUILDS THE RECORD. These sites
        // construct a fresh object rather than editing the loaded one, so a field they
        // forget is a field a paint stroke deletes.
        // [MAP-VEHICLE-HEX] PLACING A HULL IS A MOVE, SO IT GOES THROUGH THE ONE WRITER.
        // The stroke wrote where the ship IS; only ceVehicleMove writes what it is IN, and a
        // second reparent here would be the parallel system that rule exists to forbid. Until
        // this ran, a ship painted onto the sea kept whatever parent it was created under --
        // usually root -- so the switch's reading of the hull's parent was meaningless, the
        // containment chain disagreed with the picture, and "the bottom tier of wherever it
        // is" only became true after its first voyage.
        // CHAINED, NOT FIRED ALONGSIDE. ceVehicleMove re-reads the record; racing it against
        // the save above would let it load the map as it was before the stroke.
        if (saveMe) {
            var savedP: any = ceHexSave({ v: 2, radius: radius, hexes: saveMe, camHex: savedCam });
            if (vhPaint && savedP && savedP.then) {
                var vhMoveId = vhPaint, vhMoveKey = vhPaintKey;
                savedP.then(function() { return ceVehicleMove(vhMoveId, '', vhMoveKey); });
            }
        }
    }

    // ── POINTER ──
    // [HEX-RUNAWAY] TWO FAULTS, ONE SYMPTOM ("panning can slow and start to runaway,
    // continuing on its own and not responding"):
    //
    //   1. THE REF WAS MUTATED INSIDE THE STORE REDUCER. panRef.current.lastX was being
    //      advanced from within the function handed to store.set, which is not a place a
    //      side effect may live: any re-entrant or repeated invocation counts the same
    //      finger movement twice, and a pan that double-counts accelerates. Deltas are now
    //      computed and the ref advanced BEFORE the patch, so the reducer is pure.
    //   2. EVERY MOVE WROTE THE `down` MAP INTO THE STORE, which repainted the whole grid
    //      for bookkeeping nothing draws. `down` lives on panRef now. The store sees one
    //      write per move -- the camera -- and only when the camera actually moved.
    //
    // The "keeps panning after you stop" was never autonomous motion: it was the queued
    // backlog draining, which is what a per-event full rebuild guarantees under a finger
    // moving at any speed.
    function pDown(): any {
        if (!panRef.current.down) panRef.current.down = {};
        return panRef.current.down;
    }

    function onDown(e: any) {
        var id = String(e.pointerId);
        var down = pDown();
        down[id] = { x: e.clientX, y: e.clientY };
        var ids: string[] = [], k: string;
        for (k in down) ids.push(k);
        if (ids.length === 1) {
            panRef.current.activeId = id;
            panRef.current.lastX = e.clientX;
            panRef.current.lastY = e.clientY;
            // [HEX-SELECT] NO THIRD MODE. A tap that never travelled is a selection; a tap
            // that did is a pan. The threshold is the same one a touch screen needs anyway,
            // because fingers wobble on the way down and a 0px test would make selection
            // the only reachable outcome.
            panRef.current.downX = e.clientX;
            panRef.current.downY = e.clientY;
            panRef.current.moved = false;
        } else if (ids.length === 2) {
            var a = down[ids[0]], b = down[ids[1]];
            pinchRef.current = { ids: [ids[0], ids[1]],
                lastDist: Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2)) };
        }
        if (painting && ids.length === 1) paintAt(e.offsetX, e.offsetY);
    }

    function onMove(e: any) {
        var id = String(e.pointerId);
        var down = pDown();
        if (!(id in down)) return;
        var ids: string[] = [], k: string;
        for (k in down) ids.push(k);

        if (ids.length >= 2 && pinchRef.current.ids.length === 2) {
            var idA = pinchRef.current.ids[0], idB = pinchRef.current.ids[1];
            var a = (id === String(idA)) ? { x: e.clientX, y: e.clientY } : down[idA];
            var b = (id === String(idB)) ? { x: e.clientX, y: e.clientY } : down[idB];
            down[id] = { x: e.clientX, y: e.clientY };
            if (!a || !b) return;
            var dist = Math.sqrt(Math.pow(a.x - b.x, 2) + Math.pow(a.y - b.y, 2));
            var last = pinchRef.current.lastDist;
            pinchRef.current.lastDist = dist;
            if (last <= 0) return;
            var f = dist / last;
            // ANCHORED AT THE FINGERS. clientX is a page coordinate and offsetX a container
            // one; only the DIFFERENCE between the two fingers is used, so the unknown
            // container origin cancels and the midpoint is recovered from the one finger
            // whose offset this event carries. See the section header for why this is
            // achievable here and not on the circle map.
            var ax = e.offsetX + ((id === String(idA)) ? (b.x - a.x) / 2 : (a.x - b.x) / 2);
            var ay = e.offsetY + ((id === String(idA)) ? (b.y - a.y) / 2 : (a.y - b.y) / 2);
            ceHexPatch(function(s: any) {
                var newK = Math.max(CE_HEX_MIN_K, Math.min(CE_HEX_MAX_K, s.camera.k * f));
                if (newK === s.camera.k) return {};
                return { camera: { x: ax - newK * (ax - s.camera.x) / s.camera.k,
                                   y: ay - newK * (ay - s.camera.y) / s.camera.k, k: newK } };
            });
            return;
        }

        down[id] = { x: e.clientX, y: e.clientY };
        if (String(panRef.current.activeId) !== id) return;

        if (painting) { paintAt(e.offsetX, e.offsetY); return; }

        // Delta computed and the ref advanced OUTSIDE the reducer -- fault 1 above.
        if (Math.abs(e.clientX - panRef.current.downX) > CE_HEX_TAP_SLOP
            || Math.abs(e.clientY - panRef.current.downY) > CE_HEX_TAP_SLOP) {
            panRef.current.moved = true;
        }
        var dx = e.clientX - panRef.current.lastX;
        var dy = e.clientY - panRef.current.lastY;
        if (!dx && !dy) return;
        panRef.current.lastX = e.clientX;
        panRef.current.lastY = e.clientY;
        // 1:1 with the finger by construction: one user unit is one CSS pixel here.
        ceHexPatch(function(s: any) {
            return { camera: { x: s.camera.x + dx, y: s.camera.y + dy, k: s.camera.k } };
        });
    }

    // [measured, Section 32] onPointerLeave fires ~4x as often as a real interaction,
    // including plain mouse-outs with nothing held. Nothing here writes the store, so a
    // spurious leave now costs nothing at all rather than a repaint.
    function clearPointer(id: any) {
        var down = pDown();
        var tracked = (String(id) in down);
        delete down[String(id)];
        if (String(panRef.current.activeId) === String(id)) panRef.current.activeId = null;
        pinchRef.current = { ids: [], lastDist: 0 };
        // ONE WRITE PER GESTURE, and only for a pointer that was really being tracked.
        // The zoom is frozen while fingers are down (see _ceHexGeo), so something has to
        // ask for the settling render once they lift -- and nothing else will, because
        // this handler deliberately writes no state otherwise. The tracked check is what
        // keeps the measured 4:1 flood of spurious pointerleaves from turning into a
        // flood of repaints.
        if (tracked) ceHexPatch(function(s: any) { return { gest: Number(s.gest || 0) + 1 }; });
    }

    // ── GEOMETRY, CACHED AS PATH DATA ──
    // See _ceHexGeo for why this is paths and not nodes. The cache holds STRINGS; vnodes
    // are built fresh below, because a mounted vnode may never be diffed twice.
    var k = cam.k || 1;
    var gesturing = !!(panRef.current.activeId
                       || (pinchRef.current.ids && pinchRef.current.ids.length));
    var kUse = (gesturing && _ceHexGeo.kAt) ? Number(_ceHexGeo.kAt) : k;
    var selKey: string = String(st.sel || '');
    // [HEX-CAMERA] WHICH HEX THE CAMERA STANDS IN. Exact match first, then containment:
    // the camera may be in a room that was never given a hex of its own while the house
    // around it has six, and "somewhere in the house" is the true answer there rather than
    // nowhere. Deterministic on ties -- sorted, first wins -- so the marker does not hop
    // between equally valid hexes from one render to the next.
    var camLoc: string = String(st.camLocId || '');
    var camKey = '';
    // [HEX-CAMERA] THE EXACT CELL, WHEN ONE WAS CHOSEN. Travel names a LOCATION, and a
    // location can hold thirty hexes -- so resolving the marker by scanning for the first
    // cell with that loc put the camera on whichever key sorted first, which is the top-right
    // of the region and not where the author tapped. The chosen cell is remembered on the map
    // record (camHex) and wins whenever it still belongs to the place the camera is in.
    // IT IS VERIFIED, NOT TRUSTED. A remembered cell can be repainted, erased or resized away
    // while the camera stays put, so it is only used when the cell still resolves to the
    // camera's location; otherwise the scan below answers as it always did.
    var camPin = String((st as any).camHex || '');
    if (camLoc && camPin && hexes[camPin]) {
        // [HEX-VH] THE PIN IS VALID IF EITHER LAYER OF THAT CELL STILL ANSWERS FOR THE CAMERA.
        // A traveller who boarded a ship is standing on a cell whose `loc` is the sea and whose
        // `vh` is the hull, and only the second one is in their chain.
        var pinVh = String((hexes[camPin] || {}).vh || '');
        var pinLoc = String((hexes[camPin] || {}).loc || '');
        var pinUp = ceHexChain(byId, camLoc);
        if (pinVh === camLoc || pinLoc === camLoc
            || (pinVh && pinUp.indexOf(pinVh) >= 0)
            || (pinLoc && pinUp.indexOf(pinLoc) >= 0)) {
            camKey = camPin;
        }
    }
    // [HEX-VH] ONE RESOLVER, NOT A SECOND SCAN. This was a hand-rolled copy that predated the
    // vehicle layer and only ever looked at `loc` -- so boarding a ship put the camera marker
    // on the sea beneath it, which is the reported "it shows the next lowest layer". ceHexOf
    // answers for both layers and is what the pricer already uses, so the marker and the price
    // cannot disagree about where the camera is.
    if (camLoc && !camKey) { camKey = ceHexOf(hexes, byId, camLoc); }
    var sig = String(st.rev) + '|' + radius + '|' + tier + '|' + kUse.toFixed(3)
              + '|' + selKey + '|' + camKey;

    if (_ceHexGeo.sig !== sig || _ceHexGeo.fills === null) {
        var layerG = ceHexLayer(hexes, byId, tier);
        var parentG = (tier > 1) ? ceHexLayer(hexes, byId, tier - 1) : null;
        var corners = ceHexCorners(CE_HEX_SIZE);
        var gGrid = '', gDots = '';
        // Keyed by the fill it paints, so every cell of one colour joins one subpath.
        var fillMap: any = {}, fillOrder: string[] = [];
        var q: number, r: number, gi: number;
        for (q = -radius; q <= radius; q++) {
            var rA = Math.max(-radius, -q - radius), rB = Math.min(radius, -q + radius);
            for (r = rA; r <= rB; r++) {
                var key = ceHexKey(q, r);
                var cell: any = hexes[key] || null;
                var shown = layerG[key] || '';
                var p = ceHexToPixel(q, r, CE_HEX_SIZE);
                var sub = _ceHexCellPath(p.x, p.y, corners);
                gGrid += sub;
                var pc = ceColorAt(Number((cell && cell.pt) || 0));
                // [HEX-LOCCOLOR] The painted terrain wins the fill where there is one; where
                // there is not, the place tints itself faintly rather than everything
                // sharing one grey. Both are subpaths of a per-colour path, so distinct
                // colours cost nodes only in the count of colours ACTUALLY PRESENT.
                var fk = pc ? (pc + '|0.55')
                            : (shown ? (ceHexLocColor(byId, shown) + '|0.14') : '');
                if (fk) {
                    if (!fillMap[fk]) { fillMap[fk] = ''; fillOrder.push(fk); }
                    fillMap[fk] += sub;
                }
                // [HEX-ADJACENT] A CHILD IS A DOT IN THE MIDDLE -- the hex holds something
                // finer than this view shows. Two half-arcs make a circle inside a path, so
                // every dot on the map is one subpath of one node rather than a node each.
                if (cell && cell.loc && ceHexDepth(byId, String(cell.loc)) > tier) {
                    var dr = 2.5 / kUse;
                    gDots += 'M' + (p.x - dr).toFixed(1) + ',' + p.y.toFixed(1)
                           + 'a' + dr.toFixed(2) + ',' + dr.toFixed(2) + ' 0 1,0 ' + (dr * 2).toFixed(2) + ',0'
                           + 'a' + dr.toFixed(2) + ',' + dr.toFixed(2) + ' 0 1,0 ' + (-dr * 2).toFixed(2) + ',0Z';
                }
            }
        }
        var gFills: any[] = [];
        for (gi = 0; gi < fillOrder.length; gi++) {
            var parts = fillOrder[gi].split('|');
            gFills.push({ key: 'f' + gi, fill: parts[0], op: parts[1], d: fillMap[fillOrder[gi]] });
        }
        // [HEX-ADJACENT] Parent first and fainter, so a fine view still says which larger
        // thing each small region belongs to. A border and not a fill: a fill would have to
        // compose with the palette beneath it, and two translucent layers over an unknown
        // theme ground is a colour nobody chose.
        var gEdges: any[] = [];
        if (parentG) {
            var pb = ceHexBorders(parentG, CE_HEX_SIZE), pd = '';
            for (gi = 0; gi < pb.length; gi++) {
                pd += 'M' + pb[gi].x1.toFixed(1) + ',' + pb[gi].y1.toFixed(1)
                    + 'L' + pb[gi].x2.toFixed(1) + ',' + pb[gi].y2.toFixed(1);
            }
            if (pd) gEdges.push({ key: 'ep', d: pd, stroke: 'currentColor',
                                 o: '0.22', w: String(4 / kUse) });
        }
        // [HEX-LOCCOLOR] OWN-TIER BORDERS ARE GROUPED BY COLOUR, one path each. The border
        // is where the colour does the most work -- a region outlined in its own colour
        // stays legible over painted terrain, where a tinted fill does not.
        var bd = ceHexBorders(layerG, CE_HEX_SIZE);
        var bMap: any = {}, bOrder: string[] = [];
        for (gi = 0; gi < bd.length; gi++) {
            var bc = ceHexLocColor(byId, String(bd[gi].id)) || 'currentColor';
            if (!bMap[bc]) { bMap[bc] = ''; bOrder.push(bc); }
            bMap[bc] += 'M' + bd[gi].x1.toFixed(1) + ',' + bd[gi].y1.toFixed(1)
                      + 'L' + bd[gi].x2.toFixed(1) + ',' + bd[gi].y2.toFixed(1);
        }
        for (gi = 0; gi < bOrder.length; gi++) {
            gEdges.push({ key: 'o' + gi, d: bMap[bOrder[gi]], stroke: bOrder[gi],
                          o: '0.95', w: String(2 / kUse) });
        }

        var gLabels: any[] = [], gIcons: any[] = [];
        // [HEX-VH] THE HULL IS DRAWN PER CELL, not per region, because it IS a cell rather
        // than an extent -- ceHexRegions groups the location layer and a vehicle is not in it.
        // ON TOP OF WHATEVER IS THERE: the region keeps its fill, its border and its name, and
        // the ship is a glyph sitting on it. That is the whole visible point of the separate
        // layer. Drawn at every tier: a ship does not stop existing because the view zoomed
        // out to provinces.
        var vhK: string;
        for (vhK in hexes) {
            if (!Object.prototype.hasOwnProperty.call(hexes, vhK)) continue;
            var vhId = String((hexes[vhK] || {}).vh || '');
            if (!vhId) continue;
            // [MAP-VEHICLE-HEX] A HULL WITH NO ICON IS STILL ON THE MAP. `continue` here drew
            // nothing at all, so a ship whose record simply had a blank icon field was
            // invisible -- and the vehicle layer, which is otherwise working exactly as
            // specified, reads from the map as broken. The fallback is a glyph and not a
            // shape node: it rides the same text path every other emoji icon does, and hulls
            // are counted in ones, so HEX-NODECOUNT is untouched.
            var vhIcon = String((byId[vhId] || {}).icon || '') || CE_HEX_VH_GLYPH;
            var vhP = ceHexParse(vhK);
            var vhXY = ceHexToPixel(vhP.q, vhP.r, CE_HEX_SIZE);
            // [HEX-ICON-ANCHOR] A hull is already a cell, so it only wanted the size half of
            // the rule -- and it wanted it most, being the one mark that IS a single hex.
            gIcons.push({ key: 'vh' + vhK, icon: vhIcon, cx: vhXY.x, cy: vhXY.y,
                          size: Math.max(15 / kUse, CE_HEX_SIZE * CE_HEX_ICON_FILL) });
        }
        var regions = ceHexRegions(layerG, CE_HEX_SIZE);
        for (gi = 0; gi < regions.length; gi++) {
            var rg = regions[gi];
            if (rg.size * kUse < 0.9) continue;
            var rMeta: any = byId[rg.id] || {};
            var rIcon = String(rMeta.icon || '');
            // THE ICON SITS ABOVE THE NAME and both counter-scale, so the pair holds its
            // size and its spacing at every zoom. The name shifts down only when there is a
            // glyph to make room for, so an unillustrated region stays centred.
            //
            // [HEX-ICON] TWO FORMS, AND v3.7.22 DREW ONE OF THEM AS ITS OWN NAME. An icon
            // field holds either an emoji or a library reference like 'svg:castle1', and
            // putting the raw string in a <text> printed "svg:castle1" on the map. ICON-LIB
            // already answers which is which, and ceIconMapGroup already draws the vector
            // form IN MAP UNITS -- explicitly not a nested <svg>, so it is not counter-
            // scaled twice. Emoji keep the text path at CE_MAP_EMOJI_SCALE, which is the
            // same split the circle map makes.
            // THE DESCRIPTOR IS CACHED, NOT THE NODE: ceIconMapGroup returns a vnode, and a
            // mounted vnode may never be diffed twice (HEX-VNODE-REUSE).
            // [HEX-ICON-ANCHOR] Drawn on the anchor CELL, and sized to FILL one. The old
            // 15/kUse was a constant number of screen pixels at every zoom, so zooming in
            // grew the hexes and left the icon the same speck in the middle of them -- the
            // one view where there is room for a picture was the view where it read worst.
            // The floor is a share of the cell in MAP units so it grows with the grid; the
            // counter-scaled term still wins when zoomed OUT, which is what keeps a region
            // legible when its cells are a few pixels across. Whichever is larger, so the
            // mark is never smaller than a cell and never smaller than readable.
            var iSz = Math.max(15 / kUse, CE_HEX_SIZE * CE_HEX_ICON_FILL);
            var iCy = rg.ay - iSz * 0.14;
            if (rIcon) {
                var vecDef = null;
                try { vecDef = ceIconDef(rIcon); } catch (eI) { vecDef = null; }
                if (vecDef) {
                    gIcons.push({ key: 'v' + gi, icon: rIcon, cx: rg.ax,
                                  cy: iCy, size: iSz });
                } else {
                    gLabels.push({ key: 'i' + gi, x: rg.ax.toFixed(1),
                                   y: iCy.toFixed(1),
                                   fs: String(iSz * CE_MAP_EMOJI_SCALE),
                                   op: '1', text: rIcon });
                }
            }
            // UNDER THE MARK RATHER THAN A FIXED NUDGE FROM THE CENTRE. The gap was 7/kUse
            // against an icon that was always 15/kUse; now the icon can be three times that,
            // so the name has to be placed from the icon's own edge or it sits across it.
            gLabels.push({ key: 'l' + gi, x: rg.ax.toFixed(1),
                           y: (rg.ay + (rIcon ? iSz * 0.40 : 0)).toFixed(1),
                           fs: String(12 / kUse), op: '0.86',
                           text: String(rMeta.name || '') });
        }
        // [HEX-CAMERA] AN INSET OUTLINE AT THE HEX EDGE, IN ITS OWN COLOUR. It was a circle
        // through the middle of the cell, which is exactly where the region icon is drawn --
        // the marker and the picture cut through each other and neither read. Moving it to
        // the rim leaves the centre to the icon and the label.
        // IT IS STILL NOT AN OUTLINE OF THE HEX ITSELF: that is what selection means, and
        // two identical marks saying different things is worse than either being subtle. The
        // INSET is the difference, and the colour is the other -- the selection ring is
        // currentColor like every border, and this one is not. Drawn before the selection
        // ring so selecting the camera's own hex still reads.
        if (camKey) {
            var cp = ceHexParse(camKey);
            var cxy = ceHexToPixel(cp.q, cp.r, CE_HEX_SIZE);
            gEdges.push({ key: 'cam',
                d: _ceHexCellPath(cxy.x, cxy.y, ceHexCorners(CE_HEX_SIZE * 0.8)),
                stroke: CE_HEX_CAM, o: '0.95', w: String(3.5 / kUse) });
        }
        // THE SELECTION RING IS A BORDER LIKE ANY OTHER, one more path, drawn last so it
        // reads over both terrain and region outlines.
        if (selKey && hexes[selKey] !== undefined || (selKey && ceHexInMap(
                ceHexParse(selKey).q, ceHexParse(selKey).r, radius))) {
            var sp = ceHexParse(selKey);
            var sxy = ceHexToPixel(sp.q, sp.r, CE_HEX_SIZE);
            gEdges.push({ key: 'sel', d: _ceHexCellPath(sxy.x, sxy.y, corners),
                          stroke: 'currentColor', o: '1', w: String(3 / kUse) });
        }
        _ceHexGeo = { sig: sig, kAt: kUse, grid: gGrid, fills: gFills,
                      edges: gEdges, dots: gDots, labels: gLabels, icons: gIcons };
    }

    // FRESH VNODES EVERY PASS, from cached strings. A mounted vnode may never be diffed a
    // second time -- see HEX-VNODE-REUSE for what that cost when it was tried.
    // [HEXMAP-TODO] Per-hex ICONS do NOT belong in these paths: an icon is its own node
    // (ceIconSvg, ICON-LIB) and adding one per hex would walk straight back into the node
    // count this entry exists to fix. When they land, they want the same treatment the
    // circle map gives interiors -- drawn only for cells in view, or only above a zoom.
    var kids: any[] = [];
    var gd: any = _ceHexGeo, vi: number;
    for (vi = 0; vi < gd.fills.length; vi++) {
        kids.push(h('path', { key: 'hf' + gd.fills[vi].key, d: gd.fills[vi].d,
            fill: gd.fills[vi].fill, 'fill-opacity': gd.fills[vi].op, stroke: 'none' }));
    }
    kids.push(h('path', { key: 'hgrid', d: gd.grid, fill: 'none',
        stroke: CE_LINE, 'stroke-width': String(1 / kUse) }));
    for (vi = 0; vi < gd.edges.length; vi++) {
        kids.push(h('path', { key: 'hb' + gd.edges[vi].key, d: gd.edges[vi].d, fill: 'none',
            stroke: gd.edges[vi].stroke || 'currentColor',
            'stroke-opacity': gd.edges[vi].o, 'stroke-width': gd.edges[vi].w }));
    }
    if (gd.dots) {
        kids.push(h('path', { key: 'hdots', d: gd.dots, fill: 'currentColor',
            'fill-opacity': '0.5', stroke: 'none' }));
    }
    for (vi = 0; vi < (gd.icons || []).length; vi++) {
        var gicn = gd.icons[vi];
        var inode = ceIconMapGroup(gicn.icon, gicn.cx, gicn.cy, gicn.size, 'hi' + gicn.key);
        if (inode) kids.push(inode);
    }
    for (vi = 0; vi < gd.labels.length; vi++) {
        kids.push(h('text', { key: 'hl' + gd.labels[vi].key,
            x: gd.labels[vi].x, y: gd.labels[vi].y,
            'text-anchor': 'middle', 'dominant-baseline': 'middle',
            fill: 'currentColor', 'fill-opacity': gd.labels[vi].op,
            'font-size': gd.labels[vi].fs, 'pointer-events': 'none' }, gd.labels[vi].text));
    }

    // ── CONTROLS ──
    var tierOpts: any[] = [];
    for (var ti = 1; ti <= maxTier; ti++) {
        // The control is already labelled Level; repeating it in every option only
        // narrows the space the numbers have.
        tierOpts.push({ id: String(ti), label: String(ti) });
    }
    // [HEX-ERASE] TWO BRUSHES, EACH WITH ITS OWN EMPTY. See paintAt.
    var kindOpts = [{ id: 'loc', label: 'Place' }, { id: 'pt', label: 'Colour' }];
    var brushOpts = [{ id: '1', label: '1' }, { id: '2', label: '7' }, { id: '3', label: '19' }];
    // SHORT, because this label sits inside a quarter-width control on a phone. "Choose a
    // place..." was longer than the names it was asking about.
    // The empty option is this brush's eraser and says so, briefly -- it sits inside a
    // quarter-width control on a phone.
    var locOpts: any[] = [{ id: '', label: tierLocs.length ? 'clear' : 'none' }];
    for (var lo = 0; lo < tierLocs.length; lo++) {
        locOpts.push({ id: tierLocs[lo].id, label: String(tierLocs[lo].name) });
    }

    // [HEXMAP] FOUR CONTROLS, ONE ROW, LABEL ABOVE EACH. ceSettingRow puts its label beside
    // the control and one row per setting, which is right for a settings list and wrong
    // here: four of them pushed the map itself below the fold on a phone, so every paint
    // began with a scroll. THE MAP IS THE SURFACE; the controls are a strip above it.
    // Not a new primitive -- a local composition of the same tokens, because one strip on
    // one surface is not yet a pattern, and CE-STYLE takes a primitive only when a second
    // caller wants it.
    function ctl(label: string, node: any): any {
        return h('div', { style: { flex: '1 1 0', minWidth: '0', display: 'flex',
                                   flexDirection: 'column', gap: '3px' } },
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, label),
            node);
    }

    var strip = h('div', { style: { display: 'flex', gap: CE_T.s3, alignItems: 'flex-end',
                                    padding: CE_T.s2 + ' 0' } }, [
        ctl('Level', ceSelect({ k: 'hextier', value: String(tier), options: tierOpts,
            onCommit: function(v: string) {
                // The place brush clears with the level -- a location from another level can
                // never legally paint here, so carrying it would leave a brush whose every
                // stroke silently refuses. The COLOUR brush survives: colour answers to no
                // level.
                ceHexPatch(function() { return { tier: Number(v) || 1, brushLoc: '' }; });
                return Promise.resolve();
            } })),
        ctl('Brush', ceSelect({ k: 'hexkind', value: brushKind, options: kindOpts,
            onCommit: function(v: string) {
                ceHexPatch(function() { return { brushKind: String(v || 'loc') }; });
                return Promise.resolve();
            } })),
        ctl('Place', ceSelect({ k: 'hexloc', value: brushLoc, options: locOpts,
            onCommit: function(v: string) {
                ceHexPatch(function() { return { brushLoc: String(v || '') }; });
                return Promise.resolve();
            } })),
        ctl('Size', ceSelect({ k: 'hexbrush', value: String(Number(st.brush) || 1),
            options: brushOpts,
            onCommit: function(v: string) {
                ceHexPatch(function() { return { brush: Number(v) || 1 }; });
                return Promise.resolve();
            } }))
    ]);

    // [HEX-COLORS] THE ROW IS ONE RANGE OF THE PALETTE, NOT A LIST OF WHAT THE MAP HAS USED.
    // The accumulating version it replaces was a thing to keep: it grew as an author painted,
    // it needed a seed so old indices still meant something, and the row's contents differed
    // per map for no reason an author could see. Cells index the shell's palette now, which
    // is fixed and small, so the quick row can simply BE a row of it -- twelve hues at the
    // middle lightness, which is the band terrain is actually painted in.
    // THE FULL GRID IS ONE TAP AWAY and not pinned open, because a grid above the map pushes
    // the map off a phone screen, which is the exact fault the control strip was fixed for.
    // Nothing accumulates and there are no defaults to maintain.
    function hexSwatch(idx: number): any {
        var hexCol = ceColorAt(idx);
        var on = (brushKind === 'pt' && brushPt === idx);
        return h('div', {
            key: 'sw' + idx, role: 'button', tabIndex: 0,
            'aria-label': hexCol || 'No colour',
            onClick: function() {
                ceTap('hex:sw:' + idx, function() {
                    ceHexPatch(function() {
                        return { brushKind: 'pt', brushPt: idx, paint: true };
                    });
                });
            },
            style: { width: '26px', height: '26px', flex: '0 0 auto', cursor: 'pointer',
                     borderRadius: CE_T.r, padding: '6px', margin: '-6px',
                     backgroundColor: hexCol || 'transparent', backgroundClip: 'content-box',
                     border: hexCol ? 'none' : ('1px dashed ' + CE_LINE2),
                     boxShadow: on ? ('0 0 0 2px ' + CE_LINE2) : 'none' }
        });
    }
    var quickBase = CE_HEX_QUICK_LIGHT * CE_COLOR_HUES.length;
    var swatches: any[] = [hexSwatch(0)];
    for (var sw = 1; sw <= CE_COLOR_HUES.length; sw++) swatches.push(hexSwatch(quickBase + sw));

    // CHOOSING IS PAINTING. The commit selects the brush and arms it, and it writes NOTHING
    // to the record -- the brush is a session's aim, and the palette it aims into is a
    // constant. That is the whole of what deleting the per-map table bought here: this used
    // to fork the table, intern a colour, and save the map on a colour tap.
    // A TYPED HEX SNAPS to the nearest swatch (ceColorIdx) and the row shows the result at
    // once, so the snap is visible rather than silent.
    var picker = ceColorPick({
        k: 'hexbrushcol', label: 'Brush colour', value: brushHex, allowNone: false,
        onCommit: function(v: string) {
            if (!v) return;
            ceHexPatch(function() {
                return { brushPt: ceColorIdx(v), brushKind: 'pt', paint: true };
            });
        }
    });

    // ── THE SELECTED CELL ──
    // [HEX-SELECT] THE PANEL IS THE HEX'S, NOT THE VIEW'S. It reports the chain the hex
    // actually holds, in full, regardless of which level is being drawn -- the level is a
    // coarseness dial on the picture and has no business editing the answer to "what is
    // here".
    var selPanel: any = null;
    if (selKey) {
        var selCell: any = hexes[selKey] || null;
        var selLoc = String((selCell && selCell.loc) || '');
        var selChain = selLoc ? ceHexChain(byId, selLoc) : [];
        var pathBits: string[] = [];
        for (var ci = 0; ci < selChain.length; ci++) {
            pathBits.push(String((byId[selChain[ci]] || {}).name || '?'));
        }
        var selName = pathBits.length ? pathBits[pathBits.length - 1] : '';
        // [HEX-VH] THE HULL ON THIS CELL, NAMED SEPARATELY from the place under it. Both are
        // true at once now, which is the arrangement the layer bought: "The Bay" with the
        // Kestrel on it, rather than a cell that used to be the bay and is now a ship.
        var selVh = String((selCell && selCell.vh) || '');
        var selVhName = selVh ? String((byId[selVh] || {}).name || '') : '';
        var selPt = ceColorAt(Number((selCell && selCell.pt) || 0));

        // [SEC:TRAVEL] ONE QUOTE, TAKEN ONCE, read by the face and the line beneath it --
        // the same discipline the map's action bar states, and for the same reason: a face
        // and a breakdown that compute separately eventually disagree.
        // SAFE IN A RENDERER: ceTravelQuote touches no storage.
        var camAt = String(st.camLocId || '');
        // [HEX-CAMERA] "HERE" IS A CELL, NOT A LOCATION, and that correction is the whole of
        // the fix. Gating on the location meant the camera could never move WITHIN one -- a
        // province forty cells across had one position in it, the first key that sorted, and
        // every cell of it reported "the scene is here". The offer is now made whenever the
        // selected CELL is not the camera's, and travelling to another cell of the same place
        // costs and pins exactly like any other journey; ceTravelGo skips the location commit
        // when there is no location change.
        var sameCell = !!selKey && (selKey === camKey);
        var isHere = sameCell;
        var mbOpen = !!(st as any).mbOpen;
        // [MAP-VEHICLE-HEX] THE SWITCH THE CIRCLE MAP HAS, and it was the missing half of the
        // feature: without it every journey from aboard a ship was the traveller walking, and
        // the hull was never asked to move at all. Same store shape and deliberately the same
        // code read against this surface's own byId -- an offer that appeared in places where
        // the ordinary verb is right would teach the author to stop reading it. The
        // EXCLUSIONS are not the same, and the list below says why.
        var hvVeh = ceTravelVehicleOf(byId, camAt);
        var hvName = (hvVeh && byId[hvVeh]) ? String(byId[hvVeh].name || '') : '';
        var hvKey = hvVeh ? ceHexOf(hexes, byId, hvVeh) : '';
        // A VOYAGE WITHIN ONE PLACE IS STILL A VOYAGE -- sailing across the same sea moves the
        // hull -- so this asks for a different CELL, not a different location.
        // THE "ALREADY MOORED THERE" EXCLUSION IS GONE, and keeping it is why the switch was
        // invisible in every world that most needed it. It is right on the circle map, where
        // moving a hull to its own parent is a no-op; here the destination is a CELL, and
        // every other cell of the sea a ship is parented to has `loc === parentId`. Copied
        // across, it hid the switch for exactly the journey the comment above claims to
        // support -- and on a single-region ocean it hid it always.
        // A BLANK CELL IS A DESTINATION TOO, so this asks for a cell and not a location:
        // unpainted water is somewhere a ship can be, and ceVehicleMove roots the hull there.
        // The two real refusals stand -- do not sail a ship into itself or into its own hold.
        // ONE CELL HOLDS ONE HULL, so a cell that already has someone else's is refused
        // rather than sailed into: `vh` is a single field and the carry would overwrite it,
        // taking the moored ship off the map with nothing said. The author moors alongside by
        // choosing the next cell over, which is what a hex map is for.
        var hvCan = !!(hvVeh && selKey && !sameCell && selLoc !== hvVeh
                       && (!selVh || selVh === hvVeh)
                       && !ceTravelInside(byId, selLoc, hvVeh));
        var hvOn = hvCan && (String((st as any).travelVehId || '') === hvVeh);
        // [HEX-VH] ARRIVING ON A HULL BOARDS IT. A vehicle is the bottom layer of its cell and
        // the deepest thing always wins, so stepping onto the cell a ship sits on and landing
        // on the water beside it was the display rule and the travel rule disagreeing. It also
        // left the whole feature unreachable: the switch needs the camera to be ABOARD, and
        // nothing but a separate button ever put it there.
        // DISEMBARKING NEEDS NO VERB. Travelling anywhere with the switch OFF leaves the ship
        // behind, which IS stepping off it.
        var goTo = selVh || selLoc;
        var goName = (selVh ? selVhName : selName) || ('hex ' + selKey);
        var quote: any = null;
        if (goTo && !sameCell) {
            // [TRAVEL-MODE] The hex surface HAS the cells, so it prices in either mode --
            // the same store field the geometry is drawn from, no second read.
            // PRICED FROM THE HULL WHEN THE SWITCH IS ON, exactly as the circle map does:
            // the camera may be three decks down and nobody walks those decks.
            // THE CELLS ARE HANDED OVER, not left to be scanned for: this surface knows both
            // ends exactly. The hull's cell is the origin when the switch is on, for the same
            // reason the circle map prices from the hull -- nobody walks the decks.
            try { quote = ceTravelQuote(st.travelTiers || [], st.travelNodes || [],
                                        hvOn ? hvVeh : camAt, hvOn ? selLoc : goTo,
                                        (st.travelMode === 'hex')
                                            ? { mode: 'hex', hexes: hexes,
                                                fromKey: hvOn ? hvKey : camKey,
                                                toKey: selKey,
                                                mins: st.hexMins, cost: st.hexCost }
                                            : null); }
            catch (eQ) { quote = null; }
        }
        var priced = !!(quote && quote.ok && (quote.cost > 0 || quote.mins > 0));
        var phrase = '';
        if (priced) {
            var qp: string[] = [];
            if (quote.mins > 0) { try { qp.push(ceTravelDuration(quote.mins)); } catch (e2) {} }
            if (quote.cost > 0) qp.push(String(quote.cost));
            phrase = qp.join(', ');
        }

        selPanel = ceStack({ gap: CE_T.s2 }, [
            h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3 } },
                selPt ? h('div', { style: { width: '14px', height: '14px', flex: '0 0 auto',
                    borderRadius: '3px', backgroundColor: selPt } }) : null,
                h('div', { style: { flex: '1 1 auto', minWidth: '0' } },
                    h('div', { style: { fontSize: CE_T.fs } }, selName || 'Empty hex'),
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                        (selVhName ? (selVhName + ' \u00b7 ') : '')
                        + (pathBits.length > 1 ? pathBits.join(' \u203a ') : ('Hex ' + selKey))))),
            // [MAP-INLINE] THE ROW ALWAYS RENDERS, because the create button is the one
            // control an EMPTY hex needs: a world is built by tapping a blank cell and
            // saying what is there. Travel is what is conditional, not the row.
            // NULLS RATHER THAN A SHORTER LIST, per H-01: this list's length must not move.
            ceInline({ gap: CE_T.s2 }, [
                sameCell ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                            'The scene is here.') : null,
                // [HEX-VH] THE HULL IS A PLACE YOU CAN GO. Tapping its cell selects the GROUND
                // -- correctly, since that is what a region brush and a vehicle voyage both act
                // on -- which left the ship itself with no verb: the deeper thing on the cell
                // was the one thing unreachable from it. Boarding is a location change like any
                // other and pins the same cell, so the marker stays where the ship is.
                // NOW ONLY ON THE CAMERA'S OWN CELL. Arriving boards, so everywhere else this
                // button is a second door onto one journey; what it still answers is a hull
                // that was PAINTED onto the cell the camera is already standing in, where
                // there is no journey to make and so nothing to board through.
                (!selVh || selVh === camAt || !sameCell) ? null : ceBtn('Board ' + (selVhName || 'it'),
                    'hex:board:' + selVh, function() {
                        return commitTravel(selVh, true).then(function() {
                            return ceHexSetCam(selKey);
                        }).then(function() {
                            try { api.v1.ui.toast('Scene moved to ' + (selVhName || 'the vehicle') + '.',
                                { type: 'success', autoClose: 1800 }); } catch (eB) {}
                            return cePublishHex();
                        });
                    }),
                // NO KEY, for the reason its twin on the circle map states: H-01 is satisfied
                // by the null branch holding the position, and one keyed child among unkeyed
                // siblings is the mixed-key case that rule warns about.
                !hvCan ? null : h('div', {
                    style: { flex: '0 0 auto', display: 'flex', alignItems: 'center',
                             gap: CE_T.s2 } },
                    ceToggle(hvOn, 'hex:byveh:' + hvVeh, function() {
                        var hvNext = hvOn ? '' : hvVeh;
                        ceHexPatch(function() { return { travelVehId: hvNext }; });
                        return Promise.resolve();
                    }, 'Travel by ' + hvName),
                    h('div', { style: { fontSize: CE_T.fs, whiteSpace: 'nowrap' } }, hvName)),
                (sameCell || (!goTo && !hvOn)) ? null : ceBtn(priced ? 'Skip the journey' : 'Travel here',
                    'hex:travel:' + (selKey || selLoc), function() {
                        // [MAP-VEHICLE-HEX] THE FREE VERB READS THE SWITCH TOO, and its not
                        // doing so is why the toggle appeared to do nothing: in a world that
                        // has priced no tiers this is the ONLY button on the bar, so every
                        // journey went through the walking path and the hull was never asked
                        // to move. A switch that changes one of two buttons is a switch that
                        // is off half the time without saying so.
                        // [HEX-CAMERA] commitTravel ONLY WHERE THE LOCATION CHANGES. Moving to
                        // another cell of the place you are already in is a real move of the
                        // camera and not a move of the scene; re-committing would re-fire
                        // auto-triggers over a scene that did not go anywhere.
                        var mv: any;
                        if (hvOn) { mv = ceVehicleMove(hvVeh, selLoc, selKey); }
                        else if (goTo && goTo !== camAt) { mv = commitTravel(goTo, true); }
                        else { mv = Promise.resolve(true); }
                        return mv.then(function() {
                            return ceHexSetCam(selKey);
                        }).then(function() {
                            try { api.v1.ui.toast(hvOn
                                ? (hvName + ' moved to ' + (selName || 'open ground') + '.')
                                : ('Scene moved to ' + goName + '.'),
                                { type: 'success', autoClose: 1800 }); } catch (e3) {}
                            return cePublishHex();
                        });
                    }, priced ? '' : 'primary'),
                ((!goTo && !hvOn) || sameCell || !priced) ? null : ceBtn('Travel \u2014 ' + phrase,
                    'hex:travelpay:' + (selKey || selLoc), function() {
                        // THE SAME VERB THE MAP USES. Two surfaces that priced one journey
                        // through different code would eventually quote different numbers,
                        // and the author would be right to trust neither.
                        // THE VOYAGE WHEN THE SWITCH IS ON, otherwise the walk. Same two verbs
                        // the circle map offers, so a journey costs the same from either map.
                        return (hvOn ? ceTravelVehicleGo(hvVeh, selLoc,
                                                         { fromKey: hvKey, toKey: selKey })
                                     : ceTravelGo(goTo, { fromKey: camKey, toKey: selKey }))
                          .then(function(rv: any) { return ceHexSetCam(selKey).then(function() { return rv; }); })
                          .then(function(rv: any) {
                            try {
                                var bits: string[] = [];
                                if (rv.mins > 0) bits.push(ceTravelDuration(rv.mins) + ' on the road');
                                if (rv.spent > 0) bits.push(String(rv.spent) + ' ' + String(rv.resName || 'spent'));
                                if (rv.short > 0) bits.push(String(rv.short) + ' short');
                                api.v1.ui.toast(rv.moved
                                    ? ('Reached ' + String(rv.name || goName)
                                       + (bits.length ? ' \u2014 ' + bits.join(', ') : '') + '.')
                                    : ('Could not reach ' + selName + '.'),
                                    { type: !rv.moved ? 'error' : ((rv.short > 0) ? 'warning' : 'success'),
                                      autoClose: 3200 });
                            } catch (e4) {}
                            return cePublishHex();
                        });
                    }),
                // [MAP-INLINE] THE TWO DOORS, straight off the circle map's action bar --
                // same verbs, same LABELS and the same back address, so returning lands on
                // whichever map tab was open. '+ Location' rather than '+ Place': the record
                // type is a location, every other surface calls it one, and a second noun for
                // one thing is a vocabulary an author has to translate.
                // CREATION NESTS UNDER THE SELECTED LOCATION when there is one, and at the
                // top of the world when the hex is blank -- ceEntityCreate's own rule.
                !selLoc ? null : ceBtn('Edit location', 'hex:edit:' + selLoc, function() {
                    ceNav('entity', selLoc, '',
                          { surface: 'map', entityId: '', label: 'World' });
                    return Promise.resolve();
                }),
                ceBtn('+ Location', 'hex:newloc', function() {
                    return ceEntityCreate('location', selLoc,
                                          { surface: 'map', entityId: '', label: 'World' });
                })
            ]),
            // [MAP-INLINE] THE THIRD HOST, AND THE ONE THE FEATURE WAS ASKED FOR. Setting a
            // place up while looking at the map is the whole point: the loop was map, profile,
            // drill, back, map, next location, and this removes the last hop of it.
            // FROM THE PROJECTION, not a record: byId already carries the three fields the
            // block writes, and this is a renderer, which cannot load one.
            // ITS OWN STORE FLAG, NOT ceAccordion. Two reasons, and both were live faults:
            // ceAccordion's content prop is `children` and was passed as `body`, so the header
            // drew and the contents were dropped on the floor; and its open state lives in
            // ceUiStore, which this surface does not subscribe to, so the header would not
            // have opened even had the contents been wired. ceHexStore IS subscribed here.
            // COLLAPSED BY DEFAULT: the icon picker is a hundred swatches under a panel that
            // is already under the map.
            !selLoc ? null : ceBtn((mbOpen ? '\u2212 ' : '+ ') + 'On the map', 'hex:mapblock',
                function() {
                    ceHexPatch(function(s: any) { return { mbOpen: !s.mbOpen }; });
                    return Promise.resolve();
                }),
            (!selLoc || !mbOpen) ? null : h(_ceEntityMapBlock, {
                key: 'hex_mapblock', id: selLoc, terse: true, quiet: gesturing,
                ent: { mapKind: String((byId[selLoc] || {}).kind || ''),
                       icon: String((byId[selLoc] || {}).icon || ''),
                       mapColor: String((byId[selLoc] || {}).color || '') }
            })
        ]);
    }

    // [HEX-AUTO] THE DIAL HAS THE SAME STOPS THE TIER DIAL HAS, and 'Every level' is a
    // stop rather than a separate mode: HEX-TIER-SCALE's rule is that a level is a number
    // because a guessed noun is not honest, and this control inherits it rather than
    // inventing a second vocabulary for depth.
    var autoCapOpts: any[] = [{ id: '0', label: 'Every level' }];
    for (var aci = 1; aci <= maxTier; aci++) {
        autoCapOpts.push({ id: String(aci), label: 'Down to level ' + aci });
    }

    // [HEX-AUTO] ONE DOOR FOR EVERY CONTROL IN THE BLOCK. Preview, Reroll and each option
    // change press this; only Apply touches storage.
    // autoBack IS THE BASE, NOT THE LAST PREVIEW. Rerolling from the previous roll would
    // make "Keep what is placed" compound -- every roll locking the one before it until the
    // dice stopped mattering -- so each run starts from the map the author actually has.
    // GENERATION IS INSIDE THE PATCH, exactly as the resize control's is: it reads radius,
    // byId and the cells from the store at that instant rather than from this render's
    // closure, which is the HEX-RUNAWAY rule about stale forks one surface over.
    var autoRun = function(mode: string): Promise<any> {
        var seed = 0;
        if (mode === 'reroll') {
            try { seed = api.v1.random.int(1, 2147483000); }
            catch (eR) { seed = (Date.now() % 2147483000) + 1; }
        }
        ceHexPatch(function(s: any) {
            if (mode === 'refresh' && !s.autoPrev) return {};
            var back = s.autoBack || s.hexes || {};
            var sd = seed || Number(s.autoSeed) || 1;
            var res: any = null;
            try {
                res = ceHexAutoFill(back, s.byId || {}, Number(s.radius) || 6, {
                    cap: Number(s.autoCap) || Math.max(1, Number(s.maxTier) || 1),
                    spread: String(s.autoSpread || 'islands'),
                    room: String(s.autoRoom || 'balanced'),
                    shape: String(s.autoShape || 'natural'),
                    keep: !!s.autoKeep, seed: sd });
            } catch (eA) {
                api.v1.error('[AE:hex] auto-fill failed:', eA);
                return { autoNote: 'The fill could not be built. Nothing was changed.' };
            }
            // A REFUSAL REPORTS BOTH NUMBERS AND CHANGES NOTHING. The author's next move is
            // a bigger map or a shallower fill, and neither is a guess this can make.
            if (!res.ok) {
                return { autoSeed: sd, autoNote: (res.why === 'empty')
                    ? 'There are no locations to place yet.'
                    : ('This world needs about ' + res.need + ' cells and the map has '
                       + res.have + '. Grow the map, or fill to a shallower level.') };
            }
            return { autoBack: back, hexes: res.hexes, autoPrev: true, autoSeed: sd,
                     sel: '', rev: Number(s.rev || 0) + 1,
                     autoNote: 'Preview \u2014 ' + res.cells + ' cells placed'
                         + (res.unplaced
                             ? ('; ' + res.unplaced + ' had no room left. ')
                             : '. ')
                         + 'Nothing is saved until you apply it.' };
        });
        return Promise.resolve();
    };

    return ceStack({ gap: CE_T.s2 }, [
        strip,
        brushKind === 'pt' ? ceStack({ gap: CE_T.s2 }, [
            ceInline({ gap: CE_T.s3 }, swatches),
            picker
        ]) : null,
        h('div', {
            style: { position: 'relative', width: '100%', height: CE_HEX_VIEW_H, overflow: 'hidden',
                borderRadius: CE_T.r, border: '1px solid ' + CE_LINE, background: CE_FILL,
                touchAction: 'none', cursor: painting ? 'crosshair' : 'grab' },
            onPointerDown: onDown,
            onPointerMove: onMove,
            onPointerUp: function(e: any) {
                // Selection resolves HERE and not in clearPointer, because only the real
                // pointerup carries offsetX -- and the measured 4:1 flood of spurious
                // pointerleaves must never be able to move the selection.
                if (!painting && !panRef.current.moved
                    && String(panRef.current.activeId) === String(e.pointerId)) {
                    var sx = e.offsetX, sy = e.offsetY;
                    ceHexPatch(function(s: any) {
                        var c = s.camera || { x: 0, y: 0, k: 1 };
                        var hitS = ceHexFromPixel((sx - c.x) / c.k, (sy - c.y) / c.k, CE_HEX_SIZE);
                        if (!ceHexInMap(hitS.q, hitS.r, radius)) return { sel: '' };
                        var kS = ceHexKey(hitS.q, hitS.r);
                        // Tapping the selected hex again clears it, so there is a way out
                        // that does not require finding empty ground.
                        return { sel: (String(s.sel || '') === kS) ? '' : kS };
                    });
                }
                clearPointer(e.pointerId);
            },
            onPointerCancel: function(e: any) { clearPointer(e.pointerId); },
            onPointerLeave: function(e: any) { clearPointer(e.pointerId); }
        },
            h('svg', {
                // NO viewBox: one user unit is one CSS pixel, which is what makes offsetX a
                // usable hit-test coordinate. pointerEvents:'none' forces target ===
                // currentTarget on every event. See the section header for both.
                style: { width: '100%', height: '100%', display: 'block', pointerEvents: 'none' }
            },
                h('g', { transform: 'translate(' + cam.x + ',' + cam.y + ') scale(' + cam.k + ')' },
                    kids)
            )
        ),
        ceInline({ gap: CE_T.s2 }, [
            ceBtn(painting ? 'Painting' : 'Panning', 'hex:mode', function() {
                ceHexPatch(function(s: any) { return { paint: !s.paint }; });
                return Promise.resolve();
            }, painting ? 'primary' : undefined),
            ceBtn('\u2212', 'hex:zoomout', function() {
                ceHexPatch(function(s: any) {
                    return { camera: { x: s.camera.x, y: s.camera.y,
                                       k: Math.max(CE_HEX_MIN_K, s.camera.k * 0.8) } };
                });
                return Promise.resolve();
            }),
            ceBtn('+', 'hex:zoomin', function() {
                ceHexPatch(function(s: any) {
                    return { camera: { x: s.camera.x, y: s.camera.y,
                                       k: Math.min(CE_HEX_MAX_K, s.camera.k * 1.25) } };
                });
                return Promise.resolve();
            }),
            ceBtn('Origin', 'hex:origin', function() {
                // Not truly centred: the container width is not measurable here (see the
                // header), so the origin lands at a fixed inset -- stable and predictable
                // rather than correct.
                ceHexPatch(function() {
                    return { camera: { x: CE_HEX_HOME_X, y: CE_HEX_VIEW_H_PX / 2, k: 1 } };
                });
                return Promise.resolve();
            }),
            // [HEX-CAMERA] BRINGS THE CAMERA'S HEX TO THE SAME PLACE Origin puts 0,0, for
            // the same reason: the container width cannot be measured, so this is a
            // reliable "put it where I can see it" rather than a true centring. Offered
            // only when there IS such a hex -- a button that does nothing most of the time
            // teaches the author to stop reading the row.
            !camKey ? null : ceBtn('Find camera', 'hex:findcam', function() {
                var fp = ceHexParse(camKey);
                var fxy = ceHexToPixel(fp.q, fp.r, CE_HEX_SIZE);
                ceHexPatch(function(s: any) {
                    var fk2 = s.camera.k || 1;
                    return { camera: { x: CE_HEX_HOME_X - fk2 * fxy.x,
                                       y: CE_HEX_VIEW_H_PX / 2 - fk2 * fxy.y, k: fk2 } };
                });
                return Promise.resolve();
            })
        ]),
        // ── SIZE AND START OVER ──
        // Armed rather than immediate, following the pattern the image-slot surface uses:
        // the store names WHAT is armed rather than holding a boolean, so two dangerous
        // controls can share one key and neither can be armed at the same time as the
        // other.
        String(st.confirm || '') === 'resize'
            ? ceInline({ gap: CE_T.s2 }, [
                h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', flex: '1 1 auto' } },
                    'Growing keeps everything. Shrinking drops hexes outside the new edge.'),
                ceSelect({ k: 'hexsize', value: String(radius),
                    options: CE_HEX_RADII.map(function(n: number) {
                        return { id: String(n), label: 'r' + n }; }),
                    onCommit: function(v: string) {
                        var nr = Number(v) || 6;
                        ceHexPatch(function(s: any) {
                            var keep: any = {}, kk2: string;
                            for (kk2 in (s.hexes || {})) {
                                var pp = ceHexParse(kk2);
                                if (ceHexInMap(pp.q, pp.r, nr)) keep[kk2] = s.hexes[kk2];
                            }
                            ceHexSave({ v: 2, radius: nr, hexes: keep,
                                        camHex: String(s.camHex || '') });
                            return { hexes: keep, radius: nr, confirm: '', sel: '',
                                     rev: Number(s.rev || 0) + 1 };
                        });
                        return Promise.resolve();
                    } }),
                ceBtn('Done', 'hex:size:done', function() {
                    ceHexPatch(function() { return { confirm: '' }; });
                    return Promise.resolve();
                })
            ])
            : (String(st.confirm || '') === 'reset'
                ? ceInline({ gap: CE_T.s2 }, [
                    h('div', { style: { fontSize: CE_T.fsSm, flex: '1 1 auto' } },
                        'Clear every painted hex?'),
                    ceBtn('Clear it', 'hex:reset:yes', function() {
                        ceHexPatch(function(s: any) {
                            ceHexSave({ v: 2, radius: s.radius, hexes: {} });
                            return { hexes: {}, confirm: '', sel: '',
                                     rev: Number(s.rev || 0) + 1 };
                        });
                        return Promise.resolve();
                    }, 'danger'),
                    ceBtn('Keep it', 'hex:reset:no', function() {
                        ceHexPatch(function() { return { confirm: '' }; });
                        return Promise.resolve();
                    })
                ])
                : (String(st.confirm || '') === 'auto'
                    // [HEX-AUTO] ARMED LIKE THE OTHER TWO, and it shares their one `confirm`
                    // key for the reason stated above them: three dangerous controls, one
                    // slot, so no two can be open at once.
                    ? ceStack({ gap: CE_T.s2 }, [
                        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
                            String(st.autoNote || '')
                            || 'Lays every location out at once. Preview it first \u2014 saving cannot be undone.'),
                        ceInline({ gap: CE_T.s2 }, [
                            ceSelect({ k: 'hexautocap', label: 'Depth',
                                value: String(Number(st.autoCap) || 0), options: autoCapOpts,
                                onCommit: function(v: string) {
                                    ceHexPatch(function() { return { autoCap: Number(v) || 0 }; });
                                    return autoRun('refresh');
                                } }),
                            ceSelect({ k: 'hexautospread', label: 'Below the top level',
                                value: String(st.autoSpread || 'islands'),
                                options: [{ id: 'islands', label: 'Islands' },
                                          { id: 'bordered', label: 'Bordered' }],
                                onCommit: function(v: string) {
                                    ceHexPatch(function() { return { autoSpread: v }; });
                                    return autoRun('refresh');
                                } })
                        ]),
                        ceInline({ gap: CE_T.s2 }, [
                            ceSelect({ k: 'hexautoroom', label: 'Breathing room',
                                value: String(st.autoRoom || 'balanced'),
                                options: [{ id: 'packed', label: 'Packed' },
                                          { id: 'balanced', label: 'Balanced' },
                                          { id: 'sparse', label: 'Sparse' }],
                                onCommit: function(v: string) {
                                    ceHexPatch(function() { return { autoRoom: v }; });
                                    return autoRun('refresh');
                                } }),
                            ceSelect({ k: 'hexautoshape', label: 'Shape',
                                value: String(st.autoShape || 'natural'),
                                options: [{ id: 'blobby', label: 'Round' },
                                          { id: 'natural', label: 'Natural' },
                                          { id: 'sprawling', label: 'Sprawling' }],
                                onCommit: function(v: string) {
                                    ceHexPatch(function() { return { autoShape: v }; });
                                    return autoRun('refresh');
                                } }),
                            ceSelect({ k: 'hexautokeep', label: 'Painted hexes',
                                value: st.autoKeep ? 'keep' : 'replace',
                                options: [{ id: 'keep', label: 'Keep them' },
                                          { id: 'replace', label: 'Replace them' }],
                                onCommit: function(v: string) {
                                    ceHexPatch(function() { return { autoKeep: (v === 'keep') }; });
                                    return autoRun('refresh');
                                } })
                        ]),
                        // NULL RATHER THAN A SHORTER LIST, per H-01: this row's length must
                        // not move when the preview arrives.
                        ceInline({ gap: CE_T.s2 }, [
                            ceBtn(st.autoPrev ? 'Reroll' : 'Preview', 'hex:auto:run', function() {
                                return autoRun(st.autoPrev ? 'reroll' : 'preview');
                            }, st.autoPrev ? '' : 'primary'),
                            !st.autoPrev ? null : ceBtn('Apply', 'hex:auto:apply', function() {
                                ceHexPatch(function(s: any) {
                                    // [HEX-CAMERA] camHex RIDES THE PAYLOAD. This site builds
                                    // a fresh record, so a field it forgets is a field the
                                    // fill deletes.
                                    ceHexSave({ v: 2, radius: Number(s.radius) || 6,
                                                hexes: s.hexes,
                                                camHex: String(s.camHex || '') });
                                    return { autoBack: null, autoPrev: false, confirm: '',
                                             autoNote: '' };
                                });
                                try { api.v1.ui.toast('The map was laid out.',
                                    { type: 'success', autoClose: 1800 }); } catch (eT2) {}
                                return Promise.resolve();
                            }, 'primary'),
                            ceBtn(st.autoPrev ? 'Discard' : 'Close', 'hex:auto:cancel', function() {
                                ceHexPatch(function(s: any) {
                                    var b = s.autoBack;
                                    if (!b) return { confirm: '', autoNote: '', autoPrev: false };
                                    return { hexes: b, autoBack: null, autoPrev: false,
                                             confirm: '', autoNote: '', sel: '',
                                             rev: Number(s.rev || 0) + 1 };
                                });
                                return Promise.resolve();
                            })
                        ])
                    ])
                    : ceInline({ gap: CE_T.s2 }, [
                        ceBtn('Size \u2014 r' + radius, 'hex:size', function() {
                            ceHexPatch(function() { return { confirm: 'resize' }; });
                            return Promise.resolve();
                        }),
                        ceBtn('Auto-fill', 'hex:auto', function() {
                            ceHexPatch(function() {
                                return { confirm: 'auto', autoNote: '', autoPrev: false,
                                         autoBack: null };
                            });
                            return Promise.resolve();
                        }),
                        ceBtn('Start over', 'hex:reset', function() {
                            ceHexPatch(function() { return { confirm: 'reset' }; });
                            return Promise.resolve();
                        })
                    ]))),
        selPanel,
        st.note ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3 } }, String(st.note)) : null
    ]);
}

// ============================================================================
// SECTION 33 — CHAT SURFACE (jsx)
// The chat LAUNCHER and the chat-in-progress CONTROLS in one surface: who you are texting,
// who you are texting AS, per-thread message counts, display options, and
// Close / Summarize / Delete while a chat is live.
//
// RENDER ORDER (set at the bottom of ceChatBody): open-chat controls, "Text as", "To",
// last thought, Options. The numbered section comments inside that function mark where
// each block is CONSTRUCTED, which is a different order and deliberately not renumbered.
//
// POV IS PERSISTED (cfg.charChatPovId), not store state. It used to reset to "No POV" on
// every mount, so every chat cost a pick even though the answer is nearly always the same.
// Persisting it is also what makes the Profile launcher's Chat cell one-tap: nothing left
// to ask, so that path skips this surface. cfg is the single owner; the store's povId is a
// published COPY.
//
// AVATAR SIZE AND SHAPE ARE ENGINE SETTINGS. The engine authors the avatar WIDGET, so it
// chooses that widget's content, so it can write display INTO the sentinel and the bridge
// paints what it is told -- engine-is-source / bridge-is-renderer, not a mirror. Changing
// either RE-EMITS the widgets for a live chat: sentinels already in the document carry the
// old values and would not update until the next turn.
//
// MESSAGE COUNTS PARTITION BY (contactId, povId) EXACTLY, including the empty-string
// normalisation on povId, which is the engine's own "one chat per pair" rule and what stops
// an interview thread leaking into the No POV bucket. Counts come from
// listCharChatThreads() -- one source, no new message pair.
//
// THE CONVERSATION LIVES IN THE STORY DOCUMENT, on native Send. Hard rule, not a phase:
// CharChat costs zero script budget precisely because it rides native Send, and there is no
// preventDefault in this environment to build a composer with.
//
// THE SUMMARY SCREEN IS A FULL SURFACE SWAP (JSXPROFILE-NO-OVERLAY). Its draft rides the
// module variable _ceChatSummaryDraft, not store state: Save reads a value the field
// commits on blur -- the CLICK-BEFORE-BLUR shape -- and a store write would remount the
// textarea mid-typing.
//
// DELETE IS TWO CONTROLS, NEVER ONE THAT CHANGES ITS MIND (DESTRUCTIVE-NEVER-IN-PLACE).
// The armed state renders a SEPARATE control that did not exist at the first tap.
// ============================================================================

var ceChatStore: any = null;
function ceChatStoreInit(): void {
    if (ceChatStore) return;
    try {
        ceChatStore = createStore({
            ready: false, povId: '', roster: [], threads: [],
            freshThoughts: false, images: false,
            delThread: '', delThreadName: '',
            avSize: 40, avShape: 'round',
            // [CHAT-BUBBLE-AXES] null until the first publish; every reader below
            // guards, so a pre-publish render shows the block with no controls rather than
            // throwing on a missing axis.
            bubLook: null,
            active: false, contactId: '', contactName: '', lastThought: '', note: '',
            // [CC-THOUGHT-EDIT] Armed state for Clear, cleared with the chat exactly as
            // confirmDel is -- a chat that ended while the confirm was up must not leave a live
            // destructive control standing over nothing.
            confirmThought: false,
            // '' = no summary screen. summaryGen is the ceField re-seed token: a SECOND
            // summarize has to replace the textarea's contents, and FIELD-KEYLESS says that
            // is a `seed` change, not a component key bump.
            summary: '', summaryGen: 0,
            confirmDel: false
        });
    } catch (e) { api.v1.error('[AE:jsxchat] store init failed:', e); }
}

function ceChatPatch(fn: (s: any) => any): void {
    if (!ceChatStore) return;
    try {
        ceChatStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxchat] patch failed:', e); }
}

// OP-CHAIN, same reasoning as the Journal's and the image slots': every write below is
// load-modify-persist against GlobalConfig with no compare-and-swap, so two taps landing
// close together would silently discard one.
// ONE STANDING HAZARD, stated because the shape invites it: cePublishChat MUST NOT be
// wrapped in ceChatOp. Callers run it as `ceChatOp(fn).then(cePublishChat)` -- outside the
// chain -- and moving it inside would deadlock the chain against itself.
var _ceChatChain: Promise<any> = Promise.resolve();
function ceChatOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceChatChain.then(fn);
    _ceChatChain = run.catch(function() { return null; });
    return run;
}

// The summary draft. A MODULE VARIABLE, not store state, per CLICK-BEFORE-BLUR:
// in this environment a click is delivered BEFORE the blur it causes, so a Save button
// reading a blur-committed field reads the PREVIOUS value. onType writes here on every
// keystroke with no render; Save reads here.
var _ceChatSummaryDraft: string = '';

// [CC-THOUGHT-EDIT] THE THOUGHT IS A FIELD, NOT ONLY A GENERATION. char.ephemeral steers the
// next reply through buildCharChatInstruction, and until now the only writer was the model:
// a thought that came back wrong could be regenerated (by taking another turn) but never
// corrected, and never removed. Two verbs close that -- write and clear -- both through ONE
// function, because "clear" is "write nothing" and a second path would be a second set of rules
// about what a cleared snapshot looks like.
// THE DRAFT IS A MODULE VARIABLE, per CLICK-BEFORE-BLUR: a click is delivered BEFORE the blur it
// causes, so a Save button reading a blur-committed store field reads the PREVIOUS value.
// onType writes here on every keystroke with no render; Save reads here.
var _ceChatThoughtDraft: string = '';
// The value the draft was last synced FROM. cePublishChat re-syncs only when the stored thought
// has actually changed underneath the field -- a new generated thought, or a different contact.
// A blind re-sync on every publish would discard what the author is part-way through typing,
// since publishes fire for reasons that have nothing to do with this box. null = never synced.
var _ceChatThoughtSeed: string | null = null;

// ONE WRITER. An empty string is the clear, and the clear is a null snapshot rather than a
// snapshot of empty strings -- every reader tests the object, not its fields.
async function ceChatThoughtWrite(text: string): Promise<void> {
    if (!_aeCharChat.active || !_aeCharChat.contactId) return;
    var ccThTx = String(text || '').trim();
    var ccThCh: any = await loadCharacter(_aeCharChat.contactId);
    if (!ccThCh) {
        api.v1.ui.toast('Could not load that character \u2014 the thought was not saved.', { type: 'error', autoClose: 4000 });
        return;
    }
    if (!ccThTx) {
        ccThCh.ephemeral = null;
    } else {
        // THE THREE PARTS ARE CLEARED, NOT KEPT, and that is the whole reason this writes a
        // snapshot rather than one field. Every reader of a snapshot prefers eventAnchor /
        // emotionalResponse / immediateDesire and falls back to compressedLine only when all
        // three are empty (grep 'Reacting to:'), so leaving the generated parts in place beside
        // an authored line would mean the story reads one thought while the chat surface shows
        // another. generatedAtGen is carried over: it stamps WHEN this state was last set, and
        // an authored edit is a new setting of the same state, not a new generation.
        ccThCh.ephemeral = {
            eventAnchor: '', emotionalResponse: '', immediateDesire: '',
            compressedLine: ccThTx,
            generatedAtGen: Number((ccThCh.ephemeral && ccThCh.ephemeral.generatedAtGen) || 0)
        };
    }
    // ephemeralHistory IS LEFT ALONE. It is the record of what this character has thought, and
    // correcting the live line is not a claim about the past. Clearing it as well would also
    // delete the input generateEphemeral reads to avoid restating itself.
    await saveCharacter(ccThCh);
    _ceChatThoughtDraft = ccThTx;
    _ceChatThoughtSeed = ccThTx;
    try { await cePublishProfile(ccThCh.id); } catch (_eThP) {}
    // The bridge HUD renders the same line off EVT_CHARCHAT_STATE, so it has to be told or it
    // keeps showing the thought that was just corrected.
    try { await broadcastCharChatState(); } catch (_eThB) {}
    api.v1.ui.toast(ccThTx ? 'Thought saved \u2014 their next reply reads it.' : 'Thought cleared.',
        { type: 'info', autoClose: 3000 });
}

async function cePublishChat(): Promise<void> {
    ceChatStoreInit();
    if (!ceChatStore) return;
    try {
        var chars: any[] = await loadAllCharacters();
        var cfg: any = await loadConfig();
        var threads: any[] = await listCharChatThreads();
        // [CC-CTX] Decorate each thread with its context state and whether a recap
        // exists, so the card can render the control without a second round trip per row.
        var ctxModes: any = await ccCtxModes();
        var ctxSums: any = await ccCtxSummaries();
        for (var ti = 0; ti < threads.length; ti++) {
            var tEid = String(threads[ti].entryId || '');
            threads[ti].ctx = String(ctxModes[tEid] || 'off');
            threads[ti].hasSummary = !!String(ctxSums[tEid] || '').trim();
        }

        // The bridge's own roster for this strip is cachedCharVisuals, which is the ACTIVE
        // roster -- match that rather than listing archived characters as textable.
        // Protagonist included: you can text as or to them.
        var roster: any[] = [];
        for (var i = 0; i < (chars || []).length; i++) {
            var c = chars[i];
            if (!c || !c.id) continue;
            if (c.active === false) continue;
            // [STYLE2-F] pattern and role ride along so the contact CARD can
            // carry the identity hue (SS6.3 #2: in Object density the hue IS the
            // container's left border) and a sub-line that says who the person is when
            // there is no message count yet. Both come from the record already loaded
            // here -- no extra read, no new storage.
            roster.push({ id: String(c.id), name: String(c.name || 'Unknown'),
                          pattern: String(c.pattern || ''), role: String(c.occupationRole || '') });
        }

        // [POV-REMEMBERED] cfg is the source. A pov naming someone deleted or
        // deactivated is CLEARED BACK TO CONFIG here, not merely dropped from this render,
        // because the Profile launcher reads the same field and the two must not disagree
        // about which thread a tap lands in.
        // NOT routed through ceChatOp on purpose: this is a corrective write racing
        // nothing, and cePublishChat is called from inside `.then()` on that chain (see
        // the hazard note on ceChatOp) -- chaining here is the one shape that could bite.
        var pov = String(cfg.charChatPovId || '');
        if (pov && pov !== CC_POV_INTERVIEW) {
            var stillThere = false;
            for (var j = 0; j < roster.length; j++) { if (roster[j].id === pov) { stillThere = true; break; } }
            if (!stillThere) {
                pov = '';
                try { await mutConfig(function(cc: any) { cc.charChatPovId = ''; }); }
                catch (_ePv) { api.v1.error('[AE:jsxchat] stale pov clear failed:', _ePv); }
            }
        }

        // lastThought is READ-ONLY and is derived exactly as the EVT_CHARCHAT_STATE
        // broadcast derives it. This never generates a thought.
        var lastThought = '';
        var contactName = '';
        var active = !!_aeCharChat.active;
        if (active && _aeCharChat.contactId) {
            contactName = String(_aeCharChat.contactName || '');
            try {
                var thChar: any = await loadCharacter(_aeCharChat.contactId);
                if (thChar && thChar.ephemeral && thChar.ephemeral.compressedLine) {
                    lastThought = String(thChar.ephemeral.compressedLine).trim();
                }
            } catch (_eTh) { lastThought = ''; }
        }

        // [CC-THOUGHT-EDIT] Sync the editor's draft only when the stored thought has actually
        // moved -- a fresh generated thought, or a different contact. See _ceChatThoughtSeed.
        if (_ceChatThoughtSeed === null || _ceChatThoughtSeed !== lastThought) {
            _ceChatThoughtSeed = lastThought;
            _ceChatThoughtDraft = lastThought;
        }

        var disp = ceChatAvatarDisplay(cfg);
        // [CHAT-STAGE] Same one-resolver rule as disp: the surface never reads the two stage
        // fields off cfg, so a stepper can never show a number the painter is not using.
        var stg: any = ceChatStageSettings(cfg);
        // [CHAT-BUBBLE-STYLE] Same one-resolver discipline as disp above: the
        // surface never reads cfg.charChatBubble* directly, so a select can never render a
        // value the decoration rules are not actually using.
        var bub = ceChatBubbleDisplay(cfg);

        ceChatPatch(function(s: any) {
            return {
                ready: true, roster: roster, threads: threads, povId: pov,
            // The mode the NEXT chat will start as (cfg), NOT the open chat's own. When a
            // chat is open the picker row is not what the user is steering -- the open-chat
            // block above it is -- so showing the live mode here would make the row lie
            // about what tapping a contact does.
            mode: String((cfg && cfg.charChatMode && CC_MODES[String(cfg.charChatMode)]) ? cfg.charChatMode : 'text'),
            model: String((cfg && cfg.charChatModel) || CC_DEFAULT_MODEL),
                freshThoughts: !!(cfg && cfg.charChatFreshThoughts),
                images: !!(cfg && cfg.charChatImages),
                avSize: disp.size, avShape: disp.shape,
                stageOn: !!(cfg && (cfg as any).charChatStage),
                stageScale: Number(stg.charChatStageScale) || 30,
                stageFloor: Number(stg.charChatStageFloor) || 0,
                // The WHOLE resolved look, not two ids: the surface renders one control per
                // axis and gates on CE_CB_FRAME, and re-deriving that from a config copy
                // would be a second resolver to keep in step with the first.
                bubLook: bub,
                active: active,
                contactId: String(_aeCharChat.contactId || ''),
                contactName: contactName, lastThought: lastThought, note: '',
                // A chat that ended (from the tray, or from the story) while the confirm was
                // armed must not leave a live Delete control standing over nothing.
                confirmDel: active ? !!s.confirmDel : false,
                confirmThought: active ? !!s.confirmThought : false
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsxchat] publish failed:', e);
        ceChatPatch(function() { return { ready: true, note: 'Could not read the chat roster.' }; });
    }
}

// Message count for one (contactId, povId) pair. Mirrors _ccLauncherCount exactly,
// including the empty-string normalisation on povId.
// [CC-CTX] The thread record for one pair, or null. ceChatCount's sibling -- same
// scan, but the card needs the whole row (entry id, context state, whether a recap exists)
// and not just the turn count.
function ceChatThread(threads: any[], contactId: string, povId: string): any {
    for (var cctI = 0; cctI < (threads || []).length; cctI++) {
        var cctT = threads[cctI];
        if (!cctT) continue;
        if (String(cctT.contactId) === String(contactId) && String(cctT.povId || '') === String(povId || '')) return cctT;
    }
    return null;
}

function ceChatCount(threads: any[], contactId: string, povId: string): number {
    for (var i = 0; i < (threads || []).length; i++) {
        var t = threads[i];
        if (t && t.contactId === contactId && String(t.povId || '') === String(povId || '')) {
            return Number(t.turnCount) || 0;
        }
    }
    return 0;
}

// [POV-REMEMBERED] The saved pov resolved FOR ONE CONTACT. Two callers -- this
// surface and the Profile launcher's one-tap Chat cell -- and they must not disagree about
// which thread a tap lands in, so the \u201cyou cannot text as and to the same person\u201d rule
// lives here rather than being restated at each site. The interview sentinel is exempt: it
// is not a character, so it can never collide with a contactId.
function ceChatSavedPov(cfg: any, contactId: string): string {
    var pv = String((cfg && cfg.charChatPovId) || '');
    if (!pv) return '';
    if (pv !== CC_POV_INTERVIEW && pv === String(contactId || '')) return '';
    return pv;
}

function ceChatSetPov(id: string): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) { c.charChatPovId = String(id || ''); });
    }).then(function() { return cePublishChat(); });
}

// [CC-MODES] The mode's twin of the above, and stored the same way: on cfg, not on the
// chat state. It is a choice about the NEXT chat you start, so it has to survive having no
// chat open -- which is exactly when it is set. The live chat's own mode is on
// _aeCharChat.mode and is not touched here; changing this mid-chat sets what the next one
// will be, and the open chat keeps the kind it was started as.
function ceChatSetMode(id: string): Promise<any> {
    var ccsM = CC_MODES[String(id || '')] ? String(id) : 'text';
    return ceChatOp(function() {
        return mutConfig(function(c: any) { c.charChatMode = ccsM; });
    }).then(function() { return cePublishChat(); });
}

// [CCAV-ENGINE] Write a display setting, then RE-EMIT the widgets. The re-emit is
// the non-obvious half: the sentinels already in the document carry the values that were
// current when they were written, so without this the change is invisible until the next
// turn happens to rebuild them. refreshCharChatImageWidgets is clear-and-rebuild from the
// document tags and early-returns with no chat open, so this is cheap and idempotent.
function ceChatSetAvatar(field: string, value: any): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) {
            if (field === 'size') { c.charChatAvatarSize = Number(value) || 40; }
            else { c.charChatAvatarShape = String(value || 'round'); }
        });
    }).then(function() {
        return refreshCharChatImageWidgets().catch(function(e: any) {
            aeLog('[AE:jsxchat] avatar widget re-emit failed (change lands next turn):', e);
            return null;
        });
    }).then(function() { return cePublishChat(); });
}

// [CHAT-STAGE] Write a stage setting, then REBROADCAST. The broadcast is the repaint: the
// layer lives in the bridge and its only input is EVT_CHARCHAT_STATE.stage, so pushing the
// state again IS the live update -- there is no second channel and no widget to re-emit.
// Cheap enough to do on every nudge: the payload is built on every turn anyway.
// NOT GATED ON AN OPEN CHAT. broadcastCharChatState ships active:false with the stage off,
// which is exactly what the painter needs in order to take a layer down when the switch is
// flipped while nothing is open.
function ceChatSetStage(field: string, value: any): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) {
            if (field === 'on') { (c as any).charChatStage = !!value; return; }
            if (field === 'scale') { (c as any).charChatStageScale = Number(value) || 30; return; }
            if (field === 'floor') { (c as any).charChatStageFloor = Number(value) || 0; return; }
            aeLog('[AE:jsxchat] unknown stage field ignored: ' + String(field));
        });
    }).then(function() {
        // TWO CHANNELS, BOTH REQUIRED, and they carry different halves. The broadcast repaints
        // the LAYER (it is the painter's only input); the restyle recompiles the BUBBLES, which
        // the stage switch now owns the geometry of. Turning the stage on used to move the
        // figures and leave the text hugging two sides until the next chat.
        return broadcastCharChatState().catch(function(e: any) {
            aeLog('[AE:jsxchat] stage push failed (change lands on the next turn):', e);
            return null;
        });
    }).then(function() { return _ceChatRestyle(); })
      .then(function() { return cePublishChat(); });
}

// [CHAT-BUBBLE-STYLE] Write a bubble setting, then RESTYLE THE LIVE
// CHAT IN PLACE. The re-apply is the non-obvious half and it is a different mechanism from
// ceChatSetAvatar's above, for a structural reason worth stating: an avatar is a WIDGET
// whose content was written into the document when it was created, so changing it means
// re-emitting the widgets. A bubble is a RULE, and decorations.updateRules takes a partial
// rule including `style` (verified in script-types.txt: `(Partial<DecorationRule> & { id:
// string })[]`), so the restyle is one call that touches no document content at all and
// leaves every scope exactly as refreshCharChatDecorations last set it. Passing style
// WITHOUT scope is what makes that true -- adding a scope here would silently blow away
// the section classification.
//
// NO-OP WHEN NO CHAT IS OPEN, and that is correct rather than a missed case: the rules are
// registered by _charchatRegisterDecorations at chat start, which reads config through the
// same resolver, so a setting changed while closed is picked up by the next chat anyway.
// [CHAT-BUBBLE-AXES] ONE WRITER FOR THIRTEEN FIELDS PLUS THE SEED. The restyle
// half below is unchanged and is still the non-obvious part; what changed is only WHAT gets
// written before it.
//
// A SEED CLEARS THE HEX OVERRIDES, and that is the one judgement call in this function.
// Tapping Terminal while carrying a custom magenta POV hex would otherwise give you
// Terminal-but-magenta and no way to tell which half you were looking at -- the seed is a
// WHOLE LOOK, so it sets the whole look. The hex fields are one keystroke to put back and
// are visibly empty afterwards, so nothing is lost silently.
function ceChatSetBubble(field: string, value: any): Promise<any> {
    return ceChatOp(function() {
        return mutConfig(function(c: any) {
            if (field === 'seed') {
                var cbSd: any = CE_CB_SEEDS[String(value || '')] || CE_CB_SEEDS['chat'];
                c.charChatBubbleFrame   = cbSd.frame;
                c.charChatBubbleCorner  = cbSd.corner;
                c.charChatBubbleFill    = cbSd.fill;
                c.charChatBubbleEdge    = cbSd.edge;
                c.charChatBubbleDepth   = cbSd.depth;
                c.charChatBubbleType    = cbSd.type;
                c.charChatBubbleVoice   = cbSd.voice;
                c.charChatBubblePalette = cbSd.palette;
                c.charChatBubbleAccent  = cbSd.accent;
                c.charChatPovColor      = '';
                c.charChatContactColor  = '';
                c.charChatAccentColor   = '';
                return;
            }
            if (field === 'width') { c.charChatBubbleWidth = Number(value) || 78; return; }
            var cbKey = String(CE_CB_FIELD_KEY[String(field || '')] || '');
            if (!cbKey) { aeLog('[AE:jsxchat] unknown bubble field ignored: ' + String(field)); return; }
            c[cbKey] = String(value == null ? '' : value).trim();
        });
    }).then(function() { return _ceChatRestyle(); })
      .then(function() { return cePublishChat(); });
}

// [CHAT-STAGE-LANE] THE RESTYLE, EXTRACTED. Two writers now change what the decoration
// rules compile to -- the bubble axes and the stage switch -- and a second copy of this
// block is how one of them would come to restyle four rules while the other restyled six.
// The body is unchanged; only its address is.
// [CHAT-LANE] The TOKEN push is NOT gated on an open chat, unlike the rule restyle: the
// bridge's CSS variables are page-level and a photo card from a previous chat is still on
// screen after it closes.
// Passing style WITHOUT scope is what keeps refreshCharChatDecorations' section
// classification intact -- adding a scope here would silently blow it away.
function _ceChatRestyle(): Promise<any> {
    if (!_aeCharChat.active) return broadcastChatBubbleStyle();
    return loadConfig().then(function(bcCfg: any) {
        var bcD = ceChatBubbleDisplay(bcCfg);
        var bcB = _charchatBubbleRules(bcD);
        return api.v1.editor.decorations.updateRules([
            { id: AE_CHARCHAT_RULE_MARKER,  style: bcB.marker },
            { id: AE_CHARCHAT_RULE_POV,     style: bcB.pov },
            { id: AE_CHARCHAT_RULE_CONTACT, style: bcB.contact },
            { id: AE_CHARCHAT_RULE_EMOTION, style: bcB.emotion },
            { id: AE_CHARCHAT_RULE_HEAD,    style: bcB.head },
            { id: AE_CHARCHAT_RULE_EMOBOX,  style: bcB.emobox }
        ]).then(function() { return broadcastChatBubbleStyle(); });
    }).catch(function(e: any) {
        aeLog('[AE:jsxchat] bubble restyle failed (change lands on the next chat):', e);
        return null;
    });
}

// The jsx replacement for _charchatShowSummaryModal, and the entry point for
// BOTH the tray's Summarize button and the surface's own. Same generator, same
// destination; the surface is the only difference. Keeps the chat open -- Summarize was
// always a preview action and still is.
async function ceChatSummarize(): Promise<void> {
    if (!_aeCharChat.active) {
        try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e0) {}
        return;
    }
    try { api.v1.ui.toast('Summarizing\u2026', { type: 'info', autoClose: 2000 }); } catch (_e1) {}
    var ccSum = '';
    try { ccSum = await previewSummarizeCharChat(); }
    catch (e) { api.v1.error('[AE:jsxchat] summarize failed:', e); ccSum = ''; }
    if (!ccSum) {
        try { api.v1.ui.toast('Nothing to summarize yet.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return;
    }
    _ceChatSummaryDraft = ccSum;
    ceChatStoreInit();
    ceChatPatch(function(s: any) {
        return { summary: ccSum, summaryGen: (Number(s.summaryGen) || 0) + 1, confirmDel: false };
    });
    await ceOpenShell('chat');
}

// [WIZ-TRAY] The wizard twin. Same contract as ceOpenChatConfirmDelete below: arm
// the confirm the Chat tab already renders (`confirm === 'wizchat:discard'`) and open the
// surface on that tab, so the destructive control is pressed in context. The Chat tab is
// forced because the wizard remembers a tab and Discard must not arm invisibly behind
// Setup or Locations.
async function ceOpenWizChatConfirmDiscard(): Promise<void> {
    if (!_aeLiveWiz.active) {
        try { api.v1.ui.toast('No wizard chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e0) {}
        return;
    }
    ceWizStoreInit();
    ceWizPatch(function() { return { confirm: 'wizchat:discard', summary: '' }; });
    // [SHELL-TAB] The tab is the OPENER'S argument, not a ceTabSet above it. The old pair set
    // the tab and then had it cleared by ceOpenShell's own ceNav one line later, so the armed
    // Discard control was rendered on a tab nobody was looking at -- which reads exactly like
    // a delete button that does not delete.
    await ceOpenShell('wizard', '', 'chat');
    await cePublishWiz();
}

// [CC-TRAY] The tray's Delete button lands here: it ARMS the confirm and opens the
// surface, so the destructive control the user finally presses is one they can see in
// context (who the chat is with, how many messages) rather than a bare tray glyph.
async function ceOpenChatConfirmDelete(): Promise<void> {
    if (!_aeCharChat.active) {
        try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e0) {}
        return;
    }
    ceChatStoreInit();
    ceChatPatch(function() { return { confirmDel: true, summary: '' }; });
    await ceOpenShell('chat');
}

// -- Summary screen -----------------------------------------------------------
// A REAL COMPONENT, mounted with h(), not a bare call -- for the same reason
// _ceProfileImagesDrill is (IMG-SLOT-COMPONENT): it renders a ceField, ceField uses hooks,
// and it is reached CONDITIONALLY from _ceChatRoot. A conditional bare call would make the
// root's hook order depend on whether a summary exists, which is the one thing hooks
// cannot tolerate. Mounted through h() it gets its own isolated hook space and the root's
// own two hooks stay unconditional.
function _ceChatSummaryScreen(props: any): any {
    var sumWho = String(props.contactName || 'them');
    return ceStack(CE_T.s3, [
        ceProse('t2',
            'A prose recap of the conversation so far, written in the story\u2019s own voice \u2014 not a '
          + 'transcript. Edit it, then keep it as a journal entry for ' + sumWho + ', or discard it. '
          + 'The chat stays open either way.'),
        h(ceField, {
            // FIELD-KEYLESS: a second Summarize has to replace what is in the box, and the
            // reset token is `seed`, not a bumped component key.
            seed: 'ccsum:' + String(props.gen || '0'),
            k: 'ccsum',
            label: '',
            value: String(props.text || ''),
            multiline: true,
            rows: 8,
            well: true,
            onType: function(v: string) { _ceChatSummaryDraft = v; },
            onCommit: function(v: string) { _ceChatSummaryDraft = v; return Promise.resolve(); }
        }),
        ceInline(CE_T.s2, [
            // [CC-CTX] Two destinations, two buttons, because they are two different
            // jobs. A journal bubble is that character's own history and rides their dynamic
            // block; a context summary is a fact about the STORY and rides its own lorebook
            // entry that the contact card switches on and off. Saving to one does not save to
            // the other, and neither closes the chat.
            ceBtn('Keep as context summary', 'ccsum:ctx', function() {
                return ccSaveContextSummary(_ceChatSummaryDraft).then(function(ok: boolean) {
                    if (!ok) {
                        try { api.v1.ui.toast('Nothing to save.', { type: 'warning', autoClose: 3000 }); } catch (_eC0) {}
                        return null;
                    }
                    try { api.v1.ui.toast('Saved. Switch it into context from ' + sumWho
                        + '\u2019s card on the Chat screen.', { type: 'success', autoClose: 6000 }); } catch (_eC1) {}
                    _ceChatSummaryDraft = '';
                    ceChatPatch(function() { return { summary: '' }; });
                    return null;
                });
            }, 'primary'),
            ceBtn('Save to journal', 'ccsum:save', function() {
                // Reads the SCRATCHPAD, not the record and not the field -- see the
                // _ceChatSummaryDraft declaration for why the obvious version is wrong.
                return saveCharChatSummaryToJournal(_ceChatSummaryDraft).then(function(ok: boolean) {
                    if (!ok) {
                        try { api.v1.ui.toast('Nothing to save.', { type: 'warning', autoClose: 3000 }); } catch (_eS0) {}
                        return null;
                    }
                    try { api.v1.ui.toast('Summary saved to ' + sumWho + '\u2019s journal.', { type: 'success', autoClose: 3000 }); } catch (_eS1) {}
                    _ceChatSummaryDraft = '';
                    ceChatPatch(function() { return { summary: '' }; });
                    return null;
                });
            }),
            ceBtn('Discard', 'ccsum:discard', function() {
                _ceChatSummaryDraft = '';
                ceChatPatch(function() { return { summary: '' }; });
                return Promise.resolve();
            })
        ])
    ]);
}

// [CHAT-BUBBLE-AXES] Options for one axis table, in the table's own key order.
// Built FROM the table rather than listed at the call site, so a new value is one edit in
// one place and this select can never offer an id the builder does not know.
function _ceCbOpts(table: any): any[] {
    var out: any[] = [];
    var k: string;
    for (k in table) {
        if (!Object.prototype.hasOwnProperty.call(table, k)) continue;
        out.push({ id: k, label: String(table[k].label || k) });
    }
    return out;
}

// The bubble block. GATING IS THE POINT OF THE FRAME LOOKUP: a control that cannot change
// anything is NOT RENDERED, rather than rendered and ignored. Pick Frame 'none' and Corner,
// Fill and Edge leave the list, because with no box there is no radius, no fill and no
// border for them to set -- and a select that visibly does nothing is worse than an absent
// one. Depth stays under every frame because its bloom branch degrades to a textShadow,
// which needs no box (see _charchatBubbleRules).
//
// EVERY ROW IS KEYED, and that is not decoration. Gating CHANGES THE LENGTH of this child
// list, and an unkeyed list is matched by position -- the same failure TABBODY-KEY and
// ROUTE-KEY closed one and two levels up. Without keys, hiding Corner would hand the Fill
// select the Corner select's DOM node and its committed value.
function _ceChatBubbleBlock(look: any): any {
    if (!look) return ceEmpty('Bubble settings load with the chat list.', null);
    var cbFr: any = CE_CB_FRAME[String(look.frame)] || CE_CB_FRAME['bubble'];

    var cbSeeds: any[] = [];
    var cbSk: string;
    for (cbSk in CE_CB_SEEDS) {
        if (!Object.prototype.hasOwnProperty.call(CE_CB_SEEDS, cbSk)) continue;
        cbSeeds.push((function(sid: string, slab: string) {
            return ceBtn(slab, 'chat:bub:seed:' + sid, function() { return ceChatSetBubble('seed', sid); });
        })(cbSk, String(CE_CB_SEEDS[cbSk].label)));
    }

    var rows: any[] = [];
    var addRow = function(key: string, label: string, hint: string, control: any) {
        rows.push(ceWrap({ key: 'cb:' + key }, [ ceSettingRow(label, hint, control)]));
    };
    var axisRow = function(key: string, label: string, hint: string, table: any, cur: string) {
        addRow(key, label, hint, ceSelect({
            k: 'chat:bub:' + key, value: String(cur), options: _ceCbOpts(table),
            onCommit: function(v: string) { return ceChatSetBubble(key, v); }
        }));
    };

    axisRow('frame', 'Frame', 'What kind of box a message is drawn in.', CE_CB_FRAME, look.frame);
    if (cbFr.corner) {
        axisRow('corner', 'Corner', 'Rounding. Also sets the padding that keeps text off the curve.',
            CE_CB_CORNER, look.corner);
    }
    if (cbFr.fill) {
        axisRow('fill', 'Fill', 'How strongly the message is tinted. Frosted blurs what is behind it \u2014 experimental.',
            CE_CB_FILL, look.fill);
    }
    if (cbFr.edge !== 'none') {
        axisRow('edge', 'Edge', 'Weight of the outline.', CE_CB_EDGE, look.edge);
    }
    axisRow('depth', 'Depth', 'Shadow, inner highlight, or an outward glow.', CE_CB_DEPTH, look.depth);
    axisRow('type', 'Typeface', 'The lettering messages are set in.', CE_CB_TYPE, look.type);
    axisRow('voice', 'Voice', 'Slant, letter spacing and size.', CE_CB_VOICE, look.voice);
    axisRow('palette', 'Palette', 'The pair of colours \u2014 yours and theirs.', CE_CB_PALETTE, look.palette);
    axisRow('accent', 'Accent', 'The divider line and the emotion tagline.', CE_CB_ACCENT, look.accent);
    axisRow('lane', 'Lane', 'Inset leaves room beside a message for the portrait. Full row fills the '
        + 'column and keeps the text clear of it instead. Neither applies while the stage is on \u2014 '
        + 'the stage centres every message and takes the portrait down.', CE_CB_LANE, look.lane);

    // Gated like the rest: Full row IS the width, so a width control under it would set
    // nothing. Same rule as Corner under Frame 'none'.
    if (String(look.lane) !== 'full') {
        addRow('width', 'Width', 'How far a long message runs before it wraps.',
            ceSelect({
                k: 'chat:bub:width', value: String(look.width || 78),
                options: [{ id: '66', label: 'Narrow' }, { id: '78', label: 'Medium' }, { id: '88', label: 'Wide' }],
                onCommit: function(v: string) { return ceChatSetBubble('width', Number(v)); }
            }));
    }

    // [COLOR-PICK] THE OVERRIDES ARE PICKERS, NOT HEX BOXES. The boxes existed because this
    // shell had no colour input: type='color' is ruled out, and a swatch list was judged to
    // be just a longer palette. The built grid answers both halves -- sixty swatches AND a
    // hex box inside it for anyone who arrived with an exact value -- so the reason is spent
    // and the boxes go. Typing '#e8a04a' from memory was never what anyone wanted.
    // EMPTY IS STILL THE UNDO. The clear swatch commits '', which hands the slot back to the
    // palette, and the read line NAMES the colour that then applies instead of going blank --
    // an override and its absence are two different states and must not look alike.
    var colRow = function(key: string, label: string, hint: string, cur: string, none: string) {
        rows.push(ceColorRow('cb:' + key, label, hint, {
            k: 'chat:bub:' + key, label: label, value: String(cur || ''),
            allowNone: true, noneLabel: none,
            onCommit: function(v: string) { return ceChatSetBubble(key, v); }
        }));
    };
    colRow('povHex', 'Your colour', 'Overrides your side of the palette.',
        look.povRaw, 'Palette \u00b7 ' + look.povHex);
    colRow('themHex', 'Their colour', 'Overrides their side of the palette.',
        look.themRaw, 'Palette \u00b7 ' + look.themHex);
    colRow('accHex', 'Accent colour', 'Overrides the accent set above.',
        look.accRaw, 'Accent \u00b7 ' + look.accHex);
    colRow('ink', 'Text colour',
        'The lettering itself. Left clear it follows the fill \u2014 dark ink on a light '
        + 'bubble, light on a dark one.', look.ink, 'Automatic');

    return ceStack(CE_T.s2, [
        ceProse('t3',
            'Start from one of these, then change anything. They set the controls below \u2014 they are not modes.', { key: 'cb:seedhint' }),
        ceInline({ gap: CE_T.s2, key: 'cb:seeds' }, cbSeeds),
        ceStack({ key: 'cb:rows' }, rows)
    ]);
}

function _ceChatRoot(): any {
    ceChatStoreInit();
    // BOTH HOOKS RUN UNCONDITIONALLY, before every branch below. Everything conditional on
    // this surface is either a plain element or a component mounted with h().
    var st = useStoreValue(ceChatStore);
    // [STYLE2-F] SUBSCRIBED, not .get(). The Options group is a ceAccordion now and
    // its open state lives in ceUiStore.open; without this subscription ceToggleOpen would
    // write the map and nothing on this surface would ever repaint to read it. Placed with
    // the other hook, above every branch, per this function's own opening rule.
    var ui = useStoreValue(ceUiStore);
    useEffect(function() { cePublishChat(); }, []);

    // [NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    // -- Summary: FULL SURFACE SWAP, never an overlay -------------------------
    if (st.summary) {
        var sBack = ceBtn('\u2190 Chat', 'chat:sum:back', function() {
            ceChatPatch(function() { return { summary: '' }; });
            return Promise.resolve();
        });
        return ceScreen(
            ceHeader(sBack),
            [h(_ceChatSummaryScreen, {
                text: String(st.summary),
                gen: String(st.summaryGen || 0),
                contactName: st.contactName
            })]
        );
    }

    var povId: string = String(st.povId || '');
    var chatMode: string = String(st.mode || 'text');
    var roster: any[] = st.roster || [];
    var threads: any[] = st.threads || [];
    var i: number;

    // -- 1. Open chat ---------------------------------------------------------
    // [CC-TRAY] The bridge chat manager's three verbs, rendered only while there
    // is a chat to act on. Close saves the thread and strips the document; Summarize is a
    // preview that keeps the chat open; Delete discards the thread AND strips the document.
    var openBlock: any = null;
    if (st.active) {
        var mgr: any[] = [];
        mgr.push(ceBtn('Close chat', 'chat:mgr:close', function() {
            return endCharChat('save').then(function() { return cePublishChat(); });
        }, 'primary'));
        mgr.push(ceBtn('Summarize', 'chat:mgr:summ', function() { return ceChatSummarize(); }));
        // DESTRUCTIVE-NEVER-IN-PLACE: this control keeps ONE idempotent handler in both
        // states (arming twice costs nothing), so the second of a double-fire cannot land
        // on a handler that was swapped in between the two.
        mgr.push(ceIconBtn('Delete chat', ceIconTrash(), 'chat:mgr:arm', function() {
            ceChatPatch(function() { return { confirmDel: true }; });
            return Promise.resolve();
        }, 'danger'));
        if (st.confirmDel) {
            mgr.push(ceBtn('Delete permanently', 'chat:mgr:del', function() {
                return endCharChat('discard').then(function() {
                    ceChatPatch(function() { return { confirmDel: false }; });
                    return cePublishChat();
                });
            }, 'danger'));
            mgr.push(ceBtn('Keep it', 'chat:mgr:keep', function() {
                ceChatPatch(function() { return { confirmDel: false }; });
                return Promise.resolve();
            }));
        }
        openBlock = ceSection('Open chat \u2014 ' + (st.contactName || 'someone'),
            ceStack(CE_T.s2, [
                st.confirmDel
                    ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', lineHeight: '1.5', color: CE_SEM.ask } },
                        'Deleting removes the conversation from your story and deletes its saved thread. This cannot be undone.')
                    : null,
                ceInline(CE_T.s2, mgr)
            ]));
    }

    // -- 2. Options -----------------------------------------------------------
    // Thoughts and Photos are the same two config toggles the bridge's settings row owns,
    // same labels, same ON/off casing. Both work PRE-chat (they sit above the engine's
    // active-chat guard), which is why they are here rather than inside an open chat.
    var optionRow = ceInline(CE_T.s2, [
        ceBtn('Thoughts: ' + (st.freshThoughts ? 'ON' : 'off'), 'chat:opt:thoughts', function() {
            return ceChatOp(function() {
                return mutConfig(function(c: any) { c.charChatFreshThoughts = !c.charChatFreshThoughts; });
            }).then(function() { return cePublishChat(); });
        }, st.freshThoughts ? 'primary' : undefined),
        ceBtn('Photos: ' + (st.images ? 'ON' : 'off'), 'chat:opt:images', function() {
            return ceChatOp(function() {
                return mutConfig(function(c: any) { c.charChatImages = !c.charChatImages; });
            }).then(function() { return cePublishChat(); });
        }, st.images ? 'primary' : undefined),
        // [CC-XIALONG] The A/B, and the reason the model is a config key rather than a
        // constant. Two values only: a select would imply a vocabulary that does not exist.
        // Takes effect on the NEXT chat -- the model is pinned once at start and restored at
        // end, so flipping it mid-chat cannot retarget a session already in flight, and
        // pretending otherwise would be the lie. Label says which is live.
        ceBtn('Model: ' + (String(st.model || CC_DEFAULT_MODEL) === CC_DEFAULT_MODEL ? 'Xialong' : 'GLM'),
            'chat:opt:model', function() {
                var ccNext = (String(st.model || CC_DEFAULT_MODEL) === CC_DEFAULT_MODEL) ? 'glm-4-6' : CC_DEFAULT_MODEL;
                return ceChatOp(function() {
                    return mutConfig(function(c: any) { c.charChatModel = ccNext; });
                }).then(function() { return cePublishChat(); });
            })
    ]);

    // [CHAT-BUBBLE-AXES] The bubble block moved OUT of avatarRows and into its own
    // accordion below: eleven controls is a surface, not a row in somebody else's list.
    var avatarRows = ceStack(null, [
        ceSettingRow('Avatar size', 'How wide avatars are painted beside each reply.',
            ceSelect({
                k: 'chat:av:size', value: String(st.avSize),
                options: [{ id: '28', label: 'Small' }, { id: '40', label: 'Medium' }, { id: '52', label: 'Large' }],
                onCommit: function(v: string) { return ceChatSetAvatar('size', Number(v)); }
            })),
        ceSettingRow('Avatar shape', 'Portrait matches the 832\u00d71216 image frame; size stays the width.',
            ceSelect({
                k: 'chat:av:shape', value: String(st.avShape),
                options: [{ id: 'round', label: 'Round' }, { id: 'rounded', label: 'Rounded' }, { id: 'portrait', label: 'Portrait' }],
                onCommit: function(v: string) { return ceChatSetAvatar('shape', v); }
            }))
    ]);

    // [CHAT-STAGE] The switch and its two numbers. A LOOP OVER THE TABLE for the numbers,
    // the same shape _ceSettingsStage uses, so a third knob is a row in
    // CE_CHAT_STAGE_SETTINGS plus a field on GlobalConfig and nothing here.
    // THE STEPPERS ARE RENDERED EVEN WITH THE STAGE OFF, deliberately: they are two rows,
    // they say what the switch is about to do, and a control that appears on toggle is a
    // list whose LENGTH MOVES [H-01] inside an accordion body.
    // ANNOTATED READ, same remedy as uiAny in SECTION 29: useStoreValue types as `unknown`,
    // so a raw field access off it adds to the error baseline. A local `any` moves it by
    // nothing in either direction.
    var stgAny: any = st;
    var stageNumRows: any[] = [];
    for (var csI = 0; csI < CE_CHAT_STAGE_SETTINGS.length; csI++) {
        (function(d: any, idx: number) {
            var curV = (String(d.k) === 'charChatStageScale') ? Number(stgAny.stageScale) : Number(stgAny.stageFloor);
            var fld  = (String(d.k) === 'charChatStageScale') ? 'scale' : 'floor';
            stageNumRows.push(ceStepperRow({
                k: 'chat:stage:' + d.k, label: d.label, value: curV,
                min: d.lo, max: d.hi, zebraIndex: idx,
                sub: ceSub('t3', d.sub),
                onCommit: function(v: number) { return ceChatSetStage(fld, v); },
                onNudge: function(dir: number) {
                    var nv = curV + (dir * d.step);
                    if (nv < d.lo) nv = d.lo;
                    if (nv > d.hi) nv = d.hi;
                    return ceChatSetStage(fld, nv);
                }
            }));
        })(CE_CHAT_STAGE_SETTINGS[csI], csI);
    }
    var stageRows = ceStack(null, [
        ceSettingRow('Stage', 'Draws the current location behind the conversation, with the two '
            + 'of you standing in it. Messages centre themselves, the portrait beside each reply '
            + 'comes down, and its buttons move into the right-hand gutter.',
            ceToggle(!!stgAny.stageOn, 'chat:stage:on', function() {
                return ceChatSetStage('on', !stgAny.stageOn);
            }, 'Show the location and standees behind the chat')),
        ceStack(0, stageNumRows)
    ]);

    // -- 3. Last thought ------------------------------------------------------
    // Persistent inline display, matching the bridge's earlier THOUGHT-INLINE-DISPLAY
    // decision (it was a tap-to-toast before that, and the popup was removed on purpose).
    // Three states, same as the bridge: no chat open / open but nothing yet / the thought.
    var thoughtHas = !!(st.active && st.lastThought);
    var thoughtBody = !st.active
        ? 'No chat open.'
        : (thoughtHas ? String(st.lastThought) : 'No thought yet.');
    var thoughtBlock = h('div', {
        style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3 }
    },
        // [CHAT-TOP-COLLAPSE] The ceH3 IS GONE. This block is now the body of an
        // accordion whose own label says 'Last thought', and a heading inside a disclosure
        // that repeats the disclosure's label is the one heading guaranteed to be noise.
        // The contact name it also carried is on the accordion's summary line instead.
        h('div', {
            style: { fontSize: CE_T.fsSm, lineHeight: '1.5',
                // Ladder: model-produced text is t1; the empty state is SS10.1's
                // "placeholder in t3 italic" exactly, and the italic is already below.
                opacity: thoughtHas ? CE_OP.t1 : CE_OP.t3,
                fontStyle: thoughtHas ? 'normal' : 'italic' }
        }, thoughtBody),
        // [CC-THOUGHT-EDIT] THE READ LINE STAYS AND THE EDITOR SITS UNDER IT. Replacing the line
        // with a box would make the common case (glance at it) cost a read of a form control,
        // and the line above is what the accordion's own summary is truncating.
        // BOTH CONTROLS ARE NULL WHEN NO CHAT IS OPEN rather than absent: this child list would
        // otherwise change LENGTH between the two states, which H-01 says is matched partly by
        // position and recycles nodes across shapes.
        st.active ? h(ceField, {
            k: 'chat:thought:edit',
            // FIELD-KEYLESS: the seed carries the contact as well as the text, so switching
            // chats re-seeds the box even when both characters happen to be thinking nothing.
            seed: 'ccth:' + String(st.contactId || '') + ':' + String(st.lastThought || ''),
            label: '', multiline: true, rows: 2, well: true,
            value: String(st.lastThought || ''),
            placeholder: 'What are they thinking right now?',
            hint: 'Written onto ' + (st.contactName || 'them') + '. Their next reply reads this line.',
            onType: function(v: string) { _ceChatThoughtDraft = v; },
            // Blur commits to the draft too, for the path where the field loses focus to
            // something that is not the Save button.
            onCommit: function(v: string) { _ceChatThoughtDraft = v; return Promise.resolve(); }
        }) : null,
        st.active ? ceInline(CE_T.s2, [
            ceBtn('Save thought', 'chat:thought:save', function() {
                return ceChatOp(function() { return ceChatThoughtWrite(_ceChatThoughtDraft); })
                    .then(function() { return cePublishChat(); });
            }, 'primary'),
            // DESTRUCTIVE-NEVER-IN-PLACE: arming renders a SEPARATE control that did not exist
            // at the first tap, and the arm handler is idempotent so a double-fire is harmless.
            ceIconBtn('Clear thought', ceIconTrash(), 'chat:thought:arm', function() {
                ceChatPatch(function() { return { confirmThought: true }; });
                return Promise.resolve();
            }, 'danger'),
            st.confirmThought
                ? ceBtn('Clear it', 'chat:thought:clear', function() {
                    return ceChatOp(function() { return ceChatThoughtWrite(''); })
                        .then(function() {
                            ceChatPatch(function() { return { confirmThought: false }; });
                            return cePublishChat();
                        });
                }, 'danger')
                : null,
            st.confirmThought
                ? ceBtn('Keep it', 'chat:thought:keep', function() {
                    ceChatPatch(function() { return { confirmThought: false }; });
                    return Promise.resolve();
                })
                : null
        ]) : null
    );

    // -- 4. \u201cText as\u201d ---------------------------------------------------------
    // [POV-REMEMBERED] ONE selector that remembers itself, replacing the
    // row-per-candidate strip. No POV and Interview are pinned first, then every active
    // character -- the bridge's order, preserved. Committing writes cfg and republishes;
    // there is no round trip for the counts, which are already in `threads` for every pair.
    // [PICKER-ONE] povOpts WAS HERE AND IS DELETED with the ceSelect it fed. Its
    // two sentinel rows now live in CE_PICKER_DEFS.chatPov -- '' as the def's clearLabel,
    // CC_POV_INTERVIEW as its pinned first option -- which is where any future pov option
    // has to go anyway if both doors are to keep agreeing.
    // [STYLE2-F] A ceRow, not a ceSettingRow. This is not a setting sitting among
    // other settings -- it is the SCOPE OF THE LIST BELOW IT (the contact list filters the
    // POV out of itself, and the message counts are per pair), so it belongs directly above
    // that list at the list's own density, in one dense line rather than a label + a
    // two-clause hint + a control. The dropped hint said the choice is remembered; it is,
    // and one use of the control demonstrates that better than a permanent sentence does.
    // [PICKER-ONE] cePickerRow, not ceSelect -- see CE_PICKER_DEFS.chatPov. The
    // label is resolved from the SAME roster the def offers, so the row and the picker
    // cannot disagree about who is selected; a pov naming someone since deleted has already
    // been cleared back to '' by cePublishChat before this renders.
    var povLabel = '';
    if (povId === CC_POV_INTERVIEW) { povLabel = 'Interview'; }
    else if (povId) {
        for (i = 0; i < roster.length; i++) {
            if (roster[i] && roster[i].id === povId) { povLabel = String(roster[i].name || ''); break; }
        }
    }
    var povBlock = ceRow('Talk as',
        cePickerRow({ kind: 'chatPov', ctx: {}, value: povLabel,
                      placeholder: 'Yourself' }),
        null);

    // [CC-MODES] THE DOOR. Without this the table is unreachable and every chat is a text
    // message, which is what it was. Interview is deliberately NOT offered here: it is
    // selected on the POV row (it is a POV sentinel, and its \u201cwho\u201d and its \u201ckind\u201d are the
    // same choice), so offering it twice would let the two rows disagree.
    var chatModeId = String(chatMode || 'text');
    if (povId === CC_POV_INTERVIEW) chatModeId = 'interview';
    var modeBlock = (povId === CC_POV_INTERVIEW) ? null : ceRow('Kind',
        cePickerRow({ kind: 'chatMode', ctx: {},
                      value: (CC_MODES[chatModeId] || CC_MODES['text']).label,
                      placeholder: 'Texting' }),
        null);

    // -- 5. Contact list (\u201cTo\u201d) -----------------------------------------------
    // Every active character EXCEPT whoever is the POV -- you cannot text as and to the
    // same person. Counts are per (contact, pov).
    // [STYLE2-F] "This is supposed to replicate a phone's contacts list"
    // and the contacts are THE FEATURE of this surface. Two changes follow from that:
    //
    // (1) EACH CONTACT IS A ceCard, not a hairline row. SS7.3's test is mechanical -- these
    // are many DISTINCT RECORDS, which is Object density, which is the one density that
    // draws a box. It is the same call already made for the Scene roster. The avatar grows
    // to 44px (a contacts list is a list of faces), the name is ceH, and the identity hue
    // becomes the card's left border per SS6.3 #2 rather than an 8px dot -- a contacts list
    // is precisely where knowing whose screen this is has to be readable at a glance.
    //
    // (2) THE SUB-LINE FALLS BACK TO WHO THEY ARE. Previously an unstarted chat read
    // "Start a chat" on every single row -- N copies of one instruction where the row's own
    // identity could have gone. The verb is what tapping a card obviously does; the role is
    // information you cannot get any other way on this surface.
    var contactRows: any[] = [];
    for (i = 0; i < roster.length; i++) {
        contactRows.push((function(vis: any) {
            if (vis.id === povId) return null;
            var count = ceChatCount(threads, vis.id, povId);
            var thr = ceChatThread(threads, vis.id, povId);
            var thrCtx = thr ? String(thr.ctx || 'off') : 'off';
            var sub = (count > 0)
                ? (count + (count === 1 ? ' message' : ' messages'))
                : (String(vis.role || '').trim()
                    || ('Start \u2014 ' + (CC_MODES[String(chatModeId)] || CC_MODES['text']).label));
            // [CC-CTX] THE DOOR. Rendered only where there IS a thread: a control for
            // a conversation that has not happened is chrome. Three states in one cycling
            // button rather than three buttons, because they are mutually exclusive values
            // of ONE property and a radio group would say otherwise -- and because the
            // summary state can be unreachable (no recap saved yet), which a cycle can skip
            // and a radio group would have to render as a dead option.
            // [CC-ROUTE] The legacy door. Always rendered, unlike the thread controls beside
            // it: starting an in-story chat does not need a thread to already exist, which is
            // the whole difference between this control and those.
            var legacyCtl: any = ceBtn('Open in story', 'chat:start:' + vis.id, function() {
                return ceAction('chat:start:' + vis.id, function() {
                    return startCharChat(vis.id, povId, chatModeId).then(function() {
                        try {
                            if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); }
                        } catch (_eCl) {}
                    }).catch(function() {});
                });
            });

            var ctxCtl: any = null;
            if (thr) {
                var thrId = String(thr.entryId || '');
                var thrHasSum = !!thr.hasSummary;
                var ctxLabel = (thrCtx === 'transcript') ? 'In story: full record'
                             : (thrCtx === 'summary') ? 'In story: summary'
                             : 'Not in story';
                ctxCtl = h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: CE_T.s2,
                        paddingLeft: CE_T.s3, paddingBottom: CE_T.s2 } },
                    ceBtn(ctxLabel, 'chat:ctx:' + vis.id, function() {
                        // off -> summary (when there is one) -> transcript -> off.
                        var ccNext = (thrCtx === 'off')
                            ? (thrHasSum ? 'summary' : 'transcript')
                            : (thrCtx === 'summary') ? 'transcript' : 'off';
                        return ceChatOp(function() { return ccCtxSet(thrId, ccNext); })
                            .then(function() { return cePublishChat(); });
                    }, thrCtx !== 'off' ? 'primary' : undefined),
                    // DESTRUCTIVE-NEVER-IN-PLACE: arms into the shared confirm rather than
                    // deleting on the first press, and the armed row names the thread so the
                    // press that follows is one the user can see the target of.
                    ceIconBtn('Delete saved chat', ceIconTrash(), 'chat:thr:arm:' + vis.id, function() {
                        ceChatPatch(function() { return { delThread: thrId, delThreadName: String(vis.name || '') }; });
                        return Promise.resolve();
                    }, 'danger'),
                    (String(st.delThread || '') === thrId)
                        ? ceBtn('Delete ' + String(vis.name || '') + '\u2019s chat', 'chat:thr:del:' + vis.id, function() {
                            return ceChatOp(function() { return ccThreadDelete(thrId); })
                                .then(function() {
                                    ceChatPatch(function() { return { delThread: '', delThreadName: '' }; });
                                    return cePublishChat();
                                });
                        }, 'danger')
                        : null,
                    (String(st.delThread || '') === thrId)
                        ? ceBtn('Keep it', 'chat:thr:keep:' + vis.id, function() {
                            ceChatPatch(function() { return { delThread: '', delThreadName: '' }; });
                            return Promise.resolve();
                        })
                        : null
                );
            }

            // [CARD-ONE] THE SAME CARD AS SCENE NOW, per the author: one record type must
            // not look like two different things in two menus. The 44px circle is gone with
            // the hand-rolled box; the picture is the 48px rounded square every other list
            // draws. THE CARD IS NO LONGER TAPPABLE AS A WHOLE -- the identity region is,
            // which is where a tap was ever aimed, and it is what makes room for the trail
            // to hold a control later without the nested-ceTap fault SS8 names.
            var theCard = ceRecordCard({
                key: 'chatto_' + vis.id,
                // [CARD-HUE] THE HAIRLINE, because this payload carries no pressure.
                // The chat store publishes id/name/description and never read a tier, so
                // there is no number here to paint -- and leaving the pattern colour would
                // make this the one card in the app whose border means something else.
                // Wiring attention into the chat payload is a separate change.
                hue: '',
                imgId: vis.id, imgSlot: CE_IMG_SLOT_AVATAR,
                title: vis.name, sub: sub,
                openOpId: 'chat:open:' + vis.id,
                // [CC-ROUTE] THE CARD NOW OPENS THE WINDOW, and the legacy in-story chat keeps
                // its own control below rather than being deleted. Tapping a person's name
                // should open the conversation with them, which is what this route finally
                // does; the document path is a different thing wearing the same word, and it
                // stays reachable until the window has been lived in.
                // NO ceAction LATCH, because there is nothing to lose: this writes nothing and
                // starts no generation, so a double-fire navigates to the same surface twice.
                // ceTap inside ceCard is still the event boundary. The latch on the legacy
                // control below is kept for exactly the reason it was added -- that one writes
                // to the story document and closes the shell.
                onOpen: function() {
                    ceNav('ccchat', vis.id, '', { surface: 'chat', label: 'Chats' });
                    return Promise.resolve();
                },
                trail: [
                    // [CC-PREFIX] THE 'Light' BUTTON IS DELETED. It opened the same chat with
                    // one extra argument, to try the prefix-preserving builder on a real
                    // conversation; that builder is now the only one, so the button was a second
                    // door onto the same room. The card's own opener is the door.
                    count > 0
                        ? ceFixed(null, [ ceMono(String(count), { opacity: CE_OP.t2 })])
                        : null,
                    // [CC-CTX] The state, on the card, at a glance. A thread feeding the
                    // story is a fact about the story and has to be visible without opening
                    // anything -- the control itself lives below, but WHETHER it is on is
                    // the part you need while scanning the list.
                    thrCtx !== 'off'
                        ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm,
                              color: CE_SEM.ok, opacity: CE_OP.t2 } },
                            thrCtx === 'summary' ? 'summary \u2192 story' : 'in story')
                        : null
                ]
            });
            // [CC-ROUTE] The legacy control renders for every contact, so the wrapper is no
            // longer conditional -- but it KEEPS ITS KEY. The hazard TABBODY-KEY documents is
            // about the list below being matched by position, and that is a property of the
            // list rather than of whether this particular row varies.
            var rowCtl = h('div', { key: 'chatctl_' + vis.id, style: {
                display: 'flex', flexWrap: 'wrap', gap: CE_T.s2,
                paddingLeft: CE_T.s3, paddingBottom: CE_T.s2
            } }, legacyCtl);
            return ceWrap({ key: 'chatwrap_' + vis.id }, [ theCard, rowCtl, ctxCtl]);
        })(roster[i]));
    }
    var anyContact = false;
    for (i = 0; i < contactRows.length; i++) { if (contactRows[i]) { anyContact = true; break; } }

    // [STYLE2-F] THE ORDER IS THE FIX. Options used to be the SECOND
    // thing on the surface and the contact list the LAST, so four toggles and two selects
    // stood between opening Chat and doing the only thing Chat is for. Reading order now
    // matches importance: whatever is live, then who you can talk to, then the settings
    // that shape it.
    //   1. the open chat, if there is one -- it is the only thing more urgent than the list
    //   2. Text as (the list's scope) + the contact list itself
    //   3. the last thought, ONLY while a chat is open. It previously rendered "No chat
    //      open." as a permanent block on a surface whose whole job is starting one; an
    //      empty state for a thing you have not started yet is chrome, not information.
    //   4. Options, COLLAPSED. Thoughts/Photos/avatar size/shape are set rarely and changed
    //      almost never. ceAccordion is the correct primitive here and not the one
    //      STYLE2-LIST-SPLIT ruled against: this is ONE record that expands to show its own
    //      fields, which is exactly its job -- it is a LIST of records that was the misuse.
    //
    // [CHAT-POV-ABOVE-TO] "Text as" SITS ABOVE "To", not inside it.
    // It used to be the first child of ceGroup('To', ...), which put the group's own "To"
    // head ABOVE the pov selector and read backwards: you were asked who to text, then
    // interrupted by who you are texting AS, then given the list. The two are read in the
    // order they are decided -- identity first, then recipient -- and the earlier note
    // above is unaffected: pov is still the list's SCOPE and still directly adjacent to it,
    // just on the other side of the group head.
    var body: any[] = [];
    if (openBlock) { body.push(openBlock); }
    body.push(povBlock);
    if (modeBlock) body.push(modeBlock);
    // [CHAT-TOP-COLLAPSE] Options and Last thought sit ABOVE the contact list now,
    // both collapsed. They are the two things looked at first and the two things that
    // should cost the least vertical space, which is exactly what an accordion is for.
    // The thought's summary carries the thought itself, truncated -- so the common case
    // (glance at it) costs no taps, and only reading the whole line costs one.
    body.push(ceAccordion({
        id: 'chat:opts', label: 'Options', open: !!(ui && ui.open && ui.open['chat:opts']),
        summary: 'Thoughts ' + (st.freshThoughts ? 'on' : 'off')
               + ' \u00b7 Photos ' + (st.images ? 'on' : 'off')
               + ' \u00b7 Stage ' + (stgAny.stageOn ? 'on' : 'off')
               + ' \u00b7 ' + (String(st.model || CC_DEFAULT_MODEL) === CC_DEFAULT_MODEL ? 'Xialong' : 'GLM'),
        children: ceStack(CE_T.s2, [
            optionRow, avatarRows, stageRows])
    }));
    if (st.active) {
        body.push(ceAccordion({
            id: 'chat:thought',
            label: 'Last thought' + (st.contactName ? ' \u2014 ' + st.contactName : ''),
            open: !!(ui && ui.open && ui.open['chat:thought']),
            summary: thoughtHas
                ? (thoughtBody.length > 64 ? (thoughtBody.substring(0, 64) + '\u2026') : thoughtBody)
                : 'none yet',
            children: thoughtBlock
        }));
    }
    body.push(ceGroup('To',
        anyContact
            ? ceStack(CE_T.s2, contactRows)
            : ceEmpty('No characters to text yet.', null)));
    // [CHAT-BUBBLE-AXES] Its own accordion rather than more rows inside Options:
    // eleven controls under a heading called 'Options' is where a settings list stops
    // being scannable. Collapsed by default, and the summary says what is set so the
    // current look is legible without opening it.
    body.push(ceAccordion({
        id: 'chat:bubble', label: 'Bubble style', open: !!(ui && ui.open && ui.open['chat:bubble']),
        summary: st.bubLook
            ? (String((CE_CB_FRAME[String(st.bubLook.frame)] || {}).label || '\u2014')
               + ' \u00b7 ' + String((CE_CB_PALETTE[String(st.bubLook.palette)] || {}).label || '\u2014')
               + ' \u00b7 ' + String((CE_CB_TYPE[String(st.bubLook.type)] || {}).label || '\u2014'))
            : 'Loading\u2026',
        children: _ceChatBubbleBlock(st.bubLook)
    }));
    if (st.note) { body.unshift(ceEmpty(String(st.note), null)); }

    return ceScreen(ceHeader(back), body);
}

// ============================================================================
// SECTION 34 — SETTINGS SURFACE (jsx)  [JSXSETTINGS]
// ============================================================================
// Everything global: the world vocabulary, the factions, and the engine's own knobs.
// THE TAB COUNT IS NOT WRITTEN HERE and must not be added back. It has been wrong twice --
// it said THREE over a row of four, then FIVE over a row of six, and it listed Factions for
// two versions after F-26 moved that tab to Diplomacy. CE_SETTINGS_TABS is the source; the
// lines below are a gloss on what each tab is FOR and carry no count and no order.
//   World    Species / Relationship Archetypes / Conditions / Lorebook Additions
//   Context  Dramatis Personae + World outline: options, exclusions, live preview
//   States   [SEC:STATE] the state def catalog — the creation door of the state core
//   Rolls    [F-15b] resolutions and stakes
//   Time     [T-07] the calendar: bands, day names, months
//   Helpers  [HELP-MESH] the companion scripts lending their token allowance
//   System   Timing / Generation Style / Static Field Settings / Scene Background /
//            Generation Diagnostics / Interface
//
// TABS ARE ceTabGet / ceTabSet (SECTION 28), NOT ceNav. ceNav resets entityId/back on
// every call, which is correct for SURFACE navigation and wrong for a tab switch within
// the surface you are already on. The pair namespaces the stored value as
// '<surface>:<tabId>' so a second tabbed surface cannot read this one's tab out of the
// shared slot. Both patch ui.tab alone, through the same shallow-merge ceUiPatch every
// other local-state write uses.
//
// NO LIVE
// SLIDER. The native surface used sliderInput for every interval/budget/cap value;
// script-types_d.txt's ScriptInputAttributes DOES declare min/max/step, so a
// type='range' input is syntactically legal here, but NOTHING about its behaviour in
// this jsx sandbox has ever been measured — no probe, no live report. ceField's entire
// design (uncontrolled, ref-seeded, blur-commit) exists because value= was MEASURED to
// destroy uncommitted keystrokes on a re-render (JSX-PROBE-RESULTS 2, probe A8) and
// onInput was MEASURED to multi-fire with stale values at word boundaries. A range
// input's natural shape is continuous onInput plus a controlled value= — the exact
// combination already on record as unsafe for text, and untested for range. ceNumField
// below is a clamped, blur-commit TEXT field instead. A live slider stays open for
// whoever probes onInput's behaviour on a range input first.
//
// DESTRUCTIVE-NEVER-IN-PLACE, all five deletes. Species / Relationship Archetype /
// Condition / Faction / Custom Field all use the same two-step arm-then-confirm shape
// (_ceSettingsDeleteBtn / _ceSettingsConfirmRow).
//
// KNOWN GAP: Species/Faction deletion does NOT unlink the associated lorebook entry, so
// an orphaned entry is left behind. Recorded, not fixed.
// ============================================================================

var ceSettingsStore: any = null;
function ceSettingsStoreInit(): void {
    if (ceSettingsStore) return;
    try {
        ceSettingsStore = createStore({
            ready: false, cfg: null,
            confirm: '',              // delete-confirm target key, e.g. 'species:sp_123'
            diagLog: '', diagCount: 0, diagErr: 0,
            pcpLog: ''                // [PCP-SINK] last persona-channel probe report, session-only
        });
    } catch (e) { api.v1.error('[AE:jsxsettings] store init failed:', e); }
}

function ceSettingsPatch(fn: (s: any) => any): void {
    if (!ceSettingsStore) return;
    try {
        ceSettingsStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxsettings] patch failed:', e); }
}

// OP-CHAIN, same reasoning as Journal / Image Slots / Chat: every write here is
// load-modify-persist against GlobalConfig with no compare-and-swap, and this surface
// has FIVE independently-editable lists (species, archetypes, conditions, factions,
// custom fields) plus the system tab's scalars all sharing the one config object, so the
// overlap hazard is wider here than on any prior surface. One chain for the whole
// surface, not one per list — two edits in DIFFERENT lists landing close together are
// exactly as capable of racing each other as two edits in the same one.
var _ceSettingsChain: Promise<any> = Promise.resolve();
function ceSettingsOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceSettingsChain.then(fn);
    _ceSettingsChain = run.catch(function() { return null; });
    return run;
}

async function cePublishSettings(): Promise<void> {
    ceSettingsStoreInit();
    if (!ceSettingsStore) return;
    try {
        var cfg: any = await loadConfig();
        var errCount = _diagGenLog.filter(function(e: any) { return e.outcome === 'error'; }).length;
        // [CASTLORE] The Context tab's state, plus the ROSTERS it offers checkboxes
        // over. Ids and names only -- JSXKIT-STORE-SPLIT again: whole records here would
        // repaint the whole Settings surface on any character edit.
        // THE PREVIEW IS THE REAL BUILT TEXT, not a re-description of it: buildCastLoreTexts
        // is the same function the sync projects from, so what this tab shows cannot drift
        // from what the model receives. It reads storage and composes; it writes nothing.
        var clSt: any = { castOn: true, locOn: true, castTier: 0, locDepth: 0,
                          castExclude: [], locExclude: [],
                          pplOn: true, bstOn: true, pplExclude: [], bstExclude: [] };
        var clChars: any[] = [];
        var clLocs: any[] = [];
        // [SPEC-CTX] clPpl/clBst ARE GONE with the two groups that read them. The species
        // metas are still walked below, but only to be SKIPPED -- the loop's job there is to
        // keep them out of the locations roster, which it did before this projection existed
        // and still must.
        var clPreview: any = { cast: '', world: '', ppl: '', bst: '' };
        try {
            clSt = await loadCastLore();
            clPreview = await buildCastLoreTexts(clSt, 'all');
            var ci: any[] = await loadIndex();
            var k = 0;
            for (k = 0; k < (ci || []).length; k++) {
                if (!ci[k] || ci[k].active === false || ci[k].isProtagonist) continue;
                clChars.push({ id: String(ci[k].id), name: String(ci[k].name || 'Unnamed') });
            }
            var ei: any[] = await loadEntityIndex();
            for (k = 0; k < (ei || []).length; k++) {
                if (!ei[k]) continue;
                if (ei[k].type !== 'location') continue;
                if (ceMapKindOf(ei[k].mapKind) === 'hidden') continue;
                clLocs.push({ id: String(ei[k].id), name: String(ei[k].name || 'Unnamed') });
            }
        } catch (eCL) { api.v1.error('[AE:jsxsettings] cast lore read failed:', eCL); }
        // [HELP-MESH] The mesh registry is module state, so this is a copy and not a read
        // through -- the tab renders from the store like every other group here. Both are
        // cheap: the list is at most a handful of rows and aeBudgetReport spends nothing.
        var hpList: any[] = _ceHelpList();
        var hpLocal: any = aeBudgetReport(0);
        ceSettingsPatch(function() {
            return {
                ready: true, cfg: cfg,
                diagLog: dumpGenDiagLog(),
                diagCount: _diagGenLog.length, diagErr: errCount,
                pcpLog: _cePcpLast,
                castLore: clSt, clChars: clChars, clLocs: clLocs, clPreview: clPreview,
                helpers: hpList, helpLocal: hpLocal, helpDry: _ceHelpLocalDry()
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsxsettings] publish failed:', e);
        ceSettingsPatch(function() { return { ready: true }; });
    }
}

// -- Local primitives ----------------------------------------------------------------
// [SEC:STATE] ceNumField MOVED TO SECTION 28, beside ceField and ceSelect. It was
// surface-local for as long as Settings was its only consumer; the States drill on Profile
// is the second, and a numeric field is kit by any reading of SS-BOX. Its header comment
// moved with it. No call site changed -- only the declaration did.
// [LIST-DRAFT] THE UNCOMMITTED ROWS, SHARED BY BOTH ORDERED-TEXT-LIST EDITORS.
// CLICK IS DELIVERED BEFORE THE BLUR IT CAUSES (ceField's own CLICK-BEFORE-BLUR, measured),
// so "+ Add", the arrows and the trash all fire against an array that does not yet contain
// the sentence the author has just finished typing. Reported exactly that way: finishing a
// standing and pressing Add lost the standing and appended a blank one. The workaround
// authors found -- click out of the box first -- is the shape of the bug, not a usage rule.
//
// [FIELD-LIVE] IT READS THE ELEMENTS, NOT AN EVENT, AND THE FIRST ATTEMPT DID NOT.
// That one cached each keystroke into a module var from ceField's onType tap and folded the
// cache in here -- the Journal composer's shape -- and it did not fix the report. A cache of
// an event is only ever as reliable as the event: if onInput does not reach this field, the
// cache is empty and every verb falls back to the same stale array it always used, which is
// the original bug with more code in front of it. The JSX layer's delivered event set is
// under revision (the list names click/keydown/input/change and names NEITHER blur NOR
// focusout), so anything resting on which events arrive rests on sand. Asking the element
// what is in it asks nothing of the event system.
// EVERY ROW, NOT ONE. The cache could only hold the focused row; a direct read has no such
// limit, so a list whose boxes were all edited before anything committed comes back whole.
// A ROW WITH NO LIVE ELEMENT KEEPS ITS STORED VALUE. ceFieldLive returns null, not '', for
// exactly this -- an unmounted row must not be blanked by the verb that moved its neighbour.
//
// THE EPOCH IS THE OTHER HALF, and without it the fix trades one loss for another. Once a
// verb has folded the live text in and rewritten the array, the blur that follows must not
// commit on top of it: the listener still attached to the element was built by the PREVIOUS
// render and its `idx` now addresses a different row -- after a removal, somebody else's
// sentence. A commit stamped with a stale epoch is dropped.
// [LIST-SWEEP] THE EPOCH IS KEYED ON THE keyPrefix NOW, AND WAS A SINGLE SHARED COUNTER.
// With two consumers a shared clock cost nothing measurable. This pass takes the count to
// seven, and the States tab alone can have one band editor open per expanded def -- so a
// structural verb in one editor would retire a blur commit in flight in ANOTHER. That text is
// still sitting in its box, so nothing looks wrong until the author navigates away and it is
// gone. The window is the gap between the write and the repaint: small, and not zero. Scoping
// costs one map lookup and closes the class instead of betting on the window.
var _ceListEpoch: { [k: string]: number } = {};

function _ceListEpochOf(keyPrefix: string): number {
    return Number(_ceListEpoch[String(keyPrefix || '')] || 0);
}

// The list AS THE AUTHOR CURRENTLY SEES IT: stored values, each overwritten by whatever is
// actually in that row's box. Every structural verb starts here.
function _ceListLive(list: string[], keyPrefix: string): string[] {
    var out: string[] = (list || []).slice();
    var i: number;
    for (i = 0; i < out.length; i++) {
        var v = ceFieldLive(String(keyPrefix || '') + ':' + i);
        if (v !== null) out[i] = v;
    }
    return out;
}

// [LIST-SWEEP] THE RECORD SIBLING OF _ceListLive, AND THE REASON FIVE MORE EDITORS NEEDED
// ONE. _ceListLive addresses `prefix:i` because a string row IS one box; a record row is two
// or three boxes keyed `prefix:<field>:i`, so the read has to be told which fields are boxes
// and what they are called. Everything else is identical, the null rule included: a row with
// no live element keeps what was stored, which is what stops a collapsed accordion being
// blanked by a verb pressed in an open one.
//   `fields` is [{ prop, k, num }] -- prop is the name on the record, k is the key segment,
//   and num routes the read through ceFieldLiveNum with the STORED value as its fallback.
//   `norm` is the caller's own row normaliser (the `keep`/`keepRow` each editor already has),
//   run last so the clamps stay in one place per editor rather than being restated here. It
//   is also what carries a field this read knows nothing about -- a RollBand's `note`
//   survives a label read because keepRow copies it.
// A SELECT IS NOT A BOX and is deliberately absent from every call's `fields`: ceSelect
// commits on change rather than on blur, so its value is already stored before any button is
// pressed, and it registers no element for ceFieldLive to read.
function _ceRecListLive(list: any[], keyPrefix: string, fields: any[],
                        norm: (row: any) => any): any[] {
    var out: any[] = [];
    var pfx = String(keyPrefix || '');
    var i: number;
    var f: number;
    for (i = 0; i < (list || []).length; i++) {
        var src: any = list[i] || {};
        var row: any = {};
        var kk: string;
        for (kk in src) { row[kk] = src[kk]; }
        for (f = 0; f < (fields || []).length; f++) {
            var spec: any = fields[f];
            if (!spec) continue;
            var key = pfx + ':' + String(spec.k) + ':' + i;
            if (spec.num) {
                row[String(spec.prop)] = ceFieldLiveNum(key, Number(src[String(spec.prop)]) || 0);
            } else {
                var v = ceFieldLive(key);
                if (v !== null) row[String(spec.prop)] = v;
            }
        }
        out.push(norm ? norm(row) : row);
    }
    return out;
}

// Called by every verb that CHANGES THE SHAPE of the list, after it has read the rows and
// before it writes. Retires every commit closure built before this point ON THIS PREFIX.
function _ceListStructural(keyPrefix: string): void {
    var k = String(keyPrefix || '');
    _ceListEpoch[k] = _ceListEpochOf(k) + 1;
}

// [SETTINGS-INDEXED-STATES] jsx port of aeRenderIndexedStatesEditor (SECTION
// 27) — an ordered string list with reorder/remove/add, used by Relationship
// Archetypes' stages, Conditions' stages, and Factions' relationshipStates. Rendered as
// h(ceField, {key, ...}) per row inside a loop, which is the kit's own documented
// escape hatch for a dynamic field list (ceField's own header comment: "convert it to a
// real component first: h(ceField, props) with a key" — this already IS that shape, no
// further wrapping needed since nothing here calls a hook of its own). Local to this
// surface for now since it has exactly one consumer file section; promotable to
// SECTION 28 if a second surface ever needs it.
function ceIndexedStates(states: string[], onCommitList: (next: string[]) => Promise<any>, label: string, keyPrefix: string): any {
    var rows: any[] = [];
    var i: number;
    // [LIST-DRAFT] Read at RENDER time, so every closure built by this pass carries the
    // epoch that was current when its `idx` still meant what it says.
    var ep = _ceListEpochOf(keyPrefix);
    for (i = 0; i < states.length; i++) {
        (function(idx: number) {
            rows.push(ceBar({ gap: CE_T.s2, key: keyPrefix + ':row:' + idx }, [
                ceGrow(null, [ h(ceField, {
                    k: keyPrefix + ':' + idx, label: '', value: states[idx] || '',
                    // [F-25] THE MISSING seed, AND THE MOST LIKELY CAUSE OF THE REPORTED
                    // "cannot save, reorder or delete". Without it the array moved and the
                    // text boxes kept their old values, so a successful write looked like no
                    // write at all. Keyed to POSITION AND CONTENT so a move or a removal
                    // re-seeds every box below it. Confirmed by author on the faction ladder,
                    // which was rebuilt with this and now works; applied back to the
                    // primitive for its remaining archetype-stages consumer.
                    seed: keyPrefix + ':' + idx + ':' + String(states[idx] || ''),
                    onCommit: function(v: string) {
                        if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                        var next = states.slice(); next[idx] = v; return onCommitList(next);
                    }
                })]),
                // [STYLE2] ceBtn('\u2191') -> ceIconBtn. SS6.4: a row-level verb is icon-only
                // with a mandatory aria-label, and a bare arrow character in a labelled-button
                // primitive was neither -- it announced as "up arrow" or as nothing at all.
                ceIconBtn('Move ' + label + ' up', ceIconUp(), keyPrefix + ':up:' + idx, function() {
                    if (idx === 0) return Promise.resolve();
                    var next = _ceListLive(states, keyPrefix);
                    var tmp = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = tmp;
                    _ceListStructural(keyPrefix);
                    return onCommitList(next);
                }),
                ceIconBtn('Move ' + label + ' down', ceIconDown(), keyPrefix + ':dn:' + idx, function() {
                    if (idx === states.length - 1) return Promise.resolve();
                    var next = _ceListLive(states, keyPrefix);
                    var tmp = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = tmp;
                    _ceListStructural(keyPrefix);
                    return onCommitList(next);
                }),
                // A single-tap remove, no confirm -- matching the native editor's own
                // behaviour exactly (unlike the definition-level deletes below, this is a
                // prose-list edit, not a referential delete; nothing else in the config
                // points at "stage 2" by index in a way removal could orphan).
                ceIconBtn('Remove ' + label, ceIconTrash(), keyPrefix + ':rm:' + idx, function() {
                    var next = _ceListLive(states, keyPrefix); next.splice(idx, 1);
                    _ceListStructural(keyPrefix);
                    return onCommitList(next);
                }, 'danger')
            ]));
        })(i);
    }
    // [LIST-DRAFT] THE REPORTED BUG LIVED HERE. `states` is one render old at the moment this
    // fires, so the rows are read off their own elements FIRST and the blank is appended
    // after them -- the edit rides along with the add instead of being replaced by it.
    rows.push(ceBtn('+ Add ' + label, keyPrefix + ':add', function() {
        var next = _ceListLive(states, keyPrefix); next.push('New ' + label);
        _ceListStructural(keyPrefix);
        return onCommitList(next);
    }));
    return ceStack(CE_T.s2, rows);
}

// [SETTINGS-DELETE] Shared two-step confirm shape for the five definition
// deletes on this surface. Same handler in both states on the asking control
// (DESTRUCTIVE-NEVER-IN-PLACE); the confirmed action is a control that does not exist
// until confirm === key.
function _ceSettingsDeleteBtn(key: string, opLabel: string): any {
    return ceBtn(opLabel || 'Delete\u2026', 'set:delask:' + key, function() {
        ceSettingsPatch(function() { return { confirm: key }; });
        return Promise.resolve();
    }, 'danger');
}
function _ceSettingsConfirmRow(key: string, activeConfirm: string, message: string, onDelete: () => Promise<any>): any {
    if (activeConfirm !== key) return null;
    return h('div', {
        key: 'setconfirm:' + key,
        style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
    },
        ceProse('t2', message, { grow: true, basis: '180px' }),
        ceBtn('Delete', 'set:del:' + key, onDelete, 'danger'),
        ceBtn('Keep', 'set:keep:' + key, function() {
            ceSettingsPatch(function() { return { confirm: '' }; });
            return Promise.resolve();
        })
    );
}

// -- Tab strip -----------------------------------------------------------------------
var CE_SETTINGS_TABS: any[] = [
    { id: 'world',    label: 'World' },
    // [F-26] THE FACTIONS TAB IS GONE, to the Diplomacy shell route. It only ever created,
    // renamed and deleted factions, all of which Diplomacy does beside the thing that makes
    // them worth looking at -- where everyone stands.
    // [CASTLORE] Its own tab rather than a group on World. World is GlobalConfig --
    // species, factions, conditions, the things a story IS -- and this is a pair of
    // generated lorebook entries with per-record opt-outs, backed by a different storage
    // record entirely (STORAGE_CAST_LORE, not the config). Two backings under one heading
    // is how a settings screen stops meaning anything.
    { id: 'context',  label: 'Context' },
    // [SEC:STATE] THE CREATION DOOR. Its own tab rather than a group on World for the
    // reason the World tab's own contents make obvious: species, archetypes and conditions
    // are each ONE list with two fields, and a state def has scope, bounds, a band table
    // and a rest band. Folding it in would make World a screen whose last accordion is
    // five times the size of the four above it.
    { id: 'states',   label: 'States' },
    // [F-15b] Resolutions, and the future home of Stakes. Separate from States for the
    // reason given above _ceSettingsRollsTab: a state is a number a character carries, a
    // resolution is how the world judges an attempt.
    { id: 'rolls',    label: 'Rolls' },
    // [T-07] The calendar. Beside Rolls rather than folded into World, on the argument the
    // States tab's own note makes: World's lists are one name and one description each, and
    // this is a band table plus two indexed name lists. It is vocabulary either way -- how
    // long a week is and what the days are called is not a preference, which is why it is
    // here at all and not on a screen with the token budget.
    // WHAT IS *ON* THE CALENDAR IS NOT HERE. Dated entries are world CONTENT and belong with
    // the map, exactly as factions left this surface for Diplomacy.
    { id: 'time',     label: 'Time' },
    // [HELP-MESH] Beside System rather than inside it, on the States tab's own argument:
    // System's groups are this engine's knobs, and this is a list of OTHER installed
    // scripts with their own allowances. It is also the screen an author is sent to when a
    // generation fails for budget, which is not a place to arrive three accordions down.
    { id: 'helpers',  label: 'Helpers' },
    { id: 'system',   label: 'System' }
];
function _ceSettingsTabRow(active: string): any {
    return ceTabRow('settings', CE_SETTINGS_TABS, active);
}

// ======================================================================================
// -- WORLD TAB: Species -----------------------------------------------------------------
// ======================================================================================
// [F-32] _ceSettingsSpecies IS DELETED, and F-29's rule is why it goes in THIS patch rather
// than a later one: when a record's type migrates, the surface that existed for the old type
// is part of the migration. F-28 changed the faction record and left the screen, and that
// screen then edited an array nothing read.
// WHERE IT WENT: World > Species, beside Map, Entities and Time -- the journey Factions made
// to Diplomacy, for the reason F-26 gives. This accordion could only ever create, rename,
// describe and delete; the tab does all four beside the profile column, the thirteen fields,
// the image slots and the two composed lists, none of which fit in an accordion body.
//
// _ceSettingsTagDraft GOES WITH IT. It was the shared add-key scratchpad for Species and
// Factions; the faction reader left with F-26 and the species reader leaves here, so the
// declaration had zero callers the moment this function did. Deleted rather than parked
// "in case a list grows an add-key row again" -- a var with no reader is exactly the shape
// ENT-AUDIT keeps finding, and CLICK-BEFORE-BLUR is a rule this file already states in
// three places without needing a variable to remember it by.

// ======================================================================================
// -- WORLD TAB: Relationship Archetypes ---------------------------------------------
// ======================================================================================
function _ceSettingsArchetypes(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = cfg.relationshipArchetypes || [];
    var kids: any[] = [];
    var i: number;
    for (i = 0; i < list.length; i++) {
        (function(def: any) {
            var aId = String(def.id);
            var accId = 'set:arch:' + aId;
            var open = !!openMap[accId];
            var stageCount = (def.stages || []).length;
            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: def.name || '',
                    hint: 'The label in the picker only. It is never copied into a character.',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.relationshipArchetypes || []).find(function(x: any) { return x.id === aId; });
                            if (t) t.name = v;
                        }); }).then(cePublishSettings);
                    } }),
                // [F-20] THE FIELD THAT ACTUALLY SEEDS. Multiline because it holds one or
                // two sentences now, not a category word.
                h(ceField, { k: accId + ':shape', label: 'Shape', value: def.shape || '',
                    multiline: true, rows: 3,
                    hint: 'One or two sentences of prose, copied into a character\u2019s Position Shape. '
                        + 'Say what holds the two of them in relation to each other. No names, no second person.',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.relationshipArchetypes || []).find(function(x: any) { return x.id === aId; });
                            if (t) t.shape = v;
                        }); }).then(cePublishSettings);
                    } }),
                ceSub('t3', 'Standings, coldest first. Each is a sentence copied into a '
                    + 'character\u2019s Position Standing \u2014 what is observably true between them '
                    + 'right now. Leave empty to seed a shape only.'),
                ceIndexedStates(def.stages || [], function(next: string[]) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var t = (c.relationshipArchetypes || []).find(function(x: any) { return x.id === aId; });
                        if (t) t.stages = next;
                    }); }).then(cePublishSettings);
                }, 'Standing', accId + ':stage')
            ];
            body.push(_ceSettingsDeleteBtn(accId, 'Delete archetype\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (def.name || 'this archetype') + '\u201d? This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var di = (c.relationshipArchetypes || []).findIndex(function(x: any) { return x.id === aId; });
                        if (di >= 0) c.relationshipArchetypes.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));
            kids.push(ceExpandRow({
                id: accId, label: def.name || 'Unnamed archetype', open: open,
                // [F-20] REPORTS WHETHER IT SEEDS ANYTHING. "Label only" used to describe an
                // archetype with no stages; the thing that makes an entry inert now is an
                // empty SHAPE, and an entry that seeds nothing should say so on its head
                // rather than behind a disclosure triangle.
                summary: !String(def.shape || '').trim()
                    ? 'Seeds nothing \u2014 no shape written'
                    : (stageCount ? (stageCount + ' standing' + (stageCount === 1 ? '' : 's')) : 'Shape only'),
                children: ceStack(CE_T.s3, body)
            }));
        })(list[i]);
    }
    var addBtn = ceBtn('+ Add archetype', 'set:arch:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            // [F-20] Born EMPTY rather than with 'Stage 1/2/3'. Placeholder rows in a prose
            // field are worse than none: they read as content, and an author who leaves one
            // in seeds the literal words "Stage 1" into a character.
            c.relationshipArchetypes.push({ id: 'arch_' + Date.now(), name: 'New Archetype', shape: '', stages: [] });
        }); }).then(cePublishSettings);
    });
    return ceGroup('Relationship Archetypes (' + list.length + ')', ceStack(CE_T.s1, [
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', marginBottom: CE_T.s1 } },
            'Seeds for a character\u2019s Position, offered on their profile under \u201cStart from an '
            + 'archetype\u201d. The shape is copied into Position Shape and a standing into Position '
            + 'Standing, both as ordinary editable prose \u2014 nothing stays linked afterwards, and '
            + 'neither ever touches the pressure tier.'),
        list.length ? ceStack(null, kids) : ceEmpty('No archetypes defined.', null),
        addBtn
    ]));
}

// ======================================================================================
// -- WORLD TAB: Lorebook Additions ----------------------------------------------------
// ======================================================================================
function _ceSettingsLorefold(cfg: any): any {
    var lf: any = cfg.lorebookFields || {};
    var lt: any = cfg.lorebookTemplates || {};
    var LF_FIELDS = [
        { key: 'equipment', label: 'Equipment', macros: '|name|  |equipList|', sample: { name: 'Aria', equipList: 'a worn leather coat, an iron dagger' } },
        { key: 'journal',   label: 'Journal',   macros: '|name|  |journalBody|', sample: { name: 'Aria', journalBody: 'Found the letter behind the loose brick. Said nothing to the others yet.' } }
    ];
    var rows: any[] = LF_FIELDS.map(function(fd) {
        var fk = fd.key;
        var preview = parseMacroTemplate(lt[fk] || '', fd.sample);
        return ceStack({ gap: CE_T.s2, key: 'lf:' + fk, rule: 'bottom', padBottom: CE_T.s3 }, [
            ceBar(CE_T.s2, [
                ceToggle(lf[fk] !== false, 'lf:' + fk, function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookFields as any)[fk] = !(lf[fk] !== false); }); }).then(cePublishSettings);
                }),
                h('div', { style: { fontSize: CE_T.fs } }, fd.label)
            ]),
            ceMono('Macros: ' + fd.macros, { opacity: CE_OP.t3 }),
            h(ceField, { k: 'lf:' + fk + ':tpl', label: '', multiline: true, rows: 2, well: true,
                value: lt[fk] || '',
                onCommit: function(v: string) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookTemplates as any)[fk] = v; }); }).then(cePublishSettings);
                } }),
            h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', fontStyle: 'italic' } }, 'Preview: ' + (preview || '(Blank)'))
        ]);
    });
    rows.push(ceStack({ gap: CE_T.s2, key: 'lf:conditions' }, [
        ceBar(CE_T.s2, [
            ceToggle(lf.conditions !== false, 'lf:conditions', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { (c.lorebookFields as any).conditions = !(lf.conditions !== false); }); }).then(cePublishSettings);
            }),
            h('div', { style: { fontSize: CE_T.fs } }, 'States')
        ]),
        // [F-09] The KEY stays `conditions` while the label reads "States". Renaming a
        // persisted toggle would silently re-enable this channel for every author who had
        // switched it off, which is a worse outcome than one stale key name.
        ceSub('t3', 'Definitions and per-def lines live in Settings \u203a States.')
    ]));
    return ceGroup('Lorebook Additions', ceStack(CE_T.s3, [
        ceSub('t3',
            'Which dynamic character fields fold into that character\u2019s own lorebook entry each generation. Uncheck any that feel excessive; the underlying data is kept, just not injected.'),
        ceStack(CE_T.s3, rows)
    ]));
}


// ======================================================================================
// -- CONTEXT TAB: the two engine-composed lorebooks  [CASTLORE] -----------------
// ======================================================================================
// EVERY WRITE HERE GOES THROUGH ceCastLoreOp AND ENDS IN syncCastLore('all', true), which
// is the ONE thing this tab must not get wrong. `force` is not defensive: turning a list
// OFF produces the same text it produced a moment ago (or an empty one that already
// matched), so the dirty check would correctly find nothing changed and correctly skip --
// leaving a force-activated entry in the lorebook for a switch the user just turned off.
// The text is not what changed; `enabled` is.
var _ceCastLoreChain: Promise<any> = Promise.resolve();
function ceCastLoreOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceCastLoreChain.then(fn);
    _ceCastLoreChain = run.catch(function() { return null; });
    return run;
}

// Load-modify-save on the state record, then re-project and republish. Chained for the
// same reason every other op chain in this file is: two taps landing close together on a
// load-modify-save with no compare-and-swap silently discard one.
function _ceCastLoreWrite(fn: (st: CastLoreState) => void): Promise<any> {
    return ceCastLoreOp(async function() {
        try {
            var st = await loadCastLore();
            fn(st);
            await saveCastLore(st);
            await syncCastLore('all', true);
        } catch (e) { api.v1.error('[AE:castlore] write failed:', e); }
    }).then(cePublishSettings);
}

function _ceCastLoreToggleId(list: string[], id: string): string[] {
    var out: string[] = [];
    var found = false;
    for (var i = 0; i < (list || []).length; i++) {
        if (String(list[i]) === id) { found = true; continue; }
        out.push(String(list[i]));
    }
    if (!found) out.push(id);
    return out;
}

// A checkbox list of records that MAY be excluded. Rendered from ceToggle + a label rather
// than ceSettingRow: these are many rows of one repeated kind (Object-ish density), and a
// hint under every name would be a paragraph of nothing per character.
// CHECKED MEANS INCLUDED, which is the inverse of what is stored. Storing exclusions keeps
// a newly created character in the list by default -- storing inclusions would silently
// omit everyone made after the last time this screen was opened.
function _ceCastLoreExcludeList(key: string, rows: any[], excl: string[], noneMsg: string): any {
    if (!rows.length) return ceSub('t3', noneMsg);
    var ex: any = {};
    for (var e = 0; e < (excl || []).length; e++) ex[String(excl[e])] = 1;
    var kids: any[] = [];
    for (var i = 0; i < rows.length; i++) {
        kids.push((function(r: any) {
            var on = !ex[String(r.id)];
            return h('div', { key: key + ':' + r.id, style: {
                display: 'flex', alignItems: 'center', gap: CE_T.s2, minHeight: CE_T.tap
            } },
                ceToggle(on, key + ':' + r.id, function() {
                    return _ceCastLoreWrite(function(st: CastLoreState) {
                        // [F-32] FOUR KEYS, AND THE ELSE-BRANCH IS GONE. It read "anything
                        // that is not clc is a location", which was true while there were
                        // two lists and would have quietly filed a species exclusion into
                        // locExclude the moment there were four. Named branches only.
                        if (key === 'clc') { st.castExclude = _ceCastLoreToggleId(st.castExclude, String(r.id)); }
                        else if (key === 'cll') { st.locExclude = _ceCastLoreToggleId(st.locExclude, String(r.id)); }
                        else if (key === 'clp') { st.pplExclude = _ceCastLoreToggleId(st.pplExclude || [], String(r.id)); }
                        else if (key === 'clb') { st.bstExclude = _ceCastLoreToggleId(st.bstExclude || [], String(r.id)); }
                    });
                }, (on ? 'Leave out ' : 'Put back ') + String(r.name || '')),
                h('div', { style: { fontSize: CE_T.fs, opacity: on ? CE_OP.t1 : CE_OP.t3 } }, String(r.name || 'Unnamed'))
            );
        })(rows[i]));
    }
    return ceStack(null, kids);
}

// The exact text the model receives, not a description of it -- same rule the persona
// clause preview follows. Empty renders the reason it is empty rather than a blank box.
function _ceCastLorePreview(text: string, offMsg: string): any {
    var t = String(text || '').trim();
    return h('div', { style: {
        fontSize: CE_T.fsSm, opacity: t ? CE_OP.t2 : CE_OP.t3, lineHeight: CE_T.lhProse,
        whiteSpace: 'pre-wrap', background: CE_WELL, borderRadius: CE_T.r,
        border: '1px solid ' + CE_LINE, padding: CE_T.s3
    } }, t || offMsg);
}

// [SPEC-CTX] _ceCastLoreSpeciesGroup IS DELETED, both groups with it. The two species
// entries are configured on World > Species now, beside the records they name, and this is
// a MOVE rather than a copy on purpose: a second door onto one state record is how two
// surfaces come to disagree about what is switched on, and the exclusion list here was a
// checkbox column asking a question each record's own card can answer in place. The state
// fields (pplOn/bstOn/pplExclude/bstExclude) are untouched -- only the door moved.
// The 'clp'/'clb' branches inside _ceCastLoreExcludeList are kept: that function is shared
// with the cast and world lists, and its named-branches-only rule is what made adding the
// species keys safe in the first place. Their absence of callers is recorded here rather
// than fixed by pruning a general helper down to its two current users.

function _ceSettingsContextTab(st: any, openMap: any, cfg: any): any {
    var cl: any = st.castLore || { castOn: true, locOn: true, castTier: 0, locDepth: 0,
                                   castExclude: [], locExclude: [],
                                   pplOn: true, bstOn: true, pplExclude: [], bstExclude: [] };
    var pv: any = st.clPreview || { cast: '', world: '', ppl: '', bst: '' };

    return ceStack(CE_T.s4, [
        ceProse('t3',
            'Four lorebook entries the engine writes for you and keeps up to date. All are Always-On and keyless, so they survive context pressure. Editing them by hand in the lorebook does nothing \u2014 the next change overwrites them. Two of the four are set up on World \u203a Species.'),

        ceGroup('Dramatis Personae', ceStack(CE_T.s3, [
            ceSettingRow('Include this entry',
                // WHY IT IS THE ABSENT CAST AND NOT THE WHOLE CAST, said plainly, because
                // the name suggests otherwise and the omission would otherwise read as a bug.
                'Lists the cast who are NOT in the scene. Anyone present already has their full profile injected every generation, so listing them here would only say the same thing twice, worse.',
                ceToggle(cl.castOn !== false, 'cl:caston', function() {
                    return _ceCastLoreWrite(function(x: CastLoreState) { x.castOn = !(cl.castOn !== false); });
                })),
            (cl.castOn !== false) ? ceWrap({ key: 'cl_tier' }, [ ceNumField({
                k: 'cl:tier', label: 'Limit to nearby characters',
                hint: '0 = the whole cast. 1 = only those under the same top-level place as the scene. 2 = the same second-level place, and so on.',
                value: Number(cl.castTier) || 0, min: 0, max: 6,
                onCommit: function(n: number) {
                    return _ceCastLoreWrite(function(x: CastLoreState) { x.castTier = n; });
                }
            })]) : null,
            (cl.castOn !== false) ? ceStack({ gap: CE_T.s2, key: 'cl_who' }, [
                ceKey('Who to list'),
                _ceCastLoreExcludeList('clc', st.clChars || [], cl.castExclude || [],
                    'No characters yet.')
            ]) : null,
            (cl.castOn !== false) ? ceStack({ gap: CE_T.s1, key: 'cl_pvc' }, [
                ceKey('What the model sees'),
                _ceCastLorePreview(pv.cast, 'Nothing right now \u2014 everyone active is either in the scene or filtered out.')
            ]) : null
        ])),

        ceGroup('The World', ceStack(CE_T.s3, [
            ceSettingRow('Include this entry',
                // The gap this closes, stated once so nobody re-derives it: a location's
                // description reaches context through NOTHING else. See SECTION 10d.
                'An outline of your places and the descriptions you wrote for them. Nothing else injects a location description \u2014 a place\u2019s own lorebook entry carries only its Lore text, and only while you are standing in it.',
                ceToggle(cl.locOn !== false, 'cl:locon', function() {
                    return _ceCastLoreWrite(function(x: CastLoreState) { x.locOn = !(cl.locOn !== false); });
                })),
            (cl.locOn !== false) ? ceWrap({ key: 'cl_depth' }, [ ceNumField({
                k: 'cl:depth', label: 'How deep to go',
                hint: '0 = everything. 1 = top-level places only. 2 = those and what is directly inside them. Use this when every room does not need listing.',
                value: Number(cl.locDepth) || 0, min: 0, max: 8,
                onCommit: function(n: number) {
                    return _ceCastLoreWrite(function(x: CastLoreState) { x.locDepth = n; });
                }
            })]) : null,
            (cl.locOn !== false) ? ceStack({ gap: CE_T.s2, key: 'cl_which' }, [
                ceKey('Which places to list'),
                ceProse('t3',
                    'Leaving a place out does not hide what is inside it \u2014 its children still list, one level shallower. Hidden places are never listed.'),
                _ceCastLoreExcludeList('cll', st.clLocs || [], cl.locExclude || [],
                    'No places yet.')
            ]) : null,
            (cl.locOn !== false) ? ceStack({ gap: CE_T.s1, key: 'cl_pvw' }, [
                ceKey('What the model sees'),
                _ceCastLorePreview(pv.world, 'Nothing right now \u2014 no places survive the depth limit and exclusions.')
            ]) : null
        ])),

        // [SPEC-CTX] THE TWO SPECIES GROUPS STOOD HERE AND ARE ON World > Species NOW.
        // Not mirrored, moved: see the note above _ceCastLoreExcludeList.
        ceProse('t3',
            'The Peoples and Bestiary entries are set up on World \u203a Species, beside the kinds they name \u2014 the switch is above each list and the preview is under it.'),

        // [LOREFOLD] MOVED HERE FROM WORLD. World is what a story IS -- species, standing
        // vocabulary, who walks in. These are templates for text folded into a lorebook
        // entry at generation time, which is the same job as the two entries above them.
        _ceSettingsLorefold(cfg)
    ]);
}

// ======================================================================================
// -- WORLD TAB: Travel  [SEC:TRAVEL] ---------------------------------------------------
// ======================================================================================
// THE PRICE LIST. It is on World and not on Time because a price is world VOCABULARY --
// the same split that put the calendar in Settings and dated entries on the Map. What a
// hop across this world's top tier costs is a fact about the world; where the camera
// currently stands is not.
//
// ROWS ARE ADDED, NEVER SEEDED. See TravelDef for why there is no default table, and
// ceTravelRateFor for why an unpriced tier stays free rather than inheriting its
// neighbour's rate.
function _ceSettingsTravel(cfg: any): any {
    var tdef: any = ceTravelDef(cfg);
    var tiers: any[] = ceTravelTiers(cfg).slice();
    var defs: any[] = ceStateDefs(cfg);
    var opts: any[] = [{ id: '', label: 'Nothing \u2014 time only' }];
    var i: number;
    for (i = 0; i < defs.length; i++) {
        opts.push({ id: String(defs[i].id), label: String(defs[i].name || defs[i].id) });
    }

    // SORTED ON WRITE, NOT ON READ. The rows are identified by their tier number and the
    // author adds them in whatever order they think of them; sorting here means the stored
    // order and the drawn order are the same object, so a row cannot move under a field
    // that is mid-edit.
    function writeTiers(next: any[]): Promise<any> {
        next.sort(function(a: any, b: any) { return Number(a.tier) - Number(b.tier); });
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                if (!(c as any).travel || typeof (c as any).travel !== 'object') (c as any).travel = {};
                (c as any).travel.tiers = next;
            });
        }).then(cePublishSettings);
    }

    // [LIST-SWEEP] THE TIER ROWS AS THEY STAND IN THEIR BOXES. Four numeric fields per row,
    // every one committing on blur, and both Remove and "+ Price a tier" fired against a table
    // that did not yet hold the duration being typed -- the reported list bug with numbers
    // instead of sentences.
    // NOT _ceRecListLive, and the two reasons are both in the key: these carry the TIER NUMBER
    // rather than the row index (a row's identity is its tier, which is why the table can be
    // sorted on write without a box moving), and three of the four boxes compose into ONE
    // stored integer. Neither fits the generic reader, so this one is written out.
    var trvEp = _ceListEpochOf('trv');
    function liveTiers(): any[] {
        var out: any[] = [];
        var q: number;
        for (q = 0; q < tiers.length; q++) {
            var rr: any = tiers[q] || { tier: 0, mins: 0, cost: 0 };
            var tn = Number(rr.tier) || 0;
            var dhm = ceTravelDHM(Number(rr.mins) || 0);
            out.push({
                tier: tn,
                mins: ceTravelMinsOf(ceFieldLiveNum('trv:d:' + String(tn), dhm.d),
                                     ceFieldLiveNum('trv:h:' + String(tn), dhm.h),
                                     ceFieldLiveNum('trv:m:' + String(tn), dhm.m)),
                cost: ceFieldLiveNum('trv:cost:' + String(tn), Number(rr.cost) || 0)
            });
        }
        return out;
    }

    var rows: any[] = [];
    for (i = 0; i < tiers.length; i++) {
        (function(idx: number) {
            var r: any = tiers[idx] || { tier: 0, mins: 0, cost: 0 };
            var rt = Number(r.tier) || 0;
            var rDHM = ceTravelDHM(Number(r.mins) || 0);
            // ONE COMMITTER FOR THREE FIELDS. Each box recomposes the whole duration from
            // the other two AS THEY STAND, so the stored integer is written once per edit
            // and there is no partially-applied duration at any point.
            function setDHM(dv: any, hv: any, mv: any): Promise<any> {
                if (trvEp !== _ceListEpochOf('trv')) return Promise.resolve();
                var next = liveTiers();
                if (!next[idx]) return Promise.resolve();
                next[idx] = { tier: rt, mins: ceTravelMinsOf(dv, hv, mv), cost: next[idx].cost };
                return writeTiers(next);
            }
            // TWO ROWS, NOT ONE. Four inputs and a button in a single ceBar is the squeezed
            // slot CE-STYLE 8b names: on a phone the trail collapses and the last control
            // becomes unreadable. Time is one question and the price is another, so the
            // break falls where the meaning already does.
            rows.push(ceStack({ gap: CE_T.s2, key: 'trv:row:' + String(rt) }, [
                ceSub('t2', 'Tier ' + String(rt) + (rt === 0 ? ' \u2014 the widest scale in this world' : '')),
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow({ basis: '0' }, [
                        ceNumField({
                            k: 'trv:d:' + String(rt), label: 'Days',
                            value: rDHM.d, min: 0, max: 99,
                            onCommit: function(v: number) { return setDHM(v, rDHM.h, rDHM.m); }
                        })
                    ]),
                    ceGrow({ basis: '0' }, [
                        ceNumField({
                            k: 'trv:h:' + String(rt), label: 'Hours',
                            value: rDHM.h, min: 0, max: 99,
                            onCommit: function(v: number) { return setDHM(rDHM.d, v, rDHM.m); }
                        })
                    ]),
                    ceGrow({ basis: '0' }, [
                        ceNumField({
                            k: 'trv:m:' + String(rt), label: 'Mins',
                            value: rDHM.m, min: 0, max: 99,
                            onCommit: function(v: number) { return setDHM(rDHM.d, rDHM.h, v); }
                        })
                    ])
                ]),
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow({ basis: '0' }, [
                        ceNumField({
                            k: 'trv:cost:' + String(rt), label: 'Spent',
                            value: Number(r.cost) || 0, min: 0, max: 9999,
                            onCommit: function(v: number) {
                                if (trvEp !== _ceListEpochOf('trv')) return Promise.resolve();
                                var next = liveTiers();
                                if (!next[idx]) return Promise.resolve();
                                next[idx] = { tier: rt, mins: next[idx].mins, cost: v };
                                return writeTiers(next);
                            }
                        })
                    ]),
                    ceBtn('Remove', 'trv:del:' + String(rt), function() {
                        var next = liveTiers();
                        next.splice(idx, 1);
                        _ceListStructural('trv');
                        return writeTiers(next);
                    })
                ])
            ]));
        })(i);
    }

    // [TRAVEL-MODE] ONE WRITER FOR THE THREE FIELDS THIS GROUP OWNS BESIDE THE TIERS, on
    // writeTiers' own shape: the travel bag is created if absent and one key is set, so a
    // config written before any of this existed gains them without a migration.
    function writeTravel(key: string, value: any): Promise<any> {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                if (!(c as any).travel || typeof (c as any).travel !== 'object') (c as any).travel = {};
                (c as any).travel[key] = value;
            });
        }).then(cePublishSettings).then(function() { return cePublishMap(); })
          .then(function() { return cePublishHex(); });
    }
    var tMode = ceTravelMode(cfg);
    var tHexRate = ceTravelHexRate(cfg);

    return ceGroup('Travel', ceStack(CE_T.s3, [
        // [TRAVEL-MODE] THE CHOICE FIRST, because it decides whether the rows under it are
        // read at all. THE OTHER MAP STOPS QUOTING rather than showing a second number: two
        // prices for one journey is a world where the author is right to trust neither.
        ceWrap({ key: 'trv_mode' }, [ ceSettingRow('Priced by',
            tMode === 'hex'
                ? 'Cells crossed on the hex map, at the rate below. The circle map stops '
                  + 'quoting while this is on \u2014 it has no cells to count. A place that is '
                  + 'on no hex still falls back to the tiers, so a half-painted world plays.'
                : 'Hops down the containment path, at the tier rates below. This is how every '
                  + 'world was priced before the hex map existed.',
            ceSelect({
                k: 'trv:mode', value: tMode,
                options: [{ id: 'circle', label: 'Containment (circle map)' },
                          { id: 'hex', label: 'Distance (hex map)' }],
                onCommit: function(v: string) {
                    return writeTravel('mode', (String(v) === 'hex') ? 'hex' : 'circle');
                }
            }))]),
        tMode !== 'hex' ? null : ceWrap({ key: 'trv_hexmins' }, [ ceSettingRow('Minutes per hex',
            'What crossing one cell costs in time.',
            h(ceNumField, {
                k: 'trv:hexmins', label: '', value: String(tHexRate.mins), min: 0,
                onCommit: function(v: any) {
                    return writeTravel('hexMins', Math.max(0, Math.round(Number(v) || 0)));
                }
            }))]),
        tMode !== 'hex' ? null : ceWrap({ key: 'trv_hexcost' }, [ ceSettingRow('Spent per hex',
            'What crossing one cell costs from the resource above. Leave it at zero for a '
            + 'world where distance costs time and nothing else.',
            h(ceNumField, {
                k: 'trv:hexcost', label: '', value: String(tHexRate.cost), min: 0,
                onCommit: function(v: any) {
                    return writeTravel('hexCost', Math.max(0, Math.round(Number(v) || 0)));
                }
            }))]),
        ceProse('t3', 'A journey is priced hop by hop. Each hop costs whatever the place '
            + 'being entered is priced at \u2014 unless you are backing out into somewhere you '
            + 'were already inside, which costs whatever you are leaving. A place sits at '
            + 'its depth in the world unless its own page says otherwise, and a tier with '
            + 'no row here is free.'),
        ceStack({ gap: CE_T.s1, key: 'trv_res' }, [
            ceSub('t2', 'Spent on travel'),
            ceSelect({
                k: 'trv:res', value: String(tdef.stateId || ''), options: opts,
                onCommit: function(v: string) {
                    return ceSettingsOp(function() {
                        return mutConfig(function(c: any) {
                            if (!(c as any).travel || typeof (c as any).travel !== 'object') (c as any).travel = {};
                            if (v) (c as any).travel.stateId = String(v);
                            else delete (c as any).travel.stateId;
                        });
                    }).then(cePublishSettings);
                }
            }),
            ceProse('t3', 'One charge per journey, not one per traveller. Anyone following '
                + 'the camera rides along at no extra cost.')
        ]),
        rows.length ? ceStack({ key: 'trv_rows' }, rows)
                    : ceEmpty('Nothing priced. Travel is free.', null),
        // THE NEXT UNUSED INTEGER, not tiers.length: removing tier 1 out of 0/1/2 must
        // offer 1 back rather than 3, or the table grows a hole the author cannot fill.
        ceBtn('+ Price a tier', 'trv:add', function() {
            var next = liveTiers();
            var used: any = {};
            var k: number;
            for (k = 0; k < next.length; k++) used[Number(next[k].tier) || 0] = 1;
            var nt = 0;
            while (used[nt] && nt < 64) nt++;
            next.push({ tier: nt, mins: 0, cost: 0 });
            _ceListStructural('trv');
            return writeTiers(next);
        })
    ]));
}

function _ceSettingsWorldTab(cfg: any, openMap: any, confirm: string): any {
    return ceStack(CE_T.s4, [
        _ceSettingsArchetypes(cfg, openMap, confirm),
        // [F-25] Beside archetypes, not beside factions: both describe what a relationship
        // IS in this setting, and neither belongs to any one party in it.
        _ceSettingsStandingSection(cfg),
        // [SEC:TRAVEL] Below standing and above summon, which is the order the tab
        // already reads in: what the world IS, then what it costs, then who walks in.
        _ceSettingsTravel(cfg),
        // [F-4] ON WORLD, NOT ON TIME. It was sited beside the clock on the argument that
        // both move people without a tap -- and the author went looking in Settings and did
        // not find it, which settles the argument. This is a rule about who is in the scene,
        // and that is what this tab is about; Time is a screen about vocabulary.
        ceGroup('Who walks in', ceStack(CE_T.s3, [
            ceSettingRow('Summon on mention',
                'When a character\u2019s is named in the story, move them into '
                + 'the scene once the turn finishes. Individual characters can be excluded on '
                + 'their profile.',
                ceToggle((cfg as any).summonOnMention !== false, 'set:summon', function() {
                    var wasOn = ((cfg as any).summonOnMention !== false);
                    return ceSettingsOp(function() {
                        return mutConfig(function(c: any) { (c as any).summonOnMention = !wasOn; });
                    }).then(cePublishSettings);
                }, 'Summon characters on mention'))
        ]))
    ]);
}

// ======================================================================================
// -- STATES TAB  [SEC:STATE] -----------------------------------------------------------
// ======================================================================================
// THE CREATION DOOR of the two the state core needs. The other is the Profile > States
// drill; this one is the CATALOG and holds no values, which is the same split
// Settings > World / Profile > Conditions already has and is kept for the same reason:
// a def is world vocabulary, a value is a fact about one owner.
//
// WORLD- AND FACTION-SCOPED VALUES HAVE NO DOOR YET, and that is stated rather than
// papered over with a value editor bolted onto this tab. Putting gauges in the catalog is
// how a settings screen stops meaning anything (see the Context tab's own note); the World
// and Faction value doors are their own patch.
//
// ONE EDITOR, NOT A SHAPE PICKER. [D-19] There is no gauge/track toggle here because
// there is no gauge and no track -- bands 1:1 with the range IS a track, and the author
// makes one by adding a band per value. [D-15] The verbs are unified; this surface is
// allowed to be specific, and it is: bounds and bands are laid out as what they are.

// An ordered StateBand[] editor. A SIBLING TO ceIndexedStates, NOT A MODE ON IT: that one
// edits string[] and is used by three call sites that must keep working unchanged, and a
// `bands?: boolean` flag on it would put two return shapes behind one signature -- the
// exact thing the primitive collapse exists to remove. The two share a layout and nothing
// else.
// THE THRESHOLD IS SHOWN AND EDITED. It is the field that makes a band mean anything, and
// hiding it behind "band 3 of 5" would leave the author guessing which numbers land where.
function ceIndexedBands(bands: any[], onCommitList: (next: any[]) => Promise<any>, keyPrefix: string): any {
    var rows: any[] = [];
    var i: number;
    // [LIST-SWEEP] THE REPORTED "STATES STILL LOSES WHAT I TYPED". 3.4.2 put the element read
    // into ceIndexedStates, which is the STRING-list primitive; this is its record sibling and
    // was left on `bands.slice()`, so every verb here still fired against an array that did
    // not contain the threshold or the words being typed. Same bug, one editor along, which is
    // exactly why this pass is a sweep and not another single fix.
    // `keep` IS THE ROW SHAPE, WRITTEN ONCE. Four sites built {at, label} literally before;
    // one of them is now _ceRecListLive's normaliser and the rest read it.
    var keep = function(b: any): any {
        return { at: Math.round(Number((b && b.at) || 0)), label: String((b && b.label) || '') };
    };
    var live = function(): any[] {
        return _ceRecListLive(bands, keyPrefix,
            [{ prop: 'at', k: 'at', num: true }, { prop: 'label', k: 'lab' }], keep);
    };
    var ep = _ceListEpochOf(keyPrefix);
    for (i = 0; i < bands.length; i++) {
        (function(idx: number) {
            var b: any = keep(bands[idx]);
            rows.push(ceStack({ gap: CE_T.s2, key: keyPrefix + ':row:' + idx }, [
                ceBar({ gap: CE_T.s2 }, [
                    h('div', { style: { flex: '0 0 96px' } }, [
                        ceNumField({
                            k: keyPrefix + ':at:' + idx, label: 'From', value: b.at,
                            // [LIST-SWEEP] THE MISSING seed, F-25's finding in the editor it
                            // was never applied to. FIELD-KEYLESS lets uncommitted text beat an
                            // incoming value, which is right for a box standing still and wrong
                            // for one whose ROW HAS MOVED: the store is correct and the box
                            // shows the number that used to be there, which reads as "reorder
                            // does nothing". Keyed to position AND content, so a move or a
                            // removal forces every box below it.
                            seed: keyPrefix + ':at:' + idx + ':' + String(b.at),
                            onCommit: function(n: number) {
                                if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                                var next = live();
                                next[idx] = { at: Math.round(n), label: String(next[idx].label || '') };
                                return onCommitList(next);
                            }
                        })
                    ]),
                    ceGrow(null, [ h(ceField, {
                        k: keyPrefix + ':lab:' + idx, label: 'Reads as', value: b.label,
                        seed: keyPrefix + ':lab:' + idx + ':' + b.label,
                        onCommit: function(v: string) {
                            if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                            var next = live();
                            next[idx] = { at: Number(next[idx].at) || 0, label: v };
                            return onCommitList(next);
                        }
                    })])
                ]),
                ceBar({ gap: CE_T.s2 }, [
                    ceIconBtn('Move band up', ceIconUp(), keyPrefix + ':up:' + idx, function() {
                        if (idx === 0) return Promise.resolve();
                        var next = live(); var t = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }),
                    ceIconBtn('Move band down', ceIconDown(), keyPrefix + ':dn:' + idx, function() {
                        if (idx === bands.length - 1) return Promise.resolve();
                        var next = live(); var t = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }),
                    // Single-tap remove, matching ceIndexedStates: this is a list edit, not
                    // a referential delete. restBand IS an index into this list, so removal
                    // can leave it dangling -- every reader clamps it (ceStateBand), which
                    // is why the clamp is in the projection and not only at the write.
                    ceIconBtn('Remove band', ceIconTrash(), keyPrefix + ':rm:' + idx, function() {
                        var next = live(); next.splice(idx, 1);
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }, 'danger')
                ])
            ]));
        })(i);
    }
    rows.push(ceBtn('+ Add band', keyPrefix + ':add', function() {
        var next = live();
        var lastAt = next.length ? (Number(next[next.length - 1].at) || 0) : 0;
        next.push({ at: lastAt + 1, label: 'New band' });
        _ceListStructural(keyPrefix);
        return onCommitList(next);
    }));
    return ceStack(CE_T.s2, rows);
}

// Shared mutator: find this def in a freshly loaded config and hand it to `fn`. Every
// commit on this tab is one of these, so no call site re-writes the find.
// [F-15b] THE ROLL-BAND EDITOR, AND IT IS NOT ceIndexedBands. A StateBand is {at, label};
// a RollBand is {at, label, note} and D-37 is explicit that neither text is optional --
// `label` is the word the author reads, `note` is the directive the model reads, and a
// state's single label gets away with serving both only because a state's band DESCRIBES A
// FACT while an outcome INSTRUCTS. Reusing ceIndexedBands would not merely have been a
// squeeze: its commit rebuilds each row as {at, label} literally, so every note in the
// table would be silently dropped the first time an author renamed a band.
function ceIndexedRollBands(bands: any[], onCommitList: (next: any[]) => Promise<any>, keyPrefix: string): any {
    var rows: any[] = [];
    var i: number;
    var keepRow = function(src: any): any {
        return { at: Number(src.at) || 0, label: String(src.label || ''), note: String(src.note || '') };
    };
    // [LIST-SWEEP] Same read as ceIndexedBands, one field wider. keepRow is what carries
    // `note` through a label read -- _ceRecListLive copies the row and then hands it to this,
    // so a field nobody asked about is never dropped.
    var live = function(): any[] {
        return _ceRecListLive(bands, keyPrefix,
            [{ prop: 'at', k: 'at', num: true }, { prop: 'label', k: 'lab' },
             { prop: 'note', k: 'note' }], keepRow);
    };
    var ep = _ceListEpochOf(keyPrefix);
    for (i = 0; i < bands.length; i++) {
        (function(idx: number) {
            var b: any = keepRow(bands[idx] || { at: 0, label: '', note: '' });
            rows.push(ceStack({ gap: CE_T.s2, key: keyPrefix + ':row:' + idx }, [
                ceBar({ gap: CE_T.s2 }, [
                    h('div', { style: { flex: '0 0 96px' } }, [
                        ceNumField({
                            k: keyPrefix + ':at:' + idx, label: 'From', value: b.at,
                            // [LIST-SWEEP] The seed this editor never had -- see the note in
                            // ceIndexedBands, which is the same omission in the same shape.
                            seed: keyPrefix + ':at:' + idx + ':' + String(b.at),
                            onCommit: function(n: number) {
                                if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                                var next = live();
                                next[idx] = keepRow(next[idx]); next[idx].at = n;
                                return onCommitList(next);
                            }
                        })
                    ]),
                    ceGrow(null, [ h(ceField, {
                        k: keyPrefix + ':lab:' + idx, label: 'You read', value: b.label,
                        seed: keyPrefix + ':lab:' + idx + ':' + b.label,
                        onCommit: function(v: string) {
                            if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                            var next = live();
                            next[idx] = keepRow(next[idx]); next[idx].label = v;
                            return onCommitList(next);
                        }
                    })])
                ]),
                h(ceField, {
                    k: keyPrefix + ':note:' + idx, label: 'The model reads',
                    value: b.note,
                    seed: keyPrefix + ':note:' + idx + ':' + b.note,
                    placeholder: 'The attempt succeeds, but at a cost \u2014 name the price\u2026',
                    hint: 'Written to the model as one bracketed instruction. Address the story, not the author.',
                    onCommit: function(v: string) {
                        if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                        var next = live();
                        next[idx] = keepRow(next[idx]); next[idx].note = v;
                        return onCommitList(next);
                    }
                }),
                ceBar({ gap: CE_T.s2 }, [
                    ceIconBtn('Move outcome up', ceIconUp(), keyPrefix + ':up:' + idx, function() {
                        if (idx === 0) return Promise.resolve();
                        var next = live(); var t = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }),
                    ceIconBtn('Move outcome down', ceIconDown(), keyPrefix + ':dn:' + idx, function() {
                        if (idx === bands.length - 1) return Promise.resolve();
                        var next = live(); var t = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }),
                    ceIconBtn('Remove outcome', ceIconTrash(), keyPrefix + ':rm:' + idx, function() {
                        var next = live(); next.splice(idx, 1);
                        _ceListStructural(keyPrefix);
                        return onCommitList(next);
                    }, 'danger')
                ])
            ]));
        })(i);
    }
    rows.push(ceBtn('+ Add outcome', keyPrefix + ':add', function() {
        var next = live();
        var lastAt = next.length ? (Number(next[next.length - 1].at) || 0) : 0;
        next.push({ at: lastAt + 1, label: 'New outcome', note: '' });
        _ceListStructural(keyPrefix);
        return onCommitList(next);
    }));
    return ceStack(CE_T.s2, rows);
}

// [F-14] The stakeDefs write verbs. Two, not one: the cell writer has to CREATE the row it
// is asked to edit, because rows are derived from the bound resolution's band count and a
// freshly added stake has none. Doing that inside a generic def-op would mean every caller
// had to know the row-filling rule.
function _ceStakeDefOp(defId: string, fn: (d: any) => void): Promise<any> {
    return ceSettingsOp(function() {
        return mutConfig(function(c: any) {
            var list: any[] = (c as any).stakeDefs || [];
            for (var i = 0; i < list.length; i++) {
                if (list[i] && String(list[i].id) === String(defId)) { fn(list[i]); return; }
            }
        });
    }).then(cePublishSettings);
}

// GROWS THE ROW LIST TO REACH idx, filling with empty rows. An empty row is a real and
// common answer -- most outcomes charge nothing -- so there is no difference between "row
// not authored yet" and "row authored as nothing", and creating on demand is what lets the
// editor render a table for a stake that has never been touched.
function _ceStakeCellOp(defId: string, idx: number, side: string, fn: (cell: any) => void): Promise<any> {
    return _ceStakeDefOp(defId, function(d: any) {
        if (!Array.isArray(d.rows)) d.rows = [];
        while (d.rows.length <= idx) {
            d.rows.push({ actor: { defId: '', amount: 0 }, target: { defId: '', amount: 0 } });
        }
        var row: any = d.rows[idx];
        if (!row[side]) row[side] = { defId: '', amount: 0 };
        fn(row[side]);
    });
}

// [F-15b] The resolutionDefs write verb, shaped exactly like _ceStateDefOp because it does
// exactly the same job on the neighbouring list.
function _ceResDefOp(defId: string, fn: (d: any) => void): Promise<any> {
    return ceSettingsOp(function() {
        return mutConfig(function(c: any) {
            var list: any[] = (c as any).resolutionDefs || [];
            for (var i = 0; i < list.length; i++) {
                if (list[i] && String(list[i].id) === String(defId)) { fn(list[i]); return; }
            }
        });
    }).then(cePublishSettings);
}

function _ceStateDefOp(defId: string, fn: (d: any) => void): Promise<any> {
    return ceSettingsOp(function() {
        return mutConfig(function(c: any) {
            var list: any[] = (c as any).stateDefs || [];
            for (var i = 0; i < list.length; i++) {
                if (list[i] && String(list[i].id) === String(defId)) { fn(list[i]); return; }
            }
        });
    }).then(cePublishSettings);
}

function _ceSettingsStatesTab(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = ceStateDefs(cfg);
    // [F-11b] The categories this world already uses, harvested from the catalog rather
    // than stored anywhere. A category has no record and needs none -- it exists exactly as
    // long as a def names it, so a renamed-away category disappears with no cleanup pass.
    var catVocab: string[] = [];
    for (var cvi = 0; cvi < list.length; cvi++) {
        var cv = String((list[cvi] && list[cvi].category) || '').trim();
        if (cv && catVocab.indexOf(cv) < 0) catVocab.push(cv);
    }
    var scopeOpts: any[] = CE_STATE_SCOPES.map(function(s: any) { return { id: s.id, label: s.label }; });
    // [F-11c] Bucketed by category HERE TOO, and for a reason the drill did not have: defs
    // are appended in creation order, so a state added to an existing category lands at the
    // bottom of the catalog rather than beside its siblings. Grouping the editor is what
    // makes the category a real organiser instead of a label the author has to keep tidy by
    // reordering rows by hand. ceStateGrouped is the same function the drill uses, so the
    // two surfaces cannot disagree about what a category contains.
    var kidsByCat: any = {};
    var i: number;

    for (i = 0; i < list.length; i++) {
        (function(def: any) {
            var dId = String(def.id);
            var accId = 'set:state:' + dId;
            var open = !!openMap[accId];
            var bands: any[] = Array.isArray(def.bands) ? def.bands : [];
            var scopeRow: any = null;
            for (var si = 0; si < CE_STATE_SCOPES.length; si++) {
                if (CE_STATE_SCOPES[si].id === String(def.scope)) { scopeRow = CE_STATE_SCOPES[si]; break; }
            }

            // [F-25] A MANAGED DEF IS SHOWN, NOT EDITED, AND SAYS WHERE ITS DOOR IS. It is
            // regenerated from its faction on every config load, so an editor here would
            // accept edits and silently discard them at the next open -- a control that lies
            // is worse than no control. HIDING IT WOULD ALSO BE WRONG: it is a real state a
            // character carries, it appears on their profile, and an author who cannot find
            // it in the catalog concludes the catalog is incomplete.
            if (def.managed) {
                var mgFid = String(def.managed).indexOf('faction:') === 0
                    ? String(def.managed).slice(8) : '';
                var mgKids: any[] = [
                    ceSub('t2', 'Managed by a faction. Its rungs come from that faction\u2019s '
                        + 'standing ladder, and it is rebuilt whenever the ladder or the '
                        + 'faction\u2019s name changes.'),
                    ceSub('t3', (scopeRow ? scopeRow.label : String(def.scope))
                        + ' \u00b7 ' + def.min + '\u2013' + def.max + ' \u00b7 '
                        + bands.length + ' rungs')
                ];
                if (mgFid) {
                    mgKids.push(ceBtn('Edit the ladder \u2192', accId + ':toowner', function() {
                        // [F-29] DEEP-LINKS TO THE TAB, not to the faction's profile. The
                        // button names the ladder, so landing anywhere else would be one tap
                        // and one small lie. ceNav's third argument is namespaced by
                        // ceTabGet/ceTabSet, so the value is 'entity:standing' in full.
                        ceNav('entity', mgFid, 'entity:standing',
                              { surface: 'settings', entityId: '', label: 'Settings' });
                        return Promise.resolve();
                    }));
                }
                var mgCat = String(def.category || '');
                if (!kidsByCat[mgCat]) kidsByCat[mgCat] = [];
                kidsByCat[mgCat].push(ceExpandRow({
                    id: accId, label: String(def.name || 'Unnamed'), open: open,
                    summary: 'managed', children: ceStack(CE_T.s2, mgKids)
                }));
                return;
            }

            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: def.name || '',
                    onCommit: function(v: string) { return _ceStateDefOp(dId, function(d: any) { d.name = v; }); } }),

                // [F-11b] FREE TEXT, NOT A PICKER. SS13 sends referential fields to a picker,
                // and a category is NOT referential -- it names no record, so there is nothing
                // to hold an id of. It is locationType's case exactly: the vocabulary grows out
                // of use and no closed list survives both a dungeon crawl and a courtroom drama.
                // The existing categories are offered as a hint rather than a constraint, which
                // is the cheap half of a picker and the half that actually prevents typos.
                h(ceField, { k: accId + ':cat', label: 'Category', value: String(def.category || ''),
                    placeholder: 'Vitals, Resources, Skills\u2026',
                    hint: catVocab.length ? ('In use: ' + catVocab.join(', ')) : 'Groups this state on every surface that shows it.',
                    onCommit: function(v: string) { return _ceStateDefOp(dId, function(d: any) { d.category = v; }); } }),

                ceSelect({ k: accId + ':scope', label: 'Scope', value: String(def.scope || 'char'),
                    options: scopeOpts,
                    hint: scopeRow ? String(scopeRow.hint || '') : '',
                    onCommit: function(v: string) { return _ceStateDefOp(dId, function(d: any) { d.scope = v; }); } }),

                // Bounds as three plain numbers. `start` is CLAMPED ON READ rather than
                // validated here, so an author who lowers max below start does not get a
                // rejection dialog mid-edit -- the value simply reads at the new ceiling.
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ ceNumField({ k: accId + ':min', label: 'Min', value: Number(def.min) || 0,
                        onCommit: function(n: number) { return _ceStateDefOp(dId, function(d: any) { d.min = n; }); } }) ]),
                    ceGrow(null, [ ceNumField({ k: accId + ':max', label: 'Max', value: Number(def.max) || 0,
                        onCommit: function(n: number) { return _ceStateDefOp(dId, function(d: any) { d.max = n; }); } }) ]),
                    ceGrow(null, [ ceNumField({ k: accId + ':start', label: 'Starts at', value: Number(def.start) || 0,
                        onCommit: function(n: number) { return _ceStateDefOp(dId, function(d: any) { d.start = n; }); } }) ])
                ]),

                ceSub('t3', 'Bands \u2014 each is a lower bound and the words it reads as. '
                    + 'Leave the list empty and this value stays a number the story never sees.'),
                ceIndexedBands(bands, function(next: any[]) {
                    return _ceStateDefOp(dId, function(d: any) { d.bands = next; });
                }, accId + ':band')
            ];

            // [F-10] The line this def writes into the character's lorebook entry. Only
            // offered once there are bands to write one FROM -- an unbanded def is silent by
            // D-21 and a template on it would be a control that provably does nothing.
            if (bands.length) {
                var lnCur = String(def.line || '');
                var lnPrev = '';
                try {
                    var bPrev = ceStateBand(def, ceStateClamp(def, Number(def.start) || 0));
                    lnPrev = parseMacroTemplate(lnCur.trim() || DEFAULT_STATE_LINE,
                        { name: 'Aria', defName: String(def.name || ''), bandLabel: bPrev.label,
                          value: String(ceStateClamp(def, Number(def.start) || 0)) }).trim();
                } catch (ePv) { lnPrev = ''; }
                body.push(h(ceField, {
                    k: accId + ':line', label: 'Line', value: lnCur,
                    placeholder: DEFAULT_STATE_LINE,
                    hint: 'Macros: |name| |defName| |bandLabel| |value|. A [bracketed] block drops '
                        + 'whole when a macro inside it is blank. Leave empty for the default.',
                    onCommit: function(v: string) { return _ceStateDefOp(dId, function(d: any) { d.line = v; }); }
                }));
                body.push(ceSub('t3', 'At its starting value: ' + (lnPrev || '(silent \u2014 resting)')));
            }

            // Rest band, only when there is more than one band to choose between. With one
            // band every value rests and nothing can ever be said; with none the question
            // does not arise. Both are honest states and neither needs a control.
            if (bands.length > 1) {
                var restOpts: any[] = [];
                for (var bi = 0; bi < bands.length; bi++) {
                    restOpts.push({ id: String(bi), label: (bi + 1) + '. ' + String((bands[bi] && bands[bi].label) || '(blank)') });
                }
                var restCur = Math.max(0, Math.min(bands.length - 1, Number(def.restBand) || 0));
                body.push(ceSelect({
                    k: accId + ':rest', label: 'Resting band', value: String(restCur), options: restOpts,
                    hint: 'A value sitting here says nothing. Everything else is worth the model\u2019s attention.',
                    onCommit: function(v: string) {
                        return _ceStateDefOp(dId, function(d: any) { d.restBand = Number(v) || 0; });
                    }
                }));
            }

            // [F-11] TERMINALS. Two fixed slots -- one per bound -- rather than an
            // indexed list. A def has exactly two ends, so a list would let an author add a
            // third row that can never fire, and ordering within one bound is meaningless.
            // The note is the whole control: an empty note IS no terminal (ceStateTerminalOf
            // skips blanks), so there is no enable switch to fall out of sync with it.
            var termList: any[] = Array.isArray(def.terminal) ? def.terminal : [];
            var termAt = function(where: string): string {
                for (var ti = 0; ti < termList.length; ti++) {
                    if (termList[ti] && termList[ti].at === where) return String(termList[ti].note || '');
                }
                return '';
            };
            var termSet = function(where: string, note: string): Promise<any> {
                return _ceStateDefOp(dId, function(d: any) {
                    var next: any[] = (Array.isArray(d.terminal) ? d.terminal : []).filter(function(t: any) {
                        return t && t.at !== where;
                    });
                    if (String(note || '').trim()) next.push({ at: where, note: note });
                    d.terminal = next;
                });
            };
            body.push(ceSub('t3', 'Terminals \u2014 what happens when this value reaches an end of '
                + 'its range. A terminal REPLACES the roll\u2019s usual outcome directive. Leave blank '
                + 'for none; the first terminal reached, in this list\u2019s order, is the only one that fires.'));
            body.push(h(ceField, {
                k: accId + ':tmin', label: 'At minimum (' + _ceStateBounds(def).lo + ')',
                value: termAt('min'),
                placeholder: 'e.g. This character dies from their wounds\u2026',
                onCommit: function(v: string) { return termSet('min', v); }
            }));
            body.push(h(ceField, {
                k: accId + ':tmax', label: 'At maximum (' + _ceStateBounds(def).hi + ')',
                value: termAt('max'),
                placeholder: '',
                onCommit: function(v: string) { return termSet('max', v); }
            }));

            // [EVT-BAND] ONE DIRECTIVE PER BAND, and it is the same feature as the two
            // fields above rather than a second one: a terminal fires ON CROSSING at every
            // write (F-12a), so a directive hung on a band is delivered exactly once, the
            // turn the value arrives there. That is what paces an encounter -- the model
            // hears about it when it MOVED, not on every turn it is running.
            //   THE ROW IS LABELLED WITH THE BAND IT POINTS AT, because the address is an
            //   INDEX and an index does not survive a reorder. A directive that has come
            //   loose therefore reads as obviously attached to the wrong words instead of
            //   firing silently at the wrong step.
            //   OFFERED ON EVERY DEF, not only encounter shapes. "Say something the first
            //   time Health drops to badly hurt" is the same feature on a character sheet,
            //   and gating it by scope would be a rule the type does not have.
            var termBands: any[] = Array.isArray(def.bands) ? def.bands : [];
            if (termBands.length) {
                var termAtBand = function(bi: number): string {
                    for (var tb = 0; tb < termList.length; tb++) {
                        if (!termList[tb]) continue;
                        if (Number(termList[tb].band) === bi) return String(termList[tb].note || '');
                    }
                    return '';
                };
                var termSetBand = function(bi: number, note: string): Promise<any> {
                    return _ceStateDefOp(dId, function(d: any) {
                        var next: any[] = (Array.isArray(d.terminal) ? d.terminal : []).filter(function(t: any) {
                            return t && Number(t.band) !== bi;
                        });
                        if (String(note || '').trim()) next.push({ at: 'band', band: bi, note: note });
                        d.terminal = next;
                    });
                };
                body.push(ceSub('t3', 'Per-band directives \u2014 sent once, the turn the value '
                    + 'ARRIVES in that band, and not again while it sits there. This is how an '
                    + 'encounter paces itself.'));
                for (var tbi = 0; tbi < termBands.length; tbi++) {
                    (function(bi: number) {
                        var bLab = String((termBands[bi] && termBands[bi].label) || '').trim();
                        body.push(h(ceField, {
                            k: accId + ':tband:' + bi,
                            label: 'On reaching \u201c' + (bLab || ('band ' + (bi + 1))) + '\u201d',
                            value: termAtBand(bi),
                            placeholder: 'e.g. Two of them are down. The last is backing toward the door\u2026',
                            onCommit: function(v: string) { return termSetBand(bi, v); }
                        }));
                    })(tbi);
                }
            }

            // [EVENT] THE SHAPE'S OWN WAGER, offered on encounter shapes and nowhere else --
            // an ordinary state has tables pointed AT it and does not own one. This is what
            // makes Begin two controls and a button: the table comes with the shape, so an
            // author starting a fight is never asked what a strong hit takes off it.
            if (String(def.scope || '') === 'event') {
                var evStkOpts: any[] = [{ id: '', label: 'None' }];
                var evStkList: StakeDef[] = ceStakeDefs(cfg);
                for (var esi = 0; esi < evStkList.length; esi++) {
                    evStkOpts.push({ id: String(evStkList[esi].id),
                                     label: String(evStkList[esi].name || evStkList[esi].id) });
                }
                body.push(ceSettingRow('Its wager',
                    'The table that moves this track. Its rows should aim at this state \u2014 '
                    + 'a strong hit takes more off it than a graze does.',
                    ceSelect({ k: accId + ':evstake', value: String((def as any).eventStakeId || ''),
                               options: evStkOpts,
                               onCommit: function(v: string) {
                                   return _ceStateDefOp(dId, function(d: any) { d.eventStakeId = String(v || ''); });
                               } })));
            }

            // [F-11] The modifier attachment. The ONLY attach flag with a live reader, so
            // it is the only one with a control -- the rest of D-24's list stays declared and
            // unedited until the verb that reads it exists.
            var isMod = ceStateIsModifier(def);
            // [F-29] THE HINT NAMES THE SCOPE RULE, because the control cannot enforce it
            // without hiding a legal edit: a world-scoped def may be marked and simply is
            // not offerable, and an author who is not told that reads the empty approach
            // list as the bug it used to be.
            body.push(ceSettingRow('Feeds rolls',
                'This value adds to a roll made with it as the approach, and joins the '
                + 'approach list on the Move panel. Character and Protagonist states only \u2014 '
                + 'a roll reads the rating off whoever is acting.',
                ceToggle(isMod, accId + ':mod', function() {
                    return _ceStateDefOp(dId, function(d: any) {
                        var keep: string[] = (d.attach || []).filter(function(a: string) { return a !== 'modifier'; });
                        if (!isMod) keep.push('modifier');
                        d.attach = keep;
                    });
                })));

            // [G-02] The hide flag. Sits beside "Feeds rolls" because both are questions
            // about how this def BEHAVES rather than what it spans, and both are one bit.
            var isHid = !!(def as any).hideAtStart;
            body.push(ceSettingRow('Hide until it moves',
                'On a profile, this row stays out of the way while the value is still its '
                + 'starting one. A button at the bottom of the list brings it back. Nothing '
                + 'else changes \u2014 it still injects, still feeds rolls, still terminates.',
                ceToggle(isHid, accId + ':hide', function() {
                    return _ceStateDefOp(dId, function(d: any) { d.hideAtStart = !isHid; });
                })));

            // [F-11c] DUPLICATE, because a state is mostly its BANDS -- seven lines of
            // authored prose plus terminals -- and a variant of one that exists ("Suspicion,
            // but for the second job") was a retype of all of it. A structural clone through
            // JSON: bands, terminal and attach are arrays of objects, and a shallow copy
            // would hand the copy the ORIGINAL's arrays, so editing one band would edit both
            // defs' band. The copy takes a NEW ID -- values are stored against the id, so a
            // shared one would make the two defs one number wearing two names.
            // INSERTED AFTER ITS ORIGINAL rather than appended: the catalog is read in
            // authored order and a copy that lands at the far end is one an author has to go
            // and find.
            body.push(ceBtn('Duplicate state', accId + ':dup', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var dl: any[] = (c as any).stateDefs || [];
                    var si = -1;
                    for (var k = 0; k < dl.length; k++) { if (dl[k] && String(dl[k].id) === dId) { si = k; break; } }
                    if (si < 0) return;
                    var copy: any = JSON.parse(JSON.stringify(dl[si]));
                    copy.id = 'st_' + generateId();
                    copy.name = String(dl[si].name || 'State') + ' (copy)';
                    dl.splice(si + 1, 0, copy);
                }); }).then(cePublishSettings);
            }));
            body.push(_ceSettingsDeleteBtn(accId, 'Delete state\u2026'));
            body.push(_ceSettingsConfirmRow(accId, confirm,
                'Delete \u201c' + (def.name || 'this state') + '\u201d? Values already stored on characters are left behind, unread. This cannot be undone.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var l: any[] = (c as any).stateDefs || [];
                        var di = -1;
                        for (var k = 0; k < l.length; k++) { if (l[k] && String(l[k].id) === dId) { di = k; break; } }
                        if (di >= 0) l.splice(di, 1);
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }));

            // The summary is the def in one line: what it is scoped to, what it spans, and
            // whether it can ever be said out loud. That last clause is D-21 made visible --
            // an author should be able to see from the collapsed row that Currency is mute.
            var b = _ceStateBounds(def);
            var sumParts: string[] = [];
            if (String(def.category || '').trim()) sumParts.push(String(def.category).trim());
            sumParts.push(scopeRow ? scopeRow.label : String(def.scope || '?'));
            sumParts.push(b.lo + '\u2013' + b.hi);
            sumParts.push(bands.length ? (bands.length + ' bands') : 'no bands (never injects)');
            if (bands.length && String(def.line || '').trim()) sumParts.push('custom line');
            if (ceStateIsModifier(def)) {
                var isAppr = false;
                var apprs = ceStateApproaches(cfg);
                for (var ai = 0; ai < apprs.length; ai++) { if (apprs[ai].id === dId) { isAppr = true; break; } }
                // [F-29] The else branch is no longer "a modifier that is not one of the
                // four" -- it is a modifier no roll can read (wrong scope, or managed), and
                // it says so rather than reading as a lesser grade of the same thing.
                sumParts.push(isAppr ? 'approach' : 'feeds rolls \u00b7 not offerable');
            }
            if (termList.length) sumParts.push(termList.length === 2 ? 'two terminals' : 'terminal');
            if ((def as any).hideAtStart) sumParts.push('hides at start');

            var kCat = String(def.category || '').trim();
            if (!kidsByCat[kCat]) kidsByCat[kCat] = [];
            kidsByCat[kCat].push(ceExpandRow({
                id: accId, label: def.name || 'Unnamed state', open: open,
                summary: sumParts.join(' \u00b7 '),
                children: ceStack(CE_T.s3, body)
            }));
        })(list[i]);
    }

    var addBtn = ceBtn('+ Add state', 'set:state:add', function() {
        return ceSettingsOp(function() { return mutConfig(function(c: any) {
            if (!(c as any).stateDefs) (c as any).stateDefs = [];
            // [F-11b] A NEW DEF INHERITS THE LAST ONE'S CATEGORY. Defs are authored in
            // runs -- four skills, then three resources -- and retyping the category each time
            // is the friction that stops people using the field at all.
            var lastCat = '';
            var sdl: any[] = (c as any).stateDefs;
            if (sdl.length) lastCat = String(sdl[sdl.length - 1].category || '');
            sdl.push({
                id: 'st_' + generateId(), name: 'New State', scope: 'char', category: lastCat,
                min: 0, max: 10, start: 0, bands: [], restBand: 0
            });
        }); }).then(cePublishSettings);
    });

    // Category sections in ceStateGrouped's order, applied to the defs themselves so the
    // editor and the drill sort identically. [G-03] cfg is threaded so the editor honours
    // the authored order it is itself the door to -- an editor sorting differently from the
    // surface it configures is how an author concludes the control does nothing.
    var catGroups = ceStateGrouped(list.map(function(d: any) { return { category: String(d.category || '') }; }), cfg);
    var sections: any[] = [];
    for (var ci = 0; ci < catGroups.length; ci++) {
        var cname = String(catGroups[ci].category || '');
        var ckids: any[] = kidsByCat[cname.trim()] || [];
        if (!ckids.length) continue;
        sections.push(ceGroup((cname ? cname : 'Uncategorised') + ' (' + ckids.length + ')',
                              ceStack(null, ckids)));
    }

    // [G-03] THE ORDER CONTROL. Up/down only -- names are NOT editable here, because a
    // category's name lives on the defs that carry it and a text box in this list would be a
    // second writer for it that renamed nothing. It lists the categories that ACTUALLY EXIST
    // (derived from the defs, in the order now in force), so a stale entry in the stored
    // array is invisible rather than confusing.
    var liveCats: string[] = [];
    for (var lc = 0; lc < catGroups.length; lc++) {
        var lcn = String(catGroups[lc].category || '');
        if (lcn) liveCats.push(lcn);
    }
    var writeCatOrder = function(next: string[]): Promise<any> {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) { (c as any).stateCategoryOrder = next.slice(); });
        }).then(cePublishSettings);
    };
    var catOrderRows: any[] = [];
    for (var co = 0; co < liveCats.length; co++) {
        catOrderRows.push((function(nm: string, idx: number) {
            return ceListRow({
                key: 'set:catord:' + nm, label: nm,
                sub: (kidsByCat[nm] ? kidsByCat[nm].length : 0) + ' states',
                trail: ceInline({ gap: CE_T.s1 }, [
                    ceIconBtn('Move ' + nm + ' up', ceIconUp(), 'set:catup:' + nm, function() {
                        if (idx === 0) return Promise.resolve();
                        var n2 = liveCats.slice();
                        var t = n2[idx - 1]; n2[idx - 1] = n2[idx]; n2[idx] = t;
                        return writeCatOrder(n2);
                    }),
                    ceIconBtn('Move ' + nm + ' down', ceIconDown(), 'set:catdn:' + nm, function() {
                        if (idx === liveCats.length - 1) return Promise.resolve();
                        var n3 = liveCats.slice();
                        var t2 = n3[idx + 1]; n3[idx + 1] = n3[idx]; n3[idx] = t2;
                        return writeCatOrder(n3);
                    })
                ])
            });
        })(liveCats[co], co));
    }
    var catOrderGroup: any = (liveCats.length > 1)
        ? ceGroup('Category order (' + liveCats.length + ')', ceStack(CE_T.s2, [
            ceSub('t2', 'The order these sections appear in, here and on every profile. '
                + 'Uncategorised states are always last.'),
            ceStack(CE_T.s1, catOrderRows)
          ]))
        // ONE CATEGORY CANNOT BE REORDERED, so the control is absent rather than present and
        // inert -- a pair of arrows that never do anything is a control that looks broken.
        : null;

    return ceStack(CE_T.s4, sections.concat(catOrderGroup ? [catOrderGroup] : []).concat([
        ceGroup('All states (' + list.length + ')', ceStack(CE_T.s1, [
            // [STYLE2] ceSub, not an inline fontSize + a literal '0.58'. SS5 forbids a
            // surface setting type inline and SS4's ladder is three NAMED rungs; a literal
            // opacity string is how a fourth value gets into the codebase.
            ceSub('t3', 'A state is a bounded number with optional bands. Health, coin, standing, '
                + 'how drunk somebody is \u2014 all the same thing, told apart by their bounds and '
                + 'their words. Set values on a character from their Profile.'),
            list.length ? null : ceEmpty('No states defined.', null),
            addBtn,
            // [CFG-RESEED] THE OTHER DIRECTION FROM RESEED, and both are wanted for the same
            // reason: the shipped catalog is a demonstration, not a foundation, and a story
            // that is not about coin and luck starts by deleting fourteen rows one at a time.
            // TWO VERBS AND NOT ONE. "The shipped ones" is the common case -- clear the demo,
            // keep what you wrote -- and it is exact rather than a guess, because the seeded
            // defs carry fixed ids (st_currency, st_luck and the rest) that DEFAULT_STATE_DEFS
            // still names. "Everything" is the blank-slate case and says so.
            // WHAT SURVIVES IS THE SAME AS EVER: values live on the records, keyed by state
            // id, and every reader iterates the DEFS -- so a cleared catalog leaves stored
            // numbers dormant rather than dangling, and re-seeding brings them back.
            !list.length ? null : _ceSettingsDeleteBtn('stclearseed', 'Delete the shipped states\u2026'),
            _ceSettingsConfirmRow('stclearseed', confirm,
                'Delete every state this engine ships with, keeping the ones you wrote? '
                + 'Values already stored on your characters are left behind, unread, and come '
                + 'back if the state does.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        var seeded: any = {};
                        for (var si = 0; si < DEFAULT_STATE_DEFS.length; si++) {
                            seeded[String((DEFAULT_STATE_DEFS[si] as any).id)] = 1;
                        }
                        (c as any).stateDefs = ((c as any).stateDefs || []).filter(function(d: any) {
                            return !(d && seeded[String(d.id)]);
                        });
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                }),
            !list.length ? null : _ceSettingsDeleteBtn('stclearall', 'Delete every state\u2026'),
            _ceSettingsConfirmRow('stclearall', confirm,
                'Delete the entire state catalog, including states you wrote yourself? '
                + 'Values already stored on your characters are left behind, unread. Reseed '
                + 'the states to get the shipped ones back.',
                function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) {
                        (c as any).stateDefs = [];
                        // The order list is a list of CATEGORY names, and a category exists
                        // only because a def carries it. Left behind it would be a stored
                        // array naming nothing -- the same stale-entry case the order control
                        // already hides rather than shows.
                        (c as any).stateCategoryOrder = [];
                    }); }).then(function() {
                        ceSettingsPatch(function() { return { confirm: '' }; });
                        return cePublishSettings();
                    });
                })
        ])),
        ceGroup('Not here yet', ceStack(CE_T.s2, [
            ceProse('t2',
                'World- and faction-scoped states can be defined above but have nowhere to be '
                + 'set yet \u2014 their value doors come with the surfaces that own them. Character '
                + 'and protagonist states are live now, on the Profile.')
        ])),
        // [CFG-RESEED] MOST OF WHAT THIS TOUCHES IS RECOVERABLE AND THE WARNING SAYS SO.
        // The shipped defs keep their ids across versions (st_currency, st_luck and the
        // rest), so a character's stored value for a seeded state survives the swap intact
        // -- the def is replaced, the number under it is not. What is genuinely lost is a
        // def the AUTHOR wrote, and its values then go DORMANT rather than dangling: every
        // reader iterates the defs, so nothing reads an orphaned key, and re-creating the
        // def with the same id brings the old values straight back.
        ceGroup('Reseed the states', _ceReseedGroup('states', 'Reseed states\u2026',
            'Replace the whole state catalog with the one a new story ships with. Use this '
            + 'when a story was started on an older version and its resources are a seed '
            + 'behind.',
            'Replace every state definition with the current defaults? States you wrote '
            + 'yourself are removed. Values already on your characters are NOT deleted: the '
            + 'shipped states keep their ids so their numbers carry over, and a custom '
            + 'state\u2019s values sit dormant until a state with that id exists again.',
            CE_RESEED_STATES, confirm))
    ]));
}

// ======================================================================================
// -- FACTIONS TAB ----------------------------------------------------------------------
// ======================================================================================
// [F-15b] THE ROLLS TAB. Its own tab rather than a group on States, and the reason is not
// size -- it is that the two are different records answering different questions. A
// StateDef is a bounded number a character CARRIES; a ResolutionDef is how an attempt is
// JUDGED, and it belongs to the world rather than to anybody. Folding it under States would
// also have put the future Stakes table (F-14a) -- which is neither a state nor a
// resolution but the bridge between them -- somewhere with no honest heading.
// THIS TAB IS WHERE STAKES LAND. Deciding that now is what stops the question being reopened
// under time pressure later.
function _ceSettingsRollsTab(cfg: any, openMap: any, confirm: string): any {
    var list: any[] = ceResolutionDefs(cfg);
    var kids: any[] = [];
    var i: number;

    // [ACT-MODE-DOORS] THE SECOND DOOR, AND THE ONE THAT MATTERS. Its twin sits at the foot
    // of the Actions panel, which is a deliberate exception to SPEC-CTX's one-door rule --
    // and the exception is structural rather than a promise. Both controls write the SAME
    // field through the SAME verb (ceActionsModeSet), so there is no second state for them to
    // disagree about; and 'none' UNREGISTERS THE PANEL, so the panel cannot be its own way
    // back. A single door on a surface that can delete itself is a one-way switch.
    //   ON ROLLS, NOT SYSTEM. I-04 already moved a per-turn control off that panel and into
    //   this tab on the argument that how an attempt is judged is world vocabulary; what
    //   SHAPE the surface asking takes is the same kind of decision and belongs beside it.
    kids.push(ceWrap({ key: 'set:act:mode' }, [
        ceSettingRow('Actions panel', 'What the panel below the editor asks for',
            ceSelect({ k: 'set:act:mode', value: ceActionsMode(cfg), options: CE_ACT_MODES,
                       onCommit: function(v: string) { return ceActionsModeSet(v); } }))
    ]));
    if (ceActionsMode(cfg) === CE_ACT_MODE_SIMPLE) {
        // [ACT-MODE] THE WAGER ROW EXISTS ONLY IN THE MODE IT GOVERNS. In Full the approach
        // decides the wager and this would be a second, silently-ignored answer to the same
        // question; in Off there is no roll to charge. Seeded 'None' and that is the shipped
        // default -- per author a simple action is narrative and risks nothing unless asked.
        var swOpts: any[] = [{ id: '', label: 'None' }];
        var swl = ceStakeDefs(cfg);
        for (i = 0; i < swl.length; i++) {
            if (!swl[i]) continue;
            // [F-31] An encounter's own wager is filtered out here for the reason the full
            // panel's Stakes control filters it: it rides every roll while one runs, so
            // naming it as the base wager charges one track twice.
            if (ceStakeIsEvent(cfg, swl[i])) continue;
            swOpts.push({ id: String(swl[i].id), label: String(swl[i].name || swl[i].id) });
        }
        kids.push(ceWrap({ key: 'set:act:wager' }, [
            ceSettingRow('Simple actions risk', 'Charged on every simple roll \u00b7 None by default',
                ceSelect({ k: 'set:act:wager', value: String((cfg as any).simpleWagerId || ''),
                           options: swOpts,
                           onCommit: function(v: string) {
                               return ceSettingsOp(function() {
                                   return mutConfig(function(c: any) {
                                       (c as any).simpleWagerId = String(v || '');
                                   });
                               }).then(cePublishActions).then(cePublishSettings);
                           } }))
        ]));
    }
    kids.push(ceRule());

    // [I-04] THE DEFAULT, FIRST, BECAUSE IT IS THE ONLY ONE ANY ROLL WILL USE. The Actions
    // panel's resolution control is deleted -- per author an action exists because it can fail,
    // and which table judges it is world vocabulary rather than a per-turn decision. This row is
    // that decision's one and only door.
    // ceSettingRow + ceSelect, NOT AN ACCORDION: a closed, short, self-describing list is what
    // CE-STYLE 13 keeps ceSelect for. The tables themselves are edited below it.
    // ONE NODE IS PUSHED WHATEVER THE COUNT, and it is keyed. A branch that pushed nothing in
    // the one-resolution case would change this list's LENGTH the moment a second table was
    // added, and this list mixes keyed rows with unkeyed ones -- the H-01 class exactly.
    var defOpts: any[] = [];
    for (i = 0; i < list.length; i++) {
        if (!list[i]) continue;
        defOpts.push({ id: String(list[i].id), label: String(list[i].name || list[i].id) });
    }
    kids.push(ceWrap({ key: 'set:res:defrow' }, [
        (defOpts.length > 1)
            ? ceSettingRow('Default resolution', 'Every action in this world is judged by this table',
                ceSelect({ k: 'set:res:default', value: ceDefaultResolutionId(cfg), options: defOpts,
                           onCommit: function(v: string) {
                               return ceSettingsOp(function() {
                                   return mutConfig(function(c: any) {
                                       (c as any).defaultResolutionId = String(v || '');
                                   });
                               }).then(cePublishSettings);
                           } }))
            : ceSub('t3', 'There is one resolution, so every action is judged by it. Write a '
                + 'second below and a chooser appears here.')
    ]));

    for (i = 0; i < list.length; i++) {
        (function(def: any) {
            var dId = String(def.id);
            var accId = 'set:res:' + dId;
            var bands: any[] = Array.isArray(def.bands) ? def.bands : [];
            var cnt = Math.max(0, Math.min(20, Math.round(Number(def.count) || 0)));
            var sds = Math.max(2, Math.min(1000, Math.round(Number(def.sides) || 6)));

            var body: any[] = [
                h(ceField, { k: accId + ':name', label: 'Name', value: String(def.name || ''),
                    onCommit: function(v: string) { return _ceResDefOp(dId, function(d: any) { d.name = v; }); } }),

                // Dice as two plain numbers, CLAMPED ON READ by ceRollDice rather than
                // rejected here -- an author mid-edit should not meet a validation dialog,
                // and a count of 5000 would hang the loop it feeds.
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ ceNumField({ k: accId + ':count', label: 'How many dice', value: cnt,
                        onCommit: function(n: number) { return _ceResDefOp(dId, function(d: any) { d.count = n; }); } }) ]),
                    ceGrow(null, [ ceNumField({ k: accId + ':sides', label: 'Faces each', value: sds,
                        onCommit: function(n: number) { return _ceResDefOp(dId, function(d: any) { d.sides = n; }); } }) ])
                ]),

                // THE RANGE IS STATED, because it is what makes the band table's numbers
                // mean anything and it is not derivable at a glance from 3d6. At zero dice
                // it says something different and more important: this is a no-roll.
                ceSub('t3', cnt === 0
                    ? 'No dice \u2014 this always lands on the first outcome its modifiers reach, '
                      + 'so a single outcome with a low threshold always fires. Use it for things '
                      + 'that simply happen: resting, paying, travelling.'
                    : ('Rolls ' + cnt + 'd' + sds + ' \u2014 ' + cnt + ' to ' + (cnt * sds)
                       + ' before modifiers, which can push it either side.')),

                ceSub('t3', 'Outcomes \u2014 each is a lower bound on the modified total. '
                    + 'THE FIRST ONE IS THE FLOOR whatever number it carries, so a heavily '
                    + 'penalised roll can never fall through the table into nothing.'),
                ceIndexedRollBands(bands, function(next: any[]) {
                    return _ceResDefOp(dId, function(d: any) { d.bands = next; });
                }, accId + ':band')
            ];

            // DESTRUCTIVE-NEVER-IN-PLACE: the arming button and the confirmed Delete are
            // two different controls, so the irreversible one did not exist at the moment
            // of the first press. Same pair every other Settings list uses.
            // Deleting the LAST resolution is refused outright rather than guarded
            // downstream -- ceResolutionDef's fall-to-first has no first to fall to, and
            // the surface is where an author can be told why.
            if (list.length > 1) {
                var delKey = accId + ':del';
                if (confirm !== delKey) {
                    body.push(_ceSettingsDeleteBtn(delKey, 'Delete this resolution\u2026'));
                } else {
                    body.push(_ceSettingsConfirmRow(delKey, confirm,
                        'Delete "' + String(def.name || dId) + '"? If it is the default, every '
                            + 'action falls back to the first resolution in this list.',
                        function() {
                            return ceSettingsOp(function() {
                                return mutConfig(function(c: any) {
                                    var l: any[] = (c as any).resolutionDefs || [];
                                    for (var k = 0; k < l.length; k++) {
                                        if (l[k] && String(l[k].id) === dId) { l.splice(k, 1); break; }
                                    }
                                    // [I-04] THE DEFAULT CANNOT POINT AT A DELETED TABLE.
                                    // ceDefaultResolutionId would resolve it to the first def
                                    // either way; a stored id that disagrees with the resolved
                                    // one is how this control comes to display a table no roll
                                    // uses. Note the `break` -- the early `return` this replaced
                                    // would have skipped the clear.
                                    if (String((c as any).defaultResolutionId || '') === dId) {
                                        (c as any).defaultResolutionId = '';
                                    }
                                });
                            }).then(cePublishSettings);
                        }));
                }
            } else {
                body.push(ceSub('t3', 'This is the only resolution, so it cannot be deleted \u2014 '
                    + 'a world with none has nothing to roll.'));
            }

            kids.push(ceExpandRow({
                id: accId, label: String(def.name || 'Unnamed resolution'), open: !!openMap[accId],
                summary: (cnt === 0 ? 'no roll' : (String(cnt) + 'd' + String(sds)))
                    + ' \u00b7 ' + bands.length + ' outcome' + (bands.length === 1 ? '' : 's'),
                children: ceStack(CE_T.s3, body)
            }));
        })(list[i]);
    }

    kids.push(ceBtn('+ Add resolution', 'set:res:add', function() {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                if (!(c as any).resolutionDefs) (c as any).resolutionDefs = [];
                // NOTES ARE SEEDED, NOT LEFT BLANK. A band with no note reaches the model
                // as nothing at all, which is indistinguishable from a broken injection --
                // see the IMP-TRACE note in ceCommitResolution. A new table should work on
                // the first roll and be edited afterwards.
                (c as any).resolutionDefs.push({
                    id: 'res_' + generateId(), name: 'New resolution', count: 1, sides: 20,
                    bands: [
                        { at: -999, label: 'Failure',
                          note: 'The attempt fails. Name what goes wrong and let it cost something.' },
                        { at: 11, label: 'Success',
                          note: 'The attempt succeeds. Give it to them plainly.' }
                    ]
                });
            });
        }).then(cePublishSettings);
    }));

    // ── Stakes  [F-14] ───────────────────────────────────────────────────────
    // ONE EDITOR, TWO SIDES, N ROWS DERIVED FROM THE BOUND RESOLUTION'S OWN BANDS. The rows
    // are labelled with the outcome words the author wrote rather than "Row 1", which is
    // the entire reason StakeDef carries a resolutionId.
    var stakeList: any[] = ceStakeDefs(cfg);
    var apprList: any[] = ceStateApproaches(cfg);
    // [F-14p] POSITION IS OFFERED IN THE SAME LIST AS THE STATES, and until now it was not.
    // StakeCell has carried kind:'pressure' since F-17 and the seeded Regard stake uses it,
    // but this dropdown only ever listed StateDefs -- so a pressure cell (defId '') rendered
    // as "Nothing", which is the editor LYING about a stake that charges every Flair roll.
    // Touching that dropdown then wrote a defId onto a cell whose kind still said 'pressure',
    // leaving a hybrid ceApplyStake reads as pressure and the editor draws as a state.
    // A SENTINEL RATHER THAN A SECOND CONTROL: kind and defId are one choice to the author
    // ("what does this cost"), and splitting them across two widgets would make the
    // impossible combination reachable again.
    var stateOpts: any[] = [{ id: '', label: 'Nothing' },
                            { id: CE_STAKE_CELL_PRESSURE, label: 'Position (with the one aimed at)' },
                            // [T-20] Third entry, same sentinel mechanism. Its unit is said in
                            // the label because the amount field beside it cannot say it, and
                            // "By 30" meaning half an hour is not guessable.
                            { id: CE_STAKE_CELL_TIME, label: 'Time (minutes on the clock)' }];
    var allDefs: any[] = ceStateDefs(cfg);
    for (i = 0; i < allDefs.length; i++) {
        if (!allDefs[i]) continue;
        // [EVENT] MARKED IN THE LABEL. An encounter shape sits in the same flat list as
        // Health and Currency and charges something that only exists while a fight is
        // running; an author picking it needs to know that at the moment they pick it, not
        // after a roll silently moved nothing.
        stateOpts.push({ id: String(allDefs[i].id),
                         label: String(allDefs[i].name || allDefs[i].id)
                              + (String(allDefs[i].scope || '') === 'event' ? ' (encounter)' : '') });
    }
    var resOpts: any[] = [];
    for (i = 0; i < list.length; i++) { resOpts.push({ id: String(list[i].id), label: String(list[i].name || list[i].id) }); }

    var stakeKids: any[] = [];
    for (i = 0; i < stakeList.length; i++) {
        (function(sd: any) {
            var sId = String(sd.id);
            var sAcc = 'set:stake:' + sId;
            var boundRes: any = ceResolutionDef(cfg, String(sd.resolutionId || ''));
            var rBands: any[] = (boundRes && Array.isArray(boundRes.bands)) ? boundRes.bands : [];
            var sRows: any[] = Array.isArray(sd.rows) ? sd.rows : [];

            var sBody: any[] = [
                h(ceField, { k: sAcc + ':name', label: 'Name', value: String(sd.name || ''),
                    onCommit: function(v: string) { return _ceStakeDefOp(sId, function(d: any) { d.name = v; }); } }),

                ceSelect({ k: sAcc + ':res', label: 'Judged by', value: String(sd.resolutionId || ''),
                    options: resOpts,
                    hint: 'Which resolution\u2019s outcomes these rows line up with.',
                    onCommit: function(v: string) { return _ceStakeDefOp(sId, function(d: any) { d.resolutionId = v; }); } })
            ];

            // THE DEFAULTS, AS TOGGLES. This is the control the whole feature exists for:
            // an approach checked here means the author never has to choose this wager again.
            if (apprList.length) {
                var apprRows: any[] = [];
                for (var ai = 0; ai < apprList.length; ai++) {
                    (function(ap: any) {
                        var apId = String(ap.id);
                        var on = false;
                        var dfa: any[] = Array.isArray(sd.defaultForApproach) ? sd.defaultForApproach : [];
                        for (var k = 0; k < dfa.length; k++) { if (String(dfa[k]) === apId) { on = true; break; } }
                        apprRows.push(ceSettingRow(String(ap.name || apId), '',
                            ceToggle(on, sAcc + ':dfa:' + apId, function() {
                                return _ceStakeDefOp(sId, function(d: any) {
                                    var cur: any[] = Array.isArray(d.defaultForApproach) ? d.defaultForApproach.slice() : [];
                                    var at = -1;
                                    for (var q = 0; q < cur.length; q++) { if (String(cur[q]) === apId) { at = q; break; } }
                                    if (at >= 0) cur.splice(at, 1); else cur.push(apId);
                                    d.defaultForApproach = cur;
                                });
                            }, 'Default wager for ' + String(ap.name || apId))));
                    })(apprList[ai]);
                }
                sBody.push(ceGroup('Default for', ceStack(null, apprRows)));
                sBody.push(ceSub('t3', 'A move using one of these approaches risks this unless the '
                    + 'player overrides it on the Actions panel. First match in this list wins, so '
                    + 'reorder the stakes to break a tie.'));
            }

            // One group per outcome. ROWS ARE DRAWN FROM THE RESOLUTION, so deleting an
            // outcome removes its row here on the next repaint and nothing has to be
            // migrated -- ceApplyStake clamps by index at fire time.
            if (!rBands.length) {
                sBody.push(ceSub('t3', 'That resolution has no outcomes yet, so there is nothing to '
                    + 'hang a cost on. Add outcomes to it above.'));
            }
            for (var bi = 0; bi < rBands.length; bi++) {
                (function(bIdx: number) {
                    var bandLab = String((rBands[bIdx] && rBands[bIdx].label) || ('Outcome ' + (bIdx + 1)));
                    var rw: any = sRows[bIdx] || { actor: { defId: '', amount: 0 }, target: { defId: '', amount: 0 } };
                    var cellRow = function(sideKey: string, sideLabel: string): any {
                        var cell: any = rw[sideKey] || { defId: '', amount: 0 };
                        return ceStack({ gap: CE_T.s1, key: sAcc + ':' + bIdx + ':' + sideKey }, [
                            ceKey(sideLabel),
                            ceBar({ gap: CE_T.s2 }, [
                                ceGrow(null, [ ceSelect({
                                    k: sAcc + ':' + bIdx + ':' + sideKey + ':def',
                                    // [F-14p] kind wins over defId when reading. A pressure
                                    // cell IGNORES defId by contract, so showing defId here
                                    // is what produced the "Nothing" misreport.
                                    value: (String(cell.kind || 'state') === 'pressure')
                                        ? CE_STAKE_CELL_PRESSURE
                                        : ((String(cell.kind || 'state') === 'time')
                                            ? CE_STAKE_CELL_TIME : String(cell.defId || '')),
                                    options: stateOpts,
                                    onCommit: function(v: string) {
                                        return _ceStakeCellOp(sId, bIdx, sideKey, function(cl: any) {
                                            // BOTH FIELDS WRITTEN ON EVERY COMMIT, never one.
                                            // Leaving a stale kind behind is the hybrid this
                                            // sentinel exists to make unreachable.
                                            if (v === CE_STAKE_CELL_PRESSURE) { cl.kind = 'pressure'; cl.defId = ''; }
                                            else if (v === CE_STAKE_CELL_TIME) { cl.kind = 'time'; cl.defId = ''; }
                                            else { cl.kind = 'state'; cl.defId = v; }
                                        });
                                    }
                                }) ]),
                                h('div', { style: { flex: '0 0 96px' } }, [
                                    ceNumField({
                                        k: sAcc + ':' + bIdx + ':' + sideKey + ':amt',
                                        label: 'By', value: Math.round(Number(cell.amount) || 0),
                                        onCommit: function(n: number) {
                                            return _ceStakeCellOp(sId, bIdx, sideKey, function(cl: any) { cl.amount = n; });
                                        }
                                    })
                                ])
                            ])
                        ]);
                    };
                    sBody.push(ceGroup(bandLab, ceStack(CE_T.s2, [
                        cellRow('actor', 'The one who acted'),
                        cellRow('target', 'The one aimed at')
                    ])));
                })(bi);
            }

            var sDelKey = sAcc + ':del';
            if (confirm !== sDelKey) {
                sBody.push(_ceSettingsDeleteBtn(sDelKey, 'Delete this stake\u2026'));
            } else {
                sBody.push(_ceSettingsConfirmRow(sDelKey, confirm,
                    'Delete "' + String(sd.name || sId) + '"? Any approach defaulting to it stops charging anything.',
                    function() {
                        return ceSettingsOp(function() {
                            return mutConfig(function(c: any) {
                                var l: any[] = (c as any).stakeDefs || [];
                                for (var k = 0; k < l.length; k++) {
                                    if (l[k] && String(l[k].id) === sId) { l.splice(k, 1); return; }
                                }
                            });
                        }).then(cePublishSettings);
                    }));
            }

            var dfaNames: string[] = [];
            var dfa2: any[] = Array.isArray(sd.defaultForApproach) ? sd.defaultForApproach : [];
            for (var d2 = 0; d2 < dfa2.length; d2++) {
                var apd = ceStateDef(cfg, String(dfa2[d2]));
                if (apd) dfaNames.push(String(apd.name || apd.id));
            }
            stakeKids.push(ceExpandRow({
                id: sAcc, label: String(sd.name || 'Unnamed stake'), open: !!openMap[sAcc],
                summary: (boundRes ? String(boundRes.name || '') : 'no resolution')
                    + ' \u00b7 ' + (dfaNames.length ? ('default for ' + dfaNames.join(', ')) : 'never automatic'),
                children: ceStack(CE_T.s3, sBody)
            }));
        })(stakeList[i]);
    }

    stakeKids.push(ceBtn('+ Add stake', 'set:stake:add', function() {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                if (!(c as any).stakeDefs) (c as any).stakeDefs = [];
                var firstRes: any[] = (c as any).resolutionDefs || [];
                (c as any).stakeDefs.push({
                    id: 'stake_' + generateId(), name: 'New stake',
                    resolutionId: firstRes.length ? String(firstRes[0].id) : '',
                    defaultForApproach: [], rows: []
                });
            });
        }).then(cePublishSettings);
    }));

    return ceStack(CE_T.s4, [
        ceSection('Resolutions', ceStack(CE_T.s3, [
            ceProse('t2', 'How an attempt is judged. The dice and the outcome table are '
                + 'ordinary data \u2014 swapping 2d6 for a d20 and rewriting the bands turns this '
                + 'into a different game with no code behind it.'),
            ceStack(CE_T.s2, kids)
        ])),
        ceSection('Stakes', ceStack(CE_T.s3, [
            ceProse('t2', 'What an outcome costs, and to whom. A stake attached to an approach '
                + 'applies without anyone choosing it, which is the point \u2014 the player only '
                + 'touches the Stakes control when this turn is an exception.'),
            ceProse('t3', 'Keep the numbers small. In a fail-forward game the prose names the '
                + 'price; a ledger moving in tens beside it starts arguing with the sentence '
                + 'the model just wrote.'),
            ceStack(CE_T.s2, stakeKids)
        ])),
        // [CFG-RESEED] Both catalogs together, because defaultResolutionId points into one
        // of them: reseeding the tables and leaving the pointer would name a table that no
        // longer exists, and '' resolving to the first def is the honest reset for it.
        ceGroup('Reseed the rolls', _ceReseedGroup('rolls', 'Reseed rolls\u2026',
            'Replace the resolution tables and the stakes with the ones a new story ships '
            + 'with, and clear the default-table choice.',
            'Replace every resolution table and stake with the current defaults? Tables and '
            + 'stakes you wrote yourself are removed, and the default table falls back to '
            + 'whichever is first.',
            CE_RESEED_ROLLS, confirm))
    ]);
}

// [F-26] _ceSettingsFactionsTab DELETED (147 lines). Its create, rename, describe, delete,
// lorebook-link and trigger-key controls all live on Diplomacy and the faction's own screen
// now. Deleted rather than left unreachable: a tab function with no tab is the fallback that
// the next reader restores by accident.

// ======================================================================================
// -- TIME TAB  [SEC:CLOCK] --------------------------------------------------------------
// ======================================================================================
// THE CALENDAR IS AUTHORED HERE AND NOWHERE ELSE. Three groups, and the order is the order
// somebody thinks in: what the day is called, what the parts of it are called, and what
// moves the clock through them.
//
// THERE IS NO minutes-per-hour OR hours-per-day CONTROL. Per author. They are constants in
// SECTION 7c rather than unread fields on the record -- see F-20 on what a knob with no door
// costs. The week and the year ARE authored, because both are lists somebody actually names.
//
// EVERY COMMIT GOES THROUGH _ceCalMut, which is the only writer of cfg.calendar in the file.
// It materialises the object on FIRST EDIT and never on load: ceCalendar answers every read
// without it, so a load-time default would be the `if (!c.factions)` failure again -- a key
// that reappears after anything removes it.

// The one mutator. ceSettingsOp is the config chain this whole surface already runs on;
// a second chain over one record is how two edits in the same second overwrite each other.
function _ceCalMut(fn: (cal: any) => void): Promise<any> {
    return ceSettingsOp(function() {
        return mutConfig(function(c: any) {
            if (!(c as any).calendar || typeof (c as any).calendar !== 'object') (c as any).calendar = {};
            fn((c as any).calendar);
        });
    }).then(cePublishSettings);
}

// [T-01] THE BAND EDITOR, AND IT IS NOT ceIndexedBands. That primitive writes {at, label}
// LITERALLY on every commit, so reusing it here would silently drop `to` the first time an
// author renamed a band -- which is precisely the failure ceIndexedRollBands exists to avoid,
// one field along. A TimeBandDef is a RANGE, not a threshold, and the two are different shapes.
// ROWS ARE KEYED BY POSITION AND CONTENT, the seed F-25 found missing: without it the array
// moves on a reorder and the text boxes keep their old values, which reads as "reordering
// does nothing".
function _ceTimeBands(bands: any[], keyPfx: string): any {
    var rows: any[] = [];
    var i: number;
    var keep = function(b: any): any {
        return { label: String((b && b.label) || ''),
                 from: Math.round(Number((b && b.from) || 0)),
                 to: Math.round(Number((b && b.to) || 0)) };
    };
    var commit = function(next: any[]): Promise<any> {
        return _ceCalMut(function(cal: any) { cal.bands = next; });
    };
    // [LIST-SWEEP] ONE BOX PER ROW, and `from`/`to` are selects rather than boxes -- a select
    // commits on change, so its value is in storage before any verb is pressed and there is
    // nothing live to read. `keep` is the normaliser _ceRecListLive runs last, which is what
    // carries those two hours through a label read.
    var live = function(): any[] {
        return _ceRecListLive(bands, keyPfx, [{ prop: 'label', k: 'lab' }], keep);
    };
    var ep = _ceListEpochOf(keyPfx);
    var hourOpts: any[] = [];
    for (i = 0; i < CE_HOURS_DAY; i++) {
        hourOpts.push({ id: String(i), label: (i < 10 ? '0' : '') + String(i) + ':00' });
    }
    for (i = 0; i < bands.length; i++) {
        (function(idx: number) {
            var b: any = keep(bands[idx]);
            // The one line that says what this row MEANS, and it earns its place: a wrap is
            // the only thing about a band an author can get wrong without seeing it.
            var span = (b.from < b.to)
                ? ('runs to ' + ((b.to < 10 ? '0' : '') + b.to) + ':00, end exclusive')
                : ((b.from > b.to)
                    ? 'wraps past midnight'
                    : 'starts and ends at the same hour \u2014 this band matches nothing');
            rows.push(ceStack({ gap: CE_T.s2, key: keyPfx + ':row:' + idx }, [
                h(ceField, {
                    k: keyPfx + ':lab:' + idx, label: 'Reads as', value: b.label,
                    seed: keyPfx + ':' + idx + ':' + b.label,
                    onCommit: function(v: string) {
                        if (ep !== _ceListEpochOf(keyPfx)) return Promise.resolve();
                        var next = live(); next[idx].label = v; return commit(next);
                    }
                }),
                // [ROW-PROSE] THE SPAN LINE IS ITS OWN ROW AND WAS ONCE A CELL IN THE ONE
                // BELOW -- reported live as a column of single letters running down the
                // screen. Two selects and three icon buttons is already a full phone row,
                // and ceGrow sets minWidth:0, so the only flexible cell absorbed the entire
                // shortfall and wrapped at every character. THE RULE THIS PROVES, now
                // CE-STYLE 8c: a row carrying two or more controls carries NO prose. This is
                // the same inline axis H-04 found, and the same one SS8b found with a picker
                // -- third time, so it is a rule rather than three incidents.
                ceSub('t3', span),
                ceBar({ gap: CE_T.s2 }, [
                    ceFixed({ basis: '92px' }, [ ceSelect({
                        k: keyPfx + ':from:' + idx, value: String(b.from), options: hourOpts,
                        onCommit: function(v: string) {
                            var next = live(); next[idx].from = _ceHourSafe(v); return commit(next);
                        } })]),
                    ceFixed({ basis: '92px' }, [ ceSelect({
                        k: keyPfx + ':to:' + idx, value: String(b.to), options: hourOpts,
                        onCommit: function(v: string) {
                            var next = live(); next[idx].to = _ceHourSafe(v); return commit(next);
                        } })]),
                    // A SPACER, NOT A TEXT CELL. The row still needs something between the
                    // selects and the verbs to push them apart, and an empty ceGrow can be
                    // squeezed to nothing without anything being illegible.
                    ceGrow(null, []),
                    ceIconBtn('Move ' + (b.label || 'band') + ' up', ceIconUp(), keyPfx + ':up:' + idx, function() {
                        if (idx === 0) return Promise.resolve();
                        var next = live(); var t = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPfx);
                        return commit(next);
                    }),
                    ceIconBtn('Move ' + (b.label || 'band') + ' down', ceIconDown(), keyPfx + ':dn:' + idx, function() {
                        if (idx === bands.length - 1) return Promise.resolve();
                        var next = live(); var t = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = t;
                        _ceListStructural(keyPfx);
                        return commit(next);
                    }),
                    ceIconBtn('Remove ' + (b.label || 'band'), ceIconTrash(), keyPfx + ':rm:' + idx, function() {
                        var next = live(); next.splice(idx, 1);
                        _ceListStructural(keyPfx);
                        return commit(next);
                    }, 'danger')
                ])
            ]));
        })(i);
    }
    // KEYED, AND THE ROWS ABOVE IT ARE TOO -- so this list is ALL-keyed even though its
    // length moves on every add and remove. ceIndexedStates and ceIndexedBands both leave
    // their Add button bare and have not been reported; that is precedent, not correctness,
    // and the rule this file has now paid for three times (SCREEN-KEYED, TABBODY-RECYCLE,
    // H-01) is that a list whose length moves is all-keyed or does not move. ceBtn takes no
    // key of its own, hence the carrier.
    rows.push(ceWrap({ key: keyPfx + ':addrow' }, [
        ceBtn('+ Add band', keyPfx + ':add', function() {
            var next = live();
            var lastTo = next.length ? next[next.length - 1].to : 0;
            next.push({ label: 'New band', from: lastTo, to: _ceHourSafe(lastTo + 4) });
            _ceListStructural(keyPfx);
            return commit(next);
        })
    ]));
    return ceStack(CE_T.s3, rows);
}

// The month editor. A name AND a length, because months differ in length in most calendars
// worth authoring and ceClockMonth walks the list rather than dividing precisely so they can.
// A length below 1 is refused at the write rather than at the read: a zero-day month makes
// the year sum meaningless and there is no sensible thing for the walk to return.
function _ceTimeMonths(months: any[], keyPfx: string): any {
    var rows: any[] = [];
    var i: number;
    var keep = function(m: any): any {
        return { name: String((m && m.name) || ''), days: Math.max(1, Math.round(Number((m && m.days) || 1))) };
    };
    var commit = function(next: any[]): Promise<any> {
        return _ceCalMut(function(cal: any) { cal.months = next; });
    };
    // [LIST-SWEEP] Both cells are boxes here, and both commit on blur, so both are read.
    // `keep` clamps days back above zero after the read exactly as it does after a commit.
    var live = function(): any[] {
        return _ceRecListLive(months, keyPfx,
            [{ prop: 'name', k: 'nm' }, { prop: 'days', k: 'dy', num: true }], keep);
    };
    var ep = _ceListEpochOf(keyPfx);
    for (i = 0; i < months.length; i++) {
        (function(idx: number) {
            var mo: any = keep(months[idx]);
            rows.push(ceBar({ gap: CE_T.s2, key: keyPfx + ':row:' + idx }, [
                ceGrow(null, [ h(ceField, {
                    k: keyPfx + ':nm:' + idx, label: '', value: mo.name,
                    seed: keyPfx + ':' + idx + ':' + mo.name,
                    onCommit: function(v: string) {
                        if (ep !== _ceListEpochOf(keyPfx)) return Promise.resolve();
                        var next = live(); next[idx].name = v; return commit(next);
                    }
                })]),
                ceFixed({ basis: '84px' }, [ ceNumField({
                    k: keyPfx + ':dy:' + idx, label: '', value: mo.days, min: 1, max: 400,
                    onCommit: function(n: number) {
                        if (ep !== _ceListEpochOf(keyPfx)) return Promise.resolve();
                        var next = live(); next[idx].days = Math.max(1, Math.round(n)); return commit(next);
                    },
                    // [LIST-SWEEP] The seed a movable numeric box needs; see ceIndexedBands.
                    seed: keyPfx + ':dy:' + idx + ':' + String(mo.days) })]),
                ceIconBtn('Move ' + (mo.name || 'month') + ' up', ceIconUp(), keyPfx + ':up:' + idx, function() {
                    if (idx === 0) return Promise.resolve();
                    var next = live(); var t = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = t;
                    _ceListStructural(keyPfx);
                    return commit(next);
                }),
                ceIconBtn('Move ' + (mo.name || 'month') + ' down', ceIconDown(), keyPfx + ':dn:' + idx, function() {
                    if (idx === months.length - 1) return Promise.resolve();
                    var next = live(); var t = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = t;
                    _ceListStructural(keyPfx);
                    return commit(next);
                }),
                ceIconBtn('Remove ' + (mo.name || 'month'), ceIconTrash(), keyPfx + ':rm:' + idx, function() {
                    var next = live(); next.splice(idx, 1);
                    _ceListStructural(keyPfx);
                    return commit(next);
                }, 'danger')
            ]));
        })(i);
    }
    // Keyed, same reason as the band editor's -- see the note there.
    rows.push(ceWrap({ key: keyPfx + ':addrow' }, [
        ceBtn('+ Add month', keyPfx + ':add', function() {
            var next = live();
            next.push({ name: 'New month', days: 28 });
            _ceListStructural(keyPfx);
            return commit(next);
        })
    ]));
    return ceStack(CE_T.s2, rows);
}

function _ceSettingsTimeTab(cfg: any, confirm: string): any {
    var cal = ceCalendar(cfg);
    var startHour = Math.floor((Number(cal.startAt) || 0) / CE_MINS_HOUR) % CE_HOURS_DAY;
    var yearDays = 0;
    for (var yi = 0; yi < cal.months.length; yi++) yearDays += Math.max(1, Number(cal.months[yi].days) || 1);

    return ceStack(CE_T.s5, [
        // [T-19] THE MASTER SWITCH, AND IT IS OPT-IN. `timeInject !== true` is the read
        // everywhere, so ABSENT MEANS OFF and no existing story starts injecting the hour
        // because it upgraded. That is the opposite of summonOnMention's absent-means-on,
        // deliberately: summoning was already the shipped behaviour and this never was.
        // IT GATES THE INJECTION ONLY. The clock still runs, the Scene strip still shows it
        // and schedules still fire -- what stops is the story being TOLD the hour.
        ceGroup('The story clock', ceStack(CE_T.s3, [
            ceSettingRow('Tell the story the time',
                'Adds the time-of-day band to the Author\u2019s Note every turn. Off by '
                + 'default: the clock, schedules and dated entries all work without it, and a '
                + 'story that never mentions the hour does not want it restated every turn.',
                ceToggle((cfg as any).timeInject === true, 'set:cal:inject', function() {
                    var wasOn = ((cfg as any).timeInject === true);
                    return ceSettingsOp(function() {
                        return mutConfig(function(c: any) { (c as any).timeInject = !wasOn; });
                    }).then(cePublishSettings);
                }, 'Tell the story the time'))
        ])),

        // TIME OF DAY FIRST of the vocabulary groups, because it is the only one the model
        // ever reads and the only one whose absence makes the whole feature silent.
        ceGroup('Time of day', ceStack(CE_T.s3, [
            ceSub('t3', 'These labels are the only part of the clock the model is ever told. '
                + 'A band that starts after it ends wraps past midnight. Delete every band and '
                + 'the story is never told the time at all.'),
            _ceTimeBands(cal.bands, 'set:cal:band')
        ])),

        ceGroup('The week', ceStack(CE_T.s3, [
            ceSub('t3', 'How many days you name is how long a week is. Leave the list empty for '
                + 'a world with no week \u2014 days are then counted rather than named.'),
            ceIndexedStates(cal.dayNames, function(next: string[]) {
                return _ceCalMut(function(c: any) { c.dayNames = next; });
            }, 'day', 'set:cal:day')
        ])),

        ceGroup('The year', ceStack(CE_T.s3, [
            ceSub('t3', 'Each month carries its own length. An empty list means this world has no '
                + 'months and no date \u2014 which is a perfectly ordinary thing for a story to have.'),
            _ceTimeMonths(cal.months, 'set:cal:mon'),
            // A DERIVED READOUT, NOT A FIELD. The year's length is the sum of the months and
            // there is nothing to type; showing it is how an author notices they wrote thirteen.
            cal.months.length
                ? ceSub('t2', 'A year is ' + String(yearDays) + ' days'
                    + (cal.dayNames.length ? (' \u00b7 a week is ' + String(cal.dayNames.length)) : ''))
                : null
        ])),

        ceGroup('What moves the clock', ceStack(CE_T.s3, [
            ceSub('t3', 'The clock is the author\u2019s to move: an hour either way sits on the Scene '
                + 'surface. This adds time on its own after every story turn.'),
            ceNumField({ k: 'set:cal:pergen', label: 'Minutes per story turn',
                hint: '0 turns it off, which is the default',
                value: Number(cal.advancePerGen) || 0, min: 0, max: 1440,
                onCommit: function(n: number) {
                    return _ceCalMut(function(c: any) { c.advancePerGen = Math.max(0, Math.round(n)); });
                } }),
            ceSettingRow('The story begins at', 'Only used until the clock is first moved',
                ceSelect({ k: 'set:cal:start', value: String(startHour),
                    options: (function() {
                        var o: any[] = [];
                        for (var i = 0; i < CE_HOURS_DAY; i++) {
                            o.push({ id: String(i), label: (i < 10 ? '0' : '') + String(i) + ':00' });
                        }
                        return o;
                    })(),
                    onCommit: function(v: string) {
                        return _ceCalMut(function(c: any) { c.startAt = _ceHourSafe(v) * CE_MINS_HOUR; });
                    } }))
        ])),
        // [CFG-RESEED] BESIDE THE CALENDAR, not on the System tab with the other resets.
        // An author notices their month names are stale while they are LOOKING AT the month
        // names, and a fix that lives two tabs away from the symptom is one they have to
        // already know exists. The whole-config reset stays on System because it is about
        // the record, not about any one catalog.
        ceGroup('Reseed the calendar', _ceReseedGroup('cal', 'Reseed calendar\u2026',
            'Replace the day names, the months and the time-of-day bands with the ones a '
            + 'new story ships with. Use this when a story was started on an older version '
            + 'and its calendar is a seed behind.',
            'Replace this calendar with the current default? Every day name, month and '
            + 'time-of-day band you have written here is overwritten. The clock itself does '
            + 'not move \u2014 but a date is read against the months, so entries on the '
            + 'calendar will land on differently named days.',
            CE_RESEED_CALENDAR, confirm))
    ]);
}


// ======================================================================================
// -- HELPERS TAB  [HELP-MESH] ----------------------------------------------------------
// ======================================================================================
// THE MESH'S ONE SURFACE. It reads and it pings; it holds no state of its own and it is not
// where a helper is installed -- that is done in NovelAI's own script list, which is why the
// last group on this tab is instructions rather than a button.
//
// EVERY NUMBER HERE CARRIES ITS AGE, and that is deliberate rather than fussy. A helper's
// allowance is read inside the helper and travels here in a message [HELP-BUDGET-REPORTED],
// so a row is only as true as the moment it arrived. A budget printed without a timestamp
// invites the author to read a five-minute-old number as live, which is the one way this
// screen could lie.
//
// ROWS DO NOT REPAINT ON A SERVED CALL, by the same decision recorded at _ceHelpOnMessage:
// discovery repaints, a completed generation does not. Refresh is the door.

function _ceHelpNum(n: any): string {
    var hnV = Number(n);
    return (typeof n === 'number' && hnV >= 0) ? String(hnV) : '\u2014';
}

function _ceHelpAge(at: any, now: number): string {
    var haT = Number(at) || 0;
    if (!haT) return 'never';
    var haS = Math.max(0, Math.round((now - haT) / 1000));
    if (haS < 60) return haS + 's ago';
    var haM = Math.round(haS / 60);
    if (haM < 60) return haM + 'm ago';
    return Math.round(haM / 60) + 'h ago';
}

// The status word, in the order the author needs to hear it: a helper that is not answering is
// not "Ready with 4000 tokens", whatever its last reading said.
function _ceHelpStatus(r: any, now: number): string {
    if (!r) return 'Unknown';
    if (r.dead) return 'Not answering';
    // [HELP-CAPS] Shown as a status rather than a footnote: a direct-only helper cannot take
    // anything the Build route generates, which makes it useless for the case an author is
    // almost certainly looking at this screen about.
    if (r.story !== true) return 'Needs updating';
    if (r.busy) return 'Working';
    if ((now - (Number(r.at) || 0)) > CE_HELP_STALE_MS) return 'Reading is stale';
    if (typeof r.out !== 'number' || r.out < 0) return 'No reading';
    if (r.out < CE_HELP_NEED_DEF) return 'Nearly dry';
    return 'Ready';
}

function _ceSettingsHelpersTab(cfg: any, st: any): any {
    var htNow = Date.now();
    var htList: any[] = (st && st.helpers) ? st.helpers : [];
    var htLocal: any = (st && st.helpLocal) ? st.helpLocal : { out: -1, inp: -1, waitSec: -1 };
    var htOn = ((cfg as any).helpersOff !== true);
    var htDry = !!(st && st.helpDry);

    // Two copies left on the same ordinal still work -- the pick is tie-broken on script id --
    // but the author sees two rows called "Helper 2" and cannot tell which one is dry.
    var htSeen: any = {};
    var htDupe = false;
    var htI = 0;
    for (htI = 0; htI < htList.length; htI++) {
        var htNo = String(htList[htI].no || 0);
        if (htSeen[htNo]) htDupe = true;
        htSeen[htNo] = true;
    }

    var htRows: any[] = [];
    for (htI = 0; htI < htList.length; htI++) {
        var htR = htList[htI];
        htRows.push(ceRow(
            String(htR.label || 'Helper'),
            ceStack('2px', [
                ceSub('t2', 'Output ' + _ceHelpNum(htR.out) + '  \u00b7  input ' + _ceHelpNum(htR.inp)
                    + '  \u00b7  read ' + _ceHelpAge(htR.at, htNow)),
                ceSub('t3', 'v' + String(htR.version || '?')
                    + (htR.story === true ? '' : '  \u00b7  cannot take story-context calls')
                    + '  \u00b7  ' + String(Number(htR.gens) || 0) + ' served this session'
                    + (htR.lastErr ? ('  \u00b7  last error: ' + String(htR.lastErr)) : ''))
            ]),
            ceSub('t2', _ceHelpStatus(htR, htNow)),
            htI
        ));
    }

    return ceStack(CE_T.s5, [

        ceGroup('This script\u2019s own allowance', ceStack(CE_T.s3, [
            ceSub('t3', 'What NovelAI will currently let Character Engine generate. Output '
                + 'replenishes only while you are actively using the script, so advancing the '
                + 'story is what refills it \u2014 waiting is not.'),
            ceRow('Output', ceSub('t2', _ceHelpNum(htLocal.out) + ' tokens'), null, 0),
            ceRow('Input', ceSub('t2', _ceHelpNum(htLocal.inp) + ' tokens'), null, 1),
            ceRow('Replenish', ceSub('t2', (Number(htLocal.waitSec) >= 0)
                ? ('~' + String(htLocal.waitSec) + 's to 1000 output')
                : '\u2014'), null, 2),
            // [HELP-LOCAL-DRY] Shown because it explains something the author would otherwise
            // read as a bug: generations still working while this script's own numbers sit
            // at zero, and no obvious reason why.
            htDry ? ceRow('Right now', ceSub('t2',
                'This script was refused recently \u2014 generations are going to helpers'), null, 3) : null
        ])),

        // [HELP-DEFAULT-ON] Off is the measuring position, not the safe one.
        ceGroup('Delegation', ceStack(CE_T.s3, [
            ceSettingRow('Hand off when this script runs dry',
                'A helper is a separate script with its own token allowance. When Character '
                + 'Engine cannot cover a generation on its own, it passes that one call to the '
                + 'first helper that can. Its own allowance is always spent first.',
                ceToggle(htOn, 'set:help:on', function() {
                    var hsWas = ((cfg as any).helpersOff !== true);
                    return ceSettingsOp(function() {
                        return mutConfig(function(c: any) { (c as any).helpersOff = hsWas; });
                    }).then(cePublishSettings);
                }, 'Hand off when this script runs dry')),
            ceSub('t3', 'Story-context generations \u2014 the journal, snapshots and the scene '
                + 'inventors \u2014 are never handed off, because NovelAI builds their context '
                + 'from this script\u2019s own settings and a helper\u2019s would differ.')
        ])),

        ceGroup('Installed helpers', ceStack(CE_T.s3, [
            htList.length
                ? ceStack('0', htRows)
                : ceEmpty('No helpers are answering. Install one to add a second token allowance.', null),
            htDupe
                ? ceSub('t2', 'Two helpers share a number. They both still work, but rename one '
                    + 'so you can tell their rows apart.')
                : null,
            ceBtn('Refresh', 'help:refresh', function() {
                return ceHelpRefresh().then(cePublishSettings);
            }, undefined, 'Pinging\u2026'),
            ceSub('t3', 'Refresh re-reads every helper\u2019s allowance and clears any that had '
                + 'stopped answering. Nothing here spends tokens.')
        ])),

        ceGroup('Adding a helper', ceStack(CE_T.s3, [
            ceSub('t3', '1.  Import CE Generation Helper into NovelAI as its own script, '
                + 'alongside Character Engine.'),
            ceSub('t3', '2.  For a second one, export that script, change its name to end in a '
                + 'different number \u2014 CE Generation Helper 2 \u2014 give it a new id, and '
                + 'import it again. The helper reads its number off its own name; there is '
                + 'nothing to edit inside the code.'),
            ceSub('t3', '3.  Repeat for as many as you want. They are used in number order, '
                + 'each one only after the one before it runs dry.'),
            ceSub('t3', 'A helper announces itself when it loads, so a new one appears on this '
                + 'list without a reload. If it does not, press Refresh.')
        ]))
    ]);
}

// ======================================================================================
// -- SYSTEM TAB: Timing -----------------------------------------------------------------
// ======================================================================================
function _ceSettingsTiming(cfg: any): any {
    var isTok = ((cfg as any).dynamicIntervalMode === 'tokens');
    var body: any[] = [
        ceSub('t3',
            'How much story progress must pass before each update type fires \u2014 measured in generations (replies) or in context tokens.'),
        ceSettingRow('Cadence unit', '',
            ceSelect({ k: 'set:timing:mode', value: isTok ? 'tokens' : 'gens',
                options: [{ id: 'gens', label: 'Per Generation' }, { id: 'tokens', label: 'Per Tokens' }],
                onCommit: function(v: string) {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).dynamicIntervalMode = v; }); }).then(cePublishSettings);
                } }))
    ];
    if (!isTok) {
        body.push(
            ceNumField({ k: 'set:timing:thought_g', label: 'Ephemeral (Thoughts) interval', hint: 'generations, 1\u201320',
                value: cfg.thoughtIntervalGens, min: 1, max: 20,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.thoughtIntervalGens = n; }); }).then(cePublishSettings); } }),
            ceNumField({ k: 'set:timing:hook_g', label: 'Hook scan interval', hint: 'generations, 1\u201330',
                value: cfg.hookIntervalGens, min: 1, max: 30,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.hookIntervalGens = n; }); }).then(cePublishSettings); } })
        );
    } else {
        body.push(
            ceNumField({ k: 'set:timing:thought_t', label: 'Ephemeral (Thoughts) interval', hint: 'tokens, 100\u20135000',
                value: Number((cfg as any).thoughtIntervalTokens) || 500, min: 100, max: 5000,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).thoughtIntervalTokens = n; }); }).then(cePublishSettings); } }),
            ceNumField({ k: 'set:timing:hook_t', label: 'Hook scan interval', hint: 'tokens, 100\u201315000',
                value: Number((cfg as any).hookIntervalTokens) || 1500, min: 100, max: 15000,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).hookIntervalTokens = n; }); }).then(cePublishSettings); } })
        );
    }
    body.push(
        ceNumField({ k: 'set:timing:ephcap', label: 'Max ephemeral injections per generation', hint: '1\u20136',
            value: cfg.ephemeralCap, min: 1, max: 6,
            onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.ephemeralCap = n; }); }).then(cePublishSettings); } }),
        ceSub('t3',
            'Dynamic character cap: how many present characters stay dynamic at once (0 = no cap). Ranked characters fill slots first; set a rank from a character\u2019s card.'),
        ceNumField({ k: 'set:timing:maxdyn', label: 'Max dynamic characters', hint: '0\u201320, 0 = off',
            value: Number(cfg.maxDynamicCharacters) || 0, min: 0, max: 20,
            onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).maxDynamicCharacters = Math.max(0, n); }); }).then(cePublishSettings); } })
    );
    return ceGroup('Dynamic Updates Timing', ceStack(CE_T.s3, body));
}

// ======================================================================================
// -- SYSTEM TAB: Generation Style -------------------------------------------------------
// ======================================================================================
function _ceSettingsStyle(cfg: any): any {
    return ceGroup('Generation Style', ceStack(CE_T.s2, [
        h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } },
            // [STYLE-SCOPE] WAS "Injected at the top of every generation prompt.
            // Controls overall tone and register." That describes a global story-prose
            // control, and it got one: a live story had this holding second-person
            // narrative directives. THE FIELD IS A DOSSIER-VOICE GUIDE -- it steers the
            // wording of generated character FIELDS, not the story. Story prose style
            // belongs in the Author's Note, which is the style channel (see CE-STATUS).
            'Voice for GENERATED CHARACTER FIELDS \u2014 dossier wording, not story prose. '
            + 'Story style belongs in the Author\u2019s Note. Not used by thought generation.'),
        h(ceField, { k: 'set:style', label: '', multiline: true, rows: 5, well: true, value: cfg.generalStyle,
            onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.generalStyle = v; }); }).then(cePublishSettings); } }),
        ceBtn('Reset to default', 'set:style:reset', function() {
            return ceSettingsOp(function() { return mutConfig(function(c: any) { c.generalStyle = DEFAULT_GENERAL_STYLE; }); }).then(cePublishSettings);
        })
    ]));
}

// ======================================================================================
// -- SYSTEM TAB: Static Field Settings ---------------------------------------------------
// ======================================================================================
var _ceSettingsNewFieldDraft: string = '';
function _ceSettingsFields(cfg: any, openMap: any, confirm: string): any {
    var body: any[] = [
        ceSettingRow('Show field headers in context injection', '',
            ceToggle(!!cfg.showFieldHeaders, 'set:fields:headers', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.showFieldHeaders = !cfg.showFieldHeaders; }); }).then(cePublishSettings);
            }))
    ];
    var builtins: any[] = [];
    STATIC_FIELD_DEFS.forEach(function(def: any) {
        var accId = 'set:field:' + def.key;
        var open = !!openMap[accId];
        var label = cfg.fieldLabels[def.key] || def.label;
        var inst = cfg.fieldInstructions[def.key] || def.defaultInstructions;
        var budget = cfg.fieldBudgets[def.key] || def.defaultBudget;
        builtins.push(ceExpandRow({
            id: accId, label: label, open: open, summary: budget + ' token budget',
            children: ceStack(CE_T.s3, [
                h(ceField, { k: accId + ':label', label: 'Display label', value: label,
                    onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldLabels[def.key] = v; }); }).then(cePublishSettings); } }),
                h(ceField, { k: accId + ':inst', label: 'Generation instructions', multiline: true, rows: 4, value: inst,
                    onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldInstructions[def.key] = v; }); }).then(cePublishSettings); } }),
                ceNumField({ k: accId + ':budget', label: 'Generation token budget', hint: '50\u2013500', value: budget, min: 50, max: 500,
                    onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldBudgets[def.key] = n; }); }).then(cePublishSettings); } }),
                ceBtn('Reset instructions', accId + ':reset', function() {
                    return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldInstructions[def.key] = def.defaultInstructions; c.fieldBudgets[def.key] = def.defaultBudget; }); }).then(cePublishSettings);
                })
            ])
        }));
    });
    body.push(ceGroup('Built-in fields', ceStack(null, builtins)));

    var cfDefs: any[] = (cfg.customStaticFields || []).filter(function(f: any) {
        var k = f ? String(f.kind || 'facet') : 'facet';
        return !!f && k !== 'slot' && k !== 'facet';
    });
    var cfKids: any[] = [];
    cfDefs.forEach(function(cfDef: any) {
        var cfId = String(cfDef.id);
        var accId = 'set:cf:' + cfId;
        var open = !!openMap[accId];
        var cfBody: any[] = [
            h(ceField, { k: accId + ':label', label: 'Display label', value: cfDef.label || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.label = v;
                }); }).then(cePublishSettings); } }),
            h(ceField, { k: accId + ':ph', label: 'Placeholder (editor hint only)', value: cfDef.placeholder || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.placeholder = v;
                }); }).then(cePublishSettings); } }),
            h(ceField, { k: accId + ':inst', label: 'Generation instructions', multiline: true, rows: 4, value: cfDef.instructions || '',
                onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    var t = (c.customStaticFields || []).find(function(f: any) { return f && f.id === cfId; }); if (t) t.instructions = v;
                }); }).then(cePublishSettings); } }),
            ceNumField({ k: accId + ':budget', label: 'Generation token budget', hint: '50\u2013500', value: cfg.fieldBudgets[cfId] || 150, min: 50, max: 500,
                onCommit: function(n: number) { return ceSettingsOp(function() { return mutConfig(function(c: any) { c.fieldBudgets[cfId] = n; }); }).then(cePublishSettings); } })
        ];
        cfBody.push(_ceSettingsDeleteBtn(accId, 'Delete field\u2026'));
        cfBody.push(_ceSettingsConfirmRow(accId, confirm,
            'Delete \u201c' + (cfDef.label || 'this field') + '\u201d? It disappears from every character\u2019s editor. Text already written into it is kept, not erased.',
            function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    c.customStaticFields = (c.customStaticFields || []).filter(function(f: any) { return !f || f.id !== cfId; });
                }); }).then(function() {
                    ceSettingsPatch(function() { return { confirm: '' }; });
                    return cePublishSettings();
                });
            }));
        cfKids.push(ceExpandRow({
            id: accId, label: cfDef.label || '(unnamed field)', open: open,
            summary: (cfg.fieldBudgets[cfId] || 150) + ' token budget',
            children: ceStack(CE_T.s3, cfBody)
        }));
    });
    var addField = h('div', { style: { display: 'flex', gap: CE_T.s2, marginTop: CE_T.s2 } },
        ceGrow(null, [ h(ceField, {
            k: 'set:cf:newname', label: '', placeholder: 'New field name\u2026', value: '',
            seed: 'set:cf:newname:' + String(cfDefs.length),
            onType: function(v: string) { _ceSettingsNewFieldDraft = v; },
            onCommit: function(v: string) { _ceSettingsNewFieldDraft = v; return Promise.resolve(); }
        })]),
        ceBtn('+ Add', 'set:cf:add', function() {
            var newLabel = (_ceSettingsNewFieldDraft || '').trim();
            if (!newLabel) { try { api.v1.ui.toast('Name the field first.', { type: 'warning', autoClose: 2000 }); } catch (_e) {} return Promise.resolve(); }
            _ceSettingsNewFieldDraft = '';
            var newId = 'ce_cf_' + generateId();
            return ceSettingsOp(function() { return mutConfig(function(c: any) {
                if (!Array.isArray(c.customStaticFields)) c.customStaticFields = [];
                c.customStaticFields.push({ id: newId, slot: 'custom', kind: 'custom', label: newLabel, placeholder: '',
                    instructions: 'Write the ' + newLabel + ' for this character in two or three sentences, consistent with everything already established about them. Be specific and concrete rather than summarising.' });
                c.fieldBudgets[newId] = 150;
            }); }).then(cePublishSettings);
        })
    );
    body.push(ceGroup('Custom Fields (' + cfDefs.length + ')', ceStack(CE_T.s1, [
        ceSub('t3',
            'Fields you define yourself. Same generator, same token budget, same lorebook injection as the built-ins. Once defined, they appear on every character\u2019s profile under \u201cCustom fields\u201d \u2014 write into one there and it joins that character.'),
        cfDefs.length ? ceStack(null, cfKids) : ceSub('t3', 'None yet.'),
        addField
    ])));

    return ceGroup('Static Field Settings', ceStack(CE_T.s4, body));
}

// ======================================================================================
// -- SYSTEM TAB: Scene Default Background -----------------------------------------------
// ======================================================================================
function _ceSettingsBackground(cfg: any): any {
    return ceGroup('Scene Default Background', ceStack(CE_T.s2, [
        ceSub('t3',
            'Fallback image shown in the scene banner when a location has no portrait. Shared across anyone who loads this story. Leave blank for the default gradient.'),
        h(ceField, { k: 'set:bg', label: 'Image URL', value: (cfg as any).defaultBackgroundUrl || '',
            onCommit: function(v: string) { return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).defaultBackgroundUrl = v.trim(); }); }).then(cePublishSettings); } }),
        ceBtn('Clear', 'set:bg:clear', function() {
            return ceSettingsOp(function() { return mutConfig(function(c: any) { (c as any).defaultBackgroundUrl = ''; }); }).then(function() {
                try { api.v1.ui.toast('Scene background cleared.', { type: 'success', autoClose: 2000 }); } catch (_e) {}
                return cePublishSettings();
            });
        })
    ]));
}

// ======================================================================================
// -- SYSTEM TAB: Scene Stage  [SCENE-STAGE-TUNE] ----------------------------------------
// ======================================================================================
// A LOOP OVER CE_STAGE_SETTINGS, not four hand-written rows. The table owns every label,
// hint, bound and default, so the only thing this function decides is that a stage number is
// a stepper -- and it reads the CURRENT values through ceStageSettings, the same resolver the
// stage itself reads, so the box can never show a number the surface is not using.
// THE STAGE REPAINTS ON ITS OWN NEXT PUBLISH. cePublishScene runs on Scene's mount, so
// walking back to Scene shows the change; there is no cross-surface push and this is not
// worth inventing one for.
function _ceSettingsStage(cfg: any): any {
    var cur: any = ceStageSettings(cfg);
    var rows: any[] = [];
    for (var i = 0; i < CE_STAGE_SETTINGS.length; i++) {
        (function(d: any) {
            function write(v: any): any {
                return ceSettingsOp(function() {
                    return mutConfig(function(c: any) { (c as any)[d.k] = v; });
                }).then(cePublishSettings);
            }
            if (d.type === 'choice') {
                rows.push(ceSettingRow(d.label, d.sub, ceSelect({
                    k: 'set:stage:' + d.k, value: cur[d.k], options: d.options,
                    onCommit: function(v: string) { return write(v); }
                })));
                return;
            }
            rows.push(ceStepperRow({
                k: 'set:stage:' + d.k, label: d.label, value: cur[d.k],
                min: d.lo, max: d.hi, zebraIndex: i,
                sub: ceSub('t3', d.sub),
                onCommit: function(v: number) { return write(v); },
                onNudge: function(dir: number) {
                    var v = cur[d.k] + (dir * d.step);
                    if (v < d.lo) v = d.lo;
                    if (v > d.hi) v = d.hi;
                    return write(v);
                }
            }));
        })(CE_STAGE_SETTINGS[i]);
    }
    return ceGroup('Scene Stage', ceStack(CE_T.s1, [
        ceProse('t3', 'How the Scene\u2019s stage lays out character standees over the '
            + 'location picture. The stage itself is the switch in the Scene header; these '
            + 'numbers only matter while it is on.'),
        ceStack(0, rows)
    ]));
}

// ======================================================================================
// -- SYSTEM TAB: Generation Diagnostics --------------------------------------------------
// ======================================================================================
function _ceSettingsDiagnostics(st: any): any {
    return ceGroup('Generation Diagnostics', ceStack(CE_T.s3, [
        ceProse('t3',
            'Every engine generation call, logged as it happens. Session-only \u2014 resets on script reload.'),
        h('div', { style: { fontSize: CE_T.fsSm, fontWeight: '600', color: st.diagErr > 0 ? CE_SEM.ask : 'inherit' } },
            st.diagCount + ' call' + (st.diagCount === 1 ? '' : 's') + ' logged this session \u00b7 ' + st.diagErr + ' error' + (st.diagErr === 1 ? '' : 's')),
        ceInline(CE_T.s2, [
            ceBtn('Refresh', 'set:diag:refresh', function() { return cePublishSettings(); }),
            ceBtn('Copy log', 'set:diag:copy', function() {
                return api.v1.permissions.request('clipboardWrite', 'Copy the generation diagnostics log to your clipboard.').then(function(granted: boolean) {
                    if (!granted) { try { api.v1.ui.toast('Clipboard permission denied.', { type: 'warning' }); } catch (_e) {} return null; }
                    return api.v1.clipboard.writeText(dumpGenDiagLog()).then(function() {
                        try { api.v1.ui.toast('Copied to clipboard.', { type: 'success', autoClose: 2000 }); } catch (_e2) {}
                        return null;
                    });
                }).catch(function(eCp: any) {
                    try { api.v1.ui.toast('Copy failed: ' + String((eCp && eCp.message) || eCp), { type: 'error' }); } catch (_e3) {}
                    return null;
                });
            }),
            ceBtn('Clear', 'set:diag:clear', function() { clearGenDiagLog(); return cePublishSettings(); }, 'danger')
        ]),
        ceBtn('Run A/B probe (yoink vs direct)', 'set:diag:probe', function() {
            try { api.v1.ui.toast('Running probe\u2026', { id: 'ce-genprobe', autoClose: false, type: 'info' }); } catch (_e) {}
            return runBudgetProbe().then(function() {
                try { api.v1.ui.toast('Probe complete \u2014 see log below.', { id: 'ce-genprobe', type: 'success', autoClose: 2000 }); } catch (_e2) {}
                return cePublishSettings();
            });
        }),
        // [PERSONA-PROBE] A BUTTON RATHER THAN A SLASH COMMAND, deliberately: this is the one
        // instrument whose result a design is waiting on, and a probe that has to be typed
        // correctly into a console is a probe that gets debugged instead of read. The cost is
        // stated on the control because it is real \u2014 the /ce cache discipline of refusing
        // until asked twice does not transfer to a control nothing can fire by typo.
        ceProse('t3',
            'Persona channel probe \u2014 eight generations, roughly 5.5k input tokens. Answers three '
          + 'questions the chat rebuild is blocked on: whether api.v1.generate honours a non-GLM '
          + 'model, whether the two models share a prefix cache, and whether a trailing assistant '
          + 'turn acts as a prefill. Reads its own verdicts; copy the log to keep them.'),
        ceBtn('Run persona channel probe (8 calls)', 'set:diag:personaprobe', function() {
            try { api.v1.ui.toast('Running persona probe\u2026 this takes a moment.', { id: 'ce-pcprobe', autoClose: false, type: 'info' }); } catch (_ePcp) {}
            return runPersonaChannelProbe().then(function() {
                try { api.v1.ui.toast('Persona probe complete \u2014 report below.', { id: 'ce-pcprobe', type: 'success', autoClose: 2500 }); } catch (_ePcp2) {}
                return cePublishSettings();
            }).catch(function(ePcpB: any) {
                try { api.v1.ui.toast('Persona probe failed: ' + String((ePcpB && ePcpB.message) || ePcpB), { id: 'ce-pcprobe', type: 'error' }); } catch (_ePcp3) {}
                return cePublishSettings();
            });
        }),
        // [CHAT-PARTICIPANT] Beside the probe because they share the well below, and because
        // they are the same kind of instrument at two prices: one measures the channel, one
        // reads what will be sent on it. This half is free, so it carries no cost warning.
        ceProse('t3',
            'Persona prompt preview \u2014 free, no generation. Assembles and shows the persona '
          + 'channel\u2019s system turn for the open chat\u2019s contact, or the first character if '
          + 'no chat is open. Read it for a name appearing above the participant block; that is '
          + 'the one failure that costs a cache.'),
        ceBtn('Preview persona prompt (free)', 'set:diag:personaprev', function() {
            return previewPersonaPrompt().then(function() {
                try { api.v1.ui.toast('Prompt assembled \u2014 report below.', { id: 'ce-pcprev', type: 'success', autoClose: 2000 }); } catch (_ePv1) {}
                return cePublishSettings();
            }).catch(function(ePv: any) {
                try { api.v1.ui.toast('Preview failed: ' + String((ePv && ePv.message) || ePv), { id: 'ce-pcprev', type: 'error' }); } catch (_ePv2) {}
                return cePublishSettings();
            });
        }),
        // [PCP-SINK] ITS OWN WELL AND ITS OWN COPY, not folded into the generation log above.
        // That log is a RING BUFFER of every call the engine makes and this is ONE report with
        // verdicts in it; appending them would make the report scroll away behind the next
        // wizard turn, which is precisely how the first run's findings were lost. Absent
        // entirely until a probe has run, so the panel does not carry an empty box for a
        // control most sessions never press.
        (st.pcpLog ? ceStack(CE_T.s2, [
            ceInline(CE_T.s2, [
                ceBtn('Copy probe report', 'set:diag:pcpcopy', function() {
                    return api.v1.permissions.request('clipboardWrite', 'Copy the persona channel probe report to your clipboard.').then(function(granted: boolean) {
                        if (!granted) { try { api.v1.ui.toast('Clipboard permission denied.', { type: 'warning' }); } catch (_ePc1) {} return null; }
                        return api.v1.clipboard.writeText(String(st.pcpLog || '')).then(function() {
                            try { api.v1.ui.toast('Copied to clipboard.', { type: 'success', autoClose: 2000 }); } catch (_ePc2) {}
                            return null;
                        });
                    }).catch(function(ePc3: any) {
                        try { api.v1.ui.toast('Copy failed: ' + String((ePc3 && ePc3.message) || ePc3), { type: 'error' }); } catch (_ePc4) {}
                        return null;
                    });
                }),
                ceBtn('Clear report', 'set:diag:pcpclear', function() { _cePcpLast = ''; return cePublishSettings(); }, 'danger')
            ]),
            h('div', { style: { background: CE_WELL, border: '1px dashed ' + CE_LINE, padding: CE_T.s3, borderRadius: CE_T.r, maxHeight: '320px', overflowY: 'auto' } },
                ceMono(String(st.pcpLog || ''), { opacity: CE_OP.t2, style: { whiteSpace: 'pre-wrap' } })
            )
        ]) : null),
        h('div', { style: { background: CE_WELL, border: '1px dashed ' + CE_LINE, padding: CE_T.s3, borderRadius: CE_T.r, maxHeight: '320px', overflowY: 'auto' } },
            ceMono(st.diagLog, { opacity: CE_OP.t2, style: { whiteSpace: 'pre-wrap' } })
        )
    ]));
}

// ======================================================================================
// -- SYSTEM TAB: Interface -------------------------------------------------------------
// ======================================================================================
// [STYLE2] CE-STYLE v2.0 SS9.2: `prefers-reduced-motion` is NOT DETECTABLE in
// this sandbox -- there is no matchMedia -- so an explicit switch is the substitute, not a
// preference we can read. The kit's motion budget is deliberately small enough to be safe
// by default; this is for people for whom "small" is still too much.
//
// THIS ROW IS THE ONE SETTING ON THIS SURFACE THAT IS NOT STORED IN GlobalConfig, and the
// asymmetry is deliberate rather than an oversight: it is a property of the person reading
// the screen, not of the story file, so it rides api.v1.storage (account-global) and
// follows them into every story instead of being re-set per story. That is also why it
// does not go through ceSettingsOp/mutConfig/cePublishSettings like its neighbours -- it
// has no config to chain against. The ceSettingsPatch call is only there to force a
// repaint so the switch moves; nothing about the value lives in that store.
function _ceSettingsInterface(): any {
    return ceGroup('Interface', ceStack(CE_T.s2, [
        ceSettingRow('Reduce motion',
            'Turns off the small transitions on buttons, switches and the generation bar. Applies everywhere, and to every story.',
            ceToggle(CE_REDUCE_MOTION, 'set:ui:reducemotion', function() {
                return ceMotionSet(!CE_REDUCE_MOTION).then(function() {
                    ceSettingsPatch(function() { return {}; });
                });
            }, 'Reduce motion')),
        // [SHELL-WINDOW] Sits beside Reduce motion because it is the same tier of
        // setting -- account-global, about the screen rather than the story -- and so it
        // does not go through ceSettingsOp/mutConfig either. The ceSettingsPatch call is
        // only there to move the switch.
        ceSettingRow('Open in a window',
            'Opens the engine in a floating, resizable window instead of a full-screen panel, so the story stays visible beside it. Applies the next time you open the engine, and to every story.',
            ceToggle(CE_SHELL_WINDOW, 'set:ui:shellwindow', function() {
                return ceShellWindowSet(!CE_SHELL_WINDOW).then(function() {
                    try {
                        api.v1.ui.toast(CE_SHELL_WINDOW
                            ? 'Window mode on \u2014 close and reopen the engine to see it.'
                            : 'Full-screen mode on \u2014 close and reopen the engine to see it.',
                            { type: 'info', autoClose: 4000 });
                    } catch (_eWinToast) {}
                    ceSettingsPatch(function() { return {}; });
                });
            }, 'Open in a window'))
    ]));
}

// [THEME-VAR] THE PUBLISHED VOCABULARY. Every name a theme may set, in the order the probe
// lists them. `v` is the token's own value expression, so a swatch shows what the surface
// would actually paint -- a probe holding its own copy of the fallback would go on looking
// correct after the real one changed.
// ADDING A TOKEN MEANS ADDING A ROW HERE. A name absent from this list is a name no author
// discovers, which is the same failure as not having it.
//
// THE ONE NAME DELIBERATELY WITHHELD is --ce-sem-calm, because there is no such token:
// see the CE_SEM block for why 'calm' has to stay a literal. Publishing a name that
// nothing reads is the mirror of the failure above and just as expensive to an author.
//
// SHAPE AND MOTION ROWS WRITE THEIR var() OUT RATHER THAN READING CE_T. CE_T's duration
// fields are MUTATED by ceMotionApply, so a row holding CE_T.mSlow publishes '0ms' -- the
// value in force -- instead of the name it is documenting, for any reader with Reduce
// motion on. The panel's job is to name the vocabulary; the surface's job is to obey the
// switch. Radius follows the same rule for consistency even though nothing mutates it.
var CE_THEME_TOKENS: any[] = [
    { g: 'Chrome',  n: 'line',            v: CE_LINE },
    { g: 'Chrome',  n: 'line-2',          v: CE_LINE2 },
    { g: 'Chrome',  n: 'fill',            v: CE_FILL },
    { g: 'Chrome',  n: 'fill-2',          v: CE_FILL2 },
    { g: 'Chrome',  n: 'ring',            v: CE_RING },
    { g: 'Chrome',  n: 'gauge',           v: CE_GAUGE },
    { g: 'Chrome',  n: 'gauge-good',      v: CE_GAUGE_UP },
    { g: 'Chrome',  n: 'gauge-ill',       v: CE_GAUGE_DOWN },
    { g: 'Chrome',  n: 'well',            v: CE_WELL },
    { g: 'Map',     n: 'map-line',        v: ceVar('map-line', 'currentColor') },
    { g: 'Map',     n: 'map-line-select', v: ceVar('map-line-select', CE_SEM.building) },
    { g: 'Map',     n: 'map-fill-camera', v: ceVar('map-fill-camera', 'rgba(232,192,125,0.14)') },
    { g: 'Map',     n: 'map-fill-leaf',   v: ceVar('map-fill-leaf', 'rgba(255,255,255,0.05)') },
    { g: 'Map',     n: 'map-fill-branch', v: ceVar('map-fill-branch', 'rgba(255,255,255,0.02)') },
    { g: 'Map',     n: 'map-label-halo',  v: ceVar('map-label-halo', CE_FILL) },
    // [THEME-SLOT] THE HEX PALETTE JOINS THE TABLE FROM ITS OWN DECLARATION rather than
    // being retyped here. CE_HEX_PALETTE holds the name and the fallback together, and a
    // second copy of eight hex codes is eight chances for this panel to advertise a colour
    // the map does not draw. THEY WERE SLOTS FROM THE DAY THEY WERE WRITTEN and were simply
    // never listed, which is the exact failure this table's own header names: a token missing
    // from here is a token no theme author can discover.
    // Safe to read at this point in the file -- CE_HEX_PALETTE is declared above.
    { g: 'Map',     n: CE_HEX_PALETTE[0].v, v: ceVar(CE_HEX_PALETTE[0].v, CE_HEX_PALETTE[0].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[1].v, v: ceVar(CE_HEX_PALETTE[1].v, CE_HEX_PALETTE[1].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[2].v, v: ceVar(CE_HEX_PALETTE[2].v, CE_HEX_PALETTE[2].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[3].v, v: ceVar(CE_HEX_PALETTE[3].v, CE_HEX_PALETTE[3].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[4].v, v: ceVar(CE_HEX_PALETTE[4].v, CE_HEX_PALETTE[4].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[5].v, v: ceVar(CE_HEX_PALETTE[5].v, CE_HEX_PALETTE[5].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[6].v, v: ceVar(CE_HEX_PALETTE[6].v, CE_HEX_PALETTE[6].c) },
    { g: 'Map',     n: CE_HEX_PALETTE[7].v, v: ceVar(CE_HEX_PALETTE[7].v, CE_HEX_PALETTE[7].c) },
    { g: 'Map',     n: 'hex-cam',         v: CE_HEX_CAM },
    { g: 'Icons',   n: 'ic-s0',           v: ceVar('ic-s0', 'currentColor') },
    { g: 'Icons',   n: 'ic-s1',           v: ceVar('ic-s1', 'currentColor') },
    { g: 'Icons',   n: 'ic-s2',           v: ceVar('ic-s2', 'currentColor') },
    { g: 'Icons',   n: 'ic-s3',           v: ceVar('ic-s3', 'currentColor') },
    { g: 'Icons',   n: 'ic-s4',           v: ceVar('ic-s4', 'currentColor') },
    { g: 'Icons',   n: 'ic-s5',           v: ceVar('ic-s5', 'currentColor') },
    { g: 'Icons',   n: 'ic-a0',           v: ceVar('ic-a0', 'currentColor') },
    { g: 'Icons',   n: 'ic-a1',           v: ceVar('ic-a1', 'currentColor') },
    { g: 'Icons',   n: 'ic-a2',           v: ceVar('ic-a2', 'currentColor') },
    { g: 'Icons',   n: 'ic-a3',           v: ceVar('ic-a3', 'currentColor') },
    // [THEME-VAR4] THE TEN OPACITY TWINS, published at last. They have worked since the
    // slots did -- _ceIconPaths writes --ce-ic-<slot>-o beside every --ce-ic-<slot> -- but
    // they were absent from this list, which by this table's own rule above is the same as
    // not having them. THEY ARE THE HALF THAT MAKES THE OTHER HALF USABLE: the defaults
    // shade by alpha over currentColor, isometric icons overlap heavily, and stacked alpha
    // accumulates toward opaque, so a coloured structure slot flattens to a silhouette
    // unless its twin is pushed to 1. An author who finds only the colour names finds the
    // broken half. Numbers, not colours, so no swatch -- `text: true`.
    { g: 'Icons',   n: 'ic-s0-o',         v: 'var(--ce-ic-s0-o, ' + CE_ICON_OP.s0 + ')', text: true },
    { g: 'Icons',   n: 'ic-s1-o',         v: 'var(--ce-ic-s1-o, ' + CE_ICON_OP.s1 + ')', text: true },
    { g: 'Icons',   n: 'ic-s2-o',         v: 'var(--ce-ic-s2-o, ' + CE_ICON_OP.s2 + ')', text: true },
    { g: 'Icons',   n: 'ic-s3-o',         v: 'var(--ce-ic-s3-o, ' + CE_ICON_OP.s3 + ')', text: true },
    { g: 'Icons',   n: 'ic-s4-o',         v: 'var(--ce-ic-s4-o, ' + CE_ICON_OP.s4 + ')', text: true },
    { g: 'Icons',   n: 'ic-s5-o',         v: 'var(--ce-ic-s5-o, ' + CE_ICON_OP.s5 + ')', text: true },
    { g: 'Icons',   n: 'ic-a0-o',         v: 'var(--ce-ic-a0-o, ' + CE_ICON_OP.a0 + ')', text: true },
    { g: 'Icons',   n: 'ic-a1-o',         v: 'var(--ce-ic-a1-o, ' + CE_ICON_OP.a1 + ')', text: true },
    { g: 'Icons',   n: 'ic-a2-o',         v: 'var(--ce-ic-a2-o, ' + CE_ICON_OP.a2 + ')', text: true },
    { g: 'Icons',   n: 'ic-a3-o',         v: 'var(--ce-ic-a3-o, ' + CE_ICON_OP.a3 + ')', text: true },
    // Shape and motion have no colour to swatch, so their row shows the value as text.
    { g: 'Type',    n: 'head',            v: 'var(--ce-head, currentColor)' },
    { g: 'Type',    n: 'key',             v: 'var(--ce-key, currentColor)' },
    { g: 'Type',    n: 'mono',            v: 'var(--ce-mono, currentColor)' },
    { g: 'Type',    n: 'head-font',       v: 'var(--ce-head-font, ' + CE_DISP + ')', text: true },
    { g: 'Type',    n: 'key-font',        v: 'var(--ce-key-font, ' + CE_UI_FONT + ')', text: true },
    { g: 'Type',    n: 'key-track',       v: 'var(--ce-key-track, 0.1em)', text: true },
    { g: 'Type',    n: 'key-size',        v: 'var(--ce-key-size, ' + CE_T.fsKey + ')', text: true },
    { g: 'Type',    n: 'key-transform',   v: 'var(--ce-key-transform, uppercase)', text: true },
    { g: 'Type',    n: 'head-size',       v: 'var(--ce-head-size, ' + CE_T.fsD2 + ')', text: true },
    { g: 'Type',    n: 'head-weight',     v: 'var(--ce-head-weight, 600)', text: true },
    { g: 'Type',    n: 'key-opacity',     v: 'var(--ce-key-opacity, 0.58)', text: true },
    { g: 'Type',    n: 'mono-font',       v: 'var(--ce-mono-font, ' + CE_MONO_FONT + ')', text: true },
    { g: 'Type',    n: 'mono-size',       v: 'var(--ce-mono-size, ' + CE_T.fsMono + ')', text: true },
    { g: 'Switch',  n: 'toggle-track-on', v: 'var(--ce-toggle-track-on, ' + CE_FILL + ')' },
    { g: 'Switch',  n: 'toggle-track-off', v: 'var(--ce-toggle-track-off, transparent)' },
    { g: 'Switch',  n: 'toggle-line-on',  v: 'var(--ce-toggle-line-on, ' + CE_LINE2 + ')' },
    { g: 'Switch',  n: 'toggle-line-off', v: 'var(--ce-toggle-line-off, ' + CE_LINE + ')' },
    { g: 'Switch',  n: 'toggle-knob-on',  v: 'var(--ce-toggle-knob-on, currentColor)' },
    { g: 'Switch',  n: 'toggle-knob-off', v: 'var(--ce-toggle-knob-off, ' + CE_LINE2 + ')' },
    { g: 'Switch',  n: 'toggle-radius',   v: 'var(--ce-toggle-radius, 999px)', text: true },
    { g: 'Switch',  n: 'chip-fill-on',    v: 'var(--ce-chip-fill-on, ' + CE_FILL + ')' },
    { g: 'Switch',  n: 'chip-fill-off',   v: 'var(--ce-chip-fill-off, transparent)' },
    { g: 'Switch',  n: 'chip-line-on',    v: 'var(--ce-chip-line-on, ' + CE_LINE2 + ')' },
    { g: 'Switch',  n: 'chip-line-off',   v: 'var(--ce-chip-line-off, ' + CE_LINE + ')' },
    { g: 'Switch',  n: 'chip-radius',     v: 'var(--ce-chip-radius, 999px)', text: true },
    { g: 'Switch',  n: 'reticle',         v: 'var(--ce-reticle, currentColor)' },
    { g: 'Switch',  n: 'reticle-opacity', v: 'var(--ce-reticle-opacity, 0)', text: true },
    { g: 'Switch',  n: 'reticle-size',    v: 'var(--ce-reticle-size, 7px)', text: true },
    { g: 'Switch',  n: 'reticle-motion',  v: 'var(--ce-reticle-motion, ' + CE_T.mBase + ')', text: true },
    // [THEME-HUE] The content hues: eight pattern identities and the attention family.
    // These are NOT chrome and the group is separate to keep that clear -- a pattern hue
    // says whose screen this is, and CE-STYLE SS6.3 spends it on the identity rail, the
    // Object-density border, the active edge, the meter fill and the primary action ground.
    // A theme that leaves this group alone gets the shipped palette, which is the right
    // default; a theme that sets it is the only way to paint a filled button in CE.
    // AURA ONLY. None of these may be applied to body text and none may be dimmed.
    { g: 'Hue',     n: 'pat-contradiction', v: CE_PATTERN_DEFS.contradiction.c },
    { g: 'Hue',     n: 'pat-wantneed',    v: CE_PATTERN_DEFS.wantneed.c },
    { g: 'Hue',     n: 'pat-defense',     v: CE_PATTERN_DEFS.defense.c },
    { g: 'Hue',     n: 'pat-ruleset',     v: CE_PATTERN_DEFS.ruleset.c },
    { g: 'Hue',     n: 'pat-appetite',    v: CE_PATTERN_DEFS.appetite.c },
    { g: 'Hue',     n: 'pat-mask',        v: CE_PATTERN_DEFS.mask.c },
    { g: 'Hue',     n: 'pat-collateral',  v: CE_PATTERN_DEFS.collateral.c },
    { g: 'Hue',     n: 'pat-obligation',  v: CE_PATTERN_DEFS.obligation.c },
    { g: 'Hue',     n: 'sem-ask',         v: CE_SEM.ask },
    { g: 'Hue',     n: 'sem-building',    v: CE_SEM.building },
    // Swatched like the rest even though it defaults to `inherit`. That is not a wasted
    // row: `background: inherit` on the swatch square renders it as an empty outlined box,
    // which is the correct reading of a slot nobody has assigned a hue to, and it fills in
    // the moment a theme sets the name. Same contract as every other swatch here.
    { g: 'Hue',     n: 'sem-ok',          v: CE_SEM.ok },
    // [THEME-FX] The two effect slots. Both paint nothing until a theme asks, both are one
    // value at one site, and both exist because a stylesheet cannot add an element or a
    // pseudo-element to this tree -- the same constraint that produced the reticle.
    { g: 'Effect',  n: 'head-rule',       v: 'var(--ce-head-rule, ' + CE_LINE + ')' },
    { g: 'Effect',  n: 'glow',            v: 'var(--ce-glow, 0 0 0 transparent)', text: true },
    // The bubble tokens are page DOM, not shadow DOM. No swatch can show them from
    // here -- these rows are the vocabulary, and the story itself is the preview.
    { g: 'Bubble',  n: 'cb-pov-bg',       v: 'var(--ce-cb-pov-bg, transparent)' },
    { g: 'Bubble',  n: 'cb-them-bg',      v: 'var(--ce-cb-them-bg, transparent)' },
    { g: 'Bubble',  n: 'cb-pov-ink',      v: 'var(--ce-cb-pov-ink, currentColor)' },
    { g: 'Bubble',  n: 'cb-them-ink',     v: 'var(--ce-cb-them-ink, currentColor)' },
    { g: 'Bubble',  n: 'cb-tail-ink',     v: 'var(--ce-cb-tail-ink, currentColor)' },
    { g: 'Bubble',  n: 'cb-pov-edge',     v: 'var(--ce-cb-pov-edge, 1px solid currentColor)', text: true },
    { g: 'Bubble',  n: 'cb-them-edge',    v: 'var(--ce-cb-them-edge, 1px solid currentColor)', text: true },
    { g: 'Bubble',  n: 'cb-shadow',       v: 'var(--ce-cb-shadow, none)', text: true },
    { g: 'Bubble',  n: 'cb-font',         v: 'var(--ce-cb-font, inherit)', text: true },
    // [CHAT-THEME] The dock's own group. NOT folded into Bubble/cb-*: that family paints
    // into NAI's editor off CE_CB_LOOKS and has no name for a composer, a dock bar or a
    // scroller ground, so one merged value would have to mean two geometries.
    { g: 'Chat',    n: 'chat-ground',     v: CE_CHAT_GROUND },
    { g: 'Chat',    n: 'chat-bar',        v: CE_CHAT_BAR },
    { g: 'Chat',    n: 'chat-you',        v: CE_CHAT_YOU },
    { g: 'Chat',    n: 'chat-them',       v: CE_CHAT_THEM },
    { g: 'Chat',    n: 'chat-you-ink',    v: CE_CHAT_YOU_INK },
    { g: 'Chat',    n: 'chat-them-ink',   v: CE_CHAT_THEM_INK },
    { g: 'Chat',    n: 'chat-radius',     v: CE_CHAT_RADIUS, text: true },
    { g: 'Chat',    n: 'chat-tail',       v: CE_CHAT_TAIL, text: true },
    { g: 'Chat',    n: 'chat-font',       v: CE_CHAT_FONT, text: true },
    { g: 'Shape',   n: 'radius',          v: 'var(--ce-radius, 4px)', text: true },
    { g: 'Shape',   n: 'radius-card',     v: 'var(--ce-radius-card, 10px)', text: true },
    { g: 'Shape',   n: 'press-scale',     v: 'var(--ce-press-scale, 0.97)', text: true },
    { g: 'Shape',   n: 'press-scale-lg',  v: 'var(--ce-press-scale-lg, 0.99)', text: true },
    { g: 'Shape',   n: 'motion-fast',     v: 'var(--ce-motion-fast, ' + CE_MOTION.mFast + ')', text: true },
    { g: 'Shape',   n: 'motion-base',     v: 'var(--ce-motion-base, ' + CE_MOTION.mBase + ')', text: true },
    { g: 'Shape',   n: 'motion-slow',     v: 'var(--ce-motion-slow, ' + CE_MOTION.mSlow + ')', text: true },
    { g: 'Shape',   n: 'motion-ease',     v: 'var(--ce-motion-ease, ease-in-out)', text: true }
];

// [THEME-VAR] THE PROBE. The engine cannot read a computed style -- no DOM, no
// getComputedStyle -- so it cannot REPORT whether a token is live. It can PAINT with it,
// which answers the same question with the author's own eyes: a swatch that is still the
// default colour is a name the theme did not reach.
// EVERY SWATCH IS PAINTED WITH THE REAL TOKEN, not a copy. See CE_THEME_TOKENS.
// COLLAPSED, AND AT THE BOTTOM. Ninety-two rows in nine groups is the longest block on
// this tab by a wide margin, and it is read by whoever is writing a .naitheme -- once,
// deliberately, and then never again. Sitting open and second, it buried every setting
// below it. Same reasoning and same primitive as [CHAT-TOP-COLLAPSE]: this is ONE thing
// disclosing its own contents, which is ceAccordion's job, not the list-of-records misuse
// STYLE2-LIST-SPLIT ruled against.
function _ceSettingsTheme(openMap: any): any {
    var groups: string[] = [];
    var byGroup: any = {};
    for (var i = 0; i < CE_THEME_TOKENS.length; i++) {
        var t = CE_THEME_TOKENS[i];
        if (!byGroup[t.g]) { byGroup[t.g] = []; groups.push(t.g); }
        byGroup[t.g].push(t);
    }
    var kids: any[] = [
        ceProse('t3',
            'These are the names a NovelAI theme can set. Paste a \u201c:root{ \u2026 }\u201d block into '
            + 'your theme\u2019s global CSS \u2014 the properties cross into this surface, which nothing '
            + 'else in a stylesheet can do. A swatch still showing its default is a name your theme '
            + 'did not reach.'),
        ceBtn('Copy the full token list', 'settings:theme:copy', function() {
            var lines: string[] = [':root{'];
            for (var q = 0; q < CE_THEME_TOKENS.length; q++) {
                lines.push('  --ce-' + CE_THEME_TOKENS[q].n + ': ;');
            }
            lines.push('}');
            return api.v1.file.save('ce-theme-tokens.css', lines.join('\n')).then(function() {
                try { api.v1.ui.toast('Saved ce-theme-tokens.css.', { type: 'success', autoClose: 2400 }); } catch (e) {}
            });
        })
    ];
    for (var g = 0; g < groups.length; g++) {
        var rows: any[] = [];
        var list: any[] = byGroup[groups[g]];
        for (var r = 0; r < list.length; r++) {
            var tk = list[r];
            rows.push(ceBar({ gap: CE_T.s2, key: 'thtok:' + tk.n }, [
                ceFixed({ basis: '28px' }, [
                    tk.text
                        ? null
                        : h('div', { style: { width: '24px', height: '24px', borderRadius: CE_T.r,
                                              background: tk.v, border: '1px solid ' + CE_LINE } })
                ]),
                ceGrow(null, [ ceMono('--ce-' + tk.n) ]),
                tk.text ? ceSub('t3', String(tk.v)) : null
            ]));
        }
        kids.push(ceSection(groups[g], ceStack(CE_T.s1, rows)));
    }
    return ceAccordion({
        id: 'settings:theme',
        label: 'Theme tokens',
        open: !!(openMap && openMap['settings:theme']),
        summary: String(CE_THEME_TOKENS.length) + ' names a .naitheme can set',
        children: ceStack(CE_T.s3, kids)
    });
}

// Import / export, calling the four existing native functions directly -- no jsx port of
// their logic, since all four are already self-contained (api.v1.file.save/.prompt,
// api.v1.ui.toast) with no NAI-UIPart-modal dependency to translate.
function _ceSettingsImportExport(): any {
    return ceGroup('Import / export', ceStack(CE_T.s3, [
        ceProse('t3',
            'Pack the world into a hidden lorebook entry that travels with your .scenario export, or use plain JSON for backups and external tools.'),
        ceInline(CE_T.s2, [
            // [F-6] RENAMED, because a third button arrived that these two would have been
            // confused with. Pack/Unpack move the WHOLE MODULE in and out of one hidden
            // entry; Adopt reads OTHER PEOPLE'S entries and makes records from them. They
            // were "Pack to" and "Import from", which is a distinction the author has to
            // already know to read.
            ceBtn('Pack module to lorebook', 'settings:packlore', function() { return packConfigToLorebook(); }),
            ceBtn('Unpack module from lorebook', 'settings:importlore', function() { return pickAndImportFromLorebook(); }),
            // [LEAN] Lean is the default door; full is the one you take to overwrite a
            // destination that has been customised. See exportAll's header.
            ceBtn('Export JSON', 'settings:exportjson', function() { return exportAll(true); }),
            ceBtn('Export JSON (full)', 'settings:exportjsonfull', function() { return exportAll(false); }),
            ceBtn('Import JSON', 'settings:importjson', function() { return importData(); })
        ]),
        // [F-6] ITS OWN ROW AND ITS OWN SENTENCE. A different operation from the four above
        // it -- those move CE's own data, this reads a lorebook somebody else wrote -- and
        // CE-STYLE 8c keeps the explanation out of the row of controls.
        ceProse('t3',
            'Already have a lorebook? Put those entries in the \u201cCE Characters\u201d or '
            + '\u201cCE Locations\u201d category and adopt them: each becomes a character or a place '
            + 'that keeps its own entry, keys and all. A person\u2019s text lands in Concept and a '
            + 'place\u2019s in its entry body, ready to sort into fields. The old \u201cAE \u2026\u201d '
            + 'categories are read too. Entries already owned are left alone, so this is safe to run twice.'),
        ceInline(CE_T.s2, [
            ceBtn('Adopt lorebook entries', 'settings:adoptlore', function() {
                return ceAdoptLorebookEntries().then(function(r: any) {
                    try {
                        // [F-6b] The breakdown, because "adopted 9" cannot tell an author
                        // whether their locations were seen at all.
                        var adTail = (r.charAdopted && r.locAdopted)
                            ? (' (' + String(r.charAdopted) + ' character' + (r.charAdopted === 1 ? '' : 's')
                               + ', ' + String(r.locAdopted) + ' place' + (r.locAdopted === 1 ? '' : 's') + ')')
                            : '';
                        api.v1.ui.toast(r.adopted
                            ? ('Adopted ' + String(r.adopted) + ' entr' + (r.adopted === 1 ? 'y' : 'ies') + adTail + ': '
                               + r.names.slice(0, 4).join(', ') + (r.names.length > 4 ? '\u2026' : ''))
                            : (r.scanned
                                ? 'Nothing new to adopt \u2014 all ' + String(r.scanned) + ' entries are already owned or empty.'
                                : 'No entries in the \u201cCE Characters\u201d or \u201cCE Locations\u201d categories yet.'),
                            { type: r.adopted ? 'success' : 'warning', autoClose: 5000 });
                    } catch (e) {}
                    return cePublishSettings();
                });
            })
        ])
    ]));
}

// [SYNCALL-PORT] syncAllLorebooks HAD ZERO CALLERS. The function is intact and
// correct -- it takes one live snapshot of the lorebook and, for every character, location,
// species and faction, creates a missing entry, re-syncs a live one, or skips -- and the
// section map at the top of this file still lists it as reaching Settings. Its Settings
// button was in the native surface that SECTION 20 took with it, and the jsx port never
// picked it up, so the repair path for a lorebook that has drifted or been hand-deleted in
// NAI has been unreachable for the whole JSX era.
//
// It is a REPAIR TOOL, not a routine one -- earlier PROFILE-LORE means ordinary edits now
// keep themselves in sync -- so it gets a plain button and a tally rather than a switch,
// and the hint says what it is for. The tally is the function's own return value, printed
// rather than summarised, because "created 3" and "skipped 3" mean very different things to
// someone who has just deleted entries by hand.
function _ceSettingsLorebooks(): any {
    return ceGroup('Lorebooks', h('div', null,
        ceSettingRow('Sync all lorebooks',
            'Checks every character, location, species and faction against the lorebook: re-writes entries that have drifted, re-creates any that were deleted in NovelAI, and leaves the rest alone. Safe to run at any time.',
            ceBtn('Sync all', 'settings:syncall', function() {
                return (async function() {
                    try {
                        var t: any = await syncAllLorebooks();
                        var line = function(n: string, x: any) {
                            return n + ' ' + x.created + '/' + x.synced + '/' + x.skipped;
                        };
                        api.v1.ui.toast('Lorebooks (created/synced/skipped) \u2014 '
                            + line('characters', t.characters) + ', '
                            + line('locations', t.locations) + ', '
                            + line('species', t.species) + ', '
                            + line('factions', t.factions),
                            { type: 'success', autoClose: 8000 });
                    } catch (eSa) {
                        api.v1.error('[AE:jsxsettings] syncAllLorebooks failed:', eSa);
                        try { api.v1.ui.toast('Lorebook sync failed \u2014 see console.', { type: 'error', autoClose: 3000 }); } catch (eSa2) {}
                    }
                })();
            })
        )
    ));
}

// ======================================================================================
// -- SYSTEM TAB: Reset settings  [CFG-RESET] -------------------------------------------
// ======================================================================================
// ONE STORAGE RECORD, AND SAYING SO IS THE WHOLE SAFETY ARGUMENT. This rewrites
// STORAGE_CONFIG and touches nothing else -- not a character, not an entity, not the
// journal, the clock, the world states, the cast lorebook or any per-character image slot.
// Its blast radius is a fact about which key it writes, not a promise made in a comment.
//
// WHAT IT IS FOR: a story built on an older CE whose templates, state defs and calendar are
// a version behind, where the fastest route to current defaults was previously to start a
// new story and re-enter the cast. The records that took work to make are the ones this
// deliberately cannot reach.
//
// \u2500\u2500 THE CARRY LIST IS AN ALLOWLIST, AND IT IS SHORT ON PURPOSE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
// The rule for being on it is NOT "this seems useful to keep". It is: THIS FIELD POINTS AT
// DATA THIS BUTTON IS NOT ALLOWED TO TOUCH, so dropping it would break a record it has no
// business breaking. A blank protagonistCharId does not lose a character -- it loses the
// story's knowledge of WHICH character, silently, and the next generation builds context
// around nobody.
//   protagonistCharId / protagonistName   the protagonist [D-01]
//   protagonistFactionId                  a faction entity [F-26]
//   graveyardEntityId                     an entity, created lazily on the first death
//   charChatPovId                         a character
// TWO FIELDS ARE ON IT FOR A DIFFERENT REASON AND ARE LISTED SEPARATELY SO THE RULE ABOVE
// STAYS CLEAN:
//   totalGenerations   engine bookkeeping, not vocabulary. Zeroing it would restart the
//                      thought/hook cadence mid-story, which is a behaviour change nobody
//                      asked this button for.
//   interfaceMode      which shell the author is looking at. Flipping the UI out from under
//                      someone who asked to reset their world's words is a surprise, and it
//                      is the one field here whose reset they would have to undo before
//                      they could see the result of the reset.
//
// \u2500\u2500 WHAT GOES, THAT AN AUTHOR MIGHT NOT EXPECT \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
// datedEntries, projectName/Genre/Concept and the whole travel price list are authored
// CONTENT that happens to live on the config record. They are reset, because the alternative
// is a button whose scope is "the config, except the parts we guessed you wanted" -- and a
// carry list built on guesses is one nobody can predict. THE CONFIRM ROW SAYS SO out loud
// rather than leaving it to be discovered; that sentence is part of the feature.
// STATE VALUES ON CHARACTERS ARE NOT CLEANED UP and do not need to be. A stateValues key
// whose def no longer exists is never read -- every reader iterates the DEFS -- so a custom
// resource's values go dormant rather than dangling, and re-creating the def with the same
// id brings them back.
// [CFG-RESEED] THE VERB, AND THE WHOLE-CONFIG RESET IS NOW ONE OF ITS CALLERS.
// Copies the NAMED fields off a fresh makeDefaultConfig() onto the config in hand and
// saves once. Everything not named is untouched, byte for byte.
//
// THIS INVERTS 3.2.24's CARRY LIST AND THE INVERSION IS THE POINT. That version named what
// SURVIVED a reset, which fails OPEN: a config field added in some later patch is reset by
// a button written before it existed, and if that field happens to point at a character the
// breakage is silent. Naming what is OVERWRITTEN fails CLOSED -- a new field is untouched
// until somebody deliberately adds it to a list. The cost is that a new catalog must be
// added to CE_RESEED_ALL to be covered by "reset everything", which is a visible omission
// rather than an invisible clobber.
//
// A RESEED IS A REPLACEMENT, NOT A MERGE, and there is no version of this that is a merge.
// The seeds CHANGED -- that is the entire reason to press it -- so "keep what the author
// touched" would have to decide whether an edited day name is a customisation or a stale
// default, and nothing in the record distinguishes those. Replacement is the only answer
// that is the same answer every time.
//
// DEEP-COPIED THROUGH JSON, exactly as makeDefaultConfig's own seeds are. A shallow assign
// would hand the live config a reference into the freshly-built default object, which is
// harmless today and is a shared-mutable-seed bug the moment anything caches one.
async function ceReseedConfig(keys: string[]): Promise<number> {
    var moved = 0;
    try {
        var cur: any = await loadConfig();
        var def: any = makeDefaultConfig();
        var i = 0;
        for (i = 0; i < (keys || []).length; i++) {
            var k = String(keys[i] || '');
            if (!k) continue;
            if (def[k] === undefined) { delete cur[k]; moved++; continue; }
            cur[k] = JSON.parse(JSON.stringify(def[k]));
            moved++;
        }
        await saveConfig(cur);
    } catch (e) { api.v1.error('[AE:cfg] reseed:', e); }
    return moved;
}

// The four groups an author actually asks for by name, plus the union the System-tab reset
// uses. A KEY ABSENT FROM makeDefaultConfig IS DELETED RATHER THAN SKIPPED (see above), so
// stateCategoryOrder and defaultResolutionId belong on these lists even though the factory
// does not seed them -- an ordering left over from a catalog that no longer exists is
// exactly the stale state a reseed is pressed to clear.
var CE_RESEED_CALENDAR: string[] = ['calendar'];
var CE_RESEED_STATES:   string[] = ['stateDefs', 'stateCategoryOrder'];
var CE_RESEED_ROLLS:    string[] = ['resolutionDefs', 'stakeDefs', 'defaultResolutionId'];
var CE_RESEED_PROMPTS:  string[] = ['contextTemplates', 'lorebookTemplates', 'lorebookFields',
                                    'generalStyle', 'fieldLabels', 'fieldInstructions',
                                    'fieldBudgets', 'wizardSections'];
// EVERY CATALOG AND EVERY PREFERENCE, AND NOTHING THAT POINTS AT A RECORD. The four id
// fields (protagonistCharId, protagonistFactionId, graveyardEntityId, charChatPovId), the
// generation counter and interfaceMode are deliberately absent -- see ceResetConfig, which
// is the only reason this list is separate from "all the keys on GlobalConfig".
var CE_RESEED_ALL: string[] = CE_RESEED_CALENDAR
    .concat(CE_RESEED_STATES).concat(CE_RESEED_ROLLS).concat(CE_RESEED_PROMPTS)
    .concat(['species', 'relationshipArchetypes', 'standingLadder', 'standingRest',
             'standingStart', 'sheetCategories', 'customStaticFields', 'customLocationFields',
             'customItemFields', 'customFactionFields', 'customNarrativeFields',
             // [F-32] customSpeciesFields WAS MISSING, which is the visible omission this
             // list's own header says is the cost of naming what is overwritten: the array
             // was added with the species migration and nothing added it here, so "reset
             // everything" left one catalog standing. 'species' above is not a mistake and
             // stays -- makeDefaultConfig has no such key, so a reseed DELETES it, which is
             // the correct end state for a config still carrying the pre-migration array.
             'customSpeciesFields',
             'actionPresets', 'travel',
             'datedEntries', 'timeInject', 'summonOnMention', 'defaultBackgroundUrl',
             'projectName', 'projectGenre', 'projectConcept',
             'thoughtIntervalGens', 'hookIntervalGens', 'dynamicIntervalMode',
             'thoughtIntervalTokens', 'hookIntervalTokens', 'ephemeralCap',
             'maxGenerationsPerTurn', 'maxDynamicCharacters', 'autoThoughtsDefault',
             'showFieldHeaders']);

// [CFG-RESEED] The shared button-plus-confirm pair, so four call sites cannot drift apart
// on wording, key namespacing or which surfaces get republished afterwards.
// REPUBLISHES THREE SURFACES WHATEVER WAS RESEEDED. Working out which reseed touches which
// screen would be a fifth list to keep in sync with the four above, and a stale Map after a
// calendar reseed looks exactly like a reseed that did not happen.
function _ceReseedGroup(key: string, label: string, blurb: string, warn: string,
                        keys: string[], activeConfirm: string): any {
    return ceStack({ gap: CE_T.s2, key: 'reseed:' + key }, [
        ceProse('t3', blurb),
        ceInline(CE_T.s2, [ _ceSettingsDeleteBtn('reseed:' + key, label) ]),
        _ceSettingsConfirmRow('reseed:' + key, activeConfirm, warn, function() {
            return ceSettingsOp(function() { return ceReseedConfig(keys); }).then(function() {
                ceSettingsPatch(function() { return { confirm: '' }; });
                try { api.v1.ui.toast('Reseeded to current defaults.', { type: 'success', autoClose: 2600 }); } catch (e) {}
                return cePublishSettings();
            }).then(function() { return cePublishMap(); })
              .then(function() { return cePublishScene(); });
        })
    ]);
}

async function ceResetConfig(): Promise<void> {
    // [CFG-RESEED] NO LONGER BUILDS A FRESH RECORD AND CARRIES SURVIVORS ONTO IT. It names
    // every key it overwrites and leaves the rest of the record alone, which is the same
    // guarantee by the safer route -- see ceReseedConfig for why the inversion matters.
    // The four id fields and the two bookkeeping ones are protected by ABSENCE from
    // CE_RESEED_ALL now rather than by presence on a carry list, so a config field added
    // later is safe by default instead of safe only if somebody remembered it.
    await ceReseedConfig(CE_RESEED_ALL);
}

function _ceSettingsReset(confirm: string): any {
    return ceGroup('Reset settings', ceStack(CE_T.s3, [
        // [CFG-RESEED] THE PROMPTS RESEED LIVES HERE because its catalog has no tab of its
        // own -- templates, field labels, instructions and budgets are scattered across
        // Context, System and the generators, so there is no screen it could sit beside the
        // way the calendar and state ones do. It is first, above the whole-record reset,
        // because it is the narrower of the two and the one more likely to be what is
        // wanted.
        _ceReseedGroup('prompts', 'Reseed prompts\u2026',
            'Replace the injection templates, field labels, field instructions, token '
            + 'budgets, generation style and wizard sections with the ones a new story '
            + 'ships with.',
            'Replace every prompt and field setting with the current defaults? Any wording '
            + 'you customised is overwritten. Your cast, places, states and calendar are '
            + 'not touched.',
            CE_RESEED_PROMPTS, confirm),
        ceProse('t3',
            'Put every setting back to what a new story starts with \u2014 prompts, field '
            + 'instructions, states, resolutions, species, relationship archetypes, the '
            + 'calendar and the travel prices. Characters, places and factions are not '
            + 'touched, and neither is the story itself.'),
        ceInline(CE_T.s2, [
            _ceSettingsDeleteBtn('cfgreset', 'Reset everything\u2026')
        ]),
        // DESTRUCTIVE-NEVER-IN-PLACE, the same arm-then-confirm shape the five deletes on
        // this surface already use. The message names what SURVIVES as well as what goes:
        // an author reading a confirm row is deciding, and half the decision is the half
        // that is easy to leave out.
        _ceSettingsConfirmRow('cfgreset', confirm,
            'Reset every setting to a new story\u2019s defaults? Your cast, your places and '
            + 'your factions stay exactly as they are, and so does the protagonist. Anything '
            + 'you wrote on these tabs \u2014 prompts, states, the calendar, dated entries, '
            + 'travel prices, the project blurb \u2014 is replaced and cannot be undone.',
            function() {
                return ceSettingsOp(function() { return ceResetConfig(); }).then(function() {
                    ceSettingsPatch(function() { return { confirm: '' }; });
                    try { api.v1.ui.toast('Settings reset to defaults.', { type: 'success', autoClose: 2600 }); } catch (e) {}
                    // FOUR REPUBLISHES, because four surfaces read this record and none of
                    // them subscribes to the others. Settings redraws itself; the Map holds
                    // the calendar AND the travel prices; the Scene holds the injection
                    // toggles. A reset that only refreshed the screen it was pressed on
                    // would look like it half-worked.
                    return cePublishSettings();
                }).then(function() { return cePublishMap(); })
                  .then(function() { return cePublishScene(); });
            })
    ]));
}

function _ceSettingsSystemTab(cfg: any, openMap: any, confirm: string, st: any): any {
    return ceStack(CE_T.s4, [
        _ceSettingsInterface(),
        _ceSettingsLorebooks(),
        _ceSettingsImportExport(),
        _ceSettingsTiming(cfg),
        _ceSettingsStyle(cfg),
        _ceSettingsFields(cfg, openMap, confirm),
        _ceSettingsBackground(cfg),
        // [SCENE-STAGE-TUNE] Beside the background rather than on World: both are how the
        // Scene surface DRAWS, and World is the story's vocabulary.
        _ceSettingsStage(cfg),
        _ceSettingsDiagnostics(st),
        // [THEME-VAR] LAST AND COLLAPSED. It is an authoring surface for whoever writes
        // the theme, not a fault report and not a setting -- so it ranks below Diagnostics
        // rather than beside Interface, where its ninety-two rows pushed everything else
        // off the screen. See _ceSettingsTheme's own header.
        _ceSettingsTheme(openMap),
        // [CFG-RESET] LAST, BELOW THE THEME EDITOR. It is the one control on this
        // surface that discards work, and the file’s standing rule for those is that
        // they sit at the bottom of the screen they belong to rather than beside the
        // things they would undo.
        _ceSettingsReset(confirm)
    ]);
}

// ======================================================================================
// -- Root --------------------------------------------------------------------------------
// ======================================================================================
function _ceSettingsRoot(): any {
    ceSettingsStoreInit();
    var st = useStoreValue(ceSettingsStore);
    var ui = useStoreValue(ceUiStore);
    useEffect(function() { cePublishSettings(); }, []);

    // [NOHEADER] The hard-coded '\u2190 Scene' button is DELETED: this surface
    // is on the shell nav, which is rendered directly above it and already offers Scene.
    var back: any = ceBack();

    if (!st || !st.ready || !st.cfg) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    var cfg = st.cfg;
    var openMap: any = (ui && ui.open) || {};
    var confirm = String(st.confirm || '');
    // [TAB-SCOPED] Reads only THIS surface's tab; anything else reads as 'world'.
    // `ui` stays subscribed via useStoreValue above, so a tab change still repaints --
    // ceTabGet's own read is a plain store get, not a second subscription.
    var tab = ceTabGet('settings', 'world');

    // [F-26] 'factions' is no longer a tab, so a stored tab value naming it falls through to
    // 'world' by the same default that has always caught an unknown id.
    var resolvedTab = (tab === 'system' || tab === 'context'
        || tab === 'states' || tab === 'rolls' || tab === 'time'
        || tab === 'helpers') ? tab : 'world';
    var body: any;
    if (resolvedTab === 'system') { body = _ceSettingsSystemTab(cfg, openMap, confirm, st); }
    else if (resolvedTab === 'context') { body = _ceSettingsContextTab(st, openMap, cfg); }
    else if (resolvedTab === 'states') { body = _ceSettingsStatesTab(cfg, openMap, confirm); }
    else if (resolvedTab === 'rolls') { body = _ceSettingsRollsTab(cfg, openMap, confirm); }
    else if (resolvedTab === 'time') { body = _ceSettingsTimeTab(cfg, confirm); }
    else if (resolvedTab === 'helpers') { body = _ceSettingsHelpersTab(cfg, st); }
    else { body = _ceSettingsWorldTab(cfg, openMap, confirm); }

    // ceScreen, same as every other top-level surface (Chat/Map/Journal) --
    // header row plus one scrollable padded body. The tab row scrolls away with the rest
    // rather than staying pinned; a sticky secondary nav bar is a layout shape nothing
    // else on this shell uses, and inventing one here under a "mechanical port" banner
    // would be a bigger design departure than the tabs themselves.
    // [TABBODY-KEY] Same slot, same fix as Images -- see the long note there.
    // No bridge-painted content lives on Settings today, so this is prophylactic rather
    // than corrective; it costs one vnode and closes the same door before something
    // paintable lands on a tab here.
    return ceScreen(ceHeader(back), [_ceSettingsTabRow(resolvedTab),
        ceWrap({ key: 'settab:' + resolvedTab }, body)]);
}

// ============================================================================
// SECTION 35 — IMAGES SURFACE (jsx)
// THE IMAGE PROMPT-FIELD LIBRARY AND THE GENERATION DEFAULTS: add / update / toggle /
// delete / setDefaults / reorder, plus the compiled-output preview.
//
// NOT HERE, so this is not mistaken for a finished Images surface: the GALLERY (browsing,
// deletion, IndexedDB-backed bridge-side bytes) and the STUDIO COMPOSER (base prompt,
// character slots, Enhance/Auto-Snap/Generate). Both are their own design session --
// Images "is not a port." Nothing here presupposes their shape.
//
// ONE RULE SET, TWO CALLERS. The mutation logic is NOT reimplemented here: applyImgFieldOp
// (SECTION 9) is shared. A jsx copy of six ops with their own clamps is the CE-IMG-OPTS
// mirror trap, except worse, because both copies would be in this file and would look
// consistent right up until one was edited.
//
// READS ENGINE MODULE STATE DIRECTLY. imagePromptFields / globalSettings are already in
// memory, so cePublishImages copies them into the store rather than re-reading storage. The
// bridge needs an offline cache because it can render before the handshake; the engine
// cannot, and a second cache here would mirror state this file already owns. Every write
// still goes through saveImageSettings().
//
// FIELD ORDER IS NOT COSMETIC: compileActiveImageFields joins in array order, which decides
// fragment order in the final prompt, which NAI weights positionally. The engine had
// accepted a 'reorder' op since earlier with nothing ever sending one.
//
// STEPS IS CAPPED AT 28 AND SAYS SO. Not a UI opinion -- generateSnapshotImage and the
// request builder both do Math.min(steps||28, 28), so a stored 50 was already silently 28.
//
// GLOBAL, NOT STORY-SCOPED: api.v1.storage, not storyStorage. A prompt library is a
// preference that follows the author across every story, which is why it is not in the
// Settings surface's GlobalConfig-backed tabs despite reading like a settings screen.
// ============================================================================

var ceImagesStore: any = null;
// [GAL-WINDOW] THE PAGE SIZE, and it is a cell count rather than a byte budget on purpose:
// the engine never sees the pixels (the bridge owns them), so the only quantity this side
// can honestly cap is how many it ASKS FOR. Deliberately below one screenful of a wide
// desktop grid, so "Show more" is a normal part of using the tab rather than an error state.
var CE_GAL_PAGE = 24;

// DECLARED ABOVE ITS READER, not beside the gallery helpers where it was first written:
// ceImagesStoreInit reads it inside an object literal, and `var` hoists the declaration
// without the assignment -- so a store init reached before this line executed would have
// written `undefined` as the page size.
function ceImagesStoreInit(): void {
    if (ceImagesStore) return;
    try {
        ceImagesStore = createStore({
            ready: false,
            fields: [], defaults: { width: 832, height: 1216, scale: 5.0, steps: 28 },
            quality: '', negative: '',
            confirm: '',           // delete-confirm target field id
            // [IMGSTUDIO-JSX] Composer state. `prompt`/`uc` are the AUTHORITATIVE
            // text (what a generator wrote); the live typing lives in module vars -- see
            // STUDIO-DRAFTS. promptGen is the ceField seed reset token, not a key bump.
            prompt: '', uc: '', promptGen: 0,
            // one-off character overrides, cap 4, never persisted. Each slot also carries
            // `id` (character id, '' for a blank one-off) so equipment lookup can find them,
            // and picks up `_equipOn`/`_equipAppended` only once that slot's toggle is used.
            slots: [],
            picker: '',            // '' | 'char' | 'loc' -- full surface swap, not an overlay
            roster: [], locations: [],
            // [CEGAL-FIELDSEL] null = this render uses whichever Presets fields are
            // currently active, same as before this existed. A real array (including []) is
            // an explicit per-render override that never mutates any field's `.active` flag.
            studioFieldSel: null,
            // [PHASE-H] Per-render ratio override. EXACTLY the studioFieldSel
            // shape and for the same reason: null means "never touched, use the Presets
            // defaults", a real value overrides THIS RENDER ONLY and never writes back to
            // globalSettings. Two different questions (what this image is, what every
            // image defaults to) must not share one record.
            studioSize: null,
            // [CEGAL] Gallery. galImages is METADATA ONLY (uuid/prompt/storyId/
            // createdAt) -- the pixels never cross the boundary and are painted over each
            // anchored cell by the bridge. galReady is separate from `ready` because the
            // field library is engine-owned and instant while this list is a round trip
            // that may never answer (no bridge = no gallery, stated rather than spinning).
            galImages: [], galReady: false, galAsked: false, galStoryId: '',
            // [GAL-WINDOW] HOW MANY CELLS ARE ALLOWED ON SCREEN. See _ceImagesGalleryTab:
            // every cell is an anchor the BRIDGE paints a real image over, so the cell count
            // is a request for that many IndexedDB reads and that many decoded bitmaps held
            // live at once. A story with several hundred images asked for all of them in one
            // paint and took the tab down with it.
            galShown: CE_GAL_PAGE,
            galAll: false,         // scope toggle: this story only vs every story
            galView: '',           // uuid of the full-view swap, '' = grid
            galConfirm: '',        // delete-confirm target uuid
            // [IMG-EDIT-SURFACE] SECTION 35b's slice. Parked on THIS store rather
            // than a seventh one: the edit surface is reached from the gallery, shares its
            // anchor form and its download action, and a separate store would need its own
            // init call on a route the bridge can enter cold. edGen is the ceField seed
            // reset token (FIELD-KEYLESS), not a key bump.
            edUuid: '', edReady: false, edFound: false, edBusy: false,
            edPrompt: '', edFp: '', edFu: '', edMeta: null, edGen: 0
        });
    } catch (e) { api.v1.error('[AE:jsximages] store init failed:', e); }
}

function ceImagesPatch(fn: (s: any) => any): void {
    if (!ceImagesStore) return;
    try {
        ceImagesStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsximages] patch failed:', e); }
}

// OP-CHAIN. saveImageSettings is two awaited api.v1.storage.set calls plus a broadcast,
// with no compare-and-swap, and this surface can fire one per keystroke-commit across N
// fields -- the same load-modify-persist race every other surface here chains against.
var _ceImagesChain: Promise<any> = Promise.resolve();
function ceImagesOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceImagesChain.then(fn);
    _ceImagesChain = run.catch(function() { return null; });
    return run;
}

// The single verb this surface has. Mutate through the shared rule set, then
// persist+rebroadcast, then republish. Callers never touch imagePromptFields directly.
function ceImgOp(op: string, payload: any): Promise<any> {
    return ceImagesOp(function() {
        try {
            if (!applyImgFieldOp(op, payload || {})) {
                aeLog('[AE:jsximages] unknown op:', op);
                return Promise.resolve(null);
            }
        } catch (e) {
            api.v1.error('[AE:jsximages] op failed:', e);
            return Promise.resolve(null);
        }
        return saveImageSettings();
    }).then(function() { return cePublishImages(); });
}

async function cePublishImages(): Promise<void> {
    ceImagesStoreInit();
    if (!ceImagesStore) return;
    try {
        // Copied, not referenced: the store must not hand the surface a live alias of the
        // module array, or a render could read a half-applied mutation.
        var copy: any[] = [];
        for (var i = 0; i < (imagePromptFields || []).length; i++) {
            var f: any = imagePromptFields[i];
            if (!f) continue;
            copy.push({
                id: String(f.id), name: String(f.name || ''),
                basePrompt: String(f.basePrompt || ''), uc: String(f.uc || ''),
                weight: Number(f.weight) || 1, active: !!f.active
            });
        }
        var compiled = compileActiveImageFields();
        ceImagesPatch(function(s: any) {
            return {
                ready: true, fields: copy,
                defaults: {
                    width:  Number(globalSettings.defaultWidth)  || 832,
                    height: Number(globalSettings.defaultHeight) || 1216,
                    scale:  Number(globalSettings.defaultScale)  || 5.0,
                    steps:  Number(globalSettings.defaultSteps)  || 28,
                    model:  ceImgModel()
                },
                quality: compiled.quality, negative: compiled.negative,
                // A confirm armed against a field that has since gone (deleted from the
                // bridge's copy of this panel while both UIs are live) must not survive.
                confirm: _ceImgHasField(copy, String(s.confirm || '')) ? s.confirm : ''
            };
        });
    } catch (e) {
        api.v1.error('[AE:jsximages] publish failed:', e);
        ceImagesPatch(function() { return { ready: true }; });
    }
}
function _ceImgHasField(list: any[], id: string): boolean {
    if (!id) return false;
    for (var i = 0; i < list.length; i++) { if (list[i].id === id) return true; }
    return false;
}

// The three ratios every image surface in this project already offers -- the Presets
// panel, the Emotion Studio and (since earlier) the Image Studio composer all use this
// exact set. Free-form width/height is deliberately NOT offered: it can produce a
// dimension NAI rejects, which is why the composer's raw inputs were retired.
var CE_IMG_RATIOS: any[] = [
    { label: 'Portrait',  w: 832,  h: 1216 },
    { label: 'Square',    w: 1024, h: 1024 },
    { label: 'Landscape', w: 1216, h: 832 }
];

// -- Defaults block ------------------------------------------------------------------
function _ceImagesDefaults(d: any): any {
    var ratioBtns: any[] = [];
    for (var i = 0; i < CE_IMG_RATIOS.length; i++) {
        ratioBtns.push((function(sz: any) {
            var on = (d.width === sz.w && d.height === sz.h);
            return ceBtn(sz.label, 'img:ratio:' + sz.label, function() {
                if (on) return Promise.resolve();
                return ceImgOp('setDefaults', { width: sz.w, height: sz.h });
            }, on ? 'primary' : undefined);
        })(CE_IMG_RATIOS[i]));
    }
    return ceGroup('Default Generation Settings',
        ceStack(CE_T.s3, [
            ceSub('t3',
                'Applied to every generation that does not override them \u2014 the studio composer, avatars, chat photos and Auto-Snap all start here.'),
            ceSettingRow('Ratio', d.width + '\u00d7' + d.height,
                ceInline(CE_T.s2, ratioBtns)),
            // [IMG-MODEL] A SELECT, NOT A BUTTON SET like the ratio above it. Four options
            // whose labels carry a version number do not survive being squeezed onto one
            // phone row -- CE-STYLE 8b, the same collapse the travel editor and the time
            // bands both paid for. Its own row, so no prose shares it (8c).
            ceSelect({
                k: 'img:def:model', label: 'Model', value: String(d.model || CE_IMG_MODEL_DEFAULT),
                options: CE_IMG_MODELS,
                hint: 'V5 returns images with an alpha channel and can put a character on a '
                    + 'transparent background \u2014 prompt \u201ctransparent background\u201d, '
                    + 'strengthened if it needs it (2.1::transparent background::).',
                onCommit: function(v: string) { return ceImgOp('setDefaults', { model: v }); }
            }),
            ceNumField({ k: 'img:def:scale', label: 'Scale', hint: '0.1\u201310 in steps of 0.1, 5 is the default',
                value: d.scale, min: 0.1, max: 10, decimals: 1,
                onCommit: function(n: number) { return ceImgOp('setDefaults', { scale: n }); } }),
            // See IMGPRESET-STEPS-28 in the header: the clamp is real, not advisory.
            ceNumField({ k: 'img:def:steps', label: 'Steps', hint: '1\u201328 \u2014 higher values are clamped to 28 before the request',
                value: d.steps, min: 1, max: 28,
                onCommit: function(n: number) { return ceImgOp('setDefaults', { steps: n }); } })
        ]));
}

// -- Compiled preview ----------------------------------------------------------------
// The bridge never showed this. Weighting is the one part of the field model
// nobody can predict by reading the rows -- a weight of 1 compiles plain, anything else
// wraps as NAI's `w::text::` -- so the only way to know what the library actually emits
// was to generate something and look at it.
function _ceImagesCompiled(st: any): any {
    var activeCount = 0;
    for (var i = 0; i < (st.fields || []).length; i++) { if (st.fields[i].active) activeCount++; }
    function block(label: string, text: string): any {
        return ceStack(CE_T.s1, [
            ceSub('t2', label),
            h('div', { style: {
                background: CE_WELL, border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
                padding: CE_T.s3
            } }, ceMono(text || '(empty)', {
                // Ladder: compiled output is content, t1; the empty placeholder is t3.
                opacity: text ? CE_OP.t1 : CE_OP.t3,
                style: { whiteSpace: 'pre-wrap', lineHeight: '1.5' }
            }))]);
    }
    return ceSection('Compiled Output',
        ceStack(CE_T.s3, [
            ceSub('t3',
                activeCount + ' active field' + (activeCount === 1 ? '' : 's')
                + ' \u2014 exactly what gets appended to every generation, in this order. A weight of 1 compiles plain; anything else wraps as weight::text::'),
            block('Prompt', st.quality),
            block('Negative / UC', st.negative)
        ]));
}

// -- One field row -------------------------------------------------------------------
function _ceImagesField(f: any, idx: number, total: number, openMap: any, confirm: string, orderedIds: string[]): any {
    var accId = 'img:field:' + f.id;
    var open = !!openMap[accId];
    var w = Number(f.weight) || 1;

    function moveTo(newIdx: number): Promise<any> {
        if (newIdx < 0 || newIdx >= total) return Promise.resolve();
        var next = orderedIds.slice();
        var cur = next.splice(idx, 1)[0];
        next.splice(newIdx, 0, cur);
        return ceImgOp('reorder', { orderedIds: next });
    }

    var body: any[] = [
        ceInline(CE_T.s2, [
            // Active is a TOGGLE, not a verb button -- ceToggle exists precisely because a
            // button labelled with an action reads the same in both directions (earlier).
            // The bridge rendered this as a star-prefixed "Active"/"Inactive" button.
            ceBtn(f.active ? 'Active' : 'Inactive', accId + ':toggle', function() {
                return ceImgOp('toggle', { id: f.id });
            }, f.active ? 'primary' : undefined),
            ceBtn('\u2191', accId + ':up', function() { return moveTo(idx - 1); }),
            ceBtn('\u2193', accId + ':dn', function() { return moveTo(idx + 1); })
        ]),
        h(ceField, { k: accId + ':name', label: 'Name', value: f.name || '', placeholder: 'Field name',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, name: v }); } }),
        ceNumField({ k: accId + ':weight', label: 'Weight', hint: '0.1\u201310 in steps of 0.1 \u2014 1 compiles plain, anything else wraps as weight::text::',
            value: w, min: 0.1, max: 10, decimals: 1,
            onCommit: function(n: number) { return ceImgOp('update', { id: f.id, weight: n }); } }),
        h(ceField, { k: accId + ':bp', label: 'Prompt fragment', value: f.basePrompt || '',
            multiline: true, rows: 3, well: true, placeholder: 'Base prompt fragment\u2026',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, basePrompt: v }); } }),
        h(ceField, { k: accId + ':uc', label: 'Negative / UC fragment', value: f.uc || '',
            multiline: true, rows: 2, well: true, placeholder: 'UC / undesired fragment\u2026',
            onCommit: function(v: string) { return ceImgOp('update', { id: f.id, uc: v }); } })
    ];

    // DESTRUCTIVE-NEVER-IN-PLACE. The bridge deleted a field on a single tap of a bin
    // icon with no confirm at all; a prompt fragment someone tuned by hand is worth one
    // more tap. Same arm/confirm shape as every other delete on this shell.
    body.push(ceIconBtn('Delete this field\u2026', ceIconTrash(), accId + ':delask', function() {
        ceImagesPatch(function() { return { confirm: f.id }; });
        return Promise.resolve();
    }, 'danger'));
    if (confirm === f.id) {
        body.push(h('div', {
            key: accId + ':confirm',
            style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
        },
            ceProse('t2',
                'Delete \u201c' + (f.name || 'this field') + '\u201d? This cannot be undone.', { grow: true, basis: '180px' }),
            ceBtn('Delete', accId + ':del', function() {
                return ceImgOp('delete', { id: f.id }).then(function() {
                    ceImagesPatch(function() { return { confirm: '' }; });
                    return null;
                });
            }, 'danger'),
            ceBtn('Keep', accId + ':keep', function() {
                ceImagesPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    var summaryBits: string[] = [];
    if (w !== 1) summaryBits.push('\u00d7' + w);
    var frag = String(f.basePrompt || '').trim();
    if (frag) summaryBits.push(frag);
    return ceAccordion({
        id: accId,
        label: f.name || '(unnamed field)',
        open: open,
        // Semantic dot rather than a word: active/inactive is the one thing worth reading
        // off a collapsed row, and ceDot is how this shell says state at a glance.
        lead: ceDot(f.active ? 'building' : 'calm'),
        summary: summaryBits.join(' \u00b7 '),
        meta: f.active ? 'on' : '',
        children: ceStack(CE_T.s3, body)
    });
}

// ======================================================================================
// -- STUDIO TAB  [IMGSTUDIO-JSX] ----------------------------------------------
// ======================================================================================
// The composer: describe an image, optionally name who is in it, and render it. This is
// the jsx replacement for the bridge's Image Studio widget form.
//
// EVERY VERB HERE WAS ALREADY AN ENGINE FUNCTION, which is why this tab needed no new
// message pair and no bridge change at all:
//   Auto-Snap -> buildArchitectPromptFromStory(paragraphs)   (architect pass over story)
//   Enhance   -> enhanceDirectorPrompt(prompt, chars)        (returns a value)
//   Generate  -> submitDirectorPhoto(prompt, uc, chars)      (broadcasts EVT_GENERATE_IMAGE)
// The bridge reached all three by round-tripping EVT_DIRECTOR_SUBMIT / EVT_AUTOSNAP_PROMPT
// and waiting for a reply broadcast. This surface calls them directly and skips the round
// trip entirely -- the message handlers stay untouched and still work for the bridge.
//
// GENERATION STILL REQUIRES THE BRIDGE, and that is not something this surface can route
// around: submitDirectorPhoto's own first guard is `if (!isBridgeReady)`, because the
// actual pixels come from a fetch to NAI's image endpoint and there is no fetch in this
// sandbox. So Generate is DISABLED with a stated reason when the bridge is absent, rather
// than firing into silence. Auto-Snap and Enhance are pure engine generation and stay
// available either way -- there is no reason to gate prompt-building on the byte pipeline.
//
// [STUDIO-ONEOFF] CHARACTER SLOTS ARE ONE-OFF OVERRIDES AND ARE NEVER WRITTEN
// BACK, which is the engine's own existing rule (submitDirectorPhoto's comment says so
// outright: "those edits are one-off, per user's call, never written back"). Picking a
// character PREFILLS name/visuals/uc from the record; editing any of them changes this
// generation only. The slots therefore live in the STORE, not in ceProfileWrite -- there
// is no persistence path out of this tab by design, and adding one later would silently
// change what a decade of muscle memory expects a studio slot to do.
// Cap is 4, matching submitDirectorPhoto's own slice(0, 4) -- a fifth slot would be
// accepted by the UI and then silently dropped at the call, which is worse than refusing.
// A slot with no name is legitimate (an unnamed figure in the frame), so nothing filters
// on name being present.
//
// [STUDIO-DRAFTS] The prompt and UC boxes ride MODULE VARIABLES via onType, not
// store state -- CLICK-BEFORE-BLUR, the same reason the Journal composer and the chat
// summary editor do. Generate/Enhance are buttons that read a value the field commits on
// blur, and in this environment the click lands first. The store still holds the
// AUTHORITATIVE prompt (so Auto-Snap and Enhance can replace it) plus a `promptGen`
// counter, which is the ceField `seed` reset token -- FIELD-KEYLESS, not a key bump.
//
// PICKERS ARE FULL SURFACE SWAPS (JSXPROFILE-NO-OVERLAY -- overlay sheets are not
// constructible in this environment). Both the character picker and the location picker
// replace the whole surface and return to it, rather than floating over it.
// ======================================================================================

// Live text, never store state -- see STUDIO-DRAFTS above.
var _ceStudioPromptDraft: string = '';
var _ceStudioUcDraft: string = '';

function ceStudioPatch(fn: (s: any) => any): void { ceImagesPatch(fn); }

// Replace the prompt from a GENERATOR (Auto-Snap / Enhance). Bumps the seed so the
// textarea reseeds, and syncs the draft so an immediate Generate reads the new text
// rather than whatever was typed before.
function _ceStudioSetPrompt(text: string): void {
    _ceStudioPromptDraft = String(text || '');
    ceStudioPatch(function(s: any) {
        return { prompt: String(text || ''), promptGen: (Number(s.promptGen) || 0) + 1 };
    });
}

// Append to the prompt without discarding what is already there -- used by the location
// picker, which adds visuals to a description rather than replacing it.
function _ceStudioAppendPrompt(text: string): void {
    var add = String(text || '').trim();
    if (!add) return;
    var cur = String(_ceStudioPromptDraft || '').trim();
    _ceStudioSetPrompt(cur ? (cur + ', ' + add) : add);
}

function _ceStudioSlots(s: any): any[] { return (s && s.slots) ? s.slots : []; }

function ceStudioAddSlot(ch: any): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (next.length >= 4) return {};
        next.push({
            id:      ch ? String(ch.id || '') : '',
            name:    ch ? String(ch.name || '') : '',
            visuals: ch ? String(ch.visuals || '') : '',
            uc:      ch ? String(ch.uc || '') : ''
        });
        return { slots: next, picker: '' };
    });
}
function ceStudioSetSlot(idx: number, field: string, value: string): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (!next[idx]) return {};
        var row: any = {}; var k: string;
        for (k in next[idx]) { row[k] = next[idx][k]; }
        row[field] = String(value || '');
        next[idx] = row;
        return { slots: next };
    });
}
function ceStudioRemoveSlot(idx: number): void {
    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        next.splice(idx, 1);
        return { slots: next };
    });
}

// -- Per-render field selection [CEGAL-FIELDSEL] --------------------------------
// The selection a Generate call will actually use, whether or not the user has touched the
// picker yet: falls back to the Presets tab's own active set until they diverge from it.
function _ceStudioFieldSel(s: any): string[] {
    if (Array.isArray(s.studioFieldSel)) return s.studioFieldSel;
    var out: string[] = [];
    var fl: any[] = s.fields || [];
    for (var i = 0; i < fl.length; i++) { if (fl[i].active) out.push(String(fl[i].id)); }
    return out;
}
function ceStudioToggleField(fieldId: string): void {
    if (!fieldId) return;
    ceStudioPatch(function(s: any) {
        var base = _ceStudioFieldSel(s).slice();
        var i = base.indexOf(fieldId);
        if (i === -1) { base.push(fieldId); } else { base.splice(i, 1); }
        return { studioFieldSel: base };
    });
}
function ceStudioResetFieldSel(): void {
    ceStudioPatch(function() { return { studioFieldSel: null }; });
}
// [PHASE-H] The ratio override, mirroring the three functions above.
// RETURNS THE DEFAULTS WHEN UNSET rather than a hard-coded pair -- the whole point is that
// an untouched studio still follows Presets, so there is no second place the default size
// is written down.
// The three shapes already settled across every image surface in this project, plus the
// CURRENT value appended when it is none of them -- the same rule CE_IMG_RATIO_OPTS follows for
// the avatar frame, so a preset carrying some other pair renders instead of being silently
// snapped to the nearest of three.
function _ceStudioSizeOpts(sz: any): any[] {
    var out: any[] = [
        { id: '832x1216', label: 'Portrait \u2014 832\u00d71216' },
        { id: '1024x1024', label: 'Square \u2014 1024\u00d71024' },
        { id: '1216x832', label: 'Landscape \u2014 1216\u00d7832' }
    ];
    var cur = String(sz.width) + 'x' + String(sz.height);
    var known = false;
    for (var i = 0; i < out.length; i++) { if (out[i].id === cur) { known = true; break; } }
    if (!known) { out.push({ id: cur, label: 'Custom \u2014 ' + String(sz.width) + '\u00d7' + String(sz.height) }); }
    return out;
}
function _ceStudioSize(s: any): any {
    var d: any = (s && s.defaults) || {};
    var o: any = s && s.studioSize;
    if (o && Number(o.width) > 0 && Number(o.height) > 0) {
        return { width: Number(o.width), height: Number(o.height) };
    }
    return { width: Number(d.width) || 832, height: Number(d.height) || 1216 };
}
function ceStudioSetSize(v: string): void {
    var parts = String(v || '').split('x');
    var w = Number(parts[0] || 0); var hgt = Number(parts[1] || 0);
    if (!(w > 0) || !(hgt > 0)) { ceStudioPatch(function() { return { studioSize: null }; }); return; }
    ceStudioPatch(function() { return { studioSize: { width: w, height: hgt } }; });
}

// -- Actions ---------------------------------------------------------------------------
function ceStudioAutoSnap(): Promise<any> {
    return ceImagesOp(function() {
        var paras = Number(globalSettings.contextSize) || DEFAULT_CTX;
        return buildArchitectPromptFromStory(paras).then(function(built: any) {
            if (!built || !built.prompt) {
                try { api.v1.ui.toast('Could not build a prompt from the recent story.', { type: 'warning', autoClose: 3000 }); } catch (_e) {}
                return null;
            }
            _ceStudioSetPrompt(built.prompt);
            // Auto-Snap resolves which characters the story just mentioned, so it fills the
            // slots too -- the same matchedChars the bridge used to receive as charNames and
            // then have to re-resolve against its own cache. Here the records are in hand.
            var matched: any[] = (built.matchedChars || []).slice(0, 4);
            ceStudioPatch(function() {
                return { slots: matched.map(function(c: any) {
                    return { id: String(c.id || ''), name: String(c.name || ''), visuals: String(c.visuals || ''), uc: String(c.uc || '') };
                }) };
            });
            try { api.v1.ui.toast('Prompt built from the recent story.', { type: 'success', autoClose: 2500 }); } catch (_e2) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] auto-snap failed:', e);
            try { api.v1.ui.toast('Auto-snap failed.', { type: 'error', autoClose: 3000 }); } catch (_e3) {}
            return null;
        });
    });
}

function ceStudioEnhance(): Promise<any> {
    var prompt = String(_ceStudioPromptDraft || '').trim();
    if (!prompt) {
        try { api.v1.ui.toast('Write something to enhance first.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    var slots: any[] = [];
    try { var st: any = ceImagesStore ? ceImagesStore.get() : null; slots = _ceStudioSlots(st); } catch (e) { slots = []; }
    return ceImagesOp(function() {
        return enhanceDirectorPrompt(prompt, slots).then(function(res: any) {
            if (!res || !res.enhancedPrompt) {
                try { api.v1.ui.toast('Enhancement failed.', { type: 'error', autoClose: 3000 }); } catch (_e2) {}
                return null;
            }
            _ceStudioSetPrompt(res.enhancedPrompt);
            // enhanceDirectorPrompt returns adapted per-character visuals alongside the
            // prompt; writing them back into the slots is what makes a second Enhance build
            // on the first rather than re-deriving from the original record.
            var cv: any[] = res.charVisuals || [];
            if (cv.length) {
                ceStudioPatch(function(s: any) {
                    var next = _ceStudioSlots(s).slice();
                    for (var i = 0; i < next.length && i < cv.length; i++) {
                        var row: any = {}; var k: string;
                        for (k in next[i]) { row[k] = next[i][k]; }
                        if (cv[i] && cv[i].visuals) row.visuals = String(cv[i].visuals);
                        next[i] = row;
                    }
                    return { slots: next };
                });
            }
            try { api.v1.ui.toast('Prompt enhanced.', { type: 'success', autoClose: 2500 }); } catch (_e3) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] enhance failed:', e);
            try { api.v1.ui.toast('Enhancement failed.', { type: 'error', autoClose: 3000 }); } catch (_e4) {}
            return null;
        });
    });
}

function ceStudioGenerate(): Promise<any> {
    var prompt = String(_ceStudioPromptDraft || '').trim();
    if (!prompt) {
        try { api.v1.ui.toast('Describe the image first.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    if (!isBridgeReady) {
        // Stated, not silent. submitDirectorPhoto would toast this itself, but the button
        // is also visibly disabled so the reason is legible before the tap.
        try { api.v1.ui.toast('Generating needs the bridge connected.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return Promise.resolve();
    }
    var slots: any[] = [];
    try { var st: any = ceImagesStore ? ceImagesStore.get() : null; slots = _ceStudioSlots(st); } catch (e) { slots = []; }
    var uc = String(_ceStudioUcDraft || '').trim();
    // null when the user has never touched the picker -- submitDirectorPhoto treats that
    // the same as no argument at all and falls back to the standing active set.
    var fieldSel: string[] | null = null;
    var sizeSel: any = null;
    try {
        var stf: any = ceImagesStore ? ceImagesStore.get() : null;
        fieldSel = (stf && Array.isArray(stf.studioFieldSel)) ? stf.studioFieldSel : null;
        // [PHASE-H] Read the RAW override, not _ceStudioSize's resolved value: a
        // resolved value is never null, so passing it would make every render an explicit
        // override and silently pin the size the first time the studio opened.
        sizeSel = (stf && stf.studioSize) ? stf.studioSize : null;
    } catch (e) { fieldSel = null; sizeSel = null; }
    // [STORYIMG] Read at the moment of the tap, not from the render closure: the
    // toggle sits on this same tab and the two must not be able to disagree by one paint.
    var placeIt = !!globalSettings.studioPlaceInStory;
    return ceImagesOp(function() {
        return submitDirectorPhoto(prompt, uc, slots, fieldSel, sizeSel).then(function(newUuid: string) {
            // The image itself lands bridge-side (EVT_GENERATE_IMAGE -> fetch -> IndexedDB).
            // [STORYIMG] What DOES come back now is the uuid, which is enough to
            // pin the widget immediately -- so the anchor exists while the picture is still
            // generating and the bridge paints a placeholder into it. That is the whole
            // "indication of generating until success" mechanism: no second message, no
            // pending flag to keep in sync, just an anchor whose image is not there yet.
            if (placeIt && newUuid) {
                return ceStoryImgPlace(newUuid).then(function(ok: boolean) {
                    try {
                        api.v1.ui.toast(ok ? 'Generating \u2014 it will appear at the end of your story.'
                                           : 'Sent to the image pipeline\u2026',
                            { type: 'info', autoClose: 2500 });
                    } catch (_e3a) {}
                    return null;
                });
            }
            // Unchanged when the toggle is off: this does NOT claim the image exists yet.
            try { api.v1.ui.toast('Sent to the image pipeline\u2026', { type: 'info', autoClose: 2500 }); } catch (_e3) {}
            return null;
        }).catch(function(e: any) {
            api.v1.error('[AE:jsxstudio] generate failed:', e);
            try { api.v1.ui.toast('Could not start generation.', { type: 'error', autoClose: 3000 }); } catch (_e4) {}
            return null;
        });
    });
}

// -- Pickers (full surface swaps) ------------------------------------------------------
async function cePublishStudioPickers(): Promise<void> {
    // Loaded on demand rather than kept in the store permanently: the roster and the
    // location list are both already-cheap engine reads, and holding a copy would be one
    // more thing to invalidate when a character is renamed elsewhere in the shell.
    try {
        var chars: any[] = await loadAllCharacters();
        var roster: any[] = [];
        for (var i = 0; i < (chars || []).length; i++) {
            var c = chars[i];
            if (!c || !c.id) continue;
            if (c.active === false) continue;
            roster.push({ id: String(c.id), name: String(c.name || 'Unknown'),
                visuals: String(c.visuals || ''), uc: String(c.uc || '') });
        }
        var metas: any[] = await loadEntityIndex();
        var locs: any[] = [];
        for (var j = 0; j < (metas || []).length; j++) {
            if (!metas[j] || metas[j].type !== 'location') continue;
            var rec: any = await loadEntity(metas[j].id);
            if (!rec) continue;
            locs.push({ id: String(rec.id), name: String(rec.name || 'Unnamed'),
                visuals: String(rec.locationVisuals || '') });
        }
        ceImagesPatch(function() { return { roster: roster, locations: locs }; });
    } catch (e) {
        api.v1.error('[AE:jsxstudio] picker publish failed:', e);
    }
}

function _ceStudioPickerScreen(st: any, back: any): any {
    var kind = String(st.picker || '');
    var rows: any[] = [];
    var i: number;
    if (kind === 'char') {
        var roster: any[] = st.roster || [];
        for (i = 0; i < roster.length; i++) {
            rows.push((function(ch: any) {
                return ceListRow({
                    label: ch.name,
                    sub: ch.visuals ? _ceTrim(ch.visuals, 68) : 'No visuals written yet',
                    onClick: function() { ceStudioAddSlot(ch); }
                });
            })(roster[i]));
        }
        rows.push(ceListRow({
            label: 'Unnamed figure',
            sub: 'An empty slot to describe by hand',
            onClick: function() { ceStudioAddSlot(null); }
        }));
        return ceScreen(ceHeader(back),
            [ceStack(null, rows)]);
    }
    var locs: any[] = st.locations || [];
    var locRows: any[] = [];
    for (i = 0; i < locs.length; i++) {
        locRows.push((function(l: any) {
            return ceListRow({
                label: l.name,
                sub: l.visuals ? _ceTrim(l.visuals, 68) : 'No scene visuals set',
                onClick: function() {
                    if (!l.visuals) {
                        try { api.v1.ui.toast(l.name + ' has no scene visuals set.', { type: 'warning', autoClose: 3000 }); } catch (_e) {}
                        return;
                    }
                    _ceStudioAppendPrompt(l.visuals);
                    ceImagesPatch(function() { return { picker: '' }; });
                }
            });
        })(locs[i]));
    }
    return ceScreen(ceHeader(back),
        [locRows.length
            ? ceStack(null, locRows)
            : ceEmpty('No locations in this world yet.', null)]);
}

// -- The tab ---------------------------------------------------------------------------
function _ceImagesStudioTab(st: any): any {
    var d = st.defaults || {};
    var slots = _ceStudioSlots(st);
    var i: number;

    var slotNodes: any[] = [];
    for (i = 0; i < slots.length; i++) {
        slotNodes.push((function(sl: any, idx: number) {
            var kp = 'img:slot:' + idx;
            return h('div', { key: kp, style: {
                display: 'flex', flexDirection: 'column', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3
            } },
                ceBar(CE_T.s2, [
                    ceGrow(null, [ h(ceField, {
                        k: kp + ':name', label: '', value: sl.name || '', placeholder: 'Name (optional)',
                        onCommit: function(v: string) { ceStudioSetSlot(idx, 'name', v); return Promise.resolve(); }
                    })]),
                    ceBtn('Remove', kp + ':rm', function() { ceStudioRemoveSlot(idx); return Promise.resolve(); }, 'danger')
                ]),
                // [PHASE-H] 'Visuals' -> 'Character Base Prompt'. Says WHAT it is
                // (a prompt fragment) and WHOSE it is, where 'Visuals' said neither.
                h(ceField, { k: kp + ':vis', label: 'Character Base Prompt', value: sl.visuals || '',
                    multiline: true, rows: 2, well: true, placeholder: '1girl, brown hair, red dress\u2026',
                    onCommit: function(v: string) { ceStudioSetSlot(idx, 'visuals', v); return Promise.resolve(); } }),
                // [CEGAL-EQUIP] Ported from the retired bridge widget. Disabled for
                // a blank one-off slot -- there is no character id to look equipment up for.
                ceBar(CE_T.s2, [
                    ceToggle(!!sl._equipOn, kp + ':equip', function() { ceStudioToggleEquip(idx); return Promise.resolve(); }),
                    // Ladder + SS4's disabled rule: a disabled control gets t3 AND a
                    // stated reason, never dimming alone. The reason is the label itself
                    // ("pick a character first"), which is why this row was already
                    // halfway compliant; only the rungs were off.
                    h('div', { style: { fontSize: CE_T.fsSm, opacity: sl.id ? CE_OP.t1 : CE_OP.t3 } },
                        sl.id ? 'Append equipped items' : 'Append equipped items (pick a character first)')
                ]),
                // [PHASE-H] 'Negative' -> 'Character UC'.
                h(ceField, { k: kp + ':uc', label: 'Character UC (optional)', value: sl.uc || '',
                    onCommit: function(v: string) { ceStudioSetSlot(idx, 'uc', v); return Promise.resolve(); } })
            );
        })(slots[i], i));
    }

    // [PHASE-H] Resolved size for display: the override if there is one, the
    // Presets default if not.
    var sz = _ceStudioSize(st);
    var genLabel = isBridgeReady ? 'Generate' : 'Generate (needs bridge)';

    return ceStack(CE_T.s4, [
        // [PHASE-H] 'Describe' -> 'Base Prompt'. NAI's own term.
        ceGroup('Base Prompt', ceStack(CE_T.s2, [
            ceProse('t3',
                'Auto-Snap builds a prompt from what just happened in the story. Enhance rewrites a rough description into a fuller one, pulling in whoever is listed below. Generate renders it with the fields selected below (defaulting to whichever are active on the Presets tab) and the size/scale defaults from there too.'),
            h(ceField, {
                seed: 'studio:prompt:' + String(st.promptGen || 0),
                k: 'studio:prompt', label: '', value: String(st.prompt || ''),
                multiline: true, rows: 4, well: true,
                placeholder: 'e.g. two knights duel on a rain-soaked bridge at dusk',
                onType: function(v: string) { _ceStudioPromptDraft = v; },
                onCommit: function(v: string) { _ceStudioPromptDraft = v; return Promise.resolve(); }
            }),
            ceInline(CE_T.s2, [
                ceBtn('Auto-Snap', 'studio:autosnap', function() { return ceStudioAutoSnap(); }),
                ceBtn('Enhance', 'studio:enhance', function() { return ceStudioEnhance(); }),
                ceBtn('+ Location visuals', 'studio:pick:loc', function() {
                    ceImagesPatch(function() { return { picker: 'loc' }; });
                    return cePublishStudioPickers();
                })
            ]),
            h(ceField, {
                seed: 'studio:uc:' + String(st.promptGen || 0),
                // [PHASE-H] 'Negative / unwanted' -> 'Unwanted Content', NAI's term.
                k: 'studio:uc', label: 'Unwanted Content (optional)', value: String(st.uc || ''),
                multiline: true, rows: 2, well: true,
                placeholder: 'Leave blank to use the active fields\u2019 negatives',
                onType: function(v: string) { _ceStudioUcDraft = v; },
                onCommit: function(v: string) { _ceStudioUcDraft = v; return Promise.resolve(); }
            })
        ])),

        ceGroup('Who is in it (' + slots.length + ' of 4)',
            ceStack(CE_T.s3, [
                ceProse('t3',
                    'Optional. Picking someone fills their visuals from their profile; anything you change here applies to this image only and is never written back to them.'),
                slotNodes.length
                    ? ceStack(CE_T.s3, slotNodes)
                    : null,
                slots.length < 4
                    ? ceBtn('+ Add character', 'studio:pick:char', function() {
                        ceImagesPatch(function() { return { picker: 'char' }; });
                        return cePublishStudioPickers();
                    })
                    : ceSub('t3', 'Four is the maximum the generator accepts.')
            ])),

        ceGroup('Render', ceStack(CE_T.s2, [
            // [PHASE-H] THE PRESETS BUTTON IS GONE -- there is a
            // Presets TAB one row above it, so the button was a second door to a room already
            // visible from here. What replaces it is the thing the list actually asked for:
            // the ratio is editable, as a per-render override of the preset.
            // SCALE AND STEPS STAY READ-ONLY on this row and stay pointed at Presets. They
            // are not what a single image wants changed -- ratio is a compositional choice
            // (this shot is a portrait, that one is a landscape) where scale and steps are
            // engine tuning you set once. Adding all three here would rebuild the Presets
            // tab inside the composer.
            ceSettingRow('Ratio', 'Overrides the preset for this render only \u00b7 scale '
                    + d.scale + ' \u00b7 ' + d.steps + ' steps',
                ceSelect({
                    k: 'studio:size', value: String(sz.width) + 'x' + String(sz.height),
                    options: _ceStudioSizeOpts(sz),
                    onCommit: function(v: string) { ceStudioSetSize(v); return Promise.resolve(); }
                })),
            (st.studioSize)
                ? ceBtn('Reset ratio to Presets', 'studio:size:reset', function() {
                    ceStudioSetSize(''); return Promise.resolve();
                })
                : null,
            // [CEGAL-FIELDSEL] Per-render field selection. Defaults to whichever
            // Presets fields are standing-active (compileActiveImageFields' own rule) until
            // a chip here is tapped, at which point it becomes an explicit override that
            // never writes back to any field's `.active` flag -- Presets stays the source
            // of truth for every OTHER generation path (Auto-Snap, Snapshot).
            (st.fields || []).length
                ? ceStack(CE_T.s2, [
                    ceSub('t3', 'Fields for this render'),
                    ceInline(CE_T.s2, [
                        (function() {
                            var sel = _ceStudioFieldSel(st);
                            var chips: any[] = [];
                            for (var fi = 0; fi < st.fields.length; fi++) {
                                (function(f: any) {
                                    var on = sel.indexOf(String(f.id)) !== -1;
                                    chips.push(ceBtn(f.name || '(untitled)', 'studio:field:' + f.id, function() {
                                        ceStudioToggleField(String(f.id)); return Promise.resolve();
                                    }, on ? 'primary' : undefined));
                                })(st.fields[fi]);
                            }
                            return chips;
                        })()
                    ]),
                    Array.isArray(st.studioFieldSel)
                        ? ceBtn('Reset to Presets\u2019 active set', 'studio:field:reset', function() {
                            ceStudioResetFieldSel(); return Promise.resolve();
                        })
                        : null
                ])
                : null,
            // [STORYIMG] OPT-IN, DEFAULT OFF, per user. Nothing is written into the
            // document until this is on, which is also what makes the feature safe against a
            // bridge older than earlier: with no toggle there is no sentinel to leave
            // unpainted. globalSettings, not the store -- it is a standing preference, the
            // same tier autoDownload sits on, not a per-render override like studioSize.
            ceSettingRow('Put it in the story',
                'The finished picture is pinned at the end of your story with a fresh line under it, ready to keep writing.',
                ceToggle(!!globalSettings.studioPlaceInStory, 'studio:instory', function() {
                    var next = !globalSettings.studioPlaceInStory;
                    globalSettings.studioPlaceInStory = next;
                    return Promise.resolve(saveImageSettings()).then(function() {
                        ceImagesPatch(function(s: any) { return { promptGen: Number(s.promptGen) || 0 }; });
                        return null;
                    });
                }, 'Put generated images in the story')),
            ceBtn(genLabel, 'studio:generate', function() { return ceStudioGenerate(); },
                isBridgeReady ? 'primary' : undefined),
            // The escape hatch, per user. Deliberately always present rather than shown only
            // when an anchor exists: the case it is FOR is the one where the store and the
            // document disagree -- a widget orphaned by a story switch, which this side
            // cannot see and cannot count.
            ceBtn('Clear images from the story', 'studio:clearstory', function() {
                return Promise.resolve(ceStoryImgClearAll()).then(function(n: number) {
                    try {
                        api.v1.ui.toast(n > 0 ? ('Cleared ' + n + ' image' + (n === 1 ? '' : 's') + ' from the story.')
                                              : 'Cleared. Your pictures are all still in the gallery.',
                            { type: 'info', autoClose: 2500 });
                    } catch (_eCl) {}
                    return null;
                });
            }, 'danger'),
            !isBridgeReady
                ? ceProse('t3',
                    'The picture itself is fetched and stored by the bridge userscript, so rendering needs it running. Writing and enhancing prompts works without it.')
                : ceProse('t3',
                    'The finished image is saved by the bridge and appears in its gallery. Clearing only removes it from the page \u2014 nothing in the gallery is deleted.')
        ]))
    ]);
}

// ======================================================================================
// -- GALLERY TAB  [CEGAL] ------------------------------------------------------
// ======================================================================================
// Every image this project has ever generated, browsable from the engine surface. This
// was the ONE piece of Images that could not be a jsx-only patch, and the index carried
// its spec as IMGGALLERY-BLOCKED until this pass; the blocker and its four pieces are
// resolved here plus bridge earlier.
//
// THE SPLIT, which is the same CE-IMG-ATTR split already proven on 26 character slots:
//   METADATA travels    -- AE_GALLERY_INDEX_REQ / AE_GALLERY_INDEX_RESP carry
//                          { uuid, prompt, storyId, createdAt }, no bytes at all.
//   PIXELS DO NOT       -- this file draws an EMPTY anchored box per record
//                          (CE_IMG_GAL|uuid) and the bridge's painter covers it. Bytes
//                          crossing a message would mean a canvas round trip, which
//                          destroys PNG metadata and webp animation (session 5 s1), and
//                          there is no IndexedDB in this sandbox to read them from anyway.
//   ACTIONS ARE ASKED FOR -- AE_GALLERY_ACTION { uuid, op } mirrors AE_CHAR_IMAGE_ACTION
//                          exactly: this file owns the confirm, the bridge owns the row.
//
// WHY DELETE DOES NOT MUTATE THE LIST HERE: the bridge re-sends the index after a delete.
// Optimistically splicing the local copy would be a MIRROR of a store this file cannot
// read, with the same silent one-directional failure the CE-IMG-ATTR entry warns about --
// a delete that failed bridge-side would leave a record visible nowhere but here.
//
// DOWNLOAD IS BRIDGE-SIDE OUTRIGHT (it needs the blob) and so is Edit (openPromptEditor
// reads the bridge's own prompt cache). Both are requests from here, not implementations.
// 'Use as prompt' is the one action that is purely local -- the prompt text is already in
// the index, so it can seed the Studio composer with no round trip.
//
// SCOPE: records are stamped with the story that generated them. The default view is THIS
// story, because a gallery that opens on 400 images from every story anyone has ever
// written is not a gallery, it is an archive. The toggle says which one is showing.
// ======================================================================================

// Ask the bridge for the index. Cheap enough to re-ask on every entry to the tab -- it is
// one IndexedDB getAll bridge-side and the answer replaces the list wholesale, so there is
// no staleness window to reason about.
function ceGalleryRequest(): Promise<any> {
    if (!isBridgeReady) {
        // Answered, not left spinning. The tab states the reason itself.
        ceImagesPatch(function() { return { galReady: true, galAsked: true, galImages: [] }; });
        return Promise.resolve();
    }
    ceImagesPatch(function() { return { galAsked: true }; });
    return broadcastToTM('AE_GALLERY_INDEX_REQ', {}).catch(function(e: any) {
        api.v1.error('[AE:jsxgallery] index request failed:', e);
        ceImagesPatch(function() { return { galReady: true }; });
        return null;
    });
}

async function ceGalleryReceive(payload: any): Promise<void> {
    ceImagesStoreInit();
    var list: any[] = [];
    try {
        var raw: any[] = (payload && payload.images) || [];
        for (var i = 0; i < raw.length; i++) {
            var r: any = raw[i];
            if (!r || !r.uuid) continue;
            list.push({
                uuid: String(r.uuid), prompt: String(r.prompt || ''),
                storyId: String(r.storyId || ''), createdAt: Number(r.createdAt) || 0
            });
        }
    } catch (e) { api.v1.error('[AE:jsxgallery] receive failed:', e); }
    // Story id from THIS side, not from the payload: the bridge's activeStoryId is a copy
    // of a value this engine sent it, and a copy can be stale (it is blank until the first
    // EVT_STORY_ID_SYNC lands). Fall back to the bridge's only if the direct read fails.
    var sid = '';
    try { sid = String(await api.v1.story.id() || ''); } catch (e2) { sid = ''; }
    if (!sid) { sid = String((payload && payload.storyId) || ''); }
    ceImagesPatch(function(s: any) {
        // A view or a confirm armed against a record that has since been deleted must not
        // survive the refresh that reported the deletion.
        var stillThere = function(id: string): boolean {
            if (!id) return false;
            for (var j = 0; j < list.length; j++) { if (list[j].uuid === id) return true; }
            return false;
        };
        return {
            galImages: list, galReady: true, galStoryId: sid,
            // [GAL-WINDOW] A refreshed list starts at one page. Keeping a wide window
            // across a Refresh would repaint every previously-shown cell at once, which is
            // the expensive half of the original crash.
            galShown: CE_GAL_PAGE,
            galView: stillThere(String(s.galView || '')) ? s.galView : '',
            galConfirm: stillThere(String(s.galConfirm || '')) ? s.galConfirm : ''
        };
    });
}

function ceGalleryAction(uuid: string, op: string): Promise<any> {
    if (!uuid) return Promise.resolve();
    if (!isBridgeReady) {
        try { api.v1.ui.toast('That needs the bridge connected.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    return broadcastToTM('AE_GALLERY_ACTION', { uuid: uuid, op: op }).catch(function(e: any) {
        api.v1.error('[AE:jsxgallery] action ' + op + ' failed:', e);
        return null;
    });
}

// The records currently in view, after the scope toggle.
function _ceGalleryScoped(st: any): any[] {
    var all: any[] = st.galImages || [];
    var sid = String(st.galStoryId || '');
    if (st.galAll || !sid) return all;
    var out: any[] = [];
    for (var i = 0; i < all.length; i++) { if (String(all[i].storyId || '') === sid) out.push(all[i]); }
    return out;
}

function _ceGalleryFind(st: any, uuid: string): any {
    var all: any[] = st.galImages || [];
    for (var i = 0; i < all.length; i++) { if (all[i].uuid === uuid) return all[i]; }
    return null;
}

// dd Mon yyyy from a ms stamp -- no locale API assumptions, same style the rest of the
// shell uses for stamps.
var CE_GAL_MONTHS: string[] = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function _ceGalleryStamp(ms: number): string {
    if (!ms) return '';
    try {
        var dte = new Date(ms);
        return dte.getDate() + ' ' + CE_GAL_MONTHS[dte.getMonth()] + ' ' + dte.getFullYear();
    } catch (e) { return ''; }
}

// -- One grid cell ---------------------------------------------------------------------
// The box is EMPTY by design: the bridge paints the image over it. A record whose bytes
// are gone therefore reads as an empty frame rather than a broken one, which is honest --
// IndexedDB is per-browser-profile while the metadata follows the account, so a record
// with no local bytes is a real state, not an error.
function _ceGalleryCell(rec: any): any {
    return h('div', {
        key: 'gal_' + rec.uuid,
        onClick: function() { ceTap('gal:open:' + rec.uuid, function() {
            ceImagesPatch(function() { return { galView: rec.uuid, galConfirm: '' }; });
        }); },
        style: {
            flex: '1 1 96px', maxWidth: '160px', cursor: 'pointer',
            display: 'flex', flexDirection: 'column', gap: CE_T.s1
        }
    },
        h('div', ceImgAnchor(CE_IMG_GAL, rec.uuid, {
            style: {
                width: '100%', height: '128px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        })),
        ceTruncate('t3', rec.prompt ? _ceTrim(rec.prompt, 40) : '(no prompt saved)')
    );
}

// -- Full view (surface swap, JSXPROFILE-NO-OVERLAY) ------------------------------------
function _ceGalleryViewScreen(st: any, back: any): any {
    var rec = _ceGalleryFind(st, String(st.galView || ''));
    if (!rec) return ceScreen(ceHeader(back), [ceEmpty('That image is no longer in the gallery.', null)]);
    var confirming = (String(st.galConfirm || '') === rec.uuid);

    var acts: any[] = [
        ceBtn('Use as prompt', 'gal:use:' + rec.uuid, function() {
            if (!rec.prompt) {
                try { api.v1.ui.toast('This image has no saved prompt.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
                return Promise.resolve();
            }
            _ceStudioSetPrompt(rec.prompt);
            ceImagesPatch(function() { return { galView: '' }; });
            ceTabSet('images', 'studio');
            try { api.v1.ui.toast('Prompt loaded into the Studio.', { type: 'success', autoClose: 2500 }); } catch (_e2) {}
            return Promise.resolve();
        }, 'primary'),
        // [IMG-EDIT-SURFACE] WAS A DEAD ROUTE. This asked the bridge to open
        // openPromptEditor, which earlier deleted -- the bridge answered with a toast
        // saying editing had moved, and it had not moved anywhere yet. It has now.
        ceBtn('Edit\u2026', 'gal:edit:' + rec.uuid, function() {
            return ceImgEditOpen(rec.uuid, { surface: 'images', entityId: '', label: 'Images' });
        }),
        ceBtn('Download', 'gal:dl:' + rec.uuid, function() { return ceGalleryAction(rec.uuid, 'download'); }),
        // DESTRUCTIVE-NEVER-IN-PLACE: this button only ever ASKS, in both states.
        ceIconBtn('Delete this image\u2026', ceIconTrash(), 'gal:delask:' + rec.uuid, function() {
            ceImagesPatch(function() { return { galConfirm: rec.uuid }; });
            return Promise.resolve();
        })
    ];

    var body: any[] = [
        h('div', ceImgAnchor(CE_IMG_GAL, rec.uuid, {
            key: 'galview_' + rec.uuid,
            style: {
                width: '100%', height: '320px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_CONTAIN)),
        ceInline(CE_T.s2, acts)
    ];

    if (confirming) {
        body.push(h('div', {
            key: 'galconf_' + rec.uuid,
            style: { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3 }
        },
            ceProse('t2',
                'Delete this image? It is removed from local storage and cannot be recovered.', { grow: true, basis: '180px' }),
            ceBtn('Delete', 'gal:del:' + rec.uuid, function() {
                return ceGalleryAction(rec.uuid, 'delete').then(function() {
                    // The list is NOT spliced here -- the bridge re-sends the index and
                    // ceGalleryReceive clears both the view and the confirm for a record
                    // that is really gone. This only leaves the dead screen.
                    ceImagesPatch(function() { return { galView: '', galConfirm: '' }; });
                    return null;
                });
            }, 'danger'),
            ceBtn('Keep', 'gal:keep:' + rec.uuid, function() {
                ceImagesPatch(function() { return { galConfirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    var stamp = _ceGalleryStamp(rec.createdAt);
    body.push(ceSection('Prompt',
        ceStack(CE_T.s2, [
            stamp ? ceSub('t3', stamp) : null,
            h('div', { style: {
                background: CE_WELL, border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
                padding: CE_T.s3
            } }, ceMono(rec.prompt || '(no prompt saved with this image)', {
                opacity: rec.prompt ? CE_OP.t1 : CE_OP.t3,
                style: { whiteSpace: 'pre-wrap', lineHeight: '1.5' }
            }))])));

    return ceScreen(ceHeader(back),
        [ceStack(CE_T.s4, body)]);
}

// -- The tab ---------------------------------------------------------------------------
function _ceImagesGalleryTab(st: any): any {
    if (!st.galReady) {
        return ceSection('Gallery', ceEmpty('Loading\u2026', null));
    }
    if (!isBridgeReady) {
        return ceSection('Gallery',
            ceStack(CE_T.s3, [
                ceProse('t3',
                    'Saved images live in the bridge userscript\u2019s local database, so browsing them needs it running. Everything else on this surface works without it.'),
                ceBtn('Try again', 'gal:retry', function() { return ceGalleryRequest(); })]));
    }

    var recs = _ceGalleryScoped(st);
    var total = (st.galImages || []).length;
    // [GAL-WINDOW] THE CAP IS APPLIED HERE, at the only place cells are minted, so there
    // is no path that builds the full list first. Math.max against the page size means a
    // store written by an older session (or by nothing at all) still shows a screenful
    // rather than none.
    var shown = Math.max(CE_GAL_PAGE, Number(st.galShown) || 0);
    var cells: any[] = [];
    for (var i = 0; i < recs.length && i < shown; i++) { cells.push(_ceGalleryCell(recs[i])); }
    var remaining = Math.max(0, recs.length - cells.length);

    var scopeLabel = st.galAll
        ? (total + ' image' + (total === 1 ? '' : 's') + ' across every story')
        : (recs.length + ' image' + (recs.length === 1 ? '' : 's') + ' in this story');

    // [earlier CEGAL-SEGMENTED, per user: "split the toggle into two different buttons so it
    // can't be clicked twice"] THE FLIP IS GONE. THERE IS NO TOGGLE HERE ANY MORE.
    //
    // The history is worth keeping because it is a ladder of three fixes to one bug, and
    // only the last one is structural:
    //   earlier CEGAL-IDEMP captured the target at render time, which made a duplicate
    //     harmless ONLY while it landed before Preact re-rendered.
    //   earlier TAP-FLIP added a per-op time guard, which stops a duplicate that lands
    //     after a re-render -- but only if it lands inside CE_TAP_FLIP_MS, a window that is
    //     still inferred rather than measured.
    //   This is the one that does not depend on timing at all.
    //
    // TWO BUTTONS, EACH SETTING AN ABSOLUTE VALUE. 'This story' writes false, 'All stories'
    // writes true. Firing either one twice is identical to firing it once, so a duplicate
    // click event -- however far apart, however the re-render lands -- CANNOT produce a
    // different result than a single one. That is idempotence by construction rather than
    // by guard, and it is why the guard is not kept here as well: a guard that can never
    // fire is a guard nobody can test.
    //
    // The two also carry SEPARATE opIds, so ceAction's busy latch is per-button. The old
    // shared 'gal:scope' meant the latch a first fire set was the same latch the second
    // fire read, which is a second way one physical tap could be seen twice.
    //
    // The active one is `primary` and the inactive one is plain: SS11 -- state is never
    // colour alone, and here the label is the state, so "This story" being lit says which
    // scope is on without needing a check glyph.
    // [GAL-WINDOW] A SCOPE CHANGE RESETS THE WINDOW. Widening to every story while a
    // window of 240 was open would paint 240 cells from a much longer list in one go, which
    // is the crash this cap exists to prevent arriving by a different door. Still absolute
    // values, so the idempotence argument below is untouched.
    var scopeBtn = function(id: string, label: string, want: boolean): any {
        return ceBtn(label, 'gal:scope:' + id, function() {
            ceImagesPatch(function() { return { galAll: want, galShown: CE_GAL_PAGE }; });
            return Promise.resolve();
        }, (st.galAll === want) ? 'primary' : undefined);
    };

    var head = ceInline(CE_T.s2, [
        ceSub('t3', scopeLabel, { grow: true, basis: '140px' }),
        scopeBtn('this', 'This story', false),
        scopeBtn('all', 'All stories', true),
        ceBtn('Refresh', 'gal:refresh', function() { return ceGalleryRequest(); })
    ]);

    var grid = cells.length
        ? ceInline(CE_T.s3, cells)
        : ceEmpty(st.galAll
            ? 'No images saved yet. Generate one from the Studio tab.'
            : 'No images for this story yet \u2014 tap \u201cAll stories\u201d to browse older ones.', null);

    // [GAL-WINDOW] ADDS ONE PAGE, never "all". A Show-everything button would be the same
    // crash one tap away, and an author who genuinely wants the whole list can press this
    // as many times as they have pages -- which is also the honest signal that the list is
    // that long. ABSOLUTE VALUE FROM THE COUNT ALREADY RENDERED, not an increment of the
    // stored number, so a duplicate tap adds one page rather than two.
    var more: any = remaining
        ? ceStack(CE_T.s1, [
            ceWrap(null, [
                ceBtn('Show ' + Math.min(CE_GAL_PAGE, remaining) + ' more', 'gal:more', function() {
                    var next = cells.length + CE_GAL_PAGE;
                    ceImagesPatch(function() { return { galShown: next }; });
                    return Promise.resolve();
                })
            ]),
            ceSub('t3', String(remaining) + ' not shown \u2014 images load a page at a time so the tab stays responsive.')
        ])
        : null;

    return ceSection('Gallery',
        ceStack(CE_T.s3, [
            head,
            ceProse('t3',
                'Tap an image to see its prompt, reuse it in the Studio, download it or delete it.'),
            grid,
            more]));
}

// -- Root ------------------------------------------------------------------------------
function _ceImagesRoot(): any {
    ceImagesStoreInit();
    var st = useStoreValue(ceImagesStore);
    var ui = useStoreValue(ceUiStore);
    // [CEGAL] Read BEFORE the early returns and BESIDE the other hooks: the tab
    // gate below decides which effect runs, so the tab value cannot be computed after a
    // conditional return without moving a hook behind one. ceTabGet is a plain store get,
    // and this component is already subscribed to ceUiStore above, so tab clicks repaint.
    var tab = ceTabGet('images', 'studio');
    useEffect(function() { cePublishImages(); }, []);
    // Asks once per entry to the tab, not once per render. galAsked is reset by nothing --
    // the Refresh button and the post-delete re-send are the other two paths in.
    useEffect(function() {
        if (tab === 'gallery' && !(st && st.galAsked)) { ceGalleryRequest(); }
    }, [tab]);

    // [NOHEADER] Same deletion as Map/Chat/Settings — Images is on the shell nav.
    // `back` stays as a name because the gallery detail and the two pickers below are NOT
    // nav destinations and still need a way out; ceBack supplies one only when a real
    // return address was set, and those screens set their own action instead.
    var back: any = ceBack();

    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    // The picker is a FULL SURFACE SWAP (JSXPROFILE-NO-OVERLAY), so it
    // replaces everything below the header rather than floating over it. Checked before
    // the tab strip renders -- while picking, the tabs are not the navigation that matters.
    if (st.picker) {
        var pickBack = ceBtn('\u2190 Studio', 'img:pick:back', function() {
            ceImagesPatch(function() { return { picker: '' }; });
            return Promise.resolve();
        });
        return _ceStudioPickerScreen(st, pickBack);
    }

    // [CEGAL] Same rule as the picker: the full image view REPLACES the surface
    // rather than floating over it (overlay sheets are not constructible here).
    if (st.galView) {
        var galBack = ceBtn('\u2190 Gallery', 'gal:back', function() {
            ceImagesPatch(function() { return { galView: '', galConfirm: '' }; });
            return Promise.resolve();
        });
        return _ceGalleryViewScreen(st, galBack);
    }

    var openMap: any = (ui && ui.open) || {};
    var confirm = String(st.confirm || '');
    var fields: any[] = st.fields || [];
    var orderedIds: string[] = [];
    var i: number;
    for (i = 0; i < fields.length; i++) { orderedIds.push(fields[i].id); }

    // [TAB-SCOPED] Studio first: it is what someone opens Images to DO, and the
    // field library is the thing it is configured with. Defaults live on Presets beside
    // the fields they compile with, and the Studio's Render row links across to them
    // rather than restating them in two places. Gallery last -- it is what the
    // other two PRODUCE, and it is the only tab that can be empty on a fresh install.
    // `tab` is read at the top of this function, beside the hooks.
    var body: any[];
    if (tab === 'presets') {
        var rows: any[] = [];
        for (i = 0; i < fields.length; i++) {
            rows.push(_ceImagesField(fields[i], i, fields.length, openMap, confirm, orderedIds));
        }
        var addBtn = ceBtn('+ Add field', 'img:add', function() {
            return ceImgOp('add', { name: 'New Field' });
        });
        body = [
            _ceImagesDefaults(st.defaults || {}),
            ceGroup('Prompt Fields (' + fields.length + ')',
                ceStack(CE_T.s1, [
                    ceProse('t3',
                        'Reusable prompt fragments. Each has a positive fragment, a negative fragment and a weight; every ACTIVE one is folded into every generation until you switch it off. Order matters \u2014 fragments compile top to bottom.'),
                    fields.length
                        ? ceStack(null, rows)
                        : ceEmpty('No prompt fields yet. Add one to start building a library.', null),
                    addBtn])),
            _ceImagesCompiled(st)
        ];
    } else if (tab === 'gallery') {
        body = [_ceImagesGalleryTab(st)];
    } else {
        body = [_ceImagesStudioTab(st)];
    }

    var activeTab = (tab === 'presets' || tab === 'gallery') ? tab : 'studio';
// [earlier TABBODY-KEY, per user report: "blank squares in the studio, duplicated in the
// gallery on return"] THE TAB BODY IS NOW A KEYED SLOT, and this is NOT a sixth attempt at
// the header ghost (v2.167-v2.172) -- it is a different failure with a different signature
// and it is reachable from here, which that one never was.
//
// THE MECHANISM. The body sat at a FIXED POSITION in ceScreen's child list with NO KEY, and
// every tab puts an h('div') there. Preact matches unkeyed children by position and type,
// so switching tabs did not unmount anything: it REUSED the same DOM subtree and diffed
// gallery cells against studio rows in place. That is invisible for engine-owned content
// (the props all get rewritten) and destructive for BRIDGE-OWNED content, because the
// bridge appends real <img> children this tree knows nothing about. CESURF-RECYCLE already
// documents the second half from the bridge's side: the recycled node keeps the foreign
// <img> while losing data-ce-img, the sweep correctly strips it, and the user is left
// looking at an empty bordered box in a tab that never had an image in it.
//
// A DISTINCT KEY PER TAB FORCES UNMOUNT/MOUNT instead of reuse, which is the whole fix:
// nothing survives the switch to be recycled, so there is nothing for a foreign child to
// ride. The wrapper carries ceScreen's own s3 gap so spacing is unchanged.
    return ceScreen(ceHeader(back), [
        _ceImagesTabRow(activeTab),
        ceStack({ gap: CE_T.s3, key: 'imgtab:' + activeTab }, body)
    ]);
}

// Same shape as the Settings tab strip. Not promoted to the kit yet: two call sites with
// identical code is the point at which extraction is arguable, not the point at which it
// is obviously right, and a third would settle it. Recorded so it is a decision rather
// than an oversight.
var CE_IMAGES_TABS: any[] = [
    { id: 'studio',  label: 'Studio' },
    { id: 'presets', label: 'Presets' },
    { id: 'gallery', label: 'Gallery' }
];
function _ceImagesTabRow(active: string): any {
    return ceTabRow('images', CE_IMAGES_TABS, active);
}


// ============================================================================
// SECTION 35b — IMAGE EDIT SURFACE (jsx)  [IMG-EDIT-SURFACE]
//
// ONE PLACE TO RE-PROMPT AN IMAGE, reachable from every card that shows one: the story
// widget, the chat photo, and the gallery's full view. Requested as a surface rather than
// a Gallery drill precisely so the two in-document cards are ONE tap from it -- routing
// them through Gallery would have been three (open Images, find the record, open it), and
// the record you want is the one you are already looking at.
//
// WHAT earlier ACTUALLY DELETED, and why this is not simply a restore. The bridge's
// openPromptEditor died with the bridge studio, and both AE_GALLERY_ACTION op:'edit' and
// AE_CHAR_IMAGE_ACTION op:'edit' were left answering with a toast that told the user
// editing had moved somewhere it had not yet arrived. The verb was never wrong; it had no
// destination. This is the destination.
//
// THE FIELDS ARE fp AND fu, NOT prompt AND uc, AND THAT IS THE DESIGN DECISION HERE.
// A stored record carries both: `prompt` is what the author typed, `fp`/`fu` are what was
// actually sent after the active preset fields, quality string and character captions were
// compiled in. Editing `prompt` would mean RE-COMPILING at regeneration time against
// TODAY'S preset fields -- so an image made six months ago would come back changed by
// edits to a field library it never used, and the user would have no way to see why.
// Editing the compiled text is what-you-see-is-what-is-sent, which is the only version of
// this that can be reasoned about. `prompt` is still shown, read-only, as provenance.
//
// REGENERATION OVERWRITES THE SAME UUID. Every surface addresses an image by uuid -- story
// anchor, chat tag, gallery cell, character slot -- so new bytes under the old key update
// all of them with nothing rewritten. See the bridge's AE_IMG_REGEN note for the full
// reasoning and for why a failed regeneration cannot lose the original.
//
// CROSS-ARTIFACT: three new messages, all added in bridge earlier in the same pass --
// AE_IMG_META_REQ/AE_IMG_META_RESP (one record's editable fields, deliberately absent from
// the gallery index because that is sent for every image at once) and AE_IMG_REGEN /
// AE_IMG_REGEN_DONE. AE_IMG_EDIT_OPEN travels the other way: the bridge's card corners ask
// THIS side to open, because only this side owns navigation.
// ============================================================================

// Live typing, module-level, same STUDIO-DRAFTS contract as the composer: the store holds
// the authoritative text and these hold what is in the box right now. Both handlers are
// set on every field -- ceField.commit() calls onCommit unguarded and a field with only
// onType throws on blur.
var _ceImgEditFpDraft: string = '';
var _ceImgEditFuDraft: string = '';

// Open the surface for one uuid. Called by the gallery's Edit button and by the bridge's
// AE_IMG_EDIT_OPEN. Navigates FIRST and asks second, so the surface is on screen in its
// loading state rather than after a round trip that may never answer.
//
// [earlier IMGEDIT-DOOR, per user: "the edit image button in the top right corner of
// images ... does not open a prompt editing/regenerating menu"] IT NAVIGATED WITHOUT
// OPENING THE DOOR, and that is fatal for exactly one of the two callers.
//
// ceNav sets a VALUE on ceUiStore. Something has to be MOUNTED and subscribed for a value
// to become a screen, and that is ceOpenShell's job -- the shell modal is the only mount
// point in this file. The gallery's Edit button is fine either way because the shell is
// already open when you press it. THE BRIDGE'S CARD CORNERS ARE THE OPPOSITE CASE BY
// CONSTRUCTION: the whole reason those corners exist is to edit the picture you are
// looking at IN THE STORY, which means the shell is closed, which means the surface this
// navigated to had nothing rendering it. The tap was received, the state was correct, and
// nothing appeared -- the worst shape a bug can have.
//
// ceOpenShell IS THE RIGHT CALL RATHER THAN A SECOND modal.open: it initialises every
// store first (this route can be entered COLD, from a page where no surface has ever been
// opened, so ceImagesStore may not exist yet), it is idempotent when the shell is already
// up (`if (_ceSceneHandle) return`), and it navigates on the way through.
//
// `back` IS RE-APPLIED AFTER, not passed through: ceOpenShell's internal ceNav takes no
// back address and NAV-BACK's clearing rule means it wipes the previous one. Setting it
// afterwards is the only order that leaves Back pointing where this function promised.
async function ceImgEditOpen(uuid: string, back?: any): Promise<any> {
    var want = String(uuid || '');
    if (!want) return Promise.resolve();
    ceImagesStoreInit();
    _ceImgEditFpDraft = '';
    _ceImgEditFuDraft = '';
    ceImagesPatch(function(s: any) {
        // [IMGEDIT-DOOR] galView/galConfirm CLEARED HERE, and this is the second
        // reported symptom rather than tidiness. The gallery's full view is a sub-screen of
        // the Images surface gated on galView, and nothing was clearing it -- so Back from
        // here landed on the Images surface and found galView still holding the record you
        // had just left, re-rendering the full view (and its own anchored box) instead of
        // the grid the Back label promised. Reported as "its blank image space is left in
        // the gallery after backing to it"; it is not a ghost node, it is state outliving
        // its screen. Same clearing discipline ceNav already applies to sheet/picker/photo.
        // edBusy is reset for the same reason: a regeneration abandoned by navigating away
        // would otherwise leave the next record's Regenerate button reading "Rendering...".
        return { edUuid: want, edReady: false, edFound: false, edPrompt: '', edFp: '', edFu: '',
                 edMeta: null, edBusy: false, galView: '', galConfirm: '',
                 edGen: Number(s.edGen || 0) + 1 };
    });

    var backTo: any = back || { surface: 'images', entityId: '', label: 'Images' };
    try { await ceOpenShell('imgedit', want); }
    catch (eOpen) { api.v1.error('[AE:imgedit] shell open failed:', eOpen); }
    try { ceUiPatch(function() { return { back: backTo }; }); }
    catch (eBack) { api.v1.error('[AE:imgedit] back address failed:', eBack); }

    if (!isBridgeReady) {
        // Answered, not left spinning -- same rule ceGalleryRequest follows.
        ceImagesPatch(function() { return { edReady: true, edFound: false }; });
        return Promise.resolve();
    }
    return broadcastToTM('AE_IMG_META_REQ', { uuid: want }).catch(function(e: any) {
        api.v1.error('[AE:imgedit] meta request failed:', e);
        ceImagesPatch(function() { return { edReady: true, edFound: false }; });
        return null;
    });
}

// The bridge's answer. IGNORED WHEN IT IS FOR A DIFFERENT UUID than the one now open --
// two opens in quick succession would otherwise let the first answer overwrite the second.
function ceImgEditReceive(payload: any): void {
    ceImagesStoreInit();
    var uuid = String((payload && payload.uuid) || '');
    if (!uuid) return;
    ceImagesPatch(function(s: any) {
        if (String(s.edUuid || '') !== uuid) return {};
        if (!(payload && payload.found)) return { edReady: true, edFound: false };
        var fp = String(payload.fp || '');
        var fu = String(payload.fu || '');
        _ceImgEditFpDraft = fp;
        _ceImgEditFuDraft = fu;
        return {
            edReady: true, edFound: true,
            edPrompt: String(payload.prompt || ''), edFp: fp, edFu: fu,
            edMeta: { chars: payload.chars || [], settings: payload.settings || {},
                      storyId: String(payload.storyId || ''), createdAt: Number(payload.createdAt) || 0 },
            edGen: Number(s.edGen || 0) + 1
        };
    });
}

// Regeneration finished (or failed). The BYTES are already in place bridge-side and every
// painted card has been forced to repaint from there, so there is nothing to fetch -- this
// only releases the busy state and re-reads the record, since fp/fu are now whatever was
// actually sent.
function ceImgEditRegenDone(payload: any): void {
    ceImagesStoreInit();
    var uuid = String((payload && payload.uuid) || '');
    ceImagesPatch(function(s: any) {
        if (String(s.edUuid || '') !== uuid) return {};
        return { edBusy: false };
    });
}

function ceImgEditRegen(): Promise<any> {
    var st: any = null;
    try { st = ceImagesStore ? ceImagesStore.get() : null; } catch (e) { st = null; }
    if (!st || !st.edUuid) return Promise.resolve();
    var fp = String(_ceImgEditFpDraft || '').trim();
    if (!fp) {
        try { api.v1.ui.toast('The prompt is empty \u2014 nothing to render.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
        return Promise.resolve();
    }
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Regenerating needs the bridge connected.', { type: 'warning', autoClose: 3000 }); } catch (_e2) {}
        return Promise.resolve();
    }
    ceImagesPatch(function() { return { edBusy: true }; });
    return broadcastToTM('AE_IMG_REGEN', {
        uuid: String(st.edUuid), fp: fp, fu: String(_ceImgEditFuDraft || '').trim(),
        prompt: String(st.edPrompt || '')
    }).then(function() {
        try { api.v1.ui.toast('Regenerating \u2014 the picture updates in place when it lands.',
                              { type: 'info', autoClose: 3000 }); } catch (_e3) {}
        return null;
    }).catch(function(e: any) {
        api.v1.error('[AE:imgedit] regen failed:', e);
        ceImagesPatch(function() { return { edBusy: false }; });
        return null;
    });
}

function _ceImgEditRoot(): any {
    ceImagesStoreInit();
    var st = useStoreValue(ceImagesStore);
    var ui = useStoreValue(ceUiStore);
    var back: any = ceBack();

    // The uuid on the ROUTE wins over the one in the store: ceNav wrote it, and a store
    // still holding the previous record for one paint must not render as if that record
    // were this one.
    var uuid = String((ui && ui.entityId) || (st && st.edUuid) || '');
    if (!uuid) return ceScreen(ceHeader(back), [ceEmpty('No image selected.', null)]);
    if (!st || !st.edReady || String(st.edUuid || '') !== uuid) {
        return ceScreen(ceHeader(back), [ceEmpty('Loading image\u2026', null)]);
    }
    if (!st.edFound) {
        return ceScreen(ceHeader(back), [
            ceEmpty('That image is not in local storage. Records follow your account, but the '
                  + 'pictures themselves live in this browser only \u2014 it was probably generated '
                  + 'somewhere else.', null)
        ]);
    }

    var busy = !!st.edBusy;
    var meta: any = st.edMeta || {};
    var chars: any[] = meta.chars || [];
    var stamp = _ceGalleryStamp(Number(meta.createdAt) || 0);
    // [IMG-SEED] Now a real number on every engine-dispatched image: the seed is
    // minted at dispatch (_ceImgSeed) instead of inside the bridge's request builder, which
    // randomised a missing one locally and never wrote it back, so the record stored the
    // settings as SENT and the actual number was unrecoverable.
    var edSeed = Number(meta.settings && meta.settings.seed) || 0;

    var body: any[] = [
        // The same anchored box the gallery's full view uses, so the bridge paints it with
        // no new anchor form -- and after a regeneration the forced repaint bridge-side
        // swaps the picture under it with nothing asked of this file.
        h('div', ceImgAnchor(CE_IMG_GAL, uuid, {
            key: 'edview:' + uuid,
            style: {
                width: '100%', height: '280px', borderRadius: CE_T.r,
                background: CE_FILL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_CONTAIN)),

        ceGroup('Seed', ceSub('t2', edSeed > 0 ? String(edSeed) : 'not recorded for this image')),

        ceGroup('Prompt', ceStack(CE_T.s2, [
            ceProse('t3',
                'This is the prompt exactly as it was sent \u2014 preset fields, quality settings and '
              + 'character captions already compiled in. Editing it here changes what is sent and '
              + 'nothing else; your field library is not consulted again.'),
            h(ceField, {
                seed: 'imgedit:fp:' + uuid + ':' + String(st.edGen || 0),
                k: 'imgedit:fp', label: '', value: String(st.edFp || ''),
                multiline: true, rows: 5, well: true,
                placeholder: 'What the image should show',
                onType: function(v: string) { _ceImgEditFpDraft = v; },
                onCommit: function(v: string) { _ceImgEditFpDraft = v; return Promise.resolve(); }
            }),
            h(ceField, {
                seed: 'imgedit:fu:' + uuid + ':' + String(st.edGen || 0),
                k: 'imgedit:fu', label: 'Unwanted Content', value: String(st.edFu || ''),
                multiline: true, rows: 3, well: true,
                placeholder: 'What it should not show',
                onType: function(v: string) { _ceImgEditFuDraft = v; },
                onCommit: function(v: string) { _ceImgEditFuDraft = v; return Promise.resolve(); }
            })
        ])),

        ceGroup('Regenerate', ceStack(CE_T.s2, [
            ceProse('t3',
                'The new picture REPLACES this one everywhere it appears \u2014 in the story, in any '
              + 'chat that showed it, and in the gallery \u2014 because they all point at the same '
              + 'record. A new seed is used, so the same prompt gives a different image. If the '
              + 'render fails, the picture you have now is untouched.'),
            ceInline(CE_T.s2, [
                ceBtn(busy ? 'Rendering\u2026' : (isBridgeReady ? 'Regenerate' : 'Regenerate (needs bridge)'),
                      'imgedit:regen:' + uuid,
                      function() { return busy ? Promise.resolve() : ceImgEditRegen(); }, 'primary'),
                ceBtn('Use as new prompt', 'imgedit:use:' + uuid, function() {
                    _ceStudioSetPrompt(String(_ceImgEditFpDraft || st.edFp || ''));
                    ceNav('images');
                    ceTabSet('images', 'studio');
                    try { api.v1.ui.toast('Loaded into the Studio as a new image.', { type: 'success', autoClose: 2500 }); } catch (_e) {}
                    return Promise.resolve();
                }),
                ceBtn('Download', 'imgedit:dl:' + uuid, function() { return ceGalleryAction(uuid, 'download'); })
            ])
        ]))
    ];

    // Provenance, last and quiet: what this image was BEFORE the preset compile, who was in
    // it, and when. Read-only on purpose -- rewriting the original prompt would make the
    // record disagree with the pixels it is stamped on.
    var prov: any[] = [];
    if (st.edPrompt) {
        prov.push(ceProse('t3', 'Originally described as: ' + _ceTrim(String(st.edPrompt), 300), { key: 'prov_p' }));
    }
    if (chars.length) {
        var names: string[] = [];
        for (var ci = 0; ci < chars.length; ci++) {
            names.push(String((chars[ci] && (chars[ci].name || chars[ci].id)) || 'someone'));
        }
        prov.push(ceSub('t3', 'Characters: ' + names.join(', '), { key: 'prov_c' }));
    }
    if (stamp) {
        prov.push(ceSub('t3', 'Generated ' + stamp, { key: 'prov_s' }));
    }
    if (prov.length) {
        body.push(ceGroup('About this image', ceStack(CE_T.s1, prov)));
    }

    return ceScreen(ceHeader(back), body);
}


// ============================================================================
// SECTION 36 — ENTITY SURFACE (jsx)
// One surface for creating AND editing an entity.
//
// IT HANGS OFF MAP AS PROFILE HANGS OFF SCENE: a ceUiStore.surface value ('entity') plus
// ceUiStore.entityId, routed in ceRoot and deliberately ABSENT from CE_SHELL_ROUTES. The
// nav names places you can go, and "the thing I just tapped" is not one. The way back is
// ceUiStore.back, set by whoever navigated here; one deep is all NAV-BACK promises and all
// this needs, because the Contents list also renders the parent as a row.
//
// ITS OWN STORE, on the JSXKIT-STORE-SPLIT rule (change frequency, not feature): a field
// commit here would otherwise repaint the Map's whole packed-circle SVG on every blur.
// cePublishEntity is the only writer.
//
// ONE WRITE PATH, ceEntityWrite, SERIALISED (ceEntityOp). Entity storage is
// load-modify-save with no compare-and-swap and this surface has more simultaneously
// editable fields than any other -- two blurs landing close together would discard one.
//
// THE TYPE SWITCH IS ceSelect, NOT A PICKER. Four fixed kinds is the closed enum SS8
// reserves ceSelect for. References (parentId, narrativeParentId, connection targets) all
// name something the world already knows about, so all three are CE_PICKER_DEFS entries.
//
// [ANCHOR-FORMAT] A LOCATION IMAGE SLOT WAS ONCE CALLED IMPOSSIBLE ENGINE-SIDE, reasoned
// from the anchor FORMAT ('<charId>|<slot>') instead of from the bridge's actual resolver,
// which never looks the id up as a character. A location is just another id. Kept because
// the error shape recurs: read the consumer, not the naming.
// ============================================================================

var CE_ENTITY_TYPES: any[] = [
    { id: 'location',  label: 'Location' },
    { id: 'item',      label: 'Item' },
    { id: 'narrative', label: 'Narrative' },
    // [F-32] Species joins the list a record can be RETYPED to. 'faction' is deliberately
    // still absent -- retyping into one would leave it with no standing def until the next
    // ceSyncStandingDefs, and this select has no hook to run one. A species has no such
    // sidecar: migrateEntity normalises speciesList on the way in and sweeps it on the way
    // out, which is the whole of what changing type costs here.
    { id: 'species',   label: 'Species' },
    { id: 'character', label: 'Character' }
];
// [F-29] THE FACTION STRIP ON THE ENTITY SURFACE. Profile leads because it is what a
// faction IS; the other three are who stands with it, where those rungs are, and what it
// holds. ceTabRow under the 'entity' scope -- ceTabSet namespaces by surface, so a stale
// 'entity:standing' cannot reach Settings and a stale 'settings:states' cannot reach here.
// ONLY A FACTION EVER SEES THIS. Every other type resolves to 'profile' and renders exactly
// what it rendered before the strip existed.
var CE_FACTION_TABS: any[] = [
    { id: 'profile',   label: 'Profile' },
    { id: 'roster',    label: 'Roster' },
    { id: 'standing',  label: 'Standing' },
    { id: 'resources', label: 'Resources' }
];
// [MS-TAB] The same arrangement F-29 gave a faction, for the same reason: the milestone
// and its archive are CONTENT THAT STAYS rather than a door that leaves, so they partition
// the body instead of becoming a launcher. Two tabs, not three -- the thread's context
// selection belongs beside the questions it feeds, not behind a tab of its own.
var CE_THREAD_TABS: any[] = [
    { id: 'profile',    label: 'Profile' },
    { id: 'milestones', label: 'Milestones' }
];
var CE_ENTITY_STORY_STATES: any[] = [
    { id: 'locked',    label: 'Locked' },
    { id: 'active',    label: 'Active' },
    { id: 'completed', label: 'Done' }
];

// -- Store, publish, op-chain -------------------------------------------------
// [STORE-BEFORE-HOOK] imgSlots/imgTags/imgAddGen are seeded in the INITIAL shape below, not
// only on first publish: the species image drill is subscribed from its first render, and a
// list reading undefined off a subscribed store is a blank surface with no console line.
var ceEntityStore: any = null;
var _ceEntChain: Promise<any> = Promise.resolve();
// The lorebook-key composer draft. Module var, read by a button — CLICK-BEFORE-BLUR.
var _ceEntKeyDraft = '';

// ======================================================================================
// -- FACTION SURFACE  [F-23] -----------------------------------------------------------
// A faction's own screen. A DETAIL VIEW REACHED FROM SETTINGS, not a shell route -- the
// same arrangement Entity has (a surface VALUE with an entityId, absent from
// CE_SHELL_ROUTES), and for the same reason: you arrive at a faction from the list of
// factions, never from the tray.
//
// WHAT IT IS FOR: the thing AE called a Holding, which was never really a holding -- it was
// a faction with resources, a roster and a journal. Here it is simply the profile pattern
// pointed at a faction, and almost none of it is new code. Resources are faction-scoped
// StateDefs, which have had storage, verbs and a scope enum since F-07 and lacked only a
// door; this is that door.
//
// THE ROSTER IS NOT HERE YET AND THE ABSENCE IS DELIBERATE. It derives from characters'
// standing, and standing is the char-scoped def F-22 settled and has not built. A roster
// rendered off relationshipStates would be a roster of nobody, which is exactly the class
// of surface F-20 and F-22 have spent two versions removing.
// ======================================================================================

// [F-29] ceFactionStore, ceFactionStoreInit AND cePublishFaction ARE DELETED. They were a
// SECOND store publishing a SECOND projection of one record, feeding a screen whose Overview
// tab was a name, a description and a button reading "Open profile" -- an entire surface
// standing between the author and the profile they were trying to reach. Author-reported as
// a duplicate profile, and it was one: the migration that made a faction an EntityRecord
// (F-28) made the entity surface the profile, and this screen never retired itself.
//   WHAT SURVIVED THE DELETION AND WHY: the three panels below (_ceFactionRoster,
//   _ceFactionStanding, _ceFactionStates) are the only things that screen had which the
//   entity surface did not. They are now tabs on the entity surface, reading the entity
//   store's own faction projection -- built in cePublishEntity, gated on type, so a location
//   never pays for a roster it cannot have.
//   THE ROSTER DERIVATION MOVED BYTE-FOR-BYTE, restBand read from the def and both sorts
//   intact. It was correct where it was; the only thing wrong with it was which store it
//   wrote to.

// [F-29] READS THE ENTITY STORE NOW. `facRows`/`facHasDefs` rather than `rows`/`hasDefs`:
// the entity store already owns `rows` for something else, and a slot whose meaning depends
// on which surface is mounted is the ambiguity the two-store arrangement was hiding.
function _ceFactionStates(fid: string, st: any): any {
    var rows: any[] = st.facRows || [];
    if (!rows.length) {
        return ceStack(CE_T.s3, [
            ceProse('t2', st.facHasDefs
                ? 'No state in this world is scoped to a faction. A faction\u2019s own resources '
                  + '\u2014 its treasury, its unrest, how many boats it still has \u2014 are states '
                  + 'defined once with the Faction scope, then held per faction.'
                : 'No states exist in this world yet. A state is a bounded number with words '
                  + 'attached. Define one with the Faction scope and it becomes this faction\u2019s '
                  + 'to hold.'),
            ceBtn('Open States settings', 'fac:tosettings:' + fid, function() {
                // [F-29] THE RETURN ADDRESS CARRIES ITS TAB, so Settings' Back lands on
                // Resources rather than on the faction's Profile. ceBack forwards it.
                ceNav('settings', '', 'settings:states',
                      { surface: 'entity', entityId: fid, tab: 'entity:resources',
                        label: 'Faction' });
                return Promise.resolve();
            }, 'primary')
        ]);
    }
    // [I-05] THE ROW RENDERER IS LITERALLY THE CHARACTER DRILL'S NOW. It used to be a COPY of
    // it, under a comment warning that two renderers for one row shape is how two surfaces come
    // to disagree about what a resting band looks like -- which it then was. ceStateGaugeRow is
    // the shared one; only the address stays here, because a faction value lives in a bucket
    // and a character value lives on a record.
    var mkRow = (function(r: any) {
        var did = String(r.defId);
        var refOf = function(): StateRef {
            return { scope: 'faction', ownerId: fid, defId: did };
        };
        var commit = function(): Promise<any> { return cePublishEntity(fid); };
        return ceStateGaugeRow(r, 'facst:' + fid,
            function(_d: string, n: number) { return stateSet(refOf(), n).then(commit); },
            function(_d: string, d: number) { return stateNudge(refOf(), d).then(commit); });
    });
    // [G-02] Same split, same reason, same footer -- see the profile drill.
    var split = ceStateSplitHidden(rows);
    var groups = ceStateGrouped(split.shown, st.cfg || null);
    var body: any[] = [];
    for (var gi = 0; gi < groups.length; gi++) {
        (function(grp: any) {
            var kids: any[] = [];
            for (var i = 0; i < grp.rows.length; i++) kids.push(mkRow(grp.rows[i]));
            body.push(ceGroup(grp.category
                ? (grp.category + ' (' + grp.rows.length + ')')
                : ('Resources (' + grp.rows.length + ')'), ceGaugeGrid(kids)));
        })(groups[gi]);
    }
    var blankFoot: any = _ceStateBlankFooter(split.blank, 'facst:' + fid);
    if (blankFoot) body.push(blankFoot);
    return ceStack(CE_T.s3, body);
}

// ======================================================================================
// -- DIPLOMACY SURFACE  [F-26] ---------------------------------------------------------
// THE DOOR TO FACTIONS, AND A SHELL ROUTE. One nav entry, one ceRoot branch -- the whole
// cost CE_SHELL_ROUTES advertises. It replaces the Settings > Factions tab entirely, which
// is deleted: that tab only ever created, renamed and deleted factions, and burying the
// list of who exists in this world under Settings put the map of the story's politics in
// the same drawer as the token budget.
//
// WHAT IT SHOWS: every faction, where the protagonist stands with each, and which one (if
// any) is ours. BOTH PROTAGONISTS ARE OPTIONAL and the surface is built to be honest about
// that rather than to hide it -- a story with no protagonist character still lists its
// factions, it just cannot say who stands where.
// [FAC-TREE] AND IT SHOWS THEM NESTED. Factions carry parentId like every other entity;
// this is the list that draws it, so a company and its departments read as one indented run
// instead of as unrelated names in whatever order the index happened to hold. The nesting is
// PRESENTATIONAL: standing is per-faction and does NOT inherit down the tree. A department
// is its own ceStandingDefId and a protagonist hostile to the parent company starts neutral
// with its accounts office, which is the honest default -- inheritance is a rule about
// fiction, not about storage, and nothing here should invent one on the author's behalf.
// ======================================================================================

var ceDiploStore: any = null;

function ceDiploStoreInit(): void {
    if (ceDiploStore) return;
    try {
        ceDiploStore = createStore({ ready: false, rows: [], ourId: '', protagName: '', confirm: '' });
    } catch (e) { api.v1.error('[AE:diplo] store init failed:', e); }
}

function ceDiploPatch(fn: (s: any) => any): void {
    if (!ceDiploStore) return;
    try {
        ceDiploStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:diplo] patch failed:', e); }
}

async function cePublishDiplo(): Promise<void> {
    ceDiploStoreInit();
    if (!ceDiploStore) return;
    try {
        var cfg = await loadConfig();
        var pid = String((cfg as any).protagonistCharId || '');
        var protag: any = pid ? await loadCharacter(pid) : null;
        // [F-28] METAS, NOT RECORDS. The list needs a name and an id per faction and nothing
        // else -- the same reason the map draws from the index: a world of thirty factions
        // would otherwise be thirty storage reads to paint one screen. `own` went with it,
        // because knowing a faction overrides the ladder needs the full record and the
        // Diplomacy list never showed it.
        var facs: any[] = await ceFactionMetas();
        var rows: any[] = [];
        for (var i = 0; i < facs.length; i++) {
            var fac: any = facs[i];
            if (!fac || !fac.id) continue;
            var fid = String(fac.id);
            // [FAC-TREE] parentId RIDES THE ROW. It is already on the meta this loop is
            // walking, so the tree costs no extra read -- the same argument [F-28] made for
            // reading metas rather than records here in the first place.
            var row: any = { id: fid, name: String(fac.name || 'Unnamed faction'), standing: '',
                             parentId: fac.parentId ? String(fac.parentId) : '' };
            // THE STANDING IS READ THROUGH THE DEF, NOT THE LADDER. The ladder is words; the
            // def is what the protagonist actually holds, and reading the ladder here would
            // report where somebody COULD stand rather than where they DO.
            if (protag) {
                var def = ceStateDef(cfg, ceStandingDefId(fid));
                if (def) {
                    var sv: any = (protag as any).stateValues || {};
                    var rawV = (sv[def.id] === undefined) ? ceStateStart(def) : sv[def.id];
                    var band = ceStateBand(def, ceStateClamp(def, rawV));
                    row.standing = String(band.label || '');
                }
            }
            rows.push(row);
        }
        ceDiploPatch(function(s: any) {
            return { ready: true, rows: rows, ourId: String((cfg as any).protagonistFactionId || ''),
                     order: ceOrderList(cfg, 'faction'),
                     protagName: protag ? String((protag as any).name || '') : '' };
        });
    } catch (e) { api.v1.error('[AE:diplo] publish failed:', e); }
}

// [FAC-TREE] FACTIONS NEST, AND THEY NEST ON parentId RATHER THAN ON AN AXIS OF THEIR
// OWN. The record already has the field, the picker already offers it, and the map already
// cannot see the result: ceMapBuildTree filters `m.type !== 'location'` before it packs
// anything, so a faction with a parent has always been invisible there. What was missing
// was a list that draws the relation, not a place to store it.
//
// WHY NOT A SECOND AXIS. narrativeParentId exists because a plot genuinely needs BOTH a
// physical seat and a place in a plot tree. A faction was offered the same deal and did not
// take it: one parent is enough, and the cost of the choice is stated rather than hidden --
// a faction may be a subsidiary of another faction OR headquartered in a place, not both.
// A THIRD FIELD IS THE PRICE OF BOTH, and it is not worth paying until somebody wants both.
//
// ONLY faction -> faction NESTS HERE. A faction parented to a LOCATION is a headquarters,
// not a subsidiary, and it renders as a root -- which is honest rather than lossy: this
// list is the org chart, and a place is not a rung on it. That also means the two uses of
// the one field never fight, because each surface reads the half it is about.
//
// CYCLE-GUARDED, AND NOT DEFENSIVELY. The world graph PERMITS cycles at rest -- ceMapWouldCycle
// blocks them at the picker and nowhere else -- and _ceTravelChain's own header states what an
// unguarded walk over it costs: it hangs a render rather than misdrawing one row, which is the
// worse of the two failures by a distance. A node whose ancestry loops is emitted as a root.
//
// DEPTH-FIRST, SOURCE ORDER PRESERVED WITHIN EACH SIBLING SET. That is what "grouped
// together" means here: a parent is immediately followed by its own children, so a company
// and its departments are one unbroken run of rows rather than two lookups.
// [REC-ORDER] `order` SORTS EACH SIBLING SET, not the flat list. Sorting a subset by its
// index in one global sequence preserves the authored relative order, so a faction moved
// above its sibling stays above it wherever that pair appears -- and there is no per-parent
// array to keep.
function _ceDiploTree(rows: any[], order?: string[]): any[] {
    var ord: string[] = order || [];
    var byId: any = {};
    var i = 0;
    for (i = 0; i < (rows || []).length; i++) {
        if (rows[i] && rows[i].id) byId[String(rows[i].id)] = rows[i];
    }
    // The effective parent: present in THIS set (so faction-only), not self, not looping.
    var parentOf = function(r: any): string {
        var pid = String((r && r.parentId) || '');
        if (!pid || pid === String(r.id) || !byId[pid]) return '';
        var seen: any = {};
        var cur = pid;
        var hops = 0;
        while (cur && byId[cur] && hops < 512) {
            if (cur === String(r.id) || seen[cur]) return '';
            seen[cur] = true;
            cur = String(byId[cur].parentId || '');
            hops++;
        }
        return pid;
    };
    var kidsOf: any = {};
    var roots: any[] = [];
    for (i = 0; i < (rows || []).length; i++) {
        var r: any = rows[i];
        if (!r || !r.id) continue;
        var par = parentOf(r);
        if (!par) { roots.push(r); continue; }
        if (!kidsOf[par]) kidsOf[par] = [];
        kidsOf[par].push(r);
    }
    var idOf = function(r: any) { return String((r && r.id) || ''); };
    roots = ceOrderApply(roots, ord, idOf);
    var out: any[] = [];
    // ITERATIVE, NOT RECURSIVE. A world with a deep org chart would otherwise put its own
    // depth on the JS stack, and this runs inside a render.
    var stack: any[] = [];
    for (i = roots.length - 1; i >= 0; i--) stack.push({ row: roots[i], depth: 0 });
    var guard = 0;
    while (stack.length && guard < 4096) {
        guard++;
        var top: any = stack.pop();
        // `sibs` rides the emitted node so the surface can offer up/down without walking the
        // tree a second time to work out who a row's neighbours are.
        out.push({ row: top.row, depth: top.depth, sibs: top.sibs || [] });
        var kids: any[] = ceOrderApply(kidsOf[String(top.row.id)] || [], ord, idOf);
        for (var k = kids.length - 1; k >= 0; k--) {
            stack.push({ row: kids[k], depth: top.depth + 1, sibs: kids });
        }
    }
    // The roots are each other's siblings; the loop above could not know that when it pushed.
    for (i = 0; i < out.length; i++) {
        if (out[i].depth === 0) out[i].sibs = roots;
    }
    return out;
}

function _ceDiploRoot(): any {
    ceDiploStoreInit();
    useStoreValue(ceUiStore);
    var st: any = useStoreValue(ceDiploStore);

    useEffect(function() { cePublishDiplo(); }, []);

    if (!st || !st.ready) {
        return ceScreen(null, ceEmpty('Loading\u2026', null));
    }
    var rows: any[] = st.rows || [];
    var confirm = String(st.confirm || '');

    // [SELECT-LENGTH][CE-STYLE 8c] THE EXPLANATION IS ITS OWN ROW AND THE CONTROL CARRIES
    // ONLY THE VALUE. Both halves of the live report have one cause: a <select> is as wide as
    // its longest option, the longest option was the explanatory 'Nobody -- we have no side',
    // and that left the row's only flexible cell nothing to render the hint in. Replacing the
    // control with a picker fixes the width, moves the sentence out of the control, and
    // answers SS13's open-vs-closed test at the same time -- 22 factions read off records is
    // an open list, which is the picker's job and never was ceSelect's.
    // NOT A CONTROL ON EACH FACTION ROW, which was the other suggestion and is the one thing
    // that cannot be done here: those rows are ceTapRow, the whole row IS the button to the
    // faction, and SS8 is explicit that ceTap is never nested. A second target inside one
    // would be two hit areas on one element. The marker stays -- the row still reads
    // "· ours" -- so which one is ours is visible in the list without a control in it.
    var ourName = '';
    for (var oi = 0; oi < rows.length; oi++) {
        if (String(rows[oi].id) === String(st.ourId || '')) { ourName = String(rows[oi].name || ''); break; }
    }
    var ourSection = ceSection('Our faction', ceStack(CE_T.s2, [
        ceSub('t3', 'Optional. Naming one lets a Move be framed as our faction against '
            + 'another; leaving it empty is a story where the protagonist answers to nobody.'),
        ceBtn(ourName || 'Nobody', 'diplo:our', function() {
            cePickerOpen('ourFaction', { rows: rows, ourId: String(st.ourId || '') });
            return Promise.resolve();
        })
    ]));

    // [FAC-TREE] DRAWN AS A TREE, AND [F-26]'s RULING IS INTACT: the depth reaches
    // ceSettingRow's lead slot, which is whitespace, not a second tap target inside a row
    // that is itself the button.
    // NO RAIL, ONLY SPACE. SS6.3 spends the left border on PRESSURE, and a hierarchy rail
    // here would be the one place in the file where that stripe means something else.
    // [REC-ORDER] THE WHOLE TYPE IS THE WRITTEN SEQUENCE, not the visible subset. `flatIds`
    // is every faction in the order now in force, depth-first, and that is what a swap
    // rewrites -- so a move inside one branch cannot silently drop the branches above it.
    var arrScope = 'diplo';
    var arrOn = ceArrangeIs(arrScope);
    var facKids: any[] = [];
    var treeRows: any[] = _ceDiploTree(rows, (st.order || []));
    var flatIds: string[] = treeRows.map(function(t: any) { return String(t.row.id); });
    for (var i = 0; i < treeRows.length; i++) {
        (function(r: any, depth: number, sibs: any[]) {
            var isOurs = (String(st.ourId || '') === r.id);
            // [F-27] THE ROW IS THE BUTTON, and the description is NOT here. A truncated
            // description is a sentence cut at 80 characters that tells an author less than
            // the standing does and costs the row a line to say it -- the faction's own
            // screen is where its description belongs, in full, in a field they can edit.
            // What a diplomacy list is FOR is where everyone stands.
            var hint = st.protagName
                ? (r.standing
                    ? (String(st.protagName) + ' ' + r.standing + '.')
                    : (String(st.protagName) + ' has no standing here yet.'))
                : 'No protagonist set, so nobody has a standing to show.';
            // [F-29] STRAIGHT TO THE PROFILE. This row used to open a screen whose main
            // control was a button to the profile; the intermediate screen is deleted and the
            // three panels it owned are tabs here. Diplomacy is a shell route, so the way
            // back is the nav bar and the address is only for the delete path's return.
            if (arrOn) {
                // Position among SIBLINGS, not among all rows: a faction at the top of its
                // branch has nowhere up to go even with twenty rows above it on screen.
                var si = -1;
                for (var s = 0; s < sibs.length; s++) {
                    if (String(sibs[s].id) === String(r.id)) { si = s; break; }
                }
                facKids.push(ceArrangeRow('diplo:arr:' + r.id,
                    r.name + (isOurs ? ' \u00b7 ours' : ''), hint, depth,
                    si > 0, si >= 0 && si < sibs.length - 1,
                    function() {
                        return ceOrderSwap('faction', flatIds,
                                           String(r.id), String(sibs[si - 1].id))
                            .then(cePublishDiplo);
                    },
                    function() {
                        return ceOrderSwap('faction', flatIds,
                                           String(r.id), String(sibs[si + 1].id))
                            .then(cePublishDiplo);
                    }));
                return;
            }
            facKids.push(ceTapRow('diplo:row:' + r.id,
                r.name + (isOurs ? ' \u00b7 ours' : ''), hint, 'diplo:go:' + r.id, function() {
                    ceNav('entity', r.id, '',
                          { surface: 'diplomacy', entityId: '', label: 'Diplomacy' });
                }, depth));
        })(treeRows[i].row, treeRows[i].depth, treeRows[i].sibs || []);
    }

    // [F-28] A NEW FACTION IS A NEW ENTITY. The 'fac_' id prefix is kept even though the
    // record type now says what it is: existing stories address factions by these ids in
    // three storage records, and a new one that looked different would be the only faction
    // an author could not tell apart in a storage dump.
    var addBtn = ceBtn('+ Add faction', 'diplo:add', function() {
        return ceEntityOp(function() {
            var rec: any = {
                id: 'fac_' + Date.now(), name: 'New Faction', type: 'faction',
                parentId: null, description: '', connectedEntityIds: [],
                customFieldValues: {}, lorebookTags: [],
                createdAt: Date.now(), updatedAt: Date.now()
            };
            return saveEntity(migrateEntity(rec));
        }).then(ceSyncStandingDefs).then(cePublishDiplo);
    }, 'primary');

    // [REC-ORDER] THE ARRANGE DOOR. Offered only at TWO OR MORE factions, on the same rule
    // the category order control uses: one row cannot be reordered, and a pair of arrows that
    // never do anything is a control that looks broken.
    // ADD IS WITHDRAWN WHILE ARRANGING and that is not tidiness -- a new faction appends
    // itself to a list the author is mid-way through sequencing, which is the one moment the
    // append is a surprise rather than a convenience.
    var arrToggle: any = (rows.length > 1) ? ceArrangeBtn(arrScope) : null;
    var facTail: any[] = arrOn ? [] : [addBtn];
    var body: any[] = [
        ourSection,
        ceSection('Factions (' + rows.length + ')', ceStack(CE_T.s2, [
            arrOn
                ? ceSub('t3', 'Move a faction to change where it sits among its own siblings. '
                    + 'A subsidiary stays under its parent \u2014 to move it out, change what '
                    + 'it is part of on its own page.')
                : null,
            ceStack(CE_T.s1,
                rows.length
                    ? facKids.concat(facTail)
                    : [ceProse('t2', 'No factions yet. A faction is a name, a description and a '
                        + 'lorebook entry \u2014 and once one exists, everybody in the world has a '
                        + 'standing with it.'), addBtn]),
            arrToggle
        ]))
    ];
    if (confirm) body.push(ceSub('t3', confirm));
    return ceScreen(null, ceStack(CE_T.s4, body));
}

// [F-24] THE STANDING LADDER, AUTHORED HERE AND NOWHERE ELSE. Two states, and the
// difference between them is the whole feature: a faction either INHERITS the world's ladder
// or OVERRIDES it, and it must be able to say which without reading its own array.
//   NOT ceIndexedStates, and the reason has changed. It was a suspected defect in that
//   primitive; the defect was [LIST-DRAFT] -- click before blur -- and it was in BOTH
//   controls, so the split narrowed nothing. What keeps them separate now is the two-state
//   inherit/override question above, which the shared primitive has no shape for. The
//   click-before-blur fix itself is shared: one draft slot, one epoch, both editors.
// [F-25] THE LADDER ROWS, SHARED BY THE WORLD DEFAULT AND EVERY FACTION OVERRIDE. Promoted
// out of the faction surface the moment a second consumer appeared, which is the rule this
// file already applies to ceIndexedStates ("promotable if a second surface ever needs it").
// Two copies of a reorder-and-reseed control is two chances to fix one of them.
function _ceLadderRows(ladder: string[], keyPrefix: string,
                       write: (next: string[]) => Promise<any>): any[] {
    var rows: any[] = [];
    // [LIST-DRAFT] Same treatment as ceIndexedStates, and shared with it rather than
    // reimplemented: two copies of a click-before-blur fix is two chances to fix one of them.
    var ep = _ceListEpochOf(keyPrefix);
    for (var i = 0; i < ladder.length; i++) {
        (function(idx: number) {
            rows.push(ceBar({ gap: CE_T.s2, key: keyPrefix + ':row:' + idx }, [
                ceGrow(null, [ h(ceField, {
                    k: keyPrefix + ':' + idx, label: '', value: ladder[idx] || '',
                    // seed KEYED TO POSITION AND CONTENT, so a reorder or a delete re-seeds
                    // the box below it. Without this the array moves and the text does not,
                    // which reads exactly like "reordering does nothing" -- the reported bug.
                    seed: keyPrefix + ':' + idx + ':' + String(ladder[idx] || ''),
                    onCommit: function(v: string) {
                        if (ep !== _ceListEpochOf(keyPrefix)) return Promise.resolve();
                        var next = ladder.slice(); next[idx] = v; return write(next);
                    }
                })]),
                ceIconBtn('Move standing up', ceIconUp(), keyPrefix + ':up:' + idx, function() {
                    if (idx === 0) return Promise.resolve();
                    var next = _ceListLive(ladder, keyPrefix);
                    var t1 = next[idx - 1]; next[idx - 1] = next[idx]; next[idx] = t1;
                    _ceListStructural(keyPrefix);
                    return write(next);
                }),
                ceIconBtn('Move standing down', ceIconDown(), keyPrefix + ':dn:' + idx, function() {
                    if (idx === ladder.length - 1) return Promise.resolve();
                    var next = _ceListLive(ladder, keyPrefix);
                    var t2 = next[idx + 1]; next[idx + 1] = next[idx]; next[idx] = t2;
                    _ceListStructural(keyPrefix);
                    return write(next);
                }),
                ceIconBtn('Remove standing', ceIconTrash(), keyPrefix + ':rm:' + idx, function() {
                    var next = _ceListLive(ladder, keyPrefix); next.splice(idx, 1);
                    _ceListStructural(keyPrefix);
                    return write(next);
                }, 'danger')
            ]));
        })(i);
    }
    return rows;
}

// [F-30] THE TWO RUNG PICKERS, SHARED BY THE WORLD DEFAULT AND EVERY FACTION OVERRIDE, for
// the same reason _ceLadderRows is shared: two copies is two chances to fix one of them.
// OFFERED ONLY ABOVE ONE RUNG. With a single rung everything rests on it and neither
// question has a second answer -- the rule the StateDef editor already applies to its own
// resting-band control, stated there as "both are honest states and neither needs a control".
// EACH PICKER GETS ITS OWN ROW (CE-STYLE 8c): two selects and their hints on one bar is the
// column-of-single-letters collapse.
function _ceRungPickers(ladder: string[], rest: number, start: number, keyPrefix: string,
                        write: (field: string, idx: number) => Promise<any>): any[] {
    if (ladder.length < 2) return [];
    var opts: any[] = [];
    for (var i = 0; i < ladder.length; i++) {
        opts.push({ id: String(i), label: (i + 1) + '. ' + String(ladder[i] || '(blank)') });
    }
    return [
        ceSelect({
            k: keyPrefix + ':rest', label: 'Resting rung', value: String(rest), options: opts,
            hint: 'Where a stranger stands. A standing sitting here says nothing to the model; '
                + 'every other rung is worth its attention.',
            onCommit: function(v: string) { return write('standingRest', Number(v) || 0); }
        }),
        ceSelect({
            k: keyPrefix + ':start', label: 'Starting rung', value: String(start), options: opts,
            hint: 'Where somebody with no history begins. Usually the resting rung \u2014 move it '
                + 'for a world that meets outsiders warm or cold.',
            onCommit: function(v: string) { return write('standingStart', Number(v) || 0); }
        })
    ];
}

// [F-25] THE WORLD DEFAULT, ON THE WORLD TAB. It is a fact about the setting -- what the
// rungs of a relationship ARE here -- so it belongs beside species and archetypes rather
// than on any one faction. A faction only ever says it means something different.
function _ceSettingsStandingSection(cfg: any): any {
    var ladder: string[] = Array.isArray(cfg.standingLadder) && cfg.standingLadder.length
        ? cfg.standingLadder.slice() : DEFAULT_STANDING_LADDER.slice();
    var write = function(next: string[]): Promise<any> {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var keep: string[] = [];
                for (var i = 0; i < next.length; i++) {
                    var s = String(next[i] || '').trim();
                    if (s) keep.push(s);
                }
                // EMPTIED MEANS RESET, NOT ERASED. Unlike a faction, the world has nothing to
                // fall back to, so an emptied default is refilled from the seed rather than
                // left as a world where nobody can stand anywhere.
                (c as any).standingLadder = keep.length ? keep : DEFAULT_STANDING_LADDER.slice();
            });
        }).then(ceSyncStandingDefs).then(cePublishSettings);
    };
    // [F-30] The rung write is its own chain rather than a flag on `write` above: that one
    // takes a whole array and reseeds every row's key from it, and a rung move must not
    // reseed the text boxes underneath it.
    var writeRung = function(field: string, idx: number): Promise<any> {
        return ceSettingsOp(function() {
            return mutConfig(function(c: any) { (c as any)[field] = idx; });
        }).then(ceSyncStandingDefs).then(cePublishSettings);
    };
    var rows = _ceLadderRows(ladder, 'set:ladder', write);
    return ceSection('Standing ladder', ceStack(CE_T.s2, [
        ceProse('t2', 'Coldest first. Every faction uses these rungs unless it sets its own, '
            + 'and a character\u2019s standing with a faction is a state that reads them.'),
        ceStack(CE_T.s1, rows),
        ceBtn('+ Add standing', 'set:ladder:add', function() {
            // [LIST-DRAFT] Outside _ceLadderRows but on its keyPrefix, so it addresses the
            // same row elements. An Add that discarded the rung being typed would be the
            // reported archetype bug, one surface over.
            var next = _ceListLive(ladder, 'set:ladder'); next.push('New standing');
            _ceListStructural('set:ladder');
            return write(next);
        })
    ].concat(_ceRungPickers(ladder,
        ceStandingRungFor(cfg, null, 'standingRest',  ladder.length),
        ceStandingRungFor(cfg, null, 'standingStart', ladder.length),
        'set:ladder', writeRung))));
}

function _ceFactionStanding(fid: string, st: any): any {
    var ladder: string[] = (st.ladder || []).slice();
    var own = !!st.ladderOwn;

    // [F-28] WRITES THE ENTITY, not the config. ceEntityOp is the right queue for the same
    // reason the condition verbs give for choosing theirs: this is a record write, and the
    // standing sync that follows is a config write, so they must not share one chain.
    var write = function(next: string[]): Promise<any> {
        return ceEntityOp(function() {
            return loadEntity(fid).then(function(ent: any) {
                if (!ent) return;
                // AN OVERRIDE THAT MATCHES THE DEFAULT IS NOT AN OVERRIDE. Emptying the list
                // is how an author says "go back to the world's", so it deletes rather than
                // storing [] -- which ceStandingLadderFor would read as inheritance anyway,
                // but storing it would leave the surface claiming an override that is not one.
                var keep: string[] = [];
                for (var i = 0; i < next.length; i++) {
                    var s = String(next[i] || '').trim();
                    if (s) keep.push(s);
                }
                if (keep.length) (ent as any).standingLadder = keep;
                else if ((ent as any).standingLadder !== undefined) delete (ent as any).standingLadder;
                // [F-30] EMPTYING THE LADDER CLEARS THE RUNGS WITH IT. "Use the world's
                // ladder" has to mean the whole of it -- a faction left holding rung 4 of a
                // ladder it no longer owns is an override the surface would not show and the
                // author did not ask for. The clamp in ceStandingRungFor would keep it legal
                // and that is exactly the problem: legal and invisible.
                if (!keep.length) {
                    if ((ent as any).standingRest !== undefined)  delete (ent as any).standingRest;
                    if ((ent as any).standingStart !== undefined) delete (ent as any).standingStart;
                }
                return saveEntity(ent);
            });
        }).then(ceSyncStandingDefs).then(function() { return cePublishEntity(fid); });
    };

    // [F-30] Same split as the world section: a rung write must not reseed the rung text.
    var writeRung = function(field: string, idx: number): Promise<any> {
        return ceEntityOp(function() {
            return loadEntity(fid).then(function(ent: any) {
                if (!ent) return;
                (ent as any)[field] = idx;
                return saveEntity(ent);
            });
        }).then(ceSyncStandingDefs).then(function() { return cePublishEntity(fid); });
    };

    var rows: any[] = _ceLadderRows(ladder, 'facld:' + fid, write);
    // [F-30] PROJECTED, NOT RECOMPUTED HERE. This surface has no config in hand -- the
    // resolved rungs ride the store payload beside `ladder`, which is the same trip
    // ladderOwn already makes. Reading them off `st` is what stops this surface and
    // ceSyncStandingDefs answering the question two different ways.
    var rungRows: any[] = _ceRungPickers(ladder, Number(st.ladderRest) || 0,
                                         Number(st.ladderStart) || 0, 'facld:' + fid, writeRung);

    var foot: any[] = [
        ceBtn('+ Add standing', 'facld:' + fid + ':add', function() {
            // [LIST-DRAFT] Same keyPrefix as this faction's rows, for the reason above.
            var next = _ceListLive(ladder, 'facld:' + fid); next.push('New standing');
            _ceListStructural('facld:' + fid);
            return write(next);
        })
    ];
    if (own) {
        foot.push(ceBtn('Use the world\u2019s ladder', 'facld:' + fid + ':reset', function() {
            // [LIST-DRAFT] Structural: the rows are about to stop existing, so a commit
            // landing after this must not write one of them back.
            _ceListStructural('facld:' + fid);
            return write([]);
        }));
    }

    return ceGroup('Standing (' + ladder.length + ')', ceStack(CE_T.s2, [
        ceSub('t2', 'Coldest first. These are the rungs somebody can stand on with this '
            + 'faction \u2014 the words a standing will show, not the numbers behind it.'),
        ceSub('t3', own
            ? 'This faction\u2019s own ladder. It no longer follows the world default.'
            : 'Following the world default. Editing here gives this faction a ladder of its own.'),
        rows.length ? ceStack(CE_T.s1, rows) : ceSub('t3', 'No rungs \u2014 nobody can stand anywhere.'),
        ceInline(CE_T.s2, foot)
    ].concat(rungRows)));
}

// [F-29] _ceFactionRoot AND _ceFactionOverview ARE DELETED.
//   THE ROOT is replaced by a ceTabRow on the entity surface under the 'entity' scope --
//   see _ceEntityRoot. The tabs did not need a screen of their own; they needed to be on the
//   screen that already had the record.
//   THE OVERVIEW was three things and none of them survives as itself: a name-and-description
//   card (the entity hero and description field say it, editably, which the card did not), a
//   button reading "Open profile" (the profile IS the surface now, so the button is where you
//   already are), and a Delete (the entity surface has had one all along, in the Map Entity
//   drill -- it has been taught the faction's consequences rather than duplicated here).
//   THE ROSTER moved out of Overview and became a tab, per author: it is one of the three
//   things this screen had that the profile did not.

// [F-27] THE ROSTER, DERIVED AND NEVER STORED. Who belongs to a faction is a QUESTION ABOUT
// STANDING, so there is no membership list to keep in sync with one -- a stored roster and a
// standing value are two records that can disagree, and the standing is the one that moves.
// AT REST MEANS NOT A MEMBER. The middle rung is where a stranger stands (see
// ceSyncStandingDefs), so a roster listing everyone at rest would list the whole cast for
// every faction. Anyone off rest is here, warm or cold, because a sworn enemy is as much a
// fact about a faction as an ally is -- and the two are grouped rather than merged.
function _ceFactionRoster(id: string, st: any): any {
    var warm: any[] = (st.rosterWarm || []);
    var cold: any[] = (st.rosterCold || []);
    if (!warm.length && !cold.length) {
        return ceGroup('Roster', ceStack(CE_T.s1, [
            ceSub('t3', 'Nobody stands anywhere with this faction yet. A standing is a state on '
                + 'each character \u2014 move one off its resting rung and they appear here.')
        ]));
    }
    var mk = function(list: any[], idx0: number): any[] {
        var out: any[] = [];
        for (var i = 0; i < list.length; i++) {
            (function(r: any, n: number) {
                out.push(ceRow(r.name, r.label, ceBtn('Open', 'facr:' + id + ':' + r.id, function() {
                    ceNav('profile', r.id, '',
                          { surface: 'entity', entityId: id, tab: 'entity:roster',
                            label: 'Faction' });
                    return Promise.resolve();
                }), n));
            })(list[i], idx0 + i);
        }
        return out;
    };
    var kids: any[] = [];
    if (warm.length) kids.push(ceSection('With them (' + warm.length + ')', ceStack(null, mk(warm, 0))));
    if (cold.length) kids.push(ceSection('Against them (' + cold.length + ')', ceStack(null, mk(cold, 0))));
    return ceGroup('Roster (' + (warm.length + cold.length) + ')', ceStack(CE_T.s3, kids));
}

// [F-27] _ceFactionJournal DELETED. It was a second bubble editor for a shape the Journal
// surface already renders, and the Journal surface already had a scope picker built to hold
// more than one journal. The faction's Journal tab now routes there scoped to this faction,
// so there is one editor, one archive rule and one place a future change has to land.

function ceEntityStoreInit(): void {
    if (ceEntityStore) return;
    try {
        ceEntityStore = createStore({
            ready: false, id: '', ent: null, index: [],
            parentName: '', narrParentName: '', children: [], presentChars: [],
            ms: null, msActive: false, msCtxChars: [], msTargets: {},
            msEvShapes: [], msEv: null, msEvBusy: false, msEvPick: '',
            conns: [], confirm: '', keyGen: 0,
            // [F-32 SPEC-IMG][STORE-BEFORE-HOOK] Seeded in the INITIAL shape, not only
            // written by the publish. The species image drill is subscribed from its first
            // render, and a list reading undefined off a subscribed store is a blank surface
            // with no console line -- the failure every other seeded slot here guards.
            imgSlots: [], imgTags: {}, imgAddGen: 0,
            // [F-29] The faction projection. Declared here, not only written in the publish,
            // for the reason every other slot on this store is: the tabs render on the first
            // paint, before the publish resolves, and an undefined roster is a crash where an
            // empty one is a sentence.
            ladder: [], ladderOwn: false, facRows: [], facHasDefs: false,
            rosterWarm: [], rosterCold: [],
            // [LOC-PROFILE2] The profile projection, in buildCharProfilePayload's
            // shape. Built by cePublishEntity so the shared renderers get a value that is
            // already resolved rather than reaching into the record themselves.
            p: null,
            // [LOC-PROFILE3] VIEW STATE, NOT RECORD STATE. Which drill is showing,
            // and nothing else -- locScope went with the filter. See _ceProfileDrill for
            // the precedent and _ceEntDrill for why this one lives on the entity store.
            entDrill: '',
            // [LOC-PROFILE2] A DRILL ASKED FOR BEFORE THE SURFACE EXISTS. A caller arriving
            // from elsewhere cannot set entDrill directly: the publish for the new id clears
            // it, because the id it compares against is still the OLD one at the moment the
            // patch applies. So the request is parked here and the publish consumes it.
            // `entDirect` remembers that the drill was entered from outside, which is what
            // lets its Back leave the surface instead of dropping into a root nobody asked
            // for. Both cleared by _ceEntDrill, so an ordinary drill open is ordinary.
            entDrillOpen: '', entDirect: '',
            // [SEC:TRAVEL] Declared here for the reason the faction slots above give:
            // the drill renders on the first paint, before the publish resolves, and an
            // undefined option list is a crash where an empty one is a disabled control.
            travelDepth: 0, travelTiers: []
        });
    } catch (e) { api.v1.error('[AE:jsxentity] store init failed:', e); }
}

function ceEntityPatch(fn: (s: any) => any): void {
    if (!ceEntityStore) return;
    try {
        ceEntityStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxentity] patch failed:', e); }
}

// ============================================================================
// OP-CHAIN LOCK ORDER
// TEN SERIALISING CHAINS EXIST IN THIS FILE, each because its storage is load-modify-save
// with no compare-and-swap: two writes landing close together silently discard one. Each is
// a promise chain, so anything awaited inside one HOLDS it until it resolves -- which makes
// order a correctness property, not a style question. Two chains acquired in opposite
// orders from two places is a permanent hang with no error and no console line, and the
// user's only symptom is a surface that stops responding to taps.
//
// THE ORDER, OUTERMOST FIRST. Acquire only downward. Never acquire upward.
//
//     1. ceEntityOp      world graph      (entity storage)
//     2. ceProfileOp     characters       (records + sheet values)
//     3. ceCastLoreOp    cast/world lore  (state record + lorebook)
//     4. ceSettingsOp    global config
//     5. ceImagesOp      image field library
//     6. ceJournalOp     story + character journals
//     7. ceChatOp        chat threads
//     8. ceImgSlotOp     per-character image slots
//     9. ceWizOp         wizard state
//
// ceImgOp IS NOT A TENTH LOCK -- it is a verb that runs inside ceImagesOp. Listed here only
// because its name reads like a peer and is not one.
//
// WHY THIS ORDER: it is the order of ownership. An entity edit can move a character
// (BODY-META-STALE), a character move can change the cast roster, and settings can change
// what the lore contains. Each level can legitimately need the one below it; none of them
// ever needs the one above.
//
// ONLY TWO NESTINGS EXIST TODAY, both 1 -> 2: SECTION 30's equip and location verbs, and
// ceEntityWrite's body-owner refresh. Everything else is a single chain. If you need a
// third, check this list BEFORE writing it. If the pair you need runs upward, split the
// verb -- do not reverse the order here.
//
// NOT LOCKS, DO NOT ADD: queueCastLoreSync and the cePublish* functions are fire-and-forget
// coalescers. They may be called from inside any chain.
// ============================================================================
function ceEntityOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceEntChain.then(fn);
    _ceEntChain = run.catch(function() { return null; });
    return run;
}

async function cePublishEntity(id: string): Promise<void> {
    ceEntityStoreInit();
    if (!ceEntityStore || !id) return;
    try {
        var ent: any = await loadEntity(id);
        if (!ent) { ceEntityPatch(function() { return { ready: true, id: id, ent: null }; }); return; }
        var metas: any[] = await loadEntityIndex();

        var index: any[] = [];
        var children: any[] = [];
        var parentName = '';
        var narrParentName = '';
        var i = 0;
        for (i = 0; i < (metas || []).length; i++) {
            var m: any = metas[i];
            if (!m) continue;
            // parentId IS LOAD-BEARING, not decoration: ceMapWouldCycle walks byId[x].parentId
            // to reject a parent that is one of this node's own descendants. Without it the
            // guard silently returns false for every candidate and the picker offers loops.
            index.push({ id: String(m.id), name: String(m.name || 'Unnamed'),
                         type: String(m.type || ''), icon: String(m.icon || ''),
                         parentId: (m.parentId == null) ? null : String(m.parentId) });
            if (m.id === ent.parentId) parentName = String(m.name || 'Unnamed');
            if (m.id === ent.narrativeParentId) narrParentName = String(m.name || 'Unnamed');
            if (m.parentId === ent.id) {
                children.push({ id: String(m.id), name: String(m.name || 'Unnamed'),
                                type: String(m.type || ''), icon: String(m.icon || '') });
            }
        }

        // Characters standing in this entity. currentLocationId is the CharacterMeta
        // field, not a CharacterRecord one -- loadIndex is the right read here and
        // deleteEntity's own [CHANGE] note is the record of what reading the wrong one
        // costs.
        var presentChars: any[] = [];
        try {
            var cIdx: any[] = await loadIndex();
            for (i = 0; i < (cIdx || []).length; i++) {
                if (!cIdx[i] || cIdx[i].currentLocationId !== ent.id) continue;
                presentChars.push({ id: String(cIdx[i].id), name: String(cIdx[i].name || 'Unnamed') });
            }
        } catch (eC) { api.v1.error('[AE:jsxentity] char index read failed:', eC); }

        // Connection rows carry the resolved target name so the list renderer never
        // has to search the index per row.
        var conns: any[] = [];
        var raw: any[] = ent.connectedEntityIds || [];
        for (i = 0; i < raw.length; i++) {
            if (!raw[i]) continue;
            var tName = '';
            for (var j = 0; j < index.length; j++) {
                if (index[j].id === raw[i].targetId) { tName = index[j].name; break; }
            }
            conns.push({ targetId: String(raw[i].targetId || ''),
                         label: String(raw[i].label || ''),
                         name: tName || 'Missing entity' });
        }

        // [LOC-PROFILE2] Built here, once per publish, rather than per render.
        var cfgE: any = null;
        try { cfgE = await loadConfig(); } catch (eCf) { cfgE = null; }
        // [ITEM-CAT] ANY TYPE WITH A CATALOG, not locations by name. The gate was
        // the last place the profile column knew what a location was.
        var pProj: any = ceEntityCatalog(String(ent.type || ''))
            ? buildEntityProfilePayload(ent, cfgE) : null;

        // [MILESTONE] A THREAD'S OWN BLOCK, gated on type exactly as the faction block
        // below is. A location pays nothing for it: three reads that never happen.
        var msDoc: any = null;
        var msActive = false;
        var msCtxChars: any[] = [];
        var msTargets: any = {};
        // [EVT-MIRROR] Declared beside the rest of the thread block and left empty for every
        // other record type, so a location pays nothing for them -- the same arrangement the
        // three above already keep.
        var msEvShapes: any[] = [];
        var msEv: any = null;
        var msEvBusy = false;
        if (String(ent.type || '') === 'narrative') {
            try { msDoc = await loadMilestones(id); }
            catch (eMs) { msDoc = { v: 1, threadId: id, current: null, archive: [] }; }
            try { msActive = (await loadActiveThread()) === id; } catch (eAt) { msActive = false; }
            // THE CONTEXT PICKER'S OWN ROSTER. Characters by name from the character index;
            // entities come off `index`, already built above for the graph pickers.
            try {
                var msCi: any[] = await loadIndex();
                for (var mci = 0; mci < (msCi || []).length; mci++) {
                    if (!msCi[mci]) continue;
                    msCtxChars.push({ id: String(msCi[mci].id), name: String(msCi[mci].name || 'Unnamed') });
                }
            } catch (eCi) { msCtxChars = []; }
            // The current milestone's target, resolved to a name off the same index the
            // rest of this publish already walked -- no extra read.
            // [MILESTONE] Archive stamps formatted in the publish, the same arrangement
            // and the same reason as the journal's: ceClockStamp needs the calendar and the
            // renderer has no config. Written onto a COPY of each row, never onto the stored
            // document -- a derived string persisted beside its inputs is one calendar edit
            // from lying.
            var msCal: any = null;
            try { msCal = ceCalendar(cfgE); } catch (eMc) { msCal = null; }
            var msArch: any[] = [];
            for (var mai = 0; mai < ((msDoc && msDoc.archive) || []).length; mai++) {
                var mrow: any = msDoc.archive[mai];
                msArch.push({ id: String(mrow.id), text: String(mrow.text || ''),
                              stamp: (typeof mrow.resolvedStoryT === 'number')
                                     ? ceClockStamp(msCal, Number(mrow.resolvedStoryT)) : '' });
            }
            msDoc = { v: 1, threadId: id, current: (msDoc && msDoc.current) || null, archive: msArch };

            var msTid = String((msDoc && msDoc.current && msDoc.current.targetId) || '');
            if (msTid) {
                for (var mti = 0; mti < index.length; mti++) {
                    if (index[mti].id === msTid) { msTargets[msTid] = index[mti].name; break; }
                }
            }

            // [EVT-MIRROR] THE SHAPES, AND WHERE THIS THREAD'S ENCOUNTER STANDS. Both are
            // derived here rather than in the renderer for the reason every other projection
            // on this surface is: the renderer has no config and cannot read storage.
            //   THE LIVE ONE IS READ OFF THIS THREAD'S OWN MILESTONE and not through
            //   ceLiveEvent, which answers "is one running anywhere". Those differ exactly
            //   when an encounter is running on a DIFFERENT thread or loose, and this
            //   surface must show that its own milestone has none while still refusing to
            //   start a second -- so it needs both answers, and msEvBusy is the other.
            var msShapes: any[] = [];
            var msEvDefs: StateDef[] = ceEventShapes(cfgE);
            for (var msi = 0; msi < msEvDefs.length; msi++) {
                msShapes.push({ id: String(msEvDefs[msi].id), label: String(msEvDefs[msi].name || msEvDefs[msi].id) });
            }
            try { msEvBusy = !!(await ceLiveEventId()); } catch (eEb) { msEvBusy = false; }
            msEvShapes = msShapes;

            var msCurEv: any = (msDoc && msDoc.current && (msDoc.current as any).event) || null;
            if (msCurEv) {
                var msEvDef = ceStateDef(cfgE, String(msCurEv.shapeDefId || ''));
                var msEvVal = 0;
                try {
                    msEvVal = await stateRead({ scope: 'event',
                                                ownerId: String(msDoc.current.id || ''),
                                                defId: String(msCurEv.shapeDefId || '') });
                } catch (eEv2) { msEvVal = 0; }
                var msEvLine = '';
                try { msEvLine = await ceEventStateLine(cfgE, msDoc.current); } catch (eEl) { msEvLine = ''; }
                msEv = {
                    shapeName: msEvDef ? String(msEvDef.name || '') : '',
                    gone: !msEvDef,
                    line: msEvLine,
                    value: msEvVal,
                    lo: msEvDef ? _ceStateBounds(msEvDef).lo : 0,
                    hi: msEvDef ? _ceStateBounds(msEvDef).hi : 0,
                    pol: ceEventPolarity(cfgE, msEvDef),
                    stakeName: _ceActionLabelOf(ceStakeDefs(cfgE).map(function(s: any) {
                        return { id: String(s.id), label: String(s.name || s.id) };
                    }), String(msCurEv.stakeId || ''))
                };
            }
        }

        // [F-29] THE FACTION TABS' DATA, cePublishFaction's body moved here and GATED ON
        // TYPE. One record, one store, one publish -- the arrangement every other entity
        // already had and the reason a faction needed a second screen at all is gone with
        // the second store. A location pays nothing for this block.
        var facLadder: string[] = [];
        var facLadderOwn = false;
        var facRest = 0;
        var facStart = 0;
        var facRows: any[] = [];
        var facHasDefs = false;
        var rosterWarm: any[] = [];
        var rosterCold: any[] = [];
        if (String(ent.type || '') === 'faction') {
            try {
                facLadder = ceStandingLadderFor(cfgE, ent);
                facLadderOwn = Array.isArray((ent as any).standingLadder)
                    && (ent as any).standingLadder.length > 0;
                // [F-30] RESOLVED AGAINST THE LADDER IN FORCE, on the same line that resolved
                // the ladder, so the two can never disagree about how many rungs there are.
                facRest  = ceStandingRungFor(cfgE, ent, 'standingRest',  facLadder.length);
                facStart = ceStandingRungFor(cfgE, ent, 'standingStart', facLadder.length);
                var facAll: any = await loadFactionStates();
                facRows = ceStateRowsForFaction(cfgE, facAll[String(id)] || {});
                // facHasDefs ANSWERS A DIFFERENT QUESTION FROM facRows.length, exactly as it
                // does on the character drill: "this world has no states at all" and "this
                // world's states are all about somebody else" want different words and
                // different buttons.
                facHasDefs = ceStateDefs(cfgE).length > 0;
            } catch (eFs) { api.v1.error('[AE:jsxentity] faction states failed:', eFs); }
            // [F-27] rest IS READ FROM THE DEF, never assumed to be the midpoint: an author
            // may move restBand, and a roster that hard-coded it would start listing people
            // who had not moved. atRest and index BOTH come off ceStateBand, which already
            // computes both and already clamps restBand into range -- recomputing either
            // here would be the second derivation of one fact, and the clamp is the part
            // that looks unnecessary and is not.
            try {
                var sDef = ceStateDef(cfgE, ceStandingDefId(String(id)));
                if (sDef) {
                    var everyone: any[] = await loadAllCharacters();
                    var nb: number = Array.isArray(sDef.bands) ? sDef.bands.length : 0;
                    var restIdx = Math.max(0, Math.min(nb - 1, Math.round(Number(sDef.restBand) || 0)));
                    for (var ri = 0; ri < (everyone || []).length; ri++) {
                        var rch: any = everyone[ri];
                        if (!rch || !rch.id) continue;
                        var rsv: any = rch.stateValues || {};
                        var rrawv = (rsv[sDef.id] === undefined) ? ceStateStart(sDef) : rsv[sDef.id];
                        var rvv = ceStateClamp(sDef, rrawv);
                        var rband = ceStateBand(sDef, rvv);
                        if (rband.atRest) continue;
                        var rentry = { id: String(rch.id), name: String(rch.name || 'Unnamed'),
                                       label: String(rband.label || ''), value: rvv, idx: rband.index };
                        if (rband.index > restIdx) rosterWarm.push(rentry); else rosterCold.push(rentry);
                    }
                    rosterWarm.sort(function(a: any, b: any) { return b.idx - a.idx; });
                    rosterCold.sort(function(a: any, b: any) { return a.idx - b.idx; });
                }
            } catch (eRo) { api.v1.error('[AE:jsxentity] roster failed:', eRo); }
        }

        // [ATMO] The atmosphere drill resolves "which plan is today" against this, exactly
        // as the character schedule drill does -- published rather than read in the
        // renderer because a renderer cannot await. Costs one historyStorage key read per
        // publish for every entity type; the drill is location-only, the read is not worth
        // a branch.
        var entClockT = 0;
        try { entClockT = await ceClockLoad(); } catch (eCk) { entClockT = 0; }

        // [F-32 SPEC-IMG] THE SLOT LIST AND ITS TAG OVERRIDES, on this store rather than on a
        // second one. ceImgSlotStore exists and is keyed by charId, but it publishes from the
        // character path and is subscribed by the character drill; a species reading it would
        // be two surfaces on one store disagreeing about whose record is loaded. One record,
        // one store, one publish -- the arrangement F-29 reached when it deleted the faction
        // store. GATED ON TYPE, so no other entity pays a storage read for it.
        var spSlots: string[] = [];
        var spTags: any = {};
        if (String(ent.type || '') === 'species') {
            try {
                var spState: any = await loadCharImgSlots(id, 'species');
                spSlots = spState.slots || [];
                spTags = spState.tags || {};
            } catch (eSl) { api.v1.error('[AE:jsxentity] species slots read failed:', eSl); }
        }

        // [SEC:TRAVEL] THE TIER PICKER'S VOCABULARY, resolved once per publish because a
        // renderer cannot walk a graph cheaply and must not try. Two questions, one pass:
        // what depth is THIS place at (which is the default the picker offers back), and
        // how many tiers does this world plausibly have.
        // THE CEILING IS THE DEEPER OF THE WORLD AND THE PRICE LIST, deliberately. Capping
        // at the world's own depth would hide a tier the author has already priced in
        // Settings and is nesting toward; capping at the price list would refuse the
        // ordinary act of marking a place tier 0 before tier 0 has a row.
        var travDepth = 0;
        var travTiers: any[] = [];
        if (String(ent.type || '') === 'location') {
            try {
                var tGraph = ceTravelGraph(index);
                travDepth = ceTravelDepth(tGraph, String(ent.id));
                var tMax = travDepth;
                var tk = 0;
                for (tk = 0; tk < (index || []).length; tk++) {
                    if (!index[tk] || index[tk].type !== 'location') continue;
                    var dK = ceTravelDepth(tGraph, String(index[tk].id));
                    if (dK > tMax) tMax = dK;
                }
                var pricedT: any[] = ceTravelTiers(cfgE);
                for (tk = 0; tk < pricedT.length; tk++) {
                    if (!pricedT[tk]) continue;
                    var pT = Math.max(0, Math.round(Number(pricedT[tk].tier) || 0));
                    if (pT > tMax) tMax = pT;
                }
                for (tk = 0; tk <= tMax && tk < 64; tk++) travTiers.push(tk);
            } catch (eTv) { travDepth = 0; travTiers = []; }
        }

        ceEntityPatch(function(s: any) {
            return { ready: true, id: id, ent: ent, index: index, children: children,
                     parentName: parentName, narrParentName: narrParentName,
                     presentChars: presentChars, conns: conns, p: pProj, cfg: cfgE,
                     clockT: entClockT,
                     imgSlots: spSlots, imgTags: spTags,
                     // [FIELD-SEED] The add-row's reset token, carried across a republish of
                     // the SAME record exactly as entDrill and confirm are -- otherwise every
                     // field commit inside the drill would remount the add box.
                     imgAddGen: (s.id === id) ? Number(s.imgAddGen || 0) : 0,
                     travelDepth: travDepth, travelTiers: travTiers,
                     ladder: facLadder, ladderOwn: facLadderOwn,
                     ladderRest: facRest, ladderStart: facStart,
                     ms: msDoc, msActive: msActive,
                     msCtxChars: msCtxChars, msTargets: msTargets,
                     msEvShapes: msEvShapes, msEv: msEv, msEvBusy: msEvBusy,
                     facRows: facRows, facHasDefs: facHasDefs,
                     rosterWarm: rosterWarm, rosterCold: rosterCold,
                     // The drill survives a republish of the SAME entity -- a field commit
                     // inside a drill must not throw the author back to the root -- and is
                     // cleared when the surface moves to a different one.
                     entDrill: (s.id === id) ? s.entDrill
                                             : String(s.entDrillOpen || ''),
                     entDirect: (s.id === id) ? s.entDirect
                                              : String(s.entDrillOpen || ''),
                     // CONSUMED, so a later republish of the same record does not re-open a
                     // drill the author has since backed out of.
                     entDrillOpen: '',
                     confirm: (s.id === id) ? s.confirm : '' };
        });
    } catch (e) {
        // Previous value survives a failed publish -- stale beats blank, same as Profile.
        api.v1.error('[AE:jsxentity] publish failed:', e);
    }
}

// [BODY-META-STALE] SOME ENTITIES ARE PEOPLE, AND MOVING ONE IS NOT AN ENTITY EDIT.
// A character's location is their BODY's parentId -- buildCharMeta says so and derives
// CharacterMeta.currentLocationId from it -- but buildCharMeta only runs inside
// saveCharacter. So a bare saveEntity on a body left the character index pointing at the
// room they used to be in, and TWO readers believed it: the Contents list on this very
// surface, and the Map's occupants/findables. Both went quietly wrong, which is the worst
// shape a bug can have: no error, no blank, just a name in the wrong room.
//
// THE OWNER LOOKUP IS ONE INDEX READ AND ONLY ON parentId. A body is not flagged as one;
// the relationship lives on the CHARACTER (char.entityId), so the only honest question is
// "does any character claim this entity", and it is only worth asking when the answer could
// matter. Every other key -- name, description, icon, connections -- changes nothing about
// where anyone is standing.
//
// PRESENCE IS RECALCULATED, NOT ASSERTED. Moving a body is exactly the input scenePresent
// is derived from, and ceProfileSetLocation reaches the same conclusion by the same route.
// Nesting ceProfileOp inside ceEntityOp is the file's fixed global order -- see the lock
// order block above ceEntityOp -- so this is legal here and would deadlock if written the
// other way round.
async function _ceEntityBodyOwner(entityId: string): Promise<any> {
    try {
        var idx: any[] = await loadIndex();
        for (var i = 0; i < (idx || []).length; i++) {
            if (idx[i] && String(idx[i].entityId || '') === String(entityId)) return idx[i];
        }
    } catch (eO) { api.v1.error('[AE:jsxentity] body owner lookup:', eO); }
    return null;
}

// -- The single write path ----------------------------------------------------
// Load, mutate, save, republish, and tell the rest of the app. The side-effects at the end
// are the ones the legacy modal called by hand at each of its ~20 handlers and therefore
// sometimes did not: the sidebar refresh, a lorebook resync when the entity has a linked
// entry whose body this field feeds, and the body-owner refresh above.
async function ceEntityWrite(id: string, key: string, value: any): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (key === 'icon') { e.icon = String(value || '').trim() || undefined; }
            // [LOC-PROFILE] 'cfv:<facetId>' writes INTO the bag rather than replacing
            // a top-level field. A sub-key convention rather than a second write verb: the
            // generator's commit path (ceSlotOptsCommit) already calls ceEntityWrite with a
            // field key it was handed, and giving facets their own verb would mean the
            // generator needed to know which kind of field it was writing.
            else if (key.indexOf('cfv:') === 0) {
                if (!e.customFieldValues) e.customFieldValues = {};
                e.customFieldValues[key.slice(4)] = String(value || '');
            }
            else if (key === 'parentId' || key === 'narrativeParentId') {
                e[key] = String(value || '') || null;
            } else { e[key] = value; }
            await saveEntity(e);
            if (key === 'parentId') {
                var owner: any = await _ceEntityBodyOwner(id);
                if (owner) {
                    await ceProfileOp(async function() {
                        var oc: any = await loadCharacter(String(owner.id));
                        if (oc) await saveCharacter(oc);      // reruns buildCharMeta
                        await recalculateScenePresence();
                    });
                    try { await cePublishScene(); } catch (eS) {}
                    try { await cePublishMap(); } catch (eM) {}
                }
            }
            // NAME AND lorebookText ARE THE LOREBOOK'S OWN INPUTS -- the name is the
            // primary trigger key and lorebookText is the body -- so an edit to either
            // that is not resynced leaves the injected entry disagreeing with the record.
            // [LOC-PROFILE] Facets, locationType and the dramatic-function pair are
            // lorebook inputs too now, so the resync condition widens with them. Missing
            // one leaves the injected entry disagreeing with the record, which is the
            // failure this guard already existed to prevent.
            // [LORE-EVERY] NO `e.lorebookEntryId &&` GUARD. That clause is what made the
            // entry a thing an author had to go and ask for: a record with no entry skipped
            // the sync, and skipping the sync was the only way it would ever get one.
            // syncEntityLorebookEntry now creates-or-syncs and refuses an empty record on
            // its own, so the condition here is about WHICH FIELDS ARE LOREBOOK INPUTS and
            // nothing else.
            if (key === 'name' || key === 'lorebookText' || key === 'description'
                || key === 'locationType' || key.indexOf('cfv:') === 0) {
                try { await syncEntityLorebookEntry(id, true); } catch (eL) { api.v1.error('[AE:jsxentity] lore sync failed:', eL); }
            }
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] write failed:', e2); }
    });
}

// [MILESTONE] THE WRITE PATH, one function and one branch, the same discipline
// ceJournalOp keeps: every verb ends in a republish, so the surface never renders a value
// it did not read back. Inside ceEntityOp because a milestone edit and a record edit are
// the same author acting on the same thread and must not interleave.
//   NOTHING HERE AUTO-GENERATES. 'resolve' archives and leaves the slot EMPTY, per user:
//   the generate offer sits there and waits. A tool that fills the gap it just made is a
//   tool that has started driving.
function ceMilestoneOp(threadId: string, op: string, value: any): Promise<any> {
    return ceEntityOp(async function() {
        try {
            var doc: any = await loadMilestones(threadId);
            if (op === 'set') {
                var txtMs = String(value || '').trim();
                if (!txtMs) {
                    // An empty commit CLEARS rather than storing a blank milestone, which
                    // would inject an empty arc line every turn.
                    doc.current = null;
                } else if (doc.current) {
                    doc.current.text = txtMs;
                } else {
                    var msT = 0;
                    try { msT = await ceClockLoad(); } catch (eT) { msT = 0; }
                    doc.current = { id: generateId(), text: txtMs, targetId: '',
                                    createdAt: Date.now(), storyT: msT };
                }
            } else if (op === 'target') {
                if (doc.current) { doc.current.targetId = String(value || ''); }
            } else if (op === 'event.begin') {
                // [EVENT] AN ENCOUNTER ATTACHES TO THE CURRENT MILESTONE AND ONLY MINTS ONE
                // WHEN THERE IS NONE. This is what "a milestone's mechanical function" means
                // literally: a thread whose next objective is already written gets that
                // objective graded, not a second milestone pushed in front of it. Archiving
                // the standing one to make room would silently resolve an objective the
                // author never finished.
                var evCfg: any = await loadConfig();
                var evDef = ceStateDef(evCfg, String((value && value.shapeDefId) || ''));
                if (!evDef || String(evDef.scope || '') !== 'event') return null;
                // ONE AT A TIME, asked rather than flagged. See ceLiveEvent.
                if (await ceLiveEventId()) {
                    try { api.v1.ui.toast('An encounter is already running.', { type: 'info', autoClose: 2500 }); } catch (eTo1) {}
                    return null;
                }
                var evTxt = String((value && value.text) || '').trim();
                if (!doc.current) {
                    if (!evTxt) return null;   // a blank encounter would inject an empty arc line
                    var evT0 = 0;
                    try { evT0 = await ceClockLoad(); } catch (eT0) { evT0 = 0; }
                    doc.current = { id: generateId(), text: evTxt, targetId: '',
                                    createdAt: Date.now(), storyT: evT0 };
                } else if (evTxt) {
                    doc.current.text = evTxt;
                }
                if (value && value.targetId) doc.current.targetId = String(value.targetId);
                var evT1 = 0;
                try { evT1 = await ceClockLoad(); } catch (eT1) { evT1 = 0; }
                // THE SHAPE'S OWN WAGER IS COPIED IN HERE and nowhere else. See
                // StateDef.eventStakeId: the caller may override it, but with nothing passed
                // the shape decides, which is what makes Begin two controls and a button.
                doc.current.event = { shapeDefId: String(evDef.id),
                                      stakeId: String((value && value.stakeId)
                                                   || (evDef as any).eventStakeId || ''),
                                      startedAt: Date.now(), startedStoryT: evT1 };
                doc.current.eventArmedAt = Date.now();
                // THE TRACK IS NOT SEEDED. stateRead returns `start` for an owner with no
                // row, so the encounter begins at full span with one write instead of two.
            } else if (op === 'event.cancel') {
                // [EVENT] THE ENCOUNTER THE STORY WALKED PAST. It takes the mechanics off the
                // milestone and leaves the milestone standing, because "the fight ended
                // offscreen" is not "the objective is met" -- and because the arc slot and
                // the situational generator are both gated on a live encounter, an author
                // with no way out of one would be stuck with both.
                if (!doc.current || !doc.current.event) return null;
                await ceEventStatesDrop(String(doc.current.id));
                delete doc.current.event;
            } else if (op === 'event.conclude') {
                // [EVENT] STAMP, THEN ARCHIVE THROUGH THE SAME PATH A MILESTONE ALWAYS TOOK.
                // The band label is frozen onto the record HERE and nowhere else -- it is the
                // last moment the track still exists to read.
                if (!doc.current || !doc.current.event) return null;
                var cCfg: any = await loadConfig();
                var cLine = '';
                try { cLine = await ceEventStateLine(cCfg, doc.current); } catch (eCl) { cLine = ''; }
                if (cLine) doc.current.stateLine = cLine;
                await ceEventStatesDrop(String(doc.current.id));
                var cT = 0;
                try { cT = await ceClockLoad(); } catch (eCt) { cT = 0; }
                doc.current.resolvedAt = Date.now();
                doc.current.resolvedStoryT = cT;
                doc.archive.unshift(doc.current);
                doc.current = null;
                // [EVENT] THE CAP, AND ONLY ON THE LOOSE STORE. A thread's archive is reaped
                // by deleteEntity; this one has no entity behind it, so it is bounded at the
                // write instead. Applied on conclude alone -- the only op that can grow it.
                if (String(threadId) === CE_MS_LOOSE && doc.archive.length > CE_LOOSE_ARCHIVE_MAX) {
                    doc.archive = doc.archive.slice(0, CE_LOOSE_ARCHIVE_MAX);
                }
            } else if (op === 'resolve') {
                if (!doc.current) return;
                var rT = 0;
                try { rT = await ceClockLoad(); } catch (eR) { rT = 0; }
                doc.current.resolvedAt = Date.now();
                doc.current.resolvedStoryT = rT;
                // NEWEST FIRST. The renderer reads top-down and the generator reads the
                // first few, so the sort lives here and neither has to know about it.
                doc.archive.unshift(doc.current);
                doc.current = null;
            } else if (op === 'unarchive') {
                // ONE WAY BACK, because 'resolve' is one tap and a misfire should not cost
                // the text. Refuses when something is already current rather than silently
                // overwriting it -- two milestones is the one state this design forbids.
                if (doc.current) {
                    try { api.v1.ui.toast('Resolve the current milestone first.', { type: 'info', autoClose: 2500 }); } catch (eTo) {}
                    return;
                }
                var backId = String(value || '');
                for (var bi = 0; bi < doc.archive.length; bi++) {
                    if (String(doc.archive[bi].id) !== backId) continue;
                    var revived: any = doc.archive[bi];
                    delete revived.resolvedAt;
                    delete revived.resolvedStoryT;
                    doc.archive.splice(bi, 1);
                    doc.current = revived;
                    break;
                }
            } else if (op === 'drop') {
                var dropId = String(value || '');
                var kept: any[] = [];
                for (var di = 0; di < doc.archive.length; di++) {
                    if (String(doc.archive[di].id) !== dropId) kept.push(doc.archive[di]);
                }
                doc.archive = kept;
            } else { return; }
            await saveMilestones(doc);
            await cePublishEntity(threadId);
        } catch (e) { api.v1.error('[AE:milestone] op failed:', e); }
    });
}

// [MILESTONE] THE FOCUS TOGGLE. Republishes the thread it left as well as the one it
// landed on, or the previous thread's hero would keep claiming focus until something else
// happened to repaint it.
function ceThreadSetActive(threadId: string): Promise<any> {
    return ceEntityOp(async function() {
        try {
            var prev = '';
            try { prev = String(await api.v1.storyStorage.getOrDefault(STORAGE_ACTIVE_THREAD, '') || ''); }
            catch (eP) { prev = ''; }
            var now = await setActiveThread(threadId);
            if (prev && prev !== threadId) { try { await cePublishEntity(prev); } catch (eR) {} }
            await cePublishEntity(threadId);
            try {
                api.v1.ui.toast(now ? 'This is the active thread.' : 'No active thread.',
                                { type: 'success', autoClose: 2000 });
            } catch (eT2) {}
        } catch (e) { api.v1.error('[AE:milestone] set active failed:', e); }
    });
}

// [MILESTONE] The context check-list's write. A TOGGLE, not a set: the row knows its own
// id and nothing else, so the caller cannot desynchronise the list by sending a stale copy.
function ceThreadCtxToggle(threadId: string, refId: string): Promise<any> {
    return ceEntityOp(async function() {
        try {
            var ent: any = await loadEntity(threadId);
            if (!ent) return;
            var cur: string[] = ((ent as any).contextIds || []).slice(0);
            var at = cur.indexOf(String(refId));
            if (at >= 0) { cur.splice(at, 1); } else { cur.push(String(refId)); }
            (ent as any).contextIds = cur;
            await saveEntity(ent);
            await cePublishEntity(threadId);
        } catch (e) { api.v1.error('[AE:milestone] context toggle failed:', e); }
    });
}

// [ENT-IMAGE] Width and height are two fields of ONE fact (the render shape), so
// they commit together for the same reason ceProfileWritePair exists for a reference's
// id+name. Not a general batch helper; do not grow it into one.
async function ceEntityWritePair(id: string, pairs: any[]): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            for (var i = 0; i < (pairs || []).length; i++) { e[pairs[i].k] = pairs[i].v; }
            await saveEntity(e);
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] paired write failed:', e2); }
    });
}

// Connection edits are an ARRAY mutation, not a field, so they get their own verb for
// the same reason ceProfileHookOp is separate from ceProfileWrite: routing them through
// a generic key/value setter would mean the caller assembling the array, and two callers
// assembling it is how one of them ends up dropping an element.
async function ceEntityConnOp(id: string, op: string, targetId: string, value: any): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (!Array.isArray(e.connectedEntityIds)) e.connectedEntityIds = [];
            if (op === 'add') {
                for (var a = 0; a < e.connectedEntityIds.length; a++) {
                    if (e.connectedEntityIds[a] && e.connectedEntityIds[a].targetId === targetId) return;
                }
                e.connectedEntityIds.push({ targetId: targetId, label: String(value || ''), resourceCost: 0 });
            } else {
                var kept: any[] = [];
                for (var i = 0; i < e.connectedEntityIds.length; i++) {
                    var c: any = e.connectedEntityIds[i];
                    if (!c) continue;
                    if (c.targetId === targetId) {
                        if (op === 'remove') continue;
                        if (op === 'label') c.label = String(value || '');
                    }
                    kept.push(c);
                }
                e.connectedEntityIds = kept;
            }
            await saveEntity(e);
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] conn op failed:', e2); }
    });
}

async function ceEntityKeyOp(id: string, op: string, value: string): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            if (!Array.isArray(e.lorebookTags)) e.lorebookTags = [];
            var t = String(value || '').trim();
            if (op === 'add') {
                if (!t) return;
                if (e.lorebookTags.indexOf(t) >= 0) return;
                e.lorebookTags.push(t);
            } else {
                var kept: string[] = [];
                for (var i = 0; i < e.lorebookTags.length; i++) {
                    if (e.lorebookTags[i] !== t) kept.push(e.lorebookTags[i]);
                }
                e.lorebookTags = kept;
            }
            await saveEntity(e);
            if (e.lorebookEntryId) {
                try { await syncEntityLorebookEntry(id, true); } catch (eL) { api.v1.error('[AE:jsxentity] lore sync failed:', eL); }
            }
            _ceEntKeyDraft = '';
            ceEntityPatch(function(s: any) { return { keyGen: (Number(s.keyGen) || 0) + 1 }; });
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] key op failed:', e2); }
    });
}

// The item equip toggle. NOT a plain field write: isEquipped and the owning
// character's equippedItemIds are two halves of one fact, and EQUIP-STATE-SYNC is the
// autopsy of what writing only the first one costs. aeSetEquip is the canonical verb
// the bridge and the AE_EQUIP_ITEM handler both already use.
//
// [ITEM-HOLD] THE TWO DIRECTIONS RESOLVE THE OWNER FROM DIFFERENT FIELDS, and the
// asymmetry is the whole correctness of the toggle. EQUIP asks WHERE THE THING IS
// (parentId -- a character body, which is what the holder picker beside it just set).
// UNEQUIP asks WHO THE RECORD SAYS HAS IT (equippedToCharId), because when the two
// disagree it is the RECORDED holder whose equippedItemIds still names this item;
// resolving an unequip from parentId would clear the item's half and leave that list
// pointing at it forever. That is EQUIP-STATE-SYNC reached from a third side.
//
// MATCHES id OR entityId. Post-ENT-ID1 they are the same string, but the migration has
// not run against every live story, so a body still addressed by a separate entityId has
// to resolve too. Drop the second test with the union pass, not before.
async function ceEntitySetEquip(id: string, on: boolean): Promise<void> {
    return ceEntityOp(async function() {
        try {
            var fe: any = await loadEntity(id);
            if (!fe) return;
            var wantId = on
                ? String(fe.parentId || '')
                : String(fe.equippedToCharId || fe.parentId || '');
            var owner: any = null;
            if (wantId) {
                var all: any[] = await loadAllCharacters();
                for (var i = 0; i < (all || []).length; i++) {
                    if (!all[i]) continue;
                    if (String(all[i].id) === wantId || String(all[i].entityId || '') === wantId) {
                        owner = all[i]; break;
                    }
                }
            }
            await aeSetEquip(fe, owner, on);
            await cePublishEntity(id);
        } catch (e) { api.v1.error('[AE:jsxentity] equip failed:', e); }
    });
}

// CREATION AND EDITING ARE THE SAME SURFACE, which is the whole point of the phase:
// make the record, then land on it. The three openAdd*Modal popups each collected a
// name up front and then dropped the user back where they started, so a new place was
// always followed by a second trip to describe it.
// [F-32] `seed` IS AN OPTIONAL BAG OF FIELDS SET AT BIRTH, and it exists so that a surface
// which knows something about the record it is creating can say so in the CREATE rather than
// in a follow-up write. The Species tab's two Add buttons are the case: which list a new
// species lands on is the whole reason there are two buttons, and a create-then-write pair
// would leave a window where the record exists on the wrong list.
// APPLIED BEFORE saveEntity AND THEREFORE BEFORE migrateEntity's NORMALISER, so a seeded
// field is validated exactly as a stored one is -- a caller cannot smuggle a value past the
// migration by handing it in here.
async function ceEntityCreate(type: string, parentId: string, back: any, seed?: any): Promise<void> {
    try {
        var ent: any = makeDefaultEntity('New ' + String(type || 'location'));
        ent.type = String(type || 'location');
        ent.parentId = String(parentId || '') || null;
        if (seed) {
            for (var sk in seed) {
                if (!Object.prototype.hasOwnProperty.call(seed, sk)) continue;
                if (sk === 'id' || sk === 'type') continue;   // neither is the caller's to set
                ent[sk] = seed[sk];
            }
        }
        ent = migrateEntity(ent);
        await saveEntity(ent);
        ceNav('entity', ent.id, '', back || null);
        await cePublishEntity(ent.id);
    } catch (e) {
        api.v1.error('[AE:jsxentity] create failed:', e);
        try { api.v1.ui.toast('Could not create that.', { type: 'error', autoClose: 2000 }); } catch (e2) {}
    }
}

// [F-29] FACTION-AWARE, BECAUSE IT IS THE ONLY DELETE NOW. The retired faction screen ran
// ceSyncStandingDefs from its own Delete button; deleting that screen without moving the
// obligation would leave a managed def in the catalog pointing at a faction that no longer
// exists -- the exact orphan ceSyncStandingDefs is written to reap.
//   THE TYPE IS READ BEFORE THE RECORD GOES. After deleteEntity there is nothing left to ask.
//   ONE DELETE, NOT TWO. A second "Delete faction" on the profile would be a second control
//   for one act, which is the class of duplication this patch exists to remove.
async function ceEntityDelete(id: string, back: any): Promise<void> {
    try {
        var wasFaction = false;
        var preDel: any = null;
        // [G-01] ONE READ SERVES BOTH the type question (F-29) and the lorebook id.
        try {
            preDel = await loadEntity(id);
            wasFaction = !!preDel && String(preDel.type) === 'faction';
        } catch (ePre) { preDel = null; wasFaction = false; }
        // [G-01] THE ENTRY GOES FIRST, WHILE THE RECORD CAN STILL BE ASKED FOR ITS ID.
        // Not unlinkEntityLorebookEntry: that verb clears the field and SAVES the record,
        // which is a write to something about to be removed -- and it toasts "unlinked",
        // which is not what happened. removeEntry is the half that matters here.
        // A FAILURE HERE DOES NOT STOP THE DELETE. An entry the author already removed in
        // NAI throws, and refusing to delete the record over it would strand the record.
        if (preDel && (preDel as any).lorebookEntryId) {
            try { await api.v1.lorebook.removeEntry(String((preDel as any).lorebookEntryId)); }
            catch (eLb) { api.v1.error('[AE:jsxentity] lorebook remove on delete:', eLb); }
        }
        await deleteEntity(id);
        if (wasFaction) {
            await ceSyncStandingDefs();
            await cePublishDiplo();
        }
        await cePublishMap();
        if (back && back.surface) { ceNav(String(back.surface), String(back.entityId || '')); }
        else { ceNav('map'); }
    } catch (e) { api.v1.error('[AE:jsxentity] delete failed:', e); }
}

// -- Sections -----------------------------------------------------------------

// [ITEM-HOLD] RETURNS NULL FOR AN ITEM. An item's placement is not a graph detail
// filed behind Map Entity: it is the item's live state, and both halves of it -- whose
// hands it is in, and whether it is worn -- render on the item's own profile through
// _ceEntityHolding. Keeping the "Inside" picker here as well would be two doors onto one
// fact, which is the arrangement that put the holder question on the profile and the equip
// toggle three taps away inside this drill.
function _ceEntityPlacement(id: string, ent: any, st: any): any {
    if (String(ent.type || '') === 'item') return null;
    var kids: any[] = [];
    // [FAC-TREE] THE SENTENCE IS TYPE-AWARE; THE OPTION LIST IS NOT. A faction's parent
    // is read as an ORG CHART by Diplomacy and the word "physically" is simply wrong for it,
    // so the hint branches. The candidate list stays unfiltered on purpose: parenting a
    // faction to a PLACE is a legitimate second use of the same field (a headquarters), and
    // filtering to factions-only would delete that to tidy up a sentence. Diplomacy nests on
    // faction -> faction alone, so the two uses never collide in the drawing.
    var isFac = (String(ent.type || '') === 'faction');
    kids.push(cePickerRow({
        label: isFac ? 'Part of' : 'Inside', value: String(st.parentName || ''),
        kind: 'entityParent', ctx: { id: id },
        placeholder: isFac ? 'Nothing \u2014 answers to nobody' : 'Nowhere \u2014 top of the world',
        hint: isFac
            ? 'Another faction makes this one a subsidiary and files it under that faction on Diplomacy. A PLACE makes it a headquarters instead, which Diplomacy leaves at the top level \u2014 one field, so it is one or the other.'
            : 'A child is physically inside its parent. Entering a room moves the scene down the tree; an item or a person parented to a place is in that place.'
    }));
    if (ent.type === 'narrative') {
        kids.push(cePickerRow({
            label: 'Part of', value: String(st.narrParentName || ''),
            kind: 'narrativeParent', ctx: { id: id },
            placeholder: 'Nothing \u2014 a root plot'
        }));
        kids.push(ceStack({ gap: CE_T.s1, key: 'ent_state' }, [
            ceSub('t2', 'Story state'),
            ceSelect({
                k: 'ent:state:' + id, value: String(ent.storyState || 'locked'),
                options: CE_ENTITY_STORY_STATES,
                onCommit: function(v: string) { return ceEntityWrite(id, 'storyState', v); }
            })
        ]));
    }
    return ceGroup('Placement', ceStack(CE_T.s3, kids));
}

// [ICON-LIB] The picker. A GRID OF THE ICONS THEMSELVES, not a list of
// their names -- the whole question being asked is "which of these looks like
// the place I am describing", and a name cannot answer it. Tapping the
// currently-set icon clears it, so the control is its own undo and there is no
// separate Clear button competing for the row.
//
// It reads CE_ICON_LIB through ceIconKeysIn rather than listing keys, so
// adding an icon to that table is the only step needed to make it appear here.
// Reads the hint off CE_MAP_KINDS rather than switching on the value, so adding a role
// there is genuinely the only edit.
function _ceMapKindHint(v: any): string {
    var want = ceMapKindOf(v);
    for (var i = 0; i < CE_MAP_KINDS.length; i++) {
        if (CE_MAP_KINDS[i].id === want) return String(CE_MAP_KINDS[i].hint || '');
    }
    return '';
}

function _ceEntityIconPicker(id: string, ent: any): any {
    var cur = String(ent && ent.icon || '');
    var curKey = ceIconKeyOf(cur);
    var groups: any[] = [];

    for (var g = 0; g < CE_ICON_GROUPS.length; g++) {
        var grp = CE_ICON_GROUPS[g];
        var keys = ceIconKeysIn(String(grp.id));
        if (!keys.length) continue;
        var cells: any[] = [];
        for (var i = 0; i < keys.length; i++) {
            cells.push((function(k: string) {
                var on = (curKey === k);
                var def = CE_ICON_LIB[k];
                return ceIconBtn(
                    on ? ('Remove the ' + def.name + ' icon') : ('Use the ' + def.name + ' icon'),
                    ceIconSvg(CE_ICON_PREFIX + k, 22, 'icpick_' + k),
                    'ent:icon:' + id + ':' + k,
                    function() {
                        return ceEntityWrite(id, 'icon', on ? '' : (CE_ICON_PREFIX + k));
                    },
                    on ? 'primary' : undefined
                );
            })(keys[i]));
        }
        groups.push(ceStack({ gap: CE_T.s1, key: 'igw_' + grp.id }, [
            ceSub('t3', String(grp.label)),
            ceInline(CE_T.s1, cells)
        ]));
    }

    return ceGroup('Icon', ceStack(CE_T.s3, [
        ceProse('t2',
            'Drawn on the map above the name. These follow the map\u2019s own colour, so they read the same on any theme \u2014 an emoji in the field above does not.'),
        groups
    ]));
}

// [LORE-ONE-FIELD] _ceEntityLore IS DELETED, AND WITH IT THE LOREBOOK DRILL. Its own
// LOC-PROFILE2 DEPRECATED note named the condition for removal -- "it stays until those
// generators are pointed at the catalog" -- but the sharper reason was always sitting in the
// code: the field it rendered used the key 'ent:lore:<id>', which is the SAME KEY
// _ceEntityClassic's box uses. Two live elements registering one key in CE_FIELD_ELS is not
// a duplicated control, it is one control mounted twice, and a live read (ceFieldLive) could
// only ever answer for whichever mounted last.
//   WHAT SURVIVES AND WHERE: the body is edited on the profile -- always for a classic
//   record, and for a builder-shaped one whenever it still holds legacy text (see the
//   ent_classic_legacy clause). The link/resync verb moves to the drill ROW, replacing the
//   button that used to open this. The "built from the profile" explainer went with the
//   drill because the profile column shows that compilation directly.
//   UNLINK IS DROPPED, not relocated, and LORE-EVERY is why it was already inert: every
//   ceEntityWrite calls syncEntityLorebookEntry with no lorebookEntryId guard, and that verb
//   creates-or-syncs. So unlinking held only until the next edit of any lorebook input, and
//   the button's effect was undone by the next keystroke. A verb that cannot persist its
//   result is not a capability being removed.

function _ceEntityConns(id: string, st: any): any {
    var conns: any[] = st.conns || [];
    var kids: any[] = [];
    for (var i = 0; i < conns.length; i++) {
        kids.push((function(c: any) {
            return ceBar({ key: 'ent_conn_' + c.targetId, align: 'end', gap: CE_T.s2,
                           padBottom: CE_T.s2, rule: 'bottom' }, [
                ceGrow(null, [
                    h(ceField, {
                        key: 'ent_connf_' + c.targetId, k: 'ent:conn:' + id + ':' + c.targetId,
                        label: '\u2192 ' + c.name, value: c.label,
                        placeholder: 'How this route reads, e.g. \u201chead to the market\u201d',
                        onCommit: function(v: string) { return ceEntityConnOp(id, 'label', c.targetId, v); }
                    })]),
                ceIconBtn('Remove the route to ' + c.name, ceIconTrash(), 'ent:conndel:' + c.targetId, function() {
                    return ceEntityConnOp(id, 'remove', c.targetId, null);
                }, 'danger')
            ]);
        })(conns[i]));
    }
    if (!kids.length) {
        kids.push(ceProse('t3',
            'Parents and children already connect themselves. A route here is for somewhere the tree does not reach \u2014 a road, a door, a teleporter.', { key: 'ent_conn_none' }));
    }
    kids.push(cePickerRow({
        label: '', value: '', kind: 'entityConnection', ctx: { id: id },
        placeholder: 'Add a route\u2026'
    }));
    return ceGroup('Routes', ceStack(CE_T.s3, kids));
}

// The surface list asked for this by name: "when a location is selected, add a list at
// bottom of characters and loose items with that location as their parentID." Children
// and standing characters are the same question asked of the graph twice, so they are
// one list with a kind sub-line rather than two headed blocks.
function _ceEntityContents(id: string, ent: any, st: any): any {
    var rows: any[] = [];
    var kids: any[] = st.children || [];
    var i = 0;
    for (i = 0; i < kids.length; i++) {
        rows.push((function(k: any) {
            return ceListRow({
                lead: k.icon ? ceFixed({ size: 'base' }, [k.icon]) : null,
                label: k.name, sub: k.type,
                onClick: function() {
                    ceNav('entity', k.id, '', { surface: 'entity', entityId: id, label: ent.name || 'Back' });
                }
            });
        })(kids[i]));
    }
    var pcs: any[] = st.presentChars || [];
    for (i = 0; i < pcs.length; i++) {
        rows.push((function(c: any) {
            return ceListRow({
                label: c.name, sub: 'standing here',
                onClick: function() {
                    ceNav('profile', c.id, '', { surface: 'entity', entityId: id, label: ent.name || 'Back' });
                }
            });
        })(pcs[i]));
    }
    if (!rows.length) {
        rows.push(ceSub('t3', 'Nothing in here yet.', { key: 'ent_cont_none' }));
    }
    var adders = ceInline({ key: 'ent_cont_add', gap: CE_T.s2, padTop: CE_T.s2 }, [
        ceBtn('New place', 'ent:new:location:' + id, function() {
            return ceEntityCreate('location', id, { surface: 'entity', entityId: id, label: ent.name || 'Back' });
        }),
        ceBtn('New item', 'ent:new:item:' + id, function() {
            return ceEntityCreate('item', id, { surface: 'entity', entityId: id, label: ent.name || 'Back' });
        })
    ]);
    return ceGroup('Contents',
        ceStack(null, [ rows.concat([adders])]));
}


// -- The image slot -----------------------------------------------------------
// [earlier ENT-IMAGE, per user: "locations use the character visual architecture, it just
// has a different UI since it doesn't need a bunch of images"] THERE IS NO LOCATION IMAGE
// PATH AND THERE MUST NOT BE ONE. earlier deferred this as a cross-artifact build; that
// was wrong, and checking the bridge rather than reasoning from the anchor format is what
// showed it. THE BRIDGE'S IMAGE LAYER IS ENTIRELY ID-AGNOSTIC:
//   - _ceSurfImgResolve(charId, slot) ends at _loadPortrait(charId + '_em_' + slot). It
//     never looks the id up as a character.
//   - The EVT_GENERATE_IMAGE kind:'charSlot' branch saves to p.charId + '_em_' + p.slot,
//     with the comment "p.slot is the raw slot name... never re-derived here".
//   - AE_CHAR_IMAGE_ACTION builds the same key for delete / download / edit.
// So an ENTITY id in the charId position simply works. Zero bridge changes.
//
// THE SLOT IS 'Avatar', AND THAT CHOICE IS LOAD-BEARING RATHER THAN ARBITRARY. Avatar is
// the one slot _ceSurfImgResolve routes through _loadCharAvatarImage, which tries
// '<id>_em_Avatar' and THEN falls back to the pre-2.3.0 '<id>_portrait'. The bridge's old
// location sheet wrote location images to exactly '<locId>_portrait' (its "Generate Scene"
// button). Picking Avatar therefore makes every location image the user already has appear
// on this surface with no migration. Any other slot name would have shown them an empty
// frame beside a file they know exists.
//
// THE PROMPT IS BASE, NOT A CHARACTER ENTRY. ceImgSlotGenerate puts a character's visuals
// in characters[], which is what drives NAI's v4.5 per-character captions -- correct for a
// person, wrong for a room, and the bridge's own retired location generator agrees: it
// composed [quality, locationVisuals] into the base prompt with an empty characters array.
// This reproduces that through extraBaseVisuals, which buildRequestBody already folds into
// fp at the same position.
async function ceEntityImgGenerate(id: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected \u2014 image generation requires bridge.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
        return;
    }
    try {
        var e: any = await loadEntity(id);
        if (!e) return;
        var vis = String(e.locationVisuals || '').trim();
        if (!vis) {
            try { api.v1.ui.toast('Write some visuals first \u2014 there is nothing to draw from.', { type: 'warning', autoClose: 3000 }); } catch (e1) {}
            return;
        }
        var compiled = compileActiveImageFields();
        await ceBroadcastImageGen({
            uuid: api.v1.uuid(),
            prompt: '',
            characters: [],
            extraBaseVisuals: vis,
            extraBaseUC: '',
            charId: e.id,
            entityId: e.id,
            kind: 'charSlot',
            slot: CE_IMG_SLOT_AVATAR,
            settings: {
                width: Number(e.imgWidth) || 1216,
                height: Number(e.imgHeight) || 832,
                steps: Math.min(globalSettings.defaultSteps || 28, 28),
                scale: globalSettings.defaultScale || 5.0,
                model: ceImgModel(),
                seed: _ceImgSeed(0),
                quality: compiled.quality,
                negative: compiled.negative
            },
            autoDownload: false
        });
        try { api.v1.ui.toast('Generating\u2026', { type: 'info', autoClose: 2000 }); } catch (e2) {}
    } catch (e3) { api.v1.error('[AE:jsxentity] image generate failed:', e3); }
}

function _ceEntityImage(id: string, ent: any, st: any): any {
    // ONE FRAME, NOT A GRID. That is the whole UI difference the user named: the
    // architecture is shared, the surface is not. Landscape by default because a place
    // usually is; 16:9-ish box so the frame matches what will land in it.
    var w = Number(ent.imgWidth) || 1216;
    var hh = Number(ent.imgHeight) || 832;
    var cur = String(w) + 'x' + String(hh);
    var opts: any[] = [];
    var known = false;
    for (var i = 0; i < CE_IMG_RATIO_OPTS.length; i++) {
        opts.push(CE_IMG_RATIO_OPTS[i]);
        if (CE_IMG_RATIO_OPTS[i].id === cur) known = true;
    }
    if (!known) { opts.push({ id: cur, label: 'Custom \u2014 ' + String(w) + '\u00d7' + String(hh) }); }

    // A FIXED PIXEL HEIGHT, NOT aspect-ratio. The painter appends its <img> as
    // position:absolute with height:100%, so the anchor must have a real height of its own;
    // `aspectRatio` would probably supply one, but it has no precedent anywhere in this
    // file and nothing here is built on a CSS property this environment has not been
    // observed handling. Three heights matching the three shapes is the boring version that
    // cannot surprise anyone, and it is what every other image frame in the kit already does.
    var frameH = (hh > w) ? '320px' : ((hh === w) ? '260px' : '200px');
    // [v3.0.54 PHOTO-PROV] TAPPABLE, like the character slots already were. This
    // frame is where the removed Edit icon's provenance question gets answered, and the
    // viewer takes an entity id unchanged -- the image layer has never looked the id up as
    // a character (see the IMG-UPLOAD note below). canPin is NOT set: avatarSeed is a
    // CharacterRecord field and an entity has nowhere to put it.
    var frame = h('div', ceImgAnchor(id, CE_IMG_SLOT_AVATAR, {
        onClick: function() { ceTap('ent:imgview:' + id, function() {
            cePhotoOpen(id, CE_IMG_SLOT_AVATAR, String(ent.name || 'Image'));
        }); },
        role: 'button', tabIndex: 0, 'aria-label': 'View this image full screen',
        // [H-03] flexShrink 0 -- see the Scene frame for the whole finding.
        style: { flexShrink: 0, width: '100%', height: frameH, cursor: 'pointer',
            borderRadius: CE_T.r, background: CE_WELL, border: '1px solid ' + CE_LINE,
            position: 'relative', overflow: 'hidden' }
    }));

    // [LOC-PROFILE6] THE PROMPT, ABOVE THE BUTTON THAT READS IT.
    var visBlock = ceStack(CE_T.s2, [
        ceSub('t2', 'Visuals'),
        ceProse('t3', 'The tags a picture of this place is generated from. Describe the place, not the moment \u2014 this is reused for every image of it.'),
        h(ceField, {
            key: 'ent_vis', k: 'ent:vis:' + id, label: '',
            value: ent.locationVisuals || '', multiline: true, rows: 2, well: true,
            placeholder: 'stone tavern interior, fireplace, wooden beams\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'locationVisuals', v); }
        })
    ]);

    var confirming = (String(st.confirm || '') === 'img');
    var acts: any[] = [
        ceBtn('Generate', 'ent:imggen:' + id, function() { return ceEntityImgGenerate(id); }, 'primary'),
        // [IMG-UPLOAD] Works here for the reason ENT-IMAGE's note above already
        // established and did not have to re-argue: the bridge's image layer never looks
        // the id up as a character, so an entity id in the charId position resolves to
        // '<entityId>_em_Avatar' exactly as a character's does. One bridge op, both
        // surfaces, no location-specific path.
        ceIconBtn('Upload an image for this location', ceIconUpload(), 'ent:imgup:' + id,
            function() { return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'upload'); }),
        ceIconBtn('Download this image', ceIconDownload(), 'ent:imgdl:' + id,
            function() { return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'download'); }),
        // DESTRUCTIVE-NEVER-IN-PLACE: this button asks, and the handler is the same in both
        // states, so TAP-GUARD's double-fire cannot land the confirmed branch off one tap.
        confirming
            ? ceBtn('Delete it', 'ent:imgdel:' + id, function() {
                ceEntityPatch(function() { return { confirm: '' }; });
                return ceImgSlotAction(id, CE_IMG_SLOT_AVATAR, 'delete');
              }, 'danger')
            : ceIconBtn('Delete this image', ceIconTrash(), 'ent:imgdelask:' + id, function() {
                ceEntityPatch(function() { return { confirm: 'img' }; });
                return Promise.resolve();
              }, 'danger')
    ];

    return ceGroup('Image', ceStack(CE_T.s3, [
        frame,
        // [LOC-PROFILE6] The prompt sits BETWEEN the picture and the button that
        // reads it, which is the order the author works in: look at what is there, adjust
        // the words, generate again.
        visBlock,
        ceInline(CE_T.s2, acts),
        ceStack(CE_T.s1, [
            ceSub('t2', 'Shape'),
            ceSelect({
                k: 'ent:ratio:' + id, value: cur, options: opts,
                onCommit: function(v: string) {
                    var cut = String(v || '').indexOf('x');
                    if (cut < 0) return Promise.resolve();
                    var nw = Number(String(v).slice(0, cut)) || 1216;
                    var nh = Number(String(v).slice(cut + 1)) || 832;
                    return ceEntityWritePair(id, [{ k: 'imgWidth', v: nw }, { k: 'imgHeight', v: nh }]);
                }
            })
        ]),
        // The gap the frame cannot fill by itself. Deliberately stated rather than left as
        // an empty box: submitDirectorPhoto's own first guard is isBridgeReady, because the
        // pixels come from a fetch that does not exist in this sandbox.
        ceProse('t3',
            'Drawn from the visuals above. Generating needs the bridge; an image made by an older version of the location sheet already shows here.')
    ]));
}

// -- Location profile  [LOC-PROFILE2] -----------------------------------------
// THERE IS NO LOCATION PROFILE RENDERER. The first attempt at this wrote one -- a
// parallel group loop, a parallel field renderer, a parallel generate strip -- and it was
// wrong for the reason the one-implementation rule exists: the character Profile ALREADY
// renders grouped cards with leading questions, sparse facets, an "Add to <group>" drill
// and a per-field generator, and a place needs exactly that with different questions in it.
//
// SO THE PAYLOAD IS THE ADAPTER. buildEntityProfilePayload returns the same shape
// buildCharProfilePayload does -- customFields rows of {id, key, kind, label, instructions,
// value, group, groupLabel} -- and _ceProfileGroup, _ceSlotCard and _ceFacetField render it
// without knowing what kind of record it came from.
//
// `scope` IS THE ONE THING THEY DO KNOW, and it is carried ON THE PAYLOAD rather than
// threaded through four signatures. It selects the write verb (ceEntityWrite vs
// ceProfileWrite) and is passed through to _ceGenBtn, which has accepted an 'entity' scope
// since ENTGEN and already commits through ceEntityWrite. Carrying it on the payload means
// it cannot get out of sync with the record the payload describes, which a parameter
// passed separately at each call site can.
//
// FIELD KEYS ARE 'cfv:<facetId>', which is what ceEntityWrite already understands as a
// write into customFieldValues. So the facet's key, the generator's write key and the
// field's commit key are one string with no translation layer.
//
// NO PATTERN GATING. _ceGatedGroup returns true only for resistance/conduct, which are
// character group ids and appear nowhere in CE_LOC_GROUP_ORDER, so every location group
// renders its slot unconditionally and the gated-empty branch is unreachable here.
// [LOC-PROFILE4] THE AUTHOR'S ORDER, APPLIED ONCE. Every consumer -- the surface
// column, the reorder drill, and buildEntityLorebookContent -- goes through this, so what
// the author sees on the page IS what the entry says, in that order. Ids the record does
// not mention trail in catalog order rather than disappearing, which is what makes adding
// a facet to the catalog safe for every location already written.
// [ITEM-CAT] TYPE-AWARE, and renamed from ceLocOrderedDefs because it never was
// location-specific in anything but its catalog. Five consumers go through it and not one
// of them changed to gain items: the surface column, the reorder drill, the reorder verb,
// the generator shim's "every written facet" block, and the lorebook compile.
//
// `_ceCustomDefs` ON THE RECORD WINS OVER cfg. buildEntityLorebookContent is SYNCHRONOUS
// and has three callers, so it cannot reach loadConfig; its async callers resolve the
// right array by type and hang it on the in-memory copy. That replaces the synthetic
// `{ customLocationFields: ... }` object the sync path used to fabricate, which would have
// had to become a computed key here to serve two types.
function ceEntityOrderedDefs(ent: any, cfg: any): any[] {
    var cat = ceEntityCatalog(String((ent && ent.type) || 'location'));
    if (!cat) return [];
    var all: any[] = cat.base.slice(0);
    var custom: any[] = ((ent as any) && (ent as any)._ceCustomDefs)
                        || (cfg && cfg[cat.cfgKey]) || [];
    for (var c = 0; c < custom.length; c++) {
        if (!custom[c] || !custom[c].id) continue;
        // [ENT-CF-SEED] THE INSTRUCTION IS DERIVED HERE, NOT ONLY MINTED AT CREATION.
        // Seeding at the door fixes the next field and leaves every field already defined
        // inert forever -- _ceGenBtn returns null on an empty instruction, so those fields
        // render as a plain box with no Generate beside them and no way to find out why.
        // Deriving in THE ONE RESOLVER reaches the surface, the generator shim, the reorder
        // drill and the lorebook compile at once, costs no write, and cannot disagree with
        // itself. A stored instruction still wins: ceCustomFieldSeedInstr returns the
        // author's text untouched whenever there is any.
        all.push({ id: String(custom[c].id), slot: 'custom', kind: 'facet', scope: 'any',
                   label: String(custom[c].label || 'Field'),
                   hint: String((custom[c] as any).hint || ''),
                   placeholder: String(custom[c].placeholder || ''),
                   instructions: ceCustomFieldSeedInstr(String(custom[c].label || 'Field'),
                                                        String((custom[c] as any).hint || ''),
                                                        String(custom[c].instructions || ''),
                                                        String(cat.noun || 'record')),
                   budget: Number((custom[c] as any).budget) || 120 });
    }
    // [NARR-KIND] THE STEER IS APPLIED HERE BECAUSE THIS IS THE ONE RESOLVER. The
    // profile column, the reorder drill, the lorebook compile and the generator shim all
    // read through it, so a kind applied anywhere else would reach some of them and not
    // others. Only `hint` and `instructions` move: `label` is the lorebook line prefix and
    // must not change when the picker does.
    // CLONED, NOT MUTATED. `all` holds NARRATIVE_FACETS' own objects; steering in place
    // would rewrite the catalog for every record for the rest of the session.
    if (String((ent && ent.type) || '') === 'narrative') {
        var nkSteer: any = ceNarrativeKind(String((ent && ent.narrativeKind) || '')).steer || {};
        for (var s = 0; s < all.length; s++) {
            var sv = String(nkSteer[all[s].id] || '').trim();
            if (!sv) continue;
            all[s] = { id: all[s].id, slot: all[s].slot, kind: all[s].kind, scope: all[s].scope,
                       label: all[s].label, hint: sv, placeholder: all[s].placeholder,
                       instructions: String(all[s].instructions || '')
                                     + ' FOR THIS KIND OF THREAD SPECIFICALLY: ' + sv,
                       budget: all[s].budget };
        }
    }
    var order: string[] = (ent && ent.fieldOrder) || [];
    var byId: any = {};
    for (var i = 0; i < all.length; i++) { byId[all[i].id] = all[i]; }
    var out: any[] = [];
    var seen: any = {};
    for (var o = 0; o < order.length; o++) {
        var d = byId[String(order[o])];
        if (d && !seen[d.id]) { out.push(d); seen[d.id] = true; }
    }
    for (var j = 0; j < all.length; j++) {
        if (!seen[all[j].id]) { out.push(all[j]); seen[all[j].id] = true; }
    }
    return out;
}

function buildEntityProfilePayload(ent: any, cfg?: any): any {
    var cfv: any = (ent && ent.customFieldValues) || {};
    var fseed: any = (ent && ent.fieldSeeds) || {};
    var eType = String((ent && ent.type) || 'location');
    var defs: any[] = ceEntityOrderedDefs(ent, cfg || null);
    var rows: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        var fd = defs[i];
        var g = ceEntityFacetGroup(eType, fd);
        rows.push({
            id: fd.id,
            // The write key IS the storage address. See the header.
            key: 'cfv:' + fd.id,
            kind: fd.kind,
            label: fd.label,
            hint: fd.hint || '',
            instructions: fd.instructions,
            // [SEED-DURABLE] Carried on the same row as the value it steers, so _ceGenSpec
            // resolves both in one place and no renderer needs the record.
            seed: String(fseed[fd.id] || ''),
            value: String(cfv[fd.id] || ''),
            group: g,
            groupLabel: ceEntityGroupLabel(eType, g),
            // Carried so _ceGenSpec can prefer the catalog's own budget over the 150
            // floor it applies to character fields, which are all roughly one length.
            budget: fd.budget
        });
    }
    return {
        id: String((ent && ent.id) || ''),
        name: String((ent && ent.name) || 'Unnamed'),
        // [ITEM-CAT] Carried so a renderer that genuinely needs the record kind has
        // it without a second load. The renderers do not read it today and should not
        // start: `scope` is what they are allowed to know. It is here for the payload's
        // own branches and for the next type.
        entityType: eType,
        locationType: String((ent && ent.locationType) || ''),
        briefDescription: String((ent && ent.description) || ''),
        conceptDump: String((ent && ent.conceptDump) || ''),
        customFields: rows,
        // [LOC-PROFILE2] THE ADAPTER FLAG. Absent on every character payload, so
        // the char path is the untouched default and no existing call site changes meaning.
        scope: 'entity',
        // [LOC-PROFILE4] STORED WINS, ELSE SCAN -- the same arrangement
        // _ceResolveShape uses for a character. An existing location was authored entirely
        // in lorebookText and has answered no questions, so it opens in Classic and is
        // not confronted with sixteen empty boxes it did not ask for; one with a written
        // answer opens in the builder. A record that has neither opens in the builder,
        // because that is where a new place should start.
        pattern: '', flags: {}, hook: null,
        uiShape: _ceResolveEntShape(ent, rows)
    };
}

function _ceResolveEntShape(ent: any, rows: any[]): string {
    var stored = String((ent && ent.uiShape) || '');
    // [SHAPE-CUSTOM] 'custom' JOINS THE ALLOWLIST, and its absence is exactly why the
    // option did nothing. The picker wrote 'custom' to the record correctly; THIS function
    // then failed to recognise it and fell through to the content scan, which returns
    // 'builder' or 'classic' and never 'custom' -- so every read handed the surface one of
    // the other two and the select snapped back. A write that lands and a read that discards
    // it looks identical to a control that is not wired up.
    // NEVER SCANNED FOR, only honoured when stored: no arrangement of written prose says
    // "I do not want the builder's questions", so it is reachable only by choosing it.
    if (stored === 'classic' || stored === 'builder' || stored === 'custom') return stored;
    for (var i = 0; i < rows.length; i++) {
        if (String(rows[i].value || '').trim()) return 'builder';
    }
    if (String((ent && ent.lorebookText) || '').trim()) return 'classic';
    return 'builder';
}

// [LOC-PROFILE2] The two write verbs, chosen by payload scope. ONE HELPER RATHER
// THAN A TERNARY AT EACH CALL SITE: there are four, and a fifth added later that forgot
// the ternary would write a location's facet into a character record whose id happened to
// collide -- which, post-ENT-ID1, is every character's own body.
function _ceProfileWriteFor(p: any, recId: string, key: string, v: string): Promise<any> {
    return (p && String(p.scope || '') === 'entity')
        ? ceEntityWrite(recId, key, v)
        : ceProfileWrite(recId, key, v);
}
function _ceScopeOf(p: any): string {
    return (p && String(p.scope || '') === 'entity') ? 'entity' : 'char';
}

// -- Retired ------------------------------------------------------------------
// [LOC-PROFILE2] _ceEntityFacets AND _ceEntityFacetField ARE DELETED. They were a
// second profile renderer with a second sparse rule, a second group loop and a second
// generate strip. Recorded rather than silently dropped because the mistake is a general
// one: a surface that "needs the same thing with different data" needs the payload
// changed, not the renderer copied.
// -- Root ---------------------------------------------------------------------
function _ceEntityRoot(): any {
    ceEntityStoreInit();
    var ui = useStoreValue(ceUiStore);
    // [LOC-PROFILE] ANNOTATED `any`, as its sibling _ceEntityDrawer already is.
    // useStoreValue returns `{}` to tsc, so every read off this value was an untyped
    // error nobody was counting -- the same hole entityId sat in. Annotating states the
    // truth (the store is a bag) rather than papering over each access.
    var st: any = useStoreValue(ceEntityStore);
    var id = ui ? String(ui.entityId || '') : '';

    useEffect(function() { if (id) { cePublishEntity(id); } }, [id]);

    var back: any = ceBack();
    var backAddr: any = (ui && ui.back) || null;

    if (!st || !st.ready || st.id !== id) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    if (!st.ent) {
        return ceScreen(ceHeader(back), ceEmpty('That entity is no longer in the world.', null));
    }

    var ent: any = st.ent;
    var isLoc = (ent.type === 'location');
    // [F-28] THE PROFILE COLUMN GATE IS THE CATALOG, NOT THE TYPE. It read `isLoc`, which
    // was the last place this surface knew what a location was -- exactly the gate the
    // ITEM-CAT note said it had removed everywhere else. A faction has a catalog, so it gets
    // the column, the Generate buttons and the lorebook builder by asking the same question
    // every other consumer asks. isLoc survives for the BANNER only: a place's picture is a
    // 1216x832 landscape and a faction has no image slot at all.
    var hasCat = !!ceEntityCatalog(String(ent.type || ''));

    // [LOC-PROFILE2] DRILLS FIRST, exactly as ceProfileRoot does it: a full surface
    // swap with its own back control, before the root body is built at all. Identity,
    // Entity, Lorebook and Images are the four; everything that is not the profile column
    // lives in one of them.
    var drill = String(st.entDrill || '');
    if (drill) {
        // [LOC-PROFILE2] BACK OUT THE WAY IN. A drill reached from another surface has no
        // root behind it that the author asked to see -- for a character the entity root is a
        // name card and one button, which is the intermediary this route exists to skip. When
        // it was entered directly, Back is the SURFACE's back and leaves; otherwise it is the
        // root, as it has always been.
        var dDirect = !!back && (String(st.entDirect || '') === drill);
        var dBack = dDirect ? back : ceBtn('\u2190 ' + (ent.name || 'Back'), 'entdrill:back', function() {
            _ceEntDrill(''); return Promise.resolve();
        });
        var dBody: any = null;
        if (drill === 'identity')      { dBody = _ceEntityIdentityDrill(id, ent, st); }
        else if (drill === 'entity')   { dBody = _ceEntityGraphDrill(id, ent, st, backAddr); }
        else if (drill === 'images')   {
            dBody = (String(ent.type || '') === 'species')
                ? _ceEntitySpeciesImage(id, ent, st)
                : _ceEntityImage(id, ent, st);
        }
        // [LOC-PROFILE3] The same drill the character surface opens, on the same
        // renderer, reached through this surface's own drill state. See the Add button.
        else if (drill.indexOf('addfacet:') === 0) {
            dBody = st.p ? _ceProfileAddFacet(id, st.p, st.cfg || null, drill.slice(9))
                         : ceEmpty('No profile for this entity.', null);
        }
        // [ATMO] THE SAME DRILL THE CHARACTER SURFACE OPENS, in loc mode -- one editor,
        // two owners. `places` is null because a location's rows name no place.
        else if (drill === 'atmosphere') {
            dBody = _ceProfileScheduleDrill('loc', id, ent, st.cfg || null, null,
                                            Number(st.clockT) || 0, (ui && ui.open) || {});
        }
        else if (drill === 'order')     { dBody = _ceEntityOrderDrill(id, ent, st); }
        else if (drill === 'newfield')  { dBody = _ceEntityNewFieldDrill(id, st); }
        else if (drill === 'delfield')  { dBody = _ceEntityFieldsDrill(id, ent, st, (ui && ui.open) || {}); }
        else { dBody = ceEmpty(drill + ' has no renderer.', null); }
        return ceScreen(ceHeader(dBack), [dBody]);
    }

    // [LOC-PROFILE3] EVERY TOP-LEVEL CHILD IS KEYED, and this is a correctness
    // fix rather than tidying. ceScreen UNSHIFTS the header into this same array, so the
    // list length differs between a render with a header and one without; mix keyed and
    // unkeyed children in a list whose length moves and Preact matches the keyed ones by
    // key and the rest by POSITION, which is how the hero ended up under the profile
    // column on first open and how the description field ended up between the key list and
    // the button that adds to it. Either all keys or none -- and none is not an option
    // once any child is a list.
    var body: any[] = [];
    // [LOC-PROFILE4] THE IMAGE IS ITS OWN ROW. A location's picture is 1216x832 --
    // it is a banner, and beside a name block it squeezed both. Full width above the hero
    // costs one row and shows the actual shape of what lands there.
    if (isLoc) {
        body.push(ceWrap({ key: 'ent_banner' }, [
            ceImgFrame(id, CE_IMG_SLOT_AVATAR, 'banner', 'entdrill:images',
                       function() { _ceEntDrill('images'); },
                       ceIconIsSvg(ent.icon) ? '+' : (String(ent.icon || '') || '+'))
        ]));
    }
    body.push(ceWrap({ key: 'ent_hero' }, [ _ceEntityHero(id, ent, st)]));
    // [MILESTONE] UNDER THE HERO, above the launcher row, and only for a thread. It is the
    // one control on this surface whose effect is on the STORY rather than on the record,
    // which is why it sits with the name and not down among the questions.
    if (String(ent.type || '') === 'narrative') {
        body.push(ceWrap({ key: 'ent_active' }, [ _ceThreadActiveBtn(id, st)]));
    }

    // [F-29] THE FACTION'S THREE OWN PANELS, AS TABS ON THIS SURFACE. They are the only
    // things the deleted faction screen had that this one did not, and they are CONTENT THAT
    // STAYS -- which is why they are a tab strip and not three more launchers. A launcher is
    // a door that leaves (Map Entity, Lorebook, Journal); a tab partitions the body.
    //   THE HERO SITS ABOVE THE STRIP, not inside the Profile tab. The old screen had no
    //   header at all, so an author editing a ladder could not see whose ladder it was. One
    //   card is a cheap price for naming the record on every tab, and it is already the door
    //   to the identity fields.
    //   RESOLVED, NOT READ RAW. An unrecognised stored value falls to 'profile' by the same
    //   default Settings uses, so no migration is needed for anyone mid-session.
    var isFac = (String(ent.type || '') === 'faction');
    var facTab = isFac ? ceTabGet('entity', 'profile') : 'profile';
    if (!isFac || (facTab !== 'roster' && facTab !== 'standing' && facTab !== 'resources')) {
        facTab = 'profile';
    }
    if (isFac) {
        body.push(ceWrap({ key: 'ent_tabs' }, [ ceTabRow('entity', CE_FACTION_TABS, facTab)]));
    }
    // [MS-TAB] THE THREAD'S OWN STRIP, resolved the same way and for the same reason the
    // faction's is: ceTabSet namespaces by SURFACE, not by record type, so walking from a
    // faction's Roster tab to a thread would arrive holding 'roster'. An unrecognised value
    // falls to 'profile' rather than rendering nothing.
    var isThr = (String(ent.type || '') === 'narrative');
    var thrTab = isThr ? ceTabGet('entity', 'profile') : 'profile';
    if (!isThr || thrTab !== 'milestones') { thrTab = 'profile'; }
    if (isThr) {
        body.push(ceWrap({ key: 'ent_tabs' }, [ ceTabRow('entity', CE_THREAD_TABS, thrTab)]));
    }
    if (thrTab === 'milestones') {
        // [TABBODY-RECYCLE] KEYED BY TAB and by id, the same guard the faction bodies
        // carry: the milestone editor and the description field are both a well-styled
        // textarea at a similar depth, and an unkeyed body at a fixed position lets Preact
        // recycle one into the other and carry its text across the switch.
        body.push(ceWrap({ key: 'enttab:' + id + ':ms' }, [
            _ceThreadMilestones(id, st, (ui && ui.open) || {})]));
        body.push(ceWrap({ key: 'ent_del_ms' }, [ _ceEntityDeleteBlock(id, ent, st, backAddr)]));
        // [PROFILE-RETURN] Same as the root's tail: null with no address, a row with one.
        return ceScreen(back, body);
    }
    if (facTab !== 'profile') {
        var facBody: any = (facTab === 'roster')
            ? _ceFactionRoster(id, st)
            : ((facTab === 'standing') ? _ceFactionStanding(id, st) : _ceFactionStates(id, st));
        // [TABBODY-RECYCLE] KEYED BY TAB. The ladder's text boxes and the resource steppers
        // are the same shapes at the same depths; an unkeyed body at a fixed position lets
        // Preact recycle one tab's subtree into the other's and carry its values across the
        // switch. The id rides the key as well, so moving between two factions on the same
        // tab is a fresh subtree too.
        body.push(ceWrap({ key: 'enttab:' + id + ':' + facTab }, [facBody]));
        // [PROFILE-RETURN] Same as the root's tail: null with no address, a row with one.
        return ceScreen(back, body);
    }

    body.push(ceWrap({ key: 'ent_launch' }, [ _ceEntityLaunchers(id, ent)]));

    // [MAP-INLINE] THE MAP BLOCK IS NOT HERE, per user: it never belonged on the display.
    // This screen is what the STORY knows about a place; how it is drawn is a fact about the
    // map, and its two hosts are the two places an author is already looking at a map -- the
    // Map Entity drill and the hex map's own cell panel.

    // [NARR-COLUMN] THE GATE IS THE CATALOG, NOT THE SHAPE. It read
    // ceEntityHasShape, which made "has a Classic/Builder toggle" a prerequisite for having
    // a profile column at all -- so a narrative, whose catalog deliberately carries no
    // `shape` (it never had entry text to preserve), fell past this branch, past the item
    // literal below it, and into the no-catalog fallback that renders a description and
    // nothing else. That is the whole of the reported symptom. The F-28 note below still
    // holds: the ITEM branch stays a type literal because it carries Held and Bonuses,
    // which are facts about an item and not about having a catalog. This one is general,
    // and now actually is.
    //   THE TOGGLE IS WHAT IS CONDITIONAL, not the column. A type with no shape is always
    //   in the builder, because there is no second authoring model to choose between.
    if (hasCat && st.p && String(ent.type || '') !== 'item') {
        var hasShape = ceEntityHasShape(String(ent.type || ''));
        var shape = hasShape ? String(st.p.uiShape || 'builder') : 'builder';
        if (hasShape) {
            body.push(ceWrap({ key: 'ent_shape' }, [
                // [SHAPE-CUSTOM] THE THIRD OPTION REACHES ENTITIES TOO, which is the
                // half of the request that is not about characters: a faction, a location or
                // a species an author wants to describe their own way should not scroll past
                // the builder's questions either. Same vocabulary as the character picker
                // for the third entry, different for the first two, which is exactly what
                // the `defs` argument is for.
                _ceShapePicker(id, shape,
                    [{ id: 'builder', label: 'Lorebook Builder' },
                     { id: 'classic', label: 'Classic' },
                     { id: 'custom',  label: 'Custom fields only' }],
                    st.p)
            ]));
        }

        var rows: any[] = [];
        if (shape === 'custom') {
            // [SHAPE-CUSTOM] SAME RULE AS THE CHARACTER SURFACE: only fields the
            // author defined, no built-in questions above them.
            // DESCRIPTION SURVIVES, and it is the one exception on this surface rather than
            // an inconsistency with the character side. It is shape-INDEPENDENT already --
            // the Classic and Builder branches both render it -- because it feeds the world
            // list and every Generate button here. Hiding it would break the surface rather
            // than declutter it, which is not what "custom fields only" is asking for.
            rows.push(ceWrap({ key: 'ent_desc' }, [ _ceEntityDescription(id, ent)]));
            if (String(ent.type || '') === 'species') {
                rows.push(ceWrap({ key: 'ent_splist' }, [ _ceEntitySpeciesList(id, ent)]));
            }
            // [SHAPE-CUSTOM][ENT-CF-EVERY] THE AUTHOR'S OWN FIELDS, AND THE DOORS THAT
            // DEFINE AND REMOVE THEM. Without them the shape was a dead end: it hid the
            // built-in questions and then offered no way to ask any of your own, so
            // choosing it emptied the screen and left nothing to do on it. It is the SAME
            // block the builder and Classic render -- one assembly, three shapes -- so a
            // custom field looks and writes identically in all of them, and the group is
            // rendered whether or not anything is in it because otherwise the door
            // disappears at exactly the moment it is needed.
            rows.push(ceWrap({ key: 'ent_g_custom' }, [ _ceEntityCustomBlock(id, st, String(ent.type || ''))]));
        } else if (shape === 'classic') {
            // [SPEC-BODY] THE LIST TOGGLE IS NOT BUILDER-ONLY. It was pushed in the builder
            // branch alone, and EVERY MIGRATED SPECIES IS CLASSIC by construction (see
            // ceMigrateSpeciesToEntities) -- so the one control that moves a record to the
            // Bestiary was unreachable for precisely the records that arrived on the wrong
            // list, and the only way to it was a shape toggle that changes how the record is
            // authored. Same placement argument as the builder copy: directly above the
            // description whose destination it decides.
            if (String(ent.type || '') === 'species') {
                rows.push(ceWrap({ key: 'ent_splist' }, [ _ceEntitySpeciesList(id, ent)]));
            }
            // CLASSIC IS THE ONE FIELD AND ITS GENERATOR, nothing else -- the shape every
            // location in every existing story was authored in. It is not a reduced
            // builder: the two describe the same place by different means and exactly one
            // is shown, which is the same exclusivity rule uiShape enforces for characters.
            // Description is shape-independent: it feeds the world list and the generators
            // in both, so Classic is not a reason to lose it.
            rows.push(ceWrap({ key: 'ent_desc' }, [ _ceEntityDescription(id, ent)]));
            rows.push(ceWrap({ key: 'ent_classic' }, [ _ceEntityClassic(id, ent)]));
            // [ENT-CF-EVERY] AND THE AUTHOR'S OWN FIELDS BELOW THE PROSE. Classic replaces
            // CE'S QUESTIONS with one block of lore; it does not replace the author's. A
            // field defined on this project is asked of every record of this type, and a
            // record that happens to be authored as prose is still one of them -- it
            // compiles into the same entry, under its own label, after the body.
            rows.push(ceWrap({ key: 'ent_g_custom' }, [ _ceEntityCustomBlock(id, st, String(ent.type || ''))]));
        } else {
            // [LORE-ONE-FIELD] A BUILDER-SHAPED RECORD THAT STILL HOLDS A BODY KEEPS ITS
            // EDITOR, and this clause is the "redirect" half of removing the drill's copy.
            // _ceResolveEntShape returns 'builder' as soon as ANY facet is answered, so a
            // record with both a legacy body and one answered question rendered its body
            // ONLY in the Lorebook drill. Delete that drill without this and the text
            // becomes uneditable while still compiling into the entry -- invisible and
            // active, the worst of both.
            //   CONDITIONAL ON CONTENT, so a record that never had a body does not gain a
            //   box inviting one. That is the deprecation working: no new writing here.
            if (String(ent.lorebookText || '').trim()) {
                rows.push(ceWrap({ key: 'ent_classic_legacy' }, [ _ceEntityClassic(id, ent)]));
            }
            // THE PROFILE COLUMN. The same loop ceProfileRoot runs over
            // CE_FIELD_GROUP_ORDER, over CE_LOC_GROUP_ORDER instead, through the same
            // _ceProfileGroup. Concept notes lead, because every Generate button below
            // reads from them.
            // [MS-TAB] THE CONTEXT LIST LEADS ON A THREAD, above the description it
            // feeds. Every Generate button on this column reads it, so it has to be
            // choosable BEFORE the first thing is generated rather than found underneath
            // the questions it was supposed to inform.
            if (String(ent.type || '') === 'narrative') {
                rows.push(ceWrap({ key: 'ent_tctx' }, [
                    _ceThreadContext(id, ent, st, (ui && ui.open) || {})]));
            }
            rows.push(ceWrap({ key: 'ent_desc' }, [ _ceEntityDescription(id, ent)]));
            // [MS-TAB] NO CONCEPT DUMP ON A THREAD, per user. It is raw seed material for a
            // record the author is inventing from nothing; a thread is assembled from things
            // the story already has -- the lenses, the resolved archive, the chosen context
            // records -- and every one of those already reaches the generators. A second
            // free-text box feeding the same prompt is a second place to say the same thing.
            if (String(ent.type || '') !== 'narrative') {
                rows.push(ceWrap({ key: 'ent_concept' }, [ _ceEntityConcept(id, ent)]));
            }
            // [F-32 SPEC-LIST] THE LIST TOGGLE SITS DIRECTLY ABOVE WHAT IT DECIDES, which is
            // the placement argument NARR-COLUMN made for the thread kind one field down: a
            // control two taps from its own effect reads as decoration. It is the only thing
            // on this surface whose effect is on a lorebook entry rather than on the record.
            if (String(ent.type || '') === 'species') {
                rows.push(ceWrap({ key: 'ent_splist' }, [ _ceEntitySpeciesList(id, ent)]));
            }
            // [NARR-COLUMN] NO OWNER ON A THREAD. "Who holds this" is a question about a
            // place or a thing; a thread is held by nobody, and the picker offered an
            // answer that would have gone straight into every Generate button as fact.
            // [F-32] AND NO OWNER ON A SPECIES, for the reason NARR-COLUMN gives about a
            // thread: "who holds this" is a question about a place or a thing. A kind is held
            // by nobody, and the picker would have offered an answer that went straight into
            // every Generate button on this column as fact.
            if (String(ent.type || '') !== 'narrative' && String(ent.type || '') !== 'species') {
                rows.push(ceWrap({ key: 'ent_owner' }, [ _ceEntityOwner(id, ent, st)]));
            } else if (String(ent.type || '') === 'narrative') {
                // [NARR-COLUMN] THE KIND SITS DIRECTLY ABOVE WHAT IT STEERS. It was in the
                // Identity drill beside the name, which is where a locationType belongs
                // because that IS the record's identity -- but a thread kind is not what the
                // thread is, it is how the five questions are asked, and a control two taps
                // from its own effect reads as decoration.
                rows.push(ceWrap({ key: 'ent_narrkind' }, [ _ceEntityNarrKind(id, ent)]));
            }
            // [F-28] THE RECORD'S OWN TYPE, not the literal 'location'. Three hardcoded
            // strings here were the whole reason a second type could not use this column.
            var eType: string = String(ent.type || 'location');
            var lGroups: string[] = ceEntityGroupOrder(eType);
            for (var gi = 0; gi < lGroups.length; gi++) {
                var gid = lGroups[gi];
                var gExtra: any[] = (gid === 'custom') ? _ceEntityCustomKids(id, eType, st) : [];
                rows.push(ceWrap({ key: 'ent_g_' + gid }, [
                    _ceProfileGroup(id, st.p, st.cfg || null,
                                    { id: gid, label: ceEntityGroupLabel(eType, gid) }, gExtra)]));
            }
            rows.push(ceWrap({ key: 'ent_reorder' }, [
                ceBtn('Reorder fields\u2026', 'ent:reorder:' + id, function() {
                    _ceEntDrill('order'); return Promise.resolve();
                })
            ]));
        }
        body.push(ceStack({ gap: CE_T.s5, padTop: CE_T.s4, key: 'ent_col' }, rows));
    // [F-28] STAYS A TYPE LITERAL, DELIBERATELY. Generalising this branch off the catalog
    // looked right and is a trap: it carries Held and Bonuses, which are facts about an ITEM
    // and not about having a catalog. A fourth catalogued type without `shape` would fall in
    // here and be given an equip switch. The branch ABOVE is the general one.
    } else if (ent.type === 'item') {
        // [ITEM-CAT] THE SAME COLUMN, OVER THE ITEM'S OWN CATALOG -- the same loop,
        // the same _ceProfileGroup, the same field renderers, over a catalog that starts
        // empty. Only the group order and the config array differ, and both come off the
        // table rather than out of this branch.
        //
        // NO SHAPE TOGGLE. uiShape exists for locations because every place in every
        // existing story was authored in lorebookText before the builder existed, and
        // confronting one of those with sixteen empty boxes would be a regression. An item
        // has no such history -- its questions did not exist until now, so there is no
        // earlier authoring model to preserve and nothing to choose between. Its extra
        // entry text stays in the Lorebook drill, where it already was.
        //
        // HELD SITS ABOVE THE QUESTIONS. It is the only part of an item that changes during
        // play; the fields below it are what the item IS.
        var iRows: any[] = [];
        iRows.push(ceWrap({ key: 'ent_desc' }, [ _ceEntityDescription(id, ent)]));
        iRows.push(ceWrap({ key: 'ent_hold' }, [ _ceEntityHolding(id, ent, st)]));
        iRows.push(ceWrap({ key: 'ent_concept' }, [ _ceEntityConcept(id, ent)]));
        // [F-11] Bonuses sit with Held, above the questions, for the reason stated there:
        // both are what the item DOES during play, the fields below are what it IS.
        iRows.push(ceWrap({ key: 'ent_bonus' }, [ _ceEntityBonuses(id, ent, st)]));
        // THE QUESTIONS NEED THE PAYLOAD AND THE REST DOES NOT. cePublishEntity builds one
        // for every catalogued type, so st.p is present in normal operation; a failed
        // publish keeps the previous value (stale beats blank) and only on the very first
        // open could it be null. Description and Held are record reads and still render
        // there -- losing the questions for one repaint is a gap, losing the equip switch
        // would be a dead surface.
        if (st.p) {
            var iGroups: string[] = ceEntityGroupOrder('item');
            for (var ii = 0; ii < iGroups.length; ii++) {
                var igid = iGroups[ii];
                var iExtra: any[] = (igid === 'custom') ? _ceEntityCustomKids(id, 'item', st) : [];
                iRows.push(ceWrap({ key: 'ent_g_' + igid }, [
                    _ceProfileGroup(id, st.p, st.cfg || null,
                                    { id: igid, label: ceEntityGroupLabel('item', igid) }, iExtra)]));
            }
            iRows.push(ceWrap({ key: 'ent_reorder' }, [
                ceBtn('Reorder fields\u2026', 'ent:reorder:' + id, function() {
                    _ceEntDrill('order'); return Promise.resolve();
                })
            ]));
        }
        body.push(ceStack({ gap: CE_T.s5, padTop: CE_T.s4, key: 'ent_col' }, iRows));
    } else if (!isLoc) {
        // A type with no catalog. Description is universal; a plot node and a character
        // body are graph objects and get nothing else.
        body.push(ceWrap({ key: 'ent_desc_np' }, [ _ceEntityDescription(id, ent)]));
    }

    // [G-01] LAST BLOCK ON THE PROFILE, past everything an author would be editing. It is
    // keyed like every other top-level child (see the note above `body`).
    body.push(ceWrap({ key: 'ent_del_g' }, [ _ceEntityDeleteBlock(id, ent, st, backAddr)]));

    // [LOC-PROFILE3] NO HEADER ON THE ROOT -- UNLESS SOMETHING SENT US HERE. The rule
    // holds for its own reason: the shell's nav row is already the way back to Scene, so a
    // second back control said the same thing twice and cost a line on every screen.
    //
    // [PROFILE-RETURN] IT WAS NOT TRUE OF A NAV THAT CARRIED A RETURN ADDRESS. The shell's
    // nav row goes back to a TAB; it cannot go back to the Build route's stage and scope,
    // which is a position inside a tab and the only thing the author actually wants back.
    // BUILD-ONE-ROUTE says the pipeline "reaches out to a profile and keeps a way back to
    // itself" -- ceScopeBackAddr built the address, ceNav stored it, ceBack rendered the
    // button and this line threw it away. A promise kept everywhere but the last step.
    //
    // ceBack() IS ALREADY THE CONDITION. It returns null with no address, so every direct
    // visit renders exactly as it did and only a nav that supplied one gains the row. The
    // drills above have varied their header this way all along, on the same value.
    return ceScreen(back, body);
}

// -- Classic  [LOC-PROFILE4] --------------------------------------------------
// The single lorebook body and its generator. Deliberately NOT a cut-down builder and
// deliberately not the deprecated-labelled block from the Lorebook drill either: this is
// the authoring model, chosen, so it says what it is for rather than apologising.
function _ceEntityClassic(id: string, ent: any): any {
    // [SPEC-BODY] THE NOUN COMES OFF THE COPY TABLE, which is where every other word on this
    // surface gets one. "this place" was written when a location was the only type with a
    // shape toggle; a species has one too, and being told its lore box is about a place is
    // the same wrongness CE_ENT_DESC_COPY was made a table to end.
    // AND THE IDENTITY-LINE CLAUSE IS CONDITIONAL, because ceEntityIdentityLine returns ''
    // for a species by construction -- promising an opening line that cannot appear is how
    // an author concludes the entry is broken.
    var clNoun = String(_ceEntDescCopy(ent).noun);
    var clHasId = (String(ent.type || '') !== 'species');
    return ceGroup('Lorebook entry', ceStack(CE_T.s3, [
        ceProse('t3',
            'One block of prose, written or generated as a whole. Everything the story should know about this '
            + clNoun + ' goes here'
            + (clHasId
                ? ' \u2014 the identity line is added above it automatically.'
                : ', and it is injected when the name is mentioned rather than sitting in context permanently.')),
        h(ceField, {
            key: 'ent_classic_f', k: 'ent:lore:' + id, label: '',
            value: ent.lorebookText || '', multiline: true, rows: 8, well: true,
            placeholder: 'History, secrets, rules, reputation, who to expect\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'lorebookText', v); }
        }),
        ceWrap({ key: 'ent_classic_gen' }, [ _ceEntGenBtn(id, ent, 'lorebookText')])
    ]));
}

// -- Held & equipped  [ITEM-HOLD] ---------------------------------------------
// A ROW ON THE ITEM, NOT A DRILL. The drill this replaces was a whole surface holding one
// sentence and one button -- a door in front of a fact you could have just read.
//
// TWO CONTROLS, TWO QUESTIONS, per user: "the equip button should be a toggle separate
// from the picker for who it is under." The single picker that used to stand here answered
// both at once -- choosing a person WAS equipping them -- so there was no way to say a
// thing is in someone's hands but not worn, and no way to take it off without also saying
// nobody has it. WHERE IT IS is parentId, the same graph fact every other entity carries,
// asked through the same entityParent def the rest of the world uses. WHETHER IT IS WORN
// is isEquipped, and a boolean is a switch.
//
// FUNCTIONAL STATE, NOT AUTHORSHIP. Both halves are about RIGHT NOW. Never read as
// ownership -- ceOwnerContext says why a sword does not take after whoever is holding it
// this turn.
//
// THE TOGGLE IS ONLY OFFERED WHEN A PERSON IS HOLDING IT. aeSetEquip's second half writes
// the CHARACTER'S equippedItemIds; with no character there is no second half, so an
// "equipped" item lying on a table would be a half-written fact by construction. It stays
// offered while a stale on-state exists, because the author has to be able to switch that
// off.
//
// THE VERB IS ceEntitySetEquip, which owns both sides of the fact. Nothing here writes
// isEquipped through ceEntityWrite -- see EQUIP-STATE-SYNC.
// [F-11] What this item adds to its wearer's rolls. ITEMS CARRY STATES; the reference
// runs down into the state catalog and never back up, so deleting a def never walks the
// world graph and a stale defId simply stops resolving (the row disappears, the item is
// fine).
// ONLY MODIFIER DEFS ARE OFFERED. A bonus to Currency is not a thing a sword can have --
// attach:'modifier' is the permission and ceStateApproaches is not used here on purpose,
// because an author may define a fifth approach and gear should reach it.
function _ceEntityBonuses(id: string, ent: any, st: any): any {
    var cfg: any = st.cfg || null;
    var mods: any[] = ceStateDefs(cfg).filter(function(d: any) { return ceStateIsModifier(d); });
    var cur: any[] = Array.isArray(ent.bonuses) ? ent.bonuses : [];

    if (!mods.length) {
        return ceGroup('Bonuses', ceSub('t3',
            'No state feeds rolls yet. Switch on \u201cFeeds rolls\u201d for a state in Settings \u203a States '
            + 'and it becomes something this item can add to.'));
    }

    var amountOf = function(defId: string): number {
        for (var i = 0; i < cur.length; i++) {
            if (cur[i] && String(cur[i].defId) === String(defId)) return Number(cur[i].amount) || 0;
        }
        return 0;
    };
    var setAmount = function(defId: string, n: number): Promise<any> {
        return ceEntityOp(async function() {
            try {
                var e: any = await loadEntity(id);
                if (!e) return;
                var next: any[] = (Array.isArray(e.bonuses) ? e.bonuses : []).filter(function(b: any) {
                    return b && String(b.defId) !== String(defId);
                });
                // ZERO IS NOT STORED. A bonus of +0 is the absence of a bonus, and keeping
                // the row would make "has a bonus to Force" untrue for every item an author
                // ever opened and closed.
                if (n) next.push({ defId: String(defId), amount: Math.round(n) });
                e.bonuses = next;
                await saveEntity(e);
                await cePublishEntity(id);
            } catch (er) { api.v1.error('[AE:jsxentity] bonus set failed:', er); }
        });
    };

    var rows: any[] = [];
    for (var i = 0; i < mods.length; i++) {
        (function(d: any, idx: number) {
            var amt = amountOf(d.id);
            // [SS8b] Same class as the States drill: a field in the trail means the value
            // slot cannot also carry words. No nudge here -- a bonus is set, not walked.
            rows.push(ceStepperRow({
                k: 'ent:bonus:' + id + ':' + d.id, label: d.name, value: amt, zebraIndex: idx,
                sub: amt ? ceSub('t2', (amt > 0 ? '+' : '') + amt + ' while worn')
                         : ceSub('t3', 'no bonus'),
                onCommit: function(n: number) { return setAmount(d.id, n); }
            }));
        })(mods[i], i);
    }
    return ceGroup('Bonuses', ceStack(null, rows));
}

function _ceEntityHolding(id: string, ent: any, st: any): any {
    var parentId = String(ent.parentId || '');
    var idx: any[] = st.index || [];
    var pType = '';
    for (var i = 0; i < idx.length; i++) {
        if (idx[i] && String(idx[i].id) === parentId) { pType = String(idx[i].type || ''); break; }
    }
    var pName = String(st.parentName || '');
    var onBody = !!parentId && pType === 'character';
    var worn = !!(ent as any).isEquipped;
    var kids: any[] = [];
    kids.push(ceWrap({ key: 'ent_hold_who' }, [ cePickerRow({
        kind: 'entityParent', ctx: { id: id },
        label: '', value: pName,
        placeholder: 'Nowhere \u2014 loose in the world',
        hint: onBody
            ? ('In ' + pName + '\u2019s hands. Holding is not owning \u2014 a thing taken off a body is held by whoever took it and still belongs to whoever it belonged to.')
            : 'Where this thing is: the place it sits in, or the person carrying it. Only a person can wear or wield it.'
    })]));
    kids.push(ceWrap({ key: 'ent_hold_eq' }, [ ceSettingRow('Equipped',
        onBody
            ? ('Worn or wielded by ' + pName + ' rather than just carried. While this is on, the description above folds into their own lorebook entry and is rebuilt every generation.')
            : 'Put it in someone\u2019s hands above first \u2014 there is nobody for it to be worn by.',
        (onBody || worn)
            ? ceToggle(worn, 'ent:equip:' + id, function() {
                return ceEntitySetEquip(id, !worn);
              }, 'Equipped')
            : null)]));
    // Worn by nobody. Says so rather than showing an on switch with no owner beside it,
    // because "carried but not worn" and "marked worn with the holder gone" are different
    // problems and only the second one needs fixing. Reachable from records written by the
    // picker this block replaced, which set equippedToCharId without ever setting parentId.
    if (worn && !onBody) {
        kids.push(ceProse('t3',
            'Marked as equipped, but nothing that can wear it is holding it. Switch it off, or choose the person who has it.',
            { key: 'ent_hold_warn' }));
    }
    return ceGroup('Held', ceStack(CE_T.s2, kids));
}

// -- Owner  [LOC-PROFILE5] ----------------------------------------------------
// ITS OWN ROW RATHER THAN PART OF Control. Control is a written answer about permission
// and consequence; this is a resolvable id, and the two are different kinds of thing even
// though they answer the same question. Above the groups because it feeds the Control
// generator as context rather than the other way round.
// [MILESTONE] THE FOCUS CONTROL. UNDER the hero and not inside it: the hero card is one
// tap that opens the identity drill, and a button living inside a card that is itself a
// button is two targets fighting over one rectangle.
//   THE STATE IS THE LABEL. ceThreadSetActive treats a second tap on the same thread as a
//   clear, so this is its own undo and there is no separate "stop" competing for the row.
function _ceThreadActiveBtn(id: string, st: any): any {
    var on = !!st.msActive;
    return ceStack(CE_T.s1, [
        ceWrap(null, [
            ceBtn(on ? '\u2605 Active thread' : 'Make this the active thread',
                  'thr:active:' + id, function() { return ceThreadSetActive(id); },
                  on ? 'primary' : undefined)
        ]),
        ceProse('t3', on
            ? 'Its current milestone is the first line of the Author\u2019s Note every turn. Tap again to stop.'
            : 'One thread at a time reaches the story. Whichever is active puts its current milestone at the top of the Author\u2019s Note.')
    ]);
}

// [MILESTONE] THE CURRENT MILESTONE AND ITS ARCHIVE. One editable line, a target, and one
// verb -- Resolve. Everything else on this block is a read.
function _ceThreadMilestones(id: string, st: any, openMap: any): any {
    var doc: any = st.ms || { current: null, archive: [] };
    var cur: any = doc.current || null;
    var arch: any[] = doc.archive || [];
    var tName = String((st.msTargets || {})[String((cur && cur.targetId) || '')] || '');
    var kids: any[] = [];

    kids.push(ceProse('t3',
        'The next most immediate objective or challenge \u2014 one of them, not a plan. While this thread is active it is the first line of the Author\u2019s Note, so write it as the thing that should happen next rather than as a description of the thread.'));

    kids.push(h(ceField, {
        key: 'ms_cur', k: 'ms:cur:' + id, label: '',
        value: String((cur && cur.text) || ''), multiline: true, rows: 3, well: true,
        placeholder: 'What has to happen next\u2026',
        onCommit: function(v: string) { return ceMilestoneOp(id, 'set', v); }
    }));

    // [MS-GEN] THE SAME STRIP EVERY OTHER GENERATOR IN THE FILE RENDERS, on a third scope.
    // The steer field, the count, the draw method and the candidate cards are all _ceGenBtn's
    // -- this only names the slot. The write key is CE_MS_FIELDKEY rather than a field id
    // because a thread has one slot, and the strip keys its open state on
    // (charId, fieldKey), so two threads can never share one open picker.
    //   OFFERED WHETHER OR NOT ONE IS WRITTEN. Regenerating over a milestone you have and
    //   asking for a first one are the same act, and the shim excludes the current text
    //   either way so a regenerate is not handed its own last answer.
    kids.push(ceWrap({ key: 'ms_gen' }, [
        _ceGenBtn(null, id, CE_MS_FIELDKEY, 'Milestone',
                  CE_MS_INSTRUCTIONS, 70,
                  'Reads this thread\u2019s five questions, everything already resolved on it, the records you chose above, and where the story currently stands. Each candidate is a different KIND of next beat, not the same one louder.',
                  'milestone')
    ]));

    if (cur) {
        kids.push(cePickerRow({
            label: 'Target', value: tName,
            kind: 'milestoneTarget', ctx: { id: id },
            placeholder: 'Nothing in particular',
            hint: 'Optional. A place, a person or a thing the next step is aimed at.'
        }));
        kids.push(_ceThreadEncounter(id, st));
        kids.push(ceWrap(null, [
            ceBtn('Resolve', 'ms:resolve:' + id, function() {
                return ceMilestoneOp(id, 'resolve', null);
            }, 'primary')
        ]));
        kids.push(ceProse('t3',
            'Resolving files this below and leaves the slot empty. Nothing is generated for you \u2014 write or ask for the next one when you know what it is.'));
    }

    if (arch.length) {
        var aNodes: any[] = [];
        for (var i = 0; i < arch.length; i++) {
            aNodes.push((function(m: any) {
                var stampA = String(m.stamp || '');
                return ceStack({ gap: CE_T.s1, key: 'msa_' + m.id }, [
                    stampA ? ceMono(stampA, { opacity: CE_OP.t3 }) : null,
                    ceProse('t2', String(m.text || '')),
                    ceInline(CE_T.s2, [
                        // [MILESTONE] COPY, NOT A HANDOFF INTO THE COMPOSER, per user. The
                        // journal composer's value is '' by construction (FIELD-KEYLESS
                        // clears it through `seed`), so seeding it would mean giving that
                        // field a second source of truth -- for a step the author can do
                        // with one tap and a paste.
                        ceBtn('Copy', 'ms:copy:' + m.id, function() {
                            return _ceMilestoneCopy(String(m.text || ''));
                        }),
                        ceBtn('Reopen', 'ms:reopen:' + m.id, function() {
                            return ceMilestoneOp(id, 'unarchive', String(m.id));
                        }),
                        ceBtn('Delete', 'ms:drop:' + m.id, function() {
                            return ceMilestoneOp(id, 'drop', String(m.id));
                        }, 'danger')
                    ])
                ]);
            })(arch[i]));
        }
        kids.push(ceAccordion({
            id: 'ms:arch:' + id,
            label: 'Resolved',
            open: !!openMap['ms:arch:' + id],
            summary: _ceTrim(String(arch[0].text || ''), 60),
            meta: String(arch.length),
            children: ceStack(CE_T.s3, [
                ceProse('t3',
                    'Never injected. These are what the next milestone is generated FROM \u2014 and are worth copying into the journal, where they become part of the story record.'),
                ceStack(CE_T.s4, aNodes)
            ])
        }));
    }

    return ceGroup('Milestone', ceStack(CE_T.s3, kids));
}

// [EVT-MIRROR] THE THREE PRESSES THIS SURFACE NEEDS, and every one is a thin press-to-verb
// exactly as the Actions panel's are. NO SECOND COPY of "one at a time", of what concluding
// costs, or of which shape carries which wager: ceMilestoneOp's event ops own all of it, and
// both doors press the same three.
//   THE SHAPE PICK IS A DRAFT ON THE STORE, not a write. Nothing is decided until Begin, so
//   choosing one must not touch storage -- the same call _ceActionsEvDraft makes and for the
//   same reason.
function _ceThreadEvPick(shapeId: string): Promise<any> {
    if (!ceEntityStore) return Promise.resolve(null);
    try {
        ceEntityStore.set(function(st: any) {
            var next: any = {}; var k: string;
            for (k in st) { if (Object.prototype.hasOwnProperty.call(st, k)) next[k] = st[k]; }
            next.msEvPick = String(shapeId || '');
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxentity] encounter shape pick:', e); }
    return Promise.resolve(null);
}

// [EVT-MIRROR] THE ASYMMETRY BETWEEN THE TWO DOORS, AND IT IS THE RIGHT ONE. The Actions
// panel asks for a line because it may be starting from nothing; here the milestone is
// already written and already on screen, and event.begin ADOPTS a standing milestone rather
// than minting a second one. So this door asks one question instead of two, and passing no
// text is what tells the op to keep what is there.
//   IT REFUSES WITH A REASON. A blank milestone and a shape would mint an encounter whose
//   arc line is empty, which injects a bare band label every turn with nothing to attach it
//   to -- the op already returns null for that case, silently, and silence here reads as a
//   dead button.
async function ceThreadEvBegin(threadId: string): Promise<any> {
    var st: any = null;
    try { st = ceEntityStore ? ceEntityStore.get() : null; } catch (e) { st = null; }
    var shapeId = String((st && st.msEvPick) || '');
    if (!shapeId) {
        try { api.v1.ui.toast('Choose a shape first.', { type: 'info', autoClose: 2500 }); } catch (e1) {}
        return null;
    }
    var curTxt = String((st && st.ms && st.ms.current && st.ms.current.text) || '').trim();
    if (!curTxt) {
        try { api.v1.ui.toast('Write the milestone first \u2014 it is what the encounter is about.',
            { type: 'info', autoClose: 3000 }); } catch (e2) {}
        return null;
    }
    try {
        await ceMilestoneOp(String(threadId), 'event.begin', { shapeDefId: shapeId, text: '' });
    } catch (e3) { api.v1.error('[AE:jsxentity] encounter begin:', e3); }
    await _ceThreadEvPick('');
    return null;
}

// CONCLUDE ARCHIVES THE MILESTONE, CANCEL LEAVES IT STANDING. Two buttons and not one, and
// the wording is the Actions panel's word for word -- the same decision reached from two
// surfaces must not be described two ways.
function ceThreadEvEnd(threadId: string, op: string): Promise<any> {
    return ceMilestoneOp(String(threadId), String(op), null);
}

// Clipboard is a PERMISSIONED API and the request is made at the tap, not at load --// Clipboard is a PERMISSIONED API and the request is made at the tap, not at load --
// the same shape the Generation Diagnostics copy button already uses.
function _ceMilestoneCopy(text: string): Promise<any> {
    var t = String(text || '');
    if (!t) return Promise.resolve(null);
    return api.v1.permissions.request('clipboardWrite', 'Copy a resolved milestone so you can paste it into the journal.')
        .then(function(granted: boolean) {
            if (!granted) { try { api.v1.ui.toast('Clipboard permission denied.', { type: 'warning' }); } catch (e1) {} return null; }
            return api.v1.clipboard.writeText(t).then(function() {
                try { api.v1.ui.toast('Copied \u2014 paste it into the journal.', { type: 'success', autoClose: 2500 }); } catch (e2) {}
                return null;
            });
        }).catch(function(eC: any) {
            try { api.v1.ui.toast('Copy failed: ' + String((eC && eC.message) || eC), { type: 'error' }); } catch (e3) {}
            return null;
        });
}

// [EVT-MIRROR] THE OTHER DOOR ONTO AN ENCOUNTER, and the one that was missing. An encounter
// is a milestone's mechanical function, so the place a milestone is written is the place it
// should be possible to grade one -- an author who has just typed "get past the gate guard"
// should not have to leave for another surface to make it a thing that takes several rolls.
//   IT SITS UNDER TARGET AND ABOVE RESOLVE, which is the order of the decisions: what has to
//   happen, what it is aimed at, how it is graded, and then whether it is done.
//   TWO CONTROLS AND A BUTTON, one fewer than the Actions panel, and the missing one is the
//   description -- it is the field directly above this block. Asking for it twice is how the
//   two copies come to disagree.
function _ceThreadEncounter(id: string, st: any): any {
    var ev: any = st.msEv || null;
    var shapes: any[] = st.msEvShapes || [];
    var kids: any[] = [];

    if (ev) {
        if (ev.gone) {
            kids.push(ceSub('t3', 'Its shape has been deleted \u2014 there is no track left to '
                + 'move, but the encounter can still be concluded or cancelled.'));
        } else {
            var span = Math.max(1, Number(ev.hi) - Number(ev.lo));
            var frac = Math.max(0, Math.min(1, (Number(ev.value) - Number(ev.lo)) / span));
            var pol = Number(ev.pol) || 0;
            kids.push(ceBar({ gap: CE_T.s2 }, [
                ceSub('t3', String(ev.shapeName)),
                (pol > 0 ? ceMeter(frac, CE_GAUGE_UP)
                         : (pol < 0 ? ceMeter(frac, CE_GAUGE_DOWN) : ceMeter(frac))),
                ceSub('t3', String(ev.value) + '/' + String(ev.hi))
            ]));
            if (ev.line) kids.push(ceProse('t2', String(ev.line)));
        }
        // THE ROLLS ARE NOT HERE AND THE PANEL IS NAMED. This surface begins and ends an
        // encounter; it does not advance one, because advancing one is a roll and a roll is
        // the Actions panel's whole subject. Saying where rather than duplicating it there.
        kids.push(ceSub('t3', ev.stakeName
            ? ('Its wager: ' + String(ev.stakeName) + '. Rolls on the Actions panel move it.')
            : ('This shape has no wager, so nothing moves the track. Give it one under '
               + 'Settings \u203a States \u203a ' + String(ev.shapeName || 'the shape') + '.')));
        kids.push(ceInline(CE_T.s2, [
            ceBtn('Conclude', 'thr:ev:done:' + id, function() {
                return ceThreadEvEnd(id, 'event.conclude');
            }),
            ceBtn('Cancel encounter', 'thr:ev:cancel:' + id, function() {
                return ceThreadEvEnd(id, 'event.cancel');
            }, 'danger')
        ]));
        kids.push(ceProse('t3',
            'Concluding files this milestone below with where the track ended stamped onto it. '
            + 'Cancelling takes the grading off and leaves the milestone standing \u2014 for the '
            + 'fight the story walked past rather than the one that finished.'));
    } else if (st.msEvBusy) {
        // ONE AT A TIME, AND SAID PLAINLY. The op refuses this with a toast; a button that
        // only explains itself after being pressed is a button that looks broken.
        kids.push(ceSub('t3', 'An encounter is already running somewhere else. Conclude or '
            + 'cancel that one before grading this milestone.'));
    } else if (shapes.length) {
        kids.push(ceSettingRow('Shape', 'How it is graded \u00b7 authored in Settings \u203a States',
            ceSelect({ k: 'thr:ev:shape:' + id, value: String(st.msEvPick || ''),
                       options: [{ id: '', label: 'None' }].concat(shapes),
                       onCommit: function(v: string) { return _ceThreadEvPick(v); } })));
        kids.push(ceWrap(null, [
            ceBtn('Grade this as an encounter', 'thr:ev:begin:' + id, function() {
                return ceThreadEvBegin(id);
            })
        ]));
        kids.push(ceProse('t3',
            'Turns the milestone above into something that takes several rolls to settle. The '
            + 'shape decides how long it runs and how it reads at each step; the milestone stays '
            + 'exactly as written and becomes what the encounter is about.'));
    } else {
        kids.push(ceSub('t3', 'No encounter shapes yet. Author one in Settings \u203a States '
            + 'with scope \u201cEncounter\u201d \u2014 its span is how long an encounter lasts and its '
            + 'bands are how it reads at each step.'));
    }

    return ceGroup(ev ? 'Encounter' : 'Grade as an encounter', ceStack(CE_T.s2, kids));
}

// [MILESTONE] WHAT THIS THREAD'S GENERATORS MAY READ. A CHECK-LIST, NOT THE PICKER: the// [MILESTONE] WHAT THIS THREAD'S GENERATORS MAY READ. A CHECK-LIST, NOT THE PICKER: the
// picker answers "which one", and this asks "which of these", which is a different control
// -- so it is ceAccordion over ceToggle rows, the arrangement the Wizard's own context
// lorebook list already uses. Collapsed by default because a large cast makes it long.
//   ONE LIST, TWO SOURCES. Characters first, then world records; the ids share one array
//   on the record because the author is answering one question.
function _ceThreadContext(id: string, ent: any, st: any, openMap: any): any {
    var sel: string[] = (ent.contextIds || []);
    var picked: any = {};
    var i = 0;
    for (i = 0; i < sel.length; i++) { picked[String(sel[i])] = true; }

    function row(rid: string, label: string, sub: string): any {
        var on = !!picked[rid];
        return ceListRow({
            key: 'tctx_' + rid, opId: 'thr:ctx:' + rid,
            label: label, sub: sub,
            trail: ceToggle(on, 'thr:ctxt:' + rid, function() {
                return ceThreadCtxToggle(id, rid);
            }, label)
        });
    }

    var rows: any[] = [];
    var chars: any[] = st.msCtxChars || [];
    for (i = 0; i < chars.length; i++) { rows.push(row(String(chars[i].id), String(chars[i].name), 'character')); }
    var idx: any[] = st.index || [];
    for (i = 0; i < idx.length; i++) {
        if (!idx[i] || idx[i].id === id) continue;
        if (String(idx[i].type || '') === 'character') continue;   // the body, not the person
        rows.push(row(String(idx[i].id), String(idx[i].name || 'Unnamed'), String(idx[i].type || '')));
    }

    var n = 0;
    for (i = 0; i < sel.length; i++) { if (sel[i]) n = n + 1; }
    return ceWrap(null, [ ceAccordion({
        id: 'thr:ctx:' + id,
        label: 'Choose context for generation',
        open: !!openMap['thr:ctx:' + id],
        summary: n ? (String(n) + ' selected') : 'Nothing selected',
        meta: String(rows.length),
        children: ceStack(CE_T.s3, [
            ceProse('t3',
                'What this thread\u2019s Generate buttons are allowed to read. Update it whenever the thread turns toward someone new \u2014 it is a selection, not a commitment.'),
            rows.length ? ceStack(null, rows) : ceEmpty('Nothing in the world yet.', null)
        ])
    })]);
}

// [NARR-COLUMN] A SELECT, NOT FREE TEXT -- the opposite call from locationType, and for
// the opposite reason: a location type is a word the story uses and any word will do, while
// a thread kind is a key into NARRATIVE_KINDS' steer table and a value with no entry would
// steer nothing while looking like it had.
function _ceEntityNarrKind(id: string, ent: any): any {
    var k: any = ceNarrativeKind(String(ent.narrativeKind || ''));
    return ceGroup('Kind of thread', ceStack(CE_T.s2, [
        ceSelect({
            k: 'ent:narrkind:' + id, value: String(ent.narrativeKind || 'custom'),
            options: ceNarrativeKindOptions(),
            onCommit: function(v: string) { return ceEntityWrite(id, 'narrativeKind', v); }
        }),
        ceProse('t3', String(k.blurb || '')
            + ' It re-words the five questions below and what their Generate buttons are told. It stores no answer of its own, so change it whenever the thread turns out to be something else.')
    ]));
}

function _ceEntityOwner(id: string, ent: any, st: any): any {
    var nm = ceOwnerName(ent, st.index || [], st.cfg || null);
    var dangling = !!String(ent.ownerId || '') && !nm;
    return ceGroup('Owner', ceStack(CE_T.s2, [
        cePickerRow({
            kind: 'entityOwner', ctx: { id: id },
            label: '', value: nm,
            placeholder: 'Nobody in particular',
            hint: nm
                ? ('Everything ' + nm + '\u2019s record says is read by the Generate buttons below.')
                : 'A character or a faction. Whoever holds this place shapes it, so their record is read by every Generate button below.'
        }),
        // An owner whose record has been deleted. Says so rather than showing blank,
        // because a blank picker and an owner who no longer exists are different problems.
        dangling ? ceProse('t3', 'The owner this pointed at no longer exists. Choose another, or clear it.') : null
    ]));
}

// -- Description  [LOC-PROFILE7] ----------------------------------------------
// THE FIELD WITH THE MOST READERS AND THE LEAST EXPLANATION. It is not lore and it is not
// optional decoration: it is the short physical read, and three things consume it that the
// author cannot see from here.
//
// The copy differs by type because the READERS differ, and stating the wrong ones would be
// worse than stating none. An item's description rides into the holder's own lorebook
// entry while it is carried, and into the image prompt -- so for an item this field is
// partly a picture instruction and partly something the narrator is told about a character.
// A location's goes to the world list, to Contents, and seeds its generators.
// [NARR-COLUMN] A TABLE, NOT THE TWO-WAY TERNARY THIS WAS. The ternary asked "is it an
// item" and called everything else a place, so a faction and a thread were both told their
// description was "what is sensed on arrival" -- copy that is wrong in a way an author
// reads as the surface not knowing what it is looking at, which is exactly what was
// reported. Keyed by type with `location` as the fallback, so a fifth type is a row.
var CE_ENT_DESC_COPY: { [k: string]: { why: string; ph: string; noun: string } } = {
    location: {
        why: 'The short read on this place \u2014 what is sensed on arrival. It shows beside the name in the world list and in Contents, and every Generate button here works from it.',
        ph: 'What is sensed on arrival\u2026', noun: 'place' },
    item: {
        why: 'Purely what it looks like. While someone is carrying this, it is added to THEIR lorebook entry, and it is read when a picture of them is generated \u2014 so describe the thing, not the story around it.',
        ph: 'What it looks like\u2026', noun: 'thing' },
    faction: {
        why: 'The one-line read on this faction \u2014 what it is and what it is for. It shows beside the name wherever the faction is listed, and every Generate button here works from it.',
        ph: 'What it is, in one line\u2026', noun: 'faction' },
    narrative: {
        why: 'What this thread IS, in one line \u2014 the concrete situation, not the theme. It is what you read in the thread list, and every Generate button here works from it. The five questions below say how it moves.',
        ph: 'The situation, in one line\u2026', noun: 'thread' },
    // [SPEC-BODY] THE ROW WHOSE ABSENCE IS HALF THE BUG. A species fell through to the
    // location copy, which told the author this box was "what is sensed on arrival" and
    // named two readers a species does not have -- so nothing on the surface said the one
    // thing that matters here, which is that these words go verbatim into an entry that
    // never stops injecting. Says the length, and says where the long version goes.
    species: {
        why: 'One line, and one line only. It is written straight into the Peoples or Bestiary entry, which is always on \u2014 so every word here is in context on every generation. Everything longer goes in the lorebook entry, which fires only when this kind is named.',
        ph: 'What they are, in one line\u2026', noun: 'species' }
};
function _ceEntDescCopy(ent: any): any {
    return CE_ENT_DESC_COPY[String((ent && ent.type) || '')] || CE_ENT_DESC_COPY['location'];
}

function _ceEntityDescription(id: string, ent: any): any {
    var dc: any = _ceEntDescCopy(ent);
    return ceGroup('Description', ceStack(CE_T.s2, [
        ceProse('t3', String(dc.why)),
        h(ceField, {
            key: 'ent_desc_f', k: 'ent:desc:' + id, label: '',
            value: ent.description || '', multiline: true, rows: 3, well: true,
            placeholder: String(dc.ph),
            onCommit: function(v: string) { return ceEntityWrite(id, 'description', v); }
        }),
        ceWrap({ key: 'ent_desc_gen' }, [ _ceEntGenBtn(id, ent, 'description')])
    ]));
}

// -- Concept notes  [LOC-PROFILE4] --------------------------------------------
// CharacterRecord.conceptDump's counterpart, in the same words, because it does the same
// job: raw seed material that reaches no story and every generator.
function _ceEntityConcept(id: string, ent: any): any {
    var cNoun = String(_ceEntDescCopy(ent).noun);
    return ceGroup('Concept notes', ceStack(CE_T.s2, [
        ceProse('t3',
            'Not injected into the story and not part of the entry. Every Generate button below reads from here \u2014 put down whatever you know about this ' + cNoun + ', in any order.'),
        h(ceField, {
            key: 'ent_concept_f', k: 'ent:concept:' + id, label: '',
            value: ent.conceptDump || '', multiline: true, rows: 5, well: true,
            placeholder: 'Anything you know about it, in any order\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'conceptDump', v); }
        })
    ]));
}

// -- Custom fields  [LOC-PROFILE4][ENT-CF-EVERY][ENT-CF-DOOR] ------------------
// THE DOORS ONLY. The group itself renders from the payload like every other group;
// _ceEntityCustomBlock below is what puts the two together, and it is the only caller
// that should. Defining a field is a PROJECT-level act -- it appears on every record of
// the type, not just this one -- and it is done from here rather than from Settings
// because the moment an author wants a field is the moment they are looking at the thing
// that needs it, which is also the thing that answers which catalog it belongs in. The
// same reasoning CUSTOM-BEFORE-HOOKS applied to the character surface's own custom group.
function _ceEntityCustomKids(id: string, type: string, st: any): any[] {
    var cat = ceEntityCatalog(type);
    var noun = String((cat && cat.noun) || 'record');
    // [ENT-CF-DOOR] THE MANAGE DOOR IS OFFERED ONLY WHEN THERE IS SOMETHING TO MANAGE, and
    // it is counted off the SAME array the create verb writes to, so a type with no library
    // yet shows one button rather than a door onto an empty list.
    var cfKeyN = String((cat && cat.cfgKey) || '');
    var defsN: any[] = (cfKeyN && st && st.cfg && Array.isArray(st.cfg[cfKeyN])) ? st.cfg[cfKeyN] : [];
    return [ceStack(CE_T.s2, [
        // [ITEM-CAT] For an item this is the WHOLE catalog rather than an extra
        // group, so the copy says what the author is actually doing: deciding what kind of
        // thing this story has items be.
        ceProse('t3', (String(type || '') === 'item')
            ? 'Items have no built-in questions \u2014 anything can be one. Define what this story wants to know about a thing, and every item gets asked it.'
            : 'Questions of your own, asked of every ' + noun + ' in this project.'),
        ceInline(CE_T.s2, [
            ceBtn('Define a field\u2026', 'ent:newfield:' + id, function() {
                _ceEntDrill('newfield'); return Promise.resolve();
            }),
            defsN.length
                ? ceBtn('Manage fields (' + defsN.length + ')\u2026', 'ent:delfield:' + id, function() {
                    _ceEntDrill('delfield'); return Promise.resolve();
                })
                : null
        ])
    ])];
}

// [ENT-CF-EVERY] ONE CUSTOM-FIELDS BLOCK, RENDERED BY EVERY SHAPE. The group and the door
// that defines more are one thing and were three: the builder assembled them inside its
// group loop, the custom-only shape assembled them again by hand, and CLASSIC DID NOT
// ASSEMBLE THEM AT ALL -- so on a record opened in Classic an author's own fields were
// neither shown nor definable. That is not a Classic-shaped decision. uiShape chooses
// between CE's questions and the author's prose; a field the author defined is theirs in
// both, and every migrated species is Classic by construction (ceMigrateSpeciesToEntities),
// which is why the gap surfaced there first and read as "custom fields do not work on
// species".
// THE LABEL COMES OFF THE CATALOG, not from a literal: the custom-only shape said
// 'Custom Fields' while the builder one line over said 'Your fields' for the same group.
function _ceEntityCustomBlock(id: string, st: any, type: string): any {
    var eType = String(type || '');
    return _ceProfileGroup(id, st.p, st.cfg || null,
        { id: 'custom', label: ceEntityGroupLabel(eType, 'custom') },
        _ceEntityCustomKids(id, eType, st));
}

// [ENT-CF-SEED] AN EMPTY INSTRUCTION IS A FIELD WITH NO GENERATE BUTTON, and that was the
// default on every door except the character one. Settings' "+ Add" has always written a
// sentence from the label; the entity doors wrote whatever the author typed and usually got
// '' -- so the same act produced a generating field on a character and an inert text box on
// a location, a faction or a species, with nothing on either screen explaining the
// difference. The author's own text WINS whenever there is any; this only fills the gap.
// THE QUESTION IS FOLDED IN WHEN THERE IS ONE. It is the sharper of the two strings the
// author gave us -- "What is traded here?" says more than the label "Trade goods" -- and it
// is already being shown under the label, so a generator that ignored it would answer a
// different question from the one on screen.
// THE NOUN COMES OFF THE CATALOG, so a species is not told it is a character. Callers pass
// cat.noun; the character door has its own copy and is deliberately not routed through here
// (its wording is per-character and its budget key is written in the same breath).
function ceCustomFieldSeedInstr(label: string, hint: string, authored: string, noun: string): string {
    var a = String(authored || '').trim();
    if (a) return a;
    var lb = String(label || '').trim();
    if (!lb) return '';
    var q = String(hint || '').trim();
    var nn = String(noun || 'record').trim() || 'record';
    return 'Write the ' + lb + ' for this ' + nn + ' in two or three sentences, consistent with '
        + 'everything already established about it. Be specific and concrete rather than '
        + 'summarising.'
        + (q ? ' Answer this in particular: ' + q + (q.slice(-1) === '?' ? '' : '?') : '');
}

// The draft. Module vars, never store state -- CLICK-BEFORE-BLUR: the Create button is
// read before the last field's blur lands, so a store-backed draft would be one keystroke
// behind on every submit.
var _ceEntNewLabel = '';
var _ceEntNewHint = '';
var _ceEntNewInstr = '';

function _ceEntityNewFieldDrill(id: string, st: any): any {
    var nfType = String((st && st.ent && st.ent.type) || 'location');
    var nfNoun = String((ceEntityCatalog(nfType) && ceEntityCatalog(nfType).noun) || 'record');
    return ceStack(CE_T.s4, [
        ceProse('t3',
            'A field you add here is offered on every ' + nfNoun + ' in this project, and compiles into each one\u2019s entry under the label you give it. Only the ' + nfNoun + 's you actually write in are affected.',
            { key: 'nf_why' }),
        h(ceField, {
            key: 'nf_label', k: 'ent:nf:label:' + id, label: 'Label',
            value: '', seed: String(st.keyGen || 0),
            placeholder: 'Trade goods, Local dialect, Haunting\u2026',
            onType: function(v: string) { _ceEntNewLabel = String(v || ''); },
            onCommit: function(v: string) { _ceEntNewLabel = String(v || ''); return Promise.resolve(); }
        }),
        h(ceField, {
            key: 'nf_hint', k: 'ent:nf:hint:' + id, label: 'The question',
            value: '', seed: String(st.keyGen || 0),
            placeholder: 'One line, shown under the label \u2014 \u201cWhat is traded here?\u201d',
            onType: function(v: string) { _ceEntNewHint = String(v || ''); },
            onCommit: function(v: string) { _ceEntNewHint = String(v || ''); return Promise.resolve(); }
        }),
        h(ceField, {
            key: 'nf_instr', k: 'ent:nf:instr:' + id, label: 'Generator instructions',
            value: '', seed: String(st.keyGen || 0), multiline: true, rows: 4, well: true,
            placeholder: 'What the model should write, and how long. Leave empty and one is written from the label.',
            onType: function(v: string) { _ceEntNewInstr = String(v || ''); },
            onCommit: function(v: string) { _ceEntNewInstr = String(v || ''); return Promise.resolve(); }
        }),
        ceWrap({ key: 'nf_act' }, [
            ceBtn('Create field', 'ent:nf:create:' + id, function() {
                return ceEntityNewField(id, nfType);
            }, 'primary')
        ])
    ]);
}

// ceSettingsOp INSIDE ceEntityOp is DOWNWARD (1 -> 4) and therefore legal; see the lock
// order block above ceEntityOp. It is also the first 1 -> 4 nesting in the file, so it is
// named here rather than left to be rediscovered.
// [ITEM-CAT] WHICH LIBRARY IS DECIDED BY THE RECORD YOU WERE LOOKING AT, which is
// the same reasoning that put this door on the profile rather than in Settings: the moment
// an author wants a field is the moment they are looking at the thing that needs it, and
// that thing also answers which catalog it belongs in. The id prefix comes off the table
// so an id says which library minted it -- a stray 'ce_locx_' in customItemFields would be
// legible as the bug it is.
// [ENT-CF-DOOR] ONE WRITER, TWO DOORS. The profile's define button and the Build route's
// question minting write the same row into the same config array, so this is the function
// and the two surfaces are callers. A second copy on the Build route would be a second
// place the id prefix, the seed instruction and the `slot: 'custom'` marker could drift.
// IT TAKES ITS OWN CONFIG when handed one, so a batch minting six fields does one read and
// one write instead of six of each -- and returns the config it wrote into so the caller
// can keep batching. Handed nothing, it loads and saves on its own.
async function ceCustomFieldDefine(type: string, label: string, hint: string,
                                   instr: string, cfgIn?: any): Promise<any> {
    var lab = String(label || '').trim();
    if (!lab) return cfgIn || null;
    var cat = ceEntityCatalog(type);
    if (!cat) return cfgIn || null;
    var cfg: any = cfgIn || await loadConfig();
    if (!Array.isArray(cfg[cat.cfgKey])) cfg[cat.cfgKey] = [];
    // NO DUPLICATE LABELS. The minting pass is told what already exists and is asked not to
    // repeat it, but a model that repeats one anyway must not double the question -- and the
    // author typing a label they already have means to edit it, not to have two.
    for (var i = 0; i < cfg[cat.cfgKey].length; i++) {
        var ex: any = cfg[cat.cfgKey][i];
        if (ex && String(ex.label || '').trim().toLowerCase() === lab.toLowerCase()) {
            return cfg;
        }
    }
    cfg[cat.cfgKey].push({
        id: String(cat.idPrefix) + generateId(),
        label: lab,
        hint: String(hint || '').trim(),
        placeholder: String(hint || '').trim(),
        instructions: ceCustomFieldSeedInstr(lab, String(hint || ''), String(instr || ''),
                                             String(cat.noun)),
        slot: 'custom', kind: 'facet'
    });
    if (!cfgIn) { await saveConfig(cfg); }
    return cfg;
}

function ceEntityNewField(id: string, type: string): Promise<any> {
    var label = String(_ceEntNewLabel || '').trim();
    if (!label) { api.v1.ui.toast('Give the field a label first.', { type: 'info' }); return Promise.resolve(); }
    var cat = ceEntityCatalog(type);
    if (!cat) { api.v1.ui.toast('This kind of record has no field catalog.', { type: 'info' }); return Promise.resolve(); }
    return ceEntityOp(function() {
        return ceSettingsOp(async function() {
            try {
                var cfg: any = await loadConfig();
                await ceCustomFieldDefine(type, label, String(_ceEntNewHint || ''),
                                          String(_ceEntNewInstr || ''), cfg);
                await saveConfig(cfg);
                _ceEntNewLabel = ''; _ceEntNewHint = ''; _ceEntNewInstr = '';
                ceEntityPatch(function(s2: any) { return { entDrill: '', keyGen: Number(s2.keyGen || 0) + 1 }; });
                await cePublishEntity(id);
                api.v1.ui.toast('Field added to every ' + String(cat.noun) + '.', { type: 'success', autoClose: 2000 });
            } catch (e) { api.v1.error('[AE:jsxentity] new field failed:', e); }
        });
    });
}

// -- Manage custom fields  [ENT-CF-DOOR] --------------------------------------
// THE OTHER HALF OF THE DEFINE DOOR. A character's custom fields have had a delete since
// Settings > Static Field Settings existed; an entity's had none at all, so a field defined
// by a typo was permanent and appeared on every record of its type forever. The remedy goes
// HERE rather than into Settings for the reason the define door already gives: the moment
// an author wants a field gone is the moment they are looking at the record carrying it,
// and that record also answers which library it belongs to.
//
// DESTRUCTIVE-NEVER-IN-PLACE. The ask is an icon in a row of rows; the confirm is words,
// and it is a control that does not exist until st.confirm names this field -- the same
// two-phase shape _ceEntityDeleteBlock uses one screen down, on this surface's own store.
//
// WRITTEN TEXT IS NOT ERASED, and the confirm says so. Values live in each record's
// customFieldValues under the field's id and no reader iterates that bag -- every one of
// them iterates the DEFS (ceEntityOrderedDefs) -- so a deleted field's answers go dormant
// exactly as a deleted state def's values do, and re-defining a field with the same id
// would bring them back. Deleting the values instead would be an unrecoverable edit to
// every record of the type behind a button that says it is removing a question.
function _ceEntityFieldsDrill(id: string, ent: any, st: any, openMap: any): any {
    var fdType = String((ent && ent.type) || '');
    var fdCat = ceEntityCatalog(fdType);
    var fdNoun = String((fdCat && fdCat.noun) || 'record');
    var fdKey = String((fdCat && fdCat.cfgKey) || '');
    var fdDefs: any[] = (fdKey && st.cfg && Array.isArray(st.cfg[fdKey])) ? st.cfg[fdKey] : [];
    var fdBudgets: any = (st.cfg && st.cfg.fieldBudgets) || {};
    var fdConfirm = String(st.confirm || '');
    var fdRows: any[] = [];
    for (var i = 0; i < fdDefs.length; i++) {
        if (!fdDefs[i] || !fdDefs[i].id) continue;
        fdRows.push((function(d: any) {
            var did = String(d.id);
            var dk = 'cf:' + did;
            var accId = 'ent:cf:' + did;
            var asking = (fdConfirm === dk);
            // [ENT-CF-EDIT] THE EFFECTIVE INSTRUCTION IS WHAT IS SHOWN, not the stored
            // one. A field defined before the seed existed holds '' and generates from the
            // derived sentence (ENT-CF-SEED); showing the author a blank box while a
            // Generate button visibly works beside it on the profile is the surface lying
            // about what the model is being told. Committing makes the derivation concrete,
            // which is the correct moment for it to stop being a derivation.
            var effInstr = ceCustomFieldSeedInstr(String(d.label || 'Field'),
                                                  String(d.hint || ''),
                                                  String(d.instructions || ''),
                                                  fdNoun);
            return ceExpandRow({
                id: accId, label: String(d.label || '(unnamed field)'),
                open: !!(openMap && openMap[accId]),
                summary: String(d.hint || d.placeholder || '').trim()
                    || ((fdBudgets[did] || Number(d.budget) || 120) + ' token budget'),
                children: ceStack(CE_T.s3, [
                    h(ceField, {
                        key: accId + ':label', k: accId + ':label', label: 'Label',
                        value: String(d.label || ''),
                        onCommit: function(v: string) { return ceEntityEditField(id, fdType, did, 'label', v); }
                    }),
                    h(ceField, {
                        key: accId + ':hint', k: accId + ':hint', label: 'The question',
                        value: String(d.hint || ''),
                        placeholder: 'One line, shown under the label \u2014 \u201cWhat is traded here?\u201d',
                        onCommit: function(v: string) { return ceEntityEditField(id, fdType, did, 'hint', v); }
                    }),
                    h(ceField, {
                        key: accId + ':instr', k: accId + ':instr', label: 'Generator instructions',
                        value: effInstr, multiline: true, rows: 4, well: true,
                        onCommit: function(v: string) { return ceEntityEditField(id, fdType, did, 'instructions', v); }
                    }),
                    ceNumField({ k: accId + ':budget', label: 'Generation token budget', hint: '50\u2013500',
                        value: fdBudgets[did] || Number(d.budget) || 120, min: 50, max: 500,
                        onCommit: function(n: number) { return ceEntityEditField(id, fdType, did, 'budget', String(n)); } }),
                    asking ? null : ceIconBtn('Delete ' + String(d.label || 'this field'),
                        ceIconTrash(), 'ent:cfdelask:' + did, function() {
                            ceEntityPatch(function() { return { confirm: dk }; });
                            return Promise.resolve();
                        }),
                    asking ? ceInline({ gap: CE_T.s2, key: 'cfask_' + did }, [
                        ceProse('t2', 'Delete \u201c' + String(d.label || 'this field')
                            + '\u201d? It stops being asked of every ' + fdNoun
                            + ' in this project. Anything already written into it is kept, not erased.',
                            { grow: true, basis: '180px' }),
                        ceBtn('Delete', 'ent:cfdel:' + did, function() {
                            return ceEntityDeleteField(id, fdType, did);
                        }, 'danger'),
                        ceBtn('Keep it', 'ent:cfkeep:' + did, function() {
                            ceEntityPatch(function() { return { confirm: '' }; });
                            return Promise.resolve();
                        })
                    ]) : null
                ])
            });
        })(fdDefs[i]));
    }
    if (!fdRows.length) {
        return ceEmpty('No fields of your own on ' + fdNoun + 's yet.', null);
    }
    return ceStack(CE_T.s4, [
        ceProse('t3',
            'Questions you added, asked of every ' + fdNoun + ' in this project. Editing one '
            + 'changes it everywhere at once. Removing one takes it off every ' + fdNoun
            + '\u2019s page and out of every entry it compiles into; the answers already written '
            + 'stay on their records.',
            { key: 'cfd_why' }),
        ceStack({ key: 'cfd_rows' }, fdRows)
    ]);
}

// [ENT-CF-EDIT] ONE WRITE VERB FOR THE FOUR EDITABLE PARTS, keyed by the field name, rather
// than four near-identical closures -- the shape _ceSettingsFields grew into and the reason
// its four handlers each re-spell the find-by-id.
// `budget` GOES TO cfg.fieldBudgets, NOT ONTO THE DEF, because that is where _ceGenSpec
// looks first and where the character door already writes it. Putting it on the def would be
// a second address for one number, and _ceGenSpec's config-outranks-the-catalog rule would
// make the def's copy the one that loses.
// `placeholder` TRACKS `hint`. ceEntityNewField writes them from the same box and the two
// have never been separately authored on this surface; letting them drift here would give
// the profile a placeholder that contradicts the question printed above it.
function ceEntityEditField(id: string, type: string, fieldId: string,
                           field: string, value: string): Promise<any> {
    var cat = ceEntityCatalog(type);
    if (!cat) return Promise.resolve();
    return ceEntityOp(function() {
        return ceSettingsOp(async function() {
            try {
                var cfg: any = await loadConfig();
                var list: any[] = Array.isArray(cfg[cat.cfgKey]) ? cfg[cat.cfgKey] : [];
                var target: any = null;
                for (var i = 0; i < list.length; i++) {
                    if (list[i] && String(list[i].id) === String(fieldId)) { target = list[i]; break; }
                }
                if (!target) return;
                var v = String(value === undefined ? '' : value);
                if (field === 'budget') {
                    if (!cfg.fieldBudgets || typeof cfg.fieldBudgets !== 'object') cfg.fieldBudgets = {};
                    cfg.fieldBudgets[String(fieldId)] = Math.max(50, Math.min(500, Number(v) || 120));
                } else if (field === 'label') {
                    var lb = v.trim();
                    if (!lb) { api.v1.ui.toast('A field needs a label.', { type: 'info' }); return; }
                    target.label = lb;
                } else if (field === 'hint') {
                    target.hint = v.trim();
                    target.placeholder = v.trim();
                } else if (field === 'instructions') {
                    target.instructions = v.trim();
                } else { return; }
                cfg[cat.cfgKey] = list;
                await saveConfig(cfg);
                await cePublishEntity(id);
            } catch (e) { api.v1.error('[AE:jsxentity] edit field failed:', e); }
        });
    });
}

// ceSettingsOp INSIDE ceEntityOp is DOWNWARD (1 -> 4), the same nesting ceEntityNewField
// documents above -- see the lock order block over ceEntityOp.
// NO PER-RECORD SWEEP. See the drill's header for why the values stay.
function ceEntityDeleteField(id: string, type: string, fieldId: string): Promise<any> {
    var cat = ceEntityCatalog(type);
    if (!cat) { api.v1.ui.toast('This kind of record has no field catalog.', { type: 'info' }); return Promise.resolve(); }
    return ceEntityOp(function() {
        return ceSettingsOp(async function() {
            try {
                var cfg: any = await loadConfig();
                var list: any[] = Array.isArray(cfg[cat.cfgKey]) ? cfg[cat.cfgKey] : [];
                var out: any[] = [];
                for (var i = 0; i < list.length; i++) {
                    if (list[i] && String(list[i].id) === String(fieldId)) continue;
                    out.push(list[i]);
                }
                cfg[cat.cfgKey] = out;
                await saveConfig(cfg);
                ceEntityPatch(function(s2: any) { return { confirm: '', keyGen: Number(s2.keyGen || 0) + 1 }; });
                await cePublishEntity(id);
                api.v1.ui.toast('Field removed from every ' + String(cat.noun) + '.', { type: 'success', autoClose: 2000 });
            } catch (e) { api.v1.error('[AE:jsxentity] delete field failed:', e); }
        });
    });
}

// -- Reorder  [LOC-PROFILE4] --------------------------------------------------
// ONE LIST, TWO ARROWS. A drag handle is the obvious answer and is not available: there is
// no pointer-event surface in this sandbox that the kit already models, and inventing one
// for this would be a second interaction idiom for a list of sixteen rows.
//
// THE ORDER IT SHOWS IS THE ORDER THE ENTRY COMPILES IN -- both go through
// ceEntityOrderedDefs -- which is why this is worth a drill rather than a settings toggle:
// what a record leads with is an authoring decision.
function _ceEntityOrderDrill(id: string, ent: any, st: any): any {
    var defs: any[] = ceEntityOrderedDefs(ent, st.cfg || null);
    var cfv: any = ent.customFieldValues || {};
    var rows: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        rows.push((function(d: any, idx: number) {
            var written = String(cfv[d.id] || '').trim() !== '';
            return ceListRow({
                label: d.label,
                sub: written ? undefined : 'empty \u2014 not in the entry',
                // ceBtn WITH AN ARROW GLYPH, not ceIconBtn: the icon set has no up or
                // down (ceIconDownload/ceIconUpload are file verbs and would read as
                // export/import here), and minting two SVGs for a reorder list is more
                // surface than the job needs. The label carries the accessible name.
                trail: ceInline(CE_T.s1, [
                    (idx > 0) ? ceBtn('\u2191', 'ent:ordup:' + d.id, function() {
                        return ceEntityReorder(id, d.id, -1);
                    }) : null,
                    (idx < defs.length - 1) ? ceBtn('\u2193', 'ent:orddn:' + d.id, function() {
                        return ceEntityReorder(id, d.id, 1);
                    }) : null
                ])
            });
        })(defs[i], i));
    }
    return ceStack(CE_T.s4, [
        ceProse('t3',
            'The order these appear on the page is the order they appear in the lorebook entry. Empty fields are skipped in the entry but keep their place here.',
            { key: 'ord_why' }),
        ceStack({ key: 'ord_rows' }, rows)
    ]);
}

function ceEntityReorder(id: string, fieldId: string, delta: number): Promise<any> {
    return ceEntityOp(async function() {
        try {
            var e: any = await loadEntity(id);
            if (!e) return;
            var cfg: any = await loadConfig();
            // RESOLVED, THEN STORED WHOLE. fieldOrder may be partial or empty, so moving a
            // row inside a list the record does not fully describe would be undefined. The
            // resolver produces the list the author is looking at; the move happens in that
            // list and the whole thing is written back, after which the record and the page
            // agree exactly.
            var defs: any[] = ceEntityOrderedDefs(e, cfg);
            var ids: string[] = [];
            for (var i = 0; i < defs.length; i++) { ids.push(String(defs[i].id)); }
            var at = ids.indexOf(String(fieldId));
            var to = at + Number(delta);
            if (at < 0 || to < 0 || to >= ids.length) return;
            var moved = ids[at];
            ids[at] = ids[to];
            ids[to] = moved;
            e.fieldOrder = ids;
            await saveEntity(e);
            if (e.lorebookEntryId) {
                try { await syncEntityLorebookEntry(id, true); } catch (eL) { api.v1.error('[AE:jsxentity] reorder sync:', eL); }
            }
            await cePublishEntity(id);
        } catch (e2) { api.v1.error('[AE:jsxentity] reorder failed:', e2); }
    });
}

// [LOC-PROFILE6] ceEntityWriteOwner DELETED BEFORE IT EVER SHIPPED.
// ceEntityWritePair already existed, ten lines up the same section, doing exactly what it
// did -- one lock, one load, both fields, one save. Writing a second one was the
// one-implementation rule broken by not grepping first, which is the whole reason that
// rule is phrased as "grep before minting". The owner picker calls the pair verb.

// -- Drill state  [LOC-PROFILE2] ----------------------------------------------
// On the ENTITY store rather than ceUiStore, unlike _ceProfileDrill. ceUiStore.entityId
// is already the entity's address and is written by ceNav alone (CESURF-RECYCLE); adding a
// second entity-scoped value there would give two stores a say in what this surface shows.
function _ceEntDrill(name: string): void {
    // entDirect clears here: a drill opened from this surface's own launcher row has a root
    // to go back to, and that root is where its Back belongs.
    ceEntityPatch(function() { return { entDrill: String(name || ''), entDirect: '' }; });
}

// -- Hero ---------------------------------------------------------------------
// THE NAME AREA IS A DOOR, which is the arrangement _ceProfileHero settled: tapping a
// character's name opens their identity fields, so tapping a place's name opens its own.
// The identity line renders beneath it as the sentence the record actually makes.
function _ceEntityHero(id: string, ent: any, st: any): any {
    var idLine = ceEntityIdentityLine(ent, String(st.parentName || ''));
    var where = String(st.parentName || '');
    var sub: string[] = [];
    if (ent.locationType) sub.push(String(ent.locationType));
    if (where) sub.push('in ' + where);
    // [LOC-PROFILE3] _ceProfileHero's arrangement, not an approximation of it:
    // image left, name and its two sub-lines right, and the NAME BLOCK IS THE DOOR to the
    // identity fields exactly as tapping a character's name opens theirs.
    //
    // NO IMAGE IN THE ROW. The banner above owns the picture now, and leaving the
    // 126px frame here as well meant two anchors on one slot and a name block squeezed
    // into what was left of the row -- which is the squeeze the banner was added to fix.
    // Full width for the name, because that is what the hero is for.
    return ceCard({
        opId: 'entdrill:identity',
        onClick: function() { _ceEntDrill('identity'); },
        children: ceStack(CE_T.s1, [
            ceH1(ent.name || 'Unnamed'),
            sub.length ? ceSub('t3', sub.join(' \u00b7 ')) : ceSub('t3', 'Not placed yet'),
            idLine ? ceSub('t3', '\u201c' + idLine + '\u201d') : null
        ])
    });
}

// -- Launchers ----------------------------------------------------------------
// _ceProfileLaunchers' cells, for a place. `has` is a real data check wherever the
// answer is engine-known, which is the ladder doing its stated job rather than standing in
// for "a renderer exists".
function _ceEntityLaunchers(id: string, ent: any): any {
    var cells: any[] = [
        // [LOC-PROFILE3] "Map Entity", per user. "Entity" named the record; this
        // names what is behind the door, which is where the thing sits on the map and what
        // it is joined to.
        { id: 'entity',   label: 'Map Entity',   has: true },
        // [F-32] A SPECIES GETS THE IMAGES DOOR TOO. Two different drills behind one label,
        // routed below -- a location wants one banner and a species wants a grid, and that is
        // a difference in the body rather than in the door.
        (ent.type === 'location' || ent.type === 'species')
            ? { id: 'images', label: 'Images', has: true } : null,
        // [ATMO] LOCATIONS ONLY. `has` reports whether a timetable exists at all, on the
        // same has/has-not reading every other cell here uses -- a place with none is not
        // broken, it is falling back to its description.
        (ent.type === 'location')
            ? { id: 'atmosphere', label: 'Atmosphere', has: !!ceSchedOf(ent) } : null,
        // [LORE-ONE-FIELD] A CELL THAT ACTS RATHER THAN OPENS. Behind this door were a
        // status line, an explainer, a duplicate of the profile's own body field, and three
        // buttons of which one was inert (see _ceEntityLore's tombstone). What is left is the
        // single verb, so it is the cell: F-29's "a cell may carry its own verb", one row up.
        // The LABEL reports the state the status line used to, so nothing is lost by not
        // opening it.
        (ent.type !== 'character')
            ? { id: 'lorebook', label: ent.lorebookEntryId ? 'Resync entry' : 'Link entry',
                has: !!ent.lorebookEntryId,
                go: function() {
                    var pr = ent.lorebookEntryId
                        ? syncEntityLorebookEntry(id)
                        : createLinkedEntityLorebookEntry(id);
                    Promise.resolve(pr).then(function() {
                        try { api.v1.ui.toast(ent.lorebookEntryId ? 'Entry resynced.' : 'Entry linked.',
                            { type: 'success', autoClose: 2000 }); } catch (eLo1) {}
                        return cePublishEntity(id);
                    }).catch(function(eLo2: any) {
                        api.v1.error('[AE:jsxentity] lorebook link/resync failed:', eLo2);
                        try { api.v1.ui.toast('Could not update the entry.', { type: 'error', autoClose: 2500 }); } catch (eLo3) {}
                    });
                } } : null,
        // [F-29] A CELL MAY CARRY ITS OWN VERB. Journal is a SURFACE, not a drill, so this
        // one navigates where the other three swap the body -- the arrangement F-27 settled
        // when it deleted _ceFactionJournal ("one editor, one archive"). It is a launcher and
        // not a fifth tab for exactly that reason: it leaves.
        (ent.type === 'faction') ? { id: 'journal', label: 'Journal', has: true,
            go: function() {
                ceNav('journal', id, '',
                      { surface: 'entity', entityId: id, label: String(ent.name || 'Faction') });
            } } : null
    ];
    // [SS-BOX] ceBtn, not a hand-rolled cell. SECTION 30's launcher row is a
    // custom shape because it carries a has/has-not opacity ladder over a text label; that
    // shape lives in a section with a style budget and this one has none. A row of buttons
    // says the same thing -- these are doors -- with nothing hand-typed.
    var kids: any[] = [];
    for (var i = 0; i < cells.length; i++) {
        if (!cells[i]) continue;
        kids.push((function(c: any) {
            return ceBtn(c.label, 'entdrill:' + c.id, function() {
                if (c.go) { c.go(); } else { _ceEntDrill(c.id); }
                return Promise.resolve();
            });
        })(cells[i]));
    }
    return ceInline({ gap: CE_T.s2, key: 'ent_launch', padBottom: CE_T.s3 }, kids);
}

// [F-32 SPEC-LIST] THE ONE CONTROL THAT DECIDES WHICH COMPOSED ENTRY THIS RECORD COMPILES
// INTO. Two buttons over CE_SPECIES_LISTS rather than a ceSelect, on the argument _ceShapePicker's own
// argument: a two-value choice whose values are both worth naming reads better as two
// buttons than as a closed dropdown, and the current one is visible without a tap.
// IT WRITES THROUGH ceEntityWrite like every other field here, so the lorebook resync and
// the republish are the write path's job and not this function's. `speciesList` is NOT in
// ceEntityWrite's resync list and must not be: it changes which COMPOSED entry the record
// appears in, which is queueCastLoreSync's business (saveEntity fires it), not the record's
// own entry, whose text does not mention the list at all.
function _ceEntitySpeciesList(id: string, ent: any): any {
    var cur = ceSpeciesList(ent);
    var btns: any[] = [];
    for (var i = 0; i < CE_SPECIES_LISTS.length; i++) {
        btns.push((function(def: any) {
            var on = (cur === def.id);
            return ceBtn(String(def.label), 'ent:splist:' + id + ':' + def.id, function() {
                if (on) return Promise.resolve();
                return ceEntityWrite(id, 'speciesList', String(def.id));
            }, on ? 'primary' : '');
        })(CE_SPECIES_LISTS[i]));
    }
    return ceStack(CE_T.s2, [
        ceSub('t2', 'Which list'),
        ceProse('t3',
            'Peoples and the Bestiary are two lorebook entries the engine keeps for you, and this says which one names this kind. Nothing else changes \u2014 the questions below are the same either way.'),
        ceInline(CE_T.s2, btns)
    ]);
}

// [F-32 SPEC-IMG] Generation for one species slot. ceImgSlotGenerate's job for a kind, and a
// separate function for the reason ceEntityImgGenerate is one: THE PROMPT IS BASE, NOT A
// CHARACTER ENTRY. ceImgSlotGenerate puts its subject in characters[], which drives NAI's
// v4.5 per-character captions -- right for a person, wrong for a reference plate of a kind,
// and identical to the call the location path already had to make.
// THE SLOT'S TAG IS WHAT MAKES THE SLOTS WORTH HAVING: 'Male' and 'Female' are empty names
// until the author writes what each one means, so the tag is appended to the record's own
// visuals exactly as a character's emotion tag is appended to theirs.
async function ceSpeciesImgGenerate(id: string, slot: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected \u2014 image generation requires bridge.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
        return;
    }
    try {
        var e: any = await loadEntity(id);
        if (!e) return;
        var slotState = await loadCharImgSlots(id, 'species');
        var tag = charImgEffectiveTag(slotState, slot);
        var vis = [String(e.locationVisuals || '').trim(), String(tag || '').trim()]
            .filter(Boolean).join(', ');
        if (!vis) {
            try { api.v1.ui.toast('Write some visuals first \u2014 there is nothing to draw from.', { type: 'warning', autoClose: 3000 }); } catch (e1) {}
            return;
        }
        var sSeed = _ceImgSeed(0);
        try { await charImgSetSeed(id, slot, sSeed); } catch (eSd) { api.v1.error('[AE:imgslots] seed stamp failed:', eSd); }
        var compiled = compileActiveImageFields();
        await ceBroadcastImageGen({
            uuid: api.v1.uuid(),
            prompt: '',
            characters: [],
            extraBaseVisuals: vis,
            extraBaseUC: '',
            charId: e.id,
            entityId: e.id,
            kind: 'charSlot',
            slot: slot,
            settings: {
                // A REFERENCE PLATE IS A PORTRAIT, so the default is the portrait shape and
                // not the location banner's landscape. Overridable on the record exactly as
                // a location's is -- same two fields, same select.
                // [SPEC-SHAPE] AND THE SELECT NOW EXISTS. It did not when this comment was
                // written, so the pair was unwritable for a species and this fallback was
                // the only shape a plate could ever be drawn at. See _ceEntitySpeciesImage.
                width: Number(e.imgWidth) || 832,
                height: Number(e.imgHeight) || 1216,
                steps: Math.min(globalSettings.defaultSteps || 28, 28),
                scale: globalSettings.defaultScale || 5.0,
                model: ceImgModel(),
                seed: sSeed,
                quality: compiled.quality,
                negative: compiled.negative
            },
            autoDownload: false
        });
        try { api.v1.ui.toast('Generating ' + slot + '\u2026', { type: 'info', autoClose: 2000 }); } catch (e2) {}
    } catch (e3) { api.v1.error('[AE:jsxentity] species image generate failed:', e3); }
}

// [F-32 SPEC-IMG] The species image drill. A GRID OF SLOTS, WHERE A LOCATION GETS ONE FRAME
// -- which is the whole UI difference, and the architecture underneath is the character's,
// unchanged: STORAGE_CHAR_IMG_PFX keyed by a bare id, the same charImg* verbs, the same
// ceImgAnchor, the same ceImgSlotAction ops on the bridge. Zero bridge changes, for the
// reason ANCHOR-FORMAT records: the bridge's image layer never looks the id up as a
// character.
// IT DOES NOT REUSE _ceImgSlotsDrill. That drill reads ceProfileStore for avatarVisuals,
// avatarWidth and avatarSeed -- three CharacterRecord fields a species does not have -- and
// generates through the characters[] path this record must not use. Sharing it would mean
// teaching the character drill what a species is at four separate reads, which is more
// forking than the fifty lines below.
function _ceEntitySpeciesImage(id: string, ent: any, st: any): any {
    var slots: string[] = (st.imgSlots || []);
    var tags: any = (st.imgTags || {});
    var confirming = String(st.confirm || '');
    var cards: any[] = [];
    // [SPEC-SHAPE] THE SHAPE CONTROL WAS MISSING AND ceSpeciesImgGenerate'S OWN COMMENT SAID
    // IT WAS NOT. That generator reads Number(e.imgWidth) || 832 and claims the pair is
    // "overridable on the record exactly as a location's is -- same two fields, same
    // select". The select was never rendered on this drill, so nothing anywhere could write
    // those two fields for a species and every reference plate was pinned to the fallback.
    // The fields, the reader and the default were all correct; only the door was absent,
    // which is exactly why it reads as the preset being ignored rather than as a missing
    // control -- the same shape of report a projection allowlist miss produces.
    //   ONE CONTROL FOR THE RECORD, NOT ONE PER SLOT. Every slot generates from the same
    //   record and the same visuals -- "the kind is described once" is the argument the
    //   shared prompt block below already makes -- so a per-card shape would be six answers
    //   to one question, and the record has one pair of fields to hold them in.
    //   THE DEFAULT IS PORTRAIT AND STAYS THERE: a reference plate of a kind is a portrait,
    //   which is the asymmetry against a location's landscape the generator already
    //   encodes. Read here rather than assumed, so the select opens on what will be sent.
    var spW = Number(ent.imgWidth) || 832;
    var spH = Number(ent.imgHeight) || 1216;
    var spCur = String(spW) + 'x' + String(spH);
    var spOpts: any[] = [];
    var spKnown = false;
    for (var sr = 0; sr < CE_IMG_RATIO_OPTS.length; sr++) {
        spOpts.push(CE_IMG_RATIO_OPTS[sr]);
        if (CE_IMG_RATIO_OPTS[sr].id === spCur) spKnown = true;
    }
    if (!spKnown) { spOpts.push({ id: spCur, label: 'Custom \u2014 ' + String(spW) + '\u00d7' + String(spH) }); }
    // A FIXED PIXEL HEIGHT PER SHAPE, matching _ceEntityImage's three exactly and for its
    // reason verbatim: the painter appends its <img> as position:absolute with height:100%,
    // so the anchor needs a real height of its own, and `aspectRatio` has no precedent
    // anywhere in this file. The frames were a flat 200px -- a landscape box -- so even the
    // portrait default was being letterboxed into a shape it was never generated at.
    var spFrameH = (spH > spW) ? '320px' : ((spH === spW) ? '260px' : '200px');
    for (var i = 0; i < slots.length; i++) {
        cards.push((function(slot: string) {
            var isAvatar = (slot === CE_IMG_SLOT_AVATAR);
            var frame = h('div', ceImgAnchor(id, slot, {
                onClick: function() { ceTap('ent:spimgview:' + id + ':' + slot, function() {
                    cePhotoOpen(id, slot, String(ent.name || 'Image') + ' \u2014 ' + slot);
                }); },
                role: 'button', tabIndex: 0, 'aria-label': 'View ' + slot + ' full screen',
                // [H-03] flexShrink 0 -- a fixed-height image in a flex column is crushed.
                // [SPEC-SHAPE] The height follows the record's chosen shape now; see above.
                style: { flexShrink: 0, width: '100%', height: spFrameH, cursor: 'pointer',
                    borderRadius: CE_T.r, background: CE_WELL, border: '1px solid ' + CE_LINE,
                    position: 'relative', overflow: 'hidden' }
            }));
            var acts: any[] = [
                ceBtn('Generate', 'ent:spimggen:' + id + ':' + slot, function() {
                    return ceSpeciesImgGenerate(id, slot);
                }, 'primary'),
                ceIconBtn('Upload an image for ' + slot, ceIconUpload(), 'ent:spimgup:' + id + ':' + slot,
                    function() { return ceImgSlotAction(id, slot, 'upload'); }),
                ceIconBtn('Download ' + slot, ceIconDownload(), 'ent:spimgdl:' + id + ':' + slot,
                    function() { return ceImgSlotAction(id, slot, 'download'); }),
                // DESTRUCTIVE-NEVER-IN-PLACE: this asks first, and the handler is the same in
                // both states, so TAP-GUARD's double-fire cannot land the confirmed branch.
                (confirming === 'img:' + slot)
                    ? ceBtn('Delete it', 'ent:spimgdel:' + id + ':' + slot, function() {
                        ceEntityPatch(function() { return { confirm: '' }; });
                        return ceImgSlotAction(id, slot, 'delete');
                      }, 'danger')
                    : ceIconBtn('Delete ' + slot, ceIconTrash(), 'ent:spimgdelask:' + id + ':' + slot, function() {
                        ceEntityPatch(function() { return { confirm: 'img:' + slot }; });
                        return Promise.resolve();
                      }, 'danger')
            ];
            // AVATAR IS NOT REMOVABLE, the same guard charImgRemoveSlot keeps: it is the slot
            // the record's own frame and every picker resolves to.
            if (!isAvatar) {
                acts.push(ceBtn('Remove slot', 'ent:spslotrm:' + id + ':' + slot, function() {
                    return ceEntityOp(function() { return charImgRemoveSlot(id, slot); })
                        .then(function() { return cePublishEntity(id); });
                }, 'danger'));
            }
            // ceCard TAKES ITS CHILDREN ON THE OPTS OBJECT, not as a second argument -- see
            // _ceImgSlotCard, the only other caller that renders one per slot.
            return ceCard({ key: 'spimg_' + slot, children: ceStack(CE_T.s2, [
                ceSub('t2', slot),
                frame,
                h(ceField, {
                    key: 'spimgtag_' + slot, k: 'ent:spimgtag:' + id + ':' + slot, label: '',
                    value: String(tags[slot] === undefined ? '' : tags[slot]),
                    multiline: true, rows: 2, well: true,
                    placeholder: isAvatar ? 'What a picture of this kind should show\u2026'
                                          : 'What makes this one different from the others\u2026',
                    onCommit: function(v: string) {
                        // [IMG-TAG-SHARED] 'species' EXPLICITLY. A kind's Male/Female tags
                        // are content about that kind, not story vocabulary -- see the table.
                        return ceEntityOp(function() { return charImgSetTag(id, slot, v, 'species'); })
                            .then(function() { return cePublishEntity(id); });
                    }
                }),
                ceInline(CE_T.s2, acts)
            ]) });
        })(slots[i]));
    }

    // [LOC-PROFILE6] THE SHARED PROMPT, ABOVE THE BUTTONS THAT READ IT. Every slot's
    // generation is these words plus that slot's own tag, which is what makes the slots cheap
    // to add: the kind is described once.
    var visBlock = ceStack(CE_T.s2, [
        ceSub('t2', 'Visuals'),
        ceProse('t3', 'The tags every picture of this kind is generated from. Describe what they ALL share \u2014 what makes one different goes in that slot\u2019s own box below.'),
        h(ceField, {
            key: 'ent_spvis', k: 'ent:spvis:' + id, label: '',
            value: ent.locationVisuals || '', multiline: true, rows: 2, well: true,
            placeholder: 'grey skin, four arms, bone ridges, ragged furs\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'locationVisuals', v); }
        })
    ]);

    var addRow = ceStack(CE_T.s2, [
        h(ceField, {
            key: 'spimgadd_' + String(st.imgAddGen || 0), k: 'ent:spimgadd:' + id,
            label: '', value: '', multiline: false, rows: 1, well: true,
            placeholder: 'New slot name \u2014 Juvenile, Elder, Drone, Winter coat\u2026',
            // CLICK-BEFORE-BLUR: the Add button is read before this field's blur lands, so
            // the draft is a module var and onType never repaints.
            onType: function(v: string) { _ceSpSlotDraft = String(v || ''); },
            onCommit: function(v: string) { _ceSpSlotDraft = String(v || ''); return Promise.resolve(); }
        }),
        ceBtn('Add slot', 'ent:spslotadd:' + id, function() {
            var nm = String(_ceSpSlotDraft || '').trim();
            if (!nm) {
                try { api.v1.ui.toast('Name the slot first.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
                return Promise.resolve();
            }
            _ceSpSlotDraft = '';
            return ceEntityOp(function() { return charImgAddSlot(id, nm); })
                .then(function() {
                    ceEntityPatch(function(s: any) { return { imgAddGen: Number(s.imgAddGen || 0) + 1 }; });
                    return cePublishEntity(id);
                });
        })
    ]);

    // [SPEC-SHAPE] BESIDE THE VISUALS AND ABOVE THE SLOTS, because it is the second half of
    // the same fact: the visuals say what every picture of this kind shows, and this says
    // what shape every one of them is drawn at. Both are record-wide, so both sit above the
    // per-slot cards rather than inside one of them.
    var shapeBlock = ceStack(CE_T.s1, [
        ceSub('t2', 'Shape'),
        ceProse('t3', 'The canvas every slot below is generated at. A reference plate is usually a portrait; a wide kind may read better landscape.'),
        ceSelect({
            k: 'ent:spratio:' + id, value: spCur, options: spOpts,
            onCommit: function(v: string) {
                var cut = String(v || '').indexOf('x');
                if (cut < 0) return Promise.resolve();
                var nw = Number(String(v).slice(0, cut)) || 832;
                var nh = Number(String(v).slice(cut + 1)) || 1216;
                return ceEntityWritePair(id, [{ k: 'imgWidth', v: nw }, { k: 'imgHeight', v: nh }]);
            }
        })
    ]);

    return ceStack(CE_T.s4, [
        visBlock,
        shapeBlock,
        ceGroup('Slots (' + slots.length + ')', ceStack(CE_T.s2, cards)),
        ceGroup('Add a slot', addRow)
    ]);
}
// The add-slot draft. One module var because only one add-slot row is ever mid-entry at a
// time on this surface -- the same reasoning _ceEntKeyDraft beside it already carries.
var _ceSpSlotDraft: string = '';

// -- Identity drill  [LOC-PROFILE2] -------------------------------------------
// _ceProfileIdentityDrill's job for a place: the fields that say WHICH THING THIS IS.
// THE LOREBOOK KEYS LIVE HERE, per user, and the reason holds generally: a key is another
// name for this place, so it belongs beside the name and not in a lorebook panel with the
// entry body. The Lorebook drill keeps the entry, the link controls and the projection.
function _ceEntityIdentityDrill(id: string, ent: any, st: any): any {
    var tags: string[] = ent.lorebookTags || [];
    var keyRows: any[] = [];
    for (var i = 0; i < tags.length; i++) {
        keyRows.push((function(tg: string) {
            return ceListRow({
                label: tg,
                trail: ceIconBtn('Remove the key ' + tg, ceIconTrash(), 'ent:keydel:' + tg, function() {
                    return ceEntityKeyOp(id, 'remove', tg);
                }, 'danger')
            });
        })(tags[i]));
    }

    // [LOC-PROFILE3] EVERY CHILD KEYED. This list is built conditionally (the
    // location-only block, the optional key rows) so its LENGTH changes between renders,
    // and a length-changing list with some keyed children and some not is reordered by
    // position -- which is why the description field appeared between the stored keys and
    // the button that adds one. See the root's own note.
    var idLine = ceEntityIdentityLine(ent, String(st.parentName || ''));
    var kids: any[] = [
        h(ceField, {
            key: 'ent_name', k: 'ent:name:' + id, label: 'Name',
            value: ent.name || '', placeholder: 'What it is called\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'name', v); }
        })
    ];

    // [F-32] THE GATE IS THE CATALOG, NOT THE TYPE. `ent.type === 'location'` was the last
    // place this drill knew what a location was, and the kind-word is not a fact about being
    // one -- it is a fact about having a vocabulary declared, which is now a catalog row.
    // A type with no typeSuggestions asks nothing and renders nothing, exactly as before.
    var ltSugg: string[] = ceEntityTypeSuggestions(String(ent.type || ''));
    var isSpec = (String(ent.type || '') === 'species');
    if (ltSugg.length) {
        kids.push(h(ceField, {
            key: 'ent_lt', k: 'ent:loctype:' + id, label: 'What it is',
            value: ent.locationType || '',
            placeholder: ltSugg.join(', ') + '\u2026',
            onCommit: function(v: string) { return ceEntityWrite(id, 'locationType', v); }
        }));
        kids.push(ceProse('t3',
            (isSpec
                ? 'The noun this kind is, in your own words \u2014 anything from '
                : 'The noun this place is, in your own words \u2014 anything from ')
            + ltSugg.slice(0, 4).join(', ')
            + (isSpec
                ? ' to a word only this story uses. Singular or plural, whichever reads right \u2014 it is never conjugated into a sentence.'
                : ' to a word only this story uses. It is not the map setting; it is what the story calls the thing.'),
            { key: 'ent_lt_why' }));
        // SHOW THE AUTHOR WHERE IT LANDS. The field is one word and its effect is a
        // sentence somewhere else, which is exactly the gap a preview closes.
        // [F-32] A SPECIES HAS NO IDENTITY LINE (see ceEntityIdentityLine for why), so its
        // preview shows the composed-list line instead -- which is where its kind-word
        // actually lands. Two previews rather than one because they are two different
        // sentences in two different entries, and showing a species the location preview
        // would promise it an opening line it never gets.
        if (isSpec) {
            kids.push(ceProse('t2',
                String(ent.locationType || '').trim()
                    ? ('The species list reads: \u201c' + String(ent.name || 'Name') + ' \u2014 '
                        + _ceArticle(String(ent.locationType)) + String(ent.locationType) + '.\u201d')
                    : 'Fill this in and the species list will read \u201c' + (ent.name || 'Name') + ' \u2014 a \u2026\u201d.',
                { key: 'ent_lt_prev' }));
        } else {
            kids.push(ceProse('t2', idLine
                ? ('The lorebook entry opens: \u201c' + idLine + '\u201d')
                : 'Fill this in and the entry will open with \u201c' + (ent.name || 'Name') + ' is a \u2026\u201d.',
                { key: 'ent_lt_prev' }));
        }
    }

    // [LOC-PROFILE7] DESCRIPTION IS NOT IDENTITY. Name and type say WHICH THING
    // THIS IS; description says what it is like, which is the first line of the profile
    // and now lives there. Keeping it here made the identity drill the place you edited
    // the profile from, which is exactly the drift that put it between the key list and
    // the button that adds one.

    kids.push(ceRule({ key: 'ent_id_rule2' }));
    kids.push(ceSub('t2', 'Keys', { key: 'ent_key_head' }));
    kids.push(ceProse('t3',
        (ent.name || 'The name') + ' is always a key. Add any other word or phrase that should pull this entry into the story \u2014 a nickname, a local name, what outsiders call it.',
        { key: 'ent_key_why' }));
    if (keyRows.length) kids.push(ceStack({ key: 'ent_keys' }, keyRows));
    kids.push(h(ceField, {
        key: 'ent_key_add', k: 'ent:keyadd:' + id, label: '',
        value: '', seed: String(st.keyGen || 0),
        placeholder: 'Another trigger word or phrase\u2026',
        // CLICK-BEFORE-BLUR: the Add button is read before this field's blur lands, so
        // the draft is a module var and onType never repaints.
        onType: function(v: string) { _ceEntKeyDraft = String(v || ''); },
        onCommit: function(v: string) { _ceEntKeyDraft = String(v || ''); return Promise.resolve(); }
    }));
    kids.push(ceWrap({ key: 'ent_key_addbtn' }, [
        ceBtn('Add key', 'ent:keyadd:' + id, function() {
            return ceEntityKeyOp(id, 'add', _ceEntKeyDraft);
        })
    ]));

    return ceStack(CE_T.s4, kids);
}

// [MAP-INLINE] THE THREE FIELDS THAT SET A PLACE UP ON THE MAP, ON THE PLACE'S OWN DISPLAY.
// They were behind the Map Entity launcher, which made building a map a four-hop round trip
// FOR EVERY LOCATION IN THE WORLD: map, profile, drill, back, map, next.
// THE SPLIT IS WHAT THE DRILL IS ABOUT, not convenience. mapKind, the icon and the colour are
// instructions for DRAWING this place; the drill is about where the node sits in the graph
// and what it joins. Travel tier stays there and is the clean test of the line -- it is a
// PRICE, not a picture, and it belongs with the edges rather than with the paint.
// ONE SITE, NOT TWO. The drill's copies are deleted for locations rather than duplicated
// here; it keeps the icon field for every other type, none of which has a map block.
// EVERY COMMIT REPUBLISHES BOTH MAPS. ceEntityWrite republishes this surface and nothing
// else; the circle map and the hex map are the other two readers of these fields and neither
// is told by anyone. The two publishes are chained rather than raced so a failure in the
// first does not leave the second unrun.
// [MAP-INLINE] `ent` IS A SHAPE, NOT NECESSARILY A RECORD: anything carrying mapKind, icon
// and mapColor will do. That is what lets the hex map mount this from its own projection --
// the cell panel has byId, never a loaded entity, and a renderer cannot await one.
// MOUNTED WITH h(), ALWAYS, AND THAT IS A CONTRACT. Two of its three hosts render it behind
// a condition, and _ceEntityIconPicker inside it is not known to be hook-free -- a hook that
// moves in and out of the ENCLOSING surface's list takes every later ref with it, which on
// the map surface is panRef and pinchRef. That is the whole of the pan-and-zoom fault this
// version fixes: a conditionally-rendered block was handing the map's own gesture refs away.
// A component has its own hook list and cannot do that to its host.
// `terse` DROPS THE HINTS, not the controls. On the map the block sits under a panel that is
// already under the map itself; three sentences of guidance there push the thing being
// configured off the screen, and the author reading them is looking straight at the result.
// [HEX-GESTURE] `quiet` DROPS THE PICKER AND NOTHING ELSE, and it exists because of a
// reported fault: with this block open on the hex map, panning and zooming slowed and then
// ran on by itself. That is HEX-RUNAWAY's signature and it had the same cause one level up
// -- the camera lives in ceHexStore, so every pointermove repaints the whole tab, and this
// block hangs sixty icon buttons off the bottom of it. Sixty <svg> subtrees rebuilt per
// pointer event is a backlog that drains after the finger stops, which is exactly what
// "keeps panning on its own" is.
// A PROP, NOT A MEMO. There are no hooks available here -- this block is mounted from a
// plain call inside a branch (see MAP-INLINE) -- so the host, which is the only thing that
// knows a gesture is in progress, says so.
function _ceEntityMapBlock(p: any): any {
    var id = String(p.id || '');
    var ent: any = p.ent || {};
    var terse = !!p.terse;
    var quiet = !!p.quiet;
    function mbHint(s: string): string { return terse ? '' : s; }
    var mbDraw = function() {
        return cePublishMap()
            .then(function() { return cePublishHex(); })
            .catch(function(eMb: any) {
                api.v1.error('[AE:jsxentity] map republish failed:', eMb);
                return null;
            });
    };
    return ceGroup('On the map', ceStack(CE_T.s3, [
        ceWrap({ key: 'mb_kind' }, [ ceSettingRow('Drawn as', mbHint(_ceMapKindHint((ent as any).mapKind)),
            ceSelect({
                k: 'ent:mapkind:' + id,
                value: ceMapKindOf((ent as any).mapKind),
                options: CE_MAP_KINDS,
                onCommit: function(v: string) {
                    return ceEntityWrite(id, 'mapKind', ceMapKindOf(v)).then(mbDraw);
                }
            }))]),
        // [HEX-LOCCOLOR] CLEARING IT IS THE UNDO and returns the place to its derived
        // colour, which is why the read line says 'Automatic' rather than 'No colour':
        // there is no state in which this place has no colour at all.
        ceColorRow('mb_col', 'Region colour',
            mbHint('What this place is outlined and tinted in on the hex map. Left clear, it '
            + 'is derived from the record and already differs from its neighbours.'),
            { k: 'ent:mapcol:' + id, label: 'Region colour',
              value: String((ent as any).mapColor || ''),
              allowNone: true, noneLabel: 'Automatic',
              onCommit: function(v: string) {
                  return ceEntityWrite(id, 'mapColor', ceColorNorm(v) || undefined).then(mbDraw);
              } }),
        h(ceField, {
            key: 'mb_emoji', k: 'ent:icon:' + id, label: 'Icon',
            value: ceIconIsSvg(ent.icon) ? '' : (ent.icon || ''),
            placeholder: ceIconIsSvg(ent.icon) ? '\u2014' : '\ud83c\udf0d',
            onCommit: function(v: string) { return ceEntityWrite(id, 'icon', v).then(mbDraw); }
        }),
        // MOUNTED WITH h() AND DECIDING INTERNALLY, per the contract this block's own header
        // states. Branching on `quiet` HERE would move a call in and out of this component's
        // render, which is the shape that hands hook lists away; a component that renders
        // null keeps its own list and cannot do that to its host.
        ceWrap({ key: 'mb_iconpick' }, [ h(_ceMapIconPickC, { key: 'mb_pickc', id: id, ent: ent, quiet: quiet }) ])
    ]));
}

// [HEX-GESTURE] THE PICKER'S OWN COMPONENT, and its whole reason for existing is the line
// above: it is the expensive half of the block and the half that can be dropped mid-gesture
// without the author noticing, because during a pan it is off the bottom of the screen.
function _ceMapIconPickC(p: any): any {
    if (p && p.quiet) return null;
    return _ceEntityIconPicker(String((p && p.id) || ''), (p && p.ent) || {});
}

// -- Entity drill  [LOC-PROFILE2] ---------------------------------------------
// THE GRAPH OBJECT, as opposed to the place. Kind, map treatment, icon, where it sits,
// what it connects to, what is inside it, and deletion. Everything here is about the
// entity's position in the world graph rather than about what the story knows.
//
// REACHABLE FOR A CHARACTER BODY TOO, which is the point: a body is an entity and until
// now there was no route to it from anywhere.
function _ceEntityGraphDrill(id: string, ent: any, st: any, backAddr: any): any {
    var kids: any[] = [];

    kids.push(ceStack({ gap: CE_T.s1, key: 'ent_type' }, [
        ceSub('t2', 'Kind'),
        ceSelect({
            k: 'ent:type:' + id, value: String(ent.type || 'location'),
            options: CE_ENTITY_TYPES,
            onCommit: function(v: string) { return ceEntityWrite(id, 'type', v); }
        })
    ]));

    // [MAP-INLINE] THE SAME BLOCK THE DISPLAY MOUNTS, not a second copy of the controls and
    // not a redirect to the display either. Per user: every map type reads these fields, so
    // the drill that is ABOUT the map keeps them -- the display gained a second door, it did
    // not take the first one away. ONE RENDERER, TWO HOSTS, which is the arrangement
    // PANEL-PICK already settled for the picker: two controls writing one field through two
    // code paths is how a select comes to offer a vocabulary its twin does not.
    if (ent.type === 'location') {
        kids.push(h(_ceEntityMapBlock, { key: 'ent_mapblock_d', id: id, ent: ent }));

        // [SEC:TRAVEL] THE PRICE OVERRIDE, AND IT IS A PICKER. A text field here would
        // accept 'a', 'tier 1' and '1 ' as readily as 1, and the difference between a
        // rejected entry and an accepted one would only ever show up as a journey costing
        // the wrong amount three surfaces away. A tier is one of a knowable set of
        // integers, so the control offers that set and nothing else -- SS13's rule reached
        // by its own argument rather than by its letter.
        //
        // THE DEFAULT IS AN OPTION, NOT AN EMPTY STATE. The first row IS this place's own
        // depth, named and numbered, so "unset" is a thing the author can read and choose
        // rather than a blank they have to interpret. Selecting it clears the override,
        // which is why the id is '' and not the depth itself: storing the depth would
        // freeze it, and re-parenting the place would then leave a stale number behind.
        var ttOpts: any[] = [{ id: '', label: 'Its depth \u2014 tier ' + String(st.travelDepth || 0) }];
        var ttList: any[] = st.travelTiers || [];
        var tti = 0;
        for (tti = 0; tti < ttList.length; tti++) {
            ttOpts.push({ id: String(ttList[tti]), label: 'Tier ' + String(ttList[tti]) });
        }
        kids.push(ceStack({ gap: CE_T.s1, key: 'ent_travtier' }, [
            ceSub('t2', 'Travel tier'),
            ceSelect({
                k: 'ent:travtier:' + id,
                value: ((ent as any).travelTier === undefined || (ent as any).travelTier === null)
                    ? '' : String((ent as any).travelTier),
                options: ttOpts,
                onCommit: function(v: string) {
                    var raw = String(v == null ? '' : v);
                    var next: any = undefined;
                    if (raw !== '') next = Math.max(0, Math.round(Number(raw) || 0));
                    // ceEntityWrite republishes this surface itself; the map is the other
                    // reader of the field and does not, so it is republished by hand.
                    return ceEntityWrite(id, 'travelTier', next).then(function() { return cePublishMap(); });
                }
            }),
            ceProse('t3', 'How far away this place counts as. Lower is wider. Leave it on '
                + 'its depth unless this branch is drawn finer or coarser than the rest.')
        ]));
    }

    // [MAP-INLINE] EVERY TYPE BUT A LOCATION. A location's icon rides the map block pushed
    // above, with the other two drawing fields; every other type has no such block, and an
    // icon still reaches the bridge's entity pickers, so this is where theirs stays. BOTH
    // HALVES ARE GATED TOGETHER -- the field and the picker write one value, and leaving one
    // of them here would put the same field in this drill twice.
    // h() rather than a bare call, so a conditional field is a component with its own hook
    // list rather than a hook moving in and out of this surface's.
    if (ent.type !== 'location') {
        kids.push(h(ceField, {
            key: 'ent_icon', k: 'ent:icon:' + id, label: 'Icon',
            value: ceIconIsSvg(ent.icon) ? '' : (ent.icon || ''),
            placeholder: ceIconIsSvg(ent.icon) ? '\u2014' : '\ud83c\udf0d',
            onCommit: function(v: string) { return ceEntityWrite(id, 'icon', v); }
        }));
        kids.push(ceWrap({ key: 'ent_iconpick' }, [ _ceEntityIconPicker(id, ent)]));
    }

    // [LOC-PROFILE6] locationVisuals MOVED TO Images. It is the prompt the
    // picture is generated from, so it belongs with the picture and the Generate button
    // that reads it -- not in a drill about where the node sits in the graph. Its old home
    // here left the field and its only consumer two surfaces apart.

    // [ITEM-HOLD] Not pushed at all when the block is null, rather than pushed
    // empty: ceStack's gap would otherwise leave an item's drill with a blank band where
    // Placement used to be. Every child of this list is keyed, so a length that varies by
    // type is safe -- see the root's own note on why that is not optional.
    var placement: any = _ceEntityPlacement(id, ent, st);
    if (placement) kids.push(ceWrap({ key: 'ent_place' }, [ placement]));
    kids.push(ceWrap({ key: 'ent_conng' }, [ _ceEntityConns(id, st)]));
    kids.push(ceWrap({ key: 'ent_contg' }, [ _ceEntityContents(id, ent, st)]));

    // [G-01] DELETE IS NOT HERE ANY MORE, per author: it is the last block on the PROFILE
    // (_ceEntityDeleteBlock, called from _ceEntityRoot). This drill is about where the node
    // sits in the graph, and "remove the record entirely" was never a graph edit -- it was
    // filed here because this drill existed first. The bottom of the profile is where a
    // destructive act belongs: past everything the author would otherwise be editing.

    return ceStack(CE_T.s4, kids);
}

// [G-01] THE ONE DELETE, AT THE BOTTOM OF THE PROFILE. Confirms IN PLACE rather than
// through confirmDeleteEntity's native modal -- a jsx surface that opens a UIPart modal to
// ask a yes/no question is the overlay pattern JSXPROFILE-NO-OVERLAY rules out.
//   IT TAKES THE LOREBOOK ENTRY WITH IT, per author. Deleting the record and leaving its
//   entry behind left an orphan that still MATCHED ITS KEYS and still injected -- a deleted
//   place going on describing itself to the model, with no surface left to find it from.
//   The unlink path already existed (unlinkEntityLorebookEntry); nothing called it on delete.
function _ceEntityDeleteBlock(id: string, ent: any, st: any, backAddr: any): any {
    var confirming = (String(st.confirm || '') === id);
    var isFacD = (String(ent.type || '') === 'faction');
    // [F-29] THE CONSEQUENCE IS TYPE-SPECIFIC. A place loses its children to the world
    // root; a faction loses every standing held with it. One sentence for both would have
    // to be vague enough to warn about neither.
    var why = isFacD
        ? ('Delete ' + (ent.name || 'this faction') + '? The standing every character held '
           + 'with it goes too.')
        : ('Delete ' + (ent.name || 'this') + '? Anything inside it moves to the top of the '
           + 'world rather than going with it.');
    if (ent.lorebookEntryId) why += ' Its lorebook entry is removed as well.';
    return ceGroup('Remove', ceStack(CE_T.s2, [
        ceSub('t3', ent.lorebookEntryId
            ? 'Deleting this removes the record and its linked lorebook entry. It cannot be undone.'
            : 'Deleting this removes the record. It cannot be undone.'),
        ceInline({ key: 'ent_del', gap: CE_T.s2 }, [
            confirming ? ceProse('t2', why, { grow: true, basis: '160px' }) : null,
            confirming
                ? ceBtn('Delete', 'ent:del:' + id, function() { return ceEntityDelete(id, backAddr); }, 'danger')
                : ceBtn('Delete ' + (ent.name || 'this') + '\u2026', 'ent:delask:' + id, function() {
                    ceEntityPatch(function() { return { confirm: id }; });
                    return Promise.resolve();
                  }, 'danger'),
            confirming
                ? ceBtn('Keep it', 'ent:delno:' + id, function() {
                    ceEntityPatch(function() { return { confirm: '' }; });
                    return Promise.resolve();
                  })
                : null
        ])
    ]));
}

// ============================================================================
// SECTION 37 — WIZARD SURFACE (jsx)
// World generation: species, factions, locations, narratives, the cast, the intro.
//
// THE GENERATORS ARE NOT HERE. Every one of them is a free function with no UI
// dependency, and this section only renders them. A pass on this section that
// edits a generator body has drifted.
//
// A ROUTE WITH tray:false, like Settings.
//
// FOUR STRUCTURAL RULES:
//   1. The context checklist and the count-and-Generate row are ONE component
//      each, reused by every tab.
//   2. Staging is ONE component driven by WIZ_DRAFT_FIELDS.
//   3. COMMITTED RECORDS ARE EDITED WHERE THEY LIVE, NOT HERE. Species and
//      factions on Settings, locations and narratives on the Entity surface.
//      What stays is the part only the wizard has -- the per-record Regen
//      against chosen context -- plus a row that navigates to the real editor.
//   4. Project Name / Genre / Initial Concept live on the Setup tab. They are
//      the seed EVERY generator on this surface reads through
//      buildWizardMultiContext.
//
// TABS ARE ceTabGet / ceTabSet.
//
// PUBLISH IS TAB-SCOPED. cePublishWiz reads the active tab and loads only what
// that tab renders: loadAllCharacters and loadRelationships are Drama's alone, the
// entity index is Locations/Intro/Drama's. A tab change republishes. The native
// surface reloaded everything on every keystroke-driven redraw; this does not.
//
// WRITE CHAINS, BY STORAGE, NOT BY SURFACE: config -> ceSettingsOp (it is the
// config chain and Settings already owns it; a second chain over one store is
// the bug both chains exist to prevent), entities -> ceEntityOp, characters ->
// ceProfileOp, drafts/web/intro -> ceWizOp. Where a verb needs two, the fixed
// global order holds: ceEntityOp OUTER, ceProfileOp INNER.
//
// WHAT IS DELIBERATELY ABSENT:
//   - A Help tab (it was an icon catalogue for build-time reference).
//   - Creating a classic wizard chat. loadWizardChats and its siblings are
//     DEAD-PENDING; existing chats are offered as context sources and nothing
//     here offers to make one.
//   - DEFAULT_WIZARD_TOPICS' 'Bestiary' and 'Items', DEAD-PENDING since earlier
//     with their generators already removed.
//   - Per-item regen hints in tempStorage. The hint is a module var here and
//     dies with the tap.
// ============================================================================

// [WIZ-ONE-DOOR] THE SETUP TAB IS DELETED AND ITS CONTENTS MOVED INTO 'Start'. It held the
// project seed and one button whose whole job was to switch to the Chat tab -- which is the
// definition this file already gives of a duplicate screen ("a tab whose body is a single
// button to somewhere else is a door, not a tab"). Naming the project, saying what it is, and
// talking it through are ONE act, so they are one surface; the seed sits at the top of it,
// collapsed once written, and the brainstorm sits under it.
// THE TAB ID STAYS 'chat'. It is written into ceOpenWizChatConfirmDiscard, ceTrayChatSummarize
// and every stored tab token; renaming the id to match the label would be a flag day for a
// word. A stored 'wizard:setup' from an earlier session resolves here through _ceWizTab.
var CE_WIZ_TABS: any[] = [
    { id: 'chat',       label: 'Start' },
    // [JSXWIZCHAT] SECTION 3e's WIZLIVE, which earlier deliberately
    // left out ("reachable from outside the wizard, NOT a superseded view") and routed to
    // the Chat surface instead. THAT ROUTING WAS WRONG IN PRACTICE: CharChat is a character
    // texting you, WIZLIVE is a planning conversation whose saved output becomes the context
    // every generator on the other seven tabs reads. Sending an author to CharChat for that
    // job left the whole surface with no way to make the thing it consumes -- which is also
    // why the generator tabs read as "missing context selection": _ceWizSources was fine,
    // it just had nothing to list. Second position, directly after Setup, because it feeds
    // everything to its right.
    { id: 'memory',     label: 'Memory' },
    { id: 'species',    label: 'Species' },
    // [WIZ-ENTKIND] FACTIONS AND ITEMS COME BACK, AS DOORS. Read F-28's removal note before
    // touching either: what it deleted was a SECOND EDITOR that wrote cfg.factions, and the
    // objection was never that a faction has no place in the wizard -- it was that the tab
    // renamed, described and synced a record the Entity surface already owns better. These
    // two generate a named record from the chats you chose, show what came back, and open.
    // No rename, no delete, no hierarchy editor: TABS ARE CONTENT THAT STAYS, LAUNCHERS ARE
    // DOORS THAT LEAVE. A faction's five lens fields and its org chart stay on its profile.
    { id: 'factions',   label: 'Factions' },
    { id: 'items',      label: 'Items' },
    { id: 'locations',  label: 'Locations' },
    { id: 'characters', label: 'Characters' },
    { id: 'drama',      label: 'Drama' },
    { id: 'intro',      label: 'Intro' }
];

// [WIZ-ONE-DOOR] ONE DERIVATION OF WHICH TAB IS SHOWING, read by cePublishWiz and by the
// root. They must agree exactly -- the root holds the body back until st.tab matches what it
// resolved -- so two copies of the fallback is two chances to disagree and one permanent
// loading state. Also where the retired 'setup' token is folded home: a story that was last
// left on Setup lands on Start rather than on a tab that no longer renders.
function _ceWizTab(): string {
    var t = ceTabGet('wizard', 'chat');
    if (t === 'setup') return 'chat';
    return t;
}

// The tempStorage token per tab, and it is NOT always the tab id: the native species and
// factions branch writes the singular DRAFT kind while characters and locations write the
// plural TAB id. Load-bearing while the native surface is alive, since both read the same
// keys. Verified against the native branches at 20859, 20933, 21036, 21156, 21239, 21444.
var CE_WIZ_SRC_KIND: { [tab: string]: string } = {
    memory: 'memory', species: 'species', factions: 'faction', items: 'item',
    locations: 'locations', characters: 'characters', drama: 'drama', intro: 'intro'
};
// -- Store, publish, op-chain -------------------------------------------------
var ceWizStore: any = null;
var _ceWizChain: Promise<any> = Promise.resolve();
// Read by BUTTONS, so they cannot live in the state the button renders from --
// CLICK-BEFORE-BLUR, the same shape and reason as _ceEntKeyDraft and _cePickDraft.
var _ceWizAddName = '';
var _ceWizHints: { [id: string]: string } = {};
// [WIZ-SRCFILTER] The context checklist's filter draft. A MODULE VAR WRITTEN BY onType, never
// store state -- CLICK-BEFORE-BLUR, the same contract _ceWizHints and _ceWizAddName run on:
// a chip tapped while the box has focus is delivered BEFORE the blur it causes, so a draft
// held in the store would be one keystroke stale at exactly the moment it is read.
// PER TAB, because the selection is per tab: filtering the Species sources and then moving
// to Locations must not carry a needle that hides everything there.
var _ceWizSrcQ: { [tab: string]: string } = {};

// [JSXWIZCHAT] Chat-tab drafts. Same CLICK-BEFORE-BLUR rule as every other draft
// on this surface: module vars, never store state, because Start/Save are CLICKS and a
// click is delivered before the blur that would commit a ceField.
//   _ceWizChatPersona  — the topic id chosen for a NOT-YET-STARTED chat ('' = general)
//   _ceWizChatCtxPick  — { entryId: true } context preselected for a not-yet-started chat
//                        (the native _wizModalCtxPick, verbatim in role)
//   _ceWizChatTitle    — rename draft for a LIVE chat
//   _ceWizChatSummary  — the editable summary preview before it is banked
var _ceWizChatPersona = '';
var _ceWizChatCtxPick: { [id: string]: boolean } = {};
var _ceWizChatTitle = '';
var _ceWizChatSummary = '';

function ceWizStoreInit(): void {
    if (ceWizStore) return;
    try {
        ceWizStore = createStore({
            ready: false, tab: '', cfg: null,
            chats: [], ceEntries: [], drafts: [], roster: [],
            activeChatId: '', srcSel: {},
            entIndex: [], locParent: '', locParentName: '', locParentUp: '',
            chars: [],
            introLocId: '', introLocName: '', introProse: '',
            // [JSXWIZCHAT] `live` is a PROJECTION of _aeLiveWiz (SECTION 3e), not a
            // second copy of it: the module var stays authoritative and this is refreshed by
            // cePublishWiz like everything else here. `summary` holds a generated preview
            // awaiting the author's Save -- it is deliberately store state and not a module
            // var, unlike the draft above, because its ARRIVAL must repaint.
            live: null, summary: '',
            preview: null, confirm: '', addGen: 0, draftGen: 0
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] store init failed:', e); }
}

function ceWizPatch(fn: (s: any) => any): void {
    if (!ceWizStore) return;
    try {
        ceWizStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] patch failed:', e); }
}

// Serialises this surface's own load-modify-save writes: the draft list, the NPC web and
// the intro draft, each of which is rewritten whole. Config, entity and character writes
// go to their own chains instead -- see the header.
//
// A GENERATION NEVER RUNS INSIDE IT, which is why Generate, Regen and Commit are not
// wrapped. See the note above _ceWizCommit.
function ceWizOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceWizChain.then(fn);
    _ceWizChain = run.catch(function() { return null; });
    return run;
}

function _ceWizReadSrc(tab: string, chats: any[], entries: any[]): Promise<string[]> {
    var token = CE_WIZ_SRC_KIND[tab] || tab;
    return Promise.resolve(api.v1.tempStorage.getOrDefault(STORAGE_WIZ_TAB_SRC + token, ''))
        .then(function(raw: any) {
            var ids: string[] = [];
            try {
                var parsed = JSON.parse(String(raw || '') || '[]');
                var pi = 0;
                for (pi = 0; pi < (parsed || []).length; pi++) { if (parsed[pi]) ids.push(String(parsed[pi])); }
            } catch (eSrc) { ids = []; }
            var live: string[] = [];
            var li = 0;
            for (li = 0; li < ids.length; li++) {
                var wanted = ids[li];
                var found = false;
                var ci = 0;
                for (ci = 0; ci < (chats || []).length; ci++) { if (chats[ci] && chats[ci].id === wanted) found = true; }
                var ei = 0;
                for (ei = 0; ei < (entries || []).length; ei++) { if (entries[ei] && entries[ei].id === wanted) found = true; }
                if (found) live.push(wanted);
            }
            return live;
        })
        .catch(function() { return []; });
}

function _ceWizReadIdList(key: string): Promise<string[]> {
    return Promise.resolve(api.v1.tempStorage.getOrDefault(key, ''))
        .then(function(raw: any) {
            var out: string[] = [];
            try {
                var parsed = JSON.parse(String(raw || '') || '[]');
                var i = 0;
                for (i = 0; i < (parsed || []).length; i++) { if (parsed[i]) out.push(String(parsed[i])); }
            } catch (eList) { out = []; }
            return out;
        })
        .catch(function() { return []; });
}

// ONE LOAD, SCOPED TO THE ACTIVE TAB. Sequential awaits throughout -- no Promise.all.
async function cePublishWiz(): Promise<void> {
    ceWizStoreInit();
    if (!ceWizStore) return;
    try {
        var tab = _ceWizTab();

        var cfg: any = null;
        try { cfg = await loadConfig(); } catch (eCfg) { cfg = null; }
        var chats: any[] = [];
        try { chats = (await loadWizardChats()) || []; } catch (eChats) { chats = []; }
        var entries: any[] = [];
        try { entries = (await listWizChatEntries()) || []; } catch (eEntries) { entries = []; }
        var drafts: any[] = [];
        try { drafts = (await loadWizardDrafts()) || []; } catch (eDrafts) { drafts = []; }
        var activeId = '';
        try { activeId = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_ACTIVE_CHAT, '')) || ''); }
        catch (eActive) { activeId = ''; }

        var srcSel: any = {};
        if (CE_WIZ_SRC_KIND[tab]) {
            srcSel[tab] = await _ceWizReadSrc(tab, chats, entries);
        }

        var roster: any[] = [];
        if (tab === 'characters') {
            try { roster = (await loadIndex()) || []; } catch (eRoster) { roster = []; }
        }

        // The entity index backs four tabs and the intro picker; nothing else reads it.
        // [F-32] 'species' joined the list when species became entities -- without it that
        // tab reads an empty array and renders "None yet." over a world full of them.
        var entIndex: any[] = [];
        if (tab === 'locations' || tab === 'intro' || tab === 'drama' || tab === 'species'
            || tab === 'factions' || tab === 'items') {
            try { entIndex = (await loadEntityIndex()) || []; } catch (eIdx) { entIndex = []; }
        }

        var locParent = '';
        var locParentName = '';
        var locParentUp = '';
        if (tab === 'locations') {
            try { locParent = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_LOC_PARENT, '')) || ''); }
            catch (eLp) { locParent = ''; }
            if (locParent) {
                var pMeta: any = null;
                var pi2 = 0;
                for (pi2 = 0; pi2 < entIndex.length; pi2++) { if (String(entIndex[pi2].id) === locParent) pMeta = entIndex[pi2]; }
                if (!pMeta) {
                    // The parent was deleted out from under the breadcrumb. Reset rather
                    // than render a dead crumb, exactly as the native branch does.
                    locParent = '';
                    try { await api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, ''); } catch (eLpr) {}
                } else {
                    locParentName = String(pMeta.name || 'Unnamed');
                    locParentUp = String(pMeta.parentId || '');
                }
            }
        }

        // [WIZ-ROWTEXT] THE TEXT THE GENERATORS WRITE, PROJECTED FOR THE ROWS THAT RENDER.
        // entIndex is EntityMeta and has never carried a body -- so the "In this world" list
        // could show a name and a kind-word for a record whose whole content had just been
        // regenerated, and the author had to leave for the Entity surface to read what they
        // had asked for. This is the missing half of that round trip.
        //   SCOPED TO THE VISIBLE ROWS, not to the world. Species is every species (the tab
        //   lists them all); locations is the CURRENT LEVEL ONLY, which the tree already
        //   scopes to one parent. Loading every entity to paint one level would make the
        //   cost of this tab grow with a world it does not display.
        //   EAGER, NOT ON EXPAND. ceExpandRow toggles through ceUiStore, which repaints the
        //   tree WITHOUT republishing this store -- so a lazy load keyed on `open` would
        //   render the field blank on the tap that opened it and fill it on some later,
        //   unrelated publish. Load with the list or not at all.
        var entText: any = {};
        if (tab === 'species' || tab === 'locations' || tab === 'factions' || tab === 'items') {
            var etWant: string[] = [];
            var eti = 0;
            for (eti = 0; eti < entIndex.length; eti++) {
                var etM: any = entIndex[eti];
                if (!etM) continue;
                if (tab === 'locations') {
                    if (String(etM.type) !== 'location') continue;
                    if (String(etM.parentId || '') !== locParent) continue;
                } else {
                    if (String(etM.type) !== String(ceWizEntKind(tab).kind)) continue;
                }
                etWant.push(String(etM.id));
            }
            for (eti = 0; eti < etWant.length; eti++) {
                try {
                    var etE: any = await loadEntity(etWant[eti]);
                    if (etE) {
                        entText[etWant[eti]] = {
                            description: String(etE.description || ''),
                            lorebookText: String((etE as any).lorebookText || '')
                        };
                    }
                } catch (eEt) { /* one unreadable record must not blank the whole list */ }
            }
        }

        var chars: any[] = [];
        // [WEB-GONE] The relationships read left with the Web block. Drama still loads the
        // cast for its Hooks rows; nothing on this surface reads a pair record any more.
        if (tab === 'drama') {
            try { chars = (await loadAllCharacters()) || []; } catch (eChars) { chars = []; }
        }

        var introLocId = '';
        var introLocName = '';
        var introProse = '';
        if (tab === 'intro') {
            try { introLocId = String((await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_INTRO_LOC, '')) || ''); }
            catch (eIl) { introLocId = ''; }
            if (introLocId) {
                var iFound = false;
                var ii2 = 0;
                for (ii2 = 0; ii2 < entIndex.length; ii2++) {
                    if (String(entIndex[ii2].id) === introLocId) { iFound = true; introLocName = String(entIndex[ii2].name || 'Unnamed'); }
                }
                if (!iFound) {
                    introLocId = '';
                    try { await api.v1.tempStorage.set(STORAGE_WIZ_INTRO_LOC, ''); } catch (eIlr) {}
                }
            }
            var idr: any = null;
            try { idr = await loadIntroDraft(); } catch (eId) { idr = null; }
            introProse = String((idr && idr.prose) || '');
        }

        // [JSXWIZCHAT] Live WIZLIVE state, projected. Read UNCONDITIONALLY rather
        // than under `if (tab === 'chat')` like the other tab-scoped reads above: a chat
        // being open is a constraint on the WHOLE surface (startLiveWizardChat refuses while
        // one is active, and so does the classic wizard), so a tab that cannot see it would
        // offer buttons that can only fail. It costs nothing -- _aeLiveWiz is a module var,
        // not a storage read.
        var live: any = null;
        try {
            live = {
                active: !!_aeLiveWiz.active,
                title: String(_aeLiveWiz.title || ''),
                topicId: String(_aeLiveWiz.topicId || ''),
                startedAt: Number(_aeLiveWiz.startedAt || 0),
                ctxIds: (_aeLiveWiz.contextEntryIds || []).slice()
            };
        } catch (eLive) { live = null; }

        ceWizPatch(function(s: any) {
            return { ready: true, tab: tab, cfg: cfg, chats: chats, ceEntries: entries,
                     drafts: drafts, roster: roster, activeChatId: activeId,
                     srcSel: srcSel, entIndex: entIndex, entText: entText,
                     locParent: locParent, locParentName: locParentName, locParentUp: locParentUp,
                     chars: chars,
                     introLocId: introLocId, introLocName: introLocName, introProse: introProse,
                     live: live, summary: String(s.summary || ''),
                     draftGen: Number(s.draftGen || 0) + 1 };
        });
    } catch (e) { api.v1.error('[AE:jsxwizard] publish failed:', e); }
}

// -- Shared helpers -----------------------------------------------------------
// The ids a generator on this tab will actually receive: whatever is checked, else the
// active classic chat if one exists, else nothing and the generator runs on the project
// concept alone. Identical fallback chain to every native branch.
function _ceWizEffSrc(st: any, tab: string): string[] {
    var sel: string[] = ((st && st.srcSel && st.srcSel[tab]) || []) as string[];
    if (sel.length) return sel.slice();
    var act = String((st && st.activeChatId) || '');
    if (act) return [act];
    return [];
}

function _ceWizDraftsOf(st: any, kind: string): any[] {
    var all: any[] = (st && st.drafts) || [];
    var out: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) { if (all[i] && all[i].kind === kind) out.push(all[i]); }
    return out;
}

// Writes tempStorage AND patches the store rather than republishing: a republish would
// re-read the lorebook and the whole draft list to move one checkmark.
function _ceWizToggleSrc(tab: string, id: string): Promise<any> {
    var token = CE_WIZ_SRC_KIND[tab] || tab;
    var cur: string[] = [];
    try {
        var s: any = ceWizStore ? ceWizStore.get() : null;
        cur = ((s && s.srcSel && s.srcSel[tab]) || []).slice();
    } catch (eCur) { cur = []; }
    var at = cur.indexOf(id);
    if (at >= 0) { cur.splice(at, 1); } else { cur.push(id); }
    var next = cur;
    ceWizPatch(function(s2: any) {
        var sel: any = {}; var k: string;
        for (k in (s2.srcSel || {})) { sel[k] = s2.srcSel[k]; }
        sel[tab] = next;
        // The preview is a snapshot of the OLD selection the moment this lands, so it is
        // dropped rather than left on screen lying about what would be sent.
        return { srcSel: sel, preview: null };
    });
    return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_TAB_SRC + token, JSON.stringify(next)))
        .catch(function(e: any) { api.v1.error('[AE:jsxwizard] source write failed:', e); });
}

// THE CONTEXT CHECKLIST, ONCE. Chips rather than checkbox rows: this is a multi-select
// over short labels, which is what CE-STYLE gives ceChip for, and a column of full-width
// 44px rows for six saved chats would push Generate off a phone screen before it was
// reachable.
// [WIZ-SRCFILTER] TWO GROUPS AND A FILTER. This rendered every classic chat and every CE
// Chats entry as one undifferentiated run of chips, uncapped -- unusable at a real world's
// worth of records, and it hid the fact that the two are different kinds of source already
// looped separately. They keep their own headers now, and the needle matches the label the
// author can see rather than an id they cannot.
//   A SELECTED CHIP IS NEVER FILTERED OUT. Hiding a checked source would let a generation
//   run against a chat the surface is not showing -- the checklist would stop being a list
//   of what is attached, which is the one thing it is for.
function _ceWizSources(tab: string, st: any): any {
    var chats: any[] = (st && st.chats) || [];
    var entries: any[] = (st && st.ceEntries) || [];
    var sel: string[] = ((st && st.srcSel && st.srcSel[tab]) || []) as string[];
    var needle = String(_ceWizSrcQ[tab] || '').trim().toLowerCase();
    function srcShow(id: string, label: string): boolean {
        if (sel.indexOf(id) >= 0) return true;
        if (!needle) return true;
        return String(label || '').toLowerCase().indexOf(needle) >= 0;
    }
    var chatChips: any[] = [];
    var entryChips: any[] = [];
    var nChat = 0;
    var nEntry = 0;
    var i = 0;
    for (i = 0; i < chats.length; i++) {
        (function(c: any) {
            var cid = String(c.id);
            var lbl = String(c.title || 'Untitled chat');
            nChat++;
            if (!srcShow(cid, lbl)) return;
            chatChips.push(ceChip(lbl, sel.indexOf(cid) >= 0, function() {
                ceAction('wiz:src:' + tab + ':' + cid, function() { return _ceWizToggleSrc(tab, cid); });
            }));
        })(chats[i]);
    }
    for (i = 0; i < entries.length; i++) {
        (function(e: any) {
            var eid = String(e.id);
            var lbl = String(e.displayName || 'Untitled chat');
            nEntry++;
            if (!srcShow(eid, lbl)) return;
            entryChips.push(ceChip(lbl, sel.indexOf(eid) >= 0, function() {
                ceAction('wiz:src:' + tab + ':' + eid, function() { return _ceWizToggleSrc(tab, eid); });
            }));
        })(entries[i]);
    }
    var chips: any[] = chatChips.concat(entryChips);

    var act = String((st && st.activeChatId) || '');
    var actName = '';
    for (i = 0; i < chats.length; i++) { if (chats[i] && String(chats[i].id) === act) actName = String(chats[i].title || ''); }
    var hint = sel.length
        ? (sel.length + ' selected.')
        : (actName ? ('Nothing selected \u2014 using the active chat \u201c' + actName + '\u201d.')
                   : 'Nothing selected \u2014 generating from the project concept only.');

    var body: any[] = [];
    // The filter appears only once there is enough to filter. A search box over four chips
    // is a control that costs a tap and saves none.
    if ((nChat + nEntry) > 8) {
        body.push(ceWrap({ key: 'wsrc_q' }, [ h(ceField, {
            key: 'wsrc_qf_' + tab, k: 'wiz:srcq:' + tab, label: '',
            value: String(_ceWizSrcQ[tab] || ''),
            placeholder: 'Filter by name\u2026',
            onType: function(v: string) { _ceWizSrcQ[tab] = String(v || ''); },
            // ceField commits on blur unguarded, so onCommit is not optional decoration --
            // and this is where the repaint happens: onType deliberately does not publish.
            onCommit: function(v: string) { _ceWizSrcQ[tab] = String(v || ''); return cePublishWiz(); }
        })]));
    }
    if (!chips.length) {
        body.push(ceProse('t3',
            (nChat + nEntry) > 0
                ? 'Nothing matches that. Clear the filter to see all ' + (nChat + nEntry) + '.'
                : 'No saved chats in this story. Generation uses the project concept only \u2014 fill in Setup if it is blank.',
            { key: 'wsrc_none' }));
    } else {
        if (chatChips.length) {
            body.push(ceSub('t3', 'Chats \u00b7 ' + chatChips.length + ' of ' + nChat));
            body.push(ceInline({ gap: CE_T.s2, key: 'wsrc_chats' }, chatChips));
        }
        if (entryChips.length) {
            body.push(ceSub('t3', 'Saved entries \u00b7 ' + entryChips.length + ' of ' + nEntry));
            body.push(ceInline({ gap: CE_T.s2, key: 'wsrc_entries' }, entryChips));
        }
    }
    body.push(ceProse('t3', hint, { key: 'wsrc_hint' }));
    body.push(ceWrap({ key: 'wsrc_pv' }, [ _ceWizPreview(tab, st)]));
    return ceGroup('Context', ceStack(CE_T.s2, body));
}

// Preview, IN SURFACE. The native version opens a UIPart modal over the wizard, which is
// the overlay pattern JSXPROFILE-NO-OVERLAY rules out for this shell.
function _ceWizPreview(tab: string, st: any): any {
    var pv: any = (st && st.preview) || null;
    var showing = !!(pv && pv.tab === tab);
    var acts = ceInline({ gap: CE_T.s2, key: 'wpv_acts' }, [
        showing
            ? ceBtn('Hide context', 'wiz:pv:hide:' + tab, function() {
                ceWizPatch(function() { return { preview: null }; });
                return Promise.resolve();
              })
            : ceBtn('Preview context', 'wiz:pv:' + tab, function() {
                var ids = _ceWizEffSrc(st, tab);
                return Promise.resolve(buildWizardContextPreview(ids)).then(function(text: string) {
                    ceWizPatch(function() { return { preview: { tab: tab, text: String(text || '') } }; });
                });
              })
    ]);
    if (!showing) return acts;
    return ceStack(CE_T.s2, [
        acts,
        ceWell({ key: 'wpv_body', text: String(pv.text || '(nothing would be sent)') })
    ]);
}

// THE COUNT-AND-GENERATE ROW, ONCE. `token` is the tempStorage suffix, which is the tab
// for most callers but 'web' / 'narrative' inside Drama -- one tab, three generators.
// [GEN-GUIDED] The generation door on every wizard tab: a NAME, not a count.
// The draft is a module var for the same CLICK-BEFORE-BLUR reason every other draft on this
// surface is — "Write it" is a click and a click is delivered before the field's blur, so
// reading store state here would send the PREVIOUS name.
var _ceWizGenName: { [token: string]: string } = {};

function _ceWizNameRow(token: string, label: string, placeholder: string, run: (name: string) => Promise<any>): any {
    return ceInline({ gap: CE_T.s3, align: 'end' }, [
        ceGrow({ key: 'wgn_f', basis: '160px' }, [
            h(ceField, {
                key: 'wgn_' + token, k: 'wiz:genname:' + token, label: 'Name',
                value: String(_ceWizGenName[token] || ''), placeholder: placeholder,
                onType: function(v: string) { _ceWizGenName[token] = String(v || ''); },
                onCommit: function(v: string) { _ceWizGenName[token] = String(v || ''); return Promise.resolve(); }
            })]),
        ceFixed({ key: 'wgn_go', basis: '120px' }, [
            ceBtn(label, 'wiz:genname:go:' + token, function() {
                var gnN = String(_ceWizGenName[token] || '').trim();
                if (!gnN) {
                    try { api.v1.ui.toast('Give it a name first.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
                    return Promise.resolve();
                }
                return Promise.resolve(run(gnN)).then(function(r: any) { _ceWizGenName[token] = ''; return r; });
            }, 'primary')])
    ]);
}

// The one-shot regen instruction. Session-scoped by design: it describes THIS press, not
// a preference, and the native surface persisting it in tempStorage gave it a lifetime
// nothing wanted.
function _ceWizHintField(id: string): any {
    return h(ceField, {
        key: 'whint_' + id, k: 'wiz:hint:' + id, label: '',
        value: String(_ceWizHints[id] || ''),
        placeholder: 'Optional \u2014 what to change this time\u2026',
        onType: function(v: string) { _ceWizHints[id] = String(v || ''); },
        onCommit: function(v: string) { _ceWizHints[id] = String(v || ''); return Promise.resolve(); }
    });
}

function _ceWizHint(id: string): string { return String(_ceWizHints[id] || ''); }

// Toast-wrapped generation. Every Regen in this surface has the identical shape and the
// identical failure contract -- the record is left untouched -- so it is written once.
function _ceWizRun(opLabel: string, toastId: string, work: () => Promise<any>, okMsg: string, failMsg: string): Promise<any> {
    try { api.v1.ui.toast(opLabel, { id: toastId, autoClose: false, type: 'info' }); } catch (eR1) {}
    return Promise.resolve(work()).then(function(ok: any) {
        try { api.v1.ui.toast(ok ? okMsg : failMsg, { id: toastId, type: ok ? 'success' : 'error', autoClose: 2400 }); }
        catch (eR2) {}
        return cePublishWiz();
    }).catch(function(e: any) {
        api.v1.error('[AE:jsxwizard] ' + toastId + ' failed:', e);
        try { api.v1.ui.toast(failMsg, { id: toastId, type: 'error', autoClose: 2400 }); } catch (eR3) {}
        return cePublishWiz();
    });
}

// THE STAGING REVIEW, ONCE AND SCHEMA-DRIVEN. Fields render as h(ceField, ...) with a key,
// which is ceField's own documented escape hatch for a dynamic field list -- calling it
// bare in a loop would put its useRef calls into this surface's hook list at a count that
// changes with the number of drafts.
//
// NOTHING HERE WRITES A RECORD. Edits land on the draft; only Commit calls
// commitStagedDrafts. That is the staging model and it is kept intact.
function _ceWizStaging(kind: string, st: any): any {
    var drafts: any[] = _ceWizDraftsOf(st, kind);
    if (!drafts.length) return null;
    var schema: any[] = WIZ_DRAFT_FIELDS[kind] || [];
    var confirm = String((st && st.confirm) || '');
    var cards: any[] = [];
    var i = 0;

    for (i = 0; i < drafts.length; i++) {
        cards.push((function(d: any) {
            var did = String(d.id);
            var kids: any[] = [];
            var fi = 0;
            for (fi = 0; fi < schema.length; fi++) {
                kids.push((function(fld: any) {
                    var fkey = String(fld.key);
                    return h(ceField, {
                        key: did + ':' + fkey,
                        k: 'wiz:d:' + did + ':' + fkey,
                        label: String(fld.label || ''),
                        value: String((d.fields && d.fields[fkey]) || ''),
                        seed: String(st.draftGen || 0),
                        multiline: !!fld.multiline,
                        rows: fld.multiline ? 6 : undefined,
                        well: !!fld.multiline,
                        placeholder: String(fld.label || '').toLowerCase(),
                        onCommit: function(v: string) {
                            return ceWizOp(function() { return updateWizardDraftField(did, fkey, v); });
                        }
                    });
                })(schema[fi]));
            }
            kids.push(ceInline({ gap: CE_T.s2, key: did + ':acts' }, [
                ceBtn('Regenerate', 'wiz:regen:' + did, function() {
                    return _ceWizRun('Regenerating\u2026', 'wiz-regen',
                        function() { return regenerateWizardDraft(did); },
                        'Regenerated.', 'Regeneration failed \u2014 draft left unchanged.');
                }),
                ceBtn('Discard', 'wiz:drop:' + did, function() {
                    return ceWizOp(function() { return discardWizardDraft(did); }).then(cePublishWiz);
                }, 'danger')
            ]));
            // [CARD-ONE] ceCard, not a fourth hand-rolled box. A staged draft is a RECORD
            // waiting to become a record, which is the one shape this kit already owns; the
            // gap comes back as an inner ceStack because ceCard's own gap is s1.
            return ceCard({ key: 'wizd_' + did, children: ceStack(CE_T.s3, kids) });
        })(drafts[i]));
    }

    // DESTRUCTIVE-NEVER-IN-PLACE: ask and confirm are two buttons with two opIds, so
    // TAP-GUARD's double-fire cannot land the confirmed branch off one physical tap.
    var asking = (confirm === 'stage:' + kind);
    var footer: any[] = [
        ceBtn('Commit all \u00b7 ' + drafts.length, 'wiz:commit:' + kind, function() {
            return _ceWizCommit(kind);
        }, 'primary')
    ];
    if (asking) {
        footer.push(ceBtn('Discard all \u00b7 ' + drafts.length, 'wiz:dropall:' + kind, function() {
            ceWizPatch(function() { return { confirm: '' }; });
            return ceWizOp(function() { return discardAllWizardDrafts(kind); }).then(cePublishWiz);
        }, 'danger'));
        footer.push(ceBtn('Keep them', 'wiz:dropallno:' + kind, function() {
            ceWizPatch(function() { return { confirm: '' }; });
            return Promise.resolve();
        }));
    } else {
        footer.push(ceBtn('Discard all', 'wiz:dropallask:' + kind, function() {
            ceWizPatch(function() { return { confirm: 'stage:' + kind }; });
            return Promise.resolve();
        }, 'danger'));
    }

    var body: any[] = [
        ceProse('t3',
            'None of this is in your world yet. Edit freely; committing is what writes records and lorebook entries.', { key: 'wstg_note' }),
        ceStack({ gap: CE_T.s3, key: 'wstg_cards' }, cards),
        ceInline({ gap: CE_T.s2, key: 'wstg_acts' }, footer)
    ];
    return ceSection('Staged \u00b7 ' + wizKindLabel(kind) + ' \u00b7 ' + drafts.length,
        ceStack(CE_T.s3, body));
}

// COMMIT IS DELIBERATELY NOT WRAPPED IN ceProfileOp, AND THIS IS THE ARGUMENT.
// commitStagedDrafts for kind 'character' calls generateCharacterFields per draft -- a
// model call -- between loading the drafts and writing the records. PROFILE-CHAIN-GAP
// states the rule for that chain outright: a generation must never run inside it, which
// is why ceProfileScanHook wraps only its tail. Wrapping the whole commit would stall
// every character write in the shell across N field extractions -- a worse and more
// visible failure than the race it closes.
//
// THE RACE IT LEAVES OPEN, STATED RATHER THAN HIDDEN: a commit running while the author
// navigates to a Profile and blurs a field can lose that field, because
// createWizardCharacter is a bare load-modify-save. Closing it means splitting
// commitStagedDrafts so only the write is inside the chain -- generator-layer work, which
// this section is out of scope for. KNOWN OPEN ITEM.
function _ceWizCommit(kind: string): Promise<any> {
    try { api.v1.ui.toast('Committing ' + wizKindLabel(kind) + '\u2026', { id: 'wiz-commit', autoClose: false, type: 'info' }); }
    catch (eC1) {}
    return Promise.resolve(commitStagedDrafts(kind)).then(function(made: number) {
        return Promise.resolve(loadWizardDraftsOfKind(kind)).then(function(left: any[]) {
            var msg = made > 0 ? ('Committed ' + made + ' ' + wizKindLabel(kind) + '.') : 'Nothing committed.';
            if ((left || []).length) { msg += ' ' + left.length + ' still staged \u2014 those need a name.'; }
            try { api.v1.ui.toast(msg, { id: 'wiz-commit', type: made > 0 ? 'success' : 'error', autoClose: 3000 }); }
            catch (eC2) {}
            return cePublishWiz();
        });
    }).catch(function(e: any) {
        api.v1.error('[AE:jsxwizard] commit failed:', e);
        try { api.v1.ui.toast('Commit failed.', { id: 'wiz-commit', type: 'error', autoClose: 2500 }); } catch (eC3) {}
        return cePublishWiz();
    });
}

// A row that navigates to wherever a committed record is actually edited, carrying the
// return address. THE ONE MEASURED CROSS-LINK the sweep was waiting on -- the native
// Drama tab called openEntityEditModal directly at engine ~21421.
function _ceWizGoBack(): any { return { surface: 'wizard', label: 'Wizard' }; }

// -- Project seed  [WIZ-SEED] -------------------------------------------------
// _ceWizSetup IS DELETED. It was a tab of its own holding these fields plus a button to the
// Chat tab; both halves live on Start now (WIZ-ONE-DOOR) and the function had no second
// caller, so it is removed rather than left as an unreachable screen.
//
// TWO FIELDS, NOT THREE. Genre is gone from the surface on the author's call: an initial
// concept restates it in every case anyone actually writes, and two boxes asking the same
// question is how one of them ends up stale and contradicting the other.
// [WIZ-GENRE-LEGACY] cfg.projectGenre IS NOT DELETED AND IS STILL READ. Six builders read it
// (buildWizardMultiContext, the chat environment field, the image style hint among them) and
// every one of them is already conditional on it being non-empty, so a project that never
// sets it degrades to the concept alone with no branch to add. A project that HAS one keeps
// it working. It is a legacy value with no door, deliberately: deleting the reads would
// silently change the context of every story that had filled it in.
//
// TWO STATES, ONE BLOCK, and the state is chosen by CONTENT rather than by a toggle. With
// nothing written the fields are inline and unmissable -- this is the one thing that has to
// be done before any tab to the right can work. Once written they collapse into an accordion
// whose summary IS the project, so the seed stops taking the top of the screen every visit.
// AN ACCORDION IS NOT OFFERED IN THE EMPTY STATE and that is not an oversight: ceToggleOpen
// DELETES its key when closing, so an accordion forced open by "the concept is empty" would
// re-open the instant it was closed, and a control that visibly ignores a tap is worse than
// no control.
function _ceWizProjectFields(cfg: any): any {
    return ceStack(CE_T.s3, [
        h(ceField, {
            key: 'wiz_pname', k: 'wiz:proj:name', label: 'Name',
            value: String(cfg.projectName || ''), placeholder: 'Untitled project',
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.projectName = v; }); })
                    .then(cePublishWiz);
            }
        }),
        h(ceField, {
            key: 'wiz_pconcept', k: 'wiz:proj:concept', label: 'What it is',
            value: String(cfg.projectConcept || ''), multiline: true, rows: 3, well: true,
            placeholder: 'One paragraph. What kind of world, what kind of story, and what is interesting about it\u2026',
            onCommit: function(v: string) {
                return ceSettingsOp(function() { return mutConfig(function(c: any) { c.projectConcept = v; }); })
                    .then(cePublishWiz);
            }
        }),
        ceProse('t3',
            'Both go into every generator on this surface, whether or not a chat is selected. With nothing else set, they are the whole context.', { key: 'wiz_pnote' })
    ]);
}

function _ceWizProject(st: any, openMap: any): any {
    var cfg: any = (st && st.cfg) || {};
    var nm = String(cfg.projectName || '').trim();
    var cc = String(cfg.projectConcept || '').trim();

    if (!cc) {
        return ceWrap({ key: 'wiz_proj_open' }, [ ceGroup('Project', _ceWizProjectFields(cfg))]);
    }
    return ceWrap({ key: 'wiz_proj_acc' }, [ ceAccordion({
        id: 'wiz:project',
        label: 'Project',
        open: !!(openMap && openMap['wiz:project']),
        // ceAccordion truncates its own summary to one line, so the concept can go in whole.
        summary: nm ? (nm + ' \u00b7 ' + cc) : cc,
        children: _ceWizProjectFields(cfg)
    })]);
}

// -- Walkthrough  [WIZ-WALK] --------------------------------------------------
// THE INSTRUCTIONS DESCRIBE THE SURFACES, IN THE ORDER THEY ARE USED. What was here before
// described this ONE tab ("start here, everything is built on what is in this box") and left
// the other six to be discovered by tapping them, which is why the wizard reads as a row of
// unlabelled generators. One line per tab, and the list is BUILT FROM CE_WIZ_TABS rather than
// written out beside it, so a tab added or reordered cannot leave a walkthrough describing a
// surface that is not there. A tab with no line here is simply skipped.
var CE_WIZ_WALK: { [id: string]: string } = {
    chat:       'Name the project, say what it is, and talk it through with the wizard. Save a chat and it becomes selectable context for everything below.',
    memory:     'The world canon that sits permanently in context \u2014 the facts every generation is written against.',
    species:    'The kinds of people in your world, and what every picture of one shows.',
    factions:   'Organisations and powers. Generated here, then edited on their own profiles.',
    items:      'Objects worth naming, loose in the world until something picks them up.',
    locations:  'Places, nested inside each other. Step into one to build what is inside it.',
    characters: 'The cast. Generated here as drafts, then committed to real records with their own profiles.',
    drama:      'What the cast want from each other, and what is about to go wrong between them.',
    intro:      'The opening scene, written from everything above and dropped straight into the story.'
};

function _ceWizWalk(openMap: any): any {
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < CE_WIZ_TABS.length; i++) {
        var tId = String(CE_WIZ_TABS[i].id);
        var line = CE_WIZ_WALK[tId];
        if (!line) continue;
        rows.push(ceWrap({ key: 'wwalk_' + tId }, [
            ceRow(String(CE_WIZ_TABS[i].label || tId), line, null, rows.length)]));
    }
    return ceWrap({ key: 'wiz_walk' }, [ ceAccordion({
        id: 'wiz:walk',
        label: 'How this works',
        open: !!(openMap && openMap['wiz:walk']),
        summary: 'The tabs above, in the order you use them',
        children: ceStack(null, rows)
    })]);
}

// [YOINK-PREFILL] _ceWizGenMode IS DELETED, with cfg.wizLightContext. It was a toggle between
// two context shapes; there is one now, so the setting had nothing to set and the hint under it
// described a choice the author no longer has.

// -- Chat  [JSXWIZCHAT] ----------------------------------------------
// SECTION 3e's WIZLIVE, given the door earlier left it without. Layout follows the native
// buildLiveChatTab (SECTION 27) because that is the reference surface, same rule JSXCHAT
// followed for the bridge's launcher.
//
// THE CONVERSATION ITSELF IS NOT HERE AND CANNOT BE. WIZLIVE is an IN-DOCUMENT chat: the
// engine appends a marker plus a protocol paragraph and the author talks in native { }
// instruct blocks and presses NAI's own Send. This tab opens, names, contextualises, banks
// and closes a session -- exactly the split the Chat surface (SECTION 33) already runs
// under for CharChat, and for the same hard reason: there is no preventDefault here to
// build a composer against.
//
// THE FOUR PRECONDITIONS ARE NOT RE-CHECKED HERE. startLiveWizardChat already refuses when
// a chat is live, the classic wizard is open, a CharChat is running, or a yoink is in
// flight, each with its own toast. Duplicating those tests in the view would mean two
// places deciding the same thing and drifting -- the verb owns the refusal, this only
// offers the button.

// Serialised through ceWizOp like every other drafts/web/intro write on this surface.
// The lorebook writes inside endLiveWizardChat / upsertChatEntry are that function's own
// business; what is chained here is this surface's republish.
//
// BOTH START AND RESUME CLOSE THE SHELL, and that is not a nicety. WIZLIVE puts the marker
// and the protocol paragraph in the STORY DOCUMENT and the author answers with NAI's own
// Send -- so leaving a full-size modal open over the document would hide the very thing
// that just appeared. The Chat surface's own contact rows already do exactly this after
// startCharChat(), for exactly this reason; same hand-off, same one-line close.
function _ceWizChatCloseShell(): void {
    try { if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); } }
    catch (e) { /* the chat is already in the document; a stuck modal must not fail the start */ }
}

async function _ceWizChatStart(): Promise<void> {
    var ctx: string[] = [];
    var k: string;
    for (k in _ceWizChatCtxPick) { if (_ceWizChatCtxPick[k]) ctx.push(k); }
    var started = false;
    try {
        // startLiveWizardChat owns all four refusals (chat live / classic wizard open /
        // CharChat running / yoink in flight) and toasts its own reason. It returns void
        // either way, so the shell must not close on a refusal -- read _aeLiveWiz.active
        // afterwards to tell the two apart rather than assuming success.
        await startLiveWizardChat(String(_ceWizChatPersona || ''), ctx);
        started = !!_aeLiveWiz.active;
        if (started) { _ceWizChatCtxPick = {}; _ceWizChatTitle = ''; }
    } catch (e) { api.v1.error('[AE:jsxwizard] chat start failed:', e); }
    await cePublishWiz();
    if (started) { _ceWizChatCloseShell(); }
}

// [WIZCHAT-DEL] Delete a saved chat directly, without resuming it first. Same primitive
// call as the discard-orphan fix above (api.v1.lorebook.removeEntry) -- this is that same
// capability, reachable without pulling the chat into the document at all.
async function _ceWizChatDeleteSaved(entryId: string): Promise<void> {
    try {
        await api.v1.lorebook.removeEntry(String(entryId || ''));
        try { api.v1.ui.toast('Saved chat deleted.', { type: 'success', autoClose: 2000 }); } catch (eT1) {}
    } catch (e) {
        api.v1.error('[AE:jsxwizard] saved chat delete failed:', e);
        try { api.v1.ui.toast('Could not delete that chat.', { type: 'error', autoClose: 3000 }); } catch (eT2) {}
    }
    ceWizPatch(function() { return { confirm: '' }; });
    await cePublishWiz();
}

async function _ceWizChatResume(entryId: string): Promise<void> {
    var resumed = false;
    try {
        await resumeLiveWizardChatFromEntry(String(entryId || ''));
        resumed = !!_aeLiveWiz.active;
    } catch (e) { api.v1.error('[AE:jsxwizard] chat resume failed:', e); }
    await cePublishWiz();
    if (resumed) { _ceWizChatCloseShell(); }
}

async function _ceWizChatEnd(action: string): Promise<void> {
    try { await endLiveWizardChat(String(action || 'save')); }
    catch (e) { api.v1.error('[AE:jsxwizard] chat end failed:', e); }
    _ceWizChatSummary = '';
    _ceWizChatTitle = '';
    ceWizPatch(function() { return { summary: '', confirm: '' }; });
    await cePublishWiz();
}

// Summarize PROPOSES into `summary` and never writes the lorebook on its own -- the same
// propose-don't-overwrite contract the Journal's Rewrite/Compress runs under.
async function _ceWizChatSummarize(): Promise<void> {
    try {
        var s: any = await previewSummarizeLiveChat();
        if (!s) {
            try { api.v1.ui.toast('Nothing to summarize yet \u2014 send a turn first.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
            return;
        }
        _ceWizChatSummary = String(s);
        ceWizPatch(function() { return { summary: String(s) }; });
    } catch (e) {
        api.v1.error('[AE:jsxwizard] summarize failed:', e);
        try { api.v1.ui.toast('Summarize failed \u2014 try again.', { type: 'error', autoClose: 3000 }); } catch (e2) {}
    }
}

async function _ceWizChatBankSummary(st: any): Promise<void> {
    var text = String(_ceWizChatSummary || (st && st.summary) || '').trim();
    if (!text) return;
    try {
        var live: any = (st && st.live) || {};
        // CLICK-BEFORE-BLUR, and this is the case the draft var exists for: renaming the
        // chat and then pressing Save summary is ONE gesture to the author, but the click
        // is delivered BEFORE the rename field's blur, so live.title still holds the
        // PREVIOUS name at this moment. The draft is what the author actually typed, so it
        // wins when set; live.title is the fallback for the untouched case.
        var rawTitle = String(_ceWizChatTitle || live.title || '').trim();
        var title = (rawTitle || 'Wizard Chat') + ' \u2014 Summary';
        await upsertChatEntry(null, title, [{ role: 'assistant', content: text }], String(live.topicId || ''));
        try { api.v1.ui.toast('Summary saved to the CE Chats lorebook.', { type: 'success', autoClose: 2500 }); } catch (e1) {}
        _ceWizChatSummary = '';
        ceWizPatch(function() { return { summary: '' }; });
    } catch (e) {
        api.v1.error('[AE:jsxwizard] bank summary failed:', e);
        try { api.v1.ui.toast('Could not save the summary.', { type: 'error', autoClose: 3000 }); } catch (e2) {}
    }
    await cePublishWiz();
}

function _ceWizChat(st: any, openMap: any): any {
    var live: any = (st && st.live) || null;
    var entries: any[] = (st && st.ceEntries) || [];
    var cfg: any = (st && st.cfg) || {};
    var confirm = String((st && st.confirm) || '');
    var kids: any[] = [];
    var i = 0;

    // [WIZ-ONE-DOOR] The seed and the walkthrough head this tab in BOTH states. They are
    // facts about the project, not about whether a chat happens to be open, and a live chat
    // is exactly when an author wants the concept in reach to correct it.
    kids.push(_ceWizProject(st, openMap));
    kids.push(_ceWizWalk(openMap));

    if (live && live.active) {
        kids.push(ceProse('t2',
            'A wizard chat is live in your story, below the violet marker. Write in a new paragraph '
            + 'and press Send \u2014 no need to type curly braces, they are added for you. Blue paragraphs '
            + 'are your directions, violet are the wizard\u2019s. Close it here when you are done.', { key: 'wch_lede' }));

        kids.push(ceWrap({ key: 'wch_name' }, [ ceGroup('Chat name',
            h(ceField, {
                key: 'wch_name_f', k: 'wizchat:title', label: '',
                value: String(live.title || ''), seed: String(live.startedAt || ''),
                placeholder: 'Name this chat\u2026',
                onType: function(v: string) { _ceWizChatTitle = String(v || ''); },
                onCommit: function(v: string) {
                    _ceWizChatTitle = String(v || '');
                    // _aeLiveWiz is the authority; this writes THROUGH to it and persists,
                    // exactly as the native field did. The store's copy is a projection and
                    // is refreshed by the republish.
                    return ceWizOp(function() {
                        _aeLiveWiz.title = String(v || '');
                        return saveLiveWizState();
                    }).then(cePublishWiz);
                }
            })
        )]));

        if (entries.length) {
            var ctxRows: any[] = [];
            for (i = 0; i < entries.length; i++) {
                ctxRows.push((function(e: any) {
                    var eid = String(e.id);
                    var on = !!e.forceActivation;
                    return ceSettingRow(String(e.displayName || 'Untitled chat'), '',
                        ceToggle(on, 'wizchat:ctx:' + eid, function() {
                            return ceWizOp(function() {
                                return Promise.resolve(setContextEntriesActivation([eid], !on)).then(function() {
                                    if (!on) {
                                        if (_aeLiveWiz.contextEntryIds.indexOf(eid) < 0) _aeLiveWiz.contextEntryIds.push(eid);
                                    } else {
                                        _aeLiveWiz.contextEntryIds = _aeLiveWiz.contextEntryIds.filter(function(x: string) { return x !== eid; });
                                    }
                                    return saveLiveWizState();
                                });
                            }).then(cePublishWiz);
                        }));
                })(entries[i]));
            }
            kids.push(ceWrap({ key: 'wch_ctx' }, [ ceAccordion({
                id: 'wizchat:ctx', label: 'Context lorebooks', open: !!(openMap && openMap['wizchat:ctx']),
                summary: 'Saved chats switched Always-On for this session',
                meta: (live.ctxIds || []).length ? ((live.ctxIds || []).length + ' on') : '',
                children: ceStack(null, ctxRows)
            })]));
        }

        var summaryText = String((st && st.summary) || '');
        if (summaryText) {
            kids.push(ceWrap({ key: 'wch_sum' }, [ ceSection('Summary preview',
                ceStack(CE_T.s2, [
                    ceProse('t3',
                        'Edit freely. Nothing is in the lorebook until you save it.'),
                    h(ceField, {
                        key: 'wch_sum_f', k: 'wizchat:summary', label: '',
                        value: summaryText, multiline: true, rows: 6, well: true,
                        onType: function(v: string) { _ceWizChatSummary = String(v || ''); },
                        onCommit: function(v: string) { _ceWizChatSummary = String(v || ''); return Promise.resolve(); }
                    }),
                    ceBtn('Save summary to CE Chats', 'wizchat:bank', function() {
                        return _ceWizChatBankSummary(st);
                    }, 'primary')
                ]))]));
        }

        var acts: any[] = [
            ceBtn('Summarize \u2192 preview', 'wizchat:sum', function() { return _ceWizChatSummarize(); }),
            ceBtn('Save & close', 'wizchat:save', function() { return _ceWizChatEnd('save'); }, 'primary')
        ];
        // DESTRUCTIVE-NEVER-IN-PLACE: ask and confirm are two buttons with two opIds, so
        // TAP-GUARD's double-fire cannot land the discard off one physical tap. This
        // replaces the native's 4-second armed timer, which needed api.v1.timers and could
        // disarm itself underneath the author.
        if (confirm === 'wizchat:discard') {
            acts.push(ceBtn('Discard \u2014 the chat is deleted, not saved', 'wizchat:discardyes', function() {
                ceWizPatch(function() { return { confirm: '' }; });
                return _ceWizChatEnd('discard');
            }, 'danger'));
            acts.push(ceBtn('Keep it', 'wizchat:discardno', function() {
                ceWizPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            }));
        } else {
            acts.push(ceBtn('Discard chat', 'wizchat:discardask', function() {
                ceWizPatch(function() { return { confirm: 'wizchat:discard' }; });
                return Promise.resolve();
            }, 'danger'));
        }
        kids.push(ceInline({ gap: CE_T.s2, key: 'wch_acts' }, acts));

        return ceStack(CE_T.s4, kids);
    }

    // -- Not live: choose a persona, preselect context, start ------------------
    kids.push(ceProse('t2',
        'Start a wizard chat that lives right in your story document. Pick a persona and it drops '
        + 'in below a marker \u2014 write in a new paragraph and press Send. Saved chats live in the '
        + '\u201cCE Chats\u201d lorebook category: resume them here, or switch them on as context for any '
        + 'generator on the tabs to the right.', { key: 'wch_lede0' }));

    // Persona. A CLOSED, ORDERED SET, which is what SS8 reserves ceSelect for -- not the
    // picker, which SS13 reserves for unbounded referential fields. The native used a
    // searchable picker modal because it had one; a dozen fixed topics do not need one.
    var topics: any[] = (cfg && cfg.wizardTopics && cfg.wizardTopics.length) ? cfg.wizardTopics : DEFAULT_WIZARD_TOPICS;
    var tOpts: any[] = [{ id: '', label: 'General worldbuilding' }];
    for (i = 0; i < topics.length; i++) {
        tOpts.push({ id: String(topics[i].id), label: String(topics[i].label || topics[i].id) });
    }
    var personaHint = '';
    for (i = 0; i < topics.length; i++) {
        if (String(topics[i].id) === String(_ceWizChatPersona)) {
            personaHint = _ceTrim(String(topics[i].seedMessage || ''), 150);
        }
    }
    kids.push(ceWrap({ key: 'wch_persona' }, [ ceSelect({
        k: 'wizchat:persona',
        label: 'Persona',
        value: String(_ceWizChatPersona || ''),
        options: tOpts,
        hint: personaHint || 'Sets what the wizard is for. General is a good default.',
        onCommit: function(v: string) {
            _ceWizChatPersona = String(v || '');
            // The persona drives the hint line above, so this one DOES have to repaint --
            // which is why it is a commit and not an onType scratchpad.
            return cePublishWiz();
        }
    })]));

    if (entries.length) {
        var preRows: any[] = [];
        for (i = 0; i < entries.length; i++) {
            preRows.push((function(e: any) {
                var eid = String(e.id);
                return ceSettingRow(String(e.displayName || 'Untitled chat'), '',
                    ceToggle(!!_ceWizChatCtxPick[eid], 'wizchat:pre:' + eid, function() {
                        if (_ceWizChatCtxPick[eid]) { delete _ceWizChatCtxPick[eid]; }
                        else { _ceWizChatCtxPick[eid] = true; }
                        return cePublishWiz();
                    }));
            })(entries[i]));
        }
        kids.push(ceWrap({ key: 'wch_pre' }, [ ceAccordion({
            id: 'wizchat:pre', label: 'Include saved chats as context',
            open: !!(openMap && openMap['wizchat:pre']),
            summary: 'Optional \u2014 switched Always-On for the new session',
            meta: '', children: ceStack(null, preRows)
        })]));
    }

    kids.push(ceInline({ gap: CE_T.s2, key: 'wch_start' }, [
        ceBtn('Start chat', 'wizchat:start', function() { return _ceWizChatStart(); }, 'primary')]));

    // [WIZCHAT-DEL] Resume, or delete directly. The row USED TO carry only a tap-to-resume
    // \u2014 which meant the sole route to removing a saved chat was pulling it into the
    // document and discarding it there, and until the fix above that route did not even
    // work. NESTED-TAP is why the row loses its own onClick here rather than gaining a
    // trailing button beside one: two buttons in the trail, neither one a tap target the row
    // itself also owns.
    //   ONE 'confirm' STRING, encoding the target id, following DESTRUCTIVE-NEVER-IN-PLACE
    //   exactly as the live Discard control above does \u2014 ask and confirm are two buttons
    //   with two opIds, so TAP-GUARD's double-fire cannot land the delete off one tap.
    var resumeRows: any[] = [];
    for (i = 0; i < entries.length; i++) {
        resumeRows.push((function(e: any) {
            var eid = String(e.id);
            var armed = (confirm === 'wizchat:del:' + eid);
            return ceListRow({
                key: 'wch_r_' + eid,
                label: String(e.displayName || 'Untitled chat'),
                trail: armed
                    ? ceInline({ gap: CE_T.s2 }, [
                        ceBtn('Delete permanently', 'wizchat:deldo:' + eid, function() {
                            return _ceWizChatDeleteSaved(eid);
                        }, 'danger'),
                        ceBtn('Keep it', 'wizchat:delno:' + eid, function() {
                            ceWizPatch(function() { return { confirm: '' }; });
                            return cePublishWiz();
                        })])
                    : ceInline({ gap: CE_T.s2 }, [
                        ceBtn('Resume', 'wizchat:resume:' + eid, function() { return _ceWizChatResume(eid); }),
                        ceIconBtn('Delete saved chat', ceIconTrash(), 'wizchat:delask:' + eid, function() {
                            ceWizPatch(function() { return { confirm: 'wizchat:del:' + eid }; });
                            return Promise.resolve();
                        }, 'danger')])
            });
        })(entries[i]));
    }
    kids.push(ceWrap({ key: 'wch_res' }, [ ceGroup('Saved chats \u00b7 ' + entries.length,
        entries.length
            ? ceStack(null, resumeRows)
            : ceEmpty('No saved chats yet \u2014 start one above, then Save & close to bank it here.', null))]));

    return ceStack(CE_T.s4, kids);
}

// -- Memory -------------------------------------------------------------------
// The world-canon sections that assemble into the static Memory block and the Author's
// Note. Section rows are ceExpandRow -- many distinct records, which is the case SS7.3
// gives ceExpandRow rather than ceAccordion.
function _ceWizMemory(st: any, openMap: any): any {
    var cfg: any = (st && st.cfg) || {};
    var list: any[] = cfg.wizardSections || [];
    var eff = _ceWizEffSrc(st, 'memory');
    var rows: any[] = [];
    var i = 0;

    for (i = 0; i < list.length; i++) {
        rows.push((function(sec: any, si: number) {
            var sid = String(sec.id);
            var accId = 'wiz:sec:' + sid;
            var open = !!openMap[accId];
            var body: any[] = [
                // Every field write below re-finds the section BY ID inside mutConfig
                // rather than trusting the render-time index: a reorder or a delete between
                // this render and the blur would otherwise write to a different section.
                // The move buttons are index-based because they are immediate, not deferred.
                ceSettingRow('Include this section',
                    'Off leaves it out of context entirely, wherever it is aimed.',
                    ceToggle(!!sec.enabled, 'wiz:secon:' + sid, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.enabled = !sec.enabled;
                        }); }).then(cePublishWiz);
                    }, 'Include ' + String(sec.label || 'this section'))),
                // [F-1] WHERE IT LANDS. `target` HAS BEEN THE FIELD SINCE WIZARD-2 and both
                // assemblers already filter on it; only the control was missing, which is why
                // ATTG and Style could be seeded to the Author's Note and never moved off it.
                // A ceSelect and not a toggle: the two answers are named places, and a switch
                // labelled "Author's Note" leaves you guessing what off means.
                // THE ROW'S SUB-LINE CARRIES THE CONSEQUENCE, not the restatement. Memory
                // sections assemble IN LIST ORDER, so moving ATTG to Memory puts it wherever
                // the section sits in the list -- which is a real thing to know before you
                // do it, and invisible afterwards.
                ceSettingRow('Goes to',
                    (sec.target === 'an')
                        ? 'The Author\u2019s Note, near the generation point.'
                        : 'The Memory block, in this list\u2019s order.',
                    ceSelect({ k: accId + ':target', value: (sec.target === 'an') ? 'an' : 'memory',
                        options: [{ id: 'memory', label: 'Memory' },
                                  { id: 'an', label: 'Author\u2019s Note' }],
                        onCommit: function(v: string) {
                            return ceSettingsOp(function() { return mutConfig(function(c: any) {
                                var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                                if (t) t.target = (String(v) === 'an') ? 'an' : 'memory';
                            }); }).then(cePublishWiz);
                        } })),
                h(ceField, {
                    key: accId + ':label', k: accId + ':label', label: 'Section name',
                    value: String(sec.label || ''),
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.label = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                h(ceField, {
                    key: accId + ':content', k: accId + ':content', label: 'Text',
                    value: String(sec.content || ''), multiline: true, rows: 5, well: true,
                    placeholder: 'Generated by Regen, or written here directly\u2026',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.content = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                h(ceField, {
                    key: accId + ':instr', k: accId + ':instr', label: 'What this section covers',
                    value: String(sec.instructions || ''), multiline: true, rows: 3,
                    placeholder: 'Describe ONLY this section\u2019s scope\u2026',
                    onCommit: function(v: string) {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var t = (c.wizardSections || []).find(function(x: any) { return x.id === sid; });
                            if (t) t.instructions = v;
                        }); }).then(cePublishWiz);
                    }
                }),
                _ceWizHintField(sid),
                ceInline({ gap: CE_T.s2, key: accId + ':acts' }, [
                    ceBtn('Regenerate', 'wiz:secregen:' + sid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(sec.label || '') + '\u201d\u2026', 'wiz-secregen',
                            function() { return regenerateWizardSection(sid, eff, _ceWizHint(sid)); },
                            'Regenerated \u201c' + String(sec.label || '') + '\u201d.', 'Regeneration failed.');
                    }),
                    ceBtn('Move up', 'wiz:secup:' + sid, function() {
                        if (si === 0) return Promise.resolve();
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var a = c.wizardSections; var t = a[si - 1]; a[si - 1] = a[si]; a[si] = t;
                        }); }).then(cePublishWiz);
                    }),
                    ceBtn('Move down', 'wiz:secdn:' + sid, function() {
                        if (si >= list.length - 1) return Promise.resolve();
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var a = c.wizardSections; var t = a[si + 1]; a[si + 1] = a[si]; a[si] = t;
                        }); }).then(cePublishWiz);
                    }),
                    ceIconBtn('Delete this section', ceIconTrash(), 'wiz:secdel:' + sid, function() {
                        return ceSettingsOp(function() { return mutConfig(function(c: any) {
                            var di = (c.wizardSections || []).findIndex(function(x: any) { return x.id === sid; });
                            if (di >= 0) c.wizardSections.splice(di, 1);
                        }); }).then(cePublishWiz);
                    }, 'danger')
                ])
            ];
            var written = String(sec.content || '').trim();
            return ceExpandRow({
                id: accId, label: String(sec.label || 'Unnamed section'), open: open,
                summary: written ? _ceTrim(written, 72) : 'Nothing written yet',
                // NESTED-TAP: `lead` and `meta` sit INSIDE ceExpandRow's own clickable head,
                // so neither may carry a control -- a tap would fire the control's ceTap and
                // then the head's, and only TAP-GUARD's 120ms window would stop the row
                // toggling underneath it. State goes in `meta` as text; the switch lives in
                // the body. Same reason ceAccordion's `lead` has only ever held a thumbnail.
                meta: (sec.enabled ? 'ON' : 'off') + ' \u00b7 ' + (sec.target === 'an' ? 'AN' : 'MEM'),
                children: ceStack(CE_T.s3, body)
            });
        })(list[i], i));
    }

    return ceStack(CE_T.s4, [
        ceProse('t2',
            'The permanent facts of your world. Switched-on sections are assembled into Memory and the Author\u2019s Note when you commit \u2014 which is the only step here that touches the story.', { key: 'wm_lede' }),
        ceWrap({ key: 'wm_src' }, [ _ceWizSources('memory', st)]),
        ceWrap({ key: 'wm_rows' }, [ ceGroup('Sections \u00b7 ' + list.length,
            list.length
                ? ceStack(null, rows)
                : ceEmpty('No sections defined.', null))]),
        ceInline({ gap: CE_T.s2, key: 'wm_acts' }, [
            ceBtn('Add section', 'wiz:secadd', function() {
                return ceSettingsOp(function() { return mutConfig(function(c: any) {
                    if (!c.wizardSections) c.wizardSections = [];
                    c.wizardSections.push({ id: 'wsec_' + generateId(), label: 'New Section', enabled: false,
                                            content: '', instructions: 'Describe ONLY this section\u2019s scope.', target: 'memory' });
                }); }).then(cePublishWiz);
            }),
            ceBtn('Commit to Memory', 'wiz:memcommit', function() {
                return Promise.resolve(loadConfig()).then(function(fresh: any) {
                    return Promise.resolve(commitWizardMemory(fresh)).then(function(ok: boolean) {
                        try { api.v1.ui.toast(ok ? 'Committed to Memory and the Author\u2019s Note.' : 'Commit failed.',
                            { type: ok ? 'success' : 'error', autoClose: 2400 }); } catch (eMC) {}
                        return cePublishWiz();
                    });
                });
            }, 'primary')])
    ]);
}

// -- Species / Factions -------------------------------------------------------
// ONE BODY FOR BOTH, exactly as the native branch was -- they differ only in the noun and
// the config array. The committed-record EDITOR is gone: species is edited fully by
// _ceSettingsSpecies and factions by Diplomacy and the faction's own screen [F-26], and a
// second divergent editor here was duplication, not capability. What survives is what only the wizard has: Regen against
// the chosen context, and Sync Lore.
// [WIZ-ENTKIND] ONE BODY FOR THREE KINDS AGAIN, AND THE FORK IS A TABLE LOOKUP. The
// previous note argued the `kind` fork should go because only species could reach this
// function -- true while the other two tabs were deleted, and the moment they came back the
// hardcoded `var kind = 'species'` would have silently rendered a Factions tab full of
// species. What replaced the fork is not a restored ternary chain: every difference between
// the three (noun, lede, placeholder, which field holds the generated prose, whether the
// kind divides into lists) is a column in CE_WIZ_ENT_KINDS, so a fourth kind is a row.
function _ceWizEntities(tab: string, st: any, openMap: any): any {
    var eDef: any = ceWizEntKind(tab);
    var kind = String(eDef.kind);
    var noun = String(eDef.noun);
    var eLists: any[] = ceWizEntLists(eDef);
    // [F-32] FROM THE ENTITY INDEX, not from the config. The index carries the name and the
    // kind-word but NOT the description -- EntityMeta never has -- so the summary line reads
    // the list-word and the kind-word instead, which is what this tab is actually sorting by.
    var list: any[] = [];
    var wIdx: any[] = (st && st.entIndex) || [];
    for (var wi = 0; wi < wIdx.length; wi++) {
        if (!wIdx[wi] || String(wIdx[wi].type) !== kind) continue;
        list.push(wIdx[wi]);
    }
    var eff = _ceWizEffSrc(st, tab);
    var rows: any[] = [];
    var i = 0;

    for (i = 0; i < list.length; i++) {
        rows.push((function(item: any) {
            var iid = String(item.id);
            var accId = 'wiz:ent:' + iid;
            var open = !!openMap[accId];
            // The list-word is only a fact about a kind that HAS lists; for the other two
            // it would be a label invented for the row rather than read off the record.
            var lWord = eLists.length ? String(ceSpeciesListDef(ceSpeciesList(item)).label || '') : '';
            var kWord = String(item.locationType || '').trim();
            // [WIZ-ROWTEXT] THE FIELD THE REGENERATE BUTTON WRITES INTO, on the row that
            // holds the button. WHICH field is the kind's, off CE_WIZ_ENT_KINDS -- see
            // WIZ-ENTKIND for why species differs from the other two, and why guessing
            // wrong here fails silently rather than visibly.
            //   THROUGH ceEntityWrite, WHICH OWNS THE RESYNC (F-32 ONE ENTITY WRITE): both
            //   'lorebookText' and 'description' are already in its lorebook-input list, so
            //   there is no sync call to add here and adding one would make a second writer.
            //   The republish is this surface's own, because ceEntityWrite republishes the
            //   ENTITY screen.
            var wText: any = ((st && st.entText) || {})[iid] || {};
            var body: any[] = [
                h(ceField, {
                    key: 'we_lore_' + iid, k: 'wiz:entlore:' + iid,
                    label: String(eDef.textLabel || 'Lore'),
                    value: String(wText[String(eDef.textKey)] || ''),
                    multiline: true, rows: 6, well: true,
                    placeholder: 'Nothing written yet \u2014 regenerate, or write it here.',
                    onCommit: function(v: string) {
                        return Promise.resolve(ceEntityWrite(iid, String(eDef.textKey), v)).then(cePublishWiz);
                    }
                }),
                // [WIZ-GENSRC] THE SHARED STRIP, NOT A SECOND GENERATOR. This row carried a
                // bare Regenerate plus a one-line steer box, while the identical field on the
                // record's own profile offered a steer, Metered-vs-Free, a candidate count, a
                // token budget, a story toggle and candidate cards to choose between. Two
                // generators for one field, and the weaker one was the one the wizard tab
                // existed to provide.
                //   THE STRIP KEEPS THE GROUNDING, which is why this needed WIZ-GENSRC first
                //   and could not be a straight swap: _ceGenBtn generates from the RECORD,
                //   and this tab's whole promise is "using the chats you have selected below".
                //   `eff` is those chats; without threading them through, swapping the button
                //   would have silently deleted the reason to use this tab at all.
                //   _ceWizHintField LEAVES THIS ROW BUT NOT THE FILE -- the strip has its own
                //   Steer field, so a second box here would be two controls for one thing. It
                //   still serves the Memory sections and the Drama narratives, whose
                //   Regenerate buttons are not entity-field generations and inherit no strip.
                ceWrap({ key: accId + ':gen' }, [ _ceEntGenBtn(iid, item, String(eDef.textKey), eff)]),
                ceInline({ gap: CE_T.s2, key: accId + ':acts' }, [
                    // [F-32] ONE DOOR, TO THE RECORD'S OWN SURFACE. The three buttons this
                    // replaces -- Sync lorebook, Edit in Settings, Delete -- each addressed a
                    // config row directly, and all three now live on the Entity surface
                    // beside the questions they act on. A wizard tab that also deletes
                    // records is a second editor, which is the duplication F-26 and F-29
                    // both removed. TABS ARE CONTENT THAT STAYS, LAUNCHERS ARE DOORS THAT
                    // LEAVE: this row is a door.
                    ceBtn('Open', 'wiz:entopen:' + iid, function() {
                        ceNav('entity', iid, '', _ceWizGoBack());
                        return Promise.resolve();
                    })
                ])
            ];
            return ceExpandRow({
                id: accId, label: String(item.name || 'Unnamed'), open: open,
                summary: [lWord, kWord].filter(Boolean).join(' \u00b7 '),
                children: ceStack(CE_T.s3, body)
            });
        })(list[i]));
    }

    // [WIZ-ENTKIND] ONE GROUP PER LIST, AND THE GENERATOR LIVES INSIDE THE GROUP IT
    // CREATES INTO. That placement IS the fix for W2: naming a creature under the Bestiary
    // heading is what carries the list into stageEntityNamed and addBlankWizardEntity, so
    // there is no separate list control to keep in sync with a name field and no way to
    // press Write it without having said which list. A kind with no lists gets exactly one
    // group and reads as it always did.
    //   [GEN-GUIDED] Name-first, per group. The batch door is gone from this surface: it
    //   asked one prompt to invent N things AND write them, parsed them out of free prose
    //   split on '---', and validated the whole reply on a single /NAME:/i. Naming the thing
    //   yourself is what ties it to the chat you just had, and it is one clean generation
    //   per press.
    //   THE TOKEN CARRIES THE LIST because _ceWizGenName is keyed by it -- two groups
    //   sharing a token would be two name fields writing one module var, which is the
    //   defect GEN-GUIDED's own note records for the Characters tab.
    function entGroup(listId: string, heading: string, groupRows: any[]): any {
        var token = listId ? (tab + ':' + listId) : tab;
        // 'Add a blank one' EITHER WAY. Splicing the list's noun in reads as "Add a blank
        // people" for one of the two values -- CE_SPECIES_LISTS' nouns are the words the
        // COMPOSED ENTRY uses ("the peoples of this world"), not singulars a button can
        // borrow. The group heading above already says which list this button adds to.
        var addLabel = 'Add a blank one';
        return ceWrap({ key: 'we_list_' + (listId || 'all') }, [ ceGroup(heading,
            ceStack(CE_T.s2, [
                ceWrap({ key: 'we_gen_' + (listId || 'all') }, _ceWizNameRow(token, 'Write it',
                    String(eDef.placeholder || ''),
                    function(gnName: string) {
                        return _ceWizRun('Writing \u201c' + gnName + '\u201d\u2026', 'wiz-named',
                            function() {
                                return Promise.resolve(stageEntityNamed(kind, gnName, eff, '', listId)).then(function(ids: string[]) {
                                    return (ids || []).length;
                                });
                            },
                            'Staged \u2014 review below.', 'Generation failed.');
                    })),
                groupRows.length
                    ? ceStack({ key: 'we_rows_' + (listId || 'all') }, groupRows)
                    : ceEmpty('None yet.', null),
                ceBtn(addLabel, 'wiz:entblank:' + kind + ':' + (listId || 'all'), function() {
                    return Promise.resolve(addBlankWizardEntity(kind, listId)).then(cePublishWiz);
                })]))]);
    }

    var kids: any[] = [
        ceProse('t2', String(eDef.lede || ''), { key: 'we_lede' }),
        ceWrap({ key: 'we_src' }, [ _ceWizSources(tab, st)])
    ];
    var staged = _ceWizStaging(kind, st);
    if (staged) kids.push(ceWrap({ key: 'we_stage' }, staged));

    if (eLists.length) {
        // Bucketed off the SAME normaliser the record is read through everywhere else, so a
        // record with no list, or one naming a list that has since gone, appears under
        // peoples rather than vanishing from a tab that claims to show what is in the world.
        var buckets: any = {};
        var bi = 0;
        for (bi = 0; bi < eLists.length; bi++) { buckets[String(eLists[bi].id)] = []; }
        for (bi = 0; bi < list.length; bi++) {
            // THE FALLBACK IS REACHABLE ON EXTENSION, not defensive padding. ceSpeciesList
            // normalises against CE_SPECIES_LISTS specifically, so it is the right reader
            // only while `lists: 'species'` is the only sub-division table. Give a second
            // kind its own table and this bucketing needs its own normaliser -- until then
            // this catches the mismatch instead of throwing on an undefined array.
            var bKey = ceSpeciesList(list[bi]);
            (buckets[bKey] || buckets[String(eLists[0].id)]).push(rows[bi]);
        }
        for (bi = 0; bi < eLists.length; bi++) {
            var bDef: any = eLists[bi];
            var bRows: any[] = buckets[String(bDef.id)] || [];
            kids.push(entGroup(String(bDef.id),
                String(bDef.label) + ' \u00b7 ' + bRows.length, bRows));
        }
    } else {
        kids.push(entGroup('', 'In this world \u00b7 ' + list.length, rows));
    }

    return ceStack(CE_T.s4, kids);
}

// -- Locations ----------------------------------------------------------------
// The two-pass tree: generate at the current level, step into any child, generate again.
// The committed-record editor is gone -- the Entity surface (SECTION 36) is the editor
// for a location, and it is one tap away on every row.
function _ceWizLocations(st: any, openMap: any): any {
    var eff = _ceWizEffSrc(st, 'locations');
    var parentId = String((st && st.locParent) || '');
    var parentName = String((st && st.locParentName) || '');
    var idx: any[] = (st && st.entIndex) || [];

    var kidsList: any[] = [];
    var i = 0;
    for (i = 0; i < idx.length; i++) {
        var m: any = idx[i];
        if (!m || m.type !== 'location') continue;
        if (String(m.parentId || '') !== parentId) continue;
        kidsList.push(m);
    }

    function childCount(id: string): number {
        var n = 0;
        var j = 0;
        for (j = 0; j < idx.length; j++) {
            if (idx[j] && idx[j].type === 'location' && String(idx[j].parentId || '') === id) n++;
        }
        return n;
    }

    var crumb = ceInline(CE_T.s2, [
        ceSub('t1', parentId ? ('Inside ' + parentName) : 'The top of the world',
            { key: 'wl_here', grow: true, size: 'base' }),
        parentId
            ? ceBtn('Step out', 'wiz:locup', function() {
                var up = String((st && st.locParentUp) || '');
                return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, up)).then(cePublishWiz);
              })
            : null
    ]);

    var rows: any[] = [];
    for (i = 0; i < kidsList.length; i++) {
        rows.push((function(km: any) {
            var kid = String(km.id);
            var grand = childCount(kid);
            var lAcc = 'wiz:loc:' + kid;
            var lText: any = ((st && st.entText) || {})[kid] || {};
            // [WIZ-ROWTEXT] THE ROW EXPANDS, so the record's own text is readable and
            // editable where it is generated. HISTORICAL NOTE, kept because the bug class
            // recurs: this row used to call regenerateWizardLocation with _ceWizHint(kid)
            // while rendering no _ceWizHintField(kid) anywhere on the tab, so the steer was
            // permanently '' and the button silently ignored a control the author could not
            // see -- F-20 in its second form, a door with no knob. Both are gone; the strip
            // below owns the steer (WIZ-GENSRC).
            //   THE TWO FIELDS ARE THE TWO THINGS generateLocationNamed RETURNS, under the
            //   labels staging gives them. 'On arrival' is `description` (what a camera
            //   senses) and 'Lorebook' is `lorebookText` (the full entry); a location's
            //   description is NOT excluded from its compiled entry the way a species' is,
            //   which is why both are worth showing and neither is the other's summary.
            // NESTED-TAP is why every verb is a button INSIDE the body rather than a trail:
            // ceExpandRow's header is itself a tap target, so a trailing button would sit
            // inside a tappable row and fire the toggle as well as itself, surviving only
            // on TAP-GUARD's window. Species already solved it this way; this copies it.
            var lBody: any[] = [
                h(ceField, {
                    key: 'wl_desc_' + kid, k: 'wiz:locdesc:' + kid, label: 'On arrival',
                    value: String(lText.description || ''),
                    multiline: true, rows: 3, well: true,
                    placeholder: 'What a camera senses stepping in.',
                    onCommit: function(v: string) {
                        return Promise.resolve(ceEntityWrite(kid, 'description', v)).then(cePublishWiz);
                    }
                }),
                h(ceField, {
                    key: 'wl_lore_' + kid, k: 'wiz:loclore:' + kid, label: 'Lorebook',
                    value: String(lText.lorebookText || ''),
                    multiline: true, rows: 6, well: true,
                    placeholder: 'Nothing written yet \u2014 regenerate, or write it here.',
                    onCommit: function(v: string) {
                        return Promise.resolve(ceEntityWrite(kid, 'lorebookText', v)).then(cePublishWiz);
                    }
                }),
                // [WIZ-GENSRC] ONE STRIP PER FIELD, replacing the single Regenerate that
                // wrote both. regenerateWizardLocation generated a description AND a lorebook
                // entry in one pass and committed both, so an author who liked one and not
                // the other had to take both or press again. The two fields answer different
                // questions -- what a camera senses, and what a narrator must know -- and the
                // catalog has had a separate prompt for each since LOC-PROFILE2. Each strip
                // offers its own candidates and commits only what is chosen.
                ceWrap({ key: lAcc + ':gend' }, [ _ceEntGenBtn(kid, km, 'description', eff)]),
                ceWrap({ key: lAcc + ':genl' }, [ _ceEntGenBtn(kid, km, 'lorebookText', eff)]),
                ceInline({ gap: CE_T.s2, key: lAcc + ':acts' }, [
                    ceBtn('Into', 'wiz:locinto:' + kid, function() {
                        return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_LOC_PARENT, kid)).then(cePublishWiz);
                    }),
                    ceBtn('Open', 'wiz:locopen:' + kid, function() {
                        ceNav('entity', kid, '', _ceWizGoBack());
                        return Promise.resolve();
                    }),
                    ])
            ];
            return ceExpandRow({
                id: lAcc, label: String(km.name || 'Unnamed'), open: !!openMap[lAcc],
                summary: grand ? (grand + ' inside') : 'nothing inside yet',
                children: ceStack(CE_T.s3, lBody)
            });
        })(kidsList[i]));
    }

    // [GEN-GUIDED] Name-first, same as species and factions.
    var gen = _ceWizNameRow('locations', 'Write it', 'The name of a place\u2026',
        function(gnName: string) {
            return _ceWizRun('Writing \u201c' + gnName + '\u201d\u2026', 'wiz-loc',
                function() {
                    return Promise.resolve(stageLocationNamed(gnName, parentId || null, eff, '')).then(function(ids: string[]) {
                        return (ids || []).length;
                    });
                },
                'Staged \u2014 review below.', 'Generation failed.');
        });

    var kids: any[] = [
        ceProse('t2',
            (parentId
                ? ('Name a place and it is built inside ' + parentName + '. ')
                : 'Name a place and it is built at the top of the world. ')
            + 'The chats selected below are its reference. Tap any place to step into it and build a level deeper.', { key: 'wl_lede' }),
        ceWrap({ key: 'wl_crumb' }, crumb),
        ceWrap({ key: 'wl_src' }, [ _ceWizSources('locations', st)]),
        ceWrap({ key: 'wl_gen' }, gen)
    ];
    var staged = _ceWizStaging('location', st);
    if (staged) kids.push(ceWrap({ key: 'wl_stage' }, staged));
    kids.push(ceWrap({ key: 'wl_list' }, [ ceGroup(parentId ? ('Inside ' + parentName) : 'Top of the world',
        ceStack(CE_T.s2, [
            rows.length
                ? ceStack({ key: 'wl_rows' }, rows)
                : ceEmpty('Nothing here yet.', null),
            ceBtn('Add a blank one', 'wiz:locblank', function() {
                return Promise.resolve(addBlankWizardLocation(parentId || null)).then(cePublishWiz);
            })]))]));

    return ceStack(CE_T.s4, kids);
}

// -- Characters ---------------------------------------------------------------
function _ceWizCharacters(st: any): any {
    var eff = _ceWizEffSrc(st, 'characters');
    var roster: any[] = (st && st.roster) || [];

    // [GEN-GUIDED] The batch door is gone; this WAS the guided path all along,
    // labelled "Or name one yourself" beside it. Its own note already stated the principle
    // the whole refactor is built on — naming the character IS the review step that staging
    // exists to give a batch nobody asked for by name.
    var addRow = ceInline({ gap: CE_T.s3, align: 'end' }, [
        ceGrow({ key: 'wc_addf', basis: '180px' }, [
            h(ceField, {
                key: 'wc_addname', k: 'wiz:char:addname', label: 'Name',
                value: '', seed: String((st && st.addGen) || 0),
                placeholder: 'A character this world needs\u2026',
                onType: function(v: string) { _ceWizAddName = String(v || ''); },
                onCommit: function(v: string) { _ceWizAddName = String(v || ''); return Promise.resolve(); }
            })]),
        ceFixed({ key: 'wc_addb' }, [
            ceBtn('Create', 'wiz:char:add', function() {
                var nm = String(_ceWizAddName || '').trim();
                if (!nm) {
                    try { api.v1.ui.toast('Enter a name first.', { type: 'error', autoClose: 2000 }); } catch (eA1) {}
                    return Promise.resolve();
                }
                return _ceWizRun('Writing \u201c' + nm + '\u201d\u2026', 'wiz-char1',
                    function() {
                        return Promise.resolve(runWizardCharacterSingle(nm, eff)).then(function(ok: boolean) {
                            if (ok) {
                                _ceWizAddName = '';
                                ceWizPatch(function(s: any) { return { addGen: Number(s.addGen || 0) + 1 }; });
                            }
                            return ok;
                        });
                    },
                    'Created \u201c' + nm + '\u201d.', 'Generation failed.');
            })])
    ]);

    var rosterRows: any[] = [];
    var ri = 0;
    for (ri = 0; ri < roster.length; ri++) {
        rosterRows.push((function(cm: any) {
            var cid = String(cm.id);
            return ceListRow({
                label: String(cm.name || 'Unnamed'),
                sub: String(cm.occupationRole || (cm.isProtagonist ? 'the protagonist' : '')),
                onClick: function() { ceNav('profile', cid, '', _ceWizGoBack()); }
            });
        })(roster[ri]));
    }

    var kids: any[] = [
        ceProse('t2',
            'Each character is written as one comprehensive concept dump first \u2014 everything the chosen context establishes about them. Their fields are derived from that dump when you commit, so the dump is the thing worth editing below.', { key: 'wc_lede' }),
        ceWrap({ key: 'wc_src' }, [ _ceWizSources('characters', st)]),
        // [GEN-GUIDED] ONE ROW, ONE SLOT. This mounted `addRow` TWICE -- 'wc_gen' and
        // 'wc_add' -- and the surface drew two Name fields and two Create buttons.
        // The batch generator used to live in 'wc_gen' with the guided row beside it in
        // 'wc_add'; when the batch door was deleted its slot was FILLED with the same
        // addRow rather than removed. Both copies wrote the one _ceWizAddName module
        // variable, so whichever was typed into last won and the other sat there stale --
        // a field showing a name that Create would not use.
        // THE SAME NODE IN TWO SLOTS IS NOT A KEYING PROBLEM AND MUST NOT BE FIXED AS ONE.
        // The two wrappers had distinct keys and Preact drew exactly what it was asked to;
        // the defect is in the tree, one level up from the reconciler.
        ceWrap({ key: 'wc_gen' }, addRow)
    ];
    var staged = _ceWizStaging('character', st);
    if (staged) kids.push(ceWrap({ key: 'wc_stage' }, staged));
    kids.push(ceWrap({ key: 'wc_list' }, [ ceGroup('Already in this story \u00b7 ' + roster.length,
        ceStack(CE_T.s2, [
            ceProse('t3',
                'Generation is told about these and will not recreate them.', { key: 'wc_rnote' }),
            rosterRows.length
                ? ceStack({ key: 'wc_rrows' }, rosterRows)
                : ceEmpty('No characters yet.', null)]))]));

    return ceStack(CE_T.s4, kids);
}

// -- Drama --------------------------------------------------------------------
// Three generators, one shared context selection: directed hooks, bilateral web dynamics,
// narrative threads. THE NARRATIVE ROW IS THE CROSS-LINK the deletion sweep was gated on
// -- the native version called openEntityEditModal here; this navigates to the Entity
// surface with a return address, which is the last reference that kept the sweep waiting.
function _ceWizDrama(st: any): any {
    var eff = _ceWizEffSrc(st, 'drama');
    var chars: any[] = (st && st.chars) || [];
    var idx: any[] = (st && st.entIndex) || [];
    var i = 0;

    function charName(id: string): string {
        var j = 0;
        for (j = 0; j < chars.length; j++) { if (chars[j] && chars[j].id === id) return String(chars[j].name || '?'); }
        return '?';
    }

    // ---- Hooks
    var hookRows: any[] = [];
    for (i = 0; i < chars.length; i++) {
        if (!chars[i] || !chars[i].active) continue;
        hookRows.push((function(hc: any) {
            var hid = String(hc.id);
            var cur = hc.hook || null;
            var target = cur ? (ceIsProtagonistRef(cur.targetId) ? 'the protagonist' : String(cur.targetName || '?')) : '';
            var sub = cur
                ? (target + ' \u00b7 ' + _ceHookTierLabel(cur.pressureLevel) + ' \u2014 ' + String(cur.description || ''))
                : 'no hook yet';
            // NESTED-TAP: the row carries buttons, so it deliberately has no row-level
            // tap handler — one would double-fire against them.
            return ceListRow({
                key: 'wiz_hk_' + hid,
                opId: 'wiz:hookrow:' + hid,
                label: (hc.isProtagonist ? '\u2605 ' : '') + String(hc.name || 'Unnamed'),
                sub: sub,
                trail: ceInline(CE_T.s2, [
                    ceBtn(cur ? 'Reseed' : 'Seed', 'wiz:hook1:' + hid, function() {
                        return _ceWizRun('Seeding a hook for ' + String(hc.name || '') + '\u2026', 'wiz-hook1',
                            function() { return runWizardHookSingle(hid, eff, ''); },
                            'Hook seeded for ' + String(hc.name || '') + '.', 'No clean tension found.');
                    }),
                    // [HOOK-ONE] Was a bare `fh.hooks = []`, which left the pressure
                    // key behind for the next hook to inherit. resolveCharHook is the one
                    // ending and clears both halves; quiet, because the wizard's own toast
                    // is the feedback here.
                    cur ? ceBtn('Clear', 'wiz:hookclr:' + hid, function() {
                        return resolveCharHook(hid, true).then(cePublishWiz);
                    }, 'danger') : null])
            });
        })(chars[i]));
    }

    var hooks = ceGroup('Hooks', ceStack(CE_T.s2, [
        ceProse('t3',
            'One directed opening tension per character, at the same pressure the engine spawns mid-play. '
            + 'Seed them one at a time \u2014 each is its own scan and can find nothing.', { key: 'wd_hnote' }),
        hookRows.length
            ? ceStack({ key: 'wd_hrows' }, hookRows)
            : ceEmpty('No active characters yet \u2014 build the cast on the Characters tab first.', null)
    ]));

    // [WEB-GONE] THE WEB BLOCK IS DELETED, AND A ONE-WORD BUG PROVES NOBODY COULD HAVE
    // BEEN USING IT. Its rows read `String(wl.dynamic || 'no dynamic yet')`, and
    // CeRelationship HAS NO `dynamic`: the field was renamed to `together` in the record
    // merge (see the type's own comment, "was 'dynamic' -- renamed in the same patch that
    // merged the records"). So every row in this block has rendered "no dynamic yet" since
    // the merge, whatever was written in it.
    // AND THE GENERATOR BEHIND IT WROTE ONE FIELD OF FIVE. runWizardWebBatch set only
    // wpRel.together on a record that now carries five fields, a stepper and a hook, all of
    // which are edited on the Relationships surface with per-field Generate. A second
    // editor that can only fill one fifth of the record is the duplication F-26 and F-29
    // were removed for, arriving by a third door.
    //   regenerateWebLink / generateWebBatch / runWizardWebBatch had no other caller and
    //   are deleted with it. `st.web` and its loadRelationships read leave cePublishWiz.

    // ---- Narratives
    var narrRows: any[] = [];
    for (i = 0; i < idx.length; i++) {
        var nmv: any = idx[i];
        if (!nmv || nmv.type !== 'narrative') continue;
        if (String(nmv.narrativeParentId || '')) continue;
        narrRows.push((function(nm: any) {
            var nid = String(nm.id);
            var state = String(nm.storyState || 'locked');
            return ceListRow({
                label: String(nm.name || 'Unnamed thread'),
                sub: (state === 'active' ? 'running' : (state === 'completed' ? 'done' : 'not started yet')),
                trail: ceBar(CE_T.s2, [
                    ceBtn('Regenerate', 'wiz:narrregen:' + nid, function() {
                        return _ceWizRun('Regenerating \u201c' + String(nm.name || '') + '\u201d\u2026', 'wiz-narrregen',
                            function() { return regenerateNarrativeThread(nid, eff, _ceWizHint(nid)); },
                            'Updated \u201c' + String(nm.name || '') + '\u201d.', 'Regeneration failed.');
                    }),
                    // THE CROSS-LINK the deletion sweep was gated on. The native row called
                    // openEntityEditModal(nm.id) at engine ~21421; this is that call site,
                    // now pointing at the jsx Entity surface with a return address.
                    // A button, not a row onClick -- NESTED-TAP, as above.
                    ceBtn('Open', 'wiz:narropen:' + nid, function() {
                        ceNav('entity', nid, '', _ceWizGoBack());
                        return Promise.resolve();
                    }),
                    ceBtn('Remove', 'wiz:narrdel:' + nid, function() {
                        return ceEntityOp(function() { return Promise.resolve(deleteEntity(nid)); }).then(cePublishWiz);
                    }, 'danger')])
            });
        })(nmv));
    }

    var narrBlock = ceGroup('Threads \u00b7 ' + narrRows.length, ceStack(CE_T.s2, [
        ceProse('t3',
            'Opening plots \u2014 quests, mysteries, obligations. Created at the top level; nest them from the thread\u2019s own screen.', { key: 'wd_nnote' }),
        _ceWizNameRow('narrative', 'Write it', 'What the thread is called\u2026',
            function(gnName: string) {
                return _ceWizRun('Writing \u201c' + gnName + '\u201d\u2026', 'wiz-narr',
                    function() { return stageNarrativeNamed(gnName, eff); },
                    'Thread created.', 'Generation failed.');
            }),
        narrRows.length
            ? ceStack({ key: 'wd_nrows' }, narrRows)
            : ceEmpty('No threads yet.', null),
        ceBtn('Add a blank thread', 'wiz:narrblank', function() {
            return ceEntityOp(function() { return Promise.resolve(addBlankWizardNarrative()); }).then(cePublishWiz);
        })
    ]));

    return ceStack(CE_T.s4, [
        ceProse('t2',
            'The pressure the story opens under. All three generators below read the cast plus whatever context you choose.', { key: 'wd_lede' }),
        ceWrap({ key: 'wd_src' }, [ _ceWizSources('drama', st)]),
        ceWrap({ key: 'wd_hooks' }, hooks),
        ceWrap({ key: 'wd_narr' }, narrBlock)
    ]);
}

// -- Intro --------------------------------------------------------------------
// Generate a draft opening, edit it, then commit it into the document. The one tab whose
// commit writes PROSE rather than records.
function _ceWizIntro(st: any): any {
    var eff = _ceWizEffSrc(st, 'intro');
    var locId = String((st && st.introLocId) || '');
    var locName = String((st && st.introLocName) || '');
    var prose = String((st && st.introProse) || '');
    var hasDraft = !!prose.trim();

    var locRow = ceSettingRow('Opening location',
        locId ? '' : 'Pick where the story starts. The draft is written from this place.',
        ceBtn(locId ? locName : 'Pick a place', 'wiz:introloc', function() {
            cePickerOpen('wizIntroLoc', {});
            return Promise.resolve();
        }, locId ? undefined : 'primary'));

    var genBtn = ceBtn(hasDraft ? 'Write it again' : 'Write the opening', 'wiz:introgen', function() {
        if (!locId) {
            try { api.v1.ui.toast('Pick an opening location first.', { type: 'error', autoClose: 2400 }); } catch (eI1) {}
            return Promise.resolve();
        }
        return _ceWizRun('Writing the opening\u2026', 'wiz-intro',
            function() { return generateIntroDraft(locId, eff); },
            'Draft ready \u2014 read it below.', 'Could not write the opening.');
    }, hasDraft ? undefined : 'primary');

    var kids: any[] = [
        ceProse('t2',
            'The first words of the story. Who is present comes from where each character is standing \u2014 set that on their own screen, not here.', { key: 'wi_lede' }),
        ceWrap({ key: 'wi_loc' }, locRow),
        ceWrap({ key: 'wi_src' }, [ _ceWizSources('intro', st)]),
        ceWrap({ key: 'wi_gen' }, genBtn)
    ];

    if (hasDraft) {
        kids.push(ceWrap({ key: 'wi_draft' }, [ ceGroup('The draft',
            ceStack(CE_T.s3, [
                h(ceField, {
                    key: 'wi_prose', k: 'wiz:intro:prose', label: '',
                    value: prose, seed: String((st && st.draftGen) || 0),
                    multiline: true, rows: 12, well: true,
                    placeholder: 'The opening prose\u2026',
                    onCommit: function(v: string) {
                        return ceWizOp(function() {
                            return Promise.resolve(loadIntroDraft()).then(function(cur: any) {
                                var next: any = (cur && typeof cur === 'object') ? cur : { locationId: '', prose: '' };
                                next.prose = v;
                                return Promise.resolve(api.v1.storyStorage.set(STORAGE_WIZ_INTRO_DRAFT, JSON.stringify(next)))
                                    .catch(function() { return null; });
                            });
                        });
                    }
                }),
                ceInline({ gap: CE_T.s2, key: 'wi_acts' }, [
                    ceBtn('Put it in the story', 'wiz:introcommit', function() {
                        return _ceWizRun('Inserting the opening\u2026', 'wiz-intro-commit',
                            function() { return commitIntroDraft(); },
                            'The opening is in the story.', 'Commit failed.');
                    }, 'primary'),
                    ceBtn('Throw it away', 'wiz:introdrop', function() {
                        return ceWizOp(function() {
                            return Promise.resolve(api.v1.storyStorage.remove(STORAGE_WIZ_INTRO_DRAFT))
                                .catch(function() { return null; })
                                .then(function() {
                                    return Promise.resolve(api.v1.tempStorage.remove(STORAGE_WIZ_INTRO_DRAFT))
                                        .catch(function() { return null; });
                                });
                        }).then(cePublishWiz);
                    }, 'danger')])
            ]))]));
    }

    return ceStack(CE_T.s4, kids);
}

// -- Tab row ------------------------------------------------------------------
// A tab change REPUBLISHES, because the publish is tab-scoped -- see cePublishWiz. This
// is the only place a tab is set on this surface, so that pairing cannot be forgotten.
function _ceWizTabRow(active: string): any {
    return ceTabRow('wizard', CE_WIZ_TABS, active, function() { cePublishWiz(); });
}

// -- Root ---------------------------------------------------------------------
function _ceWizRoot(): any {
    ceWizStoreInit();
    var ui = useStoreValue(ceUiStore);
    var st = useStoreValue(ceWizStore);

    useEffect(function() { cePublishWiz(); }, []);

    var back: any = ceBack();
    var tab = _ceWizTab();
    var openMap: any = (ui && ui.open) || {};

    // The store still holds the PREVIOUS tab's data until the republish lands, so the body
    // is held back rather than rendered against the wrong slice -- Drama reading a store
    // published for Setup would show an empty cast rather than a loading state.
    if (!ui || !st || !st.ready || st.tab !== tab) {
        return ceScreen(ceHeader(back), [_ceWizTabRow(tab), ceEmpty('Loading\u2026', null)]);
    }

    var body: any;
    if (tab === 'chat')            { body = _ceWizChat(st, openMap); }
    else if (tab === 'memory')     { body = _ceWizMemory(st, openMap); }
    else if (tab === 'species' || tab === 'factions' || tab === 'items') {
                                     body = _ceWizEntities(tab, st, openMap); }
    else if (tab === 'locations')  { body = _ceWizLocations(st, openMap); }
    else if (tab === 'characters') { body = _ceWizCharacters(st); }
    else if (tab === 'drama')      { body = _ceWizDrama(st); }
    else if (tab === 'intro')      { body = _ceWizIntro(st); }
    // [WIZ-ONE-DOOR] The fallback IS the Start tab now, so an unrecognised or retired token
    // lands on the seed rather than on a screen that no longer exists.
    else                           { body = _ceWizChat(st, openMap); }

    // [TABBODY-KEY] Same slot, same fix as Images -- see the long note there.
    // Wizard DOES paint (character thumbs on the Characters tab), so this one is
    // corrective, not prophylactic.
    return ceScreen(ceHeader(back), [_ceWizTabRow(tab),
        ceWrap({ key: 'wiztab:' + tab }, body)]);
}









// ============================================================================
// SECTION 38 — ACTIONS PANEL (jsx)  [F-15a] [SEC:ACTIONS]
//
// THE FIRST SURFACE THAT FIRES A ROLL. Everything before it was scaffolding: the state
// core, the modifier arithmetic, the dice, the bands and the imperative slot all existed
// and had no door. ceResolve and ceCommitResolution shipped in 3.0.65 with zero callers
// under a stated exception; this is the caller, and the exception is closed.
//
// IT TAKES THE ATTEMPT, ROLLS IT, WRITES BOTH SENTENCES TO THE DOCUMENT, AND STOPS THERE.
// [F-19] THE TEXT FIELD IS BACK AND THE OLD RULE IS DELETED, NOT AMENDED. It read "there is
// deliberately no text field and no Send button here", on the reasoning that a second story
// input would put the player's action out of narrative and force the model to restate it.
// That reasoning applied to a panel that only PRIMED. This one TRANSCRIBES: the attempt
// typed here is written into the document verbatim as the first half of an instruction
// paragraph, so it is not a second input, it is the only one.
// THE ORDER IS: type the attempt -> set approach / resolution / target / wager -> Roll ->
// read (and edit, or Rewrite) the composed outcome sentence -> "Write it to the story".
// THERE IS STILL NO SEND BUTTON. Writing the paragraph and generating from it are separate
// presses on purpose: the author sees the sentences land in their own document and NAI's own
// Send does the generation, which keeps this whole feature outside the generation lifecycle.
//
// THE RECEIPT IS THE OTHER HALF, and it is not a diagnostic. ceStateModifier keeps its
// parts separate specifically so a surface can show the arithmetic; a roll the player
// cannot check is a roll they have to trust. Modifiers and their sources, the faces, the
// total, the band, and the exact directive that went to the model.
//
// STAKES SHIP AND FIRE (F-14). The Stakes control overrides the approach's standing wager
// (ceStakeForMove is the only answer to "which one"), ceApplyStake charges it before the
// commit, and the receipt's ledger lists what was charged AND what could not be, with the
// reason -- an omitted line and an unauthored stake look identical otherwise.
//
// KNOWN, NAMED, NOT FIXED: A RESOLUTION DOES NOT REWIND ON UNDO. State values live on the
// character record in storyStorage; Undo rewinds historyStorage. A roll that costs 3
// Health and is then undone leaves the 3 gone. TWO REPAIRS EXIST and neither is that undo:
// the receipt's own one-use "Put this back" (F-14u, reverses the ledger's real deltas) and
// the profile stepper. onHistoryNavigated is registered and is where a continuityId-keyed
// reversal would go if it is ever worth a second write path.
// ============================================================================

// A scriptPanel gets whatever height NAI gives it, which is not a resolvable 100% -- the
// same class of problem CE_SHELL_WINDOW documents for the resizable window. A floor is
// what stops the jsx host collapsing to zero and rendering nothing at all.
var CE_ACTIONS_MIN_PX = 260;

var ceActionsStore: any = null;

// INITIALISED FROM registerEngineUI, NOT ceOpenShell. The panel can be opened from NAI's
// own panel list without the shell modal ever having been opened, so it cannot depend on
// ceStoresInit -- which is why STORE-BEFORE-HOOK's selftest lists it separately.
function ceActionsStoreInit(): void {
    if (ceActionsStore) return;
    try {
        ceActionsStore = createStore({ ready: false, approaches: [], resolutions: [],
                                       cast: [], factions: [], stakes: [], stakeName: '', autoStakeName: '',
                                       queued: '', posTerm: null,
                                       // [PANEL-PICK] THE PANEL'S OWN PICKER SLOT. It is
                                       // ceUiStore.picker's counterpart and exists for the
                                       // one reason PANEL-SUBSTRATE already gives: the
                                       // shell's slot is rendered by ceRoot, and ceRoot is
                                       // not mounted when this panel is.
                                       pick: null,
                                       // [F-15e][F-15d] The three lists the move pickers
                                       // read and the presets both preset pickers read.
                                       // Published here because options() is synchronous
                                       // and every one of them needs storage.
                                       movables: [], places: [], people: [], presets: [],
                                       // [I-07] Resource rows for the Bonus stepper: id,
                                       // name and the ACTOR's balance in each.
                                       spendDefs: [],
                                       // [F-19] The composed sentence and whether it has
                                       // been written yet. Derived from STORAGE_LAST_RESOLUTION
                                       // in cePublishActions, never held independently -- a
                                       // second copy is how the panel comes to offer a Write
                                       // for a line the document already has.
                                       outcome: '', outcomeReady: false, outcomeSent: false,
                                       // [H-02] DISCLOSURE STATE, ON THIS STORE AND NOT ON
                                       // ceUiStore.open. Every other accordion in the file
                                       // uses that map, and this panel cannot: it is a
                                       // scriptPanel reachable with the shell modal never
                                       // mounted, which is the same fact PANEL-PICK cites
                                       // for giving it a picker slot of its own.
                                       showHelp: false, showStake: false,
                                       // [EVENT] The encounter block. `ev` is null when
                                       // none is running and the section renders its start
                                       // form instead; `evShapes` is published either way
                                       // because the form needs it and options() is
                                       // synchronous. `evDraft` is view state only -- the
                                       // one-line description in progress, which has
                                       // nowhere to persist to until Begin is pressed.
                                       ev: null, evShapes: [], evDraft: '', evShape: '',
                                       // [H-02] The resolved wager, band by band, in the
                                       // bound resolution's own order. Built in the publish
                                       // because it needs the catalog and the arm together;
                                       // the panel must never re-derive what a stake costs.
                                       stakeBreak: [], stakeNote: '',
                                       armed: null, last: null, actorName: '',
                                       // [F-3][STORE-BEFORE-HOOK] Party is in the INITIAL
                                       // shape; the actor button reads it on first render.
                                       actorId: '', party: [], protagId: '' });
    } catch (e) { api.v1.error('[AE:actions] store init failed:', e); }
}

// [H-02] A DISCLOSURE FLIP, AND NOTHING ELSE. Deliberately not a publish: opening the help
// must not cost a dozen storage reads, and a republish mid-flow would shut an open picker
// (PANEL-PICK's own warning).
function _ceActionsFlip(key: string): void {
    if (!ceActionsStore) return;
    try {
        ceActionsStore.set(function(st: any) {
            var next: any = {}; var k: string;
            for (k in st) { next[k] = st[k]; }
            next[key] = !st[key];
            return next;
        });
    } catch (e) { api.v1.error('[AE:actions] flip failed:', e); }
}

// One read of everything the panel draws. Publishes on mount and after every commit, the
// same arrangement cePublishScene uses -- and it fails toward the PREVIOUS value rather
// than a blank one for the same reason.
async function cePublishActions(): Promise<void> {
    if (!ceActionsStore) return;
    try {
        var cfg = await loadConfig();
        var apps = ceStateApproaches(cfg);
        var appRows: any[] = [];
        var i = 0;
        for (i = 0; i < apps.length; i++) appRows.push({ id: String(apps[i].id), label: String(apps[i].name || apps[i].id) });

        var rdefs = ceResolutionDefs(cfg);
        var resRows: any[] = [];
        for (i = 0; i < rdefs.length; i++) {
            if (!rdefs[i]) continue;
            resRows.push({ id: String(rdefs[i].id), label: String(rdefs[i].name || rdefs[i].id) });
        }

        // THE CAST OFFERED AS TARGETS IS THE PRESENT ROSTER, not the whole world. A Move
        // aims at someone in the room, and a bounded short list is what makes ceSelect the
        // correct control here rather than the picker surface (CE-STYLE 13: ceSelect is for
        // a closed, short, self-describing list). An entity or faction target is unbounded
        // and needs the picker -- that is F-15b, and CeTargetRef already has room for it.
        var pid = await ceProtagonistId(cfg);
        var actorName = '';
        var cast: any[] = [];
        var all: any[] = [];
        // [F-3] WHO MAY ROLL. The protagonist always, plus anyone flagged followCamera who is
        // ACTUALLY IN THE ROOM -- a party member who is elsewhere cannot act here, and the
        // follow flag alone does not prove they arrived (a schedule or a manual move can put
        // them somewhere else between turns).
        var party: any[] = [];
        var actorPick = await ceActorId(cfg);
        try { all = await loadAllCharacters(); } catch (eC) { all = []; }
        for (i = 0; i < all.length; i++) {
            var c: any = all[i];
            if (!c || !c.id) continue;
            if (String(c.id) === String(pid)) {
                party.push({ id: String(c.id), label: String(c.name || 'Unnamed') });
                if (String(actorPick) === String(c.id)) actorName = String(c.name || '');
                continue;
            }
            if (!c.scenePresent) continue;
            if ((c as any).followCamera && c.active !== false) {
                party.push({ id: String(c.id), label: String(c.name || 'Unnamed') });
                if (String(actorPick) === String(c.id)) actorName = String(c.name || '');
            }
            cast.push({ id: String(c.id), label: String(c.name || 'Unnamed') });
        }

        var stakes: any[] = [];
        var sl = ceStakeDefs(cfg);
        for (i = 0; i < sl.length; i++) {
            if (!sl[i]) continue;
            // [F-31] AN ENCOUNTER'S OWN WAGER IS NOT A BASE WAGER. It rides every roll while
            // one is running (EVENT-STAKE) and choosing it HERE as well would charge the same
            // track twice for one attempt -- a silent double, and the sort of thing that is
            // only ever discovered by reading a receipt carefully. Filtered from this control
            // and this control only; Settings > Rolls still lists and edits them.
            if (ceStakeIsEvent(cfg, sl[i])) continue;
            stakes.push({ id: String(sl[i].id), label: String(sl[i].name || sl[i].id) });
        }

        // [F-31] THE FACTIONS, AS TARGETS. A Move can aim at one directly now, which is what
        // makes a faction-scoped stake cell resolvable on the target side -- see _ceStakeRef.
        // A SEPARATE LIST FROM `cast` rather than rows appended to it: `cast` means the people
        // in the scene everywhere else it is read, and widening it to mean "things a Move may
        // aim at" is how a list comes to be filtered differently by each of its readers.
        var facOpts: any[] = [];
        try {
            var facMeta: any[] = await ceFactionMetas();
            for (i = 0; i < facMeta.length; i++) {
                if (!facMeta[i] || !facMeta[i].id) continue;
                facOpts.push({ id: String(facMeta[i].id),
                               label: String(facMeta[i].name || 'Unnamed faction') });
            }
        } catch (eFo) { facOpts = []; }
        // [F-20] THE SPEND OPTIONS ARE RESOURCE-AND-AMOUNT IN ONE CLOSED LIST, which is why
        // this is a ceSelect and not a picker plus a stepper. Two controls would admit two
        // states no roll can act on -- an amount with no resource, a resource with no amount
        // -- and CE-STYLE 13 wants ceSelect for exactly a list like this one: closed, short
        // and self-describing. One spendable at CE_SPEND_MAX 2 is three options.
        //   BOUNDED BY WHAT IS ACTUALLY HELD, so the control cannot offer a spend that would
        //   be clamped down at the till. ceSpendForBonus still clamps -- this projection can
        //   be a moment stale and the charge is the authority -- but the common case never
        //   reaches it, and an author is never shown a price they cannot pay.
        // [I-07] ONE ROW PER RESOURCE, NOT ONE PER LEGAL AMOUNT. The composite
        // '<defId>:<n>' list this replaced existed only to make a select able to ask two
        // questions at once; the stepper asks them as two controls, so the payload is the
        // resources themselves and the balance each one holds.
        // [F-3] The balance addresses the ACTOR, or it would quote the protagonist's purse
        // while the roll spent a party member's.
        var spendDefRows: any[] = [];
        var spl = ceStateSpendables(cfg);
        for (i = 0; i < spl.length; i++) {
            var spDef: StateDef = spl[i];
            var spRef = _ceStakeRef(spDef, String(actorPick || ''), true, String(pid || ''));
            if (!spRef) continue;
            var spHave = 0;
            try { spHave = await stateRead(spRef); } catch (eSp) { spHave = 0; }
            spendDefRows.push({ id: String(spDef.id), name: String(spDef.name || spDef.id),
                                have: Math.max(0, Math.round(spHave)) });
        }

        var armedNow = await ceArmedLoad();
        // THE RESOLVED WAGER, COMPUTED ONCE HERE. The panel must never re-derive it -- the
        // control shows what the roll will actually charge, and two derivations is how those
        // two things come to disagree.
        var stakeNow = ceStakeForMove(cfg, armedNow);
        var autoStake = ceStakeForApproach(cfg, armedNow ? String(armedNow.approachDefId || '') : '',
                                           armedNow ? String(armedNow.resolutionId || '') : '');

        // [H-02] WHAT THE WAGER ACTUALLY COSTS, BAND BY BAND. Author: the seeded stakes are
        // not obviously anything. A stake's rows are INDEX-ALIGNED WITH THE BOUND
        // RESOLUTION'S BANDS (StakeRow's own contract), so the readable form of a stake is
        // simply that alignment written out: for each outcome, what the actor pays and what
        // the target pays.
        //   NAMES, NOT IDS, AND THE SIDE SPELLED OUT. "st_stamina -1" is the storage; "you
        //   lose 1 Stamina" is the fact. A cell that resolves to no address on this side is
        //   reported as such rather than omitted -- an omitted line and an unauthored cell
        //   look identical, which is the same argument the receipt's ledger already makes.
        //   CLAMPED TO THE BANDS, per StakeRow: an author who deleted a band must not have
        //   the rows under it silently re-point at the wrong outcomes.
        var stakeBreak: any[] = [];
        // [EVENT] RESOLVED ONCE FOR THE WHOLE PUBLISH, and read by BOTH the wager preview
        // below and the encounter block further down. Two reads would be two answers.
        var _pubEvId = '';
        try { _pubEvId = await ceLiveEventId(); } catch (ePe) { _pubEvId = ''; }
        // [F-31] THE SAME TWO ADDRESSES THE ROLL RESOLVES, RESOLVED ONCE HERE TOO. The fifth
        // argument's history is the argument for the sixth: a preview that asks _ceStakeRef a
        // different question than the roll asks reports a wager as unwired while the roll
        // charges it correctly, and an author checking this surface is checking it precisely
        // because they do not trust that the wiring took.
        var _pubAcFac = '';
        var _pubTgFac = '';
        try {
            _pubAcFac = await ceCharFactionId(cfg, String(actorPick || pid || ''));
            if (!_pubAcFac && cfg) _pubAcFac = String((cfg as any).protagonistFactionId || '');
        } catch (ePa) { _pubAcFac = ''; }
        try {
            var _pubTgt: any = armedNow ? armedNow.target : null;
            var _pubTk = String((_pubTgt && _pubTgt.kind) || '');
            if (_pubTk === 'faction') _pubTgFac = String(_pubTgt.id || '');
            else if (_pubTk === 'char') _pubTgFac = await ceCharFactionId(cfg, String(_pubTgt.id || ''));
        } catch (ePt) { _pubTgFac = ''; }

        var stakeNote = '';
        if (stakeNow) {
            var brRes = ceResolutionDef(cfg, String(stakeNow.resolutionId || ''));
            var brBands: any[] = (brRes && Array.isArray(brRes.bands)) ? brRes.bands : [];
            var brRows: any[] = Array.isArray(stakeNow.rows) ? stakeNow.rows : [];
            var curRes = armedNow ? String(armedNow.resolutionId || '') : '';
            if (brRes && curRes && String(brRes.id) !== curRes) {
                // A STAKE BOUND TO ANOTHER TABLE IS A REAL STATE, not an error: the author
                // chose it. Saying so beats drawing bands that will not be the ones rolled.
                stakeNote = 'This wager is written against \u201c' + String(brRes.name || brRes.id)
                    + '\u201d, not the resolution selected above.';
            }
            var cellText = function(cell: any, isActor: boolean): string {
                if (!cell) return 'nothing';
                var amt = Math.round(Number(cell.amount) || 0);
                if (!amt) return 'nothing';
                if (String(cell.kind || '') === 'pressure') {
                    // NEGATIVE IS WARMTH for a pressure cell -- StakeCell says so, and the
                    // sign reading backwards is exactly why this is spelled out in words.
                    return (amt < 0 ? 'Position warms by ' : 'Position strains by ') + Math.abs(amt);
                }
                var cd = ceStateDef(cfg, String(cell.defId || ''));
                if (!cd) return cell.defId ? 'an unknown state' : 'nothing';
                var side = isActor ? String(pid || '') : (armedNow && armedNow.target ? String(armedNow.target.id || '') : '');
                // [EVENT] THE FIFTH ARGUMENT BELONGS HERE TOO, and its absence was a real
                // defect rather than a cosmetic one: this preview asks the SAME function the
                // roll asks, and asking it without the live encounter made every event cell
                // read "nowhere to charge it on this side" -- on the one surface an author
                // checks to find out whether their wager is wired up. The roll would have
                // charged it correctly and the panel said it could not. A preview that
                // disagrees with the thing it previews is worse than no preview.
                if (!_ceStakeRef(cd, side, isActor, String(pid || ''), _pubEvId,
                                 isActor ? _pubAcFac : _pubTgFac)) {
                    return String(cd.name || cd.id)
                        + (String(cd.scope || '') === 'event'
                            ? ' \u2014 no encounter is running'
                            : (String(cd.scope || '') === 'faction'
                                // [F-31] NAMED APART for ceApplyStake's reason: "no faction on
                                // this side" is fixed at the Target control or in Settings,
                                // and folding it into the generic miss sends the author
                                // hunting through the stake table instead.
                                ? ' \u2014 no faction on this side'
                                : ' \u2014 nowhere to charge it on this side'));
                }
                return (amt < 0 ? 'loses ' : 'gains ') + Math.abs(amt) + ' ' + String(cd.name || cd.id);
            };
            for (var bi = 0; bi < brBands.length; bi++) {
                var brRow: any = brRows[Math.max(0, Math.min(brRows.length - 1, bi))] || null;
                if (!brRows.length) brRow = null;
                stakeBreak.push({
                    band: String((brBands[bi] && brBands[bi].label) || ('Band ' + (bi + 1))),
                    actor: brRow ? cellText(brRow.actor, true) : 'nothing',
                    target: brRow ? cellText(brRow.target, false) : 'nothing'
                });
            }
        }

        var queued = '';
        try { queued = String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
        catch (eQ) { queued = ''; }
        var posTerm: any = null;
        try { posTerm = await api.v1.tempStorage.getOrDefault(STORAGE_POS_TERMINUS, null); }
        catch (eP) { posTerm = null; }

        var lastNow: any = await ceLastResolution();

        // [ACT-MODE] THE SIMPLE PANEL'S WHOLE PAYLOAD, and it is cheap by construction: the
        // plan is pure, the odds are pure, and neither reads storage. That is the same fact
        // ceActionPlan cites for why an odds strip is affordable in this mode and not in the
        // full one, where the modifier would need the actor's record and their gear.
        var actMode = ceActionsMode(cfg);
        var actPlan = ceActionPlan(cfg, armedNow);
        var actResDef = ceResolutionDef(cfg, armedNow ? String(armedNow.resolutionId || '') : '');
        var actDiceLine = '';
        var actOdds: any[] = [];
        var actOddsNote = '';
        if (actResDef) {
            var adCnt = Math.max(0, Math.min(20, Math.round(Number(actResDef.count) || 0)));
            var adSds = Math.max(2, Math.min(1000, Math.round(Number(actResDef.sides) || 6)));
            // [F-15c] ZERO DICE SAYS SOMETHING DIFFERENT AND MORE USEFUL. The Settings row for
            // this table already words it this way; saying it twice differently is how one
            // surface comes to describe a no-roll as a roll.
            actDiceLine = adCnt === 0 ? 'no dice \u2014 this always lands the same way'
                                      : (adCnt + 'd' + adSds);
            var actMods = actPlan.simple ? actPlan.freeBonus : 0;
            var actO = ceRollOdds(actResDef, actMods);
            if (actO) { actOdds = actO; }
            else {
                actOddsNote = 'This table rolls too wide a range to work the odds out live \u2014 '
                    + 'they are exact up to ' + CE_ODDS_MAX_SPAN + ' possible totals '
                    + '(dice \u00d7 faces). Yours is ' + (adCnt * adSds) + '.';
            }
        } else {
            actOddsNote = 'No resolution is defined. Write one under Settings \u203a Rolls.';
        }

        // [F-15e] THE MOVE LISTS, BUILT OFF THE ENTITY INDEX AND NOTHING ELSE. Post-ENT-ID1
        // a character IS an entity at the character's own id, so bodies, items and rooms
        // all come out of one read and an item held by a person resolves its container name
        // from the same map as an item lying in a room.
        var eIdx: any[] = [];
        try { eIdx = await loadEntityIndex(); } catch (eEi) { eIdx = []; }
        var nameById: any = {};
        for (i = 0; i < eIdx.length; i++) {
            if (eIdx[i] && eIdx[i].id) nameById[String(eIdx[i].id)] = String(eIdx[i].name || '');
        }
        // ACTIVE ONLY, and the index cannot answer that -- `active` lives on the record, so
        // the roster already loaded above is what filters the dead out of both lists. A
        // character in the Graveyard is reachable from the Map, which is where bringing them
        // back belongs; offering them here would make a resurrection look like a move.
        var alive: any = {};
        for (i = 0; i < all.length; i++) {
            if (all[i] && all[i].id && all[i].active !== false) alive[String(all[i].id)] = String(all[i].name || 'Unnamed');
        }
        var hereId = '';
        for (i = 0; i < eIdx.length; i++) {
            if (eIdx[i] && String(eIdx[i].id) === String(pid)) hereId = String(eIdx[i].parentId || '');
        }
        var hereName = hereId ? String(nameById[hereId] || '') : '';
        var movHere: any[] = [];
        var movAway: any[] = [];
        var places: any[] = [];
        var people: any[] = [];
        for (i = 0; i < eIdx.length; i++) {
            var m: any = eIdx[i];
            if (!m || !m.id) continue;
            var mt = String(m.type || '');
            var mPar = String(m.parentId || '');
            var mWhere = mPar ? String(nameById[mPar] || '') : '';
            // DERIVED ONCE AND USED TWICE, and it has to be: the bucket and the heading are
            // the same fact, and computing them separately is how they came to disagree.
            // The case that caught it (node harness, not live): a protagonist at the top of
            // the world has hereId '', a loose item has mPar '', and `mPar === hereId` is
            // then TRUE while `mPar && mPar === hereId` is false -- so the row filed under
            // "elsewhere" and captioned itself "Here". An empty room id means NOWHERE IS
            // HERE, which is what the leading truthiness test says and the bare equality
            // does not.
            var mHere = !!(mPar && hereId && mPar === hereId);
            if (mt === 'location') {
                places.push({ id: String(m.id), name: String(m.name || 'Unnamed'), where: mWhere });
                continue;
            }
            if (mt === 'character') {
                if (!alive[String(m.id)]) continue;
                // THE PROTAGONIST IS A DESTINATION BUT NEVER A SUBJECT. Moving your own body
                // out from under the camera desynchronises the two, and the Map already owns
                // that verb properly -- setting the camera moves you AND everyone Following.
                // Handing something TO yourself is an ordinary move and stays offered.
                people.push({ id: String(m.id), name: alive[String(m.id)],
                              where: mWhere ? ('in ' + mWhere) : '' });
                if (String(m.id) === String(pid)) continue;
                (mHere ? movHere : movAway).push({
                    id: String(m.id), kind: 'char', name: alive[String(m.id)],
                    sub: 'character' + (mWhere ? (' \u00b7 in ' + mWhere) : ''),
                    group: mHere ? (hereName ? ('Here \u00b7 ' + hereName) : 'Here')
                                 : (mWhere || 'Nowhere in particular') });
                continue;
            }
            if (mt === 'item') {
                (mHere ? movHere : movAway).push({
                    id: String(m.id), kind: 'item', name: String(m.name || 'Unnamed'),
                    sub: 'item' + (mWhere ? (' \u00b7 in ' + mWhere) : ' \u00b7 loose in the world'),
                    group: mHere ? (hereName ? ('Here \u00b7 ' + hereName) : 'Here')
                                 : (mWhere || 'Nowhere in particular') });
            }
        }
        var movables: any[] = movHere.concat(movAway);

        // [F-15d] Presets, flattened to what the two pickers render. The attempt doubles as
        // the sub-line because a preset's NAME is often a verb and its attempt is the thing
        // that tells two similarly named ones apart.
        var presets: any[] = [];
        var pdl: any[] = ceActionPresets(cfg);
        for (i = 0; i < pdl.length; i++) {
            if (!pdl[i]) continue;
            presets.push({ id: String(pdl[i].id), name: String(pdl[i].name || 'Unnamed'),
                           sub: _ceTrim(String(pdl[i].actionText || ''), 56) });
        }

        // [PANEL-PICK] THE OPEN PICK IS CARRIED FORWARD, NOT REBUILT. This set() replaces
        // the whole value, and a publish fires after every commit -- so without this read
        // any move that republishes mid-flow would shut the picker the author is standing
        // in. Same reasoning for the pick's ctx: it holds the first half of a two-step move.
        var prevSt: any = null;
        try { prevSt = ceActionsStore.get(); } catch (ePs) { prevSt = null; }

        // [EVENT] THE LIVE ENCOUNTER, READ THROUGH ceLiveEvent AND NEVER RE-DERIVED HERE.
        // The panel and the Author's Note must agree about which encounter is running, and
        // two readers of the same two storage slots is how they come to disagree.
        //   THE METER IS BUILT FROM THE SPAN, NOT FROM A STORED FRACTION. `frac` is
        //   recomputed from the def's own bounds every publish, so editing a shape's span
        //   mid-fight redraws correctly instead of showing a bar against bounds that no
        //   longer exist.
        var evOut: any = null;
        var evShapeRows: any[] = [];
        try {
            var evShapeDefs: StateDef[] = ceEventShapes(cfg);
            for (i = 0; i < evShapeDefs.length; i++) {
                evShapeRows.push({ id: String(evShapeDefs[i].id),
                                   label: String(evShapeDefs[i].name || evShapeDefs[i].id) });
            }
            var evLive: any = _pubEvId ? await ceLiveEvent() : null;
            if (evLive && evLive.ms) {
                var evDef = ceStateDef(cfg, String(evLive.ms.event.shapeDefId || ''));
                var evVal = 0;
                var evLo = 0;
                var evHi = 1;
                var evLine = '';
                if (evDef) {
                    var evB = _ceStateBounds(evDef);
                    evLo = evB.lo; evHi = evB.hi;
                    evVal = await stateRead({ scope: 'event', ownerId: String(evLive.ms.id),
                                              defId: String(evDef.id) });
                    evLine = String(ceStateBand(evDef, evVal).label || '').trim();
                }
                var evSpan = (evHi - evLo) || 1;
                evOut = {
                    id: String(evLive.ms.id),
                    threadId: String(evLive.threadId || ''),
                    loose: String(evLive.threadId || '') === CE_MS_LOOSE,
                    text: String(evLive.ms.text || ''),
                    // A DELETED SHAPE IS A WORKING STATE. The encounter still shows, still
                    // cancels and still concludes -- it simply has no track to draw, which
                    // is the honest reading of "the author deleted the shape mid-fight".
                    shapeName: evDef ? String(evDef.name || '') : '',
                    // NAMED FROM THE MILESTONE'S COPY, not the shape's current field -- the
                    // encounter committed to a table at Begin and that is what the roll will
                    // charge, so quoting the shape here could name a different one.
                    stakeName: (function() {
                        var sd = ceStakeDef(cfg, String(evLive.ms.event.stakeId || ''));
                        return sd ? String(sd.name || '') : '';
                    })(),
                    line: evLine, value: evVal, lo: evLo, hi: evHi,
                    // [EVT-POLARITY] DERIVED IN THE PUBLISH, not in the render, because the
                    // render has no config -- and derived rather than stored so an author who
                    // edits a shape's wager sees the bar change with it.
                    pol: ceEventPolarity(cfg, evDef),
                    frac: Math.max(0, Math.min(1, (evVal - evLo) / evSpan))
                };
            }
        } catch (eEvP) { api.v1.error('[AE:actions] encounter publish:', eEvP); evOut = null; }

        ceActionsStore.set({
            ready: true, approaches: appRows, resolutions: resRows, cast: cast,
            queued: queued, posTerm: posTerm,
            stakes: stakes,
            spendDefs: spendDefRows,
            pick: (prevSt && prevSt.pick) || null,
            movables: movables, places: places, people: people, presets: presets,
            stakeName: stakeNow ? String(stakeNow.name || '') : '',
            autoStakeName: autoStake ? String(autoStake.name || '') : '',
            stakeBreak: stakeBreak, stakeNote: stakeNote, factions: facOpts,
            // [H-02] Disclosure state survives a republish for the same reason `pick` does:
            // a commit republishes, and a help panel that shut itself on every keystroke
            // would be worse than no help panel.
            showHelp: !!(prevSt && prevSt.showHelp),
            showStake: !!(prevSt && prevSt.showStake),
            // [EVENT] The draft and the chosen shape survive a republish for the reason
            // `pick` and the disclosure flags do: every field commit republishes, and a
            // start form that emptied itself on each keystroke would be unusable.
            ev: evOut, evShapes: evShapeRows,
            evDraft: String((prevSt && prevSt.evDraft) || ''),
            evShape: String((prevSt && prevSt.evShape) || ''),
            // [F-19b] READ OFF THE RESULT. `outcomeReady` is now "a roll has landed whose
            // attempt is not yet written" -- there is no composed line, so the field is gone
            // and the Write button is the only consumer.
            outcomeReady: !!(lastNow && !lastNow.sentToStory && String(lastNow.actionText || '').trim()),
            outcomeSent: !!(lastNow && lastNow.sentToStory),
            // [ACT-MODE] THE MODE AND EVERYTHING SIMPLE MODE DRAWS. Computed here rather
            // than in the renderer for the reason every other row on this payload is: the
            // renderer is synchronous and the plan needs the config.
            mode: actMode, freeBonus: actPlan.freeBonus,
            simpleStakeName: actPlan.stake ? String(actPlan.stake.name || '') : '',
            resolutionName: actResDef ? String(actResDef.name || actResDef.id) : '',
            diceLine: actDiceLine, odds: actOdds, oddsNote: actOddsNote,
            armed: armedNow, last: lastNow, actorName: actorName,
            // [F-3] Published so the actor button can name who it will change.
            actorId: String(actorPick || ''), party: party,
            // [F-3] Published so the picker can mark WHICH row is the protagonist. Without
            // it every row read 'following', including the protagonist's own.
            protagId: String(pid || '')
        });
    } catch (e) { api.v1.error('[AE:actions] publish failed:', e); }
}

// The draft the three controls write into. ARMING IS THE COMMIT and there is no separate
// confirm: the arm is free to change, costs nothing until Send, and Cancel is one tap on
// the toolbar. A staged-then-armed two-step would be a second Send button by another name.
async function ceActionArm(patch: any): Promise<void> {
    var cur = await ceArmedLoad();
    var cfg = await loadConfig();
    var base: CeArmedAction = cur || {
        approachDefId: '', resolutionId: ceDefaultResolutionId(cfg),
        spendDefId: '', spendAmount: 0, freeBonus: 0,
        target: null, stakeId: CE_STAKE_AUTO, actionText: '', armedAt: 0
    };
    // A move stored before F-19 has no field at all; '' is the correct reading of absence.
    if (typeof base.actionText !== 'string') base.actionText = '';
    // [ATTEMPT-SCRATCH] AN EXTERNAL WRITE WINS OVER THE SCRATCHPAD AND CLEARS IT. Loading a
    // preset arms an attempt the field has not been typed into; leaving a stale draft
    // standing would let the next Roll flush it straight back over what was just loaded.
    if (patch.actionText !== undefined) {
        base.actionText = String(patch.actionText || '');
        _ceAttemptDraft = null;
    }
    if (patch.approachDefId !== undefined) base.approachDefId = String(patch.approachDefId || '');
    // [I-04] `resolutionId` IS NOT PATCHABLE. It is assigned unconditionally below, from the
    // world's default and nowhere else -- a patch key nothing sends is a door left open for the
    // second writer this change exists to remove.
    // [F-20] THE PAIR MOVES TOGETHER OR NOT AT ALL. The composer offers one control whose
    // options are resource-and-amount, so the two arrive in one patch; clamping them
    // independently would admit "spend 2 of nothing" and "spend 0 Luck", neither of which
    // any surface can produce and both of which the roll path would then have to guard.
    if (patch.spendDefId !== undefined || patch.spendAmount !== undefined) {
        var spD = String((patch.spendDefId !== undefined) ? (patch.spendDefId || '') : base.spendDefId);
        var spN = Math.max(0, Math.min(CE_SPEND_MAX,
            Math.round(Number((patch.spendAmount !== undefined) ? patch.spendAmount : base.spendAmount) || 0)));
        if (!spD || !spN) { spD = ''; spN = 0; }
        base.spendDefId = spD;
        base.spendAmount = spN;
    }
    // [ACT-MODE] CLAMPED ON THE WAY IN, like the spend pair above it and for the same reason:
    // a stepper is bounded by its own props and a preset or a stale arm is not.
    if (patch.freeBonus !== undefined) {
        (base as any).freeBonus = Math.max(-CE_FREE_BONUS_MAX, Math.min(CE_FREE_BONUS_MAX,
            Math.round(Number(patch.freeBonus) || 0)));
    }
    if (patch.target !== undefined)        base.target        = patch.target;
    // [F-14] Assigned RAW, including '' -- see CeArmedAction.stakeId for why an empty
    // string is a real choice here and not an absent one.
    if (patch.stakeId !== undefined)       base.stakeId       = String(patch.stakeId);
    if (patch.eventOff !== undefined)      (base as any).eventOff = !!patch.eventOff;
    base.armedAt = Date.now();
    // [I-04] THE WORLD'S DEFAULT IS RE-READ ON EVERY ARM, not only on a fresh one. No control
    // can set this to anything else any more, so re-reading is what makes a change in Settings
    // reach an arm that is already standing; without it the panel would keep rolling the table
    // that was default when the arm was first built, and nothing on screen would say so.
    base.resolutionId = ceDefaultResolutionId(cfg);
    if (!base.resolutionId) {
        try { api.v1.ui.toast('No resolution is defined, so there is nothing to roll.', { type: 'warning', autoClose: 3500 }); } catch (e) {}
        return;
    }
    await ceArmedSet(base);
    await ceSyncToolbar();
    await cePublishActions();
}

// ── The panel's picker slot  [PANEL-PICK] ──────────────────────────────────────────────
// ceUiPatch's counterpart for a surface the shell does not own. Both verbs write the store
// directly rather than through a chain: a pick is view state, nothing persists it, and the
// store is the only reader.

function ceActionsPickOpen(kind: string, ctx: any): void {
    if (!ceActionsStore) return;
    if (!CE_PICKER_DEFS[kind]) {
        api.v1.error('[AE:actions] unknown picker kind: ' + String(kind));
        return;
    }
    var k = String(kind);
    var c: any = ctx || {};
    ceActionsStore.set(function(st: any) {
        var next: any = {};
        var key: string;
        for (key in st) { if (Object.prototype.hasOwnProperty.call(st, key)) next[key] = st[key]; }
        next.pick = { kind: k, ctx: c };
        return next;
    });
}

// `onlyKind` IS WHAT MAKES A TWO-STEP PICKER POSSIBLE. _cePickerSurface closes after every
// commit resolves, and moveWhat's commit OPENS the next picker -- so an unconditional close
// would shut the second one the instant the first finished. Passing the kind that asked to
// close makes the request idempotent against a slot that has already moved on.
function ceActionsPickClose(onlyKind?: string): void {
    if (!ceActionsStore) return;
    var want = String(onlyKind || '');
    ceActionsStore.set(function(st: any) {
        var cur: any = st ? st.pick : null;
        if (want && cur && String(cur.kind || '') !== want) return st;
        var next: any = {};
        var key: string;
        for (key in st) { if (Object.prototype.hasOwnProperty.call(st, key)) next[key] = st[key]; }
        next.pick = null;
        return next;
    });
}

// ── Encounters  [EVENT] ────────────────────────────────────────────────────────────────
// THE DOOR THE ENGINE LAYER SHIPPED WITHOUT. Everything below is a thin press-to-verb: the
// decisions all live in ceMilestoneOp's three event ops, so this file has no second copy of
// "one at a time", of where a threadless encounter is filed, or of what concluding costs.
//
// A DRAFT FLIP, NOT A PUBLISH, for _ceActionsFlip's reason exactly -- typing the
// description must not cost a dozen storage reads per keystroke.
function _ceActionsEvDraft(patch: any): void {
    if (!ceActionsStore) return;
    try {
        ceActionsStore.set(function(st: any) {
            var next: any = {}; var k: string;
            for (k in st) { if (Object.prototype.hasOwnProperty.call(st, k)) next[k] = st[k]; }
            if (patch.evDraft !== undefined) next.evDraft = String(patch.evDraft || '');
            if (patch.evShape !== undefined) next.evShape = String(patch.evShape || '');
            return next;
        });
    } catch (e) { api.v1.error('[AE:actions] encounter draft:', e); }
}

// WHERE A NEW ENCOUNTER IS FILED. The active thread if there is one, the loose store if
// there is not -- so an author with an arc gets it attached to what they are already
// pushing, and one without pays no thread to start a bar fight. THE CHOICE IS DERIVED, not
// offered: a picker here would ask a question whose right answer is already known, and
// EVENT-LOOSE's cap exists precisely so the fallback is safe to take silently.
async function ceActionsEvBegin(): Promise<void> {
    var st: any = null;
    try { st = ceActionsStore ? ceActionsStore.get() : null; } catch (e) { st = null; }
    if (!st) return;
    var shapeId = String(st.evShape || '');
    var text = String(st.evDraft || '').trim();
    if (!shapeId) {
        try { api.v1.ui.toast('Choose a shape first.', { type: 'info', autoClose: 2500 }); } catch (e1) {}
        return;
    }
    if (!text) {
        try { api.v1.ui.toast('Describe the encounter in a line.', { type: 'info', autoClose: 2500 }); } catch (e2) {}
        return;
    }
    var tid = '';
    try { tid = await loadActiveThread(); } catch (e3) { tid = ''; }
    if (!tid) tid = CE_MS_LOOSE;
    try {
        await ceMilestoneOp(tid, 'event.begin', { shapeDefId: shapeId, text: text });
    } catch (e4) { api.v1.error('[AE:actions] encounter begin:', e4); }
    _ceActionsEvDraft({ evDraft: '', evShape: '' });
    await cePublishActions();
}

// [EVENT] CANCEL TAKES THE MECHANICS OFF AND LEAVES THE MILESTONE; CONCLUDE ARCHIVES IT.
// Two buttons and not one, because "the story walked past this fight" and "this fight is
// over" leave the author's objective in different places, and collapsing them would make
// the cheap escape hatch also resolve something they never finished.
async function ceActionsEvEnd(op: string): Promise<void> {
    var st: any = null;
    try { st = ceActionsStore ? ceActionsStore.get() : null; } catch (e) { st = null; }
    var ev: any = st ? st.ev : null;
    if (!ev) return;
    try { await ceMilestoneOp(String(ev.threadId || CE_MS_LOOSE), String(op), null); }
    catch (e2) { api.v1.error('[AE:actions] encounter ' + String(op) + ':', e2); }
    await cePublishActions();
}

// ── Move  [F-15e] ──────────────────────────────────────────────────────────────────────
// FREE AND SILENT, PER AUTHOR. It rolls nothing, charges nothing, writes nothing to the
// document and leaves no receipt. A move that produced an outcome sentence would be a
// second, quieter way to write a turn, and this panel already has the loud one; a move that
// rolled would be asking whether you succeed at putting a thing down.
//
// THE WRITES ARE THE EXISTING VERBS, NOT NEW ONES, and that is deliberate to the point of
// being the whole implementation:
//   character -> place   ceProfileSetLocation. The ONLY verb that moves a body and keeps
//                        CharacterMeta.currentLocationId in step (its own header explains
//                        why a bare ceEntityWrite on the body leaves the index stale), and
//                        it recalculates presence rather than asserting it.
//   item -> person       ceProfileEquipAdd. Already takes the thing off whoever had it.
//   item -> place        The one case with no verb of its own, spelled exactly as
//                        CE_PICKER_DEFS.entityParent spells it: RELEASE THE EQUIP STATE
//                        FIRST, or the old holder's equippedItemIds still names a thing
//                        lying on the floor (EQUIP-STATE-SYNC).
// A DESTINATION IS CLASSIFIED BY LOOKING IT UP, not by trusting the label the picker sent:
// the two lists are disjoint by construction, so "is it in places" is the whole test and a
// row that is somehow in neither falls through to nothing rather than to a guess.
async function ceActionMoveApply(kind: string, id: string, name: string,
                                 destId: string, destLabel: string): Promise<void> {
    try {
        if (!id || !destId) return;
        var st: any = null;
        try { st = ceActionsStore ? ceActionsStore.get() : null; } catch (e0) { st = null; }
        var isPlace = false;
        var places: any[] = (st && st.places) || [];
        for (var i = 0; i < places.length; i++) {
            if (places[i] && String(places[i].id) === String(destId)) { isPlace = true; break; }
        }

        if (String(kind) === 'char') {
            // A character can only go to a place. moveWhere never offers People for one, so
            // this is a guard against a stale published list, not a reachable branch.
            if (!isPlace) return;
            await ceProfileSetLocation(String(id), String(destId));
        } else if (isPlace) {
            var it: any = await loadEntity(String(id));
            if (it && it.isEquipped) await ceEntitySetEquip(String(id), false);
            await ceEntityWrite(String(id), 'parentId', String(destId));
            try { await cePublishScene(); } catch (eS) {}
        } else {
            await ceProfileEquipAdd(String(destId), String(id));
            try { await cePublishScene(); } catch (eS2) {}
        }
        try {
            api.v1.ui.toast(String(name || 'It') + ' \u2192 ' + String(destLabel || 'there'),
                { type: 'success', autoClose: 2200 });
        } catch (eT) {}
        await cePublishActions();
    } catch (e) { api.v1.error('[AE:actions] move failed:', e); }
}

// ── Presets  [F-15d] ───────────────────────────────────────────────────────────────────
// THE WRITE CHAIN IS ceSettingsOp, NOT A NEW ONE. These are config writes and the Settings
// surface already owns the config chain; a second chain over the same record is how two
// edits in the same second come to overwrite each other. cePublishSettings is deliberately
// NOT called after -- no Settings surface renders presets, so there is nothing there to go
// stale, and it would mount a store this panel has no other reason to build.

// SAVING UNDER AN EXISTING NAME OVERWRITES, IT DOES NOT DUPLICATE. Matched on the trimmed,
// case-folded name, because "Pick the lock" and "pick the lock " are one preset in every
// sense the author means. This is also the only edit path a preset has: there is no preset
// editor, and there does not need to be, because re-saving IS the edit.
async function ceActionPresetSave(name: string): Promise<boolean> {
    var nm = String(name || '').trim();
    if (!nm) {
        try { api.v1.ui.toast('Give the preset a name first.', { type: 'warning', autoClose: 2500 }); } catch (e) {}
        return false;
    }
    var armed: any = await ceArmedLoad();
    // [ATTEMPT-SCRATCH] Same route, same fix: Save is a click, and the attempt beside it may
    // still be uncommitted. A preset saved with last turn's attempt in it is worse than one
    // saved with none, because nothing about it looks wrong until it is loaded.
    armed = await _ceFlushAttempt(armed);
    if (!armed) {
        try { api.v1.ui.toast('There is no action to save yet.', { type: 'warning', autoClose: 2500 }); } catch (e) {}
        return false;
    }
    var replaced = false;
    try {
        await ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var list: any[] = Array.isArray(c.actionPresets) ? c.actionPresets : [];
                var row: any = {
                    id: '', name: nm,
                    approachDefId: String(armed.approachDefId || ''),
                    // [I-04] No resolution. See CeActionPreset -- it belongs to the world.
                    stakeId: String(armed.stakeId === undefined ? CE_STAKE_AUTO : armed.stakeId),
                    // [F-20] No spend. See CeActionPreset -- it belongs to the turn.
                    actionText: String(armed.actionText || '')
                };
                var low = nm.toLowerCase();
                for (var i = 0; i < list.length; i++) {
                    if (!list[i]) continue;
                    if (String(list[i].name || '').trim().toLowerCase() !== low) continue;
                    // THE ID IS KEPT ACROSS AN OVERWRITE. Nothing stores a preset id today,
                    // but minting a new one on every save would make that impossible later
                    // for no benefit now.
                    row.id = String(list[i].id || generateId());
                    list[i] = row;
                    replaced = true;
                    break;
                }
                if (!replaced) { row.id = generateId(); list.push(row); }
                c.actionPresets = list;
            });
        });
        try {
            api.v1.ui.toast(replaced ? ('Replaced \u201c' + nm + '\u201d.') : ('Saved \u201c' + nm + '\u201d.'),
                { type: 'success', autoClose: 2200 });
        } catch (eT) {}
        await cePublishActions();
        return true;
    } catch (e) { api.v1.error('[AE:actions] preset save failed:', e); return false; }
}

// APPLIES THROUGH ceActionArm, NOT BY WRITING THE ARM DIRECTLY. That verb is where the
// resolution is assigned and the clamps live, so a preset arms exactly what a hand-built move
// would rather than a shape that skipped them. `target` and `resolutionId` are not in the patch
// at all -- see CeActionPreset for why.
async function ceActionPresetApply(id: string): Promise<void> {
    try {
        var cfg = await loadConfig();
        var list: any[] = ceActionPresets(cfg);
        var p: any = null;
        for (var i = 0; i < list.length; i++) {
            if (list[i] && String(list[i].id) === String(id)) { p = list[i]; break; }
        }
        if (!p) return;
        await ceActionArm({
            approachDefId: String(p.approachDefId || ''),
            stakeId: String(p.stakeId === undefined ? CE_STAKE_AUTO : p.stakeId),
            actionText: String(p.actionText || '')
        });
        try { api.v1.ui.toast('Loaded \u201c' + String(p.name || '') + '\u201d.', { type: 'info', autoClose: 2000 }); } catch (eT) {}
    } catch (e) { api.v1.error('[AE:actions] preset apply failed:', e); }
}

async function ceActionPresetDelete(id: string, label: string): Promise<void> {
    try {
        await ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var list: any[] = Array.isArray(c.actionPresets) ? c.actionPresets : [];
                var out: any[] = [];
                for (var i = 0; i < list.length; i++) {
                    if (list[i] && String(list[i].id) === String(id)) continue;
                    out.push(list[i]);
                }
                c.actionPresets = out;
            });
        });
        try { api.v1.ui.toast('Forgot \u201c' + String(label || '') + '\u201d.', { type: 'info', autoClose: 2000 }); } catch (eT) {}
        await cePublishActions();
    } catch (e) { api.v1.error('[AE:actions] preset delete failed:', e); }
}

// The receipt. Every part kept and shown in the order it was computed, because the parts
// ARE the explanation -- collapsing them to a total is what makes a roll unauditable.
function _ceActionReceipt(last: any): any {
    if (!last) return ceEmpty('No roll yet. Set an action up, then roll it.', null);
    var rows: any[] = [];
    var faces: any[] = (last.faces && last.faces.length) ? last.faces : [];
    var mods: any[] = (last.modParts && last.modParts.length) ? last.modParts : [];
    var mod = Number(last.modifier) || 0;

    rows.push(ceRow('Actor', String(last.actorName || '') + (last.approachName ? (' \u00b7 ' + last.approachName) : ''), null, 0));
    if (last.target && last.target.name) rows.push(ceRow('Target', String(last.target.name), null, 1));
    rows.push(faces.length
        ? ceRow('Dice', ceMono(String(last.resolutionName || '') + '  ' + faces.join(' + ') + ' = ' + String(last.raw)), null, 2)
        : ceRow('Dice', ceMono(String(last.resolutionName || '') + '  no roll'), null, 2));
    rows.push(ceRow('Modifier', mods.length
        ? ceMono(mods.join('  ') + '  = ' + (mod > 0 ? '+' : '') + mod)
        : ceSub('t3', 'none'), null, 3));
    rows.push(ceRow('Total', ceMono(String(last.total)), null, 4));
    rows.push(ceRow('Outcome', String(last.label || ''), null, 5));

    var sent: any[] = [];
    // PREEMPTION IS SHOWN, NOT HIDDEN. ceCommitResolution discards the band's note entirely
    // when a terminal is standing, and an author who is not told that will read the outcome
    // row above and expect the model to have received it.
    if (last.preempted && last.preempted.note) {
        sent.push(ceProse('t1', String(last.preempted.name || 'A character')
            + ' hit ' + String(last.preempted.defName || 'a limit') + ', so the roll\u2019s own directive was discarded.',
            { key: 'pre' }));
    }
    if (String(last.sent || '').trim()) {
        // [F-18b] PADDED, because this row claims to be what the model received and
        // ceDrainImperative pads. A receipt that renders a different string than was sent
        // is worse than no receipt.
        sent.push(ceProse('t2', '[ ' + String(last.sent).trim() + ' ]', { key: 'sent' }));
    } else {
        // NOT AN ERROR AND NOT A BLANK. An outcome whose band carries no note tells the
        // model nothing, which is a legitimate way to author a table and is also exactly
        // what a broken injection looks like. Naming it is the difference.
        // [F-15c] SILENCE IS OFTEN CORRECT AND IS NOT REPORTED AS A FAULT. Per author: a
        // no-roll whose consequences are pure arithmetic has nothing to tell the model --
        // the story text already says the character slept. Only a table WITH dice and no
        // note is likely to be an oversight, so only that one points at the field.
        sent.push((last.faces && last.faces.length)
            ? ceProse('t2', 'Nothing. This outcome has no directive \u2014 add one under '
                + 'Settings \u203a Rolls \u203a the band\u2019s "The model reads" field.', { key: 'sent' })
            : ceSub('t3', 'Nothing, by design. The numbers moved; the story needs no instruction.',
                { key: 'sent' }));
    }

    // [F-14] WHAT IT COST, INCLUDING WHAT IT DID NOT. A cell that could not be charged --
    // no target in the scene, a value already at its floor -- is listed with its reason
    // rather than omitted, because an omitted line and an unauthored stake look identical
    // and only one of them is a problem.
    var stakeBlock: any = null;
    var led: any[] = (last.stakeLedger && last.stakeLedger.length) ? last.stakeLedger : [];
    if (last.stakeName || led.length) {
        var ledRows: any[] = [];
        if (!led.length) {
            ledRows.push(ceSub('t3', 'This outcome charges nothing.', { key: 'ledempty' }));
        } else {
            for (var li = 0; li < led.length; li++) {
                ledRows.push(ceRow(String(led[li].side || ''), String(led[li].text || ''), null, li));
            }
        }
        // [F-14u] Offered only while there is something to give back. A reversed ledger
        // keeps its rows -- what happened still happened -- and swaps the button for the
        // fact, so the receipt never looks like the charge was never made.
        var anyReversible = false;
        for (var ri = 0; ri < led.length; ri++) { if (led[ri] && led[ri].delta) anyReversible = true; }
        // [F-20] A spend row carries side:'spent' and NO delta, so it is invisible to the
        // line above by construction -- which is the whole reason it was shaped that way.
        // This second pass reads the same rows for the heading only.
        var anySpend = false;
        for (var si = 0; si < led.length; si++) { if (led[si] && String(led[si].side || '') === 'spent') anySpend = true; }
        if (last.stakeReversed) {
            ledRows.push(ceSub('t3', 'Put back \u2014 ' + String(last.stakeReversedCount || 0)
                + ' value(s) restored. The turn it paid for still happened.', { key: 'ledrev' }));
        } else if (anyReversible) {
            ledRows.push(ceBtn('Put this back', 'act:stake:undo', function() {
                return ceReverseStake().then(function(ok: boolean) {
                    try {
                        api.v1.ui.toast(ok ? 'Stake reversed.' : 'Nothing left to reverse.',
                            { type: ok ? 'success' : 'warning', autoClose: 2000 });
                    } catch (e) {}
                });
            }, 'danger'));
            ledRows.push(ceSub('t3', anySpend
                ? 'Reverses what the stake charged. It does not undo the turn, and it does not '
                  + 'give back what you spent \u2014 the roll has already had that.'
                : 'Reverses only these values. It does not undo the turn.',
                { key: 'ledhint' }));
        }
        // [F-20] THE HEADING FOLLOWS WHAT IS ACTUALLY IN THE LIST. A spend rides this ledger
        // (it is a value that moved and the author needs it shown back), but a move with a
        // spend and no wager would otherwise file it under 'Stake' and claim a charge the
        // table never made. Three headings, decided from the rows rather than from the type.
        var ledHead = last.stakeName ? ('Stake \u00b7 ' + String(last.stakeName)) : 'Stake';
        if (!last.stakeName) ledHead = anySpend ? 'Spent' : 'Stake';
        else if (anySpend) ledHead = 'Spent \u00b7 ' + ledHead;
        stakeBlock = ceGroup(ledHead, ceStack(CE_T.s1, ledRows));
    }

    var blocks: any[] = [ceGroup('Roll', ceStack(CE_T.s1, rows))];
    if (stakeBlock) blocks.push(stakeBlock);
    blocks.push(ceSection('Sent to the model', ceStack(CE_T.s2, sent)));
    return ceStack(CE_T.s3, blocks);
}

function ceActionsRoot(): any {
    var st = useStoreValue(ceActionsStore);
    // [EVT-MIRROR] SUBSCRIBED BECAUSE THE GENERATION STRIP LIVES IN IT. _ceSlotOptsFor
    // reads ceUiStore, so without this line the strip would open, run, and repaint nothing
    // -- the panel would render a Generate button that visibly did nothing, which is
    // exactly the failure _ceGuideChip's own note records from the last time a control was
    // wired to a store its surface did not read.
    //   SAFE HERE. The panel's container calls ceStoresInit() before it mounts (see
    //   PANEL-SUBSTRATE), so ceUiStore is non-null by the time this runs; STORE-BEFORE-HOOK
    //   is satisfied for the same reason ceActionsStoreInit above it is.
    useStoreValue(ceUiStore);
    useEffect(function() { cePublishActions(); }, []);

    if (!st || !st.ready) return ceScreen(null, ceEmpty('Loading actions\u2026', null));

    // [PANEL-PICK] INTERCEPTED BEFORE THE COMPOSER, exactly as ceRoot intercepts the shell's
    // own picker slot and legal for the same reason: a picker is a full surface swap rather
    // than an overlay (overlays remain non-constructible here), and this panel has nothing
    // staged that a swap would lose -- the arm is already committed on every field commit.
    // `local: true` is what stops the surface reading ceUiStore.picker instead of this one.
    // AFTER THE HOOKS, NEVER BEFORE. useStoreValue and useEffect above both run
    // unconditionally; an early return that skipped either is the one thing this
    // environment calls fatal.
    var pick: any = st.pick;
    if (pick && pick.kind && CE_PICKER_DEFS[pick.kind]) {
        var pKind = String(pick.kind);
        return h(_cePickerSurface, { local: true, kind: pKind, ctx: pick.ctx || {},
                                     onClose: function() { ceActionsPickClose(pKind); } });
    }

    var armed: any = st.armed;
    var body: any[] = [];

    // [ACT-MODE] THE FORK, AND IT IS THE ONLY ONE. Everything below this line is the full
    // panel exactly as it was; Simple is a different SET-UP rendered by its own function and
    // sharing every verb underneath -- ceActionArm, ceRollNow, ceDiscardQueued and the
    // pending slot are untouched by it.
    //   'none' CAN STILL REACH HERE, for one turn, if the mode is switched to it while the
    //   panel is open: the registration is rebuilt but this component is already mounted.
    //   Saying where the door is beats rendering a panel that is supposed to be gone.
    if (String((st as any).mode || '') === CE_ACT_MODE_NONE) {
        return ceScreen(null, ceStack(CE_T.s2, [
            ceProse('t1', 'The Actions panel is switched off.', { key: 'off:1' }),
            ceProse('t2', 'Turn it back on under Settings \u203a Rolls \u2014 this panel will '
                + 'come back to the list below the editor.', { key: 'off:2' })
        ]));
    }
    if (String((st as any).mode || '') === CE_ACT_MODE_SIMPLE) {
        return ceScreen(null, _ceActionsSimple(st, armed));
    }

    // [F-3] WHO ROLLS, AT THE TOP, because everything below it is charged to that answer --
    // the stakes, the spend preview and the receipt all address the actor.
    // SUPPRESSED ENTIRELY WITH A PARTY OF ONE. A control whose only option is the answer it
    // already shows is a row of chrome, and the common story has no party at all. It appears
    // the moment somebody is flagged Follow and is standing in the room.
    // ceActionsPickOpen, NOT cePickerOpen: this panel mounts outside the shell and has its
    // own picker slot (PANEL-PICK). Using the shell's would open a picker into a slot only
    // ceRoot renders, which is the blank-picker regression by another road.
    var actParty: any[] = (st.party || []);
    if (actParty.length > 1) {
        body.push(ceSettingRow('Rolling', 'Stakes are charged to whoever acts.',
            ceBtn(String(st.actorName || 'the protagonist'), 'act:actor', function() {
                ceActionsPickOpen('actionActor', { party: actParty,
                                                   actorId: String(st.actorId || ''),
                                                   protagId: String(st.protagId || '') });
                return Promise.resolve();
            })));
    }

    // [F-17] AT THE TOP, BECAUSE IT IS A QUESTION. Everything else on this panel is a
    // control the author reaches for; this is the one thing the engine asked THEM, and a
    // question below the fold is a question nobody answers.
    if (st.posTerm) {
        // [F-21] NOT A SECTION OF ITS OWN ANY MORE. It used to sit above the move as a
        // separate question with its own accept/dismiss pair, which asked the author to
        // settle a relationship in one place and then describe the same moment in another.
        // The threshold and the outcome are ONE EVENT, so they are now one block: see the
        // "Your move" section, where the fields render between the outcome sentence and the
        // button that writes both.
        void st.posTerm;
    }

    // [F-19] THE ATTEMPT AND THE OUTCOME, IN THAT ORDER, AT THE TOP. This replaces the
    // "Waiting to be sent" bracket readout, which described a delivery mechanism that no
    // longer carries a roll: what the author now reviews is two sentences of their own
    // story, not a directive in transit.
    var mLines: any[] = [];
    // [H-02] THE SECOND LIST. What the author WRITES and what the dice GAVE BACK are two
    // steps with the roll between them, and they were one section because they had always
    // been one section. Splitting them is what lets the Roll button sit between the set-up
    // it reads and the result it produces.
    var oLines: any[] = [];
    // [ATTEMPT-SCRATCH] onType ADDED, AND IT IS THE FIX FOR "it says the field is blank
    // when it isn't". CLICK IS DELIVERED BEFORE THE BLUR IT CAUSES in this environment, so
    // Roll -- pressed straight from the field with text still uncommitted -- ran before the
    // blur that would have armed it and read the PREVIOUS actionText, which on a first
    // attempt is ''. _ceRollInner then correctly refused a move with no attempt. Pressing
    // again worked, because by then the blur had landed. This is ceField's own FIELD-SCRATCH
    // block describing the Journal "Add" bug; this field simply never grew the scratchpad.
    // THE HARD RULE HOLDS: onType writes a MODULE VARIABLE and nothing else. No store, no
    // arm, no publish -- onInput multi-fires with stale values at word boundaries, which is
    // harmless for a scratchpad and corrupting for state.
    // [I-07] NO LABEL. The section heading directly above it already says "Your attempted
    // action", and a field labelled "What you attempt" under a heading that says the same
    // thing is one idea printed twice -- the same judgement I-06 made about three controls
    // describing one empty option three ways.
    // [I-07] SECOND PERSON, MATCHING THE DIRECTIVE. The placeholder used to read "I put my
    // shoulder…" while everything the engine sends the model is written at the character
    // ("They are blooded and still in the fight"), so the one example the author ever sees
    // taught the register the rest of the system does not use.
    mLines.push(h(ceField, { k: 'act:attempt', label: '',
        value: armed ? String(armed.actionText || '') : '',
        multiline: true, rows: 2,
        placeholder: 'You put your shoulder to the door\u2026',
        onType: function(v: string) { _ceAttemptDraft = String(v || ''); },
        onCommit: function(v: string) { return ceActionArm({ actionText: v }); } }));

    if (st.outcomeSent) {
        oLines.push(ceSub('t3', 'Attempt written and the outcome armed. Press Send to generate from it.', { key: 'msent' }));
    } else if (st.outcomeReady) {
        // [F-19b] NO EDITABLE SENTENCE. The roll landed; its directive is armed and will ride
        // the next Send silently. The author writes their attempt to the document and sends;
        // there is nothing to rewrite because nothing was composed. The receipt below the
        // roll already states what the directive says.
        if (st.posTerm) {
            // [F-21] The relationship shift is still the author's to word, and still commits
            // with the same button -- only the composed sentence beside it is gone.
            var pt: any = st.posTerm;
            var ptShape = (typeof pt.draftShape === 'string') ? pt.draftShape : String(pt.shape || '');
            var ptStand = (typeof pt.draftStanding === 'string') ? pt.draftStanding : String(pt.standing || '');
            oLines.push(ceProse('t1', (pt.ownerName ? (String(pt.ownerName) + '\u2019s') : 'Your')
                + ' Position with ' + String(pt.targetName || 'them') + ' has reached '
                + (pt.warm ? 'settled' : 'breaking point')
                + '. These are the words that will be true afterwards \u2014 edit either, or '
                + 'leave both and only the armed outcome carries it.', { key: 'ptmsg' }));
            oLines.push(h(ceField, { k: 'act:pos:shape', label: 'Shape', value: ptShape,
                multiline: true, rows: 2,
                placeholder: 'What these two are to each other now\u2026',
                onCommit: function(v: string) { return ceTerminusDraft('shape', v); } }));
            oLines.push(h(ceField, { k: 'act:pos:standing', label: 'Standing', value: ptStand,
                multiline: true, rows: 2,
                placeholder: pt.warm
                    ? 'They have earned something like trust here\u2026'
                    : 'Whatever this was, it has worn through\u2026',
                onCommit: function(v: string) { return ceTerminusDraft('standing', v); } }));
            oLines.push(ceRule());
        }
        oLines.push(ceInline(CE_T.s1, [
            ceBtn(st.posTerm ? 'Write the attempt and update' : 'Write the attempt',
                'act:write', function() { return ceWriteMoveToStory(); }, 'primary'),
            ceBtn('Disarm', 'act:discard', function() {
                return ceDiscardQueued().then(function() {
                    try { api.v1.ui.toast('Disarmed.', { type: 'info', autoClose: 1500 }); } catch (e) {}
                });
            }, 'danger')
        ]));
        oLines.push(ceSub('t3', 'The dice are spent. Write your attempt and press Send \u2014 the '
            + 'outcome is delivered to the model as its own turn, not written into the story.',
            { key: 'marmed' }));
    } else {
        // [H-02] ONE SHORT LINE. The paragraph that stood here explained the whole flow at
        // the point of one field; the flow is now explained once, at the top, behind
        // _ceActionsHelp -- see its header for why that is not the same as hiding it.
        mLines.push(ceSub('t3', 'Set it up below, then roll.', { key: 'mhint' }));
    }
    // [F-19b] THE ARMED DIRECTIVE, SHOWN ONLY WHEN NO ROLL OWNS IT. The slot is filled by
    // the roll path (handled by the outcome block above) AND by a stepper terminal crossed
    // outside this panel, which has no roll result to hang under. This renders that second
    // case: an armed directive with no live outcome. Bare, not bracketed -- it is delivered
    // as a trailing user message, and showing a bracket here would misrepresent what is sent.
    if (st.queued && !st.outcomeReady && !st.outcomeSent) {
        oLines.push(ceRule());
        oLines.push(ceProse('t2', 'A limit was reached outside this panel. This is armed and '
            + 'rides your next Send: ' + String(st.queued), { key: 'qtext' }));
    }
    // [H-02] THE PANEL IS FOUR STEPS IN THE ORDER THEY HAPPEN: what you attempt, how it is
    // judged, the roll, what came back. It used to be: the attempt AND the outcome together,
    // then the Roll button, then the five controls that decide what Roll does. The verb came
    // before its own arguments and the result came before the cause.
    //   THE HELP IS FIRST AND SHUT. Every row on this panel used to carry a paragraph, which
    //   is how a control surface becomes documentation with inputs in it. The paragraphs were
    //   not wrong -- they were the only place the flow was written down -- so they are
    //   collected, not deleted, and each row keeps a phrase.
    body.push(_ceActionsHelp(st));

    // [EVENT] 0. THE ENCOUNTER, ABOVE THE FOUR STEPS, because while one is running it is
    // the frame every step below happens inside -- and because the whole reason it lives on
    // this panel rather than behind a menu is that it must be readable BETWEEN rolls without
    // going to look for it.
    //   IT IS A SECTION AND NOT A TAB [EVENT-DOOR]. This panel has no tab strip; four steps in the
    //   order they happen (H-02), and a tab would hide the fight behind the composer at
    //   exactly the moment the author is rolling against it.
    //   TWO STATES, ONE SECTION: no encounter renders the start form, a live one renders the
    //   readout. It is never both, so there is no disclosure to flip.
    var evNow: any = st.ev;
    var evRows: any[] = [];
    if (evNow) {
        // WHAT IT IS, THEN WHERE IT STANDS. `text` is the author's own line and never moves;
        // the band label under it is derived and moves with the track, which is the same
        // pair the Author's Note sends -- so what the author reads here is what the model
        // reads, with no third phrasing in between.
        evRows.push(ceProse('t1', String(evNow.text || '')));
        if (evNow.line) evRows.push(ceProse('t2', String(evNow.line)));
        if (evNow.shapeName) {
            // THE METER CARRIES THE NUMBERS AND THE ROW CARRIES THE WORD. A bar with no
            // figure beside it is a mood; the figure is what makes a wager auditable, which
            // is the receipt's whole argument one section down.
            // [EVT-POLARITY] THE TINT IS THE ONLY THING THAT KNOWS WHICH WAY IS GOOD. Every
            // seeded shape counts up, so a filling bar means progress on nine of ten -- and
            // means being cornered on Infiltration. A bar that reads identically in both cases
            // is a bar that tells an author the opposite of the truth half the time.
            // ZERO IS UNTINTED and passes nothing, which is what a shape with no wager or an
            // author's own table renders as.
            var evPol = Number(evNow.pol) || 0;
            evRows.push(ceBar({ gap: CE_T.s2 }, [
                ceSub('t3', String(evNow.shapeName)),
                (evPol > 0
                    ? ceMeter(Number(evNow.frac) || 0, CE_GAUGE_UP)
                    : (evPol < 0
                        ? ceMeter(Number(evNow.frac) || 0, CE_GAUGE_DOWN)
                        : ceMeter(Number(evNow.frac) || 0))),
                ceSub('t3', String(evNow.value) + '/' + String(evNow.hi))
            ]));
        } else {
            evRows.push(ceSub('t3', 'Its shape has been deleted \u2014 there is no track left to '
                + 'move, but the encounter can still be concluded or cancelled.'));
        }
        // [EVENT] THE EXCEPTION, WHERE THE FIGHT IS. It belongs beside the encounter rather
        // than in the Set-up section with the base wager: this is not a fifth thing to decide
        // about the attempt, it is a thing to decide about the ENCOUNTER, and it is off only
        // for the attempts that are not swings -- looking for a way out, saying something.
        evRows.push(ceSettingRow('This roll advances it', '',
            ceToggle(!(armed && armed.eventOff), 'act:ev:on', function() {
                return ceActionArm({ eventOff: !(armed && armed.eventOff) ? true : false });
            })));
        if (evNow.stakeName) {
            evRows.push(ceSub('t3', (armed && armed.eventOff)
                ? ('Held \u2014 rolls will not move the encounter until this is back on.')
                : ('Its wager: ' + String(evNow.stakeName) + ', charged on top of whatever the '
                   + 'attempt itself risks.')));
        } else {
            evRows.push(ceSub('t3', 'This shape has no wager, so nothing moves the track. Give '
                + 'it one under Settings \u203a States \u203a ' + String(evNow.shapeName || 'the shape') + '.'));
        }
        evRows.push(ceBar({ gap: CE_T.s2 }, [
            ceBtn('Conclude', 'act:ev:done', function() { return ceActionsEvEnd('event.conclude'); }),
            ceBtn('Cancel encounter', 'act:ev:cancel', function() { return ceActionsEvEnd('event.cancel'); }, 'danger')
        ]));
        if (evNow.loose) {
            evRows.push(ceSub('t3', 'Not attached to a thread. Concluding files it in the '
                + 'encounter log; the oldest drop off after ' + String(CE_LOOSE_ARCHIVE_MAX) + '.'));
        }
    } else if ((st.evShapes || []).length) {
        // THE START FORM IS TWO CONTROLS AND A BUTTON, and that ceiling is the feature: the
        // shape already carries the span, the bands and every directive, so the only thing
        // left to ask is what this one IS. Anything more here is the setup tax that made the
        // old temporary-NPC route not worth taking.
        evRows.push(ceSettingRow('Shape', 'How it is graded \u00b7 authored in Settings \u203a States',
            ceSelect({ k: 'act:ev:shape', value: String(st.evShape || ''),
                       options: [{ id: '', label: 'None' }].concat(st.evShapes || []),
                       onCommit: function(v: string) { _ceActionsEvDraft({ evShape: v }); return Promise.resolve(); } })));
        evRows.push(h(ceField, {
            k: 'act:ev:draft', label: 'What is happening',
            value: String(st.evDraft || ''),
            placeholder: 'Three raiders block the bridge\u2026',
            hint: 'One line. It leads the Author\u2019s Note for as long as this runs.',
            onCommit: function(v: string) { _ceActionsEvDraft({ evDraft: v }); return Promise.resolve(); }
        }));
        // [EVT-MIRROR] THE SAME STRIP THE MILESTONE SLOT RENDERS, on the fourth scope, and
        // this is the half of the mirror that was missing: Threads could ask for a
        // milestone and this panel could not ask for the line an encounter starts from,
        // though it is the surface where an encounter is actually begun.
        //   GATED ON THE SHAPE, AND THE GATE IS THE DESIGN. The shape's band ladder is the
        //   entire direction this generation has, so a Generate button offered before one
        //   is chosen is a button with nothing to go on. It also makes the shape do double
        //   duty -- pick it and the generator knows what kind of thing to invent.
        //   KEYED ON THE SHAPE ID, so switching shapes closes the previous strip rather
        //   than handing an Infiltration's candidates to a Courtship.
        if (String(st.evShape || '')) {
            evRows.push(ceWrap({ key: 'act_ev_gen' }, [
                _ceGenBtn(null, String(st.evShape || ''), CE_EV_FIELDKEY, 'Encounter',
                          CE_EV_INSTRUCTIONS, 50,
                          'Reads the shape you chose \u2014 its name and how it reads at every step \u2014 '
                          + 'along with where you are, who is in the scene, the story so far, and the '
                          + 'active thread if there is one. Each candidate puts a different sort of '
                          + 'opposition in the way.',
                          'event')
            ]));
        }
        evRows.push(ceBtn('Begin encounter', 'act:ev:begin', function() { return ceActionsEvBegin(); }, 'primary'));
    } else {
        // NAMED, NOT BLANK. An empty section with no explanation is the state that reads as
        // a bug; saying where shapes come from is the difference between "broken" and "not
        // set up yet".
        evRows.push(ceSub('t3', 'No encounter shapes yet. Author one in Settings \u203a States '
            + 'with scope \u201cEncounter\u201d \u2014 its span is how long an encounter lasts and its '
            + 'bands are how it reads at each step.'));
    }
    body.push(ceSection(evNow ? 'Encounter' : 'Start an encounter', ceStack(CE_T.s2, evRows)));

    // 1. THE ATTEMPT. On its own now: the outcome moved below the roll, where it happens.
    body.push(ceSection('Your attempted action', ceStack(CE_T.s2, mLines)));

    // 2. THE SET-UP. REQUIRED IS MARKED, because "why did nothing roll" was answerable only by
    // reading the toast.
    // [I-04] THE RESOLUTION ROW IS DELETED AND NOTHING REPLACES IT HERE. Per author it is not a
    // per-turn decision -- which dice judge an attempt is a fact about the world, chosen once in
    // Settings > Rolls, and asking again on every action made the required field the one an
    // author had to re-answer with the same value forever. The summary line below still NAMES
    // the table being rolled, so the panel stops asking without becoming silent about it.
    // THE ATTEMPT IS NOW THE ONLY REQUIRED THING, which is why the Approach hint no longer has
    // a "Required" sibling to be read against.
    // [I-06] EVERY EMPTY OPTION IN THIS PANEL IS 'None', and the mechanism it implies moves
    // to the row's hint -- the same call I-03 made when 'Spending' became 'Bonus'. Three
    // controls reading 'No approach (flat roll)', 'No target' and 'Nothing' described one
    // idea three ways, and the longest of them was also setting the width of the select it
    // sat in (see ROW-STACK for what that cost the row beside it).
    var apprOpts: any[] = [{ id: '', label: 'None' }].concat(st.approaches || []);
    var setRows: any[] = [];
    // [I-07] THE HINT IS GONE AND THAT IS WHAT MOVES THE CONTROL ONTO THE ROW. ceSettingRow
    // stacks only when there IS a hint (`stack = !!hint && _ceRowStacks`), so these two rows
    // needed no layout change -- the paragraph was the thing pushing the select onto its own
    // line. The label keeps its full width either way: the text block is `flex: 1 1 auto`
    // and the control is sized by its own content, so a select too wide to sit beside the
    // label wraps rather than crushing the word next to it.
    //   WHAT THE CONTROLS DO IS STILL WRITTEN DOWN, once, behind _ceActionsHelp -- which is
    //   H-02's whole argument for collecting these paragraphs rather than deleting them.
    setRows.push(ceSettingRow('Approach', '',
        ceSelect({ k: 'act:appr', value: armed ? String(armed.approachDefId || '') : '',
                   options: apprOpts,
                   onCommit: function(v: string) { return ceActionArm({ approachDefId: v }); } })));
    // [F-31] THE FACTIONS SIT BELOW THE CAST IN ONE SELECT, labelled so two entries can never
    // read as the same thing -- the same call F-27 made when factions joined the journal's
    // scope picker. ONE CONTROL, because "who or what is this aimed at" is one question, and a
    // second picker beside it would make the author answer it twice to answer it once.
    var tgtFacRows: any[] = [];
    var tgtFacSrc: any[] = (st as any).factions || [];
    for (var tfi = 0; tfi < tgtFacSrc.length; tfi++) {
        tgtFacRows.push({ id: String(tgtFacSrc[tfi].id),
                          label: String(tgtFacSrc[tfi].label) + ' \u00b7 faction' });
    }
    var tgtOpts: any[] = [{ id: '', label: 'None' }].concat(st.cast || []).concat(tgtFacRows);
    setRows.push(ceSettingRow('Target', '',
        ceSelect({ k: 'act:tgt', value: (armed && armed.target) ? String(armed.target.id) : '',
                   options: tgtOpts,
                   onCommit: function(v: string) {
                       // THE KIND COMES FROM WHICH LIST MATCHED, never from the label. The two
                       // lists are disjoint by construction, so "is it in the cast" is the
                       // whole test -- the same rule ceActionMoveApply states for places.
                       var hit: any = null;
                       var list: any[] = st.cast || [];
                       for (var i = 0; i < list.length; i++) { if (String(list[i].id) === String(v)) hit = list[i]; }
                       if (hit) {
                           return ceActionArm({ target: { kind: 'char', id: String(hit.id), name: String(hit.label) } });
                       }
                       var fl: any[] = (st as any).factions || [];
                       for (var fi = 0; fi < fl.length; fi++) {
                           if (String(fl[fi].id) !== String(v)) continue;
                           return ceActionArm({ target: { kind: 'faction', id: String(fl[fi].id),
                                                          name: String(fl[fi].label) } });
                       }
                       return ceActionArm({ target: null });
                   } })));

    // [F-14] RISKING. AN OVERRIDE, NOT A FIELD TO FILL IN, which is the point of the whole
    // stake feature: the approach already implies the usual wager, so the default option is
    // first, is preselected on every fresh arm, and NAMES what it resolves to -- an author
    // who never touches this control still gets consequences, and one who does can see what
    // they are departing from. The 'None' entry is a real third choice -- charge nothing --
    // and is stored as '', not as the absence of a value.
    var stakeOpts: any[] = [
        { id: CE_STAKE_AUTO, label: st.autoStakeName ? ('Default \u2014 ' + st.autoStakeName) : 'Default \u2014 none' },
        { id: '', label: 'None' }
    ].concat(st.stakes || []);
    // [I-01] THE ROW AND ITS BREAKDOWN ARE ONE BLOCK NOW, at CE_T.s1 rather than the
    // section's own CE_T.s2 -- tight enough to read as one control with a detail underneath
    // it, not as two peer rows in the Set-up list. Per author: "move 'what this costs' under
    // stakes." It sat directly below Stakes in list order already; the gap was that nothing
    // said it belonged to Stakes rather than sitting between Stakes and Bonus by chance.
    setRows.push(ceStack(CE_T.s1, [
        ceSettingRow('Stakes', 'Optional \u00b7 what the outcome charges',
            ceSelect({ k: 'act:stake', value: armed ? String(armed.stakeId) : CE_STAKE_AUTO,
                       options: stakeOpts,
                       onCommit: function(v: string) { return ceActionArm({ stakeId: v }); } })),
        _ceActionsStakeBreak(st)
    ]));

    // [F-20] BONUS (labelled Spending through 3.1.11). This row replaces the Situational
    // stepper, which was a free -20..+20 charging nothing. The control is a ceSettingRow +
    // ceSelect and NOT the stepper it replaces, because resource and amount are one question
    // with a short closed answer -- see cePublishActions for why two controls would be two
    // invalid states.
    // IT IS ABSENT, NOT EMPTY, IN A STORY WITH NOTHING SPENDABLE. A select whose only
    // option is "None" is a control that can only disappoint, the same judgement the preset
    // rows already make about an empty list.
    // [I-07] A STEPPER, NOT A SELECT, AND THE PAIR STILL MOVES TOGETHER. F-20 built this as
    // one control because resource-and-amount is one question with two invalid halves
    // ("spend 2 of nothing", "spend 0 Luck") -- that reasoning holds and is preserved here:
    // the resource select and the amount stepper both commit through ceActionArm with BOTH
    // fields, so the arm never sees a half-answer. What changed is only that the amount was
    // a closed list of every legal number, which for a 0-5 resource is a dropdown whose
    // entire content is "1, 2, 3, 4, 5".
    //   THE BALANCE IS THE HELPER TEXT. Not a paragraph about what spending does -- that is
    //   in the help block with everything else -- but the one number the author needs at the
    //   moment they press +: how many they have. Read for the ACTOR (see cePublishActions),
    //   so a party member's roll never quotes the protagonist's purse.
    //   ABSENT, NOT EMPTY, with nothing spendable -- F-20's judgement, unchanged.
    var spendDefs: any[] = (st.spendDefs || []);
    if (spendDefs.length) {
        var spDefCur = String((armed && armed.spendDefId) || '');
        var spAmtCur = Math.round(Number((armed && armed.spendAmount) || 0));
        // The chosen resource, or the first one, so the stepper always has something to
        // count -- an author who presses + before touching the select means the obvious.
        var spPick: any = null;
        for (var spI = 0; spI < spendDefs.length; spI++) {
            if (String(spendDefs[spI].id) === spDefCur) { spPick = spendDefs[spI]; break; }
        }
        if (!spPick) spPick = spendDefs[0];
        var spCap = Math.max(0, Math.min(CE_SPEND_MAX, Math.round(Number(spPick.have) || 0)));
        if (spendDefs.length > 1) {
            setRows.push(ceSettingRow('Bonus from', '',
                ceSelect({ k: 'act:spend:def', value: String(spPick.id),
                           options: spendDefs.map(function(d: any) {
                               return { id: String(d.id), label: String(d.name) };
                           }),
                           onCommit: function(v: string) {
                               // CHANGING THE RESOURCE ZEROES THE AMOUNT rather than carrying
                               // it across: 3 Luck is not 3 Stamina, and a silent re-aim is
                               // how an author spends something they never chose to.
                               return ceActionArm({ spendDefId: String(v || ''), spendAmount: 0 });
                           } })));
        }
        setRows.push(ceStepperRow({
            k: 'act:spend', label: 'Bonus',
            value: spAmtCur, min: 0, max: spCap,
            sub: ceSub('t3', String(spPick.name) + ': you hold ' + String(spPick.have)
                + (spAmtCur ? ('  \u00b7  spending ' + spAmtCur + ' \u2192 +' + spAmtCur + ' on the roll')
                            : '  \u00b7  one spent buys +1')),
            onNudge: function(d: number) {
                var next = Math.max(0, Math.min(spCap, spAmtCur + (Number(d) || 0)));
                return ceActionArm({ spendDefId: next ? String(spPick.id) : '', spendAmount: next });
            },
            onCommit: function(v: number) {
                var next = Math.max(0, Math.min(spCap, Math.round(Number(v) || 0)));
                return ceActionArm({ spendDefId: next ? String(spPick.id) : '', spendAmount: next });
            }
        }));
    }
    body.push(ceSection('Set-up', ceStack(CE_T.s2, setRows)));

    // 3. THE ROLL, UNDER THE THINGS IT READS. Deliberately separate from Send, per author:
    // an outcome you can see before you commit to a turn is one you can decide not to use,
    // and testing a table should not require advancing the story. It is also the reason a
    // terminal will be able to ASK the author something -- a press is a place a question can
    // be asked, and the middle of a generation is not.
    //   THE SUMMARY LINE IS THE WHOLE SET-UP IN ONE SENTENCE, which is what makes the five
    //   controls above safe to leave unexplained: the author reads back what they built.
    body.push(ceStack(CE_T.s2, [
        ceProse('t1', String(st.actorName || 'The protagonist') + ' \u2014 '
            + _ceActionLabelOf(st.resolutions, armed ? armed.resolutionId : '')
            + (armed && armed.approachDefId ? (' on ' + _ceActionLabelOf(st.approaches, armed.approachDefId)) : '')
            + (armed && armed.target && armed.target.name ? (' against ' + armed.target.name) : '')
            + (st.stakeName ? ('. On the line: ' + st.stakeName) : '. Nothing on the line')
            + '.', { key: 'setline' }),
        ceBtn('Roll it', 'act:roll', function() {
            return ceRollNow().then(function(ok: boolean) {
                if (!ok) {
                    // [F-19] The missing-attempt case toasts for itself inside _ceRollInner,
                    // where it can say the useful thing. This is the fallback for every
                    // other false, and it must not claim to know which one happened.
                    try { api.v1.ui.toast('Nothing rolled \u2014 check the action is complete.',
                        { type: 'warning', autoClose: 2500 }); } catch (e) {}
                }
            });
        }, 'primary')
    ]));

    // 4. WHAT CAME BACK. Rendered only when there IS something, and below the roll rather
    // than beside the attempt: an outcome that appears three screens above the button that
    // produced it is an outcome the author scrolls to find.
    // [I-07] THE RECEIPT LIVES HERE NOW, not at the foot of the panel. It sat below Saved
    // actions because it was built before the four-step ordering existed, which put the
    // roll's own arithmetic four sections away from the outcome it explains -- the author
    // read "How it turned out", then scrolled past two unrelated tools to find out why.
    // The dice, the wager and what was sent to the model are all one answer to one question,
    // so they are one section.
    if (st.last) oLines.push(_ceActionReceipt(st.last));
    if (oLines.length) body.push(ceSection('How it turned out', ceStack(CE_T.s2, oLines)));

    // [H-02] THIS SECTION KEEPS THE WORD "move" AND THE COMPOSER GIVES IT UP. Author:
    // the panel called the thing being composed a "move" while a button underneath said
    // "Move something" and did something unrelated. Only one of the two is literally about
    // moving, so it keeps the word; everything the composer builds is an ACTION.
    // [F-15e] MOVE. BELOW THE ACTION COMPOSER AND ABOVE THE RECEIPT, which is where it
    // belongs on both counts: it is not part of the attempt (it rolls nothing and charges
    // nothing), and it is not a record of one either. One row rather than a button, because
    // the row IS the first picker -- there is no state between pressing it and choosing.
    body.push(ceRule());
    body.push(ceSection('Move something', ceStack(CE_T.s2, [
        cePickerRow({ kind: 'moveWhat', value: '', open: ceActionsPickOpen,
                      placeholder: 'Choose what to move\u2026',
                      hint: 'Puts a character in a place, or an item in a place or a pair of '
                          + 'hands. Nothing is rolled, nothing is charged and nothing is written '
                          + 'to the story \u2014 it just moves.' })
    ])));

    // [F-15d] PRESETS. The load row only renders when there is something to load, and the
    // forget row only when there is something to forget: a picker over an empty list is a
    // control that can only disappoint, and its empty state would be the first thing a new
    // author saw here.
    var pRows: any[] = [];
    if ((st.presets || []).length) {
        pRows.push(cePickerRow({ kind: 'actionPreset', value: '', open: ceActionsPickOpen,
                                 placeholder: 'Load a saved action\u2026' }));
    }
    // value:'' IS PERMANENT AND IS NOT A BUG -- same rule ceFilterField states at length. A
    // field whose `value` prop never changes never sets wantRef, so a repaint cannot reach
    // into the element being typed in. The draft is a MODULE VAR because the Save button
    // reads it and a click is delivered before the blur it causes (CLICK-BEFORE-BLUR), so a
    // commit-on-blur value would be one keystroke stale on every first press.
    pRows.push(h(ceField, { k: 'act:preset:name', label: 'Save this action as',
        value: '', multiline: false,
        placeholder: 'Pick the lock\u2026',
        onType: function(v: string) { _ceActionPresetDraft = String(v || ''); },
        onCommit: function(v: string) { _ceActionPresetDraft = String(v || ''); return Promise.resolve(); } }));
    pRows.push(ceInline(CE_T.s1, [
        ceBtn('Save', 'act:preset:save', function() {
            return ceActionPresetSave(_ceActionPresetDraft).then(function(ok: boolean) {
                if (ok) _ceActionPresetDraft = '';
            });
        }),
        (st.presets || []).length
            ? ceBtn('Forget one\u2026', 'act:preset:forget', function() {
                ceActionsPickOpen('actionPresetForget', {});
                return Promise.resolve();
              }, 'danger')
            : null
    ]));
    pRows.push(ceSub('t3', 'A preset keeps the approach, resolution, stake and '
        + 'your attempt \u2014 not the target and not a spend, which belong to the turn. Saving under a name '
        + 'you have already used replaces it.', { key: 'pshint' }));
    body.push(ceRule());
    body.push(ceSection('Saved actions', ceStack(CE_T.s2, pRows)));

    body.push(ceRule());
    // [I-07] The receipt moved up into 'How it turned out'. Nothing replaces it here: with
    // no roll yet the outcome section does not render at all, and an empty-state card at the
    // foot of the panel would be a second answer to a question the top of the panel already
    // answers ('Set it up below, then roll').

    return ceScreen(null, body);
}


// [ACT-MODE] THE SIMPLE PANEL. Four things: what the dice are, a dial, what the dial buys,
// and the button. Everything the full panel asks is either absent (approach, target, wager,
// presets, encounter) or unnecessary (the attempt field -- see ATTEMPT-OPTIONAL).
//   IT ARMS AND DISARMS THROUGH THE SAME PATH. ceRollNow, ceCommitResolution and the pending
//   slot are untouched; the toolbar's Disarm button appears for a simple roll exactly as it
//   does for a full one. This is a different SET-UP, never a second delivery mechanism, which
//   is the line every earlier attempt at a second path crossed (grep F-15d).
function _ceActionsSimple(st: any, armed: any): any[] {
    var body: any[] = [];
    var odds: any[] = (st.odds || []);
    var fb = Math.round(Number(st.freeBonus) || 0);

    // WHAT IS BEING ROLLED, IN WORDS, because the resolution control does not exist here
    // either (I-04 removed it from the full panel too) and a table nobody names is a table
    // nobody can tell has changed.
    body.push(ceSection('The roll', ceStack(CE_T.s2, [
        ceProse('t1', String(st.resolutionName || 'No resolution')
            + (st.diceLine ? (' \u2014 ' + String(st.diceLine)) : ''), { key: 'sm:res' }),
        // [F-20 REVERSED, DELIBERATELY, AND ONLY HERE] F-20 deleted a free -20..+20 on the
        // argument that it was "a range three times the dice, costing nothing, on the one
        // surface whose whole claim is that a roll is auditable". That argument is answered
        // rather than ignored: the claim this mode makes is LEGIBILITY, not auditability, and
        // the odds strip below turns the dial into a stated difficulty rather than an opaque
        // thumb on the scale. The range is also a third of what it was -- on a 2d6 table
        // whose bands sit three apart, +-10 already spans certain-miss to certain-hit, so
        // anything wider only adds numbers that all mean "yes".
        // THE PURCHASED BONUS IS UNTOUCHED IN FULL MODE. Two modes, two answers, and neither
        // is a migration of the other.
        ceStepperRow({
            k: 'act:free', label: 'Bonus',
            value: fb, min: -CE_FREE_BONUS_MAX, max: CE_FREE_BONUS_MAX,
            sub: ceSub('t3', fb === 0
                ? 'Free \u2014 set how hard this is, and watch what it does to the odds.'
                : ((fb > 0 ? '+' : '') + fb + ' on the roll. Costs nothing.')),
            onNudge: function(d: number) {
                return ceActionArm({ freeBonus: fb + (Number(d) || 0) });
            },
            onCommit: function(v: number) {
                return ceActionArm({ freeBonus: Math.round(Number(v) || 0) });
            }
        }),
        // [ACT-ODDS] THE DIAL'S RECEIPT, AND IT IS WHY THE DIAL IS ALLOWED TO BE FREE.
        // ceMeter rather than a bare percentage: a bounded number has a shape (I-05), and a
        // row of bars is read at a glance where a row of figures is read one at a time.
        // THE FIGURE SITS BESIDE THE BAR for the reason the encounter readout gives: a bar
        // with no number next to it is a mood.
        odds.length
            ? ceStack(CE_T.s1, odds.map(function(o: any, oi: number) {
                return ceBar({ key: 'sm:odd:' + oi, gap: CE_T.s2 }, [
                    ceSub('t3', String(o.label)),
                    ceMeter(Number(o.p) || 0),
                    ceSub('t3', Math.round((Number(o.p) || 0) * 100) + '%')
                ]);
              }))
            : ceSub('t3', String(st.oddsNote || 'No odds to show for this table.'), { key: 'sm:noodds' })
    ])));

    if (st.simpleStakeName) {
        body.push(ceSub('t3', 'On the line: ' + String(st.simpleStakeName)
            + ' \u00b7 set under Settings \u203a Rolls.', { key: 'sm:stake' }));
    }

    body.push(ceBtn('Roll it', 'act:roll', function() {
        return ceRollNow().then(function(ok: boolean) {
            if (!ok) {
                try { api.v1.ui.toast('Nothing rolled \u2014 check a resolution exists under Settings \u203a Rolls.',
                    { type: 'warning', autoClose: 3000 }); } catch (e) {}
            }
        });
    }, 'primary'));

    // THE OUTCOME, AND IT IS THE SAME SLOT THE FULL PANEL SHOWS. A simple roll is armed and
    // disarmed identically, so the control that says so is identical too.
    var oLines: any[] = [];
    if (st.outcomeReady || st.queued) {
        oLines.push(ceProse('t1', 'The dice are spent. The outcome rides your next Send.', { key: 'sm:armed' }));
        oLines.push(ceBtn('Disarm', 'act:discard', function() {
            return ceDiscardQueued().then(function() {
                try { api.v1.ui.toast('Disarmed.', { type: 'info', autoClose: 1500 }); } catch (e) {}
            });
        }, 'danger'));
    }
    if (st.last) oLines.push(_ceActionReceipt(st.last));
    if (oLines.length) body.push(ceSection('How it turned out', ceStack(CE_T.s2, oLines)));

    // [F-15e] MOVE SURVIVES IN THIS MODE, per author: it rolls nothing, charges nothing and
    // writes nothing, so it is a utility rather than part of the attempt and none of the
    // reasons the set-up controls are gone apply to it.
    body.push(ceRule());
    body.push(ceSection('Move something', ceStack(CE_T.s2, [
        cePickerRow({ kind: 'moveWhat', value: '', open: ceActionsPickOpen,
                      placeholder: 'Choose what to move\u2026',
                      hint: 'Puts a character in a place, or an item in a place or a pair of '
                          + 'hands. Nothing is rolled and nothing is written to the story.' })
    ])));

    // [ACT-MODE-DOORS] THE PICKER, AT THE FOOT, AND ITS TWIN IS IN SETTINGS > ROLLS.
    // TWO DOORS ONTO ONE FIELD IS A DELIBERATE EXCEPTION TO SPEC-CTX, whose rule is that a
    // second door is how two surfaces come to disagree. The reason it is safe here is
    // structural rather than a promise: both write the SAME field through the SAME verb, so
    // there is no second state to disagree with -- and the reason it is NECESSARY is that
    // 'none' unregisters this panel, so the panel cannot be its own way back.
    body.push(ceRule());
    body.push(ceSettingRow('Actions panel', 'Also in Settings \u203a Rolls',
        ceSelect({ k: 'act:mode', value: String(st.mode || CE_ACT_MODE_SIMPLE),
                   options: CE_ACT_MODES,
                   onCommit: function(v: string) { return ceActionsModeSet(v); } })));
    return body;
}

// [ACT-MODE-DOORS] THE ONE WRITER, pressed by both doors. It re-registers the toolbar because
// 'none' removes this panel from it and nothing else on a settings commit would.
async function ceActionsModeSet(v: string): Promise<void> {
    try {
        await mutConfig(function(c: any) { c.actionsMode = String(v || CE_ACT_MODE_SIMPLE); });
        await ceSyncToolbar();
        await cePublishActions();
        await cePublishSettings();
        if (String(v) === CE_ACT_MODE_NONE) {
            // SAY IT, because the surface the author is looking at is about to stop existing
            // and a control that removes its own screen with no word reads as a crash.
            try { api.v1.ui.toast('Actions panel off. Turn it back on under Settings \u203a Rolls.',
                { type: 'info', autoClose: 5000 }); } catch (e) {}
        }
    } catch (e) { api.v1.error('[AE:actions] mode set:', e); }
}

// [F-15d] The preset name draft. See the field's own call site for why this is a module var
// and not component state.
var _ceActionPresetDraft: string = '';

// Label for an id out of one of the option lists, falling back to the id so a def deleted
// out from under an armed move is still legible rather than blank.
// [H-02] THE FLOW, WRITTEN DOWN ONCE. Author: "clean out the explanatory text so the menu
// is more attractive and place a cohesive explanation behind a dropdown helper."
//   COLLECTED, NOT DELETED. The paragraphs that used to hang off Approach, Target, Stakes
// and Bonus were the only place this system was explained; deleting them would have made
// the panel prettier and less usable. They are rewritten as one account of the whole flow,
// which is what none of them could be individually -- a per-row paragraph can say what a row
// does and cannot say why the row exists.
//   SHUT BY DEFAULT, on STYLE2-E's rule: text worth having, not worth spending the first
// screen on.
//   IT ANSWERS "WHAT IS ACTUALLY REQUIRED", which was previously answerable only by pressing
// Roll and reading the toast that came back.
function _ceActionsHelp(st: any): any {
    if (!st.showHelp) {
        return ceInline({ key: 'act_help', gap: CE_T.s2 }, [
            ceBtn('How an action works', 'act:help', function() {
                _ceActionsFlip('showHelp'); return Promise.resolve();
            })
        ]);
    }
    return ceGroup('How an action works', ceStack(CE_T.s2, [
        ceProse('t2', 'You write what your character tries. The engine rolls it, then writes '
            + 'one sentence saying how it turned out. Both go into the story together as your '
            + 'turn \u2014 nothing generates until you press Send yourself.'),
        // [I-04] AN ACTION IS A THING THAT CAN FAIL, and saying so first is what makes the rest
        // of this panel legible. Per author: there is no reason to take an action whose outcome
        // is certain, which is why there is no \u201cno roll\u201d option to explain and no
        // resolution to choose per turn.
        ceProse('t3', 'Write an action when the outcome is in doubt. If it simply happens \u2014 '
            + 'resting, paying, walking somewhere \u2014 write it in the story yourself, or use '
            + '\u201cMove something\u201d below for a place or a possession.'),
        ceSub('t2', 'Required'),
        ceProse('t3', 'Just the attempt. Everything else is optional and a roll works without '
            + 'any of it.'),
        ceSub('t2', 'What judges it'),
        ceProse('t3', 'One table judges every action in this world \u2014 which dice, and what '
            + 'the totals mean. The seeded one is 2d6 with three bands (Miss, Partial, Strong), '
            + 'and each band carries the instruction the outcome sentence is written from. '
            + 'Change it, or write another and pick which is the default, in Settings \u203a '
            + 'Rolls. The line above the button always names the one you are about to roll.'),
        ceSub('t2', 'Approach'),
        ceProse('t3', 'How you are going about it \u2014 Force, Focus, Finesse, Flair, or '
            + 'anything else this world marks as feeding rolls. Your rating in it, plus any '
            + 'gear you are wearing, is added to the dice. Leave it empty for a flat roll.'),
        ceSub('t2', 'Target'),
        ceProse('t3', 'Who you are aiming at, from the people in the scene. A target is what '
            + 'lets a wager charge somebody other than you \u2014 without one, only your own '
            + 'side of a wager can be paid. If a target is already at a limit, that limit '
            + 'replaces the roll.'),
        ceSub('t2', 'Stakes'),
        ceProse('t3', 'What the outcome costs, per band \u2014 so a Miss can take Stamina and '
            + 'a Partial can take less. Each approach has a standing wager, which is what '
            + '\u201cDefault\u201d means; you only touch this to depart from it. An action '
            + 'that changes no resource wants \u201cNothing\u201d, and that is an ordinary '
            + 'answer, not a missing one. The seeded wagers are named for what they charge '
            + '\u2014 Health, Stamina, Position, Currency \u2014 and \u201cWhat this costs\u201d '
            + 'under the control spells out every band once one is chosen.'),
        ceSub('t2', 'Bonus'),
        ceProse('t3', 'Buys a bonus outright, one point of a resource for one on the roll. '
            + 'Charged when you roll and not returned by \u201cPut this back\u201d \u2014 the '
            + 'roll has already had it.'),
        ceBtn('Close', 'act:help', function() {
            _ceActionsFlip('showHelp'); return Promise.resolve();
        })
    ]));
}

// [H-02] WHAT THE CURRENT WAGER ACTUALLY CHARGES. Author: "Stakes could have a dropdown that
// shows a discreet breakdown of the current stake." A stake names a StakeDef and nothing on
// the panel said what one does, so the seeded wagers were three words with no visible effect
// until after a roll had already charged them.
//   THE ROWS ARE THE STAKE. StakeRow is index-aligned with the bound resolution's bands, so
//   writing that alignment out IS the explanation -- there is nothing to summarise or
//   paraphrase, only to display.
//   ABSENT WHEN THERE IS NOTHING TO SHOW, rather than an empty disclosure: "Nothing" is
//   already legible in the control above it.
function _ceActionsStakeBreak(st: any): any {
    var rows: any[] = st.stakeBreak || [];
    if (!rows.length) return null;
    if (!st.showStake) {
        return ceInline({ key: 'act_stkbrk', gap: CE_T.s2 }, [
            ceBtn('What this costs', 'act:stkbrk', function() {
                _ceActionsFlip('showStake'); return Promise.resolve();
            })
        ]);
    }
    var kids: any[] = [];
    if (String(st.stakeNote || '')) kids.push(ceSub('t2', String(st.stakeNote)));
    for (var i = 0; i < rows.length; i++) {
        (function(r: any, idx: number) {
            kids.push(ceRow(String(r.band),
                'You: ' + String(r.actor) + '  \u00b7  Them: ' + String(r.target), null, idx));
        })(rows[i], i);
    }
    kids.push(ceSub('t3', 'Charged when you roll. \u201cThem\u201d needs a target set above; '
        + 'without one that side is skipped and the receipt says so.'));
    kids.push(ceBtn('Close', 'act:stkbrk', function() {
        _ceActionsFlip('showStake'); return Promise.resolve();
    }));
    return ceGroup('What this costs', ceStack(CE_T.s2, kids));
}

function _ceActionLabelOf(list: any[], id: string): string {
    var want = String(id || '');
    for (var i = 0; i < (list || []).length; i++) {
        if (String(list[i].id) === want) return String(list[i].label || want);
    }
    return want || 'nothing';
}


// ============================================================================
// SECTION 39 — WORLD PIPELINE: CHARTER + PROMPT SUBSTRATE  [CHARTER] [P-SUBSTRATE]
//
// THE PIPELINE'S INPUT LIVES HERE. Records are its OUTPUT and live where they already
// live -- entities, characters, the lorebook. The line between the two is the whole
// design: a charter reaches a prompt as an INSTRUCTION, a record reaches one only as a
// DIGEST, and nothing is both.
//
// [CHARTER-CANON-NONE] TWO PROSE TIERS, NOT THREE. An earlier plan had style/canon/play
// with a compression call each. canon IS the world profile's answers projected into NAI
// Memory, so writing it here as well would be a second writer of one artifact -- the
// failure this file spends most of its rules preventing. style and play are compressed
// from the premise chat; canon is not compressed at all.
//
// [P-SUBSTRATE] THE PROMPT BLOCKS ARE ORDERED BY VOLATILITY, NEVER BY TOPIC, and that
// ordering is an economic decision rather than an aesthetic one. Prefix caching is real on
// this runtime (measured, see CACHE-PROBE) and it inverts the usual economy: the head is
// billed once per session and the ask is billed on every call, so a 400-token doctrine
// across a 30-record batch costs 400 tokens ONCE while a 40-token ask costs 1,200. The
// head may therefore be thorough. The ASK is what must be ruthless, and no rule ever moves
// into it because "it matters most here."
//
// [P-NO-SETTING] NO BLOCK BELOW CONTAINS A NOUN THAT BELONGS TO A SETTING. The kind noun
// arrives in the ask. That is what lets ONE naming block serve places, people, groups and
// objects, and it is the whole of "works at any scale or genre" -- not prompt craft, a
// structural property that a word list can audit.
// ============================================================================

// [CHARTER] The record. Every field is sparse: absent means not written yet, and a surface
// renders the gap rather than a placeholder.
//   style    stamped onto EVERY generation. Never reaches Memory.
//   play     the Author's Note. Generator-blind.
//   ladder   the location scale rungs, largest first. Grown lazily -- one rung exists
//            until a location is stepped into, per the pipeline spec.
//   rung.scope maps onto an EXISTING LOCATION_FACETS scope value so the facet filter is
//            untouched and no record needs migrating.
interface CharterRung {
    id: string;
    label: string;
    scope: string;      // 'any' | 'region' | 'settlement' | 'structure' | 'interior'
}
interface CharterState {
    style: string;
    play: string;
    ladder: CharterRung[];
    opening?: string;          // [OPEN-DRAFT] the staged opening, before it is placed
    openingBudget?: number;    // [OPEN-BUDGET] the author's length, 0 for the default
    updatedAt: number;
}

function ceCharterEmpty(): CharterState {
    return { style: '', play: '', ladder: [], opening: '', updatedAt: 0 };
}

async function loadCharter(): Promise<CharterState> {
    try {
        var raw = await api.v1.storyStorage.getOrDefault(STORAGE_CHARTER, '') as string;
        if (!raw) return ceCharterEmpty();
        var o: any = JSON.parse(raw);
        if (!o || typeof o !== 'object') return ceCharterEmpty();
        return {
            style: String(o.style || ''),
            play: String(o.play || ''),
            ladder: Array.isArray(o.ladder) ? o.ladder : [],
            ladders: (o.ladders && typeof o.ladders === 'object') ? o.ladders : {},
            shapes: (o.shapes && typeof o.shapes === 'object') ? o.shapes : {},
            // [OPEN-DRAFT] The opening lives on the charter because it is the one artifact
            // written FROM the charter -- and because a charter that has an opening in it is
            // a story that has been started, which is a fact about the story and belongs in
            // storyStorage with the rest of its spine.
            opening: String(o.opening || ''),
            openingBudget: Number(o.openingBudget) || 0,   // [OPEN-BUDGET] 0 = the default
            updatedAt: Number(o.updatedAt) || 0
        };
    } catch (eLc) {
        api.v1.error('[AE:charter] load failed:', eLc);
        return ceCharterEmpty();
    }
}

async function saveCharter(c: CharterState): Promise<void> {
    try {
        c.updatedAt = Date.now();
        await api.v1.storyStorage.set(STORAGE_CHARTER, JSON.stringify(c));
    } catch (eSc) { api.v1.error('[AE:charter] save failed:', eSc); }
}

// ONE WRITE VERB, on ceEntityWrite's shape: the caller names a field and a value and never
// touches the record. A second writer over one store is the bug both writers exist to stop.
async function ceCharterWrite(key: string, value: any): Promise<void> {
    var c = await loadCharter();
    var k = String(key || '');
    if (k === 'style') { c.style = String(value || ''); }
    else if (k === 'play') { c.play = String(value || ''); }
    else if (k === 'ladder') { c.ladder = Array.isArray(value) ? value : []; }
    else if (k === 'opening') { (c as any).opening = String(value || ''); }   // [OPEN-DRAFT]
    else if (k === 'openingBudget') { (c as any).openingBudget = Number(value) || 0; }
    // [KIND-SHAPE] One entry per non-laddered kind. An object rather than a field each,
    // because the kinds are a table and a field each would be six writers for one fact.
    else if (k === 'shapes') {
        (c as any).shapes = (value && typeof value === 'object') ? value : {};
    }
    // [KIND-LADDER] One ladder per non-location recursive kind, on the same table shape
    // `shapes` uses and for the same reason.
    else if (k === 'ladders') {
        (c as any).ladders = (value && typeof value === 'object') ? value : {};
    }
    else { api.v1.error('[AE:charter] refused unknown field:', k); return; }
    await saveCharter(c);
    // [CHARTER-AN] THE VOICE TIER PUBLISHES ON WRITE, at the one site that writes it. The
    // alternative was to publish only on the World stage's Save, which makes a tier whose
    // destination is the Author's Note depend on a button about Memory -- and leaves the
    // Charter surface saying something that is true only later. Both callers (the field
    // commit and the compression pass) go through here, so this is still one trigger.
    if (k === 'play') { await ceCommitAuthorNote(); }
}

// ── The world question set  [BUILD-WORLD] [WORLD-PICK] [WORLD-HELPER] ───────
// The canon tier's questions are cfg.wizardSections and always have been. What was missing
// is that WHICH questions a story answers is itself a per-story answer -- and `enabled` has
// been that answer since WIZARD-2. assembleWizardMemory drops a disabled section, so a
// surface that renders a question WITHOUT its switch is offering a box whose text silently
// never reaches Memory. Four of the eight canon defaults ship off, including both
// Consequences questions.
//
// NO SECOND FLAG. An `applies` field beside `enabled` would be two answers to one question
// with only one of them read at the projection -- the exact shape of every double-source bug
// this file's rules exist to stop. "Which fields apply to this story" IS the enabled set.
//
// [WORLD-HELPER] TWO AUDIENCES, TWO FIELDS. `instructions` is model-facing scope guidance;
// `helper` is what the author reads while deciding. They were one field, rendered at both,
// and the seeds are written at a model.

// [WORLD-PICK] How many questions of its own the pass may mint. NAMED, because it is stated
// to the author on the surface and to the model in the ask, and a number written three times
// is a number that ends up meaning three different things.
var CE_WORLD_PICK_ADD_MAX = 2;

// The two questions the chooser may never switch off. Not a `core` flag on the record: a
// flag invites a surface to render it, and this is a property of ONE pass rather than of the
// question. The author may still turn them off by hand.
var CE_WORLD_ALWAYS: string[] = ['wsec_premise', 'wsec_setting'];

// ONE RESOLVER PER ADDRESS. `helper` on the record wins; the default table answers for every
// story saved before the field existed; `instructions` is the last resort so a hand-added
// section from the legacy Memory tab still says something.
function ceWorldHelper(sec: any): string {
    if (!sec) return '';
    var own = String(sec.helper || '').trim();
    if (own) return own;
    var sid = String(sec.id || '');
    for (var i = 0; i < DEFAULT_WIZARD_SECTIONS.length; i++) {
        var d: any = DEFAULT_WIZARD_SECTIONS[i];
        if (d && String(d.id) === sid) return String(d.helper || d.instructions || '');
    }
    return String(sec.instructions || '');
}

// What the MODEL is told a question covers. The mirror of ceWorldHelper and deliberately the
// other way round: a tuned instruction beats a human hint here, and a hint beats nothing.
function ceWorldScope(sec: any): string {
    if (!sec) return '';
    var ins = String(sec.instructions || '').trim();
    if (ins) return ins;
    return ceWorldHelper(sec);
}

// A default question cannot be deleted, only switched off -- there is no way to get one back.
function ceWorldIsDefault(id: string): boolean {
    var sid = String(id || '');
    for (var i = 0; i < DEFAULT_WIZARD_SECTIONS.length; i++) {
        if (String(DEFAULT_WIZARD_SECTIONS[i].id) === sid) return true;
    }
    return false;
}

// ONE WRITE VERB for a question, on ceCharterWrite's shape. Every caller names a section and
// the fields it is changing; nobody re-does the find-by-id dance, and nobody trusts a
// render-time index across a blur.
// SEEDS FROM THE DEFAULTS when cfg has no list yet, because a config written before
// DEFAULT_WIZARD_SECTIONS existed would otherwise gain its first question by accident.
var CE_WORLD_SEC_FIELDS: string[] = ['label', 'enabled', 'content', 'instructions', 'helper', 'target'];
async function ceWorldSecWrite(id: string, patch: any): Promise<void> {
    var sid = String(id || '');
    if (!sid || !patch) return;
    try {
        await ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var list: any[] = (c.wizardSections && c.wizardSections.length)
                    ? c.wizardSections : JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS));
                for (var i = 0; i < list.length; i++) {
                    if (!list[i] || String(list[i].id) !== sid) continue;
                    for (var f = 0; f < CE_WORLD_SEC_FIELDS.length; f++) {
                        var k = CE_WORLD_SEC_FIELDS[f];
                        if (patch[k] !== undefined) list[i][k] = patch[k];
                    }
                }
                c.wizardSections = list;
            });
        });
    } catch (eWsw) { api.v1.error('[AE:world] section write failed:', eWsw); }
}

// An author-added question. `helper` and `instructions` are seeded from ONE typed line
// because at the moment of adding they are the same sentence: what belongs in this box. They
// are separate fields afterwards and the legacy Memory tab can diverge them.
// ENABLED ON ARRIVAL. Nobody adds a question in order to leave it out.
async function ceWorldSecAdd(label: string, helper: string): Promise<string> {
    var lab = String(label || '').trim();
    if (!lab) return '';
    var hlp = String(helper || '').trim();
    var sid = 'wsec_' + generateId();
    try {
        await ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var list: any[] = (c.wizardSections && c.wizardSections.length)
                    ? c.wizardSections : JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS));
                list.push({ id: sid, label: lab, enabled: true, content: '',
                            instructions: hlp, helper: hlp, target: 'memory' });
                c.wizardSections = list;
            });
        });
    } catch (eWsa) { api.v1.error('[AE:world] section add failed:', eWsa); return ''; }
    return sid;
}

async function ceWorldSecDelete(id: string): Promise<void> {
    var sid = String(id || '');
    if (!sid || ceWorldIsDefault(sid)) return;
    try {
        await ceSettingsOp(function() {
            return mutConfig(function(c: any) {
                var list: any[] = c.wizardSections || [];
                var keep: any[] = [];
                for (var i = 0; i < list.length; i++) {
                    if (list[i] && String(list[i].id) !== sid) keep.push(list[i]);
                }
                c.wizardSections = keep;
            });
        });
    } catch (eWsd) { api.v1.error('[AE:world] section delete failed:', eWsd); }
}

// ── The ladder  [LADDER] ────────────────────────────────────────────────────
// WORLDPIPE 6: SCALE IS AUTHORED, NOT DERIVED FROM DEPTH. mapKind's own header already made
// this argument one layer down -- "depth 0 is a continent in one story and a suburban house
// in the next" -- and it holds identically here. A house under a region is depth 2; a house
// under region then city is depth 3; both should be asked the House questions.
//
// [LADDER-SCOPE] A RUNG MAPS ONTO AN EXISTING LOCATION_FACETS SCOPE AND WIDENS NOTHING. The
// facet table's own rule survives untouched: scope is a DISPLAY FILTER DEFAULT and touches
// no record, because a place is often several scales at once. So the rung decides what the
// generator asks by default, never what the record can hold, and there is zero migration --
// no new facet values, no backfill.
//
// [LADDER-TOP-ONLY] ONLY THE TOP RUNG IS AUTHORED ON THE SCOPE FORM. The rest are added when
// a location is first stepped into, because there is no point naming a scale before there is
// something at it, and WIZUI 5 gap 1 puts that question inline in the workspace's empty state
// at a new depth rather than on this form. Gaps are legal (6.4): a house directly under a
// region skips the City rung because there is no city.
var CE_LADDER_SCOPES: any[] = [
    { id: 'region',     label: 'Region',     hint: 'A stretch of land or space \u2014 a province, a sector, a sea.' },
    { id: 'settlement', label: 'Settlement', hint: 'A place people live together \u2014 a city, a station, a village.' },
    { id: 'structure',  label: 'Structure',  hint: 'One built thing \u2014 a house, a ship, a tower.' },
    { id: 'interior',   label: 'Interior',   hint: 'A space inside something \u2014 a room, a deck, a ward.' },
    { id: 'any',        label: 'Any',        hint: 'No particular scale. Every question is offered.' }
];
// [KIND-SCOPE] ceLadderScopeOk IS DELETED. It validated any scope against the LOCATION
// table and returned 'any' for anything else, so it was correct only while locations were
// the only laddered kind. Its three callers -- ceLadderAppend, ceScopeWrite and ceSeedDefs
// -- all had a `kind` in hand already and now use ceKindScopeOk.
// [KIND-SCOPE] THE SCALE VOCABULARY BELONGS TO THE KIND, NOT TO THE ROUTE. CE_LADDER_SCOPES
// is the LOCATION facet table's scope column spelled out with labels, and it was offered to
// every laddered kind -- so a faction rung was asked whether it was a Region or an Interior,
// wrote the answer onto rung.scope, and nothing ever read it. A picker whose value no reader
// consumes is [F-20]'s parked field wearing a label.
//
// MEASURED, NOT ASSUMED: LOCATION_FACETS carries region/settlement/structure/interior,
// SPECIES_FACETS carries people/beast, and FACTION_FACETS and NARRATIVE_FACETS carry `any`
// and nothing else. So the question "does this kind have scales" already has an answer in
// the facet tables, and the only thing this map adds is the label and hint prose a picker
// needs. A KIND WITH NO ENTRY HERE RENDERS NO PICKER and resolves to 'any', which is what
// ceSeedDefs already did for it by falling through.
//
// ONLY LOCATION IS LISTED. Species' two lists are a real scope pair and will land here with
// the Species stage; declaring them before the stage reads them would be the parked field
// this comment is about, one layer up.
var CE_KIND_SCOPES: any = {
    location: CE_LADDER_SCOPES
};
function ceKindScopes(kind: string): any[] {
    var l: any = CE_KIND_SCOPES[String(kind || '')];
    return Array.isArray(l) ? l : [];
}
function ceKindScopeOk(kind: string, s: string): string {
    var list: any[] = ceKindScopes(kind);
    var v = String(s || '');
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) === v) return v;
    }
    return 'any';
}
function ceKindScopeHint(kind: string, id: string): string {
    var list: any[] = ceKindScopes(kind);
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) === String(id)) return String(list[i].hint || '');
    }
    return '';
}

// ── The Author's Note, and its ONE writer  [CHARTER-AN] ─────────────────────
// WORLDPIPE 3.1: `play` reaches the Author's Note only, generator-blind, voice and ATTG.
// That is now true. It was not: the tier was written, shown, and read by nothing, while the
// Note's managed region was assembled from the two 'an'-targeted wizard sections. A field
// with a stated destination and no reader is [F-20]'s promise rather than its parked field.
//
// A RESOLVER WITH A PRECEDENCE, NOT TWO WRITERS. The charter wins wherever it has anything.
// The old sections stay underneath as the fallback because deleting them would empty the
// Author's Note of every story written before the charter existed, on the first save --
// which is a migration disguised as a cleanup. When the last of those stories is gone the
// fallback is one line to delete and the sections go with it.
function ceAuthorNoteBody(cfg: any, charter: any): string {
    var play = String((charter && charter.play) || '').trim();
    if (play) return play;
    return String(assembleWizardAuthorNote((cfg && cfg.wizardSections) || []) || '').trim();
}

// THE ONLY SITE THAT WRITES THE MANAGED REGION. Extracted out of commitWizardMemory so the
// charter can publish without going through a Memory commit it has nothing to do with, and
// so there is still exactly one place that knows the sentinel dance.
// [G-04] The scene sentinel is stripped defensively first: it is appended per generation and
// must never be found persisted, but finding one and writing around it is cheaper than the
// alternative.
async function ceCommitAuthorNote(): Promise<boolean> {
    try {
        var cfg: any = await loadConfig();
        var charter: any = await loadCharter();
        var body = ceAuthorNoteBody(cfg, charter);

        var existingAN = '';
        try { existingAN = (await api.v1.an.get()) || ''; } catch (_eAnR) {}

        var sceneMarker = '\n\n' + AE_AN_SENTINEL;
        var sceneIdx = existingAN.lastIndexOf(sceneMarker);
        if (sceneIdx >= 0) { existingAN = existingAN.substring(0, sceneIdx); }
        else if (existingAN.indexOf(AE_AN_SENTINEL) === 0) { existingAN = ''; }
        existingAN = existingAN.replace(/\s+$/, '');

        var wizMarker = '\n\n' + AE_WIZ_AN_SENTINEL;
        var wizIdx = existingAN.lastIndexOf(wizMarker);
        if (wizIdx >= 0) { existingAN = existingAN.substring(0, wizIdx); }
        else if (existingAN.indexOf(AE_WIZ_AN_SENTINEL) === 0) { existingAN = ''; }
        existingAN = existingAN.replace(/\s+$/, '');

        var finalAN = existingAN;
        if (body) {
            var region = AE_WIZ_AN_SENTINEL + '\n' + body;
            finalAN = existingAN ? (existingAN + '\n\n' + region) : region;
        }
        await api.v1.an.set(finalAN);
        return true;
    } catch (eAn) {
        api.v1.error('[AE:charter] author note write failed:', eAn);
        return false;
    }
}

// ── The prompt substrate  [P-SUBSTRATE] ──────────────────────────────────────
// Blocks 1-3 of the cached head. Byte-identical in every call the pipeline makes, which is
// the property the cache is paid for -- edit one of these and every warm prefix in every
// open session goes cold at once.

var CE_P_CORE =
    'You are the worldbuilding assistant inside a writing tool. An author is building the '
  + 'world of one story with you.\n\n'
  + 'THE STORY IS WHATEVER THE AUTHOR SAYS IT IS. Its setting, era, scale, tone and genre '
  + 'come only from what you are told here. Assume nothing else \u2014 not a protagonist, '
  + 'not a point of view, not a level of technology, not a kind of world. What you are '
  + 'building may be one household, a hospital, a city, a ship, a company, a country, or '
  + 'something with no earthly parallel.\n\n'
  + 'USE THE AUTHOR\u2019S OWN NAMES, EXACTLY. If they have named a person, place, group, '
  + 'object or idea, their spelling is correct and yours is not. Never replace a name you '
  + 'were given with a description of it, and never coin a new name in passing \u2014 when '
  + 'a name is wanted, you will be asked for one directly.\n\n'
  + 'NEVER FILL A GAP WITH A GUESS. If you do not know something, leave it out. A short '
  + 'true answer beats a complete-looking invented one.\n\n'
  + 'Do not use markdown: no headers, no bold or italics, no bullet characters, no code '
  + 'fences, no emoji.';

// The family block for the three conversational surfaces. The last PACE bullet is
// load-bearing: every "be concise" instruction a model receives leaks into the LENGTH of
// what it writes, and naming the distinction is the only thing that closes it.
var CE_P_CHAT =
    'You are talking with the author. This is a conversation, not a form.\n\n'
  + 'PACE\n'
  + '- Respect their time. If their first message already gives you enough to work with, '
  + 'put a concrete draft or a concrete suggestion in front of them rather than '
  + 'interviewing them.\n'
  + '- At most one question per reply, and only when the answer would change what you write '
  + 'next.\n'
  + '- If they signal in any way that they want to explore, brainstorm, take their time, or '
  + 'hear your ideas \u2014 drop the pace entirely and dig in with them. Never hurry an '
  + 'author who wants depth.\n'
  + '- Efficiency is about the CONVERSATION, never about the world. Nothing you help them '
  + 'decide should end up smaller, shorter or shallower in order to save time.\n\n'
  + 'VOICE\n'
  + 'Plain prose. Two to five sentences is the usual size; a short paragraph is right when '
  + 'you are drawing several threads together. Be a collaborator \u2014 not a gatekeeper, '
  + 'and not an enthusiast. React to what is actually good and to what is actually unclear, '
  + 'rather than praising by reflex.\n\n'
  + 'Build on what they give you. Offer one or two concrete options they can react to '
  + 'rather than open questions they must answer from nothing. Follow their lead on genre '
  + 'and tone; do not steer toward what you would find interesting.\n\n'
  + 'WHAT HAPPENS TO THIS CONVERSATION\n'
  + 'When the author is ready they press a button outside this chat, and the tool reads the '
  + 'conversation and writes the actual records. You never need to produce JSON, headings, '
  + 'or any special format here. Talk normally, and make the things you agree on '
  + 'unambiguous.';

// The family block for name, seed and extraction. The `none` channel is the part that
// matters: an unambiguous empty answer that needs no parsing, and explicit PERMISSION to
// have nothing to say, which is what stops a model inventing to fill a field.
var CE_P_MACHINE =
    'You are answering a tool, not a person. Your reply is read by a program and stored.\n\n'
  + 'Output only what is asked for. No preamble, no sign-off, no explanation of your answer, '
  + 'no restating of the question, no commentary on what you did or why.\n\n'
  + 'Never output a placeholder. No \u201cTBD\u201d, no \u201cUnknown\u201d, no bracketed '
  + 'notes, no blanks to be filled in later. If you have nothing for one field, leave that '
  + 'field out. If you have nothing at all, reply with the single word: none.\n\n'
  + 'Do not quote your own answer. No surrounding quotation marks, no backticks, no code '
  + 'fences.';

// [P-PERSONA] THE THIRD FAMILY, AND IT REPLACES CE_P_CORE RATHER THAN SITTING UNDER IT.
// Every other family in this file is a worldbuilding assistant talking to an author, and
// CE_P_CORE says so in its first sentence -- "You are the worldbuilding assistant inside a
// writing tool" -- then forbids markdown, which is a rule about filling a form and not about a
// person sending a text message. A persona channel is neither the assistant nor talking to the
// author, so inheriting that core would spend tokens on instructions its whole job contradicts.
//
// THE DECISIVE ARGUMENT IS THE CACHE, NOT THE PROSE. [PCP-CACHE-SPLIT] measured the two models
// as INDEPENDENT cache spaces, so this head shares nothing with the utility head no matter what
// is in it. Reusing CE_P_CORE here would buy exactly zero warm tokens; the only thing the two
// families need to share is the ASSEMBLER, which is why this is a `family` value on ceBuildHead
// rather than a second builder beside it.
//
// WHAT IS *NOT* HERE, and each absence is load-bearing:
//   - No mode vocabulary. Texting, talking, roleplay and interview differ in framing, task and
//     register, and CC_MODES already owns all three. This block is what is true of all four.
//   - No register. That is buildCharChatPersonaClause, per contact, and it belongs in the
//     participant block where the contact does.
//   - No name, of anyone. [P-NO-SETTING]'s argument transfers directly: a block above the point
//     where the speaker is chosen must not name the speaker, or every character gets a
//     different head from its first sentence and nothing above the participant block can cache.
//   - No emotion or attachment directive. Those are conditional on mode and config, and a
//     conditional block in a fixed head is a head that changes shape.
var CE_P_PERSONA =
    'You are writing one person in a conversation, in a story an author is building.\n\n'
  + 'YOU ARE THAT PERSON. Everything below tells you who they are. Answer as they would answer, '
  + 'from what they know and want, not from what would be useful or agreeable. They are under '
  + 'no obligation to be helpful, forthcoming or pleasant, and a character who quietly agrees '
  + 'with whoever they are talking to has stopped being a character.\n\n'
  + 'WRITE ONLY THEIR SIDE. Never write the other person\u2019s words, actions, thoughts or '
  + 'reactions, and never write what happens next \u2014 one turn, theirs, and then stop.\n\n'
  + 'NEVER STEP OUTSIDE. No narrator, no commentary on the conversation, no reference to a '
  + 'story, a model, an author, or these instructions. A question about the world that the '
  + 'person could not answer gets the answer they would actually give, which is often that they '
  + 'do not know.\n\n'
  + 'STAY INSIDE WHAT YOU WERE GIVEN. Their history, their circumstances and the people they '
  + 'know are written below. Do not invent a new named person, place or event to fill a gap \u2014 '
  + 'a person who cannot remember, or will not say, is always better than one who makes '
  + 'something up.';

// Shared by every record-writing call. This is the general form of a rule six subsystems in
// this file each state their own way, and stating it ONCE is what stops six copies drifting.
var CE_P_RECORDS =
    'WHAT A RECORD IS\n'
  + 'Everything you write here is a durable fact about the world \u2014 what is true of '
  + 'this thing in general, when nothing in particular is happening to it. It is read later, '
  + 'out of order, in scenes you cannot see.\n\n'
  + 'So: never write about a moment. No one is arriving, deciding, fighting or speaking. '
  + 'Write no weather that is happening now, no visitor at the door, no event in progress.\n\n'
  + 'The tool owns what is currently going on \u2014 who is present, where anyone is '
  + 'standing, what is held, who is angry with whom today. You are writing what remains true '
  + 'after all of that changes.';

// Appended AFTER the charter's style tier, which supplies this story's actual conventions.
// One block for every kind, because the kind noun arrives in the ask [P-NO-SETTING].
var CE_P_NAMING =
    'NAMING\n'
  + 'A name comes from inside the world. It is what the people there actually call the '
  + 'thing, so it carries their language, their history and their habits \u2014 not the '
  + 'author\u2019s opinion of it, and not yours.\n\n'
  + 'A name never announces what the thing is like. No dangerous place is named for its '
  + 'danger, no cruel person for their cruelty, no corrupt organisation for its corruption. '
  + 'A grim thing and a pleasant thing from the same culture have names of the same kind '
  + '\u2014 from the names alone you could not tell which was which. Everything grim, '
  + 'splendid, decayed or menacing belongs in the description and nowhere near the name.\n\n'
  + 'A name may come from a person, a family, a trade, a physical feature, an event, a joke, '
  + 'a mistake, or a language nobody speaks any more. Ordinary is fine. Plain is fine. '
  + 'Repetition is fine \u2014 real worlds have three places with the same name.\n\n'
  + 'Avoid names built for effect: apostrophes dropped in to look exotic, invented letters, '
  + 'syllables assembled to sound impressive, and any word chosen for how it sounds while '
  + 'meaning nothing.';

// The premise chat's own block. Appended after CORE + CHAT, and it is the only per-surface
// prompt in this section -- the rest of the pipeline's per-surface blocks arrive with their
// surfaces.
// THE CHECKLIST IS COVERAGE, NOT A SCRIPT. Stating it as topics rather than as questions is
// what stops the model marching through it; CE_P_CHAT's one-question-per-reply rule already
// caps the pace.
// \"A story about one house is not a small story\" is doing specific work: every model's
// prior on worldbuilding is EXPANSION, so an author with a chamber piece gets it inflated by
// default unless told otherwise.
var CE_P_PREMISE =
    'THIS CONVERSATION\n'
  + 'You are helping the author settle what their story actually is, before anything gets '
  + 'written down. This is the first thing they do and everything else is built on it.\n\n'
  + 'By the end you want to have covered, without ever interrogating them for it:\n'
  + '- what kind of story this is, and what happens in it\n'
  + '- where and when it is set, and how much of that place the story actually moves '
  + 'through\n'
  + '- how names sound here \u2014 the shape of a person\u2019s name, a place\u2019s name, '
  + 'a group\u2019s name\n'
  + '- what is true of this world that would not be true of ours, if anything\n'
  + '- anything that must never appear\n\n'
  + 'Names matter more than they look like they do. Two or three real examples the author is '
  + 'happy with are worth more than any amount of description, so when the conversation is '
  + 'going well, ask for them.\n\n'
  + 'Take what they bring at face value. A story about one house is not a small story, and '
  + 'does not want widening. If they hand you three words, offer them two concrete '
  + 'directions and let them react rather than asking what they mean.';

// The world profile's chat. [CHARTER-CANON-NONE] What this conversation produces IS the
// canon tier -- there is no third compression call, because the answers themselves are the
// artifact and Memory is their projection.
// \"A war that ends is an event; the border it was fought over is canon\" is the conversion
// this chat exists to perform, and it is stated as a RULE FOR WHAT TO DO WITH AN EVENT
// rather than as a prohibition on mentioning one. A model told not to write events writes
// nothing; a model told how to turn one into a fact writes the fact.
var CE_P_WORLD =
    'THIS CONVERSATION\n'
  + 'You are helping the author write the permanent canon of their world \u2014 the block of '
  + 'text the story\u2019s narrator will have in front of it for every single scene, '
  + 'forever.\n\n'
  + 'That is what makes this different from anything else you will help with. Nothing here '
  + 'is description or atmosphere. It is the set of things that must stay true, stated '
  + 'plainly enough that they can be read at a glance and never argued with.\n\n'
  + 'There is a fixed set of questions to cover, listed below. Work through them in whatever '
  + 'order the author wants, and let them skip any of them.\n\n'
  + 'Prefer what stays true over what happens. A war that ends is an event; the border it '
  + 'was fought over is canon. If the author gives you an event, ask what it left behind.';

// [WORLD-PICK] THE CHOOSER'S ASK. Two properties carry it, and neither is prompt polish.
// LEAVING A QUESTION OUT IS NAMED AS THE NORMAL CASE. Every model's prior on a checklist is
// to tick it, so a chooser that does not say "most of these do not apply" returns all of
// them and the pass has done nothing.
// IT ANSWERS IN IDS, NOT LABELS. The ids are a closed set the caller already holds, so an
// unknown line is dropped without a fuzzy match against a label an author may have renamed.
// [P-NO-SETTING] The examples name no setting: "a story with no violence in it" and "a story
// about one household" are shapes, not worlds.
// [FIELD-MINT] WRITING THE QUESTIONS, not answering them. WORLD-PICK-ADD does this for the
// world's own question set and this is the same act one level down: read the conversation,
// work out what a record of this kind needs to be asked, and write those questions into the
// kind's field library.
//
// IT EXISTS BECAUSE A SEED PASS WITH NO QUESTIONS CANNOT RUN. An item's catalog base is
// EMPTY -- `item: { base: [], ... }` -- so until an author defines fields by hand there is
// nothing to seed and the Seed button has nothing to ask for. `custom` shape reaches the
// same dead end for every kind, by choice rather than by omission. SEED-BASELINE's argument
// (a seedless field is not a degraded one) covers a NARROW ask against a full set; it does
// not cover an empty one.
//
// THE FORMAT IS WORLD-PICK-ADD'S EXACTLY -- `+ Name | one line` -- because there is no
// reason for two parse shapes for one act, and the world pass's parser was written against
// a model's actual failure modes rather than against a specification.
var CE_FIELD_MINT_MAX = 6;
var CE_P_FIELD_MINT_HEAD =
    'Write the questions this story should ask about every ';
var CE_P_FIELD_MINT_BODY =
    '.\n\nA question belongs if the answer would differ between one of these and the next, '
  + 'and would change how a scene using it is written. It does not belong if every one of '
  + 'them would answer it the same way, or if the honest answer is generic.\n\n'
  + 'Write questions about the KIND, never about one particular example. \u201cWhat is it '
  + 'made of\u201d is a question; \u201cwhat is the Kingsblade made of\u201d is an answer '
  + 'to one. If the conversation is mostly about specific examples, ask what those examples '
  + 'made you want to know, and write that.\n\n'
  + 'FEWER IS BETTER. Every question here is put to every one of these for the life of the '
  + 'story, and one that is usually answered \u201cnothing in particular\u201d costs more '
  + 'than it returns.';
var CE_P_FIELD_MINT_TAIL =
    '\n\nReply with up to ' + String(CE_FIELD_MINT_MAX) + ' questions, each on its own '
  + 'line, in exactly this form and with nothing else in the reply:\n'
  + '+ Name | one line saying what belongs in the answer\n\n'
  + 'The name is a short label the author reads above a box. The line after the bar is read '
  + 'by the author in the empty box and by the writer filling it, so say what belongs there '
  + 'rather than describing the question.\n\n'
  + 'If the conversation does not support any, reply with the single word NONE.';

// [OPEN-WRITE] THE ONE PASS IN THIS PIPELINE THAT WRITES PROSE FOR A READER. Everything
// else fills fields: short, labelled, machine-family, read by another pass. This is the
// story's first paragraphs, and the author reads every word.
//
// IT IS NOT A SUMMARY OF THE WORLD. The temptation an opening pass has, holding a charter
// and a cast list and a map, is to introduce them -- and an opening that introduces the
// world is the failure mode this whole prompt exists to refuse. The records are CONTEXT for
// a scene, not its subject.
//
// NO SECOND-PERSON DEFAULT AND NO GENRE VOICE. The charter's style line is the only
// authority on how this reads, which is CHARTER-TIER's rule applied to prose.
var CE_P_OPENING =
    'Write the opening of this story.\n\n'
  + 'UNLESS THE AUTHOR HAS ASKED FOR SOMETHING ELSE, start in a scene already underway: a '
  + 'specific place, a specific moment, somebody doing something. That is the DEFAULT and '
  + 'not a rule \u2014 if they have asked for a prologue, a frame, a letter, a cold open on '
  + 'a landscape, or anything else, write that instead and write it well. Their instruction '
  + 'outranks this paragraph completely.\n\n'
  + 'WHAT YOU HAVE BEEN GIVEN IS CONTEXT, NOT SUBJECT MATTER. Most of it should not appear. '
  + 'Use the two or three details that this particular moment would actually touch and leave '
  + 'the rest unmentioned \u2014 a world that is only shown where the scene brushes against '
  + 'it reads as larger than one that is explained.\n\n'
  + 'NAME THINGS THE WAY THE AUTHOR NAMED THEM. Every proper noun you use must be one you '
  + 'were given, spelled their way. Do not invent people, places or groups; if the scene '
  + 'needs someone who is not in the notes, leave them unnamed.\n\n'
  + 'END WITHOUT RESOLVING. The last line should leave something unanswered or about to '
  + 'happen \u2014 this is where the author takes over, and a closed scene is a wall.\n\n'
  + 'Prose only: no headings, no title, no bullet points, no note to the author, nothing '
  + 'before the first line or after the last.';

var CE_P_WORLD_PICK =
    'Choose which of these questions this story should answer.\n\n'
  + 'A question belongs if the answer would be specific to THIS story and would change how '
  + 'it is written. It does not belong if the honest answer is generic, or if nothing in the '
  + 'conversation suggests this story has one at all.\n\n'
  + 'LEAVING QUESTIONS OUT IS THE NORMAL RESULT, not a failure. A story with no violence in '
  + 'it has no question about harm. A story that never leaves one household has no question '
  + 'about the largest scale it reaches. Choosing everything is the same as choosing '
  + 'nothing.\n\n'
  + 'The questions, as id, name and what each covers:\n';

var CE_P_WORLD_PICK_TAIL =
    '\n\nReply with one id per line \u2014 only the ids of the questions that belong, and '
  + 'nothing else on those lines.\n\n'
  + 'Then WRITE ANY QUESTION THIS STORY NEEDS THAT THE LIST ABOVE DOES NOT COVER. Most '
  + 'stories need none and that is a fine answer; a story built on something the list has no '
  + 'name for needs one. Up to ' + String(CE_WORLD_PICK_ADD_MAX) + ', each on its own line, '
  + 'in exactly this form:\n'
  + '+ Name | one line saying what belongs in it\n\n'
  + 'The line after the bar is read by the author in the empty box and by the writer filling '
  + 'it, so say what belongs there rather than describing the question.\n\n'
  + 'A question is a standing fact the story\u2019s narrator needs in every scene. Never add '
  + 'one for a particular person, place, group, object or event \u2014 those are recorded '
  + 'elsewhere and do not belong here.';

// [WORLD-EXTRACT] ONE QUESTION PER CALL, and the ask is parameterised because the scope line
// is the only part that varies. The `none` channel is the load-bearing half: this pass runs
// over questions the author has NOT answered, so "the conversation did not settle this" is
// the expected answer for most of them and inventing one would be worse than leaving a blank.
// [EXTRACT-HANDOFF] THE ASK REVOKES THE CHAT FRAMING, and this is a real fault rather than
// a flourish. Extraction rides the CHAT family's prefix on purpose (PROMPTS 16/17: reuse the
// conversation's exact prefix, which is what makes it affordable) -- but that head says "You
// are talking with the author. This is a conversation, not a form" and "at most one question
// per reply". PROMPTS 3.2 puts extraction in the MACHINE family, and the two cannot both be
// in the system block without throwing the cache away.
// SO THE FAMILY SWITCH RIDES THE ASK. Observed live: an extraction returned a conversational
// turn -- "Let's develop Jake's internal conflict... Is he trying to escape his mundane life,
// or..." -- which is the head winning, not the model failing. It was written into a Memory
// field verbatim.
function _ceWorldExtractAsk(label: string, scope: string): string {
    return 'The conversation above is finished. You are no longer talking to the author, and '
         + 'nothing you write now is read by a person \u2014 it is stored in a field. Do not '
         + 'ask a question, do not suggest what to do next, and do not address anyone.\n\n'
         + 'Write the answer to ONE question, using only the conversation above.\n\n'
         + 'QUESTION: ' + String(label || '') + '\n'
         + 'WHAT BELONGS IN IT: ' + String(scope || '') + '\n\n'
         + 'Use only what the conversation actually settled. Do not extend it, tidy it, or '
         + 'fill a gap with something reasonable. Keep every name the author used, spelled '
         + 'their way.\n\n'
         + 'Do not carry over anything they raised and then rejected. A discarded idea is '
         + 'still in the text above and reads exactly like an adopted one.\n\n'
         + 'One to three sentences of plain prose, stating what stays TRUE rather than what '
         + 'happened. No heading, no label, no quotation marks, no markdown.\n\n'
         + 'If the conversation did not settle this, reply with the single word: none';
}

// ── The scoped chat  [SCOPE-CHAT] ───────────────────────────────────────────
// PROMPTS 15, AND THIS CHAT WAS RUNNING ON CE_P_WORLD. That block tells the model it is
// helping write "the permanent canon of their world -- the block of text the story's
// narrator will have in front of it for every single scene". A conversation about what six
// regions are called is not that, and Extraction B rides this exact prefix, so the wrong
// frame would have been inherited by the pass that reads the transcript.
//
// IT NAMES BOTH EXITS AND DECIDES NEITHER. A roster and one record's seeds come out of the
// same conversation and the author picks by pressing a button afterwards, so a chat told to
// produce one of them makes the other pass read against the grain of its own transcript.
//
// THE SCOPE INSTRUCTION IS SOFT ON PURPOSE. A hard refusal reads as obstructive and authors
// route around it by not mentioning things at all, which loses the material rather than
// filing it. A soft return keeps the conversation honest and still gets it into the right
// chat.
var CE_P_SCOPED_TAIL =
    'Stay there. If they raise something belonging elsewhere, follow them for a moment and '
  + 'then bring it back \u2014 the tool has a separate conversation for every other part of '
  + 'this world, and things worked out in the wrong one are lost.\n\n'
  + 'Two things can come out of this conversation, and the author chooses which by pressing '
  + 'a button afterwards, so you do not need to decide:\n'
  + '- a list of them to create, each with a name if they gave one\n'
  + '- everything worth knowing about one particular one\n\n'
  + 'Both are served by the same thing: being specific. A name they said out loud, a detail '
  + 'they got excited about, a distinction they drew between two of these \u2014 those '
  + 'survive. General impressions do not.';

function ceScopedChatLead(pluralNoun: string, rungLabel: string, parentName: string): string {
    var s = 'THIS CONVERSATION\nYou are working with the author on one part of their world: '
          + String(pluralNoun || 'places');
    if (String(rungLabel || '').trim()) s += ', at the level of ' + String(rungLabel);
    if (String(parentName || '').trim()) s += ', inside ' + String(parentName);
    return s + '.';
}

// ── The record chat  [REC-CHAT] ─────────────────────────────────────────────
// [REC-CHAT-ONE-EXIT] THE SCOPE CHAT HAS TO NAME TWO EXITS AND THIS ONE NAMES ONE. PROMPTS
// 15's block says "two things can come out of this conversation and the author chooses which,
// so you do not need to decide" -- which is honest there and unnecessary here. A conversation
// about one record has one product, so the question list stops being background context and
// becomes the agenda, and the model can be told plainly what it is filling.
//
// IT DOES NOT INHERIT THE SCOPE CHAT'S TURNS. WORLDPIPE 7.2: a child reads its ancestors'
// OUTPUT, never their transcript. What the scope conversation established about the set
// arrives as the batch intent, which rides the ask -- so the shared material travels
// compressed, exactly as the premise chat travels to every call as the charter.
var CE_P_RECORD_TAIL =
    'Stay on this one thing. If they raise another, note it and come back \u2014 everything '
  + 'else in this world has its own conversation, and what is worked out in the wrong one is '
  + 'lost.\n\n'
  + 'One thing comes out of this conversation. When the author is ready they press a button '
  + 'outside this chat, and the tool reads what you agreed and fills in the questions below. '
  + 'You never need to produce a list, a heading or any special format here \u2014 talk '
  + 'normally, and make the things you settle unambiguous.\n\n'
  + 'A question they say nothing about stays empty and is written later from the world\u2019s '
  + 'own rules, so there is no need to cover all of them. What this conversation is for is the '
  + 'things only they know.';

function ceRecordChatLead(noun: string, name: string, parentName: string): string {
    var s = 'THIS CONVERSATION\nYou are working with the author on one ' + String(noun || 'thing')
          + ' in their world: ' + String(name || 'this one');
    if (String(parentName || '').trim()) s += ', inside ' + String(parentName);
    return s + '.';
}

// ── The seed call  [SEED-CALL] ──────────────────────────────────────────────
// PROMPTS 10.2, AND THIS IS THE BLOCK THE WHOLE PIPELINE TURNS ON. A seed is not a short
// answer -- it is the author's instruction to the later pass that writes the field at
// length, which is why the profile's facet instructions all end by deferring to "the
// author's steer above". Told to the model directly because a model asked for a short
// answer writes a summary, and a summary of nothing is where the generic line comes from.
//
// "NEVER SAY A THING IS MYSTERIOUS" EARNS ITS PLACE. It is GLM's single most common evasion
// on a question it has nothing for, and it survives every generic instruction about being
// specific.
var CE_P_SEED_WHAT =
    'WHAT YOU ARE WRITING\n'
  + 'Not answers \u2014 starting points. Each line you write becomes the author\u2019s '
  + 'instruction to a later pass that writes the real thing at length.\n\n'
  + 'So each line should be the most specific and most useful thing that could be said about '
  + 'that question: a fact, an angle, a tension, something concrete to build from. One that '
  + 'could only be said about this particular thing is worth ten that could be said about any '
  + 'of its kind.\n\n'
  + 'Never summarise. Never repeat the name. Never say a thing is important, interesting or '
  + 'mysterious \u2014 say what it is.';

// [SEED-KEYS] LABELS ARE THE KEYS, NOT NUMBERS. A numbered format is cheaper on output
// tokens and a model that answers question 3 in slot 2 produces a silently wrong record; a
// label mismatch is visible and recoverable.
// LINE FORMAT, NOT JSON: a missing line is a missing field rather than a parse failure, and
// no value needs escaping.
// THE PERMISSION TO OMIT IS LOAD-BEARING and is the same `none` channel MACHINE opens one
// block up -- a model with nothing for a question and no way to say so writes padding.
// [DESC-MEANS] THE ALWAYS-ON LINE IS NOT A SUMMARY FOR EVERY KIND. Every staged row has a
// `description` -- it is written by the SUMMARY line, rendered as its own box above the
// questions whatever the shape is, and committed to the record's own description column. For
// a place or a faction that is a one-line gloss. AN ITEM'S DESCRIPTION IS MECHANICAL: it is
// what the thing looks like on the person wearing or carrying it, it is the line
// ceEntityLoreText emits when the item is equipped, and a plain summary in it is a wasted
// field and a wrong one.
//   IT IS ALREADY ALWAYS PART OF THE SHAPE. The box renders for every kind and every shape,
//   including `classic` and `custom`, because it is not a facet and never passed through
//   ceSeedDefs. So nothing needs adding -- what was wrong is only what it SAYS, in three
//   places that must agree: the field's label, its placeholder, and the line the seed pass
//   asks for. One table, three readers.
var CE_DESC_GLOSS: any = {
    item: { label: 'Worn appearance',
            hint: 'How it looks on the person wearing or carrying it\u2026',
            ask: 'one sentence, under 25 words \u2014 how this looks on the person wearing '
               + 'or carrying it, not what it does' },
    // A character's column for this is briefDescription, which the sheet already treats as
    // the one-line who-they-are rather than a summary of the record.
    character: { label: 'In brief',
                 hint: 'Who they are, in one line\u2026',
                 ask: 'one sentence, under 20 words \u2014 who this person is, plainly' }
};
function ceDescGloss(kind: string): any {
    var g: any = CE_DESC_GLOSS[String(kind || '')];
    if (g) return g;
    return { label: 'In one line',
             hint: 'What this is, in the plainest terms\u2026',
             ask: 'one sentence, under 20 words \u2014 what this is, in the plainest terms' };
}

// [SEED-KEYS] The format, per kind, because the SUMMARY line is the one part that varies.
function ceSeedFormat(kind: string): string {
    return CE_P_SEED_FORMAT_HEAD + ceDescGloss(kind).ask + CE_P_SEED_FORMAT_TAIL;
}

var CE_P_SEED_FORMAT_HEAD =
    'Answer in lines, one per question, in this exact form:\n\n'
  + 'SUMMARY: <';
var CE_P_SEED_FORMAT_TAIL = '>\n'
  + '<Question label>: <one sentence, under 25 words>\n'
  + '<Question label>: <one sentence, under 25 words>\n\n'
  + 'Use the labels exactly as they are written above, one line each, in any order. If you '
  + 'have nothing worth saying for a question, leave that line out entirely \u2014 a missing '
  + 'line is fine and a padded one is not.';

var CE_P_SEED_UNUSABLE =
    'That was not readable. Write the lines again: the question label exactly as written, a '
  + 'colon, then one sentence. Nothing else on any line, nothing before the first line and '
  + 'nothing after the last.';

// [EXTRACT-RELAPSE] The same refusal EXTRACT-HANDOFF's ask needs, in the seed pass's shape.
// Extraction B rides the chat's prefix, so the head it is fighting is the CHAT family's.
var CE_P_SEED_RELAPSE =
    'That was a conversation, not the lines. Nobody will read it. Write the lines themselves '
  + '\u2014 label, colon, one sentence \u2014 with no question in them and no address to '
  + 'anyone. If the conversation settled nothing about this, reply with the single word: none';

// ── Charter compression  [CHARTER-COMPRESS] ─────────────────────────────────
// TWO CALLS, ONE PER TIER, and never one call for both. An earlier arrangement asked for
// every tier in one reply and the first tier ate the whole output budget -- the same finding
// as the name/description split, arrived at twice.
// THE WARNING GOES FIRST ON BOTH. The failure it names is specific and it does happen: a
// model summarising a conversation replaces \"the Ashen Choir\" with \"a religious order\"
// without noticing it has destroyed anything.
var CE_P_COMPRESS_WARN =
    'READ THIS BEFORE WRITING.\n\n'
  + 'The conversation above is about to be discarded. This is the last time you or anything '
  + 'else will see it. What you write now is the only part that survives into everything the '
  + 'tool generates from here.\n\n'
  + 'Capture every name the author gave you, in their exact words \u2014 every person, '
  + 'place, group, object and idea they named. Never replace a name with a description of '
  + 'it. Anything you leave out or rename is gone.';

// THE STRICTEST PROMPT IN THE PIPELINE, because it has the widest blast radius. Three moves
// here transfer to anything with a wide reach: state the blast radius FIRST, give a WORD
// BUDGET rather than \"be brief\", and give the model a DELETION TEST it can apply to its own
// output.
// The last paragraph prevents the specific failure the tier system exists for: one named
// thing placed in this tier is then forced onto every record in the world.
var CE_P_STYLE_TIER =
    'Write the RULES tier of this world\u2019s charter.\n\n'
  + 'This text is stamped onto EVERY generation the tool makes \u2014 every place, person, '
  + 'group and object, for the life of the story. It is a set of INSTRUCTIONS to those '
  + 'writers, not writing itself. Put nothing here that should not apply to every single '
  + 'thing in this world.\n\n'
  + 'UNDER 120 WORDS TOTAL. Plain instruction lines:\n\n'
  + '- Premise: one line saying what kind of world this is.\n'
  + '- Naming: how names sound and are built here \u2014 for people, for places, for '
  + 'groups. Give two or three examples the author actually used or approved. Say what '
  + 'naming style to avoid. THIS IS THE MOST IMPORTANT PART. Give it the most words.\n'
  + '- Hard rules: at most three, and only rules that are true absolutely everywhere.\n'
  + '- Forbidden: what must never appear, if the author said so. Omit this line otherwise.\n\n'
  + 'No atmosphere. No imagery. No mood words. No adjective strings. No scene-setting. If a '
  + 'line reads like it belongs in a story rather than on a checklist, delete it.\n\n'
  + 'Do not name a single specific place, person, group or event. Those belong elsewhere, '
  + 'and anything named here is forced onto everything in the world.';

var CE_P_PLAY_TIER =
    'Write the VOICE tier of this world\u2019s charter.\n\n'
  + 'This goes to the story\u2019s narrator and to nothing else. It never reaches the '
  + 'tool\u2019s own writers, so it is about how the story READS, not about what is in the '
  + 'world.\n\n'
  + 'Two parts, under 120 words total:\n\n'
  + '- One bracketed line, exactly this shape and nothing else on it:\n'
  + '  [ Author: <name>; Title: <title>; Tags: <comma-separated>; Genre: <genre> ]\n'
  + '  Pick an author whose sensibility actually fits what the author described.\n'
  + '- The voice: name two authors whose combined sensibilities capture it, chosen for '
  + 'emotional register and prose rhythm rather than for genre, and set against each other '
  + 'rather than agreeing. Then say concretely what that produces \u2014 sentence length, '
  + 'how much description, how much interiority, how the prose handles feeling.\n\n'
  + 'No plot. No characters. No setting facts. Those are elsewhere, and repeating them here '
  + 'spends the narrator\u2019s attention twice.';

// [P-SUBSTRATE] THE HEAD, ASSEMBLED IN ONE PLACE. Every caller reads through this rather
// than concatenating its own order -- two assemblies is two prefixes, and two prefixes is
// a cache that is warm for neither.
// [P-STYLE-ABOVE-NAMING] PROMPTS 22 open item 1 -- style tier above or below NAMING -- is
// CLOSED, above, and the A/B is not worth running because the two arguments do not actually
// conflict once the session is the unit.
//
// The volatility case for putting NAMING first: it is byte-identical for every story and the
// style tier is per story, so 1.1's most-stable-first would sort it above. THAT CASE PAYS
// NOTHING. A session is one story, so the style tier is constant for its whole life and both
// orders are equally warm. Volatility ordering only earns anything where a block actually
// varies inside a cache's lifetime, and this one does not.
//
// So the choice is semantic, and 4.2 already made it: the style tier carries this world's
// actual sound, shape and example names, "the piece that makes the block setting-appropriate
// rather than merely setting-neutral". Conventions first, then the doctrine read in light of
// them.
//
// THE RECENCY COUNTER-ARGUMENT DOES NOT APPLY HERE, which is the part worth recording. A
// later block usually wins a conflict, so the specific tier would want to sit last -- but
// these two blocks do not compete. The style tier says how names SOUND; NAMING says what a
// name must not ANNOUNCE. They are complementary and there is nothing for recency to settle.
// If a future style tier starts contradicting NAMING, that is the signal to re-open this, and
// it is a one-line swap below.
//
// `family` picks exactly one of CHAT / MACHINE. `records` and `naming` are additive.
function ceBuildHead(opts: any): string {
    var o: any = opts || {};
    var parts: string[] = [];
    // [P-PERSONA] THE ONE BRANCH THAT REPLACES THE CORE RATHER THAN ADDING TO IT. `chat` and
    // `machine` are two registers of the same assistant and share CE_P_CORE; `persona` is not
    // that assistant at all. Handled here and returning early on the shared tail below, so
    // there is still exactly ONE assembler and no caller concatenates its own order.
    if (String(o.family) === 'persona') {
        parts.push(CE_P_PERSONA);
    } else {
        parts.push(CE_P_CORE);
        parts.push(String(o.family) === 'chat' ? CE_P_CHAT : CE_P_MACHINE);
    }
    if (o.records) parts.push(CE_P_RECORDS);
    var st = String(o.style || '').trim();
    if (st) parts.push('WORLD RULES \u2014 this applies to everything in this world:\n' + st);
    if (o.naming) parts.push(CE_P_NAMING);
    return parts.join('\n\n');
}

// ── [CHAT-HEADERS] CAPITALS ARE FOR INSTRUCTIONS, NEVER FOR MATERIAL ────────────
// A shouted heading is a style instruction whether or not it was meant as one. The persona
// channel's whole output is prose in a character's voice, and the model has no reliable way to
// tell a section label it should ignore from a register it should imitate -- it can only see
// that the text it was handed shouts.
// SO THE LINE IS DRAWN ON WHAT THE TEXT *IS*, not on where it sits:
//   INSTRUCTIONS keep their capitals. CE_P_CORE, CE_P_PERSONA and every other CE_P_* block lead
//   their clauses in caps, it is this file's house style for the system voice, and an imperative
//   addressed to the model is not something a character could imitate in a text message.
//   MATERIAL IS SENTENCE CASE. Blocks 4, 5 and 6 are a cast list, a journal and a dossier --
//   things the model reads ABOUT rather than is told to do. They now read 'Who else is in this
//   story', 'The story so far', 'Who you are'.
// THE NAME CAME OUT OF THE HEADINGS TOO. Block 6 opened four sections with the character's name
// in capitals -- WHERE KARA ZOR-EL IS NOW, HOW KARA ZOR-EL WRITES -- which shouted, spent tokens
// restating what the first line had already established, and read like a form rather than like
// someone's file. The block says who it is once, at the top, and is second person after that.
// 'The story so far' ALSO NOW MATCHES buildActiveJournalText's own wording, which is the phrase
// the journal already introduces itself with everywhere else in this file.

// ── [CHAT-PARTICIPANT] THE REINFORCEMENT BLOCK ───────────────────────────────
// WHO THIS PERSON IS, ASSEMBLED FOR THE PERSONA CHANNEL. It sits BELOW the shared prefix and
// is therefore re-encoded on every chat switch -- which is the correct place for it and also
// the reason it may be generous. Nothing above it names a character, so switching contact
// invalidates this block and nothing else.
//
// [CHAT-PARTICIPANT-NOLINE] THERE IS NO "COMPACT PERSONA LINE", and CE-SOCIAL 7.2 asking for
// one is DELETED rather than deferred. Three reasons, and the second is the one that matters:
//   1. It was justified by buildCharChatPersonaClause "compiling a full SMS register on every
//      call". That clause is Style / Length / Emoji plus notes -- some tens of tokens -- and
//      compiling it is string concatenation in a worker. A per-call COMPILE was being read as
//      a per-call COST. There is nothing there to save.
//   2. A cached identity summary would be A SECOND PROJECTION OF THE RECORD, which
//      buildLorebookContent's own header already forbids in as many words: it is the identity
//      authority for every other consumer, and a second projection drifts the first time a
//      field is added. That function ALREADY carries an `aether` style built for this exact
//      consumer, so the compact line would have been a third rendering of a record that has
//      two correct ones.
//   3. The compact reference already exists and is the DRAMATIS PERSONAE, which is shared
//      across every chat and sits in the cached prefix. A second compact reference per contact
//      would say the same thing one block lower and pay for it on every switch.
// So the split is: DP is thin and shared and cached; THIS is thick and per-contact and is not.
// Accepting that asymmetry is CE-SOCIAL's own [D], and this is what the thick half is.
//
// IT IS DELIBERATELY THICK. Off native Send nothing activates a lorebook entry for us -- the
// direct transport builds no story context at all -- so every word of identity that used to
// arrive through NAI's own assembly has to be placed here by hand. The failure this guards
// against is a character who is merely described rather than reinforced.
//
// FIVE SOURCES, EVERY ONE OF THEM AN EXISTING BUILDER. Nothing here re-derives a record.
//   identity   buildLorebookContent(char, 'aether') -- the card shape, per CC-AETHER
//   history    buildCharDynamicBlock -- equipment, states, conditions AND the character
//              journal, which is the fold this block gets for free [LOREFOLD]
//   register   buildCharChatPersonaClause -- how they text, gated on the mode as ever
//   standing   _ceRelPersonaColour -- where they stand with the people they know [REL-INJECT]
//   the other  the POV line, last, because it is the smallest and most volatile fact here
// A source that returns nothing contributes NO HEADING, not an empty one: a labelled blank
// tells the model a thing exists and that it has nothing, which is an invitation to invent it.
async function ceChatParticipantBlock(contact: CharacterRecord, povName: string, cfg: GlobalConfig): Promise<string> {
    var cpbOut: string[] = [];
    var cpbName = String((contact && contact.name) || 'They');

    var cpbId = '';
    try { cpbId = String(await buildLorebookContent(contact, 'aether') || '').trim(); }
    catch (eCpb1) { api.v1.error('[AE:chatpart] identity build failed:', eCpb1); }
    if (cpbId) cpbOut.push('Who you are \u2014 ' + cpbName + '\n' + cpbId);

    // [REL-ONE-SOURCE] skipPosition, because _ceRelPersonaColour below covers the same records
    // and covers MORE of them.
    var cpbDyn = '';
    try { cpbDyn = String(await buildCharDynamicBlock(contact, cfg, undefined, { skipPosition: true }) || '').trim(); }
    catch (eCpb2) { api.v1.error('[AE:chatpart] dynamic block failed:', eCpb2); }
    if (cpbDyn) cpbOut.push('Where things stand for you right now\n' + cpbDyn);

    // [CC-MODES] Gated exactly as buildCharChatInstruction gates it: the clause compiles an SMS
    // register and a spoken reply in textspeak is the failure that gate exists for.
    if (_ccMode().usesPersona) {
        var cpbReg = '';
        try { cpbReg = String(buildCharChatPersonaClause(contact) || '').trim(); }
        catch (eCpb3) { api.v1.error('[AE:chatpart] register clause failed:', eCpb3); }
        if (cpbReg) cpbOut.push('How you write\n' + cpbReg);
    }

    // [REL-ONE-SOURCE] THE BROAD PROJECTION WINS HERE, and the reason is the transport rather
    // than a preference. _ceRelFoldBlock filters to relationships whose OTHER party is
    // scenePresent, because it feeds a lorebook entry that fires while a scene is being written
    // and a standing with someone three rooms away is noise there. A text conversation is the
    // opposite case: you text the people who are NOT in the room, and the person on the other
    // end of this thread is very often exactly the one the fold would have dropped.
    // Both were firing until now and printed the same standing twice under two headings, which
    // is the ONE SITE rule broken in the plainest way -- two functions owning one data path.
    var cpbRel = '';
    try { cpbRel = String(await _ceRelPersonaColour(contact, cfg) || '').trim(); }
    catch (eCpb4) { api.v1.error('[AE:chatpart] relationship colour failed:', eCpb4); }
    if (cpbRel) cpbOut.push('Where you stand with people\n' + cpbRel);

    var cpbPov = String(povName || '').trim();
    if (cpbPov) cpbOut.push('You are talking to\n' + cpbPov + '.');

    return cpbOut.join('\n\n');
}

// [CHAT-PARTICIPANT] Blocks 1-3: the family head, the world's rules, and the mode's standing
// brief plus its standing output directives.
// THE MODE BRIEF IS HERE AND NOT IN THE TAIL, which is the change from the Send-era shape.
// buildCharChatInstruction had to push it at the bottom of context because the top was NAI's;
// on this channel the top is ours, and a standing brief identical for every turn of a thread
// belongs above the turns rather than being re-sent under each one.
// [CHAT-ASK-EMPTY] THE EMOTION AND ATTACHMENT DIRECTIVES MOVE UP HERE TOO, and that is the
// substantive change rather than a tidy-up. Both are CONSTANT across every turn of a thread --
// one is a property of the mode, the other of cfg.charChatImages -- and CE-SOCIAL 8.5's rule is
// that anything constant across turns is in the wrong place if it is in the ask. Sending them
// under every turn was a Send-era necessity, because the tail was the only position we owned.
// THEY DO NOT BREAK THE CACHE: a mode does not change mid-thread and a config toggle is not a
// per-turn event, so this head is stable for a session's worth of turns on one mode.
// [CHARCHAT-TAIL-TERMINAL] IS RETIRED ON THIS CHANNEL, and deliberately so. That invariant --
// nothing may follow the emotion directive, measured against four versions of empty replies --
// was about the SHAPE OF A TERMINAL BLOCK changing between turns when a conditional sat last in
// storyText's tail. Here nothing conditional sits last: the tail is a prefill on a real
// assistant turn [CHAT-REPLY-TAIL] and the conditionals are in a head that does not move.
function ceChatPersonaHead(styleTier: string, cfg: GlobalConfig | null): string {
    var cphMode = _ccMode();
    var cphParts: string[] = [ceBuildHead({ family: 'persona', style: String(styleTier || '') })];
    var cphBrief: string[] = ['This conversation', cphMode.framing, cphMode.register];
    if (cfg && (cfg as any).charChatImages) {
        // [CHARCHAT-IMG] Same clause the Send path carries, de-named: it said "anything <pov>
        // asks you to show" and a POV name in a shared head is exactly what block 6 exists to
        // keep out. "They" reads identically and costs one cache.
        cphBrief.push('You may attach a photo when it fits \u2014 a selfie, something you are '
            + 'looking at, or anything they ask you to show. Do it when it is natural, and always '
            + 'when asked. To attach one, put this on its own line AFTER your message text: '
            + '[Image: a clear description of what the photo shows] Describe the shot in plain '
            + 'words \u2014 what you are doing, wearing, where you are, the framing. Do not '
            + 'describe your own face or body; that is applied automatically. Never more than one '
            + 'photo per message.');
    }
    if (cphMode.usesEmotion) {
        // [CHARCHAT-EMOTION-LIST] Still no 24-word list: resolveEmotion/EMOTION_MAP maps 136
        // synonyms onto the canonical set and every reader runs through it.
        cphBrief.push('End every message with a new line reading: Emotion: <a single word for '
            + 'how you feel right now>');
    }
    cphParts.push(cphBrief.join('\n'));
    return cphParts.join('\n\n');
}

// [CHAT-CAST] BLOCK 4 -- THE DRAMATIS PERSONAE, WHOLE. CE-SOCIAL's [D] is that it is not
// lifted apart to pull the participants out, and the reason is a cache one: a DP that varied by
// which chat is open would break every block below it on every switch. Accepting that a
// participant reads thin here and thick in block 6 is the whole trade, and it is the right way
// round -- the thin copy is the one that is shared and therefore free.
// ONE PROJECTION, NOT A SECOND. buildCastLoreTexts is the same builder that composes the
// always-on lorebook entry, asked for the cast half only, so this channel cannot disagree with
// the story about who the cast is.
async function ceChatCastBlock(): Promise<string> {
    try {
        var ccbSt = await loadCastLore();
        if (ccbSt && ccbSt.castOn === false) return '';
        var ccbT: any = await buildCastLoreTexts(ccbSt, 'cast');
        var ccbBody = String((ccbT && ccbT.cast) || '').trim();
        return ccbBody ? ('Who else is in this story\n' + ccbBody) : '';
    } catch (eCcb) { api.v1.error('[AE:chatcast] cast block failed:', eCcb); return ''; }
}

// [CHAT-STORY-JRNL] BLOCK 5 -- THE LONG ARC, AS THE JOURNAL. It is already compressed, already
// curated, and already the artifact this project asks the model to write when it summarises a
// chat. That last part is what makes the loop close: ccSummarize writes a narrative recap into
// the journal and the journal is read back here, so a conversation that mattered becomes
// background for the next one without a second store or a second format.
// IT DOES NOT REPLACE THE STORY TAIL, and an earlier note here said it did -- that the journal
// and a raw excerpt were "two answers to what has happened" and carrying both paid twice for
// one fact. WRONG, and rewritten rather than qualified: they answer at two timescales, and a
// journal is BEHIND the story by construction because it is written after the fact. Dropping
// the tail left a character briefed on ancient history and blind to the room they are in.
// The tail is block 5b, immediately below this one. See [CHAT-SCENE].
//
// STABILITY, WHICH IS THE WHOLE REASON THIS BLOCK SITS ABOVE THE PARTICIPANTS. It changes only
// when the author writes or compresses a journal entry, and that does not happen mid-chat --
// so within a chatting session it is frozen while the contact below it changes constantly. That
// is [P-STYLE-ABOVE-NAMING]'s rule applied: order on what varies INSIDE a cache's lifetime, not
// on what looks volatile in the abstract.
// TRIMMED FROM THE OLDEST END, keeping reading order. The archive already holds what fell off
// the front, and a journal read out of order is a worse artifact than a short one.
var CE_CHAT_JRNL_TOKENS = 1200;
async function ceChatStoryBlock(cfg: GlobalConfig): Promise<string> {
    try {
        var csbSt = await loadJournal();
        var csbAll: any[] = (csbSt && csbSt.bubbles) ? csbSt.bubbles : [];
        var csbLive: any[] = [];
        var i = 0;
        for (i = 0; i < csbAll.length; i++) {
            if (csbAll[i] && !csbAll[i].archived && String(csbAll[i].text || '').trim()) csbLive.push(csbAll[i]);
        }
        if (!csbLive.length) return '';
        var csbModel = ceUtilityModel();
        // Drop the oldest until it fits. Measured per drop rather than estimated: the whole
        // point of a budget is that the number is real, and one encode per bubble on a block
        // built once per session is not a cost worth approximating away.
        var csbBody = buildJournalBody(csbLive as any, cfg);
        var csbTok = await wizCountTokens(csbBody, csbModel);
        var csbDropped = 0;
        while (csbTok > CE_CHAT_JRNL_TOKENS && csbLive.length > 1) {
            csbLive.shift();
            csbDropped++;
            csbBody = buildJournalBody(csbLive as any, cfg);
            csbTok = await wizCountTokens(csbBody, csbModel);
        }
        if (!csbBody.trim()) return '';
        return 'The story so far' + (csbDropped ? ' (earlier entries omitted)' : '') + '\n' + csbBody;
    } catch (eCsb) { api.v1.error('[AE:chatstory] journal block failed:', eCsb); return ''; }
}

// [CHAT-SCENE] BLOCK 5b -- WHAT JUST HAPPENED, WHICH IS NOT WHAT THE JOURNAL KNOWS.
// THE JOURNAL DOES NOT REPLACE THE LIVE STORY TAIL, and reading it as though it did was an
// over-application of the decision to drop the RAW EXCERPT as a *history* source. They answer
// two different questions at two different timescales:
//     block 5   the journal -- the long arc, compressed and curated, written retrospectively
//     block 5b  the tail    -- the last few hundred tokens of actual prose, what is happening
// A journal is always BEHIND the story by construction: it is written after a scene, or in a
// batch, or not for a while. If the author is writing a scene and texts a character mid-scene,
// the journal cannot tell that character what is going on around them right now -- it can only
// tell them what was true a few scenes ago. Both, or the character is well-briefed on ancient
// history and blind to the room.
//
// IT SITS *ABOVE* THE PARTICIPANT, and both of the ordering arguments agree for once.
//   SHARING: the tail is the same text whoever you are texting, so it belongs with the shared
//   blocks rather than being re-sent per contact.
//   VOLATILITY: it changes when the author writes PROSE, and an author writing prose is an
//   author who is not currently chatting. Within a chatting session it is frozen while the
//   contact below it changes constantly -- the same [P-STYLE-ABOVE-NAMING] reasoning that put
//   the journal here. Ordering the three by how often they actually move gives journal (rarely)
//   then tail (between sessions) then participant (constantly), which is this order.
//
// _charchatStoryTextAboveMarker IS REUSED RATHER THAN REPLACED, and a note recorded earlier
// that it becomes a deletion was wrong. It cuts at the chat marker and reads BACKWARD from
// there, which is correct in both worlds without a branch: while chats still live in the
// document it stops before them, and once they do not the marker is absent, the cut lands at
// the end, and it reads the tail of a document that is now pure prose. The migration needs
// nothing from it.
// ITS glm-4-6 TOKENIZER PIN IS LEFT ALONE. [PCP-TOKENIZER-SAME] measured the two vocabularies
// as identical, so it is already correct for either channel, and churning a function the Send
// path still calls to change nothing is not worth the flag day.
// 8000, VIA 700 AND 2400, and each of those was too small for the same reason: 700 was the
// EPHEMERAL path's budget on native Send, where NAI had already built the story context and the
// tail merely topped it up. On this transport there is no NAI context. Block 5b is the ONLY
// place the live story appears, so a supplement's ration became the whole meal without anyone
// changing the number. The instruction now is as much story as fits comfortably, not just the
// recent end, and 8000 is roughly six thousand words -- a good many scenes rather than a beat.
// GENEROUS IS CHEAP HERE because of WHERE it sits, not despite the size. The tail is in the
// SHARED prefix, so it is paid cold once and then bills at [PCP-CACHE-SPLIT]'s warm rate for
// every turn of the session afterwards -- 1193 against 41 on the measured prefix. Widening a
// cached block costs one call; the same tokens in a per-turn block would cost every call.
//
// [CHAT-TAIL-NOTADAPTIVE] IT IS A CONSTANT AND MUST STAY ONE, however tempting a remainder
// looks. "As much as fits" reads like an argument for computing this from what the other
// blocks left over -- target minus head minus cast minus participant minus turns. THAT WOULD
// DESTROY THE CACHE AND THE SAVING WOULD BE INVISIBLE WHILE IT HAPPENED. The turns grow by one
// every turn, so a tail sized against them changes every turn; the tail sits ABOVE the turns,
// so changing it invalidates the entire prefix below it. Every single message would cold-start
// the whole prompt -- 1193 instead of 41, forever, and nothing would look wrong. A fixed number
// is what keeps block 5b byte-identical across every contact and every turn, which is the
// property the whole ordering argument in CE-SOCIAL 8 exists to buy.
// THE REAL CEILING IS UNMEASURED. getAllowedInput reads ~57k on this account, but that is an
// allowance, not the model's context window, and xialong-v1's window is not documented anywhere
// this project can see. 8000 leaves the whole prompt near 12k, which is comfortable for any
// modern model. Revisit with a measurement once real threads exist, not with a guess.
var CE_CHAT_TAIL_TOKENS = 8000;
async function ceChatSceneBlock(): Promise<string> {
    try {
        var cscT = String(await _charchatStoryTextAboveMarker(CE_CHAT_TAIL_TOKENS) || '').trim();
        return cscT ? ('The current scene\n' + cscT) : '';
    } catch (eCsc) { api.v1.error('[AE:chatscene] story tail failed:', eCsc); return ''; }
}

// [CHAT-PREFIX] BLOCKS 1-5, THE SHARED PREFIX, ASSEMBLED IN ONE PLACE. Everything here is
// identical for every contact in a story, so it is what the cache is actually paid for --
// measured at [PCP-CACHE-SPLIT] as 1193 cold against 41 warm.
// NOTHING IN HERE MAY NAME A CHARACTER, which is the one invariant worth testing rather than
// asserting. The DP names the cast, and that is not the same thing: it names ALL of them, in a
// fixed order, so it is identical whichever chat is open. What must not appear is the SPEAKER
// being singled out -- that is block 6's job, and a name above this line invalidates every
// block below it on every switch.
async function ceChatSharedPrefix(styleTier: string, cfg: GlobalConfig): Promise<string> {
    var cspParts: string[] = [ceChatPersonaHead(styleTier, cfg)];
    var cspCast = await ceChatCastBlock();
    if (cspCast) cspParts.push(cspCast);
    var cspStory = await ceChatStoryBlock(cfg);
    if (cspStory) cspParts.push(cspStory);
    // [CHAT-SCENE] LAST OF THE SHARED BLOCKS, because it is the most volatile of them --
    // everything above survives an author writing a paragraph and this does not.
    var cspScene = await ceChatSceneBlock();
    if (cspScene) cspParts.push(cspScene);
    return cspParts.join('\n\n');
}

// ── [CHAT-THINK] THE THOUGHT, RE-IMPLEMENTED ─────────────────────────
// THE THOUGHT MOVES BACK IN FRONT OF THE REPLY. [CHARCHAT-THOUGHT-POST] records that it was a
// pre-reply call and was moved after, and that four attempts to make it describe the current
// moment each cost the reply itself. THAT CONSTRAINT WAS THE HOOK, NOT THE ORDERING: no
// api.v1.generate call may be made from onBeforeContextBuild, because it fires while the reply
// is already in flight and a nested call is rejected outright. Off Send there is no hook and no
// in-flight reply -- two sequential calls we make ourselves -- so the thought can describe the
// message it is actually reacting to instead of the one before it, which is what it was for.
//
// [CHAT-THINK-NONAME] IT NAMES NOBODY, AND THIS IS THE POINT OF REBUILDING IT RATHER THAN
// PORTING IT. buildChatThoughtSystemPrompt interpolated char.name and the POV name into roughly
// thirteen of its fifteen lines, so every character got a different system turn from its first
// sentence and nothing above it could ever cache. Here the head already says "you are that
// person" and block 6 already says who -- so the rubric is entirely second person and is BYTE-
// IDENTICAL for every character in every story. That is a testable claim, not a stylistic one.
//
// IT IS AN ASK, NOT A SYSTEM PROMPT, and that is what makes two calls cheaper than twice one.
// The thought and the reply share blocks 1-7 exactly -- same head, same participants, same
// turns -- and differ only in this trailing user message. So the second call of a turn re-uses
// the first call's warm prefix and pays for its own tail alone.
// [CHARCHAT-THOUGHT-NOSTYLE] survives: cfg.generalStyle is a story-PROSE guide and this is
// three labelled lines. It is not read here and no config path resurrects it.
// THE WORKED EXAMPLE STAYS. It is the cheapest lever on shape adherence there is, and it is
// generic -- "she", "he", a Friday -- so it introduces no name.
function ceChatThoughtAsk(): string {
    return [
        '[ Before you answer, write a private internal snapshot of how you are reading the last '
      + 'message. This is NOT a message. It will never be sent and the other person will never '
      + 'see it. Do not continue the conversation.',
        '',
        'Write EXACTLY three lines and nothing else. Each line starts with its label and a colon. '
      + 'Only the label is in capitals \u2014 the rest of the line is normal sentence case.',
        'EVENT: the specific thing in their last message you are reacting to \u2014 an actual '
      + 'phrase, question, refusal or silence, never a mood or an abstraction. One sentence.',
        'RESPONSE: your own unspoken thought, first person, in your own voice and cadence. Not a '
      + 'description of an emotion and not an emotion word. One sentence.',
        'DESIRE: what you intend to do with your reply right now \u2014 a bare verb phrase, under '
      + 'ten words, no subject.',
        '',
        'Example of the exact shape (illustrative only \u2014 never reuse these words):',
        'EVENT: She asked if he was still coming on Friday.',
        'RESPONSE: Here we go again \u2014 like I haven\u2019t already blown this once.',
        'DESIRE: Deflect until the plan firms up.',
        '',
        'No quotes. No JSON. No code fences. No name. No fourth line. ]'
    ].join('\n');
}

// ── [CHAT-THREAD] THE STORE ──────────────────────────────────────────
// Three functions and no cleverness. A thread that has never been written reads as an empty
// one rather than as null, because every caller would otherwise write the same guard.
function ceThreadKey(contactId: string, povId: string): string {
    return STORAGE_CHAT_THREAD_PFX + charChatEntryId(String(contactId || ''), String(povId || ''));
}

async function loadChatThread(contactId: string, povId: string): Promise<ChatThread> {
    var ctEmpty: ChatThread = {
        contactId: String(contactId || ''), povId: String(povId || ''), povName: '',
        mode: 'texting', messages: [], startedAt: Date.now(), updatedAt: Date.now()
    };
    try {
        var ctRaw: any = await api.v1.storyStorage.getOrDefault(ceThreadKey(contactId, povId), null);
        if (ctRaw && typeof ctRaw === 'object' && Array.isArray(ctRaw.messages)) {
            ctRaw.messages = ctRaw.messages.filter(function (m: any) { return m && typeof m.text === 'string'; });
            return ctRaw as ChatThread;
        }
    } catch (eCt) { api.v1.error('[AE:chatthread] load failed:', eCt); }
    return ctEmpty;
}

async function saveChatThread(thread: ChatThread): Promise<void> {
    try {
        thread.updatedAt = Date.now();
        await api.v1.storyStorage.set(ceThreadKey(thread.contactId, thread.povId), thread);
    } catch (eCts) { api.v1.error('[AE:chatthread] save failed:', eCts); }
}

// [CHAT-TURNS] BLOCK 7 -- THE TRANSCRIPT AS REAL MESSAGES, WHICH IS THE WHOLE POINT OF THE
// MOVE. On Send the transcript was prose inside one user turn, because the tail of storyText
// was the only position we owned [CHARCHAT-USERTOKEN]. Here each turn is its own message with
// its own role, which is the shape the model was trained on.
// THE CONTACT'S TURNS CARRY THEIR NAME HEADER AND THEIR EMOTION LINE. Both are deliberate and
// both are about the NEXT turn rather than this one: the header matches the prefill
// [CHAT-REPLY-TAIL] so a continuation is continuing something it has seen the shape of before,
// and the emotion line is the in-context example that keeps the model producing one.
// THE POV'S TURNS CARRY NO HEADER. They are the user role, there is only one of them, and a
// label on a message from the only other participant is a token spent saying nothing.
// [CHAT-TURN-WINDOW] HOW MANY TURNS REACH THE PROMPT, WHICH IS NOT HOW MANY THE WINDOW DRAWS.
// Two different limits with two different reasons, and conflating them would tie a rendering
// decision to a token budget:
//     THIS ONE bounds the PROMPT, because a thread grows without limit and block 7 would
//     eventually crowd out the story context above it.
//     THE VIEW's limit is the window's own, about scroll length and paint cost, and it can show
//     far more than this without any of it reaching a model.
//
// DROPPED IN CHUNKS, NOT ONE AT A TIME, and this is the part that is not obvious. A sliding
// window that keeps exactly the last N shifts on EVERY turn -- the oldest message falls off
// each time, block 7's first bytes change each time, and the cache dies on every message once
// a thread passes N. Dropping a BATCH when the cap is hit instead means the window is stable
// for CE_CHAT_TURN_DROP turns at a stretch, so a long thread cold-starts once every twenty
// messages rather than every one. Same average trimming, twenty times fewer cold starts.
// WHAT FALLS OFF IS NOT YET SUMMARISED, and that is the door rather than an oversight:
// ccSummarize already writes a narrative recap into the journal, and the journal is block 5.
// Feeding dropped turns through it would let an old conversation survive as story background
// instead of vanishing. Not built here; the trim point is the one place it would hook in.
var CE_CHAT_TURN_MAX = 60;
var CE_CHAT_TURN_DROP = 20;
function ceThreadTurnMessages(thread: ChatThread, contactName: string): any[] {
    var cttOut: any[] = [];
    var cttAll = (thread && thread.messages) ? thread.messages : [];
    var cttMsgs = cttAll;
    if (cttAll.length > CE_CHAT_TURN_MAX) {
        // THE START INDEX IS QUANTISED TO A MULTIPLE OF DROP, which is the whole mechanism.
        // Taking the last N instead (slice(len - N)) reads like the same thing and is not: its
        // start advances by one on every message, so block 7's first bytes change every turn
        // and the batching buys nothing. Anchoring the start to a DROP boundary means it holds
        // still for DROP messages and then jumps, so the window SIZE breathes between
        // MAX-DROP and MAX-1 while its CONTENT stays byte-stable in between. That is backwards
        // from how a window is usually written and it is the point: what must be stable here
        // is the PREFIX, not the length.
        var cttKeep = CE_CHAT_TURN_MAX - CE_CHAT_TURN_DROP;
        var cttStart = Math.floor((cttAll.length - cttKeep) / CE_CHAT_TURN_DROP) * CE_CHAT_TURN_DROP;
        cttMsgs = cttAll.slice(cttStart);
    }
    var i = 0;
    for (i = 0; i < cttMsgs.length; i++) {
        var m: any = cttMsgs[i];
        if (!m || !String(m.text || '').trim()) continue;
        if (m.role === 'pov') {
            cttOut.push({ role: 'user', content: String(m.text) });
        } else {
            var cttBody = String(contactName || 'They') + ': ' + String(m.text);
            // The stored replay uses the SAME constant the document path writes, so the model
            // sees one shape of emotion line across both transports during the migration.
            if (m.emotion) cttBody += '\n' + CHARCHAT_EMOTION_PREFIX + m.emotion;
            if (m.attachmentPrompt) cttBody += '\n[Image: ' + String(m.attachmentPrompt) + ']';
            cttOut.push({ role: 'assistant', content: cttBody });
        }
    }
    return cttOut;
}

// [CHAT-THINK] The snapshot handed to the reply call. A BRACKETED ASIDE IN THE USER ROLE, not a
// system turn: a system message arriving below the transcript would read as a new set of rules
// mid-conversation, and this is a note about the moment rather than a rule.
function ceChatThoughtNote(thought: any): string {
    if (!thought) return '';
    var ctnB: string[] = [];
    if (thought.eventAnchor) ctnB.push('You are reacting to: ' + String(thought.eventAnchor));
    if (thought.emotionalResponse) ctnB.push('Your unspoken thought: ' + String(thought.emotionalResponse));
    if (thought.immediateDesire) ctnB.push('What you want from this reply: ' + String(thought.immediateDesire));
    if (!ctnB.length) return '';
    return '[ Privately, before you answer:\n' + ctnB.join('\n')
        + '\nDo not restate any of this. Let it shape the reply and nothing else. ]';
}

// [CHAT-ATTACH] LIFT THE [Image: ...] TAG OUT OF THE BODY AND RETURN BOTH HALVES.
// WRITTEN HERE BECAUSE THERE WAS NO SUCH FUNCTION TO REUSE, which is worth stating rather than
// quietly adding a third: the Send path spreads this job over several sites -- _charchatImageRx
// to find, a resolved-form variant to re-find after stamping, and separate strip passes in the
// context and summary builders -- because the tag had to survive as DOCUMENT TEXT and be
// recognised again later. Off the document it does not survive as text at all: it becomes a
// FIELD on the message [CHAT-THREAD], so it is lifted once, here, at the moment the reply is
// parsed, and the body stored is already clean.
// _charchatImageRx IS REUSED for the matching itself, so the shape a model may write is still
// defined in exactly one place. The RESOLVED form is deliberately not handled -- an 8-hex
// stamp only ever existed to point into a document, and nothing on this path writes one.
// FIRST TAG WINS, matching the standing 'never more than one photo per message' directive; a
// model that writes two has already broken the brief and the second is silently dropped.
// [CHAT-ATTACH-INLINE] THE PHOTO IS GENERATED AS PART OF THE TURN, not staged for approval.
// Author's decision. The consequence to hold onto is that a bad prompt costs a real image
// generation, so the prompt the model writes is the last chance to get it right -- which is why
// the attachment clause in the head [CHAT-ASK-EMPTY] spends as many words as it does on what a
// good description contains. The window will fire this from attachmentPrompt on the returned
// message; busyStage 'image' keeps its existing meaning of a generation in flight.
function ceChatSplitAttachment(body: string): any {
    var casT = String(body || '');
    var casRx = _charchatImageRx();
    var casM = casRx.exec(casT);
    if (!casM) return { text: casT.trim(), prompt: '' };
    var casP = String(casM[1] || '').trim();
    var casClean = casT.replace(_charchatImageRx(), '').replace(/[ \t]+$/gm, '').trim();
    return { text: casClean, prompt: casP };
}

// ── [CHAT-SEND] ONE TURN, TWO CALLS ───────────────────────────────────
// THE TWO CALLS SHARE BLOCKS 1-7 EXACTLY and differ only after them, which is what makes the
// second one nearly free rather than a doubling:
//     thought   [system: 1-6][turns: 7][user: thought ask]
//     reply     [system: 1-6][turns: 7][user: thought note][assistant: prefill]
// Everything before the tail is byte-identical between them, so the reply call arrives on a
// prefix the thought call just warmed. This ONLY holds because the thought ask names nobody
// [CHAT-THINK-NONAME] and the standing directives sit in the head [CHAT-ASK-EMPTY]; either one
// leaking a per-turn detail upward would cost the sharing.
//
// THE THOUGHT RUNS FIRST AND IS DISCARDED ON FAILURE. It describes the message being answered,
// which is the thing [CHARCHAT-THOUGHT-POST] could not do from a hook, and if it fails the
// reply still goes out -- a turn with no snapshot is worse than one with, and infinitely better
// than none at all.
// SEQUENTIAL AWAITS, NEVER Promise.all: concurrent api.v1.generate calls serialize anyway, and
// the second's whole advantage is that the first has already warmed the prefix.
// NOTHING IS PERSISTED UNTIL BOTH CALLS ARE DONE. The POV message is appended to the in-memory
// thread so the model can see it, and the SAVE happens once at the end with both turns on it --
// so a failure mid-turn leaves the stored thread exactly as it was rather than holding a
// question nobody answered.
// [CHAT-TURN-CORE] ONE RUNNER, THREE DOORS. Send, press and regenerate differ in about six
// lines each and agree on everything else -- load, assemble, think, reply, parse, persist. Three
// copies of that would be three places to fix the next time the reply parse changes, which is
// the ONE SITE rule stated as a maintenance cost rather than as a principle. The public entry
// points below are thin on purpose.
//
// WHAT EACH DOOR ACTUALLY CHANGES:
//   send   appends a POV message first. The ordinary case.
//   press  appends nothing and adds a nudge note. The POV has not replied and the character
//          speaks again anyway.
//   regen  discards the last contact message and reuses its thought instead of thinking again.
//
// NOTHING IS PERSISTED UNTIL BOTH CALLS ARE DONE, and regen strengthens rather than weakens
// that: the discarded message is removed from the IN-MEMORY thread only, so a failed
// regeneration leaves the stored thread holding the original reply rather than nothing. A
// regenerate that eats your message when the network hiccups is the worst possible version of
// this control.
async function _ceChatTurn(contactId: string, povId: string, povName: string, opts: any): Promise<any> {
    var o: any = opts || {};
    var csCfg = await loadConfig();
    var csChar = await loadCharacter(String(contactId));
    if (!csChar) return { ok: false, reason: 'no such character' };

    var csThread = await loadChatThread(contactId, povId);
    csThread.povName = String(povName || csThread.povName || '');
    csThread.mode = _ccMode().id;

    // ── regen: lift the last contact turn back off, keeping its thought
    var csReuse: any = null;
    if (o.regen) {
        var csLast = csThread.messages.length ? csThread.messages[csThread.messages.length - 1] : null;
        if (!csLast || csLast.role !== 'contact') return { ok: false, reason: 'nothing to regenerate', thread: csThread };
        // [CHAT-REGEN-THOUGHT] The thought is REUSED, not re-run, and that is a claim about what
        // regenerate means rather than a saving. The thought is a reading of the POV's last
        // message, and that message has not changed -- so a second reading would answer a
        // question nobody asked again. What the author wants from this button is the same
        // intent said differently, which is exactly what one call at temperature 1.0 on an
        // unchanged prompt produces. It also halves the cost of the control.
        csReuse = csLast.thought || null;
        csThread.messages = csThread.messages.slice(0, csThread.messages.length - 1);
    }

    if (o.userText) {
        csThread.messages.push({
            id: 'm' + String(Date.now()) + '_' + String(api.v1.random.roll('1d100000').total),
            role: 'pov', text: String(o.userText), at: Date.now()
        });
    }

    var csStyle = '';
    try { var csC: any = await loadCharter(); csStyle = String((csC && csC.style) || ''); }
    catch (eCs0) { api.v1.error('[AE:chatturn] charter read:', eCs0); }

    var csShared = await ceChatSharedPrefix(csStyle, csCfg);
    var csPart = await ceChatParticipantBlock(csChar, csThread.povName, csCfg);
    var csSystem = [csShared, csPart].filter(Boolean).join('\n\n');
    var csTurns = ceThreadTurnMessages(csThread, csChar.name);
    var csBase: any[] = [{ role: 'system', content: csSystem }].concat(csTurns);
    var csModel = String(csCfg.charChatModel || CC_DEFAULT_MODEL);

    // [CHAT-PRESS] The nudge, added ONLY when the character is speaking into silence. If the
    // POV's message is still the last thing in the thread then pressing means \"answer that\",
    // which is the ordinary reply and needs no note at all -- so the note is decided from the
    // TRANSCRIPT rather than from which button was pushed.
    // IT IS NEVER STORED. A directive is not a turn: persist it and the thread fills with POV
    // messages the author never wrote, and every later prompt replays them as dialogue.
    var csTailMsg = csThread.messages.length ? csThread.messages[csThread.messages.length - 1] : null;
    var csSilent = !!(csTailMsg && csTailMsg.role === 'contact');
    var csNudge = '';
    if (o.press && csSilent) {
        csNudge = '[ They have not written back. Time has passed. Send another message anyway '
                + '\u2014 follow your last one, do not repeat it, and let the silence show in how '
                + 'you write. ]';
    }

    // ── call 1: the thought
    // [CHAT-PRESS] Silence needs no special rubric: ceChatThoughtAsk already names \"refusal or
    // silence\" among the things a character can be reacting to, so pressing reads as an event
    // rather than as a missing one. That was written for a different reason and happens to be
    // exactly right here.
    var csThought: any = csReuse;
    if (!csThought) {
        try {
            var csThinkMsgs = csBase.slice();
            if (csNudge) csThinkMsgs.push({ role: 'user', content: csNudge });
            csThinkMsgs.push({ role: 'user', content: ceChatThoughtAsk() });
            var csTR: any = await aeDiagGenerate('chat:thought:' + csChar.name, csThinkMsgs,
                { model: csModel, max_tokens: 220, temperature: 0.85 },
                undefined, 'background');
            var csTT = String((csTR && csTR.choices && csTR.choices[0] && csTR.choices[0].text) || '');
            if (csTT) csThought = _charchatParseThought(csTT);
        } catch (eCs1) {
            api.v1.error('[AE:chatturn] thought call failed (the reply still goes):', eCs1);
        }
    }

    // ── call 2: the reply
    var csTail = ceChatReplyTail(csChar.name, csThread.povName);
    var csMsgs = csBase.slice();
    if (csNudge) csMsgs.push({ role: 'user', content: csNudge });
    var csNote = ceChatThoughtNote(csThought);
    if (csNote) csMsgs.push({ role: 'user', content: csNote });
    csMsgs.push(csTail.prefill);

    var csRaw = '';
    try {
        var csRR: any = await aeDiagGenerate('chat:reply:' + csChar.name, csMsgs,
            { model: csModel, max_tokens: 400, temperature: 1.0, stop: csTail.stop },
            undefined, 'background');
        csRaw = String((csRR && csRR.choices && csRR.choices[0] && csRR.choices[0].text) || '');
    } catch (eCs2) {
        api.v1.error('[AE:chatturn] reply call failed:', eCs2);
        return { ok: false, reason: 'generation failed', thread: csThread };
    }
    if (!csRaw.trim()) return { ok: false, reason: 'empty reply', thread: csThread };

    // [CHAT-REPLY-TAIL] The net is DEMOTED, not deleted: `stop` ends the completion at a
    // LABELLED turn boundary, and charChatCleanReply still catches an unlabelled drift into
    // the other person's side that no stop string can see.
    var csClean = charChatCleanReply(csRaw, csChar.name, csThread.povName);
    var csEmotion = _ccEmotionSlot(charChatParseEmotion(csRaw));
    var csImg = ceChatSplitAttachment(csClean);
    var csText = csImg.text;

    csThread.messages.push({
        id: 'm' + String(Date.now()) + '_' + String(api.v1.random.roll('1d100000').total),
        role: 'contact', text: String(csText || '').trim(), at: Date.now(),
        emotion: csEmotion || undefined,
        attachmentPrompt: (csImg && csImg.prompt) ? String(csImg.prompt) : undefined,
        thought: csThought || undefined
    });
    await saveChatThread(csThread);

    return { ok: true, thread: csThread, emotion: csEmotion, thought: csThought,
             pressed: !!csNudge, regenerated: !!o.regen,
             attachmentPrompt: (csImg && csImg.prompt) ? String(csImg.prompt) : '' };
}

// The ordinary turn: the author writes something and the character answers.
async function ceChatSend(contactId: string, povId: string, povName: string, userText: string): Promise<any> {
    var csB = String(userText || '').trim();
    if (!csB) return { ok: false, reason: 'empty message' };
    return _ceChatTurn(contactId, povId, povName, { userText: csB });
}

// [CHAT-PRESS] Send with nothing to send. Two useful shapes fall out of one entry point and
// neither needed a flag: with the character's own message last it is a double-text, and with an
// EMPTY thread it is the character opening the conversation unprompted. The third case -- the
// POV's message still unanswered -- is just a reply, and _ceChatTurn decides that from the
// transcript rather than from here.
async function ceChatPress(contactId: string, povId: string, povName: string): Promise<any> {
    return _ceChatTurn(contactId, povId, povName, { press: true });
}

// Discard the character's last message and write a different one in its place.
async function ceChatRegenerate(contactId: string, povId: string, povName: string): Promise<any> {
    return _ceChatTurn(contactId, povId, povName, { regen: true });
}

// [CHAT-REPLY-TAIL] THE REPLY'S ASK IS EMPTY, AND THE TURN IS DRIVEN FROM A PREFILL.
// [PCP-PREFILL] measured it: a trailing assistant message ending mid-sentence is CONTINUED on
// both models -- "Kesserel: yeah, I" returned "'ll be there". So the name header stops being
// something we ask for and becomes something we WRITE, which is the same guarantee the Send
// path got from _charchatCanonContact, one layer earlier and for free.
// EVERYTHING THAT USED TO BE IN THE ASK IS NOW ABOVE. The mode brief, the emotion directive and
// the attachment clause are in the head [CHAT-ASK-EMPTY]; identity and register are in block 6.
// What is left is a header and a stop list, and CE-SOCIAL 8.5's test -- "if it is constant
// across turns of one thread it is in the wrong place" -- passes with nothing to move.
//
// STOP IS THE HEADER FORM, NEVER THE BARE NAME. `stop: ['\nBen:']` ends the completion when the
// model starts writing the other person's turn; `stop: ['Ben']` would truncate the reply at the
// first time the character says their name out loud, which in a text conversation is constantly.
// This is why charChatCleanReply's regex net is DEMOTED rather than deleted: stop handles the
// labelled case at the source, the net still catches an unlabelled drift into the other side.
function ceChatReplyTail(contactName: string, povName: string): any {
    var crtC = String(contactName || 'They').trim();
    var crtP = String(povName || '').trim();
    var crtStop: string[] = ['\n' + crtC + ':'];
    if (crtP) { crtStop.push('\n' + crtP + ':'); crtStop.push('\n\n' + crtP + ':'); }
    return {
        prefill: { role: 'assistant', content: crtC + ':' },
        stop: crtStop
    };
}


// ============================================================================
// SECTION 40 — BUILD SURFACE (jsx)  [BUILD-ONE-ROUTE]
//
// THE PIPELINE IS ONE ROUTE. Eight stages, one nav entry, internal navigation of its own.
// The alternative -- a route per stage -- would put eight cells on a nav row built for six
// and would make "where am I in this process" a question the shell answers badly.
//
// IT REACHES OUT AND KEEPS A WAY BACK. The full write of a record's fields happens on that
// record's own profile, using the per-field Generate button that already exists there; this
// surface sends the author to it and the head carries a trail back. That is why the stage
// list here is not also a record editor: COMMITTED RECORDS ARE EDITED WHERE THEY LIVE.
//
// THE HEAD HAS TWO MODES, chosen by depth. At depth 0 it is a SPINE -- how much of this is
// done -- and the whole strip is ONE door back to the stage list, not eight doors, because
// eight cells at this width are each under the 44px tap floor and eight destinations is
// what the stage list already is. At depth it is a TRAIL -- where am I -- truncated from
// the LEFT, because a breadcrumb that elides the current scope to show the world root has
// it backwards. Both modes are the same height so stepping in does not reflow the body.
//
// INSTRUCTION LIVES IN EMPTY STATES. A stage with nothing in it explains itself; the same
// stage with content shows only content. That is the whole of "walk a newcomer through
// without taxing a veteran" -- by the time someone is a veteran their stages have content,
// so they never scroll past a helper.
// ============================================================================

// The stage list. `built` is honest rather than aspirational: a stage with built:false
// renders as ahead-of-you on the spine and is not navigable, so nothing here is a door to a
// screen that does not exist.
// [BUILD-KINDS] WHAT A STAGE IS ABOUT, and the three facts that decide how much chrome it
// gets. Every difference between the stages is one of these, which is what lets one renderer
// serve all of them instead of six near-copies.
//   kind       the CE_ENTITY_CATALOGS entry, so ceSeedDefs and the commit path need no map
//   recursive  does a record of this kind CONTAIN others? Locations do and factions do, so
//              both get the trail and Step into. Species, items and threads do not, and for
//              them the workspace is one flat list with no depth to be at
//   ladder     does the hierarchy have NAMED SCALES? Only locations. A faction contains
//              factions without there being a word for how big each layer is, so the scale
//              form and the rung picker are location-only even though the recursion is not.
//              THESE TWO ARE SEPARATE FACTS and treating them as one is what would have made
//              a faction stage ask for a ladder it has no use for
//   lists      a flat kind that still divides, which is species and only species: peoples
//              and creatures, two lists and no depth. Sub-division is not recursion
var CE_BUILD_KINDS: any = {
    // `chatPfx` is the scope chat's address and is NOT derived from `kind`: locations were
    // addressed 'loc:' before there was a second kind, and deriving it now would orphan
    // every transcript already in a story.
    places: { kind: 'location',  recursive: true,  ladder: true,  lists: null, chatPfx: 'loc' },
    orgs:   { kind: 'faction',   recursive: true,  ladder: true,  lists: null, chatPfx: 'fac' },
    // [KIND-LIST] `lists` was the string 'species' and nothing read it. It is now the table
    // itself, and each entry carries the FACET SCOPE the list stands for -- which is not the
    // list id: the lists are people/bestiary and SPECIES_FACETS is scoped people/beast. An
    // identity map would have silently asked a creature the people questions.
    kin:    { kind: 'species',   recursive: false, ladder: false, chatPfx: 'spc',
              lists: [ { id: 'people',   label: 'Peoples',  scope: 'people' },
                       { id: 'bestiary', label: 'Bestiary', scope: 'beast'  } ] },
    things: { kind: 'item',      recursive: false, ladder: false, lists: null, chatPfx: 'itm' },
    arcs:   { kind: 'narrative', recursive: false, ladder: false, lists: null, chatPfx: 'nar' },
    cast:   { kind: 'character', recursive: false, ladder: false, lists: null, chatPfx: 'cha' }
};
// [KIND-LIST] A FLAT KIND THAT STILL DIVIDES. Species have no subspecies, so there is no
// depth and no ladder -- but there are two of them, and the division decides which questions
// are asked. So THE LIST PLAYS THE RUNG'S PART for a list kind: it is the standing pointer,
// it supplies the facet scope to ceSeedDefs, and it lands on the record as `speciesList`.
// What it does NOT do is carry a shape -- one shape per kind is enough, because the scope
// already separates the question sets and a peoples/creatures split in Classic-vs-Builder is
// a distinction no author has asked for.
function ceKindLists(kind: string): any[] {
    var k: string;
    for (k in CE_BUILD_KINDS) {
        if (String(CE_BUILD_KINDS[k].kind) !== String(kind || '')) continue;
        var l: any = CE_BUILD_KINDS[k].lists;
        return Array.isArray(l) ? l : [];
    }
    return [];
}
function ceKindListDef(kind: string, id: string): any {
    var list: any[] = ceKindLists(kind);
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) === String(id || '')) return list[i];
    }
    return list.length ? list[0] : null;
}
// [KIND-LIST] Does this kind's Build stage ask for a rung? Read off the table by KIND, the
// way _ceChatPfx is, because ceScopeWrite knows the kind and never the stage.
function ceKindLaddered(kind: string): boolean {
    var k: string;
    for (k in CE_BUILD_KINDS) {
        if (String(CE_BUILD_KINDS[k].kind) === String(kind || '')) {
            return !!CE_BUILD_KINDS[k].ladder;
        }
    }
    return false;
}
function ceBuildKind(stage: string): any {
    return CE_BUILD_KINDS[String(stage || '')] || null;
}
// [BUILD-KINDS] The chat prefix BY KIND rather than by stage. A pass knows which kind it is
// running on and never which stage asked for it, so the table is read the other way round.
// [BUILD-KINDS] Does this kind have a stage on the Build route? Retention, and anything
// else that should follow the route rather than a list of kind names, asks here.
function _ceKindHasStage(kind: string): boolean {
    var k: string;
    for (k in CE_BUILD_KINDS) {
        if (String(CE_BUILD_KINDS[k].kind) === String(kind || '')) return true;
    }
    return false;
}
function _ceChatPfx(kind: string): string {
    var k: string;
    for (k in CE_BUILD_KINDS) {
        if (String(CE_BUILD_KINDS[k].kind) === String(kind || '')) {
            return String(CE_BUILD_KINDS[k].chatPfx);
        }
    }
    return 'loc';
}

var CE_BUILD_STAGES: any[] = [
    { id: 'premise',  label: 'Premise',   built: true  },
    { id: 'charter',  label: 'Charter',   built: true  },
    { id: 'world',    label: 'World',     built: true  },
    // [SCOPE-ONE-STAGE] Scope and Locations were two stages and are one. WIZUI 5 gap 1
    // already puts the rung question "inline in S6's empty state at a new depth, as one
    // field" -- so keeping a separate form stage at depth 0 answered one question in two
    // different places depending on how deep the author was standing. One surface: no rung
    // yet renders the scale form, a rung renders the workspace, and that holds at every
    // depth. The count control does not vanish with the form; it becomes the workspace's
    // add-rows control, where it belongs once there is a list to add to.
    { id: 'places',   label: 'Locations', built: true  },
    // [BUILD-KINDS] The cascade WORLDPIPE 7.2 orders: locations, then the things that live
    // in them, then the people, then what they carry, then what happens. Each is declared
    // here before it is offered, so the order is a fact in one place rather than an
    // accident of when each one was written.
    { id: 'kin',      label: 'Species',   built: true  },
    // [BUILD-KINDS] THE SECOND KIND STAGE, and the one that proves the renderer. It shares
    // every line of the workspace with Locations and differs only in its table row -- so if
    // this one works, the remaining four are `built: true` plus a commit branch each.
    { id: 'orgs',     label: 'Factions',  built: true  },
    { id: 'cast',     label: 'Cast',      built: true  },
    { id: 'things',   label: 'Items',     built: true  },
    { id: 'arcs',     label: 'Threads',   built: true  },
    // [OPEN-WRITE] THE LAST STAGE AND THE ONLY ONE THAT IS NOT A QUEUE. Every stage above
    // it produces records; this produces one artifact, from all of them, and puts it in the
    // story. It is last because it reads everything above it.
    { id: 'open',     label: 'Opening',   built: true  }
];

// [SCOPE-ONE-STAGE] 'scope' is a RETIRED STAGE ID and normalises to 'places' rather than
// falling through to the charter, because a story whose tab state was saved on the old id
// would otherwise land somewhere it did not ask for.
function _ceBuildStage(): string {
    var t = ceTabGet('build', 'charter');
    if (t === 'scope') t = 'places';
    for (var i = 0; i < CE_BUILD_STAGES.length; i++) {
        if (CE_BUILD_STAGES[i].id === t && CE_BUILD_STAGES[i].built) return t;
    }
    return 'charter';
}

// -- Store --------------------------------------------------------------------
var ceBuildStore: any = null;
function ceBuildStoreInit(): void {
    if (ceBuildStore) return;
    try {
        ceBuildStore = createStore({ ready: false, stage: '', charter: null, sections: [],
                                    turns: [], rows: [], done: [], trail: [], scopeAt: '',
                                    rungHere: null, scopeSel: '', dockOpen: true,
                                    pending: false, chatBlock: '', seedDefs: [],
                                    chatKey: '', chatLabel: '', scopeShape: 'builder',
                                    kdef: null, listAt: '', listDefs: [], cfg: null,
                                    chatAddr: '' });
    } catch (e) { api.v1.error('[AE:build] store init failed:', e); }
}

async function cePublishBuild(): Promise<void> {
    ceBuildStoreInit();
    if (!ceBuildStore) return;
    try {
        var c = await loadCharter();
        var stg = _ceBuildStage();
        // [REC-CHAT] Which conversation is showing, read BEFORE the awaits because it
        // decides which transcript to load. '' is the scope chat.
        var prevSt: any = null;
        try { prevSt = ceBuildStore.get(); } catch (_ePb) { prevSt = null; }
        var chatKey = String((prevSt && prevSt.chatKey) || '');
        // [BUILD-CHAT] Only the stage that is showing loads its transcript. A publish that
        // read every scope's chat would grow with the world for a screen that renders one.
        // [BUILD-CHAT] The scoped chat is addressed by scope id -- 'loc:' plus the record the
        // author is standing in, or 'loc:top'. WORLDPIPE 9: ONE ACTIVE CHAT PER SCOPE, whose
        // job is to fill the question set for the scope you are standing in, and whose exit
        // is an extraction pass. Stepping in is therefore a different conversation, not a
        // filtered view of one.
        // [BUILD-KINDS] Every kind stage runs the same branch; only the table differs.
        var kdef: any = ceBuildKind(stg);
        var chatScope = stg;
        if (kdef) {
            // [KIND-LIST] A list kind's scope chat is addressed by LIST, because the two
            // lists are two conversations: what the peoples of this world are is not the
            // same subject as what hunts them, and one transcript answering both is paid
            // for on every seed call in each.
            var addrAt = ceKindLists(String(kdef.kind)).length
                ? await ceListLoadAt(String(kdef.kind))
                : await ceScopeLoadAt(String(kdef.kind));
            chatScope = chatKey
                ? ('rec:' + chatKey)
                : (String(kdef.chatPfx) + ':' + (addrAt || 'top'));
        }
        // [OPEN-WRITE] The Opening stage has a conversation like every other, on its own
        // address. It is named here rather than folded into the kdef test because it is not
        // a kind: there is no queue behind it and no records come out of it.
        if (stg === 'open') { chatScope = 'opn:top'; }
        var ch: any = (stg === 'premise' || stg === 'world' || stg === 'open' || !!kdef)
            ? await loadBuildChat(chatScope) : null;
        // [BUILD-WORLD] THE QUESTIONS ARE cfg.wizardSections, NOT A NEW LIST. That array is
        // already the world's question set, already editable on the old surface, and already
        // the thing assembleWizardMemory projects into NAI Memory. A second list beside it
        // would be a second source of truth about what this world's canon asks.
        var secs: any[] = [];
        if (stg === 'world') {
            var wcfg: any = await loadConfig();
            secs = (wcfg && wcfg.wizardSections && wcfg.wizardSections.length)
                 ? wcfg.wizardSections : DEFAULT_WIZARD_SECTIONS;
        }
        // [SCOPE-FORM] The queue is read only by the stage that renders it, on the same
        // rule as the transcript above: a publish that loaded every scope's drafts would
        // grow with the world for a screen that shows one rung.
        var qrows: any[] = [];
        var done: any[] = [];
        var trail: any[] = [];
        var atId = '';
        var rungHere: any = null;
        // [SCOPE-CHAT] The scoped chat's system tail, resolved HERE and nowhere else. The
        // dock needs it synchronously at render and the extraction pass needs the same
        // bytes asynchronously, so both read ceScopeChatBlock and one of them caches the
        // answer. Two assemblies would be two prefixes and a cache warm for neither.
        var chatBlk = '';
        // [SEED-ASK-SET] The asked set, resolved once per publish so the row editor and the
        // batch cannot disagree about which questions this rung has.
        var seedDefs: any[] = [];
        var chatLbl = '';
        // [ROW-RETAIN] entity id -> the staged row's fields, for the built list.
        var keptBy: any = {};
        var scopeShape = 'builder';
        var listAt = '';
        var listDefs: any[] = [];
        // [FIELD-MINT] The config, for the questions group's list of the author's own fields.
        // Loaded ONLY for a kind stage, on the same rule as the transcript and the queue: a
        // publish that read it for Premise would pay for a screen that has no fields on it.
        var pubCfg: any = null;
        if (kdef) {
            // A FLAT KIND IS ALWAYS AT THE TOP. It has no depth to be at, so the pointer is
            // never read and never minted -- rather than read and always ''.
            atId = kdef.recursive ? await ceScopeLoadAt(String(kdef.kind)) : '';
            // [KIND-LIST] Where the author is standing on a flat kind that divides. '' for
            // every kind that does not.
            listDefs = ceKindLists(String(kdef.kind));
            listAt = listDefs.length ? await ceListLoadAt(String(kdef.kind)) : '';
            var ladder: any[] = ceKindLadder(String(kdef.kind), c);
            var idx = await loadEntityIndex();
            // The trail, built by walking parents. [MAP-SELF]'s cycle guard applies: a node
            // whose ancestry loops is treated as a root rather than hanging the walk.
            if (atId) {
                var seen: any = {};
                var cur = atId;
                var guard = 0;
                while (cur && !seen[cur] && guard < 24) {
                    seen[cur] = true; guard++;
                    var mm: any = null;
                    for (var mi = 0; mi < idx.length; mi++) {
                        if (idx[mi] && String(idx[mi].id) === String(cur)) { mm = idx[mi]; break; }
                    }
                    if (!mm) break;
                    trail.unshift({ id: String(mm.id), label: String(mm.name || 'Unnamed') });
                    cur = String(mm.parentId || '');
                }
            }
            // Which rung the things at this scope sit at. At the top it is the ladder's
            // first; at depth it is the one after the parent's, which may not exist yet.
            if (!atId) {
                rungHere = ladder.length ? ladder[0] : null;
            } else {
                var parent = await loadEntity(atId);
                var pr = String((parent && (parent as any).rung) || '');
                rungHere = pr ? ceLadderNext(ladder, pr) : (ladder.length > 1 ? ladder[1] : null);
            }
            var rungId = rungHere ? String(rungHere.id) : '';
            var pcfg: any = await loadConfig();
            pubCfg = pcfg;
            scopeShape = ceKindShape(String(kdef.kind), rungHere, c);
            // [KIND-LIST] THE LIST SUPPLIES THE SCOPE WHERE THERE IS NO RUNG. That is the
            // whole of what makes a list a rung's equivalent: a rung decides what is asked
            // by being a scale, a list decides it by being a division, and ceSeedDefs
            // cannot tell them apart because it only ever sees the answer.
            var askScope = 'any';
            if (listDefs.length) {
                var lDef: any = ceKindListDef(String(kdef.kind), listAt);
                askScope = String((lDef && lDef.scope) || 'any');
            } else if (rungHere) {
                askScope = String(rungHere.scope || 'any');
            }
            seedDefs = ceSeedDefs(String(kdef.kind), askScope, pcfg, scopeShape);
            // [BUILD-CHROME] THE STAGE'S KIND, NOT 'location'. Every kind stage read the
            // location queue, so a faction stage listed locations, offered to name them,
            // and hid the faction rows ceScopeWrite had correctly staged.
            var ds = await loadWizardDraftsOfKind(String(kdef.kind));
            for (var di = 0; di < ds.length; di++) {
                var d: any = ds[di];
                if (!d) continue;
                if (String(d.parentId || '') !== String(atId || '')) continue;
                if (rungId && String((d.fields || {})[CE_DRAFT_RUNG_KEY] || '') !== rungId) continue;
                // [KIND-LIST] A draft staged before the list existed carries no listId, and
                // ceKindListDef's fallback puts it on the FIRST list rather than nowhere --
                // the same additive rule ceSpeciesList uses on the record side, so a row
                // written by the old wizard appears under Peoples instead of vanishing.
                if (listDefs.length) {
                    var dLd: any = ceKindListDef(String(kdef.kind), String((d as any).listId || ''));
                    if (String((dLd && dLd.id) || '') !== String(listAt || '')) continue;
                }
                // [ROW-RETAIN] A stamped row has already become a record and belongs in the
                // built list below, holding the lines that record was born with.
                var dTo = String((d.fields || {})[CE_DRAFT_DONE_KEY] || '');
                if (dTo) { keptBy[dTo] = d.fields; continue; }
                qrows.push(d);
            }
            // [NO-MANIFEST] Committed records at this scope are rows in the same list. A
            // committed row is not a different kind of thing, it is the same thing further
            // along -- which is what makes `committed` a derived state rather than a store.
            for (var ei = 0; ei < idx.length; ei++) {
                var m: any = idx[ei];
                if (!m || String(m.type) !== String(kdef.kind)) continue;
                if (String(m.parentId || '') !== String(atId || '')) continue;
                // [KIND-LIST] Committed records divide the same way the queue does, read
                // through ceSpeciesList so an unset value lands on Peoples rather than on
                // neither list.
                if (listDefs.length && String(kdef.kind) === 'species') {
                    var mLd = ceSpeciesList(m);
                    if (mLd === 'people' && String(listAt) !== 'people') continue;
                    if (mLd !== 'people' && String(listAt) === 'people') continue;
                }
                done.push({ id: String(m.id), name: String(m.name || 'Unnamed'),
                            kept: keptBy[String(m.id)] || null });
            }
            // [REC-CHAT-DERIVED] The pointer is VALIDATED against the list rather than
            // stored durably: stepping into a place leaves a chatKey naming a row of the
            // scope above, and a dock showing a conversation the surface has no row for is
            // worse than snapping back to the set.
            var keyOk = false;
            var kn = '';
            var ki = 0;
            for (ki = 0; ki < qrows.length; ki++) {
                if (String(qrows[ki].id) === chatKey) {
                    keyOk = true; kn = String((qrows[ki].fields || {}).name || ''); break;
                }
            }
            if (!keyOk) {
                for (ki = 0; ki < done.length; ki++) {
                    if (String(done[ki].id) === chatKey) {
                        keyOk = true; kn = String(done[ki].name || ''); break;
                    }
                }
            }
            if (chatKey && !keyOk) { chatKey = ''; }
            if (chatKey) {
                var kIntent = '';
                for (ki = 0; ki < qrows.length; ki++) {
                    if (String(qrows[ki].id) === chatKey) {
                        kIntent = String((qrows[ki].fields || {}).intent || ''); break;
                    }
                }
                chatBlk = await ceRecordChatBlock(kn, kIntent, atId, String(kdef.kind));
                chatLbl = kn;
            } else {
                chatBlk = await ceScopeChatBlock(atId, String(kdef.kind));
                var lLab = '';
                if (listDefs.length) {
                    var lD2: any = ceKindListDef(String(kdef.kind), listAt);
                    lLab = String((lD2 && lD2.label) || '');
                } else if (rungHere) {
                    lLab = _cePlural(String(rungHere.label));
                }
                chatLbl = lLab ? (lLab + ' \u2014 all of them') : 'All of them';
            }
        }
        ceBuildStore.set(function(prev: any) {
            return { ready: true, stage: stg, charter: c, sections: secs, rows: qrows,
                     done: done, trail: trail, scopeAt: atId, rungHere: rungHere,
                     chatBlock: chatBlk, seedDefs: seedDefs,
                     chatKey: chatKey, chatLabel: chatLbl, scopeShape: scopeShape,
                     kdef: kdef, listAt: listAt, listDefs: listDefs, cfg: pubCfg,
                     chatAddr: chatScope,
                     turns: ch ? ch.turns : [],
                     // [SCOPE-SEL-STORE] Surface-owned, so it survives a publish. It is
                     // cleared to '' only by the store's own init; a publish that reset it
                     // would snap the picker back to the saved rung every time a row was
                     // named.
                     scopeSel: prev ? String(prev.scopeSel || '') : '',
                     dockOpen: prev ? !!prev.dockOpen : true,
                     // A publish is the END of whatever was in flight. Anything that wants
                     // to stay pending across one sets it again after.
                     pending: false };
        });
    } catch (e) { api.v1.error('[AE:build] publish failed:', e); }
}

// The one-field patch. Used for flags the surface owns rather than storage does -- the dock's
// height and the in-flight latch -- so neither needs a round trip through cePublishBuild.
function ceBuildPatch(fn: (s: any) => any): void {
    if (!ceBuildStore) return;
    try {
        ceBuildStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:build] patch failed:', e); }
}

var _ceBuildChain: Promise<any> = Promise.resolve();
function ceBuildOp(fn: any): Promise<any> {
    _ceBuildChain = _ceBuildChain.then(fn, fn);
    return _ceBuildChain;
}

// -- The spine  [BUILD-ONE-ROUTE] ---------------------------------------------
// Segments are proportional flex cells, not fixed widths, so eight or twelve stages both
// fill the strip. The current one is wider AND accented -- width alone is ambiguous at 3px
// and colour alone is invisible to anyone who cannot see it.
// ════════════════════════════════════════════════════════════════════════════
// THE BAND SYSTEM  [BUILD-BANDS]
//
// EVERY BUILD STAGE EMITS THE SAME BANDS IN THE SAME ORDER, ALWAYS. A stage with
// nothing for a band omits it; it never reorders them.
//
//   0  WHERE YOU ARE   progress, name, what this does, what it produces
//   1  TALK            the conversation, in a container with edges
//   2  SET UP          what these are and what is asked of them; COLLAPSES once answered
//   3  THE WORK        the progression, the queue, the terminal action
//   4  WHAT EXISTS     committed records
//
// THE ORDER IS THE ORDER OF OPERATIONS, which is the whole design rule: downward is
// forward. You talk about a thing before you can say what scale it is; the scale exists
// before there are rows; rows exist before they are committed; records exist last.
//
// WHY THIS WAS NEEDED. Everything on this surface was a ceGroup -- CE-STYLE's FIELD
// density -- so "configure this kind once", "work these rows repeatedly" and "here is what
// exists" rendered identically, nine deep. That is not a spacing problem and no amount of
// gap fixes it: it is one density doing four jobs. ceGroup still exists and is still
// correct INSIDE a band, which is where field-shaped things live.
//
// A BAND IS NOT A BOX. Object density is the one density that draws a box (CE-STYLE 7.3)
// and it is reserved for the records themselves. A band is Field density's grouping
// vocabulary one level up: a rule, a numbered label, a state, and air.
// ════════════════════════════════════════════════════════════════════════════

// The three band states, DERIVED BY THE CALLER FROM ITS OWN DATA and never written as
// prose. 'done' is not praise and 'waiting' is not a warning; they answer "is there
// anything for me here", which is the question a stack of nine identical groups refused.
var CE_BAND_STATE: any = {
    waiting: { label: 'not yet', tone: 't3' },
    open:    { label: '',        tone: 't2' },
    done:    { label: 'done',    tone: 't3' }
};

// opts: { state, summary, openKey, count }
//   state    'waiting' | 'open' | 'done'
//   summary  the one line shown INSTEAD of the children when collapsed
//   openKey  present = collapsible. Absent = always open.
//   count    a number for the head's right edge
function ceBand(num: number, label: string, opts: any, children: any): any {
    var o: any = opts || {};
    var okey = String(o.openKey || '');
    var collapsible = !!okey;
    // [BUILD-BANDS] COLLAPSED IS THE DEFAULT ONLY WHERE THE CALLER SAYS IT IS ANSWERED.
    // _ceOpenIs is the surface-wide open map, so a band the author has opened stays open
    // across a publish -- which matters because every press on this surface republishes.
    var open = collapsible ? (!!_ceOpenIs(okey) || String(o.state || '') !== 'done') : true;
    var st: any = CE_BAND_STATE[String(o.state || 'open')] || CE_BAND_STATE.open;
    var right: any[] = [];
    if (o.count !== undefined && o.count !== null && String(o.count) !== '') {
        right.push(ceSub('t3', String(o.count)));
    }
    if (st.label) { right.push(ceSub('t3', String(st.label))); }
    if (collapsible) { right.push(ceSub('t3', open ? '\u2212' : '+')); }

    var head = h('div', {
        key: 'bandhead',
        role: collapsible ? 'button' : undefined,
        tabIndex: collapsible ? 0 : undefined,
        'aria-expanded': collapsible ? (open ? 'true' : 'false') : undefined,
        onClick: collapsible
            ? function() { ceTap('band:' + okey, function() { ceToggleOpen(okey); }); }
            : undefined,
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: collapsible ? CE_T.tap : undefined,
            paddingBottom: CE_T.s1,
            borderBottom: '1px solid ' + CE_LINE,
            cursor: collapsible ? 'pointer' : 'default'
        }
    }, [
        // The number is the band's whole claim to being a sequence. It is ceMono because it
        // is a figure in a row of words, and dimmed because it is scaffolding the author
        // reads once and then navigates by shape.
        h('div', { key: 'bn', style: { flex: '0 0 auto', opacity: CE_OP.t3 } },
          ceMono(String(num))),
        ceGrow(null, [ceKey(String(label))]),
        right.length ? ceInline({ gap: CE_T.s2, key: 'bnr' }, right) : null
    ]);

    return h('div', { key: 'band' + String(num), style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s3,
        paddingBottom: CE_T.s5
    } }, [
        head,
        (open || !collapsible) ? children
            : (String(o.summary || '') ? ceSub('t3', String(o.summary)) : null)
    ]);
}

// [BUILD-BANDS] BAND 0. Three parts and all three are REQUIRED, which is the point: a stage
// cannot be added to this surface without someone writing the sentence that says what it
// produces. That requirement is the only durable answer to a surface whose vocabulary --
// charter, rung, seed, shape, commit -- was all load-bearing and none of it introduced.
//   `does` says what happens here. `next` says what comes out and where it goes.
function ceStagePreamble(title: string, does: string, next: string): any {
    return ceStack(CE_T.s2, [
        ceD2(String(title)),
        ceProse('t2', String(does)),
        String(next || '') ? ceProse('t3', String(next)) : null
    ]);
}

// [BUILD-STEPS] THE PROGRESSION, DRAWN. add -> name -> seed -> commit is four acts and the
// only signal was a button label changing IN PLACE, so an author looked for the next step
// below the fold and there was nothing below the fold to find. Every value here is already
// derived by ceScopeRowState; none of this is new logic, it is the state finally being
// shown.
//   NOT A NAV. The cells are not doors -- the controls beneath them are. A step strip whose
//   cells were tappable would be a second way to do everything on the band, which is the
//   duplication this file removes everywhere else.
// steps: [{ label, state: 'done'|'now'|'wait', meta }]
function ceStepTrack(steps: any[]): any {
    var kids: any[] = [];
    for (var i = 0; i < (steps || []).length; i++) {
        var s: any = steps[i];
        if (!s) continue;
        kids.push(_ceStepCell(s, i, i === (steps.length - 1)));
    }
    return h('div', { key: 'steptrack', style: {
        display: 'flex', alignItems: 'stretch', gap: CE_T.s1
    } }, kids);
}
// Its own function: a closure built in a `var` loop captures the last cell.
function _ceStepCell(s: any, idx: number, last: boolean): any {
    var state = String(s.state || 'wait');
    var now = state === 'now';
    var done = state === 'done';
    return h('div', { key: 'stc' + String(idx), style: {
        flex: now ? '1.6 1 0' : '1 1 0',
        display: 'flex', flexDirection: 'column', gap: '3px',
        minWidth: 0
    } }, [
        // The bar. Full-strength currentColor for done and current, CE_LINE for waiting --
        // the spine's own two-signal arrangement, which was measured to work at 3px.
        h('div', { key: 'stb', style: {
            height: '3px', borderRadius: '2px',
            background: (done || now) ? 'currentColor' : CE_LINE,
            opacity: now ? '1' : (done ? '0.58' : '1')
        } }, null),
        ceTruncate(now ? 't1' : 't3', String(s.label || '')),
        String(s.meta || '') ? ceTruncate('t3', String(s.meta)) : null
    ]);
}

function _ceBuildSpine(stage: string): any {
    var segs: any[] = [];
    var here = 0;
    var i = 0;
    for (i = 0; i < CE_BUILD_STAGES.length; i++) {
        if (CE_BUILD_STAGES[i].id === stage) here = i;
    }
    for (i = 0; i < CE_BUILD_STAGES.length; i++) {
        segs.push(h('div', { key: 'bsp' + CE_BUILD_STAGES[i].id, style: {
            height: '3px',
            flex: (i === here) ? '2.2 1 0' : '1 1 0',
            // NO NEW COLOUR. CE_SEM.ok resolves to 'inherit', so tinting the current cell
            // with it would have drawn it identically to a done one and left WIDTH as the
            // only signal -- which is ambiguous at 3px. Full-opacity currentColor plus the
            // 2.2x width is two signals from tokens that already exist.
            background: (i > here) ? CE_LINE : 'currentColor',
            opacity: (i === here) ? '1' : (i < here ? '0.58' : '1')
        } }, null));
    }
    // THE WHOLE STRIP IS ONE DOOR, not eight. Eight cells at this width are each under the
    // 44px tap floor, and eight destinations is what the stage picker is for.
    return h('div', {
        role: 'button', tabIndex: 0, 'aria-label': 'Choose a stage',
        onClick: function() { ceTap('build:spine', function() { cePickerOpen('buildStage', {}); }); },
        style: { cursor: 'pointer', paddingBottom: CE_T.s2 }
    },
        // [BUILD-BANDS] THE TITLE IS GONE FROM HERE. Band 0's preamble carries the stage
        // name now, and a heading in both places was the same word at two weights on one
        // screen -- the collision the redesign exists to remove. What stays is the one thing
        // only the spine can say: where this stage sits in the ten.
        ceStack({ gap: '2px' }, [
            h('div', { style: { display: 'flex', gap: '3px' } }, segs),
            ceSub('t3', 'Step ' + (here + 1) + ' of ' + CE_BUILD_STAGES.length
                       + '  \u00b7  tap to jump')
        ])
    );
}

// -- Charter stage ------------------------------------------------------------
// [CHARTER] TWO TIERS AND NO THIRD. See SECTION 39's header for why canon is absent.
function _ceBuildCharterTier(label: string, hint: string, key: string, value: string): any {
    return ceGroup(label, ceStack(CE_T.s2, [
        ceProse('t3', hint),
        h(ceField, { k: 'chart:' + key, label: '', multiline: true, rows: 6, well: true,
            value: value,
            onCommit: function(v: string) {
                return ceBuildOp(function() { return ceCharterWrite(key, v); })
                    .then(cePublishBuild);
            } })
    ]));
}

// [G-04, one surface over] WHAT THE MODEL IS ACTUALLY TOLD, rendered as sent. The Author's
// Note earned this treatment for the same reason: an injected block nobody can read is a
// block nobody can debug, and "why does it keep writing that" has no other answer.
// COLLAPSED, AND THAT IS THE WHOLE LICENCE FOR IT EXISTING. A diagnostic that costs a fold
// is free; one that costs a screenful is a tax on everyone who is not debugging.
function _ceBuildHeadPreview(c: any, open: boolean): any {
    return ceAccordion({
        id: 'build:head', open: open,
        label: 'What every generation is told',
        summary: 'The exact text in front of the model before your ask',
        children: ceWell({ key: 'bhp_body',
            text: ceBuildHead({ family: 'machine', records: true, naming: true,
                                style: String((c && c.style) || '') }) })
    });
}

// [EMPTY-LEDE] AN EMPTY STATE INTRODUCES THE EDITOR; IT DOES NOT REPLACE IT. This function
// early-returned ceEmpty() when both tiers were blank, which is the state EVERY story starts
// in -- so the fields and the preview fold never rendered, there was nothing to type into,
// and the empty state was therefore unreachable-from as well as unhelpful. Reported as two
// separate faults ("nowhere to type", "no fold") that were one.
// THE RULE, and it is narrower than "instruction lives in empty states": where a surface is
// the ONLY way to create the thing it is empty of, its empty state is a LEDE above the
// controls. ceEmpty() is for a surface whose content is created somewhere else.
// This is READ-FIELD's rule one level up -- a read view that omits what is missing gives no
// way to add it -- and it cost the same bug.
function _ceBuildCharter(st: any): any {
    var c: any = st.charter || ceCharterEmpty();
    var blank = !String(c.style || '').trim() && !String(c.play || '').trim();
    return ceStack(CE_T.s2, [
        // [BUILD-COPY] "Charter" was the clearest case of a load-bearing word nobody
        // introduced. The heading now says what the page produces; the stored keys stay
        // `style` and `play`, on CHARTER-TIER-NAMES' rule that a label may move and a key
        // may not.
        ceStagePreamble('How it reads',
            'Two blocks of instructions that ride every generation this tool makes: what is '
            + 'always true in your world, and how the prose should sound.',
            'The first is stamped onto every record you build. The second goes to the story '
            + 'itself, through the Author\u2019s Note, as soon as you write it.'),
        blank ? ceProse('t3',
            'Nothing written yet. Write these yourself below, or let the Premise '
            + 'conversation write both of them for you.') : null,
        // [CHARTER-COMPRESS] THE WRITE BUTTON SITS ABOVE THE FIELDS IT WRITES. It was below
        // them, on the argument that rewriting is something you do while looking at what you
        // are about to replace -- which is true and is not where the control belongs. The
        // fields are two multiline boxes; a control under them is off-screen at the moment
        // it is wanted, and on a first run there is nothing above it to have read. A
        // destructive control is announced BEFORE its target, not discovered after it.
        // IT DISCARDS. Both tiers are overwritten by whatever comes back, so this is the one
        // destructive control on this surface and it says so rather than asking twice.
        ceBand(3, 'Write it from the Premise chat',
            { state: blank ? 'open' : 'done' }, ceStack(CE_T.s2, [
            ceProse('t3', 'Reads the Premise conversation and writes both blocks below. '
                + 'Anything already written there is replaced.'),
            ceBtn('Write the charter', 'build:compress', function() {
                return ceBuildOp(function() { return ceCompressCharter(); })
                    .then(function(msg: any) {
                        try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 5000 }); } catch (_e) {}
                        return cePublishBuild();
                    });
            }, blank ? 'primary' : undefined, 'Writing\u2026')
        ])),
        ceBand(4, 'What it says', { state: blank ? 'waiting' : 'done' }, ceStack(CE_T.s4, [
        // [CHARTER-TIER-NAMES] "Rules" AND "Voice", AND THE KEYS DO NOT MOVE. The first tier
        // was labelled Style, which sat one synonym away from Voice and described neither:
        // its contents are a premise, naming conventions, hard rules and a forbidden list.
        // The stored keys stay `style` and `play` on TAB-WORLD's rule -- renaming an id to
        // match a label is how a rename becomes a migration.
        _ceBuildCharterTier('What is always true',
            'Stamped onto every place, person and group this tool writes. What this world '
            + 'is, how names sound here, what is true everywhere, what must never appear. '
            + 'Instructions, not writing.', 'style', String(c.style || '')),
        // [CHARTER-AN] Voice reaches the Author's Note, and it does so on write -- see
        // ceCharterWrite. The hint says so because it is now true.
        _ceBuildCharterTier('How the prose sounds',
            'Goes to the story itself, through the Author\u2019s Note, as soon as you write '
            + 'it. How the writing reads \u2014 never what is in the world.',
            'play', String(c.play || ''))
        ])),
        _ceBuildHeadPreview(c, _ceOpenIs('build:head'))
    ]);
}

// -- The dock, hosted  [BUILD-CHAT] -------------------------------------------
// ONE HOST FOR EVERY STAGE THAT TALKS. Premise and World differ only in their scope id,
// their prompt block and their empty line -- everything else about wiring a dock is
// identical, and two copies of it is two places for the pending latch to be forgotten.
// [CHAT-PANEL] THE DOCK HAD NO EDGES. It paints its own ground and grows to 46vh inline in
// the same stack as everything else, with no rule above it and none below, so an author
// could not tell where the conversation ended and the page resumed. Closed, its only
// affordance was a small caret and a TRUNCATED COPY OF THE LAST MESSAGE -- which reads as a
// status line, not a door, which is why nobody found the chat by looking at it.
//
// THIS IS A WRAPPER, NOT A REWRITE. The dock's internals are right; what it lacked was a
// boundary and a name. The head says "Conversation" and carries the turn count; the last
// message drops to a dimmed preview line underneath, where it is a preview instead of a
// title.
function ceChatPanel(head: string, turnCount: number, dock: any): any {
    return h('div', { key: 'chatpanel', style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s2,
        borderTop: '1px solid ' + CE_LINE2,
        borderBottom: '1px solid ' + CE_LINE2,
        paddingTop: CE_T.s2, paddingBottom: CE_T.s2,
        background: CE_FILL
    } }, [
        ceInline({ gap: CE_T.s2, key: 'cph', pad: '0 ' + CE_T.s3 }, [
            ceGrow(null, [ceKey(String(head || 'Conversation'))]),
            ceSub('t3', turnCount
                ? (String(turnCount) + (turnCount === 1 ? ' turn' : ' turns'))
                : 'nothing said yet')
        ]),
        dock
    ]);
}

function _ceBuildDock(st: any, scope: string, block: string, empty: string, ph: string): any {
    var turns: any[] = st.turns || [];
    var lead = '';
    for (var i = turns.length - 1; i >= 0; i--) {
        if (turns[i] && String(turns[i].text || '').trim()) { lead = String(turns[i].text); break; }
    }
    if (!lead) lead = empty;
    return h(ceChatDock, {
        k: scope,
        open: !!st.dockOpen,
        onOpen: function(next: boolean) { ceBuildPatch(function() { return { dockOpen: !!next }; }); },
        turns: turns,
        lead: lead,
        pending: !!st.pending,
        placeholder: ph,
        onSend: function(text: string) {
            // SET BEFORE THE CHAIN, not inside it. ceBuildOp serialises against whatever is
            // already queued, so a latch set inside would appear only after the wait it
            // exists to explain.
            ceBuildPatch(function() { return { pending: true }; });
            return ceBuildOp(function() { return ceBuildChatSend(scope, block, text); })
                .then(cePublishBuild);
        },
        onEdit: function(id: string, text: string) {
            return ceBuildOp(function() { return ceBuildChatEdit(scope, id, text); })
                .then(cePublishBuild);
        },
        onDelete: function(id: string) {
            return ceBuildOp(function() { return ceBuildChatDelete(scope, id); })
                .then(cePublishBuild);
        }
    });
}

// -- World stage  [BUILD-WORLD] -----------------------------------------------
// [CHARTER-CANON-NONE] THESE ANSWERS ARE THE CANON TIER. There is no compression call for
// canon: what the author writes here IS the artifact, and NAI Memory is its projection
// through assembleWizardMemory, which already exists and already runs.
//
// THE AUTHOR'S-NOTE SECTIONS ARE NOT SHOWN HERE, and this is the flatten rather than a
// filter bug. Two of the ten defaults target the Author's Note, and the charter's Voice tier
// now owns that destination outright -- two writers into one place is the thing this design
// keeps removing. The sections are not deleted and an existing story's Author's Note keeps
// working; they simply are not part of the pipeline's question set.
//
// [WORLD-PICK] EVERY QUESTION CARRIES ITS SWITCH. It did not, and that was a silent data
// loss: `enabled` gates assembleWizardMemory, four of the eight canon defaults ship off, and
// this surface rendered all eight as boxes. Text typed into a switched-off question was
// saved to config and then dropped at the projection with nothing said. The switch is not a
// new feature; it is the missing half of a field that was always read.
//
// [WORLD-HELPER] THE HELPER IS THE BOX'S PLACEHOLDER, per SS7.6. A question with an answer
// shows the answer; a blank one explains what belongs in it, in the place the author is
// about to type. A prose line above the box would be a second element that outlives the
// blank state and has to be conditionally hidden -- the placeholder clears itself.
// What used to render here was `instructions`, which is the model's copy.
// [WIZUI-GUIDE] The three fold bodies. Functions rather than vars because two of them read
// CE_WORLD_PICK_ADD_MAX, and a top-level var reading another top-level var is the ordering
// hazard the Chat token group already paid for once.
// [KIND-NOUN] ONE GUIDE, ASSEMBLED FROM THE KIND'S OWN FACTS. It was three paragraphs of
// location prose shown on every stage, which told an author building factions that a house
// can sit directly inside a region. The middle paragraph is about the scope picker and the
// last is about stepping in, so both are CONDITIONAL on the same two facts the chrome is.
function _ceScopeGuide(kind: string, hasScopes: boolean, recursive: boolean): string {
    var noun = _ceKindNoun(kind);
    var pl = _cePlural(noun);
    var lists: any[] = ceKindLists(kind);
    var s = lists.length
        ? ('Say roughly how many of these there are. Blank rows are named for you later; '
           + 'type in any you already have in mind. The two lists above are separate sets '
           + 'with separate conversations, and which one you are in decides what each row '
           + 'is asked.')
        : ('Name what sits at this scale and roughly how many there are. Blank rows are '
           + 'named for you later; type in any you already have in mind.');
    if (hasScopes) {
        s += '\n\nThe scale below the name does not change what a ' + noun + ' can hold. It '
           + 'decides which questions are offered first when you open one.';
    }
    s += '\n\nOnce a ' + noun + ' is committed you can Open it to develop its fields';
    if (recursive) {
        s += ', or Step into it to name what is inside. A ' + noun + ' can skip a scale '
           + 'entirely \u2014 what that gap means is a true fact about your world, not '
           + 'something to fill in.';
    } else {
        s += '.';
    }
    return s;
}
// [KIND-SCOPE] _ceScopeScopeHint IS DELETED, superseded by ceKindScopeHint on the same
// argument as ceLadderScopeOk: it read hints out of the location table for every kind.
function _ceWorldPickGuide(): string {
    return 'Not every story has intimacy, or violence, or a world that departs from the '
         + 'ordinary \u2014 and some need a question none of the defaults cover.\n\n'
         + 'Choose and write questions reads your Premise conversation, switches on the '
         + 'questions this story has, and writes up to ' + String(CE_WORLD_PICK_ADD_MAX)
         + ' of its own where the list falls short. It never switches off one you have '
         + 'already answered.\n\n'
         + 'Write the blanks from the chat reads the conversation above and fills in the '
         + 'questions you have left empty. It never touches one you have written.';
}
function _ceWorldAddGuide(): string {
    return 'A question is a standing fact the narrator needs in every scene. A particular '
         + 'person, place or group is not one \u2014 those get records of their own further '
         + 'along.\n\n'
         + 'The line you write under \u201cWhat belongs in it\u201d is what you will read in '
         + 'the empty box, and what the writer is told when it fills one in.';
}
function _ceWorldSaveGuide(): string {
    return 'Assembles every switched-on question that has an answer into the story\u2019s '
         + 'Memory block, in the order above, and writes the Author\u2019s Note from the '
         + 'charter\u2019s Voice tier.\n\n'
         + 'Both are projections of what is already saved here, so pressing this twice does '
         + 'nothing the first press did not. Nothing on this screen reaches the story until '
         + 'you do press it.';
}

function _ceBuildWorldRow(sec: any, custom: boolean): any {
    var sid = String(sec.id);
    var on = !!sec.enabled;
    var body = String(sec.content || '');
    var help = ceWorldHelper(sec);
    return ceWrap({ key: 'wq:' + sid }, [ceStack(CE_T.s2, [
        // Label, and the switch on the same line as the thing it switches. A settings row
        // with its own heading and its own explanation is a paragraph of chrome per
        // question, repeated eight times, saying what a switch beside a name already says.
        ceRow(String(sec.label || 'Question'), null, ceInline({ gap: CE_T.s1 }, [
            custom ? ceIconBtn('Delete ' + String(sec.label || 'this question'), ceIconTrash(),
                'world:del:' + sid, function() {
                    return ceBuildOp(function() { return ceWorldSecDelete(sid); })
                        .then(cePublishBuild);
                }, 'danger') : null,
            ceToggle(on, 'world:on:' + sid, function() {
                return ceBuildOp(function() { return ceWorldSecWrite(sid, { enabled: !on }); })
                    .then(cePublishBuild);
            }, 'Ask ' + String(sec.label || 'this question'))
        ])),
        // [WORLD-HELPER] THE HELPER IS THE PLACEHOLDER. A blank box that explains itself is
        // the empty state SS7.6 asks for; a line of prose ABOVE the box is a second element
        // that survives into the answered state's layout and has to be conditionally hidden.
        // The box already has somewhere to put this and it disappears on its own when text
        // arrives.
        // A SWITCHED-OFF QUESTION HAS NO BOX, so its helper is the only thing to read and it
        // renders as prose. That is the one case where the line earns its space: it is what
        // the decision to switch it on is made from.
        on ? h(ceField, { k: 'world:' + sid, label: '', multiline: true, rows: 4, well: true,
                value: body,
                placeholder: help,
                onCommit: function(v: string) {
                    return ceBuildOp(function() {
                        return ceWorldSecWrite(sid, { content: String(v || '') });
                    }).then(cePublishBuild);
                } })
          : ceProse('t3', help),
        // [EXTRACT-REROLL] Only where there is something to replace or a chat to read it
        // from. A re-roll on a question nobody has discussed would spend a call to be told
        // the conversation has not settled it.
        on ? ceInline({ gap: CE_T.s2 }, [
            ceBtn('Re-roll from the chat', 'world:reroll:' + sid, function() {
                return ceBuildOp(function() { return ceWorldReroll(sid); })
                    .then(function(msg: any) {
                        try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 5000 }); } catch (_eRr) {}
                        return cePublishBuild();
                    });
            }, undefined, 'Re-rolling\u2026')
        ]) : null
    ])]);
}

function _ceBuildWorld(st: any): any {
    var secs: any[] = st.sections || [];
    var rows: any[] = [];
    var answered = 0;
    var asked = 0;
    var left = 0;
    for (var i = 0; i < secs.length; i++) {
        var sec: any = secs[i];
        if (!sec || sec.target === 'an') continue;
        if (sec.enabled) {
            asked++;
            if (String(sec.content || '').trim()) answered++;
        } else { left++; }
        rows.push(_ceBuildWorldRow(sec, !ceWorldIsDefault(String(sec.id))));
    }
    var tally = String(answered) + ' of ' + String(asked) + ' answered';
    if (left) tally += '  \u00b7  ' + String(left) + ' left out';
    var wTurns = ((st.turns || []) as any[]).length;
    return ceStack(CE_T.s2, [
        // ── BAND 0 ──
        ceStagePreamble('The world',
            'The facts that stay true for the whole story \u2014 the block the narrator '
            + 'reads before every scene. Talk them through, then let the engine work out '
            + 'which your story has and fill in what you already settled.',
            'Saving puts them in the story\u2019s Memory, where every generation sees '
            + 'them.'),
        // [EMPTY-LEDE] Above the questions, never in their place.
        answered ? null : ceProse('t3',
            'Nothing answered yet. Most stories need only a handful of these \u2014 '
            + 'leaving one out is a normal answer, not a gap.'),
        // ── BAND 1 · TALK ──
        ceBand(1, 'Talk it through', { state: wTurns ? 'open' : 'waiting' },
            ceChatPanel('Conversation', wTurns,
                _ceBuildDock(st, 'world', CE_P_WORLD,
                    'What is always true in this world?',
                    'Talk through the world\u2019s canon'))),
        // [WORLD-PICK] [WORLD-EXTRACT] The two passes sit together and in the order they are
        // used: choosing narrows the set, extracting fills what is left. Extracting first
        // would spend a call on every question the story does not have.
        // [WIZUI-GUIDE] WIZUI 3.2: NOTHING IN THIS PIPELINE GETS A PERMANENT PARAGRAPH OF
        // INSTRUCTION ON SCREEN. What a novice needs after the empty state is gone lives in a
        // GUIDE-BODY fold, which is a '?' on the group's own heading row rather than a line
        // of its own. Three paragraphs on this surface were standing prose and are now three
        // folds; the empty-state lede above stays, because 3.1 is what puts it there.
        // ── BAND 2 · SET UP ──
        ceBand(2, 'Which questions this story has',
            { state: asked ? 'done' : 'open',
              openKey: asked ? 'band:world:setup' : '',
              summary: tally },
            ceStack(CE_T.s4, [
        ceGroup('Start from the conversation', ceStack(CE_T.s2, [
            _ceGuideBar('', _ceWorldPickGuide()),
            _ceGuide(_ceWorldPickGuide(), true),
            ceInline({ gap: CE_T.s2 }, [
                ceBtn('Choose and write questions', 'world:pick', function() {
                    return ceBuildOp(function() { return ceWorldChoose(); })
                        .then(function(msg: any) {
                            try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 6000 }); } catch (_eW1) {}
                            return cePublishBuild();
                        });
                }, undefined, 'Choosing\u2026'),
                ceBtn('Write the blanks from the chat', 'world:extract', function() {
                    return ceBuildOp(function() { return ceWorldExtract(); })
                        .then(function(msg: any) {
                            try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 6000 }); } catch (_eW2) {}
                            return cePublishBuild();
                        });
                }, undefined, 'Writing\u2026')
            ]),
            ceSub('t3', tally)
        ])),
        // The author's own question. Two boxes and a button, read through ceFieldLive and
        // cleared through ceFieldSet [CHAT-SEND-LIVE] -- Add is a click and arrives before
        // the blur that would commit either box.
        // onCommit IS A NO-OP AND IS NOT OPTIONAL: ceField's blur handler calls p.onCommit
        // unguarded whenever the text changed, so a field without one throws into ceAction's
        // catch on every edit. These two boxes are read at the press, not at the blur.
        ceGroup('Add your own', ceStack(CE_T.s2, [
            _ceGuideBar('', _ceWorldAddGuide()),
            _ceGuide(_ceWorldAddGuide(), true),
            h(ceField, { k: 'world:new:label', label: 'Name', value: '',
                placeholder: 'Money, The Sea, Who Is In Charge\u2026',
                onCommit: function() { return Promise.resolve(); } }),
            h(ceField, { k: 'world:new:helper', label: 'What belongs in it', value: '',
                multiline: true, rows: 2,
                placeholder: 'One line \u2014 it is what you will read here when the box is empty, and what the writer is told\u2026',
                onCommit: function() { return Promise.resolve(); } }),
            ceBtn('Add question', 'world:add', function() {
                var lab = String(ceFieldLive('world:new:label') || '').trim();
                var hlp = String(ceFieldLive('world:new:helper') || '').trim();
                if (!lab) {
                    try { api.v1.ui.toast('Give it a name first.', { type: 'error', autoClose: 2400 }); } catch (_eW3) {}
                    return Promise.resolve();
                }
                ceFieldSet('world:new:label', '');
                ceFieldSet('world:new:helper', '');
                return ceBuildOp(function() { return ceWorldSecAdd(lab, hlp); })
                    .then(cePublishBuild);
            })
        ]))
        ])),
        // ── BAND 3 · THE WORK ──
        // The question rows stay FIELD density: they are many fields of ONE record -- the
        // world -- which is CE-STYLE 7.2 exactly. Object density is for the kind stages,
        // where the rows are distinct things.
        rows.length ? ceBand(3, 'Answer them',
            { state: (answered && answered === asked) ? 'done' : 'open',
              count: String(answered) + '/' + String(asked) },
            ceStack(CE_T.s4, rows)) : null,
        // [WIZUI-PRIMARY] WIZUI 3.3: ONE PRIMARY ACTION PER SURFACE, and on S4 it is the
        // projection into Memory -- "a novice can complete the entire pipeline by pressing
        // the obvious button on each screen." The other three controls on this surface are
        // secondary by omission; a second accent would make the rule say nothing.
        // IT IS SAFE TO OFFER FOREVER because Memory is a projection (WORLDPIPE 3.2) and
        // re-pressing it is idempotent. That is why the destructive-sounding half of the copy
        // is a fold and the one-line consequence is not.
        // [CHARTER-AN] It writes the Author's Note too, and the line says so: the Note is
        // resolved from the charter's Voice tier, which this button is not the only writer of
        // but is the one an author is looking at when the world changes.
        ceBand(4, 'Save to the story', { state: answered ? 'open' : 'waiting' },
            ceStack(CE_T.s2, [
            _ceGuideBar('', _ceWorldSaveGuide()),
            _ceGuide(_ceWorldSaveGuide(), true),
            ceSub('t3', 'Replaces the Memory block and the Author\u2019s Note region.'),
            ceBtn('Save to Memory', 'world:commit', function() {
                return ceBuildOp(function() {
                    return Promise.resolve(loadConfig()).then(function(fresh: any) {
                        return commitWizardMemory(fresh);
                    });
                }).then(function(ok: any) {
                    try {
                        api.v1.ui.toast(ok ? 'Written into Memory and the Author\u2019s Note.'
                                           : 'Could not write Memory.',
                            { type: ok ? 'success' : 'error', autoClose: 2800 });
                    } catch (_eW4) {}
                    return cePublishBuild();
                });
            }, 'primary', 'Saving\u2026')
        ]))
    ]);
}

// -- Locations workspace  [SCOPE-FORM] [LADDER] [SCOPE-DOOR] -------------------
// [SCOPE-ONE-STAGE] ONE SURFACE, TWO PHASES, AND THE SAME TWO AT EVERY DEPTH. No rung for
// this scope yet renders the scale form; a rung renders the workspace. WIZUI 5 gap 1 already
// put the rung question "inline in S6's empty state at a new depth, as one field" -- so a
// separate form stage at depth 0 answered one question in two places depending on how deep
// the author was standing.
//
// [LADDER-PER-PLACE] THE LADDER IS A DEFAULT AND THE PLACE DECIDES. Different things sit
// directly under a region -- a city here, a single house there -- so the rung below a record
// is offered, not imposed, and a skipped rung is a true fact about the world rather than a
// gap to fill (WORLDPIPE 6.4).
//
// [SCOPE-DOOR] A COMMITTED ROW HAS TWO DOORS AND THEY ARE NOT THE SAME DOOR.
//   Open       -> its profile, where the seeds this pipeline wrote sit above each field's
//                 instruction and the per-field Generate develops them. The Entity surface
//                 gains a door; it does not gain a batch generator.
//   Step into  -> this workspace, one scale down, naming what is inside it.
// Both carry the same thing -- which record, and which scope of work -- and both return
// through NAV-BACK's existing address rather than a second back button.
// One seed line. ITS OWN FUNCTION, not a loop body, because a handler built inside a `var`
// loop closes over the loop variable and every field would write the last question's id.
function _ceSeedFieldRow(did: string, def: any, value: string): any {
    var fid = String(def.id);
    return h(ceField, { k: 'seed:' + did + ':' + fid, label: String(def.label || 'Field'),
        value: String(value || ''), multiline: true, rows: 2,
        placeholder: String(def.hint || def.label || ''),
        onCommit: function(v: string) {
            return ceBuildOp(function() {
                return ceScopeRowWrite(did, CE_DRAFT_SEED_PFX + fid, v);
            }).then(cePublishBuild);
        } });
}

// [NO-MANIFEST] REVIEW IS THE RECORD. WORLDPIPE 10 answers "where does the author see this
// before it commits" with: here, in the row they are already looking at. Every seed is
// individually editable and individually deletable by emptying it, which is the whole of the
// review gate -- a separate screen of proposed answers would be a second copy of the list.
//
// THE FOLD IS BUILT ONLY WHEN IT IS OPEN. ceExpandRow takes its children as a prop, so they
// are constructed at the call site whether or not they render; twelve rows of ten fields is
// 120 components built to draw none of them.
//
// EVERY ASKED QUESTION GETS A BOX, ANSWERED OR NOT. A blank one is where the author types
// the steer the pass had nothing for, and that is the cheapest seed in the pipeline because
// it costs no call at all.
function _ceScopeRow(d: any, idx: number, rungLabel: string, defs: any[], openMap: any,
                     kKindRow: string): any {
    var did = String(d.id);
    var f: any = d.fields || {};
    var state = ceScopeRowState(d);
    var head = ceStack(CE_T.s1, [
        ceRow(state === 'queued' ? (rungLabel + ' ' + String(idx + 1)) : String(f.name || ''),
            null,
            ceIconBtn('Remove this ' + _ceKindNoun(kKindRow), ceIconTrash(),
                      'scope:del:' + did, function() {
                return ceBuildOp(function() { return ceScopeRowDelete(did); })
                    .then(cePublishBuild);
            }, 'danger')),
        h(ceField, { k: 'scope:name:' + did, label: '', value: String(f.name || ''),
            placeholder: 'Leave blank and the name pass will write one\u2026',
            onCommit: function(v: string) {
                return ceBuildOp(function() { return ceScopeRowWrite(did, 'name', v); })
                    .then(cePublishBuild);
            } })
    ]);
    if (state === 'queued' || !defs.length) {
        return ceWrap({ key: 'scr:' + did }, [head]);
    }
    var rowId = 'seedrow:' + did;
    var open = !!(openMap && openMap[rowId]);
    var filled = 0;
    var i = 0;
    for (i = 0; i < defs.length; i++) {
        if (String(f[CE_DRAFT_SEED_PFX + String(defs[i].id)] || '').trim()) filled++;
    }
    var kids: any[] = [];
    if (open) {
        // [DESC-MEANS] The label and placeholder come off the same table the seed pass
        // reads, so the box an author types into and the line the model is asked for cannot
        // describe different things. An item's is its worn appearance, which is what the
        // record's description column MEANS for an item.
        var descG: any = ceDescGloss(kKindRow);
        kids.push(h(ceField, { k: 'seed:sum:' + did, label: String(descG.label),
            value: String(f.description || ''), multiline: true, rows: 2,
            placeholder: String(descG.hint),
            onCommit: function(v: string) {
                return ceBuildOp(function() { return ceScopeRowWrite(did, 'description', v); })
                    .then(cePublishBuild);
            } }));
        for (i = 0; i < defs.length; i++) {
            kids.push(_ceSeedFieldRow(did, defs[i],
                String(f[CE_DRAFT_SEED_PFX + String(defs[i].id)] || '')));
        }
        // [SEED-REROLL] The answer to a bad seed, and the reason there is no review step
        // between the pass and the row: one call, no surface.
        kids.push(ceBtn('Re-seed this one', 'scope:reseed:' + did, function() {
            return ceBuildOp(function() { return ceSeedReroll(did, kKindRow); })
                .then(function(msg: any) {
                    try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 5000 }); }
                    catch (_eSr) {}
                    return cePublishBuild();
                });
        }, undefined, 'Re-seeding\u2026'));
    }
    return ceWrap({ key: 'scr:' + did }, [ceStack(CE_T.s2, [
        head,
        // [OPEN-SOLO] One row's seeds open at a time.
        ceExpandRow({ id: rowId, key: 'sx:' + did, label: 'Seeds', open: open,
            solo: 'seedrow:',
            summary: String(f.description || '').trim() || 'Nothing written yet',
            meta: String(filled) + '/' + String(defs.length),
            children: kids.length ? ceStack(CE_T.s2, kids) : null })
    ])]);
}

// A committed row. No name box -- the record owns its name now, and editing it here would be
// a second writer of one field with the profile.
// [ROW-RETAIN] The built row, and it can still show the lines the record was born with.
// READ-ONLY, because the record's fields are the live copy now and an editable second copy
// of an answer is the parallel structure SEED-IS-VALUE deleted. This is a receipt: what the
// pass wrote, still legible after generation has written over it on the record.
function _ceScopeDoneRow(rec: any, defs: any[], openMap: any, kdef: any): any {
    var rid = String(rec.id);
    var kKind = String((kdef && kdef.kind) || 'location');
    var kRec = !!(kdef && kdef.recursive);
    var kept: any = rec.kept || null;
    var acts = ceInline({ gap: CE_T.s1 }, [
        ceBtn('Open', 'scope:open:' + rid, function() {
            ceNav('entity', rid, '', ceScopeBackAddr());
            return Promise.resolve();
        }),
        // [BUILD-CHROME] A FLAT KIND HAS NOWHERE TO STEP. The button is absent rather than
        // disabled: there is no depth here to be denied.
        kRec ? ceBtn('Step into', 'scope:into:' + rid, function() {
            return ceBuildOp(function() { return ceScopeSetAt(rid, kKind); })
                .then(cePublishBuild);
        }) : null
    ]);
    var lines: any[] = [];
    if (kept) {
        var sum = String(kept.description || '').trim();
        if (sum) lines.push(ceSub('t3', sum));
        for (var i = 0; i < (defs || []).length; i++) {
            var v = String(kept[CE_DRAFT_SEED_PFX + String(defs[i].id)] || '').trim();
            if (!v) continue;
            lines.push(ceRow(String(defs[i].label || 'Field'), v, null));
        }
    }
    if (!lines.length) {
        return ceWrap({ key: 'scd:' + rid }, [ceRow(String(rec.name || 'Unnamed'), null, acts)]);
    }
    var kid = 'donerow:' + rid;
    return ceWrap({ key: 'scd:' + rid }, [ceStack(CE_T.s2, [
        ceRow(String(rec.name || 'Unnamed'), null, acts),
        ceExpandRow({ id: kid, key: 'dx:' + rid, label: 'Seeds it was built from',
            open: !!(openMap && openMap[kid]), solo: 'donerow:',
            meta: String(lines.length),
            children: (openMap && openMap[kid]) ? ceStack(CE_T.s1, lines) : null })
    ])]);
}

// [RUNG-PLURAL] THE LABEL IS THE AUTHOR'S AND MAY ALREADY BE PLURAL. Appending 's' gave
// "universess" on a ladder whose rungs were named Universes, Galaxies, Worlds -- which is
// the normal way to name a scale, since a rung describes a class of thing rather than one.
// English-lite and deliberately so: this is a label, not a language feature, and the only
// wrong answers worth preventing are the ones an author will actually see.
function _cePlural(label: string): string {
    var s = String(label || '').trim();
    if (!s) return 'places';
    var low = s.toLowerCase();
    if (low.charAt(low.length - 1) === 's') return low;
    if (/(x|z|ch|sh)$/.test(low)) return low + 'es';
    if (/[^aeiou]y$/.test(low)) return low.substring(0, low.length - 1) + 'ies';
    return low + 's';
}

// [KIND-NOUN] THE ROUTE'S WORD FOR A RECORD, READ FROM THE CATALOG IT ALREADY HAS.
// CE_ENTITY_CATALOGS has carried a `noun` per type since F-32 -- 'location', 'faction',
// 'item', 'species', and 'thread' for a narrative -- so the Build route needs no second
// table and cannot disagree with the profile about what a thing is called. A CHARACTER HAS
// NO CATALOG (its body is a graph object, not a question set), and the kind string is its
// own correct noun, which is why the fallback is the kind rather than a literal.
function _ceKindNoun(kind: string): string {
    var c = ceEntityCatalog(String(kind || ''));
    return String((c && c.noun) || String(kind || 'record'));
}
// Sentence-initial and label use. English-lite on _cePlural's own argument: this is a label,
// not a language feature.
function _ceKindNounCap(kind: string): string {
    var s = _ceKindNoun(kind);
    return s ? (s.charAt(0).toUpperCase() + s.substring(1)) : 'Record';
}

// [KIND-NOUN] EXAMPLE RUNG NAMES, per kind. This is a placeholder and nothing reads it back,
// so it is prose rather than a vocabulary -- but it is the one string an author reads before
// they know what the field wants, and 'Region, Ward, Deck' on the faction stage is the whole
// reported confusion in eleven characters. A kind with no entry gets a generic prompt rather
// than a wrong one.
var CE_KIND_RUNG_HINTS: any = {
    location:  'Region, Ward, Deck, District\u2026',
    faction:   'Power, House, Chapter, Cell\u2026',
    species:   'People, Kind, Lineage\u2026',
    item:      'Relic, Tool, Cargo\u2026',
    narrative: 'Arc, Thread, Movement\u2026',
    character: 'Cast, Circle, Household\u2026'
};
function _ceKindRungHint(kind: string): string {
    return String(CE_KIND_RUNG_HINTS[String(kind || '')]
        || ('What you call a group of ' + _cePlural(_ceKindNoun(kind)) + '\u2026'));
}

function _ceShapeLabel(shape: string): string {
    var s = String(shape || 'builder');
    if (s === 'classic') return 'Classic';
    if (s === 'custom') return 'Custom fields only';
    // [SEED-DEFS-CHAR] The character's third value. It reads as the template it is, not as
    // the internal word, on CHARTER-TIER-NAMES' rule: the label may move, the key may not.
    if (s === 'studio') return 'Profile template';
    return 'Lorebook Builder';
}

// [REC-CHAT] The chat strip. One line: which conversation, a door to the list of them, and
// the two verbs that keep the store from growing without a valve.
// [CHAT-KEEP] COPY AND CLEAR SIT TOGETHER, on the diagnostics log's exact idiom -- there is
// no confirm in this sandbox and none is invented, because a transcript the author has just
// copied is not a transcript they can lose. Clear is `danger` and says what it is about to
// take, and the count in its label is the only warning that can be honest here.
// [BUILD-CHAT] THE ADDRESS IS RESOLVED ONCE, IN cePublishBuild, AND READ HERE. It used to be
// derived twice -- publish built it from kdef.chatPfx, the strip and the dock spelled 'loc:'
// -- so on the faction stage the dock WROTE loc:top while publish READ fac:top, and every
// turn typed there landed in the location conversation and never came back.
//
// A SECOND DERIVATION IS NOT FIXED BY MAKING THE TWO AGREE; IT IS FIXED BY DELETING ONE.
// The kind-prefix version was corrected and then broke again the moment the Opening stage
// arrived: it is not a kind, so it has no kdef, so the fallback addressed its dock to
// 'loc:top' while publish read 'opn:top' -- the identical bug, from the identical cause, one
// stage later. Publish already knows the answer, so it stores it, and this reads it.
//
// THE FALLBACK IS RETAINED FOR ONE FRAME ONLY: the store is rendered once before the first
// publish completes, and a strip addressed to '' would post a turn into nowhere.
function ceBuildChatAddr(st: any): string {
    var stored = String((st && st.chatAddr) || '');
    if (stored) return stored;
    var key = String((st && st.chatKey) || '');
    if (key) return 'rec:' + key;
    var kd: any = (st && st.kdef) || null;
    var pfx = String((kd && kd.chatPfx) || 'loc');
    var at = ((st && ((st.listDefs || []) as any[]).length)
        ? String(st.listAt || '')
        : String((st && st.scopeAt) || ''));
    return pfx + ':' + (at || 'top');
}
function _ceChatStrip(st: any): any {
    var key = String(st.chatKey || '');
    var scope = ceBuildChatAddr(st);
    var label = String(st.chatLabel || 'This conversation');
    var turns: any[] = st.turns || [];
    var n = turns.length;
    return ceRow(label, null, ceInline({ gap: CE_T.s1 }, [
        ceBtn('Switch', 'chat:pick', function() {
            cePickerOpen('buildChat', {});
            return Promise.resolve();
        }),
        n ? ceBtn('Export', 'chat:export', function() {
            return api.v1.file.save(_ceChatFileName(label),
                ceBuildChatJson(label, scope, String(st.chatBlock || ''), turns)
            ).then(function() {
                try { api.v1.ui.toast('Exported \u2014 the turns and what the model is told.',
                    { type: 'success', autoClose: 2600 }); } catch (_eCc2) {}
                return null;
            }).catch(function(eCp: any) {
                try { api.v1.ui.toast('Export failed: ' + String((eCp && eCp.message) || eCp),
                    { type: 'error' }); } catch (_eCc3) {}
                return null;
            });
        }) : null,
        n ? ceBtn('Clear ' + String(n), 'chat:clear', function() {
            return ceBuildOp(function() { return ceBuildChatDrop(scope); })
                .then(function() {
                    try { api.v1.ui.toast('Conversation cleared. Anything already seeded '
                        + 'stays on the record.', { type: 'success', autoClose: 4000 }); }
                    catch (_eCc4) {}
                    return cePublishBuild();
                });
        }, 'danger') : null
    ]));
}

// [CHAT-HEAD-SLOT] The trail, at depth. ceScopeHead's two modes are chosen by depth and the
// spine already covers depth 0, so this is the other half rather than a second head.
// IT TRUNCATES FROM THE LEFT, keeping the last two segments: a breadcrumb that elides the
// current scope to show the world root has it backwards.
function _ceScopeTrail(trail: any[], kKindUp: string): any {
    var segs: any[] = [];
    var start = Math.max(0, trail.length - 2);
    if (start > 0) segs.push(ceSub('t3', '\u2026'));
    for (var i = start; i < trail.length; i++) {
        segs.push(ceSub('t3', (i > start || start > 0 ? '\u203a ' : '') + String(trail[i].label)));
    }
    var up = trail.length > 1 ? String(trail[trail.length - 2].id) : '';
    return ceRow('In', ceInline({ gap: CE_T.s1 }, segs),
        ceBtn(trail.length > 1 ? 'Up' : 'Top', 'scope:up', function() {
            return ceBuildOp(function() { return ceScopeSetAt(up, kKindUp); })
                .then(cePublishBuild);
        }));
}

// [KIND-LIST] THE LIST BAR, and it sits exactly where the trail sits for a recursive kind
// -- both answer "where am I standing", and a kind has one or the other and never both.
// SEG-BAR is the existing primitive for N short doors in one enclosure, which is what this
// is: two cells, one of them current.
function _ceListBar(kind: string, defs: any[], at: string): any {
    var cells: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        var d: any = defs[i];
        var isAt = String(d.id) === String(at || '');
        cells.push({ id: String(d.id), label: String(d.label), current: isAt });
    }
    var kids: any[] = [];
    for (var j = 0; j < cells.length; j++) {
        kids.push(_ceListCell(kind, cells[j]));
    }
    return ceInline({ gap: CE_T.s1 }, kids);
}
// Its own function because a closure over the loop variable inside _ceListBar would capture
// the last cell for every button -- the classic one, and this file has no `let` to fix it.
function _ceListCell(kind: string, cell: any): any {
    var cid = String(cell.id);
    return ceBtn(String(cell.label), 'list:' + kind + ':' + cid, function() {
        return ceBuildOp(function() { return ceListSetAt(kind, cid); })
            .then(cePublishBuild);
    }, cell.current ? 'primary' : undefined);
}

// [FIELD-MINT] THE QUESTIONS GROUP, and it is NOT the second schema editor SHAPE-ASKS
// forbids. That rule is about a screen that duplicates the shape picker's decision -- WHICH
// set of questions is asked. This decides what is IN the author's own set, which is
// ENT-CF-DOOR's job and has always lived beside the record; the Build route is simply the
// other place an author is looking at a kind, and at Build time there is no record to put
// the door on. One writer (ceCustomFieldDefine), two doors.
//
// [EMPTY-LEDE] IT LEADS WITH THE PROBLEM WHEN THERE IS ONE. An item's catalog is empty and
// `custom` shape empties any kind's, so the Seed button on those stages has nothing to ask
// and no way to say why. The lede is the only place that can say it.
function _ceBuildFields(st: any, kKind: string, kNoun: string, seedDefs: any[],
                        chatScope: string, hasTurns: boolean): any {
    var none = !seedDefs.length;
    var cfg: any = st.cfg || null;
    var cat: any = ceEntityCatalog(kKind);
    var own: any[] = (cat && cfg && Array.isArray(cfg[cat.cfgKey])) ? cfg[cat.cfgKey] : [];
    var pl = _cePlural(kNoun);
    var rows: any[] = [];
    for (var i = 0; i < own.length; i++) {
        rows.push(_ceBuildFieldRow(kKind, own[i]));
    }
    return ceGroup(none ? ('Nothing is asked of a ' + kNoun + ' yet') : 'Questions',
        ceStack(CE_T.s2, [
        none ? ceProse('t3', 'A ' + kNoun + ' has no built-in questions, so the Seed pass has '
            + 'nothing to write. Write them from what you have said below, or add them '
            + 'yourself \u2014 either way they are asked of every ' + kNoun + ' from then on.')
             : ceSub('t3', String(seedDefs.length) + ' asked of every ' + kNoun
                    + (own.length ? (' \u00b7 ' + String(own.length) + ' of them yours') : '')),
        // The pass, offered only when there is a conversation for it to read. A button that
        // cannot work yet is a promise the surface cannot keep -- SEED-CALL's own rule.
        hasTurns ? ceBtn('Write questions from this chat', 'fields:mint', function() {
            return ceBuildOp(function() {
                return ceFieldMint(kKind, chatScope, String(st.chatBlock || ''));
            }).then(function(msg: any) {
                try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 7000 }); }
                catch (_eFm1) {}
                return cePublishBuild();
            });
        }, none ? 'primary' : undefined, 'Reading\u2026') : null,
        hasTurns ? null : ceSub('t3', 'Talk these through below and this can write them for '
            + 'you, or add one now.'),
        h(ceField, { k: 'fields:label', label: 'Add a question', value: '',
            placeholder: 'A short label \u2014 \u201cWho made it\u201d\u2026',
            onCommit: function() { return Promise.resolve(); } }),
        h(ceField, { k: 'fields:hint', label: '', value: '',
            placeholder: 'One line saying what belongs in the answer\u2026',
            onCommit: function() { return Promise.resolve(); } }),
        ceBtn('Add it', 'fields:add', function() {
            // [CLICK-BEFORE-BLUR] Both boxes read at press time.
            var lab = String(ceFieldLive('fields:label') || '').trim();
            var hnt = String(ceFieldLive('fields:hint') || '').trim();
            if (!lab) {
                try { api.v1.ui.toast('Give the question a label first.',
                    { type: 'error', autoClose: 2400 }); } catch (_eFa1) {}
                return Promise.resolve();
            }
            return ceBuildOp(async function() {
                var c2: any = await loadConfig();
                var n0: number = (Array.isArray(c2[cat.cfgKey]) ? c2[cat.cfgKey].length : 0);
                await ceCustomFieldDefine(kKind, lab, hnt, '', c2);
                var n1: number = (Array.isArray(c2[cat.cfgKey]) ? c2[cat.cfgKey].length : 0);
                if (n1 > n0) { await saveConfig(c2); }
                return n1 > n0;
            }).then(function(made: any) {
                ceFieldSet('fields:label', '');
                ceFieldSet('fields:hint', '');
                try { api.v1.ui.toast(made
                    ? ('Asked of every ' + kNoun + ' from now on.')
                    : 'That question is already being asked.',
                    { type: made ? 'success' : 'info', autoClose: 3000 }); } catch (_eFa2) {}
                return cePublishBuild();
            });
        }),
        rows.length ? ceStack(CE_T.s1, rows) : null,
        rows.length ? ceSub('t3', 'Edit the wording or the generator instructions on any '
            + pl + ' profile.') : null
    ]));
}
// Its own function so the delete closure captures one field and not the loop's last.
// [DESTRUCTIVE-NEVER-IN-PLACE] is NOT breached by the absence of a confirm here: this
// removes a question the author added minutes ago on the same screen, and _ceEntityFieldsDrill
// keeps the two-phase delete for the profile, where the field may be years old and carry
// answers on every record. Written text is not erased either way.
function _ceBuildFieldRow(kKind: string, d: any): any {
    var did = String((d && d.id) || '');
    var lab = String((d && d.label) || 'Field');
    return ceRow(lab, null,
        ceIconBtn('Remove ' + lab, ceIconTrash(), 'fields:del:' + did, function() {
            return ceBuildOp(async function() {
                var cat = ceEntityCatalog(kKind);
                if (!cat) return false;
                var c3: any = await loadConfig();
                var arr: any[] = Array.isArray(c3[cat.cfgKey]) ? c3[cat.cfgKey] : [];
                var keep: any[] = [];
                for (var i = 0; i < arr.length; i++) {
                    if (arr[i] && String(arr[i].id) === did) continue;
                    keep.push(arr[i]);
                }
                c3[cat.cfgKey] = keep;
                await saveConfig(c3);
                return true;
            }).then(cePublishBuild);
        }, 'danger'));
}

// [OPEN-WRITE] THE OPENING SURFACE. Not a workspace: there is no queue, no rung, no commit.
// One conversation, one Write, one box, one Place.
//
// [OPEN-PLACE] WRITING AND PLACING ARE TWO ACTS AND THE SURFACE SAYS SO. The generated text
// lands in an editable box on the charter and goes into the document only when the author
// presses the second button -- DESTRUCTIVE-NEVER-IN-PLACE, applied to the one control in
// this pipeline that touches the story. Placing is also not consuming: the draft stays, so
// an author who places, dislikes it and undoes in NAI has not lost the text.
function _ceBuildOpening(st: any): any {
    var c: any = st.charter || ceCharterEmpty();
    var draft = String((c as any).opening || '');
    var has = !!draft.trim();
    var turnsN = ((st.turns || []) as any[]).length;
    return ceStack(CE_T.s2, [
        // ── BAND 0 ──
        ceStagePreamble('The opening',
            'Writes the first paragraphs of the story from everything you have built. It '
            + 'reads what the world has settled and who and what exists in it \u2014 but it '
            + 'writes a scene, not an introduction to your setting.',
            'Nothing reaches the story until you press Place. You can edit it first.'),
        // ── BAND 1 · TALK ──
        // [OPEN-CHAT-FIRST] The conversation comes before the button that consumes it, and
        // is not gated on a draft existing: a chat that appears only after the first write
        // is a chat that cannot shape the first write.
        ceBand(1, 'Talk it through', { state: turnsN ? 'open' : 'waiting' },
            ceStack(CE_T.s2, [
                _ceChatStrip(st),
                ceProse('t3', turnsN
                    ? 'This conversation is read when the opening is written.'
                    : 'Say where it should start, whose eyes it is through, or what is '
                      + 'happening \u2014 or write first and talk after.'),
                ceChatPanel('Conversation', turnsN,
                    _ceBuildDock(st, 'opn:top', '',
                        'How should the story open?',
                        'Say how it should start'))
            ])),
        // ── BAND 3 · THE WORK ──
        ceBand(3, 'Write it', { state: has ? 'done' : 'open' }, ceStack(CE_T.s2, [
            _ceGuideBar('', _ceOpeningGuide()),
            _ceGuide(_ceOpeningGuide(), true),
            h(ceField, { k: 'open:hint', label: 'Anything it should do', value: '',
                multiline: true, rows: 2,
                placeholder: 'Optional \u2014 whose eyes, where, what is happening\u2026',
                onCommit: function() { return Promise.resolve(); } }),
            // [OPEN-BUDGET] The author's, not a constant. An opening is the one artifact
            // whose right length is a taste question -- two paragraphs or two pages -- and
            // the pass had 900 tokens hardcoded with nothing on screen saying so.
            ceNumField({ k: 'open:budget', label: 'How long, in tokens', hint: '200\u20132000',
                value: Math.max(200, Math.min(2000, Number((c as any).openingBudget) || 900)),
                min: 200, max: 2000,
                onCommit: function(v: number) {
                    return ceBuildOp(function() {
                        return ceCharterWrite('openingBudget', String(v));
                    }).then(cePublishBuild);
                } }),
            ceBtn(has ? 'Write it again' : 'Write the opening', 'open:write', function() {
                // [CLICK-BEFORE-BLUR] Read at press time, not from an event cache.
                var hint = String(ceFieldLive('open:hint') || '').trim();
                var bud = ceFieldLiveNum('open:budget',
                                         Number((c as any).openingBudget) || 900);
                return ceBuildOp(function() { return ceOpeningWrite(hint, bud); })
                    .then(function(msg: any) {
                        try { api.v1.ui.toast(String(msg),
                            { type: 'success', autoClose: 5000 }); } catch (_eOw1) {}
                        return cePublishBuild();
                    });
            }, has ? undefined : 'primary', 'Writing\u2026'),
            has ? ceSub('t3', 'Writing again replaces what is below.') : null
        ])),
        // ── BAND 4 · WHAT EXISTS ──
        has ? ceBand(4, 'The opening', { state: 'open' }, ceStack(CE_T.s2, [
            h(ceField, { k: 'open:body', label: '', value: draft,
                multiline: true, rows: 14, well: true,
                placeholder: '',
                onCommit: function(v: string) {
                    return ceBuildOp(function() { return ceCharterWrite('opening', v); })
                        .then(cePublishBuild);
                } }),
            ceSub('t3', 'Edit it here \u2014 it is not in the story until you place it.'),
            ceBtn('Place it in the story', 'open:place', function() {
                return ceBuildOp(function() { return ceOpeningPlace(); })
                    .then(function(msg: any) {
                        try { api.v1.ui.toast(String(msg),
                            { type: 'success', autoClose: 6000 }); } catch (_eOp1) {}
                        return cePublishBuild();
                    });
            }, 'primary', 'Placing\u2026')
        ])) : null
    ]);
}
function _ceOpeningGuide(): string {
    return 'This reads the world you have settled and the records you have committed, and '
         + 'writes a scene that is already underway \u2014 not a tour of the setting.\n\n'
         + 'Most of what it is given should not appear. A world shown only where the scene '
         + 'brushes against it reads as larger than one that is explained.\n\n'
         + 'It never invents a name you have not written. If the scene needs someone who is '
         + 'not in your records, they are left unnamed \u2014 which is usually a sign of '
         + 'somebody worth building.';
}

// [KIND-SHAPE] DOES THIS BUILD STAGE OFFER A SHAPE? Catalog kinds answer from the catalog;
// a character answers yes without one, because its three shapes are real question sets that
// live outside CE_ENTITY_CATALOGS entirely.
function ceBuildKindHasShape(kind: string): boolean {
    if (String(kind || '') === 'character') return true;
    return ceEntityHasShape(String(kind || ''));
}

function _ceBuildScope(st: any, openMap: any): any {
    var c: any = st.charter || ceCharterEmpty();
    var trail: any[] = st.trail || [];
    var atId = String(st.scopeAt || '');
    var rung: any = st.rungHere || null;
    var rows: any[] = st.rows || [];
    var done: any[] = st.done || [];
    var i = 0;

    // [BUILD-CHROME] THE CHROME IS CONDITIONAL, THE LIST IS NOT. Everything below the trail
    // -- rows, names, seeds, chats, commit -- is identical for every kind, which is what
    // makes this one renderer rather than six near-copies. What varies is four facts, and
    // they are READ from the tables rather than branched on by name.
    // IT IS DECLARED FIRST BECAUSE THE ROW LOOPS READ IT. `var` hoists the declaration and
    // not the value, so with this block below them `kdef` was `undefined` at the moment
    // String(kdef.kind) ran -- a hard throw on any stage that had a staged row, Locations
    // included, and invisible on an empty one.
    var kdef: any = st.kdef || CE_BUILD_KINDS.places;
    var kKind = String(kdef.kind || 'location');
    var isRecursive = !!kdef.recursive;
    var hasLadder = !!kdef.ladder;
    // [KIND-SCOPE] The fourth fact, derived rather than declared: does this kind's facet
    // table use scales at all? Only locations do today.
    var scopeOpts: any[] = [];
    var kScopes: any[] = ceKindScopes(kKind);
    var hasScopes = kScopes.length > 0;
    for (i = 0; i < kScopes.length; i++) {
        scopeOpts.push({ id: kScopes[i].id, label: kScopes[i].label });
    }
    // A KIND WITHOUT A LADDER IS NEVER WAITING FOR A RUNG. `noRung` gates the scale form.
    // RECURSION AND A LADDER ARE SEPARATE FACTS: a species nests nowhere and needs no rung,
    // while a faction nests and has rungs whose names carry no scale vocabulary.
    var noRung = hasLadder && !rung;
    // [KIND-LIST] The fifth fact. A list kind has no trail and no rung; the bar is its head
    // and the current list is its standing.
    var listDefs: any[] = st.listDefs || [];
    var hasLists = listDefs.length > 0;
    var listAt = String(st.listAt || '');
    var listDef: any = hasLists ? ceKindListDef(kKind, listAt) : null;
    // [KIND-NOUN] The route's word for one of these, and the author's word for a rung of
    // them. `rungLabel` is the AUTHOR's and only falls back to the kind noun before they
    // have named one.
    var kNoun = _ceKindNoun(kKind);
    // [KIND-LIST] On a list kind the LIST's label is the heading, because "Peoples" and
    // "Bestiary" are the author's words for these sets and the kind noun ("species") is
    // wrong for half of them.
    var rungLabel = rung ? String(rung.label)
                  : (listDef ? String(listDef.label) : _ceKindNounCap(kKind));
    var rungPl = _cePlural(rungLabel);

    // [SCOPE-SEL-STORE] Store-backed, because ceSelect does not register in CE_FIELD_ELS and
    // a ceFieldLive read of it returns null -- CLICK-BEFORE-BLUR in the one control shape
    // where the live read cannot rescue it. A select commits on change, so nothing is lost.
    var curScope = ceKindScopeOk(kKind, String(st.scopeSel || '')
        || (rung ? rung.scope : (hasScopes ? (atId ? 'structure' : 'region') : 'any')));

    var seedDefs: any[] = st.seedDefs || [];
    var named = 0;
    var seeded = 0;
    for (i = 0; i < rows.length; i++) {
        var rs = ceScopeRowState(rows[i]);
        if (rs !== 'queued') named++;
        if (rs === 'seeded') seeded++;
    }
    var toName = rows.length - named;
    var toSeed = named - seeded;

    var rowKids: any[] = [];
    for (i = 0; i < rows.length; i++) {
        rowKids.push(_ceScopeRow(rows[i], i, rungLabel, seedDefs, openMap, kKind));
    }
    var doneKids: any[] = [];
    for (i = 0; i < done.length; i++) {
        doneKids.push(_ceScopeDoneRow(done[i], seedDefs, openMap, kdef));
    }

    var head = hasLists ? _ceListBar(kKind, listDefs, listAt)
             : ((isRecursive && trail.length) ? _ceScopeTrail(trail, kKind) : null);

    var shapeNow = String(st.scopeShape || 'builder');
    // [REC-CHAT] Which conversation, and what its empty state says.
    var chatKey = String(st.chatKey || '');
    var isRec = !!chatKey;
    var chatLabel = String(st.chatLabel || '') || rungLabel;
    var chatScope = ceBuildChatAddr(st);   // [BUILD-CHAT] one resolver, see _ceChatStrip
    var turnsN = ((st.turns || []) as any[]).length;
    var recLede = '';
    if (isRec) {
        var recRow: any = null;
        for (i = 0; i < rows.length; i++) {
            if (String(rows[i].id) === chatKey) { recRow = rows[i]; break; }
        }
        var blanks = seedDefs.length;
        if (recRow) {
            blanks = 0;
            for (i = 0; i < seedDefs.length; i++) {
                if (!String((recRow.fields || {})[CE_DRAFT_SEED_PFX + String(seedDefs[i].id)] || '').trim()) {
                    blanks++;
                }
            }
        }
        recLede = 'This conversation is about ' + chatLabel + ' and nothing else. '
                + (blanks
                    ? (String(blanks) + ' of its ' + String(seedDefs.length) + ' questions '
                       + (blanks === 1 ? 'is' : 'are') + ' still blank \u2014 tell me what you '
                       + 'know and Seed will write them down.')
                    : ('Every question already has a line. Talk anything over and re-seed it '
                       + 'when you are done.'));
    }

    // [BUILD-BANDS] FIVE BANDS, ONE ORDER, EVERY STAGE. What was nine consecutive ceGroups
    // is now: where you are, talk, set up, the work, what exists. The parts inside each band
    // are the ones that were already here -- this is a re-ordering and a re-framing, not a
    // rewrite of the controls.
    //
    // SET UP IS ABOVE THE WORK, which is the reported fault stated structurally: the shape
    // picker ("what X are made of") and the question list both GOVERN the rows, and both
    // rendered BELOW them. A thing that decides what a row is asked cannot sit under the row.
    //
    // TALK IS SECOND, above set-up, on the author's call and for the reason the whole
    // redesign exists: the conversation is the thing a new user cannot discover, and every
    // generator on this page reads it. It is the same position on all ten stages now.
    var setupDone = !!rung || (!hasLadder && rows.length > 0);
    var setupSummary = rungLabel
        + (hasScopes ? (' \u00b7 ' + ceKindScopeHint(kKind, curScope).split(' \u2014 ')[0]) : '')
        + ' \u00b7 ' + _ceShapeLabel(shapeNow)
        + ' \u00b7 ' + String(seedDefs.length) + ' question'
        + (seedDefs.length === 1 ? '' : 's');

    return ceStack(CE_T.s2, [
        // ── BAND 0 ────────────────────────────────────────────────────────────────
        head,
        ceStagePreamble(_ceKindNounCap(kKind) + 's',
            'Name the ' + _cePlural(kNoun) + ' this story has, one batch at a time, and let '
            + 'the engine write a first line for each of their questions.',
            'Committing turns them into records the story can read, and opens them for '
            + 'editing on their own page.'),
        (noRung && !rows.length) ? ceProse('t3', atId
            ? ('What sits directly inside ' + (trail.length ? String(trail[trail.length - 1].label) : 'here')
               + ', and what do you call those? They can skip a scale \u2014 what a gap '
               + 'means is a true fact about your world, not something missing.')
            : ('What are the largest ' + _cePlural(kNoun) + ' in your story, and what do you '
               + 'call them? Your word, not a standard one. Smaller ones are added later, '
               + 'when there is something to put them inside.')) : null,

        // ── BAND 1 · TALK ─────────────────────────────────────────────────────────
        noRung ? null : ceBand(1, 'Talk it through',
            { state: turnsN ? 'open' : 'waiting', count: '' },
            ceStack(CE_T.s2, [
                _ceChatStrip(st),
                (!isRec || turnsN) ? null : ceProse('t3', recLede),
                ceChatPanel('Conversation', turnsN,
                    noRung ? null : _ceBuildDock(st, chatScope, String(st.chatBlock || ''),
                        isRec ? ('Everything you settle here becomes ' + chatLabel + '\u2019s fields.')
                              : 'What is out there, and what are they called?',
                        isRec ? ('Talk about ' + chatLabel)
                              : ('Talk through the ' + rungPl)),
                    // [SHAPE-ASKS] ABOVE THE LIST, for the reason the charter's write button moved above
                    // its tiers: a control whose effect is visible below it goes above it. Changing the
                    // shape changes what every row on screen is about to be asked.
                    // [ROW-VALUE-SHORT] THE STATE IS A LINE OF ITS OWN, NOT ceRow'S MIDDLE SLOT. That
                    // slot is a narrow column between a label and an action, and "Custom fields only .
                    // no questions" came back one character per line down the middle of the screen. A
                    // value that is a sentence gets the full width under the row.
                    // [FIELD-MINT] ABOVE THE SHAPE ROW AND BELOW THE CHAT, because it reads the chat and
                    // is read BY the shape: choosing `custom` empties the asked set, and this is where an
                    // author goes next when it does.
                )
            ])),

        // ── BAND 2 · SET UP ───────────────────────────────────────────────────────
        // [BUILD-BANDS] COLLAPSES ONCE ANSWERED. Setup is decided once and re-read rarely,
        // and leaving it open is most of the vertical stack on every return visit.
        ceBand(2, noRung ? 'What these are' : 'How they are built',
            { state: setupDone ? 'done' : 'open',
              openKey: setupDone ? ('band:setup:' + kKind) : '',
              summary: setupSummary },
            ceStack(CE_T.s4, [
                ceGroup(noRung ? ('What is at this scale') : _cePlural(rungLabel), ceStack(CE_T.s2, [
                    _ceGuideBar('', _ceScopeGuide(kKind, hasScopes, isRecursive)),
                    _ceGuide(_ceScopeGuide(kKind, hasScopes, isRecursive), true),
                    // [KIND-NOUN] The placeholder is a list of EXAMPLE RUNG NAMES for this kind, and
                    // location words on the faction stage are the whole reported symptom in one
                    // string. `value` is blank until the author has named a rung; the fallback
                    // rungLabel is chrome, not an answer, so it must not be pre-filled as one.
                    // [KIND-LIST] ABSENT ON A KIND WITH NO SCALES. Asking what a species' scale is
                    // called is asking a question with no answer, and ceScopeWrite skips the rung
                    // block for exactly these kinds -- so a field here would be typed into and
                    // discarded.
                    hasLadder ? h(ceField, { k: 'scope:label', label: 'Called',
                        value: rung ? String(rung.label) : '',
                        placeholder: _ceKindRungHint(kKind),
                        onCommit: function() { return Promise.resolve(); } }) : null,
                    // [KIND-SCOPE] ABSENT, NOT DISABLED, for a kind with no scales. There is no
                    // scale here to be denied, and a greyed control implies one exists.
                    hasScopes ? ceSelect({ k: 'scope:scope', value: curScope, options: scopeOpts,
                        onCommit: function(v: string) {
                            ceBuildPatch(function() { return { scopeSel: ceKindScopeOk(kKind, v) }; });
                            return Promise.resolve();
                        } }) : null,
                    hasScopes ? ceSub('t3', ceKindScopeHint(kKind, curScope)) : null,
                    ceNumField({ k: 'scope:count', label: 'How many', value: rows.length,
                        min: 0, max: 24, onCommit: function() { return Promise.resolve(); } }),
                    h(ceField, { k: 'scope:intent', label: 'What they have in common', value: '',
                        multiline: true, rows: 2,
                        placeholder: 'Optional \u2014 one line the name pass reads for all of them\u2026',
                        onCommit: function() { return Promise.resolve(); } }),
                    // [WIZUI-PRIMARY] The accented control while there is no list yet. Once there is
                    // one, Commit is the obvious next thing and this drops to secondary.
                    ceBtn(noRung ? 'Set the scale' : ('Add ' + _cePlural(kNoun)), 'scope:set', function() {
                        var lab = String(ceFieldLive('scope:label') || '').trim();
                        var cnt = ceFieldLiveNum('scope:count', rows.length);
                        var itn = String(ceFieldLive('scope:intent') || '').trim();
                        if (noRung && !lab) {
                            try { api.v1.ui.toast('Give these ' + _cePlural(kNoun) + ' a name first.',
                                { type: 'error', autoClose: 2400 }); } catch (_eS1) {}
                            return Promise.resolve();
                        }
                        return ceBuildOp(function() {
                            return ceScopeWrite(lab, curScope, cnt, itn, atId,
                                                rung ? String(rung.id) : '', kKind, listAt);
                        }).then(function(msg: any) {
                            try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 5000 }); } catch (_eS2) {}
                            return cePublishBuild();
                        });
                    }, noRung ? 'primary' : undefined, 'Setting\u2026')
                ])),
                // [BUILD-CHAT] WORLDPIPE 9: one active chat per scope, ON the pipeline surface. Its
                // job is to fill the question set for the scope you are standing in, and its exit is
                // an extraction pass -- which is why it sits beside the list rather than on a tab.
                // [REC-CHAT] The strip, then the dock. WHICH conversation is a control and not a
                // navigation: the dock stays where it is and its contents change, because a chat
                // that took over the screen would make switching feel like leaving the workspace.,
                (noRung || !ceBuildKindHasShape(kKind)) ? null : ceStack(CE_T.s1, [
                    ceRow('What ' + rungPl + ' are made of', null,
                        ceBtn('Change', 'scope:shape', function() {
                            cePickerOpen('buildShape', { kind: kKind,
                                                     rungId: rung ? String(rung.id) : '' });
                            return Promise.resolve();
                        })),
                    ceSub('t3', _ceShapeLabel(shapeNow) + ' \u00b7 ' + (seedDefs.length
                        ? (String(seedDefs.length) + ' question' + (seedDefs.length === 1 ? '' : 's')
                           + ' asked of each')
                        : 'no questions \u2014 the pass writes one line and nothing else'))
                ]),
                // [NO-MANIFEST] The queue is the records. `queued` / `named` / `committed` are all
                // derived from what is blank; nothing stores a status.,
                (noRung || !ceEntityCatalog(kKind)) ? null
                    : _ceBuildFields(st, kKind, kNoun, seedDefs, chatScope, turnsN > 0),
                // [KIND-SHAPE] A kind whose catalog offers no toggle has no shape to change, so the
                // row is absent rather than showing a control that writes a value nothing reads.
                // [SEED-DEFS-CHAR] A CHARACTER HAS NO CATALOG AND HAS THREE SHAPES, so ceEntityHasShape
                // -- which asks the catalog -- answered false and hid the one picker the Cast stage
                // most needs. The catalog is the wrong authority for this question; ceBuildKindHasShape
                // is the right one, and it is the same fact ceKindShape and ceSeedDefs already branch on.
            ])),

        // ── BAND 3 · THE WORK ─────────────────────────────────────────────────────
        (noRung || !rows.length) ? null : ceBand(3, _cePlural(rungLabel),
            { state: (named === rows.length && seeded === rows.length) ? 'done' : 'open',
              count: String(rows.length) },
            ceStack(CE_T.s4, [
                // [BUILD-STEPS] The progression, drawn. Every number here is already derived
                // above; this is the state finally being shown rather than implied by which
                // button happens to carry the accent.
                ceStepTrack([
                    { label: 'Add', state: 'done', meta: String(rows.length) + ' staged' },
                    { label: 'Name',
                      state: toName > 0 ? 'now' : 'done',
                      meta: toName > 0 ? (String(toName) + ' blank') : 'all named' },
                    { label: 'Seed',
                      state: toName > 0 ? 'wait' : (toSeed > 0 ? 'now' : 'done'),
                      meta: toSeed > 0 ? (String(toSeed) + ' to write') : 'all seeded' },
                    { label: 'Commit',
                      state: (named && toName === 0 && toSeed === 0) ? 'now' : 'wait',
                      meta: String(named) + ' ready' }
                ]),
                rows.length ? ceGroup('Staged \u00b7 ' + String(named) + ' of ' + String(rows.length)
                    + ' named', ceStack(CE_T.s3, [
                    // [WIZUI-PRIMARY] ONE ACCENT AT A TIME, AND IT MOVES WITH THE PHASE. WIZUI S6:
                    // the primary is Name, then Seed, then Commit, depending on what the list needs.
                    // While anything is unnamed, naming is the obvious next thing; once everything
                    // has a name, Commit below takes the accent.
                    (toName > 0 || toSeed > 0) ? ceInline({ gap: CE_T.s2 }, [
                        toName > 0 ? ceBtn('Name ' + String(toName) + ' more', 'scope:name', function() {
                            return ceBuildOp(function() {
                                return ceNameBatch(atId, rung ? String(rung.id) : '',
                                                   String(kdef.kind));
                            }).then(function(msg: any) {
                                try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 6000 }); } catch (_eN1) {}
                                return cePublishBuild();
                            });
                        }, 'primary', 'Naming\u2026') : null,
                        // [SEED-CALL] The second phase, and it appears only once something is named
                        // -- a seed call needs a name to write about, and a button that could not
                        // work yet is a promise the surface cannot keep.
                        toSeed > 0 ? ceBtn('Seed ' + String(toSeed), 'scope:seed', function() {
                            return ceBuildOp(function() {
                                return ceSeedBatch(atId, rung ? String(rung.id) : '',
                                                   String(kdef.kind));
                            }).then(function(msg: any) {
                                try { api.v1.ui.toast(String(msg), { type: 'success', autoClose: 7000 }); } catch (_eS5) {}
                                return cePublishBuild();
                            });
                        }, toName > 0 ? undefined : 'primary', 'Seeding\u2026') : null
                    ]) : null,
                    ceStack(CE_T.s3, rowKids)
                ])) : null,
                rows.length ? ceGroup('Commit', ceStack(CE_T.s2, [
                    ceSub('t3', 'Named ' + _cePlural(kNoun) + ' become records, carrying their seeds. '
                        + 'Anything still blank stays staged.'),
                    ceBtn('Commit ' + String(named) + ' ' + (named === 1 ? kNoun : _cePlural(kNoun)),
                        'scope:commit',
                        function() {
                            if (!named) {
                                try { api.v1.ui.toast('Name at least one first.',
                                    { type: 'error', autoClose: 2400 }); } catch (_eS3) {}
                                return Promise.resolve();
                            }
                            // [BUILD-CHROME] THE STAGE'S KIND. Committing 'location' from the faction
                            // stage created location records out of the author's factions and left
                            // the faction queue untouched.
                            return ceBuildOp(function() { return commitStagedDrafts(kKind); })
                                .then(function(nMade: any) {
                                    try { api.v1.ui.toast(String(nMade) + ' '
                                        + (Number(nMade) === 1 ? kNoun : _cePlural(kNoun))
                                        + ' created. Open one to develop it'
                                        + (isRecursive ? ', or step into it to build what is inside.' : '.'),
                                        { type: 'success', autoClose: 6000 }); } catch (_eS4) {}
                                    return cePublishBuild();
                                });
                        }, (seeded && seeded === rows.length) ? 'primary' : undefined, 'Committing\u2026')
                ])) : null
            ])),

        // ── BAND 4 · WHAT EXISTS ──────────────────────────────────────────────────
        done.length ? ceBand(4, 'In the world',
            { state: 'done', count: String(done.length) },
            ceStack(CE_T.s2, doneKids)) : null
    ]);

}

// -- Premise stage  [BUILD-CHAT] ----------------------------------------------
// [EMPTY-LEDE] The empty state is a LEDE above the dock, never ceEmpty() in its place: this
// surface is the only way to start the conversation it is empty of.
function _ceBuildPremise(st: any): any {
    var turns: any[] = st.turns || [];
    return ceStack(CE_T.s2, [
        ceStagePreamble('Premise',
            'Say what your story is \u2014 a genre, an image, one line, whatever you have '
            + '\u2014 and we work it out together in the conversation below.',
            'Everything after this reads what you settle here. Nothing is written to your '
            + 'story yet.'),
        turns.length ? null : ceProse('t3',
            'There is no wrong first sentence. \u201cA heist, but underwater\u201d is '
            + 'enough to start from.'),
        ceBand(1, 'Talk it through', { state: turns.length ? 'open' : 'waiting' },
            ceChatPanel('Conversation', turns.length,
                _ceBuildDock(st, 'premise', CE_P_PREMISE,
                    'Tell me what your story is \u2014 one line is enough.',
                    'What is your story?')))
    ]);
}

// -- Root ---------------------------------------------------------------------
// [BUILD-ONE-ROUTE] THE DOOR TO THE SURFACE THIS REPLACES, AND ITS KILL LIST.
//
// The old Wizard is off the nav and reachable only here. It stays until the pipeline can do
// what it did; deleting it in the same patch that starts the replacement would leave an
// author with no worldbuilding at all for the several patches in between, which is the
// big-bang this file's own generation rework deliberately refused.
//
// WHAT GOES WHEN THIS DOOR GOES -- written now, while the reasoning is fresh, so the final
// deletion is mechanical rather than exploratory:
//   SECTION 37 entire            the nine-tab surface and every _ceWiz* renderer
//   CE_WIZ_TABS, CE_WIZ_SRC_KIND, CE_WIZ_ENT_KINDS, ceWizEntKind, ceWizEntLists
//   buildWizardMultiContext + ...Detailed   superseded by the charter's tiers and the
//                               cascade's digests; the tick-six-chats context blob is the
//                               thing the charter exists to replace
//   generateWizardSection        superseded by the world profile's seed pass
//   the entityBatch / entityLore generators   superseded by the name and seed calls
//   DEFAULT_WIZARD_TOPICS        its seedMessage/instructions become the scoped chats
//   ceWizStore, cePublishWiz, ceWizOp, _ceWizTab and the _ceWiz* module drafts
//   STORAGE_WIZ_TAB_SRC, STORAGE_WIZ_LOC_PARENT, STORAGE_WIZ_ACTIVE_CHAT
//
// WHAT SURVIVES, and this half matters more:
//   WizardDraft + STORAGE_WIZ_DRAFTS   the staging store IS the pipeline's queue. It is not
//                               replaced, it is the thing records are staged in.
//   DEFAULT_WIZARD_SECTIONS     becomes the world profile's default question set
//   SECTION 3e WIZLIVE's chat records   retargeted as the scoped chat, not deleted
function _ceBuildLegacyDoor(): any {
    return ceBand(9, 'Old wizard', { state: 'waiting', openKey: 'band:legacy',
                                     summary: 'The surface this replaces, until it is gone' },
        ceStack(CE_T.s2, [
        ceProse('t3', 'The surface this replaces. It is off the nav row and lives here '
            + 'until the new pipeline covers what it did. Anything you make in it still '
            + 'lands in the same records.'),
        ceBtn('Open the old wizard', 'build:legacy', function() {
            ceNav('wizard', '', '');
            return Promise.resolve();
        })
    ]));
}

function _ceBuildRoot(): any {
    ceBuildStoreInit();
    var st = useStoreValue(ceBuildStore);
    // [BUILD-UI-SUB] EVERY OTHER ROUTE ROOT SUBSCRIBES TO ceUiStore AND THIS ONE DID NOT.
    // The busy latch, the accordion's open map and every '?' body live in that store and are
    // READ synchronously by the components that draw them -- which only works because the
    // root repaints when it changes. Without the subscription this surface alone had a
    // permanently closed fold and a button whose busy label never appeared, with nothing on
    // the console to say so.
    var ui: any = useStoreValue(ceUiStore);
    var openMap: any = (ui && ui.open) || {};
    useEffect(function() { cePublishBuild(); }, []);
    var back: any = ceBack();
    if (!st || !st.ready) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    var stage = String(st.stage || 'charter');
    return ceScreen(ceHeader(back), ceStack(CE_T.s4, [
        _ceBuildSpine(stage),
        // [TABBODY-RECYCLE] The stage body carries its own key, or two stages that render
        // the same shape are matched by position and carry each other's values across a
        // stage change.
        h('div', { key: 'bstage:' + stage },
            stage === 'premise' ? _ceBuildPremise(st)
          : stage === 'world'   ? _ceBuildWorld(st)
          : stage === 'open'    ? _ceBuildOpening(st)
          : ceBuildKind(stage)  ? _ceBuildScope(st, openMap)
          : _ceBuildCharter(st)),
        _ceBuildLegacyDoor()
    ]));
}


// ============================================================================
// SECTION 41 — CHAT DOCK (kit)  [CHAT-DOCK]
//
// THE FIRST CHAT SURFACE THIS FILE DRAWS ITSELF. CharChat paints into NAI's own editor
// (CHAT-STAGE) and therefore never had to solve any of what is below. Every chat moves in
// here eventually, so this is kit rather than a wizard part, and the wizard is simply its
// first host.
//
// [CHAT-DOCK] TWO HEIGHTS, AND THE COMPOSER IS PRESENT AT BOTH. Closed is one line of the
// last thing said plus the box; open is the thread. A half height was prototyped and cut on
// test -- two cramped regions read worse than one good one, and the third stop turned a
// toggle into a cycle. `open` is therefore a BOOLEAN and not a two-value enum, because a
// two-value enum invites a third value later and the third value is the one that was
// measured and rejected.
// The point of a dock rather than a tab: the height change is a RESIZE, so nothing unmounts
// and the author never navigates away from their work to say something about it.
//
// [CHAT-REVERSE] THE SCROLLER IS column-reverse AND THE TURNS ARE NEWEST-FIRST IN THE DOM.
// Nothing in this sandbox can move a scroll container (SCROLL-ANCHOR): there is no
// scrollTop, no scrollIntoView, and onScroll only reports. A reverse-column flex container
// anchors at its visual bottom natively, so the newest turn stays in view with no JS at all.
// Verified on this runtime with the Settings probe before this was built.
// REVERSE THE ARRAY, NEVER THE READING ORDER. On screen it reads oldest-at-top.
//
// [CHAT-HEAD-SLOT] THE DOCK OWNS NO HEADER. It takes one. The wizard's is a progress spine
// or a breadcrumb, a character's is a person; a header owned here would force one of them to
// be wrong.
//
// [CHAT-THEME] ITS OWN TOKEN GROUP, and the separation from the existing Bubble/cb-* family
// is deliberate rather than an oversight. cb-* describes bubbles PAINTED INTO NAI'S EDITOR,
// driven by CE_CB_LOOKS' frame/corner/fill/edge/depth table, and has no name for a composer,
// a dock bar or a scroller ground because that surface has none of those things. Merging
// them would make one theme value mean two geometries.
// ============================================================================

// The colour tokens live with the other colour tokens (SECTION 28), NOT here -- see the
// note at their declaration. CE_THEME_TOKENS is evaluated long before this point in the
// file, and a var read before its assignment is undefined rather than an error.

// [CHAT-SEND-LIVE] The composer's draft is READ OFF THE ELEMENT and CLEARED ON IT, never
// held in the store. Send is a CLICK and CLICK-BEFORE-BLUR means it is delivered before the
// blur that would commit a ceField -- so a stored draft is one keystroke stale at exactly the
// moment it is read. ceFieldLive and ceFieldSet are the pair, and neither asks anything of
// the event system.
// A `value` PROP CANNOT CLEAR THIS BOX. Measured, reported: the seed is '' before a send and
// '' after one, so the prop never changes and ceField's imperative value-change write never
// fires. See ceFieldSet's own note.

// [CHAT-DOTS] THE WAITING INDICATOR, AND WHY IT IS A JS CHAIN RATHER THAN AN ANIMATION.
// Two of the three ways to do this do not exist here: a stylesheet in document.head reaches
// nothing inside this shadow root, and CSS @keyframes resolve in the TREE SCOPE OF THE
// ELEMENT, so a document-level animation name does not exist either -- the same finding the
// chip reticle records. The third way is a TRANSITION ON AN INLINE STYLE, which needs
// something to change the style, which needs a clock.
// THERE IS NO setInterval. api.v1.timers exposes setTimeout returning a Promise<number> and
// clearTimeout, so the loop is a SELF-RESCHEDULING CHAIN.
// A GENERATION COUNTER, NOT clearTimeout. Cancelling would mean awaiting the promise to get
// an id and storing it somewhere that survives an unmount; a counter makes a superseded
// chain return on its next tick with no bookkeeping, and a leaked chain is impossible
// because every chain checks whether it is still the current one.
// ITS OWN STORE, AND ONLY THIS COMPONENT SUBSCRIBES. That is the rule the deleted generation
// rail left behind: an indeterminate indicator that a whole surface subscribes to is a
// performance bug rather than an indicator. Nothing else reads _ceDotsStore.
var _ceDotsStore: any = null;
var _ceDotsRun = 0;
var _ceDotsPhase = 0;

function _ceDotsInit(): void {
    if (_ceDotsStore) return;
    try { _ceDotsStore = createStore({ phase: 0 }); }
    catch (e) { api.v1.error('[AE:dots] store init failed:', e); }
}

function _ceDotsStop(): void { _ceDotsRun++; }

function _ceDotsStart(): void {
    _ceDotsInit();
    if (!_ceDotsStore) return;
    _ceDotsRun++;
    var mine = _ceDotsRun;
    var step = function(): void {
        if (mine !== _ceDotsRun) return;
        _ceDotsPhase = (_ceDotsPhase + 1) % 4;
        var ph = _ceDotsPhase;
        try { _ceDotsStore.set(function() { return { phase: ph }; }); } catch (e1) {}
        try { (api.v1.timers.setTimeout(step, 220) as any).catch(function() {}); }
        catch (e2) {}
    };
    try { (api.v1.timers.setTimeout(step, 220) as any).catch(function() {}); }
    catch (e3) {}
}

function _ceDockDots(): any {
    _ceDotsInit();
    var st = useStoreValue(_ceDotsStore);
    useEffect(function() {
        // Reduced motion gets three still dots. The indicator's JOB is done by its presence;
        // the bounce is the part that is optional.
        if (!CE_REDUCE_MOTION) _ceDotsStart();
        return function() { _ceDotsStop(); };
    }, []);
    var ph = Number(st && st.phase) || 0;
    var dots: any[] = [];
    for (var i = 0; i < 3; i++) {
        dots.push(h('div', { key: 'dd' + i, style: {
            width: '6px', height: '6px', borderRadius: '999px',
            background: 'currentColor',
            opacity: (!CE_REDUCE_MOTION && ph === i) ? '0.9' : '0.4',
            transform: (!CE_REDUCE_MOTION && ph === i) ? 'translateY(-3px)' : 'translateY(0)',
            transition: 'transform ' + CE_T.mBase + ' ' + CE_T.ease
                      + ', opacity ' + CE_T.mBase + ' ' + CE_T.ease
        } }, null));
    }
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: '5px', height: '14px' } }, dots);
}

// One turn. `pending` renders the dots rather than text -- an assistant turn that exists but
// has no words yet is the honest state during a generation, and it keeps the thread's
// geometry from jumping when the words arrive.
// [BUILD-CHAT-EDIT] TAPPING A BUBBLE OPENS IT. The open flag rides ceToggleOpen, the same
// store ceAccordion and ceExpandRow already use, so this introduces no second open-state
// mechanism. A pending bubble is not tappable: there is nothing yet to edit.
// [CE-BUBBLE] THE BUBBLE SHELL, EXTRACTED SO TWO DOCKS CANNOT DISAGREE ABOUT WHAT A MESSAGE
// LOOKS LIKE. Build chats and character chats need very different CONTENTS -- one has edit and
// delete, the other has a face, a photo and a private thought -- and identical geometry. Two
// copies of the tail-corner rule would drift the first time either was touched, which is the
// same argument buildLorebookContent's header makes about identity projections.
// THE TAIL CORNER IS THE WHOLE READ. One tight corner on the side the turn came from is what
// makes a stack of boxes legible as a conversation, and it costs one radius token rather than a
// drawn tail. `mine` decides the side, the fill and which corner tightens, and nothing else.
function ceBubble(o: any, inner: any): any {
    var b: any = o || {};
    var mine = !!b.mine;
    var wide = !!b.wide;
    return h('div', { key: b.key, style: {
        display: 'flex',
        justifyContent: (mine && !wide) ? 'flex-end' : 'flex-start',
        paddingBottom: CE_T.s2
    } },
        h('div', {
            onClick: b.onClick,
            style: {
                maxWidth: wide ? '100%' : '85%',
                width: wide ? '100%' : undefined,
                cursor: b.onClick ? 'pointer' : 'default',
                background: mine ? CE_CHAT_YOU : CE_CHAT_THEM,
                color: mine ? CE_CHAT_YOU_INK : CE_CHAT_THEM_INK,
                fontFamily: CE_CHAT_FONT,
                fontSize: CE_T.fsBody,
                lineHeight: CE_T.lhProse,
                whiteSpace: b.pre === false ? 'normal' : 'pre-wrap',
                wordBreak: 'break-word',
                padding: CE_T.s2 + ' ' + CE_T.s3,
                borderRadius: mine
                    ? (CE_CHAT_RADIUS + ' ' + CE_CHAT_RADIUS + ' ' + CE_CHAT_TAIL + ' ' + CE_CHAT_RADIUS)
                    : (CE_CHAT_RADIUS + ' ' + CE_CHAT_RADIUS + ' ' + CE_CHAT_RADIUS + ' ' + CE_CHAT_TAIL)
            }
        }, inner)
    );
}

function _ceDockTurn(t: any, key: string, p: any): any {
    var mine = String(t.role) === 'user';
    var pend = !!t.pending;
    var tid = String(t.id || '');
    var ekey = 'dockedit:' + tid;
    var openEd = !pend && !!tid && _ceOpenIs(ekey);
    var inner: any;
    if (openEd) {
        // [CLICK-BEFORE-BLUR] Save is a CLICK, so it reads the box through ceFieldLive
        // rather than waiting for a commit that arrives after it.
        inner = ceStack(CE_T.s2, [
            h(ceField, { k: ekey, label: '', multiline: true, rows: 4, well: true,
                value: String(t.text || '') }),
            ceInline(CE_T.s2, [
                ceBtn('Save', ekey + ':save', function() {
                    var live = ceFieldLive(ekey);
                    var v = (live === null) ? String(t.text || '') : String(live);
                    ceToggleOpen(ekey);
                    return Promise.resolve(p && p.onEdit ? p.onEdit(tid, v) : null);
                }),
                ceBtn('Delete', ekey + ':del', function() {
                    ceToggleOpen(ekey);
                    return Promise.resolve(p && p.onDelete ? p.onDelete(tid) : null);
                }),
                ceBtn('Cancel', ekey + ':cancel', function() {
                    ceToggleOpen(ekey); return Promise.resolve();
                })
            ])
        ]);
    } else if (pend) {
        inner = h(_ceDockDots, null);
    } else {
        inner = String(t.text || '');
    }

    // [CE-BUBBLE] Geometry through the shared shell. An open editor goes WIDE, which also
    // moves it to the left edge -- an edit box pinned right at 85% is a box you cannot read
    // your own paragraph in.
    return ceBubble({
        key: key, mine: mine, wide: openEd,
        onClick: (pend || openEd) ? undefined : function() {
            ceTap('dockturn:' + tid, function() { ceToggleOpen(ekey); });
        }
    }, inner);
}

// [CHAT-DOCK] THE COMPONENT.
//   open         boolean
//   onOpen(next) the HOST stores it. Session state, per scope.
//   head         a VNode slot [CHAT-HEAD-SLOT]
//   turns        [{ id, role, text, pending? }] in READING order, oldest first
//   lead         the one line shown while closed
//   placeholder  composer placeholder
//   onSend(text) returns a promise
//   pending      a reply is in flight -- renders the dots bubble at the newest position
//   onEdit(id,text) / onDelete(id)  a tapped bubble opens; omit both and bubbles are inert
//   actions      optional VNode beside the composer
//   k            the field key; must be unique on the surface, like every ceField k
function ceChatDock(p: any): any {
    var open = !!p.open;
    var fk = String(p.k || 'dock');
    var turns: any[] = p.turns || [];

    // [CHAT-REVERSE] Newest first in the DOM. [H-01] every row is keyed, and this list's
    // length moves on every send -- an unkeyed one would be matched by position and a
    // rendering fault would look like a scrolling one.
    var rows: any[] = [];
    // [CHAT-REVERSE] The pending bubble is FIRST in the DOM, which is last on screen. It is
    // not a stored turn -- a transcript that persisted a bubble with no words in it would
    // replay one into the next prompt.
    if (p.pending) rows.push(_ceDockTurn({ id: '__pending', role: 'assistant', text: '', pending: true }, 'dt_pending', p));
    for (var i = turns.length - 1; i >= 0; i--) {
        if (turns[i]) rows.push(_ceDockTurn(turns[i], 'dt_' + String(turns[i].id || i), p));
    }

    var scroller = h('div', { key: 'dockscroll', style: {
        display: 'flex', flexDirection: 'column-reverse',
        overflowY: 'auto', overflowX: 'hidden',
        maxHeight: open ? '46vh' : '0px',
        minHeight: '0',
        background: CE_CHAT_GROUND,
        padding: open ? (CE_T.s3 + ' ' + CE_T.s3 + ' 0') : '0 ' + CE_T.s3,
        transition: 'max-height ' + CE_T.mBase + ' ' + CE_T.ease
    } }, rows.length ? rows : null);

    // The grab bar. Closed it carries the lead; open it is the collapse control and the lead
    // is redundant, so the lead DIMS rather than being removed -- removing it would change
    // the bar's height and make the resize jump at its own start.
    var bar = h('div', {
        key: 'dockbar',
        role: 'button', tabIndex: 0,
        'aria-expanded': open ? 'true' : 'false',
        'aria-label': open ? 'Collapse the chat' : 'Expand the chat',
        onClick: function() { ceTap('dock:' + fk + ':toggle', function() { if (p.onOpen) p.onOpen(!open); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: CE_T.tap, padding: CE_T.s2 + ' ' + CE_T.s3,
            cursor: 'pointer', background: CE_CHAT_BAR
        }
    },
        h('div', { style: { flex: '0 0 auto', width: '10px', fontSize: '8px', opacity: '0.58',
            transform: open ? 'rotate(90deg)' : 'rotate(-90deg)',
            transition: 'transform ' + CE_T.mBase + ' ' + CE_T.ease } }, '\u25B6'),
        // The lead DIMS when open rather than being removed: removing it would change the
        // bar's height and make the resize jump at its own start.
        ceGrow(null, [ ceTruncate(open ? 't3' : 't2', String(p.lead || '')) ])
    );

    var composer = h('div', { key: 'dockcomp', style: {
        display: 'flex', alignItems: 'flex-end', gap: CE_T.s2,
        padding: CE_T.s2 + ' ' + CE_T.s3 + ' ' + CE_T.s3,
        background: CE_CHAT_BAR
    } },
        ceGrow(null, [
            h(ceField, { k: 'chat:' + fk, label: '', multiline: true, rows: 1, well: true,
                placeholder: String(p.placeholder || 'Say something') })
        ]),
        p.actions || null,
        ceBtn('Send', 'dock:' + fk + ':send', function() {
            var live = ceFieldLive('chat:' + fk);
            var text = String((live === null ? '' : live) || '').trim();
            if (!text) return Promise.resolve();
            // CLEARED BEFORE THE SEND, not after it. onSend is a round trip of several
            // seconds; a box still holding its text for that whole time is a box the author
            // will press Send on again.
            ceFieldSet('chat:' + fk, '');
            return Promise.resolve(p.onSend ? p.onSend(text) : null);
        })
    );

    return ceStack({ gap: '0', key: 'dock_' + fk }, [
        p.head || null,
        scroller,
        bar,
        composer
    ]);
}


// ── [CC-SURFACE] THE CHARACTER CHAT WINDOW ────────────────────────────────
// A SEPARATE DOCK FROM ceChatDock, SHARING ceBubble. The build dock's composer is one field and
// a Send; this one needs a second verb, a per-message control, a face, a photo and a way back
// through a long history. Bending one component to do both would put four dead props on every
// build chat.
//
// 32 A PAGE, GROWING ON DEMAND. The render window is not the prompt window: reading further
// back costs paint and never sends more to a model [CHAT-TURN-WINDOW]. 32 is about two screens,
// which is enough that the control is rarely needed and small enough that opening a
// thousand-message thread is instant.
var CE_CC_PAGE = 32;

// [CC-EMO-SLOT] The face beside a bubble. The slot IS the emotion word, which is the whole of
// what the bridge needs -- _ceSurfImgResolve sends any non-Avatar slot to charId + '_em_' +
// slot, and the canonical emotion list is exactly that set of slot names.
// SILENT WHEN THERE IS NO IMAGE. An author who has not drawn a Joy gets a bubble, not a broken
// frame: the anchor simply resolves nothing and the box stays empty at its reserved size, so
// the column does not jitter as emotions change down a thread.
function _ceCcFace(charId: string, emotion: string): any {
    if (!emotion) return null;
    // NO fit OPT: cover is the painter's default and is what a circular crop wants. The photo
    // below asks for CE_IMG_CONTAIN instead, because cropping a face is fine and cropping a
    // picture someone chose to send is not.
    return h('div', ceImgAnchor(String(charId), String(emotion), {
        key: 'face', style: {
            flex: '0 0 auto', width: '34px', height: '34px',
            borderRadius: '50%', overflow: 'hidden',
            background: CE_CHAT_THEM, alignSelf: 'flex-end'
        }
    }), null);
}

// [CHAT-ATTACH-INLINE] The photo. A resolved attachment paints from the gallery by its FULL
// uuid -- ceImgAnchor(CE_IMG_GAL, uuid) is an anchor form that already exists, so an attachment
// needs no new bridge vocabulary at all. A prompt with no id yet is a photo still generating,
// and says so rather than showing nothing.
function _ceCcPhoto(m: any): any {
    if (m.attachmentId) {
        return h('div', ceImgAnchor(CE_IMG_GAL, String(m.attachmentId), {
            key: 'att', style: {
                marginTop: CE_T.s2, borderRadius: CE_T.r, overflow: 'hidden',
                width: '100%', minHeight: '120px', background: CE_CHAT_GROUND
            }
        }, CE_IMG_CONTAIN), null);
    }
    if (m.attachmentPrompt) {
        return h('div', { key: 'attp', style: {
            marginTop: CE_T.s2, padding: CE_T.s2, borderRadius: CE_T.r,
            border: '1px dashed ' + CE_LINE, fontSize: CE_T.fsSm, opacity: CE_OP.t3
        } }, '\uD83D\uDCF7  ' + String(m.attachmentPrompt));
    }
    return null;
}

// ONE MESSAGE. Tapping a contact bubble reveals what is normally hidden: the private thought
// that produced it, and Regenerate.
// REGENERATE APPEARS ON THE LAST CONTACT MESSAGE ONLY, and that is a correctness constraint
// wearing a UX hat. _ceChatTurn pops exactly one message off the end, so offering the control
// on an older bubble would either silently regenerate the wrong turn or discard everything
// after it. A control that cannot work is not shown.
function _ceCcTurn(m: any, key: string, p: any): any {
    var mine = String(m.role) === 'pov';
    var mid = String(m.id || '');
    var ekey = 'ccturn:' + mid;
    var open = !!mid && _ceOpenIs(ekey);
    var kids: any[] = [ h('div', { key: 'body' }, String(m.text || '')) ];

    var photo = _ceCcPhoto(m);
    if (photo) kids.push(photo);

    if (open && !mine) {
        var th = m.thought || null;
        var det: any[] = [];
        if (th && (th.eventAnchor || th.emotionalResponse || th.immediateDesire)) {
            det.push(ceProse('t3', 'Reacting to: ' + String(th.eventAnchor || '\u2014')));
            det.push(ceProse('t3', 'Thinking: ' + String(th.emotionalResponse || '\u2014')));
            det.push(ceProse('t3', 'Wants to: ' + String(th.immediateDesire || '\u2014')));
        } else {
            det.push(ceProse('t3', 'No thought was recorded for this message.'));
        }
        if (p && p.canRegen) {
            det.push(ceBtn('Regenerate', ekey + ':regen', function() {
                ceToggleOpen(ekey);
                return Promise.resolve(p.onRegen ? p.onRegen() : null);
            }));
        }
        kids.push(h('div', { key: 'det', style: {
            marginTop: CE_T.s2, paddingTop: CE_T.s2, borderTop: '1px solid ' + CE_LINE
        } }, ceStack(CE_T.s1, det)));
    }

    var bubble = ceBubble({
        key: 'b', mine: mine,
        onClick: mine ? undefined : function() { ceTap(ekey, function() { ceToggleOpen(ekey); }); }
    }, ceStack({ gap: '0' }, kids));

    // The face rides OUTSIDE the bubble, in a row with it, so the bubble's own width and tail
    // corner are untouched by whether an image exists.
    if (mine) return h('div', { key: key }, bubble);
    return h('div', { key: key, style: { display: 'flex', gap: CE_T.s2, alignItems: 'flex-end' } },
        _ceCcFace(String(p.charId), String(m.emotion || '')),
        ceGrow(null, [bubble])
    );
}

// [CC-SURFACE] THE DOCK. Reverse-column like the build dock [CHAT-REVERSE], so the newest turn
// is at the bottom without a scroll-to-bottom effect, and every row is keyed [H-01] because
// this list's length moves on every send.
// LOAD MORE IS LAST IN THE DOM, WHICH IS TOP OF THE SCREEN. That falls out of column-reverse
// and is the correct place for it: it is the oldest thing on screen.
function ceCcDock(p: any): any {
    var th = p.thread || { messages: [] };
    var all: any[] = th.messages || [];
    var shown = Math.max(1, Number(p.shown || CE_CC_PAGE));
    var start = Math.max(0, all.length - shown);
    var vis = all.slice(start);
    var busy = String(p.busy || '');

    var rows: any[] = [];
    if (busy) rows.push(ceBubble({ key: 'ccpending', mine: false }, h(_ceDockDots, null)));
    var i = 0;
    for (i = vis.length - 1; i >= 0; i--) {
        if (vis[i]) rows.push(_ceCcTurn(vis[i], 'ct_' + String(vis[i].id || i), p));
    }
    if (start > 0) {
        rows.push(h('div', { key: 'ccmore', style: { padding: CE_T.s2 + ' 0', textAlign: 'center' } },
            ceBtn('Load ' + Math.min(CE_CC_PAGE, start) + ' earlier', 'cc:more', function() {
                return Promise.resolve(p.onMore ? p.onMore() : null);
            })
        ));
    } else if (all.length) {
        rows.push(ceProse('t3', 'This is the start of the conversation.', { key: 'ccstart' }));
    }

    var scroller = h('div', { key: 'ccscroll', style: {
        display: 'flex', flexDirection: 'column-reverse',
        overflowY: 'auto', overflowX: 'hidden',
        flex: '1 1 auto', minHeight: '0',
        background: CE_CHAT_GROUND, padding: CE_T.s3 + ' ' + CE_T.s3 + ' 0'
    } }, rows.length ? rows : ceEmpty('No messages yet.', null));

    // [CC-PRESS-LABEL] THE SECOND VERB NAMES WHAT IT WILL ACTUALLY DO. ceChatPress reads the
    // transcript rather than the button [CHAT-PRESS], so one control has three honest meanings
    // and the label is the only place the author can see which one is live.
    var lastM = all.length ? all[all.length - 1] : null;
    var pressLabel = !lastM ? 'Let them text first'
        : (String(lastM.role) === 'contact' ? 'Nudge' : 'Get a reply');

    var composer = h('div', { key: 'cccomp', style: {
        display: 'flex', alignItems: 'flex-end', gap: CE_T.s2,
        padding: CE_T.s2 + ' ' + CE_T.s3 + ' ' + CE_T.s3, background: CE_CHAT_BAR
    } },
        ceGrow(null, [
            h(ceField, { k: 'cc:msg', label: '', multiline: true, rows: 1, well: true,
                placeholder: 'Message ' + String(p.contactName || '') })
        ]),
        ceBtn(pressLabel, 'cc:press', function() {
            return Promise.resolve(p.onPress ? p.onPress() : null);
        }),
        // [CLICK-BEFORE-BLUR] Read at press time through ceFieldLive, and CLEARED BEFORE the
        // send: a round trip is several seconds, and a box still holding its text for all of
        // them is a box the author presses Send on twice.
        ceBtn('Send', 'cc:send', function() {
            var live = ceFieldLive('cc:msg');
            var text = String((live === null ? '' : live) || '').trim();
            if (!text) return Promise.resolve();
            ceFieldSet('cc:msg', '');
            return Promise.resolve(p.onSend ? p.onSend(text) : null);
        })
    );

    return ceStack({ gap: '0', key: 'ccdock', style: { flex: '1 1 auto', minHeight: '0' } }, [
        scroller,
        busy ? ceProse('t3', busy, { key: 'ccbusy' }) : null,
        p.err ? ceProse('t3', String(p.err), { key: 'ccerr' }) : null,
        composer
    ]);
}

// [CC-SURFACE] The drill. Mounted through h() rather than called bare because it holds hooks;
// see _ceProfileImagesDrill's header for why that distinction matters on this surface.
function _ceCcDrill(props: any): any {
    var charId = String((props && props.charId) || '');
    ceCcStoreInit();
    var st = useStoreValue(ceCcStore);

    useEffect(function() {
        cePublishCcThread(charId);
        return undefined;
    }, [charId]);

    if (!st || !st.ready || String(st.charId) !== charId) {
        return ceEmpty('Loading the conversation\u2026', null);
    }

    var povId = String(_aeCharChat.povId || '');
    var povName = String(_aeCharChat.povName || '');
    // [CC-ROUTE] FROM THE PUBLISHED RECORD, not from a prop. The surface root has only an
    // entityId to work from, and ChatThread deliberately stores no name -- a name copied onto a
    // record goes stale the moment the character is renamed. cePublishCcThread carries it.
    var contactName = String(st.contactName || (props && props.contactName) || '');
    var msgs = (st.thread && st.thread.messages) ? st.thread.messages : [];
    var lastM = msgs.length ? msgs[msgs.length - 1] : null;

    // ONE RUNNER FOR ALL THREE VERBS, so the busy flag, the error surface and the republish
    // cannot get out of step between them. `keepShown` is true on every one of these: the
    // author is at the bottom of a conversation they are having, and resetting their scroll
    // depth because a message arrived would be the rudest thing this surface could do.
    var run = function(label: string, fn: () => Promise<any>): Promise<any> {
        ceCcPatch(function() { return { busy: label, err: '' }; });
        return fn().then(function(r: any) {
            return cePublishCcThread(charId, true).then(function() {
                ceCcPatch(function() {
                    return { busy: '', err: (r && r.ok) ? '' : ('Nothing came back' + ((r && r.reason) ? (' \u2014 ' + r.reason) : '.')) };
                });
                return r;
            });
        }).catch(function(e: any) {
            ceCcPatch(function() { return { busy: '', err: String((e && e.message) || e) }; });
            return null;
        });
    };

    return ceCcDock({
        charId: charId, contactName: contactName, thread: st.thread,
        shown: st.shown, busy: st.busy, err: st.err,
        // [CHAT-REGEN-THOUGHT] Only when the character spoke last, matching what _ceChatTurn
        // will actually accept.
        canRegen: !!(lastM && String(lastM.role) === 'contact') && !st.busy,
        onMore: function() {
            ceCcPatch(function(s: any) { return { shown: Number(s.shown || CE_CC_PAGE) + CE_CC_PAGE }; });
            return Promise.resolve();
        },
        onSend: function(text: string) {
            return run('Writing\u2026', function() { return ceChatSend(charId, povId, povName, text); });
        },
        onPress: function() {
            return run('Writing\u2026', function() { return ceChatPress(charId, povId, povName); });
        },
        onRegen: function() {
            return run('Rewriting\u2026', function() { return ceChatRegenerate(charId, povId, povName); });
        }
    });
}

// [CC-ROUTE] ITS OWN SURFACE, NOT A DRILL UNDER PROFILE. 3.9.0 mounted this as
// profileDrill 'chat', which was wrong twice over: a conversation is not a detail of a
// character record the way Equipment or Images are, and a drill inherits the profile's
// scrolling screen -- so a chat would have grown the page downward instead of holding a fixed
// composer at the bottom of a scroller that owns its own height.
// A SURFACE VALUE WITH AN entityId, exactly like 'entity' and 'imgedit', and deliberately
// ABSENT FROM CE_SHELL_ROUTES for the reason those two are: it is a detail view reached FROM
// the chat menu, not a destination you would pick off a nav bar with nothing selected.
// [NAV-BACK] The door passes a return address, so Back lands on the chat menu the author came
// from rather than on whatever ceNav last cleared.
function _ceCcRoot(): any {
    ceCcStoreInit();
    // Both hooks unconditional, above every branch, per the surface rule this file already
    // states on _ceChatRoot.
    var ui = useStoreValue(ceUiStore);
    var charId = String((ui && ui.entityId) || '');
    var back: any = ceBack();
    if (!charId) return ceScreen(ceHeader(back), ceEmpty('No conversation selected.', null));
    // [CC-SURFACE] Mounted through h() because it hooks; see _ceProfileImagesDrill.
    return ceScreen(ceHeader(back), [h(_ceCcDrill, { charId: charId })]);
}

// ============================================================================
// SECTION 42 — BUILD CHATS  [BUILD-CHAT]
//
// EVERY STAGE THAT TALKS SHARES THIS. One transcript per scope, one live at a time, and the
// scope id -- 'premise', 'world', 'loc:<entityId>' -- is the whole addressing scheme.
//
// [BUILD-CHAT-NEW-PATH] WIZLIVE'S GENERATION PATH IS NOT REUSED AND MUST NOT BE RECREATED.
// It builds its prompt through the old wizard's multi-chat context assembler, which the
// charter and the cascade's digests replace outright: that assembler pastes a tick-list of
// whole transcripts into a blob whose ORDER varies per call, so every call was fully
// uncached. This path builds ONE stable [system, ...turns] prefix and appends, which is the
// arrangement prefix caching actually rewards (measured -- see CACHE-PROBE).
//
// EVERYTHING GOES THROUGH THE ROUTER. aeDiagGenerateWithStory is the one door
// [GEN-ROUTER], which is also where helper delegation lands later without this file
// knowing helpers exist -- that is the entire reason the router went in first.
//
// [BUILD-CHAT-FAILKIND] A TRANSPORT FAILURE IS NOT AN ANSWER. The turn is left in the
// transcript with its error visible rather than swallowed, because the failure this guards
// against is the silent one: a budget that runs out mid-session and returns plausible
// nothing.
// ============================================================================

interface BuildChatTurn {
    id: string;
    role: string;        // 'user' | 'assistant'
    text: string;
    pending?: boolean;
}
interface BuildChat {
    scope: string;
    turns: BuildChatTurn[];
    updatedAt: number;
}

async function loadBuildChats(): Promise<any> {
    try {
        var raw = await api.v1.storyStorage.getOrDefault(STORAGE_BUILD_CHATS, '{}') as string;
        var o: any = JSON.parse(raw || '{}');
        return (o && typeof o === 'object') ? o : {};
    } catch (eBcL) { api.v1.error('[AE:buildchat] load failed:', eBcL); return {}; }
}

async function loadBuildChat(scope: string): Promise<BuildChat> {
    var all = await loadBuildChats();
    var c: any = all[String(scope)] || null;
    if (!c) return { scope: String(scope), turns: [], updatedAt: 0 };
    return { scope: String(scope), turns: Array.isArray(c.turns) ? c.turns : [],
             updatedAt: Number(c.updatedAt) || 0 };
}

async function saveBuildChat(c: BuildChat): Promise<void> {
    try {
        var all = await loadBuildChats();
        c.updatedAt = Date.now();
        all[String(c.scope)] = c;
        await api.v1.storyStorage.set(STORAGE_BUILD_CHATS, JSON.stringify(all));
    } catch (eBcS) { api.v1.error('[AE:buildchat] save failed:', eBcS); }
}

// [REC-CHAT-REKEY] A DRAFT'S ID DIES AT COMMIT. commitStagedDrafts mints a fresh entity id,
// so a transcript addressed by the draft's id orphans at exactly the moment the thing it is
// about becomes real. This moves it, and it is called from the commit path beside the
// lorebook entry creation already there -- the same class of thing, at the one moment
// identity changes.
async function ceBuildChatRekey(from: string, to: string): Promise<void> {
    try {
        var all = await loadBuildChats();
        var c: any = all[String(from)];
        if (!c) return;
        c.scope = String(to);
        all[String(to)] = c;
        delete all[String(from)];
        await api.v1.storyStorage.set(STORAGE_BUILD_CHATS, JSON.stringify(all));
    } catch (eRk) { api.v1.error('[AE:buildchat] rekey failed:', eRk); }
}

// [CHAT-KEEP] THE WHOLE TRANSCRIPT, DROPPED. A committed record keeps its chat by default and
// the store therefore grows with the cast for the life of the story; this is the valve that
// makes that affordable, and it sits beside Copy on the strip for the reason the diagnostics
// log does -- an author who can take it with them is not losing anything by clearing it.
async function ceBuildChatDrop(scope: string): Promise<void> {
    try {
        var all = await loadBuildChats();
        if (!all[String(scope)]) return;
        delete all[String(scope)];
        await api.v1.storyStorage.set(STORAGE_BUILD_CHATS, JSON.stringify(all));
    } catch (eDr) { api.v1.error('[AE:buildchat] drop failed:', eDr); }
}

// [CHAT-EXPORT] A FILE, THROUGH api.v1.file.save -- the same door exportData already uses,
// with `fileDownload` already in the load-time permission request. It is JSON rather than
// prose because a transcript is structured data with a re-import on the other side of it,
// and because the thing an author does with an exported chat is keep it, not read it in a
// paste buffer.
// IT CARRIES THE RESOLVED SYSTEM BLOCK beside the turns. That half is free and closes WIZUI
// 5's gap 4 -- "nothing shows the author what the model is being told" -- at the record level
// without building S2's preview panel, because the export's second audience is a bug report
// about a chat that misbehaved, and the turns alone never explain one.
function ceBuildChatJson(title: string, scope: string, block: string,
                         turns: BuildChatTurn[]): string {
    var out: any[] = [];
    for (var i = 0; i < (turns || []).length; i++) {
        var t: any = turns[i];
        if (!t || t.pending) continue;
        if (!String(t.text || '').trim()) continue;
        out.push({ role: String(t.role), text: String(t.text) });
    }
    return JSON.stringify({
        ce: 'buildChat', version: 1,
        title: String(title || ''), scope: String(scope || ''),
        exportedAt: Date.now(), systemBlock: String(block || ''), turns: out
    }, null, 2);
}

// The filename an author will have twenty of in one folder, so it says which world and which
// record without being opened.
function _ceChatFileName(title: string): string {
    var t = String(title || 'chat').replace(/[^A-Za-z0-9 _-]/g, '').replace(/\s+/g, '-');
    if (!t) t = 'chat';
    return 'ce-chat-' + t.toLowerCase().substring(0, 40) + '.json';
}

// [CHARTER-COMPRESS] EXTRACTION REUSES THE CHAT'S EXACT PREFIX AND APPENDS ONE MESSAGE.
// That is the whole reason two compressions are affordable: the [system, ...turns] array is
// already warm from the conversation itself, so each tier pays only for its own instruction.
// Building a fresh context blob here instead would be 100% uncached and cost more than the
// conversation did.
// SEQUENTIAL, NOT Promise.all. Two concurrent calls interleave against one budget and the
// second one's failure would be indistinguishable from the first one's.
async function ceCompressCharter(): Promise<string> {
    var chat = await loadBuildChat('premise');
    if (!chat.turns.length) return 'Nothing to read yet \u2014 talk it through first.';
    var base = await ceBuildChatMessages('premise', CE_P_PREMISE, chat.turns);
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    var params: any = { model: model, max_tokens: 400, temperature: 0.8, enable_thinking: false };
    var tiers: any[] = [
        { key: 'style', label: 'Rules', ask: CE_P_STYLE_TIER },
        { key: 'play',  label: 'Voice', ask: CE_P_PLAY_TIER }
    ];
    var failed: string[] = [];
    var wrote = 0;
    for (var i = 0; i < tiers.length; i++) {
        var msgs = base.slice(0);
        msgs.push({ role: 'user', content: CE_P_COMPRESS_WARN + '\n\n' + tiers[i].ask });
        try {
            var res: any = await aeDiagGenerateWithStory('charter:' + tiers[i].key, msgs, params,
                                                         undefined, undefined, 'background');
            var out = ceGenText(res);
            if (!out || out.toLowerCase() === 'none') { failed.push(tiers[i].label); continue; }
            await ceCharterWrite(tiers[i].key, out);
            wrote++;
        } catch (eCc) {
            // [GEN-FAIL-KIND] A transport failure stops the run rather than writing the
            // second tier over a first one that never arrived. A model failure is counted
            // and the other tier still gets its turn.
            api.v1.error('[AE:charter] compress failed:', eCc);
            if (_ceGenFailKind(eCc) === 'transport') {
                return 'The call did not reach the model. '
                     + (wrote ? 'Style was written; Voice was not. ' : 'Nothing was written. ')
                     + 'Try again in a moment.';
            }
            failed.push(tiers[i].label);
        }
    }
    if (!wrote) return 'Neither tier came back usable. Try again, or write them yourself.';
    if (failed.length) return failed.join(' and ') + ' did not come back \u2014 press again to retry.';
    return 'Charter written. Read it over before you build on it.';
}

// [GEN-THINK] ONE READER FOR EVERY GENERATION THIS PIPELINE MAKES, because a reasoning model
// leaks its scratchpad into the answer and every call site would otherwise learn that
// separately. OBSERVED on the chooser: a reply arrived carrying a bare `</think>` with no
// opener, which rode into a question's text.
//
// `enable_thinking: false` IS NOT ENOUGH AND IS NOT REMOVED. It is a request; this is what
// happens when the request is declined. Both, or the next model with a different flag name
// lands here anyway.
//
// THE UNPAIRED TAG IS THE HARD CASE and it is why this does not simply cut at the marker.
// A stray `</think>` means the opener was consumed upstream, so the reasoning is the part
// BEFORE it -- but a truncated reply can put the only usable text there instead. So: take
// what follows the tag, and fall back to what preceded it only when nothing follows. A
// cleaner that can return empty where the model returned something is worse than the leak.
function ceStripThink(s: string): string {
    var t = String(s || '');
    // Matched pairs first, however many.
    t = t.replace(/<think>[\s\S]*?<\/think>/gi, '');
    var close = t.toLowerCase().lastIndexOf('</think>');
    if (close >= 0) {
        var after = t.substring(close + 8);
        t = String(after).trim() ? after : t.substring(0, close);
    }
    // An opener with no closer: everything after it is scratchpad, unless it is everything.
    var open = t.toLowerCase().indexOf('<think>');
    if (open >= 0) {
        var before = t.substring(0, open);
        t = String(before).trim() ? before : t.substring(open + 7);
    }
    // The directive itself, when a preset appends it into the visible reply.
    t = t.replace(/\/nothink/gi, '');
    // PROMPTS 4.7 step 4: CE has no guard of this class anywhere on free-text generation,
    // and WE shipped a name reading `Pennraw</arg_value>` because a raw completion carried
    // its own tool markup. NAMED TAGS ONLY, never every angle bracket -- prose legitimately
    // contains one and a blanket strip would eat it.
    t = t.replace(/<\|[^|]*\|>/g, '');
    t = t.replace(/<\/?(?:think|thinking|reasoning|answer|response|tool_call|arg_value|arg_key)[^>]*>/gi, '');
    return t.trim();
}

// [EXTRACT-RELAPSE] A REPLY THAT IS A QUESTION IS NOT AN ANSWER, and it is detectable. The
// failure mode is specific: the model keeps conversing and proposes what to explore next, so
// the tell is a question mark plus second-person or hortative address. Both are needed --
// "What the border was fought over is still contested" is a legitimate canon sentence with no
// question mark, and a field may legitimately contain the word "you" in reported speech.
// IT REFUSES RATHER THAN WRITING. A conversational turn stored in Memory is read by the
// narrator before every scene for the life of the story, which is a worse outcome than a
// blank field the author can see is blank. MISS-NAMED's rule: reported with its own reason,
// never silently skipped.
function ceLooksConversational(s: string): boolean {
    var t = String(s || '').trim();
    if (!t) return false;
    if (t.indexOf('?') < 0) return false;
    var lo = t.toLowerCase();
    var tells = ['let us ', "let's ", 'should we', 'shall we', 'do you ', 'would you ',
                 'what do you', 'how do you', 'we could', 'we should', 'perhaps we',
                 'here are some', 'a few questions', 'to develop', 'think about'];
    for (var i = 0; i < tells.length; i++) {
        if (lo.indexOf(tells[i]) >= 0) return true;
    }
    // A reply that is mostly question is one too: three or more marks in a short answer is
    // an interview, whatever words it used.
    var marks = t.split('?').length - 1;
    return marks >= 3;
}

// The one read of a generation result. Every caller in this section goes through it rather
// than reaching into `choices` itself -- four copies of one shape is four places to forget
// the cleaner the next time a model does something new.
function ceGenText(res: any): string {
    var ch: any = (res && res.choices && res.choices[0]) || null;
    if (!ch) return '';
    return ceStripThink(String((ch.parsedContent || ch.text) || ''));
}

// ── The world passes  [WORLD-PICK] [WORLD-EXTRACT] ──────────────────────────
// BOTH REUSE A CHAT'S EXACT PREFIX, on CHARTER-COMPRESS's finding: the [system, ...turns]
// array is already warm from the conversation itself, so each ask pays only for itself.
// Building a fresh context blob for either would be fully uncached and cost more than the
// conversation did.

// The question list, resolved once, in one order, for both passes and the surface. Reading
// cfg in three places and filtering it three ways is how the surface comes to show a
// question the pass does not know about.
async function ceWorldQuestions(): Promise<any[]> {
    var cfg: any = await loadConfig();
    var list: any[] = (cfg && cfg.wizardSections && cfg.wizardSections.length)
        ? cfg.wizardSections : DEFAULT_WIZARD_SECTIONS;
    var out: any[] = [];
    for (var i = 0; i < list.length; i++) {
        // [BUILD-WORLD] The Author's-Note-targeted sections are not part of the pipeline's
        // question set. The charter's Voice tier owns that destination.
        if (list[i] && list[i].target !== 'an') out.push(list[i]);
    }
    return out;
}

// [WORLD-PICK] WHICH QUESTIONS THIS STORY ANSWERS, decided from the Premise conversation.
// IT READS PREMISE, NOT WORLD. The choice is about what KIND of story this is, which is what
// the premise chat is for; the world chat is where the chosen questions get answered, so
// reading it here would ask the author to have already done the thing this pass exists to
// start.
// IT NEVER SWITCHES OFF A QUESTION THAT HAS TEXT IN IT. A pass that silently discarded an
// answer would make the button unusable a second time, which is exactly when an author
// presses it -- after the conversation moved on.
// IT IS A STARTING POINT, NOT A VERDICT. Every question it touches has its switch on the
// same screen, so the result is visible and one tap from reversible. That is what buys the
// right to apply it directly instead of building a confirmation surface for it.
// [FIELD-MINT] The pass. It rides the SCOPE CHAT's exact prefix, on EXTRACT-HANDOFF's rule:
// the conversation about what these are is the only place the answer lives, and reusing its
// prefix is what makes the call cheap. The family switch rides the ask, not the head.
//
// IT WRITES INTO THE KIND'S FIELD LIBRARY, which is a config array shared with the profile's
// own define door -- so a question minted here appears on every record of the kind, exactly
// as one typed on a profile does. ONE READ AND ONE WRITE for the batch, which is why
// ceCustomFieldDefine takes a config.
async function ceFieldMint(kind: string, chatScope: string, chatBlock: string): Promise<string> {
    var cat = ceEntityCatalog(String(kind || ''));
    if (!cat) return 'This kind keeps no field library.';
    var chat = await loadBuildChat(String(chatScope || ''));
    if (!chat.turns.length) {
        return 'Nothing to read yet \u2014 talk these through in the chat below first.';
    }
    var noun = String(cat.noun || 'record');

    // What is already asked, so the model does not write it again. BOTH HALVES: the base
    // facets and the author's own, because a duplicate of a built-in is just as useless as
    // a duplicate of a custom one.
    var cfg: any = await loadConfig();
    var known: string[] = [];
    var base: any[] = (cat.base || []) as any[];
    var b = 0;
    for (b = 0; b < base.length; b++) { known.push(String(base[b].label || '')); }
    var own: any[] = Array.isArray(cfg[cat.cfgKey]) ? cfg[cat.cfgKey] : [];
    for (b = 0; b < own.length; b++) { known.push(String(own[b].label || '')); }

    var ask = CE_P_FIELD_MINT_HEAD + noun + CE_P_FIELD_MINT_BODY;
    if (known.length) {
        ask += '\n\nALREADY ASKED, so do not write these again:\n' + known.join('\n');
    }
    ask += CE_P_FIELD_MINT_TAIL;

    var msgs = await ceBuildChatMessages(String(chatScope || ''), String(chatBlock || ''),
                                         chat.turns);
    msgs.push({ role: 'user', content: ask });
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    // 0.7, the extraction row, for ceWorldChoose's stated reason: this pass reads AND
    // invents, so a colder read writes the obvious question and mints nothing.
    var params: any = { model: model, max_tokens: 320, temperature: 0.7, enable_thinking: false };
    var out = '';
    try {
        var res: any = await aeDiagGenerateWithStory('field:mint', msgs, params,
                                                     undefined, undefined, 'background');
        out = ceGenText(res);
    } catch (eFm) {
        api.v1.error('[AE:field] mint failed:', eFm);
        return _ceGenFailKind(eFm) === 'transport'
            ? 'The call did not reach the model. Nothing was changed \u2014 try again in a moment.'
            : 'The model returned nothing usable. Nothing was changed.';
    }

    // Parse first, write second, on ceWorldChoose's rule: a half-applied schema change is
    // worse than none.
    var adds: any[] = [];
    var raw: string[] = out.split('\n');
    for (var r = 0; r < raw.length; r++) {
        var line = ceStripThink(String(raw[r] || '')).trim();
        if (!line) continue;
        if (line.charAt(0) !== '+') continue;
        var rest = line.substring(1).trim();
        var bar = rest.indexOf('|');
        var nm = (bar >= 0 ? rest.substring(0, bar) : rest).trim();
        var hp = (bar >= 0 ? rest.substring(bar + 1) : '').trim();
        // The label is a heading, not a sentence. A model that answered with a whole
        // question keeps it, but one that wrote a paragraph is a format failure.
        if (!nm || nm.length > 48) continue;
        if (adds.length < CE_FIELD_MINT_MAX) adds.push({ label: nm, hint: hp });
    }
    if (!adds.length) {
        return 'Nothing was written. The conversation may not say enough about what these '
             + 'have in common yet \u2014 or you can add a question yourself below.';
    }

    var wrote = 0;
    var before = own.length;
    for (var a = 0; a < adds.length; a++) {
        cfg = await ceCustomFieldDefine(String(kind), String(adds[a].label),
                                        String(adds[a].hint), '', cfg);
    }
    var after: any[] = Array.isArray(cfg[cat.cfgKey]) ? cfg[cat.cfgKey] : [];
    wrote = after.length - before;
    if (wrote <= 0) {
        return 'Everything it wrote was already being asked. Nothing was changed.';
    }
    await saveConfig(cfg);
    return String(wrote) + ' question' + (wrote === 1 ? '' : 's')
        + ' added. Every ' + noun + ' is asked ' + (wrote === 1 ? 'it' : 'them')
        + ' from now on \u2014 edit or remove any of them on a ' + noun + '\u2019s profile.';
}

// [OPEN-WRITE] The pass. It rides the OPENING CHAT's own prefix, so an author who has said
// "start on the boat, not in the city" is answered by a call that has already read it.
// THE UPSTREAM IS ASSEMBLED HERE AND NOWHERE ELSE. ceWorldBlock and the record digests
// already exist and are what every other pass reads; an opening that built its own view of
// the world would be a second derivation of the same thing.
async function ceOpeningWrite(hint: string, budget?: number): Promise<string> {
    var c = await loadCharter();
    var chat = await loadBuildChat('opn:top');

    var parts: string[] = [];
    var wb = '';
    try { wb = await ceOpeningWorldBlock(); } catch (eOw1) { wb = ''; }
    if (String(wb || '').trim()) { parts.push(String(wb).trim()); }
    var cast = '';
    try { cast = await ceOpeningCastBlock(); } catch (eOw2) { cast = ''; }
    if (cast) { parts.push(cast); }
    if (String(c.play || '').trim()) {
        parts.push('HOW THIS IS PLAYED:\n' + String(c.play).trim());
    }
    if (String(hint || '').trim()) {
        parts.push('THE AUTHOR ASKS FOR THIS OPENING SPECIFICALLY:\n' + String(hint).trim());
    }
    if (!parts.length && !chat.turns.length) {
        return 'There is nothing to open yet \u2014 write the Premise and build a little of '
             + 'the world first.';
    }

    var sys = ceBuildHead({ family: 'machine', records: true, style: String(c.style || '') });
    sys += '\n\n' + CE_P_OPENING;
    var msgs: any[] = await ceBuildChatMessages('opn:top', '', chat.turns);
    msgs[0] = { role: 'system', content: sys };   // the machine head replaces the chat head
    msgs.push({ role: 'user', content: parts.join('\n\n') });

    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    // [P-SUBSTRATE] 0.9. This is the one pass that INVENTS rather than extracts, and the
    // extraction row's 0.7 writes competent, generic prose -- which is the specific thing an
    // opening cannot be.
    var maxT = Math.max(200, Math.min(2000, Math.round(Number(budget) || 900)));
    var params: any = { model: model, max_tokens: maxT, temperature: 0.9,
                        enable_thinking: false };
    var out = '';
    try {
        var res: any = await aeDiagGenerateWithStory('open:write', msgs, params,
                                                     undefined, undefined, 'background');
        out = ceGenText(res);
    } catch (eOw) {
        api.v1.error('[AE:open] write failed:', eOw);
        return _ceGenFailKind(eOw) === 'transport'
            ? 'The call did not reach the model. Nothing was changed \u2014 try again in a moment.'
            : 'The model returned nothing usable. Nothing was changed.';
    }
    var body = ceStripThink(String(out || '')).trim();
    if (!body) return 'The model returned nothing usable. Nothing was changed.';

    // [OPEN-DRAFT] STAGED, NEVER PLACED. Writing it and putting it in the story are two
    // acts, and the second one is the author's -- DESTRUCTIVE-NEVER-IN-PLACE applied to the
    // one control on this surface that touches the document.
    await ceCharterWrite('opening', body);
    return 'Written. Read it over and edit anything before you place it.';
}

// [OPEN-WRITE] The world's ANSWERED questions, and only the answered ones. ceWorldQuestions
// is the same list the World tab renders, so there is no second view of what this story has
// settled -- and an unanswered question contributes nothing but a heading the model would
// feel obliged to fill in.
async function ceOpeningWorldBlock(): Promise<string> {
    try {
        var qs: any[] = await ceWorldQuestions();
        var lines: string[] = [];
        for (var i = 0; i < qs.length; i++) {
            var v = String((qs[i] && qs[i].content) || '').trim();
            if (!v) continue;
            lines.push(String(qs[i].label || '') + ': ' + v);
        }
        return lines.length ? ('WHAT IS TRUE OF THIS WORLD:\n' + lines.join('\n')) : '';
    } catch (eOwb) {
        api.v1.error('[AE:open] world block failed:', eOwb);
        return '';
    }
}

// The cast and the committed world, as the opening pass sees them: NAMES AND ONE LINE EACH,
// never full records. A pass told everything about forty records writes about forty records.
async function ceOpeningCastBlock(): Promise<string> {
    try {
        var idx: any[] = await loadEntityIndex();
        var chars: string[] = [];
        var world: string[] = [];
        for (var i = 0; i < idx.length; i++) {
            var m: any = idx[i];
            if (!m || !String(m.name || '').trim()) continue;
            var line = String(m.name);
            var d = String(m.description || '').trim();
            if (d) { line += ' \u2014 ' + (d.length > 120 ? d.substring(0, 120) : d); }
            if (String(m.type) === 'character') { chars.push(line); }
            else { world.push(line); }
            if (chars.length + world.length >= 40) break;
        }
        var s = '';
        if (chars.length) { s += 'WHO EXISTS:\n' + chars.join('\n'); }
        if (world.length) {
            if (s) s += '\n\n';
            s += 'WHAT EXISTS:\n' + world.join('\n');
        }
        return s;
    } catch (eOcb) {
        api.v1.error('[AE:open] cast block failed:', eOcb);
        return '';
    }
}

// [OPEN-PLACE] THE ONE CONTROL IN THIS PIPELINE THAT WRITES INTO THE DOCUMENT. Everything
// else this file builds is a record; this puts prose in front of the author's cursor.
//   PARAGRAPHS, NOT ONE BLOCK. api.v1.document.appendParagraphs is what the rest of the file
//   already uses, and a single append would give NAI one enormous section that the editor
//   cannot split afterwards.
//   IT DOES NOT CLEAR THE DRAFT. Placing is not consuming: an author who places, dislikes it
//   and undoes in NAI must still have the text here.
async function ceOpeningPlace(): Promise<string> {
    var c = await loadCharter();
    var body = String((c as any).opening || '').trim();
    if (!body) return 'There is nothing written yet.';
    var paras: string[] = [];
    var raw: string[] = body.split('\n');
    for (var i = 0; i < raw.length; i++) {
        var ln = String(raw[i] || '').trim();
        if (ln) paras.push(ln);
    }
    if (!paras.length) return 'There is nothing written yet.';
    var secs: any[] = [];
    for (var p = 0; p < paras.length; p++) { secs.push({ text: paras[p] }); }
    try {
        await api.v1.document.appendParagraphs(secs);
    } catch (eOp) {
        api.v1.error('[AE:open] place failed:', eOp);
        return 'Could not write into the story. Nothing was placed.';
    }
    return String(paras.length) + ' paragraph' + (paras.length === 1 ? '' : 's')
        + ' added to the end of the story. It is still here if you want it again.';
}

async function ceWorldChoose(): Promise<string> {
    var chat = await loadBuildChat('premise');
    if (!chat.turns.length) {
        return 'Nothing to read yet \u2014 talk your story through in Premise first.';
    }
    var qs = await ceWorldQuestions();
    if (!qs.length) return 'There are no questions to choose from.';

    var lines: string[] = [];
    var known: any = {};
    for (var i = 0; i < qs.length; i++) {
        var q: any = qs[i];
        known[String(q.id)] = true;
        lines.push(String(q.id) + ' | ' + String(q.label || '') + ' | ' + ceWorldHelper(q));
    }
    var ask = CE_P_WORLD_PICK + lines.join('\n') + CE_P_WORLD_PICK_TAIL;

    var msgs = await ceBuildChatMessages('premise', CE_P_PREMISE, chat.turns);
    msgs.push({ role: 'user', content: ask });
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    // [P-SUBSTRATE] 0.7 is PROMPTS 5's extraction row -- reading a transcript, not
    // inventing. This pass does both, so it does not drop below it: a colder read picks the
    // obvious questions and mints nothing.
    var params: any = { model: model, max_tokens: 400, temperature: 0.7, enable_thinking: false };
    var out = '';
    try {
        var res: any = await aeDiagGenerateWithStory('world:pick', msgs, params,
                                                     undefined, undefined, 'background');
        out = ceGenText(res);
    } catch (eWp) {
        api.v1.error('[AE:world] choose failed:', eWp);
        return _ceGenFailKind(eWp) === 'transport'
            ? 'The call did not reach the model. Nothing was changed \u2014 try again in a moment.'
            : 'The model returned nothing usable. Nothing was changed.';
    }

    // Parse first, write second. A half-applied selection is worse than none, and the empty
    // parse is a real outcome rather than an error: it means the reply was unusable.
    var keep: any = {};
    var adds: any[] = [];
    var raw: string[] = out.split('\n');
    for (var r = 0; r < raw.length; r++) {
        var line = ceStripThink(String(raw[r] || ''));
        if (!line) continue;
        if (line.charAt(0) === '+') {
            var rest = line.substring(1).trim();
            var bar = rest.indexOf('|');
            var nm = (bar >= 0 ? rest.substring(0, bar) : rest).trim();
            var hp = (bar >= 0 ? rest.substring(bar + 1) : '').trim();
            if (nm && adds.length < CE_WORLD_PICK_ADD_MAX) adds.push({ label: nm, helper: hp });
            continue;
        }
        // A bare id, or an id at the head of a line the model decorated anyway.
        var tok = line.split(/[\s|,]+/)[0];
        if (known[tok]) keep[tok] = true;
    }
    var picked = 0;
    var kk: string;
    for (kk in keep) { picked++; }
    if (!picked && !adds.length) {
        return 'The reply named no questions. Nothing was changed \u2014 try again.';
    }
    // [CE_WORLD_ALWAYS] Forced on after the parse, never offered to the model to drop.
    for (var a = 0; a < CE_WORLD_ALWAYS.length; a++) {
        if (known[CE_WORLD_ALWAYS[a]]) keep[CE_WORLD_ALWAYS[a]] = true;
    }

    var on = 0; var off = 0; var kept = 0;
    for (var w = 0; w < qs.length; w++) {
        var s: any = qs[w];
        var sid = String(s.id);
        var want = !!keep[sid];
        var hasText = !!String(s.content || '').trim();
        if (!want && hasText) { kept++; continue; }   // answered questions are never dropped
        if (!!s.enabled === want) continue;
        await ceWorldSecWrite(sid, { enabled: want });
        if (want) { on++; } else { off++; }
    }
    var added = 0;
    for (var d = 0; d < adds.length; d++) {
        var nid = await ceWorldSecAdd(adds[d].label, adds[d].helper);
        if (nid) added++;
    }

    var msg = 'Questions chosen.';
    if (on) msg += ' ' + String(on) + ' switched on.';
    if (off) msg += ' ' + String(off) + ' left out.';
    if (added) {
        msg += ' ' + String(added) + ' new question' + (added === 1 ? '' : 's')
             + ' written for this story.';
    }
    if (kept) msg += ' ' + String(kept) + ' kept because ' + (kept === 1 ? 'it was' : 'they were') + ' already answered.';
    return msg + ' Change any of them below.';
}

// [WORLD-EXTRACT] THE ANSWERS, WRITTEN FROM THE WORLD CONVERSATION.
// BLANKS ONLY, AND ONLY WHERE THE QUESTION IS SWITCHED ON. This is the non-destructive twin
// of the charter's Write button: that one overwrites two fields the author is looking at,
// this one fills in gaps. An extraction that replaced answered questions would make the
// button unpressable the moment it became useful.
// ONE CALL PER QUESTION, SEQUENTIAL. Asking for every answer in one reply is the arrangement
// CHARTER-COMPRESS already measured and rejected -- the first field eats the output budget.
// The cost of doing it right is latency proportional to the blanks, which is bounded by the
// chosen set and is why the chooser runs first.
async function ceWorldExtract(): Promise<string> {
    var chat = await loadBuildChat('world');
    if (!chat.turns.length) {
        return 'Nothing to read yet \u2014 talk the world through above first.';
    }
    var qs = await ceWorldQuestions();
    var todo: any[] = [];
    for (var i = 0; i < qs.length; i++) {
        if (qs[i] && qs[i].enabled && !String(qs[i].content || '').trim()) todo.push(qs[i]);
    }
    if (!todo.length) return 'Every switched-on question already has an answer.';

    var base = await ceBuildChatMessages('world', CE_P_WORLD, chat.turns);
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    var params: any = { model: model, max_tokens: 300, temperature: 0.7, enable_thinking: false };
    var wrote = 0; var silent = 0; var failed = 0; var relapsed = 0;
    for (var t = 0; t < todo.length; t++) {
        var q: any = todo[t];
        try {
            var outT = await _ceWorldExtractOne(base, params, q);
            if (outT === null) { relapsed++; continue; }
            if (!outT) { silent++; continue; }
            await ceWorldSecWrite(String(q.id), { content: outT });
            wrote++;
        } catch (eWe) {
            // [GEN-FAIL-KIND] A transport failure stops the run. Continuing would spend the
            // rest of the questions against a door that is shut and report every one of them
            // as a model that had nothing to say.
            api.v1.error('[AE:world] extract failed:', eWe);
            if (_ceGenFailKind(eWe) === 'transport') {
                return 'The call did not reach the model after '
                     + String(wrote) + ' answer' + (wrote === 1 ? '' : 's')
                     + '. Press again to carry on from where it stopped.';
            }
            failed++;
        }
    }
    if (!wrote && !silent) return 'Nothing came back usable. Try again, or write them yourself.';
    var msg = wrote
        ? (String(wrote) + ' answer' + (wrote === 1 ? '' : 's') + ' written. Read them over.')
        : 'Nothing was written.';
    if (silent) {
        msg += ' ' + String(silent) + ' left blank \u2014 the conversation had not settled '
             + (silent === 1 ? 'it' : 'them') + ' yet.';
    }
    // [EXTRACT-RELAPSE] Named separately from a blank, because it is a different thing that
    // went wrong and a different thing to do about it: the conversation DID cover it and the
    // reply came back as chat. Re-roll that one field.
    if (relapsed) {
        msg += ' ' + String(relapsed) + ' came back as conversation rather than an answer '
             + '\u2014 re-roll ' + (relapsed === 1 ? 'it' : 'them') + ' below.';
    }
    if (failed) msg += ' ' + String(failed) + ' failed.';
    return msg;
}

// [EXTRACT-RELAPSE] ONE QUESTION, ONE RETRY, THEN REFUSE. Returns the text, '' for the
// `none` channel, or null when the model would not stop conversing.
// THE RETRY IS BLUNTER RATHER THAN LONGER. The first ask already revokes the chat framing;
// if that lost, restating it politely will lose again, so the re-ask is a flat instruction
// with the rejected turn above it as a real assistant message -- the same shape PROMPTS 4.6
// uses for a rejected name, and for the same reason: the model sees its own answer rather
// than being told about it in the third person.
async function _ceWorldExtractOne(base: any[], params: any, q: any): Promise<string | null> {
    var ask = _ceWorldExtractAsk(String(q.label || ''), ceWorldScope(q));
    var msgs = base.slice(0);
    msgs.push({ role: 'user', content: ask });
    var res: any = await aeDiagGenerateWithStory('world:extract', msgs, params,
                                                 undefined, undefined, 'background');
    var out = ceGenText(res);
    var low = out.toLowerCase();
    if (!out || low === 'none' || low === 'none.') return '';
    if (!ceLooksConversational(out)) return out;

    msgs.push({ role: 'assistant', content: out });
    msgs.push({ role: 'user', content:
        'That was a question, not an answer. Nobody will read it. Write the field itself: '
      + 'one to three sentences stating what is true, with no question and no address to '
      + 'anyone. If the conversation did not settle it, reply with the single word: none' });
    var res2: any = await aeDiagGenerateWithStory('world:extract:retry', msgs, params,
                                                  undefined, undefined, 'background');
    var out2 = ceGenText(res2);
    var low2 = out2.toLowerCase();
    if (!out2 || low2 === 'none' || low2 === 'none.') return '';
    if (ceLooksConversational(out2)) return null;
    return out2;
}

// [EXTRACT-REROLL] ONE FIELD, ON DEMAND. The author's answer to a bad extraction, and the
// reason there is no manifest step between the chat and the fields: a review pass over
// proposed answers is a second copy of the question list the author is already looking at,
// and WORLDPIPE 2 deleted exactly that structure for exactly that reason. A per-field
// re-roll costs one call and no surface.
// IT OVERWRITES, unlike the batch, because pressing it on a field that has content is the
// only reason to press it at all.
async function ceWorldReroll(secId: string): Promise<string> {
    var chat = await loadBuildChat('world');
    if (!chat.turns.length) return 'Nothing to read yet \u2014 talk the world through first.';
    var qs = await ceWorldQuestions();
    var q: any = null;
    for (var i = 0; i < qs.length; i++) {
        if (String(qs[i].id) === String(secId)) { q = qs[i]; break; }
    }
    if (!q) return 'That question is gone.';
    var base = await ceBuildChatMessages('world', CE_P_WORLD, chat.turns);
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    var params: any = { model: model, max_tokens: 300, temperature: 0.7, enable_thinking: false };
    try {
        var out = await _ceWorldExtractOne(base, params, q);
        if (out === null) {
            return 'It came back as conversation again. Try once more, or write it yourself.';
        }
        if (!out) return 'The conversation has not settled this one. Left as it was.';
        await ceWorldSecWrite(String(q.id), { content: out });
        return 'Rewritten from the chat.';
    } catch (eWr) {
        api.v1.error('[AE:world] reroll failed:', eWr);
        return _ceGenFailKind(eWr) === 'transport'
            ? 'The call did not reach the model. Nothing was changed.'
            : 'The model returned nothing usable. Nothing was changed.';
    }
}

// ── The scope form's writes  [SCOPE-FORM] [NO-MANIFEST] ─────────────────────
// WORLDPIPE 2: THERE IS NO MANIFEST. THE RECORDS ARE THE QUEUE. A manifest row and a stub
// record hold the same facts, and two structures holding the same facts is a second source of
// truth where the one that is not the record loses -- every consumer reads records. So the
// count on the scope form seeds STUB DRAFTS, and status is DERIVED from what is blank:
//   no name          queued      the name pass has not run, or the author has not typed one
//   name, no seeds   named
//   seeds            seeded      ready to commit
// That is F-29's rule (build the enumerator FROM the flag) applied to progress. Nothing
// stores a status and nothing can drift out of one.
//
// THE STAGING STORE IS THAT QUEUE AND IS NOT REPLACED. WizardDraft + STORAGE_WIZ_DRAFTS
// already has the [STAGING] contract -- generate, review, commit, nothing touching cfg or the
// lorebook until commitStagedDrafts runs -- and drafts gain fields rather than a sibling.
//
// [SCOPE-COUNT-HONEST] THE AUTHOR MAY NAME ROWS BEFORE ANYTHING GENERATES, which is the whole
// reason the count seeds rows rather than being remembered as a number. An author with three
// places already in mind types them in; the name pass fills the rest. A count held as a
// number until a generator existed would be a parked field [F-20], and the row is the thing
// that makes it not one.

// The rung a stub sits at, and the draft field it is stored under. `rung` is WORLDPIPE 5's
// first addition to the draft record; the draft's `fields` map is already a flat string map,
// so it needs no schema change to hold one.
var CE_DRAFT_RUNG_KEY = 'rung';
// [SEED-DURABLE] Seeds ride the draft's existing flat string map under a prefix rather than
// as a nested object, because WIZ_DRAFT_FIELDS-driven surfaces already iterate that map and
// a nested value would render as [object Object] on the one that does not know about it.
var CE_DRAFT_SEED_PFX = 'seed:';
// [BUILD-COMMIT-KIND] The seeds off a staged row, and the rung's shape out of a ladder that
// is already in hand. Both were inline in the location branch; a second kind reaching commit
// is exactly when a copy would have been made.
function _ceDraftSeeds(fields: any): any {
    var out: any = {};
    var k: string;
    for (k in (fields || {})) {
        if (String(k).indexOf(CE_DRAFT_SEED_PFX) !== 0) continue;
        var fid = String(k).substring(CE_DRAFT_SEED_PFX.length);
        if (fid && String(fields[k] || '').trim()) out[fid] = String(fields[k]).trim();
    }
    return out;
}
function _ceRungShapeIn(ladder: any[], rungId: string): string {
    for (var i = 0; i < (ladder || []).length; i++) {
        if (String(ladder[i].id) === String(rungId)) return ceRungShape(ladder[i]);
    }
    return '';
}

// [ROW-RETAIN] A COMMITTED ROW IS STAMPED, NOT DELETED. The seeds are written into the
// record's fields at commit and the record is then free to be generated over, so the row is
// the only place the ORIGINAL lines survive -- which is what makes SEED-IS-VALUE's accepted
// overwrite recoverable without a second structure on the record.
// EVERY DRAFT SCAN MUST SKIP A STAMPED ROW. commitStagedDrafts' own loop skips first, because
// the failure that costs something is a second Commit press minting a duplicate record.
var CE_DRAFT_DONE_KEY = 'committedTo';

// [SCOPE-DEPTH] WHERE THE AUTHOR IS STANDING, in tempStorage per WORLDPIPE 7.5: "the return
// target is session state, not story state, because a return path that survives a story
// switch points at a record the story does not have." '' is the top rung.
// NO MODULE MIRROR. One was written for "a render can read it without awaiting" and had no
// synchronous reader: the surface reads st.scopeAt, which cePublishBuild already resolved.
// A second copy of a pointer whose only consumer is the store is the parked-field shape one
// layer over, so there is one store and one read.
// [SCOPE-PER-KIND] ONE POINTER PER RECURSIVE KIND, not one for the route. Locations and
// factions both have depth and an author moves between the two stages mid-build; a single
// pointer would carry a location id into the faction stage, where it names nothing and the
// list comes back empty with no way to tell why. The key is suffixed rather than a second
// storage entry so a kind added later needs no new key.
// A FLAT KIND NEVER READS IT. Species, items and threads have no depth to be at, so their
// pointer is always '' and the suffix is never minted.
function _ceScopeKey(kind: string): string {
    var k = String(kind || 'location');
    return (k === 'location') ? STORAGE_BUILD_SCOPE : (STORAGE_BUILD_SCOPE + ':' + k);
}
async function ceScopeLoadAt(kind?: string): Promise<string> {
    try {
        var v = await api.v1.tempStorage.getOrDefault(_ceScopeKey(String(kind || 'location')),
                                                      '') as string;
        return String(v || '');
    } catch (eSl) { return ''; }
}
// [KIND-LIST] WHICH LIST THE AUTHOR IS STANDING IN, on its own key rather than overloaded
// onto the scope pointer. `scopeAt` means "which record am I inside" and a list is not a
// record; fusing them would have made a species' parentId read as 'people'.
// tempStorage, on SCOPE-DEPTH's own argument: it is where the author is standing, which is
// session state and not a fact about the story.
function _ceListKey(kind: string): string {
    return STORAGE_BUILD_SCOPE + ':list:' + String(kind || '');
}
async function ceListLoadAt(kind: string): Promise<string> {
    var list: any[] = ceKindLists(kind);
    if (!list.length) return '';
    var v = '';
    try { v = await api.v1.tempStorage.getOrDefault(_ceListKey(kind), '') as string; }
    catch (eLl) { v = ''; }
    var d: any = ceKindListDef(kind, String(v || ''));
    return String((d && d.id) || '');
}
async function ceListSetAt(kind: string, id: string): Promise<void> {
    try { await api.v1.tempStorage.set(_ceListKey(kind), String(id || '')); }
    catch (eLs) { api.v1.error('[AE:scope] list pointer write failed:', eLs); }
}

async function ceScopeSetAt(id: string, kind?: string): Promise<void> {
    try {
        await api.v1.tempStorage.set(_ceScopeKey(String(kind || 'location')), String(id || ''));
    } catch (eSs) { api.v1.error('[AE:scope] scope pointer write failed:', eSs); }
}

// [LADDER] The rung a record's CHILDREN sit at: the one after the record's own. Returns null
// when the ladder has no rung below, which is the case WIZUI 5 gap 1 covers -- the workspace
// asks for one inline rather than inventing it.
// [LADDER-PER-PLACE] AND IT IS A DEFAULT, NOT A DERIVATION. Different things sit directly
// under a region -- a city in one place, a single house in another -- so the ladder answers
// "what usually comes next" and the row's own picker answers "what this one is". Gaps are
// legal (WORLDPIPE 6.4) and a skipped rung is a true fact about the world.
function ceLadderNext(ladder: any[], rungId: string): any {
    var list: any[] = ladder || [];
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) === String(rungId)) {
            return (i + 1 < list.length) ? list[i + 1] : null;
        }
    }
    return list.length ? list[0] : null;
}
// Append a rung to the ladder. Used by the workspace's empty state at a new depth, which is
// where WIZUI 5 gap 1 puts the question.
async function ceLadderAppend(label: string, scope: string, kind?: string): Promise<string> {
    var lab = String(label || '').trim();
    if (!lab) return '';
    var kd = String(kind || 'location');
    var c = await loadCharter();
    var ladder: any[] = ceKindLadder(kd, c).slice(0);
    var rid = 'rung_' + generateId();
    // [KIND-SCOPE] Validated against THIS KIND's vocabulary. The location-only validator
    // this replaces quietly rewrote a species' 'people' to 'any'.
    ladder.push({ id: rid, label: lab, scope: ceKindScopeOk(kd, scope) });
    await ceKindLadderWrite(kd, ladder);
    return rid;
}

// Status, DERIVED. One resolver, so the list and any count read the same answer.
function ceScopeRowState(d: any): string {
    if (!d) return 'queued';
    var f: any = d.fields || {};
    if (!String(f.name || '').trim()) return 'queued';
    if (String(f.description || '').trim() || String(f.lore || '').trim()) return 'seeded';
    // [SEED-PARTIAL] A row whose reply omitted the SUMMARY line but answered questions IS
    // seeded. Reading only `description` would have offered it to the batch again and paid
    // for a second set of the lines it already has.
    var k: string;
    for (k in f) {
        if (k.indexOf(CE_DRAFT_SEED_PFX) === 0 && String(f[k] || '').trim()) return 'seeded';
    }
    return 'named';
}

// [SCOPE-FORM] Author the top rung and seed its queue in ONE act, because they are one
// decision: "the biggest spaces here are Regions and there are about six of them."
// IT IS ADDITIVE ON RE-PRESS AND NEVER DESTRUCTIVE. Pressing it again with a larger count
// tops the queue up to that count; a smaller one leaves what is there. Rows the author has
// already named are exactly what a destructive re-seed would throw away, and this form is
// the only way back to it.
async function ceScopeWrite(label: string, scope: string, count: number, intent: string,
                            parentId: string, rungIdIn: string, kind?: string,
                            listId?: string): Promise<string> {
    var kdW = String(kind || 'location');
    var lab = String(label || '').trim();
    var sc = ceKindScopeOk(kdW, scope);   // [KIND-SCOPE]
    var want = Math.max(0, Math.min(24, Math.round(Number(count) || 0)));
    var line = String(intent || '').trim();
    var par = String(parentId || '') || null;
    var rungId = String(rungIdIn || '');

    // [KIND-LIST] A FLAT KIND NEVER AUTHORS A RUNG. It has no scales, so the label field is
    // not on its form and `lab` is always blank -- which would have hit the "Give these a
    // name first" refusal below and made the button do nothing at all. The rung block is
    // skipped entirely rather than being fed a placeholder, because a ladder with one
    // invented rung on it is a ladder pretending to be a scale.
    var wantsRung = ceKindLaddered(kdW);
    if (!wantsRung) { rungId = ''; }
    else if (!rungId) {
        if (!lab) return 'Give these a name first.';
        var charter = await loadCharter();
        var ladder: any[] = ceKindLadder(kdW, charter).slice(0);
        if (!par && ladder.length) {
            ladder[0] = { id: String(ladder[0].id || ('rung_' + generateId())), label: lab, scope: sc };
            await ceKindLadderWrite(kdW, ladder);
            rungId = String(ladder[0].id);
        } else {
            rungId = await ceLadderAppend(lab, sc, kdW);
        }
    } else if (lab) {
        var c2 = await loadCharter();
        var l2: any[] = ceKindLadder(kdW, c2).slice(0);
        for (var r = 0; r < l2.length; r++) {
            if (String(l2[r].id) === rungId) { l2[r] = { id: rungId, label: lab, scope: sc }; }
        }
        await ceKindLadderWrite(kdW, l2);
    }
    if (wantsRung && !rungId) return 'Could not work out which scale these sit at.';

    // The queue: top up to `want`, counting only stubs already at this parent and rung.
    var drafts = await loadWizardDraftsOfKind(kdW);
    var here = 0;
    for (var i = 0; i < drafts.length; i++) {
        if (!drafts[i]) continue;
        // [ROW-RETAIN] A COMMITTED ROW IS NOT QUEUED. Stamped drafts are kept so the built
        // list can still show the lines a record was born with, and every other draft scan
        // in the file skips them -- cePublishBuild's queue scan and commitStagedDrafts' own
        // loop both do. THIS ONE DID NOT, so after committing two the count read 2, `want`
        // could never exceed it, and Add reported "2 already queued" while the staged list
        // was visibly empty. The queue and the count have to mean the same thing or the
        // number in the box is answering a different question from the list under it.
        if (String((drafts[i].fields || {})[CE_DRAFT_DONE_KEY] || '')) continue;
        if (String(drafts[i].parentId || '') !== String(par || '')) continue;
        // [KIND-LIST] A list kind counts against the LIST, the way a laddered one counts
        // against the rung. Both are "how many of these are already queued where I am
        // standing"; only the address differs.
        if (listId) {
            if (String((drafts[i] as any).listId || '') === String(listId)) here++;
            continue;
        }
        if (String((drafts[i].fields || {})[CE_DRAFT_RUNG_KEY] || '') === rungId) here++;
    }
    var add = Math.max(0, want - here);
    if (add > 0) {
        var items: any[] = [];
        for (var n = 0; n < add; n++) {
            var row: any = { name: '', description: '', lore: '' };
            if (rungId) { row[CE_DRAFT_RUNG_KEY] = rungId; }
            // The optional line rides every stub in the batch. It is the author's one steer
            // for what these places have in common, and it is what the name pass reads.
            if (line) { row.intent = line; }
            items.push(row);
        }
        // [BUILD-CHROME-READS] THE STAGE'S KIND, and the last site that was not. The rung
        // was written onto the faction ladder, the count was counted against faction
        // drafts, and then the rows themselves were staged as LOCATIONS -- so Add factions
        // reported success, put nothing on the faction stage, and quietly grew the location
        // queue. A write whose kind disagrees with the read beside it is the shape this
        // whole patch is about; this one had it inside a single function.
        await addWizardDrafts(kdW, items, [], par, String(listId || '') || undefined);
    }

    var nounW = _ceKindNoun(kdW);
    var msg = lab ? ('These are ' + lab + '.') : 'Scale set.';
    if (add > 0) {
        msg += ' ' + String(add) + ' ' + (add === 1 ? nounW : _cePlural(nounW)) + ' queued.';
    } else if (want && here >= want) { msg += ' ' + String(here) + ' already queued.'; }
    return msg + ' Name any you already have in mind.';
}

// [SCOPE-DOOR] ONE DOOR WITH A SCOPE ARGUMENT, BOTH WAYS (WORLDPIPE 7.5). "Open" and "Step
// into" are two destinations off one committed row and they are deliberately two visible
// affordances rather than one door that guesses:
//   OPEN       the record's own profile, to develop the seeds this pipeline wrote into full
//              fields, with the return leg in the head. That is the existing Entity surface
//              and it gains a door, not a batch generator.
//   STEP INTO  this same workspace, one scale down, to name what is inside it.
// The return leg is NAV-BACK's existing `back` address, which is why there is no second
// back-button here: a surface inventing its own is how three of them appear.
// [BUILD-ONE-ROUTE] THE WAY BACK, AND IT NAMES THE STAGE. The address carried no `tab`, so
// Back returned to whichever stage the route happened to be showing rather than the one the
// author left from -- the return address for a round trip the route makes on purpose.
// ceNav forwards `tab` and ceBack has consumed it since F-29, so this is the missing half.
function ceScopeBackAddr(): any {
    return { surface: 'build', entityId: '', tab: _ceBuildStage(), label: 'Building' };
}

// One write verb for a stub's field, on ceWorldSecWrite's shape.
async function ceScopeRowWrite(id: string, key: string, value: string): Promise<void> {
    try { await updateWizardDraftField(String(id), String(key), String(value || '')); }
    catch (eSrw) { api.v1.error('[AE:scope] row write failed:', eSrw); }
}

async function ceScopeRowDelete(id: string): Promise<void> {
    try {
        var all = await loadWizardDrafts();
        var keep: any[] = [];
        for (var i = 0; i < all.length; i++) {
            if (all[i] && String(all[i].id) !== String(id)) keep.push(all[i]);
        }
        await saveWizardDrafts(keep);
    } catch (eSrd) { api.v1.error('[AE:scope] row delete failed:', eSrd); }
}

// ── The name pass  [NAME-CALL] ──────────────────────────────────────────────
// PROMPTS 4: the highest-volume call in the pipeline and the cheapest to get right. A name
// that arrives ALONE can be compared against a pool and re-asked for; a name inside a
// paragraph cannot be fixed without discarding good prose. At ~24 tokens three retries cost
// less than one retry of a full record.
//
// [NAME-POOL-WORLD] THE POOL IS WORLD-WIDE, not scoped to the rung. PROMPTS 4.3 argues pools
// are per KIND -- an object and a region sharing a root is fine, two sibling places sharing
// one is not -- and the second half of that is what decides it here: two places with the same
// name anywhere in one world is the collision that actually bites a reader, and a pool that
// only saw siblings would let every region quietly reuse its neighbour's district names.
// The ~120 cap is what keeps that affordable.
//
// [NAME-APPEND-ONLY] THE POOL GROWS BY APPENDING, oldest first. Call n's prompt is literally
// call n-1's prompt plus text, which is a prefix extension and stays warm. WE orders its
// pools most-recent-first with a cap, which rewrites the block every call and throws the
// prefix away; CE must not copy that. The cap applies to the SEEDED head only -- within a
// batch the pool grows unbounded, which is correct, because a batch is a few dozen names.

var CE_NAME_POOL_CAP = 120;

// [NAME-CLEAN] PROMPTS 4.7, in order. Step 1 is the GLM-specific rung WE does not have: the
// common failure is "Here is a name:\nAshford", and a first-line rule ALONE returns the
// preamble. Step 4 is the guard CE had nowhere on free-text generation -- WE shipped a name
// reading `Pennraw</arg_value>` because the raw completion carried its own tool markup, and
// a legitimate name never contains an angle bracket, so truncating there is free.
function ceNameClean(raw: string): string {
    var t = ceStripThink(String(raw || ''));
    // FENCES COME OFF BEFORE THE LINE IS PICKED, and the order matters: a fenced reply's
    // first non-empty line is the fence itself, so picking first left "```" and the sweep
    // then emptied it. Measured on ```\nBrackwater\n``` , which returned nothing.
    t = t.replace(/```[a-z]*/gi, '').replace(/`/g, '');
    // 1. first non-empty line, and a line ending in a colon is a preamble.
    var lines = t.split('\n');
    var pick = '';
    for (var i = 0; i < lines.length; i++) {
        var ln = String(lines[i] || '').trim();
        if (!ln) continue;
        if (ln.charAt(ln.length - 1) === ':') continue;
        pick = ln; break;
    }
    t = pick;
    // 2. a leading key. CASE-INSENSITIVE, because the spec's two spellings are `NAME:` and
    // `Name -` and an alternation of the two literal cases matches neither of them.
    t = t.replace(/^\s*name\s*[:\-\u2014]\s*/i, '');
    // 4. truncate at the first angle bracket, then sweep any remaining fragment.
    var lt = t.indexOf('<');
    if (lt >= 0) t = t.substring(0, lt);
    t = t.replace(/<[^>]*>/g, '');
    // 5. surrounding quotes and trailing punctuation.
    t = t.trim().replace(/^["'\u201c\u2018]+/, '').replace(/["'\u201d\u2019]+$/, '');
    t = t.replace(/[.,;:!]+$/, '').trim();
    // 7. length is the cheapest tell that a model started writing a description.
    if (t.length > 60) return '';
    return t;
}

// [NAME-COMPARE] PROMPTS 4.8. The article is stripped for COMPARISON ONLY -- it stays in the
// stored name if the model wrote one.
function ceNameNormalise(s: string): string {
    return String(s || '').toLowerCase()
        .replace(/^(the|a|an)\s+/, '')
        .replace(/[^a-z0-9]/g, '');
}
function ceNameDistance(a: string, b: string): number {
    var s = String(a || ''); var t = String(b || '');
    if (s === t) return 0;
    if (!s.length) return t.length;
    if (!t.length) return s.length;
    var prev: number[] = [];
    var i = 0; var j = 0;
    for (j = 0; j <= t.length; j++) { prev.push(j); }
    for (i = 1; i <= s.length; i++) {
        var cur: number[] = [i];
        for (j = 1; j <= t.length; j++) {
            var cost = (s.charAt(i - 1) === t.charAt(j - 1)) ? 0 : 1;
            var del = prev[j] + 1;
            var ins = cur[j - 1] + 1;
            var sub = prev[j - 1] + cost;
            cur.push(Math.min(del, Math.min(ins, sub)));
        }
        prev = cur;
    }
    return prev[t.length];
}
// Returns '' for no clash, else 'exact:<name>' or 'near:<name>'. EXACT IS NEVER ACCEPTED at
// any rung; near is acceptable only on the final rung, with a log line.
function ceNameClash(cand: string, pool: string[]): string {
    var c = ceNameNormalise(cand);
    if (!c) return '';
    var i = 0;
    for (i = 0; i < pool.length; i++) {
        if (ceNameNormalise(pool[i]) === c) return 'exact:' + pool[i];
    }
    for (i = 0; i < pool.length; i++) {
        var p = ceNameNormalise(pool[i]);
        if (!p) continue;
        var shorter = Math.min(p.length, c.length);
        var lim = (shorter <= 6) ? 1 : 2;
        if (ceNameDistance(p, c) <= lim) return 'near:' + pool[i];
    }
    // [NAME-ROOT] THE SHARED-ROOT RUNG, AND IT EXISTS BECAUSE THE SPEC'S RULE AND THE SPEC'S
    // EXAMPLE DISAGREE. PROMPTS 4.8 gives the threshold as "<=1 when the shorter name is 6
    // characters or fewer, <=2 otherwise" and says it "catches Duskmere/Duskmoor". It does
    // not: the normalised forms differ in three positions, so Levenshtein returns 3 and the
    // stated rule clears it. Measured, not reasoned.
    // The example is the intent and the threshold is the letter, so both are implemented: a
    // long shared prefix on two long names is a shared ROOT, which is the thing the example
    // is about and the thing distance cannot see.
    // IT RETURNS `near`, NEVER `exact`, so it costs at most one re-ask and is still
    // acceptable on the final rung -- which matters because NAMING itself says repetition is
    // fine and real worlds have three places with the same name.
    for (i = 0; i < pool.length; i++) {
        var pr = ceNameNormalise(pool[i]);
        if (pr.length < 7 || c.length < 7) continue;
        if (pr.substring(0, 5) === c.substring(0, 5)) return 'near:' + pool[i];
    }
    return '';
}

// [NAME-POOL-WORLD] Every committed location name, most recent last so the append stays an
// extension. Capped on the normalised form so two spellings of one name cost one slot.
async function ceNamePool(): Promise<string[]> {
    var out: string[] = [];
    try {
        var idx = await loadEntityIndex();
        var seen: any = {};
        for (var i = 0; i < idx.length; i++) {
            var m: any = idx[i];
            if (!m || String(m.type) !== 'location') continue;
            var nm = String(m.name || '').trim();
            if (!nm) continue;
            var k = ceNameNormalise(nm);
            if (!k || seen[k]) continue;
            seen[k] = true;
            out.push(nm);
        }
    } catch (eNp) { api.v1.error('[AE:name] pool read failed:', eNp); }
    if (out.length > CE_NAME_POOL_CAP) out = out.slice(out.length - CE_NAME_POOL_CAP);
    return out;
}

function ceNamePoolBlock(noun: string, pool: string[]): string {
    return 'Names already used for ' + String(noun) + ' in this world. Your name must not '
         + 'match any of these or closely resemble one:\n' + pool.join(', ');
}

// [LADDER-BLOCK] PROMPTS 8, locations only. The last paragraph is called the single most
// valuable line in the whole location pipeline, and the reason is worth keeping at the code:
// without it a model handed "a ward" describes the hospital, the city and the country it is
// in, because that is the shape of every worldbuilding text it has ever read.
// [NAME-KIND] A LADDERLESS KIND GETS A DIFFERENT BLOCK, NOT A LADDER WITH NOTHING IN IT.
// This block's every sentence is about SCALE -- "described at these levels", "the level of",
// "do not describe the inside of anything below it" -- and a kind with no scales was handed
// it anyway, with an empty level list and the rung falling back to "this scale". An item was
// told it was a place at an unnamed scale in a world of Universes.
function ceKindNameBlock(kind: string, intentLine: string): string {
    var noun = _ceKindNoun(kind);
    var s = 'WHAT YOU ARE NAMING\n';
    s += 'A ' + noun + '. Not a place, not a person \u2014 a ' + noun + ', and the name must '
       + 'read like one.\n';
    if (String(intentLine || '').trim()) {
        s += '\nTrue of all of them:\n' + String(intentLine).trim() + '\n';
    }
    s += '\nGive the name only. Do not describe it, do not place it anywhere, and do not '
       + 'invent a category above or below it.';
    return s;
}

function ceLadderBlock(ladder: any[], rung: any, parentName: string, belowLabel: string): string {
    var names: string[] = [];
    for (var i = 0; i < (ladder || []).length; i++) { names.push(String(ladder[i].label || '')); }
    var s = 'SCALE\n';
    if (names.length) s += 'This world is described at these levels, largest first:\n'
                        + names.join(' > ') + '\n\n';
    s += 'You are writing at the level of: ' + String((rung && rung.label) || 'this scale') + '.\n';
    s += String(parentName || '').trim()
        ? ('This sits inside ' + String(parentName) + '.\n')
        : 'This is the largest scale in the world.\n';
    s += String(belowLabel || '').trim()
        ? ('What this level contains: ' + String(belowLabel) + '.\n')
        : 'Nothing smaller has been described yet.\n';
    s += '\nStay at this level. Do not invent a level above it, and do not describe the '
       + 'inside of anything below it \u2014 those are written separately, and anything you '
       + 'say about them here will contradict what is written there.';
    return s;
}

// The name call's own head. NOT the chat's prefix: this is a MACHINE-family call with its own
// stable prefix, so the pool and the ask are the only things that move within a batch.
// [NAME-KIND] THE LADDER IS THE KIND'S, AND SO IS THE BLOCK. It read `c.ladder` -- the
// LOCATION ladder -- for every kind, while ceNameBatch had already resolved the right one
// and never passed it. So naming factions announced the location scale, and naming items,
// species, threads or characters announced a location scale those kinds do not have.
//
// [NAME-FROM-CHAT] THE CONVERSATION IS PART OF THE BASE. The pass had no access to it at
// all: the author would spend ten turns saying what these are and then get names drawn from
// nothing but a noun and a pool. It goes in the BASE rather than the per-row ask, which is
// what keeps NAME-CALL's stable-prefix property -- the transcript is identical for every row
// in the batch, so call n's prompt is still call n-1's plus text.
async function ceNameMessages(rung: any, parentName: string, belowLabel: string,
                              pool: string[], noun: string,
                              kind?: string, ladder?: any[], intentLine?: string,
                              transcript?: string): Promise<any[]> {
    var c = await loadCharter();
    var kdM = String(kind || 'location');
    var sys = ceBuildHead({ family: 'machine', records: true, naming: true,
                            style: String(c.style || '') });
    var lad: any[] = Array.isArray(ladder) ? ladder : ceKindLadder(kdM, c);
    var lb = (rung && lad.length)
        ? ceLadderBlock(lad, rung, parentName, belowLabel)
        : ceKindNameBlock(kdM, String(intentLine || ''));
    if (lb) sys = sys + '\n\n' + lb;
    var msgs: any[] = [{ role: 'system', content: sys }];
    if (String(transcript || '').trim()) {
        msgs.push({ role: 'user', content:
            'WHAT THE AUTHOR HAS SAID ABOUT THESE. Names they used are the ones to use; '
          + 'names they rejected are not. If they have not named this one, the conversation '
          + 'still tells you what it should sound like.\n\n' + String(transcript).trim() });
    }
    if (pool.length) msgs.push({ role: 'user', content: ceNamePoolBlock(noun, pool) });
    return msgs;
}

var CE_P_NAME_UNUSABLE =
    'That was not a usable name. Reply with the name itself and nothing else \u2014 no '
  + 'sentence, no explanation, no quotation marks.';

var CE_P_NAME_FIVE =
    'Give five different names for this, one per line. Each must use a different root word '
  + 'and sound unlike the other four. Nothing on any line except the name.';

// [NAME-RETRY] PROMPTS 4.6. Two properties, and both are structural rather than stylistic:
// the rejected candidate goes back as a REAL assistant turn so the model sees its own answer
// rather than being told about it in the third person, and AN EXACT DUPLICATE IS NEVER
// ACCEPTED -- this returns '' and the caller owns the failure, which makes an exact-duplicate
// record impossible without ever stalling the batch.
// The final rung asks for FIVE at once and takes the first clean non-colliding one; a NEAR
// match is acceptable there, with a log line, because five roots that all collide means the
// pool has genuinely crowded the space and one more single-shot will not find room.
async function ceNameOne(base: any[], noun: string, intent: string, pool: string[]): Promise<string> {
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    var params: any = { model: model, max_tokens: 24, temperature: 0.95,
                        enable_thinking: false, stop: ['\n'] };
    var ask = 'Name one ' + String(noun) + '.';
    if (String(intent || '').trim()) ask += ' ' + String(intent).trim();
    ask += '\nReply with only the name.';

    var msgs = base.slice(0);
    msgs.push({ role: 'user', content: ask });
    var attempt = 0;
    for (attempt = 0; attempt < 3; attempt++) {
        var res: any = await aeDiagGenerateWithStory('name:' + noun, msgs, params,
                                                     undefined, undefined, 'background');
        var raw = ceGenText(res);
        var cand = ceNameClean(raw);
        if (!cand) {
            msgs.push({ role: 'assistant', content: raw || '(nothing)' });
            msgs.push({ role: 'user', content: CE_P_NAME_UNUSABLE });
            continue;
        }
        var clash = ceNameClash(cand, pool);
        if (!clash) return cand;
        var kind = clash.indexOf('exact:') === 0 ? 'identical to' : 'too close to';
        var other = clash.substring(clash.indexOf(':') + 1);
        msgs.push({ role: 'assistant', content: cand });
        msgs.push({ role: 'user', content:
            '\u201c' + cand + '\u201d is ' + kind + ' \u201c' + other + '\u201d, which '
          + 'already exists in this world. Give a completely different name \u2014 a '
          + 'different root and a different sound, not a variation on that one. Reply with '
          + 'only the name.' });
    }

    // The final rung: five at once, no stop, and a near match is allowed here.
    var five = base.slice(0);
    five.push({ role: 'user', content: ask + '\n\n' + CE_P_NAME_FIVE });
    var fp: any = { model: model, max_tokens: 80, temperature: 1.0, enable_thinking: false };
    var fres: any = await aeDiagGenerateWithStory('name:five:' + noun, five, fp,
                                                  undefined, undefined, 'background');
    var flines = ceStripThink(ceGenText(fres)).split('\n');
    var nearFallback = '';
    for (var f = 0; f < flines.length; f++) {
        var fc = ceNameClean(flines[f]);
        if (!fc) continue;
        var fClash = ceNameClash(fc, pool);
        if (!fClash) return fc;
        if (fClash.indexOf('near:') === 0 && !nearFallback) nearFallback = fc;
    }
    if (nearFallback) {
        api.v1.log('[AE:name] accepted a near match on the final rung: ' + nearFallback);
        return nearFallback;
    }
    return '';
}

// [NAME-BATCH] The pass, over the queued rows at one scope. SAVE AFTER EVERY ROW and count
// failures rather than aborting: WORLDPIPE 8's rule, and it is what makes "run it again for
// the failed ones" mean something. A transport failure halts with everything before it
// intact, because continuing spends the rest of the batch against a door that is shut.
async function ceNameBatch(parentId: string, rungId: string, kind?: string): Promise<string> {
    var kdN = String(kind || 'location');
    var c = await loadCharter();
    var ladder: any[] = ceKindLadder(kdN, c);
    var rung: any = null;
    for (var r = 0; r < ladder.length; r++) {
        if (String(ladder[r].id) === String(rungId)) rung = ladder[r];
    }
    // [NAME-KIND] THE KIND'S NOUN, NOT 'place'. A ladderless kind has no rung, so every
    // item, species, thread and character in the pipeline was asked for by the literal
    // sentence "Name one place." -- which is the whole of the reported symptom.
    var noun = String((rung && rung.label) || _ceKindNoun(kdN)).toLowerCase();
    var nextRung = ceLadderNext(ladder, String(rungId));
    var belowLabel = nextRung ? String(nextRung.label) : '';
    var parentName = '';
    if (parentId) {
        var pe = await loadEntity(String(parentId));
        parentName = String((pe && pe.name) || '');
    }

    var drafts = await loadWizardDraftsOfKind(kdN);
    var todo: any[] = [];
    for (var i = 0; i < drafts.length; i++) {
        var d: any = drafts[i];
        if (!d) continue;
        if (String(d.parentId || '') !== String(parentId || '')) continue;
        if (String((d.fields || {})[CE_DRAFT_RUNG_KEY] || '') !== String(rungId)) continue;
        if (String((d.fields || {}).name || '').trim()) continue;
        todo.push(d);
    }
    if (!todo.length) {
        return 'Every ' + _ceKindNoun(kdN) + ' here already has a name.';
    }

    var pool = await ceNamePool();
    // [NAME-FROM-CHAT] The conversation about this set, flattened once for the whole batch.
    var nTrans = '';
    try {
        var nChat: any = await loadBuildChat(_ceChatPfx(kdN) + ':'
                                             + (String(parentId || '') || 'top'));
        var nParts: string[] = [];
        for (var nt = 0; nt < nChat.turns.length; nt++) {
            var tu: any = nChat.turns[nt];
            nParts.push((String(tu.role) === 'user' ? 'Author: ' : 'You: ')
                        + String(tu.text || ''));
        }
        nTrans = nParts.join('\n\n');
    } catch (eNt) { nTrans = ''; }
    // The batch line rides every stub in this queue, so it is the same for all of them and
    // belongs in the stable base rather than being re-sent with each row's ask.
    var nIntent = String((todo[0] && (todo[0].fields || {}).intent) || '');
    var base = await ceNameMessages(rung, parentName, belowLabel, pool, noun + 's',
                                    kdN, ladder, nIntent, nTrans);
    var made = 0; var failed = 0;
    for (var t = 0; t < todo.length; t++) {
        var intent = String((todo[t].fields || {}).intent || '');
        try {
            var nm = await ceNameOne(base, noun, intent, pool);
            if (!nm) { failed++; continue; }
            await ceScopeRowWrite(String(todo[t].id), 'name', nm);
            // [NAME-APPEND-ONLY] The accepted name joins the pool AND the prefix, in place,
            // so the next call is this call plus text.
            pool.push(nm);
            base = await ceNameMessages(rung, parentName, belowLabel, pool, noun + 's',
                                        kdN, ladder, nIntent, nTrans);
            made++;
        } catch (eNb) {
            api.v1.error('[AE:name] batch failed:', eNb);
            if (_ceGenFailKind(eNb) === 'transport') {
                return 'The call did not reach the model after ' + String(made)
                     + ' name' + (made === 1 ? '' : 's') + '. Press again to carry on.';
            }
            failed++;
        }
    }
    var msg = String(made) + ' named.';
    if (failed) {
        msg += ' ' + String(failed) + ' could not be \u2014 press again for '
             + (failed === 1 ? 'it' : 'those') + ', or type ' + (failed === 1 ? 'it' : 'them')
             + ' in.';
    }
    return msg;
}

// ── Digests  [DIGEST-ANCESTOR] [DIGEST-SIBLING] ─────────────────────────────
// PROMPTS 9: EVERY CROSS-RECORD READ IS A DIGEST, NEVER A RECORD, so a prompt's size is fixed
// no matter how dense the world gets. Both blocks are built ONCE PER BATCH and carried in the
// base, which is also what keeps them out of the differing tail P-GATE measures.
//
// AN UNGENERATED ANCESTOR CONTRIBUTES NO LINE, not a placeholder. WE returns '' for a biome
// still called Unnamed and the reason generalises: a line saying a thing exists and nothing
// else is an invitation to invent it, at exactly the level the pipeline has decided not to
// invent at yet.
//
// A CHILD READS ITS ANCESTORS' OUTPUT, NEVER THEIR CHARTER NOTES. That is what stops one
// authored directive being applied twice at two levels and is why no precedence field is
// needed anywhere in this pipeline.
function _ceDigestCut(s: string, max: number): string {
    var t = String(s || '').replace(/\s+/g, ' ').trim();
    if (t.length <= max) return t;
    var cut = t.substring(0, max);
    var stop = cut.lastIndexOf('. ');
    if (stop < 0) stop = cut.lastIndexOf('! ');
    if (stop < 0) stop = cut.lastIndexOf('? ');
    if (stop > Math.floor(max / 2)) return cut.substring(0, stop + 1);
    var sp = cut.lastIndexOf(' ');
    return (sp > 0 ? cut.substring(0, sp) : cut) + '\u2026';
}

function _ceRungLabelOf(ladder: any[], rungId: string): string {
    var list: any[] = ladder || [];
    for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) === String(rungId)) return String(list[i].label || '');
    }
    return '';
}

async function ceDigestAncestors(atId: string, kind?: string): Promise<string> {
    var id = String(atId || '');
    if (!id) return '';
    var lines: string[] = [];
    try {
        var c = await loadCharter();
        var ladder: any[] = ceKindLadder(String(kind || 'location'), c);
        var seen: any = {};
        var guard = 0;
        while (id && !seen[id] && guard < 12) {
            seen[id] = true; guard++;
            var e: any = await loadEntity(id);
            if (!e) break;
            var head = _ceDigestCut(String(e.description || ''), 200);
            if (head) {
                var lab = _ceRungLabelOf(ladder, String((e as any).rung || ''));
                lines.unshift(String(e.name || 'Unnamed')
                    + (lab ? (' (' + lab + ')') : '') + ' \u2014 ' + head);
            }
            id = String(e.parentId || '');
        }
    } catch (eDa) { api.v1.error('[AE:seed] ancestor digest failed:', eDa); return ''; }
    if (!lines.length) return '';
    return 'ALREADY ESTABLISHED \u2014 do not contradict, do not rename:\n' + lines.join('\n');
}

// [DIGEST-SIBLING] Capped at six and already-written only, so a scope with thirty places
// costs the same as one with two. Index order, which is the author's, because PROMPTS 9.2
// only asks for something better than distance and this already is: a place the author made
// first is the one they think about the world through.
var CE_DIGEST_SIB_CAP = 6;
async function ceDigestSiblings(atId: string, parentName: string,
                                kind?: string): Promise<string> {
    var lines: string[] = [];
    try {
        var idx = await loadEntityIndex();
        var picked = 0;
        for (var i = 0; i < idx.length && picked < CE_DIGEST_SIB_CAP; i++) {
            var m: any = idx[i];
            if (!m || String(m.type) !== String(kind || 'location')) continue;
            if (String(m.parentId || '') !== String(atId || '')) continue;
            var e: any = await loadEntity(String(m.id));
            if (!e) continue;
            var head = _ceDigestCut(String(e.description || ''), 110);
            if (!head) continue;
            lines.push(String(e.name || 'Unnamed') + ' \u2014 ' + head);
            picked++;
        }
    } catch (eDs) { api.v1.error('[AE:seed] sibling digest failed:', eDs); return ''; }
    if (!lines.length) return '';
    var head2 = String(parentName || '').trim()
        ? ('ALSO IN ' + String(parentName) + ', already written:')
        : 'ALREADY WRITTEN AT THIS SCALE:';
    return head2 + '\n' + lines.join('\n')
         + '\nWrite something that fits alongside these. Do not rename them, contradict them, '
         + 'or repeat what they already are.';
}

// ── The seed pass  [SEED-CALL] ──────────────────────────────────────────────
// PROMPTS 10. ONE CALL PER RECORD, NOT PER QUESTION, and that is the opposite of the rule one
// layer down. Here the author judges the lines as a SET -- "is this the right place" is read
// off all of them together -- so a missing line is a gap in one artifact rather than a
// separate failure. On the profile the full write of each question is its own call, because
// there the failure is the first answer eating the whole output budget.
//
// [SEED-ASK-SET] WHICH QUESTIONS ARE ASKED IS LADDER-SCOPE APPLIED, NOT A NEW RULE: the rung
// decides what is ASKED by default and never what the record can HOLD. So the set is the six
// `any` lenses, the facets whose scope is this rung's, and every field the author defined.
// A Region is not asked how the room is lit.
// THE FULL SET ALREADY HAS A CONTROL. A rung whose scope is `any` asks everything, which is
// exactly what the scale picker advertises, so the author who wants all sixteen questions on
// a region has a switch rather than a setting.
// [SEED-BASELINE] AND A SEEDLESS FIELD IS NOT A DEGRADED ONE. The worry a narrower ask raises
// -- that a seeded record arrives with fewer steers than a hand-built one -- measures against
// a baseline that does not exist: a hand-built record has NO seeds at all, every unseeded
// field generates from its own instruction exactly as it always has, and the profile still
// shows all sixteen questions.
// [SHAPE-ASKS] THE SHAPE PICKS THE QUESTIONS, AND THERE IS NO SECOND EDITOR. The profile
// already has this control -- Lorebook Builder, Classic, Custom fields only -- and it already
// means exactly what a schema screen would have to mean:
//   builder  the catalog's questions at this rung's scope, which is what the pass asks today
//   classic  FOR AN ENTITY, no questions -- prose the author writes or the pass extracts
//            whole, which is _ceResolveEntShape's own reading of it: lorebookText, not
//            facets. NOT TRANSFERABLE TO CHARACTERS, where Classic is a specific question
//            set exactly as Profile Plus is. When the cast stage lands, its shape branch
//            resolves to a set and not to zero, and this filter must be told which kind it
//            is filtering rather than assuming a location's meaning
//   custom   only fields the author defined, and nothing above them
// So the answer to "where are a kind's questions established" is: on the scale, with the
// control that already exists, rather than in a schema surface that would be a second door
// onto ENT-CF-DOOR's editor.
//
// IT LIVES ON THE RUNG because a rung IS the per-scale configuration -- it already carries
// the label and the facet scope, and one rung is one question set by construction. A shape
// on the row instead would have nowhere to live at a scope with no rows yet, which is
// precisely when an author wants to choose it.
function ceShapeOk(shape: string): string {
    var s = String(shape || '');
    return (s === 'builder' || s === 'classic' || s === 'custom') ? s : 'builder';
}
function ceRungShape(rung: any): string {
    return ceShapeOk(String((rung && (rung as any).shape) || ''));
}

// [KIND-SHAPE] WHERE A KIND'S SHAPE LIVES, and it is two places for one reason. A LOCATION's
// shape is the RUNG's, because a rung is a scale and a scale is a question set -- a world may
// well want its Regions on the builder and its Rooms on classic prose. NO OTHER KIND HAS
// SCALES, so theirs is one choice for the whole story and lives on the charter under the kind
// name. A one-rung ladder would have unified them, and a ladder with one rung is a ladder
// pretending to be a scale.
// [KIND-LADDER] A LADDER PER RECURSIVE KIND. Factions nest and their nesting has names --
// an alliance is not a chapter -- so the same scale machinery serves them, and building them
// "like locations" means literally that rather than a parallel path.
//
// I ARGUED THESE APART AND WAS HALF RIGHT. Recursion and a ladder ARE separate facts: parent
// context comes from the ancestor digest, which walks parentId and needs no scales at all.
// But the ladder carries three other things a nesting kind wants -- a sense of magnitude for
// the naming and seed passes, a default rung for children, and THE COUNT CONTROL, which
// SCOPE-ONE-STAGE folded into the scale form. A faction stage without one needed a second
// empty state that asked "how many" a different way, which is the one-renderer claim
// starting to fray. Two ladders through one mechanism beats two empty states.
//
// LOCATIONS KEEP charter.ladder. Moving them into the map would rewrite every existing
// story's charter for a symmetry no author would ever see.
function ceKindLadder(kind: string, charter: any): any[] {
    if (String(kind || '') === 'location') {
        return (charter && Array.isArray(charter.ladder)) ? charter.ladder : [];
    }
    var map: any = (charter && (charter as any).ladders) || {};
    var l: any = map[String(kind || '')];
    return Array.isArray(l) ? l : [];
}
async function ceKindLadderWrite(kind: string, arr: any[]): Promise<void> {
    try {
        if (String(kind || '') === 'location') {
            await ceCharterWrite('ladder', Array.isArray(arr) ? arr : []);
            return;
        }
        var c = await loadCharter();
        var map: any = (c as any).ladders || {};
        map[String(kind || '')] = Array.isArray(arr) ? arr : [];
        await ceCharterWrite('ladders', map);
    } catch (eKl) { api.v1.error('[AE:scope] ladder write failed:', eKl); }
}

function ceKindShape(kind: string, rung: any, charter: any): string {
    // [SEED-DEFS-CHAR] A character's shapes are classic/studio/custom and never reach
    // ceShapeOk, which would normalise 'studio' to 'builder'. Its default is 'classic', the
    // same answer _ceResolveShape gives a record with no evidence either way.
    if (String(kind || '') === 'character') {
        var cm: any = (charter && (charter as any).shapes) || {};
        var cv = String(cm['character'] || '');
        return (cv === 'classic' || cv === 'studio' || cv === 'custom') ? cv : 'classic';
    }
    // [KIND-LADDER] A LADDERED KIND'S SHAPE IS ITS RUNG'S, whichever kind it is. The rule was
    // never about locations; it was about scales, and factions now have them.
    if (rung) return ceRungShape(rung);
    var map: any = (charter && (charter as any).shapes) || {};
    return ceShapeOk(String(map[String(kind || '')] || ''));
}

// [SHAPE-ASKS] THE ASKED SET, FOR ANY KIND. `kind` names a CE_ENTITY_CATALOGS entry, which is
// what makes this one function rather than six: the catalog already knows a type's base
// facets and which config array holds the author's own, and ceEntityOrderedDefs already
// merges them in the author's order.
//
// SCOPE ONLY NARROWS FOR LOCATIONS. `scope` is a field on the location facets and on nothing
// else, so for every other kind the rung filter is a no-op rather than a special case --
// ceSeedDefs is handed 'any' and the branch falls through. That is the ladder being a
// location concept, expressed by absence instead of by an if.
//
// A CHARACTER IS NOT AN ENTITY AND IS NOT HANDLED HERE. CharacterRecord's questions are
// profile slots, not a facet catalog, and its shape vocabulary is classic/studio/custom where
// this one is builder/classic/custom -- AND ITS CLASSIC IS A REAL QUESTION SET rather than
// the absence of one, which is the assumption this filter would otherwise carry in wrong.
// `character` therefore resolves to the author's own static fields and nothing else, which is
// honest and useless, and Cast must wire the slot table before it ships.
// [SEED-DEFS-CHAR] A CHARACTER IS NOT A CATALOG ENTRY, AND ITS THREE SHAPES ARE THREE REAL
// QUESTION SETS. This function served CE_ENTITY_CATALOGS and a character has no entry there,
// so it fell to `if (isCustom)` and returned the author's own fields and nothing else --
// which is why Cast could not ship: a character on Classic or Studio was asked nothing at
// all, and the seed pass had no way to say so.
//
// The vocabulary is NOT the entity one, and the difference is load-bearing:
//   classic  the sheet. STATIC_FIELD_DEFS -- appearance, personality, voice, background.
//            AN ENTITY'S CLASSIC IS ONE PROSE BOX AND ASKS NOTHING; A CHARACTER'S CLASSIC
//            IS A QUESTION SET. Same word, opposite meaning, which is exactly why the old
//            `sh === 'classic' && kd !== 'character'` early return had to carve the kind out
//            and then had nothing to offer it.
//   studio   the slot model: the `kind: 'slot'` rows of customStaticFields, which are the
//            questions of whichever profile template is active.
//   custom   the author's own facets, identical to every other kind's custom.
// _ceResolveShape already knows all three and has since SHAPE-CUSTOM; this is the read side
// catching up.
//
// SCOPE DOES NOT APPLY. A character has no scales and no lists, so the rung filter is a
// no-op here by absence rather than by a branch.
function _ceCharSeedDefs(sh: string, cfg: any): any[] {
    var out: any[] = [];
    var i = 0;
    var rows: any[] = (cfg && cfg.customStaticFields) || [];
    if (sh === 'classic') {
        // Mapped onto the def shape the seed pass and the row editor read: an id, a label,
        // and a hint that is the question. The sheet's own `placeholder` IS that question --
        // it is the line an author reads in the empty box -- so it is reused rather than
        // paraphrased into a second copy that would drift from the sheet.
        for (i = 0; i < STATIC_FIELD_DEFS.length; i++) {
            var s: any = STATIC_FIELD_DEFS[i];
            out.push({ id: String(s.id), label: String(s.label || ''),
                       hint: String(s.placeholder || ''), slot: 'static', scope: 'any' });
        }
        return out;
    }
    if (sh === 'studio') {
        for (i = 0; i < rows.length; i++) {
            if (!rows[i] || String(rows[i].kind || '') !== 'slot') continue;
            out.push(rows[i]);
        }
        return out;
    }
    for (i = 0; i < rows.length; i++) {
        if (!rows[i] || String(rows[i].kind || '') === 'slot') continue;
        out.push(rows[i]);
    }
    return out;
}

function ceSeedDefs(kind: string, rungScope: string, cfg: any, shape?: string): any[] {
    var kd = String(kind || 'location');
    // [SEED-DEFS-CHAR] The character vocabulary is its own, so ceShapeOk -- which knows
    // builder/classic/custom -- must not be run over it. 'studio' would normalise to
    // 'builder' and the studio slots would never be asked.
    if (kd === 'character') {
        var csh = String(shape || '');
        if (csh !== 'classic' && csh !== 'studio' && csh !== 'custom') { csh = 'classic'; }
        return _ceCharSeedDefs(csh, cfg);
    }
    var sh = ceShapeOk(shape);
    // CLASSIC ASKS NOTHING -- for an ENTITY. The seed pass still runs and still writes the
    // one-line summary; what it does not do is put a question set in front of a record whose
    // whole point is that it has none.
    if (sh === 'classic') return [];
    var defs: any[] = ceEntityOrderedDefs({ type: kd } as any, cfg);
    var want = ceKindScopeOk(kd, String(rungScope || 'any'));   // [KIND-SCOPE]
    var out: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        var d: any = defs[i];
        var sc = String(d.scope || 'any');
        var isCustom = String(d.slot) === 'custom';
        if (sh === 'custom') { if (isCustom) out.push(d); continue; }
        if (want === 'any' || sc === 'any' || sc === want || isCustom) { out.push(d); }
    }
    return out;
}

// [KIND-SHAPE] The write, routed the same way the read is. Both through the one charter door.
// [KIND-SHAPE] THE WRITE BRANCHES ON THE RUNG, NOT ON THE KIND, because that is what the
// READ does. ceKindShape's first line is `if (rung) return ceRungShape(rung)` for every
// kind; this branched on `kind !== 'location'` instead, so a faction -- which HAS rungs
// since KIND-LADDER -- had its shape written to charter.shapes.faction and read back off
// the rung, which carries no shape and answers 'builder'. The picker committed, the store
// republished, and the value snapped back with nothing on the console. TWO DERIVATIONS FOR
// ONE ADDRESS, which is the failure this file names in its own header.
async function ceScopeShapeWrite(kind: string, rungId: string, shape: string): Promise<void> {
    try {
        // [SEED-DEFS-CHAR] Not through ceShapeOk for a character: 'studio' is not in its
        // three and would be written as 'builder', which is not a character shape at all.
        var sh = '';
        if (String(kind || '') === 'character') {
            sh = String(shape || '');
            if (sh !== 'classic' && sh !== 'studio' && sh !== 'custom') { sh = 'classic'; }
        } else {
            sh = ceShapeOk(shape);
        }
        var c = await loadCharter();
        if (!String(rungId || '')) {
            // No rung: a flat kind, one choice for the whole story, on the charter.
            var map: any = (c as any).shapes || {};
            map[String(kind || '')] = sh;
            await ceCharterWrite('shapes', map);
            return;
        }
        var ladder: any[] = ceKindLadder(String(kind || 'location'), c);
        var hit = false;
        for (var i = 0; i < ladder.length; i++) {
            if (String(ladder[i].id) !== String(rungId)) continue;
            (ladder[i] as any).shape = sh;
            hit = true;
            break;
        }
        if (hit) await ceKindLadderWrite(String(kind || 'location'), ladder);
    } catch (eSs) { api.v1.error('[AE:scope] shape write failed:', eSs); }
}

// [DESC-ASKED] THE DESCRIPTION IS THE FIRST QUESTION, not a line in the formatting rules.
// It was only ever named in the format block, three paragraphs after a doctrine that ends
// "Never summarise." -- so a model that read the doctrine and skipped a formatting slot
// dropped it, which is exactly what an item's worn appearance did while its facets filled.
// Listed here it is asked the way everything else is, and ceSeedParse accepts its label.
//   ALL FOUR CALLERS PASS THE KIND, including both chat blocks -- SCOPE-CHAT-STABLE needs
//   cePublishBuild and the extraction pass to produce identical bytes, and they only will if
//   the question list is built the same way on both sides.
function ceSeedQuestionBlock(defs: any[], kind?: string): string {
    var s = 'THE QUESTIONS';
    if (String(kind || '')) {
        var g: any = ceDescGloss(String(kind));
        s += '\n' + String(g.label) + ' \u2014 ' + String(g.ask);
    }
    for (var i = 0; i < (defs || []).length; i++) {
        s += '\n' + String(defs[i].label || 'Field') + ' \u2014 '
           + String(defs[i].hint || defs[i].label || '');
    }
    return s;
}

// [SCOPE-CHAT] The scoped chat's system tail. TWO CALLERS, ONE FUNCTION: cePublishBuild
// caches it for the dock's synchronous render and the extraction pass rebuilds it, and the
// bytes must be identical or the conversation's warm prefix is thrown away by the very pass
// that exists to reuse it.
// [SCOPE-CHAT-STABLE] IT CARRIES NO DIGEST OF WHAT EXISTS AT THIS SCOPE, against PROMPTS 15's
// last line. Committing one row would rewrite the system block of a conversation the whole
// session is warm on. The ladder and the question list do not move, so what is here stays.
async function ceScopeChatBlock(atId: string, kind?: string): Promise<string> {
    try {
        var kd = String(kind || 'location');
        var c = await loadCharter();
        var ladder: any[] = ceKindLadder(kd, c);
        var rung: any = null;
        var parentName = '';
        if (!String(atId || '')) {
            rung = ladder.length ? ladder[0] : null;
        } else {
            var pe: any = await loadEntity(String(atId));
            parentName = String((pe && pe.name) || '');
            var pr = String((pe && (pe as any).rung) || '');
            rung = pr ? ceLadderNext(ladder, pr) : (ladder.length > 1 ? ladder[1] : null);
        }
        var label = String((rung && rung.label) || '');
        var plural = _cePlural(label);
        // ceLadderNext falls back to the FIRST rung when it is handed an id it cannot find,
        // which is right for the ladder walk and wrong here, so the identity check stands
        // between "there is a level below" and "there is no level at all".
        var nx = ceLadderNext(ladder, String((rung && rung.id) || ''));
        var below = (nx && rung && String(nx.id) !== String(rung.id)) ? String(nx.label || '') : '';
        var cfg: any = await loadConfig();
        var defs = ceSeedDefs(kd, String((rung && rung.scope) || 'any'), cfg,
                              ceKindShape(kd, rung, c));
        var s = ceScopedChatLead(plural, label, parentName) + '\n\n' + CE_P_SCOPED_TAIL;
        s += '\n\n' + ceLadderBlock(ladder, rung, parentName, below);
        s += '\n\n' + ceSeedQuestionBlock(defs, kd);
        return s;
    } catch (eScb) {
        api.v1.error('[AE:seed] scoped chat block failed:', eScb);
        return CE_P_SCOPED_TAIL;
    }
}

// [REC-CHAT] One record's chat block. SAME TWO CALLERS AS ceScopeChatBlock and the same
// reason: cePublishBuild caches it for the dock's synchronous render, the seed pass rebuilds
// it, and the bytes must match or the extraction throws away the prefix it exists to reuse.
// `intent` IS HOW THE SET REACHES THE MEMBER. It is the batch line the scope conversation
// produced, carried compressed, which is WORLDPIPE 7.2's rule one scale down.
async function ceRecordChatBlock(recName: string, intent: string, atId: string,
                                 kind?: string): Promise<string> {
    try {
        var kd = String(kind || 'location');
        var c = await loadCharter();
        var ladder: any[] = ceKindLadder(kd, c);
        var rung: any = null;
        var parentName = '';
        if (!String(atId || '')) {
            rung = ladder.length ? ladder[0] : null;
        } else {
            var pe: any = await loadEntity(String(atId));
            parentName = String((pe && pe.name) || '');
            var pr = String((pe && (pe as any).rung) || '');
            rung = pr ? ceLadderNext(ladder, pr) : (ladder.length > 1 ? ladder[1] : null);
        }
        var label = String((rung && rung.label) || 'place');
        var nx = ceLadderNext(ladder, String((rung && rung.id) || ''));
        var below = (nx && rung && String(nx.id) !== String(rung.id)) ? String(nx.label || '') : '';
        var cfg: any = await loadConfig();
        var defs = ceSeedDefs(kd, String((rung && rung.scope) || 'any'), cfg,
                              ceKindShape(kd, rung, c));
        var s = ceRecordChatLead(label.toLowerCase(), recName, parentName)
              + '\n\n' + CE_P_RECORD_TAIL;
        if (String(intent || '').trim()) {
            s += '\n\nTRUE OF ALL OF THEM, including this one:\n' + String(intent).trim();
        }
        s += '\n\n' + ceLadderBlock(ladder, rung, parentName, below);
        s += '\n\n' + ceSeedQuestionBlock(defs, kd);
        return s;
    } catch (eRcb) {
        api.v1.error('[AE:seed] record chat block failed:', eRcb);
        return CE_P_RECORD_TAIL;
    }
}

// The seed call's own base. A MACHINE-family head, the ladder block, the doctrine, the
// question list and the format -- all of which are identical for every record in the batch,
// so the per-record ask is two lines. That is what PROMPTS 21's second check is asking for.
async function ceSeedMessages(ladder: any[], rung: any, parentName: string, belowLabel: string,
                              defs: any[], anc: string, sib: string,
                              kind?: string): Promise<any[]> {
    var c = await loadCharter();
    var sys = ceBuildHead({ family: 'machine', records: true, style: String(c.style || '') });
    sys += '\n\n' + ceLadderBlock(ladder, rung, parentName, belowLabel);
    sys += '\n\n' + CE_P_SEED_WHAT;
    sys += '\n\n' + ceSeedQuestionBlock(defs, String(kind || ''));
    sys += '\n\n' + ceSeedFormat(String(kind || ''));   // [DESC-MEANS]
    var msgs: any[] = [{ role: 'system', content: sys }];
    if (anc) msgs.push({ role: 'user', content: anc });
    if (sib) msgs.push({ role: 'user', content: sib });
    return msgs;
}

function ceSeedAsk(noun: string, name: string, intent: string): string {
    var s = String(noun || 'Place') + ': ' + String(name || '');
    if (String(intent || '').trim()) s += '\n' + String(intent).trim();
    return s + '\n\nWrite its lines now.';
}

// [EXTRACT-HANDOFF] EXTRACTION B, AND THE FAMILY SWITCH RIDES THE ASK. This is appended to
// the scoped chat's exact prefix -- that is what makes it affordable -- and that prefix's
// head says "you are talking with the author, this is a conversation, not a form". PROMPTS
// 3.2 puts extraction in the MACHINE family and both cannot sit in the system block without
// discarding the cache, so the revocation is the first thing in the tail.
// "DO NOT CARRY OVER ANYTHING THEY RAISED AND THEN REJECTED" is the failure specific to
// reading a transcript rather than a charter: a discarded idea is still in the text and reads
// exactly like an adopted one.
function ceSeedExtractAsk(noun: string, name: string, intent: string, defs: any[],
                          kind?: string): string {
    var s = 'The conversation above is finished. You are no longer talking to the author, and '
          + 'nothing you write now is read by a person \u2014 it is stored in fields. Do not '
          + 'ask a question, do not suggest what to do next, and do not address anyone.\n\n'
          + 'The author is done talking about ' + String(name || 'this')
          + ' and wants it written down. Read the conversation above and fill in what they '
          + 'established about it.\n\n'
          + 'Everything you write must come from the conversation. Where they said nothing '
          + 'about a question, leave that line out \u2014 a later pass will fill it. Keep '
          + 'every name they used, spelled their way. Do not carry over anything they raised '
          + 'and then rejected.\n\n';
    s += String(noun || 'Place') + ': ' + String(name || '');
    if (String(intent || '').trim()) s += '\n' + String(intent).trim();
    s += '\n\n' + ceSeedQuestionBlock(defs, String(kind || ''))
       + '\n\n' + ceSeedFormat(String(kind || ''))
       + '\n\n'
       + 'If the conversation says nothing about it at all, reply with the single word: none';
    return s;
}

// [SEED-KEYS] THE PARSE. Labels are the keys, matched case-insensitively on the text before
// the first colon with every non-alphanumeric dropped, so `**Control**:` and `- control :`
// both land.
// POSITION IS THE FALLBACK ONLY WHEN NO KEY RESOLVED AT ALL. That is the one failure it is
// for -- a model that renamed the labels but kept the order -- and applying it any wider is
// how question 3's answer gets written into slot 2, which is the silently wrong record
// PROMPTS 10.3 chose labels to avoid. A LINE WITH NO COLON IS NEVER PLACED: it is a format
// failure, and guessing at one costs a retry to avoid and a wrong record to accept.
function _ceSeedKey(s: string): string {
    return String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');
}
// [DESC-ASKED] THE DESCRIPTION IS ASKED BY LABEL LIKE EVERY OTHER FIELD. It used to arrive
// only through the SUMMARY slot in the format block -- one line in the formatting rules,
// never listed among the questions, and immediately after a doctrine paragraph that ends
// "Never summarise." A model reading that reasonably drops the line, which is why an item's
// worn appearance came back empty while its facets filled in.
//   ITS LABEL IS THE KIND'S OWN [DESC-MEANS], so the question block says "Worn appearance"
//   for an item and "In brief" for a character, and the parser accepts either that label or
//   the literal word SUMMARY -- an older reply, or a model that followed the format block
//   instead of the question list, still lands.
function ceSeedDescKey(kind: string): string {
    return _ceSeedKey(String(ceDescGloss(kind).label || ''));
}

function ceSeedParse(raw: string, defs: any[], kind?: string): any {
    var t = ceStripThink(String(raw || ''));
    t = t.replace(/```[a-z]*/gi, '').replace(/`/g, '');
    var byKey: any = {};
    var i = 0;
    for (i = 0; i < defs.length; i++) { byKey[_ceSeedKey(defs[i].label)] = String(defs[i].id); }
    var dKey = String(kind || '') ? ceSeedDescKey(String(kind)) : '';
    var out: any = { summary: '', seeds: {}, hits: 0 };
    var loose: string[] = [];
    var lines = t.split('\n');
    for (i = 0; i < lines.length; i++) {
        var ln = String(lines[i] || '').trim();
        if (!ln) continue;
        ln = ln.replace(/^[-*\u2022\u2013\u2014]\s*/, '');
        var ci = ln.indexOf(':');
        if (ci < 0) continue;
        var key = _ceSeedKey(ln.substring(0, ci));
        if (!key) continue;
        var val = ln.substring(ci + 1).trim()
            .replace(/^["'\u201c\u2018]+/, '').replace(/["'\u201d\u2019]+$/, '').trim();
        if (!val || val.length > 400) continue;
        // [DESC-ASKED] Either spelling lands in the same place.
        if (key === 'summary' || (dKey && key === dKey)) {
            if (!out.summary) out.summary = val;
            continue;
        }
        var fid = byKey[key];
        if (fid) {
            if (!out.seeds[fid]) { out.seeds[fid] = val; out.hits++; }
        } else {
            loose.push(val);
        }
    }
    if (!out.hits && loose.length && loose.length <= defs.length) {
        for (i = 0; i < loose.length; i++) {
            out.seeds[String(defs[i].id)] = loose[i];
            out.hits++;
        }
    }
    return out;
}

// [SEED-PARTIAL] ONE RETRY, AND ONLY WHEN NOTHING PARSED. PROMPTS 10.5 asks for a retry
// naming every missing label, which contradicts 10.3 in the same document: 10.3 tells the
// model to leave out what it has nothing for, so re-asking for those lines demands exactly
// the padding 10.2 forbids. Five lines out of nine is a result. Zero is a format failure and
// is the only thing worth another call.
// Returns null when nothing usable came back, and an EMPTY result for the `none` channel --
// which is a different thing the caller does something different about.
async function _ceSeedOne(base: any[], params: any, defs: any[], ask: string,
                          mode: string, kind?: string): Promise<any> {
    var msgs = base.slice(0);
    msgs.push({ role: 'user', content: ask });
    var res: any = await aeDiagGenerateWithStory('seed:' + mode, msgs, params,
                                                 undefined, undefined, 'background');
    var raw = ceGenText(res);
    var low = String(raw || '').trim().toLowerCase();
    if (!raw || low === 'none' || low === 'none.') return { summary: '', seeds: {}, hits: 0 };

    // [EXTRACT-RELAPSE] Only on the extraction path, because only that one rides a head that
    // asks for conversation. The retry is BLUNTER rather than longer, with the rejected turn
    // above it as a real assistant message: the first ask already revoked the framing, so
    // restating it politely loses the same argument twice.
    if (mode === 'extract' && ceLooksConversational(raw)) {
        msgs.push({ role: 'assistant', content: raw });
        msgs.push({ role: 'user', content: CE_P_SEED_RELAPSE });
        var res2: any = await aeDiagGenerateWithStory('seed:extract:relapse', msgs, params,
                                                      undefined, undefined, 'background');
        raw = ceGenText(res2);
        var low2 = String(raw || '').trim().toLowerCase();
        if (!raw || low2 === 'none' || low2 === 'none.') return { summary: '', seeds: {}, hits: 0 };
        if (ceLooksConversational(raw)) return null;
    }

    var parsed = ceSeedParse(raw, defs, String(kind || ''));
    if (!parsed.summary && !parsed.hits) {
        var m2 = base.slice(0);
        m2.push({ role: 'user', content: ask });
        m2.push({ role: 'assistant', content: raw });
        m2.push({ role: 'user', content: CE_P_SEED_UNUSABLE });
        var res3: any = await aeDiagGenerateWithStory('seed:' + mode + ':retry', m2, params,
                                                      undefined, undefined, 'background');
        parsed = ceSeedParse(ceGenText(res3), defs, String(kind || ''));
    }
    if (!parsed.summary && !parsed.hits) return null;
    return parsed;
}

// ONE WRITE PER ROW. WORLDPIPE 8 says save after every row, and updateWizardDraftField is a
// full load-modify-save of the whole staging store per FIELD -- ten of those per record and
// thirty records is nine hundred round trips for one batch.
async function ceScopeRowWriteMany(id: string, patch: any): Promise<void> {
    try {
        var all = await loadWizardDrafts();
        var found = false;
        for (var i = 0; i < all.length; i++) {
            if (!all[i] || String(all[i].id) !== String(id)) continue;
            var k: string;
            for (k in patch) { (all[i].fields as any)[k] = String(patch[k] || ''); }
            found = true;
            break;
        }
        if (found) await saveWizardDrafts(all);
    } catch (eSw) { api.v1.error('[AE:seed] row write failed:', eSw); }
}

// `blank` writes an empty string for every asked question the reply had nothing for. The
// batch does not use it -- adding to a row is safe -- and [SEED-REROLL] does, because a
// re-roll that left the previous pass's lines standing beside the new ones would show the
// author a record half from each.
function _ceSeedPatch(got: any, defs: any[], blank: boolean): any {
    var patch: any = {};
    if (String(got.summary || '').trim()) patch.description = String(got.summary).trim();
    for (var i = 0; i < defs.length; i++) {
        var fid = String(defs[i].id);
        var v = String((got.seeds && got.seeds[fid]) || '').trim();
        if (v) { patch[CE_DRAFT_SEED_PFX + fid] = v; }
        else if (blank) { patch[CE_DRAFT_SEED_PFX + fid] = ''; }
    }
    return patch;
}

// Everything both the batch and the re-roll need, resolved once. Two resolutions of "what
// does this rung ask and what is the model allowed to read" is how a re-roll comes to write
// a line the batch would never have asked for.
async function _ceSeedContext(parentId: string, rungId: string, kind?: string): Promise<any> {
    var kd = String(kind || 'location');
    var c = await loadCharter();
    var ladder: any[] = ceKindLadder(kd, c);
    var rung: any = null;
    var r = 0;
    for (r = 0; r < ladder.length; r++) {
        if (String(ladder[r].id) === String(rungId)) rung = ladder[r];
    }
    var noun = String((rung && rung.label) || 'Place');
    var nx = ceLadderNext(ladder, String(rungId));
    var belowLabel = (nx && rung && String(nx.id) !== String(rung.id)) ? String(nx.label || '') : '';
    var parentName = '';
    if (String(parentId || '')) {
        var pe: any = await loadEntity(String(parentId));
        parentName = String((pe && pe.name) || '');
    }
    var cfg: any = await loadConfig();
    var kShape = ceKindShape(kd, rung, c);
    var defs = ceSeedDefs(kd, String((rung && rung.scope) || 'any'), cfg, kShape);
    var anc = await ceDigestAncestors(String(parentId || ''), kd);
    var sib = await ceDigestSiblings(String(parentId || ''), parentName, kd);
    var genBase = await ceSeedMessages(ladder, rung, parentName, belowLabel, defs, anc, sib, kd);

    // [SEED-ROUTE] The conversation, if there is one, and the flat text used to decide which
    // rows it covers.
    var scope = _ceChatPfx(kd) + ':' + (String(parentId || '') || 'top');
    var extBase: any = null;
    var transcript = '';
    try {
        var chat = await loadBuildChat(scope);
        if (chat && chat.turns && chat.turns.length) {
            var blk = await ceScopeChatBlock(String(parentId || ''), kd);
            extBase = await ceBuildChatMessages(scope, blk, chat.turns);
            var parts: string[] = [];
            for (var t = 0; t < chat.turns.length; t++) {
                var tt: any = chat.turns[t];
                if (tt && !tt.pending && String(tt.text || '').trim()) parts.push(String(tt.text));
            }
            transcript = parts.join('\n').toLowerCase();
        }
    } catch (eSc) { api.v1.error('[AE:seed] scoped chat read failed:', eSc); }

    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    // PROMPTS 10.4: the formula rather than a constant, because the question count is the
    // author's. A fixed ceiling would truncate the last questions of a long schema, and a
    // truncated tail is indistinguishable from lines the model chose to omit.
    var params: any = { model: model, max_tokens: 48 + 24 * defs.length,
                        temperature: 0.75, enable_thinking: false };
    return { rung: rung, noun: noun, defs: defs, params: params, genBase: genBase,
             extBase: extBase, transcript: transcript, shape: kShape, kind: kd };
}

// [REC-CHAT] The row's own transcript, or null when it has none. Returns the SAME array the
// dock sends on, so the extraction is a prefix extension of the conversation rather than a
// second assembly of it.
async function _ceSeedRecordBase(recId: string, name: string, intent: string,
                                 atId: string, kind?: string): Promise<any> {
    try {
        var scope = 'rec:' + String(recId);
        var chat = await loadBuildChat(scope);
        if (!chat || !chat.turns || !chat.turns.length) return null;
        var blk = await ceRecordChatBlock(name, intent, String(atId || ''), kind);
        return await ceBuildChatMessages(scope, blk, chat.turns);
    } catch (eRb) { api.v1.error('[AE:seed] record base failed:', eRb); return null; }
}

// [SEED-ROUTE] THREE SOURCES, ONE FORMAT, AND THE ROW DECIDES WHICH. A row whose name appears
// in this scope's transcript is EXTRACTED from the conversation (PROMPTS 17); every other row
// is GENERATED from the charter and the digests (PROMPTS 10). The test is a substring against
// the transcript and costs nothing, which is the point -- running extraction on every row
// would spend one call per place the author never mentioned.
// A MISS DEGRADES TO THE SAFE HALF. `none` from the extraction falls through to the generate
// path, so the worst a wrong route does is pay one extra call; and extraction never invents,
// so a row it cannot fill is filled from the charter rather than from a conversation that
// said nothing about it.
async function ceSeedBatch(parentId: string, rungId: string, kind?: string): Promise<string> {
    var ctx: any = await _ceSeedContext(parentId, rungId, kind);
    // [SHAPE-ASKS] Classic asks nothing BY DESIGN and still wants its one-line summary, so
    // an empty set is only an error when the shape meant to have one.
    if (!ctx.defs.length && ctx.shape !== 'classic') {
        return 'This shape asks no questions. Define a field on a record, or switch the shape.';
    }
    var drafts = await loadWizardDraftsOfKind(String(ctx.kind));
    var todo: any[] = [];
    var i = 0;
    for (i = 0; i < drafts.length; i++) {
        var d: any = drafts[i];
        if (!d) continue;
        if (String(d.parentId || '') !== String(parentId || '')) continue;
        if (String((d.fields || {})[CE_DRAFT_RUNG_KEY] || '') !== String(rungId)) continue;
        if (ceScopeRowState(d) !== 'named') continue;
        todo.push(d);
    }
    if (!todo.length) {
        return 'Nothing here is waiting on seeds. Name a place first, or re-seed one below.';
    }

    var made = 0; var empty = 0; var failed = 0; var fromChat = 0;
    for (i = 0; i < todo.length; i++) {
        var row: any = todo[i];
        var nm = String((row.fields || {}).name || '').trim();
        var intent = String((row.fields || {}).intent || '');
        try {
            var got: any = null;
            // [REC-CHAT] THE ROW'S OWN CHAT OUTRANKS THE SCOPE'S. A conversation about this
            // one record is the better source by construction, and it is also the cheaper
            // prefix -- the scope transcript is paid on every row and is noise on all but
            // the one it is about.
            var recBase = await _ceSeedRecordBase(String(row.id), nm, intent, parentId,
                                                  String(ctx.kind));
            if (recBase) {
                got = await _ceSeedOne(recBase, ctx.params, ctx.defs,
                    ceSeedExtractAsk(ctx.noun, nm, intent, ctx.defs, String(ctx.kind || '')), 'extract', String(ctx.kind || ''));
                if (got && (got.summary || got.hits)) { fromChat++; }
                else { got = null; }
            }
            if (!got && ctx.extBase && nm && ctx.transcript.indexOf(nm.toLowerCase()) >= 0) {
                got = await _ceSeedOne(ctx.extBase, ctx.params, ctx.defs,
                    ceSeedExtractAsk(ctx.noun, nm, intent, ctx.defs, String(ctx.kind || '')), 'extract', String(ctx.kind || ''));
                if (got && (got.summary || got.hits)) { fromChat++; }
                else { got = null; }
            }
            if (!got) {
                got = await _ceSeedOne(ctx.genBase, ctx.params, ctx.defs,
                    ceSeedAsk(ctx.noun, nm, intent), 'gen', String(ctx.kind || ''));
            }
            if (!got) { failed++; continue; }
            if (!got.summary && !got.hits) { empty++; continue; }
            await ceScopeRowWriteMany(String(row.id), _ceSeedPatch(got, ctx.defs, false));
            made++;
        } catch (eSb) {
            api.v1.error('[AE:seed] batch failed:', eSb);
            // [GEN-FAIL-KIND] A transport failure halts with everything before it intact.
            // Continuing would spend the rest of the batch against a door that is shut and
            // report every remaining row as a model with nothing to say.
            if (_ceGenFailKind(eSb) === 'transport') {
                return 'The call did not reach the model after ' + String(made)
                     + ' seeded. Press again to carry on from where it stopped.';
            }
            failed++;
        }
    }

    if (!made) return 'Nothing came back usable. Try again, or type the lines in yourself.';
    var msg = String(made) + ' seeded';
    if (fromChat) {
        msg += ', ' + String(fromChat) + ' of ' + (fromChat === 1 ? 'them' : 'those')
             + ' read out of the conversation';
    }
    msg += '. Open a row to read the lines.';
    if (empty) {
        msg += ' ' + String(empty) + ' had nothing to say \u2014 give '
             + (empty === 1 ? 'it' : 'them') + ' a line of your own and press again.';
    }
    if (failed) {
        msg += ' ' + String(failed) + ' failed \u2014 press again for '
             + (failed === 1 ? 'it' : 'those') + '.';
    }
    return msg;
}

// [SEED-REROLL] ONE ROW, ON DEMAND, AND IT CLEARS BEFORE IT WRITES. This is the answer to a
// bad seed rather than a review step between the pass and the row: a manifest of proposed
// lines is a second copy of the list the author is already looking at, which is the structure
// WORLDPIPE 2 deleted. It reads the row's own parent and rung rather than taking them as
// arguments, so a re-roll cannot be pointed at a scope the row is not in.
async function ceSeedReroll(draftId: string, kind?: string): Promise<string> {
    var kdR = String(kind || 'location');
    var drafts = await loadWizardDraftsOfKind(kdR);
    var row: any = null;
    for (var i = 0; i < drafts.length; i++) {
        if (drafts[i] && String(drafts[i].id) === String(draftId)) { row = drafts[i]; break; }
    }
    if (!row) return 'That row is gone.';
    var nm = String((row.fields || {}).name || '').trim();
    if (!nm) return 'Name it first \u2014 a seed call needs something to write about.';
    var intent = String((row.fields || {}).intent || '');
    try {
        var ctx: any = await _ceSeedContext(String(row.parentId || ''),
                                            String((row.fields || {})[CE_DRAFT_RUNG_KEY] || ''),
                                            kdR);
        if (!ctx.defs.length && ctx.shape !== 'classic') {
            return 'This shape asks no questions.';
        }
        var got: any = null;
        var rBase = await _ceSeedRecordBase(String(row.id), nm, intent,
                                            String(row.parentId || ''), kdR);
        if (rBase) {
            got = await _ceSeedOne(rBase, ctx.params, ctx.defs,
                ceSeedExtractAsk(ctx.noun, nm, intent, ctx.defs, String(ctx.kind || '')), 'extract', String(ctx.kind || ''));
            if (!got || (!got.summary && !got.hits)) got = null;
        }
        if (!got && ctx.extBase && ctx.transcript.indexOf(nm.toLowerCase()) >= 0) {
            got = await _ceSeedOne(ctx.extBase, ctx.params, ctx.defs,
                ceSeedExtractAsk(ctx.noun, nm, intent, ctx.defs, String(ctx.kind || '')), 'extract', String(ctx.kind || ''));
            if (!got || (!got.summary && !got.hits)) got = null;
        }
        if (!got) {
            got = await _ceSeedOne(ctx.genBase, ctx.params, ctx.defs,
                ceSeedAsk(ctx.noun, nm, intent), 'gen', String(ctx.kind || ''));
        }
        if (!got) return 'Nothing usable came back. The lines are as they were.';
        if (!got.summary && !got.hits) {
            return 'It had nothing to say about this one. The lines are as they were.';
        }
        await ceScopeRowWriteMany(String(row.id), _ceSeedPatch(got, ctx.defs, true));
        return 'Rewritten.';
    } catch (eSr) {
        api.v1.error('[AE:seed] reroll failed:', eSr);
        return _ceGenFailKind(eSr) === 'transport'
            ? 'The call did not reach the model. Nothing was changed.'
            : 'The model returned nothing usable. Nothing was changed.';
    }
}

// ── The prompt gate  [P-GATE] ───────────────────────────────────────────────
// PROMPTS 21 asks for a permanent, scriptable proof that the architecture's central claim
// still holds as prompts get edited: that every call in a batch is the SAME head plus one
// differing tail. Phase 1 shipped gate_router.py for the router; this is its runtime twin.
//
// [P-GATE-NO-TOKENS] IT PROVES PREFIX IDENTITY, NOT A BILLED DELTA, AND THAT IS A CORRECTION
// TO 21 RATHER THAN A SHORTFALL. 21's first two assertions are "call 2 bills far less than
// call 1" and "the delta is roughly the ask" -- both read off countUncachedInputTokens. That
// counter reports what an array would cost AGAINST THE CACHE AS IT STANDS, and a gate that
// generates nothing never warms the cache, so call 2 would report the same number as call 1
// no matter how correct the prompts were. The assertion would fail on a healthy pipeline and
// pass on nothing.
//
// What those two assertions are PROXIES for is byte-identity of the head, and that is
// checkable directly, deterministically, and at zero cost. So the gate compares the arrays
// themselves. The uncached counter is still reported, as an observation rather than a test.
//
// [P-GATE-NOUN-SCOPE] 21's third assertion says "no call's array contains a genre noun
// outside the charter blocks". Taken literally that scans the author's own transcript and
// their own charter, which is exactly where a genre noun is CORRECT -- a story about dragons
// says dragon. The check is therefore over the STATIC SUBSTRATE BLOCKS by name, which are the
// only part an edit can break and the only part that claims to be setting-neutral.

// Setting nouns. Not a taxonomy and not exhaustive -- a tripwire. Each one is a word that
// could only have arrived by someone writing an example into a block that must serve every
// genre, which is the specific regression 21 exists to catch.
var CE_P_SETTING_NOUNS: string[] = [
    'wizard', 'wizards', 'magic', 'magical', 'spell', 'spells', 'sorcerer', 'sorcery',
    'dragon', 'dragons', 'elf', 'elves', 'orc', 'orcs', 'goblin', 'goblins', 'dwarf',
    'vampire', 'vampires', 'zombie', 'zombies', 'demon', 'demons', 'god', 'gods',
    'kingdom', 'kingdoms', 'castle', 'castles', 'tavern', 'taverns', 'dungeon', 'dungeons',
    'knight', 'knights', 'sword', 'swords', 'medieval', 'fantasy',
    'spaceship', 'spaceships', 'starship', 'starships', 'planet', 'planets', 'galaxy',
    'android', 'androids', 'robot', 'robots', 'laser', 'lasers', 'cyberpunk', 'steampunk',
    'mech', 'alien', 'aliens', 'apocalypse', 'dystopia', 'samurai', 'ninja', 'pirate',
    'detective', 'noir', 'western', 'horror', 'romance', 'thriller'
];

// The blocks the scan covers, resolved in a function so no top-level var reads another.
// A NEW SUBSTRATE BLOCK JOINS THIS LIST IN THE SAME PATCH or the gate silently stops
// covering it, which is the failure mode that makes a gate worse than no gate.
function _cePromptBlocks(): any[] {
    return [
        { name: 'CORE', text: CE_P_CORE },
        { name: 'CHAT', text: CE_P_CHAT },
        { name: 'MACHINE', text: CE_P_MACHINE },
        { name: 'RECORDS', text: CE_P_RECORDS },
        { name: 'NAMING', text: CE_P_NAMING },
        { name: 'PREMISE', text: CE_P_PREMISE },
        { name: 'WORLD', text: CE_P_WORLD },
        { name: 'FIELD_MINT_BODY', text: CE_P_FIELD_MINT_BODY },
        { name: 'FIELD_MINT_TAIL', text: CE_P_FIELD_MINT_TAIL },
        { name: 'WORLD_PICK', text: CE_P_WORLD_PICK },
        { name: 'WORLD_PICK_TAIL', text: CE_P_WORLD_PICK_TAIL },
        { name: 'COMPRESS_WARN', text: CE_P_COMPRESS_WARN },
        { name: 'STYLE_TIER', text: CE_P_STYLE_TIER },
        { name: 'PLAY_TIER', text: CE_P_PLAY_TIER },
        { name: 'EXTRACT_ASK', text: _ceWorldExtractAsk('Question', 'what belongs in it') },
        { name: 'SCOPED_TAIL', text: CE_P_SCOPED_TAIL },
        { name: 'SCOPED_LEAD', text: ceScopedChatLead('places', 'Level', '') },
        { name: 'SEED_WHAT', text: CE_P_SEED_WHAT },
        // [DESC-MEANS] Both, because the item wording is the one an author will want to
        // check and a gate that only ever shows the generic line hides the variant.
        { name: 'SEED_FORMAT', text: ceSeedFormat('') },
        { name: 'SEED_FORMAT_ITEM', text: ceSeedFormat('item') },
        { name: 'SEED_UNUSABLE', text: CE_P_SEED_UNUSABLE },
        { name: 'SEED_RELAPSE', text: CE_P_SEED_RELAPSE },
        { name: 'SEED_EXTRACT_ASK', text: ceSeedExtractAsk('place', 'A Place', '', [], '') },
        { name: 'RECORD_TAIL', text: CE_P_RECORD_TAIL },
        { name: 'RECORD_LEAD', text: ceRecordChatLead('place', 'A Place', '') }
    ];
}

// Word-boundary, case-insensitive, one pass per block. Built per call rather than held in a
// var because a RegExp with /g carries lastIndex between uses and a shared one skips matches.
function _cePromptNounScan(): string[] {
    var hits: string[] = [];
    var blocks = _cePromptBlocks();
    for (var b = 0; b < blocks.length; b++) {
        var body = String(blocks[b].text || '').toLowerCase();
        var found: string[] = [];
        for (var w = 0; w < CE_P_SETTING_NOUNS.length; w++) {
            var noun = CE_P_SETTING_NOUNS[w];
            if (new RegExp('\\b' + noun + '\\b').test(body)) found.push(noun);
        }
        if (found.length) hits.push(blocks[b].name + ': ' + found.join(', '));
    }
    return hits;
}

// The tolerant call shape, per [UNCACHED-ASYNC]: the typings declare a number and this
// runtime returns a promise. Tolerant of either, so this keeps answering if that is fixed.
async function _cePromptUncached(msgs: any[]): Promise<number> {
    try {
        if (!api.v1.script.countUncachedInputTokens) return -1;
        var r: any = api.v1.script.countUncachedInputTokens(msgs as any);
        var v = (r && typeof r.then === 'function') ? await r : r;
        return (typeof v === 'number' && v >= 0) ? v : -1;
    } catch (eUc) { return -1; }
}

function _cePromptChars(msgs: any[]): number {
    var n = 0;
    for (var i = 0; i < msgs.length; i++) { n += String((msgs[i] && msgs[i].content) || '').length; }
    return n;
}

// [P-GATE] THE GATE. Builds the world-extract sequence's arrays and generates nothing.
// It measures that pass because it is the pipeline's first real batch -- N asks appended to
// one conversation prefix -- and is therefore the shape the name and seed passes will take.
// When those exist they become further kinds here; the three checks do not change.
// IT RUNS ON AN EMPTY STORY. With no world conversation it substitutes a two-turn stand-in
// and says so, because a gate that only runs on a finished story is a gate nobody runs.
async function _cePromptGate(nWanted: number): Promise<string> {
    var out: string[] = [];
    var n = Math.max(2, Math.min(12, Math.round(Number(nWanted) || 6)));

    var chat = await loadBuildChat('world');
    var turns: any[] = chat.turns || [];
    var synthetic = false;
    if (!turns.length) {
        synthetic = true;
        turns = [{ id: 'gate1', role: 'user', text: 'A stand-in turn, so the gate can run.' },
                 { id: 'gate2', role: 'assistant', text: 'A stand-in reply, so the gate can run.' }];
    }

    var qs = await ceWorldQuestions();
    var asks: any[] = [];
    for (var q = 0; q < qs.length && asks.length < n; q++) {
        asks.push({ label: String(qs[q].label || ''), scope: ceWorldScope(qs[q]) });
    }
    while (asks.length < 2) {
        asks.push({ label: 'Stand-in ' + String(asks.length + 1), scope: 'a stand-in scope' });
    }

    var base = await ceBuildChatMessages('world', CE_P_WORLD, turns as any);
    var calls: any[] = [];
    for (var a = 0; a < asks.length; a++) {
        var msgs = base.slice(0);
        msgs.push({ role: 'user', content: _ceWorldExtractAsk(asks[a].label, asks[a].scope) });
        calls.push(msgs);
    }

    out.push('PROMPT GATE \u2014 world extract, ' + String(calls.length) + ' calls, nothing generated.');
    if (synthetic) out.push('No world conversation yet; a two-turn stand-in was used.');
    out.push('');

    // CHECK 1 -- PREFIX IDENTITY. Every call is call 1's head plus one differing tail.
    var headOk = true;
    var headFail = '';
    var ref = calls[0];
    for (var c = 1; c < calls.length; c++) {
        var cur = calls[c];
        if (cur.length !== ref.length) {
            headOk = false; headFail = 'call ' + String(c + 1) + ' has a different message count'; break;
        }
        for (var m = 0; m < ref.length - 1; m++) {
            if (String(ref[m].role) !== String(cur[m].role)
             || String(ref[m].content) !== String(cur[m].content)) {
                headOk = false;
                headFail = 'call ' + String(c + 1) + ' differs at message ' + String(m)
                         + ' (role ' + String(ref[m].role) + ')';
                break;
            }
        }
        if (!headOk) break;
    }
    out.push((headOk ? 'PASS' : 'FAIL') + '  1. prefix identity \u2014 every call is one head plus one tail');
    if (!headOk) out.push('        ' + headFail);

    // CHECK 2 -- THE ASK IS THE SMALL HALF. 1's whole economy is that the head is paid once
    // and the ask on every call, so an ask approaching the head's size means a rule has
    // drifted down into it.
    var headChars = _cePromptChars(ref.slice(0, ref.length - 1));
    var askMax = 0;
    var askTotal = 0;
    for (var k = 0; k < calls.length; k++) {
        var ac = String(calls[k][calls[k].length - 1].content || '').length;
        askTotal += ac;
        if (ac > askMax) askMax = ac;
    }
    var ratio = headChars > 0 ? (askMax / headChars) : 1;
    var askOk = ratio < 0.34;
    out.push((askOk ? 'PASS' : 'FAIL') + '  2. the ask is the small half \u2014 largest ask is '
        + String(Math.round(ratio * 100)) + '% of the head');
    out.push('        head ' + String(headChars) + ' chars, asks ' + String(askTotal)
        + ' chars over ' + String(calls.length) + ' calls');

    // CHECK 3 -- NO SETTING NOUN in any substrate block [P-NO-SETTING].
    var nouns = _cePromptNounScan();
    out.push((nouns.length ? 'FAIL' : 'PASS') + '  3. no setting noun in any substrate block');
    for (var h = 0; h < nouns.length; h++) { out.push('        ' + nouns[h]); }

    // OBSERVED, NOT ASSERTED. See [P-GATE-NO-TOKENS]: without a generation the cache is cold
    // for both, so these two numbers are expected to be close. They diverge only after the
    // pass has actually run once, which is when this line is worth reading.
    var u1 = await _cePromptUncached(calls[0]);
    var u2 = await _cePromptUncached(calls[1]);
    out.push('');
    out.push('observed uncached: call 1 = ' + (u1 < 0 ? 'n/a' : String(u1))
        + ', call 2 = ' + (u2 < 0 ? 'n/a' : String(u2))
        + '  (cold for both unless the pass has already run)');
    return out.join('\n');
}

// [BUILD-CHAT-EDIT] A TURN IS EDITABLE AND DELETABLE, INCLUDING THE MODEL'S. The transcript
// is the prompt -- it is replayed verbatim as the prefix on every later call -- so a bad
// reply left in it is not a cosmetic blemish, it is context that steers everything after it.
// Editing one is therefore a first-class verb rather than a convenience.
// EDITING DOES NOT RE-RUN THE REPLY. What follows a changed turn still answers the old text
// until the author sends again, which is visible and recoverable; silently regenerating a
// tail the author did not ask for is neither.
async function ceBuildChatEdit(scope: string, id: string, text: string): Promise<BuildChat> {
    var chat = await loadBuildChat(scope);
    for (var i = 0; i < chat.turns.length; i++) {
        if (chat.turns[i] && String(chat.turns[i].id) === String(id)) {
            chat.turns[i].text = String(text || '');
        }
    }
    await saveBuildChat(chat);
    return chat;
}

async function ceBuildChatDelete(scope: string, id: string): Promise<BuildChat> {
    var chat = await loadBuildChat(scope);
    var keep: any[] = [];
    for (var i = 0; i < chat.turns.length; i++) {
        if (chat.turns[i] && String(chat.turns[i].id) !== String(id)) keep.push(chat.turns[i]);
    }
    chat.turns = keep;
    await saveBuildChat(chat);
    return chat;
}

var _ceBuildTurnSeq = 0;
function _ceBuildTurnId(): string {
    _ceBuildTurnSeq++;
    return 'bt' + String(Date.now()) + '_' + String(_ceBuildTurnSeq);
}

// [P-SUBSTRATE] THE PREFIX IS ASSEMBLED ONCE PER CALL AND IN ONE ORDER. Two assemblies is
// two prefixes and two prefixes is a cache warm for neither, which is why every caller
// reaches ceBuildHead rather than concatenating its own.
// The style tier rides the head because a chat that does not know the world's naming
// conventions will cheerfully propose names that violate them.
async function ceBuildChatMessages(scope: string, block: string, turns: BuildChatTurn[]): Promise<any[]> {
    var c = await loadCharter();
    var sys = ceBuildHead({ family: 'chat', style: String(c.style || '') });
    if (block) sys = sys + '\n\n' + block;
    var msgs: any[] = [{ role: 'system', content: sys }];
    for (var i = 0; i < turns.length; i++) {
        var t = turns[i];
        if (!t || t.pending) continue;
        if (!String(t.text || '').trim()) continue;
        msgs.push({ role: (String(t.role) === 'user') ? 'user' : 'assistant',
                    content: String(t.text) });
    }
    return msgs;
}

// One turn of a build chat: append the author, ask, append the reply. Returns the saved chat
// so the caller republishes from what actually landed rather than from what it hoped for.
// [BUILD-CHAT-FAILKIND] The catch writes the failure INTO the transcript. A chat that
// silently drops a turn on a dead budget looks to the author exactly like a model with
// nothing to say.
async function ceBuildChatSend(scope: string, block: string, text: string): Promise<BuildChat> {
    var chat = await loadBuildChat(scope);
    chat.turns.push({ id: _ceBuildTurnId(), role: 'user', text: String(text) });
    await saveBuildChat(chat);

    var msgs = await ceBuildChatMessages(scope, block, chat.turns);
    var model = ceUtilityModel();   // [UTIL-PIN] the utility channel, never the story's model
    var params: any = {
        model: model,
        max_tokens: 1000,
        temperature: 0.85,
        // [P-SUBSTRATE] EXPLICIT, NEVER INHERITED. generationParameters.get() returns the
        // author's STORY settings, so a story tuned to 1.3 would quietly wreck every reply
        // here and read as a fault in the pipeline. Sampler values are not part of the
        // cached prefix, so stating them costs nothing.
        enable_thinking: false
    };
    var reply = '';
    var failed = '';
    try {
        var res: any = await aeDiagGenerateWithStory('build:' + scope, msgs, params, undefined, undefined, 'background');
        reply = ceGenText(res);
    } catch (eBcG) {
        failed = _ceGenFailKind(eBcG) === 'transport'
            ? 'The call did not reach the model. Nothing was generated \u2014 try again in a moment.'
            : 'The model returned nothing usable. Try rephrasing, or send again.';
        api.v1.error('[AE:buildchat] generate failed:', eBcG);
    }
    chat = await loadBuildChat(scope);
    chat.turns.push({ id: _ceBuildTurnId(), role: 'assistant',
                      text: failed || reply || '(no reply)' });
    await saveBuildChat(chat);
    return chat;
}
