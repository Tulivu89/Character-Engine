// ── Default Values ────────────────────────────────────────────────────────────

// [WIZARD-2] Starter world-canon sections. target:'memory' assembles into the Memory block
// IN LIST ORDER; the two target:'an' rows assemble into the Author's Note and sit last.
// Sections past Central Conflict start disabled. Authors reorder freely in the Memory tab.
var DEFAULT_WIZARD_SECTIONS: WizardMemorySection[] = [
    { id: 'wsec_premise', label: 'Premise', enabled: true, content: '', target: 'memory',
      instructions: 'Write ONE sentence \u2014 the story\'s logline: who the central figure is, the situation they are in, and what is at stake. Specific to this story, not a theme and not a question. Do not assume a point of view or address the reader. Register to aim for: "A disgraced navigator hired to chart waters her old commander declared unmappable." "A woman who stayed in the house after the divorce because leaving would mean admitting it mattered."' },
    { id: 'wsec_setting', label: 'Setting', enabled: true, content: '', target: 'memory',
      instructions: 'State the world, place, and era the story sits in, and the scope it occupies within that world. The facts of the stage \u2014 not plot, not characters, not theme. One or two sentences.' },
    { id: 'wsec_themes', label: 'Themes', enabled: true, content: '', target: 'memory',
      instructions: 'Name the emotional register and the throughlines the story keeps returning to. Abstractions, not events. Do not restate the setting or describe specific characters.' },
    { id: 'wsec_conflict', label: 'Central Conflict', enabled: true, content: '', target: 'memory',
      instructions: 'Describe the opposing forces and what is contested between them \u2014 the shape of the pressure, not its resolution and not the individual beats.' },
    { id: 'wsec_worldrules', label: 'World Rules', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how this world works where it departs from the ordinary: the powers, technologies, or social orders in play, what they make possible, and what they cost. Rules, not instances.' },
    { id: 'wsec_intimacy', label: 'Intimacy and Consequences', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how attraction, desire, and intimacy operate in this world and what tends to follow from them \u2014 the tone and the stakes of closeness, not a specific pairing.' },
    { id: 'wsec_danger', label: 'Danger and Consequences', enabled: false, content: '', target: 'memory',
      instructions: 'Describe how harm, violence, and danger operate in this world and what their aftermath looks like \u2014 how lethal, how lasting, how the narrative treats it. Not a specific confrontation.' },
    { id: 'wsec_stakes', label: 'Stakes', enabled: false, content: '', target: 'memory',
      instructions: 'Describe what can be won or lost at the largest scale this story reaches \u2014 the weight on the scales, not the mechanics or the plot beats.' },
    { id: 'wsec_attg', label: 'ATTG', enabled: true, content: '', target: 'an',
      instructions: 'Output ONLY a single ATTG line, enclosed in spaced brackets, in exactly this form: [ Author: <name>; Title: <title>; Tags: <comma-separated tags>; Genre: <genre> ]. Pick a well-known author whose sensibility fits this story. Output only the bracketed line \u2014 no heading, no commentary, no markdown.' },
    { id: 'wsec_style', label: 'Style', enabled: true, content: '', target: 'an',
      instructions: 'Describe the narrative voice, beginning with a two-author tonal anchor: name two authors whose combined sensibilities capture this story\'s voice, matched to emotional register and prose style rather than surface genre, the pairing set in productive tension. Then describe the resulting voice concretely: sentence rhythm, level of description, use of interiority, how the prose handles emotion. Under 100 words. No markdown.' }
];

// [WIZARD-2] Starter topic registry. Concept feeds context to the rest; World Memory fans
// out to the Memory sections on commit; Style & Voice writes the AN voice; the entity
// topics follow. commitKind routes what a topic produces.
var DEFAULT_WIZARD_TOPICS: WizardTopic[] = [
    { id: 'wtopic_concept', label: 'Initial Concept', commitKind: 'concept',
      seedMessage: 'This chat shapes your story\'s foundation \u2014 the title, genre, and central premise everything else will stand on. Bring whatever you have, even a stray image or a single line, and we\'ll sharpen it together. What\'s the core idea you\'re starting from?',
      instructions: 'You are a narrative designer acting as a sounding board, helping the user develop a story\'s core concept \u2014 its title, genre, and central premise \u2014 into a cohesive foundation the rest of the world can stand on.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone; you are a creative partner, not a gatekeeper. Build on the user\'s idea with a concrete suggestion or two that push the premise forward, and follow their lead rather than steering toward any particular genre or tone. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_memory', label: 'World Memory', commitKind: 'memoryFanout',
      seedMessage: 'This chat builds the permanent facts of your world \u2014 the premise, the setting and its scope, the themes it keeps returning to, and the conflict driving everything. Once something lands here it becomes canon that holds steady for the whole story. Where should we start \u2014 the premise, or the shape of the conflict?',
      instructions: 'You are a world-builder helping the user define the static canon of their story \u2014 the permanent memory block. Its sections may include the premise (a one-sentence logline of the central figure, their situation, and what is at stake), the setting and its scope, the core themes, the central conflict, and optional world rules, intimacy, danger, and stakes. The story may be any genre and any point of view; do not assume a player-protagonist or a second-person frame.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Favour durable facts, throughlines, and world rules over plot events or character arcs. If an idea is vague, offer a couple of concrete directions to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_style', label: 'Style & Voice', commitKind: 'memoryFanout',
      seedMessage: 'This chat sets the narrative voice for your Author\'s Note \u2014 tense, perspective, tone, pacing, prose density, and the authors whose sensibilities you\'re reaching for. Describe the reading experience you\'re after, even loosely, and we\'ll pin it down. What\'s the voice you\'re hearing?',
      instructions: 'You are a prose stylist helping the user define the narrative voice for the Author\'s Note \u2014 tense, perspective, tone, pacing, and density.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Talk about writing mechanics rather than story content. A strong anchor is naming one or two authors whose combined sensibilities capture the voice \u2014 matched to emotional register and prose style, not surface genre \u2014 then describing the concrete result: sentence rhythm, description density, interiority, how the prose handles emotion. If the user\'s description is broad (e.g. "dark"), offer a few specific techniques or authorial blends to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_species', label: 'Species', commitKind: 'speciesBatch',
      seedMessage: 'This chat designs the species, peoples, or creature-types living in your world \u2014 what makes each one fundamentally distinct, not just differently dressed. Tell me about one you already picture, however roughly. What\'s the first one?',
      instructions: 'You are helping the user design distinct species, peoples, or creature-types, each of which becomes a structured lorebook entry.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Look for what makes a species fundamentally distinct: anatomy, inherent cultural drives, and its role in the world. If an idea leans on a familiar trope, offer a stranger or more grounded angle to react to rather than just flagging it. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    // [F-28] wtopic_factions DELETED with the tab it committed into. See CE_WIZ_TABS.
    { id: 'wtopic_locations', label: 'Locations', commitKind: 'locationsBatch',
      seedMessage: 'This chat maps the places in your world, from sweeping regions down to single rooms, pairing what a person senses on arrival with the deeper history behind it. Tell me about one place, at whatever scale feels right. Where should we begin?',
      instructions: 'You are helping the user map their setting: specific locations, their scale (region, settlement, or a single room), the immediate scene-present view, and the deeper background lore for the lorebook.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. For each place, draw out two layers: (A) the immediate description \u2014 one or two sentences of what is physically sensed on arrival, at whatever scale the place is \u2014 and (B) the hidden history, culture, or systems reserved for the lorebook entry. Keep the two from duplicating each other. Usually ask one focused question at a time, drilling into scale, atmosphere, or connections.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_characters', label: 'Characters', commitKind: 'charactersBatch',
      seedMessage: 'This chat builds a character\'s static identity \u2014 who they are at a glance, their physical presence, and what shaped them. We\'ll work through one detail at a time rather than all at once. Who\'s the character, and what\'s the first thing you see when you picture them?',
      instructions: 'You are workshopping a character with the user \u2014 their static baseline: name, age, gender, species, role, a tight one-sentence summary, a physical scene-present description, core contradictions, voice and mannerisms, and formative background.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Work one detail at a time rather than asking for every field at once. If something feels flat, offer a concrete, sensory, or grounded alternative to react to. Keep to static identity \u2014 momentary feelings, immediate goals, and shifting relationships belong in other chats. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_drama', label: 'Drama & Tension', commitKind: 'dramaSeed',
      seedMessage: 'This chat seeds the tensions your story runs on \u2014 the debts, secrets, and wants tying your established characters together. We\'re sharpening dynamics between who and what already exists, not inventing new people. What\'s a relationship or thread you want to charge with stakes?',
      instructions: 'You are a dramaturg helping the user seed the dramatic engine: the tensions characters carry, the charged dynamics between them, and the threads that drive the story.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Work with the established cast rather than introducing new named people, and tie each tension to a specific person, debt, secret, or want with concrete stakes. If a conflict feels symmetric or toothless, suggest a specific asymmetry, hidden motive, or forcing stake to react to. Usually ask one focused question at a time.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    { id: 'wtopic_intro', label: 'Intro / Opening', commitKind: 'introScene',
      seedMessage: 'This chat designs your opening scene \u2014 the moment the story begins and control takes hold. Tell me the situation it opens on: where things are, and what\'s already in motion.',
      instructions: 'You are a writing partner helping the user workshop the OPENING scene \u2014 the moment the story begins and interaction takes hold. Take the intro they bring on its own terms, whatever pacing or structure they picture.\n\nWrite in plain prose \u2014 no markdown, headers, or lists. Keep a warm, collaborative tone. Help sharpen the sensory grounding of the first moment and find where the first action or choice takes hold \u2014 whether the scene opens mid-action or eases in, both are legitimate. Usually ask one focused question at a time, developing atmosphere, the immediate situation, or where agency begins.\n\nTypically respond in 2-5 sentences; a short paragraph is fine when drawing several threads together.' },
    // KNOWN DEAD: the two topics below have commitKinds (archetypeBatch / itemBatch) with
    // no generators left. Harmless, slated for removal.
    { id: 'wtopic_bestiary', label: 'Bestiary', commitKind: 'archetypeBatch',
      seedMessage: 'This chat stocks your bestiary of drop-in minor NPCs \u2014 the quick, disposable folk and creatures you spawn into a scene: someone to fight, someone to bribe, someone to haggle with. Each one gets a NAME and a one-line BRIEF for why they\'re here, and either can vary at spawn with {a|b|c} alternation, like "{Brittle|Rattling|Ancient} Skeleton." What\'s the first one?',
      instructions: 'You are a creature-and-cast designer helping the user stock a bestiary of MINOR, drop-in NPCs \u2014 the lightweight, disposable figures spawned into a scene (mobs to fight, folk to bargain with, ambient background people), NOT deep named characters. You author exactly two things for each archetype: the name and the brief.\n\nFORMAT:\n1. Write in pure prose. No markdown, bolding, italics, headers, or lists.\n2. Keep a warm, collaborative tone.\n3. For each archetype, help pin down two things: a short NAME or label (offer spawn-time variety with {a|b|c} alternation where it fits) and a one-line BRIEF of what they are doing here.\n4. Keep them shallow by design: a name and a one-line reason to be present, nothing more. If the user starts developing one with real depth, gently suggest promoting it to a full character instead.\n5. Ask exactly ONE focused question per turn to sharpen a specific archetype.\n\nTypically respond in 2-5 sentences; when summarizing or drawing together several already-established points for the user, a short paragraph is fine.' },
    { id: 'wtopic_items', label: 'Items', commitKind: 'itemBatch',
      seedMessage: 'This chat stocks your set of item templates \u2014 the things a player finds, carries, wields, or wears. Each one gets a NAME and a one-line DESCRIPTION, and either can vary at spawn with {a|b|c} alternation, like a "{rusty|gleaming} {iron|steel} dagger." What\'s the first one?',
      instructions: 'You are an item designer helping the user stock a set of ITEM TEMPLATES: the objects a player finds, carries, wields, or wears \u2014 weapons, garments, tools, trinkets, consumables. You author exactly two things for each item: the name and the description.\n\nFORMAT:\n1. Write in pure prose. No markdown, bolding, italics, headers, or lists.\n2. Keep a warm, collaborative tone.\n3. For each item, pin down two things: a short NAME (offer spawn-time variety with {a|b|c} alternation where colour, material, or condition could differ, e.g. a {rusty|gleaming|chipped} {iron|steel} dagger) and a one-sentence DESCRIPTION of what it is and its notable qualities.\n4. Keep them concrete and evocative but shallow: one name, one sentence, nothing more.\n5. Ask exactly ONE focused question per turn to sharpen a specific item.\n\nTypically respond in 2-5 sentences; when summarizing or drawing together several already-established points for the user, a short paragraph is fine.' }
];

// ── World-Build Wizard: chat storage + CRUD (storyStorage) ───────────────────
async function loadWizardChats(): Promise<WizardChat[]> {
    let raw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_CHATS, '[]') as string;
    try {
        let arr = JSON.parse(raw);
        if (Array.isArray(arr)) { for (let mc of arr) { if (!mc.characterIds) mc.characterIds = []; } return arr; }
        return [];
    } catch (e) {
        api.v1.error('[AE:wizard] loadWizardChats parse error:', e);
        return [];
    }
}

async function saveWizardChats(chats: WizardChat[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_WIZ_CHATS, JSON.stringify(chats || []));
}

async function loadWizardChat(id: string): Promise<WizardChat | null> {
    let chats = await loadWizardChats();
    return chats.find(function(c) { return c.id === id; }) || null;
}

async function saveWizardChat(chat: WizardChat): Promise<void> {
    if (!chat || !chat.id) return;
    let chats = await loadWizardChats();
    let idx = chats.findIndex(function(c) { return c.id === chat.id; });
    chat.updatedAt = Date.now();
    if (idx >= 0) chats[idx] = chat;
    else chats.push(chat);
    await saveWizardChats(chats);
}

async function createWizardChat(topicId: string, title: string): Promise<WizardChat> {
    // Seed the topic's opening message so a new chat explains what it produces.
    let seedMsgs: WizardChatMessage[] = [];
    try {
        let seedCfg = await loadConfig();
        let seedTopic = getWizardTopic(seedCfg, topicId);
        if (seedTopic && (seedTopic as any).seedMessage && String((seedTopic as any).seedMessage).trim()) {
            seedMsgs.push({ role: 'assistant', content: String((seedTopic as any).seedMessage).trim() });
        }
    } catch (eSeed) { /* non-fatal: start empty */ }
    let chat: WizardChat = {
        id: 'wchat_' + generateId(),
        topicId: topicId,
        title: title || 'New Chat',
        messages: seedMsgs,
        contextChatIds: [],
        includeStory: false,
        lorebookEntryIds: [],
        characterIds: [],
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
    await saveWizardChat(chat);
    return chat;
}

async function deleteWizardChat(id: string): Promise<void> {
    let chats = await loadWizardChats();
    chats = chats.filter(function(c) { return c.id !== id; });
    await saveWizardChats(chats);
}

// ── World-Build Wizard: staging store (storyStorage) ─────────────────────────
// [STAGING] generate -> review -> commit. Nothing touches cfg.* or the lorebook until
// commitStagedDrafts() runs, so a bad generation discards without leaving orphan records.
// `fields` is a flat string map so one store and one editor serve every kind; the per-kind
// shape is WIZ_DRAFT_FIELDS below and commit routes on `kind`.
interface WizardDraft {
    id: string;
    kind: string;
    fields: { [k: string]: string };
    sourceChatIds: string[];
    parentId: string | null;   // locations only; null for every other kind
    createdAt: number;
}


// [STAGING] Per-kind field schema. `multiline` selects textInput vs multilineTextInput.
var WIZ_DRAFT_FIELDS: { [kind: string]: { key: string; label: string; multiline: boolean }[] } = {
    species:   [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Lore', multiline: true }],
    faction:   [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Lore', multiline: true }],
    archetype: [{ key: 'name', label: 'Name', multiline: false }, { key: 'brief', label: 'Brief', multiline: true }],
    item:      [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'Description', multiline: true }],
    location:  [{ key: 'name', label: 'Name', multiline: false }, { key: 'description', label: 'On arrival', multiline: true }, { key: 'lore', label: 'Lorebook', multiline: true }],
    // [CHAR-STAGE] Name + dump only. The structured fields are derived AT COMMIT from
    // whatever dump is on screen then -- a failed fields call must not strand a character
    // with nothing but a name.
    character: [{ key: 'name', label: 'Name', multiline: false }, { key: 'dump', label: 'Concept', multiline: true }]
};

function wizKindLabel(kind: string): string {
    if (kind === 'species')   return 'species';
    if (kind === 'faction')   return 'factions';
    if (kind === 'archetype') return 'archetypes';
    if (kind === 'item')      return 'items';
    if (kind === 'location')  return 'locations';
    if (kind === 'character') return 'characters';
    return kind;
}


async function loadWizardDrafts(): Promise<WizardDraft[]> {
    let raw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_DRAFTS, '[]') as string;
    try {
        let arr = JSON.parse(raw);
        if (Array.isArray(arr)) return arr;
        return [];
    } catch (eWdLoad) {
        api.v1.error('[AE:wizard] loadWizardDrafts parse error:', eWdLoad);
        return [];
    }
}

async function saveWizardDrafts(drafts: WizardDraft[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_WIZ_DRAFTS, JSON.stringify(drafts || []));
}

async function loadWizardDraftsOfKind(kind: string): Promise<WizardDraft[]> {
    let all = await loadWizardDrafts();
    return all.filter(function(d) { return d.kind === kind; });
}

// Returns the ids created, so a generate-then-commit caller commits exactly its own
// drafts and not whatever the user already had staged.
async function addWizardDrafts(kind: string, items: { [k: string]: string }[], sourceChatIds: string[], parentId: string | null): Promise<string[]> {
    let all = await loadWizardDrafts();
    let newIds: string[] = [];
    for (let it of (items || [])) {
        let did = 'wdraft_' + generateId();
        newIds.push(did);
        all.push({
            id: did,
            kind: kind,
            fields: it,
            sourceChatIds: (sourceChatIds || []).slice(),
            parentId: parentId || null,
            createdAt: Date.now()
        });
    }
    await saveWizardDrafts(all);
    return newIds;
}

async function updateWizardDraftField(draftId: string, fieldKey: string, value: string): Promise<void> {
    let all = await loadWizardDrafts();
    let target = all.find(function(d) { return d.id === draftId; });
    if (!target) return;
    target.fields[fieldKey] = value;
    await saveWizardDrafts(all);
}

// DO NOT FEED DISCARDED NAMES INTO THE DO-NOT-RECREATE LIST. Tried and reverted: a
// rejected draft is not an existing entity, so forbidding it made the model invent
// unrelated originals instead of retrying the name the chat was about. Only STAGED names
// go in that list, which is all it was ever for -- stopping a second Generate press from
// duplicating the batch on screen.
async function discardWizardDraft(draftId: string): Promise<void> {
    let all = await loadWizardDrafts();
    await saveWizardDrafts(all.filter(function(d) { return d.id !== draftId; }));
}

async function discardAllWizardDrafts(kind: string): Promise<number> {
    let all = await loadWizardDrafts();
    let doomed = all.filter(function(d) { return d.kind === kind; });
    await saveWizardDrafts(all.filter(function(d) { return d.kind !== kind; }));
    return doomed.length;
}

async function removeWizardDrafts(draftIds: string[]): Promise<void> {
    if (!draftIds || !draftIds.length) return;
    let all = await loadWizardDrafts();
    await saveWizardDrafts(all.filter(function(d) { return draftIds.indexOf(d.id) < 0; }));
}

function getWizardTopic(cfg: GlobalConfig, topicId: string): WizardTopic | null {
    let list = ((cfg as any).wizardTopics && (cfg as any).wizardTopics.length)
        ? (cfg as any).wizardTopics
        : DEFAULT_WIZARD_TOPICS;
    return list.find(function(t: WizardTopic) { return t.id === topicId; }) || null;
}

// [F-24] THE WORLD'S STANDING LADDER, coldest first. A faction overrides only if it means
// something different by these words.
// [F-20] The archetypes below are PROSE THE MODEL READS, not taxonomy: shape says what holds
// two people together, each stage says what is observably true right now. WRITE THEM PRESENT
// TENSE, NO SECOND PERSON, NO NAMES -- Position's AN template renders them with nothing
// around them but a name, and these seed arbitrary pairs.
var DEFAULT_STANDING_LADDER: string[] = ['Hostile', 'Wary', 'Neutral', 'Friendly', 'Allied'];

var DEFAULT_REL_ARCHETYPES: RelationshipArchetypeDef[] = [
    { id: 'arch_rivals', name: 'Rivals',
      shape: 'They want the same thing and only one of them can have it. Neither can walk away without conceding, so they keep circling back to each other.',
      stages: [
        'Each will take a loss themselves if it costs the other more.',
        'Every exchange is being scored. Courtesy, when it appears, is a move.',
        'They measure themselves against each other, and both know the other is doing it.',
        'Neither would say it aloud, but each has stopped hoping the other fails.',
        'The contest is still running. It has simply stopped being the point of them.' ] },

    { id: 'arch_friends', name: 'Friends',
      shape: 'They chose each other, and nothing outside the friendship obliges either of them to keep choosing. It holds because both keep showing up.',
      stages: [
        'They are glad to see each other and would not go out of their way for it.',
        'The warmth is real and out of practice. There is more history here than present.',
        'They tell each other things first.',
        'Their plans assume each other. Neither has checked whether that was ever agreed.' ] },

    { id: 'arch_dating', name: 'Dating',
      shape: 'Something is being built here and both can see it half-finished, so every choice either makes gets read as evidence of where it is going.',
      stages: [
        'Both are keeping count now, and neither has admitted it.',
        'They are still deciding, and are careful not to ask the other how it is going.',
        'The question of whether this is happening has quietly stopped being asked.',
        'They plan around each other as a matter of course.',
        'Whatever comes, the other one is not in question.' ] },

    { id: 'arch_slowburn', name: 'Slow Burn',
      shape: 'Neither has named it and both have had the chance. What passes between them keeps arriving in what is not said.',
      stages: [
        'They have noticed each other and would deny it if asked.',
        'They find reasons to be in the same place. The reasons are getting thinner.',
        'Being in the room has become the reason for being in the room.',
        'It is obvious to everyone else, and probably to them.' ] },

    { id: 'arch_e2l', name: 'Enemies to Lovers',
      shape: 'They began on opposite sides of something that mattered and neither has fully put it down. What runs between them was forged as hostility and has not cooled, only turned.',
      stages: [
        'Each is a problem the other intends to solve.',
        'They have a common reason not to act on it yet.',
        'Each has had a clear chance to hurt the other and let it pass.',
        'The old hostility is still there and has stopped meaning what it did.',
        'Nothing has been forgiven. It simply matters less than this does.' ] },

    { id: 'arch_familial', name: 'Strained Familial',
      shape: 'They did not choose each other and cannot resign. Whatever went wrong happened long enough ago that both have built their lives around it.',
      stages: [
        'Contact is an event. Each has a version of the story in which they were reasonable.',
        'They are civil, in the way that takes effort.',
        'They are trying, clumsily, and each can see the other trying.',
        'The old damage has been named. It belongs to them together now rather than sitting between them.' ] },

    { id: 'arch_custom', name: 'Custom', shape: '', stages: [] }
];

// [F-20] MIGRATION-ONLY, BYTE-EXACT. Lets the v6 pass tell an untouched catalog from an
// edited one. A fuzzy match would overwrite authored text; do not loosen it.
var CE_LEGACY_REL_ARCHETYPES: any = {
    arch_rivals:   'Hostile|Antagonistic|Competitive|Grudging Respect|Friendly',
    arch_friends:  'Acquaintances|Distant|Close|Inseparable',
    arch_dating:   'On the Rocks|Tentative|Steady|Committed|Devoted',
    arch_slowburn: 'Strangers|Curious|Drawn In|Smitten',
    arch_e2l:      'Enemies|Reluctant Allies|Uneasy Trust|Falling|Lovers',
    arch_familial: 'Estranged|Tense|Reconciling|Bonded',
    arch_custom:   ''
};

// [SEC:STATE][D-25] THE SEED LIBRARY. DEFINITIONS, not built-in kinds: the engine knows
// exactly one thing, "a bounded number with optional bands and optional attachments", and
// these are ordinary rows an author may edit or delete.
// Currency and Luck are unbanded on purpose -- by D-21 that makes them silent in context.
//
// DO NOT SEED AN UNREAD ATTACHMENT. Read today: 'modifier' (ceStateIsModifier, F-11) and
// 'spendForBonus' (ceStateSpendables, F-20). Declared and unread: 'cost' and 'target',
// which Health, Stamina and Standing all seed -- so they are outstanding promises, not
// parked fields. [F-25] A declared value nothing reads is harmless until it is SEEDED; then
// every new story makes a promise it breaks.
// [F-10] The line a def writes when it declares none. Assumes a band label that is a
// PREDICATE FRAGMENT ('is dying'). Migrated conditions carry their own template instead.
var DEFAULT_STATE_LINE = '[|name| |bandLabel|.]';

// [F-17] THE BAND IS THE UNIT. Four states of health is a max of 4, and one point of damage
// is one step worse. Not a tuning preference: on the old 0-100 track ninety-six points were
// invisible and a Miss costing 1 was noise. Keep every new scale band-sized.
var DEFAULT_STATE_DEFS: StateDef[] = [
    { id: 'st_health', name: 'Health', scope: 'char', category: 'Vitals', min: 0, max: 4, start: 4,
      bands: [ { at: 0, label: 'is dying' }, { at: 1, label: 'is badly hurt' },
               { at: 2, label: 'is hurt' }, { at: 3, label: 'is bruised' },
               { at: 4, label: 'is unhurt' } ],
      restBand: 4, attach: ['cost', 'target'],
      terminal: [ { at: 'min', note: 'This character dies from their wounds. Describe their '
        + 'death in visceral detail. Do not soften it and do not allow a last-second rescue.' } ] },
    // Six steps rather than five so exhaustion arrives a beat later than death does.
    { id: 'st_stamina', name: 'Stamina', scope: 'char', category: 'Vitals', min: 0, max: 5, start: 5,
      bands: [ { at: 0, label: 'is spent' }, { at: 2, label: 'is flagging' },
               { at: 4, label: 'is fresh' } ],
      restBand: 2, attach: ['cost'],
      terminal: [ { at: 'min', note: 'This character has nothing left. They stop, collapse or '
        + 'give in \u2014 they cannot continue what they were doing. Do not let willpower substitute '
        + 'for strength here.' } ] },
    // [F-17] THE THIRD VITAL, AND THE ONE FOCUS PAYS FROM. Finesse and Focus both charged
    // Stamina, which made the two approaches indistinguishable at the till: a failed act of
    // concentration and a failed act of dexterity took the same thing off the same row. A
    // working, a vigil, a thing seen that should not have been seen cost composure and do
    // not cost wind.
    //   hideAtStart, per G-02 and for its founding case -- a story that never asks anyone to
    //   hold themselves together never grows the row.
    //   ITS TERMINAL IS NOT A DEATH. Health kills; this one empties. That distinction is the
    //   whole reason it is a separate number rather than a second band on Stamina.
    { id: 'st_soul', name: 'Soul', scope: 'char', category: 'Vitals', min: 0, max: 4, start: 4,
      bands: [ { at: 0, label: 'is hollowed out \u2014 whatever was theirs to give has been given' },
               { at: 1, label: 'is badly frayed, and it shows in what they say' },
               { at: 2, label: 'is unsettled and cannot put it down' },
               { at: 3, label: 'is uneasy' },
               { at: 4, label: 'is whole' } ],
      restBand: 4, attach: ['cost'], hideAtStart: true,
      terminal: [ { at: 'min', note: 'This character has nothing left to give of themselves. '
        + 'They cannot begin, continue or hold anything that asks for will. Show what is '
        + 'missing in them, and do not restore it in this scene.' } ] },
    // [EVENT] THE TEN SEEDED SHAPES. Seeded because the door exists -- an Encounter section
    // on the Actions panel starts one -- so this is a promise the build keeps rather than
    // F-20's knob with nothing behind it.
    //   THEY ARE QUALITY REFERENCES, NOT REQUIRED PIECES. Every part of every one is what an
    //   author would write: a span that is a NUMBER OF SUCCESSES rather than hit points,
    //   bands that say how the thing READS at each step, and per-band directives on the
    //   steps worth announcing. Delete them and encounters still work.
    //   THEY COUNT UP, and that is the one convention to hold: `start` is at or near `min`,
    //   the terminal is at `max`, and a stake that moves the track POSITIVE is progress. A
    //   track is a progress bar and a progress bar fills. Infiltration is the exception and
    //   proves the rule -- it climbs toward being CAUGHT -- which is why ceEventPolarity
    //   derives the bar's tint from the wager rather than from the direction.
    //   THREE STRUCTURES, AND EVERY SHAPE IS ONE OF THEM:
    //     ONE-ENDED    a terminal at max and nothing at the floor. There is no losing here,
    //                  only ABANDONING, and abandoning is Cancel -- a floor terminal would
    //                  announce a defeat the author had not decided on.
    //     TWO-ENDED    a terminal at BOTH bounds, starting between them. Both ends are
    //                  somebody's win and neither is the author giving up.
    //     COST METER   climbing IS the danger, the objective is not on the track at all, and
    //                  the AUTHOR concludes it. Reaching the bound is the failure.
    //   THE NARRATIVE ROLE IS NOT A FIELD. Which wager an attempt pays is decided by the
    //   APPROACH the author rolls -- Finesse pays Stamina, Flair pays Position, Focus pays
    //   Soul -- so a Chase and an Infiltration with identical arithmetic still cost
    //   different things. Two tables, one ledger, and the shape supplies only the track.
    { id: 'st_ev_melee', name: 'Melee', scope: 'event', category: 'Encounters',
      min: 0, max: 3, start: 0, eventStakeId: 'stake_ev_melee',
      // ONE-ENDED, AND IT DOES NOT MODEL LOSING. What the fight costs the actor is their
      // Health, charged by the ATTEMPT's own wager, and Health already carries a death
      // terminal every move inherits. A track that also went down would be a second, quieter
      // place for the same loss to live.
      bands: [ { at: 0, label: 'The fight is joined and nobody has the better of it yet' },
               { at: 1, label: 'They are blooded and giving ground' },
               { at: 2, label: 'One of them is left standing and they know how this is going' },
               { at: 3, label: 'The fight is over. Whoever stood against them is down, fled or finished' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 1, note: 'The exchange has drawn blood. Show what it cost them \u2014 '
            + 'a wound, a stumble, a weapon dropped \u2014 and keep them in the fight.' },
        { at: 'band', band: 2, note: 'They are down to their last and it shows. Let them fight '
            + 'like someone who knows how this ends: desperate, or ready to run. Do not finish it yet.' },
        { at: 'band', band: 3, note: 'The fight ends here. Resolve it fully and concretely \u2014 '
            + 'who is standing, who is not, and what the room looks like now.' } ] },

    // TWO-ENDED, AND THE BANDS DESCRIBE A LINE RATHER THAN THE PEOPLE IN IT. Handed "the
    // flank has folded" a model writes ground, mass and noise; handed four half-tracked
    // soldiers it writes a brawl. DIRECTIVES ARE SPARSE -- four of seven bands speak,
    // because announcing every step over a span this long turns a battle into a checklist.
    { id: 'st_ev_battle', name: 'Battle', scope: 'event', category: 'Encounters',
      min: 0, max: 6, start: 3, eventStakeId: 'stake_ev_battle',
      bands: [ { at: 0, label: 'Their own line is gone. What is left of it is running or laying down arms' },
               { at: 1, label: 'A flank has folded and nothing is being sent to hold it' },
               { at: 2, label: 'They are giving ground and paying for every yard of it' },
               { at: 3, label: 'Both lines are committed and neither has bent' },
               { at: 4, label: 'The shape of it has turned, and the other side did not choose the turn' },
               { at: 5, label: 'The far line is bending and its orders are arriving too late to matter' },
               { at: 6, label: 'The field is theirs. The other side is breaking with nothing behind it' } ],
      restBand: 3,
      terminal: [
        { at: 'band', band: 1, note: 'It is going against them. Show a formation that is no '
            + 'longer a formation and a decision arriving too late to matter. Do not call it yet.' },
        { at: 'band', band: 5, note: 'The engagement has turned. Write ground and mass \u2014 where '
            + 'the line bulges, what is being fed into it \u2014 rather than one exchange between '
            + 'two people.' },
        { at: 'band', band: 0, note: 'They lose the field here. Name where their line went, who '
            + 'is left to run, and what the other side does with the ground.' },
        { at: 'band', band: 6, note: 'They take the field here. Name which side broke, what it '
            + 'cost to break them, and what the field looks like once it is quiet.' } ] },

    // TWO-ENDED AND SHORT. A chase has no give-up state: either the distance closes or it
    // opens past following, and both are an ending.
    //   THE BANDS NAME THE GAP AND NOT THE ROLES, so one shape serves the hunter and the
    //   hunted. "Their terms" is whichever end the protagonist wants, and the author's own
    //   line at Begin is what says which.
    //   ROLLED ON FINESSE IT CHARGES STAMINA, so a long chase runs a character down whether
    //   or not the track moves. That is the point of it having its own shape at all.
    { id: 'st_ev_chase', name: 'Chase', scope: 'event', category: 'Encounters',
      min: 0, max: 4, start: 2, eventStakeId: 'stake_ev_chase',
      bands: [ { at: 0, label: 'The chase is lost. The distance went the way they needed it not to' },
               { at: 1, label: 'It is slipping, and every choice from here is the one that decides it' },
               { at: 2, label: 'The gap is holding and neither side has spent what they have left' },
               { at: 3, label: 'The gap is going their way and the other side can feel it' },
               { at: 4, label: 'It is over on their terms \u2014 the distance closed, or opened past following' } ],
      restBand: 2,
      terminal: [
        { at: 'band', band: 1, note: 'It is getting away from them. Take a route, a turning or a '
            + 'stretch of clear ground off the board, and make the next choice cost something.' },
        { at: 'band', band: 3, note: 'The distance is moving their way. Show it in what they can '
            + 'now hear, see or reach that they could not a moment ago. Do not end it yet.' },
        { at: 'band', band: 0, note: 'The chase ends against them here. Say plainly how the '
            + 'distance was lost and what that leaves them holding.' },
        { at: 'band', band: 4, note: 'The chase ends on their terms here. Say where it ended and '
            + 'what state everyone is in \u2014 nobody arrives from a chase unwinded.' } ] },

    // ONE-ENDED, AND NOT EVERYTHING CONTESTED IS ADVERSARIAL: the top of this one is
    // AGREEMENT. NO FLOOR TERMINAL, deliberately -- a negotiation is not lost, it is
    // ABANDONED, and abandoning it is Cancel.
    //   ITS WAGER PUSHES BACK. A Miss SUBTRACTS, so ground already taken is losable, which
    //   is the second thing this seed exists to show: a track need not be a ratchet.
    { id: 'st_ev_negotiation', name: 'Negotiation', scope: 'event', category: 'Encounters',
      min: 0, max: 4, start: 0, eventStakeId: 'stake_ev_negotiation',
      bands: [ { at: 0, label: 'The positions are stated and neither has moved off theirs' },
               { at: 1, label: 'They are listening, and nothing has been conceded' },
               { at: 2, label: 'The shape of a deal is on the table and what is left is price' },
               { at: 3, label: 'One condition stands between them, and both know it is the last one' },
               { at: 4, label: 'It is agreed. The terms are settled and both sides are acting on them' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 2, note: 'A deal is plausible now and both sides can feel it. Move '
            + 'them off positions and onto terms \u2014 numbers, timing, who goes first. Do not let '
            + 'them agree yet.' },
        { at: 'band', band: 3, note: 'One thing stands between them. Name it exactly, and let '
            + 'whoever wants this more be the one who shows it. Do not close it yet.' },
        { at: 'band', band: 4, note: 'It is agreed here. State the terms plainly, in whose words '
            + 'they were settled, and what each side has now undertaken to do.' } ] },

    // ONE-ENDED AND THE SHORTEST IN THE LIBRARY, which is what it is for: three steps reads
    // as tense rather than trivial, and every step carries a directive.
    //   ROLLED ON FLAIR IT CHARGES POSITION, which is the whole reason it is not just a short
    //   negotiation -- getting what you want here costs the relationship, and the base wager
    //   says so without this shape having to.
    { id: 'st_ev_interrogation', name: 'Interrogation', scope: 'event', category: 'Encounters',
      min: 0, max: 3, start: 0, eventStakeId: 'stake_ev_interrogation',
      bands: [ { at: 0, label: 'They are giving nothing, and are comfortable giving nothing' },
               { at: 1, label: 'Something has landed. They are choosing their words now' },
               { at: 2, label: 'They are answering around it and the shape of what they are hiding is visible' },
               { at: 3, label: 'They give it up. Whatever they were holding is said out loud' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 1, note: 'Something got through. Show it in a pause, a correction, or '
            + 'an answer that is too complete. They do not admit anything.' },
        { at: 'band', band: 2, note: 'They are working to keep it back and it is visible. Let them '
            + 'offer something smaller in its place. Do not let them break yet.' },
        { at: 'band', band: 3, note: 'They give it up here. Have them say it in their own words, '
            + 'and show what saying it costs them.' } ] },

    // TWO-ENDED AND LONG, and this is the PACING demonstration: an encounter is not a combat
    // system, it is a thing the story returns to over several scenes.
    //   THE FLOOR IS TWO STEPS FROM START AND THE CEILING IS FOUR, which is the asymmetry the
    //   fiction wants -- it drifts upward under any competent attempt, and souring it takes a
    //   genuinely bad run rather than one clumsy line.
    //   DIRECTIVES ARE SPARSE, five of seven. A directive every other roll would make a slow
    //   burn into a status bar.
    { id: 'st_ev_courtship', name: 'Courtship', scope: 'event', category: 'Encounters',
      min: 0, max: 6, start: 2, eventStakeId: 'stake_ev_courtship',
      bands: [ { at: 0, label: 'It is closed. Whatever this might have been, one of them has answered it' },
               { at: 1, label: 'Something has gone wrong between them and neither is naming it' },
               { at: 2, label: 'They are circling one another with nothing settled' },
               { at: 3, label: 'Something has been noticed on both sides and neither has acknowledged it' },
               { at: 4, label: 'They are seeking each other out and the reasons have stopped being convincing' },
               { at: 5, label: 'Neither of them is pretending any more and neither has said it aloud' },
               { at: 6, label: 'It is answered. Whatever this was becoming, both of them now know what it is' } ],
      restBand: 2,
      terminal: [
        { at: 'band', band: 1, note: 'Something has cooled. Show it in what is not said \u2014 a '
            + 'shortened answer, an evening that ends early. Neither of them explains it.' },
        { at: 'band', band: 3, note: 'Something lands between them. Show it in a look held too '
            + 'long, a pause, or a sentence that comes out wrong. Neither of them names it.' },
        { at: 'band', band: 5, note: 'They are past deniability and both know it. Let the scene sit '
            + 'in that. Do not have either of them declare themselves yet.' },
        { at: 'band', band: 0, note: 'It closes here. One of them says or does the thing that ends '
            + 'it, and the other understands. Do not soften it into ambiguity.' },
        { at: 'band', band: 6, note: 'It resolves here. One of them says or does the thing and the '
            + 'other answers. Do not fade out of it and do not leave it ambiguous.' } ] },

    // THE COST METER, and the single most reusable variant in the library. The track measures
    // SUSPICION: it starts at rest, it climbs, and its ceiling is being caught. Nothing on it
    // is progress toward the job.
    //   THE AUTHOR CONCLUDES THIS ONE. Every other shape ends by reaching a bound; this one
    //   ends when the thing is stolen, and reaching the bound is the FAILURE. That needs no
    //   engine support -- Conclude was always the author's verb.
    //   ITS METER READS NEGATIVE, and derived rather than declared: the Strong row moves it
    //   nothing, so ceEventPolarity falls to the Miss row and inverts.
    { id: 'st_ev_infiltration', name: 'Infiltration', scope: 'event', category: 'Encounters',
      min: 0, max: 5, start: 0, eventStakeId: 'stake_ev_infiltration',
      bands: [ { at: 0, label: 'Nobody has any reason to be looking' },
               { at: 1, label: 'Something is slightly out of place and no one has decided it matters' },
               { at: 2, label: 'Someone is uneasy and has started paying attention' },
               { at: 3, label: 'Questions are being asked and the questions are getting closer' },
               { at: 4, label: 'They are being hunted. It is a question of where, not whether' },
               { at: 5, label: 'They are found. Whoever was looking has them' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 2, note: 'Someone has noticed. Put a person in the scene who is looking '
            + '\u2014 a guard doubling back, a servant who counts things \u2014 and do not let them find '
            + 'anything yet.' },
        { at: 'band', band: 4, note: 'The search is organised now. Doors, lamps, voices calling to '
            + 'one another. Close the ways out one at a time.' },
        { at: 'band', band: 5, note: 'They are caught here. Say who has them, how it happened, and '
            + 'what is being done about it. Do not allow a last-moment escape.' } ] },

    // ONE-ENDED, AND WITH NO OPPONENT AT ALL. This is the clearest statement of the whole
    // thesis: there is nobody here a temporary NPC record could even have described. Weather,
    // water, distance, a failing hull.
    //   NO FLOOR TERMINAL, like Negotiation -- a crossing is not lost, it is TURNED BACK FROM.
    //   ITS STRONG IS WORTH TWO. The crossing does not get tired, so decisiveness is the only
    //   thing that shortens it and hesitation the only thing that lengthens it.
    { id: 'st_ev_crossing', name: 'Crossing', scope: 'event', category: 'Encounters',
      min: 0, max: 5, start: 0, eventStakeId: 'stake_ev_crossing',
      bands: [ { at: 0, label: 'It is ahead of them and it has not started yet' },
               { at: 1, label: 'It has their full attention and nothing is going as planned' },
               { at: 2, label: 'It is worse than it was and there is no shelter to turn back to' },
               { at: 3, label: 'It has taken something that will not be replaced out here' },
               { at: 4, label: 'The far side is in sight and there is nothing left to spend reaching it' },
               { at: 5, label: 'They are through. Whatever it took, it is behind them' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 2, note: 'Conditions turn against them. Take something away \u2014 footing, '
            + 'light, a route, a piece of kit \u2014 and make going back no easier than going on.' },
        { at: 'band', band: 4, note: 'They are nearly through and running on nothing. Let the last '
            + 'of it be endurance rather than skill, and do not deliver them yet.' },
        { at: 'band', band: 5, note: 'They are through. Say what it cost to get here and what the '
            + 'far side looks like. There is nothing to defeat \u2014 it simply ends.' } ] },

    // ONE-ENDED, NEITHER SOCIAL NOR VIOLENT, and its bands are about THE THING BEING BUILT
    // rather than anyone in the room. Proof that "encounter" is not a euphemism for "fight".
    //   ITS FAILURE MODE LIVES ON THE ACTOR AND NOT ON THE TRACK, which is the two-table
    //   design paying off in full: rolled on Focus it charges Soul, and Soul's own terminal
    //   at zero stops a working this track knows nothing about. A floor terminal here would
    //   be a second, worse version of the same ending.
    { id: 'st_ev_ritual', name: 'Ritual', scope: 'event', category: 'Encounters',
      min: 0, max: 5, start: 0, eventStakeId: 'stake_ev_ritual',
      bands: [ { at: 0, label: 'It is prepared and nothing has been asked of it yet' },
               { at: 1, label: 'It has taken, and something in the room is answering' },
               { at: 2, label: 'It is running on its own momentum and stopping would cost more than continuing' },
               { at: 3, label: 'It is asking for more than was offered' },
               { at: 4, label: 'It is nearly whole and the last of it will not come cheaply' },
               { at: 5, label: 'It is done. The working holds, and whatever it was for is true now' } ],
      restBand: 0,
      terminal: [
        { at: 'band', band: 1, note: 'It catches. Show the room change \u2014 sound, temperature, the '
            + 'behaviour of light or of animals \u2014 rather than anyone announcing that it worked.' },
        { at: 'band', band: 3, note: 'It wants more than was brought. Name what it is asking for, '
            + 'concretely, and make refusing it as costly as paying.' },
        { at: 'band', band: 5, note: 'It completes here. State what is now true that was not true '
            + 'before, and what it took from whoever held it open.' } ] },

    // TWO-ENDED AND OFF-SCREEN. Nothing here happens in the room: the bands describe position,
    // access and who is being listened to, so a letter, a market or a conversation can advance
    // it.
    //   IT IS ABOUT SOMETHING. The contest is the track; what the contest is OVER is the
    //   faction's own Superiority, seeded below. Post-F-31 a stake CAN name that def, on
    //   either side of a Move -- which is the capability this shape was waiting on.
    { id: 'st_ev_faction', name: 'Faction conflict', scope: 'event', category: 'Encounters',
      min: 0, max: 6, start: 3, eventStakeId: 'stake_ev_faction',
      bands: [ { at: 0, label: 'Their side has lost the argument. What it held is held by someone else now' },
               { at: 1, label: 'They are being cut out \u2014 rooms they used to be in, decisions made without them' },
               { at: 2, label: 'The ground is going the other way and everyone with something to lose can see it' },
               { at: 3, label: 'Neither side has the advantage and both are still spending to get it' },
               { at: 4, label: 'The tide is with them. People who were waiting have stopped waiting' },
               { at: 5, label: 'The other side is conceding by inches and calling it something else' },
               { at: 6, label: 'It is settled in their favour. The other side is negotiating terms, not outcomes' } ],
      restBand: 3,
      terminal: [
        { at: 'band', band: 1, note: 'They are being shut out. Show it at a remove \u2014 an invitation '
            + 'that does not come, a name missing from a list, a door answered by somebody junior.' },
        { at: 'band', band: 5, note: 'The other side is giving way and dressing it as policy. Show a '
            + 'concession being made and named as something else. Do not settle it yet.' },
        { at: 'band', band: 0, note: 'They lose here. Name what has been taken, who holds it now, and '
            + 'what is left to them.' },
        { at: 'band', band: 6, note: 'They win here. Name what they now hold, who conceded it, and '
            + 'what the other side is still owed or still owes.' } ] },
    { id: 'st_currency', name: 'Currency', scope: 'protagonist', category: 'Resources', min: 0, max: 99, start: 10,
      bands: [], restBand: 0, attach: ['cost'] },
    // [F-17] NEVER FOCUS'S COST. Luck is spent deliberately; draining it on a failed roll
    // would make the one resource the player controls the one they cannot plan around.
    // The seeded Focus stake charges Stamina instead.
    { id: 'st_luck', name: 'Luck', scope: 'protagonist', category: 'Resources', min: 0, max: 5, start: 2,
      bands: [], restBand: 0, attach: ['spendForBonus'] },

    // [F-11][D-32] THE FOUR F's. Approaches, not skills: the player says HOW, and four cover
    // attacking, diving, seducing and bribing with no action existing for any of them.
    // UNBANDED ON PURPOSE -- D-21 makes them silent, because a model told "Force 3" imitates
    // the number. These are for the roll.
    { id: 'st_force', name: 'Force', scope: 'char', category: 'Approaches', min: 0, max: 5, start: 1,
      bands: [], restBand: 0, attach: ['modifier'] },
    { id: 'st_focus', name: 'Focus', scope: 'char', category: 'Approaches', min: 0, max: 5, start: 1,
      bands: [], restBand: 0, attach: ['modifier'] },
    { id: 'st_finesse', name: 'Finesse', scope: 'char', category: 'Approaches', min: 0, max: 5, start: 1,
      bands: [], restBand: 0, attach: ['modifier'] },
    { id: 'st_flair', name: 'Flair', scope: 'char', category: 'Approaches', min: 0, max: 5, start: 1,
      bands: [], restBand: 0, attach: ['modifier'] },

    // [F-09b] THE CONDITIONS CAME BACK AS SEEDS. F-09 collapsed cfg.conditions into this
    // catalog and migrated every EXISTING story's rows, but seeded none -- so a story
    // written after F-09 got Vitals, Resources and Approaches and no example of the third
    // thing a state can be. That is the gap: nothing here demonstrated the SHAPE a condition
    // takes, and the shape is not obvious from Health. These three are ordinary rows an
    // author may edit or delete, and they are also the reference for writing a fourth.
    //
    // THE SHAPE, and every part of it is load-bearing:
    //   start 0 / restBand 0 / an EMPTY BAND AT 0   -- absence is a value here, and D-22
    //     suppression is what gives back exactly what presence-in-an-array used to encode.
    //     A character who is not ill costs nothing and says nothing.
    //   `line` OVERRIDES DEFAULT_STATE_LINE, and must. The default assumes a band label that
    //     is a predicate fragment ('is dying'); a condition's stages are SENTENCES, so the
    //     def name carries the naming clause and the band carries the description. This is
    //     the same template F-09's migration writes, byte for byte, so a migrated story and
    //     a fresh one read identically.
    //   hideAtStart -- G-02, and this is the case it was written for. Three more rows on
    //     every profile that nobody has a condition on is exactly the clutter that made the
    //     flag necessary; at start they are absent from the surface and present in the model.
    //   category 'Conditions' -- F-11b. Matches the migration's category so the two paths
    //     group together. It sorts last by first appearance, which is where it belongs.
    // NO TERMINAL ON ANY OF THEM, deliberately. Health's terminal kills a character and
    // every move that can reduce Health inherits it; an illness that killed at max would
    // inherit the same way, from a value an author moves BY HAND with no roll in sight. A
    // story that wants a fatal illness declares it; a seed must not.
    { id: 'st_intoxicated', name: 'Intoxicated', scope: 'char', category: 'Conditions',
      min: 0, max: 3, start: 0, restBand: 0, hideAtStart: true,
      line: '[|name| is currently |defName|.][ |bandLabel|]',
      bands: [ { at: 0, label: '' },
               { at: 1, label: 'Loose and warm with it, talking more than usual, guard down.' },
               { at: 2, label: 'Clumsy and loud, saying things that will be remembered by everyone but them.' },
               { at: 3, label: 'Barely upright, slurring, and losing the thread of what is happening around them.' } ] },
    { id: 'st_ill', name: 'Ill', scope: 'char', category: 'Conditions',
      min: 0, max: 3, start: 0, restBand: 0, hideAtStart: true,
      line: '[|name| is currently |defName|.][ |bandLabel|]',
      bands: [ { at: 0, label: '' },
               { at: 1, label: 'Off-colour and working through it \u2014 headache, no appetite, tiring early.' },
               { at: 2, label: 'Visibly unwell. Feverish and aching, and no use for anything that asks much.' },
               { at: 3, label: 'Bedbound and getting worse. Should not be moved far and cannot be relied on at all.' } ] },
    { id: 'st_pregnant', name: 'Pregnant', scope: 'char', category: 'Conditions',
      min: 0, max: 3, start: 0, restBand: 0, hideAtStart: true,
      line: '[|name| is currently |defName|.][ |bandLabel|]',
      bands: [ { at: 0, label: '' },
               { at: 1, label: 'Early, and not showing. Tired in the afternoons and sick in the mornings.' },
               { at: 2, label: 'Showing now, and past hiding it from anyone paying attention. Slower, hungrier, warmer.' },
               { at: 3, label: 'Near term. Uncomfortable, easily winded, and unwilling to be far from where they mean to be.' } ] },

    // [F-31] WHAT A FACTION HOLDS, as against a character's standing WITH one -- the
    // distinction CE_STATE_SCOPES' own hint draws, and the first seeded row on that side of
    // it. Seeded because Faction conflict needs something to be about: the encounter track is
    // the contest and this is the position the contest is over.
    //   IT IS A REAL ADDRESS NOW. Before F-31 _ceStakeRef refused faction on both sides, so a
    //   stake naming this would have been F-20's knob with nothing behind it. A Move can aim
    //   at a faction directly, and a Move aimed at a person reaches their faction through
    //   ceCharFactionId, so both cells resolve.
    //   NO TERMINAL, AND THAT IS NOT AN OVERSIGHT. Faction scope returns from inside its own
    //   write chain and has never fired one; a terminal here would be a directive that
    //   silently never arrives. The asymmetry with 'event' is documented at stateSet.
    //   DEFAULT_STATE_LINE FITS AS IT STANDS -- the labels are predicate fragments, so it
    //   renders "The Iron Circle is ascendant."
    { id: 'st_fac_superiority', name: 'Superiority', scope: 'faction', category: 'Factions',
      min: 0, max: 4, start: 2, restBand: 2,
      bands: [ { at: 0, label: 'is finished as a power \u2014 what it held is held by others now' },
               { at: 1, label: 'is losing ground, and everyone who deals with it knows' },
               { at: 2, label: 'holds what it holds and is neither gaining nor losing' },
               { at: 3, label: 'is gaining, and the people who matter have noticed' },
               { at: 4, label: 'is ascendant \u2014 nothing within reach opposes it openly' } ] }
];

// [F-12][D-25] 2d6 fail-forward. An ordinary row: swapping `sides` to 20 and rewriting three
// bands makes it a d20 game without touching code.
// THE BOTTOM BAND'S `at` IS DELIBERATELY UNREACHABLE-LOW. Modifiers can be negative, so a
// floor of 2 would leave a -1 total matching no band. ceRollBand treats the first band as
// the floor regardless; this just stops the table misleading whoever reads it.
var DEFAULT_RESOLUTION_DEFS: ResolutionDef[] = [
    { id: 'res_2d6', name: '2d6 fail-forward', count: 2, sides: 6, bands: [
        { at: -999, label: 'Miss',
          note: 'The attempt fails and the situation gets worse. Name the new problem; do not '
              + 'simply restate the failure.' },
        { at: 7, label: 'Partial',
          note: 'The attempt succeeds, but at a cost. Grant what was wanted and name the price '
              + 'in the same breath.' },
        { at: 10, label: 'Strong',
          note: 'The attempt succeeds cleanly. Give it to them without a hidden catch.' }
    ] }
];

// [I-04] MIGRATION-ONLY, NO OTHER READER. The seeded no-roll resolution is gone (a
// resolution that cannot fail is not one). These two literals describe the row exactly as it
// shipped in 3.0.65-3.1.12 so the v7 pass can tell an untouched seed from an authored table.
// Zero dice survives as an AUTHORING choice -- ceRollDice's floor is still 0.
var CE_NOROLL_SEED_ID = 'res_certain';
var CE_NOROLL_LEGACY_NOTE = 'This happens as described. Do not introduce a complication or a reason it fails.';

// [F-14] THE SEEDED WAGERS, one per approach family, as ORDINARY EDITABLE ROWS rather than
// behaviour compiled in. [I-02] NAMED FOR THE STATE THEY MOVE, not for a mood, so
// "Default \u2014 Health" on the Approach line is read rather than decoded. Ids are unchanged;
// nothing keys off a display name.
// EVERY ROW IS DELIBERATELY SMALL. Fail-forward makes the FICTION name the cost, so a ledger
// moving in tens would contradict the prose beside it. One point is felt over a session.
// THE SHAPE READS DOWN THE TABLE: a Miss costs the actor, a Partial both, a Strong the
// target. Nothing is conserved between the sides and nothing should be -- see StakeCell.
function _ceStakeRow(aDef: string, aAmt: number, tDef: string, tAmt: number): StakeRow {
    return { actor: { defId: aDef, amount: aAmt }, target: { defId: tDef, amount: tAmt } };
}
var DEFAULT_STAKE_DEFS: StakeDef[] = [
    { id: 'stake_health', name: 'Health', resolutionId: 'res_2d6',
      defaultForApproach: ['st_force'],
      rows: [ _ceStakeRow('st_health', -1, '', 0),
              _ceStakeRow('st_health', -1, 'st_health', -1),
              _ceStakeRow('', 0, 'st_health', -1) ] },
    // [F-17] FINESSE SPENDS STAMINA AND FOCUS SPENDS SOUL. The approach that FEEDS a roll
    // and the state that PAYS for it are different by design -- but until st_soul existed
    // these two approaches paid the same row, which made them indistinguishable at the till
    // no matter how differently they read on the page.
    { id: 'stake_stamina', name: 'Stamina', resolutionId: 'res_2d6',
      defaultForApproach: ['st_finesse'],
      rows: [ _ceStakeRow('st_stamina', -1, '', 0),
              _ceStakeRow('st_stamina', -1, '', 0),
              _ceStakeRow('', 0, '', 0) ] },
    // [I-02] NAMED FOR THE STATE IT MOVES, like every row here. Same shape as Stamina's --
    // a Miss and a Partial both cost, a Strong is clean -- so the two approaches are told
    // apart by WHAT they spend rather than by how much.
    { id: 'stake_soul', name: 'Soul', resolutionId: 'res_2d6',
      defaultForApproach: ['st_focus'],
      rows: [ _ceStakeRow('st_soul', -1, '', 0),
              _ceStakeRow('st_soul', -1, '', 0),
              _ceStakeRow('', 0, '', 0) ] },

    // [F-17] FLAIR'S STAKE IS THE RELATIONSHIP. NEGATIVE IS WARMTH -- _ceApplyPressure
    // decrements on 'advanced' -- so a Strong eases the Position a tier and a Miss strains
    // it. Pressure is the only relationship track that already grades, already injects and
    // already has two ends: both cells name it, it fires once, there is no per-side copy.
    { id: 'stake_position', name: 'Position', resolutionId: 'res_2d6',
      defaultForApproach: ['st_flair'],
      rows: [ { actor: { kind: 'pressure', defId: '', amount: 1 },  target: { defId: '', amount: 0 } },
              { actor: { defId: '', amount: 0 },                    target: { defId: '', amount: 0 } },
              { actor: { kind: 'pressure', defId: '', amount: -1 }, target: { defId: '', amount: 0 } } ] },

    // Kept, not automatic: buying is a no-roll move, not an outcome of charm.
    { id: 'stake_currency', name: 'Currency', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_currency', -1, '', 0),
              _ceStakeRow('st_currency', -1, '', 0),
              _ceStakeRow('', 0, '', 0) ] },

    // [EVENT] THE ENCOUNTER WAGERS, one per seeded shape.
    //   THE TRACK GOES IN THE ACTOR CELL AND THE TARGET CELL STAYS EMPTY, and that is a rule
    //   rather than a habit: an event ref is SIDE-INDEPENDENT (_ceStakeRef), so a row naming
    //   the track from both sides charges it twice for one roll. What the attempt cost the
    //   ACTOR is the base wager's job.
    //   NONE OF THESE IS A defaultForApproach. They are addressed by StateDef.eventStakeId
    //   and nowhere else, and an approach defaulting to one would move a fight nobody started.
    //   ceStakeIsEvent RECOGNISES THEM and keeps them out of the BASE wager select, where
    //   choosing one would charge the track a second time on top of the always-on encounter
    //   wager. Settings > Rolls still lists and edits them.
    //   FOUR PATTERNS ACROSS TEN TABLES, and the repetition is honest: the span and the prose
    //   are what make a courtship read differently from a chase, not the arithmetic.
    { id: 'stake_ev_melee', name: 'Melee (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('', 0, '', 0),
              _ceStakeRow('st_ev_melee', 1, '', 0),
              _ceStakeRow('st_ev_melee', 1, '', 0) ] },
    { id: 'stake_ev_battle', name: 'Battle (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_battle', -1, '', 0),
              _ceStakeRow('st_ev_battle', 1, '', 0),
              _ceStakeRow('st_ev_battle', 1, '', 0) ] },
    { id: 'stake_ev_chase', name: 'Chase (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_chase', -1, '', 0),
              _ceStakeRow('st_ev_chase', 1, '', 0),
              _ceStakeRow('st_ev_chase', 1, '', 0) ] },
    { id: 'stake_ev_negotiation', name: 'Negotiation (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_negotiation', -1, '', 0),
              _ceStakeRow('st_ev_negotiation', 1, '', 0),
              _ceStakeRow('st_ev_negotiation', 1, '', 0) ] },
    { id: 'stake_ev_interrogation', name: 'Interrogation (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_interrogation', -1, '', 0),
              _ceStakeRow('st_ev_interrogation', 1, '', 0),
              _ceStakeRow('st_ev_interrogation', 1, '', 0) ] },
    { id: 'stake_ev_courtship', name: 'Courtship (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_courtship', -1, '', 0),
              _ceStakeRow('st_ev_courtship', 1, '', 0),
              _ceStakeRow('st_ev_courtship', 1, '', 0) ] },
    // POSITIVE THROUGHOUT, because the track is a COST. A Strong is the only result that buys
    // nothing: there is no becoming less suspected by rolling well.
    { id: 'stake_ev_infiltration', name: 'Infiltration (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_infiltration', 2, '', 0),
              _ceStakeRow('st_ev_infiltration', 1, '', 0),
              _ceStakeRow('', 0, '', 0) ] },
    { id: 'stake_ev_crossing', name: 'Crossing (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_crossing', -1, '', 0),
              _ceStakeRow('st_ev_crossing', 1, '', 0),
              _ceStakeRow('st_ev_crossing', 2, '', 0) ] },
    { id: 'stake_ev_ritual', name: 'Ritual (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_ritual', -1, '', 0),
              _ceStakeRow('st_ev_ritual', 1, '', 0),
              _ceStakeRow('st_ev_ritual', 2, '', 0) ] },
    { id: 'stake_ev_faction', name: 'Faction conflict (encounter)', resolutionId: 'res_2d6',
      defaultForApproach: [],
      rows: [ _ceStakeRow('st_ev_faction', -1, '', 0),
              _ceStakeRow('st_ev_faction', 1, '', 0),
              _ceStakeRow('st_ev_faction', 1, '', 0) ] }
];

// [F-14p] Editor stand-in for kind:'pressure' in a list otherwise made of StateDef ids.
// NOT STOREABLE -- translated to kind/defId on commit, and spelled so no generateId output
// can collide with it.
var CE_STAKE_CELL_PRESSURE = '__position__';
// [T-20] Same mechanism for the clock, which is one integer in historyStorage rather than a
// StateDef. AMOUNT IS MINUTES, not band steps.
var CE_STAKE_CELL_TIME = '__time__';

// [F-14] "Follow the approach's default." A SENTINEL, NOT AN ABSENT FIELD: choosing
// "nothing on the line" ('') must be a different stored state from never having chosen.
// Compared literally in ceStakeForMove, written literally by the composer -- change both.
var CE_STAKE_AUTO = '__auto__';

// [F-20] THE MOST POINTS ONE ROLL MAY BUY. Rate is fixed 1:1 -- against bands at 7 and 10,
// two is enough to turn a near miss and never enough to buy an outcome. A per-def rate was
// dropped as a knob with no door. A 0-99 def marked spendForBonus buys at 1:1 too.
var CE_SPEND_MAX = 2;

// [F-11][F-29] ORDER ONLY, NOT THE MEMBERSHIP TEST. ceStateApproaches reads attach:'modifier'
// for membership and this list only to keep the seeded four at the head. Separate from the
// seeds so a deleted or renamed def degrades rather than breaks.
var CE_APPROACH_IDS: string[] = ['st_force', 'st_focus', 'st_finesse', 'st_flair'];

// [SEC:STATE] The scope vocabulary, in picker order. ONE TABLE so the picker, the drill
// filter and the storage router cannot disagree about what scopes exist.
var CE_STATE_SCOPES: any[] = [
    { id: 'char',        label: 'Character',   hint: 'Every character has one.' },
    { id: 'protagonist', label: 'Protagonist', hint: 'Only the protagonist has one.' },
    { id: 'npc',         label: 'Everyone else', hint: 'Every character except the protagonist has one.' },
    { id: 'world',       label: 'World',       hint: 'One value for the whole story.' },
    { id: 'faction',     label: 'Faction',     hint: 'Each faction has one \u2014 its own, not a character\u2019s standing with it.' },
    // [EVENT] THE SHAPE OF AN ENCOUNTER. Authoring one is authoring a state, which is the
    // whole reason the scope exists rather than a separate shape record: the bounds are the
    // encounter's length, the bands are how it reads at each step, and the per-band
    // directives are what the model is told when it moves. One 'Melee' serves every brawl.
    { id: 'event',       label: 'Encounter',   hint: 'A shape for encounters \u2014 its span is how long one lasts and its bands are how it reads. Started from the Actions panel; it belongs to no character.' }
];

var DEFAULT_GENERAL_STYLE = 'Use punchy, direct, and efficient narrative language. Focus on actionable character details. Omit flowery adjectives. Write as a concise psychological dossier.';

// MIGRATION-ONLY, BYTE-EXACT. Every OLD_* string below is a past DEFAULT; migrateConfig
// upgrades a config still carrying one exactly and leaves a hand-authored string alone.
// Never edit one to "fix" it -- an edited literal stops matching and the migration silently
// stops firing.
var OLD_CRITICAL_HOOK_V1 = "[|name|: |hookDescription|]";
// [SCENEBLOCK] Prior scene-block defaults, byte-exact, upgraded in place by migrateConfig.
var OLD_TIME_V35 = "[It is |band|.]";
var OLD_PLACE_V35 = "[|protagonist| is in |locationName|.][ |atmosphere|]";
var OLD_PRESENT_V35 = "[Present: |presentNames|.]";
var OLD_NPC_TEMPLATE_V28 = "[|name|][ — |relArchetype|, |relStage|][ with |primaryRelationship.targetName|][ (|conditionStates|)][. Goal: |midRange.currentDesire|][. Thinking: |ephemeral.compressedLine|]";

var OLD_NPC_TEMPLATE_V82 = "[|name|][. Thinking: |ephemeral.compressedLine|]";
// parseMacroTemplate turns a literal backslash-n inside a bracket block into a real
// newline. Any second line must RE-STATE THE NAME: the AN is a flat list, so an
// unattributed line 2 reads as belonging to the next character.
var OLD_NPC_TEMPLATE_V86 = "[|name|][ \u2014 thinking: |reactionLine|][ \u2014 |intentLine|]";
// ONE LINE PER CHARACTER. Tried per-clause lines: with 2-3 present it becomes 4-6 stacked
// one-clause lines and that block structure competes with the prose the model should write.
// The separation that mattered is sentence-level -- see _ceFrameIntent.
var OLD_NPC_TEMPLATE_V87 = "[|name|][ — thinking: |reactionLine|][\\n|name| |intentLine|]";

// [EPHEMERAL-REWIRE] Two independently-suppressing clauses. reactionLine is the interior
// read; intentLine is the same desire framed by pursuit tier (_ceFrameIntent) as an
// UNLABELLED declarative -- labelling it "Thinking" a second time makes it read as more
// interior decoration instead of near-future fact. eventAnchor is deliberately absent: it
// is generation-time scaffolding and the story text above already shows the beat.
var DEFAULT_TEMPLATES: ContextTemplates = {
    npc: "[|name|][ — thinking: |reactionLine|][ |intentLine|]",
    criticalHook: "[|name|: |hookDescription|][ |hookPressure|]",
    npcWeb: "[|nameA| & |nameB| — |dynamic|]",
    // [POSITION] One character's private reading of another, emitted only when
    // both are scene-present. |positionPressure| is the tier-graded clause from
    // _ceFramePosition and is EMPTY at tiers -1..1, so a Position with nothing moving
    // renders as just shape + standing and the bracket self-suppresses.
    position: "[|name| on |targetName| — |shape|.][ |standing|][ |positionPressure|]",
    // [D-08] |protagonist| falls back to 'The scene' so the location still lands in a story
    // with none.
    // [ATMO] |locationDescription| IS RETIRED AND IS NO LONGER PASSED. A template naming it
    // self-suppresses its bracket, so migrateConfig swaps the token in place rather than
    // leaving an author's customised line to quietly stop rendering. |atmosphere| is what
    // replaced it and already falls back to the description -- see ceAtmoFor. One macro,
    // because two would put the same sentence in context twice on every story that has both.
    // [SCENEBLOCK] TIME AND PLACE ARE ADJACENT LINES OF ONE PART, joined by a single '\n'
    // inside the an.place row so no blank line sits between them. |band| self-suppresses its
    // own bracket, so a story with the clock off drops the time line and keeps the place.
    place: "[It is |band|.\n][|protagonist| is in |locationName|.][ |atmosphere|]",
    // [SCENEBLOCK] NO 'Present:' LABEL -- an out-of-narrative header steers the model's own
    // prose toward headed prose. The present block is now a PARAGRAPH built by
    // _ceScenePresentPara: a lead sentence per scene-present character who has a schedule
    // note, then the rest joined as "X, Y and Z are present." This template is the FALLBACK
    // JOIN an author with no schedule notes still gets; |presentTail| is the joined-names
    // sentence and |scheduleLead| the composed leads (empty when nobody has a note).
    present: "[|scheduleLead|][ |presentTail|]",
    // [T-06] RETIRED AS A STANDALONE ROW. The time line now leads the an.place part (see
    // `place` above), so a separate an.time row would emit it a second time. Kept in the
    // shape as a self-suppressing empty so a saved custom template naming |time| is a no-op
    // rather than a broken macro; migrateConfig blanks the old default in place.
    time: ""
};

// [CONDITIONS] Each bracket is its own block so a missing macro suppresses its clause
// rather than emitting a broken fragment.
var DEFAULT_LOREBOOK_TEMPLATES: LorebookTemplates = {
    equipment:     "[|name| is wearing/carrying |equipList|.]",
    // DEAD MACRO FAMILIES: |midRange.*|, |primaryRelationship.*|, |relArchetype|,
    // |relStage| resolve to nothing. A saved custom template naming one self-suppresses.
    // Position's own template is an AN template (DEFAULT_TEMPLATES.position), not one of these.
    journal:       "[|name|'s own notes: |journalBody|]",
    // [T-10] WHAT THEIR SCHEDULE SAYS THEY ARE DOING. A ONE-PARTY FACT, so unlike Position
    // it folds into the owner's OWN entry with no both-parties gate and no WEB-FLATTEN
    // exposure -- it is the same shape as equipment, which is why it sits beside it.
    activity:      "[|name| is |activity|.]"
};

// [LOREFOLD] Default include state: everything on. Toggled in World Settings.
var DEFAULT_LOREBOOK_FIELDS: LorebookFieldToggles = {
    equipment: true, conditions: true, journal: true, activity: true, position: true
};

var DEFAULT_CTX  = 4;   // default context size (story paragraphs) for image prompt architect

var DEFAULT_ARCH = "You are an expert cinematic director translating a narrative scene into a precise image generation prompt for a hybrid text-to-image AI.\n\nAnalyze the provided scene and character data, then output a prompt following this exact structure:\n\n1. CORE TAGS: Start with 10-15 comma-separated Danbooru tags establishing the baseline. Include subject counts (e.g., 1girl, 1boy), rating (e.g., rating: general), camera angles (e.g., dutch angle, from below), lighting (e.g., cinematic lighting, sunbeams), and environment traits.\n2. ACTION & ATMOSPHERE: Follow immediately with 1 to 2 vivid sentences of natural language describing exactly what the characters are doing, their expressions, the mood, and the background details.\n3. CHARACTER INTEGRATION: You MUST seamlessly integrate the specific visual traits of any identified characters into the tags or the prose.\n\nOutput ONLY the final prompt text. Do not include headers, bullet points, introductory text, or commentary.";

var DEFAULT_NOTE = "[System Note: This chat interface supports image attachments. When your character wants to send a selfie, share a picture of their surroundings, or show the user an object, append an image attachment to your message on a new line using this exact format: > [Image: comma-separated visual tags]\nThe tags must be concise visual descriptors (character name, clothing, pose, expression, setting, and lighting). Always include the character's name so their specific appearance is applied.\nExample message:\nI finally made it to the cafe! It's so cute here, wish you were with me.\n[Image: Sarah, smiling, holding a coffee cup, sitting at a cafe table, wearing a cozy oversized sweater, sunlit window background] ]";

// ── Static Field Definitions ──────────────────────────────────────────────────
// The four core character narrative fields, read by the editor and the generator.

var STATIC_FIELD_DEFS = [
    {
        id: 'physicalDescription', key: 'physicalDescription',
        label: 'Physical Description', injectionHeader: 'Appearance',
        placeholder: 'Physical anatomy, skin, hair, eyes, and build...',
        defaultInstructions: 'Describe the physical body exactly as a camera would capture it, moving from their overall silhouette to specific details. Explicitly state their body type, physique, curves or musculature, skin tone, hair, and eye color. Lean into sensual, striking, or inhuman/monstrous anatomical details if applicable. Capture their physical essence organically; do not just list traits. DO NOT describe clothing, outfits, or armor. DO NOT describe mannerisms or movement. Avoid cliché features like facial scars unless explicitly present in the context.',
        defaultBudget: 100
    },
    {
        id: 'personalityCore', key: 'personalityCore',
        label: 'Personality Core', injectionHeader: 'Personality',
        placeholder: 'Fundamental nature and contradictions...',
        defaultInstructions: 'Define their fundamental psychological baseline and static disposition. Follow this with a core contradiction or hidden facet that gives them dimensional depth (e.g., outwardly cynical but secretly romantic, or pragmatic but fiercely loyal). Do not force a tragic backstory or trauma. Focus on *how* their mind works and their default state of being, not their fleeting goals or current mood. Be tight and declarative.',
        defaultBudget: 100
    },
    {
        id: 'voiceAndMannerisms', key: 'voiceAndMannerisms',
        label: 'Voice & Mannerisms', injectionHeader: 'Voice',
        placeholder: 'Vocal timbre and physical habits...',
        defaultInstructions: 'Describe the physical and auditory qualities of how they communicate. Name their vocal timbre, speech rhythm, and any distinct accent. Follow with one or two signature physical mannerisms or unconscious gestures that reveal their nature (e.g., how they hold their gaze, a sensual habit, or an inhuman tic). Describe the pattern and presence of their communication, not specific vocabulary.',
        defaultBudget: 75
    },
    {
        id: 'background', key: 'background',
        label: 'Background', injectionHeader: 'Background',
        placeholder: 'Formative history...',
        defaultInstructions: 'State one or two formative past events that firmly established who they are today. Focus on what shaped their current worldview or brought them to their current station. Keep it in the past tense with no flourish. Omit broad life summaries in favor of specific, defining turning points.',
        defaultBudget: 100
    }
];

// ── Location facets  [LOC-PROFILE] ───────────────────────────────────────────
// THE CHARACTER MODEL, APPLIED TO PLACES: same CustomFieldDef shape, same
// customFieldValues storage, same generator, same slot-grouping helper.
//
// THE QUESTION IS NOT "what does this place look like" -- a described place is set dressing
// the model ignores. It is WHAT DOES THIS PLACE DO TO A SCENE THAT HAPPENS IN IT? The six
// slot:'any' lenses answer that and are offered at every scale. The rest are scale-flavoured
// and NOT a different kind of field: `scope` is a DISPLAY FILTER DEFAULT and touches no
// record, because a place is often several scales at once and forcing a choice gets the
// interesting cases wrong.
//
// EVERY FACET IS SPARSE. Empty renders nothing and compiles nothing.
//
// WRITING A NEW ONE: the instruction names the job and the length, refuses the two or three
// universal failure modes, and then leans on the author's steer -- the subject may be a
// broom cupboard or a dying empire, so a tight character-slot instruction is wrong here.
// [LOC-PROFILE4] `hint` IS THE QUESTION AND IS NOT OPTIONAL. "Constrains" names an idea, not
// a question, and a label naming an unfamiliar idea is a field the author skips. It renders
// under the label always. Character fields carry none.
const LOCATION_FACETS: { id: string; slot: string; kind: string; scope: string; label: string; hint: string; placeholder: string; instructions: string; budget: number }[] = [
    // ── The six lenses. ONE GROUP, ALL SLOTS, ALWAYS PRESENT. ──
    // NOT six one-field groups: _ceSlotCard suppresses a heading whose label equals its only
    // field's, and with no heading there is no bar for the guidance '?' to sit in.
    { id: 'ce_loc_constrains', slot: 'any', kind: 'slot', scope: 'any', label: 'Constrains', budget: 90, hint: 'What can\u2019t you do here?',
      placeholder: 'What cannot be done here\u2026',
      instructions: 'Name one to three concrete limits this place imposes on people in it. Physical or social: cramped, overlooked, silent, sealed, no way out but the one you came in by, nobody speaks first here. Under 50 words. State what CANNOT be done, not how the place feels \u2014 mood belongs elsewhere. Follow the author\u2019s steer above closely; it outranks any assumption about genre or scale. Avoid listing hazards as adjectives and avoid limits that are true of every place of this kind.' },
    { id: 'ce_loc_costs', slot: 'any', kind: 'slot', scope: 'any', label: 'Costs', budget: 90, hint: 'What does being here take out of you?',
      placeholder: 'What being here takes out of you\u2026',
      instructions: 'State what being here costs: what it takes from someone over time, or what it risks. Cold, exposure, being seen, being owed, money, standing, sanity, air. One to two sentences, under 45 words. It must be a reason to eventually leave. Follow the author\u2019s steer above closely. Avoid pure danger-adjectives and avoid costs nobody in the story would actually pay attention to.' },
    { id: 'ce_loc_offers', slot: 'any', kind: 'slot', scope: 'any', label: 'Offers', budget: 100, hint: 'What is available here \u2014 and to whom?',
      placeholder: 'What is available here \u2014 tools, cover, exits, people\u2026',
      instructions: 'List what this place makes available to someone in it: tools, cover, information, transport, exits, people worth talking to. Under 55 words. Concrete nouns rather than qualities \u2014 things a character could reach for in a scene. Follow the author\u2019s steer above closely. Avoid inventing a named person or faction unless the steer or notes give you one, and avoid anything that would be true of any building.' },
    { id: 'ce_loc_control', slot: 'any', kind: 'slot', scope: 'any', label: 'Control', budget: 100, hint: 'Whose place is this, and who is allowed in it?',
      placeholder: 'Whose it is, and who is allowed here\u2026',
      instructions: 'State who holds this place and on what terms: who owns or runs it, who is welcome, who is tolerated, who is turned away, and what happens to someone who should not be here. One to three sentences, under 55 words. Follow the author\u2019s steer above closely. Avoid inventing a named ruler, faction or organisation unless the steer or notes give you one \u2014 an unnamed \u201cthe family that has run it four generations\u201d is better than a fabricated proper noun.' },
    { id: 'ce_loc_memory', slot: 'any', kind: 'slot', scope: 'any', label: 'Memory', budget: 100, hint: 'What happened here, and what is it known for?',
      placeholder: 'What happened here, and what it is known for\u2026',
      instructions: 'State what this place is known for and what happened here \u2014 one specific past event or standing reputation, and how people speak about it now. One to three sentences, under 55 words. Follow the author\u2019s steer above closely. Avoid prophecy, ancient evil, and any calamity the story has not established; a rumour, a grudge or an ordinary disgrace is usually the stronger answer.' },
    { id: 'ce_loc_signature', slot: 'any', kind: 'slot', scope: 'any', label: 'Signature', budget: 90, hint: 'What does it look, sound and smell like?',
      placeholder: 'What it looks, sounds and smells like\u2026',
      instructions: 'Give the sensory read of this place: what is seen, heard, smelled and felt on the skin the moment someone is in it. Two to three sentences, under 55 words. Specific to THIS place \u2014 a detail that would be wrong for any other of its kind. Follow the author\u2019s steer above closely. Avoid opening with \u201cnestled\u201d or \u201csteeped in\u201d, and avoid describing anyone arriving.' },

    // ── Region. ──
    { id: 'ce_loc_climate', slot: 'region', kind: 'facet', scope: 'region', label: 'Climate & seasons', budget: 90, hint: 'What does the weather and the year do here?',
      placeholder: 'Weather, seasons, what the year does here\u2026',
      instructions: 'Describe the weather and the shape of the year here, and what people do about it. Under 50 words. Concrete and consequential \u2014 what it forces, not a forecast. Follow the author\u2019s steer above closely. Avoid a bare list of seasons and avoid weather that has no effect on anybody.' },
    { id: 'ce_loc_terrain', slot: 'region', kind: 'facet', scope: 'region', label: 'Terrain', budget: 90, hint: 'What is the land like, and what does it make hard?',
      placeholder: 'The land itself \u2014 and what it makes hard\u2026',
      instructions: 'Describe the land and what it does to movement, sight and settlement. Under 50 words. Follow the author\u2019s steer above closely. Avoid a travelogue; say what the ground makes hard, and what it hides.' },
    { id: 'ce_loc_hazards', slot: 'region', kind: 'facet', scope: 'region', label: 'Hazards & wildlife', budget: 80, hint: 'What is dangerous here, and how do people live with it?',
      placeholder: 'What lives here, what kills here\u2026',
      instructions: 'Name what is dangerous here and how people account for it. Under 45 words. Follow the author\u2019s steer above closely. Avoid a bestiary and avoid making everything lethal \u2014 the interesting hazard is the one people have learned to live beside.' },

    // ── Settlement. ──
    { id: 'ce_loc_people', slot: 'settlement', kind: 'facet', scope: 'settlement', label: 'Who lives here', budget: 90, hint: 'Who lives here?',
      placeholder: 'Population, kinds of people, how they carry themselves\u2026',
      instructions: 'Describe who lives here \u2014 numbers if they matter, and more importantly what kind of people, how they carry themselves, and what a stranger notices about them. Under 50 words. Follow the author\u2019s steer above closely. Avoid census figures with no consequence and avoid a single monolithic culture unless the steer says so.' },
    { id: 'ce_loc_power', slot: 'settlement', kind: 'facet', scope: 'settlement', label: 'Power & law', budget: 100, hint: 'Who decides, who enforces, and what are the rules?',
      placeholder: 'Who decides, who enforces, what the rules are\u2026',
      instructions: 'State how this place is governed and policed: who decides, who enforces, what the enforced rules actually are, and where the real power sits if it is not where the formal power sits. Under 55 words. Follow the author\u2019s steer above closely. Avoid inventing named institutions unless the steer or notes give you one.' },
    { id: 'ce_loc_economy', slot: 'settlement', kind: 'facet', scope: 'settlement', label: 'Trade & work', budget: 90, hint: 'What does this place live on?',
      placeholder: 'What is made, sold, smuggled, owed\u2026',
      instructions: 'State what this place lives on: what is made, grown, sold, smuggled or extracted, what it needs from outside, and who profits. Under 50 words. Follow the author\u2019s steer above closely. Avoid generic \u201cbustling market\u201d framing; name the actual goods.' },

    // ── Structure. ──
    { id: 'ce_loc_build', slot: 'structure', kind: 'facet', scope: 'structure', label: 'Construction & age', budget: 90, hint: 'What is it made of, how old, what state is it in?',
      placeholder: 'What it is made of, how old, what state it is in\u2026',
      instructions: 'Describe what this structure is built from, roughly how old it is, and what condition it is in \u2014 including what has been repaired, added or left to rot. Under 50 words. Follow the author\u2019s steer above closely. Avoid architectural vocabulary for its own sake; the useful details are the ones a person would touch or trip on.' },
    { id: 'ce_loc_approach', slot: 'structure', kind: 'facet', scope: 'structure', label: 'Approach & defences', budget: 90, hint: 'How do you get in, and what stops you?',
      placeholder: 'How you get in, what stops you\u2026',
      instructions: 'State how someone gets in and what stands in the way: doors, gates, watch, locks, sightlines, the way round the back that everybody knows about. Under 50 words. Follow the author\u2019s steer above closely. Avoid a floor plan; give the two or three facts that matter to someone trying to enter or leave unseen.' },

    // ── Interior. ──
    { id: 'ce_loc_contents', slot: 'interior', kind: 'facet', scope: 'interior', label: 'Furnishing & contents', budget: 90, hint: 'What is actually in the room?',
      placeholder: 'What is actually in the room\u2026',
      instructions: 'List what is actually in this space and what state it is in \u2014 furniture, tools, clutter, what is on the walls, what is out of place. Under 50 words. Concrete nouns. Follow the author\u2019s steer above closely. Avoid a tidy inventory; the revealing detail is usually the thing nobody meant to leave out.' },
    { id: 'ce_loc_light', slot: 'interior', kind: 'facet', scope: 'interior', label: 'Light & sound', budget: 80, hint: 'How is it lit, and what can be heard?',
      placeholder: 'How it is lit, what you can hear, what carries\u2026',
      instructions: 'Describe how this space is lit and what can be heard in it, including what carries and what does not \u2014 whether a conversation here is private. Under 45 words. Follow the author\u2019s steer above closely. Avoid mood adjectives; state the source of the light and the source of the noise.' }
];

// GROUP ORDER AND LABELS, the arrangement CE_FIELD_GROUP_ORDER holds for characters. THE
// GROUPS ARE THE SCALES, and a group is a place to look, not a gate -- every group is
// offered at every scale.
// [LOC-PROFILE3] DO NOT RE-ADD A SCOPE FILTER. It hid groups the author had not written in,
// so the surface changed shape as it filled and the question you had not thought about was
// the one you could not see.
const CE_LOC_GROUP_ORDER: string[] = ['any', 'region', 'settlement', 'structure', 'interior', 'custom'];
const CE_LOC_GROUP_LABELS: Record<string, string> = {
    // The heading names the JOB, not the catalog's scope: these six build the entry.
    any: 'Lorebook Builder', region: 'Region', settlement: 'Settlement',
    structure: 'Structure', interior: 'Interior', custom: 'Your fields'
};

// SUGGESTIONS, NOT AN ENUM. locationType takes any string, and the picker also harvests
// every value already used in this story.
var CE_LOC_TYPE_SUGGESTIONS: string[] = [
    'region', 'country', 'city', 'town', 'district', 'structure', 'interior', 'wilderness', 'route'
];

// [ITEM-CAT] NO BUILT-IN FIELDS, DELIBERATELY. The location lenses work because every place
// can be asked what it constrains; nothing is true of every item that way.
const CE_ITEM_GROUP_ORDER: string[] = ['custom'];
const CE_ITEM_GROUP_LABELS: Record<string, string> = { custom: 'Your fields' };

// [F-28] Five, not six: every organisation wants, holds, has a method, answers to somebody
// and has a reputation. There is no faction Signature that is not already Reputation.
const FACTION_FACETS: { id: string; slot: string; kind: string; scope: string; label: string; hint: string; placeholder: string; instructions: string; budget: number }[] = [
    { id: 'ce_fac_wants', slot: 'any', kind: 'slot', scope: 'any', label: 'Wants', budget: 90, hint: 'What is it trying to get?',
      placeholder: 'What it is trying to get\u2026',
      instructions: 'State what this faction is actually trying to achieve right now \u2014 not its founding ideals, what it is pushing for this year. One to two sentences, under 50 words. It must be something that could be won or lost. Follow the author\u2019s steer above closely; it outranks any assumption about genre. Avoid abstractions like "power" or "order" on their own, and avoid goals that no scene could ever advance or frustrate.' },
    { id: 'ce_fac_holds', slot: 'any', kind: 'slot', scope: 'any', label: 'Holds', budget: 100, hint: 'What does it actually have?',
      placeholder: 'Territory, money, people, secrets, obligations owed to it\u2026',
      instructions: 'List what this faction concretely commands: territory, money, numbers, materiel, information, debts owed to it, offices it controls. Under 55 words. Concrete nouns a character could try to take or use. Follow the author\u2019s steer above closely. Avoid inventing named places or people unless the steer or notes give them, and avoid holdings so large the story could never threaten them.' },
    { id: 'ce_fac_method', slot: 'any', kind: 'slot', scope: 'any', label: 'Method', budget: 90, hint: 'How does it get its way?',
      placeholder: 'How it actually operates\u2026',
      instructions: 'State how this faction actually gets what it wants: what it does first, what it does when that fails, and what it will not do. One to three sentences, under 55 words. Follow the author\u2019s steer above closely. Avoid "any means necessary" and similar non-answers \u2014 a faction with no line it will not cross is not characterised, and the line is the interesting part.' },
    { id: 'ce_fac_answers', slot: 'any', kind: 'slot', scope: 'any', label: 'Answers to', budget: 90, hint: 'Who decides, and who can overrule them?',
      placeholder: 'Who decides, and what constrains them\u2026',
      instructions: 'State who makes decisions here and what constrains them \u2014 a person, a council, a charter, a creditor, a rival who must be placated. One to three sentences, under 50 words. Follow the author\u2019s steer above closely. Avoid inventing a named leader unless the steer or notes give one; "whoever currently holds the harbour contract" is stronger than a fabricated proper noun.' },
    { id: 'ce_fac_reputation', slot: 'any', kind: 'slot', scope: 'any', label: 'Reputation', budget: 100, hint: 'What do people say about it?',
      placeholder: 'What is said about it, and by whom\u2026',
      instructions: 'State what this faction is known for and how ordinary people speak about it \u2014 including where the reputation is wrong. One to three sentences, under 55 words. Follow the author\u2019s steer above closely. Avoid prophecy and ancient evil; a grudge, a scandal or a useful misunderstanding is usually the stronger answer.' }
];
const CE_FAC_GROUP_ORDER: string[] = ['any', 'custom'];
const CE_FAC_GROUP_LABELS: Record<string, string> = { any: 'Lorebook Builder', custom: 'Your fields' };

// [NARR-LENS] Five questions, asked of every thread whatever kind it is. THE SPINE IS
// UNIVERSAL AND THE KIND ONLY RE-ASKS IT -- see NARRATIVE_KINDS. That is what makes the
// kind picker re-selectable: values key on the lens id, never on the kind, so switching
// from Concealment to Reckoning re-words five questions and loses no answer.
// LABELS ARE STABLE ACROSS KINDS on purpose. They are the line prefixes in the compiled
// lorebook entry, so a kind that renamed them would rewrite the entry body on a picker tap.
const NARRATIVE_FACETS: { id: string; slot: string; kind: string; scope: string; label: string; hint: string; placeholder: string; instructions: string; budget: number }[] = [
    { id: 'ce_narr_pressure', slot: 'any', kind: 'slot', scope: 'any', label: 'Pressure', budget: 90,
      hint: 'Why now?',
      placeholder: 'What makes this live this month and not next\u2026',
      instructions: 'State what is forcing this thread NOW \u2014 the event, deadline, arrival, discovery or decision that made it live this month rather than next. One to two sentences, under 50 words. It must be something that has already happened or is already in motion, not a mood and not a background condition. Follow the author\u2019s steer above closely; it outranks any assumption about genre. Avoid \u201ctensions are rising\u201d and similar summaries, and avoid a cause the story has not established.' },
    { id: 'ce_narr_objective', slot: 'any', kind: 'slot', scope: 'any', label: 'Objective', budget: 80,
      hint: 'What would have to happen for this to be over?',
      placeholder: 'What would have to happen for this to be over\u2026',
      instructions: 'State what would have to happen for this thread to be over. One to two sentences, under 45 words. It must be OBSERVABLE \u2014 something a scene could show landing, not a feeling anyone has about it afterwards. Follow the author\u2019s steer above closely. Avoid \u201cfind peace\u201d, \u201clearn the truth about themselves\u201d and other endings no scene could confirm, and name one ending rather than several.' },
    { id: 'ce_narr_opposition', slot: 'any', kind: 'slot', scope: 'any', label: 'Opposition', budget: 100,
      hint: 'What resists \u2014 and what does it do about it?',
      placeholder: 'What resists, and what it actually does\u2026',
      instructions: 'State what resists this and what it actually DOES about it. One to three sentences, under 55 words. Opposition can be a person, an institution, distance, time, or a habit the protagonist will not break \u2014 but whatever it is, it must act rather than merely exist. Follow the author\u2019s steer above closely. Avoid inventing a named antagonist unless the steer or notes give you one, and avoid opposition so total that no scene could make progress against it.' },
    { id: 'ce_narr_cost', slot: 'any', kind: 'slot', scope: 'any', label: 'Cost', budget: 90,
      hint: 'What does pursuing this take out of the protagonist?',
      placeholder: 'What they spend, risk or give up by choosing it\u2026',
      instructions: 'State what pursuing this takes out of the protagonist: what they spend, risk, neglect or give up by choosing it over everything else. One to two sentences, under 50 words. It must be a reason someone might reasonably stop. Follow the author\u2019s steer above closely. Avoid generic exhaustion, and avoid a cost paid only at the end \u2014 the useful cost is charged along the way.' },
    { id: 'ce_narr_consequence', slot: 'any', kind: 'slot', scope: 'any', label: 'Consequence', budget: 100,
      hint: 'What is different afterwards \u2014 win or lose?',
      placeholder: 'What the story cannot take back once this resolves\u2026',
      instructions: 'State what is different afterwards, whether this ends well or badly \u2014 what the story cannot take back once it resolves either way. One to three sentences, under 55 words. Write BOTH outcomes when they differ meaningfully. The world must not return to how it was. Follow the author\u2019s steer above closely. Avoid \u201ceverything changes\u201d and similar non-answers, and avoid consequences that fall only on people the story has not met.' }
];

// [NARR-KIND] THE KIND OWNS ONE SHORT LINE PER LENS AND NOTHING ELSE. A full per-kind
// instruction set would be ten copies of the block above and would fork what the lens
// already says well; a steer composes with it instead, exactly as the author’s own steer
// field does one layer further in. Keyed by lens id, so a kind cannot steer a field that
// does not exist. `custom` steers nothing and is the honest option for a thread that fits
// none of the nine.
// WHICH WAY A THREAD POINTS IS SAID IN THE STEER, NOT IN A FLAG. The dread kinds tell
// Objective to be negative because that is where the difference does its work; a boolean
// beside them would be a declared attachment nothing reads.
var NARRATIVE_KINDS: { id: string; label: string; blurb: string; steer: { [k: string]: string } }[] = [
    { id: 'errand', label: 'Errand', blurb: 'Something must be reached, fetched, delivered or destroyed.', steer: {
        ce_narr_pressure:    'Why the thing cannot simply be collected later \u2014 who else wants it, or what is about to happen to it.',
        ce_narr_objective:   'The specific thing in the specific place, and what counts as having it.',
        ce_narr_opposition:  'Distance, whoever holds it, and what they do when someone comes for it.',
        ce_narr_cost:        'What the journey or the taking spends \u2014 time, money, standing, a favour called in.',
        ce_narr_consequence: 'What having it changes, and who notices that it is gone.' } },
    { id: 'mystery', label: 'Mystery', blurb: 'Something must be known.', steer: {
        ce_narr_pressure:    'What made the question urgent \u2014 a body, a disappearance, a letter, a lie that stopped working.',
        ce_narr_objective:   'The fact to be established, stated plainly here even though the protagonist does not have it yet.',
        ce_narr_opposition:  'Who is keeping it hidden and how \u2014 silence, forgery, distance, a witness who will not speak.',
        ce_narr_cost:        'What asking costs: who is warned, who is endangered, what the protagonist can no longer unknow.',
        ce_narr_consequence: 'What the answer does to the people who already knew it, and to the one who did not.' } },
    { id: 'reckoning', label: 'Reckoning', blurb: 'Someone must answer for something.', steer: {
        ce_narr_pressure:    'What reopened it \u2014 their return, a witness, a second offence, the protagonist finally being able to act.',
        ce_narr_objective:   'What answering actually looks like: a confession, a ruin, a court, a blade, a name said in public.',
        ce_narr_opposition:  'Their power to resist, and the protagonist\u2019s own uncertainty about whether they are right to do this.',
        ce_narr_cost:        'What the pursuit takes while it lasts \u2014 who is neglected for it, and what the protagonist becomes doing it.',
        ce_narr_consequence: 'What is left when it is done, including the possibility that it settles nothing.' } },
    { id: 'ascent', label: 'Ascent', blurb: 'A position must be taken.', steer: {
        ce_narr_pressure:    'What made the seat available or the climb possible now \u2014 a death, a vacancy, a scandal, a patron.',
        ce_narr_objective:   'The specific standing, office or recognition, and how the story would know it had been granted.',
        ce_narr_opposition:  'Rivals who want it too, and the people whose approval cannot be bought.',
        ce_narr_cost:        'What must be traded for it \u2014 loyalties, principles, the people who liked the protagonist as they were.',
        ce_narr_consequence: 'What the position demands of whoever holds it, and what the losers do afterwards.' } },
    { id: 'bond', label: 'Bond', blurb: 'A relationship must change shape.', steer: {
        ce_narr_pressure:    'What made the current shape unsustainable \u2014 a revelation, a departure, a demand, a change in circumstance.',
        ce_narr_objective:   'The standing the relationship must reach, as something a scene could show. The recorded shape and standing are the starting point, not the goal.',
        ce_narr_opposition:  'Usually the relationship\u2019s own current shape, and whatever each of them would have to admit.',
        ce_narr_cost:        'What each of them risks by letting it change, including what they lose if it works.',
        ce_narr_consequence: 'What the new standing makes possible, and what it closes off.' } },
    { id: 'debt', label: 'Debt', blurb: 'Something is owed, and will be collected.', steer: {
        ce_narr_pressure:    'The clock: who is coming, when, and what they already did to someone else who was late.',
        ce_narr_objective:   'Discharge, escape or renegotiation \u2014 say which, and what would actually end the obligation.',
        ce_narr_opposition:  'The holder\u2019s reach, and the fact that they do not need to hurry.',
        ce_narr_cost:        'What paying costs AND what running costs, so that neither is the obvious answer.',
        ce_narr_consequence: 'What is taken if the debt lands, and what is owed to whoever helps.' } },
    { id: 'concealment', label: 'Concealment', blurb: 'Something must stay hidden.', steer: {
        ce_narr_pressure:    'What has moved closer to it \u2014 a new arrival, an audit, a witness, a piece of it already loose.',
        ce_narr_objective:   'Negative and ongoing: name exactly what must not be known, and by whom specifically.',
        ce_narr_opposition:  'Who is looking, what they already have, and what they would do with the rest.',
        ce_narr_cost:        'What the maintenance takes \u2014 lies told, people kept at a distance, chances refused to stay safe.',
        ce_narr_consequence: 'What exposure would do, and what surviving concealed does to the one keeping it.' } },
    { id: 'siege', label: 'Siege', blurb: 'Something held must be kept.', steer: {
        ce_narr_pressure:    'What is pressing on it now, and how long the current arrangement can hold.',
        ce_narr_objective:   'Negative: what must still be standing, held or alive at the end, and by when.',
        ce_narr_opposition:  'The pressure itself and its patience \u2014 attrition, weather, appetite, an enemy who can afford to wait.',
        ce_narr_cost:        'What is spent holding on: supplies, people, the ability to do anything else at all.',
        ce_narr_consequence: 'What holding leaves behind, and what falls with it if it does not hold.' } },
    { id: 'ruin', label: 'Ruin', blurb: 'Something is going wrong and cannot be stopped \u2014 only slowed, or survived.', steer: {
        ce_narr_pressure:    'What stage the decline has reached, and what just made it undeniable.',
        ce_narr_objective:   'Not a rescue: what is worth saving out of it, and what \u201csurvived\u201d would mean here.',
        ce_narr_opposition:  'The process itself, and everyone who profits from it continuing or refuses to see it.',
        ce_narr_cost:        'What slowing it takes, and what is spent on the parts that cannot be saved.',
        ce_narr_consequence: 'What is left standing afterwards, and who has to live in it.' } },
    { id: 'custom', label: 'Custom', blurb: 'None of the nine. The five questions are asked plainly, with no steer.', steer: {} }
];
const CE_NARR_GROUP_ORDER: string[] = ['any', 'custom'];
const CE_NARR_GROUP_LABELS: Record<string, string> = { any: 'The thread', custom: 'Your fields' };

// [NARR-KIND] The enumerator is built FROM the table, per F-29 -- a hand-kept options
// list beside it is a second source of truth that silently wins.
function ceNarrativeKindOptions(): { id: string; label: string }[] {
    var out: { id: string; label: string }[] = [];
    for (var i = 0; i < NARRATIVE_KINDS.length; i++) {
        out.push({ id: NARRATIVE_KINDS[i].id, label: NARRATIVE_KINDS[i].label });
    }
    return out;
}
// Falls back to `custom` for an unset or unrecognised kind, so every caller gets a
// record and none of them re-derives the default.
function ceNarrativeKind(id: string): any {
    var want = String(id || '');
    for (var i = 0; i < NARRATIVE_KINDS.length; i++) {
        if (NARRATIVE_KINDS[i].id === want) return NARRATIVE_KINDS[i];
    }
    return NARRATIVE_KINDS[NARRATIVE_KINDS.length - 1];
}

// THE CATALOG TABLE. Adding a record type to the profile column is an entry here plus a
// payload branch. Every consumer -- surface column, Add drill, reorder drill, generator
// shim, lorebook compile -- reads through the four functions below and none names a type.
//   base     built-in facet catalog, or [] for a type that has none
//   cfgKey   which GlobalConfig array holds the author's own fields
//   groups / labels   group order and headings for the surface column
//   idPrefix minted onto a new custom field, so an id says which library it came from
//   noun     the word the authoring copy uses
var CE_ENTITY_CATALOGS: any = {
    location: { base: LOCATION_FACETS, cfgKey: 'customLocationFields',
                groups: CE_LOC_GROUP_ORDER, labels: CE_LOC_GROUP_LABELS,
                idPrefix: 'ce_locx_', noun: 'location', shape: true },
    item:     { base: [],               cfgKey: 'customItemFields',
                groups: CE_ITEM_GROUP_ORDER, labels: CE_ITEM_GROUP_LABELS,
                idPrefix: 'ce_itemx_', noun: 'item' },
    faction:  { base: FACTION_FACETS,   cfgKey: 'customFactionFields',
                groups: CE_FAC_GROUP_ORDER, labels: CE_FAC_GROUP_LABELS,
                idPrefix: 'ce_facx_', noun: 'faction', shape: true },
    // [NARR-LENS] NO `shape`. The Classic/Builder toggle exists for types whose records
    // were authored as one block of entry text before their questions existed; a narrative
    // has never had a lorebookText of its own, so there is no earlier model to preserve.
    narrative: { base: NARRATIVE_FACETS, cfgKey: 'customNarrativeFields',
                groups: CE_NARR_GROUP_ORDER, labels: CE_NARR_GROUP_LABELS,
                idPrefix: 'ce_narrx_', noun: 'thread' }
};
// [F-28] `shape` -- does this type offer the Classic/Builder toggle? A FACT ABOUT HISTORY,
// not catalog size: true for types whose records were authored as ONE description before
// their questions existed (locations, migrated factions). Items were not, so there is no
// earlier model to preserve. ON THE TABLE, not as a type literal in the surface.
function ceEntityHasShape(type: string): boolean {
    var c = ceEntityCatalog(type);
    return !!(c && c.shape);
}
// NULL FOR A TYPE WITH NO CATALOG; callers treat null as "no profile column". A character
// body is a graph object and would get a page that asks nothing.
function ceEntityCatalog(type: string): any {
    return CE_ENTITY_CATALOGS[String(type || '')] || null;
}
function ceEntityGroupOrder(type: string): string[] {
    var c = ceEntityCatalog(type);
    return (c && c.groups) || [];
}
function ceEntityFacetGroup(type: string, def: any): string {
    var g = String((def && def.slot) || '');
    return ceEntityGroupOrder(type).indexOf(g) >= 0 ? g : '';
}
function ceEntityGroupLabel(type: string, g: string): string {
    var c = ceEntityCatalog(type);
    return (c && c.labels && c.labels[g]) || 'Other';
}
// BUILT-IN ONLY. Custom fields live in config; ceEntityOrderedDefs merges the two.
function ceEntityFacetById(type: string, id: string): any {
    var c = ceEntityCatalog(type);
    var base: any[] = (c && c.base) || [];
    for (var i = 0; i < base.length; i++) {
        if (base[i].id === String(id)) return base[i];
    }
    return null;
}

// ============================================================================
// SECTION 3 — SUBSYSTEM BLOCK
//   3a logging   3b diagnostic flags & slash commands   3c budget constants & locks
//   3d wizard mode (classic) AND self test   3e WIZLIVE   3f CharChat (largest block)
//   3g budget & generation diagnostics   3h generation execution (direct + yoink)
//   3i script-level state   3j context census
// ============================================================================

// ============================================================================
// SECTION 3a — LOGGING & DIAGNOSTIC CHANNELS
// aeLog and its per-channel enable map, persisted to api.v1.storage.
// ============================================================================

// ── [DIAG LOG-CHANNELS] Channelled console logger ───────────────────────────
// The channel is derived at call time from the '[AE:xxx]' or '[AE:xxx:yyy]' tag already on
// nearly every message, so enabling a base channel enables its ':'-suffixed children and no
// call site needed its text rewritten. An untagged message always passes through.
// api.v1.error() IS NEVER GATED: errors are the sparse, high-signal half of this file's
// logging and a channel that could default off would silence a real failure.
// Persisted to api.v1.storage GLOBAL scope, not story-scoped -- developer diagnostics, not
// story state. Runtime control: /log <channel> on|off, /log all, /log none, /log list.
var AE_LOG_STORAGE_KEY = 'ae_log_channels_v1';
// Channels ON by default; everything else is silent until explicitly enabled.
var AE_LOG_DEFAULT_ON = ['charchat', 'summon'];
var _aeLogEnabled: {[k: string]: boolean} = {};
for (let _aeLogDfltCh of AE_LOG_DEFAULT_ON) { _aeLogEnabled[_aeLogDfltCh] = true; }

// Fires immediately, not behind onScriptsLoaded, so persisted choices apply as early as
// possible; the window before it resolves falls back to AE_LOG_DEFAULT_ON.
(async function _aeLogInit() {
    try {
        let _aeLogRaw = await api.v1.storage.getOrDefault(AE_LOG_STORAGE_KEY, '');
        if (_aeLogRaw) {
            let _aeLogParsed = JSON.parse(_aeLogRaw);
            // MERGED OVER THE DEFAULTS, NOT SUBSTITUTED FOR THEM. The stored map is a
            // snapshot of the channels that existed when /log last ran, so a wholesale
            // replace silently muted every channel added AFTER it -- which is how three
            // summon fixes shipped into silence. An explicit stored false still wins.
            if (_aeLogParsed && typeof _aeLogParsed === 'object') {
                for (let _aeLogK in _aeLogParsed) _aeLogEnabled[_aeLogK] = !!_aeLogParsed[_aeLogK];
            }
        }
    } catch (_eAeLogInit) { /* keep the coded defaults */ }
})();

function _aeLogChannelOf(first: any): string {
    if (typeof first !== 'string') return '';
    let _aeLogM = first.match(/^\[AE:([a-zA-Z0-9_-]+(?::[a-zA-Z0-9_-]+)*)\]/);
    return _aeLogM ? _aeLogM[1] : '';
}
function _aeLogChannelOn(channel: string): boolean {
    if (!channel) return true; // untagged lines always pass through — see header comment
    if (_aeLogEnabled['*']) return true; // escape hatch: /log all
    if (_aeLogEnabled[channel]) return true;
    let _aeLogBase = channel.split(':')[0];
    return !!_aeLogEnabled[_aeLogBase];
}
// Drop-in replacement for api.v1.log(...) — same variadic signature, channel-gated.
function aeLog(...args: any[]): void {
    try {
        if (!_aeLogChannelOn(_aeLogChannelOf(args[0]))) return;
        (api.v1.log as any).apply(null, args);
    } catch (_eAeLog) { /* logging must never break the caller */ }
}
async function aeLogSetChannel(channel: string, on: boolean): Promise<void> {
    _aeLogEnabled[channel] = on;
    try { await api.v1.storage.set(AE_LOG_STORAGE_KEY, JSON.stringify(_aeLogEnabled)); } catch (_eAeLogSet) {}
}
function aeLogList(): string {
    let _aeLogOn = Object.keys(_aeLogEnabled).filter(function(k) { return _aeLogEnabled[k]; });
    let _aeLogOff = Object.keys(_aeLogEnabled).filter(function(k) { return !_aeLogEnabled[k]; });
    return 'Log channels ON: ' + (_aeLogOn.length ? _aeLogOn.join(', ') : '(none)')
        + '\nKnown but OFF: ' + (_aeLogOff.length ? _aeLogOff.join(', ') : '(none)')
        + '\nAny [AE:xxx] tag never listed here is OFF by default. Prefix match applies '
        + '(e.g. "charchat" also covers "charchat:resp"). Commands: /log <channel> on|off, '
        + '/log all, /log none, /log list.';
}
// ── [DIAG LOG-CHANNELS] end ──────────────────────────────────────────────────

// ============================================================================
// SECTION 3b — DIAGNOSTIC FLAGS & SLASH COMMANDS
// CE_DIAG flag set plus the /diag and /log command handler.
// ============================================================================

// ── [DIAG CE-DIAG-FLAGS] CharChat runtime kill-switches ─────────────────────
// One suspect mechanism removed at a time, so a failing turn can be re-tested without a ship
// cycle per hypothesis. Every flag defaults false = unmodified behaviour. Persisted to
// api.v1.storage global scope. Runtime control: /diag <flag> on|off, /diag list.
var AE_DIAG_STORAGE_KEY = 'ae_diag_flags_v1';
interface CEDiagFlags {
    ccRawContext: boolean;      // skip runCharChatContextOverride entirely — NAI gets the
                                 // raw story context for a chat turn. DIAGNOSTIC ONLY: this
                                 // WILL leak story scaffolding/system prompt into the chat.
    ccSkipWidgets: boolean;     // skip refreshCharChatImageWidgets' clear/rebuild pass
                                 // (called from inside refreshCharChatDecorations)
    ccSkipDecorations: boolean; // skip refreshCharChatDecorations entirely in onGenerationEnd
                                 // (this also skips widgets, since that call nests inside it —
                                 // use ccSkipWidgets instead to isolate just the widget pass)
    ccNoSeenDefer: boolean;     // onResponse: do not request re-delivery via seenData:false on
                                 // non-final chunks — accept cross-chunk misses, clean on final only
    ccNoPrime: boolean;         // disable an earlier CHARCHAT-SLOT-PRIME call (Fresh Thoughts OFF path)
    ccNoThought: boolean;       // disable the post-reply ephemeral thought call (Fresh Thoughts ON path)
    ccNoImages: boolean;        // skip _charchatProcessImages() entirely for the turn
    ccNoPrefill: boolean;       // [CHARCHAT-USERTOKEN] disable the dangling speaker cue at the
                                 // end of context. Set true to restore earlier behaviour (context
                                 // ends on a closed '[ ... ]' block) and reproduce the empty-reply bug.
    wlNoPrefill: boolean;       // [WIZLIVE-USERTOKEN] same fix, same flag pattern, for Live
                                 // Wizard Chat's onBeforeContextBuild branch.
}
var CE_DIAG: CEDiagFlags = {
    ccRawContext: false, ccSkipWidgets: false, ccSkipDecorations: false,
    ccNoSeenDefer: false, ccNoPrime: false, ccNoThought: false, ccNoImages: false,
    ccNoPrefill: false, wlNoPrefill: false
};
(async function _aeDiagInit() {
    try {
        let _aeDiagRaw = await api.v1.storage.getOrDefault(AE_DIAG_STORAGE_KEY, '');
        if (_aeDiagRaw) {
            let _aeDiagParsed = JSON.parse(_aeDiagRaw);
            if (_aeDiagParsed && typeof _aeDiagParsed === 'object') Object.assign(CE_DIAG, _aeDiagParsed);
        }
    } catch (_eAeDiagInit) { /* keep all-off defaults — unmodified behaviour */ }
})();
async function aeDiagSet(flag: string, on: boolean): Promise<string> {
    if (!(flag in CE_DIAG)) return 'Unknown diag flag: ' + flag + '. ' + aeDiagList();
    (CE_DIAG as any)[flag] = on;
    try { await api.v1.storage.set(AE_DIAG_STORAGE_KEY, JSON.stringify(CE_DIAG)); } catch (_eAeDiagSet) {}
    aeLog('[AE:diag] ' + flag + ' = ' + on);
    return flag + ' set to ' + on + '. ' + (on ? 'NON-DEFAULT behaviour is now active for this flag.' : 'Back to default behaviour for this flag.');
}
function aeDiagList(): string {
    return 'Diag flags (all default false/unmodified): '
        + Object.keys(CE_DIAG).map(function(k) { return k + '=' + (CE_DIAG as any)[k]; }).join(', ');
}
// ── [DIAG CE-DIAG-FLAGS] end ─────────────────────────────────────────────────

// ── [DIAG-CMD-SHARED] Surface-independent /log and /diag handler ────────────
// NEVER GATE A CROSS-CUTTING FACILITY ON A UI SURFACE THAT MAY NOT EXIST. These commands
// once lived only in runWizardChatTurn, so they were unreachable from WIZLIVE, which types
// into the document and never calls it. Callable from both that function and the AE_DIAG_CMD
// bridge message (SECTION 18), which reaches the engine whatever is open.
// THE HANDLE IS window.aeBridge, NOT window.CE_ENGINE -- the latter is named in old comments
// and has never existed in any shipped bridge. Verified live:
//     window.aeBridge.sendToEngine('AE_DIAG_CMD', { cmd: '/ce ghost' })
// The reply arrives as an AE_DIAG_REPLY console event, not as a return value. Returns the
// reply string on a match, or null so the caller falls through to its own handling.
async function aeHandleDiagCommand(rawText: string, cmdLower: string): Promise<string | null> {
    if (cmdLower === '/log' || cmdLower.indexOf('/log ') === 0) {
        let _logParts = rawText.split(/\s+/);
        let _logSub = (_logParts[1] || 'list').toLowerCase();
        if (_logSub === 'list') return aeLogList();
        if (_logSub === 'all') { await aeLogSetChannel('*', true); return 'All log channels ON.'; }
        if (_logSub === 'none') {
            for (let _logK in _aeLogEnabled) _aeLogEnabled[_logK] = false;
            await aeLogSetChannel('charchat', false); // triggers the persist write
            return 'All log channels OFF (including "*"). \'charchat\' stays off until re-enabled \u2014 it is no longer the coded default once you\'ve explicitly touched channel state.';
        }
        let _logCh = _logParts[1];
        let _logState = (_logParts[2] || '').toLowerCase();
        if (!_logCh || (_logState !== 'on' && _logState !== 'off')) {
            return 'Usage: /log list | /log all | /log none | /log <channel> on|off\n' + aeLogList();
        }
        await aeLogSetChannel(_logCh, _logState === 'on');
        return 'Channel "' + _logCh + '" set ' + _logState.toUpperCase() + '.\n' + aeLogList();
    }
    // [CE-STATUS] One command answering "is this character updating, and is anything of
    // theirs reaching context" without log channels on or a generation first. Every gate
    // runDynamicEngine checks, in the order it checks them, per character -- because these
    // gates fail SILENTLY and look identical: no body, parked in another room, over the
    // dynamic cap, and interval-not-elapsed all produce nothing happening.
    if (cmdLower === '/ce' || cmdLower.indexOf('/ce ') === 0) {
        const ceParts = rawText.split(/\s+/);
        const ceSub = (ceParts[1] || 'status').toLowerCase();
        // [WORLDMAP] Opens the World Map surface (SECTION 32) from the console, over the
        // same DIAG-CMD path as every other /ce command; the toolbar button is the primary
        // door. The returned string is DIAG-CMD's reply payload, not chat output.
        // [REACH] RE-DOORED, NOT DELETED. aeBudgetReport and _ceFreeRunsReport lost their
        // callers with the dead bridge protocol. They measure the one resource every
        // generation spends and nothing else can see.
        // [SELFTEST] `/ce selftest` runs everything, `/ce selftest read` only the live
        // storage invariants -- the half worth running after a patch.
        if (ceSub === 'selftest' || ceSub === 'test') {
            return await runSelfTest(ceParts[2] || 'all');
        }
        if (ceSub === 'budget') {
            var bgN = Number(ceParts[2]) || 0;
            var bg = aeBudgetReport(bgN);
            var fr = await _ceFreeRunsReport();
            return 'budget out=' + bg.out + ' in=' + bg.inp
                 + ' need=' + bg.need + ' waitSec=' + bg.waitSec
                 + '\nfree runs used=' + fr.used + '/' + fr.max + ' left=' + fr.left;
        }
        if (ceSub === 'map' || ceSub === 'mapprobe') {
            ceOpenMap().catch(function() {});
            return 'Opening World Map\u2026';
        }
        // [GHOST-WALK] Lists the tree under and around the live host. IT ANSWERED AND THE
        // ENGINE-SIDE INVESTIGATION IS CLOSED -- see GHOST-WALK-UP below for the finding.
        // Every property read is guarded: the DOM whitelist here is undocumented and a
        // diagnostic that throws is worse than none.
        if (ceSub === 'ghost') {
            var gwOut: string[] = [];
            var gwId: string;
            for (gwId in _ceMountCount) {
                gwOut.push('mount ' + gwId + ' x' + _ceMountCount[gwId]);
            }
            // [HOST-ORPHAN] The host COUNT is the headline number: it must be 1 no matter
            // how many mounts have fired. Above 1 means the teardown is not keeping up.
            var gwHostList: any[] = _ceMountHosts['ce-shell-jsx'] || [];
            gwOut.push('tracked hosts=' + gwHostList.length + ' (1 is correct)');
            var gwHost: any = _ceMountElem['ce-shell-jsx'] || null;
            if (!gwHost) { gwOut.push('no ce-shell-jsx host recorded — open the shell first.'); return gwOut.join('\n'); }
            var gwSeen = 0;
            var gwWalk = function(node: any, path: string, depth: number): void {
                if (!node || gwSeen > 80 || depth > 4) return;
                gwSeen++;
                var tag = '?'; var kids: any = null; var n = 0; var txt = '';
                try { tag = String(node.tagName || node.nodeName || '?'); } catch (_e1) {}
                try { kids = node.childNodes || null; n = (kids && kids.length) || 0; } catch (_e2) {}
                try { txt = String(node.textContent || '').replace(/\s+/g, ' ').slice(0, 34); } catch (_e3) {}
                gwOut.push(new Array(depth + 1).join('  ') + '[' + path + '] ' + tag
                    + ' kids=' + n + (txt ? ' "' + txt + '"' : ''));
                for (var gi = 0; gi < n && gwSeen <= 80; gi++) {
                    var kid: any = null;
                    try { kid = kids[gi]; } catch (_e4) { kid = null; }
                    gwWalk(kid, path + '.' + gi, depth + 1);
                }
            };
            try { gwOut.push('host isConnected=' + String(!!gwHost.isConnected)); } catch (_e5) {}
            gwOut.push('-- DOWN from host --');
            gwWalk(gwHost, '0', 0);
            if (gwSeen > 80) gwOut.push('… truncated at 80 nodes');

            // [GHOST-WALK-UP] Climbs the parent chain and lists each level's direct
            // children, because the down-walk came back clean while a ghost was on screen.
            // [SANDBOX-DOM] THE MEASUREMENT THAT ENDED THE ENGINE-SIDE INVESTIGATION. It
            // reported a #document with an EMPTY BODY, our host beside that body rather
            // than inside it, and no readable parent above. THAT IS NOT THE PAGE: the
            // engine renders into a SYNTHETIC DOCUMENT inside the sandbox which NAI
            // marshals out, so render, h and every walk here run on a private tree.
            // The engine cannot see the ghosts and cannot fix them from here; the live
            // probe is window.aeBridge.ghost. Keep this as the record, do not build on it.
            gwOut.push('-- UP from host --');
            var gwUp: any = gwHost;
            var gwLvl = 0;
            while (gwLvl < 8) {
                var gwPar: any = null;
                try { gwPar = gwUp.parentNode || gwUp.parentElement || null; } catch (_e6) { gwPar = null; }
                if (!gwPar) { gwOut.push('^' + gwLvl + ' no readable parent (chain ends here)'); break; }
                gwLvl++;
                var pTag = '?'; var pKids: any = null; var pN = 0;
                try { pTag = String(gwPar.tagName || gwPar.nodeName || '?'); } catch (_e7) {}
                try { pKids = gwPar.childNodes || null; pN = (pKids && pKids.length) || 0; } catch (_e8) {}
                gwOut.push('^' + gwLvl + ' ' + pTag + ' kids=' + pN);
                for (var pi = 0; pi < pN && pi < 12; pi++) {
                    var pKid: any = null; var kTag = '?'; var kN = 0; var kTxt = ''; var kMe = '';
                    try { pKid = pKids[pi]; } catch (_e9) { pKid = null; }
                    if (!pKid) continue;
                    try { kTag = String(pKid.tagName || pKid.nodeName || '?'); } catch (_e10) {}
                    try { kN = (pKid.childNodes && pKid.childNodes.length) || 0; } catch (_e11) {}
                    try { kTxt = String(pKid.textContent || '').replace(/\s+/g, ' ').slice(0, 44); } catch (_e12) {}
                    if (pKid === gwUp) kMe = '  <== the branch we came up from';
                    gwOut.push('    ^' + gwLvl + '.' + pi + ' ' + kTag + ' kids=' + kN
                        + (kTxt ? ' "' + kTxt + '"' : '') + kMe);
                }
                if (pN > 12) gwOut.push('    … ' + (pN - 12) + ' more children at this level');
                gwUp = gwPar;
            }
            return gwOut.join('\n');
        }
        // [CTX-CENSUS] The contents instrument, paired with /ce budget's allowance
        // instrument. SECTION 3j owns the capture; this is only the door.
        if (ceSub === 'ctx') {
            return await _ceCtxReport(ceParts[2] || '');
        }
        // [IMP-TRACE] The instrument the imperative path did not have. Free, read-only.
        if (ceSub === 'imp') {
            return await _ceImpReport();
        }
        // [BILLED-IN] Free, read-only, no generation. This is the one that says
            // whether the story block is actually working in a real story.
        if (ceSub === 'cost') {
            return _ceCostReport();
        }
        // [CACHE-PROBE] Bare `/ce cache` states the contract and refuses; only
        // `/ce cache run` spends budget. A diagnostic that fires on a typo goes unused.
        if (ceSub === 'cache') {
            // [CACHE-STORY] Second probe, different question: /ce cache asks whether two
            // SCRIPT calls share a cache (yes); this asks whether a STORY turn fills one.
            if ((ceParts[2] || '').toLowerCase() === 'story') {
                if ((ceParts[3] || '').toLowerCase() !== 'run') {
                    return 'STORY-CACHE PROBE. Two generateWithStory calls, measuring billed input.\n'
                         + 'Costs up to ~18k input tokens if it misses. RUN IT IMMEDIATELY AFTER A\n'
                         + 'STORY TURN \u2014 anything in between moves the cache on and S1 misses for\n'
                         + 'the wrong reason.\n\n'
                         + '  S1  first call after the story turn  -> did the STORY turn fill our cache?\n'
                         + '  S2  second call, different tail      -> script-to-script only?\n\n'
                         + 'SUCCESS = S1 cheap. That means an auto-generation can ride the story turn\u2019s\n'
                         + 'own prefix, costing its tail instead of a private 2500-token block, and\n'
                         + 'seeing the whole story context instead of an excerpt.\n'
                         + 'If only S2 is cheap, generateWithStory costs one full story context per\n'
                         + 'pass \u2014 worse than the block, and the block stays.\n\n'
                         + 'Run it with:  /ce cache story run';
                }
                return await _ceCacheStoryProbe();
            }
            if ((ceParts[2] || '').toLowerCase() !== 'run') {
                return 'PREFIX-CACHE PROBE. Four generations, one variable at a time, measuring\n'
                     + 'billed input via getAllowedInput() deltas. Costs roughly 5k input tokens.\n\n'
                     + '  A1  prefix P + tail S1   cold reference (P carries a per-run nonce)\n'
                     + '  A2  prefix P + tail S1   identical repeat      -> exact-match caching?\n'
                     + '  A3  prefix P + tail S2   same prefix, new tail -> PREFIX caching?\n'
                     + '  B1  prefix Q + tail S2   different prefix      -> control\n\n'
                     + 'SUCCESS = A2 and A3 both well under A1 while B1 stays near A1. That, and\n'
                     + 'only that, justifies reordering the auto-generation prompts to share a\n'
                     + 'story prefix. If A3 is not cheap, a shared prefix buys nothing.\n\n'
                     + 'Run it with:  /ce cache run';
            }
            return await _ceCacheProbe();
        }
        if (ceSub !== 'status') {
            return 'Usage: /ce status | /ce ctx [stable|<key>] | /ce cost | /ce cache [run|story run]'
                 + ' | /ce budget [need] | /ce selftest [pure|read|all] | /ce map | /ce ghost';
        }
        try {
            const stCfg   = await loadConfig();
            const stIdx   = await loadIndex();
            const stEnts  = await loadEntityIndex();
            const stCam   = await loadProtagonistLocation();
            const stGen   = Number(await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0)) || 0;
            const stTok   = Number(await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0)) || 0;
            const stMode  = ((stCfg as any).dynamicIntervalMode === 'tokens') ? 'tokens' : 'gens';
            const stTokM  = (stMode === 'tokens');
            const stProg  = stTokM ? stTok : stGen;
            const stUnit  = stTokM ? 'tok' : 'gen';
            const stCap   = Number((stCfg as any).maxDynamicCharacters) || 0;
            const stAllow = computeDynamicAllowedSet(stIdx as any, stCap);
            const stCamName = stCam
                ? ((stEnts.filter(Boolean).find(function(m) { return m.id === stCam; }) || { name: '?' }).name + ' [' + stCam + ']')
                : '(none — NO CAMERA LOCATION, nothing can be scene-present)';

            const out: string[] = [];
            out.push('CADENCE  ' + stMode + '  gen=' + stGen + '  tok=' + stTok);
            out.push('CAMERA   ' + stCamName);
            out.push('CAP      ' + (stCap > 0 ? (stCap + ' (allowed this turn: ' + stAllow.size + ')') : 'none'));
            out.push('');

            const stActive = stIdx.filter(Boolean).filter(function(m) { return m.active; });
            if (stActive.length === 0) out.push('(no active characters)');

            for (const meta of stActive) {
                const c = await loadCharacter(meta.id);
                if (!c) { out.push(meta.name + ': <record failed to load>'); continue; }
                const isProt = !!c.isProtagonist;
                const isStat = !!(c as any).isStatic;
                const body   = c.entityId ? (stEnts.filter(Boolean).find(function(m) { return m.id === c.entityId; }) || null) : null;
                const room   = c.entityId ? getEffectiveRoomId(c.entityId, stEnts) : null;
                const roomNm = room ? ((stEnts.filter(Boolean).find(function(m) { return m.id === room; }) || { name: '?' }).name) : null;
                const rel    = charIsRelevant(c, new Set<string>());
                const capOut = (stCap > 0 && !stAllow.has(meta.id));

                // Name the FIRST gate that stops this character, in dispatch order — a
                // list of every failing condition is noise when only the first one matters.
                let blocker = '';
                if (isProt)            blocker = 'protagonist (never updated)';
                else if (isStat)       blocker = 'STATIC toggle';
                else if (capOut)       blocker = 'over dynamic cap';
                else if (!c.entityId)  blocker = 'NO BODY (entityId unset) — cannot ever be scene-present';
                else if (!body)        blocker = 'body id set but entity MISSING — use Generate Missing Physical Body';
                else if (room === null) blocker = 'body has no room (parentId null) — place it in a location';
                else if (!stCam)       blocker = 'no camera location set';
                else if (room !== stCam) blocker = 'in ' + roomNm + ', camera is elsewhere';
                else if (!c.scenePresent) blocker = 'scenePresent=false despite co-location (stale — runs on next generation)';
                else if (!rel)         blocker = 'not relevant';

                out.push(meta.name + (isProt ? ' [PROTAG]' : (isStat ? ' [STATIC]' : ' [dyn]')));
                out.push('  place    body=' + (c.entityId ? (body ? 'ok' : 'MISSING') : 'none')
                    + ' room=' + (roomNm || '-') + ' present=' + (c.scenePresent ? 'YES' : 'no'));
                if (blocker) {
                    out.push('  BLOCKED  ' + blocker);
                } else {
                    const lastEph  = Number(stTokM ? c.lastEphemeralTokens : c.lastEphemeralGen) || 0;
                    const lastHook = Number(stTokM ? c.lastHookTokens      : c.lastHookGen)      || 0;
                    const intEph   = Number(stTokM ? (stCfg as any).thoughtIntervalTokens : stCfg.thoughtIntervalGens) || (stTokM ? 500  : 2);
                    const intHook  = Number(stTokM ? (stCfg as any).hookIntervalTokens    : stCfg.hookIntervalGens)    || (stTokM ? 1500 : 6);
                    function due(on: boolean, last: number, iv: number): string {
                        if (!on) return 'OFF';
                        const d = stProg - last;
                        return (d >= iv ? 'DUE ' : '    ') + d + '/' + iv + stUnit;
                    }
                    // [POSITION] rel= removed: Position has no cadence of its own, it rides
                    // the eph beat pass. What replaced it is the tier plus whether the target
                    // resolves at all -- the migration outcome that silently injects nothing.
                    out.push('  cadence  eph=' + due(!!c.autoThoughtsEnabled, lastEph, intEph)
                        + '  hook=' + due(!!c.hooksEnabled, lastHook, intHook));
                    const stPos: any = (c as any).position;
                    if (stPos && (stPos.shape || stPos.standing)) {
                        const stTid = String(stPos.targetId || '');
                        const stTier = stTid ? await _ceReadPressure(c.id, 'position_' + stTid) : 0;
                        out.push('  position ' + (String(stPos.targetName || '') || '(unnamed)')
                            + ' id=' + (stTid || 'UNRESOLVED')
                            + ' tier=' + (stTid ? String(stTier) : 'n/a'));
                    }
                }

                const cfv: any = (c as any).customFieldValues || {};
                const pat = _ceCharPatternSlots(c);
                const patName = _ceResolveCharPattern(c); // was its own inline scan
                out.push('  slots    core=' + (cfv['ce_slot_core'] ? 'y' : '-')
                    + ' pursuit=' + (cfv['ce_slot_pursuit'] ? 'y' : '-')
                    + ' pattern=' + (patName || '-')
                    + ' resist=' + (pat.resistance ? 'y' : '-')
                    + ' conduct=' + (pat.conduct ? 'y' : '-'));
                out.push('  pressure hook=t' + (await _ceReadPressure(c.id, 'hook'))
                    + ' pursuit=t' + (await _ceReadPressure(c.id, 'pursuit'))
                    // [EVIDENCE-SURFACE] Last stamped classification, or '-' when the
                    // beat pass produced no usable one. Distinguishes "the model said nothing
                    // moved" from "the reply was malformed", which a tier alone cannot.
                    + ' last=' + (((c.ephemeral as any) && (c.ephemeral as any).pursuitState) || '-'));
                // The snapshot IS the injected content — no snapshot means the two AN
                // lines cannot render no matter how healthy every gate above looks.
                const eph: any = c.ephemeral;
                out.push('  snapshot ' + (eph && (eph.emotionalResponse || eph.immediateDesire)
                    ? ('yes @' + stUnit + ' ' + (eph.generatedAtGen || 0)
                        + ' | intent="' + String(eph.immediateDesire || '').substring(0, 40) + '"')
                    : 'NONE — nothing to inject'));
                out.push('');
            }
            return out.join('\n');
        } catch (eCeSt) {
            return '/ce status failed: ' + ((eCeSt && (eCeSt as any).message) || String(eCeSt));
        }
    }
    if (cmdLower === '/diag' || cmdLower.indexOf('/diag ') === 0) {
        let _diagParts = rawText.split(/\s+/);
        let _diagSub = (_diagParts[1] || 'list').toLowerCase();
        if (_diagSub === 'list') return aeDiagList();
        let _diagFlag = _diagParts[1];
        let _diagState = (_diagParts[2] || '').toLowerCase();
        if (!_diagFlag || (_diagState !== 'on' && _diagState !== 'off')) {
            return 'Usage: /diag list | /diag <flag> on|off\n' + aeDiagList();
        }
        return await aeDiagSet(_diagFlag, _diagState === 'on');
    }
    return null;
}
// ── [DIAG DIAG-CMD-SHARED] end ───────────────────────────────────────────────

// ============================================================================
// SECTION 3c — GENERATION BUDGET CONSTANTS & ENGINE LOCKS
// AE_BUDGET_* token caps and the top-level generation/broadcast locks.
// ============================================================================

// [BUDGET-GATE] EACH DYNAMIC GENERATOR'S DISPATCH GATE MUST EQUAL THAT GENERATOR'S OWN
// max_tokens. A literal that outgrows its gate means the gate admits a call the request
// cannot fit, the JSON truncates mid-object, extractJSON returns nothing and the update is
// skipped with NO error anywhere. This has now happened twice. Named constants so the
// coupling is explicit; grep the constant before touching either number.
// AE_BUDGET_REL deleted with generateRelationshipUpdate.
const AE_BUDGET_EPH  = 260;   // generateEphemeral max_tokens — LOCKSTEP with its literal
// [HOOK-PROMPT] LOCKSTEP WITH BOTH max_tokens LITERALS in generateHookUpdates, for the
// reason AE_BUDGET_EPH states: the dispatch gate is this constant. The spawn reply carries
// four keys including a scaffold sentence; 200 was sized for two.
// [HOOK-ESCALATE] 320: the escalator's reply also rewrites a description sentence.
const AE_BUDGET_HOOK = 320;   // generateHookUpdates max_tokens

// [F-19b] ceComposeOutcome and its budget are DELETED. The roll no longer generates a
// sentence of story -- see the F-19b block above ceRollNow for the whole pivot.

// ── Engine State ──────────────────────────────────────────────────────────────
// ae_lock: probability engine mutex — prevents double-rolling on a single player input.
var ae_lock = false;
var ae_genInFlight = false;  // an editor.generate() is active (cleared in onGenerationEnd)

// Per-story-turn token accumulator for the token-mode dynamic cadence. onResponse sums the
// generated tokenIds across a turn; onGenerationEnd's story path banks the total onto
// STORAGE_TOKEN_COUNT and resets. _aeStoryTurnCid tracks which generation the total belongs
// to so it self-resets on a new continuityId. Chat, wizard and yoink turns all return from
// onResponse before it runs.
var _aeStoryTurnTokens = 0;
var _aeStoryTurnCid: string | null = null;

// ── Editor Yoink generation (budget-free) ────────────────────────────────────
// [vNEXT] The Wizard's chats and field generators must not draw on the script generation
// budget, so instead of api.v1.generate() they hijack the editor generation path (the
// "yoink"): set _yoinkState.active, swap our prompt in via onContextBuilt, capture and
// swallow the output via onResponse, resolve in onGenerationEnd. While active the engine's
// normal context/response/end logic early-returns.
interface AEYoinkState {
    active: boolean;
    messages: any[];
    responseText: string;
    resolve: ((value: string) => void) | null;
    reject: ((reason: any) => void) | null;
    // [YOINK-WATCHDOG] NAI's own per-generation id, captured when a yoink's context is
    // built and checked by onResponse/onGenerationEnd before touching _aeYoink state -- so a
    // late event from a generation the watchdog already abandoned cannot resolve, or corrupt
    // the buffer of, a newer call that has since taken the slot.
    continuityId: string | null;
}
var _aeYoink: AEYoinkState = { active: false, messages: [], responseText: '', resolve: null, reject: null, continuityId: null };

// ============================================================================
// SECTION 3d — WIZARD MODE (classic)
// The modal wizard-mode switch. Mutually exclusive with WIZLIVE (3e).
// ============================================================================

// ── [WIZMODE] Hard wizard mode switch ─────────────────────────────────
// [WIZMODE-CUT] CLASSIC WIZARD MODE IS GONE, along with everything that hung off it: the
// param snapshot and its restore, the deferred-exit flag, the frozen per-chat context and
// five "close the classic wizard first" guards -- all unreachable code guarding a state that
// could not occur. WIZLIVE is the wizard now and owns its own param pin.
// _wizZombieIds SURVIVES AND NEVER BELONGED HERE. The yoink watchdog sets it when it
// force-recovers a stuck generation and two live guards read it; only the name tied it here.
var _wizZombieIds: { [continuityId: string]: boolean } = {};
var AE_WIZARD_MAX_TOKENS = 300; // pinned output cap for WIZLIVE replies────────────────────────────────

// ============================================================================
// SECTION 3e — LIVE WIZARD CHAT (WIZLIVE)
// In-document wizard chat: marker paragraph, decorations, transcript
// persistence. Shares its overall shape with CHARCHAT (3f) but NOT its
// code — see the CE-INDEX note before attempting to unify them.
// ============================================================================

// ── [WIZLIVE] In-document wizard chat ───────────────────────────────────────
// The chat lives IN the story document rather than in a hidden yoink conversation. The user
// talks in { } instruct blocks and presses NAI's own Send, so replies are ordinary
// generations landing in the document -- nothing swallowed, no onResponse capture, no
// watchdog. endLiveWizardChat archives the transcript as a WizardChat record, optionally
// commits notes to Memory, then removes every paragraph from the marker down.
// THE CACHING CONTRACT IS THE DESIGN. The story prefix -- system prompt, memory, lorebook,
// early story text -- is NEVER touched while the chat is live. The only context differences
// on a chat turn are the Author's Note deactivating and the chat paragraphs growing at the
// tail, so ending the chat resumes story generation on a byte-identical top of context.
// Committing to Memory is the single deliberate exception; that is the feature.
interface LiveWizState {
    active: boolean;
    markerId: number | null;        // sectionId of the boundary marker paragraph
    setupIds: number[];             // sectionIds of engine-authored setup paragraphs (excluded from the transcript)
    topicId: string;                // wizard topic supplying the persona; '' = generic live persona
    paramSnapshot: any;             // generationParameters snapshot restored on end (persisted so a reload can still restore)
    startedAt: number;
    sourceEntryId: string | null;   // CE-Chats lorebook entry this chat resumes/overwrites; null = a fresh chat (Save creates a new entry)
    contextEntryIds: string[];      // CE-Chats entries switched forceActivation:true for THIS session; switched back off on end
    title: string;                  // user-facing chat name — defaults to the topic label at start/resume, renameable live; NEVER carries a timestamp
}
var _aeLiveWiz: LiveWizState = { active: false, markerId: null, setupIds: [], topicId: '', paramSnapshot: null, startedAt: 0, sourceEntryId: null, contextEntryIds: [], title: '' };

const AE_WIZLIVE_RULE_MARKER  = 'ae-wizlive-marker';
const AE_WIZLIVE_RULE_USER    = 'ae-wizlive-user';   // Director (instruction) turns — cool blue
const AE_WIZLIVE_RULE_WIZ     = 'ae-wizlive-wiz';    // Wizard replies + setup paragraphs — violet
const AE_WIZLIVE_MARKER_TEXT  = '\u2501\u2501 WIZARD CHAT \u2501\u2501 The story above is reference material. Everything below this line is an out-of-story planning chat and will be removed when the chat ends.';

// [CE-CHATS] Live wizard chats persist to the lorebook, not to a Memory sentinel. One
// keyless entry per saved chat, so it can never activate by keyword -- it enters context
// only while its forceActivation ("Always On") flag is true. That flag IS how a chat or a
// batch generator "chooses" a saved chat as context: on for the session, off when done.
var WIZLIVE_CAT_NAME  = 'CE Chats';
var _aeWizChatCatId: string | null = null;   // module cache of the category id (also mirrored to storyStorage)

async function saveLiveWizState(): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_WIZLIVE, JSON.stringify(_aeLiveWiz)); }
    catch (e) { api.v1.error('[AE:wizlive] state save failed:', e); }
}


// ── CE-Chats lorebook store ─────────────────────────────────────────────────
// Find (or create) the "CE Chats" lorebook category. Cached in module scope and
// mirrored to storyStorage so we usually skip the categories() scan.
async function ensureWizChatCategory(): Promise<string> {
    if (_aeWizChatCatId) return _aeWizChatCatId;
    try {
        let cached = (await api.v1.storyStorage.getOrDefault(STORAGE_WIZLIVE_CAT, '')) as string;
        if (cached) {
            let c = await api.v1.lorebook.category(cached);
            if (c) { _aeWizChatCatId = cached; return cached; }
        }
    } catch (_e0) {}
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).filter(function(c: any) { return (c.name || '') === WIZLIVE_CAT_NAME; })[0];
        if (found) {
            _aeWizChatCatId = found.id;
            try { await api.v1.storyStorage.set(STORAGE_WIZLIVE_CAT, found.id); } catch (_e1) {}
            return found.id;
        }
    } catch (_e2) {}
    let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: WIZLIVE_CAT_NAME, enabled: true });
    _aeWizChatCatId = newId;
    try { await api.v1.storyStorage.set(STORAGE_WIZLIVE_CAT, newId); } catch (_e3) {}
    return newId;
}

// All CE-Chats entries (each is one saved wizard chat), newest lorebook order.
async function listWizChatEntries(): Promise<any[]> {
    try { let cat = await ensureWizChatCategory(); return (await api.v1.lorebook.entries(cat)) || []; }
    catch (e) { api.v1.error('[AE:wizlive] listWizChatEntries:', e); return []; }
}

// Serialize a transcript into a round-trippable block. The header line carries the title and
// optionally the source topic, so a resume restores the right persona. Turns are
// "Director:"/"Wizard:" prefixed -- the shape the chat already reads as context when Always
// On. The [saved:...] stamp rides the HEADER only; the entry's name never carries a date.
function serializeChatTranscript(title: string, msgs: WizardChatMessage[], topicId: string): string {
    let head = '=== ' + (title || 'Wizard Chat') + (topicId ? ' [topic:' + topicId + ']' : '') + ' [saved:' + new Date().toLocaleString() + ']' + ' ===';
    let parts: string[] = [head, ''];
    for (let i = 0; i < msgs.length; i++) {
        let m = msgs[i];
        parts.push((m.role === 'user' ? 'Director: ' : 'Wizard: ') + m.content);
        parts.push('');
    }
    return parts.join('\n').replace(/\s+$/, '');
}

// Inverse of serializeChatTranscript. String-parsed (no bracket-bearing regex) so the
// engine brace-balance check stays meaningful. Lines before the first role header are
// ignored; a role line starts a turn, and following lines accrue to it until the next
// role header — so multi-line wizard replies survive the round trip.
function parseChatTranscript(text: string): { title: string; topicId: string; msgs: WizardChatMessage[] } {
    let title = ''; let topicId = '';
    let lines = String(text || '').split('\n');
    let msgs: WizardChatMessage[] = [];
    let cur: WizardChatMessage | null = null;
    for (let i = 0; i < lines.length; i++) {
        let line = lines[i];
        let t = line.trim();
        if (t.length >= 6 && t.indexOf('===') === 0 && t.lastIndexOf('===') === t.length - 3) {
            let inner = t.substring(3, t.length - 3).trim();
            let tp = inner.indexOf('[topic:');
            if (tp >= 0) {
                let close = inner.indexOf(']', tp);
                if (close > tp) {
                    topicId = inner.substring(tp + 7, close).trim();
                    inner = (inner.substring(0, tp) + inner.substring(close + 1)).trim();
                }
            }
            // Strip the [saved:...] stamp too — it is metadata, never part of the title.
            let sp = inner.indexOf('[saved:');
            if (sp >= 0) {
                let sclose = inner.indexOf(']', sp);
                if (sclose > sp) inner = (inner.substring(0, sp) + inner.substring(sclose + 1)).trim();
            }
            title = inner;
            continue;
        }
        let role: 'user' | 'assistant' | null = null;
        let rest = '';
        if (line.indexOf('Director:') === 0) { role = 'user'; rest = line.substring(9); }
        else if (line.indexOf('Wizard:') === 0) { role = 'assistant'; rest = line.substring(7); }
        if (role) {
            if (cur) msgs.push(cur);
            if (rest.charAt(0) === ' ') rest = rest.substring(1);
            cur = { role: role, content: rest };
        } else if (cur) {
            cur.content += '\n' + line;
        }
    }
    if (cur) msgs.push(cur);
    let outM: WizardChatMessage[] = [];
    for (let k = 0; k < msgs.length; k++) {
        let c = msgs[k].content.replace(/^\s+/, '').replace(/\s+$/, '');
        if (c.length > 0) outM.push({ role: msgs[k].role, content: c });
    }
    return { title: title, topicId: topicId, msgs: outM };
}

// Create-or-overwrite a CE-Chats entry. sourceEntryId (when it still exists) is
// overwritten in place; otherwise a fresh keyless, forceActivation:false entry is made.
async function upsertChatEntry(sourceEntryId: string | null, title: string, msgs: WizardChatMessage[], topicId: string): Promise<string> {
    let cat = await ensureWizChatCategory();
    let text = serializeChatTranscript(title, msgs, topicId);
    if (sourceEntryId) {
        let existing: any = null;
        try { existing = await api.v1.lorebook.entry(sourceEntryId); } catch (_e) {}
        if (existing) {
            await api.v1.lorebook.updateEntry(sourceEntryId, { text: text, displayName: title, category: cat });
            return sourceEntryId;
        }
    }
    let id = api.v1.uuid();
    let newId = await api.v1.lorebook.createEntry({ id: id, category: cat, displayName: title, text: text, keys: [], enabled: true, forceActivation: false, hidden: false });
    return newId || id;
}

// Flip forceActivation ("Always On") for a set of entries. Turning entries on is a
// deliberate top-of-context change (like the old Memory commit was); it happens once
// at chat start and reverts once at chat end, so all turns WITHIN a chat stay
// byte-identical and the prefix cache survives the session.
async function setContextEntriesActivation(ids: string[], on: boolean): Promise<void> {
    for (let i = 0; i < ids.length; i++) {
        try { await api.v1.lorebook.updateEntry(ids[i], { forceActivation: on }); }
        catch (e) { api.v1.error('[AE:wizlive] context toggle failed:', e); }
    }
}

// ── Decorations: split Director (blue) vs Wizard (violet) ───────────────────
// Registered once with empty user/wiz scopes; refreshLiveWizDecorations recomputes
// the two id sets from the live document (called on start, restore, and each turn end).
async function _wizliveRegisterDecorations(markerId: number): Promise<void> {
    await api.v1.editor.decorations.registerRules([
        { id: AE_WIZLIVE_RULE_MARKER, type: 'node', match: '^', style: { backgroundColor: 'rgba(147, 112, 219, 0.22)', borderTop: '2px solid rgba(147, 112, 219, 0.85)', borderBottom: '1px solid rgba(147, 112, 219, 0.4)' }, scope: { sectionIds: [markerId] } },
        { id: AE_WIZLIVE_RULE_USER,   type: 'node', match: '^', style: { backgroundColor: 'rgba(74, 158, 217, 0.10)', borderLeft: '3px solid rgba(74, 158, 217, 0.60)' }, scope: { sectionIds: [] } },
        { id: AE_WIZLIVE_RULE_WIZ,    type: 'node', match: '^', style: { backgroundColor: 'rgba(147, 112, 219, 0.07)', borderLeft: '3px solid rgba(147, 112, 219, 0.45)' }, scope: { sectionIds: [] } }
    ]);
}

async function refreshLiveWizDecorations(): Promise<void> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return;
    let all: any[] = [];
    try { all = await api.v1.document.scan(); } catch (_eScan) { return; }
    let userIds: number[] = [];
    let wizIds: number[] = [];
    let seen = false;
    for (let idx = 0; idx < all.length; idx++) {
        let row = all[idx];
        if (row.sectionId === _aeLiveWiz.markerId) { seen = true; continue; }
        if (!seen) continue;
        // Engine-authored setup (protocol/greeting) reads as the wizard side.
        if (_aeLiveWiz.setupIds.indexOf(row.sectionId) >= 0) { wizIds.push(row.sectionId); continue; }
        let isUser = row.section.source === 'instruction';
        if (!isUser) {
            let org = row.section.origin || [];
            if (org.length > 0) {
                let allTyped = true;
                let anyUser = false;
                for (let o of org) {
                    if (o.data === 'user') anyUser = true;
                    if (o.data !== 'user' && o.data !== 'edit') { allTyped = false; break; }
                }
                isUser = allTyped && anyUser;
            }
        }
        if (isUser) userIds.push(row.sectionId); else wizIds.push(row.sectionId);
    }
    try {
        await api.v1.editor.decorations.updateRules([
            { id: AE_WIZLIVE_RULE_USER, scope: { sectionIds: userIds } },
            { id: AE_WIZLIVE_RULE_WIZ,  scope: { sectionIds: wizIds } }
        ]);
    } catch (e) { aeLog('[AE:wizlive] decoration refresh failed (cosmetic only):', e); }
}

// Build the persona + protocol paragraphs shared by start and resume.
function _wizliveProtocolText(cfg: GlobalConfig, topicId: string): string {
    let topic = topicId ? getWizardTopic(cfg, topicId) : null;
    let persona = topic ? topic.instructions : 'You are a warm, collaborative worldbuilding assistant helping the user develop their story. Write in pure prose \u2014 no markdown, bolding, headers, or lists. Offer one or two concrete suggestions that push the idea forward and ask exactly ONE focused question per turn. Typically respond in 2-5 sentences.';
    let protoParts: string[] = [];
    protoParts.push('WIZARD CHAT MODE. ' + persona);
    protoParts.push('The user speaks in instruction blocks like this one. Reply to their newest instruction in plain conversational prose \u2014 do NOT continue the story itself. The story text above the chat marker is reference material you may draw on.');
    if (cfg.projectName || cfg.projectGenre || cfg.projectConcept) {
        let pj: string[] = [];
        if (cfg.projectName) pj.push('Project: ' + cfg.projectName);
        if (cfg.projectGenre) pj.push('Genre: ' + cfg.projectGenre);
        if (cfg.projectConcept) pj.push('Concept: ' + cfg.projectConcept);
        protoParts.push(pj.join('. ') + '.');
    }
    return protoParts.join(' ');
}

async function startLiveWizardChat(topicId: string, ctxEntryIds?: string[]): Promise<void> {
    if (_aeLiveWiz.active) { api.v1.ui.toast('A wizard chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is open in the story \u2014 end it first.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active) { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let cfg = await loadConfig();
    let topic = topicId ? getWizardTopic(cfg, topicId) : null;
    let protoText = _wizliveProtocolText(cfg, topicId);
    let greeting = (topic && (topic as any).seedMessage && String((topic as any).seedMessage).trim())
        ? String((topic as any).seedMessage).trim()
        // [WIZLIVE-BRACE-WRAP] No longer tells the user to type
        // [WIZLIVE-BRACE-WRAP] The greeting does not ask the user to type a brace:
        // _wizliveNormalizeDocument wraps a Director turn after every reply.
        : 'I\u2019m listening \u2014 write your message in a new paragraph, then press Send.';

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs([
        { text: AE_WIZLIVE_MARKER_TEXT, source: 'instruction' },
        { text: protoText, source: 'instruction' },
        { text: greeting }
    ]);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length === 0) { api.v1.ui.toast('Could not start the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_WIZARD_MAX_TOKENS });
    } catch (eP) { aeLog('[AE:wizlive] param pin failed, continuing without pin:', eP); snap = null; }

    let ctx = Array.isArray(ctxEntryIds) ? ctxEntryIds.slice() : [];
    let startTitle = (topic && topic.label) ? topic.label : 'General Worldbuilding';
    _aeLiveWiz = { active: true, markerId: markerId, setupIds: added.slice(1), topicId: topicId || '', paramSnapshot: snap, startedAt: Date.now(), sourceEntryId: null, contextEntryIds: ctx, title: startTitle };
    _wlLastSeenSectionCount = -1;   // [WIZ-SETTLE] fresh session, no baseline yet
    await saveLiveWizState();

    if (ctx.length > 0) {
        try { await setContextEntriesActivation(ctx, true); }
        catch (eCtx) { api.v1.error('[AE:wizlive] context activation failed:', eCtx); }
    }

    try { await _wizliveRegisterDecorations(markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration registration failed (cosmetic only):', eD); }

    // [WIZ-TRAY] The tray triple is the ONLY chrome a live wizard chat has —
    // _ceWizChatCloseShell closes the modal on start by design. ceSyncToolbar is a change
    // detector, so these calls are cheap and idempotent.
    try { await ceSyncToolbar(); } catch (_eTb) {}
    api.v1.ui.toast('Wizard chat open \u2014 talk in { } instruct blocks below the marker, then press Send.', { type: 'info', autoClose: 6000 });
}

// Pull a saved chat back into the story and go live on it. The entry it came from is
// held as sourceEntryId so Save & Close overwrites that same entry.
async function resumeLiveWizardChatFromEntry(entryId: string): Promise<void> {
    if (_aeLiveWiz.active) { api.v1.ui.toast('A wizard chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is open in the story \u2014 end it first.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active) { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let entry: any = null;
    try { entry = await api.v1.lorebook.entry(entryId); } catch (_e) {}
    if (!entry || !entry.text) { api.v1.ui.toast('Could not load that saved chat.', { type: 'error', autoClose: 4000 }); return; }
    let parsed = parseChatTranscript(entry.text);
    if (parsed.msgs.length === 0) { api.v1.ui.toast('That saved chat is empty.', { type: 'warning', autoClose: 3000 }); return; }

    let cfg = await loadConfig();
    let protoText = _wizliveProtocolText(cfg, parsed.topicId);

    // marker + protocol, then one paragraph per turn (user turns rebuilt as { } instruct blocks).
    let paras: any[] = [
        { text: AE_WIZLIVE_MARKER_TEXT, source: 'instruction' },
        { text: protoText, source: 'instruction' }
    ];
    for (let i = 0; i < parsed.msgs.length; i++) {
        let m = parsed.msgs[i];
        if (m.role === 'user') {
            // [WIZLIVE-BRACE-DOUBLE] Rebuild a Director turn in the SAME bare form the write
            // pass produces -- "Director: body", source:'instruction', no literal brace. A
            // '{ body }' wrap re-introduces the double brace and drops the label, so a resumed
            // chat would read differently from a live-typed one. Header-strip guards a saved
            // body that still carries the prefix.
            let wlRB = _wizliveStripDirectorHeader(_wizliveStripBraces(m.content.replace(/\n+/g, ' ').trim()));
            paras.push({ text: 'Director: ' + wlRB, source: 'instruction' });
        } else {
            let chunks = m.content.split('\n');
            for (let j = 0; j < chunks.length; j++) {
                let c = chunks[j].replace(/^\s+/, '').replace(/\s+$/, '');
                if (c.length > 0) paras.push({ text: c });
            }
        }
    }

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs(paras);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length < 2) { api.v1.ui.toast('Could not insert the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];
    let protocolId = added[1];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_WIZARD_MAX_TOKENS });
    } catch (eP) { aeLog('[AE:wizlive] param pin failed, continuing without pin:', eP); snap = null; }

    let resumeTitle = (parsed.title || '').trim() || ((getWizardTopic(cfg, parsed.topicId) || {} as any).label) || 'General Worldbuilding';
    _aeLiveWiz = { active: true, markerId: markerId, setupIds: [protocolId], topicId: parsed.topicId || '', paramSnapshot: snap, startedAt: Date.now(), sourceEntryId: entryId, contextEntryIds: [], title: resumeTitle };
    _wlLastSeenSectionCount = -1;   // [WIZ-SETTLE] resumed session, no baseline yet
    await saveLiveWizState();

    try { await _wizliveRegisterDecorations(markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration registration failed (cosmetic only):', eD); }

    try { await ceSyncToolbar(); } catch (_eTb) {}   // [WIZ-TRAY]
    api.v1.ui.toast('Chat resumed in the story \u2014 continue below the marker. Save & Close overwrites this saved chat.', { type: 'info', autoClose: 6000 });
}

function _wizliveStripBraces(t: string): string {
    let s = (t || '').trim();
    if (s.length >= 2 && s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') s = s.substring(1, s.length - 1).trim();
    return s;
}

// [WIZLIVE-BRACE-DOUBLE] Strip a leading "Director:" label from a turn body so the canon pass
// stays idempotent: a braceless canon that left the label in grew "Director: Director: ..." on
// every reopen. Mirrors _charchatStripHeader (fixed label, tolerates **bold**, tabs and a
// full-width colon; two passes for a "Director:\nDirector:" split). Role is never inferred
// from text -- _wizliveRowIsUser already classified this row.
function _wizliveStripDirectorHeader(body: string): string {
    let wlT = (body || '').replace(/^\s+/, '');
    let wlRx = new RegExp('^\\*{0,2}Director\\*{0,2}[ \\t]*[:\uff1a]\\s*', 'i');
    for (let wlPass = 0; wlPass < 2; wlPass++) {
        if (wlRx.test(wlT)) wlT = wlT.replace(wlRx, '');
        else break;
    }
    return wlT;
}

// ONE SHARED CLASSIFIER, not a per-caller copy (the same call already made for CharChat's
// _charchatRowIsPov). ROLE IS NEVER INFERRED FROM TEXT: instruction-source paragraphs are
// Director turns, and so is a paragraph whose origin metadata is entirely user/edit-typed
// (they did not use braces this time).
function _wizliveRowIsUser(section: any): boolean {
    if (section.source === 'instruction') return true;
    let wlOrg = section.origin || [];
    if (wlOrg.length === 0) return false;
    let wlAllTyped = true;
    let wlAnyUser = false;
    for (let wlO of wlOrg) {
        if (wlO.data === 'user') wlAnyUser = true;
        if (wlO.data !== 'user' && wlO.data !== 'edit') { wlAllTyped = false; break; }
    }
    return wlAllTyped && wlAnyUser;
}

// [WIZLIVE-MERGE] ROOT CAUSE of "wizard user messages not automatically wrapped": when a
// Director turn is typed with no trailing paragraph break, NAI's native Send continues the
// Wizard reply INTO that same paragraph. The merged section's origin then spans a user-typed
// head and an ai-generated tail, so _wizliveRowIsUser sees 'ai'/'prompt' and returns FALSE --
// the turn stops being a Director turn and is never wrapped or stamped. CharChat does not
// have this problem because it splits the glued paragraph first.
// Returns the offset where the AI-authored portion begins, or -1 if the origin is homogeneous.
// Byte-for-byte the logic of _charchatMergeSplitIdx.
function _wizliveMergeSplitIdx(section: any): number {
    let wlOrg = (section && section.origin) || [];
    if (wlOrg.length < 2) return -1;
    let wlSorted = wlOrg.slice().sort(function(a: any, b: any) { return a.position - b.position; });
    let wlSawUser = false;
    for (let wlO of wlSorted) {
        if (wlO.data === 'user' || wlO.data === 'edit') { wlSawUser = true; continue; }
        if (wlSawUser && (wlO.data === 'ai' || wlO.data === 'prompt')) return wlO.position;
    }
    return -1;
}

// WRITE-PASS ONLY, from _wizliveNormalizeDocument at onGenerationEnd -- never the read-only
// side, which must not mutate the document and which also runs on dryRun.
// Physically splits any Director paragraph NAI glued a Wizard reply onto: the user-typed head
// keeps the original sectionId, and the AI tail becomes a fresh paragraph via
// insertParagraphAfter with no source override, since script-written text gets 'script' origin
// which _wizliveRowIsUser reads as NOT a Director turn. Runs BEFORE the wrap loop.
// [WIZ-TRAILBREAK] Mirrors _charchatEnsureTrailingBreak. scan() with from/to pinned to one id
// reads exactly that section -- there is no api.v1.document.section(id) accessor.
async function _wizliveEnsureTrailingBreak(): Promise<void> {
    let wlIds = await api.v1.document.sectionIds();
    if (wlIds.length) {
        let wlLastId = wlIds[wlIds.length - 1];
        let wlRows = await api.v1.document.scan(undefined, { from: wlLastId, to: wlLastId });
        let wlLast = (wlRows && wlRows.length) ? wlRows[wlRows.length - 1].section : null;
        if (wlLast && String((wlLast.text || '')).trim() === '') return;   // already have one
    }
    await api.v1.document.appendParagraph({ text: '' });
}

// [WIZ-SETTLE] ONE PASS, FACTORED OUT so the outer function can run it more than
// once — mirrors _charchatSplitMergedSectionsPass.
async function _wizliveSplitMergedSectionsPass(): Promise<number> {
    let wlAll: any[] = [];
    try { wlAll = await api.v1.document.scan(); }
    catch (eSc) { api.v1.error('[AE:wizlive] merge-split scan failed:', eSc); return 0; }
    let wlSeen = false;
    let wlCount = 0;
    for (let wlR of wlAll) {
        if (wlR.sectionId === _aeLiveWiz.markerId) { wlSeen = true; continue; }
        if (!wlSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wlR.sectionId) >= 0) continue;
        wlCount++;
        let wlFull = wlR.section.text || '';
        let wlIdx = _wizliveMergeSplitIdx(wlR.section);
        if (wlIdx <= 0 || wlIdx >= wlFull.length) continue;
        let wlHead = wlFull.substring(0, wlIdx);
        let wlTail = wlFull.substring(wlIdx);
        try {
            await api.v1.document.insertParagraphAfter(wlR.sectionId, { text: wlTail });
            await api.v1.document.updateParagraph(wlR.sectionId, { text: wlHead });
        } catch (eSp) { api.v1.error('[AE:wizlive] merge-split failed for section ' + wlR.sectionId + ':', eSp); }
    }
    return wlCount;
}

// [WIZ-SETTLE] THE SPLIT NEEDS A SETTLE POLL OR IT FIRES INTERMITTENTLY AND READS AS RANDOM.
// MEASURED (CharChat's autopsy, applying unchanged here): two scans 150ms apart can BOTH
// report the same too-low section count because NAI had not started writing yet, so "did the
// count change" cannot distinguish settled from not-started. Poll against EXPECTED growth
// instead (last known count + 2: the Director paragraph plus a reply), bounded so a genuinely
// failed turn does not poll forever. Shares CC_SETTLE_MAX_PASSES / CC_SETTLE_SLEEP_MS -- the
// two chats sit on the same editor and the numbers have no reason to diverge.
var _wlLastSeenSectionCount: number = -1;
async function _wizliveSplitMergedSections(): Promise<void> {
    if (_aeLiveWiz.markerId === null) return;
    let wlExpectMin = (_wlLastSeenSectionCount >= 0) ? (_wlLastSeenSectionCount + 2) : -1;
    let wlSeenN = await _wizliveSplitMergedSectionsPass();
    let wlPass = 1;
    while (wlExpectMin >= 0 && wlSeenN < wlExpectMin && wlPass < CC_SETTLE_MAX_PASSES) {
        try { await api.v1.timers.sleep(CC_SETTLE_SLEEP_MS); } catch (_eSl) {}
        wlSeenN = await _wizliveSplitMergedSectionsPass();
        wlPass++;
    }
    _wlLastSeenSectionCount = wlSeenN;
}

// [WIZLIVE-BRACE-WRAP] Rewrites every Director turn in the live document to "Director: body"
// -- bare, source:'instruction', NO LITERAL BRACE -- so the user never types one. NAI renders
// its own brace around an instruction paragraph, so a literal wrap is a SECOND brace and
// re-bakes "{ {Director: ...} }" on every reopen; the read-side twin
// (_wizliveCanonicalStoryOverride) and the resume path use the same bare form. Old stories
// self-migrate: "{Director: body}" strips to "body" and re-canons bare, idempotent after.
// WRITE-PASS ONLY, from onGenerationEnd. Mutating the document mid-context-build would race
// the generation currently building against it.
// THE LABEL IS THE FIXED LITERAL "Director" -- WIZLIVE has no per-user name, and this matches
// the prefixes serializeChatTranscript already uses for the saved transcript.
async function _wizliveNormalizeDocument(): Promise<void> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return;
    // [WIZLIVE-MERGE] Split any Director paragraph NAI glued a Wizard reply onto BEFORE
    // scanning, so the wrap loop sees a clean user-only section rather than a merged one
    // _wizliveRowIsUser rejects. Same split-before-normalise ordering CharChat uses.
    try { await _wizliveSplitMergedSections(); } catch (eMs) { aeLog('[AE:wizlive] merge-split pass failed (non-fatal):', eMs); }
    let wlAll: any[] = [];
    try { wlAll = await api.v1.document.scan(); }
    catch (eWs) { api.v1.error('[AE:wizlive] turn scan failed:', eWs); return; }
    let wlSeen = false;
    let wlRunOpen = false;   // [WIZ-TURNGROUP] is the previous chat section a Director turn?
    let wlUpdates: { sectionId: number; section: any }[] = [];
    for (let wlR of wlAll) {
        if (wlR.sectionId === _aeLiveWiz.markerId) { wlSeen = true; continue; }
        if (!wlSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wlR.sectionId) >= 0) continue;
        // [WIZ-TURNGROUP] A RUN OF DIRECTOR PARAGRAPHS IS ONE TURN. Stamping each paragraph
        // independently made a two-paragraph direction two turns to the model and two headers
        // on screen. Tracked with a flag rather than turn objects: WIZLIVE writes each section
        // back in place and has no join step, so grouping is just "was the previous chat
        // section also a Director turn".
        if (!_wizliveRowIsUser(wlR.section)) { wlRunOpen = false; continue; }
        let wlTxt = (wlR.section.text || '');
        if (!wlTxt.trim()) continue;
        let wlBody = _wizliveStripDirectorHeader(_wizliveStripBraces(wlTxt));
        if (!wlBody) continue;
        let wlFirst = !wlRunOpen;
        wlRunOpen = true;
        // [WIZLIVE-BRACE-DOUBLE] Bare "Director: body", source:'instruction' stamped as we
        // rewrite; the stamp carries turn identity now the literal brace is gone. Re-stamp
        // even when the text matches, to migrate a turn an older build left un-instruction'd.
        let wlCanon = wlFirst ? ('Director: ' + wlBody) : wlBody;
        if (wlCanon !== wlR.section.text || wlR.section.source !== 'instruction') {
            wlUpdates.push({ sectionId: wlR.sectionId, section: { text: wlCanon, source: 'instruction' } });
        }
    }
    if (wlUpdates.length > 0) {
        try { await api.v1.document.updateParagraphs(wlUpdates); }
        catch (eWu) { aeLog('[AE:wizlive] brace-wrap rewrite failed (cosmetic only):', eWu); }
    }
}

// [WIZLIVE-INSTRUCTION] THE ONLY PLACE AN INSTRUCTION IS RELIABLY OBEYED IS THE TRUE BOTTOM
// of context, immediately before the generation point (CharChat learned this across four
// versions). WIZLIVE's protocol paragraph sits inside storyText at whatever depth NAI's budget
// trims it to, so it drifts upward as the chat grows and is progressively ignored. That
// paragraph is still the USER's framing; the MODEL's steering comes from here. Mirrors
// buildCharChatInstruction's four concerns: task, role, format, anti-impersonation.
function buildWizardChatInstruction(): string {
    let wlOut: string[] = [];
    // Task + anti-impersonation. "Director" is named explicitly because the model can still
    // see the instruction-brace shape of Director turns after a header strip, and naming the
    // role it must not produce is the cheapest anti-impersonation clause.
    wlOut.push('[ Instruction: Write the Wizard\u2019s next reply to the Director\u2019s latest message. '
             + 'Reply in conversational prose \u2014 do NOT continue the story text above the chat marker. '
             + 'Write ONLY the Wizard\u2019s response. Never write a "Director:" turn or any text on the Director\u2019s behalf. ]');
    // Format constraint: same "no markdown" rubric the protocol text carries, restated here
    // because it is far more effective at the bottom of context than in a setup paragraph.
    wlOut.push('[ Write in pure prose. No markdown, no bolding, no headers, no bullet lists. ]');
    return wlOut.join('\n');
}

// [WIZLIVE-BRACE-WRAP-T1] The read-only twin, so a Director turn is canonical to the model on
// the SAME turn it is typed rather than one turn later. [WIZLIVE-CTX-STRIP] It also strips the
// "Director:" header from the model's view, leaving plain body text inside NAI's instruction
// brace -- the structural anti-impersonation fix. The DOCUMENT keeps "Director: body".
// SURGICAL, NOT CHARCHAT'S FULL REBUILD, AND THAT IS THE INVARIANT. CharChat rebuilds its
// whole region and diverges from the raw document at the TOP of it, which it can afford
// because it owns its prefix. WIZLIVE must not: its whole design is that the prefix AND the
// live document text reach the model byte-identical to a story turn, so the cache survives the
// chat. So this takes a COPY of params.storyText.content and rewrites ONLY the Director turns
// still unwrapped in the document -- normally just the newest, which is new text anyway.
// SAFETY OF THE IN-PLACE REPLACE: the search is anchored PAST the marker and advances a
// forward cursor in document order, so a short body cannot collide with earlier prose. A
// trimmed marker or a whitespace shift skips that turn and leaves it raw -- degrading to the
// one-turn lag, never worse. The DOCUMENT is not mutated here.
async function _wizliveCanonicalStoryOverride(params: any): Promise<string | null> {
    if (!_aeLiveWiz.active || _aeLiveWiz.markerId === null) return null;
    let wcStory = (params && params.storyText && params.storyText.content) ? params.storyText.content : '';
    if (!wcStory) return null;
    let wcMarkIdx = wcStory.indexOf(AE_WIZLIVE_MARKER_TEXT);
    if (wcMarkIdx < 0) return null;   // chat region trimmed out of budget — leave story text as NAI trimmed it
    let wcFrom = wcMarkIdx + AE_WIZLIVE_MARKER_TEXT.length;

    let wcAll: any[] = [];
    try { wcAll = await api.v1.document.scan(); }
    catch (eWc) { api.v1.error('[AE:wizlive] canonical scan failed \u2014 story text left raw this turn:', eWc); return null; }

    let wcSeen = false;
    let wcChanged = false;
    for (let wcR of wcAll) {
        if (wcR.sectionId === _aeLiveWiz.markerId) { wcSeen = true; continue; }
        if (!wcSeen) continue;
        if (_aeLiveWiz.setupIds.indexOf(wcR.sectionId) >= 0) continue;
        if (!_wizliveRowIsUser(wcR.section)) continue;   // only Director turns get wrapped; Wizard replies pass through untouched
        let wcRaw = (wcR.section.text || '');
        if (!wcRaw.trim()) continue;
        // [WIZLIVE-BRACE-DOUBLE] Bare, header-led form matching the write pass.
        // [WIZLIVE-CTX-STRIP] The model's view strips the "Director:" header entirely: a model
        // that never sees it in the transcript has no prefix to continue when it wants to take
        // the user's next turn. The DOCUMENT keeps it; the write pass is unchanged.
        let wcBody = _wizliveStripDirectorHeader(_wizliveStripBraces(wcRaw));
        if (!wcBody) continue;
        if (wcBody === wcRaw) continue;                   // already bare in the document — model already sees it right
        let wcIdx = wcStory.indexOf(wcRaw, wcFrom);       // anchored past the marker, advancing in document order
        if (wcIdx < 0) continue;                          // trimmed / whitespace-shifted — degrade to raw (no worse than pre-fix)
        wcStory = wcStory.substring(0, wcIdx) + wcBody + wcStory.substring(wcIdx + wcRaw.length);
        wcFrom = wcIdx + wcBody.length;
        wcChanged = true;
    }
    return wcChanged ? wcStory : null;
}

// Walk the document from the marker down and rebuild the conversation. Role mapping:
// instruction-source paragraphs are user turns (NAI's { } instruct blocks); anything
// whose origin metadata is entirely user/edit-typed is also treated as a user turn
// (they forgot the braces); everything else is the wizard. Consecutive wizard
// paragraphs merge into one turn. Engine-authored setup paragraphs are excluded.
async function collectLiveWizTranscript(): Promise<{ msgs: WizardChatMessage[]; ids: number[] }> {
    let out: WizardChatMessage[] = [];
    let ids: number[] = [];
    if (_aeLiveWiz.markerId === null) return { msgs: out, ids: ids };
    let all = await api.v1.document.scan();
    let seen = false;
    for (let row of all) {
        if (row.sectionId === _aeLiveWiz.markerId) { seen = true; ids.push(row.sectionId); continue; }
        if (!seen) continue;
        ids.push(row.sectionId);
        if (_aeLiveWiz.setupIds.indexOf(row.sectionId) >= 0) continue;
        let txt = (row.section.text || '').trim();
        if (!txt) continue;
        let isUser = _wizliveRowIsUser(row.section);
        if (isUser) {
            out.push({ role: 'user', content: _wizliveStripBraces(txt) });
        } else if (out.length > 0 && out[out.length - 1].role === 'assistant') {
            out[out.length - 1].content += '\n' + txt;
        } else {
            out.push({ role: 'assistant', content: txt });
        }
    }
    return { msgs: out, ids: ids };
}

// Run one distillation pass over the live transcript and RETURN the text without
// committing anything. The modal shows it as an editable preview the user can then
// save to the lorebook (or ignore). Replaces the old auto-commit "summarize" action.
async function previewSummarizeLiveChat(): Promise<string> {
    let collected = await collectLiveWizTranscript();
    if (collected.msgs.length === 0) return '';
    let sTranscript = collected.msgs.map(function(m) { return (m.role === 'user' ? 'USER: ' : 'WIZARD: ') + m.content; }).join('\n');
    let sOut = await executeYoinkGeneration([
        { role: 'system', content: 'Distill the following worldbuilding chat into dense, declarative canon statements suitable for a lorebook entry. Keep only established facts and decisions \u2014 drop questions, hedges, and conversational filler. Write in pure prose or short single-line statements. No markdown, no headers, no bullet lists. Be concise.' },
        { role: 'user', content: sTranscript }
    ], { tag: 'liveWizSummarize' });
    return (sOut || '').trim();
}

async function endLiveWizardChat(action: string): Promise<void> {
    if (!_aeLiveWiz.active) { api.v1.ui.toast('No wizard chat is open.', { type: 'warning', autoClose: 2500 }); return; }
    let act = (action === 'discard') ? 'discard' : 'save';

    let collected = await collectLiveWizTranscript();
    let msgs = collected.msgs;

    // Save FIRST, destroy LAST — a save failure returns early leaving the chat intact
    // in the document, so nothing is ever lost to a half-completed end.
    if (act === 'save' && msgs.length > 0) {
        try {
            let title = (_aeLiveWiz.title || '').trim() || 'Wizard Chat';
            await upsertChatEntry(_aeLiveWiz.sourceEntryId, title, msgs, _aeLiveWiz.topicId);
            api.v1.ui.toast('Chat saved to the CE Chats lorebook.', { type: 'success', autoClose: 3000 });
        } catch (eS) {
            api.v1.error('[AE:wizlive] lorebook save failed:', eS);
            api.v1.ui.toast('Save failed \u2014 the chat is still in your document, nothing was removed.', { type: 'error', autoClose: 5000 });
            return;
        }
    }

    // Switch this session's context entries back off so story mode returns to its exact
    // pre-chat prefix (preserving the story-generation cache).
    if (_aeLiveWiz.contextEntryIds && _aeLiveWiz.contextEntryIds.length > 0) {
        try { await setContextEntriesActivation(_aeLiveWiz.contextEntryIds, false); }
        catch (eCtx) { api.v1.error('[AE:wizlive] context deactivation failed:', eCtx); }
    }

    // Remove the chat region, marker included, in one call.
    try {
        if (collected.ids.length > 0) await api.v1.document.removeParagraphs(collected.ids);
    } catch (eR) { api.v1.error('[AE:wizlive] paragraph removal failed \u2014 clean up manually from the marker down:', eR); }

    try { api.v1.editor.decorations.removeRules([AE_WIZLIVE_RULE_MARKER, AE_WIZLIVE_RULE_USER, AE_WIZLIVE_RULE_WIZ]); } catch (_eDr) {}

    // Restore pinned generation params (same field-by-field shape as the WIZMODE restore).
    if (_aeLiveWiz.paramSnapshot) {
        try {
            let ps: any = _aeLiveWiz.paramSnapshot;
            let r: any = { model: ps.model };
            if (ps.max_tokens !== undefined) r.max_tokens = ps.max_tokens;
            if (ps.temperature !== undefined) r.temperature = ps.temperature;
            if (ps.top_p !== undefined) r.top_p = ps.top_p;
            if (ps.top_k !== undefined) r.top_k = ps.top_k;
            if (ps.frequency_penalty !== undefined) r.frequency_penalty = ps.frequency_penalty;
            if (ps.presence_penalty !== undefined) r.presence_penalty = ps.presence_penalty;
            if (ps.min_p !== undefined) r.min_p = ps.min_p;
            await api.v1.generationParameters.update(r);
        } catch (eRe) { api.v1.error('[AE:wizlive] param restore failed:', eRe); }
    }

    _aeLiveWiz = { active: false, markerId: null, setupIds: [], topicId: '', paramSnapshot: null, startedAt: 0, sourceEntryId: null, contextEntryIds: [], title: '' };
    _wlLastSeenSectionCount = -1;   // [WIZ-SETTLE] chat closed, clear the stale baseline
    try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_eRm) {}
    try { await ceSyncToolbar(); } catch (_eTb) {}   // [WIZ-TRAY]
    api.v1.ui.toast('Wizard chat closed \u2014 story mode restored.', { type: 'success', autoClose: 3000 });
}

// Startup rehydration: a chat left open in this story (script reload, tab close)
// comes back live IF its marker paragraph still exists; otherwise the stale state
// is cleared and any pinned params restored from the persisted snapshot. Context
// entries stay Always-On across a reload (lorebook state is story-scoped and
// persistent) and are only switched off when the chat is finally ended.
async function restoreLiveWizOnStartup(): Promise<void> {
    let raw = '';
    try { raw = (await api.v1.storyStorage.getOrDefault(STORAGE_WIZLIVE, '')) as string; } catch (_e0) {}
    if (!raw) return;
    let st: any = null;
    try { st = JSON.parse(raw); } catch (_e1) { st = null; }
    if (!st || !st.active || typeof st.markerId !== 'number') {
        try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_e2) {}
        return;
    }
    let ids: number[] = [];
    try { ids = await api.v1.document.sectionIds(); } catch (_e3) {}
    if (ids.indexOf(st.markerId) < 0) {
        if (st.paramSnapshot) {
            try {
                let rp: any = { model: st.paramSnapshot.model };
                if (st.paramSnapshot.max_tokens !== undefined) rp.max_tokens = st.paramSnapshot.max_tokens;
                await api.v1.generationParameters.update(rp);
            } catch (_e4) {}
        }
        // Stale marker: make sure any leftover Always-On context entries are switched off.
        if (Array.isArray(st.contextEntryIds) && st.contextEntryIds.length > 0) {
            try { await setContextEntriesActivation(st.contextEntryIds, false); } catch (_e4b) {}
        }
        try { await api.v1.storyStorage.remove(STORAGE_WIZLIVE); } catch (_e5) {}
        aeLog('[AE:wizlive] stale chat state cleared (marker no longer in document).');
        return;
    }
    _aeLiveWiz = {
        active: true,
        markerId: st.markerId,
        setupIds: Array.isArray(st.setupIds) ? st.setupIds : [],
        topicId: st.topicId || '',
        paramSnapshot: st.paramSnapshot || null,
        startedAt: st.startedAt || Date.now(),
        sourceEntryId: (typeof st.sourceEntryId === 'string') ? st.sourceEntryId : null,
        contextEntryIds: Array.isArray(st.contextEntryIds) ? st.contextEntryIds : [],
        title: (typeof st.title === 'string' && st.title) ? st.title : 'Wizard Chat'
    };
    try { await _wizliveRegisterDecorations(st.markerId); await refreshLiveWizDecorations(); }
    catch (eD) { aeLog('[AE:wizlive] decoration restore failed (cosmetic only):', eD); }
    // [WIZ-TRAY] _ceTrayChatActive is seeded null, so this registers once on the
    // first sync regardless of which state the restored chat is in.
    try { await ceSyncToolbar(); } catch (_eTb) {}
    api.v1.ui.toast('Wizard chat still open in this story \u2014 continue below the marker or end it from the World-Build Wizard.', { type: 'info', autoClose: 6000 });
}
// ── [WIZLIVE] end ──────────────────────────────────────────────────────

// ============================================================================
// SECTION 3f — CHARACTER CHAT (CHARCHAT)
// [CHARCHAT] IN-STORY CHARACTER CHAT
// ----------------------------------------------------------------------------
// A conversation with ONE character, held in the document tail and driven by NAI's own Send.
// Modelled on WIZLIVE, but where WIZLIVE leaves the top of context alone, CHARCHAT OWNS THE
// WHOLE PROMPT. runCharChatContextOverride replaces, per generation:
//   systemPrompt  the AetherRoom card: framing, both identities, register.
//   lorebook      EVERY character-linked entry deactivated -- participants' (already folded
//                 into the card) and everyone else's (persona-bleed guard). NON-character
//                 entries are left alone.
//   authorsNote   DEACTIVATED; the ephemeral line rides the instruction tail instead.
//   storyText     narrative header, canonical chat region, next-message instruction APPENDED
//                 at true bottom, invisible in the document.
// SAFE UNCONDITIONALLY because story generation cannot run while a chat is open -- see the
// mutual-exclusion guards in startCharChat / startLiveWizardChat / resumeLiveWizardChatFromEntry.
// Applied on dryRun too, so NAI's context viewer shows the real chat context.
// endCharChat ships DISCARD ONLY.
interface CharChatState {
    active: boolean;
    markerId: number | null;        // sectionId of the boundary marker paragraph
    setupIds: number[];             // engine-authored setup paragraphs (excluded from the transcript)
    // POV classification is _charchatRowIsPov's origin rule and nothing else. If the
    // "{ {Nate: ...} }" corruption class reappears, the origin rule is not seeing 'user' on
    // typed text -- log what NAI actually stamps before reinstating anything.
    // busyStage: '' | 'thinking' | 'replying' | 'image', for the bridge status line. NOT
    // persisted -- it describes an in-flight call, so a restored copy could only lie.
    busyStage: string;
    // thoughtPass / thoughtAnchorIds are deleted; restoreCharChatOnStartup rebuilds field by
    contactId: string;              // the character being texted \u2014 the model speaks AS this one
    contactName: string;            // denormalized so context assembly needs no character load on the hot path
    povId: string;                  // [earlier, REVERSES the old LOCKED DECISION] whose phone this is, AND now the second half of the saved-thread partition key (see charChatEntryId) — no longer label-only. '' = unset ("No POV" bucket, back-compat with earlier threads).
    povName: string;
    // [CC-MODES] One of CC_MODES' ids. Persisted. Read through _ccModeId(), NEVER raw: state
    // saved before this field existed carries undefined, and the resolver is what turns that
    // into 'interview' (legacy povId sentinel) or 'text'.
    mode?: string;
    paramSnapshot: any;             // generationParameters snapshot restored on end (persisted so a reload can still restore)
    startedAt: number;
    lastEmotion: string;            // last parsed Emotion: tag \u2014 diagnostic/bridge only; the tag itself stays in the document
}
var _aeCharChat: CharChatState = { active: false, markerId: null, setupIds: [], busyStage: '', contactId: '', contactName: '', povId: '', povName: '', mode: 'text', paramSnapshot: null, startedAt: 0, lastEmotion: '' };
// The draft never reaches the engine: the bridge holds it and injects it into NAI's editor
// at pointerdown on Send. The engine sees the turn only afterwards, as real document text.

// [CHARCHAT-ARM-CANCEL] The in-flight post-reply thought's cancellation signal, or null.
// A bare module var, not on CharChatState, for the same reason busyStage is not persisted:
// it describes a call happening right now. Set by generateChatEphemeral for the life of its
// api.v1.generate() call, cleared in its finally; read ONLY by op 'arm'.
var _ccThoughtSignal: any = null;

// [DIAG CHARCHAT-RACE-DIAG] One shared timestamp and logger for every checkpoint in the
// post-reply lifecycle, under ONE tag so the console shows one ordered timeline.
var _ccRaceDiagLastAt: number = 0;
function _ccRaceDiagMark(label: string): void {
    let ccNow = Date.now();
    let ccElapsed = _ccRaceDiagLastAt ? (ccNow - _ccRaceDiagLastAt) : 0;
    aeLog('[AE:charchat:race-diag] ' + label + ' (+' + ccElapsed + 'ms since last mark)');
    _ccRaceDiagLastAt = ccNow;
}

// [DIAG CHARCHAT-EMPTY-REPLY-DIAG] Non-setup section count left by the LAST successful turn;
// a real turn adds AT LEAST 2. Fed by the settle-poll, so a firing means the poll gave up
// rather than that one short check ran early. -1 skips the check on a chat's first turn.
var _ccLastSeenSectionCount: number = -1;

// [DIAG CHARCHAT-RESP-DIAG] Watches onResponse, the one place reply text physically passes
// through. calls === 0 means the model returned nothing (prompt or transport); calls > 0 with
// finalSeen false means text WAS delivered, we deferred it with seenData:false and the
// re-delivery never arrived -- WE lost the reply. Keyed by continuityId.
var _ccRespCid: string = '';
var _ccRespCalls: number = 0;
var _ccRespBest: string = '';       // longest text seen this turn — seenData:false re-delivery is cumulative (script-types: "the same data in addition to any new data"), so longest === most complete
var _ccRespFinalSeen: boolean = false;

const AE_CHARCHAT_RULE_MARKER = 'ae-charchat-marker';
const AE_CHARCHAT_RULE_POV    = 'ae-charchat-pov';      // POV turns — right-justified bubble
const AE_CHARCHAT_RULE_CONTACT= 'ae-charchat-contact';  // the character's replies — left-justified bubble
// [CHARCHAT-BUBBLES] INLINE, not node: the Emotion: line may share a section with the reply
// body, so it cannot get its own node-level box. This inline rule styles only the substring
// its `match` finds, layered on top of the CONTACT node rule's bubble.
const AE_CHARCHAT_RULE_EMOTION= 'ae-charchat-emotion';
// [CHARCHAT-IMGWIDGET] The one string both artifacts must agree on. The bridge greps for this
// exact prefix with a TreeWalker (duplicated there as a literal -- the two files share no
// module). FLAG DAY: change BOTH or chat photos silently stop binding.
// [CHARCHAT-BUBBLES2] NAI SPLITS A SECTION WHOSE TEXT CONTAINS '\n', so the reply body and its
// Emotion line land as two sections and the tail inherits the CONTACT rule as a second bubble.
// Hence _HEAD (flat bottom) and _EMOBOX (flat top, same fill), which together read as ONE
// bubble with a tagline in it. _NAME hides the "Name: " prefix with display:none -- the text
// STAYS in the document, which is non-negotiable: the origin rule, the transcript walk and the
// save format all read it.
const AE_CHARCHAT_RULE_HEAD   = 'ae-charchat-head';
const AE_CHARCHAT_RULE_EMOBOX = 'ae-charchat-emobox';
const AE_CHARCHAT_RULE_NAME   = 'ae-charchat-name';
// [CHATIMG-HIDE-TAG] Hides the "[Image#hex: desc]" tag text in a bubble. The tag STAYS in
// the document (it is the durable pointer -- see _charchatImageRx) but is the raw image
// PROMPT, which the user should not see; the bridge paints the photo from a widget anchor.
const AE_CHARCHAT_RULE_IMGTAG = 'ae-charchat-imgtag';
const AE_CHARCHAT_IMG_SENTINEL = 'ce-chatimg:';

// ── [CHAT-BUBBLE-AXES] Bubble LOOK as composable axes ───────────────────────
// Nine axes plus colour, not a preset list. DecorationRule.style is Record<string,string> with
// no property whitelist, so the limit is the seam, not the API.
// WHAT AN AXIS MAY CHANGE. HEAD and EMOBOX are two SEPARATE paragraphs faking one bubble, and
// they read as one only while their box widths and HORIZONTAL PADDING agree, so Corner sets
// padX for all four rules at once. Alignment and max-width stay frozen: the avatar owns the
// lane the contact bubble's max-width leaves open.
// AXES ARE NOT FULLY INDEPENDENT (Depth's box half needs a box; Corner and Fill need a frame).
// Those dependencies are declared on CE_CB_FRAME and read by BOTH this builder and the Chat
// surface, so a control that would lie is not rendered.
// EVERY COLOUR IS COMPUTED FROM A HEX -- a var() cannot carry a user's chosen hue.

interface ChatFrameDef  { label: string; fill: boolean; edge: string; notch: boolean; corner: boolean; }
interface ChatCornerDef { label: string; r: string; n: string; padX: string; }

// FRAME -- what kind of box a turn is. `edge` names WHERE a border may go, which is the one
// thing that separates rule from underline from card; `corner` and `fill` are the gates.
var CE_CB_FRAME: { [k: string]: ChatFrameDef } = {
    bubble:    { label: 'Bubble',    fill: true,  edge: 'all',    notch: true,  corner: true  },
    card:      { label: 'Card',      fill: true,  edge: 'all',    notch: false, corner: true  },
    rule:      { label: 'Rule',      fill: false, edge: 'side',   notch: false, corner: false },
    underline: { label: 'Underline', fill: false, edge: 'bottom', notch: false, corner: false },
    none:      { label: 'None',      fill: false, edge: 'none',   notch: false, corner: false }
};

// CORNER -- radius, the speaker-side notch, AND the horizontal padding that keeps text off
// the curve. padX rises with r for the reason in the header note; it is applied identically
// to pov, contact, head and emobox, so the seam cannot notice.
var CE_CB_CORNER: { [k: string]: ChatCornerDef } = {
    sharp: { label: 'Sharp', r: '2px',  n: '2px', padX: '12px' },
    soft:  { label: 'Soft',  r: '6px',  n: '5px', padX: '12px' },
    round: { label: 'Round', r: '16px', n: '5px', padX: '14px' },
    pill:  { label: 'Pill',  r: '22px', n: '6px', padX: '20px' }
};

// FILL -- one alpha applied to the side's own hue. `blur` is backdropFilter and its result
// is not guaranteed: it composites against whatever NAI paints behind the editor, which this
// script cannot see. Labelled experimental in the surface rather than promised.
var CE_CB_FILL: any = {
    solid:   { label: 'Solid',              a: 0.30, blur: false },
    tint:    { label: 'Tint',               a: 0.16, blur: false },
    wash:    { label: 'Wash',               a: 0.07, blur: false },
    frosted: { label: 'Frosted (beta)',     a: 0.14, blur: true  },
    none:    { label: 'None',               a: 0,    blur: false }
};

var CE_CB_EDGE: any = {
    none:     { label: 'None',     w: '0',   a: 0    },
    hairline: { label: 'Hairline', w: '1px', a: 0.42 },
    bold:     { label: 'Bold',     w: '2px', a: 0.55 },
    bright:   { label: 'Bright',   w: '1px', a: 0.88 }
};

var CE_CB_DEPTH: any = {
    flat:  { label: 'Flat'  },
    lift:  { label: 'Lift'  },
    bloom: { label: 'Bloom' },
    inset: { label: 'Inset' }
};

// The three font stacks keep their var(--ae-font-*) hook: those name a FAMILY the bridge is
// allowed to retheme, not a value the user picked.
var CE_CB_TYPE: any = {
    sans:  { label: 'Sans',      font: 'var(--ae-font-sans, system-ui, -apple-system, \u0022Segoe UI\u0022, Roboto, sans-serif)' },
    serif: { label: 'Serif',     font: 'Georgia, \u0022Iowan Old Style\u0022, \u0022Times New Roman\u0022, serif' },
    mono:  { label: 'Monospace', font: 'var(--ae-font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace)' }
};

var CE_CB_VOICE: any = {
    normal: { label: 'Normal', extra: {} },
    italic: { label: 'Italic', extra: { fontStyle: 'italic' } },
    wide:   { label: 'Wide',   extra: { letterSpacing: '0.06em', lineHeight: '1.62' } },
    tight:  { label: 'Tight',  extra: { letterSpacing: '-0.01em', fontSize: '0.94em' } }
};

// LANE -- the ONE geometry axis, allowed only because it moves the bubble and the AVATAR
// TOGETHER: the avatar's position is DERIVED and pushed across with everything else.
//   inset  the bubble stops at `width` and the avatar sits in what is left.
//   full   the BOX runs the full column and the avatar lane is reserved as PADDING inside it.
//          Contact side only -- POV turns get no avatar.
// `width` applies under inset and is IGNORED under full, which is why the surface hides it
// in that mode rather than leaving a control that sets nothing.
// [CHAT-STAGE-LANE] A THIRD VALUE 'stage' LIVED HERE FOR ONE VERSION. It was the wrong
// address: the stage's layout is not a taste an author sets beside the layer, it IS the
// layer, and two switches meant the common state was the half-applied one. Driven from
// charChatStage now. A config still carrying 'stage' resolves to the default through
// _ceCbPick like any other unknown id, so nothing needs migrating.
var CE_CB_LANE: any = {
    inset: { label: 'Inset' },
    full:  { label: 'Full row' }
};

// PALETTE is a PAIR, because the two sides are only legible as a pair -- picking them
// independently is how you get two hues nobody can tell apart at 16% alpha. The custom hex
// overrides below exist for exactly the case this table cannot serve.
var CE_CB_PALETTE: any = {
    signal: { label: 'Signal',     pov: '#4a9ed9', them: '#f0f0f5' },
    ember:  { label: 'Ember',      pov: '#e8c07d', them: '#c9a2a2' },
    aether: { label: 'Aether',     pov: '#5ec4ff', them: '#e084ff' },
    moss:   { label: 'Moss',       pov: '#7cffb0', them: '#e8c07d' },
    vellum: { label: 'Vellum',     pov: '#e8c07d', them: '#f0f0f5' },
    tide:   { label: 'Tide',       pov: '#4ad9c4', them: '#9a8ce0' },
    dusk:   { label: 'Dusk',       pov: '#9370db', them: '#d98a8a' },
    mono:   { label: 'Monochrome', pov: '#f0f0f5', them: '#f0f0f5' }
};

// ACCENT is the THIRD colour and it is deliberately separate from the pair: it paints the
// CHARACTER CHAT marker band and the Emotion tagline, neither of which belongs to a side.
var CE_CB_ACCENT: any = {
    amber:  { label: 'Amber',  hex: '#e8a04a' },
    blue:   { label: 'Blue',   hex: '#4a9ed9' },
    green:  { label: 'Green',  hex: '#7cffb0' },
    violet: { label: 'Violet', hex: '#9370db' },
    rose:   { label: 'Rose',   hex: '#e0748c' },
    cyan:   { label: 'Cyan',   hex: '#5ec4ff' },
    bone:   { label: 'Bone',   hex: '#d8d8de' }
};

// SEEDS ARE BUTTONS, NOT MODES. A seed WRITES the nine axis values and then has no further
// existence: nothing stores which was used and changing an axis afterwards does not "leave"
// a preset, because there was never a preset to be in.
var CE_CB_SEEDS: any = {
    chat:      { label: 'Chat',      frame: 'bubble',    corner: 'round', fill: 'tint',    edge: 'hairline', depth: 'lift',  type: 'sans',  voice: 'normal', palette: 'signal', accent: 'amber', lane: 'inset' },
    terminal:  { label: 'Terminal',  frame: 'rule',      corner: 'sharp', fill: 'none',    edge: 'bold',     depth: 'flat',  type: 'mono',  voice: 'tight',  palette: 'moss',   accent: 'green', lane: 'inset' },
    scrying:   { label: 'Scrying',   frame: 'bubble',    corner: 'soft',  fill: 'frosted', edge: 'bright',   depth: 'bloom', type: 'serif', voice: 'wide',   palette: 'aether', accent: 'violet', lane: 'inset' },
    telepathy: { label: 'Telepathy', frame: 'none',      corner: 'sharp', fill: 'none',    edge: 'none',     depth: 'bloom', type: 'serif', voice: 'italic', palette: 'dusk',   accent: 'violet', lane: 'inset' },
    script:    { label: 'Script',    frame: 'underline', corner: 'sharp', fill: 'none',    edge: 'hairline', depth: 'flat',  type: 'mono',  voice: 'normal', palette: 'mono',   accent: 'bone', lane: 'inset' },
    paper:     { label: 'Paper',     frame: 'card',      corner: 'soft',  fill: 'wash',    edge: 'none',     depth: 'flat',  type: 'serif', voice: 'wide',   palette: 'vellum', accent: 'amber', lane: 'inset' },
    plain:     { label: 'Plain',     frame: 'none',      corner: 'sharp', fill: 'none',    edge: 'none',     depth: 'flat',  type: 'sans',  voice: 'normal', palette: 'mono',   accent: 'amber', lane: 'inset' }
};

// Every legacy preset id maps to the seed that reproduces it.
// THE MIGRATION IS A READ, NOT A WRITE: ceChatBubbleDisplay resolves the SEED FIRST and uses
// its values as the per-axis defaults, so a config carrying charChatBubbleStyle:'neon' and no
// axis fields resolves by arithmetic rather than by conversion -- idempotent by construction
// and impossible to half-apply.
var CE_CB_LEGACY_SEED: any = {
    messages: 'chat', ink: 'paper', terminal: 'terminal', neon: 'scrying', plain: 'plain'
};

var CE_CHAT_BUBBLE_WIDTHS: number[] = [66, 78, 88];

// ceChatSetBubble's field name -> the GlobalConfig key it writes. A MAP RATHER THAN AN
// IF-CHAIN so the surface and the writer cannot drift: a typo is an undefined lookup that
// refuses the write instead of creating a config key nothing reads. 'seed' is deliberately
// ABSENT -- it writes nine keys at once and is handled before this is consulted.
var CE_CB_FIELD_KEY: any = {
    frame:   'charChatBubbleFrame',   corner:  'charChatBubbleCorner',
    fill:    'charChatBubbleFill',    edge:    'charChatBubbleEdge',
    depth:   'charChatBubbleDepth',   type:    'charChatBubbleType',
    voice:   'charChatBubbleVoice',   palette: 'charChatBubblePalette',
    accent:  'charChatBubbleAccent',  lane:    'charChatBubbleLane',
    povHex:  'charChatPovColor',      themHex: 'charChatContactColor',
    accHex:  'charChatAccentColor',   ink:     'charChatBubbleInk'
};

// -- Colour primitives ----------------------------------------------------------------
// A BAD HEX RESOLVES TO THE DEFAULT INK RATHER THAN FAILING. The hex fields are free text,
// so 'blue', '#12' and '' all reach here and every one must produce a usable colour.
function _ceCbRgb(hex: string): number[] {
    var s = String(hex || '').replace('#', '').trim();
    if (s.length === 3) { s = s.charAt(0) + s.charAt(0) + s.charAt(1) + s.charAt(1) + s.charAt(2) + s.charAt(2); }
    if (!(new RegExp('^[0-9a-fA-F]{6}$')).test(s)) return [233, 233, 236];
    return [parseInt(s.slice(0, 2), 16), parseInt(s.slice(2, 4), 16), parseInt(s.slice(4, 6), 16)];
}

// Plain rgba(), never color-mix() and never a bare var(): an unresolvable var() computes the
// WHOLE declaration to unset, and color-mix has one more parser to disagree with.
function _ceCbRgba(hex: string, a: number): string {
    if (!(a > 0)) return 'transparent';
    var c = _ceCbRgb(hex);
    return 'rgba(' + String(c[0]) + ',' + String(c[1]) + ',' + String(c[2]) + ',' + String(a) + ')';
}

// AUTO-CONTRAST, AND ITS ONE ASSUMPTION. The fill is translucent, so the readable ink depends
// on what is BEHIND it -- which this script cannot measure (no DOM). The fill is composited
// against an assumed dark base; the override is what a wrong assumption is for.
var CE_CB_BASE_RGB: number[] = [27, 27, 31];
var CE_CB_INK_LIGHT = '#e9e9ec';
var CE_CB_INK_DARK  = '#14141a';

function _ceCbInk(hex: string, alpha: number, override: string): string {
    var ov = String(override || '').trim();
    if (ov) return ov;
    var c = _ceCbRgb(hex);
    var a = (alpha > 0) ? alpha : 0;
    var mixR = (c[0] * a) + (CE_CB_BASE_RGB[0] * (1 - a));
    var mixG = (c[1] * a) + (CE_CB_BASE_RGB[1] * (1 - a));
    var mixB = (c[2] * a) + (CE_CB_BASE_RGB[2] * (1 - a));
    var lum = ((0.2126 * mixR) + (0.7152 * mixG) + (0.0722 * mixB)) / 255;
    return (lum > 0.55) ? CE_CB_INK_DARK : CE_CB_INK_LIGHT;
}

// An id that is not a key of its own table reads as the default. Same contract every other
// resolver in this file follows: a half-written config can never reach the rule builder.
function _ceCbPick(v: any, table: any, dflt: string): string {
    var id = String(v || '');
    return table[id] ? id : dflt;
}

// The one resolver. EVERY read of the bubble config goes through here, including the Chat
// surface's own controls -- which is why the surface can never render a select whose value
// is not one of its options.
function ceChatBubbleDisplay(cfg: any): any {
    // The DEFAULT for every axis below, resolved before any of them: a legacy preset id if
    // one is present and recognised, otherwise 'chat'. See CE_CB_LEGACY_SEED's note.
    var cbSeedId = String(CE_CB_LEGACY_SEED[String((cfg && cfg.charChatBubbleStyle) || '')] || 'chat');
    var cbBase: any = CE_CB_SEEDS[cbSeedId] || CE_CB_SEEDS['chat'];
    var cbPal = _ceCbPick(cfg && cfg.charChatBubblePalette, CE_CB_PALETTE, cbBase.palette);
    var cbAcc = _ceCbPick(cfg && cfg.charChatBubbleAccent, CE_CB_ACCENT, cbBase.accent);

    // A CUSTOM HEX OVERRIDES ITS PALETTE SLOT AND NOTHING ELSE. Empty means "use the
    // palette", so clearing the field is the undo -- there is no separate "custom: on".
    var cbPovHex  = String((cfg && cfg.charChatPovColor) || '').trim();
    var cbThemHex = String((cfg && cfg.charChatContactColor) || '').trim();
    var cbAccHex  = String((cfg && cfg.charChatAccentColor) || '').trim();

    // Width SNAPS to the offered set, as avatar size does: the surface renders it as a
    // three-option ceSelect and an off-set value would show no selection while being in effect.
    var bwRaw = Number(cfg && cfg.charChatBubbleWidth);
    var bwOut = 78;
    if (bwRaw > 0) {
        var bwBest = CE_CHAT_BUBBLE_WIDTHS[0];
        for (var bwI = 1; bwI < CE_CHAT_BUBBLE_WIDTHS.length; bwI++) {
            if (Math.abs(CE_CHAT_BUBBLE_WIDTHS[bwI] - bwRaw) < Math.abs(bwBest - bwRaw)) bwBest = CE_CHAT_BUBBLE_WIDTHS[bwI];
        }
        bwOut = bwBest;
    }

    return {
        frame:   _ceCbPick(cfg && cfg.charChatBubbleFrame,  CE_CB_FRAME,  cbBase.frame),
        corner:  _ceCbPick(cfg && cfg.charChatBubbleCorner, CE_CB_CORNER, cbBase.corner),
        fill:    _ceCbPick(cfg && cfg.charChatBubbleFill,   CE_CB_FILL,   cbBase.fill),
        edge:    _ceCbPick(cfg && cfg.charChatBubbleEdge,   CE_CB_EDGE,   cbBase.edge),
        depth:   _ceCbPick(cfg && cfg.charChatBubbleDepth,  CE_CB_DEPTH,  cbBase.depth),
        type:    _ceCbPick(cfg && cfg.charChatBubbleType,   CE_CB_TYPE,   cbBase.type),
        voice:   _ceCbPick(cfg && cfg.charChatBubbleVoice,  CE_CB_VOICE,  cbBase.voice),
        palette: cbPal,
        accent:  cbAcc,
        lane:    _ceCbPick(cfg && cfg.charChatBubbleLane, CE_CB_LANE, cbBase.lane),
        // [CHAT-LANE] Read through ceChatAvatarDisplay rather than off cfg, so the two resolvers
        // cannot disagree about what 'Large' means. Under `full` this is the reserved lane width;
        // under `inset` the rules ignore it but the bridge still needs it to place the portrait.
        avSize:  ceChatAvatarDisplay(cfg).size,
        // [CHAT-STAGE-LANE] THE STAGE IS AN AXIS OF THE LOOK, resolved here with the rest.
        // It is a plain boolean rather than a table key because it has two states and no
        // vocabulary; everything downstream reads it from here and never from cfg.
        // stageScale IS NOT READ HERE. The flanked column that needed it is gone -- the
        // standee's width and the text's width are now independent, which is the whole
        // simplification.
        stage:   !!(cfg && (cfg as any).charChatStage),
        povHex:  cbPovHex  || CE_CB_PALETTE[cbPal].pov,
        themHex: cbThemHex || CE_CB_PALETTE[cbPal].them,
        accHex:  cbAccHex  || CE_CB_ACCENT[cbAcc].hex,
        povRaw:  cbPovHex, themRaw: cbThemHex, accRaw: cbAccHex,
        ink:     String((cfg && cfg.charChatBubbleInk) || ''),
        width:   bwOut
    };
}

// Compile a resolved look into the six node-rule style objects, keyed by rule id. ONE builder,
// TWO callers: _charchatRegisterDecorations and ceChatSetBubble (live restyle), so neither
// writes a declaration of its own and they cannot disagree.
// GEOMETRY, load-bearing and not axis-controlled (padX excepted):
//  * width:'fit-content' ON POV AND CONTACT. A node marker styles the whole PARAGRAPH BOX, and
//    a block box with margin-left:auto and max-width:78% is still width:auto.
//  * HEAD AND EMOBOX ARE DELIBERATELY NOT fit-content: the seam only disappears while their
//    boxes are the SAME WIDTH, and two fit-content boxes around different text never are.
function _charchatBubbleRules(look: any): any {
    var cbFr = CE_CB_FRAME[look.frame]   || CE_CB_FRAME['bubble'];
    var cbCo = CE_CB_CORNER[look.corner] || CE_CB_CORNER['round'];
    var cbFi = CE_CB_FILL[look.fill]     || CE_CB_FILL['tint'];
    var cbEd = CE_CB_EDGE[look.edge]     || CE_CB_EDGE['hairline'];
    var cbTy = CE_CB_TYPE[look.type]     || CE_CB_TYPE['sans'];
    var cbVo = CE_CB_VOICE[look.voice]   || CE_CB_VOICE['normal'];
    var cbDp = String(look.depth || 'flat');

    // [CHAT-LANE] Under `full` the BOX runs the full column and the avatar lane becomes
    // padding inside it. Contact side ONLY: POV turns get no avatar, so reserving there would
    // be a gap nothing fills. Head and emobox receive the SAME laneRight, so the seam holds.
    var cbFull = (String(look.lane || 'inset') === 'full');
    // [CHAT-STAGE-LANE] THE STAGE IS THE AUTHOR'S width%, CENTRED, and no arithmetic at all.
    // The previous pass reserved the standees' full width on both sides and clamped the
    // result off the floor; on a phone that clamp fired every time, so the reservation was
    // only ever theatre. What actually makes text over a figure readable is the scrim, which
    // is there regardless -- so the column and the standee width are independent now and the
    // gutters are simply what the width leaves.
    var cbStage = !!look.stage;
    var bMax = cbFull ? '100%' : (String(look.width || 78) + '%');
    var padX = cbFr.corner ? cbCo.padX : '0px';
    var laneW = cbFull ? (Number(look.avSize || 40) + 12) : 0;
    var padThemR = laneW > 0 ? ('calc(' + padX + ' + ' + String(laneW) + 'px)') : padX;
    var bR   = cbFr.corner ? cbCo.r : '0';
    var bN   = (cbFr.corner && cbFr.notch) ? cbCo.n : bR;

    var fillA  = cbFr.fill ? cbFi.a : 0;
    var povBg  = _ceCbRgba(look.povHex,  fillA);
    var themBg = _ceCbRgba(look.themHex, fillA);
    var povInk  = _ceCbInk(look.povHex,  fillA, look.ink);
    var themInk = _ceCbInk(look.themHex, fillA, look.ink);

    var edgeOn  = (cbEd.a > 0) && (cbFr.edge !== 'none');
    var povLine  = cbEd.w + ' solid ' + _ceCbRgba(look.povHex,  cbEd.a);
    var themLine = cbEd.w + ' solid ' + _ceCbRgba(look.themHex, cbEd.a);

    // A BOX EXISTS ONLY IF SOMETHING DRAWS ONE. boxShadow on a paragraph with no fill and
    // no full border paints a rectangle nobody asked for, which is what "bloom on Frame:
    // none" would have been. Declared once and read by all four depth branches.
    var hasBox = cbFr.fill || (edgeOn && cbFr.edge === 'all');
    var povShadow  = 'none';
    var themShadow = 'none';
    var povGlow    = '';
    var themGlow   = '';
    if (cbDp === 'lift' && hasBox) {
        povShadow  = '0 1px 3px rgba(0,0,0,0.28)';
        themShadow = povShadow;
    } else if (cbDp === 'inset' && hasBox) {
        povShadow  = 'inset 0 1px 0 rgba(255,255,255,0.09)';
        themShadow = povShadow;
    } else if (cbDp === 'bloom') {
        if (hasBox) {
            povShadow  = '0 0 14px ' + _ceCbRgba(look.povHex,  0.24);
            themShadow = '0 0 14px ' + _ceCbRgba(look.themHex, 0.24);
        }
        povGlow  = '0 0 6px ' + _ceCbRgba(look.povHex,  0.38);
        themGlow = '0 0 6px ' + _ceCbRgba(look.themHex, 0.38);
    }

    // BORDER ASSEMBLY IS EXPLICIT PER RULE: HEAD and EMOBOX each SUPPRESS one edge to close the
    // seam. Key insertion order matters -- `border` is written first and the suppressions after,
    // so the later declaration wins when both are serialised.
    var bPov: any = {
        display: 'block', width: 'fit-content', marginLeft: 'auto', marginRight: '0', maxWidth: bMax,
        padding: '8px ' + padX,
        borderRadius: bR + ' ' + bR + ' ' + bN + ' ' + bR,
        // [THEME-VAR2] THE AUTHOR'S CE SETTINGS BECOME THE FALLBACK, NOT THE ANSWER. Every
        // value above is computed from the look the author chose; wrapping each in var() lets
        // a THEME restyle the bubble without touching that choice. These are decoration rules
        // in the STORY EDITOR, so they are ordinary page DOM and a :root block reaches them --
        // unlike the shadow-rooted jsx surfaces.
        backgroundColor: 'var(--ce-cb-pov-bg, ' + povBg + ')',
        border: 'none',
        boxShadow: 'var(--ce-cb-shadow, ' + povShadow + ')',
        color: 'var(--ce-cb-pov-ink, ' + povInk + ')',
        fontFamily: 'var(--ce-cb-font, ' + cbTy.font + ')'
    };
    var bThem: any = {
        display: 'block', width: 'fit-content', marginRight: 'auto', marginLeft: '0', maxWidth: bMax,
        padding: '8px ' + padThemR + ' 8px ' + padX,
        borderRadius: bR + ' ' + bR + ' ' + bR + ' ' + bN,
        backgroundColor: 'var(--ce-cb-them-bg, ' + themBg + ')',
        border: 'none',
        boxShadow: 'var(--ce-cb-shadow, ' + themShadow + ')',
        color: 'var(--ce-cb-them-ink, ' + themInk + ')',
        fontFamily: 'var(--ce-cb-font, ' + cbTy.font + ')'
    };
    var bHead: any = {
        display: 'block', marginRight: 'auto', marginLeft: '0', marginBottom: '0', maxWidth: bMax,
        padding: '8px ' + padThemR + ' 2px ' + padX,
        borderRadius: bR + ' ' + bR + ' 0 0',
        backgroundColor: 'var(--ce-cb-them-bg, ' + themBg + ')',
        border: 'none',
        boxShadow: 'var(--ce-cb-shadow, ' + themShadow + ')',
        color: 'var(--ce-cb-them-ink, ' + themInk + ')',
        fontFamily: 'var(--ce-cb-font, ' + cbTy.font + ')'
    };
    var bTail: any = {
        display: 'block', marginRight: 'auto', marginLeft: '0', marginTop: '0', maxWidth: bMax,
        padding: '0 ' + padThemR + ' 7px ' + padX,
        borderRadius: '0 0 ' + bR + ' ' + bN,
        backgroundColor: 'var(--ce-cb-them-bg, ' + themBg + ')',
        border: 'none',
        boxShadow: 'var(--ce-cb-shadow, ' + themShadow + ')',
        color: 'var(--ce-cb-tail-ink, ' + _ceCbRgba(look.accHex, 0.86) + ')',
        fontFamily: 'var(--ce-cb-font, ' + cbTy.font + ')'
    };

    // [THEME-VAR3] THE EDGE MUST NOT DEPEND ON THE AUTHOR'S FRAME CHOICE. A story saved with
    // Frame: none or Edge: off entered none of the branches below, so --ce-cb-*-edge was never
    // written and the theme looked like it had failed. THE FALLBACK IS THE AUTHOR'S CHOICE --
    // including `none` -- AND THE TOKEN OVERRIDES IT EITHER WAY.
    // ONE EXPRESSION, THREE FALLBACKS: every side that can carry a rule writes the SAME var()
    // with whatever that side would have been, so a themed `side` frame becomes a full box.
    var povLineV  = 'var(--ce-cb-pov-edge, '  + ((edgeOn && cbFr.edge === 'all') ? povLine  : 'none') + ')';
    var themLineV = 'var(--ce-cb-them-edge, ' + ((edgeOn && cbFr.edge === 'all') ? themLine : 'none') + ')';
    var povSideV  = 'var(--ce-cb-pov-edge, '  + povLine  + ')';
    var themSideV = 'var(--ce-cb-them-edge, ' + themLine + ')';
    // Written unconditionally, so a theme reaches a frameless story. The two seam
    // suppressions ride with it: they are geometry, and a theme that supplies a border must
    // not reopen the head/tail seam by doing so.
    bPov.border  = povLineV;
    bThem.border = themLineV;
    bHead.border = themLineV;  bHead.borderBottom = 'none';
    bTail.border = themLineV;  bTail.borderTop    = 'none';
    if (edgeOn && cbFr.edge === 'side') {
        // The SIDE is the visual identity here: the speaker's own margin carries the rule.
        bPov.borderRight  = povSideV;
        bThem.borderLeft  = themSideV;
        bHead.borderLeft  = themSideV;
        bTail.borderLeft  = themSideV;
    } else if (edgeOn && cbFr.edge === 'bottom') {
        // Only the LAST paragraph of the pair underlines, or the tagline gets a rule through
        // the middle of what is meant to read as one block.
        bPov.borderBottom  = povSideV;
        bThem.borderBottom = themSideV;
        bTail.borderBottom = themSideV;
    }

    // Under `full`, fit-content plus a large right padding would hug the text and leave the
    // avatar on the editor background. The contact stack takes the whole row; POV keeps hugging.
    if (cbFull) { bThem.width = '100%'; }

    // [CHAT-STAGE-LANE] BOTH MARGINS AUTO ON ALL FOUR RULES. The side a speaker's bubble
    // hugs is the whole of the inset layout's speaker cue, and on a stage it is carried by
    // WHICH STANDEE IS STANDING THERE instead -- so hugging a side would only push the text
    // onto the figure it belongs to. Written after the border assembly above, because the
    // seam suppressions are geometry too and must not be reopened by a later margin write.
    // THE RIGHT GUTTER IS ALSO WHERE THE TURN CONTROLS GO, painted by the bridge against
    // this same centred box -- so the two gutters have to stay equal or the cluster lands
    // on top of the text it belongs to.
    if (cbStage) {
        bPov.marginLeft  = 'auto'; bPov.marginRight  = 'auto';
        bThem.marginLeft = 'auto'; bThem.marginRight = 'auto';
        bHead.marginLeft = 'auto'; bHead.marginRight = 'auto';
        bTail.marginLeft = 'auto'; bTail.marginRight = 'auto';
    }

    if (cbFr.fill && cbFi.blur) {
        bPov.backdropFilter = 'blur(6px)';  bThem.backdropFilter = 'blur(6px)';
        bHead.backdropFilter = 'blur(6px)'; bTail.backdropFilter = 'blur(6px)';
    }
    if (povGlow)  { bPov.textShadow = povGlow; }
    if (themGlow) { bThem.textShadow = themGlow; bHead.textShadow = themGlow; bTail.textShadow = themGlow; }

    // Voice merges LAST so it can override anything above it -- Tight's fontSize is exactly
    // that, a declaration the shared shape has no field for.
    var cbK: string;
    for (cbK in cbVo.extra) {
        if (!Object.prototype.hasOwnProperty.call(cbVo.extra, cbK)) continue;
        bPov[cbK] = cbVo.extra[cbK]; bThem[cbK] = cbVo.extra[cbK];
        bHead[cbK] = cbVo.extra[cbK]; bTail[cbK] = cbVo.extra[cbK];
    }

    return {
        marker: {
            backgroundColor: _ceCbRgba(look.accHex, 0.16),
            borderTop: '2px solid ' + _ceCbRgba(look.accHex, 0.85),
            borderBottom: '1px solid ' + _ceCbRgba(look.accHex, 0.40)
        },
        pov: bPov, contact: bThem, head: bHead, emobox: bTail,
        emotion: {
            color: _ceCbRgba(look.accHex, 0.86),
            fontStyle: (look.type === 'mono') ? 'normal' : 'italic',
            fontSize: 'var(--ae-font-size-xs, 11px)', fontFamily: cbTy.font
        }
    };
}

// ── [CHAT-LANE] The bubble's look, for the bridge ───────────────────────────
// THREE THINGS ARE PAINTED BY THE BRIDGE, NOT BY A DECORATION RULE: the contact avatar, the
// per-turn control cluster, and the chat photo card. All three must agree with the bubble, so
// every number they need is DERIVED here from the one resolved look and pushed as CSS custom
// properties. Nothing over there computes a bubble value.
// THE PHOTO CARD is a NODE widget on the message's own section, so it lands BETWEEN the HEAD
// and EMOBOX paragraphs -- physically inside the fake bubble, which is why the payload carries
// edges and radii and not just a width.
function _charchatBubbleTokens(look: any): any {
    var cbFr: any = CE_CB_FRAME[String(look.frame)] || CE_CB_FRAME['bubble'];
    var cbCo: any = CE_CB_CORNER[String(look.corner)] || CE_CB_CORNER['round'];
    var cbFi: any = CE_CB_FILL[String(look.fill)] || CE_CB_FILL['tint'];
    var cbEd: any = CE_CB_EDGE[String(look.edge)] || CE_CB_EDGE['hairline'];
    var cbTy: any = CE_CB_TYPE[String(look.type)] || CE_CB_TYPE['sans'];

    var tFull  = (String(look.lane || 'inset') === 'full');
    // [CHAT-STAGE-LANE] The photo card is a SEGMENT of the bubble, so it centres with it --
    // otherwise a stage chat shows centred text with a left-aligned picture cutting across
    // the middle of it. The bridge does the centring off the class; this only has to agree
    // about the width, which it does by not changing it.
    var tStage = !!look.stage;
    var tW     = Number(look.width || 78);
    var tSize  = Number(look.avSize || 40);
    var tPadX  = cbFr.corner ? String(cbCo.padX) : '0px';
    var tR     = cbFr.corner ? String(cbCo.r) : '0';
    var tN     = (cbFr.corner && cbFr.notch) ? String(cbCo.n) : tR;

    // THE AVATAR LANE, DERIVED. Under inset the portrait is centred in the band the bubble leaves
    // on the RIGHT -- (100 + W) / 2 is that band's centre, which reduces to the old hardcoded 89
    // at the old default of 78. Under full there is no band, so it pins to the column edge.
    var tAvaLeft = tFull
        ? 'calc(100% - var(--ae-cca-size,40px) - 6px)'
        : ('calc(' + String((100 + tW) / 2) + '% - var(--ae-cca-size,40px) / 2)');

    var tFillA = cbFr.fill ? Number(cbFi.a) : 0;
    var tEdgeOn = (Number(cbEd.a) > 0) && (cbFr.edge !== 'none');
    // The photo card carries a FULL border or none. Under a 'side' or 'bottom' frame the
    // bubble has no box for the card to continue, so it gets none and reads as a bare
    // picture -- which is what those frames look like everywhere else.
    var tPovEdge  = (tEdgeOn && cbFr.edge === 'all') ? (cbEd.w + ' solid ' + _ceCbRgba(look.povHex,  cbEd.a)) : 'none';
    var tThemEdge = (tEdgeOn && cbFr.edge === 'all') ? (cbEd.w + ' solid ' + _ceCbRgba(look.themHex, cbEd.a)) : 'none';

    return {
        maxWidth: tFull ? '100%' : (String(tW) + '%'),
        // '1' tells the bridge to centre the photo card and to withhold the gutter avatar
        // and its control cluster. A stale bridge ignores the key and paints both, which is
        // wrong-but-working rather than blank -- the same standing every token here has.
        stage:    tStage ? '1' : '0',
        lane:     tFull ? (String(tSize + 12) + 'px') : '0px',
        avaLeft:  tAvaLeft,
        padX:     tPadX,
        radius:   tR,
        notch:    tN,
        povBg:    _ceCbRgba(look.povHex,  tFillA),
        themBg:   _ceCbRgba(look.themHex, tFillA),
        povEdge:  tPovEdge,
        themEdge: tThemEdge,
        povInk:   _ceCbInk(look.povHex,  tFillA, look.ink),
        themInk:  _ceCbInk(look.themHex, tFillA, look.ink),
        accent:   _ceCbRgba(look.accHex, 0.86),
        font:     String(cbTy.font)
    };
}

// Push the tokens. THREE call sites, all necessary: registration (a chat opening),
// ceChatSetBubble (a live change), and the bridge handshake (a bridge that connected or
// reloaded after either). A bridge never told falls back to its own CSS literals, so a stale
// bridge is wrong-but-working rather than blank.
function broadcastChatBubbleStyle(): Promise<any> {
    if (!isBridgeReady) return Promise.resolve(null);
    return loadConfig().then(function(cbsCfg: any) {
        return broadcastToTM('AE_CHAT_BUBBLE_STYLE', _charchatBubbleTokens(ceChatBubbleDisplay(cbsCfg)));
    }).catch(function(e: any) {
        aeLog('[AE:chatstyle] bubble token push failed (bridge keeps its last values):', e);
        return null;
    });
}

// [CHARCHAT-AVATAR] Second sentinel, same channel. One anchor per CONTACT TURN, not per
// section -- a three-paragraph reply gets ONE avatar. The bridge resolves the emotion to a
// per-emotion portrait slot (charId+'_em_'+emotion), falling back to charId+'_em_Avatar'.
// POV turns get none. FLAG DAY: this literal is duplicated in the bridge -- change BOTH or
// avatars silently stop binding. Payload format is documented at the emit site below.
const AE_CHARCHAT_AVA_SENTINEL = 'ce-chatava:';
const AE_CHARCHAT_MAX_TOKENS  = 120;                    // SMS-length DEFAULT pin — now only the fallback for a contact whose persona verbosity is 'auto'. See charChatMaxTokensFor().
// generateEphemeral() is a fully separate call with its own budget and shares nothing with the
// reply's own max_tokens pin.
const AE_CHARCHAT_SUMMARY_MAX_TOKENS = 300;             // Matches AE_WIZARD_MAX_TOKENS's precedent for "a short prose passage" — used only transiently during previewSummarizeCharChat, never left pinned.
// The two context budgets are deliberately asymmetric: the transcript is what the contact is
// actually answering, the story is background, so the story gets the smaller share.
const AE_CHATEPH_STORY_TOKENS = 700;
const AE_CHATEPH_CHAT_CHARS = 2400;
// ── [CC-MODES] WHAT KIND OF CONVERSATION THIS IS ────────────────────────────
// A mode owns every string that differs between kinds of conversation: framing, register
// rubric, the noun for one turn, the document marker, the greeting, the story-block header and
// the output cap. NOTHING ELSE MAY FORK ON MODE -- a new difference becomes a field here
// rather than a ternary at the site.
// MODE IS NOT THE PARTITION KEY. charChatEntryId is still (contactId, povId): one thread per
// pair. Interview partitions only because its povId IS the sentinel.
interface CharChatMode {
    id: string;
    label: string;         // picker label
    channel: string;       // the noun for the conversation itself
    framing: string;       // sentence 1 of the system prompt
    task: string;          // sentence 2 -- what the model is being asked to write
    register: string;      // the mode's own rubric; replaces the old global one
    turnNoun: string;      // one turn: 'message' / 'reply' / 'turn' / 'answer'
    bodyLabel: string;     // header over the story block
    marker: string;        // the document boundary marker
    maxTokens: number;     // output cap; 0 = defer to the persona verbosity ladder
    usesPersona: boolean;  // whether the SMS persona clause (style/emoji) applies
    usesEmotion: boolean;  // whether the terminal Emotion directive applies
    greet: string;         // setup paragraph verb, completed with the contact's name
    // An optional extra clause on the instruction tail, for a failure this mode has and the
    // others do not. Empty everywhere but interview; an empty string is skipped rather than
    // pushed, so the tail's block count does not change shape between modes.
    guard: string;
}

// THE REGISTER RUBRICS. Per-MODE, not per-CONTACT, so the system prompt stays byte-identical
// across every contact in a story and switching chats does not invalidate the prefix.
// Register itself is owned solely by buildCharChatPersonaClause -- the old three-way
// "digital native / professional / senior" classifier here disagreed with it every turn.
const CC_REG_TEXT = [
    'Relaxed punctuation and short lines are natural here; match the character rather than a template.',
    'Never repeat the same emoticon consecutively. Avoid cliches.',
    'Only rarely include narrative prose or actions (e.g. *sighs*) -- this is a conversation, not a scene.'
].join('\n');

const CC_REG_TALK = [
    'Write only what is spoken aloud. No narration, no action lines, no stage directions.',
    'Speech is looser than prose: interruptions, half-sentences and plain words are right.',
    'Avoid cliches, and do not summarise back what was just said.'
].join('\n');

const CC_REG_SCENE = [
    'Speech and action both belong here. Actions in plain prose, in the story\u2019s own voice.',
    'Write only this character \u2014 never the other person\u2019s words, actions or reactions.',
    'Keep it to one beat: a thing said, a thing done, or both. Do not narrate past the moment.'
].join('\n');

// Paragraph three is the anti-drift clause and is why this mode is worth building rather than
// dangerous: the model's failure mode is accommodation, and a character who agrees with the
// author is a mirror, not evidence. The "answer the human version of a meta question" clause is
// DELIBERATELY absent -- a meta question gets an in-world non-answer, accepted.
const CC_REG_INTERVIEW = [
    'Write only the spoken answer, in first person, in this character\u2019s own register.',
    'The interviewer is a real person sitting across from them, asking about things the character lived through. Answer the question that was asked; do not open a new subject and do not interview them back.',
    'They are under no obligation to be helpful, forthcoming or agreeable. They may refuse a question, change the subject, or say they would rather not talk about it.',
    'Give the answer the room it needs \u2014 usually a few sentences, more when the question earns it, less when the character is done talking.'
].join('\n');

// Deliberately NOT the persona verbosity axis for the three non-texting modes: that ladder
// caps at 240 and is calibrated for SMS ("under 32 words"), and a spoken answer under that
// cap is a stub. One flat pin each instead. `text` alone passes 0 and defers to the ladder.
const AE_CCINT_MAX_TOKENS   = 320;
const AE_CCTALK_MAX_TOKENS  = 280;
const AE_CCSCENE_MAX_TOKENS = 340;

const CC_MODES: Record<string, CharChatMode> = {
    text: {
        id: 'text', label: 'Texting', channel: 'text conversation',
        framing: 'A live text conversation between two people, written one message at a time.',
        task: 'Below the narrative context you will find the conversation so far. Write ONLY the next single message, as the character defined above.',
        register: CC_REG_TEXT, turnNoun: 'message', bodyLabel: '[ NARRATIVE CONTEXT ]',
        marker: '\u2501\u2501 CHARACTER CHAT \u2501\u2501 The story above is reference material. Everything below this line is a conversation, not narration.',
        maxTokens: 0, usesPersona: true, usesEmotion: true,
        greet: 'You are now texting ', guard: ''
    },
    talk: {
        id: 'talk', label: 'Talking', channel: 'conversation',
        framing: 'A conversation between two people who are speaking to each other in person.',
        task: 'Below the narrative context you will find the conversation so far. Write ONLY the next thing this character says aloud.',
        register: CC_REG_TALK, turnNoun: 'reply', bodyLabel: '[ NARRATIVE CONTEXT ]',
        marker: '\u2501\u2501 CONVERSATION \u2501\u2501 The story above is reference material. Everything below this line is spoken dialogue, not narration.',
        maxTokens: AE_CCTALK_MAX_TOKENS, usesPersona: false, usesEmotion: true,
        greet: 'You are now talking with ', guard: ''
    },
    scene: {
        id: 'scene', label: 'Roleplay', channel: 'scene',
        framing: 'A scene played out between two people, one turn each, in speech and action.',
        task: 'Below the narrative context you will find the scene so far. Write ONLY this character\u2019s next turn \u2014 what they say, what they do, or both.',
        register: CC_REG_SCENE, turnNoun: 'turn', bodyLabel: '[ NARRATIVE CONTEXT ]',
        marker: '\u2501\u2501 SCENE \u2501\u2501 The story above is reference material. Everything below this line is a scene played one turn at a time.',
        maxTokens: AE_CCSCENE_MAX_TOKENS, usesPersona: false, usesEmotion: true,
        greet: 'You are now in a scene with ', guard: ''
    },
    interview: {
        id: 'interview', label: 'Interview', channel: 'interview',
        framing: 'A recorded interview. One side of it is being written.',
        task: 'Below the record you will find the interview transcript. Write ONLY the next spoken answer, as the character defined above.',
        register: CC_REG_INTERVIEW, turnNoun: 'answer', bodyLabel: '[ THE RECORD ]',
        marker: '\u2501\u2501 INTERVIEW \u2501\u2501 The story above is the record. Everything below this line is a recorded interview.',
        maxTokens: AE_CCINT_MAX_TOKENS, usesPersona: false, usesEmotion: false,
        greet: 'You are interviewing ',
        // The anti-fabrication clause. An interview invites invention in a way a text thread does not
        // -- an invented event read back as canon is the expensive failure of this mode.
        guard: 'is answering about events they lived through. Where the record is silent they may say they do not remember, or that they would rather not talk about it \u2014 inventing an event that is not in the record is worse than admitting to a gap.'
    }
};

// A THIRD POV VALUE. Interview needs its own thread bucket and this sentinel gives it one:
// _charchatParseEntryId splits on the FIRST '_pov_', and 'ce-interview' cannot collide with a
// character UUID. It is ALSO the legacy mode resolver -- state saved before CC-MODES carries
// no `mode`, and this sentinel is how _ccModeId recovers the right answer.
const CC_POV_INTERVIEW = 'ce-interview';

// [CC-XIALONG] The chat's default model. Overridable per story via cfg.charChatModel.
// NOT a general engine default: every other generator in this file is glm-4-6 and stays
// there. This one string is the only place the chat's model is decided.
const CC_DEFAULT_MODEL = 'xialong-v1';

// THE resolver. Every mode read goes through here. Order matters: an explicit stored mode
// wins, the sentinel is the legacy fallback, 'text' is the floor -- so an unrecognised id
// from a future version degrades to a working conversation rather than to undefined.
function _ccModeId(povId?: string, stored?: string): string {
    let ccmS = String(stored || '');
    if (ccmS && CC_MODES[ccmS]) return ccmS;
    if (String(povId || '') === CC_POV_INTERVIEW) return 'interview';
    return 'text';
}

// Explicit form. Use at the sites that run BEFORE _aeCharChat is assigned (startCharChat's
// append, resumeCharChatFromEntry's append) -- the same ordering hazard charChatMaxTokensFor
// documents for povId, and for the same reason. Pass the mode, do not read it.
function _ccModeFor(povId?: string, stored?: string): CharChatMode {
    return CC_MODES[_ccModeId(povId, stored)];
}

// Ambient form, for anything running mid-chat (context override, story-above-marker).
function _ccMode(): CharChatMode {
    return _ccModeFor(_aeCharChat.povId, _aeCharChat.mode);
}

// Retained because twenty call sites read it and interview is still the one mode with a
// structurally different POV. A MODE test rather than a povId test: a stored mode is
// authoritative and the sentinel is only consulted when there is none.
function _ccIsInterview(povId: string): boolean {
    return _ccModeId(povId, _aeCharChat.mode) === 'interview';
}

function _ccMarkerTextFor(povId: string): string {
    return _ccModeFor(povId, _aeCharChat.mode).marker;
}

function _ccMarkerText(): string {
    return _ccMode().marker;
}

// ── [CHAT-STAGE] The chat stage's own geometry ───────────────────────────────
// TWO NUMBERS, ITS OWN TABLE, ITS OWN FIELDS. Scene's stage is drawn into a jsx modal and
// this one into NAI's story editor; those frames have different widths, different heights
// and different things standing in them, so a slider that moved both would be one number
// lying to two surfaces. `stageFacing` is NOT duplicated here and is read from
// ceStageSettings by the one site that needs it -- it describes the ARTWORK, not a frame.
// SPREAD AND CAP HAVE NO MEANING HERE, which is why the table is two rows and not four: the
// chat stage holds exactly two figures at fixed edges, so there is no row to spread and no
// crowd to cap. A knob with no door is a parked field [F-20].
// `k` IS THE CONFIG FIELD NAME, the same convention CE_STAGE_SETTINGS uses and for the same
// reason: the resolver returns an object keyed identically, so no second vocabulary maps a
// label to a stored field.
var CE_CHAT_STAGE_SETTINGS: any[] = [
    { k: 'charChatStageScale', def: 30, lo: 12, hi: 45, step: 1, label: 'Standee width',
      sub: 'How much of the editor\u2019s width each figure may take, as a percent. It is a '
         + 'ceiling rather than a size \u2014 a tall picture runs out of height first and comes '
         + 'out narrower on its own. The text column is what is left between the two.' },
    { k: 'charChatStageFloor', def: 0, lo: 0, hi: 40, step: 1, label: 'Floor line',
      sub: 'Percent of the editor\u2019s height to lift the figures\u2019 feet off the bottom '
         + 'edge. Use it when the front of the location picture is a desk or a wall rather '
         + 'than the floor someone would stand on.' }
];

// [CHAT-STAGE-LANE] CE_CHAT_STAGE_MINCOL AND CE_CHAT_STAGE_FLANK ARE DELETED. They were the
// floor and fallback of a text column computed from the standee's width; live, the floor
// fired on every phone-sized editor, so the flanking it was protecting never happened and
// the arithmetic only obscured a plain centred column. The two widths are independent now.

// ONE DERIVATION PER ADDRESS. The bubble rules, the token push, the broadcast and the
// Chat surface's own controls all ask this and never the config, so a stored value out of
// range cannot mean one thing to the editor and another to the painter.
function ceChatStageSettings(cfg: any): any {
    var c: any = cfg || {};
    var out: any = {};
    for (var i = 0; i < CE_CHAT_STAGE_SETTINGS.length; i++) {
        var d: any = CE_CHAT_STAGE_SETTINGS[i];
        var v = Number(c[d.k]);
        if (!isFinite(v)) v = d.def;
        if (v < d.lo) v = d.lo;
        if (v > d.hi) v = d.hi;
        out[d.k] = Math.round(v);
    }
    return out;
}

// [CCAV-ENGINE] The ONE resolver for chat-avatar display, so a half-written config cannot
// produce a sentinel the bridge has to guess at. SIZE IS SNAPPED to the offered set (the Chat
// surface renders a three-option ceSelect); SHAPE is validated against the closed set the
// bridge's CSS can draw and anything else collapses to 'round'.
const CE_CCAV_SIZES: number[] = [28, 40, 52];
const CE_CCAV_SHAPES: string[] = ['round', 'rounded', 'portrait'];
function ceChatAvatarDisplay(cfg: any): { size: number; shape: string } {
    let avRaw = Number(cfg && cfg.charChatAvatarSize);
    let avSize = 40;
    if (avRaw > 0) {
        let avBest = CE_CCAV_SIZES[0];
        for (let avI = 1; avI < CE_CCAV_SIZES.length; avI++) {
            if (Math.abs(CE_CCAV_SIZES[avI] - avRaw) < Math.abs(avBest - avRaw)) avBest = CE_CCAV_SIZES[avI];
        }
        avSize = avBest;
    }
    let avShape = String((cfg && cfg.charChatAvatarShape) || 'round');
    if (CE_CCAV_SHAPES.indexOf(avShape) < 0) avShape = 'round';
    return { size: avSize, shape: avShape };
}

async function saveCharChatState(): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_CHARCHAT, JSON.stringify(_aeCharChat)); }
    catch (e) { api.v1.error('[AE:charchat] state save failed:', e); }
}

// [CHARCHAT-HUD] Carries the TURN LIST, not just chat metadata. Turns are assembled by
// charChatTurnsPayload() from _charchatScanTurns, so the bridge never infers role from the
// DOM or from text -- it renders what the document's own section metadata says.
async function broadcastCharChatState(): Promise<void> {
    try {
        let ccTurns: any[] = [];
        if (_aeCharChat.active) {
            try { ccTurns = await charChatTurnsPayload(); }
            catch (eT) { aeLog('[AE:charchat] turn payload build failed (sending metadata only):', eT); }
        }
        let ccCfgB = await loadConfig();
        // The contact's current inner state, for the header. Same field generateEphemeral() persists
        // (char.ephemeral.compressedLine) -- read-only here, this never generates one. Empty string
        // when there is no thought yet; the bridge hides the control on falsy.
        let ccThought = '';
        try {
            if (_aeCharChat.active && _aeCharChat.contactId) {
                let ccThChar = await loadCharacter(_aeCharChat.contactId);
                if (ccThChar && ccThChar.ephemeral && ccThChar.ephemeral.compressedLine) {
                    ccThought = String(ccThChar.ephemeral.compressedLine).trim();
                }
            }
        } catch (_eTh) { ccThought = ''; }
        // [CHAT-STAGE] THE FACTS, NOT THE PIXELS. Rides this message rather than a new name
        // because this is the choke point every start / resume / end / turn already passes
        // through, and the protocol is closed -- a new verb would need a case on the other
        // side, a field does not. A bridge that has not been updated ignores the key.
        // THE LOCATION IS THE CAMERA'S, ALWAYS. loadProtagonistLocation is the same read
        // buildSceneStatePayload makes, so a chat held across two places shows where the
        // READER is standing -- there is no mode fork and no \u0022which end\u0022 question anywhere
        // in this feature. The root sentinel is skipped rather than loaded: it deliberately
        // has no entity behind it, so loadEntity would be a guaranteed miss every turn.
        // AN ABSENT LOCATION STILL SHIPS on:true with an empty locId -- the two standees
        // over the scrim are the layer working, not a half-drawn one, and gating the whole
        // feature on a picture nobody has generated yet would read as the switch being broken.
        // NOT REBROADCAST BY TRAVEL. This fires on the chat's own lifecycle, so a location
        // changed mid-conversation repaints on the next turn rather than immediately. Known
        // and accepted: re-pointing travel at this is a change to a hot path for a case that
        // corrects itself one message later.
        let ccStage: any = { on: false };
        try {
            if (_aeCharChat.active && ccCfgB && (ccCfgB as any).charChatStage) {
                let ccSg: any = ceChatStageSettings(ccCfgB);
                let ccLocId = '';
                let ccImgW = 0; let ccImgH = 0;
                try {
                    let ccLoc = await loadProtagonistLocation();
                    if (ccLoc && ccLoc !== AE_ROOT_LOCATION_ID) {
                        ccLocId = String(ccLoc);
                        let ccLocEnt: any = await loadEntity(ccLocId);
                        if (ccLocEnt) {
                            ccImgW = Number(ccLocEnt.imgWidth) || 0;
                            ccImgH = Number(ccLocEnt.imgHeight) || 0;
                        }
                    }
                } catch (_eLoc) { ccLocId = ''; ccImgW = 0; ccImgH = 0; }
                ccStage = {
                    on: true,
                    locId: ccLocId, imgW: ccImgW, imgH: ccImgH,
                    scale: Number(ccSg.charChatStageScale) || 30,
                    floor: Number(ccSg.charChatStageFloor) || 0,
                    // Shared on purpose -- see CHAT-STAGE. The art's own direction, not an
                    // instruction to flip: which figure gets mirrored is a fact about where
                    // each one ended up standing, and that is the painter's to know.
                    facing: String(ceStageSettings(ccCfgB).stageFacing || 'right')
                };
            }
        } catch (_eStg) { ccStage = { on: false }; }
        await broadcastToTM(EVT_CHARCHAT_STATE, {
            active: _aeCharChat.active, contactId: _aeCharChat.contactId, contactName: _aeCharChat.contactName,
            povId: _aeCharChat.povId, povName: _aeCharChat.povName, startedAt: _aeCharChat.startedAt,
            lastEmotion: _aeCharChat.lastEmotion,
            lastThought: ccThought,
            turns: ccTurns,
            images: !!(ccCfgB && ccCfgB.charChatImages),
            freshThoughts: !!(ccCfgB && ccCfgB.charChatFreshThoughts),
            stage: ccStage,                          // [CHAT-STAGE]
            busyStage: _aeCharChat.busyStage || ''   // [CHARCHAT-THINK-FIRST]
        });
    } catch (e) { aeLog('[AE:charchat] state broadcast failed:', e); }
    // [CC-TRAY] The tray's Close / Summarize / Delete buttons exist only while a chat is open and
    // api.v1.ui.register is the only way to change the button set. This is the choke point every
    // start / resume / end / restore already passes through, and ceSyncToolbar is a CHANGE
    // DETECTOR, so per-turn calls cost one boolean compare rather than a re-registration.
    try { await ceSyncToolbar(); } catch (_eTbSync) {}
}


// [CHARCHAT-THINK-FIRST] Set the in-flight stage and push it. Always broadcasts -- a setter
// that could silently not repaint would defeat the point. Cheap: state is broadcast anyway.
async function _charchatSetBusy(stage: string): Promise<void> {
    if (_aeCharChat.busyStage === stage) return;
    _aeCharChat.busyStage = stage || '';
    aeLog('[AE:charchat:busy] ' + (stage || '(idle)'));
    try { await broadcastCharChatState(); } catch (_eSb) {}
}

// [CHARCHAT-HUD] Contacts screen data. POV-first, mirroring the native picker's own flow.
// ONE listCharChatThreads() call for every pair, filtered in memory -- same "one bulk
// lorebook call, never N lookups" discipline the native picker follows.

// ── Decorations: POV vs contact bubbles, marker band, name/tag hiding ────────
// Same shape as _wizliveRegisterDecorations: registered once with empty scopes, then
// refreshed from the live document on start, restore, and each turn end.
async function _charchatRegisterDecorations(markerId: number): Promise<void> {
    // [CHAT-BUBBLE-AXES] EVERY STYLE OBJECT BELOW IS BUILT, NOT WRITTEN -- _charchatBubbleRules
    // compiles the resolved look and ceChatSetBubble calls the same builder for a live restyle.
    // EVERY var() CARRIES A LITERAL FALLBACK. The tokens live in the bridge's stylesheet, which
    // CE-STRIP deleted once already: an unresolvable var() computes the WHOLE declaration to
    // unset, so fill, border and radius vanish together and bubbles degrade to indented text.
    // UNVERIFIED, worth a live check: whether a node marker's `style` reaches the paragraph's
    // own box rather than an inner text wrapper. script-types.txt says it styles paragraphs.
    let ccStyCfg: any = null;
    try { ccStyCfg = await loadConfig(); } catch (_eCcSty) { ccStyCfg = null; }
    let ccBubDisp = ceChatBubbleDisplay(ccStyCfg);
    let ccB = _charchatBubbleRules(ccBubDisp);
    // [CHAT-LANE] The bridge paints the avatar, the turn controls and the photo
    // card; all three have to agree with the rules built one line up. Not awaited -- a
    // token push that fails must not stop the decorations from registering.
    broadcastChatBubbleStyle();
    await api.v1.editor.decorations.registerRules([
        { id: AE_CHARCHAT_RULE_MARKER,  type: 'node', match: '^', style: ccB.marker, scope: { sectionIds: [markerId] } }, // [CHAT-TOKEN-PARITY] was 3 hardcoded rgba(232,160,74,*) literals
        // POV (yours): right-justified, hugging its own text.
        { id: AE_CHARCHAT_RULE_POV,     type: 'node', match: '^', style: ccB.pov, scope: { sectionIds: [] } },
        // Contact (theirs): left-justified, hugging its own text.
        { id: AE_CHARCHAT_RULE_CONTACT, type: 'node', match: '^', style: ccB.contact, scope: { sectionIds: [] } },
        // The Emotion: tagline. INLINE type, matched by pattern rather than a fixed id list.
        // CHARCHAT_EMOTION_PREFIX is two leading spaces then 'Emotion: ', so the pattern is
        // deliberately loose (\s*) to survive that whitespace changing.
        { id: AE_CHARCHAT_RULE_EMOTION, type: 'inline', match: '^\\s*Emotion:.*$', flags: 'm', style: ccB.emotion, scope: { sectionIds: [] } },
        // A contact bubble WITH an emotion tail below it. Same box as CONTACT but
        // open at the bottom, so the tail can close it.
        { id: AE_CHARCHAT_RULE_HEAD, type: 'node', match: '^', style: ccB.head, scope: { sectionIds: [] } },
        // The emotion tail. Closes the bubble the HEAD opened — same background,
        // no top border, no top margin, so the seam disappears and the two sections read as
        // one bubble with a tagline inside it.
        { id: AE_CHARCHAT_RULE_EMOBOX, type: 'node', match: '^', style: ccB.emobox, scope: { sectionIds: [] } },
        // Hide the "Name: " prefix. match is rebuilt per refresh from the live names (see
        // _charchatNameRuleMatch) -- registered here with a deliberately never-matching pattern so a
        // stale rule cannot hide the wrong text before the first refresh lands.
        { id: AE_CHARCHAT_RULE_NAME, type: 'inline', match: '(?!)', flags: 'm', style: { display: 'none' }, scope: { sectionIds: [] } },
        // [CHATIMG-HIDE-TAG] Hide the image PROMPT tag. The pattern is STATIC (both resolved
        // and unresolved forms) so it is registered once and only RESCOPED per refresh. Flags
        // 'gi': global for a two-image turn, case-insensitive for a model-written "[image:".
        { id: AE_CHARCHAT_RULE_IMGTAG, type: 'inline', match: '\\[[ \\t]*Image(?:#[0-9a-f]{8})?[ \\t]*:[ \\t]*[^\\]\\n\\r]+?[ \\t]*\\]', flags: 'gi', style: { display: 'none' }, scope: { sectionIds: [] } }
    ]);
}

// The "Name: " prefix pattern for the two live speakers. Returns a
// never-matching pattern when neither name is known, rather than something like '^:' that
// could match real prose.
function _charchatNameRuleMatch(): string {
    let ccNames: string[] = [];
    if (_aeCharChat.contactName) ccNames.push(_charchatEscapeRx(_aeCharChat.contactName));
    if (_aeCharChat.povName) ccNames.push(_charchatEscapeRx(_aeCharChat.povName));
    if (!ccNames.length) return '(?!)';
    return '^(?:' + ccNames.join('|') + '):[ \\t]*';
}

// [CHARCHAT-IMGWIDGET] Image anchors for the chat.
// WHY A WIDGET AND NOT A UIPartImage: script-types.txt requires UIPartImage.src to be a base64
// data URI -- no URLs -- which puts the whole payload through the Worker against
// memoryLimit: 128. This creates an EMPTY ANCHOR carrying a sentinel string instead; the BRIDGE
// finds it with a TreeWalker and paints the real <img> from its own IndexedDB.
// DRIFT IS THE PLATFORM'S JOB: NAI positions a node widget relative to its sectionId,
// repositions it on every edit, and disposes it when the section is removed.
// THE SENTINEL CARRIES THE 8-HEX SHORT ID, NOT THE FULL UUID, and that is forced: the bridge
// dbSaves under the full uuid but only the prefix is written into the document tag, and the
// document is this function's only source of truth on a restore. Do not widen the tag.
// WIDGETS DO NOT SURVIVE A RELOAD; this is the rebuild, from the DOCUMENT TAGS, so no
// tombstone list is needed. The document is the state.
var _ccImgHandles: any[] = [];

async function _ccImgDisposeHandles(): Promise<void> {
    let ccHs = _ccImgHandles;
    _ccImgHandles = [];
    for (let ccD = 0; ccD < ccHs.length; ccD++) {
        try { if (ccHs[ccD] && ccHs[ccD].dispose) await ccHs[ccD].dispose(); }
        catch (eCcD) { aeLog('[AE:charchat] widget dispose failed (already gone?)'); }
    }
}

async function refreshCharChatImageWidgets(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    // [STORYIMG] HANDLE-TRACKED rather than a blanket clearWidgets(), which would take every
    // story image with it. Each feature disposes its OWN handles and neither can reach the other's.
    await _ccImgDisposeHandles();

    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); } catch (_eccWs) { return; }

    let ccOpts: any[] = [];
    // [CHARCHAT-AVATAR-EMOTION] Avatar options are COLLECTED here and emitted after the walk,
    // because of a real ordering constraint: a turn's emotion is written on its OWN section
    // BELOW the body, but the avatar has to anchor on the section ABOVE it. At the moment the
    // anchor is chosen the emotion is unread. Not a second scan -- ccAll is already in memory.
    let ccAvaRuns: any[] = [];
    let ccPendingRun: any = null;   // the run awaiting its Emotion: line; null when none is open
    let ccSeen = false;
    let ccPrevId = _aeCharChat.markerId;   // section above the current one; seeds to the marker
    // [CHARCHAT-AVATAR] Track contact RUNS so exactly one avatar anchors per turn.
    // ccInContactRun is true for the 2nd..Nth section of a multi-paragraph reply, which is
    // how a three-line reply gets ONE avatar (on its first section) rather than three.
    let ccInContactRun = false;
    for (let ccI = 0; ccI < ccAll.length; ccI++) {
        let ccRow = ccAll[ccI];
        if (ccRow.sectionId === _aeCharChat.markerId) { ccSeen = true; ccInContactRun = false; ccPendingRun = null; continue; }
        if (!ccSeen) continue;
        let ccTxt = (ccRow.section && ccRow.section.text) || '';

        // Avatar anchoring is independent of the image scan below and must run even for a
        // section with no image tag, so it comes first and does not `continue` on empty text.
        if (_aeCharChat.setupIds.indexOf(ccRow.sectionId) >= 0) {
            ccInContactRun = false;                       // setup paragraphs are not turns
            ccPendingRun = null;
        } else {
            let ccEmoLine = /^[ \t]*Emotion:/.test(ccTxt);
            let ccIsPov = _charchatRowIsPov(ccRow.section, ccRow.sectionId);
            if (ccEmoLine || ccIsPov) {
                // Emotion tail belongs to the contact turn above it; POV turns get no avatar.
                // Either way, break the run without anchoring. The tail is also where the open
                // run LEARNS its emotion. charChatParseEmotion already runs resolveEmotion, so
                // the sentinel can only carry one of the canonical 24 -- what the bridge's
                // slot lookup keys off. A malformed tail returns '' and degrades to the bare contactId form.
                if (ccEmoLine && ccPendingRun) {
                    ccPendingRun.emotion = charChatParseEmotion(ccTxt);
                    ccPendingRun = null;
                }
                if (ccIsPov) { ccInContactRun = false; ccPendingRun = null; }
            } else {
                // A contact BODY section. Anchor an avatar only on the FIRST of a run.
                if (!ccInContactRun) {
                    // sectionId's doc comment: the widget inserts AFTER this section, so to place the avatar
                    // BESIDE the bubble (not below it) anchor on the PREVIOUS section and let the bridge pull it
                    // down into the gutter. ccPrevId is the section immediately above this one.
                    ccPendingRun = { anchorId: ccPrevId, emotion: '' };
                    ccAvaRuns.push(ccPendingRun);
                }
                ccInContactRun = true;
            }
        }
        ccPrevId = ccRow.sectionId;

        if (!ccTxt) continue;
        // Fresh regex per section: _charchatImageResolvedRx() is /g and therefore
        // stateful via lastIndex. Reusing one instance across sections silently skips
        // matches. (This is the same reason the scanner elsewhere rebuilds it per use.)
        let ccRx = _charchatImageResolvedRx();
        let ccM: RegExpExecArray | null;
        while ((ccM = ccRx.exec(ccTxt)) !== null) {
            // [CHARCHAT-IMGWIDGET-FIX] LITERALLY THE SHAPE script-types.txt's createWidgets
            // example uses: type + sectionId + a bare text part, nothing else. MEASURED: a
            // richer content array was rejected outright ("does not match any of the allowed
            // types") even though every field validated against the options interface. Do not
            // add fields back speculatively. Dropping noTemplate is safe ONLY because the
            // sentinel carries the 8-hex id and nothing else, so there is no model prose for
            // UIPartText to resolve as a storage key.
            // [CHAT-LANE] '|p' MARKS A POV PHOTO: a contact photo is a middle segment, a POV
            // photo is the LAST and carries the bubble's bottom corners. FLAG DAY -- a bridge
            // that fails its 8-hex test on the suffixed form paints no POV photo.
            ccOpts.push({
                type: 'node',
                sectionId: ccRow.sectionId,
                content: [{
                    type: 'text',
                    text: AE_CHARCHAT_IMG_SENTINEL + ccM[1]
                        + (_charchatRowIsPov(ccRow.section, ccRow.sectionId) ? '|p' : ''),
                    style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
                }]
            });
        }
    }

    // [CCAV-ENGINE] Emit the avatar sentinels now every run's Emotion: tail has been read.
    //     ce-chatava:<contactId>|<emotion>|<sizePx>|<shape>
    // Fields 3 and 4 make avatar size and shape an ENGINE setting: the widget's content is ours
    // to choose, so the bridge is TOLD what to paint instead of consulting its own localStorage.
    // The emotion field is ALWAYS emitted, empty when there is none, because a positional parse
    // cannot skip a field. FLAG DAY: an older bridge splits on the FIRST '|' and degrades to
    // the plain Avatar image.
    let ccAvaCfg: any = null;
    try { ccAvaCfg = await loadConfig(); } catch (_eAvCfg) { ccAvaCfg = null; }
    let ccAvaDisp = ceChatAvatarDisplay(ccAvaCfg);
    for (let ccA = 0; ccA < ccAvaRuns.length; ccA++) {
        let ccRun = ccAvaRuns[ccA];
        ccOpts.push({
            type: 'node',
            sectionId: ccRun.anchorId,
            content: [{
                type: 'text',
                text: AE_CHARCHAT_AVA_SENTINEL + (_aeCharChat.contactId || '')
                    + '|' + (ccRun.emotion || '')
                    + '|' + String(ccAvaDisp.size)
                    + '|' + ccAvaDisp.shape,
                style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
            }]
        });
    }

    if (!ccOpts.length) return;
    try {
        let ccHandles: any = await api.v1.editor.decorations.createWidgets(ccOpts);
        _ccImgHandles = (ccHandles && ccHandles.length) ? ccHandles : [];
    }
    catch (eccW) { aeLog('[AE:charchat] chat widget create failed (photos/avatars will not bind):', eccW); }
}

async function refreshCharChatDecorations(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); } catch (_eccScan) { return; }
    let povIds: number[] = [];
    let contactIds: number[] = [];
    // [CHARCHAT-BUBBLES2] headIds/emoIds are DISJOINT from contactIds — a section
    // must land in exactly one node rule's scope or two boxes fight over the same paragraph.
    let headIds: number[] = [];
    let emoIds: number[] = [];
    let ccLastContact = -1;   // the contact section directly above; -1 when the run is broken
    let ccEmoLineRx = /^[ \t]*Emotion:/;
    let ccSeen = false;
    for (let ccIdx = 0; ccIdx < ccAll.length; ccIdx++) {
        let ccRow = ccAll[ccIdx];
        if (ccRow.sectionId === _aeCharChat.markerId) { ccSeen = true; continue; }
        if (!ccSeen) continue;
        if (_aeCharChat.setupIds.indexOf(ccRow.sectionId) >= 0) { contactIds.push(ccRow.sectionId); ccLastContact = -1; continue; }
        // An emotion line is its own section (NAI splits on the '\n' _charchatFormatReply
        // writes). Promote the contact bubble above it to HEAD and take this one as the tail.
        if (ccEmoLineRx.test((ccRow.section && ccRow.section.text) || '')) {
            emoIds.push(ccRow.sectionId);
            if (ccLastContact >= 0) {
                let ccK = contactIds.indexOf(ccLastContact);
                if (ccK >= 0) contactIds.splice(ccK, 1);
                headIds.push(ccLastContact);
            }
            ccLastContact = -1;
            continue;
        }
        // Shared with the transcript walk and the normaliser, which is the only way all three
        // can be guaranteed to agree about who said what.
        if (_charchatRowIsPov(ccRow.section, ccRow.sectionId)) { povIds.push(ccRow.sectionId); ccLastContact = -1; }
        else {
            // [CHARCHAT-TRAILING-BLANK-COLOR] The blank paragraph left after a reply has no
            // source and no origin, so _charchatRowIsPov cannot classify it and it fell through
            // to contactIds. Detected as "empty text AND last section". VISUAL ONLY.
            let ccIsTrailingBlank = (ccIdx === ccAll.length - 1) && !((ccRow.section && ccRow.section.text) || '').trim();
            if (ccIsTrailingBlank) { povIds.push(ccRow.sectionId); ccLastContact = -1; }
            else { contactIds.push(ccRow.sectionId); ccLastContact = ccRow.sectionId; }
        }
    }
    try {
        await api.v1.editor.decorations.updateRules([
            { id: AE_CHARCHAT_RULE_POV,     scope: { sectionIds: povIds } },
            { id: AE_CHARCHAT_RULE_CONTACT, scope: { sectionIds: contactIds } },
            // Same scope as CONTACT: the pattern match already restricts which text gets
            // tagged, so reusing the list stays trivially in sync with the classification. The
            // inline rule spans both the tail sections and the contact bubbles, so if NAI ever
            // stops splitting on '\n' this still styles the line.
            { id: AE_CHARCHAT_RULE_EMOTION, scope: { sectionIds: contactIds.concat(headIds, emoIds) } },
            { id: AE_CHARCHAT_RULE_HEAD,    scope: { sectionIds: headIds } },
            { id: AE_CHARCHAT_RULE_EMOBOX,  scope: { sectionIds: emoIds } },
            // Names are hidden across every speaking section, both sides.
            { id: AE_CHARCHAT_RULE_NAME, match: _charchatNameRuleMatch(), flags: 'm',
              scope: { sectionIds: povIds.concat(contactIds, headIds) } },
            // [CHATIMG-HIDE-TAG] Same scope as NAME — an image tag can appear in
            // either speaker's turn (the POV side attaches photos too), and HEAD is included
            // for the same belt-and-braces reason EMOTION includes it above.
            { id: AE_CHARCHAT_RULE_IMGTAG, scope: { sectionIds: povIds.concat(contactIds, headIds) } }
        ]);
    } catch (eccD) { aeLog('[AE:charchat] decoration refresh failed (cosmetic only):', eccD); }
    // [CHARCHAT-IMGWIDGET] Called from HERE rather than from this function's own call sites:
    // the image anchors and the bubble decorations describe the same document state, so binding
    // them together is the only way they cannot drift. Awaited but non-fatal.
    // [DIAG CE-DIAG-FLAGS] ccSkipWidgets skips the clear+rebuild widget pass but keeps bubble
    // decorations, isolating the most document-invasive per-turn operation.
    if (CE_DIAG.ccSkipWidgets) { aeLog('[AE:diag] ccSkipWidgets ON \u2014 widget clear/rebuild skipped this turn.'); return; }
    try { await refreshCharChatImageWidgets(); } catch (_eccIw) {}
}

// ── Context assembly ────────────────────────────────────────────

// ── [CHARCHAT-PERSONA] Structured texting persona ───────────────
// Three closed axes plus a free-text escape hatch: STRUCTURED, NOT GENERATED. The reason is
// placement -- the compiled persona rides the next-message instruction, a terse block at the
// true bottom of context, and a generated paragraph would drown it and be re-paid every turn.
// 'auto' emits an EMPTY clause on purpose and is a CORRECT output: the mode's register rubric
// owns register by default.
interface CharChatOpt { id: string; label: string; clause: string; }

// [PERSONA-AUTO-COPY] The 'auto' rows say what the state IS, not where it came from. NOTHING
// is compiled from the profile on this side -- what produces a per-character texting voice is
// the mode's register rubric asking the model to derive one. The old "Auto (from their
// profile)" label read as an inspectable CE feature with nothing behind it.
const CHARCHAT_STYLE_OPTS: CharChatOpt[] = [
    { id: 'auto',     label: 'Default \u2014 how they would text', clause: '' },
    { id: 'casual',   label: 'Digital native / casual',   clause: 'relaxed grammar, lowercase, slang and abbreviations' },
    { id: 'standard', label: 'Standard / adult',          clause: 'standard punctuation, clear syntax, concise phrasing' },
    { id: 'formal',   label: 'Formal / tech-unsavvy',     clause: 'overly formal grammar, full sentences, heavy ellipses' },
    { id: 'clipped',  label: 'Clipped / guarded',         clause: 'short and flat, minimal punctuation, gives little away' },
    { id: 'warm',     label: 'Warm / effusive',           clause: 'affectionate, generous with words, leans into feeling' },
    { id: 'florid',   label: 'Florid / theatrical',       clause: 'ornate word choice, dramatic phrasing, deliberate flourish' }
];

// `tokens` is the whole reason verbosity is not just another clause: telling the model
// "be brief" while handing it a 240-token cap is two instructions that disagree, and
// the cap always wins. This axis sets BOTH. tokens:0 means "use AE_CHARCHAT_MAX_TOKENS".
interface CharChatVerbOpt extends CharChatOpt { tokens: number; }
const CHARCHAT_VERBOSITY_OPTS: CharChatVerbOpt[] = [
    { id: 'auto',   label: 'Default \u2014 SMS length',  clause: '',                                        tokens: 0   },
    { id: 'terse',  label: 'Terse (a few words)',      clause: 'a few words, under 10 words',             tokens: 60  },
    { id: 'short',  label: 'Short (one sentence)',     clause: 'one sentence, under 20 words',            tokens: 90  },
    { id: 'normal', label: 'Normal (SMS length)',      clause: 'SMS length, under 32 words',              tokens: 120 },
    { id: 'chatty', label: 'Chatty (two or three)',    clause: 'two or three sentences, under 50 words',  tokens: 170 },
    { id: 'long',   label: 'Long (a short paragraph)', clause: 'up to a short paragraph, under 80 words', tokens: 240 }
];

const CHARCHAT_EMOJI_OPTS: CharChatOpt[] = [
    { id: 'auto',  label: 'Default \u2014 how they would text', clause: '' },
    { id: 'none',  label: 'Never',                     clause: 'never use emoji or kaomoji' },
    { id: 'rare',  label: 'Rare',                      clause: 'emoji only rarely, and never the same one twice in a row' },
    { id: 'some',  label: 'Some',                      clause: 'occasional emoji, never the same one twice in a row' },
    { id: 'heavy', label: 'Heavy',                     clause: 'expressive emoji and kaomoji throughout, but never repeat one consecutively' }
];

function _charchatOpt(opts: CharChatOpt[], id: string): CharChatOpt {
    let ccWant = id || 'auto';
    for (let ccI = 0; ccI < opts.length; ccI++) { if (opts[ccI].id === ccWant) return opts[ccI]; }
    return opts[0];
}

// The compiled persona as ONE line for the instruction block. Empty when the persona is
// absent, disabled or fully 'auto' -- the intended resting state, not a failure.
function buildCharChatPersonaClause(char: CharacterRecord): string {
    let cp = char.chatPersona;
    if (!cp || cp.enabled === false) return '';
    let ccBits: string[] = [];
    let ccSt = _charchatOpt(CHARCHAT_STYLE_OPTS, cp.style || 'auto').clause;
    if (ccSt) ccBits.push('Style: ' + ccSt + '.');
    let ccVb = _charchatOpt(CHARCHAT_VERBOSITY_OPTS, cp.verbosity || 'auto').clause;
    if (ccVb) ccBits.push('Length: ' + ccVb + '.');
    let ccEm = _charchatOpt(CHARCHAT_EMOJI_OPTS, cp.emoji || 'auto').clause;
    if (ccEm) ccBits.push('Emoji: ' + ccEm + '.');
    if (cp.notes && cp.notes.trim()) ccBits.push(cp.notes.trim().replace(/\s+/g, ' '));
    // [LEGACY] the old freeform shape, folded in as trailing notes so a character authored before
    // the three-axis persona does not silently lose their register.
    let ccLeg: string[] = [];
    if (cp.register && cp.register.trim()) ccLeg.push(cp.register.trim());
    if (cp.voice && cp.voice.trim())       ccLeg.push(cp.voice.trim());
    if (cp.content && cp.content.trim())   ccLeg.push(cp.content.trim());
    if (ccLeg.length > 0) ccBits.push(ccLeg.join(' ').replace(/\s+/g, ' '));
    return ccBits.join(' ');
}

// The output cap for THIS contact. Verbosity owns it entirely.
// [CCINT] povId is optional and MUST be passed at both pin sites: this runs from startCharChat
// BEFORE _aeCharChat is assigned, so it cannot read the mode from module state. Pass the mode,
// do not read it. Omitting it (the persona preview) yields the phone answer, correct there.
function charChatMaxTokensFor(char: CharacterRecord | null, cfg: GlobalConfig | null, povId?: string): number {
    // [CC-MODES] Only `text` defers to the persona verbosity ladder. That axis IS the SMS
    // axis -- wording and cap together -- and neither half applies to someone speaking, so
    // every other mode carries its own flat pin in CC_MODES.
    let ccMode = _ccModeFor(povId, _aeCharChat.mode);
    if (ccMode.maxTokens > 0) return ccMode.maxTokens;
    let ccBase = AE_CHARCHAT_MAX_TOKENS;
    let ccCp = char ? char.chatPersona : null;
    if (ccCp && ccCp.enabled !== false) {
        let ccV = _charchatOpt(CHARCHAT_VERBOSITY_OPTS, ccCp.verbosity || 'auto') as CharChatVerbOpt;
        if (ccV && ccV.tokens > 0) ccBase = ccV.tokens;
    }
    return ccBase;
}

// ── [CC-AETHER] THE STEERING SURFACE, IN AETHERROOM CARD FORMAT ─────────────
// The model reading this is xialong-v1, trained on this exact layout: a header line, then
// `----`-delimited blocks, then `Field: value` lines. FORMAT IS INSTRUCTION for a
// format-trained model, and the code below is the spec.
// THE IDENTITY BLOCK IS buildLorebookContent's OUTPUT, not re-derived field by field: that
// function is the identity authority for every other consumer, and a second projection would
// drift the first time a field was added. The contact's lorebook entry is deactivated for the
// turn, so this is a move, not a duplication.
function _ccField(label: string, value: any): string {
    let ccfV = String(value === undefined || value === null ? '' : value).trim();
    if (!ccfV) return '';
    return label + ': ' + ccfV.replace(/\s*\n\s*/g, ' ') + '\n';
}

// The relation line. AetherRoom carries either a named relationship or an explicit
// "doesn't know them" -- the second is not an absence, it is a statement, and a model
// given neither will invent familiarity. CE's CharPosition is the nearest thing we hold.
function _ccRelationLine(contact: CharacterRecord, povName: string): string {
    if (!povName) return '';
    let ccrP: any = (contact as any).position || {};
    let ccrBits: string[] = [];
    if (ccrP.shape)    ccrBits.push(String(ccrP.shape));
    if (ccrP.standing) ccrBits.push(String(ccrP.standing));
    let ccrTgt = String(ccrP.targetName || '').trim();
    if (ccrBits.length > 0 && ccrTgt && ccrTgt.toLowerCase() === povName.toLowerCase()) {
        return 'Relationship: ' + ccrBits.join(' \u2014 ') + '\n';
    }
    return 'Opinion of ' + povName + ': not established.\n';
}

async function buildCharChatSystemPrompt(contact: CharacterRecord, cfg: GlobalConfig, povId: string): Promise<string> {
    let ccM = _ccModeFor(povId, _aeCharChat.mode);
    let ccPovName = String(_aeCharChat.povName || '');
    let ccOut = 'AetherRoom\n----\n';

    // ── the contact ────────────────────────────────────────────────────────
    ccOut += contact.name + '\n';
    ccOut += 'Type: contact\n';
    // [CC-DEDUP] The builder owns the seven identity fields (style 'aether'); this block owns
    // only what the builder cannot know -- the card header, the type, and the relation to the POV.
    ccOut += _ccRelationLine(contact, ccPovName);

    let ccIdentity = '';
    try { ccIdentity = (await buildLorebookContent(contact, 'aether')).trim(); }
    catch (eccI) { api.v1.error('[AE:charchat] identity build failed:', eccI); }
    if (ccIdentity) ccOut += ccIdentity + '\n';
    else if (contact.briefDescription) ccOut += contact.briefDescription.trim() + '\n';

    let ccDyn = '';
    try { ccDyn = (await buildCharDynamicBlock(contact, cfg)).trim(); }
    catch (eccD2) { api.v1.error('[AE:charchat] dynamic block failed:', eccD2); }
    if (ccDyn) ccOut += ccDyn + '\n';

    // ── the other side ─────────────────────────────────────────────────────
    // Interview has no POV CharacterRecord by construction, so it gets a role line instead of
    // a card: the interviewer genuinely has no identity, and saying so beats leaving the model
    // to infer one.
    ccOut += '----\n';
    if (ccM.id === 'interview') {
        ccOut += 'The interviewer\nType: user\nRole: asking the questions on the record.\n';
    } else if (ccPovName) {
        ccOut += ccPovName + '\nType: user\n';
        let ccPovRec: CharacterRecord | null = null;
        try { if (_aeCharChat.povId) ccPovRec = await loadCharacter(_aeCharChat.povId); }
        catch (eccPv) { ccPovRec = null; }
        // [CC-DEDUP] Same builder, same style as the contact block, so the two cannot drift the first
        // time a field is added.
        if (ccPovRec) {
            let ccPovTxt = '';
            try { ccPovTxt = (await buildLorebookContent(ccPovRec, 'aether')).trim(); }
            catch (eccPb) { ccPovTxt = ''; }
            if (ccPovTxt) ccOut += ccPovTxt + '\n';
        }
    } else {
        ccOut += 'The other person\nType: user\n';
    }

    // ── where this is happening ────────────────────────────────────────────
    let ccEnv = '';
    ccEnv += _ccField('Environment', cfg ? (cfg as any).projectGenre : '');
    ccEnv += _ccField('Scene', cfg ? (cfg as any).projectConcept : '');
    if (ccEnv) ccOut += '----\n' + ccEnv;

    // ── the ask ────────────────────────────────────────────────────────────
    // LAST, and closest to the conversation it governs. The register rubric is the MODE's --
    // per-contact register is buildCharChatPersonaClause's job and lands on the instruction
    // tail -- which is what lets the card stay byte-identical when a story switches chats.
    ccOut += '----\n' + ccM.framing + '\n' + ccM.task + '\n' + ccM.register + '\n';
    return ccOut.replace(/\n{3,}/g, '\n\n').replace(/\s+$/, '');
}

// The next-message instruction. Appended to the END of storyText.content, which puts it at true
// bottom of context and keeps it invisible in the document.
// TWO NON-NEGOTIABLE INVARIANTS, both paid for by a four-version empty-reply arc:
//   CHARCHAT-USERTOKEN -- the context must not end on a closed bracket block. The dangling
//     '<name>:' cue is the fix, appended by runCharChatContextOverride, not here.
//   CHARCHAT-TAIL-TERMINAL -- the LAST block must be UNCONDITIONAL.

// Deliberate priority order -- task, register, state, output protocol. "Most present" is a
// position, not a volume: the bottom of context is the only place we control precisely.
function buildCharChatInstruction(contact: CharacterRecord, povName: string, cfg: GlobalConfig | null, povId: string): string {
    // [CC-MODES] Every mode shares this ONE tail; the differences are CC_MODES fields read
    // below, so the two invariants above are defended in one place rather than in copies.
    let ccName = _aeCharChat.contactName || contact.name;
    let ccAddr = povName ? (', addressed to ' + povName) : '';
    let ccOut: string[] = [];

    // The name header is never requested and never trusted -- it is applied programmatically
    // on the way in and again by the standing pass. Saying so stops the model spending its
    // 120 tokens re-deriving a header we throw away.
    ccOut.push('[ Instruction: Write the next ' + _ccMode().turnNoun + ' from ' + ccName + ccAddr + '. '
             + 'If the previous ' + _ccMode().turnNoun + ' also belongs to ' + ccName + ' \u2014 complement it rather than repeating it. '
             + 'Write ONLY the message body: the name header is applied automatically, so never write one yourself. '
             // [CHARCHAT-CONTACT-BRACE] Naming the specific failure rather than forbidding
             // headers in the abstract: the model imitates the brace convention it can see on
             // the POV turns above. _charchatCanonContact is the guarantee; this is prevention.
             + 'Never write curly braces around your message \u2014 those belong to ' + (povName || 'the other person') + '\u2019s messages only. ]');

    // [CC-MODES] Gated on the mode. The persona clause compiles an SMS register -- lowercase
    // slang, emoji density, "under 32 words" -- which put a SPOKEN reply in textspeak the moment
    // a non-texting mode existed. Spoken register arrives via voiceAndMannerisms in the card.
    if (_ccMode().usesPersona) {
        let ccPersona = buildCharChatPersonaClause(contact);
        if (ccPersona) ccOut.push('[ ' + ccName + '\u2019s texting style: ' + ccPersona + ' ]');
    }

    // THE EPHEMERAL LINE RIDES HERE, NOT THE AUTHOR'S NOTE: the AN lands at the author's
    // configured depth INSIDE recent history and the hook exposes no depth control, so a "right
    // now" line was always some arbitrary distance from the generation point.
    // [CHARCHAT-TAIL-ORDER] Read here, PUSHED LAST -- see the bottom of this function.
    let ccEph = (contact.ephemeral && contact.ephemeral.compressedLine) ? String(contact.ephemeral.compressedLine).trim() : '';

    // [CHARCHAT-THOUGHT-POST] ccEph IS ONE TURN STALE AND THAT IS THE DESIGN:
    // generateChatEphemeral runs from onGenerationEnd AFTER each reply, so this line describes
    // the moment the last reply landed. Four attempts to make it describe THIS moment each cost
    // the reply itself. If thinking failed, was cancelled or is off, the previous snapshot is
    // served unchanged: not writing IS the fallback.
    // [CHARCHAT-IMG] Attachment clause, only when the feature is on. The model is asked for a
    // DESCRIPTION, not tags -- the architect pass builds the prompt.
    if (cfg && cfg.charChatImages) {
        ccOut.push('[ You may attach a photo when it fits \u2014 a selfie, something you are looking at, '
                 + 'or anything ' + (povName || 'they') + ' asks you to show. Do it when it is natural, and always when asked. '
                 + 'To attach one, put this on its own line AFTER your message text: [Image: a clear description of what the photo shows] '
                 + 'Describe the shot in plain words (what you are doing, wearing, where you are, the framing). '
                 + 'Do not describe your own face or body \u2014 that is applied automatically. Never attach more than one photo per message. ]');
    }

    // [CHARCHAT-EMOTION-LIST] No 24-word list here on purpose: resolveEmotion()/EMOTION_MAP
    // maps 136 synonyms onto the 24 and both readers of this tag run it through that map.
    // [CHARCHAT-TAIL-TERMINAL] THE TERMINAL BLOCK MUST BE UNCONDITIONAL. MEASURED: with the
    // conditional thought last, the prompt's terminal block changed shape permanently after the
    // first reply and every turn after the first returned an empty completion. NOTHING MAY BE
    // PUSHED AFTER THE EMOTION DIRECTIVE (or the closing voice directive, where there is none).
    if (_ccMode().guard) ccOut.push('[ ' + ccName + ' ' + _ccMode().guard + ' ]');
    if (ccEph) ccOut.push('[ ' + ccName + ' right now: ' + ccEph + ' ]');
    if (_ccMode().usesEmotion) {
        ccOut.push('[ End your ' + _ccMode().turnNoun + ' with a new line: Emotion: <a single word for how ' + ccName + ' feels right now> ]');
    } else {
        ccOut.push('[ Write in ' + ccName + '\u2019s own voice, and stop when they are done \u2014 no closing remark, and no line about the conversation itself. ]');
    }
    return ccOut.join('\n');
}

// ── [CHARCHAT-TURNS] Canonical turn formatting ──────────────────────────────
// The user writes whatever they like and we rewrite it into canonical shape AFTERWARDS:
//   "{Hi, Sara}"  ->  "{user: Hi, Sara}"
//   "Hi, Sara"    ->  "{user: Hi, Sara}"
//   "{Hi, Sara"   ->  "{user: Hi, Sara}"     (unclosed brace closed for them)
//   "Hi, Paul"    ->  "Sara:\nHi, Paul"       (contact side)
// A header the MODEL wrote is stripped and re-applied rather than trusted, so a WRONG one can
// never survive. Every POV turn is re-emitted WITH its closing brace, so a dangling "{" cannot
// reach the model from any source.

const CHARCHAT_EMOTION_PREFIX = '  Emotion: ';   // [earlier, per user] two leading spaces. The one authored string in this subsystem whose exact whitespace is load-bearing — user's emotion-image widget matches on it.

// One shared regex builder rather than three drifting copies -- a private copy silently stopped
// matching the moment CHARCHAT_EMOTION_PREFIX gained its leading spaces.
function _charchatEmotionRx(): RegExp { return /[\n\r\s]*Emotion:[ \t]*([^\n\r]+?)[ \t]*$/i; }

// ── [CHARCHAT-IMG] Image attachment tags ────────────────────────────────────
// TWO regexes, and the distinction is the mechanism:
//   UNRESOLVED  "[Image: a description]"          -- what the MODEL writes.
//   RESOLVED    "[Image#7f3a91c2: a description]" -- what WE rewrite it to once dispatched.
// The unresolved pattern requires ':' directly after the word, so a resolved tag can never
// re-match it -- which is what makes the pass idempotent on every generation end.
// THE TAG STAYS IN THE DOCUMENT because the document is the durable record, serialised into the
// lorebook on Save and read back on resume; embedding the uuid IN the text means the pointer
// survives the round trip with no side-table.
function _charchatImageRx(): RegExp { return /\[[ \t]*Image[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/gi; }
function _charchatImageResolvedRx(): RegExp { return /\[[ \t]*Image#([0-9a-f]{8})[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/gi; }

// Max attachments dispatched per generation-end pass. A model that decides every message
// deserves a photo would otherwise spend real budget without bound. A backstop, not a feature.
const AE_CHARCHAT_IMG_MAX_PER_TURN = 2;
const AE_CHARCHAT_IMG_MAX_TOKENS = 300;   // matches buildArchitectPromptFromStory's own architect cap

// ROLE CLASSIFICATION, IN ONE PLACE. Role is NEVER inferred from text.
// THE RULE: a section is a POV turn if NAI stamped it entirely user/edit-typed. Origin CANNOT
// answer any finer question -- an engine-written POV turn and an engine-written contact reply
// are both 'script' -- and every attempt to widen it produced the "{ {Nate: ...} }" double-wrap
// corruption. DO NOT WIDEN IT AGAIN. sectionId is kept though unused; every caller passes it.
function _charchatRowIsPov(section: any, sectionId?: number): boolean {
    if (section.source === 'instruction') return true;
    let ccOrg = section.origin || [];
    if (ccOrg.length === 0) return false;
    let ccAllTyped = true;
    let ccAnyUser = false;
    for (let ccO of ccOrg) {
        if (ccO.data === 'user') ccAnyUser = true;
        if (ccO.data !== 'user' && ccO.data !== 'edit') { ccAllTyped = false; break; }
    }
    return ccAllTyped && ccAnyUser;
}

// [CHARCHAT-MERGE] Detect a section whose origin crosses from user-typed (user/edit or script)
// to AI-generated (ai/prompt). That is the signature of NAI's native Send continuing a
// completion DIRECTLY INTO the paragraph the user typed into, because the cursor had no
// trailing break. _charchatRowIsPov trusts one source for the WHOLE section, so a merged
// section was canonicalised as one giant POV turn -- the confirmed source of both the "double
// brace" and the "contact header bleeding into the POV body" reports.
// Returns the offset where the AI portion begins, or -1 if the origin is homogeneous. Sorted
// defensively. 'script' MUST count as pre-AI: without it a bridge-sent turn NAI glued a
// completion onto is invisible here and never split.
function _charchatMergeSplitIdx(section: any): number {
    let ccOrg = (section && section.origin) || [];
    if (ccOrg.length < 2) return -1;
    let ccSorted = ccOrg.slice().sort(function(a: any, b: any) { return a.position - b.position; });
    let ccSawUser = false;
    for (let ccO of ccSorted) {
        if (ccO.data === 'user' || ccO.data === 'edit') { ccSawUser = true; continue; }
        if (ccSawUser && (ccO.data === 'ai' || ccO.data === 'prompt')) return ccO.position;
    }
    return -1;
}

// Strip a leading "Name:" header — whoever wrote it. Every name we know about is tried,
// so a header the model got WRONG is removed too rather than kept and doubled up.
function _charchatStripHeader(body: string, names: string[]): string {
    let ccT = (body || '').replace(/^\s+/, '');
    for (let ccPass = 0; ccPass < 2; ccPass++) {   // 2 passes: "Sara:\nSara: hi" happens
        let ccHit = false;
        for (let ccI = 0; ccI < names.length; ccI++) {
            if (!names[ccI]) continue;
            // [\s*] not [\r?\n?] after the colon: _charchatScanTurns joins a grouped turn with '\n', so a
            // reply NAI split as ["Sara:", "", "Hi, Paul"] arrives as "Sara:\n\nHi, Paul". Consuming at
            // most ONE newline left the blank line in place -- the "response adds a second newline" report.
            let ccRx = new RegExp('^\\*{0,2}' + _charchatEscapeRx(names[ccI]) + '\\*{0,2}[ \\t]*[:\uff1a]\\s*', 'i');
            if (ccRx.test(ccT)) { ccT = ccT.replace(ccRx, ''); ccHit = true; break; }
        }
        if (!ccHit) break;
    }
    return ccT;
}

// Unwrap our own brace wrapper, tolerating BOTH the unclosed case and the never-opened
// case — per user, the user was never obliged to type either one.
function _charchatUnwrapPov(text: string): string {
    let ccS = (text || '').trim();
    // [CHARCHAT-POV-IDEMPOTENT] Loop until no wrapper is left, so canon(canon(x)) === canon(x)
    // and re-prompting is byte-identical to prompting once -- a single strip left a re-sent turn
    // double-wrapped. Bounded rather than while(true): a nested wrapper costs a fixed number of
    // passes rather than hanging the worker.
    for (let ccPass = 0; ccPass < 8; ccPass++) {
        let ccBefore = ccS;
        if (ccS.charAt(0) === '{') ccS = ccS.substring(1);
        if (ccS.length > 0 && ccS.charAt(ccS.length - 1) === '}') ccS = ccS.substring(0, ccS.length - 1);
        ccS = ccS.trim();
        if (ccS === ccBefore) break;
    }
    return ccS.trim();
}

// CANONICAL POV TURN. '' means "there is no turn here" -- callers drop it rather than emitting
// an empty one. THE LITERAL BRACES ARE LOAD-BEARING, established by direct test: without them a
// POV paragraph has nothing marking it as a fresh instruction turn and reads as a continuation
// of the previous contact turn. NAI does not draw a bracket of its own here (a typed "{Hi!}"
// came back doubled, a bare "Hi!" came back bodyless).
function _charchatCanonPov(text: string, povName: string, contactName: string): string {
    let ccBody = _charchatStripHeader(_charchatUnwrapPov(text), [povName, contactName]).replace(/\s+$/, '');
    if (!ccBody) return '';
    return '{' + (povName ? (povName + ': ' + ccBody) : ccBody) + '}';
}

// CANONICAL CONTACT TURN. The Emotion tag is split off first and re-attached last, so
// the header strip can never mistake it for body and a body strip can never eat it.
function _charchatCanonContact(text: string, contactName: string, povName: string): string {
    let ccT = (text || '');
    let ccEmotion = '';
    let ccCut = ccT.match(_charchatEmotionRx());
    if (ccCut && ccCut[1] && ccCut.index !== undefined) {
        let ccE = ccCut[1].trim();
        // Canonicalise to the 24-state list via resolveEmotion()/EMOTION_MAP, the same
        // normaliser the image pipeline uses: the emotion-image widget keys off those 24 words.
        if (ccE.length > 0 && ccE.length <= 40) { ccEmotion = resolveEmotion(ccE); ccT = ccT.substring(0, ccCut.index); }
    }
    let ccBody = _charchatStripHeader(ccT, [contactName, povName]).replace(/\s+$/, '');
    // [CHARCHAT-CONTACT-BRACE] The model sees Name-colon after a brace-wrapped POV turn,
    // generalises the convention, and opens a brace of its own -- on one reported send it
    // emitted only that and stopped. Unwrap here too, then treat a body that is nothing but
    // punctuation as NO body: returning '' makes the normaliser drop the turn.
    if (ccBody.indexOf('{') >= 0 || ccBody.indexOf('}') >= 0) {
        // [CHARCHAT-BRACE-LINE] A boundary-only unwrap misses a grouped turn whose text is
        // "}\nCan't you figure it out? ..." -- charAt(0) is '}' not '{', so nothing was
        // stripped and the normaliser stamped a header onto the brace line and enshrined it as
        // its own message. Strip pure brace/punctuation LINES first, then unwrap the boundary.
        let ccLinesB = ccBody.split('\n');
        while (ccLinesB.length > 1 && !/[\p{L}\p{N}]/u.test(ccLinesB[0])) ccLinesB.shift();
        while (ccLinesB.length > 1 && !/[\p{L}\p{N}]/u.test(ccLinesB[ccLinesB.length - 1])) ccLinesB.pop();
        let ccDeBraced = ccLinesB.join('\n');
        if (ccDeBraced !== ccBody) {
            aeLog('[AE:charchat:contact-brace] stripped a scaffold-only line from a contact turn '
                + '(the model opened or closed a brace on its own line before writing the message).');
            ccBody = ccDeBraced;
        }
        let ccUnwrapped = _charchatUnwrapPov(ccBody);
        ccUnwrapped = _charchatStripHeader(ccUnwrapped, [contactName, povName]).replace(/\s+$/, '');
        if (ccUnwrapped !== ccBody) ccBody = ccUnwrapped;
    }
    // Scaffold-only: no letter or digit anywhere. Not merely "is it a brace" -- the observed
    // failures are all header-plus-brace or brace-only, and pure punctuation is never a message.
    if (ccBody && !/[\p{L}\p{N}]/u.test(ccBody)) {
        aeLog('[AE:charchat:contact-brace] dropped a scaffold-only contact body '
            + JSON.stringify(ccBody.substring(0, 20)) + ' — the model wrote a header/brace and no message. '
            + 'The turn is dropped rather than enshrined; if this fires every turn, the reply prompt is losing to the context shape.');
        ccBody = '';
    }
    if (!ccBody && !ccEmotion) return '';
    // Header and body share a line ("Sara: message") -- a real text message does not put the
    // sender's name on its own line. Emotion keeps its own line below: CHARCHAT_EMOTION_PREFIX's
    // leading newline is what the external emotion-image widget scans for.
    let ccOut = (contactName || 'They') + ': ' + (ccBody || '\u2026');
    if (ccEmotion) ccOut += '\n' + CHARCHAT_EMOTION_PREFIX + ccEmotion;
    return ccOut;
}

// A logical turn = a run of CONSECUTIVE same-role paragraphs. Grouping before normalising is
// correctness, not optimisation: NAI splits a reply into sections however it likes, and
// normalising each in isolation stamps a "Sara:" header onto every line of a three-paragraph
// reply. Grouping also absorbs the stray blank a trailing newline leaves.
async function _charchatScanTurns(): Promise<{ turns: { isPov: boolean; ids: number[]; texts: string[] }[]; ids: number[] }> {
    let ccTurns: { isPov: boolean; ids: number[]; texts: string[] }[] = [];
    let ccAllIds: number[] = [];
    if (_aeCharChat.markerId === null) return { turns: ccTurns, ids: ccAllIds };
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); }
    catch (eTs) { api.v1.error('[AE:charchat] turn scan failed:', eTs); return { turns: ccTurns, ids: ccAllIds }; }
    let ccSeen = false;
    for (let ccR of ccAll) {
        if (ccR.sectionId === _aeCharChat.markerId) { ccSeen = true; ccAllIds.push(ccR.sectionId); continue; }
        if (!ccSeen) continue;
        ccAllIds.push(ccR.sectionId);
        if (_aeCharChat.setupIds.indexOf(ccR.sectionId) >= 0) continue;

        // [CHARCHAT-MERGE] READ-ONLY safety net; the real fix splits the section in
        // _charchatSplitMergedSections (write-pass only -- this also runs on dryRun and must
        // never mutate). If that split has not run, cut at the same origin boundary in memory.
        // If this fires during the WRITE pass both halves carry the SAME sectionId and the
        // second write wins, losing the other half for that cycle. Accepted.
        let ccFullText = ccR.section.text || '';
        let ccSplitIdx = _charchatMergeSplitIdx(ccR.section);
        if (ccSplitIdx > 0 && ccSplitIdx < ccFullText.length) {
            let ccHead = ccFullText.substring(0, ccSplitIdx);
            let ccTail = ccFullText.substring(ccSplitIdx);
            let ccLastH = (ccTurns.length > 0) ? ccTurns[ccTurns.length - 1] : null;
            if (ccLastH && ccLastH.isPov) { ccLastH.ids.push(ccR.sectionId); ccLastH.texts.push(ccHead); }
            else ccTurns.push({ isPov: true, ids: [ccR.sectionId], texts: [ccHead] });
            ccTurns.push({ isPov: false, ids: [ccR.sectionId], texts: [ccTail] });
            continue;
        }

        let ccIsPov = _charchatRowIsPov(ccR.section, ccR.sectionId);
        let ccLast = (ccTurns.length > 0) ? ccTurns[ccTurns.length - 1] : null;
        if (ccLast && ccLast.isPov === ccIsPov) { ccLast.ids.push(ccR.sectionId); ccLast.texts.push(ccR.section.text || ''); }
        else ccTurns.push({ isPov: ccIsPov, ids: [ccR.sectionId], texts: [ccR.section.text || ''] });
    }
    return { turns: ccTurns, ids: ccAllIds };
}

// [CHARCHAT-MERGE] WRITE-PASS ONLY, from _charchatNormalizeDocument at onGenerationEnd. Splits
// any section _charchatMergeSplitIdx flags as merged.
// [CHARCHAT-SETTLE-POLL] Polls against EXPECTED growth (last known count + 2) rather than
// pass-to-pass agreement. MEASURED: agreement cannot distinguish "settled" from "not started"
// -- two scans 150ms apart agreed on the same too-low count while a third found the full reply
// already there. Bounded so a genuinely failed turn does not poll forever.
const CC_SETTLE_MAX_PASSES = 5;    // hard ceiling: 1 initial scan + up to 4 retries
const CC_SETTLE_SLEEP_MS = 200;    // gap between polls
async function _charchatSplitMergedSections(): Promise<void> {
    if (_aeCharChat.markerId === null) return;
    // No baseline yet (turn 1 of a chat) -- nothing to compare growth against, so do exactly the
    // single scan+split pass and record the baseline for next turn.
    let ccExpectMin = (_ccLastSeenSectionCount >= 0) ? (_ccLastSeenSectionCount + 2) : -1;
    let ccPass = await _charchatSplitMergedSectionsPass();
    let ccFinalSeen = ccPass.seen;
    let ccPassNum = 1;
    while (ccExpectMin >= 0 && ccFinalSeen < ccExpectMin && ccPassNum < CC_SETTLE_MAX_PASSES) {
        aeLog('[AE:charchat:merge-diag] pass ' + ccPassNum + ' \u2014 seen=' + ccFinalSeen
            + ', expected at least ' + ccExpectMin + ' for a settled turn. NAI may still be '
            + 'writing \u2014 retrying after a short delay.');
        try { await api.v1.timers.sleep(CC_SETTLE_SLEEP_MS); } catch (_eSl) {}
        let ccRetry = await _charchatSplitMergedSectionsPass();
        ccFinalSeen = ccRetry.seen;
        ccPassNum++;
    }
    if (ccExpectMin >= 0 && ccFinalSeen >= ccExpectMin && ccPassNum > 1) {
        aeLog('[AE:charchat:merge-diag] settled after ' + ccPassNum + ' passes \u2014 seen='
            + ccFinalSeen + ' reached the expected ' + ccExpectMin + '. THE RACE IS REAL; a '
            + 'single fixed retry was not patient enough for this turn.');
    } else if (ccExpectMin >= 0 && ccFinalSeen < ccExpectMin) {
        aeLog('[AE:charchat:merge-diag] gave up after ' + ccPassNum + ' passes (' + (CC_SETTLE_MAX_PASSES - 1)
            + ' retries, ' + (CC_SETTLE_SLEEP_MS * (CC_SETTLE_MAX_PASSES - 1)) + 'ms total) without reaching '
            + 'the expected ' + ccExpectMin + ' \u2014 seen=' + ccFinalSeen + '. See CHARCHAT-EMPTY-REPLY-DIAG below.');
    }

    // [DIAG CHARCHAT-EMPTY-REPLY-DIAG] Runs AFTER the settle-poll, so a firing means the poll
    // gave up rather than that one check ran early. Dumps the newest sections. -1 skips turn 1.
    if (_ccLastSeenSectionCount >= 0 && ccFinalSeen <= _ccLastSeenSectionCount + 1) {
        aeLog('[AE:charchat:empty-reply-diag] section count still barely moved after settle-polling: was '
            + _ccLastSeenSectionCount + ', now ' + ccFinalSeen + ' \u2014 NAI likely generated NO '
            + 'reply text at all (only the Director\'s own turn landed, if that). Dumping the '
            + 'newest section(s) below.');
        try {
            let ccAllDump: any[] = await api.v1.document.scan();
            let ccSeenDump = false;
            let ccDumpRows: any[] = [];
            for (let ccD of ccAllDump) {
                if (ccD.sectionId === _aeCharChat.markerId) { ccSeenDump = true; continue; }
                if (!ccSeenDump) continue;
                if (_aeCharChat.setupIds.indexOf(ccD.sectionId) >= 0) continue;
                ccDumpRows.push(ccD);
            }
            let ccTail = ccDumpRows.slice(-3);
            if (ccTail.length === 0) {
                aeLog('[AE:charchat:empty-reply-diag] the chat region is completely empty past the marker/setup paragraphs.');
            }
            for (let ccDR of ccTail) {
                let ccDText = (ccDR.section && ccDR.section.text) || '';
                aeLog('[AE:charchat:empty-reply-diag] id=' + ccDR.sectionId
                    + ' source=' + JSON.stringify(ccDR.section.source)
                    + ' origin=' + JSON.stringify(ccDR.section.origin)
                    + ' textLen=' + ccDText.length
                    + ' text=' + JSON.stringify(ccDText));
            }
        } catch (eDump) { api.v1.error('[AE:charchat:empty-reply-diag] dump scan failed:', eDump); }
    }
    // [CHARCHAT-EMPTY-REPLY-BASELINE] The baseline is NOT recorded here: this runs BEFORE the
    // grow pass, so the count would be pre-grow while the next turn's comparison is post-grow --
    // an ordinary turn appeared to add +2 when it added +1. The normaliser records it instead.
}

// Physically splits a flagged section into two paragraphs: the user-typed head keeps the
// original sectionId and source, and the AI tail becomes a fresh paragraph via
// insertParagraphAfter with no source override -- script-written text gets 'script' origin,
// which _charchatRowIsPov reads as NOT a POV turn. Runs BEFORE _charchatScanTurns, so grouping
// never sees a merged section. Factored out so the settle-poll can run it more than once.
async function _charchatSplitMergedSectionsPass(): Promise<{ seen: number; split: number }> {
    let ccAll: any[] = [];
    try { ccAll = await api.v1.document.scan(); }
    catch (eSc) { api.v1.error('[AE:charchat] merge-split scan failed:', eSc); return { seen: 0, split: 0 }; }
    let ccSeen = false;
    // [DIAG CHARCHAT-SPLIT-DIAG] Every decision is logged: does this pass RUN, does it FIND the
    // boundary, does the write land. Cheap -- no generation, no extra scan.
    let ccDiagSeen = 0, ccDiagSplit = 0;
    for (let ccR of ccAll) {
        if (ccR.sectionId === _aeCharChat.markerId) { ccSeen = true; continue; }
        if (!ccSeen) continue;
        if (_aeCharChat.setupIds.indexOf(ccR.sectionId) >= 0) continue;
        ccDiagSeen++;
        let ccFull = ccR.section.text || '';
        let ccIdx = _charchatMergeSplitIdx(ccR.section);
        if (ccIdx <= 0 || ccIdx >= ccFull.length) {
            if (ccIdx > 0) aeLog('[AE:charchat:split] section ' + ccR.sectionId + ' idx=' + ccIdx + ' REJECTED (>= len ' + ccFull.length + ')');
            continue;
        }
        let ccHead = ccFull.substring(0, ccIdx);
        let ccTail = ccFull.substring(ccIdx);
        aeLog('[AE:charchat:split] section ' + ccR.sectionId + ' SPLIT at ' + ccIdx
            + ' head=' + JSON.stringify(ccHead.substring(0, 40))
            + ' tail=' + JSON.stringify(ccTail.substring(0, 40)));
        try {
            await api.v1.document.insertParagraphAfter(ccR.sectionId, { text: ccTail });
            await api.v1.document.updateParagraph(ccR.sectionId, { text: ccHead });
            ccDiagSplit++;
        } catch (eSp) { api.v1.error('[AE:charchat] merge-split failed for section ' + ccR.sectionId + ':', eSp); }
    }
    aeLog('[AE:charchat:split] pass complete — ' + ccDiagSeen + ' chat sections scanned, ' + ccDiagSplit + ' split.');
    return { seen: ccDiagSeen, split: ccDiagSplit };
}

// [CHARCHAT-CTX-BRACE] ccNoBrace renders the POV turn WITHOUT its brace wrapper, for the
// model's view only. _charchatNormalizeDocument never passes it; the DOCUMENT keeps its braces.
function _charchatCanonTurn(turn: { isPov: boolean; ids: number[]; texts: string[] }, povName: string, contactName: string, ccNoBrace?: boolean): string {
    let ccJoined = turn.texts.join('\n');
    if (!turn.isPov) return _charchatCanonContact(ccJoined, contactName, povName);
    let ccPov = _charchatCanonPov(ccJoined, povName, contactName);
    if (ccNoBrace && ccPov) ccPov = _charchatUnwrapPov(ccPov);
    return ccPov;
}

// WRITE PASS -- onGenerationEnd ONLY, never onBeforeContextBuild: mutating the document
// mid-context-build would race the generation it is building for, and that hook also fires on
// dryRun, so a costing pass would rewrite the author's paragraphs. The read-only twin keeps the
// MODEL's view canonical every turn; this keeps the DOCUMENT's canonical one beat later.
async function _charchatNormalizeDocument(): Promise<void> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return;
    // [CHARCHAT-MERGE] Fix any section NAI glued a completion onto BEFORE grouping turns. Failure
    // here is non-fatal (logged, falls through to _charchatScanTurns's in-memory fallback).
    try { await _charchatSplitMergedSections(); }
    catch (eSpAll) { aeLog('[AE:charchat] merge-split pass failed (continuing with unsplit sections):', eSpAll); }
    let ccScan = await _charchatScanTurns();
    let ccUpdates: { sectionId: number; section: any }[] = [];
    let ccRemove: number[] = [];
    let ccGrow: { afterId: number; lines: string[] }[] = [];
    for (let ccT of ccScan.turns) {
        // [CHARCHAT-BRACE-DOUBLE] POV turns written WITHOUT the literal brace (the 'true'
        // below is ccNoBrace). They are source:'instruction' and NAI renders its OWN brace, so
        // a literal '{...}' is a SECOND layer -- and since _charchatScanTurns reads RAW text the
        // unwrap could only strip ours while NAI's persisted, re-baking "{ {Name: ...} }".
        let ccCanon = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName, true);
        if (!ccCanon) { for (let ccX of ccT.ids) ccRemove.push(ccX); continue; }
        let ccLines = ccCanon.split('\n');
        // Fit the canonical lines back onto the sections this turn already occupies: rewrite in
        // place where they line up, fold overflow onto the last written section, drop what is no
        // longer needed. Deliberately does NOT force one paragraph per turn -- NAI owns how a
        // reply is split and fighting that is a losing game; we only fix the text.
        let ccKeep = Math.min(ccLines.length, ccT.ids.length);
        for (let ccI = 0; ccI < ccKeep; ccI++) {
            // [CHARCHAT-BRACE-DOUBLE] Force source:'instruction' on POV sections as we rewrite them: it is
            // what carries turn identity now the literal brace is gone. updateParagraphs takes a
            // Partial<Section>, so source is settable (verified in script-types).
            if (ccLines[ccI] !== ccT.texts[ccI]) {
                let ccSec: any = { text: ccLines[ccI] };
                if (ccT.isPov) ccSec.source = 'instruction';
                ccUpdates.push({ sectionId: ccT.ids[ccI], section: ccSec });
            }
        }
        for (let ccJ = ccKeep; ccJ < ccT.ids.length; ccJ++) ccRemove.push(ccT.ids[ccJ]);
        // [CHARCHAT-GROW] A canonical turn may need MORE sections than the document gives it
        // (body + 'Emotion:' = 2 lines in 1 section); folding surplus onto the last section
        // renders as ONE visual line, the "Emotion: bored glued onto the reply" report. Deferred
        // rather than inserted mid-loop, which would invalidate ids ccScan resolved.
        if (ccLines.length > ccT.ids.length && ccT.ids.length > 0) {
            ccGrow.push({ afterId: ccT.ids[ccT.ids.length - 1], lines: ccLines.slice(ccT.ids.length) });
        }
    }
    if (ccUpdates.length > 0) {
        try { await api.v1.document.updateParagraphs(ccUpdates); }
        catch (eNu) { aeLog('[AE:charchat] turn normalisation rewrite failed (cosmetic only):', eNu); }
    }
    // [CHARCHAT-GROW] Grow AFTER the in-place rewrites (the head line is canonical by then) and
    // BEFORE the removals. insertParagraphsAfter, NOT insertParagraphAfter -- the latter returns
    // Promise<void> (verified in script-types.txt) and cannot be chained by returned id.
    for (let ccG of ccGrow) {
        let ccSecs: any[] = [];
        for (let ccL of ccG.lines) ccSecs.push({ text: ccL });
        try { await api.v1.document.insertParagraphsAfter(ccG.afterId, ccSecs); }
        catch (eNg) { aeLog('[AE:charchat] turn grow failed (cosmetic only):', eNg); }
    }
    if (ccRemove.length > 0) {
        try { await api.v1.document.removeParagraphs(ccRemove); }
        catch (eNr) { aeLog('[AE:charchat] turn normalisation cleanup failed (cosmetic only):', eNr); }
    }
    // [CHARCHAT-EMPTY-REPLY-BASELINE] Baseline for the next turn, recorded at the only point the
    // document is settled: after the rewrites, the grow and the removals. Same skip rules.
    try {
        let ccBaseAll = await api.v1.document.scan();
        let ccBaseSeen = false, ccBaseN = 0;
        let ccLastId: number | null = null, ccLastText = '';
        for (let ccB of ccBaseAll) {
            if (ccB.sectionId === _aeCharChat.markerId) { ccBaseSeen = true; continue; }
            if (!ccBaseSeen) continue;
            if (_aeCharChat.setupIds.indexOf(ccB.sectionId) >= 0) continue;
            ccBaseN++;
            ccLastId = ccB.sectionId;
            ccLastText = ccB.section.text || '';
        }
        _ccLastSeenSectionCount = ccBaseN;
        // [CHARCHAT-TRAILING-BLANK] Without a blank paragraph after the reply the next
        // keystroke lands mid-line. One-shot: only fires when the last section is non-blank.
        if (ccLastId !== null && ccLastText.trim()) {
            try { await api.v1.document.insertParagraphAfter(ccLastId, { text: '' }); }
            catch (eTb) { aeLog('[AE:charchat] trailing blank paragraph failed (cosmetic only):', eTb); }
        }
    } catch (eNb) { aeLog('[AE:charchat] baseline recount failed (empty-reply diag disabled this turn):', eNb); }
}

// READ-ONLY twin of _charchatNormalizeDocument: it makes the model's view canonical on the SAME
// turn the user types it, since the write pass only runs after a generation.
// [CHARCHAT-CTX-BRACE] BRACES ARE STRIPPED FROM THE MODEL'S VIEW ONLY. "Nate:" already says who
// is speaking, so the brace carries nothing the header does not while teaching the model a
// convention it then imitates -- the confirmed source of the header-plus-brace turn. THE
// DOCUMENT KEEPS ITS BRACES: _charchatRowIsPov and _charchatCanonPov both depend on them.
// [CHATIMG-CTX-ID] Strips the hex id for the model's view: an IndexedDB key means nothing to it
// and a transcript is a pattern that gets copied (confirmed live by a hallucinated id). SAFE
// BECAUSE THE BRIDGE NEVER READS CONTEXT -- it walks the DOCUMENT, untouched by this pass.
function _charchatStripImgIds(s: string): string {
    return String(s || '').replace(_charchatImageResolvedRx(), '[Image: $2]');
}

async function _charchatCanonicalChatText(): Promise<string> {
    let ccScan = await _charchatScanTurns();
    let ccOut: string[] = [];
    for (let ccT of ccScan.turns) {
        let ccC = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName, true);
        if (ccC) ccOut.push(_charchatStripImgIds(ccC));
    }
    return ccOut.join('\n\n');
}

// The whole steering thesis, in one function. Called from onBeforeContextBuild while a
// chat is active — including on dryRun, so the context viewer shows the real thing.
async function runCharChatContextOverride(params: any): Promise<any> {
    let ccResult: any = {};
    try {
        let ccCfg = await loadConfig();
        let ccContact = await loadCharacter(_aeCharChat.contactId);
        if (!ccContact) {
            api.v1.error('[AE:charchat] contact ' + _aeCharChat.contactId + ' could not be loaded \u2014 leaving context untouched this turn.');
            return undefined;
        }

        // [CHARCHAT-FRESH-THOUGHTS-TIMING] NO api.v1.generate() CALL MAY BE MADE FROM THIS
        // HOOK. It fires WHILE this turn's own reply generation is in progress (NAI's internal
        // state, separate from ae_genInFlight), so a nested call is rejected outright -- every
        // time, confirmed by the error text. The ephemeral refresh lives in onGenerationEnd.

        // [CHARCHAT-THOUGHT-POST] Every generation reaching this function is a REPLY. The
        // thought is a direct api.v1.generate() call fired from onGenerationEnd after the reply
        // lands (grep generateChatEphemeral). Four versions of evidence killed the fork: NAI
        // wraps this slot in its own turn scaffold no matter what we substitute.

        // 1. TOP OF CONTEXT — we own it.
        ccResult.systemPrompt = { active: true, content: await buildCharChatSystemPrompt(ccContact, ccCfg, _aeCharChat.povId) };

        // 2. LOREBOOK -- deactivate every character-linked entry. Participants' are already in
        //    the system prompt (duplication guard), everyone else's is the persona-bleed guard.
        //    Enumerated from the character index, NOT params.lorebookEntries, which is not a
        //    guaranteed enumeration. Non-character entries are untouched: world lore is still
        //    true during a text message.
        let ccSuppress: any[] = [];
        try {
            let ccIdx = await loadIndex();
            for (let ccMeta of ccIdx.filter(Boolean)) {
                let ccChar = await loadCharacter(ccMeta.id);
                if (ccChar && ccChar.lorebookEntryId) ccSuppress.push([ccChar.lorebookEntryId, { active: false }]);
            }
        } catch (eccL) { api.v1.error('[AE:charchat] lorebook suppression failed \u2014 persona bleed possible this turn:', eccL); }
        // [CC-NO-DOUBLE] EVERY CE-MANAGED CONVERSATION ENTRY IS OFF FOR THE DURATION: saved
        // CharChat threads, their rendered context entries, and WIZLIVE's saved threads. All
        // three are keyless-and-inert by construction, so this usually changes nothing -- but
        // that is a property of how WE write them, not one the lorebook enforces, and a
        // hand-ticked Always On turns one into a second transcript beside the one the model is
        // being asked to continue. Category-scoped, so no bookkeeping can drift.
        try {
            let ccOffCats: string[] = [];
            let ccCatAll = await api.v1.lorebook.categories();
            for (let ccCatOne of (ccCatAll || [])) {
                let ccCatNm = String(ccCatOne.name || '');
                if (ccCatNm === CHARCHAT_CAT_NAME || ccCatNm === CC_CTX_CAT_NAME || ccCatNm === WIZLIVE_CAT_NAME) {
                    ccOffCats.push(String(ccCatOne.id));
                }
            }
            if (ccOffCats.length > 0) {
                let ccEntAll = await api.v1.lorebook.entries();
                for (let ccEntOne of (ccEntAll || [])) {
                    if (ccOffCats.indexOf(String(ccEntOne.category || '')) >= 0) {
                        ccSuppress.push([String(ccEntOne.id), { active: false }]);
                    }
                }
            }
        } catch (eccX) { api.v1.error('[AE:charchat] conversation-entry suppression failed \u2014 a saved transcript may reach this turn:', eccX); }
        if (ccSuppress.length > 0) ccResult.lorebookEntries = ccSuppress;

        // 3. AUTHOR'S NOTE -- DEACTIVATED. The ephemeral line rides the next-message
        //    instruction at the true bottom instead. Deliberate: the story's own AN is about the
        //    STORY, and a text message is not a story turn.

        // 4. STORY TEXT -- narrative header, CANONICAL chat region, next-message instruction at
        // true bottom. The chat region is REBUILT from the document rather than passed through.
        // GUARD: only rebuild when the marker SURVIVES in params.storyText.content, which is
        // already trimmed to the context budget while the document scan is not. Marker present
        // means the whole region is present (it is the tail), so a rebuild is length-neutral;
        // marker trimmed away means the chat outgrew the budget and storyText is left as NAI
        // trimmed it. The setup/greeting paragraph is dropped -- it is instructions to the USER.
        let ccStory = (params && params.storyText && params.storyText.content) ? params.storyText.content : '';
        // [CCINT] Mode-correct marker. Reading the phone constant while in an interview leaves
        // ccMarkIdx at -1 and silently skips the canonical rebuild -- no error, a worse prompt.
        let ccMarkTxt = _ccMarkerText();
        let ccMarkIdx = ccStory.indexOf(ccMarkTxt);
        if (ccMarkIdx >= 0) {
            let ccCanonChat = '';
            try { ccCanonChat = await _charchatCanonicalChatText(); }
            catch (eCc) { api.v1.error('[AE:charchat] canonical chat rebuild failed \u2014 passing the raw region through:', eCc); ccCanonChat = ''; ccMarkIdx = -1; }
            if (ccMarkIdx >= 0) {
                ccStory = ccStory.substring(0, ccMarkIdx) + ccMarkTxt
                        + (ccCanonChat ? ('\n\n' + ccCanonChat) : '');
            }
        }
        ccStory = ccStory.replace(/\s+$/, '');
        // [CCINT] Relabel only -- the same story text either way, but "the record" is the noun
        // the interview rubric and the instruction tail both use, and disagreeing is confusion.
        let ccBody = _ccMode().bodyLabel + '\n' + ccStory;
        ccBody += '\n\n' + buildCharChatInstruction(ccContact, _aeCharChat.povName, ccCfg, _aeCharChat.povId);
        // [CHARCHAT-USERTOKEN] THE ROOT CAUSE OF THE EMPTY REPLY, MEASURED. NAI's
        // token-probability viewer on a failed Send shows the most likely next token is the
        // chat-template control token <|user|> at 42-56% raw / 53-92% after sampling: the model
        // is not producing a bad reply, it is ENDING ITS TURN, which is a zero-length completion.
        // WHY: NAI puts the TAIL of storyText AFTER the <|assistant|> marker, so whatever this
        // function ends with reads as the model's own in-progress output. In story mode that is
        // prose trailing off mid-scene, so continuing is the only sensible move; in chat mode it
        // was the instruction stack ending on a CLOSED bracket block, where nothing dangles and
        // handing the turn back is natural. Widgets, decorations, images and priming made no
        // difference because none of them touch the distribution.
        // THE FIX: NEVER END THE ASSISTANT TURN ON A CLOSED BLOCK. End on a dangling speaker cue.
        // NOT VIA logit_bias / stop: both exist ONLY on GenerationParams, the api.v1.generate()
        // path, and native Send exposes neither (verified in script-types.txt).
        if (!CE_DIAG.ccNoPrefill) {
            ccBody += '\n\n' + (_aeCharChat.contactName || ccContact.name || 'They') + ':';
        } else {
            aeLog('[AE:diag] ccNoPrefill ON \u2014 context ends on a closed block (pre-v2.69.0 shape).');
        }
        // [DIAG CHARCHAT-TAIL-DIAG] Logs what the model literally reads immediately before the
        // generation point -- the direct A/B for CHARCHAT-TAIL-TERMINAL. Free. dryRun is NOT
        // suppressed: the context viewer pass logs it too, the cheapest way to inspect the tail.
        try {
            let ccTailLog = ccBody.substring(Math.max(0, ccBody.length - 300));
            aeLog('[AE:charchat:tail] eph=' + ((ccContact.ephemeral && ccContact.ephemeral.compressedLine) ? 'yes' : 'no')
                + ' storyTextLen=' + ccBody.length + ' last300=' + JSON.stringify(ccTailLog));
        } catch (_eTail) {}
        ccResult.storyText = { active: true, content: ccBody };

    } catch (eccAll) {
        api.v1.error('[AE:charchat] context override failed \u2014 falling back to untouched context:', eccAll);
        return undefined;
    }
    return ccResult;
}

// ── Post-hoc reply cleanup ────────────────────────────────────────
// Native generation exposes no per-turn stop sequences (that is the api.v1.generate path only),
// so instruct/paragraph turn alternation plus this regex net is the whole anti-impersonation
// defence.
function _charchatEscapeRx(str: string): string {
    return (str || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// THE EMOTION TAG IS PARSED BUT NOT STRIPPED, and this is a hard EXTERNAL contract: a separate
// emotion-image widget script reads `Emotion: <word>` off DOCUMENT text. The parsed value is
// mirrored to _aeCharChat.lastEmotion; the tag stays in the text.
function charChatParseEmotion(raw: string): string {
    let ccM = (raw || '').match(_charchatEmotionRx());
    if (ccM && ccM[1]) {
        let ccE = ccM[1].trim();
        // Canonicalise to the 24-state list via the same resolveEmotion()/EMOTION_MAP the image
        // pipeline uses, or a synonym ("annoyed") reaches the document verbatim and misses the
        // widget. resolveEmotion never returns '', so the <=40 guard still decides if one was
        // found at all.
        if (ccE.length > 0 && ccE.length <= 40) return resolveEmotion(ccE);   // <=40 guard against false positives
    }
    return '';
}

// Thoughts come from generateEphemeral() -- a persisted record, not a line scraped out of the
// reply text.

function charChatCleanReply(raw: string, contactName: string, povName: string): string {
    let ccT = (raw || '');
    if (!ccT.trim()) return ccT;

    // Split the Emotion tag off, clean the body only, then re-attach: an impersonation
    // truncation can never eat the tag, and the tag can never be read as message content.
    let ccEmotion = charChatParseEmotion(ccT);
    if (ccEmotion) {
        let ccCut = ccT.match(_charchatEmotionRx());
        if (ccCut && ccCut.index !== undefined) ccT = ccT.substring(0, ccCut.index);
    }

    // Drop a self-prefix the model added on its own -- defensive only, since we prepend our OWN
    // canonical header below. Shared with _charchatStripHeader rather than a second copy of the
    // regex, and it tries the POV's name too: a WRONG-side header was kept and stamped over.
    ccT = _charchatStripHeader(ccT, [contactName, povName]);

    // Truncate the moment the model starts speaking for the POV, or trails off with
    // their bare name (both are the model taking over the user's side of the chat).
    if (povName) {
        let ccRxList = [
            new RegExp('(?:^|\\n)\\s*\\*?\\*?' + _charchatEscapeRx(povName) + '\\*?\\*?\\s*[:\uff1a]', 'i'),
            new RegExp('(?:^|\\n)\\s*\\*?\\*?' + _charchatEscapeRx(povName) + '\\*?\\*?\\s*$', 'i')
        ];
        for (let ccRx of ccRxList) {
            let ccMt = ccT.match(ccRx);
            if (ccMt && ccMt.index !== undefined && ccMt.index > 0) ccT = ccT.substring(0, ccMt.index);
        }
    }

    ccT = ccT.replace(/\s+$/, '').replace(/^\s+/, '');

    // The name header is OURS: never requested, always applied here, canonical regardless of
    // what the model did. FIRST of two applications -- this owns the text on the way in,
    // _charchatNormalizeDocument owns what the user or NAI did to it afterwards.
    let ccBody = ccT || '\u2026';   // an empty body after cleanup still gets a header + placeholder rather than vanishing silently
    // Header and body share a line ("Sara: message"), matching _charchatCanonContact exactly -- this
    // and that function must stay in sync; they cover the same shape at two different times.
    let ccOut = (contactName || 'They') + ': ' + ccBody;
    if (ccEmotion) ccOut += '\n' + CHARCHAT_EMOTION_PREFIX + ccEmotion;
    return ccOut;
}

// ── Session lifecycle ──────────────────────────────────────────

// [CHARCHAT-RESUME] Resolves resume-vs-start itself, because the bridge path calls straight in
// and an unconditional "append a fresh marker + greeting" started a new thread every time,
// orphaning the old one. ABOVE the mode guards deliberately: resumeCharChatFromEntry re-checks
// every one, so a guarded-out resume reports the identical toast.
async function startCharChat(contactId: string, povId: string, modeId?: string): Promise<void> {
    if (!_aeCharChat.active) {
        let ccExistingId = charChatEntryId(contactId, povId);
        let ccExisting: any = null;
        try { ccExisting = await api.v1.lorebook.entry(ccExistingId); }
        catch (_eRes) { ccExisting = null; }
        if (ccExisting && ccExisting.text) { await resumeCharChatFromEntry(ccExistingId, contactId); return; }
    }
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeLiveWiz.active)  { api.v1.ui.toast('A wizard chat is open in the story \u2014 end it before starting a character chat.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active)    { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let ccContact = await loadCharacter(contactId);
    if (!ccContact) { api.v1.ui.toast('Could not load that character.', { type: 'error', autoClose: 4000 }); return; }
    let ccCfgStart = await loadConfig();
    let ccPov: CharacterRecord | null = null;
    // [CCINT] The sentinel is not a character. Without this guard the load returns null and the
    // povId is zeroed below, silently dropping the chat into phone mode and the wrong bucket.
    if (povId && !_ccIsInterview(povId)) { ccPov = await loadCharacter(povId); }

    // [LOCKED DECISION] POV is a LABEL ONLY. It names who the contact is texting so the
    // instruction can address them; it grants no scene presence and injects no profile.
    let ccPovName = ccPov ? ccPov.name : '';

    // Both paths get the same instructions: there is no scaffold to "finish". The user never has
    // to type a brace -- _charchatCanonPov re-wraps regardless of source, so "Hi, Sara" and
    // "{Hi, Sara}" come out the same.
    let ccStartMode = _ccModeFor(povId, modeId);
    // [CC-MODES] One greeting, assembled from the mode. The interview clause about not
    // knowing they are in a story is kept and generalised: it is true in every mode.
    let ccGreet = ccStartMode.greet + ccContact.name
        + '. Write your ' + (ccStartMode.id === 'interview' ? 'question' : 'own turn')
        + ' in a new paragraph, then press Send. They answer in their own voice, in the story\u2019s world \u2014 they do not know they are in a story.'
        + (ccPovName ? ' Your name is added for you automatically; just write what you want to say.' : '');

    let ccBefore = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs([
        { text: ccStartMode.marker, source: 'instruction' },
        { text: ccGreet, source: 'instruction' }
    ]);
    let ccAfter = await api.v1.document.sectionIds();
    let ccAdded = ccAfter.slice(ccBefore.length);
    if (ccAdded.length === 0) { api.v1.ui.toast('Could not start the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let ccMarkerId = ccAdded[0];

    // Pin output short, snapshot->update->restore as WIZLIVE does. The cap is this CONTACT's,
    // not a global: "be brief" under a 240-token cap is two instructions that disagree.
    // [CC-XIALONG] THE MODEL IS PINNED HERE TOO. xialong-v1 is trained on the AetherRoom card
    // format and glm-4-6 is not; config-driven so a tier that cannot reach xialong has a
    // fallback. Restored in endCharChat.
    let ccSnap: any = null;
    try {
        ccSnap = await api.v1.generationParameters.get();
        let ccPinM = String((ccCfgStart as any).charChatModel || CC_DEFAULT_MODEL);
        await api.v1.generationParameters.update({
            model: ccPinM,
            max_tokens: charChatMaxTokensFor(ccContact, ccCfgStart, povId)
        });
        aeLog('[AE:charchat] pinned model=' + ccPinM + ' for this chat; restored on end.');
    } catch (eccP) { aeLog('[AE:charchat] param pin failed, continuing without pin:', eccP); ccSnap = null; }

    _aeCharChat = {
        active: true, markerId: ccMarkerId, setupIds: ccAdded.slice(1),
        contactId: contactId, contactName: ccContact.name,
        povId: (ccPov || ccStartMode.id === 'interview') ? povId : '', povName: ccPovName,
        mode: ccStartMode.id,   // [CCINT] the sentinel has no CharacterRecord and must survive this guard
        paramSnapshot: ccSnap, startedAt: Date.now(), lastEmotion: ''
    };
    _ccLastSeenSectionCount = -1;   // [DIAG earlier CHARCHAT-EMPTY-REPLY-DIAG] fresh session, no baseline yet
    await saveCharChatState();

    try { await _charchatRegisterDecorations(ccMarkerId); await refreshCharChatDecorations(); }
    catch (eccDr) { aeLog('[AE:charchat] decoration registration failed (cosmetic only):', eccDr); }

    // [CHARCHAT-TOAST-WRONG] The user types a plain message into NAI's own editor and presses
    // NAI's own Send; the normaliser adds braces and header after. Do not tell them to type { }.
    api.v1.ui.toast(ccStartMode.label + ' \u2014 ' + ccContact.name
        + '. Type below the marker, then press Send.', { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}

// Walk the LIVE document from the marker down (mirrors collectLiveWizTranscript), returning ids
// AND msgs from one scan. Role comes from row.section.source, NEVER from name-prefix text, so
// this works whether or not a POV was set. Consecutive non-POV paragraphs merge into one turn.
async function collectCharChatTranscript(): Promise<{ ids: number[]; msgs: WizardChatMessage[] }> {
    let ccScan = await _charchatScanTurns();
    let ccMsgs: WizardChatMessage[] = [];
    for (let ccT of ccScan.turns) {
        // Canonicalise on the way out too: a saved thread should round-trip in the shape the
        // live document is kept in, and a hand-edited turn has never seen the write pass.
        let ccC = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName);
        if (!ccC) continue;   // empty turn — a blank paragraph, or a brace block never typed into
        ccMsgs.push({ role: ccT.isPov ? 'user' : 'assistant', content: ccT.isPov ? _charchatStripBraces(ccC) : ccC });
    }
    return { ids: ccScan.ids, msgs: ccMsgs };
}

function _charchatStripBraces(t: string): string {
    let s = (t || '').trim();
    if (s.length >= 2 && s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') s = s.substring(1, s.length - 1).trim();
    return s;
}

// ── Saved threads (one per character PAIR) ──────────────────────────────────
// One lorebook entry per (contact, POV) PAIR with a DETERMINISTIC id (charChatEntryId), so
// there is no per-session sourceEntryId to track the way WIZLIVE needs one: Save always
// overwrites the one thread for that pair and Clear deletes it.
var CHARCHAT_CAT_NAME = 'CE Character Chats';
var _aeCharChatCatId: string | null = null;

async function ensureCharChatCategory(): Promise<string> {
    if (_aeCharChatCatId) return _aeCharChatCatId;
    try {
        let cached = (await api.v1.storyStorage.getOrDefault(STORAGE_CHARCHAT_CAT, '')) as string;
        if (cached) {
            let c = await api.v1.lorebook.category(cached);
            if (c) { _aeCharChatCatId = cached; return cached; }
        }
    } catch (_e0) {}
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).filter(function(c: any) { return (c.name || '') === CHARCHAT_CAT_NAME; })[0];
        if (found) {
            _aeCharChatCatId = found.id;
            try { await api.v1.storyStorage.set(STORAGE_CHARCHAT_CAT, found.id); } catch (_e1) {}
            return found.id;
        }
    } catch (_e2) {}
    let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: CHARCHAT_CAT_NAME, enabled: true });
    _aeCharChatCatId = newId;
    try { await api.v1.storyStorage.set(STORAGE_CHARCHAT_CAT, newId); } catch (_e3) {}
    return newId;
}

// A function of BOTH ids. povId='' reuses the EXACT legacy id shape, so every thread saved
// before POV became a partition key is the "no POV" bucket with no rekey. A real povId appends
// '_pov_<povId>'; UUIDs never contain '_pov_', so this splits unambiguously.
function charChatEntryId(contactId: string, povId: string): string {
    return 'ae_charchat_' + contactId + (povId ? ('_pov_' + povId) : '');
}

// Inverse of charChatEntryId. Returns null for anything outside our own prefix -- defensive;
// the category is hidden:true but nothing stops something else living in it.
function _charchatParseEntryId(eId: string): { contactId: string; povId: string } | null {
    let prefix = 'ae_charchat_';
    if (!eId || eId.indexOf(prefix) !== 0) return null;
    let rest = eId.substring(prefix.length);
    if (!rest) return null;
    let povIdx = rest.indexOf('_pov_');
    if (povIdx === -1) return { contactId: rest, povId: '' };
    return { contactId: rest.substring(0, povIdx), povId: rest.substring(povIdx + 5) };
}

// [CHARCHAT-SUMMARY-SAVE] Save an edited summary preview to the character's own Journal, not a
// lorebook entry: charJournalAddBubble is reused as-is, so same storage, same broadcast, same
// surface -- no new category, id scheme or UI.
// [CC-CTX] Stored against the OPEN chat's THREAD id, not the contact id: a contact can have a
// thread per POV and each deserves its own recap.
async function ccSaveContextSummary(summaryText: string): Promise<boolean> {
    let ccsBody = (summaryText || '').trim();
    if (!ccsBody || !_aeCharChat.contactId) return false;
    let ccsKey = charChatEntryId(_aeCharChat.contactId, _aeCharChat.povId);
    let ccsAll = await ccCtxSummaries();
    ccsAll[ccsKey] = ccsBody;
    try { await api.v1.storyStorage.set(STORAGE_CC_CTX_SUMMARY, ccsAll); }
    catch (e) { api.v1.error('[AE:ccctx] summary write failed:', e); return false; }
    // If this thread is ALREADY switched on as a summary, refresh the live entry -- a
    // control that silently keeps showing the older text would be the worse failure.
    let ccsModes = await ccCtxModes();
    if (ccsModes[ccsKey] === 'summary') {
        try { await ccCtxSet(ccsKey, 'summary'); } catch (_ecsR) {}
    }
    return true;
}

async function saveCharChatSummaryToJournal(summaryText: string): Promise<boolean> {
    let ccBody = (summaryText || '').trim();
    if (!ccBody || !_aeCharChat.contactId) return false;
    await charJournalAddBubble(_aeCharChat.contactId, ccBody);
    return true;
}

// [CHARCHAT-SUMMARY-SAVE] An editable-preview modal mirroring _wizModalPreview: Save writes via
// saveCharChatSummaryToJournal, Discard does not. Summarize keeps the chat open either way.


// Sigil-delimited, NOT name-prefix-delimited, so role reconstruction never depends on whether a
// POV was set; @POV/@CONTACT never appear in the live document. Turn content is stored EXACTLY
// as it appeared live so a resume is a lossless round trip, and contactId is never in the text
// -- it comes off the entry's deterministic id.
// [CC-MODES] The head carries the MODE LABEL, the only durable record of which kind of
// conversation a thread was. Every pre-CC-MODES header opens with 'Texting', which IS the text
// mode's label, so old threads parse without a migration.
function serializeCharChatTranscript(contactName: string, povName: string, msgs: WizardChatMessage[]): string {
    let head = '=== ' + _ccMode().label + ' \u2014 ' + contactName
             + (povName ? (' (as ' + povName + ')') : '') + ' ===';
    let parts: string[] = [head, ''];
    for (let i = 0; i < msgs.length; i++) {
        parts.push(msgs[i].role === 'user' ? '@POV' : '@CONTACT');
        parts.push(msgs[i].content);
        parts.push('');
    }
    return parts.join('\n').replace(/\s+$/, '');
}

// Cheap, header-only read. contactId is deliberately NOT parsed here: callers already know it
// (the deterministic entry id minus the prefix), so there is nothing to recover from text.
function parseCharChatEntryHeader(text: string): { povName: string; mode: string } {
    let first = String(text || '').split('\n')[0] || '';
    let m = first.match(/\(as (.+?)\)/);
    // Label match, not id match: the header is user-facing text. An unknown label from a future
    // version falls to '' and _ccModeId resolves it as it resolves a missing one.
    let ccpMode = '';
    let ccpK: string;
    for (ccpK in CC_MODES) {
        if (!Object.prototype.hasOwnProperty.call(CC_MODES, ccpK)) continue;
        if (first.indexOf('=== ' + CC_MODES[ccpK].label) === 0) { ccpMode = ccpK; break; }
    }
    return { povName: m ? m[1].trim() : '', mode: ccpMode };
}

// Inverse of serializeCharChatTranscript. Sigil lines are the ONLY thing that starts a turn;
// everything else, blank lines included, accrues to whichever turn is open, so a multi-line
// reply survives the round trip as one turn.
function parseCharChatTranscript(text: string): { msgs: WizardChatMessage[] } {
    let lines = String(text || '').split('\n');
    let msgs: WizardChatMessage[] = [];
    let cur: WizardChatMessage | null = null;
    for (let i = 0; i < lines.length; i++) {
        let t = lines[i].trim();
        if (t === '@POV' || t === '@CONTACT') {
            if (cur) msgs.push(cur);
            cur = { role: (t === '@POV' ? 'user' : 'assistant'), content: '' };
            continue;
        }
        if (!cur) continue; // header line / pre-first-sigil spacer
        cur.content += (cur.content ? '\n' : '') + lines[i];
    }
    if (cur) msgs.push(cur);
    let out: WizardChatMessage[] = [];
    for (let k = 0; k < msgs.length; k++) {
        let c = msgs[k].content.replace(/^\s+/, '').replace(/\s+$/, '');
        if (c.length > 0) out.push({ role: msgs[k].role, content: c });
    }
    return { msgs: out };
}

function countCharChatTurns(text: string): number {
    let m = String(text || '').match(/^@(?:POV|CONTACT)\s*$/gm);
    return m ? m.length : 0;
}

// ONE bulk lorebook.entries(cat) call, never N entry() lookups for a roster-sized picker. One
// record per (contactId, povId) PAIR, both ids taken off the entry's own deterministic id, so
// there is nothing to parse out of the header and nothing to drift.
async function listCharChatThreads(): Promise<{ contactId: string; povId: string; entryId: string; turnCount: number }[]> {
    let out: { contactId: string; povId: string; entryId: string; turnCount: number }[] = [];
    try {
        let cat = await ensureCharChatCategory();
        let entries = await api.v1.lorebook.entries(cat);
        for (let e of (entries || [])) {
            let parsed = _charchatParseEntryId(e.id || '');
            if (!parsed || !parsed.contactId) continue;
            out.push({ contactId: parsed.contactId, povId: parsed.povId, entryId: e.id, turnCount: countCharChatTurns(e.text || '') });
        }
    } catch (eList) { api.v1.error('[AE:charchat] listCharChatThreads:', eList); }
    return out;
}


// Strip the self-header and Emotion line back OFF a turn for the distiller: live document
// formatting is exactly what the summary prompt must not see.
function _charchatBareBody(content: string, ownName: string): string {
    let c = _charchatStripHeader(content, [ownName]);
    // Shared emotion pattern, not a private copy: CHARCHAT_EMOTION_PREFIX carries two leading
    // spaces, which a hand-written /\n?Emotion:.../ silently stopped matching.
    c = c.replace(_charchatEmotionRx(), '');
    // [CHATIMG-CTX-ID] Same strip as the canonical builder, for the path that feeds the
    // summariser off collectCharChatTranscript: a raw id is noise and a pattern to copy.
    c = _charchatStripImgIds(c);
    return c.trim();
}

// NO PRE-FILLED "{user: " OPENER. An unclosed one reaching context is a dangling instruction
// block whose most natural continuation is finishing the user's line, not replying as contact.

// Create-or-overwrite THE thread for this (contact, pov) PAIR -- deterministic id, no lookup
// needed to know where to write.
// ── [CC-CTX] THE CONTEXT DOOR ───────────────────────────────────────────────
// A saved thread is keyless with forceActivation unset, so it cannot enter context at all: it is
// storage for the resume picker. TWO ENTRIES, NOT ONE -- the thread entry keeps its lossless
// round-trip form because resumeCharChatFromEntry depends on every byte, and none of that
// belongs in a story prompt (markers are storage syntax, and a chat-shaped block in narrative
// context teaches the model to write chat). Switching ON creates a SEPARATE entry holding the
// RENDERED form; switching off deletes it.
function ccCtxEntryId(threadEntryId: string): string {
    return 'ae_ccctx_' + String(threadEntryId || '').replace(/^ae_charchat_/, '');
}

var CC_CTX_CAT_NAME = 'CE Chat Context';
var _aeCcCtxCatId: string | null = null;

// Its OWN category, not the thread one. Threads are hidden archival storage; these are live
// context the author chose, and belong somewhere they can be switched off by hand.
async function ensureCcCtxCategory(): Promise<string> {
    if (_aeCcCtxCatId) return _aeCcCtxCatId;
    try {
        let ccc = (await api.v1.storyStorage.getOrDefault(STORAGE_CC_CTX_CAT, '')) as string;
        if (ccc) {
            let ccCat = await api.v1.lorebook.category(ccc);
            if (ccCat) { _aeCcCtxCatId = ccc; return ccc; }
        }
    } catch (_ecc0) {}
    try {
        let ccCats = await api.v1.lorebook.categories();
        let ccFound = (ccCats || []).filter(function(c: any) { return (c.name || '') === CC_CTX_CAT_NAME; })[0];
        if (ccFound) {
            _aeCcCtxCatId = ccFound.id;
            try { await api.v1.storyStorage.set(STORAGE_CC_CTX_CAT, ccFound.id); } catch (_ecc1) {}
            return ccFound.id;
        }
    } catch (_ecc2) {}
    let ccNew = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: CC_CTX_CAT_NAME, enabled: true });
    _aeCcCtxCatId = ccNew;
    try { await api.v1.storyStorage.set(STORAGE_CC_CTX_CAT, ccNew); } catch (_ecc3) {}
    return ccNew;
}

async function ccCtxModes(): Promise<Record<string, string>> {
    try { return (await api.v1.storyStorage.getOrDefault(STORAGE_CC_CTX_MODE, {})) as Record<string, string>; }
    catch (e) { api.v1.error('[AE:ccctx] mode read failed:', e); return {}; }
}

async function ccCtxSummaries(): Promise<Record<string, string>> {
    try { return (await api.v1.storyStorage.getOrDefault(STORAGE_CC_CTX_SUMMARY, {})) as Record<string, string>; }
    catch (e) { api.v1.error('[AE:ccctx] summary read failed:', e); return {}; }
}

// THE PROJECTION. Storage form in, context form out. Each removal is syntax, not content:
//   @POV / @CONTACT  -> gone. Parser markers; the turn already carries a "Name:" header.
//   { }              -> gone (CHARCHAT-CTX-BRACE): an injected convention gets imitated.
//   Emotion: <word>  -> gone. A sidecar for painters that read the DOCUMENT.
//   [Image#hex: ...] -> id stripped, description kept (CHATIMG-CTX-ID).
function ccRenderThreadForContext(text: string, contactName: string, povName: string, modeLabel: string): string {
    let ccrRaw = String(text || '');
    let ccrLines = ccrRaw.split('\n');
    let ccrOut: string[] = [];
    for (let ccrI = 0; ccrI < ccrLines.length; ccrI++) {
        let ccrL = ccrLines[ccrI];
        if (ccrI === 0 && ccrL.indexOf('===') === 0) continue;
        if (ccrL === '@POV' || ccrL === '@CONTACT') continue;
        ccrOut.push(ccrL);
    }
    let ccrBody = ccrOut.join('\n');
    ccrBody = ccrBody.replace(_charchatEmotionRx(), '');
    ccrBody = _charchatStripImgIds(ccrBody);
    // Unwrap the POV braces with a whole-paragraph match, not a global brace strip: a brace
    // INSIDE a message is the character's own punctuation.
    ccrBody = ccrBody.replace(/^\{\s*([\s\S]*?)\s*\}$/gm, '$1');
    ccrBody = ccrBody.replace(/\n{3,}/g, '\n\n').trim();
    if (!ccrBody) return '';
    let ccrWhat = (String(modeLabel || '').toLowerCase() === 'interview') ? 'an interview' : 'a conversation';
    return 'The following is a record of ' + ccrWhat + ' between '
         + (contactName || 'them') + ' and ' + (povName || 'the viewpoint character')
         + '. It happened; treat it as established.\n\n' + ccrBody;
}

// Switch one thread's context state. 'off' DELETES the entry rather than deactivating it: a
// dormant entry is invisible state, and this door exists so that what is in context is legible
// from the lorebook without this surface.
async function ccCtxSet(threadEntryId: string, want: string): Promise<void> {
    let ccsWant = (want === 'summary' || want === 'transcript') ? want : 'off';
    let ccsId = ccCtxEntryId(threadEntryId);
    let ccsModes = await ccCtxModes();

    if (ccsWant === 'off') {
        try { await api.v1.lorebook.removeEntry(ccsId); } catch (_ecsD) {}
        delete ccsModes[threadEntryId];
        try { await api.v1.storyStorage.set(STORAGE_CC_CTX_MODE, ccsModes); }
        catch (e) { api.v1.error('[AE:ccctx] mode write failed:', e); }
        return;
    }

    let ccsThread: any = null;
    try { ccsThread = await api.v1.lorebook.entry(threadEntryId); } catch (_ecsT) {}
    if (!ccsThread || !ccsThread.text) {
        api.v1.ui.toast('That saved chat could not be read.', { type: 'error', autoClose: 4000 });
        return;
    }
    let ccsHdr = parseCharChatEntryHeader(ccsThread.text);
    let ccsParsed = _charchatParseEntryId(threadEntryId);
    let ccsContactName = '';
    try {
        if (ccsParsed && ccsParsed.contactId) {
            let ccsChar = await loadCharacter(ccsParsed.contactId);
            if (ccsChar) ccsContactName = ccsChar.name;
        }
    } catch (_ecsC) {}
    let ccsLabel = _ccModeFor(ccsParsed ? ccsParsed.povId : '', ccsHdr.mode).label;

    let ccsText = '';
    if (ccsWant === 'summary') {
        let ccsSums = await ccCtxSummaries();
        let ccsSum = String(ccsSums[threadEntryId] || '').trim();
        if (!ccsSum) {
            api.v1.ui.toast('No summary saved for that chat yet \u2014 open it, Summarize, then '
                + 'Keep as context summary.', { type: 'warning', autoClose: 6000 });
            return;
        }
        ccsText = 'The following summarises ' + (ccsLabel.toLowerCase() === 'interview' ? 'an interview' : 'a conversation')
                + ' between ' + (ccsContactName || 'them') + ' and ' + (ccsHdr.povName || 'the viewpoint character')
                + '. It happened; treat it as established.\n\n' + ccsSum;
    } else {
        ccsText = ccRenderThreadForContext(ccsThread.text, ccsContactName, ccsHdr.povName, ccsLabel);
        if (!ccsText) {
            api.v1.ui.toast('That chat has nothing to add to context.', { type: 'warning', autoClose: 3000 });
            return;
        }
    }

    let ccsCat = await ensureCcCtxCategory();
    let ccsDisp = ccsLabel + ' \u2014 ' + (ccsContactName || 'chat')
                + (ccsWant === 'summary' ? ' (summary)' : ' (transcript)');
    let ccsExisting: any = null;
    try { ccsExisting = await api.v1.lorebook.entry(ccsId); } catch (_ecsE) {}
    // forceActivation, NOT keys. Keyed activation on a block this size drags the whole
    // conversation into context on every passing mention of the character.
    if (ccsExisting) {
        await api.v1.lorebook.updateEntry(ccsId, { text: ccsText, displayName: ccsDisp,
            category: ccsCat, enabled: true, forceActivation: true });
    } else {
        await api.v1.lorebook.createEntry({ id: ccsId, category: ccsCat, displayName: ccsDisp,
            text: ccsText, keys: [], enabled: true, forceActivation: true });
    }
    ccsModes[threadEntryId] = ccsWant;
    try { await api.v1.storyStorage.set(STORAGE_CC_CTX_MODE, ccsModes); }
    catch (e) { api.v1.error('[AE:ccctx] mode write failed:', e); }
}

// Delete a saved thread AND anything downstream of it. Reached from the contact card, the only
// place a thread you are not currently in can be reached from.
async function ccThreadDelete(threadEntryId: string): Promise<void> {
    try { await ccCtxSet(threadEntryId, 'off'); } catch (_ectd0) {}
    try { await api.v1.lorebook.removeEntry(threadEntryId); }
    catch (e) { api.v1.error('[AE:ccctx] thread delete failed:', e); }
    let cctSums = await ccCtxSummaries();
    if (cctSums[threadEntryId] !== undefined) {
        delete cctSums[threadEntryId];
        try { await api.v1.storyStorage.set(STORAGE_CC_CTX_SUMMARY, cctSums); } catch (_ectd1) {}
    }
}

async function upsertCharChatEntry(contact: CharacterRecord, povId: string, povName: string, msgs: WizardChatMessage[]): Promise<string> {
    let cat = await ensureCharChatCategory();
    let id = charChatEntryId(contact.id, povId);
    // [CCINT] Display name only -- the id already partitions the thread. This just stops an
    // interview and a phone thread with the same character reading identically.
    let ccDisp = _ccMode().label + ' \u2014 ' + contact.name;
    let text = serializeCharChatTranscript(contact.name, povName, msgs);
    let existing: any = null;
    try { existing = await api.v1.lorebook.entry(id); } catch (_e) {}
    if (existing) {
        await api.v1.lorebook.updateEntry(id, { text: text, displayName: ccDisp, category: cat });
        return id;
    }
    // [DEVIATION from the CE-Chats pattern, deliberate] hidden:true -- pure archival storage
    // for the Chat picker, never meant for manual lorebook browsing.
    let newId = await api.v1.lorebook.createEntry({ id: id, category: cat, displayName: ccDisp, text: text, keys: [], enabled: true, forceActivation: false, hidden: true });
    return newId || id;
}

// Pull a saved thread back into the story. POV is read from the entry, not re-asked: an
// established thread already has one, and re-prompting breaks the click-and-continue flow.
async function resumeCharChatFromEntry(entryId: string, contactId: string): Promise<void> {
    if (_aeCharChat.active) { api.v1.ui.toast('A character chat is already open in the story.', { type: 'warning', autoClose: 3000 }); return; }
    if (_aeLiveWiz.active)  { api.v1.ui.toast('A wizard chat is open in the story \u2014 end it before starting a character chat.', { type: 'warning', autoClose: 4000 }); return; }
    if (_aeYoink.active)    { api.v1.ui.toast('A background generation is running \u2014 try again in a moment.', { type: 'warning', autoClose: 3000 }); return; }

    let ccContact = await loadCharacter(contactId);
    if (!ccContact) { api.v1.ui.toast('Could not load that character.', { type: 'error', autoClose: 4000 }); return; }
    let entry: any = null;
    try { entry = await api.v1.lorebook.entry(entryId); } catch (_e) {}
    if (!entry || !entry.text) { api.v1.ui.toast('Could not load that saved chat.', { type: 'error', autoClose: 4000 }); return; }

    // POV NAME comes off the header; POV ID is parsed off entryId itself, the same source
    // listCharChatThreads built this picker row from, so the two cannot disagree.
    let hdr = parseCharChatEntryHeader(entry.text);
    let ccPovName = hdr.povName;
    let ccEntryParsed = _charchatParseEntryId(entryId);
    let ccPovId = ccEntryParsed ? ccEntryParsed.povId : '';
    // [CC-MODES] Resolved here and passed EXPLICITLY below, for charChatMaxTokensFor's ordering
    // reason: _aeCharChat is assigned at the bottom, so an ambient read answers for the
    // PREVIOUS chat.
    let ccResumeMode = _ccModeFor(ccPovId, hdr.mode);
    let parsed = parseCharChatTranscript(entry.text);
    if (parsed.msgs.length === 0) { api.v1.ui.toast('That saved chat is empty.', { type: 'warning', autoClose: 3000 }); return; }

    let paras: any[] = [ { text: ccResumeMode.marker, source: 'instruction' } ];   // [CCINT] ccPovId is parsed above; _aeCharChat is not assigned until below
    for (let i = 0; i < parsed.msgs.length; i++) {
        let m = parsed.msgs[i];
        if (m.role === 'user') {
            // [CHARCHAT-BRACE-DOUBLE] No literal brace: the paragraph is source:'instruction'
            // and NAI draws its own. Adding one was a confirmed cause of a resumed POV turn
            // coming back as "{ {Name: ...} }". The unwrap still runs so a thread saved by an
            // older build normalises clean, idempotent either way.
            paras.push({ text: _charchatUnwrapPov(m.content), source: 'instruction' });
        } else {
            let chunks = m.content.split('\n');
            for (let j = 0; j < chunks.length; j++) {
                let c = chunks[j].replace(/^\s+/, '').replace(/\s+$/, '');
                if (c.length > 0) paras.push({ text: c });
            }
        }
    }

    let before = await api.v1.document.sectionIds();
    await api.v1.document.appendParagraphs(paras);
    let after = await api.v1.document.sectionIds();
    let added = after.slice(before.length);
    if (added.length === 0) { api.v1.ui.toast('Could not resume the chat \u2014 document append failed.', { type: 'error', autoClose: 4000 }); return; }
    let markerId = added[0];

    let snap: any = null;
    try {
        snap = await api.v1.generationParameters.get();
        let ccRCfg = await loadConfig();
        await api.v1.generationParameters.update({
            model: String((ccRCfg as any).charChatModel || CC_DEFAULT_MODEL),
            max_tokens: ccResumeMode.maxTokens > 0 ? ccResumeMode.maxTokens
                                                   : charChatMaxTokensFor(ccContact, ccRCfg, ccPovId)
        });
    } catch (eP) { aeLog('[AE:charchat] param pin failed, continuing without pin:', eP); snap = null; }

    _aeCharChat = {
        active: true, markerId: markerId, setupIds: [],
        contactId: contactId, contactName: ccContact.name,
        povId: ccPovId, povName: ccPovName,   // povId now IS persisted/functional again — see the field's own comment
        mode: ccResumeMode.id,
        paramSnapshot: snap, startedAt: Date.now(), lastEmotion: ''
    };
    _ccLastSeenSectionCount = -1;   // [DIAG earlier CHARCHAT-EMPTY-REPLY-DIAG] resumed session, no baseline yet
    await saveCharChatState();

    try { await _charchatRegisterDecorations(markerId); await refreshCharChatDecorations(); }
    catch (eD) { aeLog('[AE:charchat] decoration registration failed (cosmetic only):', eD); }

    api.v1.ui.toast(ccResumeMode.label + ' with ' + ccContact.name
        + ' resumed \u2014 continue below the marker.', { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}

// Non-ending preview. [LOCKED PURPOSE] a NARRATIVE recap matching the story's own prose -- no
// transcript formatting, no turn labels, no Emotion lines (Close/save preserves those for
// resuming). Feeds the distiller a bare role:body transcript. This only returns text.
async function previewSummarizeCharChat(): Promise<string> {
    if (!_aeCharChat.active) return '';
    let collected = await collectCharChatTranscript();
    if (collected.msgs.length === 0) return '';
    let cfg = await loadConfig();
    // [CCSUM-SHAPE] No speaker labels, braces, Emotion lines or image ids. _charchatBareBody
    // strips the last three; the labels stop here.
    let sParts: string[] = [];
    for (let sI = 0; sI < collected.msgs.length; sI++) {
        let sM = collected.msgs[sI];
        let sWho = (sM.role === 'user') ? (_aeCharChat.povName || 'They') : _aeCharChat.contactName;
        let sBody = _charchatBareBody(sM.content, sWho).trim();
        if (sBody) sParts.push(sBody);
    }
    if (sParts.length === 0) return '';
    let sTranscript = sParts.join('\n\n');
    let styleHint = [cfg.projectGenre, cfg.projectConcept].filter(Boolean).join(' \u2014 ');
    let sMode = _ccMode();
    let sWhoA = _aeCharChat.contactName || 'one person';
    let sWhoB = _aeCharChat.povName || 'the other';

    // Bump the cap for this one call, restoring the chat's pin in a finally.
    // executeYoinkGeneration rides editor.generate(), which uses whatever generationParameters
    // are AMBIENT -- including the chat's SMS-length cap, still pinned because Summarize does
    // not end the chat. That is why summaries read as truncated fragments. The MODEL needs no
    // handling: executeYoinkGeneration pins glm-4-6 itself, which a prose distiller wants.
    let ccSumSnap: any = null;
    try {
        ccSumSnap = await api.v1.generationParameters.get();
        await api.v1.generationParameters.update({ max_tokens: AE_CHARCHAT_SUMMARY_MAX_TOKENS });
    } catch (ePin) { aeLog('[AE:charchat] summarize token bump failed, using whatever is ambient:', ePin); }

    let sOut = '';
    try {
        sOut = await executeYoinkGeneration([
            { role: 'system', content:
                'You write short narrative recaps for a story'
                + (styleHint ? (' (' + styleHint + ')') : '') + '. '
                + 'You are given the contents of ' + (sMode.id === 'interview' ? 'an interview' : 'a ' + sMode.channel)
                + ' between ' + sWhoA + ' and ' + sWhoB + ', one paragraph per turn, oldest first. '
                + 'Your output is PROSE, in the story\u2019s own voice and past tense. Never dialogue, never a '
                + 'transcript, never a list, never speaker labels, never quotation of whole lines. '
                + 'Keep only what was established, decided, revealed or changed between them. Be concise.' },
            // [CCSUM-SHAPE] THE ASK IS BELOW THE TRANSCRIPT, and the transcript is terminated.
            // Do not move either: with the transcript last and dangling on a turn, the most
            // likely continuation is another turn. Repeated here rather than left to the system
            // message because position beats volume.
            { role: 'user', content:
                'Here is the conversation.\n\n'
                + sTranscript
                + '\n\n[ END OF CONVERSATION \u2014 nothing follows this line ]\n\n'
                + 'The conversation above is complete. Do NOT continue it and do NOT reproduce it. '
                + 'Write the recap now, as a single short passage of narrative prose.' }
        ], { tag: 'charChatSummarize' });
    } finally {
        if (ccSumSnap) {
            try { await api.v1.generationParameters.update({ max_tokens: ccSumSnap.max_tokens }); }
            catch (eUnpin) { api.v1.error('[AE:charchat] summarize token restore failed \u2014 chat may stay at the wider cap until it ends:', eUnpin); }
        }
    }
    // [CCSUM-SHAPE] LAST-DITCH GUARD, not a substitute for the prompt work above. If the model
    // returned a transcript anyway the first line carries a speaker label; say so rather than
    // silently saving dialogue into a journal meant to hold prose.
    let sClean = (sOut || '').trim();
    if (/^[^\n:]{1,24}:\s/.test(sClean)) {
        aeLog('[AE:charchat] summarize returned transcript shape despite the terminated prompt \u2014 '
            + 'surfacing it unchanged so the failure is visible rather than saved silently.');
    }

    return sClean;
}

// 'save' (Close) writes the one thread for this pair; 'discard' (Clear) deletes it. One thread
// per pair means starting over is clearing what is there, not accumulating saves.
async function endCharChat(action: string): Promise<void> {
    if (!_aeCharChat.active) { api.v1.ui.toast('No character chat is open.', { type: 'warning', autoClose: 2500 }); return; }
    let act = (action === 'save') ? 'save' : 'discard';
    let ccContactId = _aeCharChat.contactId;

    let collected: { ids: number[]; msgs: WizardChatMessage[] } = { ids: [], msgs: [] };
    try { collected = await collectCharChatTranscript(); }
    catch (eccC) { api.v1.error('[AE:charchat] transcript scan failed:', eccC); }

    // Save/delete FIRST, destroy the document LAST — a failure here returns early,
    // leaving the chat intact rather than losing it to a half-completed end.
    if (act === 'save') {
        if (collected.msgs.length > 0) {
            try {
                let ccContact = await loadCharacter(ccContactId);
                if (ccContact) {
                    await upsertCharChatEntry(ccContact, _aeCharChat.povId, _aeCharChat.povName, collected.msgs);
                    api.v1.ui.toast('Chat with ' + ccContact.name + ' saved.', { type: 'success', autoClose: 3000 });
                }
            } catch (eS) {
                api.v1.error('[AE:charchat] lorebook save failed:', eS);
                api.v1.ui.toast('Save failed \u2014 the chat is still in your document, nothing was removed.', { type: 'error', autoClose: 5000 });
                return;
            }
        }
    } else {
        // One thread per PAIR: clearing deletes only THIS pov's thread with this contact.
        // Non-fatal if nothing was ever saved for the pair.
        try { await api.v1.lorebook.removeEntry(charChatEntryId(ccContactId, _aeCharChat.povId)); } catch (_eDel) {}
    }

    try {
        if (collected.ids.length > 0) await api.v1.document.removeParagraphs(collected.ids);
    } catch (eccR) { api.v1.error('[AE:charchat] paragraph removal failed \u2014 clean up manually from the marker down:', eccR); }

    // AE_CHARCHAT_RULE_IMGTAG must be removed with the rest: a rule left registered keeps
    // hiding '[Image#hex: ...]' in its scope, so a later story mention silently loses the text.
    try { api.v1.editor.decorations.removeRules([AE_CHARCHAT_RULE_MARKER, AE_CHARCHAT_RULE_POV, AE_CHARCHAT_RULE_CONTACT, AE_CHARCHAT_RULE_EMOTION, AE_CHARCHAT_RULE_HEAD, AE_CHARCHAT_RULE_EMOBOX, AE_CHARCHAT_RULE_NAME, AE_CHARCHAT_RULE_IMGTAG]); } catch (_eccDr2) {}
    // [CHARCHAT-IMGWIDGET] The photo anchors go with the rules. NAI would dispose them itself
    // on sectionRemoved; this is belt-and-braces for the 'save' path and for any ordering where
    // the clear lands before the strip. Handle-tracked, so the story's images survive.
    await _ccImgDisposeHandles();

    // Restore pinned generation params (same field-by-field shape as the WIZLIVE restore).
    if (_aeCharChat.paramSnapshot) {
        try {
            let ccPs: any = _aeCharChat.paramSnapshot;
            let ccR: any = { model: ccPs.model };
            if (ccPs.max_tokens !== undefined) ccR.max_tokens = ccPs.max_tokens;
            if (ccPs.temperature !== undefined) ccR.temperature = ccPs.temperature;
            if (ccPs.top_p !== undefined) ccR.top_p = ccPs.top_p;
            if (ccPs.top_k !== undefined) ccR.top_k = ccPs.top_k;
            if (ccPs.frequency_penalty !== undefined) ccR.frequency_penalty = ccPs.frequency_penalty;
            if (ccPs.presence_penalty !== undefined) ccR.presence_penalty = ccPs.presence_penalty;
            if (ccPs.min_p !== undefined) ccR.min_p = ccPs.min_p;
            await api.v1.generationParameters.update(ccR);
        } catch (eccRe) { api.v1.error('[AE:charchat] param restore failed:', eccRe); }
    }

    _aeCharChat = { active: false, markerId: null, setupIds: [], contactId: '', contactName: '', povId: '', povName: '', paramSnapshot: null, startedAt: 0, lastEmotion: '' };
    _ccLastSeenSectionCount = -1;   // [DIAG earlier CHARCHAT-EMPTY-REPLY-DIAG] chat closed, clear the stale baseline
    try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_eccRm) {}
    api.v1.ui.toast(act === 'save' ? 'Story mode restored.' : 'Chat cleared \u2014 story mode restored.', { type: 'success', autoClose: act === 'save' ? 2000 : 3000 });
    await broadcastCharChatState();
}

// Startup rehydration, identical contract to restoreLiveWizOnStartup: a chat comes back live IF
// its marker paragraph still exists, otherwise the stale state is cleared and pinned params are
// restored. Restoring the pin matters more here -- a stranded 120-token cap would silently
// truncate every story generation.
async function restoreCharChatOnStartup(): Promise<void> {
    let ccRaw = '';
    try { ccRaw = (await api.v1.storyStorage.getOrDefault(STORAGE_CHARCHAT, '')) as string; } catch (_ecc0) {}
    if (!ccRaw) return;
    let ccSt: any = null;
    try { ccSt = JSON.parse(ccRaw); } catch (_ecc1) { ccSt = null; }
    if (!ccSt || !ccSt.active || typeof ccSt.markerId !== 'number') {
        try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_ecc2) {}
        return;
    }
    let ccSecIds: number[] = [];
    try { ccSecIds = await api.v1.document.sectionIds(); } catch (_ecc3) {}
    if (ccSecIds.indexOf(ccSt.markerId) < 0) {
        if (ccSt.paramSnapshot) {
            try {
                let ccRp: any = { model: ccSt.paramSnapshot.model };
                if (ccSt.paramSnapshot.max_tokens !== undefined) ccRp.max_tokens = ccSt.paramSnapshot.max_tokens;
                await api.v1.generationParameters.update(ccRp);
            } catch (_ecc4) {}
        }
        try { await api.v1.storyStorage.remove(STORAGE_CHARCHAT); } catch (_ecc5) {}
        aeLog('[AE:charchat] stale chat state cleared (marker no longer in document).');
        return;
    }
    _aeCharChat = {
        active: true,
        markerId: ccSt.markerId,
        setupIds: Array.isArray(ccSt.setupIds) ? ccSt.setupIds : [],
        contactId: (typeof ccSt.contactId === 'string') ? ccSt.contactId : '',
        contactName: (typeof ccSt.contactName === 'string') ? ccSt.contactName : '',
        povId: (typeof ccSt.povId === 'string') ? ccSt.povId : '',
        // [CC-MODES] Resolved, not copied: state written before this field existed has no
        // `mode`, and copying raw would leave undefined on every pre-CC-MODES restore.
        mode: _ccModeId((typeof ccSt.povId === 'string') ? ccSt.povId : '', ccSt.mode),
        povName: (typeof ccSt.povName === 'string') ? ccSt.povName : '',
        paramSnapshot: ccSt.paramSnapshot || null,
        startedAt: ccSt.startedAt || Date.now(),
        lastEmotion: (typeof ccSt.lastEmotion === 'string') ? ccSt.lastEmotion : ''
    };
    // A chat whose contact was deleted between sessions would steer every generation at
    // a character that no longer exists. Fail loudly and close rather than limp.
    let ccChk = _aeCharChat.contactId ? await loadCharacter(_aeCharChat.contactId) : null;
    if (!ccChk) {
        aeLog('[AE:charchat] restored chat points at a missing character \u2014 closing it.');
        await endCharChat('discard');
        return;
    }
    try { await _charchatRegisterDecorations(ccSt.markerId); await refreshCharChatDecorations(); }
    catch (eccDr3) { aeLog('[AE:charchat] decoration restore failed (cosmetic only):', eccDr3); }
    api.v1.ui.toast('Still open \u2014 ' + _ccMode().label + ' with ' + _aeCharChat.contactName
        + ' \u2014 continue below the marker, or end it from the Chat button.', { type: 'info', autoClose: 6000 });
    await broadcastCharChatState();
}


// ── [CHARCHAT-HUD] Bridge-driven chat verbs ─────────────────────────────────
// Fire a chat turn the way the Send button does. api.v1.editor.generate() triggers a generation
// at the end of the document as if the user clicked Send -- no DOM, no click simulation, and
// CONFIRMED BY MEASUREMENT to cost zero script output budget. isBlocked() is checked but NOT
// TRUSTED: editor.generate() was caught throwing immediately after it returned false, because
// "a generation is already in progress" is NAI's own state. Hence the retry.
// [CHARCHAT-GEN-BREAK] GUARANTEE A TRAILING PARAGRAPH BREAK before firing a generation that
// appends nothing of its own. 'nudge' and 'regen' leave the cursor at the end of the POV turn,
// so NAI has no break to start a fresh section from and the reply lands INSIDE it. The blank is
// self-cleaning: a reply landing in it is a contact turn, and an empty one is dropped.
async function _charchatEnsureTrailingBreak(): Promise<void> {
    try {
        let ccBrIds = await api.v1.document.sectionIds();
        if (ccBrIds.length) {
            // scan() with from/to pinned to one id reads exactly that section -- there is no
            // api.v1.document.section(id) accessor.
            let ccBrLastId = ccBrIds[ccBrIds.length - 1];
            let ccBrRows = await api.v1.document.scan(undefined, { from: ccBrLastId, to: ccBrLastId });
            let ccBrLast = (ccBrRows && ccBrRows.length) ? ccBrRows[ccBrRows.length - 1].section : null;
            if (ccBrLast && String((ccBrLast.text || '')).trim() === '') return;   // already have one
        }
        await api.v1.document.appendParagraph({ text: '' });
    } catch (eBr) {
        // Non-fatal and deliberately not a return-false: the generation should still run. Worst
        // case is a glued reply, which the split machinery can still attempt to rescue.
        api.v1.error('[AE:charchat] trailing-break ensure failed (reply may glue):', eBr);
    }
}

async function _charchatFireGenerate(): Promise<boolean> {
    for (let ccAttempt = 0; ccAttempt < 3; ccAttempt++) {
        let ccBlocked = false;
        try { ccBlocked = await api.v1.editor.isBlocked(); } catch (_eIb) { ccBlocked = false; }
        if (!ccBlocked) {
            try { await api.v1.editor.generate(); return true; }
            catch (eG) { aeLog('[AE:charchat] editor.generate attempt ' + (ccAttempt + 1) + ' failed:', eG); }
        }
        await api.v1.timers.sleep(600);
    }
    api.v1.ui.toast('Could not start a reply — a generation may still be running.', { type: 'warning', autoClose: 3500 });
    return false;
}

// The bridge's whole write surface in one dispatcher. Every op re-broadcasts at the end so the
// panel repaints from the DOCUMENT, never from an optimistic local copy.
async function handleCharChatAction(payload: any): Promise<void> {
    let ccOp = String((payload && payload.op) || '');

    // [CHARCHAT-LAUNCHER-SETTINGS] 'thinking' and 'images' are config-only and touch no
    // document, so they run BEFORE the active-chat guard: the launcher surfaces both PRE-chat.
    if (ccOp === 'thinking') {
        let ccThCfg = await loadConfig();
        let ccThWant = (payload && typeof payload.on === 'boolean') ? !!payload.on : !ccThCfg.charChatFreshThoughts;
        ccThCfg.charChatFreshThoughts = ccThWant;
        await saveConfig(ccThCfg);
        let ccThWho = _aeCharChat.active && _aeCharChat.contactName ? _aeCharChat.contactName + '’s' : 'their';
        api.v1.ui.toast('Fresh thoughts ' + (ccThWant ? 'on — ' + ccThWho + ' state refreshes after each reply.' : 'off.'), { type: 'info', autoClose: 3000 });
        await broadcastCharChatState();
        return;
    }
    if (ccOp === 'images') {
        let ccImgCfg = await loadConfig();
        let ccImgWant = (payload && typeof payload.on === 'boolean') ? !!payload.on : !ccImgCfg.charChatImages;
        ccImgCfg.charChatImages = ccImgWant;
        await saveConfig(ccImgCfg);
        api.v1.ui.toast('Photo attachments ' + (ccImgWant ? 'on — either side can send pictures.' : 'off.'), { type: 'info', autoClose: 3000 });
        await broadcastCharChatState();
        return;
    }

    // Every remaining op acts on the live document, so they require an open chat.
    if (!_aeCharChat.active) {
        aeLog('[AE:charchat] action ignored — no chat is open.');
        return;
    }

    // [CHARCHAT-SHELL-BASELINE] The op vocabulary is 'arm', 'nudge', 'regen', 'edit', 'remove',
    // 'images'. Every one acts on the document or on config and NONE carries a message body.
    // That asymmetry IS the design: NAI owns composing, we own everything around it. The three
    // ops that turned bridge-held text into a POV paragraph are deleted; nothing outside NAI
    // writes a POV turn any more.

    if (ccOp === 'arm') {
        if (payload && payload.on === false) return;
        // [DIAG CHARCHAT-RACE-DIAG] Against onGenerationEnd's timeline, this says whether a Send
        // arrived while a thought was still in flight or after the busy indicator cleared, and
        // by how much. A short gap on a turn that still failed points at NAI's slot release.
        _ccRaceDiagMark('arm op received (a Send is imminent)');
        if (_ccThoughtSignal) {
            let ccArmSig = _ccThoughtSignal;
            _ccThoughtSignal = null;   // FIRST: one cancel per signal, and a second arm must not re-cancel a dead one
            try {
                ccArmSig.cancel().catch(function(eArmC1: any) {
                    api.v1.error('[AE:charchat:arm] thought cancel rejected \u2014 it may still be running. If a reply goes missing right after this line, this window is the first suspect:', eArmC1);
                });
                aeLog('[AE:charchat:arm] a Send is coming \u2014 CANCELLED the in-flight post-reply thought. '
                    + 'The previous thought stands, by design. If replies still go missing with Fresh Thoughts ON '
                    + 'and never with it OFF, cancellation is not freeing the slot in time (see the CE-INDEX v2.45.0 block).');
            } catch (eArmC2) {
                api.v1.error('[AE:charchat:arm] thought cancel threw (the send is unaffected):', eArmC2);
            }
        } else {
            // [DIAG CHARCHAT-RACE-DIAG] Nothing to cancel; logged so the timeline shows every
            // arm event, not only the ones that found something.
            aeLog('[AE:charchat:arm] a Send is coming \u2014 no thought was in flight to cancel.');
        }
        return;
    }

    // [CHARCHAT-SHELL-BASELINE] 'povclaim' is gone with the injection it claimed. The text is
    // now typed by a human into NAI's own editor, the case the origin rule was written for.


    if (ccOp === 'nudge') {
        // Generate with no new message -- "say something else". The instruction block at the
        // bottom of context always asks for the contact's NEXT message, so no special wording.
        // [CHARCHAT-GEN-BREAK] ...but "nothing added" is what glues the reply onto the POV turn.
        await _charchatEnsureTrailingBreak();
        await _charchatFireGenerate();
        return;
    }

    if (ccOp === 'regen') {
        let ccScan = await _charchatScanTurns();
        let ccLast: { isPov: boolean; ids: number[]; texts: string[] } | null = null;
        for (let ccI = ccScan.turns.length - 1; ccI >= 0; ccI--) {
            if (!ccScan.turns[ccI].isPov) { ccLast = ccScan.turns[ccI]; break; }
        }
        if (!ccLast) { api.v1.ui.toast('Nothing to regenerate yet.', { type: 'warning', autoClose: 2500 }); return; }

        // Keep a copy, drop the turn, fire. editor.generate() resolves when generation STARTS,
        // not finishes, so the restore can only cover a failure to START. Accepted.
        let ccBackup = ccLast.texts.slice();
        try { await api.v1.document.removeParagraphs(ccLast.ids); }
        catch (eR) { api.v1.error('[AE:charchat] regen remove failed:', eR); return; }
        await broadcastCharChatState();

        // [CHARCHAT-GEN-BREAK] Dropping the old reply leaves the cursor at the end of the POV
        // turn. Must run AFTER the remove -- the break has to be the last section -- and before
        // firing.
        await _charchatEnsureTrailingBreak();

        let ccOk = await _charchatFireGenerate();
        if (!ccOk) {
            for (let ccB of ccBackup) {
                try { await api.v1.document.appendParagraph({ text: ccB }); }
                catch (_eRb) {}
            }
            await broadcastCharChatState();
        }
        return;
    }

    if (ccOp === 'edit') {
        let ccIds: number[] = (payload && Array.isArray(payload.ids)) ? payload.ids.map(Number) : [];
        let ccText = String((payload && payload.text) || '');
        if (!ccIds.length) return;
        // Fold the edit onto the FIRST section of the turn and drop the rest: the user edited
        // one logical message, and a turn may span several sections only because of how NAI
        // split the reply. Re-canonicalisation re-applies the header, so the bridge sends BODY.
        try {
            await api.v1.document.updateParagraph(ccIds[0], { text: ccText });
            if (ccIds.length > 1) await api.v1.document.removeParagraphs(ccIds.slice(1));
        } catch (eE) { api.v1.error('[AE:charchat] edit failed:', eE); return; }
        // Safe to normalise here: no generation is in flight (this is a user action, not
        // a hook), which is the one condition the write pass requires.
        try { await _charchatNormalizeDocument(); } catch (_eEn) {}
        try { await refreshCharChatDecorations(); } catch (_eEd) {}
        await broadcastCharChatState();
        return;
    }

    if (ccOp === 'remove') {
        let ccIds: number[] = (payload && Array.isArray(payload.ids)) ? payload.ids.map(Number) : [];
        if (!ccIds.length) return;
        try { await api.v1.document.removeParagraphs(ccIds); }
        catch (eD) { api.v1.error('[AE:charchat] remove failed:', eD); return; }
        try { await refreshCharChatDecorations(); } catch (_eDd) {}
        await broadcastCharChatState();
        return;
    }

    aeLog('[AE:charchat] unknown action op: ' + ccOp);
}

// ── [CHARCHAT-IMG] Image attachments ────────────────────────────────────────
// A chat-SCOPED architect pass. Deliberately NOT buildArchitectPromptFromStory, which reads the
// last N sections -- during a chat those ARE the transcript, so it would compose an image prompt
// out of SMS banter and emotion tags.
// CHARACTER RESOLUTION: the speaker's visual record is seeded UNCONDITIONALLY rather than left
// to a name match, because "me grinning, holding up the coffee" names nobody and the speaker
// would generate as a stranger. Anyone else named is matched normally, capped at 4.
async function buildCharChatImagePrompt(description: string, speakerName: string): Promise<{ prompt: string; characters: { name: string; visuals: string; uc: string }[] } | null> {
    let ccDesc = (description || '').trim();
    if (!ccDesc) return null;
    await loadImageSettings();

    // Seed: the speaker, always. getCharacterData matches on its argument's text, so the bare
    // name is how we ask for this specific record.
    let ccChars: { name: string; visuals: string; uc: string }[] = [];
    let ccSelf = speakerName ? getCharacterData(speakerName) : [];
    if (ccSelf.length) ccChars.push({ name: ccSelf[0].name, visuals: ccSelf[0].visuals, uc: ccSelf[0].uc });

    // Anyone else the description explicitly names.
    let ccOthers = getCharacterData(ccDesc);
    for (let ccO of ccOthers) {
        if (ccChars.some(function(c) { return c.name === ccO.name; })) continue;
        ccChars.push({ name: ccO.name, visuals: ccO.visuals, uc: ccO.uc });
        if (ccChars.length >= 4) break;
    }

    let ccNames = ccChars.map(function(c) { return c.name; }).join(', ');
    let ccUser = 'Photo description:\n' + ccDesc
        + '\n\nThis is a photo taken by ' + (speakerName || 'someone') + ' and sent in a text message \u2014 '
        + 'compose it as a casual phone snapshot (handheld framing, natural/available light), not a cinematic still, '
        + 'unless the description clearly calls for something else.'
        + (ccNames ? '\n\nCharacters identified in scene: ' + ccNames + '. Apply their specific visual tags.' : '')
        + '\n\nGenerate the image prompt:';

    try {
        let ccResp = await aeDiagGenerate('imgArchitect:charchat',
            [
                { role: 'system', content: globalSettings.architectPrompt || DEFAULT_ARCH },
                { role: 'user',   content: ccUser }
            ],
            { model: 'glm-4-6', max_tokens: AE_CHARCHAT_IMG_MAX_TOKENS }
        );
        let ccPrompt = ((ccResp.choices && ccResp.choices[0] &&
            (ccResp.choices[0].message && ccResp.choices[0].message.content || ccResp.choices[0].text)) || ccResp.text || '').trim();
        if (!ccPrompt) return null;
        return { prompt: ccPrompt, characters: ccChars };
    } catch (eCcImg) {
        aeLog('[AE:charchat] image architect failed:', eCcImg);
        return null;
    }
}

// Dispatch ONE resolved attachment to the bridge. Mirrors assembleSnapshotImage's
// EVT_GENERATE_IMAGE payload shape, with kind:'charchat' so the bridge routes it to the chat
// rather than the gallery strip. uuid is generated HERE, not in the bridge, because it is also
// what gets written into the document tag -- the two must agree or the bubble cannot find it.
async function dispatchCharChatImage(uuid: string, prompt: string, chars: { name: string; visuals: string; uc: string }[], speakerName: string, isPov: boolean): Promise<void> {
    let ccCompiled = compileActiveImageFields();
    await ceBroadcastImageGen({
        uuid:             uuid,
        prompt:           prompt,
        characters:       chars,
        extraBaseVisuals: '',
        extraBaseUC:      '',
        kind:             'charchat',
        contactId:        _aeCharChat.contactId,
        povId:            _aeCharChat.povId,
        senderName:       speakerName,
        senderIsPov:      isPov,
        settings: {
            width:    globalSettings.defaultWidth,
            height:   globalSettings.defaultHeight,
            steps:    Math.min(globalSettings.defaultSteps || 28, 28),
            scale:    globalSettings.defaultScale || 5.0,
            model:    ceImgModel(),
            seed:     _ceImgSeed(0),
            quality:  ccCompiled.quality,
            negative: ccCompiled.negative
        },
        autoDownload: false
    });
}

// THE PASS, from onGenerationEnd's CHARCHAT branch AFTER _charchatNormalizeDocument has split
// any glued section and settled the text we are about to rewrite.
// WHY NOT onBeforeContextBuild: this calls api.v1.generate() via the architect, and that hook
// fires WHILE the turn's own generation is in progress, where NAI rejects nested calls outright.
// onGenerationEnd is the one place a nested generate is proven safe. _diagProbeActive is
// required for the same reason: the nested call re-fires the whole hook lifecycle including
// this branch. EITHER SIDE's tags are caught, so this walks every turn.
async function _charchatProcessImages(): Promise<number> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return 0;

    let ccScan = await _charchatScanTurns();
    let ccJobs: { sectionId: number; text: string; desc: string; isPov: boolean; speaker: string }[] = [];

    for (let ccT of ccScan.turns) {
        for (let ccI = 0; ccI < ccT.ids.length; ccI++) {
            let ccText = ccT.texts[ccI] || '';
            let ccRx = _charchatImageRx();
            let ccM = ccRx.exec(ccText);
            if (!ccM) continue;
            ccJobs.push({
                sectionId: ccT.ids[ccI],
                text: ccText,
                desc: ccM[1],
                isPov: ccT.isPov,
                speaker: ccT.isPov ? (_aeCharChat.povName || '') : (_aeCharChat.contactName || '')
            });
            if (ccJobs.length >= AE_CHARCHAT_IMG_MAX_PER_TURN) break;
        }
        if (ccJobs.length >= AE_CHARCHAT_IMG_MAX_PER_TURN) break;
    }
    if (!ccJobs.length) return 0;

    // [CHARCHAT-IMG-BUSY-FLASH] Flipped HERE, now a real job is confirmed. The caller flipped
    // busyStage='image' whenever the GLOBAL toggle was on, whether or not THIS reply asked for a
    // photo -- a misleading "sending photo..." on every turn.
    try { await _charchatSetBusy('image'); } catch (_eIB) {}

    if (!isBridgeReady) {
        api.v1.ui.toast('\ud83d\udcf7 Photo skipped \u2014 image generation needs the bridge connected.', { type: 'warning', autoClose: 3500 });
        return 0;
    }

    let ccDone = 0;
    for (let ccJ of ccJobs) {
        let ccUuid = api.v1.uuid();
        let ccShort = String(ccUuid).replace(/-/g, '').substring(0, 8).toLowerCase();

        // No manual _diagProbeActive pair: aeDiagGenerate sets and RESTORES it. A manual pair
        // clears to false unconditionally, stomping an outer guard if this ever ran nested.
        let ccBuilt: { prompt: string; characters: { name: string; visuals: string; uc: string }[] } | null = null;
        try { ccBuilt = await buildCharChatImagePrompt(ccJ.desc, ccJ.speaker); }
        catch (eB) { api.v1.error('[AE:charchat] image prompt build failed:', eB); }

        if (!ccBuilt) {
            // Leave the tag UNRESOLVED rather than stamping a uuid onto an image that was never
            // dispatched: a resolved tag pointing at nothing renders as a permanent spinner the
            // next pass refuses to retry.
            aeLog('[AE:charchat] image architect returned nothing for: ' + ccJ.desc);
            continue;
        }

        try { await dispatchCharChatImage(ccUuid, ccBuilt.prompt, ccBuilt.characters, ccJ.speaker, ccJ.isPov); }
        catch (eD) { api.v1.error('[AE:charchat] image dispatch failed:', eD); continue; }

        // Rewrite ONLY the first unresolved tag in this section, and only after a successful
        // dispatch. A non-global regex hits the first match, which the cap already assumes.
        let ccNew = ccJ.text.replace(/\[[ \t]*Image[ \t]*:[ \t]*([^\]\n\r]+?)[ \t]*\]/i,
            '[Image#' + ccShort + ': ' + ccJ.desc + ']');
        try {
            await api.v1.document.updateParagraph(ccJ.sectionId, { text: ccNew });
            ccDone++;
        } catch (eU) {
            api.v1.error('[AE:charchat] image tag rewrite failed (image still generating, bubble will not bind):', eU);
        }
    }
    return ccDone;
}

// Turn list for the bridge HUD. The bridge paints bubbles from THIS, never from the DOM: role
// comes from _charchatScanTurns and is NEVER inferred from text.
async function charChatTurnsPayload(): Promise<any[]> {
    if (!_aeCharChat.active || _aeCharChat.markerId === null) return [];
    let ccScan = await _charchatScanTurns();
    let ccOut: any[] = [];
    for (let ccT of ccScan.turns) {
        let ccCanon = _charchatCanonTurn(ccT, _aeCharChat.povName, _aeCharChat.contactName);
        if (!ccCanon) continue;

        // Split the display text into the parts the bridge renders separately: the emotion and
        // image tags stay in the DOCUMENT but the bridge wants them as fields, not as text.
        let ccEmotion = '';
        let ccCut = ccCanon.match(_charchatEmotionRx());
        if (ccCut && ccCut[1] && ccCut.index !== undefined) {
            ccEmotion = resolveEmotion(ccCut[1].trim());
            ccCanon = ccCanon.substring(0, ccCut.index);
        }

        let ccImgs: { uuid: string; desc: string; pending: boolean }[] = [];
        let ccRxR = _charchatImageResolvedRx();
        let ccMr: any;
        while ((ccMr = ccRxR.exec(ccCanon)) !== null) ccImgs.push({ uuid: ccMr[1], desc: ccMr[2], pending: false });
        let ccRxU = _charchatImageRx();
        let ccMu: any;
        while ((ccMu = ccRxU.exec(ccCanon)) !== null) ccImgs.push({ uuid: '', desc: ccMu[1], pending: true });

        // Body = the text with both tag forms and the leading name header removed.
        let ccBody = ccCanon
            .replace(_charchatImageResolvedRx(), '')
            .replace(_charchatImageRx(), '');
        ccBody = _charchatStripHeader(_charchatUnwrapPov(ccBody), [_aeCharChat.povName, _aeCharChat.contactName]);
        ccBody = ccBody.replace(/\n{3,}/g, '\n\n').trim();

        ccOut.push({
            ids:      ccT.ids,
            isPov:    ccT.isPov,
            speaker:  ccT.isPov ? (_aeCharChat.povName || 'You') : (_aeCharChat.contactName || 'They'),
            body:     ccBody,
            emotion:  ccEmotion,
            images:   ccImgs,
            raw:      ccCanon
        });
    }
    return ccOut;
}

// ── [CHARCHAT] end ─────────────────────────────────────


// Run a budget-free generation against a custom message array, resolving with the captured
// response text. editor.generate() shares the script-level rate limit with api.v1.generate(),
// so this checks isBlocked() and floors on getAllowedOutput().
// [YOINK-HARDEN] THE SINGLE-ATTEMPT PRIMITIVE. executeYoinkGeneration wraps this with model
// pinning, a language guard and one corrective retry -- call THAT, not this.

// ============================================================================
// SECTION 3g — BUDGET & GENERATION DIAGNOSTICS
// Token-budget probe and the generation ring-buffer log. Both are
// instrumentation only; AE_DIAG_BUDGET / AE_DIAG_GEN are kill switches.
// ============================================================================

// ── [DIAG BUDGET] Per-generation token-budget instrument ─────────────────────
// [DIAG] Additive, engine-only; AE_DIAG_BUDGET=false silences it and every call site is tagged
// [DIAG]. Measures the api.v1.script output/input allowance deltas across each generation, so
// the question "does the yoink draw on the script budget" has a reading rather than a guess.
// /budgetprobe runs the A/B, /budgetlog dumps the recent log.
var AE_DIAG_BUDGET = true;
var _diagProbeActive = false;      // true while ANY of our own nested api.v1.generate() calls is in flight — api.v1.generate() fires the full hook lifecycle, so every hook checks this first and no-ops rather than treating the nested call as a story/chat/wizard turn. [earlier/earlier] Set and RESTORED by aeDiagGenerate alone (the sole api.v1.generate() call site); the old hand-rolled true/false pairs at each caller are gone — they were redundant once the wrapper owned it, and they cleared unconditionally, which stomps an outer guard when nested.
interface DiagBudgetPre { out: number; inp: number; kind: string; continuityId: string | null; }
var _diagBudgetPre: DiagBudgetPre | null = null;
var _diagBudgetLog: string[] = [];
function diagBudO(): number { try { return api.v1.script.getAllowedOutput ? api.v1.script.getAllowedOutput() : -1; } catch (e) { return -1; } }
// [BILLED-IN] One subtraction, one place, so no call site re-derives the sign.
// Returns -1 rather than 0 when either sample failed: an unknown cost and a free call are
// different readings and a table that conflates them is worse than one that says so.
function _ceBilled(before: number): number {
    var after = diagBudI();
    if (before < 0 || after < 0) return -1;
    return Math.max(0, before - after);
}
function diagBudI(): number { try { return api.v1.script.getAllowedInput ? api.v1.script.getAllowedInput() : -1; } catch (e) { return -1; } }
function diagReplenishSec(): number { try { let t = api.v1.script.getTimeUntilAllowedOutput ? api.v1.script.getTimeUntilAllowedOutput(1000) : -1; return t >= 0 ? Math.round(t / 1000) : -1; } catch (e) { return -1; } }
// [GEN-BUDGET] Public budget snapshot for the HUD -- a first-class payload the bridge shows the
// author, deliberately separate from the channel-gated diagnostics above and always available.
// waitSec uses getTimeUntilAllowedOutput, which per script-types does not account for the user
// interaction flag, so it is a FLOOR, NOT A PROMISE. Output replenishes only while the author
// has interacted with the script recently, which is why the bridge copy tells them to advance
// the story rather than wait. Do not present waitSec as a countdown.
// NEVER CALLS waitForAllowedOutput: these paths run from modal and bridge callbacks where that
// signal never fires, so awaiting it deadlocks. Check and report; never block.
function aeBudgetReport(needOut?: number): { out: number; inp: number; waitSec: number; need: number } {
    const bOut = diagBudO();
    const bInp = diagBudI();
    const bNeed = (typeof needOut === 'number' && needOut > 0) ? needOut : 0;
    let bWait = -1;
    try {
        if (bNeed > 0 && api.v1.script.getTimeUntilAllowedOutput) {
            const ms = api.v1.script.getTimeUntilAllowedOutput(bNeed);
            bWait = ms >= 0 ? Math.ceil(ms / 1000) : -1;
        } else {
            bWait = diagReplenishSec();
        }
    } catch (eBud) { bWait = -1; }
    return { out: bOut, inp: bInp, waitSec: bWait, need: bNeed };
}

function diagBudgetSnapshot(kind: string, continuityId: string | null): void {
    if (!AE_DIAG_BUDGET) return;
    _diagBudgetPre = { out: diagBudO(), inp: diagBudI(), kind: kind, continuityId: continuityId };
}
function diagBudgetClose(continuityId: string | null): void {
    if (!AE_DIAG_BUDGET || !_diagBudgetPre) return;
    if (continuityId && _diagBudgetPre.continuityId && continuityId !== _diagBudgetPre.continuityId) return;
    let pre = _diagBudgetPre; _diagBudgetPre = null;
    let pO = diagBudO(), pI = diagBudI();
    let dO = pO - pre.out, dI = pI - pre.inp;
    let line = '[AE:budget] ' + pre.kind
        + '  out ' + pre.out + '\u2192' + pO + ' (\u0394' + (dO >= 0 ? '+' : '') + dO + ')'
        + '  in ' + pre.inp + '\u2192' + pI + ' (\u0394' + (dI >= 0 ? '+' : '') + dI + ')'
        + '  replenish~' + diagReplenishSec() + 's';
    aeLog(line);
    _diagBudgetLog.push(line);
    if (_diagBudgetLog.length > 30) _diagBudgetLog.shift();
}
function dumpBudgetLog(): string {
    if (!_diagBudgetLog.length) return 'No budget readings yet. Run a wizard turn or /budgetprobe first.\nCurrent: out=' + diagBudO() + ' in=' + diagBudI() + ' replenish~' + diagReplenishSec() + 's';
    return 'Recent generation budget readings (newest last):\n' + _diagBudgetLog.join('\n') + '\nCurrent: out=' + diagBudO() + ' in=' + diagBudI();
}
// A/B probe: a tiny api.v1.generate() against a tiny yoink, back to back, so their real budget
// cost is directly comparable. api.v1.generate is glm-4-6-only for chat per the docs, hence the
// model pin. _diagProbeActive keeps a probe generation from advancing story state.
async function runBudgetProbe(): Promise<string> {
    let L: string[] = ['Budget A/B probe (out=output allowance, in=input allowance):'];
    L.push('start:            out=' + diagBudO() + ' in=' + diagBudI());
    let a0o = diagBudO(), a0i = diagBudI(), aOk = false, aErr = '';
    // Manual _diagProbeActive pair removed \u2014 aeDiagGenerate sets/restores it.
    try {
        let r: any = await aeDiagGenerate('diag:budgetprobe:direct', [{ role: 'user', content: 'Reply with exactly one word: ping' }], { model: 'glm-4-6', max_tokens: 8, temperature: 0 });
        aOk = !!(r && r.choices && r.choices[0]);
    } catch (e) { aErr = String((e && (e as any).message) || e); }
    let a1o = diagBudO(), a1i = diagBudI();
    L.push('api.v1.generate:  ' + (aOk ? 'ok ' : ('ERR ' + aErr + ' ')) + ' out \u0394' + (a1o - a0o) + '  in \u0394' + (a1i - a0i));
    let b0o = diagBudO(), b0i = diagBudI(), bOk = false, bErr = '';
    try {
        let ry = await executeYoinkGeneration([{ role: 'system', content: 'Reply with exactly one word: ping' }, { role: 'user', content: 'ping' }], { tag: 'diag:budgetprobe' });
        bOk = !!(ry && ry.trim());
    } catch (e) { bErr = String((e && (e as any).message) || e); }
    let b1o = diagBudO(), b1i = diagBudI();
    L.push('yoink:            ' + (bOk ? 'ok ' : ('ERR ' + bErr + ' ')) + ' out \u0394' + (b1o - b0o) + '  in \u0394' + (b1i - b0i));
    L.push('end:              out=' + diagBudO() + ' in=' + diagBudI() + '  replenish~' + diagReplenishSec() + 's');
    let out = L.join('\n');
    aeLog(out);
    return out;
}
// ── [DIAG BUDGET] end ────────────────────────────────────────────────────────

// ── [DIAG GEN] Generation call diagnostics — engine-wide ────────────────────
// [GENDIAG] ONE SHARED, TAGGED RING BUFFER FOR BOTH GENERATION PATHS -- the budget-free YOINK
// path and the budgeted DIRECT path -- because each used to swallow its own errors with no
// common record, so a single transient AbortError from NAI's pipeline killed a whole batch
// behind a generic "Failed." toast. Recorded at diagGenRecord() and aeDiagGenerate(); the
// viewer is buildGenDiagContent().
// IN-MEMORY AND SESSION-ONLY, deliberately not in storage: diagnostic scaffolding, not user
// data. It resets on script reload and adds no storage key.
interface AEGenDiagEntry {
    id: number;
    tag: string;                 // which generator/feature (and often character) this call belongs to
    method: 'yoink' | 'direct';  // executeYoinkGeneration vs api.v1.generate
    startedAt: number;           // Date.now() when the call began
    ms: number;                  // wall-clock latency for this entry's outcome
    outcome: 'ok' | 'empty' | 'error';
    errorName: string;           // e.g. 'AbortError', 'Error' — '' when outcome !== 'error'
    errorMessage: string;
    retried: boolean;            // a same-messages retry was attempted after a thrown error (yoink only)
    driftDetected: boolean;      // non-Latin/CJK drift heuristic tripped (yoink only)
    validatorFailed: boolean;    // caller-supplied validator rejected the raw output (yoink only)
    outLen: number;              // length of the returned text, 0 on error
    budgetOut: number;
    budgetIn: number;
    // [BILLED-IN] budgetIn is the allowance BEFORE the call, so the drop is what the call cost.
    // The only per-call cache reading available: countUncachedInputTokens is in the typings but
    // not on this runtime, while getAllowedInput is documented as an UNCACHED-token allowance.
    // -1 where the caller did not sample it.
    billedIn: number;
}
var AE_DIAG_GEN = true;          // flip-in-code kill switch, mirrors AE_DIAG_BUDGET above
var AE_DIAG_GEN_MAX = 60;        // ring buffer cap — oldest entries drop first
var _diagGenLog: AEGenDiagEntry[] = [];
var _diagGenSeq = 0;

function diagGenRecord(entry: {
    tag: string; method: 'yoink' | 'direct'; startedAt: number; ms: number;
    outcome: 'ok' | 'empty' | 'error'; errorName: string; errorMessage: string;
    retried: boolean; driftDetected: boolean; validatorFailed: boolean; outLen: number;
    budgetOut: number; budgetIn: number; billedIn?: number;
}): void {
    if (!AE_DIAG_GEN) return;
    _diagGenSeq++;
    let full: AEGenDiagEntry = { id: _diagGenSeq, tag: entry.tag, method: entry.method, startedAt: entry.startedAt,
        ms: entry.ms, outcome: entry.outcome, errorName: entry.errorName, errorMessage: entry.errorMessage,
        retried: entry.retried, driftDetected: entry.driftDetected, validatorFailed: entry.validatorFailed,
        outLen: entry.outLen, budgetOut: entry.budgetOut, budgetIn: entry.budgetIn,
        billedIn: (typeof entry.billedIn === 'number') ? entry.billedIn : -1 };
    _diagGenLog.push(full);
    if (_diagGenLog.length > AE_DIAG_GEN_MAX) _diagGenLog.shift();
    let line = '[AE:gendiag] #' + full.id + ' ' + full.method + '  tag=' + full.tag
        + '  outcome=' + full.outcome
        + (full.errorName ? ('  ' + full.errorName + ': ' + full.errorMessage) : '')
        + '  ms=' + full.ms
        + (full.retried ? '  retried' : '')
        + (full.driftDetected ? '  drift' : '')
        + (full.validatorFailed ? '  validatorFailed' : '')
        + '  outLen=' + full.outLen
        + '  budget(out=' + full.budgetOut + ',in=' + full.budgetIn + ')'
        + (full.billedIn >= 0 ? ('  billedIn=' + full.billedIn) : '');
    if (full.outcome === 'error') api.v1.error(line); else aeLog(line);
}

function dumpGenDiagLog(): string {
    if (!_diagGenLog.length) return 'No generation calls logged yet this session.';
    let lines = _diagGenLog.slice().reverse().map(function(e) {
        return '#' + e.id + ' [' + new Date(e.startedAt).toLocaleTimeString() + ']  ' + e.method + '  ' + e.tag
            + '\n    outcome=' + e.outcome
            + (e.errorName ? ('  ' + e.errorName + ': ' + e.errorMessage) : '')
            + '  ms=' + e.ms
            + (e.retried ? '  retried' : '')
            + (e.driftDetected ? '  drift' : '')
            + (e.validatorFailed ? '  validatorFailed' : '')
            + '  outLen=' + e.outLen
            + '  budget(out=' + e.budgetOut + ',in=' + e.budgetIn + ')'
            + (e.billedIn >= 0 ? ('  billedIn=' + e.billedIn) : '');
    });
    let errCount = _diagGenLog.filter(function(e) { return e.outcome === 'error'; }).length;
    return 'Recent generation calls, newest first (' + _diagGenLog.length + ' logged, ' + errCount + ' error' + (errCount === 1 ? '' : 's') + '):\n' + lines.join('\n');
}

function clearGenDiagLog(): void { _diagGenLog = []; _diagGenSeq = 0; }

// [CHARCHAT-THOUGHT-NATIVE] aeGenerateBounded() is deleted, not parked -- an unused generation
// path is how this file grew a hidden HUD. generateChatEphemeral takes a CANCELLATION SIGNAL
// instead, cancelled by op 'arm' when a Send is imminent, which is the bound that matters; a
// wall-clock timeout would only abandon a call that is still running. If a future pass needs a
// bounded nested generation, recover the old shape rather than rewriting it: real cancellation
// via api.v1.createCancellationSignal(), always awaited to settlement, never a Promise.race --
// the naive version reintroduces the collision it existed to remove.

// ============================================================================
// SECTION 3h — GENERATION EXECUTION (direct wrapper + yoink pipeline)
// aeDiagGenerate wraps the DIRECT budgeted path; executeYoinkGeneration
// is the metered/free-run path with watchdog and retry classification.
// ============================================================================

// Thin instrumented wrapper around api.v1.generate() -- the DIRECT (budgeted) generation path,
// and THE SOLE CALLER of api.v1.generate() in this file. Messages, params and the raw response
// all pass through unchanged, so no caller's parsing or fallback changes; a thrown error is
// recorded AND rethrown.
// [CHARCHAT-OVERRIDE-LEAK] IT SETS _diagProbeActive, AND THAT IS WHY IT IS THE SOLE CALLER.
// The CHARCHAT context override claimed every generation reaching it was a chat turn. FALSE,
// and this file's own budget probe had already recorded the counter-evidence: api.v1.generate
// DOES build story context. generateEphemeral and the imgArchitect pass run WHILE a chat is
// open, so they took the full chat override -- system prompt replaced, character lorebook
// suppressed, and a storyText tail ending in the instruction block, which is exactly the
// fragment that leaked into the document. It also explains the 'extractJSON failed' runs: those
// calls ask for JSON and were handed a context asking for a text message. _diagProbeActive was
// already the documented mechanism; it was simply never set for every nested call. Setting it
// HERE covers all of them at once.
// SAVE/RESTORE, NOT A BLIND RESET. Two call sites already set the flag around a region that
// CONTAINS an aeDiagGenerate call, so clearing on the way out would drop their guard early and
// re-expose the window they set it for. Restoring makes nesting safe in either order.
// SIGNATURE per script-types.txt: generate(messages, params, callback?, behaviour?, signal?).
// The optional signal and behaviour are threaded through; callers that omit them are
// byte-identical to before. generateChatEphemeral asks for 'background' because it runs while
// the author is reading and typing and must never block the editor.
async function aeDiagGenerate(tag: string, messages: any[], params: any, signal?: any, behaviour?: 'background' | 'blocking'): Promise<any> {
    // [SLOT-YOINK-AUTO] Any metered call frees the next yoink run. Fire-and-forget and never
    // allowed to throw: failing to reset a counter must not take down the generation.
    _ceYoinkRunReset().catch(function() {});
    let t0 = Date.now();
    let b0o = diagBudO(), b0i = diagBudI();
    let ccProbePrev = _diagProbeActive;
    _diagProbeActive = true;
    try {
        let resp: any = signal
            ? await api.v1.generate(messages, params, undefined, behaviour, signal)
            : await api.v1.generate(messages, params, undefined, behaviour);
        let outText = String((resp && resp.choices && resp.choices[0] &&
            (resp.choices[0].text || (resp.choices[0].message && resp.choices[0].message.content))) || (resp && resp.text) || '');
        diagGenRecord({ tag: tag, method: 'direct', startedAt: t0, ms: Date.now() - t0,
            outcome: outText.trim() ? 'ok' : 'empty', errorName: '', errorMessage: '',
            retried: false, driftDetected: false, validatorFailed: false,
            outLen: outText.length, budgetOut: b0o, budgetIn: b0i,
            // [BILLED-IN] Sampled here, not in the finally: the finally also runs on the throw
            // path, where a second read would be attributed to a call that consumed nothing.
            billedIn: _ceBilled(b0i) });
        return resp;
    } catch (e) {
        diagGenRecord({ tag: tag, method: 'direct', startedAt: t0, ms: Date.now() - t0,
            outcome: 'error', errorName: String((e && (e as any).name) || 'Error'), errorMessage: String((e && (e as any).message) || e),
            retried: false, driftDetected: false, validatorFailed: false,
            outLen: 0, budgetOut: b0o, budgetIn: b0i, billedIn: _ceBilled(b0i) });   // [BILLED-IN]
        throw e;
    } finally {
        _diagProbeActive = ccProbePrev;
    }
}
// ── [DIAG GEN] end ────────────────────────────────────────────────────────────

function executeYoinkGenerationAttempt(messages: any[]): Promise<string> {
    return new Promise(function(resolve, reject) {
        if (_aeYoink.active) { reject(new Error('A yoink generation is already in progress')); return; }
        if (ae_genInFlight || ae_lock) { reject(new Error('Editor is busy; try again in a moment')); return; }
        // [YOINK-UNCAP] NO getAllowedOutput() FLOOR HERE. MEASURED: editor.generate() does not
        // draw down getAllowedOutput() at all, so a floor refused a FREE generation because a
        // budget it does not spend was low -- precisely when the free path is worth most. If
        // NAI does reject the call, the catch below converts it to the same toast, on evidence.
        _aeYoink.active = true;
        _aeYoink.messages = messages;
        _aeYoink.responseText = '';
        _aeYoink.resolve = resolve;
        _aeYoink.reject = reject;
        // Cleared here and captured in onContextBuilt, so this attempt only ever
        // accepts hook events belonging to the generation it actually started.
        _aeYoink.continuityId = null;
        diagBudgetSnapshot('YOINK', null);   // [DIAG] pre-read for this yoink; closed in onGenerationEnd
        api.v1.editor.generate().catch(function(ygErr) {
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
            // Surface rate-limit errors as a human-readable toast rather than letting the raw
            // NAI error bubble silently to the log.
            const ygEMsg = String((ygErr && ygErr.message) || ygErr || '');
            if (ygEMsg.toLowerCase().indexOf('limit') >= 0 || ygEMsg.toLowerCase().indexOf('budget') >= 0) {
                api.v1.ui.toast('Generation limit reached. Wait a moment before retrying.', { type: 'warning', autoClose: 5000 });
            }
            reject(ygErr);
        });
    });
}

// [YOINK-HARDEN] Cheap non-Latin/CJK drift heuristic -- not a language detector, just a signal
// that generation derailed into another script entirely (reported as the Wizard occasionally
// answering in Chinese). Hypothesis: the attempt rides whatever model the story's live settings
// point at, while NAI's docs state role-tagged messages are only supported by glm-4-6.
var AE_NONLATIN_DRIFT_RE = /[\u3040-\u30FF\u3400-\u4DBF\u4E00-\u9FFF\uAC00-\uD7AF\uF900-\uFAFF]/;

interface AEYoinkOptions {
    // Optional pass/fail check on the raw response (e.g. "contains NAME:"). A failing
    // check triggers the same one-shot corrective retry as language-drift detection.
    validator?: (raw: string) => boolean;
    // [GENDIAG] Which generator/feature (and often character) this call belongs
    // to, for diagGenRecord() — see the [DIAG GEN] block above. Defaults to 'untagged'
    // when omitted; every call site in this file passes one.
    tag?: string;
}

// [YOINK-WATCHDOG] MEASURED: NAI's generation pipeline can wedge -- observed as "Encoder Worker
// Timeout" in the console -- WITHOUT ever calling onGenerationEnd. Every guard in this file
// before it (the _aeYoink.active flag, the model-pin's try/finally, the onGenerationEnd
// failsafe) only runs in response to a hook firing, so one stuck generation left BOTH
// _aeYoink.active AND the pinned model stuck forever: every later story turn silently skipped
// world-state injection and ran on the wrong model, and every later wizard call was rejected.
// TWO INDEPENDENT PARTS:
//   1. A genuine client-side timeout (AE_YOINK_TIMEOUT_MS) via Promise.race against
//      api.v1.timers.sleep -- dependent on no NAI hook at all. On timeout we force-recover.
//   2. Force-recovery must not corrupt a NEWER call. Every hook carries NAI's own
//      continuityId; we capture it at context-build and check it before touching _aeYoink, so
//      a late event from an abandoned generation is recognised as orphaned and ignored.
var AE_YOINK_TIMEOUT_MS = 90000;

// The model pin is the prime suspect for the encoder wedge itself: every yoink forced a model
// switch and back even when nothing needed it, and glm-4-6 uses a different tokenizer from most
// story models. Defaulting OFF until confirmed safe. The watchdog is needed regardless.
var AE_YOINK_MODEL_PIN_ENABLED = false;

// [SLOT-YOINK-AUTO] MEASURED: editor.generate() does not draw down getAllowedOutput() the way
// api.v1.generate() does, but a run of them stops producing after roughly three UNLESS a metered
// generation happens in between, which frees the next run. Both are NAI's own metering of a
// documented method, so alternating is ordinary use of the surface, not a workaround.
// [YOINK-UNCAP] THE CAP IS OFF BY DEFAULT (0 = unlimited) BECAUSE THE TWO FAILURE DIRECTIONS
// ARE NOT SYMMETRIC. A too-high cap costs one wasted attempt that self-corrects on the same
// click, since an empty yoink in auto mode falls straight through to a metered call. A too-low
// cap is invisible and permanent: the author is silently moved onto the metered path and billed
// for generations NAI would have served free, with nothing on any surface saying so.
// So the EMPTY RESPONSE is the gate, not the counter -- NAI's own answer rather than our guess
// at its metering. The counter is kept and still feeds _ceFreeRunsReport, so re-imposing a cap
// is a one-integer change if NAI ever starts hard-failing instead of returning empty.
const AE_YOINK_RUN_MAX = 0;   // 0 = unlimited; any positive integer re-arms the hard cap
const STORAGE_YOINK_RUN = 'ae_yoink_run';   // tempStorage: consecutive yoink calls since the last metered one

// [SLOT-YOINK-AUTO] tempStorage, not a module var: the engine is unloaded on story switch, and
// a counter surviving that would claim free generations this story never made. Losing the count
// is harmless; keeping a stale one is not.
async function _ceYoinkRunGet(): Promise<number> {
    try {
        const raw = await api.v1.tempStorage.getOrDefault(STORAGE_YOINK_RUN, '0') as string;
        const n = parseInt(String(raw), 10);
        return (isFinite(n) && n >= 0) ? n : 0;
    } catch (e) { return 0; }
}
async function _ceYoinkRunSet(n: number): Promise<void> {
    try { await api.v1.tempStorage.set(STORAGE_YOINK_RUN, String(Math.max(0, n))); } catch (e) {}
}

// EVERY metered generation resets the run, not just slot-options ones -- a story turn, a beat
// pass or a hook update frees the next run just as well. aeDiagGenerate is the single choke
// point they all pass through, which is why the reset lives there and not at each call site.
async function _ceYoinkRunReset(): Promise<void> { await _ceYoinkRunSet(0); }

// [STUDIO-2] Report the free-run state for the bridge to display: how many generations are
// still free is the one number an author actually budgets against, and no surface could say it.
// RIDES THE EXISTING EVT_SLOT_OPTIONS PAYLOAD -- a new key, not a new message pair -- because
// the bridge already caches that payload for this purpose, so the readout cannot drift from it.
// `left` is derived HERE, not in the bridge: AE_YOINK_RUN_MAX is an OBSERVED constant expected
// to be re-measured, and a bridge computing max - used itself would need a matching release
// every time it was. The arithmetic stays on the side that owns the constant.
async function _ceFreeRunsReport(): Promise<{ used: number; max: number; left: number }> {
    try {
        const frUsed = await _ceYoinkRunGet();
        // [YOINK-UNCAP] left = -1 is the UNLIMITED sentinel, not an error and not a zero. A
        // surface must test for it explicitly: "0 left" and "no cap" are opposite states, and
        // collapsing them tells the author to stop generating the moment it became free.
        if (AE_YOINK_RUN_MAX <= 0) return { used: frUsed, max: 0, left: -1 };
        return { used: frUsed, max: AE_YOINK_RUN_MAX, left: Math.max(0, AE_YOINK_RUN_MAX - frUsed) };
    } catch (e) {
        // Never throw into a reply path -- a missing readout is a cosmetic loss, a thrown
        // one loses the options the author just paid for.
        // [YOINK-UNCAP] Must carry the sentinel too: left: 0 here would report "no free runs
        // remain" from the one branch that knows nothing at all.
        if (AE_YOINK_RUN_MAX <= 0) return { used: 0, max: 0, left: -1 };
        return { used: 0, max: AE_YOINK_RUN_MAX, left: AE_YOINK_RUN_MAX };
    }
}

function ygTimeoutRejection(ms: number): Promise<never> {
    return api.v1.timers.sleep(ms).then(function() {
        throw new Error('Yoink generation timed out after ' + Math.round(ms / 1000) + 's (encoder/generation pipeline appears stuck) \u2014 recovered automatically.');
    });
}

// One attempt bounded by AE_YOINK_TIMEOUT_MS. If the timeout wins the underlying attempt is NOT
// cancelled -- api.v1 exposes no cancellation for editor.generate() -- so we force-recover
// _aeYoink here rather than leaving it to cleanup that may never run. State the abandoned call's
// late callbacks would have touched is guarded by continuityId, so recovery cannot corrupt the
// next call.
async function ygAttemptWithWatchdog(msgs: any[], tag?: string): Promise<string> {
    try {
        return await Promise.race([executeYoinkGenerationAttempt(msgs), ygTimeoutRejection(AE_YOINK_TIMEOUT_MS)]);
    } catch (ygTimeoutErr) {
        if (_aeYoink.active) {
            api.v1.error('[AE:wizard] yoink watchdog fired (tag=' + (tag || 'untagged') + ') \u2014 force-recovering stuck generation state:', ygTimeoutErr);
            // [WIZMODE] Remember this generation's id (if captured) so any late
            // output/end-event is still caught by the onResponse/onGenerationEnd zombie
            // check even after wizard mode has since exited.
            if (_aeYoink.continuityId) _wizZombieIds[_aeYoink.continuityId] = true;
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
        }
        throw ygTimeoutErr;
    }
}

// [GENDIAG] Classifies a thrown yoink error as worth one immediate same-messages retry. A
// thrown error on the FIRST attempt (observed as AbortError from NAI's own pipeline) used to
// skip ALL retry logic and fail a whole batch on one transient hiccup.
// EXCLUDED FROM RETRY: our OWN deterministic state guards, which reject identically on an
// immediate retry, and our own watchdog timeout, which already waited once -- retrying blind
// doubles the wait on a pipeline that may be genuinely wedged. Everything else is transient.
function ygIsRetryableError(e: any): boolean {
    let msg = String((e && (e as any).message) || e || '');
    if (msg.indexOf('already in progress') >= 0) return false;
    if (msg.indexOf('Editor is busy') >= 0) return false;
    if (msg.indexOf('budget is low') >= 0) return false;
    if (msg.indexOf('timed out after') >= 0) return false;
    return true;
}

// [YOINK-HARDEN] Orchestrates a yoink generation with four defensive layers over
// executeYoinkGenerationAttempt:
//   1. MODEL PIN, best-effort and off by default (AE_YOINK_MODEL_PIN_ENABLED). Snapshots the
//      params, skips the update when already on glm-4-6, restores in finally -- reliable even
//      on a stuck generation, because ygAttemptWithWatchdog guarantees the await settles.
//   2. LANGUAGE GUARD: an English-only instruction appended once to the first system message.
//   3. ERROR RETRY: ygIsRetryableError decides whether a thrown first attempt is worth one
//      same-messages retry. A non-retryable or twice-failing error propagates unchanged.
//   4. VALIDATE + ONE CORRECTIVE RETRY against AE_NONLATIN_DRIFT_RE and the optional
//      caller-supplied validator, retrying the SAME messages with a corrective line appended.
// Every outcome -- success, empty or propagated error -- is recorded via diagGenRecord() into
// the shared ring buffer alongside the DIRECT path.
async function executeYoinkGeneration(messages: any[], opts?: AEYoinkOptions): Promise<string> {
    let ygTag = (opts && opts.tag) || 'untagged';
    let ygT0 = Date.now();
    let ygB0o = diagBudO(), ygB0i = diagBudI();
    let ygMessages = messages.slice();
    if (ygMessages.length > 0 && ygMessages[0] && ygMessages[0].role === 'system') {
        ygMessages[0] = { role: 'system', content: String(ygMessages[0].content || '') + '\n\nRespond in English only, regardless of any other language present in the reference context.' };
    }

    let ygPrior: any = null;
    if (AE_YOINK_MODEL_PIN_ENABLED) {
        try { ygPrior = await api.v1.generationParameters.get(); }
        catch (ygGetErr) { aeLog('[AE:wizard] generationParameters.get failed, skipping model pin:', ygGetErr); }

        if (ygPrior && ygPrior.model !== 'glm-4-6') {
            try { await api.v1.generationParameters.update({ model: 'glm-4-6' }); }
            catch (ygPinErr) { aeLog('[AE:wizard] glm-4-6 pin failed, continuing on current model:', ygPinErr); ygPrior = null; }
        } else if (ygPrior) {
            ygPrior = null;   // already on glm-4-6 — nothing to restore, nothing to skip past.
        }
    }

    try {
        let ygRaw = '';
        let ygErrorRetried = false;
        try {
            ygRaw = await ygAttemptWithWatchdog(ygMessages, ygTag);
        } catch (ygFirstErr) {
            if (!ygIsRetryableError(ygFirstErr)) {
                diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
                    outcome: 'error', errorName: String((ygFirstErr && (ygFirstErr as any).name) || 'Error'),
                    errorMessage: String((ygFirstErr && (ygFirstErr as any).message) || ygFirstErr),
                    retried: false, driftDetected: false, validatorFailed: false, outLen: 0,
                    budgetOut: ygB0o, budgetIn: ygB0i });
                throw ygFirstErr;
            }
            aeLog('[AE:wizard] yoink attempt failed (' + String((ygFirstErr && (ygFirstErr as any).name) || 'Error') + ': ' + String((ygFirstErr && (ygFirstErr as any).message) || ygFirstErr) + ') \u2014 retrying once (tag=' + ygTag + ')');
            ygErrorRetried = true;
            try {
                ygRaw = await ygAttemptWithWatchdog(ygMessages, ygTag);
            } catch (ygSecondErr) {
                diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
                    outcome: 'error', errorName: String((ygSecondErr && (ygSecondErr as any).name) || 'Error'),
                    errorMessage: String((ygSecondErr && (ygSecondErr as any).message) || ygSecondErr),
                    retried: true, driftDetected: false, validatorFailed: false, outLen: 0,
                    budgetOut: ygB0o, budgetIn: ygB0i });
                throw ygSecondErr;
            }
        }

        let ygEmpty = !ygRaw || !ygRaw.trim();
        let ygDrift = !ygEmpty && AE_NONLATIN_DRIFT_RE.test(ygRaw);
        let ygInvalid = !ygEmpty && !!(opts && opts.validator) && !opts.validator(ygRaw);
        let ygCorrectiveRetried = false;
        if (ygEmpty || ygDrift || ygInvalid) {
            ygCorrectiveRetried = true;
            let ygRetryMessages = ygMessages.slice();
            ygRetryMessages.push({ role: 'user', content: '[Your previous response broke format or used non-English text. Respond in English only, in plain prose, with no bullet points, lists, or markdown. Follow the FORMAT above exactly.]' });
            try {
                let ygRetryRaw = await ygAttemptWithWatchdog(ygRetryMessages, ygTag);
                if (ygRetryRaw && ygRetryRaw.trim()) ygRaw = ygRetryRaw;
            } catch (ygRetryErr) {
                aeLog('[AE:wizard] corrective retry failed, keeping first-attempt output:', ygRetryErr);
            }
        }
        diagGenRecord({ tag: ygTag, method: 'yoink', startedAt: ygT0, ms: Date.now() - ygT0,
            outcome: (ygRaw && ygRaw.trim()) ? 'ok' : 'empty', errorName: '', errorMessage: '',
            retried: ygErrorRetried || ygCorrectiveRetried, driftDetected: ygDrift, validatorFailed: ygInvalid,
            outLen: (ygRaw || '').length, budgetOut: ygB0o, budgetIn: ygB0i });
        return ygRaw;
    } finally {
        if (ygPrior) {
            let ygRestore: any = { model: ygPrior.model };
            if (ygPrior.max_tokens !== undefined) ygRestore.max_tokens = ygPrior.max_tokens;
            if (ygPrior.temperature !== undefined) ygRestore.temperature = ygPrior.temperature;
            if (ygPrior.top_p !== undefined) ygRestore.top_p = ygPrior.top_p;
            if (ygPrior.top_k !== undefined) ygRestore.top_k = ygPrior.top_k;
            if (ygPrior.frequency_penalty !== undefined) ygRestore.frequency_penalty = ygPrior.frequency_penalty;
            if (ygPrior.presence_penalty !== undefined) ygRestore.presence_penalty = ygPrior.presence_penalty;
            if (ygPrior.min_p !== undefined) ygRestore.min_p = ygPrior.min_p;
            try { await api.v1.generationParameters.update(ygRestore); }
            catch (ygRestoreErr) { api.v1.error('[AE:wizard] failed to restore generation params after yoink pin:', ygRestoreErr); }
        }
    }
}
// ============================================================================
// SECTION 3i — SCRIPT-LEVEL STATE VARIABLES
// The actual module-level mutable state: broadcast in-flight/pending
// latches, bridge-ready flag, debounce handles, modal handles, caches.
// ============================================================================

var ae_pendingGenerate = false; // a move effect requested generation; the top-level handler fires it once after ALL effects

// ── Bridge Communication State ────────────────────────────────────────────────
// isBridgeReady: set true after first successful EVT_HANDSHAKE_ACK.
// engineScriptId is not stored here (this IS the engine); the bridge stores it.
var isBridgeReady = false;

// Debounce timers for broadcast functions (Section 18).
// Both functions are called frequently (on every save); debouncing prevents storms.
var _charDataBroadcastTimeout: any = null;

// ── Character Visual Cache ────────────────────────────────────────────────────
var cachedCharVisuals: CharacterVisualRecord[] = [];

// ── Image Settings State ──────────────────────────────────────────────────────
// Loaded from api.v1.storage (global, not story-bound) by loadImageSettings().
var imagePromptFields: ImagePromptField[] = [];
var globalSettings: GlobalImageSettings = {
    autoDownload: false,
    // [STORYIMG-DEFAULT-ON] DEFAULTS ON, and the reason is that the indicator already existed
    // and this flag was switching it off. STORYIMG's pending placeholder -- the anchor pinned at
    // Generate time that the bridge spins until the bytes land, and that stays standing if they
    // never do -- is gated entirely on this, so defaulting false shipped a mechanism that never
    // ran for anybody.
    studioPlaceInStory: true,
    contextSize: DEFAULT_CTX,
    architectPrompt: DEFAULT_ARCH,
    architectAutoSnap: true
};

// ── NAI Sidebar Modal Handles ─────────────────────────────────────────────────
// Handles for the NAI-side modal windows (GM authoring tools).
// Each is set when a modal opens and nulled when it closes.

// ============================================================================
// SECTION 3d — SELF TEST
// `/ce selftest [pure|read|all]` -- the file's only automated check.
// TWO TIERS, AND THE MISSING THIRD IS DELIBERATE.
//   PURE  -- synthetic input to a pure function, checked output. Touches no storage.
//   READ  -- reads LIVE storage and asserts an INVARIANT over it. Not one line writes.
//   WRITE -- DOES NOT EXIST AND MUST NOT BE ADDED. There is no scratch story to run in and
//            storyStorage is the author's actual save. If a write path needs proving, extract
//            its DECISION into a pure function and test that -- a better shape anyway.
// THE READ TIER IS THE VALUABLE HALF, because the bugs this file ships are invariant violations
// that produce no error and no blank screen. THE BAR FOR ADDING A CHECK: it would have caught a
// real bug from this file's own history.
// A CHECK RETURNS null FOR PASS, OR A STRING SAYING WHAT WAS WRONG -- false on its own has never
// been enough to act on.
var CE_TESTS: any[] = [];
function ceTest(group: string, name: string, fn: any): void {
    CE_TESTS.push({ group: group, name: name, fn: fn });
}
function _tEq(actual: any, expected: any, what: string): string | null {
    return (actual === expected) ? null
        : (what + ': expected ' + JSON.stringify(expected) + ', got ' + JSON.stringify(actual));
}

function _ceRegisterTests(): void {
    if (CE_TESTS.length) return;

    // -- PURE ------------------------------------------------------------------
    ceTest('pure', 'ceFilterMatch tests every field, not just the first', function() {
        // [PICKER-SPLIT] The exact bug that hid for four versions.
        return _tEq(ceFilterMatch('key', ['Rusty Key', 'in the chest']), true, 'label hit')
            || _tEq(ceFilterMatch('chest', ['Rusty Key', 'in the chest']), true, 'sub hit')
            || _tEq(ceFilterMatch('anvil', ['Rusty Key', 'in the chest']), false, 'miss')
            || _tEq(ceFilterMatch('', ['anything']), true, 'empty needle matches all');
    });

    ceTest('pure', 'ceFilterNeedle normalises', function() {
        return _tEq(ceFilterNeedle('  KeY  '), 'key', 'trim+lower')
            || _tEq(ceFilterNeedle(null), '', 'null');
    });

    ceTest('pure', 'ceMapKindOf normalises unknowns to region', function() {
        // This normaliser is why mapKind could gain 'hidden' with no migration. If it stops
        // defaulting, every record written before a value existed changes meaning.
        return _tEq(ceMapKindOf(undefined), 'region', 'undefined')
            || _tEq(ceMapKindOf('nonsense'), 'region', 'unknown')
            || _tEq(ceMapKindOf('hidden'), 'hidden', 'hidden')
            || _tEq(ceMapKindOf('vehicle'), 'vehicle', 'vehicle')
            || _tEq(ceMapKindOf('interior'), 'interior', 'interior');
    });

    ceTest('pure', 'ceTravelVehicleOf takes the innermost hull', function() {
        // [MAP-VEHICLE] THE BAR FOR A CHECK IS "it would have caught a real bug", and the
        // two this covers are the ones the walk can silently get wrong: answering the
        // OUTERMOST vehicle (a launch inside a carrier sails the carrier), and answering ''
        // for a camera standing on the vehicle node itself (a one-node ship, which is most
        // of them, would never offer the feature at all).
        var metas: any[] = [
            { id: 'sea',   name: 'The Sea',  type: 'location', parentId: null },
            { id: 'ship',  name: 'Carrier',  type: 'location', parentId: 'sea',  mapKind: 'vehicle' },
            { id: 'bay',   name: 'Hangar',   type: 'location', parentId: 'ship', mapKind: 'interior' },
            { id: 'boat',  name: 'Launch',   type: 'location', parentId: 'bay',  mapKind: 'vehicle' },
            { id: 'cabin', name: 'Cabin',    type: 'location', parentId: 'boat', mapKind: 'interior' }
        ];
        var byId = ceTravelGraph(metas);
        return _tEq(ceTravelVehicleOf(byId, 'cabin'), 'boat', 'innermost wins')
            || _tEq(ceTravelVehicleOf(byId, 'boat'), 'boat', 'aboard the node itself')
            || _tEq(ceTravelVehicleOf(byId, 'bay'), 'ship', 'a room aboard the outer hull')
            || _tEq(ceTravelVehicleOf(byId, 'sea'), '', 'not aboard anything')
            || _tEq(ceTravelInside(byId, 'cabin', 'ship'), true, 'a cabin is inside the carrier')
            || _tEq(ceTravelInside(byId, 'ship', 'ship'), true, 'inclusive at the container end')
            || _tEq(ceTravelInside(byId, 'sea', 'ship'), false, 'the sea is not inside the ship');
    });

    ceTest('pure', 'ceMapWouldCycle blocks a descendant becoming a parent', function() {
        var byId: any = { a: { id: 'a', parentId: null }, b: { id: 'b', parentId: 'a' },
                          c: { id: 'c', parentId: 'b' } };
        return _tEq(ceMapWouldCycle(byId, 'a', 'c'), true, 'a under its own grandchild')
            || _tEq(ceMapWouldCycle(byId, 'c', 'a'), false, 'c under its grandparent is fine');
    });

    ceTest('pure', '_ceAncestorAtTier answers or admits it cannot', function() {
        // Returning '' for "chain too short" is load-bearing: callers INCLUDE on '', so a
        // filter that cannot decide drops nobody. A real id for a short chain would make the
        // cast-lore tier filter silently exclude people.
        var byId: any = { w: { id: 'w', parentId: null }, r: { id: 'r', parentId: 'w' },
                          h: { id: 'h', parentId: 'r' } };
        return _tEq(_ceAncestorAtTier(byId, 'h', 1), 'w', 'tier 1 from depth 2')
            || _tEq(_ceAncestorAtTier(byId, 'h', 2), 'r', 'tier 2 from depth 2')
            || _tEq(_ceAncestorAtTier(byId, 'w', 2), '', 'chain too short -> cannot answer')
            || _tEq(_ceAncestorAtTier(byId, 'h', 0), '', 'tier 0 is off');
    });

    ceTest('pure', 'empty lore text is empty, not a bare header', function() {
        // projectCastLore gates enabled/forceActivation on non-empty text, so '' is what
        // disables the entry rather than shipping a heading with no list under it.
        return _tEq(buildCastLoreText([]), '', 'no rows -> no text')
            || _tEq(buildWorldLoreText([]), '', 'no places -> no text');
    });

    ceTest('pure', 'world lore indents by depth and keeps descriptions', function() {
        var t = buildWorldLoreText([{ name: 'City', depth: 0, desc: '' },
                                    { name: 'Inn', depth: 1, desc: 'warm' }]);
        if (t.indexOf('\n- City') < 0) return 'root line malformed: ' + JSON.stringify(t);
        if (t.indexOf('\n  - Inn: warm') < 0) return 'child not indented or desc dropped: ' + JSON.stringify(t);
        return null;
    });

    ceTest('pure', 'applyCharFieldValue writes the flags it claims and rejects the rest', function() {
        var c: any = {};
        var okA = applyCharFieldValue(c, 'flag.active', false);
        var okB = applyCharFieldValue(c, 'flag.nonsense', true);
        return _tEq(okA, true, 'active accepted')
            || _tEq(c.active, false, 'active written')
            || _tEq(okB, false, 'unknown flag rejected');
    });

    // [F-14] The two rules that are silent when wrong: an index that does not clamp charges
    // the wrong outcome, and a protagonist-scoped def on the target side charges the wrong
    // person. Neither throws and neither shows up in a receipt as anything but a number.
    ceTest('pure', 'a stake row clamps to the table it has', function() {
        var rows: any[] = [
            { actor: { defId: 'a', amount: -1 }, target: { defId: '', amount: 0 } },
            { actor: { defId: 'b', amount: -1 }, target: { defId: '', amount: 0 } }
        ];
        var pick = function(i: number): string {
            var idx = Math.max(0, Math.min(rows.length - 1, Math.round(Number(i) || 0)));
            return String(rows[idx].actor.defId);
        };
        return _tEq(pick(0), 'a', 'first')
            || _tEq(pick(1), 'b', 'second')
            || _tEq(pick(7), 'b', 'past the end clamps to last')
            || _tEq(pick(-3), 'a', 'below the start clamps to first');
    });

    ceTest('pure', 'a protagonist-scoped stake cannot be charged to a target', function() {
        var prot: any = { id: 'st_coin', name: 'Coin', scope: 'protagonist', min: 0, max: 9, start: 0, bands: [], restBand: 0 };
        var chr: any = { id: 'st_hp', name: 'Health', scope: 'char', min: 0, max: 9, start: 9, bands: [], restBand: 0 };
        var asActor: any = _ceStakeRef(prot, 'someone', true);
        var asTarget: any = _ceStakeRef(prot, 'someone', false);
        var charTarget: any = _ceStakeRef(chr, 'someone', false);
        return _tEq(!!asActor, true, 'protagonist def is chargeable to the actor')
            || _tEq(asTarget, null, 'protagonist def refuses the target side')
            || _tEq(charTarget ? charTarget.ownerId : '', 'someone', 'char def uses the side id');
    });

    ceTest('pure', 'migrateConfig backfills every key it must', function() {
        // [KIND-BACKFILL] A shape addition without a migrate line is invisible until an old
        // save loads. ADD A LINE HERE FOR EVERY NEW GlobalConfig KEY.
        var c: any = migrateConfig({});
        return _tEq(typeof c.graveyardEntityId, 'string', 'graveyardEntityId')
            || _tEq(typeof c.maxDynamicCharacters, 'number', 'maxDynamicCharacters')
            || _tEq(Array.isArray(c.resolutionDefs), true, 'resolutionDefs')
            || _tEq(Array.isArray(c.stakeDefs), true, 'stakeDefs');
    });

    ceTest('pure', 'pack geometry: children stay inside, siblings do not overlap', function() {
        // A geometry bug here is A BLANK SURFACE WITH NO CONSOLE LINE.
        // THE FIXTURE LINKS PARENTS NOW AND NEVER DID. The final transform is
        // PARENT-RELATIVE -- a node's centre is its parent's centre plus its own local
        // offset -- so a fixture without `parent` pointers took the root branch for every
        // node and measured a layout the map cannot produce. Every tree that reaches
        // ceMapPackHierarchy comes from ceMapBuildTree, which links both ways.
        var root: any = { id: 'r', parent: null, children: [
            { id: 'a', children: [] }, { id: 'b', children: [] }, { id: 'c', children: [] }] };
        for (var pi = 0; pi < root.children.length; pi++) root.children[pi].parent = root;
        ceMapSumValues(root);
        var p: any = ceMapPackHierarchy(root, 1000, 4);
        if (!p || !p.children) return 'pack returned nothing';
        // [MAP-SELF] THE SLOT IS PART OF THE GEOMETRY AND IS CHECKED LIKE ONE. It is not
        // drawn as a circle, so nothing on screen would report it escaping or sitting on a
        // child -- the symptom would be a name quietly overlapping a room again, which is
        // the bug this whole mechanism exists to end.
        if (!(p.sr > 0)) return 'parent has children but no slot';
        var ds = Math.sqrt((p.sx - p.x) * (p.sx - p.x) + (p.sy - p.y) * (p.sy - p.y));
        if (!isFinite(ds) || !isFinite(p.sr)) return 'slot has non-finite geometry';
        if (ds + p.sr > p.r + 0.5) return 'slot escapes its own circle';
        for (var i = 0; i < p.children.length; i++) {
            var k: any = p.children[i];
            var d = Math.sqrt((k.x - p.x) * (k.x - p.x) + (k.y - p.y) * (k.y - p.y));
            if (!isFinite(d) || !isFinite(k.r)) return 'child ' + k.id + ' has non-finite geometry';
            if (d + k.r > p.r + 0.5) return 'child ' + k.id + ' escapes its parent';
            if (k.sr !== 0) return 'leaf ' + k.id + ' was given a slot';
            var dk = Math.sqrt((p.sx - k.x) * (p.sx - k.x) + (p.sy - k.y) * (p.sy - k.y));
            if (dk + 0.5 < p.sr + k.r) return 'slot overlaps child ' + k.id;
            for (var j = i + 1; j < p.children.length; j++) {
                var o: any = p.children[j];
                if (Math.sqrt((k.x - o.x) * (k.x - o.x) + (k.y - o.y) * (k.y - o.y)) + 0.5 < k.r + o.r) {
                    return 'siblings ' + k.id + '/' + o.id + ' overlap';
                }
            }
        }
        return null;
    });

    ceTest('pure', 'pack geometry: a single-child container is not a leaf', function() {
        // [MAP-SELF] THE CHECK THAT REPLACES SINGLE-CHILD-OFFSET. That branch existed
        // because n=1 packs concentric -- parent and child edge to edge, indistinguishable
        // from a leaf -- and it is deleted on the claim that the slot makes n=1 into n=2.
        // A claim that replaces a mechanism is a claim worth a check.
        var only: any = { id: 'only', children: [] };
        var box: any = { id: 'box', parent: null, children: [only] };
        only.parent = box;
        ceMapSumValues(box);
        var q: any = ceMapPackHierarchy(box, 1000, 4);
        if (!q || !q.children || !q.children.length) return 'pack returned nothing';
        var c: any = q.children[0];
        if (!(q.sr > 0)) return 'single-child container has no slot';
        if (!(c.r < q.r * 0.92)) return 'lone child fills its container edge to edge';
        var dc = Math.sqrt((c.x - q.x) * (c.x - q.x) + (c.y - q.y) * (c.y - q.y));
        if (!(dc > 0)) return 'lone child is concentric with its container';
        if (dc + c.r > q.r + 0.5) return 'lone child escapes its container';
        return null;
    });

    ceTest('pure', 'ceClockDayOf round-trips ceClockMonth', function() {
        // [F-2] THE ONE INVARIANT THE MONTH GRID RESTS ON: a tapped cell becomes an absolute
        // day through ceClockDayOf and is read back through ceClockMonth, and if the two
        // disagree the grid silently selects the wrong date. Walked across a year boundary and
        // across February, the two places a fixed month list goes wrong.
        var cal: any = ceCalendar(null);
        var abs = 0;
        for (abs = 0; abs < 800; abs++) {
            var mo: any = ceClockMonth(cal, abs * CE_MINS_DAY);
            if (!mo) return 'no month at abs ' + String(abs);
            var back = ceClockDayOf(cal, mo.year, mo.index, mo.dayOfMonth);
            if (back !== abs) return 'abs ' + String(abs) + ' round-tripped to ' + String(back);
        }
        return _tEq(ceClockDayOf(cal, 1, 1, 27), 58, 'Feb 28 of year 1')
            || _tEq(ceClockDayOf(cal, 1, 2, 0), 59, 'Mar 1 of year 1')
            || _tEq(ceClockDayOf(cal, 2, 0, 0), 365, 'Jan 1 of year 2')
            // A day past the end of a short month CLAMPS rather than spilling forward.
            || _tEq(ceClockDayOf(cal, 1, 1, 29), 58, 'Feb 30 clamps to Feb 28');
    });

    ceTest('pure', 'ceClockMonthStart finds the first of the month', function() {
        var cal: any = ceCalendar(null);
        return _tEq(ceClockMonthStart(cal, 58), 31, 'Feb 28 -> Feb 1')
            || _tEq(ceClockMonthStart(cal, 364), 334, 'Dec 31 -> Dec 1')
            || _tEq(ceClockMonthStart(cal, 365), 365, 'Jan 1 of year 2 is its own start')
            || _tEq(ceClockMonthStart(cal, 0), 0, 'day zero');
    });

    ceTest('pure', 'a monthless world has no grid to build', function() {
        // NOT a degradation to paper over -- with no months there is nothing to project a
        // grid onto, and both helpers say so rather than inventing a January.
        var cal: any = { dayNames: ['Sun'], months: [], bands: [] };
        return _tEq(ceClockDayOf(cal, 1, 0, 0), -1, 'no months -> -1')
            || _tEq(ceClockMonthStart(cal, 17), 17, 'no months -> absDay unchanged')
            || _tEq(ceClockMonth(cal, 17 * CE_MINS_DAY), null, 'no months -> null');
    });

    // -- READ (live storage, never written) ------------------------------------
    ceTest('read', 'BODY-META-STALE: currentLocationId matches the body', async function() {
        // THE CHECK THAT WOULD HAVE CAUGHT IT. A body moved without saveCharacter leaves
        // the index claiming the old room and nothing anywhere reports it.
        var idx: any[] = await loadIndex();
        var ents: any[] = await loadEntityIndex();
        var byId: any = {};
        var i = 0;
        for (i = 0; i < (ents || []).length; i++) { if (ents[i]) byId[String(ents[i].id)] = ents[i]; }
        var bad: string[] = [];
        for (i = 0; i < (idx || []).length; i++) {
            var m: any = idx[i];
            if (!m || !m.entityId) continue;
            var body: any = byId[String(m.entityId)];
            if (!body) { bad.push(String(m.name || m.id) + ': entityId points at nothing'); continue; }
            var want = String(body.parentId || '');
            var got = String(m.currentLocationId || '');
            if (want !== got) {
                bad.push(String(m.name || m.id) + ': meta=' + (got || 'nowhere') + ' body=' + (want || 'nowhere'));
            }
        }
        return bad.length ? (bad.length + ' stale: ' + bad.slice(0, 4).join('; ')) : null;
    });

    ceTest('read', 'no cycles in the world graph', async function() {
        var ents: any[] = await loadEntityIndex();
        var byId: any = {};
        var i = 0;
        for (i = 0; i < (ents || []).length; i++) { if (ents[i]) byId[String(ents[i].id)] = ents[i]; }
        for (i = 0; i < (ents || []).length; i++) {
            if (!ents[i]) continue;
            var cur = String(ents[i].id);
            var seen: any = {}; var guard = 0;
            while (cur && guard++ < 1000) {
                if (seen[cur]) return 'cycle through ' + String(ents[i].name || ents[i].id);
                seen[cur] = 1;
                var p: any = byId[cur];
                cur = p ? String(p.parentId || '') : '';
            }
        }
        return null;
    });

    ceTest('read', 'every picker def is complete', function() {
        // A def missing `commit` looks fine until someone taps a row.
        var bad: string[] = [];
        var k: string;
        for (k in CE_PICKER_DEFS) {
            var d: any = CE_PICKER_DEFS[k];
            if (typeof d.options !== 'function') bad.push(k + '.options');
            if (typeof d.commit !== 'function') bad.push(k + '.commit');
            if (d.group != null && typeof d.group !== 'function') bad.push(k + '.group is not a function');
            if (d.searchMin != null && typeof d.searchMin !== 'number') bad.push(k + '.searchMin is not a number');
        }
        return bad.length ? ('incomplete: ' + bad.join(', ')) : null;
    });

    // [PANEL-PICK-BLANK] THE TEST THAT WOULD HAVE CAUGHT THE BLANK PICKER. Every store
    // _cePickerSurface subscribes to must be non-null BEFORE it renders: useStoreValue(null)
    // throws, and a throw during render empties the surface silently -- no rows, no hint, no
    // Cancel, indistinguishable from "the def has no options".
    // THIS LIST IS THE SUBSCRIPTION LIST AND MUST BE EXTENDED WITH IT. Duplicated knowledge,
    // accepted: the alternative is the picker guarding each read, and a picker that degrades
    // quietly past a missing store shows a short list and says nothing about why.
    ceTest('read', 'PANEL-PICK: every store the picker subscribes to exists', function() {
        var pkMissing: string[] = [];
        if (!ceProfileStore) pkMissing.push('ceProfileStore');
        if (!ceEntityStore) pkMissing.push('ceEntityStore');
        if (!ceWizStore) pkMissing.push('ceWizStore');
        if (!ceChatStore) pkMissing.push('ceChatStore');
        if (!ceActionsStore) pkMissing.push('ceActionsStore');
        return pkMissing.length
            ? ('_cePickerSurface would throw on: ' + pkMissing.join(', ')
               + ' — check its *StoreInit calls; a missing one renders a blank picker with no Cancel')
            : null;
    });

    // [PANEL-SUBSTRATE] Split out of the store check below: registerEngineUI initialises these
    // at startup so the Actions scriptPanel's controls work, so reporting them under "open the
    // shell first" would describe a healthy story wrongly AND hide the failure this exists to
    // catch -- a missing ceUiStore makes ceAction drop every control on every surface silently.
    ceTest('read', 'PANEL-SUBSTRATE: the kit substrate is initialised at startup', function() {
        var subMissing: string[] = [];
        if (!ceUiStore) subMissing.push('ceUiStore');
        if (!ceSceneStore) subMissing.push('ceSceneStore');
        if (!ceActionsStore) subMissing.push('ceActionsStore');
        return subMissing.length
            ? ('registerEngineUI did not initialise: ' + subMissing.join(', ')
               + ' — every control routed through ceAction is inert until it does')
            : null;
    });

    ceTest('read', 'STORE-BEFORE-HOOK: every store is initialised', function() {
        // A store left out of ceOpenShell's init list renders its surface BLANK, no error.
        var missing: string[] = [];
        if (!ceProfileStore) missing.push('ceProfileStore');
        if (!ceJournalStore) missing.push('ceJournalStore');
        if (!ceImgSlotStore) missing.push('ceImgSlotStore');
        if (!ceMapStore) missing.push('ceMapStore');
        if (!ceChatStore) missing.push('ceChatStore');
        if (!ceSettingsStore) missing.push('ceSettingsStore');
        if (!ceImagesStore) missing.push('ceImagesStore');
        if (!ceEntityStore) missing.push('ceEntityStore');
        if (!ceWizStore) missing.push('ceWizStore');
        // ceUiStore / ceSceneStore / ceActionsStore are NOT in this list -- they are
        // startup-initialised and have their own check directly above.
        return missing.length ? ('not initialised (open the shell first): ' + missing.join(', ')) : null;
    });

    ceTest('read', 'every tray route has an icon', function() {
        // An invented iconId renders a broken native toolbar button and nothing says so.
        var bad: string[] = [];
        for (var i = 0; i < CE_SHELL_ROUTES.length; i++) {
            var r: any = CE_SHELL_ROUTES[i];
            if (!r.id) { bad.push('route ' + i + ' has no id'); continue; }
            if (r.tray !== false && !r.icon) bad.push(r.id + ' is on the tray with no icon');
        }
        return bad.length ? bad.join('; ') : null;
    });

    ceTest('read', 'cast-lore exclusions still name real records', async function() {
        // Not fatal -- a deleted character stops being excluded from a list it is not on.
        // Reported because an exclusion list that only ever grows is a slow leak.
        var idx: any[] = await loadIndex();
        var have: any = {};
        var i = 0;
        for (i = 0; i < (idx || []).length; i++) { if (idx[i]) have[String(idx[i].id)] = 1; }
        var cl: any = await loadCastLore();
        var bad: string[] = [];
        for (i = 0; i < (cl.castExclude || []).length; i++) {
            if (!have[String(cl.castExclude[i])]) bad.push(String(cl.castExclude[i]));
        }
        return bad.length ? (bad.length + ' dangling exclusion(s): ' + bad.slice(0, 3).join(', ')) : null;
    });
}

// Sequential, not Promise.all: a failing check should not have its output interleaved with
// four others, and nothing here is slow enough for the concurrency to be worth that.
async function runSelfTest(group?: string): Promise<string> {
    _ceRegisterTests();
    var want = String(group || 'all').toLowerCase();
    var out: string[] = [];
    var pass = 0, fail = 0, skip = 0;
    for (var i = 0; i < CE_TESTS.length; i++) {
        var t: any = CE_TESTS[i];
        if (want !== 'all' && t.group !== want) { skip++; continue; }
        var res: any = null;
        try { res = await t.fn(); }
        catch (e) { res = 'THREW: ' + ((e && (e as any).message) || String(e)); }
        if (res === null || res === undefined) { pass++; }
        else { fail++; out.push('  FAIL [' + t.group + '] ' + t.name + '\n         ' + String(res)); }
    }
    var head = 'selftest: ' + pass + ' passed, ' + fail + ' failed'
             + (skip ? (', ' + skip + ' skipped') : '');
    return fail ? (head + '\n' + out.join('\n')) : (head + ' \u2014 all clear');
}


// ============================================================================
// SECTION 3j — CONTEXT CENSUS  [CTX-CENSUS]
// `/ce ctx` -- what reached the model this turn, per contributor, in real tokens. /ce budget
// measures the allowance; this measures the contents.
// CAPTURE, DO NOT RECOMPUTE. Every string reported is one the context hooks already hold:
// _ceCtxCapture keeps references at the end of onBeforeContextBuild's REAL pass, _ceCtxSeal adds
// the assembled totals in onContextBuilt. Neither tokenises -- encode is async and would become
// a per-turn cost. Tokenising happens once, on demand, when /ce ctx is typed.
// NOT ON THE DRY RUN, for a measured reason: the AE path returns at the dryRun guard BEFORE it
// builds anything, so capturing there would mean running the lorebook activation and the AN line
// builders (N character loads) on every costing pass to observe work the real pass already does.
// A TOKENISER EXISTS HERE: api.v1.tokenizer.encode, already wrapped as wizCountTokens with a
// chars/4 fallback. Every count is a real token count except the story-text row, marked (est)
// because its body is deliberately not retained. Do not add a second counter.
// THE PARTS TABLE IS AN ATTRIBUTION; THE ASSEMBLED TOTAL IS THE TRUTH. NAI does its own
// key-matched activation after this hook returns, so the per-part sum is only what we believe we
// contributed. The report prints the assembled figure beside it and the difference as
// 'unattributed' -- a large unattributed number is itself the finding.
// SESSION-ONLY, IN MEMORY, NO STORAGE KEY. A census from a story since switched away from is
// worthless; the next turn re-captures, and /ce ctx before any turn says so.
// ============================================================================

// One contributor. BAND IS THE PRICE, NOT THE SIZE: HIGH sits above everything and invalidates
// the whole tail when it moves, AN sits at the author-configured depth where churn is nearly
// free, TAIL is the story itself.
interface CeCtxPart {
    band: string;
    key: string;      // `/ce ctx <key>` dumps this one
    label: string;
    chars: number;
    hash: string;
    body: string;     // '' when not retained — see est
    est: boolean;     // true = no body, token figure is chars/4
}
interface CeCtxCapture {
    continuityId: string;
    model: string;
    mode: string;
    parts: CeCtxPart[];
    sealed: boolean;
    msgCount: number;
    msgChars: number;
    uncached: number;   // -1 = api.v1.script.countUncachedInputTokens unavailable
}
var _ceCtxCur: CeCtxCapture | null = null;
var _ceCtxPrev: CeCtxCapture | null = null;

// Empty contributors are dropped rather than listed at zero: an inactive Memory and an
// absent one are the same fact to the model, and a table of zeroes hides the real rows.
function _ceCtxPush(parts: CeCtxPart[], band: string, key: string, label: string, text: any, keepBody: boolean): void {
    var t = (typeof text === 'string') ? text : '';
    if (!t) return;
    parts.push({
        band: band, key: key, label: label,
        chars: t.length, hash: _ceDjb2(t),
        body: keepBody ? t : '', est: !keepBody
    });
}

// OURS WINS WHERE WE OVERRODE IT. params carries what NAI handed us; the return value
// carries what the model will actually read. Reporting params for a slot we replaced
// would measure the thing we discarded.
function _ceCtxCapture(params: any, result: any, mode: string): void {
    try {
        if (!params || params.dryRun) return;
        var res: any = result || {};
        var parts: CeCtxPart[] = [];
        var i = 0;

        var sys = (res.systemPrompt && typeof res.systemPrompt.content === 'string')
            ? res.systemPrompt.content
            : ((params.systemPrompt && params.systemPrompt.active !== false) ? String(params.systemPrompt.content || '') : '');
        _ceCtxPush(parts, 'HIGH', 'sys', 'system prompt', sys, true);

        var mem = (res.memory && typeof res.memory.content === 'string')
            ? res.memory.content
            : ((params.memory && params.memory.active !== false) ? String(params.memory.content || '') : '');
        _ceCtxPush(parts, 'HIGH', 'mem', 'memory', mem, true);

        // Index our own lorebook overrides first so the pass over params can prefer them,
        // then emit any override for an id params never listed — those still reach context.
        var ovr: any = {};
        var used: any = {};
        var mineArr: any[] = (res.lorebookEntries || []);
        for (i = 0; i < mineArr.length; i++) {
            if (mineArr[i] && mineArr[i][0]) ovr[String(mineArr[i][0])] = mineArr[i][1] || {};
        }
        var pl: any[] = (params.lorebookEntries || []);
        for (i = 0; i < pl.length; i++) {
            var row: any = pl[i];
            if (!row || !row[0]) continue;
            var lid = String(row[0]);
            var cur: any = row[1] || {};
            var mine: any = ovr[lid];
            var on = mine ? (mine.active !== false) : (cur.active === true);
            if (!on) continue;
            used[lid] = 1;
            var txt = (mine && typeof mine.content === 'string') ? mine.content : String(cur.content || '');
            _ceCtxPush(parts, 'HIGH', 'lb:' + lid, (mine ? 'lore*' : 'lore ') + ' ' + lid, txt, true);
        }
        var oid: string;
        for (oid in ovr) {
            if (used[oid]) continue;
            _ceCtxPush(parts, 'HIGH', 'lb:' + oid, 'lore* ' + oid, String((ovr[oid] || {}).content || ''), true);
        }
        var tmp: any[] = (res.temporaryLorebookEntries || []);
        for (i = 0; i < tmp.length; i++) {
            var te: any = tmp[i] || {};
            if (te.active === false) continue;
            _ceCtxPush(parts, 'HIGH', 'tmp:' + String(te.id || i), 'temp  ' + String(te.name || te.id || i), String(te.content || ''), true);
        }

        // THE AN IS SPLIT because it has two owners: one slot to NAI, two things to us, and
        // the engine half is the only half a patch here can shrink.
        var anFinal = (res.authorsNote && typeof res.authorsNote.content === 'string')
            ? res.authorsNote.content
            : ((params.authorsNote && params.authorsNote.active !== false) ? String(params.authorsNote.content || '') : '');
        // [AN-KEY-STABLE] ALWAYS THESE TWO KEYS, never a third. The first live run reported the
        // AN as NEW + NEW + GONE on the turn the engine block first appeared, because the key
        // silently changed from 'an' to 'an:user'/'an:ce' underneath the diff. A KEY THAT
        // DEPENDS ON CONTENT IS NOT A KEY.
        var anAt = anFinal.lastIndexOf(AE_AN_SENTINEL);
        var anUser = (anAt >= 0) ? anFinal.substring(0, anAt).replace(/\s+$/, '') : anFinal;
        var anOurs = (anAt >= 0) ? anFinal.substring(anAt) : '';
        _ceCtxPush(parts, 'AN', 'an:user', 'author\u2019s note (author\u2019s own)', anUser, true);
        _ceCtxPush(parts, 'AN', 'an:ce', 'author\u2019s note (engine block)', anOurs, true);

        // BODY NOT RETAINED, deliberately: it is the author's own document and the largest
        // thing here. Measured, not copied -- which is why its row is the one marked (est).
        var story = (res.storyText && typeof res.storyText.content === 'string')
            ? res.storyText.content
            : ((params.storyText && params.storyText.active !== false) ? String(params.storyText.content || '') : '');
        _ceCtxPush(parts, 'TAIL', 'story', 'story text', story, false);

        _ceCtxPrev = _ceCtxCur;
        _ceCtxCur = {
            continuityId: String(params.continuityId || ''),
            model: String(params.model || ''),
            mode: String(mode || 'story'),
            parts: parts, sealed: false, msgCount: 0, msgChars: 0, uncached: -1
        };
    } catch (eCtxCap) { aeLog('[AE:ctx] capture failed:', eCtxCap); }
}

// MATCHED ON continuityId so a yoink or probe generation cannot seal a story turn's capture with
// its own message array. Yoink never captures, so without the match its onContextBuilt pass
// would overwrite the last real turn's totals with the wizard prompt's.
function _ceCtxSeal(params: any): void {
    try {
        if (!params || params.dryRun) return;
        if (!_ceCtxCur || _ceCtxCur.sealed) return;
        var cid = String(params.continuityId || '');
        if (_ceCtxCur.continuityId && cid && _ceCtxCur.continuityId !== cid) return;
        var msgs: any[] = (params.messages || []);
        var n = 0; var i = 0;
        for (i = 0; i < msgs.length; i++) n += String((msgs[i] && msgs[i].content) || '').length;
        _ceCtxCur.msgCount = msgs.length;
        _ceCtxCur.msgChars = n;
        // UNVERIFIED WHETHER THIS IS THE CACHE THE STORY GENERATION IS BILLED AGAINST: the
        // typings scope it to the script's own input allowance. It moves when the prefix moves,
        // the only property /ce ctx stable needs. Do not read it as a billing figure.
        try {
            if (api.v1.script.countUncachedInputTokens) {
                _ceCtxCur.uncached = api.v1.script.countUncachedInputTokens(msgs as any);
            }
        } catch (eUnc) { _ceCtxCur.uncached = -1; }
        _ceCtxCur.sealed = true;
    } catch (eCtxSeal) { aeLog('[AE:ctx] seal failed:', eCtxSeal); }
}

// Lorebook ids are opaque in the hook payload; the display name costs one read and is
// only worth taking when a human is reading the table. Resolved here, not at capture.
async function _ceCtxLabel(part: CeCtxPart): Promise<string> {
    if (String(part.key || '').indexOf('lb:') !== 0) return part.label;
    var id = part.key.substring(3);
    var nm = '';
    try {
        var e: any = await api.v1.lorebook.entry(id);
        if (e) nm = String(e.displayName || '');
    } catch (eLbl) { nm = ''; }
    var mine = (part.label.indexOf('lore*') === 0) ? 'lore* ' : 'lore  ';
    return mine + (nm || id);
}

function _ceCtxPad(t: string, w: number): string {
    var out = String(t);
    while (out.length < w) out += ' ';
    return out;
}
function _ceCtxLpad(t: any, w: number): string {
    var out = String(t);
    while (out.length < w) out = ' ' + out;
    return out;
}

// Real tokens where a body was kept, chars/4 where it was not. One await per part, sequential
// rather than parallel -- an on-demand command, and the shape every generation-adjacent flow
// in this file uses.
async function _ceCtxTokens(part: CeCtxPart, model: string): Promise<number> {
    if (part.est) return Math.ceil(part.chars / 4);
    return await wizCountTokens(part.body, model);
}

async function _ceCtxTable(): Promise<string> {
    var c = _ceCtxCur as CeCtxCapture;
    var model = c.model || (await wizActiveModel());
    var out: string[] = [];
    var i = 0;
    var tok: number[] = [];
    var attributed = 0;
    var attribChars = 0;
    for (i = 0; i < c.parts.length; i++) {
        var t = await _ceCtxTokens(c.parts[i], model);
        tok.push(t);
        attributed += t;
        attribChars += c.parts[i].chars;
    }
    out.push('/ce ctx \u2014 ' + c.mode + ' turn, model ' + (model || '?')
        + (c.sealed ? '' : '  [UNSEALED \u2014 onContextBuilt did not run for this turn]'));
    out.push('band  ' + _ceCtxLpad('tokens', 7) + '  ' + _ceCtxLpad('share', 6) + '  contributor');
    var order = ['HIGH', 'AN', 'TAIL'];
    var b = 0;
    for (b = 0; b < order.length; b++) {
        for (i = 0; i < c.parts.length; i++) {
            if (c.parts[i].band !== order[b]) continue;
            var share = attributed ? ((100 * tok[i]) / attributed) : 0;
            out.push(_ceCtxPad(c.parts[i].band, 6)
                + _ceCtxLpad(tok[i], 7) + '  '
                + _ceCtxLpad(share.toFixed(1) + '%', 6) + '  '
                + (await _ceCtxLabel(c.parts[i]))
                + (c.parts[i].est ? '  (est)' : ''));
        }
    }
    out.push('\u2014\u2014');
    out.push('attributed   ' + attributed + ' tok / ' + attribChars + ' chars across ' + c.parts.length + ' parts');
    if (c.sealed) {
        // COMPARED IN CHARS, NOT TOKENS, and the pedantry is the point: attributed tokens are
        // real while an assembled token figure would be chars/4, so differencing them
        // manufactures a number out of two units. Both char counts are exact.
        out.push('assembled    ' + c.msgChars + ' chars in ' + c.msgCount + ' messages');
        out.push('unattributed ' + (c.msgChars - attribChars) + ' chars \u2014 NAI key-matched activations we did not force, plus chat-template overhead. Large and positive means something reaches context that this census cannot name.');
        // MEASURED: unavailable on the first live run. The symbol IS in script-types_d.txt and
        // is NOT on the runtime's api.v1.script -- typings ahead of build. Say which, so nobody
        // re-derives it: an absent instrument and a zero are not the same reading.
        out.push('uncached     ' + (c.uncached >= 0 ? (c.uncached + ' tok \u2014 the churn number, compare with /ce ctx stable')
            : 'unavailable \u2014 api.v1.script.countUncachedInputTokens is in the typings but not on this runtime. Use the per-part diff in /ce ctx stable instead.'));
    }
    out.push('keys: ' + c.parts.map(function(p) { return p.key; }).join(' '));
    out.push('/ce ctx <key> dumps one body \u00b7 /ce ctx stable diffs against the previous turn');
    return out.join('\n');
}

// THE COMMAND THE PHASE 3 AUDIT WAS ACTUALLY FOR. Which contributor moved, and how far
// down the invalidation reaches: everything at or below the FIRST changed HIGH part has
// to be re-encoded, so its index is the cost, not the number of changes.
async function _ceCtxStable(): Promise<string> {
    var c = _ceCtxCur as CeCtxCapture;
    if (!_ceCtxPrev) return '/ce ctx stable: only one turn captured so far. Generate another turn, then run this again.';
    var p = _ceCtxPrev as CeCtxCapture;
    var byKey: any = {};
    var i = 0;
    for (i = 0; i < p.parts.length; i++) byKey[p.parts[i].key] = p.parts[i];
    var out: string[] = ['/ce ctx stable \u2014 this turn vs the previous captured turn'];
    var firstMoved = -1;
    var highSeen = 0;
    var changed = 0;
    for (i = 0; i < c.parts.length; i++) {
        var np = c.parts[i];
        var op: any = byKey[np.key];
        var isHigh = (np.band === 'HIGH');
        if (isHigh) highSeen++;
        var state = '';
        if (!op) { state = 'NEW    '; }
        else if (op.hash !== np.hash) { state = 'CHANGED'; }
        else { state = 'same   '; }
        if (op) byKey[np.key] = null;
        if (state !== 'same   ') {
            changed++;
            if (isHigh && firstMoved < 0) firstMoved = highSeen;
        }
        out.push('  ' + state + '  ' + _ceCtxPad(np.band, 5) + '  ' + (await _ceCtxLabel(np))
            + (op && op.chars !== np.chars ? ('  ' + op.chars + ' \u2192 ' + np.chars + ' chars') : ''));
    }
    var k: string;
    for (k in byKey) {
        if (!byKey[k]) continue;
        changed++;
        out.push('  GONE     ' + _ceCtxPad(byKey[k].band, 5) + '  ' + (await _ceCtxLabel(byKey[k])));
    }
    out.push('\u2014\u2014');
    if (!changed) {
        out.push('high band is byte-identical \u2014 nothing re-encoded on our account this turn.');
    } else if (firstMoved < 0) {
        out.push(changed + ' contributor(s) moved, none of them HIGH \u2014 churn is at AN/TAIL depth, which is nearly free.');
    } else {
        out.push(changed + ' contributor(s) moved; first HIGH change is #' + firstMoved + ' of ' + highSeen
            + ' \u2014 that one and everything below it re-encodes.');
    }
    out.push('uncached: ' + (p.uncached >= 0 ? p.uncached : '?') + ' \u2192 ' + (c.uncached >= 0 ? c.uncached : '?') + ' tok');
    return out.join('\n');
}

function _ceCtxDump(key: string): string {
    var c = _ceCtxCur as CeCtxCapture;
    var want = String(key || '').toLowerCase();
    var i = 0;
    for (i = 0; i < c.parts.length; i++) {
        if (c.parts[i].key.toLowerCase() === want || c.parts[i].key.toLowerCase().indexOf(want) === 0) {
            var pt = c.parts[i];
            if (!pt.body) return pt.key + ': body not retained (' + pt.chars + ' chars). Story text is the author\u2019s own document \u2014 read it in the editor.';
            return pt.key + '  [' + pt.band + ', ' + pt.chars + ' chars]\n' + pt.body;
        }
    }
    return 'No captured contributor matching \u201c' + key + '\u201d. Keys: '
        + c.parts.map(function(pp) { return pp.key; }).join(' ');
}


// PREFIX-CACHE PROBE  [CACHE-PROBE]
// `/ce cache run` -- DOES THIS RUNTIME CACHE PREFIXES, AND AT WHAT GRANULARITY?
// THIS EXISTS BECAUSE THE ANSWER WAS ASSUMED AND SHOULD NOT HAVE BEEN. Reordering every
// auto-generation prompt to [story] -> [character] -> [task] is worth nothing unless the backend
// rewards a SHARED PREFIX across separate calls -- a property of NAI's serving stack, stated
// nowhere in script-types.txt. countUncachedInputTokens would have answered it directly and is
// in the typings but NOT on this runtime (measured). So: measure it.
// FOUR CALLS, ONE VARIABLE AT A TIME, budget sampled with getAllowedInput() either side:
//   A1  prefix P + tail S1   cold reference -- P carries a per-run nonce
//   A2  prefix P + tail S1   byte-identical repeat        -> tests EXACT-MATCH caching
//   A3  prefix P + tail S2   same prefix, different tail  -> tests PREFIX caching
//   B1  prefix Q + tail S2   different prefix             -> control, must stay full
// READ IT LIKE THIS, decided here rather than after seeing the numbers:
//   A2 and A3 well under A1, B1 near A1  -> prefix caching is real; the reorder is worth it.
//   A2 under A1 but A3 near A1           -> exact-match only; a shared prefix buys NOTHING.
//   all four within noise                -> no cache visible through the budget, so the reorder
//                                           does not ship on faith.
// COSTS REAL BUDGET (~4 x 1.3k input), which is why bare `/ce cache` prints this and refuses.

// Deterministic filler with a caller-supplied seed. Word-shaped so it tokenises at a normal
// ratio, and reproducible so one seed gives the same prefix twice -- the mechanism A2 and A3
// depend on.
function _ceCacheFiller(seed: string, words: number): string {
    var vocab = ['harbor', 'lantern', 'quiet', 'thread', 'copper', 'winter', 'signal',
        'marrow', 'gutter', 'anvil', 'plume', 'shale', 'verdict', 'tallow', 'orbit',
        'rasp', 'cinder', 'fathom', 'brine', 'lattice'];
    var h = 0; var i = 0; var out: string[] = [];
    var sd = String(seed);
    for (i = 0; i < sd.length; i++) h = (((h << 5) - h) + sd.charCodeAt(i)) | 0;
    for (i = 0; i < words; i++) {
        h = (h * 1103515245 + 12345) | 0;
        out.push(vocab[Math.abs(h) % vocab.length]);
        if (i % 12 === 11) out.push('\n');
    }
    return out.join(' ');
}

async function _ceCacheProbe(): Promise<string> {
    var model = await wizActiveModel();
    // NONCE MAKES A1 GENUINELY COLD: without it a second run finds its own prefix already warm
    // and reports caching as absent-then-present at random. roll() returns a RESULT OBJECT, so
    // String()-ing it yields a constant, which is not a nonce -- .total is the number.
    var nonce = _ceDjb2(String(Date.now()) + ':' + String(api.v1.random.roll('1d1000000').total));
    var P = 'Reference material, set ' + nonce + ':\n' + _ceCacheFiller('P' + nonce, 900);
    var Q = 'Reference material, set ' + nonce + 'q:\n' + _ceCacheFiller('Q' + nonce, 900);
    var S1 = '\n\nAnswer with the single word: alpha';
    var S2 = '\n\nAnswer with the single word: beta';
    var params: any = { model: model, max_tokens: 8, temperature: 0 };

    var runs = [
        { tag: 'A1', label: 'prefix P + tail S1  (cold reference)', body: P + S1 },
        { tag: 'A2', label: 'prefix P + tail S1  (identical repeat)', body: P + S1 },
        { tag: 'A3', label: 'prefix P + tail S2  (same prefix, new tail)', body: P + S2 },
        { tag: 'B1', label: 'prefix Q + tail S2  (different prefix, control)', body: Q + S2 }
    ];
    var deltas: number[] = [];
    var out: string[] = ['/ce cache run \u2014 prefix-cache probe, model ' + (model || '?')];
    var pTok = await wizCountTokens(P + S1, model);
    out.push('payload ~' + pTok + ' tok per call, 4 calls, sequential');
    var i = 0;
    for (i = 0; i < runs.length; i++) {
        var b0 = diagBudI();
        var t0 = Date.now();
        var err = '';
        try {
            // SEQUENTIAL AND AWAITED, never Promise.all: the whole measurement is a
            // before/after budget read, and overlapping calls would interleave the samples.
            await aeDiagGenerate('cacheprobe:' + runs[i].tag,
                [{ role: 'user', content: runs[i].body }], params, undefined, 'background');
        } catch (eCp) { err = ' [call failed: ' + ((eCp && (eCp as any).message) || String(eCp)) + ']'; }
        var b1 = diagBudI();
        var d = (b0 >= 0 && b1 >= 0) ? (b0 - b1) : -1;
        deltas.push(d);
        out.push('  ' + runs[i].tag + '  ' + _ceCtxPad(runs[i].label, 46)
            + 'billed ' + _ceCtxLpad(d >= 0 ? String(d) : '?', 6) + ' tok'
            + '  (' + (Date.now() - t0) + 'ms)' + err);
    }

    out.push('\u2014\u2014');
    if (deltas[0] < 0) {
        out.push('getAllowedInput() returned -1 \u2014 no input budget counter on this runtime. '
            + 'This probe cannot answer the question here, and neither can anything else we have. '
            + 'Do NOT reorder the auto-generation prompts for caching reasons.');
        return out.join('\n');
    }
    // BUDGET REPLENISHES WITH TIME, so a delta is a lower bound on what was billed and every
    // reading is biased the same direction. The 25% threshold is a deliberate margin over
    // that drift rather than a claim about the backend.
    var a1 = deltas[0], a2 = deltas[1], a3 = deltas[2], b1v = deltas[3];
    var lowA2 = a1 > 0 && a2 < a1 * 0.75;
    var lowA3 = a1 > 0 && a3 < a1 * 0.75;
    var fullB = a1 > 0 && b1v > a1 * 0.75;
    if (lowA2 && lowA3 && fullB) {
        out.push('VERDICT: prefix caching is real. A shared prefix across separate calls is '
            + 'rewarded, so reordering the auto-generation prompts to put the story block first '
            + 'saves roughly (calls-1) x prefix tokens per dynamic pass. Worth building.');
    } else if (lowA2 && !lowA3) {
        out.push('VERDICT: exact-match caching only \u2014 A2 was cheap, A3 was not. A shared prefix '
            + 'with a differing tail buys NOTHING. Do not reorder for caching; the reorder would '
            + 'only be worth doing on steering grounds, which is a separate question and a '
            + 'separate test.');
    } else if (!lowA2 && !lowA3) {
        out.push('VERDICT: no caching visible through the input budget. Either the backend does '
            + 'not cache, or the budget does not reflect it. Both mean the same thing for us: '
            + 'the reorder is unmeasurable here and must not ship on the caching argument.');
    } else {
        out.push('VERDICT: mixed / inconclusive (A1=' + a1 + ' A2=' + a2 + ' A3=' + a3 + ' B1=' + b1v + '). '
            + 'Replenishment drift or a failed call can produce this. Re-run once before reading anything into it.');
    }
    out.push('Reminder: this measures NAI\u2019s serving stack, not the model. It says nothing '
        + 'about whether the reorder helps or hurts output quality \u2014 that needs its own test.');
    return out.join('\n');
}


// STORY-CACHE PROBE  [CACHE-STORY]
// `/ce cache story run` -- DOES generateWithStory RIDE THE STORY TURN'S OWN CACHE?
// WHAT IS PROVEN AND WHAT IS NOT: /ce cache run established SCRIPT-TO-SCRIPT prefix caching (the
// second of two calls sharing a prefix billed ~1%). It did NOT establish that a STORY turn's
// context populates a cache the script can hit. Those are different producers, and the whole
// value of generateWithStory rests on the second being true.
// WHY IT MATTERS: generateWithStory builds the real story context and appends our messages. If
// that hits the cache the author's own turn just filled, an ephemeral costs its tail rather than
// a private 2500-token block, AND it sees the full context rather than an excerpt.
// COSTS UP TO ~18k INPUT IF IT MISSES, hence the explicit `run`. RUN IT IMMEDIATELY AFTER A
// STORY TURN: any generation in between moves the cache on and S1 reads as a miss for the wrong
// reason.
//   S1  first call after a story turn  -> did the STORY turn's context populate our cache?
//   S2  second call, different tail    -> does generateWithStory cache SCRIPT-to-SCRIPT?
// READING, committed before the numbers exist:
//   S1 small            -> rides the story turn's cache; replace the block with generateWithStory
//   S1 large, S2 small  -> script-scoped only, paying full once per pass. At ~9k vs the block's
//                          ~2.5k that is worse, so keep the block.
//   both large          -> no caching through this path. Keep the block.
async function _ceCacheStoryProbe(): Promise<string> {
    var model = await wizActiveModel();
    var params: any = { model: model, max_tokens: 6, temperature: 0 };
    // SUPPRESS OUR OWN HOOKS: buildContext would otherwise re-enter onBeforeContextBuild while a
    // generation is in flight. This makes the built context differ from the story turn's from
    // the first lorebook override onward, so a PARTIAL hit is the expected best case here.
    var opts: any = { suppressScriptHooks: 'self' };
    var tails = ['Reply with the single word: alpha', 'Reply with the single word: beta'];
    var out: string[] = ['/ce cache story run \u2014 story-cache probe, model ' + (model || '?')];
    var deltas: number[] = [];
    var i = 0;
    for (i = 0; i < tails.length; i++) {
        var b0 = diagBudI();
        var t0 = Date.now();
        var err = '';
        var prev = _diagProbeActive;
        _diagProbeActive = true;
        try {
            await api.v1.generateWithStory([{ role: 'user', content: tails[i] }], params, opts,
                undefined, 'background');
        } catch (eSp) { err = ' [failed: ' + ((eSp && (eSp as any).message) || String(eSp)) + ']'; }
        _diagProbeActive = prev;
        var b1 = diagBudI();
        var d = (b0 >= 0 && b1 >= 0) ? (b0 - b1) : -1;
        deltas.push(d);
        out.push('  S' + (i + 1) + '  ' + (i === 0 ? 'first call after the story turn ' : 'second call, different tail    ')
            + '  billed ' + _ceCtxLpad(d >= 0 ? String(d) : '?', 6) + ' tok  (' + (Date.now() - t0) + 'ms)' + err);
    }
    // THE YARDSTICK IS THE LAST CENSUS, not a guess: /ce ctx already measured what the story
    // turn actually assembled, so the comparison is against a real number from this story.
    var asmChars = (_ceCtxCur && _ceCtxCur.sealed) ? _ceCtxCur.msgChars : 0;
    var asmEst = asmChars ? Math.ceil(asmChars / 4) : 0;
    out.push('\u2014\u2014');
    out.push(asmEst
        ? ('story context for comparison: ~' + asmEst + ' tok (' + asmChars + ' chars, from the last /ce ctx capture)')
        : 'no sealed /ce ctx capture to compare against \u2014 take a story turn first, then run /ce ctx, then this.');
    if (deltas[0] < 0) {
        out.push('getAllowedInput() unavailable \u2014 this probe cannot answer the question here.');
        return out.join('\n');
    }
    var big = asmEst ? (asmEst * 0.5) : 3000;
    if (deltas[0] < big * 0.2) {
        out.push('VERDICT: S1 was cheap \u2014 generateWithStory HITS the story turn\u2019s cache. '
            + 'Move the auto-generations onto it: they would cost their tail instead of a private '
            + '2500-token block, and would see the whole story context instead of an excerpt. '
            + 'The v3.0.51 story block becomes the fallback path and the CharChat pattern.');
    } else if (deltas[1] < big * 0.2) {
        out.push('VERDICT: script-to-script only \u2014 S1 paid full, S2 was cheap. generateWithStory '
            + 'costs one full story context per pass. At ~' + (asmEst || '?') + ' tok against the '
            + 'block\u2019s ~2500, that is worse. KEEP the v3.0.51 story block.');
    } else {
        out.push('VERDICT: no caching visible through generateWithStory. KEEP the v3.0.51 story block. '
            + 'Worth one re-run before believing it \u2014 a dynamic pass firing between the story turn '
            + 'and S1 produces exactly this reading for an unrelated reason.');
    }
    return out.join('\n');
}


// PASS COST REPORT  [BILLED-IN]
// `/ce cost` -- what the auto-generations actually billed, per call, newest first.
// THE INSTRUMENT THAT VERIFIES THE STORY BLOCK, AND NOTHING ELSE DOES. The block shipped on a
// synthetic probe plus an argument; this reads the real thing, getAllowedInput() sampled either
// side of every generator call, which the docs define as an UNCACHED-token allowance.
// WHAT SUCCESS LOOKS LIKE, in a pass with two or more generators:
//   first call of a pass    small (tens to low hundreds) once the block is built and the scene
//                           has not changed -- only the new story beat is uncached
//   later calls of a pass   ~tens. Same block, same prefix, only the tail differs.
//   first call after a      ~2500, a full re-anchor. Expected, once per scene.
//   scene change or reload
// FAILURE is any steady-state call billing four figures: the block's front is moving turn to
// turn and the front-anchoring is not doing its job.
function _ceCostReport(): string {
    if (!_diagGenLog.length) return '/ce cost: no generation calls logged this session yet.';
    var rows = _diagGenLog.slice().reverse().slice(0, 14);
    var out: string[] = ['/ce cost \u2014 billed input per generator call, newest first'];
    var i = 0;
    var known = 0;
    var total = 0;
    for (i = 0; i < rows.length; i++) {
        var e = rows[i];
        out.push('  ' + _ceCtxPad(String(e.tag), 34)
            + _ceCtxLpad(e.billedIn >= 0 ? String(e.billedIn) : '?', 7) + ' tok'
            + '  ' + _ceCtxLpad(e.ms + 'ms', 7)
            + (e.outcome !== 'ok' ? ('  ' + e.outcome) : ''));
        if (e.billedIn >= 0) { known++; total += e.billedIn; }
    }
    out.push('\u2014\u2014');
    out.push(known ? (known + ' calls measured, ' + total + ' tok total, ' + Math.round(total / known) + ' tok mean')
                   : 'no call had a usable budget sample \u2014 getAllowedInput() unavailable.');
    out.push('story block: ' + (_ceSBText ? (_ceSBText.length + ' chars, anchored at ' + (_ceSBAnchor || '?')) : 'not built yet'));
    out.push('Expect tens per call in steady state; ~2500 once after a scene change or reload.');
    return out.join('\n');
}

async function _ceCtxReport(arg: string): Promise<string> {
    try {
        if (!_ceCtxCur) {
            return '/ce ctx: nothing captured yet. Take one story turn (or one chat turn), then run this again.\n'
                 + 'The census is session-only and in memory \u2014 a script reload clears it.';
        }
        var a = String(arg || '').toLowerCase();
        if (a === 'stable') return await _ceCtxStable();
        if (a && a !== 'cost' && a !== 'all') return _ceCtxDump(a);
        return await _ceCtxTable();
    } catch (eCtxRep) {
        return '/ce ctx failed: ' + ((eCtxRep && (eCtxRep as any).message) || String(eCtxRep));
    }
}


// ============================================================================
// SECTION 4 — UTILITY FUNCTIONS
// Pure helpers and factory functions with no side effects.
// These are called throughout the script and must be defined before first use.
// ============================================================================


// ── ID Generation ─────────────────────────────────────────────────────────────

// djb2 over a string, base36. ONE HASH, TWO CONSUMERS: _ceGuideKey (SECTION 28) derives
// a session UI key from instruction text; _ceCtxPush (SECTION 3j) fingerprints a context
// contributor so /ce ctx stable can say which one moved. Neither is a checksum and
// neither leaves the session -- collisions cost an accordion state or a false 'SAME'
// line in a diagnostic, not correctness. Do not write a third copy.
function _ceDjb2(text: string): string {
    var s = String(text || ''); var hh = 5381; var i = 0;
    for (i = 0; i < s.length; i++) { hh = (((hh << 5) + hh) + s.charCodeAt(i)) | 0; }
    return (hh >>> 0).toString(36);
}

function generateId(): string {
    // Generates a collision-resistant ID from timestamp + random suffix.
    // Used for all new records (characters, entities, rules, milestones, etc.).
    return Date.now().toString(36) + Math.random().toString(36).substring(2);
}

// [PICKER-ONE] aeIconPfx WAS HERE AND IS DELETED. It existed to keep bare
// icon-library NAMES out of NATIVE UIPart button labels, and its only two call sites were
// inside openPickerModal, which this patch deletes. The jsx surfaces never needed it:
// ceIconIsSvg / ceIconSvg resolve a library key to a real glyph rather than printing it,
// which is the same problem solved properly one layer down. Nothing else called it --
// verified by grep, not assumed.

// ── World-Build Wizard: assemble + commit the Memory block ───────────────────
// [vNEXT] Assembles enabled, non-blank, memory-targeted sections into the static
// Memory block ("[ Label ]\n<content>", blank-separated) and returns it. Style and
// any other 'an'-targeted sections are NOT included here — they commit separately.
function assembleWizardMemory(sections: WizardMemorySection[]): string {
    let blocks: string[] = [];
    for (let s of (sections || [])) {
        if (!s || s.target !== 'memory') continue;
        if (!s.enabled) continue;
        let body = (s.content || '').trim();
        if (!body) continue;
        blocks.push('[ ' + s.label + ' ]\n' + body);
    }
    return blocks.join('\n\n');
}

// [vNEXT] Assembles 'an'-targeted sections (e.g. Style) into an Author's Note body.
function assembleWizardAuthorNote(sections: WizardMemorySection[]): string {
    let blocks: string[] = [];
    for (let s of (sections || [])) {
        if (!s || s.target !== 'an') continue;
        if (!s.enabled) continue;
        let body = (s.content || '').trim();
        if (!body) continue;
        // [WIZARD-2] If the body is already a complete bracketed AN block
        // (e.g. a generated ATTG line "[ Author: ...; Genre: ... ]"), emit it verbatim;
        // otherwise wrap it as a labelled "[ Label: body ]" block (the Style default).
        if (body.charAt(0) === '[' && body.charAt(body.length - 1) === ']') {
            blocks.push(body);
        } else {
            blocks.push('[ ' + s.label + ': ' + body + ' ]');
        }
    }
    return blocks.join('\n\n');
}

// [earlier AN-FIX] Commits the assembled wizard sections to the real NAI surfaces.
// Memory sections OVERWRITE the Memory field (static world canon — stable, written once).
// AN sections (Style, etc.) are written into a NAMED REGION of the Author's Note using
// AE_WIZ_AN_SENTINEL so they coexist with the scene-state block injected at generation
// time by onBeforeContextBuild. The scene block is NEVER stored in the persisted AN —
// it is appended ephemerally per-generation. The wizard region always sits FIRST in the
// persisted AN; the scene block is appended AFTER it at generation time so it has the
// highest recency weight in the AN slot.
async function commitWizardMemory(cfg: GlobalConfig): Promise<boolean> {
    try {
        let mem = assembleWizardMemory(cfg.wizardSections || []);
        await api.v1.memory.set(mem);

        let wizAN = assembleWizardAuthorNote(cfg.wizardSections || []);

        // Read the current persisted AN and strip both managed regions before rewriting.
        // Safe to call repeatedly (idempotent). Strip scene sentinel first (defensive),
        // then strip any prior wizard region.
        let existingAN = '';
        try { existingAN = (await api.v1.an.get()) || ''; } catch (_eRead) {}

        // Strip stale scene block (defensive — should never be persisted).
        let sceneMarker = '\n\n' + AE_AN_SENTINEL;
        let sceneIdx = existingAN.lastIndexOf(sceneMarker);
        if (sceneIdx >= 0) {
            existingAN = existingAN.substring(0, sceneIdx);
        } else if (existingAN.indexOf(AE_AN_SENTINEL) === 0) {
            existingAN = '';
        }
        existingAN = existingAN.replace(/\s+$/, '');

        // Strip any prior wizard region.
        let wizMarker = '\n\n' + AE_WIZ_AN_SENTINEL;
        let wizIdx = existingAN.lastIndexOf(wizMarker);
        if (wizIdx >= 0) {
            existingAN = existingAN.substring(0, wizIdx);
        } else if (existingAN.indexOf(AE_WIZ_AN_SENTINEL) === 0) {
            existingAN = '';
        }
        existingAN = existingAN.replace(/\s+$/, '');

        // Re-assemble: any non-AE base content + wizard region (if any AN sections enabled).
        let finalAN: string;
        if (wizAN.trim()) {
            let wizRegion = AE_WIZ_AN_SENTINEL + '\n' + wizAN.trim();
            finalAN = existingAN ? (existingAN + '\n\n' + wizRegion) : wizRegion;
        } else {
            finalAN = existingAN;
        }

        await api.v1.an.set(finalAN);
        return true;
    } catch (e) {
        api.v1.error('[AE:wizard] commitWizardMemory error:', e);
        return false;
    }
}

// ── World-Build Wizard: context assembly ─────────────────────────────────────
// [vNEXT] Builds the read-only context preamble for a wizard chat from its selected
// sources: project concept fields, other wizard chats, lorebook entries, and recent
// story text. Each source is clearly delimited so the model treats it as reference.
// ── World-Build Wizard: token budget + transcript distillation (earlier) ─────
// Until now buildWizardContext concatenated every linked chat's FULL raw transcript with
// no cap of any kind. That is invisible on a 28k-context account and fatal on a 12k one:
// a few long brainstorm chats linked as context sources can exceed the whole window, and
// NAI's handling of an oversized messages[] override is undocumented. Since almost every
// yoink call is [system, user] with ALL formatting rules living in the system message,
// losing the front of that array would strip the rules and produce exactly the
// ungoverned, malformed output this subsystem has been chasing.
//
// Two defences, applied together:
//   1. DISTILL — a linked chat contributes settled facts, not its deliberation. Cached on
//      the chat record; regenerated only when the chat grows.
//   2. CAP — measure the assembled blocks with the real tokenizer against the account's
//      real ceiling (api.v1.maxTokens is subscription-tier aware, so no tier is hardcoded)
//      and drop whole low-priority blocks until it fits.

// Reserve for the persona + format rules that ride in the system message alongside ctx.
var AE_CTX_RESERVE_INSTRUCTIONS = 2000;
// Reserve for the model's own output.
var AE_CTX_RESERVE_OUTPUT = 1200;
// Never hand back a budget smaller than this; below it, context is useless anyway.
var AE_CTX_MIN_BUDGET = 800;
// Chats shorter than this stay raw: distilling 3 messages costs a generation and saves
// nothing, and a short exchange is already close to "just the facts".
var AE_DISTILL_MIN_MESSAGES = 6;

// Which model's tokenizer/ceiling applies. editor.generate() runs on the story's live
// model, so ask generationParameters rather than assuming.
async function wizActiveModel(): Promise<string> {
    try {
        let gp = await api.v1.generationParameters.get();
        if (gp && gp.model) return String(gp.model);
    } catch (eModel) { aeLog('[AE:wizard] could not read active model, assuming glm-4-6:', eModel); }
    return 'glm-4-6';
}

// Real token count, with a coarse chars/4 fallback if the tokenizer is unavailable.
async function wizCountTokens(text: string, model: string): Promise<number> {
    let t = String(text || '');
    if (!t) return 0;
    try {
        let ids = await api.v1.tokenizer.encode(t, model);
        if (ids && typeof ids.length === 'number') return ids.length;
    } catch (eTok) { aeLog('[AE:wizard] tokenizer.encode failed, estimating:', eTok); }
    return Math.ceil(t.length / 4);
}

// Context tokens available for reference material, after instructions, output, and (for a
// live chat turn) the transcript that will be replayed alongside it.
async function wizContextBudget(model: string, ownMessagesTokens: number): Promise<number> {
    let ceiling = 0;
    try { ceiling = await api.v1.maxTokens(model); }
    catch (eMax) { aeLog('[AE:wizard] maxTokens unavailable, skipping context cap:', eMax); return 0; }
    if (!ceiling || ceiling <= 0) return 0;
    let budget = ceiling - AE_CTX_RESERVE_INSTRUCTIONS - AE_CTX_RESERVE_OUTPUT - (ownMessagesTokens || 0);
    if (budget < AE_CTX_MIN_BUDGET) budget = AE_CTX_MIN_BUDGET;
    return budget;
}

// A context block with a drop priority. Higher survives longer.
interface WizCtxBlock {
    text: string;
    priority: number;
    label: string;
}

// Trim whole blocks (never mid-block) until the total fits the budget. Drops
// the LOWEST priority first, and among equal priorities the LAST added first, so the
// project header and the earliest-linked chats survive longest. A budget of 0 means the
// ceiling could not be determined — in that case nothing is trimmed, matching earlier
// behaviour rather than guessing.
async function wizTrimBlocksToBudget(blocks: WizCtxBlock[], budget: number, model: string): Promise<{ kept: WizCtxBlock[]; dropped: string[]; tokens: number }> {
    let kept = blocks.slice();
    let dropped: string[] = [];
    if (!budget || budget <= 0) {
        let rawTotal = 0;
        for (let b of kept) rawTotal += await wizCountTokens(b.text, model);
        return { kept: kept, dropped: dropped, tokens: rawTotal };
    }

    let counts: number[] = [];
    for (let b of kept) counts.push(await wizCountTokens(b.text, model));
    let total = 0;
    for (let n of counts) total += n;

    while (total > budget && kept.length > 0) {
        // Find the drop candidate: lowest priority, latest index among ties.
        let victim = -1;
        for (let i = 0; i < kept.length; i++) {
            if (victim < 0) { victim = i; continue; }
            if (kept[i].priority < kept[victim].priority) victim = i;
            else if (kept[i].priority === kept[victim].priority) victim = i;
        }
        if (victim < 0) break;
        // The project header is priority 100 and must never be the last thing standing
        // that gets dropped; if only it remains, stop and accept the overage.
        if (kept.length === 1 || kept[victim].priority >= 100) break;
        total -= counts[victim];
        dropped.push(kept[victim].label);
        kept.splice(victim, 1);
        counts.splice(victim, 1);
    }

    return { kept: kept, dropped: dropped, tokens: total };
}

// [DISTILL] Turn a chat transcript into declarative world facts. Reframed rather
// than merely constrained: the model is recording current world state, not summarizing a
// conversation. The contrastive pair targets SURFACE FORM (how a sentence is phrased),
// which is safe to name explicitly — unlike naming unwanted story CONCEPTS, which risks
// priming them. Abandoned ideas are simply absent from the output.
var AE_DISTILL_SYSTEM = [
    'You are recording the current state of a story world as established so far. You are not summarizing a conversation.',
    'Write only settled facts, in the present tense, as plain declarative prose. State each fact as though it has always been true of this world.',
    'Where a point was revised, record only the version that stands now.',
    'WRONG: "After some back-and-forth, they settled on a near-future dystopia."',
    'RIGHT: "The setting is a near-future dystopia where the water supply is privately owned."',
    'WRONG: "One idea raised was a rival guild, though it was set aside."',
    'RIGHT: (omit it entirely)',
    'Preserve every proper name, number, and concrete detail that still stands. Write in English. Use plain prose with no markdown, bullet points, headers, or numbering.',
    'Output only the world facts. No preamble, no commentary.'
].join('\n\n');

// Distill one chat, caching on the record. Returns notes text, or '' if distillation is
// unavailable — callers fall back to the raw transcript rather than losing the context.
// NOTE: this itself runs a yoink generation, so it must only ever be called BEFORE the
// caller starts its own yoink (buildWizardContext always runs first — see callers).
// allowGenerate=false returns only an existing cache and never generates, which is what
// the read-only context preview needs: pressing Preview must not spend a generation.
async function getWizardChatNotes(chat: WizardChat, allowGenerate: boolean): Promise<string> {
    if (!chat || !chat.messages || !chat.messages.length) return '';
    let msgCount = chat.messages.length;
    if (msgCount < AE_DISTILL_MIN_MESSAGES) return '';   // short chat: caller uses raw

    let cache = chat.notesCache;
    if (cache && cache.sourceMsgCount === msgCount && (cache.text || '').trim()) return cache.text;
    if (!allowGenerate) return '';   // stale or absent cache, and we may not generate

    let transcript = chat.messages.map(function(m) { return '[' + m.role.toUpperCase() + '] ' + m.content; }).join('\n');
    let notes = '';
    try {
        notes = await executeYoinkGeneration([
            { role: 'system', content: AE_DISTILL_SYSTEM },
            { role: 'user', content: transcript + '\n\nRecord the world facts established above.' }
        ], { tag: 'wizChatDistill:' + (chat.title || chat.id) });
    } catch (eDistill) {
        api.v1.error('[AE:wizard] distillation failed for chat "' + chat.title + '", falling back to raw transcript:', eDistill);
        return '';
    }
    notes = (notes || '').trim();
    if (!notes) return '';

    let fresh = await loadWizardChat(chat.id);
    if (fresh) {
        fresh.notesCache = { text: notes, sourceMsgCount: msgCount, updatedAt: Date.now() };
        await saveWizardChat(fresh);
    }
    return notes;
}

// allowDistill=false makes this a pure read (no generation), for the preview.
// The returned string is the same one the generator will receive.
async function buildWizardContext(chat: WizardChat, cfg: GlobalConfig, allowDistill?: boolean): Promise<string> {
    let res = await buildWizardContextDetailed(chat, cfg, allowDistill !== false);
    return res.text;
}

// Assembles the context as priority-tagged blocks, distills linked chats, then
// trims to the account's real token ceiling. Returns the joined text plus what was cut,
// so the preview can show it and the user can see WHY something is missing.
async function buildWizardContextDetailed(chat: WizardChat, cfg: GlobalConfig, allowDistill: boolean): Promise<{ text: string; dropped: string[]; tokens: number; budget: number; model: string }> {
    let blocks: WizCtxBlock[] = [];

    let pName = (cfg.projectName || '').trim();
    let pGenre = (cfg.projectGenre || '').trim();
    let pConcept = (cfg.projectConcept || '').trim();
    if (pName || pGenre || pConcept) {
        let head: string[] = [];
        if (pName)    head.push('Project: ' + pName);
        if (pGenre)   head.push('Genre: ' + pGenre);
        if (pConcept) head.push('Concept: ' + pConcept);
        blocks.push({ text: '--- PROJECT ---\n' + head.join('\n'), priority: 100, label: 'Project header' });
    }

    // Linked chats contribute their SETTLED FACTS, not their deliberation.
    // Falling back to the raw transcript when distillation is unavailable keeps the old
    // behaviour rather than silently dropping the chat entirely.
    let ctxIds = chat.contextChatIds || [];
    if (ctxIds.length > 0) {
        let allChats = await loadWizardChats();
        for (let cid of ctxIds) {
            let oc = allChats.find(function(c) { return c.id === cid; });
            if (!oc || !oc.messages || oc.messages.length === 0) continue;
            let notes = await getWizardChatNotes(oc, allowDistill);
            if (notes) {
                blocks.push({ text: '--- WORLD FACTS FROM: ' + oc.title + ' ---\n' + notes, priority: 80, label: 'Chat notes: ' + oc.title });
            } else {
                let transcript = oc.messages.map(function(m) { return '[' + m.role.toUpperCase() + '] ' + m.content; }).join('\n');
                blocks.push({ text: '--- CHAT: ' + oc.title + ' ---\n' + transcript, priority: 80, label: 'Chat transcript: ' + oc.title });
            }
        }
    }

    let loreIds = chat.lorebookEntryIds || [];
    for (let lid of loreIds) {
        try {
            let entry = await api.v1.lorebook.entry(lid);
            if (entry && entry.text && entry.text.trim()) {
                let lname = (entry as any).displayName || (entry as any).name || 'Lorebook Entry';
                blocks.push({ text: '--- LOREBOOK: ' + lname + ' ---\n' + entry.text.trim(), priority: 50, label: 'Lorebook: ' + lname });
            }
        } catch (e) { aeLog('[AE:wizard] lorebook context read failed for ' + lid); }
    }

    // Per-chat character context — the chat decides, independent of each
    // character's global charContextEnabled flag. Formatted straight from the record.
    let charCtxIds = chat.characterIds || [];
    for (let chCid of charCtxIds) {
        try {
            let cc = await loadCharacter(chCid);
            if (!cc) continue;
            let ccLines: string[] = [];
            if (cc.briefDescription) ccLines.push(cc.briefDescription);
            if (cc.species || cc.age || cc.gender || cc.occupationRole) ccLines.push([cc.species, cc.age, cc.gender, cc.occupationRole].filter(Boolean).join(', '));
            if (cc.personalityCore) ccLines.push('Personality: ' + cc.personalityCore);
            if (cc.background) ccLines.push('Background: ' + cc.background);
            if (ccLines.length) blocks.push({ text: '--- CHARACTER: ' + cc.name + ' ---\n' + ccLines.join('\n'), priority: 60, label: 'Character: ' + cc.name });
        } catch (eCc) { aeLog('[AE:wizard] character context read failed for ' + chCid); }
    }

    if (chat.includeStory) {
        let story = await getRecentStoryText(2000);
        if (story.trim()) blocks.push({ text: '--- RECENT STORY ---\n' + story.trim(), priority: 10, label: 'Recent story' });
    }

    // Cap against the account's REAL ceiling. maxTokens() is subscription-tier aware, so a
    // 12k Scroll account trims where a 28k account does not, with no tier hardcoded here.
    let model = await wizActiveModel();
    // One encode call, not one per message: this is only a reserve, and the transcript is
    // trimmed properly (per-message) by runWizardChatTurn.
    let ownJoined = (chat.messages || []).map(function(m) { return m.content; }).join('\n');
    let ownTokens = ownJoined ? await wizCountTokens(ownJoined, model) : 0;
    let budget = await wizContextBudget(model, ownTokens);
    let trimmed = await wizTrimBlocksToBudget(blocks, budget, model);

    if (trimmed.dropped.length) {
        aeLog('[AE:wizard] context over budget (' + budget + ' tok); dropped: ' + trimmed.dropped.join(', '));
    }

    return {
        text: trimmed.kept.map(function(b) { return b.text; }).join('\n\n'),
        dropped: trimmed.dropped,
        tokens: trimmed.tokens,
        budget: budget,
        model: model
    };
}

// ── World-Build Wizard: chat turn (yoink) ────────────────────────────────────
// [vNEXT] Appends the user's message, runs a budget-free yoink generation against
// the topic persona + assembled context + transcript, appends the assistant reply,
// and persists the chat. Returns the assistant text (or null on failure).
async function runWizardChatTurn(chatId: string, userText: string): Promise<string | null> {
    let cfg = await loadConfig();
    let chat = await loadWizardChat(chatId);
    if (!chat) return null;
    // [DIAG] Budget diagnostics via typed commands — engine-only. /budgetlog spends no budget.
    let _diagCmd = (userText || '').trim().toLowerCase();
    if (AE_DIAG_BUDGET && (_diagCmd === '/budgetprobe' || _diagCmd === '/budgetlog')) {
        let _diagOut = _diagCmd === '/budgetprobe' ? await runBudgetProbe() : dumpBudgetLog();
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _diagOut });
        await saveWizardChat(chat);
        return _diagOut;
    }
    // [GENDIAG] /gendiag dumps the shared yoink+direct generation-call log (see
    // the [DIAG GEN] block near the top of the file); /gendiagclear resets it. Spends no
    // budget — pure in-memory ring buffer read/reset, same convention as /budgetlog.
    if (AE_DIAG_GEN && (_diagCmd === '/gendiag' || _diagCmd === '/gendiagclear')) {
        let _genDiagOut = _diagCmd === '/gendiagclear' ? (clearGenDiagLog(), 'Generation diagnostics log cleared.') : dumpGenDiagLog();
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _genDiagOut });
        await saveWizardChat(chat);
        return _genDiagOut;
    }
    // [DIAG earlier DIAG-CMD-SHARED] /log and /diag now live in aeHandleDiagCommand
    // (SECTION 3) so they're reachable from BOTH this modal wizard chat AND the new
    // AE_DIAG_CMD bridge message (SECTION 18) — see that function's header comment
    // for why a chat-turn-only command surface was the wrong call.
    let _sharedDiagOut = await aeHandleDiagCommand(userText.trim(), _diagCmd);
    if (_sharedDiagOut !== null) {
        chat.messages.push({ role: 'user', content: userText.trim() });
        chat.messages.push({ role: 'assistant', content: _sharedDiagOut });
        await saveWizardChat(chat);
        return _sharedDiagOut;
    }
    let topic = getWizardTopic(cfg, chat.topicId);
    let persona = topic ? topic.instructions : 'You are a helpful worldbuilding assistant. Keep replies short and conversational.';

    if (userText && userText.trim()) {
        chat.messages.push({ role: 'user', content: userText.trim() });
    }

    // [WIZMODE-CUT] The freeze-per-chat cache went with the mode that gated it: it
    // only ever filled while _aeWizardMode was true, which was never.
    let ctx: string = await buildWizardContext(chat, cfg);
    let sysParts: string[] = [persona];
    if (ctx.trim()) {
        sysParts.push('The following is READ-ONLY reference context. Use it to inform your replies, but do not quote it back verbatim.\n\n' + ctx);
    }

    let msgs: any[] = [{ role: 'system', content: sysParts.join('\n\n') }];

    // The transcript is replayed in full on every turn and grows without bound.
    // On a 12k-context account a long chat can push the system message (which carries the
    // topic persona and all formatting rules) out of the window. Keep the seed message —
    // it frames the whole topic — plus as many of the MOST RECENT turns as fit, dropping
    // from the middle. buildWizardContext has already trimmed ctx against the same ceiling.
    let turnModel = await wizActiveModel();
    let ctxTokens = await wizCountTokens(sysParts.join('\n\n'), turnModel);
    let turnCeiling = 0;
    try { turnCeiling = await api.v1.maxTokens(turnModel); }
    catch (eTurnMax) { aeLog('[AE:wizard] maxTokens unavailable, replaying full transcript:', eTurnMax); }

    let history = chat.messages.slice();
    if (turnCeiling > 0) {
        let transcriptBudget = turnCeiling - ctxTokens - AE_CTX_RESERVE_OUTPUT;
        if (transcriptBudget < AE_CTX_MIN_BUDGET) transcriptBudget = AE_CTX_MIN_BUDGET;

        // Cheap chars/4 estimate first. Only pay for per-message tokenization when we are
        // plausibly near the ceiling, so a normal-length chat costs zero extra encode calls.
        let roughChars = 0;
        for (let rm of history) roughChars += (rm.content || '').length;
        let roughTokens = Math.ceil(roughChars / 4);

        if (roughTokens > transcriptBudget * 0.8) {
            let seed = (history.length > 0 && history[0].role === 'assistant') ? history[0] : null;
            let rest = seed ? history.slice(1) : history.slice();
            let seedTokens = seed ? await wizCountTokens(seed.content, turnModel) : 0;

            let keptRev: WizardChatMessage[] = [];
            let used = seedTokens;
            for (let i = rest.length - 1; i >= 0; i--) {
                let mt = await wizCountTokens(rest[i].content, turnModel);
                if (used + mt > transcriptBudget && keptRev.length > 0) break;
                used += mt;
                keptRev.push(rest[i]);
            }
            keptRev.reverse();
            let trimmedCount = rest.length - keptRev.length;
            history = seed ? [seed].concat(keptRev) : keptRev;
            if (trimmedCount > 0) aeLog('[AE:wizard] transcript over budget; dropped ' + trimmedCount + ' older message(s) from the middle.');
        }
    }

    for (let m of history) {
        msgs.push({ role: m.role, content: m.content });
    }

    let reply = '';
    try {
        reply = await executeYoinkGeneration(msgs, { tag: 'wizChatTurn:' + (chat.title || chatId) });
    } catch (e) {
        api.v1.error('[AE:wizard] chat turn generation failed:', e);
        return null;
    }
    reply = (reply || '').trim();
    if (!reply) return null;

    chat.messages.push({ role: 'assistant', content: reply });
    await saveWizardChat(chat);
    return reply;
}

// ── World-Build Wizard: per-section generation (yoink) ───────────────────────
// [vNEXT] Generates ONE memory section's content from a chat transcript, scoped hard
// to that section's instructions so sections never bleed into each other. Already-
// written sections are passed as read-only context to avoid overlap. Returns the
// generated text (or null on failure).
async function generateWizardSection(section: WizardMemorySection, ctx: string, cfg: GlobalConfig, priorSections: WizardMemorySection[], hint?: string): Promise<string | null> {
    let sys = [
        'You are writing the "' + section.label + '" section of a story\'s static world canon.',
        section.instructions,
        'CONSTRAINT: Write ONLY the content of this section. Do not restate this section\'s name as a heading before the content. Do not write any other section\'s content. Be concise and concrete.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, italics, or bullet points. Output plain text only.'
    ].join('\n\n');

    let priorLines: string[] = [];
    for (let ps of (priorSections || [])) {
        if (ps.id === section.id) continue;
        let body = (ps.content || '').trim();
        if (body) priorLines.push('[' + ps.label + '] ' + body);
    }

    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    if (priorLines.length > 0) usrParts.push('--- ALREADY-WRITTEN SECTIONS (do not repeat these; stay in your own scope) ---\n' + priorLines.join('\n'));
    if (hint && hint.trim()) usrParts.push('--- EXTRA GUIDANCE FOR THIS REGENERATION ---\n' + hint.trim());
    usrParts.push('Now write the "' + section.label + '" section.');

    let msgs: any[] = [
        { role: 'system', content: sys },
        { role: 'user', content: usrParts.join('\n\n') }
    ];

    let result = '';
    try {
        result = await executeYoinkGeneration(msgs, { tag: 'wizSection:' + section.label });
    } catch (e) {
        api.v1.error('[AE:wizard] section generation failed (' + section.label + '):', e);
        return null;
    }
    return (result || '').trim() || null;
}

// Regenerate ONE section in place (does not commit memory). sourceChatIds
// mirrors the multi-source context model every other generator tab uses (Species/
// Factions/etc via buildWizardMultiContext) — was single-chat-only before, which also
// meant the bridge's AE_WIZ_REGEN_ENTITY handler was silently truncating its own
// already-array-shaped sourceChatIds payload down to just the first id. Writes the
// result into cfg.wizardSections.
async function regenerateWizardSection(sectionId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let section = (cfg.wizardSections || []).find(function(s) { return s.id === sectionId; });
    if (!section) return null;
    let ctx = await buildWizardMultiContext(sourceChatIds || [], cfg);
    let prior = cfg.wizardSections || [];
    let gen = await generateWizardSection(section, ctx, cfg, prior, hint);
    if (!gen) return null;
    await mutConfig(function(c) {
        let target = (c.wizardSections || []).find(function(s) { return s.id === sectionId; });
        if (target) target.content = gen;
    });
    return gen;
}

// Build wizard context from MULTIPLE source chats (multi-select). Constructs a
// synthetic chat whose contextChatIds are the selected chats, so buildWizardContext pulls
// each selected chat's transcript (as a "--- CHAT: title ---" block) plus the project header.
// includeStory is on if ANY selected chat has it; selected chats' lorebook links are unioned.
// allowDistill=false makes this a pure read (used by the context preview).
async function buildWizardMultiContext(chatIds: string[], cfg: GlobalConfig, allowDistill?: boolean): Promise<string> {
    let res = await buildWizardMultiContextDetailed(chatIds, cfg, allowDistill !== false);
    return res.text;
}

async function buildWizardMultiContextDetailed(chatIds: string[], cfg: GlobalConfig, allowDistill: boolean): Promise<{ text: string; dropped: string[]; tokens: number; budget: number; model: string }> {
    let selIds = (chatIds || []).filter(Boolean);
    let allMultiChats = await loadWizardChats();
    let anyMultiStory = false;
    let unionLore: string[] = [];
    // Ids that resolve to NEITHER a classic chat NOR (checked below) fall through
    // to a direct lorebook-entry read — this is how a CE Chats entry (or any other saved
    // lorebook source a generator tab lets the user check) becomes generator context with
    // no owning classic-chat record required.
    let directLoreBlocks: WizCtxBlock[] = [];
    for (let sid of selIds) {
        let sc = allMultiChats.find(function(c) { return c.id === sid; });
        if (sc) {
            if (sc.includeStory) anyMultiStory = true;
            for (let lid of (sc.lorebookEntryIds || [])) { if (unionLore.indexOf(lid) < 0) unionLore.push(lid); }
            continue;
        }
        try {
            let le = await api.v1.lorebook.entry(sid);
            if (le && le.text && le.text.trim()) {
                let leName = (le as any).displayName || 'Saved Chat';
                directLoreBlocks.push({ text: '--- SAVED CHAT: ' + leName + ' ---\n' + le.text.trim(), priority: 80, label: 'Saved chat: ' + leName });
            }
        } catch (eLoreDirect) { aeLog('[AE:wizard] direct lorebook source read failed for ' + sid); }
    }
    let classicIds = selIds.filter(function(id) { return allMultiChats.some(function(c) { return c.id === id; }); });
    let synthChat: WizardChat = { id: 'transient', topicId: '', title: '', messages: [], contextChatIds: classicIds, includeStory: anyMultiStory, lorebookEntryIds: unionLore, createdAt: 0, updatedAt: 0 };
    let base = await buildWizardContextDetailed(synthChat, cfg, allowDistill);
    if (directLoreBlocks.length === 0) return base;
    // Splice the directly-selected lorebook sources in alongside the already-assembled
    // (already-budgeted) base text, then re-trim the combination to the same ceiling.
    let combined: WizCtxBlock[] = directLoreBlocks.concat([{ text: base.text, priority: 70, label: 'Chat/project context' }]);
    let trimmed2 = await wizTrimBlocksToBudget(combined, base.budget, base.model);
    return {
        text: trimmed2.kept.map(function(b) { return b.text; }).join('\n\n'),
        dropped: base.dropped.concat(trimmed2.dropped),
        tokens: trimmed2.tokens,
        budget: base.budget,
        model: base.model
    };
}

// [PREVIEW] Return the exact reference context a batch generation for these
// source chats would receive, plus a short header describing what is (and is not)
// present. Read-only: no generation, no storage writes, no side effects.
//
// This exists because buildWizardContext's output was previously invisible. When a
// generation comes back empty or malformed, the first question is "was any context
// actually attached?" — and neither the user nor the author could answer it. An empty
// preview is now self-evident.
async function buildWizardContextPreview(sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let res: { text: string; dropped: string[]; tokens: number; budget: number; model: string };
    try {
        // allowDistill=false: pressing Preview must never spend a generation.
        res = await buildWizardMultiContextDetailed(sourceChatIds || [], cfg, false);
    } catch (ePrev) {
        api.v1.error('[AE:wizard] context preview build failed:', ePrev);
        return 'Context preview failed to build. See the script log for details.';
    }
    let body = (res.text || '').trim();
    if (!body) {
        return 'NO CONTEXT ATTACHED.\n\nGeneration will run on the topic instructions alone, with nothing about your world.\n\nTo fix: set a project name/genre/concept in the Setup tab, or check one or more context-source chats above.';
    }

    let headLines: string[] = [];
    headLines.push('--- CONTEXT PREVIEW ---');
    headLines.push('This is the reference context the generator will receive, verbatim.');
    headLines.push('Model: ' + res.model);
    if (res.budget > 0) {
        let pct = Math.round((res.tokens / res.budget) * 100);
        headLines.push('Size: ' + res.tokens + ' of ' + res.budget + ' available context tokens (' + pct + '%).');
    } else {
        headLines.push('Size: ~' + res.tokens + ' tokens (context ceiling unavailable, so no cap is applied).');
    }
    if (res.dropped.length) {
        headLines.push('');
        headLines.push('TRIMMED TO FIT \u2014 these blocks were dropped, lowest priority first:');
        for (let dl of res.dropped) headLines.push('  - ' + dl);
    }
    // A stale/absent notes cache shows as a raw transcript here but will be distilled on
    // the real run, so the live context is usually SMALLER than this preview. Say so
    // rather than letting the number look alarming.
    if (body.indexOf('--- CHAT: ') >= 0) {
        headLines.push('');
        headLines.push('Note: chats shown as raw transcripts have not been distilled yet. They will be condensed into world facts on the next generation, which usually shrinks this considerably.');
    }
    headLines.push('');
    return headLines.join('\n') + body;
}




// ── World-Build Wizard: species / faction batch generation (yoink) ───────────
// [vNEXT] Generate a batch of named items (species or factions), each with a short
// lore description, in one budget-free pass. Output is parsed from a simple
// NAME:/LORE: block format. Returns an array of {name, description} (may be < count
// if the model returns fewer). kind is 'species' or 'faction' for prompt phrasing.
// [STAGING] avoidNames carries names discarded during this staging session
// (tombstones) plus any staged-but-uncommitted names, so a regenerate after deleting a
// bad entry does not hand the same entry straight back.
async function generateEntityBatch(kind: string, count: number, sourceChatIds: string[], avoidNames?: string[]): Promise<{ name: string; description: string }[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let noun = (kind === 'faction') ? 'factions (organizations, powers, or groups)' : 'species (peoples or creature-types)';

    // Feed existing same-kind names in so the batch never recreates them.
    // [F-28] Factions come from the entity index; species still from the config.
    let batchExistingNames = ((kind === 'faction') ? (await ceFactionMetas()) : (cfg.species || []))
        .map(function(x: any) { return (x && x.name) ? String(x.name).trim() : ''; })
        .filter(Boolean);
    for (let avName of (avoidNames || [])) {
        if (avName && batchExistingNames.indexOf(avName) < 0) batchExistingNames.push(avName);
    }

    let batchSysLines: string[] = [
        'You are generating ' + noun + ' for a story world.',
        'Produce EXACTLY ' + count + ' distinct entries that fit the world and feel like they belong together without being repetitive.',
        'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.'
    ];
    if (batchExistingNames.length) {
        batchSysLines.push('These ' + (kind === 'faction' ? 'factions' : 'species') + ' ALREADY EXIST — do NOT recreate, rename, or duplicate any of them. Generate entirely new, distinct entries:\n' + batchExistingNames.map(function(bn) { return '- ' + bn; }).join('\n'));
    }
    batchSysLines.push('FORMAT: For each entry output exactly:\nNAME: <short proper name>\nLORE: <a full, substantial description (roughly 5-8 sentences, one or two solid paragraphs) covering what it is, what matters about it, and the specific details that distinguish it>\nSeparate entries with a line containing only ---');
    batchSysLines.push('Draw on the specific names, ideas, and details raised in the brainstorming chat below — do not stay generic.');
    batchSysLines.push('Output ONLY the entries in that format. No preamble, no numbering, no extra commentary.');
    let sys = batchSysLines.join('\n\n');

    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    usrParts.push('Generate ' + count + ' ' + (kind === 'faction' ? 'factions' : 'species') + ' now.');

    let raw = '';
    try {
        raw = await executeYoinkGeneration([{ role: 'system', content: sys }, { role: 'user', content: usrParts.join('\n\n') }], { validator: function(r) { return /NAME:/i.test(r); }, tag: 'entityBatch:' + kind });
    } catch (e) {
        api.v1.error('[AE:wizard] batch generation failed (' + kind + '):', e);
        return [];
    }

    // Parse NAME:/LORE: blocks split on --- lines.
    let out: { name: string; description: string }[] = [];
    let chunks = (raw || '').split(/\n-{3,}\n/);
    for (let ch of chunks) {
        let nameMatch = ch.match(/NAME:\s*(.+)/i);
        let loreMatch = ch.match(/LORE:\s*([\s\S]+)/i);
        if (!nameMatch) continue;
        let nm = nameMatch[1].trim();
        let lore = loreMatch ? loreMatch[1].trim() : '';
        // Trim a trailing stray --- or NAME: bleed if the split missed.
        lore = lore.replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        if (nm) out.push({ name: nm, description: lore });
    }
    return out;
}

// [vNEXT] Generate (or regenerate) the lore description for ONE named species/faction,
// scoped to that single item, with optional hint. Returns description text or null.
async function generateEntityLore(kind: string, name: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let kindNoun = (kind === 'faction') ? 'faction' : 'species';
    let sys = [
        'You are writing the lore description for a single ' + kindNoun + ' named "' + name + '" in a story world.',
        'Write a full, substantial description (roughly 5-8 sentences, one or two solid paragraphs) covering what it is, what matters about it, and the specific details that distinguish it. Stay focused on THIS ' + kindNoun + ' only, and draw on the specific ideas and details in the reference context rather than staying generic.',
        'Output ONLY the description prose. Do not begin with the name or a label.'
    ].join('\n\n');
    let usrParts: string[] = [];
    if (ctx.trim()) usrParts.push(ctx);
    if (hint && hint.trim()) usrParts.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    usrParts.push('Write the description for "' + name + '" now.');
    let result = '';
    try {
        result = await executeYoinkGeneration([{ role: 'system', content: sys }, { role: 'user', content: usrParts.join('\n\n') }], { tag: 'entityLore:' + kind + ':' + name });
    } catch (e) {
        api.v1.error('[AE:wizard] entity lore generation failed (' + name + '):', e);
        return null;
    }
    return (result || '').trim() || null;
}

// ── World-Build Wizard: stage / commit (earlier STAGING) ─────────────────────
// Every batch kind now follows: stage*Batch (generate -> park as drafts) ->
// user reviews/edits/discards -> commitStagedDrafts (write records + lorebook, clear
// drafts + tombstones). The legacy run*Batch wrappers preserve the old one-shot
// behavior for existing callers (notably the bridge's AE_WIZ_GENERATE handler) by
// staging and then committing ONLY the ids they just created — so a one-shot call never
// sweeps up drafts the user is still reviewing in the native wizard.

// Names currently staged-but-uncommitted for a kind. Combined with tombstones to form
// the do-not-recreate list, so a second Generate pass extends the batch rather than
// duplicating it.
// Do-not-recreate list for a kind = names of drafts STILL STAGED, so a second
// Generate press extends the batch rather than duplicating what is already on screen.
// Discarded names are deliberately NOT included (see discardWizardDraft).
// excludeDraftId omits one draft's own name — used by per-draft Regenerate, which must
// be free to produce the same place/person again with better prose.
async function avoidNamesForKind(kind: string, excludeDraftId?: string): Promise<string[]> {
    let staged = await loadWizardDraftsOfKind(kind);
    let merged: string[] = [];
    for (let sd of staged) {
        if (excludeDraftId && sd.id === excludeDraftId) continue;
        let mn = (sd.fields.name || '').trim();
        if (mn && merged.indexOf(mn) < 0) merged.push(mn);
    }
    return merged;
}

// [GEN-GUIDED] ONE NAMED THING, WRITTEN TO ORDER. The author supplies the name,
// which is the whole point: a name they typed is already anchored to what they and the
// wizard chat were just talking about, so the generator is asked to elaborate a decision
// rather than to invent and decide in one pass.
//
// IT ALSO DELETES THE PARSE. generateEntityLore returns prose and nothing else — no
// NAME:/LORE: blocks, no '---' record separator inside five to eight sentences of free
// text, and therefore none of the bleed-cleanup regexes stageEntityBatch's parser needs.
// Those regexes were the confession that the separator was being written INTO the lore.
//
// AND IT DELETES THE SILENT SHORTFALL. The batch validator is /NAME:/i over the WHOLE
// reply, so a request for five that came back with two well-formed entries passed and
// staged two, indistinguishable to the author from a lazy model. One name in, one draft
// or an honest null out.
async function stageEntityNamed(kind: string, name: string, sourceChatIds: string[], hint: string): Promise<string[]> {
    let gnName = String(name || '').trim().substring(0, 60);
    if (!gnName) return [];
    let gnLore = await generateEntityLore(kind, gnName, sourceChatIds, String(hint || ''));
    if (!gnLore) return [];
    return await addWizardDrafts(kind, [{ name: gnName, description: gnLore }], sourceChatIds, null);
}

// Stage N species/factions as drafts. Returns the created draft ids (empty on failure).
// [GEN-GUIDED] NOT the surface's door any more — stageEntityNamed is. Retained for
// the bridge's AE_WIZ_GENERATE handler, which still calls the run*Batch wrapper below.
async function stageEntityBatch(kind: string, count: number, sourceChatIds: string[]): Promise<string[]> {
    let avoid = await avoidNamesForKind(kind);
    let items = await generateEntityBatch(kind, count, sourceChatIds, avoid);
    if (!items.length) return [];
    let rows = items.map(function(it) { return { name: it.name, description: it.description || '' }; });
    return await addWizardDrafts(kind, rows, sourceChatIds, null);
}

// Stage N minor-NPC archetypes as drafts.
// [CE-STRIP earlier] stageArchetypeBatch() removed — Bestiary + Item Templates cut.

// Stage N item templates as drafts.
// [CE-STRIP earlier] stageItemBatch() removed — Bestiary + Item Templates cut.

// Regenerate a single staged draft in place, reusing the chat sources it was
// generated from. Its own name is excluded from the do-not-recreate list so the model may
// legitimately produce the same subject again with better prose. Returns false on failure
// and leaves the existing draft untouched, so a bad regen never destroys good content.
async function regenerateWizardDraft(draftId: string): Promise<boolean> {
    let all = await loadWizardDrafts();
    let target = all.find(function(d) { return d.id === draftId; });
    if (!target) return false;

    let rgKind = target.kind;
    let rgSrc = target.sourceChatIds || [];
    let rgAvoid = await avoidNamesForKind(rgKind, draftId);
    let rgFields: { [k: string]: string } | null = null;

    try {
        if (rgKind === 'species' || rgKind === 'faction') {
            let rows = await generateEntityBatch(rgKind, 1, rgSrc, rgAvoid);
            if (rows.length) rgFields = { name: rows[0].name, description: rows[0].description || '' };
        // [CE-STRIP earlier] 'archetype'/'item' draft-regen branches removed — Bestiary + Item Templates cut.
        } else if (rgKind === 'location') {
            let rows = await generateLocationBatch(1, target.parentId || null, rgSrc, rgAvoid);
            if (rows.length) rgFields = { name: rows[0].name, description: rows[0].description || '', lore: rows[0].lore || '' };
        } else if (rgKind === 'character') {
            // Keep the name the user is already looking at; regenerate only the concept.
            let rgName = (target.fields.name || '').trim();
            if (!rgName) return false;
            let rgDump = await generateCharacterDump(rgName, rgSrc);
            if (rgDump && rgDump.trim()) rgFields = { name: rgName, dump: rgDump.trim() };
        }
    } catch (eRegen) {
        api.v1.error('[AE:wizard] regenerate failed for draft ' + draftId + ':', eRegen);
        return false;
    }

    if (!rgFields) return false;
    let fresh = await loadWizardDrafts();
    let live = fresh.find(function(d) { return d.id === draftId; });
    if (!live) return false;
    live.fields = rgFields;
    await saveWizardDrafts(fresh);
    return true;
}

// [STAGING] The single irreversible write path. Commits staged drafts of a kind
// to real records (+ lorebook entries where that kind has them), then removes exactly
// the committed drafts and clears the kind's tombstones. Drafts with a blank name are
// skipped and LEFT STAGED rather than silently dropped, so the user can see and fix them.
//
// onlyIds restricts the commit to a specific set (used by the legacy run*Batch wrappers).
// Returns the number of records actually created.
async function commitStagedDrafts(kind: string, onlyIds?: string[]): Promise<number> {
    let drafts = await loadWizardDraftsOfKind(kind);
    if (onlyIds && onlyIds.length) {
        drafts = drafts.filter(function(d) { return onlyIds.indexOf(d.id) >= 0; });
    }
    if (!drafts.length) return 0;

    let committedIds: string[] = [];
    let made = 0;

    for (let d of drafts) {
        let dName = (d.fields.name || '').trim();
        if (!dName) continue;   // leave nameless drafts staged for the user to fix

        try {
            if (kind === 'species') {
                let spId = 'sp_' + generateId();
                await mutConfig(function(c) {
                    if (!c.species) c.species = [];
                    c.species.push({ id: spId, name: dName, description: d.fields.description || '', lorebookTags: [] });
                });
                await createLinkedSpeciesLorebookEntry(spId).catch(function() {});
            } else if (kind === 'faction') {
                // [F-28] AN ENTITY, NOT A CONFIG ROW. The wizard's Factions TAB is retired,
                // but this commit path is also reachable from a staged draft, so it has to
                // land a record of the shape everything else now reads. Same fields
                // ceMigrateFactionsToEntities writes, for the same reason: one faction shape.
                let facId = 'fac_' + generateId();
                await saveEntity(migrateEntity({
                    id: facId, name: dName, type: 'faction', parentId: null,
                    description: d.fields.description || '', connectedEntityIds: [],
                    customFieldValues: {}, lorebookTags: [], uiShape: 'classic',
                    createdAt: Date.now(), updatedAt: Date.now()
                } as any));
                await createLinkedEntityLorebookEntry(facId).catch(function() {});
                await ceSyncStandingDefs().catch(function() {});
            } else if (kind === 'archetype') {
                let archId = 'arch_' + generateId();
                await mutConfig(function(c) {
                    if (!(c as any).npcArchetypes) (c as any).npcArchetypes = [];
                    (c as any).npcArchetypes.push({ id: archId, name: dName, briefTemplate: d.fields.brief || '', charResourceDefs: [], actionInstances: [], tagSubscriptions: [] });
                });
            } else if (kind === 'item') {
                let itmId = 'item_' + generateId();
                await mutConfig(function(c) {
                    if (!(c as any).itemArchetypes) (c as any).itemArchetypes = [];
                    (c as any).itemArchetypes.push({ id: itmId, name: dName, descriptionTemplate: d.fields.description || '', tagSubscriptions: [], spawnTarget: 'inventory' });
                });
            } else if (kind === 'location') {
                await createLocationEntity(dName, d.fields.description || '', d.fields.lore || '', d.parentId || null);
            } else if (kind === 'character') {
                // [CHAR-STAGE] Structured fields are derived HERE, from the concept
                // dump as the user left it. If field extraction fails, the character is still
                // created with its name + dump rather than being lost, and the dump remains
                // visible on the record for a manual per-field regenerate.
                let chDump = d.fields.dump || '';
                let chFields: WizardCharFields | null = null;
                try { chFields = await generateCharacterFields(dName, chDump); }
                catch (eChFields) { api.v1.error('[AE:wizard] field extraction failed for "' + dName + '":', eChFields); }
                await createWizardCharacter(dName, chDump, chFields);
            } else {
                aeLog('[AE:wizard] commitStagedDrafts unknown kind: ' + kind);
                continue;
            }
            committedIds.push(d.id);
            made++;
        } catch (eCommit) {
            // Leave this draft staged so the user can retry; keep going with the rest.
            api.v1.error('[AE:wizard] commit failed for staged ' + kind + ' "' + dName + '":', eCommit);
        }
    }

    await removeWizardDrafts(committedIds);
    return made;
}

// [vNEXT] Batch-create species records from a chat: generate, push records, and
// create+link a lorebook entry (with tags = name) for each. Returns count created.
// [STAGING] Now a thin stage -> commit wrapper. Commits only its own new drafts.

// [vNEXT] Batch-create faction records from a chat. Factions also get the default
// standing track (relationshipStates) so the existing index-based standing works.
// [STAGING] Now a thin stage -> commit wrapper. Commits only its own new drafts.

// [vNEXT] Batch-create minor-NPC archetypes from a wizard chat: generate NAME +
// one-line BRIEF pairs and push NpcArchetypeDef records to cfg.npcArchetypes.
// Resources/tags start empty (edit in the Bestiary: "+ Default Resources", tags);
// no lorebook entry — archetypes are spawn templates, not world lore. Returns count.
// [STAGING] Pure generator: parses and RETURNS archetypes, writing nothing.
// Committing to cfg.npcArchetypes is commitStagedDrafts()'s job.
// [CE-STRIP earlier] generateArchetypeBatch() removed — Bestiary + Item Templates cut.

// [STAGING] Legacy one-shot: stage then commit only the drafts just created.
// Retained for the bridge's AE_WIZ_GENERATE handler and any direct callers.
// [CE-STRIP earlier] runWizardArchetypesBatch() removed — Bestiary + Item Templates cut.

// [ITEMS] Generate item templates from a wizard chat: NAME + one-line DESC
// pairs. Mechanics (skill bonuses, actions, tags) start EMPTY by design and are filled
// in the Item Template editor \u2014 the model only authors the name + description, the
// same shallow-generation split the Bestiary uses.
// [STAGING] Pure generator: parses and RETURNS item templates, writing nothing.
// Committing to cfg.itemArchetypes is commitStagedDrafts()'s job.
// [CE-STRIP earlier] generateItemBatch() removed — Bestiary + Item Templates cut.

// [STAGING] Legacy one-shot: stage then commit only the drafts just created.
// [CE-STRIP earlier] runWizardItemsBatch() removed — Bestiary + Item Templates cut.

// Manually add a single blank species/faction record (default name, empty
// lore) and link a lorebook entry, so the user can rename it and then ⚡ Regen its
// fields — the regen path re-syncs the existing entry. Returns the new record id.
// [F-28] SPECIES ONLY. Its one caller was the wizard's Species/Factions tab, which is now
// species-only -- a new faction is created on Diplomacy, where it lands as an entity.
async function addBlankWizardEntity(kind: string): Promise<string> {
    let blankId = 'sp_' + generateId();
    await mutConfig(function(c) {
        if (!c.species) c.species = [];
        c.species.push({ id: blankId, name: 'New Species', description: '', lorebookTags: [] });
    });
    await createLinkedSpeciesLorebookEntry(blankId).catch(function() {});
    return blankId;
}

// [vNEXT] Regenerate one species/faction's description in place and re-sync its
// lorebook entry. kind is 'species' or 'faction'. Returns the new text or null.
async function regenerateWizardEntity(kind: string, itemId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    // [F-28] SPECIES ONLY, same reason as addBlankWizardEntity. `kind` is kept in the
    // signature because generateEntityLore reads it for prompt phrasing and its one caller
    // still passes it -- narrowing the parameter would be a change to a working generator to
    // express a fact the body already states.
    let cfg = await loadConfig();
    let list: any[] = (cfg.species || []);
    let item = list.find(function(x) { return x.id === itemId; });
    if (!item) return null;
    let gen = await generateEntityLore(kind, item.name, sourceChatIds, hint);
    if (!gen) return null;
    await mutConfig(function(c) {
        let arr: any[] = (c.species || []);
        let t = arr.find(function(x) { return x.id === itemId; });
        if (t) t.description = gen;
    });
    await syncSpeciesLorebookEntry(itemId).catch(function() {});
    return gen;
}


// [CE-STRIP earlier] tierBandIndexForDepth / entryActionIdForDepth / syncTierTemplate
// removed — tier-travel cost templates cut with Actions + Travel. Locations no longer
// stamp an entryActionId.

// Yoink-generate a batch of locations as {name, description}. parentId null =
// top-level. Existing sibling names are fed in to avoid duplicates; the parent's own
// description anchors children. Multi-chat context via buildWizardMultiContext.
//
// [LOCGEN] >>> PAIRED PROMPT: generateSceneLocation() (Items block, near
// >>> generateSceneItem) emits the SAME NAME/DESC/LORE contract from story context
// >>> instead of chat context, and parses it with the same regexes. If you change the
// >>> format instructions or the parse here, change them there too.
// [STAGING] avoidNames carries tombstoned + staged-uncommitted names.
async function generateLocationBatch(count: number, parentId: string | null, sourceChatIds: string[], avoidNames?: string[]): Promise<{ name: string; description: string; lore: string }[]> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let parentEnt = parentId ? await loadEntity(parentId) : null;
    let locIdx = await loadEntityIndex();
    let existingLoc = locIdx.filter(function(m) { return m.type === 'location' && m.parentId === (parentId || null); }).map(function(m) { return m.name; }).filter(Boolean);
    for (let avLoc of (avoidNames || [])) {
        if (avLoc && existingLoc.indexOf(avLoc) < 0) existingLoc.push(avLoc);
    }
    let scopeNoun = parentEnt ? ('sub-locations inside "' + parentEnt.name + '"') : 'top-level locations (regions / major places) of the world';

    let locSysLines: string[] = [
        'You are generating ' + scopeNoun + ' for a story world.',
        'Produce EXACTLY ' + count + ' distinct locations that fit the world and belong together without being repetitive.',
        // The brainstorming chat is the AUTHORITY on which places to build, not
        // mere background flavour. Users reported discussing Hogwarts / Diagon Alley /
        // Hogsmeade and receiving unrelated inventions instead. State this first and
        // positively: name the places the chat names, and invent only to fill a shortfall.
        'The brainstorming chat below is your source of truth. If it names specific places, use those exact names and build those locations first, preserving the chat\'s own details about each. Invent additional locations only if the chat names fewer than ' + count + '.',
        'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.'
    ];
    if (parentEnt && (parentEnt.description || '').trim()) {
        locSysLines.push('They are all inside this parent location:\n' + parentEnt.name + ': ' + parentEnt.description.trim());
    }
    if (existingLoc.length) {
        // Scoped wording: these are records that already exist in the world, so
        // recreating one would make a duplicate. This list no longer contains names the
        // user merely discarded (earlier tombstones), which is what previously caused the
        // generator to be forbidden from producing the very places the chat was about.
        locSysLines.push('Locations with these names already exist in the world, so choose different ones \u2014 build any OTHER places the chat names:\n' + existingLoc.map(function(ln) { return '- ' + ln; }).join('\n'));
    }
    locSysLines.push('FORMAT: For each location output exactly:\nNAME: <short place name>\nDESC: <1-2 sentences capturing ONLY what a camera physically senses on arrival (light, texture, scale). No history.>\nLORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, culture, and tensions>\nSeparate entries with a line containing only ---');
    locSysLines.push('Draw every name and detail from the brainstorming chat. Output ONLY the entries in the exact format requested. No preamble, no numbering, no commentary.');
    let locSys = locSysLines.join('\n\n');

    let locUsr: string[] = [];
    if (ctx.trim()) locUsr.push(ctx);
    // Restate the priority immediately before generation, where it carries the
    // most recency weight, rather than relying on the system message alone.
    locUsr.push('Generate ' + count + ' locations now, starting with the places named in the chat above.');

    let locRaw = '';
    try {
        locRaw = await executeYoinkGeneration([{ role: 'system', content: locSys }, { role: 'user', content: locUsr.join('\n\n') }], { validator: function(r) { return /NAME:/i.test(r); }, tag: 'locationBatch' + (parentEnt ? (':' + parentEnt.name) : '') });
    } catch (eLocGen) {
        api.v1.error('[AE:wizard] location batch generation failed:', eLocGen);
        return [];
    }

    let locOut: { name: string; description: string; lore: string }[] = [];
    let locChunks = (locRaw || '').split(/\n-{3,}\n/);
    for (let lch of locChunks) {
        let lnm = lch.match(/NAME:\s*(.+)/i);
        let lde = lch.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
        let llo = lch.match(/LORE:\s*([\s\S]+)/i);
        if (!lnm) continue;
        let lName = lnm[1].trim();
        let lDesc = lde ? lde[1].trim() : '';
        lDesc = lDesc.replace(/\nLORE:[\s\S]*$/i, '').replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        let lLore = llo ? llo[1].trim() : '';
        lLore = lLore.replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim();
        if (lName) locOut.push({ name: lName, description: lDesc, lore: lLore });
    }
    return locOut;
}

// [LOCGEN] The ONE place a generated {name, description, lore} triple becomes a
// persisted `location` entity plus its linked lorebook entry. Two callers, deliberately:
//
//   runWizardLocationsBatch()  (directly below)  — authoring-time, wizard chat context,
//                                                  Yoink generation, N at a time.
//   spawnLocation()            (Items block, next to spawnItem/generateSceneItem) —
//                                                  in-play, story context, one at a time.
//
// >>> PAIRED CODE: if you add a field stamped onto new locations here, make sure BOTH
// >>> callers can supply it. If you change what a location needs at birth, this helper
// >>> is the only place to change it — do not re-inline entity assembly in a caller.
//
// Siblings need no connectedEntityIds edge: locationGraph derives lateral adjacency from
// a shared parentId (see "Lateral siblings" in buildSceneStatePayload).
async function createLocationEntity(name: string, description: string, lore: string, parentId: string | null): Promise<string> {
    let cle = makeDefaultEntity(name || 'New Location');
    cle.type = 'location';
    cle.parentId = parentId || null;
    cle.description = description || '';
    (cle as any).lorebookText = lore || '';
    // [CE-STRIP earlier] entryActionId param/assignment removed — always dead, no consumer.
    await saveEntity(cle);
    // [LORE-EVERY] ATTEMPTED ALWAYS, GATED ONCE. The old `if (lore.trim())` was a second,
    // narrower copy of createLinkedEntityLorebookEntry's own gate: it refused a place whose
    // caller had filled custom answers instead of the deprecated free-text box. The real
    // gate refuses an empty record on its own, so this call is safe to make unconditionally
    // and there is one place left that decides what "empty" means.
    await createLinkedEntityLorebookEntry(cle.id, true).catch(function() {});
    return cle.id;
}

// Batch-create location entities under parentId, stamping each with the tier
// template for its depth. Returns the count created.
// [STAGING] Legacy one-shot: stage then commit only the drafts just created.
// Tier/entry-action resolution now happens inside commitStagedDrafts, from the parentId
// carried on each draft record.

// Create one blank location under parentId. Returns id.
async function addBlankWizardLocation(parentId: string | null): Promise<string> {
    let le = makeDefaultEntity('New Location');
    le.type = 'location';
    le.parentId = parentId || null;
    await saveEntity(le);
    return le.id;
}

// Regenerate one location's short description AND comprehensive lorebook in a
// single pass; updates both fields and re-syncs (or creates) its lorebook entry.
// [GEN-GUIDED] ONE NAMED PLACE. Factored out of regenerateWizardLocation so the
// guided stager and the in-place regen share one prompt rather than two that drift. Two
// labelled blocks in one reply is not the batch's problem: there is no '---' record
// separator and no per-entry shortfall to go unnoticed.
async function generateLocationNamed(name: string, parentId: string | null, sourceChatIds: string[], hint: string): Promise<{ description: string; lore: string } | null> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let parentEnt = parentId ? await loadEntity(parentId) : null;
    let locSys = [
        'You are writing the entry for a single location named "' + name + '"' + (parentEnt ? (' inside "' + parentEnt.name + '"') : '') + ' in a story world.',
        'Output exactly two labelled blocks and nothing else:\nDESC: <1-2 sentences of scene-present description — what a person directly sees, hears, and senses on arrival. Keep it short.>\nLORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, who or what is here, how it connects to the wider world, and any secrets or tensions>',
        'Stay focused on THIS location, drawing on the specific ideas in the reference context. Do not add any other labels, preamble, or commentary.'
    ].join('\n\n');
    let locUsr: string[] = [];
    if (ctx.trim()) locUsr.push(ctx);
    if (hint && hint.trim()) locUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    locUsr.push('Write the DESC and LORE for "' + name + '" now.');
    let locRes = '';
    try {
        locRes = await executeYoinkGeneration([{ role: 'system', content: locSys }, { role: 'user', content: locUsr.join('\n\n') }], { validator: function(r) { return /DESC:|LORE:/i.test(r); }, tag: 'locationNamed:' + name });
    } catch (eLocReg) {
        api.v1.error('[AE:wizard] location generation failed:', eLocReg);
        return null;
    }
    let locOutRaw = (locRes || '').trim();
    if (!locOutRaw) return null;
    let rde = locOutRaw.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
    let rlo = locOutRaw.match(/LORE:\s*([\s\S]+)/i);
    let newDesc = rde ? rde[1].trim() : '';
    newDesc = newDesc.replace(/\nLORE:[\s\S]*$/i, '').trim();
    let newLore = rlo ? rlo[1].trim() : '';
    if (!newDesc && !newLore) { newLore = locOutRaw; }
    return { description: newDesc, lore: newLore };
}

// Stage ONE named place as a draft, under the tab's current parent.
async function stageLocationNamed(name: string, parentId: string | null, sourceChatIds: string[], hint: string): Promise<string[]> {
    let glName = String(name || '').trim().substring(0, 60);
    if (!glName) return [];
    let got = await generateLocationNamed(glName, parentId, sourceChatIds, hint);
    if (!got) return [];
    return await addWizardDrafts('location', [{ name: glName, description: got.description, lore: got.lore }], sourceChatIds, parentId || null);
}

async function regenerateWizardLocation(locId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let ent = await loadEntity(locId);
    if (!ent) return null;
    let got = await generateLocationNamed(ent.name, ent.parentId || null, sourceChatIds, hint);
    if (!got) return null;
    let newDesc = got.description;
    let newLore = got.lore;
    let freshEnt = await loadEntity(locId);
    if (!freshEnt) return null;
    if (newDesc) freshEnt.description = newDesc;
    if (newLore) (freshEnt as any).lorebookText = newLore;
    await saveEntity(freshEnt);
    if (newLore) {
        if ((freshEnt as any).lorebookEntryId) await syncEntityLorebookEntry(locId, true).catch(function() {});
        else await createLinkedEntityLorebookEntry(locId).catch(function() {});
    }
    return newLore || newDesc;
}

// ── World-Build Wizard: Characters (seed-and-go via comprehensive concept dump) ──
// Flow: generate names from chat (dedup) -> per character, generate a
// comprehensive concept dump from chat -> derive all dramatis-personae + static fields
// from THAT dump (not chat) -> create the character (entity body + record + lorebook).
// The dump is the persistent source; later per-field regens in the editor read it.

interface WizardCharFields {
    species: string; age: string; gender: string; occupationRole: string; briefDescription: string;
    physicalDescription: string; personalityCore: string; voiceAndMannerisms: string; background: string;
    coreValues: string[];
}

async function generateCharacterDump(name: string, sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let dumpSys = [
        'You are assembling a COMPREHENSIVE concept profile (a "concept dump") for a single character named "' + name + '" based entirely on the brainstorming context.',
        'Organize EVERYTHING the context establishes or implies about ' + name + ' into one thorough, well-structured profile: who they are, anatomical appearance, psychological contradictions, vocal timbre, formative history, relationships, and goals.',
        'CRITICAL RULE: Write entirely in plain prose. DO NOT use markdown, bolding, italics, or bullet points. DO NOT invent tragic backstories or cliché tropes unless explicitly stated in the context.',
        'Output ONLY the plain prose profile for ' + name + '. No preamble, no headers, no commentary.'
    ].join('\n\n');
    let dumpUsr: string[] = [];
    if (ctx.trim()) dumpUsr.push(ctx);
    dumpUsr.push('Write the comprehensive concept profile for "' + name + '" now.');
    let dumpRaw = '';
    try { dumpRaw = await executeYoinkGeneration([{ role: 'system', content: dumpSys }, { role: 'user', content: dumpUsr.join('\n\n') }], { tag: 'charDump:' + name }); }
    catch (eCharDump) { api.v1.error('[AE:wizard] character dump failed:', eCharDump); return ''; }
    return (dumpRaw || '').trim();
}

async function generateCharacterFields(name: string, dump: string): Promise<WizardCharFields | null> {
    if (!(dump || '').trim()) return null;
    let fieldSys = [
        'You are filling structured fields for the character "' + name + '", extracting data ONLY from the concept profile provided. Do not contradict it; where the profile is silent, infer the most fitting objective value.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, or italics. Output EXACTLY these labelled lines, in this exact order, and nothing else:\n' +
        'SPECIES: <one or two words>\n' +
        'AGE: <a number or short phrase>\n' +
        'GENDER: <short>\n' +
        'ROLE: <occupation or role, a few words>\n' +
        'BRIEF: <one tight sentence identifying who they are at a glance>\n' +
        'PHYSICAL: <Camera-view physical anatomy, skin, hair, eyes, and build. Sensual or striking details if applicable. No clothing. No mannerisms.>\n' +
        'PERSONALITY: <Psychological baseline and a core contradiction/hidden facet. No tragic tropes. Declarative.>\n' +
        'VOICE: <Vocal timbre, speech rhythm, and one signature physical mannerism.>\n' +
        'BACKGROUND: <One or two formative past events that shaped their current worldview. Past tense.>\n' +
        'VALUES: <3-5 deeply held values, semicolon-separated>'
    ].join('\n\n');
    let fieldUsr = '--- CONCEPT PROFILE ---\n' + dump.trim() + '\n\nFill the fields for "' + name + '" now.';
    let fieldRaw = '';
    try { fieldRaw = await executeYoinkGeneration([{ role: 'system', content: fieldSys }, { role: 'user', content: fieldUsr }], { validator: function(r) { return /SPECIES:|BRIEF:/i.test(r); }, tag: 'charFields:' + name }); }
    catch (eCharFields) { api.v1.error('[AE:wizard] character fields failed:', eCharFields); return null; }

    function parseCharFields(txt: string): Record<string, string> {
        let labels = ['SPECIES', 'AGE', 'GENDER', 'ROLE', 'BRIEF', 'PHYSICAL', 'PERSONALITY', 'VOICE', 'BACKGROUND', 'VALUES'];
        let result: Record<string, string> = {};
        let fLines = (txt || '').split('\n');
        let cur = '';
        for (let fl of fLines) {
            let trimmed = fl.trim();
            let up = trimmed.toUpperCase();
            let hit = '';
            for (let lb of labels) { if (up.indexOf(lb + ':') === 0) { hit = lb; break; } }
            if (hit) { result[hit] = trimmed.slice(hit.length + 1).trim(); cur = hit; }
            else if (cur && trimmed) { result[cur] = (result[cur] ? result[cur] + ' ' : '') + trimmed; }
        }
        return result;
    }

    let parsed = parseCharFields(fieldRaw);
    let valuesRaw = parsed['VALUES'] || '';
    return {
        species: parsed['SPECIES'] || '', age: parsed['AGE'] || '', gender: parsed['GENDER'] || '',
        occupationRole: parsed['ROLE'] || '', briefDescription: parsed['BRIEF'] || '',
        physicalDescription: parsed['PHYSICAL'] || '', personalityCore: parsed['PERSONALITY'] || '',
        voiceAndMannerisms: parsed['VOICE'] || '', background: parsed['BACKGROUND'] || '',
        coreValues: valuesRaw.split(';').map(function(s) { return s.trim(); }).filter(Boolean)
    };
}

async function createWizardCharacter(name: string, dump: string, fields: WizardCharFields | null): Promise<string> {
    let cfg = await loadConfig();
    // [ENT-ID1] CHARACTER FIRST, THEN THE BODY AT THE SAME ID. Order reversed from
    // the original: the body used to be minted with its own generateId() and the pointer
    // written afterwards, which is the arrangement that made a stale pointer expressible
    // at all. There is one id now, and entityId is a mirror of it kept only so the ~60
    // existing readers and the bridge payloads keep working until the union pass.
    let ch = makeDefaultCharacter(name, cfg);
    let body = makeDefaultEntity(name);
    body.id = ch.id;
    body.type = 'character';
    body.parentId = null;
    await saveEntity(body);
    ch.entityId = body.id;
    ch.conceptDump = dump || '';
    if (fields) {
        ch.species = fields.species || '';
        ch.age = fields.age || '';
        ch.gender = fields.gender || '';
        ch.occupationRole = fields.occupationRole || '';
        ch.briefDescription = fields.briefDescription || '';
        ch.physicalDescription = fields.physicalDescription || '';
        ch.personalityCore = fields.personalityCore || '';
        ch.voiceAndMannerisms = fields.voiceAndMannerisms || '';
        ch.background = fields.background || '';
        ch.coreValues = fields.coreValues || [];
    }
    await saveCharacter(ch);
    try { await createLinkedLorebookEntry(ch.id); } catch (eCharLb) { /* non-fatal */ }
    return ch.id;
}

// Generate ONE character end-to-end (dump from chat -> fields from dump -> create).
async function runWizardCharacterSingle(name: string, sourceChatIds: string[]): Promise<boolean> {
    let nm = (name || '').trim();
    if (!nm) return false;
    let dump = await generateCharacterDump(nm, sourceChatIds);
    let fields = await generateCharacterFields(nm, dump);
    await createWizardCharacter(nm, dump, fields);
    return true;
}

// Batch: names from chat (dedup) -> each character end-to-end. Returns count created.
// [CHAR-STAGE] Now a thin stage -> commit wrapper, committing only its own drafts.
// The per-character dump/field calls still happen, just split across the two halves.

// ── World-Build Wizard: Intro / Opening scene ────────────────────────────────
// Pick where the story opens and who is present; generate the opening
// prose (yoink, budget-free), place the player + cast there, and insert into the editor.

async function generateIntroProse(locationId: string, charIds: string[], sourceChatIds: string[]): Promise<string> {
    let cfg = await loadConfig();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let loc = locationId ? await loadEntity(locationId) : null;
    let allChars = await loadAllCharacters();
    let protag = allChars.find(function(c) { return c.isProtagonist; });
    let castLines: string[] = [];
    for (let cid of (charIds || [])) {
        let ch = allChars.find(function(c) { return c.id === cid; });
        if (!ch) continue;
        castLines.push('- ' + ch.name + (ch.briefDescription ? (': ' + ch.briefDescription) : ''));
    }
    let introSys: string[] = [
        'You are writing the OPENING of an interactive story \u2014 the very first scene, in immersive second-person present tense ("You ...") from the protagonist\'s point of view.',
        'Establish the setting, mood, and immediate situation, and bring any present characters to life through concrete action and detail. Start *in media res* (already in the location, mid-action). End on a beat that invites the player to act; do not resolve the situation.',
        'CRITICAL RULE: Avoid all backstory, lore-dumping, and exposition. DO NOT use any markdown, bolding, italics, or headings.'
    ];
    if (loc) {
        let locLore = ((loc as any).lorebookText || '').trim();
        introSys.push('SETTING (where the scene opens):\n' + loc.name + ((loc.description || '').trim() ? (' \u2014 ' + loc.description.trim()) : '') + (locLore ? ('\nBackground: ' + locLore) : ''));
    }
    if (protag) {
        introSys.push('THE PROTAGONIST ("you"):\n' + protag.name + ((protag.briefDescription || '').trim() ? (': ' + protag.briefDescription.trim()) : ''));
    }
    if (castLines.length) introSys.push('PRESENT IN THE SCENE:\n' + castLines.join('\n'));
    introSys.push('Write 2-4 vivid paragraphs. Output ONLY the opening prose \u2014 no title, headings, labels, or commentary.');
    let introUsr: string[] = [];
    if (ctx.trim()) introUsr.push(ctx);
    introUsr.push('Write the opening scene now.');
    let introRaw = '';
    try { introRaw = await executeYoinkGeneration([{ role: 'system', content: introSys.join('\n\n') }, { role: 'user', content: introUsr.join('\n\n') }], { tag: 'introProse' }); }
    catch (eIntroGen) { api.v1.error('[AE:wizard] intro generation failed:', eIntroGen); return ''; }
    return (introRaw || '').trim();
}

// Generate prose first (so a failure leaves world state untouched), then place
// the cast + player, then insert the prose into the story editor as paragraphs.
// [INTRO-STAGE] The intro generator now stages its output like the other wizard
// tabs: generate -> review/edit/regenerate -> commit. generateIntroDraft yoinks the opening
// prose and stores it as an editable draft WITHOUT touching the story; commitIntroDraft
// travels the player in and writes the (possibly edited) draft, then clears it.
async function generateIntroDraft(locationId: string, sourceChatIds: string[]): Promise<boolean> {
    if (!locationId) { api.v1.ui.toast('Pick an intro location first.', { type: 'error', autoClose: 2500 }); return false; }
    let loc = await loadEntity(locationId);
    if (!loc) { api.v1.ui.toast('That location no longer exists.', { type: 'error', autoClose: 2500 }); return false; }
    // Cast placement removed — characters get intro locations set in their character cards.
    let prose = await generateIntroProse(locationId, [], sourceChatIds);
    if (!(prose || '').trim()) return false;
    // [STAGING] storyStorage, not tempStorage — a staged draft the user is asked
    // to review must survive a script reload / story switch.
    await api.v1.storyStorage.set(STORAGE_WIZ_INTRO_DRAFT, JSON.stringify({ locationId: locationId, prose: prose.trim() })).catch(function() {});
    return true;
}

// [STAGING] Read the staged intro draft, tolerating both the new storyStorage
// JSON string and any legacy tempStorage object left over from before the migration.
async function loadIntroDraft(): Promise<any> {
    let rawIntro = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_INTRO_DRAFT, '') as string;
    if (rawIntro && String(rawIntro).trim()) {
        try { return JSON.parse(rawIntro as string); }
        catch (eIntroParse) { api.v1.error('[AE:wizard] intro draft parse error:', eIntroParse); }
    }
    let legacyIntro = await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_INTRO_DRAFT, null) as any;
    if (legacyIntro && legacyIntro.locationId) return legacyIntro;
    return null;
}

async function commitIntroDraft(): Promise<boolean> {
    let draft = await loadIntroDraft();
    if (!draft || !draft.locationId || !((draft.prose || '') as string).trim()) { api.v1.ui.toast('No intro draft to commit.', { type: 'error', autoClose: 2500 }); return false; }
    let loc = await loadEntity(draft.locationId);
    if (!loc) { api.v1.ui.toast('That location no longer exists.', { type: 'error', autoClose: 2500 }); return false; }
    await commitTravel(draft.locationId, true);
    let introParas = String(draft.prose).split(/\n\n+/);
    for (let para of introParas) {
        if (para.trim()) { await api.v1.document.appendParagraph({ text: para.trim() }).catch(function() {}); }
    }
    await api.v1.storyStorage.remove(STORAGE_WIZ_INTRO_DRAFT).catch(function() {});
    await api.v1.tempStorage.remove(STORAGE_WIZ_INTRO_DRAFT).catch(function() {});
    return true;
}


// ── World-Build Wizard: Drama (hooks, NPC web, narrative threads) ─────────────
// [vNEXT] The Drama wizard seeds the three primitives the live Drama tab and the
// dynamic engine maintain: per-character UnresolvedHooks, bilateral WebLinks, and
// narrative-thread entities. Hooks and web links are CHARACTER-AWARE — the generators
// are fed the established roster and must resolve to real records; nothing is written
// against a person who does not exist. Seeded hooks deliberately mirror the dynamic
// engine's spawn shape (pressure 20-50, one concrete directed sentence) so they read
// identically to tension the engine raises later during play.

// Compact cast roster for drama generators: protagonist marked, each active character
// on one identifying line. Shared context so generated tensions reference real people.
function buildWizardCastContext(allChars: CharacterRecord[]): string {
    let castLines: string[] = [];
    let castProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (castProtag) {
        let pBrief = (castProtag.briefDescription || '').trim();
        castLines.push('PROTAGONIST (the player, "you"): ' + castProtag.name + (pBrief ? (' — ' + pBrief) : ''));
    }
    for (let cc of allChars) {
        if (cc.isProtagonist) continue;
        if (!cc.active) continue;
        let ccBrief = (cc.briefDescription || '').trim();
        let ccRole = (cc.occupationRole || '').trim();
        let ccTail = ccBrief ? (' — ' + ccBrief) : (ccRole ? (' — ' + ccRole) : '');
        castLines.push('- ' + cc.name + ccTail);
    }
    if (castLines.length === 0) return '';
    return '--- CAST ---\n' + castLines.join('\n');
}

// Resolve a generated target name to the canonical hook target: the protagonist maps
// to the '__player__' token (the Drama tab and injection logic expect it); an exact
// cast name/nickname maps to that name; anything else is kept verbatim (the engine
// tolerates free-text targets so a near-miss is still editable rather than dropped).
// [HOOK-TARGETID] REPLACES resolveHookTarget, which returned ONE string doing two
// incompatible jobs — a display name for a cast member, but the raw id '__player__' for the
// protagonist. Every caller then had to know which it had received, and two callers didn't
// (see the UnresolvedHook comment). This returns the pair the record now stores, so no
// caller has to decide.
// UNRESOLVED IS NOT AN ERROR: a name the cast does not contain comes back as
// { id: '', name: <what the model said> }, which is exactly the free-text state the picker
// also produces. 'none' / 'n/a' come back as a fully empty ref.
function resolveHookTargetRef(raw: string, allChars: CharacterRecord[]): { id: string; name: string } {
    let rt = (raw || '').trim();
    if (!rt) return { id: '', name: '' };
    let rtLow = rt.toLowerCase();
    if (rtLow === 'none' || rtLow === 'n/a') return { id: '', name: '' };
    let rtProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (rtProtag && (rtLow === rtProtag.name.toLowerCase() || rtLow === 'the protagonist' || rtLow === 'protagonist' || rtLow === 'you' || rtLow === 'the player' || rtLow === 'player')) {
        return { id: CE_PROTAGONIST_REF, name: rtProtag.name || 'the protagonist' };
    }
    for (let rc of allChars) {
        if (rc.isProtagonist) continue;
        if (rc.name.toLowerCase() === rtLow) return { id: rc.id, name: rc.name };
        if ((rc.nicknames || []).some(function(n) { return (n || '').toLowerCase() === rtLow; })) return { id: rc.id, name: rc.name };
    }
    return { id: '', name: rt };
}

// [HOOK-ONE] Legacy `hooks[]` -> the one `hook`. THE ONE IMPLEMENTATION: both
// migrateCharacter (sync, per load, silent, also covers plain-JSON import) and the stamped
// v4 pass call this and nothing else collapses.
//
// HIGHEST UNRESOLVED WINS, not first. An author who wrote three kept adding because none
// of them was firing, so the one nearest the cap is the one they were waiting on. A hook
// flagged resolved:true is dropped outright — under the old model that flag left the
// record in place and froze the character out of ever spawning another, which is the bug
// this collapse exists to end, not one to carry forward.
//
// pressureLevel is copied VERBATIM. This runs before the v3 rescale on an unstamped story,
// so converting here would divide an already-converted value and floor every hook to 0.
var _ceHookDropped = 0;   // extras discarded; drained once by ceMigrateHooks for its toast

function _ceCollapseLegacyHooks(arr: any): any {
    if (!Array.isArray(arr) || !arr.length) return null;
    var live: any[] = [];
    for (var i = 0; i < arr.length; i++) {
        if (arr[i] && !arr[i].resolved) live.push(arr[i]);
    }
    if (!live.length) return null;
    var best = live[0];
    for (var j = 1; j < live.length; j++) {
        if ((Number(live[j].pressureLevel) || 0) > (Number(best.pressureLevel) || 0)) best = live[j];
    }
    if (live.length > 1) {
        _ceHookDropped += (live.length - 1);
        aeLog('[AE:hookone] kept 1 of ' + live.length + ' hooks; dropped: '
            + live.filter(function(x: any) { return x !== best; })
                  .map(function(x: any) { return String(x.description || '').substring(0, 60); }).join(' | '));
    }
    if (best.resolved !== undefined) delete best.resolved;
    if (best.surfacedCount !== undefined) delete best.surfacedCount;
    return best;
}

// [HOOK-TIER] The one tier label. Five rungs, named rather than numbered, because
// "3" is not a thing an author has any way to calibrate and "Pressing" is. Kept beside the
// target resolver for the same reason that one exists: two call sites hand-rolling this
// is how they drift.
function _ceHookTierLabel(tier: any): string {
    var t = Math.max(0, Math.min(4, Number(tier) || 0));
    return ['Noticed', 'Simmering', 'Pressing', 'Urgent', 'Breaking point'][t];
}

// The one display resolver. '__player__' is an id and has no name of its own, so anything
// that puts a hook target in front of the model or the user resolves it HERE rather than
// hand-rolling the ternary — which is precisely how two call sites came to lack one.
function _ceHookTargetLabel(hook: any, cfg: any): string {
    if (!hook) return 'someone';
    if (ceIsProtagonistRef(hook.targetId)) {
        return String((cfg && cfg.protagonistName) || 'the protagonist');
    }
    return String(hook.targetName || '') || 'someone';
}

// Resolve a generated name to an existing character id (protagonist included), or ''.
function findWizardCharIdByName(allChars: CharacterRecord[], raw: string): string {
    let fn = (raw || '').trim().toLowerCase();
    if (!fn) return '';
    let fProtag = allChars.find(function(c) { return c.isProtagonist; });
    if (fProtag && (fn === 'the protagonist' || fn === 'protagonist' || fn === 'you' || fn === 'the player' || fn === 'player')) return fProtag.id;
    for (let fc of allChars) {
        if (fc.name.toLowerCase() === fn) return fc.id;
        if ((fc.nicknames || []).some(function(n) { return (n || '').toLowerCase() === fn; })) return fc.id;
    }
    return '';
}

// [vNEXT] Generate ONE starting hook for a character: a concrete unresolved tension
// directed at another existing cast member or the protagonist. Mirrors the dynamic
// engine's hook-spawn prompt for tonal parity. Returns {targetId, targetName, description,
// pressureLevel} (the target ref already resolved) or null when no clean tension exists.
async function generateCharacterHook(char: CharacterRecord, sourceChatIds: string[], hint: string): Promise<{ targetId: string; targetName: string; description: string; pressureLevel: number } | null> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let cast = buildWizardCastContext(allChars);
    let dump = (char.conceptDump || '').trim();

    let hookSys = [
        'You are a dramaturg seeding the OPENING dramatic tension for the character "' + char.name + '" at the very start of a story.',
        'Identify ONE specific, unresolved tension this character carries toward another person: a conflict, a threat they pose or face, a debt, a secret they guard, a betrayal, or an urgent unfulfilled want. Passive moods and general feelings do NOT qualify. It must be directed at a named person and demand eventual action.',
        'The target MUST be one of the established cast, named EXACTLY as written, OR the protagonist. Do not invent a new person.',
        'Write the hook as a single, punchy sentence naming the core tension in concrete terms: what happened, what is owed, what is at stake.',
        '  Wrong: "feels uneasy about her place in the household"',
        '  Right: "Owes the magister a debt she cannot pay, and the collector arrives within the week"',
        'If this character has no plausible directed tension, set the target to "None".',
        // [PRESSURE] No PRESSURE line asked for or parsed — a fresh hook is
        // fixed at tier 1 by runWizardHookSingle, not guessed by the model.
        'CRITICAL RULE: DO NOT use any markdown, bolding, italics, or bullet points. Output EXACTLY these two labelled lines and nothing else:\nTARGET: <exact cast name, the protagonist, or None>\nHOOK: <one concrete sentence>'
    ].join('\n\n');

    let hookUsr: string[] = [];
    if (cast) hookUsr.push(cast);
    if (dump) hookUsr.push('--- ' + char.name.toUpperCase() + ' (concept profile) ---\n' + dump);
    if (ctx.trim()) hookUsr.push(ctx);
    if (hint && hint.trim()) hookUsr.push('--- EXTRA GUIDANCE FOR THIS REGENERATION ---\n' + hint.trim());
    hookUsr.push('Write the opening hook for "' + char.name + '" now.');

    let hookRaw = '';
    try { hookRaw = await executeYoinkGeneration([{ role: 'system', content: hookSys }, { role: 'user', content: hookUsr.join('\n\n') }], { tag: 'wizHookSeed:' + char.name }); }
    catch (eHookGen) { api.v1.error('[AE:wizard] hook generation failed (' + char.name + '):', eHookGen); return null; }

    function parseHookFields(txt: string): { target: string; hook: string } {
        let pTarget = ''; let pHookLines: string[] = []; let pCur = '';
        let pLines = (txt || '').split('\n');
        for (let pl of pLines) {
            let pt = pl.trim();
            let pu = pt.toUpperCase();
            if (pu.indexOf('TARGET:') === 0) { pTarget = pt.slice(7).trim(); pCur = 'target'; }
            else if (pu.indexOf('HOOK:') === 0) { let hb = pt.slice(5).trim(); if (hb) pHookLines.push(hb); pCur = 'hook'; }
            else if (pCur === 'hook' && pt) { pHookLines.push(pt); }
        }
        return { target: pTarget, hook: pHookLines.join(' ').trim() };
    }

    let parsedHook = parseHookFields(hookRaw);
    let resolvedTarget = resolveHookTargetRef(parsedHook.target, allChars);
    if (!resolvedTarget.name || !parsedHook.hook) return null;
    return { targetId: resolvedTarget.id, targetName: resolvedTarget.name,
             description: parsedHook.hook, pressureLevel: 1 };
}

// Seed (or reseed) the starting hook on one character. Stamps lastHookGen with the
// current story gen count so the escalator picks it up on schedule.
async function runWizardHookSingle(charId: string, sourceChatIds: string[], hint: string): Promise<boolean> {
    let baseChar = await loadCharacter(charId);
    if (!baseChar) return false;
    let gen = await generateCharacterHook(baseChar, sourceChatIds, hint);
    if (!gen) return false;
    let freshHookChar = await loadCharacter(charId);
    if (!freshHookChar) return false;
    let gc = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
    // [PRESSURE] historyStorage is the source of truth from creation.
    // [HOOK-LIFE] Tier 1 — 0 means resolved. See generateHookUpdates' spawn branch.
    await api.v1.historyStorage.set(_cePressureKey(charId, 'hook'), 1);
    freshHookChar.hook = {
        id: api.v1.uuid(),
        targetId: gen.targetId || '',
        targetName: gen.targetName,
        description: (gen.description || '').substring(0, 300),
        pressureLevel: 1,
        developmentNotes: []
    };
    freshHookChar.lastHookGen = Number(gc) || 0;
    await saveCharacter(freshHookChar);
    return true;
}

// [vNEXT] Seed one hook on each selected character. Returns the count successfully seeded.
// [GEN-GUIDED] runWizardHooksBatch DELETED. It was never a batch generation — a
// `for` loop calling runWizardHookSingle once per character, i.e. N independent model calls
// reported through ONE aggregate toast, so a character the scan found nothing for was
// indistinguishable from one it succeeded on. The per-row Reseed button does the identical
// work and names the character in both its progress and its result. Its multi-select
// (the ae_wiz_hook_chars key, the store's hookSel, the per-row ceToggle) went with it.

// [vNEXT] Generate a batch of bilateral cast dynamics (NPC web). Each names two distinct
// existing people and one concrete charged sentence between them. Parsed from labelled
// A:/B:/DYNAMIC: blocks. Mapping to ids + dedup happens in runWizardWebBatch.
// [WEB-FLATTEN] The PRIORITY: key is no longer asked for or parsed. dMatch's
// terminator alternation still names it defensively so a stray line from an older
// model habit cannot be swallowed into the dynamic sentence.
async function generateWebBatch(count: number, sourceChatIds: string[]): Promise<{ aName: string; bName: string; dynamic: string }[]> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let cast = buildWizardCastContext(allChars);
    if (!cast) return [];

    let webSys: string[] = [
        'You are a dramaturg defining the web of bilateral dynamics between the established cast of a story.',
        'Produce EXACTLY ' + count + ' distinct PAIR dynamics. Each names two DIFFERENT people from the cast below (the protagonist may be one of them) and states the charged relationship between them in one concrete sentence.',
        'Focus on friction, history, and asymmetry: rivalries, old debts, unspoken attraction, divided loyalty, mutual dependence. Avoid bland "they are friends" pairings, and do not repeat the same pair twice.',
        'CRITICAL RULE: DO NOT use any markdown, bolding, or bullet points. Output plain text only.',
        'FORMAT: for each pair output exactly:\nA: <exact cast name>\nB: <exact cast name>\nDYNAMIC: <one concrete sentence>\nSeparate pairs with a line containing only ---',
        'Output ONLY the pairs in that format. No preamble, no numbering, no commentary.'
    ];

    let webUsr: string[] = [];
    if (ctx.trim()) webUsr.push(ctx);
    webUsr.push('Generate ' + count + ' bilateral dynamics now.');

    let webRaw = '';
    try { webRaw = await executeYoinkGeneration([{ role: 'system', content: webSys.join('\n\n') }, { role: 'user', content: webUsr.join('\n\n') }], { tag: 'webBatch' }); }
    catch (eWebGen) { api.v1.error('[AE:wizard] web batch generation failed:', eWebGen); return []; }

    let webOut: { aName: string; bName: string; dynamic: string }[] = [];
    let webChunks = (webRaw || '').split(/\n-{3,}\n/);
    for (let wch of webChunks) {
        let aMatch = wch.match(/(?:^|\n)\s*A:\s*(.+)/i);
        let bMatch = wch.match(/(?:^|\n)\s*B:\s*(.+)/i);
        let dMatch = wch.match(/DYNAMIC:\s*([\s\S]+?)(?:\nPRIORITY:|$)/i);
        if (!aMatch || !bMatch) continue;
        let aNm = aMatch[1].trim();
        let bNm = bMatch[1].trim();
        let dyn = dMatch ? dMatch[1].trim().replace(/\n-{3,}[\s\S]*$/, '').trim() : '';
        if (aNm && bNm) webOut.push({ aName: aNm, bName: bNm, dynamic: dyn });
    }
    return webOut;
}

// [vNEXT] Generate web dynamics, map names to existing character ids, drop self-pairs,
// unresolved names, and pairs already present (unordered). Returns the count added.
async function runWizardWebBatch(count: number, sourceChatIds: string[]): Promise<number> {
    let allChars = await loadAllCharacters();
    let pairs = await generateWebBatch(count, sourceChatIds);
    if (pairs.length === 0) return 0;
    let web = await loadNpcWeb();
    let webMade = 0;
    for (let wp of pairs) {
        let aId = findWizardCharIdByName(allChars, wp.aName);
        let bId = findWizardCharIdByName(allChars, wp.bName);
        if (!aId || !bId || aId === bId) continue;
        let already = web.some(function(l) { return (l.charA_id === aId && l.charB_id === bId) || (l.charA_id === bId && l.charB_id === aId); });
        if (already) continue;
        web.push({ id: api.v1.uuid(), charA_id: aId, charB_id: bId, dynamic: (wp.dynamic || '').substring(0, 300) });
        webMade++;
    }
    if (webMade > 0) await saveNpcWeb(web);
    return webMade;
}

// [vNEXT] Regenerate the dynamic sentence on ONE existing web link in place (no new link).
async function regenerateWebLink(linkId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let allChars = await loadAllCharacters();
    let web = await loadNpcWeb();
    let link = web.find(function(l) { return l.id === linkId; });
    if (!link) return null;
    let wa = allChars.find(function(c) { return c.id === link.charA_id; });
    let wb = allChars.find(function(c) { return c.id === link.charB_id; });
    if (!wa || !wb) return null;
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let regSys = [
        'You are writing the charged bilateral dynamic between "' + wa.name + '" and "' + wb.name + '" in a story.',
        'State their relationship in one concrete sentence — friction, history, or asymmetry. Avoid bland pairings.',
        'Output ONLY the single sentence. No names prefix, no label, no markdown.'
    ].join('\n\n');
    let regUsr: string[] = [];
    if (ctx.trim()) regUsr.push(ctx);
    if (hint && hint.trim()) regUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    regUsr.push('Write the dynamic between "' + wa.name + '" and "' + wb.name + '" now.');
    let regRaw = '';
    try { regRaw = await executeYoinkGeneration([{ role: 'system', content: regSys }, { role: 'user', content: regUsr.join('\n\n') }], { tag: 'webLinkRegen:' + wa.name + '-' + wb.name }); }
    catch (eWebReg) { api.v1.error('[AE:wizard] web regen failed:', eWebReg); return null; }
    let regTxt = (regRaw || '').trim();
    if (!regTxt) return null;
    let web2 = await loadNpcWeb();
    let t2 = web2.find(function(l) { return l.id === linkId; });
    if (t2) { t2.dynamic = regTxt.substring(0, 300); await saveNpcWeb(web2); }
    return regTxt;
}

// [vNEXT] Generate a batch of narrative-thread descriptors. Each is a short name, a
// story state (locked/active/completed), and a 1-2 sentence current-situation hook.
// Parsed from labelled NAME:/STATE:/DESC: blocks. Records are created in runWizard...Batch.
async function addBlankWizardNarrative(): Promise<string> {
    let blankEnt = makeDefaultEntity('New Thread');
    blankEnt.type = 'narrative';
    blankEnt.storyState = 'locked';
    blankEnt.narrativeParentId = null;
    await saveEntity(blankEnt);
    return blankEnt.id;
}

// [GEN-GUIDED] ONE NAMED THREAD, composed from two verbs that already exist:
// create the entity, then let the single-thread writer fill its situation. Nothing new is
// prompted for, and the batch's NAME:/STATE:/DESC: split is not involved. State opens at
// 'locked', which is what makeDefaultEntity already sets and what the batch prompt itself
// called the usual answer.
async function stageNarrativeNamed(name: string, sourceChatIds: string[]): Promise<boolean> {
    let snName = String(name || '').trim().substring(0, 80);
    if (!snName) return false;
    let ent = makeDefaultEntity(snName);
    ent.type = 'narrative';
    ent.storyState = 'locked';
    ent.narrativeParentId = null;
    await saveEntity(ent);
    let got = await regenerateNarrativeThread(ent.id, sourceChatIds, '');
    return !!got;
}

// [vNEXT] Regenerate ONE narrative thread's situation description in place.
async function regenerateNarrativeThread(entId: string, sourceChatIds: string[], hint: string): Promise<string | null> {
    let cfg = await loadConfig();
    let nEntity = await loadEntity(entId);
    if (!nEntity || nEntity.type !== 'narrative') return null;
    let ctx = await buildWizardMultiContext(sourceChatIds, cfg);
    let nSys = [
        'You are writing the current situation of the narrative thread "' + nEntity.name + '" in a story.',
        'State in one to two concrete sentences what this thread is and what it pushes the player toward right now — unresolved, never a summary of how it ends.',
        'Output ONLY the description prose. No name prefix, no label, no markdown.'
    ].join('\n\n');
    let nUsr: string[] = [];
    if (ctx.trim()) nUsr.push(ctx);
    if (hint && hint.trim()) nUsr.push('--- EXTRA GUIDANCE ---\n' + hint.trim());
    nUsr.push('Write the situation for "' + nEntity.name + '" now.');
    let nRaw = '';
    try { nRaw = await executeYoinkGeneration([{ role: 'system', content: nSys }, { role: 'user', content: nUsr.join('\n\n') }], { tag: 'narrativeRegen:' + nEntity.name }); }
    catch (eNarrReg) { api.v1.error('[AE:wizard] narrative regen failed:', eNarrReg); return null; }
    let nTxt = (nRaw || '').trim();
    if (!nTxt) return null;
    let nFresh = await loadEntity(entId);
    if (nFresh) { nFresh.description = nTxt; await saveEntity(nFresh); }
    return nTxt;
}



// ── Emotion Resolution ────────────────────────────────────────────────────────

function resolveEmotion(raw: any): string {
    if (!raw) return 'neutral';
    const key = String(raw).toLowerCase().trim().replace(/[^a-z_]/g, '');
    return EMOTION_MAP[key] || 'neutral';
}

// ── Entity Factory ────────────────────────────────────────────────────────────

function makeDefaultEntity(name: string): EntityRecord {
    // Returns a new EntityRecord with all required fields initialised to safe defaults.
    // callers typically override type, parentId, and description immediately after.
    return {
        id: generateId(),
        name: name,
        type: 'location',
        parentId: null,
        narrativeParentId: null,
        storyState: 'locked',
        description: '',

        connectedEntityIds: [],
        contextIds: [],
        locationType: '',
        ownerId: '',
        ownerKind: '',
        conceptDump: '',
        uiShape: '',
        fieldOrder: [],
        customFieldValues: {},
        // [CE-STRIP earlier] actions/rules/skillBonuses/showActionWidget/isVehicle/gated removed — dead Actions remnants.
        // encounters: removed earlier E4
        // [CE-STRIP LOC-PROFILE] knowledgeString DELETED alongside notes. It was
        // never declared on EntityRecord and was WRITTEN ONLY HERE -- the object-literal
        // type error that would have exposed it was masked by `notes`, which sat above it
        // and is the only property tsc reports per literal. Zero readers anywhere.
        lorebookTags: [],
        lorebookText: '',
        locationVisuals: '',
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
}

// ── Character Factory ─────────────────────────────────────────────────────────

function makeDefaultCharacter(name: string, cfg: GlobalConfig): CharacterRecord {
    // Returns a new CharacterRecord with all required fields initialised.
    const char: CharacterRecord = {
        id: api.v1.uuid(),
        name: name,
        conceptDump: '',
        nicknames: [],
        species: '',
        age: '',
        gender: '',
        occupationRole: '',
        briefDescription: '',
        visuals: '',
        uc: '',
        sceneVisuals: '',
        avatarVisuals: '',
        avatarWidth: 1024,
        avatarHeight: 1024,
        avatarSeed: 0,
        // Flags
        scenePresent: false,
        active: true,
        followCamera: false,   // [FOLLOW-CAM]
        pattern: '',           // [PATTERN-STORED]
        lorebookEntryId: undefined,
        // Static narrative
        physicalDescription: '',
        voiceAndMannerisms: '',
        personalityCore: '',
        background: '',
        customFieldValues: {},
        coreValues: [],
        // Relationships and hooks
        position: { targetId: '', targetName: '', shape: '', standing: '' },  // [POSITION]
        hook: null,   // [HOOK-ONE]
        stateValues: {},       // [SEC:STATE] empty is complete -- every read falls to the def's start
        // Dynamic state
        ephemeral: null,
        ephemeralHistory: [],
        lastEphemeralGen: 0,  // [E1]
        lastEphemeralTokens: 0, // 
        lastHookGen: 0,
        lastHookTokens: 0, // 
        // Equipment and resources
        equippedItemIds: [],
        // Sheet
        sheetValues: {},
        // Engine flags
        autoThoughtsEnabled: cfg.autoThoughtsDefault,
        hooksEnabled: true,
        // World graph
        entityId: undefined,
        createdAt: Date.now(),
        updatedAt: Date.now()
    };
    return char;
}

// ============================================================================
// SECTION 4b — NATIVE MODAL HELPERS
// [PICKER-ONE] ONE native UIPart construct is left in the file, not three.
//
//   openEngineModal    wraps api.v1.ui.modal.open and tells the bridge to hide
//                      behind it. Use this, never api.v1.ui.modal.open directly.
//                      ONE live caller: openLorebookImportPicker. (confirmDeleteChar
//                      was the second and is deleted -- earlier REACH.)
//
// openPickerModal is DELETED -- see the block below for why one picker architecture is
// the whole point. Everything else the author touches is a jsx surface (SECTIONS 28-37),
// and a jsx surface chooses from a list through CE_PICKER_DEFS, never through a modal.
// ============================================================================

// openEngineModal — the one wrapper around api.v1.ui.modal.open. It no longer signals
// the bridge: AE_MODAL_OPENED/CLOSED hid the HUD behind the modal and there is no HUD.
// Kept as the single door so a future modal-wide concern has one place to land.
async function openEngineModal(opts: any): Promise<any> {
    return await api.v1.ui.modal.open(opts);
}


// ============================================================================
// [PICKER-ONE] openPickerModal AND ITS TWO INTERFACES WERE HERE AND ARE DELETED.
//
// THIS FILE HAD TWO PICKER ARCHITECTURES. This was the older one: a native UIPart modal
// with its own search box, its own pinned-option block and its own selected-highlight,
// carrying a header that promised the scattered bespoke pickers would be migrated ONTO
// it. They were -- onto the OTHER one. CE_PICKER_DEFS + _cePickerSurface (SECTION 28) is
// the architecture every live chooser now uses, and by earlier this had exactly ONE caller
// left (openDynamicRankPicker), which was itself doorless and is deleted in the same
// patch.
//
// WHY DELETION AND NOT A MERGE. The whole point of one picker is that an improvement to
// it reaches every chooser at once. Two implementations means every improvement is made
// twice or made once and silently missed by half the surfaces -- which is exactly what
// happened here: the jsx picker's search matched only `label` and never `sub`, and this
// one matched both, for four versions, with nobody able to see the difference because no
// live surface rendered this one. A second implementation is not a fallback, it is a
// second place for the truth to live.
//
// DO NOT RE-ADD A NATIVE LIST MODAL. JSXPROFILE-NO-OVERLAY already forbids opening a
// UIPart modal from a jsx surface, and every surface in this file is a jsx surface now.
// If something needs to choose from a list, it gets a CE_PICKER_DEFS entry.
// ============================================================================

// ============================================================================
// SECTION 5 — STORAGE: CHARACTER DATA
// All reads and writes for CharacterRecord and the character index.
// Every function here operates on api.v1.storyStorage.
// ============================================================================

// ── Index (CharacterMeta[]) ───────────────────────────────────────────────────
// The index is the lightweight list used for sidebar rendering and fast lookups.
// Full CharacterRecord data lives in individual keys (STORAGE_CHAR_PFX + id).

async function loadIndex(): Promise<CharacterMeta[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_INDEX, []) as CharacterMeta[];
}

async function saveIndex(idx: CharacterMeta[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_INDEX, idx.filter(Boolean));
}

// ── Migration ─────────────────────────────────────────────────────────────────
// migrateCharacter runs every time a CharacterRecord is loaded from storage.
// It forward-migrates old save formats and ensures all required fields exist.
// Safe to call multiple times on the same record.

function migrateCharacter(raw: any, cfg: GlobalConfig): CharacterRecord {
    const d = makeDefaultCharacter('Unnamed', cfg);
    const c = { ...d, ...raw };

    // ── Deprecated field removal ──────────────────────────────────────────────
    delete (c as any).storyRole;
    delete (c as any).conditions;
    delete (c as any).activeConditionId;
    delete (c as any).tier;
    delete (c as any).budgetCap;
    delete (c as any).portraitKey;
    delete (c as any).homeLocationId;

    // ── Equipment migration (equippedItemId → equippedItemIds) ────────────────
    if (!c.equippedItemIds) {
        c.equippedItemIds = (c as any).equippedItemId ? [(c as any).equippedItemId] : [];
    }
    delete (c as any).equippedItemId;
    if ('equippedItems' in c) delete (c as any).equippedItems;
    if ('wardrobe' in c) delete (c as any).wardrobe;

    // ── earlier field guards ───────────────────────────────────────────────────

    // [SEC:STATE] charResourceDefs / charResourceValues DELETED, along with the
    // #gold -> #currency rewrite that was the only thing maintaining them. THEY WERE
    // NEVER DECLARED ON CharacterRecord and had no editor on any surface, native or jsx --
    // the two readers were buildCharMacroExtras' `res` map and its `conditionStates` join,
    // both of which iterated an array nothing could write, so both resolved empty for
    // every character in every story. Verified zero writers before deleting: the only
    // `charResourceDefs:` literal left in the file is inside batch worldbuild's
    // `kind === 'archetype'` branch, which pushes to cfg.npcArchetypes -- a config field
    // CE-STRIP removed, so that branch already wrote into nothing.
    // The primitive that replaces them is SECTION 7b; a character's values are
    // c.stateValues below.
    delete (c as any).charResourceDefs;
    delete (c as any).charResourceValues;
    if (!c.stateValues || typeof c.stateValues !== 'object') c.stateValues = {};

    // [F-09] activeConditions -> stateValues. Presence in the array WAS the on switch and
    // stage 0 was the mildest ACTIVE stage, so every stored index shifts up by one and
    // absence from the array becomes the value 0 it always meant. Ids carry over, so the
    // defId is already the right key. Orphans (a condition deleted out from under an active
    // state) are dropped here rather than written as a value with no def -- ceStateRowsForChar
    // would ignore them anyway, and a record should not carry a key nothing can read.
    if (Array.isArray((c as any).activeConditions)) {
        for (var aci = 0; aci < (c as any).activeConditions.length; aci++) {
            var ac: any = (c as any).activeConditions[aci];
            if (!ac || !ac.defId) continue;
            var acIdx = Number(ac.stageIndex);
            if (!isFinite(acIdx) || acIdx < 0) acIdx = 0;
            c.stateValues[String(ac.defId)] = Math.round(acIdx) + 1;
        }
        delete (c as any).activeConditions;
    }

    // ── Structural guards ─────────────────────────────────────────────────────
    // [HOOK-ONE] Array -> single field. Present here as well as in the stamped v4
    // pass because a record can also arrive from plain-JSON import, which never passes the
    // startup gate. Silent and sync (migrateCharacter is both); the v4 pass is what
    // reports. Preserves pressureLevel verbatim so it can still run BEFORE the v3 rescale.
    if (c.hook === undefined) c.hook = _ceCollapseLegacyHooks((c as any).hooks);
    if ((c as any).hooks !== undefined) delete (c as any).hooks;
    if (!c.ephemeralHistory) c.ephemeralHistory = [];
    // [MIDRANGE-RETIRE] Mid-range salvage. currentDesire / socialMask /
    // shiftedView were the only author-visible content the layer held, and all three are
    // MODEL-authored prose -- so they migrate into this character's journal (which already
    // folds into their own lorebook entry) rather than into a genesis slot. Writing model
    // text into a genesis slot is the "goal masquerading as a core" mistake the
    // ce_slot_drive -> ce_slot_pursuit migration below already avoids. baselineView is
    // dropped, not salvaged: it was a frozen scaffold for a diff that no longer happens.
    // migrateCharacter is SYNC and charJournalAddBubble is async, so the text is stashed
    // on the record here and drained by loadCharacter; the drain writes the record back
    // without midRange, so this fires exactly once per character.
    if ((c as any).midRange) {
        let _mrSalvage: string[] = [];
        let _mrOld: any = (c as any).midRange;
        if (_mrOld.currentDesire) _mrSalvage.push('Wanted: ' + String(_mrOld.currentDesire).trim());
        if (_mrOld.socialMask)    _mrSalvage.push('Presented as: ' + String(_mrOld.socialMask).trim());
        if (_mrOld.shiftedView)   _mrSalvage.push('Came to believe: ' + String(_mrOld.shiftedView).trim());
        if (_mrSalvage.length > 0) (c as any)._ceMidRangeSalvage = _mrSalvage.join('\n');
    }
    delete (c as any).midRange;
    delete (c as any).midRangeHistory;
    delete (c as any).lastMidrangeGen;
    delete (c as any).lastMidrangeTokens;
    delete (c as any).autoUpdateEnabled;
    
    // Purge old character arc properties from database memory
    delete (c as any).arcEnabled;
    delete (c as any).arcType;
    delete (c as any).developingAspects;
    delete (c as any).arcCurrentState;
    delete (c as any).arcTrajectory;
    delete (c as any).arcEndState;
    delete (c as any).arcMilestones;

    // [POSITION] primaryRelationship -> position. Six generator-owned fields
    // collapse into two author-owned ones, and the mapping is deliberately lossy in one
    // direction only: prose is CONCATENATED, never dropped, so nothing the author wrote
    // disappears — but nothing is reformatted either, because a migration that rewrites
    // an author's sentences is a migration that loses an argument with them later.
    //
    //   archetype + howItStarted                -> shape     (what it IS)
    //   currentStatus + trajectory + summary    -> standing  (where it stands)
    //   threads[]                               -> character journal, then dropped
    //   milestones[] / stageIndex / archetypeId -> dropped outright
    //
    // Tier starts at 0 and is NOT seeded. _ceSeedPressureFromRecord seeds from a tier the
    // record already carries, and primaryRelationship never carried one, so any seed would
    // be a number invented here and then read back as evidence — the one thing the
    // pressure model exists to prevent.
    //
    // targetId cannot be resolved here: migrateCharacter is SYNC and the name->id lookup
    // needs the index. The old free-text targetName is stashed for loadCharacter's async
    // drain instead, same sync-stash / async-drain shape the earlier mid-range salvage
    // proved out. Both stashes are consumed by the same one-shot write.
    if ((c as any).primaryRelationship && !(c as any).position) {
        let _prOld: any = (c as any).primaryRelationship;
        let _shapeParts: string[] = [];
        if (_prOld.archetype)     _shapeParts.push(String(_prOld.archetype).trim());
        if (_prOld.howItStarted)  _shapeParts.push(String(_prOld.howItStarted).trim());
        let _standParts: string[] = [];
        if (_prOld.currentStatus) _standParts.push(String(_prOld.currentStatus).trim());
        if (_prOld.trajectory)    _standParts.push('What is pushing it: ' + String(_prOld.trajectory).trim() + '.');
        if (_prOld.summary)       _standParts.push('The knot: ' + String(_prOld.summary).trim());
        (c as any).position = {
            targetId: '',
            targetName: String(_prOld.targetName || ''),
            shape: _shapeParts.join(' \u2014 '),
            standing: _standParts.join(' ')
        };
        let _prThreads: string[] = ((_prOld.threads || []) as any[])
            .map(function(t: any) { return String(t || '').trim(); }).filter(Boolean);
        if (_prThreads.length > 0) {
            (c as any)._cePositionSalvage = 'Open threads with '
                + (String(_prOld.targetName || '').trim() || 'their primary relationship') + ':\n'
                + _prThreads.map(function(t: string) { return '- ' + t; }).join('\n');
        }
        if ((c as any).position.targetName) (c as any)._cePositionResolve = (c as any).position.targetName;
    }
    delete (c as any).primaryRelationship;
    delete (c as any).relationshipHistory;
    delete (c as any).lastArcGen;
    delete (c as any).lastArcTokens;
    if (!(c as any).position) (c as any).position = { targetId: '', targetName: '', shape: '', standing: '' };
    // [HOOK-TARGETID] Hook target migration. NO STORAGE PASS NEEDED: an absent
    // targetId reads as '', which is the legal unresolved state. The ONE legacy encoding
    // that must not survive is targetName === '__player__' — a raw id sitting in the name
    // slot, which two generation-path readers were feeding to the model verbatim. It moves
    // to the id slot here and the name is left empty for _ceHookTargetLabel to resolve
    // against the live protagonist name, which is more correct than the string ever was.
    var _hk: any = (c as any).hook;
    if (_hk) {
        if (String(_hk.targetName || '') === CE_PROTAGONIST_REF) { _hk.targetId = CE_PROTAGONIST_REF; _hk.targetName = ''; }
        if (typeof _hk.targetId !== 'string') _hk.targetId = '';
    }
    if (!c.customFieldValues) c.customFieldValues = {};
    // [CORE-PURSUIT] Drive split into Core (what they will not let go of) and
    // Pursuit (the concrete objective now). The retired ce_slot_drive instruction asked for
    // something "specific enough to act on this scene", so every saved value is
    // pursuit-shaped — it moves to ce_slot_pursuit. Core deliberately starts EMPTY and is
    // re-authored: auto-populating it from a pursuit-shaped string would seed every existing
    // character with a Core that is really a goal, which is the exact failure the split
    // exists to remove. Guarded so a hand-authored Pursuit is never overwritten.
    if (c.customFieldValues['ce_slot_drive'] !== undefined) {
        if (!c.customFieldValues['ce_slot_pursuit']) c.customFieldValues['ce_slot_pursuit'] = c.customFieldValues['ce_slot_drive'];
        delete c.customFieldValues['ce_slot_drive'];
    }
    if (!c.sheetValues) c.sheetValues = {};
    if (!c.conceptDump) c.conceptDump = '';
    // The *Tokens stamps below were DELETED here from earlier through v2.53.x
    // (per-generation cadence had fully replaced per-token). They are reintroduced as an
    // opt-in alternative unit (dynamicIntervalMode === 'tokens') — deleting them would wipe
    // token progress on every character load. Default-to-0 instead, same as the gen stamps.
    if ((c as any).lastEphemeralTokens === undefined) (c as any).lastEphemeralTokens = 0;
    if ((c as any).lastHookTokens      === undefined) (c as any).lastHookTokens      = 0;
    if (c.lastEphemeralGen === undefined) c.lastEphemeralGen = 0;
    if (c.lastHookGen      === undefined) c.lastHookGen      = 0;
    if (c.hooksEnabled === undefined) c.hooksEnabled = true;

    // ── Visual field guards (earlier) ──────────────────────────────────────────
    if (!c.visuals)       c.visuals       = '';
    if (!c.uc)            c.uc            = '';
    if (!c.sceneVisuals)  c.sceneVisuals  = '';
    if (!c.avatarVisuals) c.avatarVisuals = '';
    if (c.avatarWidth  === undefined || c.avatarWidth  === null) c.avatarWidth  = 1024;
    if (c.avatarHeight === undefined || c.avatarHeight === null) c.avatarHeight = 1024;
    if (c.avatarSeed   === undefined || c.avatarSeed   === null) c.avatarSeed   = 0;

    return c as CharacterRecord;
}

// ── Load ──────────────────────────────────────────────────────────────────────

async function loadCharacter(id: string): Promise<CharacterRecord | null> {
    const raw = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + id);
    if (!raw) return null;
    const cfg = await loadConfig();
    const rec = migrateCharacter(raw, cfg);
    // [MIDRANGE-RETIRE] One-shot drain of the salvage stashed by
    // migrateCharacter, which is sync and cannot await the journal writer. Written back
    // with storyStorage.set rather than saveCharacter: this is a legacy-field strip, and
    // saveCharacter's index + lorebook rebuild is unnecessary churn on what is often a
    // cold read. After the write, raw no longer carries midRange, so the stash is never
    // set again for this character and the branch is skipped on every later load.
    // [POSITION] The same drain now also carries the relationship salvage and the
    // targetName -> targetId resolve, because both were stashed by the same sync pass and
    // both are cleared by the same single write-back. Keeping them as one block is what
    // guarantees a character can never end up with the threads journalled but the id
    // unresolved (or vice versa) after a mid-drain failure — either the write lands and
    // every stash is gone, or it does not and the whole thing is retried on next load.
    if ((rec as any)._ceMidRangeSalvage || (rec as any)._cePositionSalvage || (rec as any)._cePositionResolve) {
        const _drainMid = String((rec as any)._ceMidRangeSalvage || '');
        const _drainPos = String((rec as any)._cePositionSalvage || '');
        const _drainTgt = String((rec as any)._cePositionResolve || '');
        delete (rec as any)._ceMidRangeSalvage;
        delete (rec as any)._cePositionSalvage;
        delete (rec as any)._cePositionResolve;
        try {
            // The old target was free text typed or picked by NAME. '__player__' was
            // already a sentinel and maps straight across; anything else is matched
            // case-insensitively against the index. A miss leaves targetId empty on
            // purpose — see CharPosition: an unresolved target is a working state, and
            // guessing at one would invent a link the author never drew.
            if (_drainTgt && !((rec as any).position || {}).targetId) {
                if (_drainTgt === CE_PROTAGONIST_REF) {
                    (rec as any).position.targetId = CE_PROTAGONIST_REF;
                } else {
                    const _drainIdx = await loadIndex();
                    const _drainHit = _drainIdx.find(function(m: any) {
                        return m && String(m.name || '').toLowerCase() === _drainTgt.toLowerCase();
                    });
                    if (_drainHit) (rec as any).position.targetId = _drainHit.id;
                }
            }
            if (_drainMid) await charJournalAddBubble(id, _drainMid);
            if (_drainPos) await charJournalAddBubble(id, _drainPos);
            await api.v1.storyStorage.set(STORAGE_CHAR_PFX + id, rec);
        } catch (eSalvage) { api.v1.error('[AE:engine] legacy salvage drain:', eSalvage); }
    }
    return rec;
}


async function loadAllCharacters(): Promise<CharacterRecord[]> {
    const idx = await loadIndex();
    const cfg = await loadConfig();
    const chars = await Promise.all(
        idx.filter(Boolean).map(async function(m) {
            try {
                const raw = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + m.id);
                return raw ? migrateCharacter(raw, cfg) : null;
            } catch (e) {
                api.v1.error('[AE] loadAllCharacters: failed to load char ' + m.id, e);
                return null;
            }
        })
    );
    return chars.filter(Boolean) as CharacterRecord[];
}

// ── Save ──────────────────────────────────────────────────────────────────────

async function saveCharacter(char: CharacterRecord): Promise<void> {
    const cfg = await loadConfig();

    // Derive equipped item names from equippedItemIds for the index
    const equippedItemNames: string[] = [];
    for (const itemId of (char.equippedItemIds || [])) {
        try {
            const itemEnt = await loadEntity(itemId);
            if (itemEnt) equippedItemNames.push(itemEnt.name);
        } catch (ignoredErr) { /* non-fatal — item may not exist yet */ }
    }

    // Derive the character's current location from their entity body's parentId.
    // This is the single source of truth for character location — not a stored field.
    let currentLocationId: string | undefined = undefined;
    if (char.entityId) {
        try {
            const charEntBody = await loadEntity(char.entityId);
            if (charEntBody) currentLocationId = charEntBody.parentId !== null ? charEntBody.parentId : undefined;
        } catch (ignoredErr) { /* non-fatal — entity may not exist yet */ }
    }

    // Build the lightweight index entry
    const meta: CharacterMeta = {
        id: char.id,
        name: char.name,
        isProtagonist: char.isProtagonist,
        entityId: char.entityId,
        // [ENT-AUDIT] hasCriticalHook removed — recomputed on every save since the
        // percentage era and read by nothing, engine or bridge. The two injection bands
        // read char.hook.pressureLevel directly.
        scenePresent: char.scenePresent,
        active: char.active,
        briefDescription: char.briefDescription,
        species: char.species,
        age: char.age,
        occupationRole: char.occupationRole,
        lastThought: char.ephemeral ? char.ephemeral.compressedLine : undefined,
        equippedItemNames: equippedItemNames.length > 0 ? equippedItemNames : undefined,
        currentLocationId: currentLocationId,
        isStatic: !!((char as any).isStatic),   // [DYN1] propagate so card reads correct state
        dynamicPriorityRank: (typeof (char as any).dynamicPriorityRank === 'number' && (char as any).dynamicPriorityRank > 0) ? (char as any).dynamicPriorityRank : undefined  // [vNEXT] propagate rank so the cap sorts off the index
    };

    const idx = await loadIndex();
    const existingIdx = idx.findIndex(function(m) { return m.id === char.id; });
    if (existingIdx >= 0) { idx[existingIdx] = meta; } else { idx.push(meta); }

    await saveIndex(idx);
    await api.v1.storyStorage.set(STORAGE_CHAR_PFX + char.id, char);

    // [D-01] Keep the pointer and its name mirror in sync so CE_PROTAGONIST_REF resolves
    // correctly in injections. BOTH fields, not just the name: a character renamed or
    // imported carrying isProtagonist would otherwise leave the pointer empty and send
    // every reader through ceProtagonistId's adoption scan on every call.
    // Reads/writes storyStorage directly rather than through loadConfig/saveConfig because
    // migrateConfig on the way in would rewrite unrelated fields from inside a save path.
    if (char.isProtagonist && char.name) {
        try {
            const cfgSync = await api.v1.storyStorage.get(STORAGE_CONFIG) as any;
            if (cfgSync && (cfgSync.protagonistName !== char.name
                            || cfgSync.protagonistCharId !== char.id)) {
                cfgSync.protagonistName = char.name;
                cfgSync.protagonistCharId = char.id;
                await api.v1.storyStorage.set(STORAGE_CONFIG, cfgSync);
            }
        } catch (e) { /* non-fatal */ }
    }

}

// ── Delete ────────────────────────────────────────────────────────────────────

async function deleteCharacter(id: string): Promise<void> {
    const char = await loadCharacter(id);
    // [ENT-ID1] SWEEPS BY id, NOT BY entityId, and that is a behaviour change rather
    // than a rename: a character whose pointer was blank or dangling used to keep its body
    // forever, because the only address the sweep knew came from the record it was about
    // to delete. The body's address is now the character's own id and cannot be lost with
    // it. entityId is still honoured when it names something ELSE -- a pre-ENT-ID1 record
    // imported after migration -- so no orphan is created by the transition either.
    await deleteEntity(id);
    if (char && char.entityId && String(char.entityId) !== id) {
        await deleteEntity(String(char.entityId));
    }
    // [IMG-SLOT-CASCADE-FIX] Read the REAL slot list before anything is deleted.
    // The cascade below used to ask the bridge's own [DEAD] _getEmoSlots for which portrait
    // keys to sweep — a table nothing has written to since IMG-SLOTS moved list ownership
    // engine-side, so a custom slot added through the Images drill was invisible to it and
    // its saved image survived the character's deletion as an IndexedDB orphan. This file IS
    // now the source of truth for the slot list (loadCharImgSlots, same load-modify-persist
    // path the drill itself reads), so it can hand the bridge the real list directly instead
    // of the bridge re-deriving a stale one. Read failures fall back to an empty array rather
    // than throwing — a character whose slot record never saved still finishes deleting; the
    // bridge's own [DEAD] fallback below covers that case exactly as it did before this patch.
    var imgSlotsForCascade: string[] = [];
    try { imgSlotsForCascade = (await loadCharImgSlots(id)).slots || []; }
    catch (e) { api.v1.error('[AE:imgslots] cascade slot read failed:', e); }
    await api.v1.storyStorage.remove(STORAGE_CHAR_PFX + id);
    // The engine's OWN slot-list record is a second, separate orphan from the same gap —
    // storyStorage rather than IndexedDB, but unowned by anything once the character is
    // gone. Swept here rather than left for a future pass since it is the same feature and
    // costs nothing extra now that the record has already been read above.
    try { await api.v1.storyStorage.remove(STORAGE_CHAR_IMG_PFX + id); } catch (e) { /* non-fatal */ }
    const idx = await loadIndex();
    await saveIndex(idx.filter(function(m) { return m.id !== id; }));
    
    // Dispatch cascade event to bridge to clean up IndexedDB assets. `slots` is the real,
    // current list (Avatar + Snapshot + 24 canonical + any custom slots) — the bridge
    // handler prefers this and only falls back to its own enumeration when it is absent,
    // so an older engine build talking to this bridge still cascades exactly as before.
    await broadcastToTM('AE_DELETE_PORTRAIT_CASCADE', { charId: id, slots: imgSlotsForCascade });
    // [CASTLORE] Deletion is the one mutation the save-path hooks cannot see.
    queueCastLoreSync('cast');
}


// ============================================================================
// SECTION 6 — STORAGE: ENTITY DATA
// All reads and writes for EntityRecord and the entity index.
// Entities are the world graph: locations, items, narrative nodes, character bodies.
// ============================================================================

// ── Index (EntityMeta[]) ──────────────────────────────────────────────────────

// [F-28] cfg.factions -> ENTITY RECORDS, AND THE CONFIG ARRAY IS DELETED. Async, so it
// cannot live in migrateConfig; it runs once from onScriptsLoaded before any surface reads.
//
// THE ID IS PRESERVED, WHICH IS THE WHOLE MIGRATION STRATEGY. Standing def ids
// (ceStandingDefId), faction-scoped state buckets (STORAGE_STATE_FACTION), the journal
// prefix, entity ownerId/ownerKind:'faction' references and cfg.protagonistFactionId are ALL
// keyed by faction id -- so keeping it means none of them need touching, migrating or
// checking. Change the id and every one of those becomes an orphan on the same day.
//
// IDEMPOTENT AND SELF-HEALING: a config with no `factions` key does nothing, and a faction
// whose entity already exists is skipped rather than overwritten, so an interrupted run
// resumes rather than clobbering author edits made since.
//
// parentId IS null AND STAYS null FOR NOW. A faction inside a faction is real (a chapter, a
// house in a coalition) and this record can express it -- but parentId is the MAP's
// containment tree, and a faction hung in it would be drawn as a place. Wiring faction
// nesting means teaching the map to skip the type first; until then null is the honest
// value rather than a hierarchy nothing renders.
async function ceMigrateFactionsToEntities(): Promise<void> {
    let cfg: any = null;
    try { cfg = await loadConfig(); } catch (eL) { return; }
    let list: any[] = (cfg && (cfg as any).factions) || [];
    if (!Array.isArray(list) || !list.length) {
        // The key still goes, so a config that reached here empty does not carry a dead
        // array forever -- the ae_tracked_narrative failure mode, avoided by one line.
        if (cfg && (cfg as any).factions !== undefined) {
            try { await mutConfig(function(c: any) { delete (c as any).factions; }); } catch (eD) {}
        }
        return;
    }
    let made = 0;
    for (let i = 0; i < list.length; i++) {
        let f: any = list[i];
        if (!f || !f.id) continue;
        let fid = String(f.id);
        let existing: any = null;
        try { existing = await loadEntity(fid); } catch (eE) { existing = null; }
        if (existing) continue;
        let rec: any = {
            id: fid, name: String(f.name || 'Unnamed faction'), type: 'faction',
            parentId: null, description: String(f.description || ''),
            connectedEntityIds: [], customFieldValues: {},
            // THE LOREBOOK LINK COMES ACROSS INTACT. The entry exists in NAI already; a
            // migration that dropped the id would leave it orphaned in the lorebook and
            // silently mint a second one on the next sync.
            lorebookEntryId: f.lorebookEntryId || undefined,
            lorebookTags: Array.isArray(f.lorebookTags) ? f.lorebookTags.slice() : [],
            // A migrated faction has answered no lens questions, so it opens in Classic for
            // the reason a migrated location does: it was authored as one description and
            // must not be confronted with five empty boxes it did not ask for.
            uiShape: 'classic',
            lorebookText: '',
            createdAt: Date.now(), updatedAt: Date.now()
        };
        if (Array.isArray(f.standingLadder) && f.standingLadder.length) {
            rec.standingLadder = f.standingLadder.slice();
        }
        try { await saveEntity(migrateEntity(rec)); made = made + 1; }
        catch (eS) { api.v1.error('[AE:facmig] save failed for ' + fid + ':', eS); return; }
    }
    // DELETED ONLY AFTER EVERY RECORD IS WRITTEN, and the loop returns rather than breaking
    // on a save failure, so a partial run leaves cfg.factions standing and retries next load.
    try { await mutConfig(function(c: any) { delete (c as any).factions; }); }
    catch (eD2) { api.v1.error('[AE:facmig] config cleanup failed:', eD2); return; }
    if (made) aeLog('[AE:facmig] migrated ' + made + ' faction(s) to entities');
}

// [F-28] Every faction, as entity metas. THE ONE READ, replacing cfg.factions at every call
// site -- a second way to enumerate factions is how two surfaces come to disagree about how
// many there are.
async function ceFactionMetas(): Promise<any[]> {
    let out: any[] = [];
    try {
        let idx: any[] = await loadEntityIndex();
        for (let i = 0; i < (idx || []).length; i++) {
            if (idx[i] && String(idx[i].type) === 'faction') out.push(idx[i]);
        }
    } catch (e) { api.v1.error('[AE:faction] meta read failed:', e); }
    return out;
}

async function loadEntityIndex(): Promise<EntityMeta[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_INDEX, []) as EntityMeta[];
}

async function saveEntityIndex(idx: EntityMeta[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, idx.filter(Boolean));
}

// ── Migration ─────────────────────────────────────────────────────────────────
// migrateEntity runs every time an EntityRecord is loaded from storage.
// Handles all legacy field shapes from prior engine versions.

function migrateEntity(raw: any): EntityRecord {
    const ent = raw as any;
    if (!ent.id) ent.id = generateId();
    if (!ent.name) ent.name = 'Unnamed Entity';

    // Force legacy spatial sub-types into the current functional type system
    if (!ent.type || ['interior', 'exterior', 'transit', 'abstract'].includes(ent.type)) {
        ent.type = 'location';
    }
    // Migrate legacy shop type → narrative
    if (ent.type === 'shop') ent.type = 'narrative';

    if (ent.narrativeParentId === undefined) ent.narrativeParentId = null;
    // [NARR-KIND] Only threads carry one. Swept off anything else so a record that
    // changed type does not keep steering questions its catalog no longer asks.
    if (ent.type === 'narrative') {
        if (typeof ent.narrativeKind !== 'string' || !ent.narrativeKind) ent.narrativeKind = 'custom';
        if (!Array.isArray((ent as any).contextIds)) (ent as any).contextIds = [];
    } else {
        delete (ent as any).narrativeKind;
        delete (ent as any).contextIds;
    }
    if (ent.parentId === undefined) ent.parentId = null;
    if (!ent.storyState) ent.storyState = 'locked';

    // [E4] Encounter migration removed; delete stale field from old saves
    delete (ent as any).encounters;

    // [CE-STRIP earlier] rules/skillBonuses/isVehicle field guards and the
    // migrateEntityAction() flat-action migration removed — dead Actions remnants.

    if (!ent.description) ent.description = '';
    // [ENT-AUDIT] Swept, not defaulted. See the interface.
    delete (ent as any).atmosphere;
    delete (ent as any).state;
    delete (ent as any).stateDescriptions;
    delete (ent as any).tagSubscriptions;
    delete (ent as any).inventoryIds;
    delete (ent as any).eventDayTarget;

    // Migrate old connection array key to current key
    ent.connectedEntityIds = ent.connectedEntityIds || ent.connectedLocationIds || [];
    delete ent.connectedLocationIds;

    // [ENT-ID1] presentCharacterIds is deleted rather than defaulted -- see the
    // interface. Stored records still carry it; this is the sweep.
    delete (ent as any).presentCharacterIds;

    // Remove legacy commerce fields
    delete ent.price;

    // [LOC-PROFILE]
    if (typeof ent.locationType !== 'string') ent.locationType = '';
    // [SEC:TRAVEL] NORMALISED, NEVER DEFAULTED -- see the field's own comment for why
    // absent and 0 cannot be collapsed. A junk value is deleted rather than clamped: a
    // record carrying travelTier: 'far' means the field was never really set, and pinning
    // it to 0 would invent the most expensive answer available.
    if ((ent as any).travelTier !== undefined && (ent as any).travelTier !== null) {
        var mtTier = Number((ent as any).travelTier);
        if (!isFinite(mtTier) || mtTier < 0) delete (ent as any).travelTier;
        else (ent as any).travelTier = Math.round(mtTier);
    } else {
        delete (ent as any).travelTier;
    }
    // [LOC-PROFILE2] dramaticFunction / dramaticInLore swept. They were a taxonomy
    // wearing a text field, and the six lenses already say what a place does to a scene
    // without a second field claiming to summarise them.
    delete (ent as any).dramaticFunction;
    delete (ent as any).dramaticInLore;
    if (!ent.customFieldValues || typeof ent.customFieldValues !== 'object') ent.customFieldValues = {};
    // [LOC-PROFILE4]
    if (typeof ent.ownerId !== 'string') ent.ownerId = '';        // [LOC-PROFILE5]
    if (typeof ent.ownerKind !== 'string') ent.ownerKind = '';
    if (typeof ent.conceptDump !== 'string') ent.conceptDump = '';
    if (typeof ent.uiShape !== 'string') ent.uiShape = '';
    if (!Array.isArray(ent.fieldOrder)) ent.fieldOrder = [];
    // [CE-STRIP LOC-PROFILE] notes swept, not defaulted.
    delete (ent as any).notes;
    if (!ent.lorebookTags) ent.lorebookTags = [];
    if (ent.lorebookText === undefined) ent.lorebookText = '';
    if (ent.locationVisuals === undefined) ent.locationVisuals = '';
    if (!ent.createdAt) ent.createdAt = Date.now();
    if (!ent.updatedAt) ent.updatedAt = Date.now();

    // Filter null entries in all arrays for safety
    ent.connectedEntityIds  = ent.connectedEntityIds.filter(Boolean);

    return ent as EntityRecord;
}

// [CE-STRIP earlier] migrateEntityAction() removed via brace-matched deletion.

// ── Load ──────────────────────────────────────────────────────────────────────

async function loadEntity(id: string): Promise<EntityRecord | null> {
    const raw = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + id, null);
    return raw ? migrateEntity(raw) : null;
}

// ── Save ──────────────────────────────────────────────────────────────────────

async function saveEntity(ent: EntityRecord): Promise<void> {
    ent.updatedAt = Date.now();
    // [E3] Auto-clear tracking when a narrative is completed.
    // [CE-SWEEP] The narrative-completed hook here existed only to clear the
    // tracking flag and toast. Nothing else lived in it, so the whole branch is gone.
    await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + ent.id, ent);

    const idx = await loadEntityIndex();
    const meta: EntityMeta = {
        id: ent.id,
        name: ent.name,
        type: ent.type,
        parentId: ent.parentId,
        locationType: (ent as any).locationType || undefined,
        narrativeParentId: ent.narrativeParentId,
        narrativeKind: (ent as any).narrativeKind || undefined,
        storyState: ent.storyState,
        childCount: idx.filter(function(m) { return m.parentId === ent.id; }).length,
        icon: ent.icon || undefined,
        // The map draws from the index, never from full records -- a world of two hundred
        // places would otherwise be two hundred storage reads per repaint.
        mapKind: (ent as any).mapKind || undefined,
        // [SEC:TRAVEL] Same argument as mapKind directly above. migrateEntity has
        // already normalised or removed this, so the record is trusted here rather than
        // re-coerced -- a second coercion is a second place the two could disagree.
        travelTier: (ent as any).travelTier
        // [CE-STRIP earlier] gated/isVehicle/hasGlobalAutoTrigger removed — dead Actions/Travel remnants.
    };

    const i = idx.findIndex(function(m) { return m.id === ent.id; });
    if (i >= 0) { idx[i] = meta; } else { idx.push(meta); }
    await saveEntityIndex(idx);


    // [CASTLORE] THE GEOGRAPHY ENTRY'S CHOKE POINT, and it is HERE rather than on
    // the presence recalc because this is the only place its inputs can change. The World
    // outline is built from EntityRecord.description, name and parentId -- all three are
    // written through this function and nowhere else -- and it does NOT depend on where
    // anybody is standing. Hanging it off presence instead would have meant one loadEntity
    // per location every time the camera walked into a room, to rebuild a string that could
    // not have changed. Coalesced and dirty-checked, so an import saving two hundred
    // entities produces one rebuild, not two hundred.
    queueCastLoreSync('world');
}

// [UNIFY] migrateFactionArgsOnEntities removed - Faction standing actions are obsolete.

// ── Delete ────────────────────────────────────────────────────────────────────

// ── Milestones  [MILESTONE] ───────────────────────────────────────────────────
// One document per thread. Never loaded by the thread LIST -- six rows must not cost six
// archives -- and never by the map or the index.
async function loadMilestones(threadId: string): Promise<ThreadMilestones> {
    var raw: any = null;
    try { raw = await api.v1.storyStorage.getOrDefault(STORAGE_MS_PFX + String(threadId), null); }
    catch (e) { raw = null; }
    var cur: any = (raw && raw.current) ? raw.current : null;
    var arc: any[] = (raw && Array.isArray(raw.archive)) ? raw.archive : [];
    return { v: 1, threadId: String(threadId), current: cur, archive: arc };
}
async function saveMilestones(doc: ThreadMilestones): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_MS_PFX + String(doc.threadId), doc); }
    catch (e) { api.v1.error('[AE:milestone] save failed:', e); }
}

// [MILESTONE] THE FOCUS POINTER, read by an.arc on every context build and by the thread
// list. Returns '' when unset OR when the thread it names is gone -- a dangling pointer
// would make the Author's Note quote a milestone belonging to a deleted record.
async function loadActiveThread(): Promise<string> {
    var id = '';
    try { id = String(await api.v1.storyStorage.getOrDefault(STORAGE_ACTIVE_THREAD, '') || ''); }
    catch (e) { id = ''; }
    if (!id) return '';
    try {
        var ent: any = await loadEntity(id);
        if (!ent || String(ent.type || '') !== 'narrative') return '';
    } catch (e2) { return ''; }
    return id;
}
// Passing the id already set CLEARS it, so the hero button is its own undo and there is no
// second control competing for the row -- the same arrangement the icon picker uses.
async function setActiveThread(id: string): Promise<string> {
    var want = String(id || '');
    var cur = '';
    try { cur = String(await api.v1.storyStorage.getOrDefault(STORAGE_ACTIVE_THREAD, '') || ''); }
    catch (e) { cur = ''; }
    var next = (cur === want) ? '' : want;
    try { await api.v1.storyStorage.set(STORAGE_ACTIVE_THREAD, next); }
    catch (e2) { api.v1.error('[AE:milestone] active thread write failed:', e2); }
    return next;
}

// ── Encounters  [EVENT] ───────────────────────────────────────────────────────
// ONE LIVE ENCOUNTER PER STORY, AND THE LOOKUP IS THE ENFORCEMENT. There is no "is an
// encounter running" flag anywhere: the answer is derived from the two places a live one can
// be, so two encounters cannot both claim to be current and there is no second source to
// drift. Everything that needs to refuse while one is running -- the situational generator,
// a second begin -- asks this rather than keeping its own bit.
//
// THE LOOSE STORE IS CHECKED FIRST, and that ordering is the whole precedence rule. A
// threadless encounter is by definition the thing happening RIGHT NOW; an arc's milestone is
// what the story is pushing toward. When both exist the immediate one wins the arc line,
// which is the same call AE's INJ2 note records the cost of getting wrong in the other
// direction.
async function ceLiveEvent(): Promise<any> {
    try {
        var loose: any = await loadMilestones(CE_MS_LOOSE);
        if (loose && loose.current && loose.current.event) {
            return { threadId: CE_MS_LOOSE, ms: loose.current };
        }
    } catch (e) { /* an unreadable loose store is "no loose encounter", not a fault */ }
    var tid = '';
    try { tid = await loadActiveThread(); } catch (e2) { tid = ''; }
    if (!tid) return null;
    try {
        var doc: any = await loadMilestones(tid);
        if (doc && doc.current && doc.current.event) return { threadId: tid, ms: doc.current };
    } catch (e3) { /* same */ }
    return null;
}

// The milestone id alone, '' for none. The stake chain wants an ADDRESS and nothing else,
// and handing it the whole record would invite a second reader of the same fields.
async function ceLiveEventId(): Promise<string> {
    var live: any = await ceLiveEvent();
    return (live && live.ms) ? String(live.ms.id || '') : '';
}

// [EVENT] THE ONE MILESTONE THE AUTHOR'S NOTE QUOTES. an.arc reads this and nothing else, so
// the "one arc line" rule survives a feature that added a second place a milestone can live.
// A live encounter DISPLACES the active thread's milestone rather than sitting beside it --
// listing both would leak two competing objectives into one Author's Note, which is exactly
// what INJ2 measured.
async function ceArcMilestone(): Promise<any> {
    var live: any = await ceLiveEvent();
    if (live && live.ms) return live.ms;
    var tid = '';
    try { tid = await loadActiveThread(); } catch (e) { tid = ''; }
    if (!tid) return null;
    try {
        var doc: any = await loadMilestones(tid);
        return (doc && doc.current) ? doc.current : null;
    } catch (e2) { return null; }
}

// [EVENT] [F-29] THE FLAG IS THE MEMBERSHIP TEST. A shape is any StateDef of scope 'event',
// which means authoring one is authoring a state and the Settings > States surface is
// already its editor -- no shape catalog, no second record type, and an author's own shapes
// are indistinguishable from any this file might ever seed.
//   NOTHING IS SEEDED. A seeded shape with no door to start an encounter through would be a
//   promise the build does not keep (F-20), so the seeds arrive with the surface.
function ceEventShapes(cfg: GlobalConfig | null): StateDef[] {
    var out: StateDef[] = [];
    var list: StateDef[] = ceStateDefs(cfg);
    for (var i = 0; i < list.length; i++) {
        if (list[i] && String(list[i].scope || '') === 'event') out.push(list[i]);
    }
    return out;
}

// [EVENT] THE ENCOUNTER AS ONE SENTENCE AT THE GENERATION POINT. The Author's Note carries
// this too (an.arc), and the duplication is the POINT rather than an oversight: the AN sits
// thousands of tokens above the generation point, and what enforces pacing is the model
// reading the situation as the LAST thing before it writes. A directive that says what just
// happened, delivered under an arc line that says what is still true, is the pair that keeps
// a fight from resolving itself in one paragraph.
//   IT LEADS, THE DIRECTIVE FOLLOWS. State of the world first, instruction second -- the
//   order F-19b's register argument depends on, and the order a GM would use.
//   RETURNS '' WITH NO LIVE ENCOUNTER, so the splice is unchanged in every story that never
//   starts one.
async function ceEventTurnLine(): Promise<string> {
    var live: any = null;
    try { live = await ceLiveEvent(); } catch (e) { return ''; }
    if (!live || !live.ms) return '';
    var cfg: any = null;
    try { cfg = await loadConfig(); } catch (e2) { return ''; }
    var head = String(live.ms.text || '').trim();
    var line = '';
    try { line = await ceEventStateLine(cfg, live.ms); } catch (e3) { line = ''; }
    if (!head && !line) return '';
    var out = head ? _ceEndSentence(head) : '';
    if (line) out = (out ? (out + ' ') : '') + _ceEndSentence(line);
    return out;
}

// [EVENT] WHERE THE ENCOUNTER STANDS, IN THE SHAPE'S OWN WORDS. Derived on every read and
// never stored -- see Milestone.stateLine for why the archived copy is the exception.
// Returns '' for a milestone with no event, a deleted shape, or a shape with no bands, and
// every one of those is a working state that simply leaves the arc line as the objective
// alone.
async function ceEventStateLine(cfg: GlobalConfig | null, ms: any): Promise<string> {
    if (!ms || !ms.event) return '';
    var def = ceStateDef(cfg, String(ms.event.shapeDefId || ''));
    if (!def) return '';
    var v = 0;
    try { v = await stateRead({ scope: 'event', ownerId: String(ms.id || ''), defId: def.id }); }
    catch (e) { return ''; }
    var bd = ceStateBand(def, v);
    if (!bd.banded) return '';
    return String(bd.label || '').trim();
}

// [CASTLORE] Deletion is the one mutation saveEntity/saveCharacter cannot see, so
// both delete paths queue their own rebuild. Without it a deleted place would sit in the
// World entry until something unrelated happened to be saved.
async function deleteEntity(id: string): Promise<void> {
    await api.v1.storyStorage.remove(STORAGE_ENTITY_PFX + id);
    // [MILESTONE] THE SIDECAR GOES WITH THE RECORD. A key held on a prefix nothing
    // enumerates is invisible once its owner is gone, so every deleted thread would leak
    // one document forever. Unconditional: remove on a key that was never written is a
    // no-op, and asking the type first would mean a record already read badly here.
    try { await api.v1.storyStorage.remove(STORAGE_MS_PFX + id); }
    catch (eMs) { api.v1.error('[AE:milestone] reap failed:', eMs); }
    // AND THE POINTER, if it named this thread. loadActiveThread already refuses a
    // dangling id, but leaving the string behind means a thread later created with a
    // recycled id would inherit focus it never asked for.
    try {
        var actDel = String(await api.v1.storyStorage.getOrDefault(STORAGE_ACTIVE_THREAD, '') || '');
        if (actDel === String(id)) { await api.v1.storyStorage.set(STORAGE_ACTIVE_THREAD, ''); }
    } catch (eAt) { /* non-fatal — the read guard covers it */ }
    const idx = await loadEntityIndex();

    // Collect orphaned children BEFORE removing the entry from the index,
    // since we need their parentId reference while it still points to the deleted entity.
    const orphaned = idx.filter(function(m) { return m.parentId === id; });

    await saveEntityIndex(idx.filter(function(m) { return m.id !== id; }));

    // Re-parent any child entities to the world root (null parent).
    for (const m of orphaned) {
        try {
            const child = await loadEntity(m.id);
            if (child) { child.parentId = null; await saveEntity(child); }
        } catch (ignoredErr) { /* non-fatal */ }
    }
    // [CASTLORE] BOTH halves. A deleted place leaves the World outline, and a
    // deleted body detaches its character from every location the roster reports. The
    // re-parent loop above already ran saveEntity for each orphan, which queued 'world' --
    // this asks for 'all', and the queue's pending slot collapses the two rather than
    // running twice (see queueCastLoreSync).
    queueCastLoreSync();
}

// ── Copy ──────────────────────────────────────────────────────────────────────

async function copyEntity(id: string, deep: boolean = false): Promise<void> {
    try {
        const src = await loadEntity(id);
        if (!src) return;

        const newId = generateId();
        const copy: EntityRecord = JSON.parse(JSON.stringify(src));

        copy.id = newId;
        copy.name = 'Copy of ' + src.name;
        copy.createdAt = Date.now();
        copy.updatedAt = Date.now();

        // Clear runtime state — copy starts fresh, not carrying over scene presence
        copy.connectedEntityIds = [];

        // [E4] Encounter range copy removed
        if (false && (copy as any).encounters) {
            (copy as any).encounters.ranges = ((copy as any).encounters.ranges || []).map(function(r) {
                return Object.assign({}, r, { id: generateId(), triggered: false });
            });
        }

        await saveEntity(copy);

        if (deep) {
            const allMeta = await loadEntityIndex();
            const children = allMeta.filter(function(m) { return m.parentId === src.id; });

            for (const childMeta of children) {
                const childSrc = await loadEntity(childMeta.id);
                if (!childSrc) continue;

                const childCopy: EntityRecord = JSON.parse(JSON.stringify(childSrc));
                childCopy.id = generateId();
                childCopy.name = childSrc.name;
                childCopy.parentId = newId;
                childCopy.createdAt = Date.now();
                childCopy.updatedAt = Date.now();
                childCopy.connectedEntityIds = [];
                if (false && (childCopy as any).encounters) {
                    (childCopy as any).encounters.ranges = ((childCopy as any).encounters.ranges || []).map(function(r) {
                        return Object.assign({}, r, { id: generateId(), triggered: false });
                    });
                }
                await saveEntity(childCopy);
            }

            api.v1.ui.toast('Copied "' + src.name + '" with ' + children.length + ' child(ren).', { type: 'success' });
        } else {
            api.v1.ui.toast('Copied "' + src.name + '".', { type: 'success' });
        }


    } catch (e) {
        api.v1.error('[AE] copyEntity:', e);
        api.v1.ui.toast('Copy failed.', { type: 'error' });
    }
}

// ── History (recent location breadcrumb) ─────────────────────────────────────

async function loadEntityHistory(): Promise<string[]> {
    return await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_HISTORY, []) as string[];
}

async function saveEntityHistory(ids: string[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_ENTITY_HISTORY, ids.slice(0, 10));
}

// ── Schema migrations  [ENT-ID1] ─────────────────────────────────────────────
// STORAGE-WIDE, RUN ONCE, STAMPED. Distinct in kind from migrateCharacter /
// migrateEntity, which normalise ONE record on load and must therefore be idempotent
// and blind to every other record. Anything that rewrites ids has to see the whole
// store at once, so it lives here and gates on STORAGE_SCHEMA_VER.
//
// WHY THE CHARACTER'S ID IS THE ONE THAT SURVIVES, given that the character is the
// aberration and the entity id is the more principled name: rewrite surface, nothing
// else. A body id appears in six places, all inside the world graph (char.entityId,
// entity.parentId, connectedEntityIds[].targetId, the entity index, player location,
// location history). A character id appears in four storage key PREFIXES plus
// equippedToCharId, hook.targetId, the character index, castExclude, party state,
// CharChat state, the CC-CTX maps, and bridge-side IndexedDB image assets keyed by it.
// Keeping the character's value is a six-place sweep; keeping the body's is a dozen
// places and a cross-artifact asset rename. After this runs there is no such thing as
// a "character id" -- there is one id namespace, seeded for existing characters from
// the value they already had.
//
// FAIL-CLOSED PER CHARACTER. A collision at the destination address, or a body that
// cannot be read, skips THAT character and leaves it exactly as it was; it does not
// abort the run and does not half-write. A skipped character is repaired on next open
// by ceRepairBody in the gate below, which is automatic and needs nobody to find a button.
async function ceMigrateBodyIds(): Promise<{ moved: number; skipped: number }> {
    var moved = 0, skipped = 0;
    var idx = await loadIndex();
    var entIdx = await loadEntityIndex();

    // oldBodyId -> charId, for the reference sweep below. Built first and in full, so
    // the sweep is one pass over the graph rather than one pass per character.
    var remap: { [k: string]: string } = {};
    for (var i = 0; i < idx.length; i++) {
        var m: any = idx[i];
        if (!m || !m.id) continue;
        var oldId = String(m.entityId || '');
        if (!oldId || oldId === String(m.id)) continue;
        // Destination already occupied by something that is not this character's body.
        if (entIdx.some(function(e: any) { return e && String(e.id) === String(m.id); })) {
            api.v1.error('[AE:entid1] destination id occupied, skipping character:', m.id);
            skipped++;
            continue;
        }
        remap[oldId] = String(m.id);
    }

    // Move each body record to its character's id.
    for (var oldKey in remap) {
        if (!Object.prototype.hasOwnProperty.call(remap, oldKey)) continue;
        var newKey = remap[oldKey];
        try {
            var body: any = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + oldKey, null);
            if (!body) { delete remap[oldKey]; skipped++; continue; }
            body.id = newKey;
            await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + newKey, body);
            await api.v1.storyStorage.remove(STORAGE_ENTITY_PFX + oldKey);
            moved++;
        } catch (e) {
            api.v1.error('[AE:entid1] body move failed:', oldKey, e);
            delete remap[oldKey];
            skipped++;
        }
    }

    // Sweep every reference to a moved id. Six places, per the header.
    var swap = function(v: any): any {
        var s = String(v || '');
        return (s && remap[s]) ? remap[s] : v;
    };

    for (var j = 0; j < entIdx.length; j++) {
        var em: any = entIdx[j];
        if (!em) continue;
        em.id = swap(em.id);
        em.parentId = em.parentId === null ? null : swap(em.parentId);
        if (em.narrativeParentId) em.narrativeParentId = swap(em.narrativeParentId);
    }
    await saveEntityIndex(entIdx);

    for (var k = 0; k < entIdx.length; k++) {
        var km: any = entIdx[k];
        if (!km || !km.id) continue;
        try {
            var rec: any = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + String(km.id), null);
            if (!rec) continue;
            var dirty = false;
            if (rec.parentId !== null && rec.parentId !== undefined && swap(rec.parentId) !== rec.parentId) {
                rec.parentId = swap(rec.parentId); dirty = true;
            }
            if (rec.narrativeParentId && swap(rec.narrativeParentId) !== rec.narrativeParentId) {
                rec.narrativeParentId = swap(rec.narrativeParentId); dirty = true;
            }
            var conns: any[] = rec.connectedEntityIds || [];
            for (var ci = 0; ci < conns.length; ci++) {
                if (!conns[ci]) continue;
                if (swap(conns[ci].targetId) !== conns[ci].targetId) {
                    conns[ci].targetId = swap(conns[ci].targetId); dirty = true;
                }
            }
            if (dirty) await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + String(km.id), rec);
        } catch (e) { api.v1.error('[AE:entid1] reference sweep failed:', km.id, e); }
    }

    // Character records: the pointer becomes a mirror.
    for (var ci2 = 0; ci2 < idx.length; ci2++) {
        var cm: any = idx[ci2];
        if (!cm || !cm.id) continue;
        try {
            var craw: any = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + String(cm.id));
            if (!craw) continue;
            if (String(craw.entityId || '') !== String(cm.id)) {
                craw.entityId = String(cm.id);
                await api.v1.storyStorage.set(STORAGE_CHAR_PFX + String(cm.id), craw);
            }
            cm.entityId = String(cm.id);
        } catch (e) { api.v1.error('[AE:entid1] character pointer sweep failed:', cm.id, e); }
    }
    await saveIndex(idx);

    // Transient pointers into the graph.
    try {
        // STORAGE_PROTAGONIST_LOC IS DECLARED UNDER THE tempStorage HEADING AND IS NOT IN
        // tempStorage -- every one of its ~10 live call sites uses storyStorage. The
        // declaration block is wrong, not the call sites; flagged rather than moved,
        // since relocating a constant is a separate patch from this one.
        var loc = await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, '') as string;
        if (loc && remap[String(loc)]) await api.v1.storyStorage.set(STORAGE_PROTAGONIST_LOC, remap[String(loc)]);
    } catch (e) { /* non-fatal — a lost camera position re-resolves on next travel */ }
    try {
        var hist = await loadEntityHistory();
        await saveEntityHistory(hist.map(function(h) { return swap(h); }));
    } catch (e) { /* non-fatal */ }

    return { moved: moved, skipped: skipped };
}

// POST-ASSERTION. The migration is irreversible, so the run is only trusted if no
// pre-migration body id survives anywhere the sweep was supposed to reach. Reports
// rather than throws: a survivor means one more thing to fix, not a story to refuse
// to open, and the author gets told either way.
async function ceAssertNoLegacyBodyIds(): Promise<{ id: string; label: string }[]> {
    var bad: { id: string; label: string }[] = [];
    var idx = await loadIndex();
    var entIdx = await loadEntityIndex();
    var live: { [k: string]: boolean } = {};
    for (var i = 0; i < entIdx.length; i++) { if (entIdx[i] && entIdx[i].id) live[String(entIdx[i].id)] = true; }
    for (var j = 0; j < idx.length; j++) {
        var m: any = idx[j];
        if (!m || !m.id) continue;
        // IDS, NOT JUST LABELS. The caller repairs what this finds, and repairing the
        // whole cast to fix two characters is the full-cast startup pass Section 27
        // deliberately removed. A finding has to name its subject to be actionable.
        if (m.entityId && String(m.entityId) !== String(m.id)) {
            bad.push({ id: String(m.id), label: String(m.name || m.id) + ': entityId still diverges' });
        } else if (!live[String(m.id)]) {
            bad.push({ id: String(m.id), label: String(m.name || m.id) + ': no body at own id' });
        }
    }
    return bad;
}

// AUTOMATIC REPAIR, INLINE. Deliberately NOT ceProfileEnsureBody, which is the same
// repair wrapped in ceEntityOp + ceProfileOp + cePublishProfile. At migration time no
// surface is mounted: there is no concurrent writer to serialise against and no store
// to repaint, so those three buy nothing and cost a full profile payload build per
// character. ceProfileEnsureBody remains the correct verb from a live surface.
async function ceRepairBody(charId: string): Promise<boolean> {
    try {
        var c: any = await loadCharacter(charId);
        if (!c) return false;
        var existing: any = await loadEntity(charId);
        if (!existing) {
            var body: any = makeDefaultEntity(String(c.name || 'Unnamed'));
            body.id = charId;
            body.type = 'character';
            body.parentId = null;
            await saveEntity(body);
        }
        if (String(c.entityId || '') !== charId) {
            c.entityId = charId;
            await saveCharacter(c);
        }
        return true;
    } catch (e) {
        api.v1.error('[AE:entid1] repair failed:', charId, e);
        return false;
    }
}

// [HOOK-ONE] The stamped hook pass. Does two jobs that cannot be separated,
// because loadAllCharacters() runs migrateCharacter on the way out and migrateCharacter
// already collapsed the array: by the time this sees a record there is no array left to
// rescale. So the rescale moved onto the single field, and the collapse's own persistence
// rides the same save.
//
// `rescale` is the old v3 job: 0-100 -> 0-4, ONCE, which is why it is stamped rather than
// idempotent — a stored 4 is 'tier 4' after it runs and was '4 percent' before, and no
// inspection can tell those apart. Rounded rather than divided so a hand-edited 30 lands
// on 1 instead of 1.2 and failing every integer comparison downstream.
//
// EVERY CHARACTER IS SAVED, not just the changed ones. The collapse happened out of sight
// in the loader, so this pass cannot tell who needed it; saving all of them once, behind a
// stamp, is cheaper than a second raw read of storage to find out.
async function ceMigrateHooks(rescale: boolean): Promise<{ saved: number; dropped: number }> {
    var saved = 0;
    _ceHookDropped = 0;
    try {
        var all = await loadAllCharacters();
        for (var i = 0; i < all.length; i++) {
            var c: any = all[i];
            if (!c) continue;
            if (rescale && c.hook) {
                var was = Number(c.hook.pressureLevel) || 0;
                if (was > 4) c.hook.pressureLevel = Math.max(0, Math.min(4, Math.round(was / 25)));
            }
            await saveCharacter(c);
            saved++;
        }
    } catch (e) { api.v1.error('[AE:hookone] migration failed:', e); }
    return { saved: saved, dropped: _ceHookDropped };
}

// THE GATE. Runs at startup, before anything reads a character or an entity.
// Toasts on completion and on repair -- per user: a defect the author has to notice
// unaided and then find a button for is a defect they will not fix.
async function ceRunSchemaMigrations(): Promise<void> {
    var have = 1;
    try { have = Number(await api.v1.storyStorage.getOrDefault(STORAGE_SCHEMA_VER, 1)) || 1; }
    catch (e) { have = 1; }
    if (have >= CE_SCHEMA_VERSION) return;

    if (have < 6) {
        // [F-20] THE ARCHETYPE CATALOG BECAME PROSE AND THE SEEDER CANNOT DELIVER THAT.
        // migrateConfig only fills relationshipArchetypes when the key is ABSENT, so every
        // existing story would keep the label-only entries forever -- entries that seed the
        // word "Hostile" into a field asking what the relationship IS.
        // BYTE-EXACT OR SKIPPED, per id. An entry is replaced only when its stages still
        // join to exactly what shipped AND it has no shape written; anything else is treated
        // as authored and left completely alone, gaining only an empty shape field so the
        // editor has something to bind to.
        try {
            var arCfg = await loadConfig();
            var arList: any[] = Array.isArray((arCfg as any).relationshipArchetypes)
                ? (arCfg as any).relationshipArchetypes : [];
            var arHit = 0;
            for (var aq = 0; aq < arList.length; aq++) {
                var arD: any = arList[aq];
                if (!arD) continue;
                var arId = String(arD.id || '');
                var arLegacy = CE_LEGACY_REL_ARCHETYPES[arId];
                var arJoined = (Array.isArray(arD.stages) ? arD.stages : []).join('|');
                if (typeof arLegacy === 'string' && arJoined === arLegacy && !String(arD.shape || '')) {
                    for (var af = 0; af < DEFAULT_REL_ARCHETYPES.length; af++) {
                        if (String(DEFAULT_REL_ARCHETYPES[af].id) !== arId) continue;
                        arD.name   = DEFAULT_REL_ARCHETYPES[af].name;
                        arD.shape  = DEFAULT_REL_ARCHETYPES[af].shape;
                        arD.stages = DEFAULT_REL_ARCHETYPES[af].stages.slice();
                        arHit++;
                        break;
                    }
                    continue;
                }
                if (typeof arD.shape !== 'string') arD.shape = '';
            }
            if (arHit > 0) {
                await saveConfig(arCfg);
                aeLog('[AE:archetype] rewrote ' + arHit + ' untouched seed archetype(s) as prose.');
            }
        } catch (eAr) { api.v1.error('[AE:archetype] v6 rewrite failed \u2014 the old labels stand:', eAr); }
    }

    // OUT OF DESCENDING ORDER ON PURPOSE: this sits in the slot the v5 scrub vacated because it
    // acts on the same row for the same reason. The blocks are independent of each other, so
    // position is readability only -- keeping the no-roll history in one place wins.
    if (have < 7) {
        // [I-04] THE UNTOUCHED NO-ROLL SEED IS REMOVED. Its door is gone (the composer no
        // longer chooses a resolution) and per author it should never have been a mode: an
        // action is worth taking because it can fail.
        // BYTE-EXACT OR LEFT ALONE -- the same rule the retired v5 scrub applied to the same
        // row, for the same reason. It goes only when it is still recognisably the seed: the
        // shipped id, zero dice, one band, and a note that is either empty (post-v5) or the
        // exact string that shipped before it. An author who grew a real table on top of it
        // keeps it, and can still name it the default from Settings.
        // NEVER THE LAST ONE. ceResolutionDef falls to the first def and a config with none has
        // no first to fall to, so a world whose only resolution is this one keeps it.
        try {
            var nrCfg = await loadConfig();
            var nrDefs: any[] = Array.isArray((nrCfg as any).resolutionDefs) ? (nrCfg as any).resolutionDefs : [];
            var nrOut: any[] = [];
            var nrGone = false;
            for (var nq = 0; nq < nrDefs.length; nq++) {
                var nrD: any = nrDefs[nq];
                var nrB: any[] = (nrD && Array.isArray(nrD.bands)) ? nrD.bands : [];
                var nrSeed = !!nrD
                    && String(nrD.id) === CE_NOROLL_SEED_ID
                    && Math.round(Number(nrD.count) || 0) === 0
                    && nrB.length === 1
                    && (String(nrB[0].note || '') === '' || String(nrB[0].note || '') === CE_NOROLL_LEGACY_NOTE);
                if (nrSeed && nrDefs.length > 1) { nrGone = true; continue; }
                nrOut.push(nrD);
            }
            if (nrGone) {
                (nrCfg as any).resolutionDefs = nrOut;
                // A DEFAULT POINTING AT THE ROW JUST REMOVED IS CLEARED RATHER THAN LEFT TO
                // FALL THROUGH. ceDefaultResolutionId would resolve it to the first def either
                // way; a stored id that disagrees with the resolved one is how a Settings
                // control comes to display a table no roll uses.
                if (String((nrCfg as any).defaultResolutionId || '') === CE_NOROLL_SEED_ID) {
                    (nrCfg as any).defaultResolutionId = '';
                }
                await saveConfig(nrCfg);
                aeLog('[AE:noroll] removed the seeded no-roll resolution \u2014 an action is worth taking only when it can fail.');
            }
        } catch (eNr) { api.v1.error('[AE:noroll] v7 removal failed \u2014 the row stands and is harmless:', eNr); }
    }

    if (have < 4) {
        // Ordered before the body-id block deliberately: this one only reads and writes
        // hooks, so running it first means a failure in the (much larger) id sweep below
        // cannot leave hooks half-converted behind a stamp that never lands.
        var hkRes = await ceMigrateHooks(have < 3);
        if (hkRes.dropped > 0) {
            api.v1.ui.toast('Hooks are one per character now. '
                + hkRes.dropped + ' extra hook(s) were dropped — see the console for what they said.',
                { type: 'warning', autoClose: 7000 });
        }
    }

    if (have < 2) {
        var res = await ceMigrateBodyIds();
        var bad = await ceAssertNoLegacyBodyIds();
        // Repair before reporting, so the toast describes the state the author ends in
        // rather than the one they were in mid-run. Scoped to what failed.
        var repaired = 0;
        for (var r = 0; r < bad.length; r++) {
            if (await ceRepairBody(bad[r].id)) repaired++;
        }
        if (repaired > 0) bad = await ceAssertNoLegacyBodyIds();
        if (res.moved > 0 || repaired > 0 || bad.length > 0) {
            api.v1.ui.toast('World data updated: ' + res.moved + ' character bodies relinked'
                + (repaired > 0 ? ', ' + repaired + ' rebuilt' : '')
                + (bad.length > 0 ? '. ' + bad.length + ' still need attention — see engine log.' : '.'),
                { type: bad.length > 0 ? 'warning' : 'success', autoClose: 6000 });
        }
        for (var b = 0; b < bad.length; b++) api.v1.error('[AE:entid1] unresolved:', bad[b].label);
    }

    try { await api.v1.storyStorage.set(STORAGE_SCHEMA_VER, CE_SCHEMA_VERSION); }
    catch (e) { api.v1.error('[AE:entid1] schema stamp failed — migration will re-run:', e); }
}


// ============================================================================
// SECTION 7 — STORAGE: GLOBAL CONFIG
// Single GlobalConfig record per story. Governs engine intervals, field labels,
// resources, factions, skill modifiers, and generation style.
// ============================================================================

// [CE-STRIP v2.0.x] DEFAULT_TIME_BANDS removed — Clock/Calendar cut.

function makeDefaultConfig(): GlobalConfig {
    return {
        contextTemplates: JSON.parse(JSON.stringify(DEFAULT_TEMPLATES)),
        lorebookTemplates: JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_TEMPLATES)),  // [CONDITIONS]
        lorebookFields: JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_FIELDS)),  // [LOREFOLD]
        interfaceMode: 'native',   // [earlier] default to the native HUD; bridge is opt-in
        thoughtIntervalGens: 2,    // [E1] ephemeral every 2 generations
        hookIntervalGens: 6,       // hooks every 6 generations
        dynamicIntervalMode: 'gens', // default cadence unit (per-generation)
        thoughtIntervalTokens: 500,  // token-mode intervals — scaled ~250 tok/gen from the *Gens above
        hookIntervalTokens: 1500,
        totalGenerations: 0,
        ephemeralCap: 3,
        maxGenerationsPerTurn: 1,  // [TURN-CAP] 0 = unlimited
        maxDynamicCharacters: 0,   // [vNEXT] 0 = no cap (all present dynamic chars process)
        graveyardEntityId: '',     // [KILL] created lazily on the first death
        sheetCategories: [], // [PATCH] DEFAULT_SHEET_CATEGORIES removed; full Sheet Categories cut deferred to its own pass.
        autoThoughtsDefault: true,
        showFieldHeaders: true,
        generalStyle: DEFAULT_GENERAL_STYLE,
        fieldLabels: {},
        fieldInstructions: {},
        fieldBudgets: {},
        customStaticFields: [],
        customLocationFields: [],
        customItemFields: [],
        customFactionFields: [],
        customNarrativeFields: [],
        relationshipArchetypes: [...DEFAULT_REL_ARCHETYPES],
        stateDefs: JSON.parse(JSON.stringify(DEFAULT_STATE_DEFS)),  // [SEC:STATE][D-25]
        resolutionDefs: JSON.parse(JSON.stringify(DEFAULT_RESOLUTION_DEFS)),  // [F-12]
        defaultResolutionId: '',   // [I-04] '' resolves to the first def; see ceDefaultResolutionId
        stakeDefs: JSON.parse(JSON.stringify(DEFAULT_STAKE_DEFS)),  // [F-14]
        species: [],
        standingLadder: DEFAULT_STANDING_LADDER.slice(),
        projectName: '',
        projectGenre: '',
        projectConcept: '',
        wizardSections: JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS)),
        defaultBackgroundUrl: '',
        // [T-07] SEEDED FOR A NEW STORY ONLY. ceCalendar answers identically for a config
        // without this key, so nothing depends on the seed -- it exists so Settings > Time
        // opens on a concrete week and year rather than on four empty lists. There is no
        // matching migrateConfig default, deliberately: that is the shape that resurrects a
        // key a migration removed.
        calendar: JSON.parse(JSON.stringify(DEFAULT_CALENDAR)),
    };
}

// [UNIFY] Action/Rules system removed - Faction standing and rule-arg repair helpers removed.


// [FACETS] Built-in facet library. Facets are mechanically identical to the four
// slots — same CustomFieldDef shape, same generators, same customFieldValues storage, same
// addField injection, and blanks self-suppress — so there is no facet subsystem, only this
// list and a picker. `slot` groups them in the UI and is presentational only.
//
// These SHIP rather than being imported. The import path still works for author-written
// packs, but making the stock library an import step would have meant every new story
// starts with nothing and the feature is invisible until someone finds a JSON file.
//
// Instructions are compressed relative to the slot instructions: a facet is one small
// specific thing, so each carries a task, a length, and the one cliche it attracts. The
// anti-default clause is not decoration — a narrative-trained model has a strong stock
// answer for nearly every one of these.
const BUILTIN_FACETS: { id: string; slot: string; label: string; placeholder: string; instructions: string; kind?: string }[] = [
    // ══════════════════════════════════════════════════════════════════════════
    // SLOTS — the six-slot character model (schema v0.2). Mechanically identical
    // to facets (same CustomFieldDef shape, same generator, same customFieldValues
    // storage), which is why they live in the same library rather than a parallel
    // one. They differ only in `kind: 'slot'`, which AE_GET_FACET_DEFS filters on so
    // slots never appear in the "+ Add facet" picker — slots are card-driven and
    // (for Resistance/Conduct) pattern-gated, facets are freely addable.
    //
    // Presence / Core / Pursuit are pattern-independent. Resistance and Conduct
    // exist once per pattern; the bridge resolves ce_slot_resist_<pattern> /
    // ce_slot_conduct_<pattern> from the character's chosen pattern.
    // ══════════════════════════════════════════════════════════════════════════

    // ── Fixed slots ──
    { id: 'ce_slot_presence', slot: 'presence', kind: 'slot', label: 'Presence', placeholder: 'What a stranger perceives on first sight…',
      instructions: 'Describe what a stranger perceives on first sight: build and bearing, then skin, hair, and eyes, then voice and the way they move. Two–three sentences, under 60 words. Sweep from silhouette to detail — do not hunt for one striking feature to lead with. Only what is perceivable from outside; no history, no motive. Avoid piercing eyes, smirks, easy grace, "commands attention," "ethereal," and invented oddities such as unusual hands, unnatural height, or scars unless the seed material establishes one.' },
    { id: 'ce_slot_core', slot: 'core', kind: 'slot', label: 'Core', placeholder: 'The one thing they will not let go of…',
      instructions: 'State the one thing this character will not let go of — the person, belief, wound, or hunger everything else bends around. One sentence, under 30 words. It must still be true if every current plan fails. Not a goal with an endpoint and not a personality trait. Avoid "freedom," "family," "protecting those they love," and anything they could simply achieve and be finished with.' },
    { id: 'ce_slot_pursuit', slot: 'pursuit', kind: 'slot', label: 'Pursuit', placeholder: 'What they are actively going after right now…',
      instructions: 'State what this character is actively going after right now — the concrete objective they could be seen working on this scene. One–two sentences, under 40 words. Name the object, not the value: "get her brother’s name off the ledger," not "seeks justice." Phrase it so it can plainly succeed or fail. Leave empty if they are chasing nothing. Avoid restating the Core, avoid revenge unless the profile earns it, and never use the words "quest" or "destiny".' },

    // ── Resistance — one per pattern. What holding the Core COSTS them. ──
    { id: 'ce_slot_resist_contradiction', slot: 'resistance', kind: 'slot', label: 'Resistance · Contradiction', placeholder: 'The second thing also true, pulling against the Core…',
      instructions: 'Name the second thing that is also true of them and pulls against the Core — a competing truth, not a flaw. Under 40 words. Both halves must show in behaviour and neither may be the "real" one. Avoid "tough but caring," "pushing people away to protect them," and pairings that resolve too neatly.' },
    { id: 'ce_slot_resist_wantneed', slot: 'resistance', kind: 'slot', label: 'Resistance · Want / Need', placeholder: 'The substitute they chase instead…',
      instructions: 'State the substitute this character chases in place of the Core — what they sincerely believe will settle it, and why it cannot. Under 40 words. They must endorse the belief fully. Avoid making them self-aware about it, and avoid substitutes so obviously wrong or cartoonishly evil that no one would hold them.' },
    { id: 'ce_slot_resist_defense', slot: 'resistance', kind: 'slot', label: 'Resistance · Defense', placeholder: 'What holding the Core exposes them to…',
      instructions: 'Name what holding the Core exposes them to — the thing they cannot afford to have seen. Under 40 words. Specific, concealable, and live now rather than a past event. Avoid generic trauma, "fear of vulnerability," and anything already obvious from outside.' },
    { id: 'ce_slot_resist_ruleset', slot: 'resistance', kind: 'slot', label: 'Resistance · Rule set', placeholder: 'The laws they keep, and the one that will break…',
      instructions: 'State two to four laws this character keeps while pursuing the Core, phrased as they would phrase them, then name the one the Core will eventually force them to break. Under 45 words. Rules constrain behaviour; virtues do not. Avoid "never lies," "never harms the innocent," and codes that cost nothing to keep.' },
    { id: 'ce_slot_resist_appetite', slot: 'resistance', kind: 'slot', label: 'Resistance · Appetite', placeholder: 'What they cannot refuse, and the one line they keep…',
      instructions: 'Name what this character cannot refuse and the one thing they will not touch. Under 40 words. The appetite serves or substitutes for the Core; the refusal is the single edge they keep. Sensory and specific. Avoid moralising, and avoid appetites with no line attached.' },
    { id: 'ce_slot_resist_mask', slot: 'resistance', kind: 'slot', label: 'Resistance · Function mask', placeholder: 'The role, and what it forbids…',
      instructions: 'State the role this character performs and what it forbids them from wanting, showing, or admitting — where the Core is the forbidden thing. Under 40 words. The conflict must be live and currently costly. Avoid roles worn lightly enough to forbid nothing.' },

    // ── Conduct — one per pattern. The standing move when the cost comes due. ──
    { id: 'ce_slot_conduct_contradiction', slot: 'conduct', kind: 'slot', label: 'Conduct · Contradiction', placeholder: 'Which side shows, and what brings the other out…',
      instructions: 'Describe which side shows by default and the specific circumstance that brings the other out. Two sentences, under 50 words. Observable behaviour for each side, not feelings. Avoid "the walls come down," "beneath the cold exterior," and switches that happen for no reason.' },
    { id: 'ce_slot_conduct_wantneed', slot: 'conduct', kind: 'slot', label: 'Conduct · Want / Need', placeholder: 'How they pursue the substitute, and who pays…',
      instructions: 'Describe how they pursue the substitute and who pays for it. Two sentences, under 50 words. Show the pursuit as something others watch happen. Avoid clean success and avoid them learning the lesson on their own.' },
    { id: 'ce_slot_conduct_defense', slot: 'conduct', kind: 'slot', label: 'Conduct · Defense', placeholder: 'The avoidance move, and the tell that leaks…',
      instructions: 'Describe their avoidance move when the sore spot is approached, and the one tell that leaks anyway. Two sentences, under 50 words. Both observable — a deflection and a crack in it. Avoid changing the subject as the only tactic, or sudden flashes of anger.' },
    { id: 'ce_slot_conduct_ruleset', slot: 'conduct', kind: 'slot', label: 'Conduct · Rule set', placeholder: 'How they keep the rules, and what they do when others do not…',
      instructions: 'Describe how they keep the rules day to day, and what they do when someone breaks one in front of them — enforce, withdraw, or absorb. Two sentences, under 50 words. Visible action, not stated belief. Avoid lecturing or drawing a weapon as the only responses.' },
    { id: 'ce_slot_conduct_appetite', slot: 'conduct', kind: 'slot', label: 'Conduct · Appetite', placeholder: 'The manner of taking, asking, or indulging…',
      instructions: 'Describe how they go after what they want — the manner of taking, asking, or indulging, and how open or sly they are about it. Two sentences, under 50 words. Show it in action. Avoid making them purely predatory or purely restrained.' },
    { id: 'ce_slot_conduct_mask', slot: 'conduct', kind: 'slot', label: 'Conduct · Function mask', placeholder: 'The performance, and the tell that slips…',
      instructions: 'Describe the performance — tone, posture, the phrases they reach for — and the one small physical tell that slips when it costs them. Two sentences, under 50 words. Both observable. Avoid the mask dropping completely; that is a threshold event, not a habit.' },

    // ══════════════════════════════════════════════════════════════════════════
    // FACETS — optional, freely addable, grouped by the slot each one deepens.
    // ══════════════════════════════════════════════════════════════════════════

    // ── Presence ──
    { id: 'ce_fx_signature', slot: 'presence', label: 'Signature detail', placeholder: 'The one thing people describe them by…',
      instructions: 'Name the single physical detail someone would use to describe this character to a stranger. One sentence, under 25 words, concrete and visible. Not a personality trait. Avoid scars, unusual eye colours, "an aura of mystery", and anything already stated elsewhere in the profile.' },
    { id: 'ce_fx_carry', slot: 'presence', label: 'Clothing & carry', placeholder: 'What they wear and what is always on them…',
      instructions: 'Describe what this character wears day to day and the one object always on their person. Two sentences, under 45 words. Say what the clothing is FOR — weather, work, status, concealment. Avoid hooded cloaks, impossible hidden weapons, and avoid describing the body itself.' },
    { id: 'ce_fx_scent', slot: 'presence', label: 'Scent & sound', placeholder: 'How they register beyond sight…',
      instructions: 'Describe how this character registers to senses other than sight: what they smell of, and the sound they make moving or being nearby. Two sentences, under 35 words. Ground both in their actual life and work. Avoid generic florals, leather, ozone, and woodsmoke unless the profile earns them.' },
    { id: 'ce_fx_condition', slot: 'presence', label: 'Condition', placeholder: 'How their body is doing right now…',
      instructions: 'State how this character’s body is doing at this point in the story: rested or worn, fed or not, whole or carrying something. Present tense, under 35 words. This is a current state and expected to change, so avoid permanent traits and old injuries that no longer affect them.' },
    { id: 'ce_fx_bearing', slot: 'presence', label: 'Bearing', placeholder: 'How they occupy space…',
      instructions: 'Describe how this character occupies space: what they do with their weight when standing still, how much room they take, where they put themselves in a room. Two sentences, under 35 words. Avoid arms crossed, leaning in doorways, lounging with false ease, and looming.' },

    // ── Drive ──
    { id: 'ce_fx_errand', slot: 'drive', label: 'Immediate errand', placeholder: 'The small task they are on this week…',
      instructions: 'State the small concrete task this character is trying to finish in the next few days. Must be completable on the page. One or two sentences, under 30 words. Not their life goal — the errand. Avoid anything phrased as a quest or destiny.' },
    { id: 'ce_fx_ambition', slot: 'drive', label: 'Long ambition', placeholder: 'Where they want to be in ten years…',
      instructions: 'State where this character wants to be in ten years, in the terms they would use themselves. Under 35 words. Concrete and material rather than a virtue. Avoid revenge, redemption, and any goal phrased as freedom, justice, or belonging.' },
    { id: 'ce_fx_forwhom', slot: 'drive', label: 'Who it is for', placeholder: 'The person this is actually about…',
      instructions: 'Name the specific person this character’s pursuit is really about, and what they want from that person that they have not asked for. Two sentences, under 40 words. It may be someone dead, absent, or unaware. Avoid making it about a group, an abstraction, or humanity in general.' },
    { id: 'ce_fx_tried', slot: 'drive', label: 'What they have tried', placeholder: 'The approach that already failed…',
      instructions: 'State what this character already tried in pursuit of what they want, how it failed, and why they still believe. Two or three sentences, under 50 words. The failure must be specific, mundane, and recent enough to still sting.' },
    // [STUDIO-2] The redesign asks the Pursuit slot a question the library could
    // not answer: what the failure actually costs. 'What they have tried' covers the past
    // attempt, nothing covered the consequence. Without it Pursuit states an aim with no
    // stated downside, and a model has no reason to treat losing it as expensive.
    { id: 'ce_fx_stake', slot: 'drive', label: 'What is at stake', placeholder: 'What happens if they fail this week…',
      instructions: 'State the concrete consequence if this character fails at what they are currently pursuing. One or two sentences, under 40 words. It must be a specific loss to THIS character, not a general disaster — what they personally forfeit, and to whom. Avoid the world ending or vague statements about losing themselves.' },

    // ── Position ──
    // [STUDIO-2] Facets that deepen char.position (earlier). These are ordinary
    // customFieldValues like every other facet and are NOT part of the CharPosition record:
    // position.shape and position.standing are the two fields the pressure tier grades, and
    // adding more prose to that record would mean more surface for the tier to be read
    // against without any of it being classified. These sit alongside it as context instead.
    { id: 'ce_fx_pos_history', slot: 'position', label: 'How it started', placeholder: 'The first thing that happened between them…',
      instructions: 'State the specific event or circumstance that began this relationship, from this character’s side. Two sentences, under 45 words. A concrete occasion rather than a summary of a period. Avoid fateful encounters or immediate soul-bonds.' },
    { id: 'ce_fx_pos_unsaid', slot: 'position', label: 'Never said out loud', placeholder: 'The thing they will not say to them…',
      instructions: 'State the one thing this character will not say to the other person, and what they say instead. Two sentences, under 40 words. It should be sayable in principle — withheld by choice, not by circumstance.' },
    { id: 'ce_fx_pos_want', slot: 'position', label: 'What they want from them', placeholder: 'What they are really after…',
      instructions: 'State what this character actually wants from the other person, which may not be what they ask for. One or two sentences, under 35 words. Name the want plainly rather than describing the feeling around it.' },
    // [FACET-TIES] Two gaps the Studio's Position step could not fill. Position
    // itself is ONE other character (char.position is a single record, deliberately — see
    // the earlier CharPosition note), so a character's group allegiance and their other
    // named ties had nowhere to live except a Background paragraph the model reads as
    // history rather than as live standing.
    //
    // Filed under slot 'position' because that is the Studio's relationships step and
    // `slot` is presentational grouping only. They are ordinary customFieldValues: NOT
    // part of the CharPosition record, NOT gated on both-parties-scene-present, and not
    // graded by any pressure tier — they inject like every other facet.
    { id: 'ce_fx_faction', slot: 'position', label: 'Faction & allegiance', placeholder: 'Who they answer to, and how willingly…',
      instructions: 'Name the group this character belongs to or answers to — house, crew, guild, unit, family, employer — their standing inside it, and how willingly they carry it. Two sentences, under 45 words. If they belong to nothing, say what that costs them rather than leaving it blank. Avoid secret societies and shadowy organisations nobody in the story has met.' },
    { id: 'ce_fx_relations', slot: 'position', label: 'Other relationships', placeholder: 'The two or three other people who matter…',
      instructions: 'Name the two or three other people who currently matter to this character and state each tie in a few words — who they are and what is between them. Under 50 words total. Named individuals with a live connection, not categories and not everyone they have ever met. Do not restate the primary relationship already recorded above.' },

    // ── Resistance ──
    { id: 'ce_fx_secret', slot: 'resistance', label: 'Secret', placeholder: 'Something true they have not told…',
      instructions: 'State something true about this character that they have not told anyone, and name who would be hurt or lost if it surfaced. Two sentences, under 45 words. It must be currently dangerous rather than merely private. Avoid secret parentage, hidden powers, and concealed heroic identities.' },
    { id: 'ce_fx_vice', slot: 'resistance', label: 'Vice', placeholder: 'The habit that costs them…',
      instructions: 'Name the habit that costs this character something, and give the justification they actually use for it in their own head. Two sentences, under 40 words. Do not moralise or hint they will overcome it. Avoid drink and gambling as unmotivated stock answers.' },
    { id: 'ce_fx_debt', slot: 'resistance', label: 'Debt', placeholder: 'What they owe and to whom…',
      instructions: 'State what this character owes and to whom — money, a favour, blood, or guilt — and what the holder can demand because of it. Two sentences, under 45 words. Name the creditor specifically. Avoid vague debts to organisations nobody has met or life debts for saving their life.' },
    { id: 'ce_fx_grudge', slot: 'resistance', label: 'Grudge', placeholder: 'Who wronged them, and what is unfinished…',
      instructions: 'Name who wronged this character, what was done, and the specific unfinished thing that remains. Two sentences, under 45 words. The wrong should be proportionate to an ordinary life unless the profile says otherwise. Avoid murdered families and burning villages.' },
    { id: 'ce_fx_superstition', slot: 'resistance', label: 'Superstition', placeholder: 'A belief that is not true, acted on anyway…',
      instructions: 'State a belief this character holds that is not true, and the specific thing they do because of it. Two sentences, under 35 words. It should be small, habitual, and slightly embarrassing rather than a grand delusion.' },
    { id: 'ce_fx_blindspot', slot: 'resistance', label: 'Blind spot', placeholder: 'What everyone else can see…',
      instructions: 'State the thing about this character that everyone around them can see and they cannot. Two sentences, under 40 words. Write it as others would describe it, not as a diagnosis. Avoid stating that they are afraid of intimacy or cannot trust people.' },

    // ── Conduct ──
    { id: 'ce_fx_tell', slot: 'conduct', label: 'Tell', placeholder: 'What they do when uncomfortable…',
      instructions: 'Name the small physical thing this character does when lying or uncomfortable, and who has noticed it. Two sentences, under 30 words. It must be specific and small. Avoid eye contact avoidance, jaw clenching, throat clearing, sighing heavily, biting the lip, and touching the neck.' },
    { id: 'ce_fx_pressure', slot: 'conduct', label: 'Under pressure', placeholder: 'Their default move when things go badly…',
      instructions: 'State what this character does by default when things go badly: fight, fix, flee, freeze, charm, or delegate. Name one and describe what it looks like in practice. Two sentences, under 40 words. Do not hedge across several. Avoid "unleashing their true power."' },
    { id: 'ce_fx_strangers', slot: 'conduct', label: 'With strangers', placeholder: 'Someone they have no stake in…',
      instructions: 'Describe how this character treats someone they have no stake in and will never see again. Two sentences, under 40 words. This is the most revealing thing about most people, so be specific rather than perfectly pleasant or pointlessly cruel.' },
    { id: 'ce_fx_subordinates', slot: 'conduct', label: 'With subordinates', placeholder: 'Someone who cannot refuse them…',
      instructions: 'Describe how this character treats someone who cannot refuse them — an employee, a servant, a junior, anyone dependent. Two sentences, under 40 words. Be honest rather than flattering; a decent person and a cruel one differ most here.' },
    { id: 'ce_fx_authority', slot: 'conduct', label: 'With authority', placeholder: 'Someone who outranks them…',
      instructions: 'Describe how this character behaves toward someone who outranks them and knows it. Two sentences, under 40 words. State whether they comply, needle, flatter, or stonewall, and what it costs them to do it.' },
    { id: 'ce_fx_humour', slot: 'conduct', label: 'Humour', placeholder: 'What they find funny…',
      instructions: 'State what this character actually finds funny and whether they let it show. Two sentences, under 35 words. Give one example of the kind of thing that would make them laugh. Avoid dry wit, sarcasm as unearned defaults, and "dark amusement at danger."' },
    { id: 'ce_fx_anger', slot: 'conduct', label: 'Anger', placeholder: 'Loud, cold, quiet, or precise…',
      instructions: 'Describe specifically what this character’s anger looks like from outside, and what they do with it. Two sentences, under 40 words. Choose one register — loud, cold, quiet, precise, or displaced — and commit. Avoid seeing red, clenched fists, flashing eyes, and gritting teeth.' },
    { id: 'ce_fx_speech', slot: 'conduct', label: 'Speech sample', placeholder: 'Three lines of their actual dialogue…',
      instructions: 'Write exactly three lines of this character’s dialogue, each from a different situation: one relaxed, one under pressure, one when they want something. No attribution, no narration, no quotation marks, one line each. Make the rhythm and vocabulary distinctive enough that the lines would be recognisable without a name attached. Do not start lines with crutch words like "Ah," "Well," or "...".' },

    // ── History ──
    { id: 'ce_fx_formative', slot: 'history', label: 'Formative event', placeholder: 'What shaped how they operate…',
      instructions: 'Describe the event that most shaped how this character operates now, and name the specific habit it left. Two or three sentences, past tense, under 50 words. Ordinary events shape people more than catastrophes; avoid war, fire, mysterious mentors, and the death of a parent unless the profile establishes them.' },
    { id: 'ce_fx_origin', slot: 'history', label: 'Where they are from', placeholder: 'Place, class, and what it left…',
      instructions: 'State where this character is from, what class or station that meant, and one thing it left in how they speak or behave. Two sentences, under 45 words. Keep it consistent with the established world rather than importing a real-world region.' },
    { id: 'ce_fx_skill', slot: 'history', label: 'Skill & training', placeholder: 'What they are good at, and how they learned…',
      instructions: 'State what this character is genuinely good at and how they learned it, including one thing they are notably bad at. Two or three sentences, under 50 words. Competence should match their life; avoid unexplained mastery or ancient forgotten arts.' },
    { id: 'ce_fx_reputation', slot: 'history', label: 'Reputation', placeholder: 'What people say when they are not there…',
      instructions: 'State what people say about this character when they are not in the room, and how accurate it is. Two sentences, under 40 words. Give the actual phrasing others would use. Avoid making them universally feared or universally loved.' },

    // ── Pattern Additions ──

    // Collateral: For villains, anti-heroes, and ruthless pragmatists. The cost is external.
    { id: 'ce_slot_resist_collateral', slot: 'resistance', kind: 'slot', label: 'Resistance · Collateral', placeholder: 'The harm they cause, and the lie that justifies it…',
      instructions: 'Name the specific harm pursuing the Core inflicts on the people around them, and the lie they tell themselves to justify it. Under 40 words. The harm must be undeniable to everyone but them, and they must fully believe the justification. Avoid "for the greater good" as a generic excuse.' },
    { id: 'ce_slot_conduct_collateral', slot: 'conduct', kind: 'slot', label: 'Conduct · Collateral', placeholder: 'How they step over people, and how they handle the fallout…',
      instructions: 'Describe how they step over someone to get what they want, and how they react when forced to look at the damage. Two sentences, under 50 words. Do not let them feel genuine, productive guilt; show how they deflect, rationalize, or compensate instead.' },

    // Obligation: For characters bound by duty, oaths, debts, or literal chains.
    { id: 'ce_slot_resist_obligation', slot: 'resistance', kind: 'slot', label: 'Resistance · Obligation', placeholder: 'The chain that binds them, and their hidden rebellion…',
      instructions: 'Name the external force, person, or vow that chains them to the Core, and the one small, private rebellion they keep for themselves. Under 40 words. The chain must be a hard constraint they cannot currently break. Avoid generic "loyalty"; make it a concrete mechanism of control.' },
    { id: 'ce_slot_conduct_obligation', slot: 'conduct', kind: 'slot', label: 'Conduct · Obligation', placeholder: 'How they obey, and how they drag their feet…',
      instructions: 'Describe how they execute the duties they are forced into, and the subtle way they drag their feet, work to rule, or sabotage it. Two sentences, under 50 words. Both observable. Avoid outright defiance; the sabotage must be deniable.' },
    // ── After Dark additions ──
    // Facets that describe the body, the mind and the bedroom. They are ORDINARY
    // facets — same shape, same generator, same storage, freely addable from the
    // picker and self-suppressing while empty — filed under the slot each one
    // deepens rather than under a group of their own, so a character who never adds
    // one sees no trace of them anywhere.

    // ── Add to: Presence ──

    { id: 'ce_fx_occupational', slot: 'presence', label: 'Occupational mark', placeholder: 'How their life has shaped their body…',
      instructions: 'Describe how this character’s profession, lifestyle, or past has permanently shaped their physical body. Think a dancer’s legs, a scribe’s ink-stained calluses, or a rider’s bowlegged walk. Two sentences, under 40 words. Avoid generic descriptions of being muscular or fit; focus on the specific, asymmetrical toll of their daily life.' },

    { id: 'ce_fx_allure', slot: 'presence', label: 'Physical draw', placeholder: 'What specifically draws the eye…',
      instructions: 'Name the specific physical trait or mannerism that draws sexual or romantic attention to this character. One sentence, under 30 words. Focus on a grounded, observable detail rather than a magical aura. Avoid "perfect proportions," "smoldering eyes," and descriptions that sound like clinical anatomical summaries.' },

    // ── Add to: Resistance (Internal conflicts and boundaries) ──

    { id: 'ce_fx_taboo', slot: 'resistance', label: 'Taboo', placeholder: 'The line they will not cross in bed…',
      instructions: 'State the one intimate, sexual, or romantic line this character will absolutely not cross, or the specific desire they hold but are deeply ashamed of. Two sentences, under 40 words. Make it specific to their psychology and history rather than a universal moral law. Avoid illegal non-consent.' },

    // ── Add to: Conduct (Behavior in action) ──

    { id: 'ce_fx_cognition', slot: 'conduct', label: 'Cognition', placeholder: 'How their mind processes problems…',
      instructions: 'Describe how this character’s mind works when solving a problem or processing new information. Do they leap to intuitive conclusions, build slow logical chains, or rely on paranoid suspicion? Two sentences, under 40 words. Avoid stating they are simply "a genius," "highly intelligent," or "always ten steps ahead."' },

    { id: 'ce_fx_intimacy', slot: 'conduct', label: 'Intimacy', placeholder: 'How they behave when the armor comes off…',
      instructions: 'Describe how this character behaves behind closed doors in sexual or romantic situations. Do they need to dominate, do they become surprisingly tender, or are they clumsy and eager? Two sentences, under 45 words. Focus on rhythm, power dynamics, and vulnerability. Avoid explicit anatomical terminology and purple prose; describe the psychological and physical dynamic.' },

    { id: 'ce_fx_appetite_erotic', slot: 'conduct', label: 'Erotic appetite', placeholder: 'What they crave physically…',
      instructions: 'State what this character is distinctly drawn to in sexual encounters—a specific physical dynamic, a role, a kink, or a type of partner—and how openly they pursue it. Two sentences, under 45 words. Ground it tightly in their Core psychology. Avoid exaggerated anime tropes and purely biological descriptions.' },

    // ═══════════════════════════════════════════════════════════════════════════
    // ASPECTS — THE SECOND AXIS. Every other entry in this library, slot and facet
    // alike, answers ONE question: how does this person handle pressure from their own
    // centre? Resistance is what the Core costs, Conduct is the standing move when that
    // cost comes due, Drive is the Core aimed at something, Background is retroactive
    // justification for it, Position is the Core aimed at one person, and even Presence
    // — the least Core-bound group — is uniformly about how they READ TO OTHERS.
    // A finished profile is therefore ENTIRELY EXPLICABLE: nothing about the character is
    // arbitrary, and real people are mostly arbitrary.
    //
    // The mechanical cost, which is the reason this exists and not the aesthetic one:
    // buildFieldGenContext hands a generator the whole established profile as fixed
    // material. If every line in that brief traces to the Core, the model has ONE REGISTER
    // AVAILABLE, and a scene calling for small talk or a quiet moment gets a character who
    // monologues about their wound while making tea.
    //
    // A SECOND LIBRARY IS NOT THE INVENTION — THE NEGATIVE CONSTRAINT IS. Written with
    // the same discipline as everything above, these would come back as more Core-derived
    // material under new labels, because the Core is sitting in the brief either way. So
    // every instruction here carries the refusal, and the refusal closes TWO doors: asked
    // for something unrelated to the Core, a narrative-trained model reaches for IRONIC
    // CONTRAST (the assassin who loves gardening), which is a Core comment arrived at by a
    // different route. Hence the fixed clause "Not about the Core, contrast included."
    //
    // The clause is shorter than the group's argument needs because CE_BUILD_STEPS asks
    // this step THIRD, after Drive and before Pattern (see the note there). Generated at
    // that point the brief holds Presence and Core and little else, so there is barely
    // anything to derive from. It stays in every instruction as insurance for the other
    // path: an author filling Aspects late, or regenerating one on a finished character,
    // puts the whole profile back in context.
    //
    // NO `kind` — these are ordinary facets. No slot exists for this group and none
    // should: a slot is card-driven and mandatory-feeling, and there is no single question
    // here that every character must answer.
    // ═══════════════════════════════════════════════════════════════════════════

    { id: 'ce_fx_asp_offduty', slot: 'aspects', label: 'Off-duty', placeholder: 'What they do with an unclaimed hour…',
      instructions: 'State what this character does with an unclaimed hour: the actual activity, and whether anyone knows about it. Two sentences, under 40 words. Not about the Core, contrast included. Avoid drinking alone, staring into the middle distance, and hobbies chosen for irony.' },
    { id: 'ce_fx_asp_taste', slot: 'aspects', label: 'Taste', placeholder: 'What they like, and what they cannot stand…',
      instructions: 'Name something this character likes and something they cannot stand — food, music, weather, a kind of room, a kind of person. Two sentences, under 35 words. Not about the Core, contrast included. Give the specific thing rather than the category, and let at least one of the two be petty or unflattering.' },
    { id: 'ce_fx_asp_knack', slot: 'aspects', label: 'Useless competence', placeholder: 'What they are good at that never comes up…',
      instructions: 'Name something this character is genuinely good at that has never once been useful to them, and how they came by it. Two sentences, under 40 words. Not about the Core, contrast included. It must stay useless — do not let it turn out to matter. Avoid combat skills and anything the plot could plausibly call on.' },
    { id: 'ce_fx_asp_creature', slot: 'aspects', label: 'Creature habits', placeholder: 'How they eat, sleep, and handle discomfort…',
      instructions: 'Describe how this character eats, sleeps, and handles cold, hunger, or discomfort day to day. Two sentences, under 40 words. Not about the Core, contrast included. Ordinary bodily routine, not the toll of their work and not their current condition. Avoid ascetic discipline and avoid never sleeping.' },
    { id: 'ce_fx_asp_opinion', slot: 'aspects', label: 'Opinion', placeholder: 'A view they will argue about…',
      instructions: 'State a view this character holds firmly and will argue about, on a subject that does not matter to the story. Two sentences, under 35 words. Not about the Core, contrast included. Give the position, not the topic, and let it be one a reasonable person could disagree with.' },
    { id: 'ce_fx_asp_means', slot: 'aspects', label: 'Means', placeholder: 'What they can actually afford…',
      instructions: 'State what this character can actually afford: where they sleep, what they eat, what money comes in and how reliably. Two sentences, under 45 words. Not about the Core, contrast included. Their present circumstance, not the station they were born to. Avoid vague wealth and avoid destitution unless the profile establishes it.' },
    { id: 'ce_fx_asp_fear', slot: 'aspects', label: 'Ordinary fear', placeholder: 'Something small they are afraid of…',
      instructions: 'Name a small, common thing this character is afraid of, and what they do to avoid dealing with it. Two sentences, under 35 words. Not about the Core, contrast included — this is not what they are protecting or hiding, it is heights or dogs or deep water. Let it be slightly embarrassing.' },
    { id: 'ce_fx_asp_belief', slot: 'aspects', label: 'Belief', placeholder: 'What they think is true beyond what they can see…',
      instructions: 'State what this character believes about how the world works beyond what they can see — a faith, a cosmology, a superstitious certainty, or a flatly secular conviction — and how much of their behaviour it actually governs. Two sentences, under 45 words. Not about the Core, contrast included. "They have never thought about it" is a complete answer if it is true. Avoid invented pantheons the story has not established, and avoid crises of faith unless the profile earns one.' },

];

// [FIELD-GROUPING] Facets were rendering in a block at the BOTTOM of every
// surface, detached from the slot they deepen \u2014 a Grudge is a Resistance detail, and
// six slots followed by thirty loose facets reads as thirty unrelated extras.
//
// The cause is storage order, not a display decision: cfg.customStaticFields is APPEND-ONLY
// (migrateConfig upserts missing ids onto the end), and BUILTIN_FACETS declares all the
// slots first and all the facets after, so every consumer that walks the array in order
// inherits that split. Fixing it by reordering the stored array was rejected \u2014 it would
// rewrite author config on load, and an author-added field's position is theirs.
//
// So: order at READ time, through one helper, so the lorebook entry, the HUD profile
// payload and the generation context all group identically. Bucketed rather than sorted
// so the result does not depend on Array.prototype.sort stability.
//
// NOT applied to the native character sheet's field catalog (~engine 18820), which groups
// by `kind` into 'Character slots' / 'Facets' / 'Custom fields'. That surface's grouping is
// explicit and visible, and reordering its source list would not interleave the groups
// anyway. If it should follow this model too, that is a separate change to its group
// assignment, not to its ordering.
// [ASPECTS] 'aspects' is LAST and that is a decision, not an accident. This array
// drives three consumers: the profile column, buildLorebookContent, and the "already
// established" brief in buildFieldGenContext. Aspects material is the one group that
// load-bears nothing, so it reads and injects after everything that does. It is asked
// THIRD in the build walk (CE_BUILD_STEPS) — the two orders are independent arrays
// and nothing joins them.
const CE_FIELD_GROUP_ORDER: string[] = ['presence', 'drive', 'resistance', 'conduct', 'position', 'history', 'aspects'];

// Display names for the groups above. These are the Studio's own steps, so an author who
// built the character in the Studio meets the same six words on every other surface.
// 'history' shows as Background because that is what the Studio step is called and what the
// first-class `background` field beside it is called.
const CE_FIELD_GROUP_LABELS: Record<string, string> = {
    presence: 'Presence', drive: 'Drive', resistance: 'Resistance',
    conduct: 'Conduct', position: 'Position', history: 'Background',
    aspects: 'Aspects'
};

// Mirror of the bridge's _studioFacetGroupFor(). core/pursuit fold into 'drive' because the
// stored data makes no distinction there. Returns '' for anything unrecognised \u2014
// including an author-defined field, which has no slot at all \u2014 and those trail the
// grouped ones rather than being dropped or wedged into a group they do not belong to.
function ceStaticFieldGroup(def: any): string {
    const s = String((def && def.slot) || '');
    if (s === 'core' || s === 'pursuit') return 'drive';
    return CE_FIELD_GROUP_ORDER.indexOf(s) >= 0 ? s : '';
}

function ceStaticFieldGroupLabel(group: string): string {
    return CE_FIELD_GROUP_LABELS[group] || 'Other fields';
}

// Returns a NEW array \u2014 never mutates cfg.customStaticFields, which is the stored
// config. Within a group the slot card comes first and facets follow in library order.
function ceOrderStaticFields(defs: any[]): any[] {
    if (!Array.isArray(defs)) return [];
    const buckets: Record<string, any[]> = {};
    for (const g of CE_FIELD_GROUP_ORDER) buckets[g] = [];
    const ungrouped: any[] = [];
    for (const d of defs) {
        if (!d) continue;
        const g = ceStaticFieldGroup(d);
        if (g) buckets[g].push(d); else ungrouped.push(d);
    }
    let out: any[] = [];
    for (const g of CE_FIELD_GROUP_ORDER) {
        out = out.concat(
            buckets[g].filter(function(d: any) { return String(d.kind || '') === 'slot'; }),
            buckets[g].filter(function(d: any) { return String(d.kind || '') !== 'slot'; })
        );
    }
    return out.concat(ungrouped);
}

function migrateConfig(raw: any): GlobalConfig {
    // Merges raw saved data over defaults so new fields always have values.
    // Strips deprecated keys so old saves don't carry stale data.
    const d = makeDefaultConfig();
    const c = { ...d, ...raw };

    // [FACETS] Seed built-in facets. Runs inside migrateConfig for the same reason
    // the travel templates do (see loadConfig's note): migrateConfig is applied to the
    // DEFAULT as well as to saved data, so a brand-new story gets the library without any
    // import step, and an existing story picks up newly added facets on next load.
    //
    // Adds by id ONLY where absent. An author who has edited a built-in facet's label or
    // instructions keeps their version forever — re-seeding over the top would silently
    // discard tuning work, which is the whole reason this is an upsert-if-missing rather
    // than a merge.
    if (!Array.isArray(c.customLocationFields)) c.customLocationFields = [];   // [LOC-PROFILE4]
    if (!Array.isArray(c.customItemFields)) c.customItemFields = [];           // [ITEM-CAT]
    if (!Array.isArray((c as any).customFactionFields)) (c as any).customFactionFields = [];  // [F-28]
    if (!Array.isArray((c as any).customNarrativeFields)) (c as any).customNarrativeFields = [];  // [NARR-LENS]
    if (!Array.isArray(c.customStaticFields)) c.customStaticFields = [];
    for (const bf of BUILTIN_FACETS) {
        const bfExisting = c.customStaticFields.filter(function(f: any) { return f && f.id === bf.id; })[0];
        if (!bfExisting) {
            c.customStaticFields.push({ id: bf.id, slot: bf.slot, label: bf.label, placeholder: bf.placeholder, instructions: bf.instructions, kind: bf.kind || 'facet' });
            continue;
        }
        // [earlier KIND-BACKFILL, per user: "Presence, Resistance and Conduct are missing
        // fields"] THE UPSERT ABOVE ADDS BY ID ONLY, AND `kind` WAS ADDED TO THE SEED AFTER
        // THE SEED HAD ALREADY RUN. A config seeded before an earlier `kind` therefore holds
        // ce_slot_presence / ce_slot_resist_* / ce_slot_conduct_* with NO kind at all, and
        // buildCharProfilePayload defaults a missing kind to 'facet'. Every one of the six
        // slots then reached the Profile classified as a facet -- which means _ceSlotsFor
        // skipped it and the sparse rule (facets self-suppress while empty) HID IT.
        //
        // That is why the symptom looked like a layout regression and was not one: the
        // condensed rewrite did not touch this path. It looked new because Drive's two slots
        // had text in them and rendered anyway (a WRITTEN facet is shown), so only the empty
        // ones vanished, and only on a config old enough to predate the field.
        //
        // BACKFILL `kind` ONLY. label/instructions/placeholder/slot stay exactly as stored,
        // because those are the fields an author may have tuned and the upsert-if-missing
        // rule above exists to protect. `kind` is machine classification -- it decides which
        // renderer and which picker a def belongs to -- and there is no author-meaningful
        // reason for a built-in's kind to differ from the library's.
        const bfKind = bf.kind || 'facet';
        if (String((bfExisting as any).kind || '') !== bfKind) { (bfExisting as any).kind = bfKind; }
    }

    // Deprecated field removal
    delete c.storyRolePresets;
    delete c.conditionPresets;
    delete (c as any).defaultBudgetCap;
    delete (c as any).globalRules;
    delete (c as any).arcTypePresets; // Purge old config properties

    // Structural guards
    // [REMOVED earlier, per user] Was: [HOLDING] Seed the baked-in default player
    // faction (idempotent by id). This existed to give the Holding system's roster a
    // default source — but Holding Document authoring + the player-faction picker
    // were already CE-STRIPped out (see buildFactionsWorkspace's own removal note,
    // "[CE-STRIP v2.0.x] Holding Document authoring + player-faction picker removed").
    // Nothing has read DEFAULT_PLAYER_FACTION_ID except this seed since that strip —
    // verified zero remaining callers before deleting both the seed and the constant
    // (grep DEFAULT_PLAYER_FACTION_ID / 'fac_player' turns up nothing else). A fresh
    // config no longer gets an uneditable "The Player" faction it never asked for;
    // existing saves that already have one are UNTOUCHED (this only ever ran on
    // migration, never as a delete pass) — remove it by hand via the Factions Manager
    // if you don't want it.
    // [F-28] `if (!c.factions) c.factions = []` DELETED FROM BOTH SITES. It ran on every
    // loadConfig, so it re-created the array ceMigrateFactionsToEntities had just deleted and
    // the cleanup never stuck. A default that resurrects a migrated-away key is the quietest
    // way a migration can appear to work and not.
    if (!c.relationshipArchetypes) c.relationshipArchetypes = JSON.parse(JSON.stringify(DEFAULT_REL_ARCHETYPES));
    // [F-09] The conditions seed-and-guard pair lived here. Both are gone: the catalog
    // is cfg.stateDefs, seeded above, and the conditions -> stateDefs migration beside it
    // consumes and deletes whatever cfg.conditions a save still carries.
    // (retired guard)
    // that already have SOME conditions (even a custom, edited list) are left alone —
    // same non-destructive pattern as relationshipArchetypes above.

    // [SEC:STATE][D-25] Seeded once, on a config that has never had the key. An
    // existing story that has ALREADY edited or emptied its catalog is left alone -- same
    // non-destructive rule conditions and archetypes above use, and deliberately NOT a
    // per-row upsert: a per-row backfill would resurrect a seed the author deleted, which
    // is the KIND-BACKFILL failure inverted.
    if (!(c as any).stateDefs) (c as any).stateDefs = JSON.parse(JSON.stringify(DEFAULT_STATE_DEFS));
    if (!(c as any).resolutionDefs) (c as any).resolutionDefs = JSON.parse(JSON.stringify(DEFAULT_RESOLUTION_DEFS));  // [F-12]
    // [I-04] THE NO-ROLL BACKFILL IS DELETED, not merely stopped. It ran on every load and
    // re-created the row by id, so leaving it would have resurrected exactly what the v7
    // migration below removes -- the same failure the two `if (!c.factions)` lines caused for
    // F-28, and the quietest way a migration can appear to work and not.
    if (!(c as any).stakeDefs) (c as any).stakeDefs = JSON.parse(JSON.stringify(DEFAULT_STAKE_DEFS));  // [F-14]
    // [F-15d] NO SEED, ONLY THE EMPTY LIST. Every other catalog above ships defaults
    // because an author needs something to roll against on turn one; a preset is a record
    // of a move the author has already made, so a seeded one would be the engine claiming
    // to remember something that never happened.
    if (!Array.isArray((c as any).actionPresets)) (c as any).actionPresets = [];

    // [F-09] CONDITIONS -> STATE DEFS. One-way, stamped, and it runs before the catalog is
    // read by anything. THE RANGE SHIFTS DOWN BY ONE: a condition was ABSENT-or-active with
    // stage 0 as its mildest ACTIVE stage, and a state is always present, so value 0
    // becomes "not this" and the stages occupy 1..N. Rest-band suppression (D-22) then
    // gives back exactly the absence the old presence-in-an-array encoded.
    //   { id, name, stages: [a,b,c] }
    //     -> min 0, max 3, start 0, restBand 0,
    //        bands [ {0,''}, {1,a}, {2,b}, {3,c} ]
    //   { id, name, stages: [] }        (an on/off condition)
    //     -> min 0, max 1, bands [ {0,''}, {1,''} ]   -- the DEF NAME carries the sentence
    // IDS ARE PRESERVED, so char.activeConditions[].defId keys straight into stateValues
    // without a lookup table, and a story whose author hand-edited a condition keeps it.
    // THE AUTHOR'S OWN TEMPLATE MIGRATES WITH THEM: cfg.lorebookTemplates.condition is
    // copied onto each def's `line`, so a customised template survives as the customisation
    // it was rather than being silently replaced by the new default.
    if (Array.isArray((c as any).conditions) && (c as any).conditions.length) {
        var condTpl = String(((c as any).lorebookTemplates && (c as any).lorebookTemplates.condition) || '')
                        || '[|name| is currently |defName|.][ |bandLabel|]';
        // The old template spoke |conditionName| and |stageText|; the new one speaks
        // |defName| and |bandLabel|. Rename in place rather than dropping the author's line.
        condTpl = condTpl.replace(/\|conditionName\|/g, '|defName|').replace(/\|stageText\|/g, '|bandLabel|');
        var sdList: any[] = (c as any).stateDefs;
        var seen: any = {};
        for (var sdi = 0; sdi < sdList.length; sdi++) { if (sdList[sdi]) seen[String(sdList[sdi].id)] = true; }
        for (var ci = 0; ci < (c as any).conditions.length; ci++) {
            var cond: any = (c as any).conditions[ci];
            if (!cond || !cond.id || seen[String(cond.id)]) continue;
            var stages: any[] = Array.isArray(cond.stages) ? cond.stages : [];
            var nb: any[] = [ { at: 0, label: '' } ];
            for (var si = 0; si < stages.length; si++) nb.push({ at: si + 1, label: String(stages[si] || '') });
            if (nb.length === 1) nb.push({ at: 1, label: '' });   // on/off
            sdList.push({
                id: String(cond.id), name: String(cond.name || 'Condition'), scope: 'char',
                min: 0, max: nb.length - 1, start: 0, bands: nb, restBand: 0, line: condTpl,
                // [F-11b] Migrated conditions keep their identity as a GROUP even though they
                // stopped being a separate kind. That is the whole point of the field: the
                // collapse was mechanical, the author's mental model was not.
                category: 'Conditions'
            });
        }
    }
    delete (c as any).conditions;
    if (!c.lorebookTemplates) c.lorebookTemplates = JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_TEMPLATES));
    else {
        // [LOREFOLD] backfill every lorebook template key so old saves gain the
        // new equipment/journal lines without clobbering customised ones.
        for (const _ltk of Object.keys(DEFAULT_LOREBOOK_TEMPLATES)) {
            if (!(c.lorebookTemplates as any)[_ltk]) (c.lorebookTemplates as any)[_ltk] = (DEFAULT_LOREBOOK_TEMPLATES as any)[_ltk];
        }
        // [POSITION] The V214 reshape loop was deleted here with its map. The
        // three orphaned keys it operated on are deliberately NOT stripped from saved
        // configs: an unread key costs nothing, and a config strip is the one migration
        // that cannot be undone if the decision is ever revisited.
    }
    // [LOREFOLD] Per-field include switches — default any missing key to on.
    if (!c.lorebookFields) c.lorebookFields = JSON.parse(JSON.stringify(DEFAULT_LOREBOOK_FIELDS));
    else {
        for (const _lfk of Object.keys(DEFAULT_LOREBOOK_FIELDS)) {
            if ((c.lorebookFields as any)[_lfk] === undefined) (c.lorebookFields as any)[_lfk] = (DEFAULT_LOREBOOK_FIELDS as any)[_lfk];
        }
    }
    // Migrate legacy string[] archetypes → RelationshipArchetypeDef[]
    if (Array.isArray(c.relationshipArchetypes) && c.relationshipArchetypes.length > 0 && typeof c.relationshipArchetypes[0] === 'string') {
        c.relationshipArchetypes = (c.relationshipArchetypes as any[]).map(function(s: any) {
            return { id: 'arch_' + String(s).toLowerCase().replace(/[^a-z0-9]+/g, '_').slice(0, 24) + '_' + Math.random().toString(36).slice(2, 6), name: String(s), stages: [] };
        });
    }
    if (!c.customStaticFields)     c.customStaticFields = [];
    if (!c.fieldLabels)            c.fieldLabels = {};
    if (!c.fieldInstructions)      c.fieldInstructions = {};
    if (!c.fieldBudgets)           c.fieldBudgets = {};
    if (!c.sheetCategories)        c.sheetCategories = [];
    if (c.ephemeralCap === undefined) c.ephemeralCap = 3;

    // [CE-STRIP v2.0.x] Global/party resources migration removed — Resources cut.

    // earlier fields
    if (!c.species)  c.species  = [];

    // [F-24] STANDING LADDERS. The world default is filled only when the key is ABSENT --
    // an author who emptied it meant it, same non-destructive rule the archetype and state
    // seeds above use.
    if (!Array.isArray((c as any).standingLadder)) (c as any).standingLadder = DEFAULT_STANDING_LADDER.slice();
    // relationshipStates -> standingLadder, CONSUMED AND DELETED rather than mirrored. Every
    // faction was seeded with the identical five words, so a straight copy would give every
    // existing story N overrides that all say what the default already says -- which is the
    // exact condition F-24 exists to remove. A ladder is carried forward ONLY if it actually
    // differs from the default; otherwise the faction is left to inherit.
    var mfl: any[] = (c as any).factions || [];
    for (var mfi = 0; mfi < mfl.length; mfi++) {
        var mfac: any = mfl[mfi];
        if (!mfac) continue;
        var mold: any = mfac.relationshipStates;
        if (Array.isArray(mold) && mold.length && !Array.isArray(mfac.standingLadder)) {
            var msame = (mold.length === DEFAULT_STANDING_LADDER.length);
            if (msame) {
                for (var mj = 0; mj < mold.length; mj++) {
                    if (String(mold[mj]) !== DEFAULT_STANDING_LADDER[mj]) { msame = false; break; }
                }
            }
            if (!msame) mfac.standingLadder = mold.slice();
        }
        // DELETED, NOT LEFT LYING. A dead array that the lorebook builder still reads is how
        // a superseded field goes on shipping prose about itself for another five versions.
        if (mfac.relationshipStates !== undefined) delete mfac.relationshipStates;
    }
    // [F-28] THE STANDING SYNC MOVED OUT OF HERE. It reads faction ENTITIES now, which is
    // async, and migrateConfig is sync. It runs from onScriptsLoaded instead -- the repair
    // guarantee is unchanged, only the hook it hangs from. The relationshipStates fold above
    // stays: it operates on cfg.factions, which still exists at this point on an old save
    // and is consumed by ceMigrateFactionsToEntities immediately afterward.

    // Dynamic-update cadence unit + intervals. From earlier through v2.53.x the
    // token-interval fields were DELETED here on every load (per-generation cadence had
    // replaced per-token). They are now reintroduced as an OPT-IN alternative unit, so the
    // deletes are gone — stripping them would wipe the user's token settings every load. A
    // stale token value on a earlier save is harmless: it is only consulted when
    // dynamicIntervalMode === 'tokens', which those old saves never set, and the defaults
    // below only fill a MISSING field, never overwrite a real one.
    if ((c as any).dynamicIntervalMode !== 'tokens' && (c as any).dynamicIntervalMode !== 'gens') (c as any).dynamicIntervalMode = 'gens';
    if (!(c as any).thoughtIntervalTokens) (c as any).thoughtIntervalTokens = 500;
    if (!(c as any).hookIntervalTokens)    (c as any).hookIntervalTokens    = 1500;
    // Ensure gen-interval fields exist (new saves via makeDefaultConfig will have them)
    if (!c.thoughtIntervalGens) c.thoughtIntervalGens = 2;
    if (!c.hookIntervalGens)    c.hookIntervalGens    = 6;
    // [POSITION] arcIntervalGens / arcIntervalTokens guards deleted with the
    // relationship generator. Saved values are left in place rather than deleted, same
    // reasoning as the orphaned lorebook template keys above.
    if (c.maxGenerationsPerTurn === undefined) c.maxGenerationsPerTurn = 1;  // [TURN-CAP]
    if (c.maxDynamicCharacters === undefined) c.maxDynamicCharacters = 0;  // [vNEXT] no cap by default
    if (typeof (c as any).graveyardEntityId !== 'string') (c as any).graveyardEntityId = '';  // [KILL]
    if (c.totalGenerations === undefined) c.totalGenerations = 0;
    if (c.defaultBackgroundUrl === undefined) c.defaultBackgroundUrl = ''; // 
    if (!c.contextTemplates) c.contextTemplates = JSON.parse(JSON.stringify(DEFAULT_TEMPLATES));
    if (typeof (c as any).interfaceMode !== 'string') (c as any).interfaceMode = 'native';  // [earlier]
    // [CE-STRIP earlier CTX-CUT] The old earlier template-upgrade loop (location/
    // trackedNarrative/player/npc) is gone along with those keys. A save from before
    // this pass still has a contextTemplates object, just missing the new
    // criticalHook key — backfill it so old saves don't render a blank hook line.
    // Any orphaned location/player/npcWeb/trackedNarrative/activeNarrative string
    // values left on old saves are harmless — unread by anything now.
    if (c.contextTemplates && !(c.contextTemplates as any).criticalHook) {
        (c.contextTemplates as any).criticalHook = DEFAULT_TEMPLATES.criticalHook;
    }
    // [LOREFOLD] Backfill the re-added NPC-web AN template, and migrate the
    // pre-LOREFOLD fat npc template to thoughts-only so relationship/goal/conditions
    // are not injected in BOTH the AN and the lorebook. Hand-authored npc strings
    // (anything other than the known old default) are preserved untouched.
    // [POSITION] Same backfill for the new position line, so a save from before
    // this pass gets the AN template rather than an empty string (which parseMacroTemplate
    // would render as nothing at all, making Position look broken rather than unconfigured).
    if (c.contextTemplates && (c.contextTemplates as any).criticalHook === OLD_CRITICAL_HOOK_V1) {
        (c.contextTemplates as any).criticalHook = DEFAULT_TEMPLATES.criticalHook;
    }
    if (c.contextTemplates && !(c.contextTemplates as any).position) {
        (c.contextTemplates as any).position = (DEFAULT_TEMPLATES as any).position;
    }
    if (c.contextTemplates && !(c.contextTemplates as any).place) {
        (c.contextTemplates as any).place = (DEFAULT_TEMPLATES as any).place;
    }
    if (c.contextTemplates && !(c.contextTemplates as any).present) {
        (c.contextTemplates as any).present = (DEFAULT_TEMPLATES as any).present;
    }
    if (c.contextTemplates && !(c.contextTemplates as any).npcWeb) {
        (c.contextTemplates as any).npcWeb = DEFAULT_TEMPLATES.npcWeb;
    }
    // [T-06] Backfill the time line, on the same terms as the four above it: a save written
    // before this key would otherwise render an empty template, which parseMacroTemplate
    // resolves to nothing at all -- making a working clock look like a broken one.
    // THIS BACKFILLS A TEMPLATE AND NOT c.calendar. ceCalendar fills the calendar's defaults
    // on every read, so materialising it here would be the two `if (!c.factions)` lines
    // wearing new clothes: a load-time default that resurrects a key nothing asked for.
    if ((c.contextTemplates as any) && (c.contextTemplates as any).time === undefined) {
        (c.contextTemplates as any).time = (DEFAULT_TEMPLATES as any).time;
    }
    // [SCENEBLOCK] Upgrade the two prior defaults in place. Byte-exact, so a hand-authored
    // template is untouched and keeps rendering as the author wrote it.
    if (c.contextTemplates && (c.contextTemplates as any).time === OLD_TIME_V35) {
        (c.contextTemplates as any).time = (DEFAULT_TEMPLATES as any).time;
    }
    if (c.contextTemplates && (c.contextTemplates as any).place === OLD_PLACE_V35) {
        (c.contextTemplates as any).place = (DEFAULT_TEMPLATES as any).place;
    }
    if (c.contextTemplates && (c.contextTemplates as any).present === OLD_PRESENT_V35) {
        (c.contextTemplates as any).present = (DEFAULT_TEMPLATES as any).present;
    }
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V28) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [EPHEMERAL-REWIRE] Same upgrade pattern: only replaces the template if it
    // still exactly matches the pre-v2.83 stock default. A hand-edited npc template
    // (using the old |ephemeral.compressedLine| macro or anything else) is left alone.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V82) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [NPC-TPL-2LINE] Same upgrade pattern again, for the one-line v2.83-v2.86
    // default. Hand-edited templates are still left alone.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V86) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [NPC-TPL-1LINE] Upgrade the short-lived earlier two-line default too.
    if (c.contextTemplates && (c.contextTemplates as any).npc === OLD_NPC_TEMPLATE_V87) {
        (c.contextTemplates as any).npc = DEFAULT_TEMPLATES.npc;
    }
    // [ATMO] A TOKEN SWAP, NOT A TEMPLATE REPLACEMENT, and that is the whole reason it can
    // run unconditionally. The three upgrades above compare the WHOLE string and leave a
    // hand-edited template alone -- correct for them, because they changed what the line
    // says. This one retires a MACRO: |locationDescription| is no longer passed, so a
    // customised place template naming it would keep its own wording and silently lose the
    // bracket it sat in. Swapping the token in place preserves the author's line exactly
    // and repoints it at the field that replaced it, which already falls back to the
    // description. A template that never named it is untouched, and running twice is a
    // no-op because there is nothing left to match.
    if (c.contextTemplates && typeof (c.contextTemplates as any).place === 'string'
        && (c.contextTemplates as any).place.indexOf('|locationDescription|') >= 0) {
        (c.contextTemplates as any).place =
            (c.contextTemplates as any).place.split('|locationDescription|').join('|atmosphere|');
    }
    
    // [vNEXT] Seed the World-Build Wizard's Memory section list and concept fields.
    if (!c.wizardSections) {
        c.wizardSections = JSON.parse(JSON.stringify(DEFAULT_WIZARD_SECTIONS));
    }
    if (c.projectName === undefined) c.projectName = '';
    if (c.projectGenre === undefined) c.projectGenre = '';
    if (c.projectConcept === undefined) c.projectConcept = '';

    // [CE-STRIP v2.0.x] time* migration-fill removed — Clock/Calendar cut.

    return c as GlobalConfig;
}

async function loadConfig(): Promise<GlobalConfig> {
    const raw = await api.v1.storyStorage.getOrDefault(STORAGE_CONFIG, null);
    // [SEED1] Run migrateConfig on the DEFAULT too, so a brand-new story is
    // seeded with sys_default_travel / sys_return_travel. Previously makeDefaultConfig
    // bypassed migrateConfig, leaving fresh stories with no travel templates until the
    // action editor happened to save a config -> travel silently did nothing.
    return migrateConfig(raw ? raw : makeDefaultConfig());
}

async function saveConfig(cfg: GlobalConfig): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_CONFIG, cfg);
}

// ── [D-04] THE PROTAGONIST REFERENCE ────────────────────────────────────────
// The one id any consumer may pass in place of a real character id to mean "whoever the
// protagonist currently is". Hook targets and Position targets both store it.
//
// THE VALUE STAYS '__player__' WHILE THE NAME SAYS PROTAGONIST, and that is the whole
// point of introducing a constant rather than a rename. This string is PERSISTED inside
// every saved position and hook in every existing story; changing it is a migration over
// the whole roster, and it buys nothing a reader can see, because a stored sentinel is an
// opaque token -- exactly the argument that keeps the storage key 'ce_player_location'
// alone. What was actually wrong was the terminology at the ~18 code sites that compared
// against the bare literal, and a named constant fixes that without touching a byte of
// anybody's story. AMENDS D-03's tier-2 plan (migrate the sentinel) accordingly.
var CE_PROTAGONIST_REF = '__player__';

function ceIsProtagonistRef(v: any): boolean {
    return String(v || '') === CE_PROTAGONIST_REF;
}

// [D-01] The pointer, with a one-shot adoption for stories written before it existed.
// SELF-HEALING RATHER THAN A MIGRATION PASS, same shape loadProtagonistLocation already
// uses for the camera: a story whose roster carries the old isProtagonist flag and whose
// config carries no pointer adopts the flag the first time anything asks, and persists the
// answer so the scan happens once. A roster with no protagonist writes nothing and returns
// '' every time, which is the correct answer and not a failure.
async function ceProtagonistId(cfg?: GlobalConfig | null): Promise<string> {
    let pgCfg: any = cfg;
    try { if (!pgCfg) pgCfg = await loadConfig(); } catch (ePg) { return ''; }
    let pgId = String((pgCfg && pgCfg.protagonistCharId) || '');
    if (pgId) return pgId;
    try {
        let pgIdx = await loadIndex();
        let pgMeta = pgIdx.find(function(m: any) { return !!m.isProtagonist; });
        if (!pgMeta) return '';
        pgCfg.protagonistCharId = String(pgMeta.id);
        if (!pgCfg.protagonistName) pgCfg.protagonistName = String(pgMeta.name || '');
        await saveConfig(pgCfg).catch(function() {});
        return String(pgMeta.id);
    } catch (ePg2) { return ''; }
}

// [D-04] CE_PROTAGONIST_REF -> a real character id. Anything else passes through
// unchanged, so a caller can hand this an id it has not inspected. Returns '' when the
// ref is the protagonist and there is no protagonist -- the caller's own empty-id path.
async function ceResolveCharRef(ref: string, cfg?: GlobalConfig | null): Promise<string> {
    let pgRef = String(ref || '');
    if (!ceIsProtagonistRef(pgRef)) return pgRef;
    return await ceProtagonistId(cfg);
}

// [D-01] THE ONLY WRITER of the protagonist pointer, and therefore the only place the
// stored isProtagonist projection is maintained. Pass '' to clear.
// THE SWEEP IS WHAT ENFORCES EXCLUSIVITY. Writing the pointer alone would leave a stale
// `true` on whoever held it before, and every one of the 40 read sites would then see two
// protagonists -- the exact failure the pointer exists to make unrepresentable. Saves only
// the records whose flag actually changes, so the common case (a story with one
// protagonist, re-set to the same character) writes nothing.
async function setProtagonist(charId: string): Promise<void> {
    let spNext = String(charId || '');
    try {
        let spIdx = await loadIndex();
        let spName = '';
        for (let spI = 0; spI < (spIdx || []).length; spI++) {
            let spMeta: any = spIdx[spI];
            if (!spMeta || !spMeta.id) continue;
            let spWant = (String(spMeta.id) === spNext && !!spNext);
            if (spWant) spName = String(spMeta.name || '');
            if (!!spMeta.isProtagonist === spWant) continue;
            let spChar = await loadCharacter(String(spMeta.id));
            if (!spChar) continue;
            spChar.isProtagonist = spWant;
            await saveCharacter(spChar).catch(function() {});
        }
        let spCfg = await loadConfig();
        spCfg.protagonistCharId = spNext;
        spCfg.protagonistName = spNext ? spName : '';
        await saveConfig(spCfg);
        // The roster entry leads with the protagonist, so the cast text is stale the
        // moment this changes. force=true: the dirty check compares built text, and a
        // swap between two characters can produce an identical-length list.
        await syncCastLore('cast', true).catch(function() {});
    } catch (e) { api.v1.error('[AE] setProtagonist:', e); }
}

// ── Relationship archetype helpers ──────────────────────────────────────────
// [POSITION] findArchetypeDef and resolveArchetypeStage DELETED. They resolved
// a saved archetypeId + stageIndex into a stage label for the |relStage| macro and the
// ◀/▶ stage stepper. Both went with the ladder: an archetype is a one-shot SEED, so there
// is no stored reference left to resolve and no ordered track to step along.
// [F-20] IT SEEDS PROSE, NOT A NAME. The line above said "copies a name into
// Position.shape", which was accurate and was the bug: shape asks what a relationship IS
// and a category word is not an answer. The catalog now carries a prose `shape` and prose
// standings, and _ceProfilePositionKids is the door that copies them in.
// STILL NO STORED LINK. _ceArchetypeForShape derives "which archetype was this seeded from"
// by matching the shape TEXT, precisely so CharPosition does not grow an archetypeId that
// would reintroduce the reference this deletion removed.

// ── Unified search picker ───────────────────────────────────────────────────
// Any picker with potentially >5 options should use this. Renders a live search
// box that re-filters as the user types. items: { id, label }[]. onSelect gets the
// chosen id. Auto-omits the search box when there are 5 or fewer items.


// ============================================================================
// SECTION 7b — STATE CORE   [SEC:STATE]
// The one primitive (D-19) and its three verbs (D-23). Everything AE called a resource,
// a track, a gauge, a faction standing or a condition is this, differing only in bounds,
// bands and scope.
//
// ── WHAT LIVES WHERE ────────────────────────────────────────────────────────
//   catalog            cfg.stateDefs                     (Settings > States)
//   char/protagonist   CharacterRecord.stateValues       (Profile > States)
//   world              STORAGE_STATE_WORLD
//   faction            STORAGE_STATE_FACTION
// A MISSING VALUE IS NOT AN ERROR AND IS NEVER BACKFILLED. Every read falls to the def's
// `start`, so adding a def to a story with fifty characters writes nothing and a KIND-
// BACKFILL-shaped bug (a seed that never reaches records created before it) cannot occur
// here by construction.
//
// ── THE VERBS OWN THE INVARIANTS ────────────────────────────────────────────
// Build order §6: named verbs first, the rule engine last as a thin dispatch over them.
// So clamping lives HERE, at the write, and not in any caller. There is deliberately no
// way to store a value outside [min,max].
//
// ── CHAINS, AND THE ONE RULE ────────────────────────────────────────────────
// char/protagonist writes go through ceProfileOp because they ARE character-record
// writes, and that inherits the documented ceEntityOp-outer/ceProfileOp-inner order
// rather than adding a third participant to it. world/faction writes have no record
// overlap with either, so they get their own chain.
//   NEVER CALL stateSet/stateNudge FROM INSIDE ceProfileOp. It is a promise chain, so a
//   reentrant call waits on a link that cannot resolve until the caller returns. A verb
//   that already holds the chain should mutate `c.stateValues` directly and let its own
//   save land -- _ceStateApply is the shared clamp for exactly that case.
//
// ── NOT HERE YET ────────────────────────────────────────────────────────────
// Injection. A def with bands is ELIGIBLE (D-21) and a value off its rest band is
// INFORMATION (D-22) -- both are computed by ceStateBand below and read by nobody. The
// line template, the macro and the lorebook fold land with the conditions migration; per
// answer to open Q4 states inject through the LOREBOOK, not the Author's Note, which
// supersedes the queue's `an.state` row.
// ============================================================================

// -- Catalog lookups (pure) ---------------------------------------------------

function ceStateDefs(cfg: GlobalConfig | null): StateDef[] {
    var list: any = (cfg as any) ? (cfg as any).stateDefs : null;
    return Array.isArray(list) ? (list as StateDef[]) : [];
}

function ceStateDef(cfg: GlobalConfig | null, defId: string): StateDef | null {
    var defs = ceStateDefs(cfg);
    for (var i = 0; i < defs.length; i++) {
        if (defs[i] && String(defs[i].id) === String(defId)) return defs[i];
    }
    return null;
}

// Bounds are read defensively rather than trusted: min/max arrive from an author-edited
// number field, and a def with max < min would otherwise make every clamp return NaN.
function _ceStateBounds(def: StateDef): { lo: number; hi: number } {
    var lo = Number(def.min); if (!isFinite(lo)) lo = 0;
    var hi = Number(def.max); if (!isFinite(hi)) hi = lo;
    if (hi < lo) hi = lo;
    return { lo: lo, hi: hi };
}

function ceStateClamp(def: StateDef, v: any): number {
    var b = _ceStateBounds(def);
    var n = Number(v);
    if (!isFinite(n)) n = Number(def.start) || 0;
    n = Math.round(n);
    return Math.max(b.lo, Math.min(b.hi, n));
}

function ceStateStart(def: StateDef): number {
    return ceStateClamp(def, def.start);
}

// -- Bands: the whole of the projection layer (F-08) ---------------------------
// PURE, SYNCHRONOUS, NO STORAGE. That is what makes it safe to call from a render path,
// which the States drill does per row.
//
// D-20 HELD STRUCTURALLY: this returns the label and the number SIDE BY SIDE and offers
// no switch to hide either. Surfaces show both; whatever eventually injects shows the
// label alone. Neither is a per-def option, so neither can be misconfigured.
//
// index === -1 means the def has no bands at all -- eligible for nothing, by D-21.
function ceStateBand(def: StateDef, value: number): { index: number; label: string; atRest: boolean; banded: boolean } {
    var out = { index: -1, label: '', atRest: true, banded: false };
    var bands: any[] = (def && Array.isArray(def.bands)) ? def.bands : [];
    if (!bands.length) return out;
    out.banded = true;
    var v = ceStateClamp(def, value);
    // First band wins the floor whatever its own `at` says -- see StateBand.
    var idx = 0;
    for (var i = 0; i < bands.length; i++) {
        if (!bands[i]) continue;
        var at = Number(bands[i].at);
        if (!isFinite(at)) continue;
        if (i === 0 || v >= at) idx = i;
    }
    out.index = idx;
    out.label = String((bands[idx] && bands[idx].label) || '');
    // [D-22] Rest is an INDEX comparison, not an empty-label test. A resting band is
    // free to carry a display label ("is unhurt") and still inject nothing; an empty
    // label on a NON-resting band is an authoring gap, not a suppression switch.
    var rest = Number(def.restBand);
    if (!isFinite(rest)) rest = 0;
    rest = Math.max(0, Math.min(bands.length - 1, Math.round(rest)));
    out.atRest = (idx === rest);
    return out;
}

// [D-21 + D-22, stated once so no caller re-derives it] A value reaches context only if
// its def has bands AND it is off its rest band.
// [F-09] THE NON-EMPTY LABEL TEST WAS REMOVED and its removal is load-bearing. A migrated
// on/off condition has bands ['', ''] and says "Aria is currently Pregnant." out of its
// DEF NAME -- the band carries no words because there are no stages to carry. Requiring a
// label here would have made every two-state condition silent on migration, which is the
// class of bug that only shows up in somebody else's save. An empty RENDER is still
// dropped; that check belongs at the render, not here.
function ceStateSpeaks(def: StateDef, value: number): boolean {
    var b = ceStateBand(def, value);
    return b.banded && !b.atRest;
}

// [F-10] The line one def writes for one owner, or '' if it is silent or renders empty.
// THE ONLY PLACE A STATE BECOMES PROSE -- four readers reach context through
// buildCharDynamicBlock and every one of them lands here.
function ceStateLine(cfg: GlobalConfig | null, def: StateDef, ownerName: string, value: number): string {
    if (!ceStateSpeaks(def, value)) return '';
    var band = ceStateBand(def, value);
    var tpl = String(def.line || '').trim() || DEFAULT_STATE_LINE;
    try {
        return parseMacroTemplate(tpl, {
            name: ownerName || '', defName: String(def.name || ''),
            bandLabel: band.label, value: String(value)
        }).trim();
    } catch (e) { api.v1.error('[AE:state] line:', e); return ''; }
}

// Every speaking line for one character, in catalog order, one per def.
function ceStateLinesForChar(cfg: GlobalConfig | null, char: any): string[] {
    if (!char) return [];
    var isProt = !!(cfg && String((cfg as any).protagonistCharId || '') === String(char.id || ''));
    var rows = ceStateRowsForChar(cfg, char, isProt);
    var out: string[] = [];
    for (var i = 0; i < rows.length; i++) {
        if (!rows[i].speaks) continue;
        var def = ceStateDef(cfg, rows[i].defId);
        if (!def) continue;
        var ln = ceStateLine(cfg, def, String(char.name || ''), rows[i].value);
        if (ln) out.push(ln);
    }
    return out;
}

// -- Scope storage ------------------------------------------------------------
// Shaped after loadCastLore: getOrDefault, coerce every field, never throw upward.

async function loadWorldStates(): Promise<Record<string, number>> {
    var out: Record<string, number> = {};
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_STATE_WORLD, null);
        if (raw && typeof raw === 'object') {
            var keys = Object.keys(raw);
            for (var i = 0; i < keys.length; i++) {
                var n = Number(raw[keys[i]]);
                if (isFinite(n)) out[keys[i]] = n;
            }
        }
    } catch (e) { api.v1.error('[AE:state] world load:', e); }
    return out;
}

async function saveWorldStates(v: Record<string, number>): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_STATE_WORLD, v || {}); }
    catch (e) { api.v1.error('[AE:state] world save:', e); }
}

async function loadFactionStates(): Promise<Record<string, Record<string, number>>> {
    var out: Record<string, Record<string, number>> = {};
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_STATE_FACTION, null);
        if (raw && typeof raw === 'object') {
            var fids = Object.keys(raw);
            for (var i = 0; i < fids.length; i++) {
                var row: any = raw[fids[i]];
                if (!row || typeof row !== 'object') continue;
                var inner: Record<string, number> = {};
                var dks = Object.keys(row);
                for (var j = 0; j < dks.length; j++) {
                    var n = Number(row[dks[j]]);
                    if (isFinite(n)) inner[dks[j]] = n;
                }
                out[fids[i]] = inner;
            }
        }
    } catch (e) { api.v1.error('[AE:state] faction load:', e); }
    return out;
}

async function saveFactionStates(v: Record<string, Record<string, number>>): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_STATE_FACTION, v || {}); }
    catch (e) { api.v1.error('[AE:state] faction save:', e); }
}

// [EVENT] The same pair keyed by milestone id. DELIBERATELY A COPY RATHER THAN A
// GENERALISED loadKeyedStates(key): the two differ in nothing today, and the moment one of
// them needs a per-owner default or a reap the shared version would grow a mode flag. Two
// twenty-line readers that never diverge cost less than one that has to be read twice to
// see which owner it is serving.
async function loadEventStates(): Promise<Record<string, Record<string, number>>> {
    var out: Record<string, Record<string, number>> = {};
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_STATE_EVENT, null);
        if (raw && typeof raw === 'object') {
            var eids = Object.keys(raw);
            for (var i = 0; i < eids.length; i++) {
                var row: any = raw[eids[i]];
                if (!row || typeof row !== 'object') continue;
                var inner: Record<string, number> = {};
                var dks = Object.keys(row);
                for (var j = 0; j < dks.length; j++) {
                    var n = Number(row[dks[j]]);
                    if (isFinite(n)) inner[dks[j]] = n;
                }
                out[eids[i]] = inner;
            }
        }
    } catch (e) { api.v1.error('[AE:state] event load:', e); }
    return out;
}

async function saveEventStates(v: Record<string, Record<string, number>>): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_STATE_EVENT, v || {}); }
    catch (e) { api.v1.error('[AE:state] event save:', e); }
}

// [EVENT] EVERY TRACK A CONCLUDED ENCOUNTER LEFT BEHIND. Called at the conclude and at the
// cancel, because an encounter's whole storage footprint is one row in that map and leaving
// it would accumulate a row per fight for the life of the story.
async function ceEventStatesDrop(milestoneId: string): Promise<void> {
    var mid = String(milestoneId || '');
    if (!mid) return;
    await ceStateOp(async function() {
        var m = await loadEventStates();
        if (m[mid] === undefined) return null;
        delete m[mid];
        await saveEventStates(m);
        return null;
    });
}

// The world/faction write chain. Separate from ceProfileOp on purpose -- see the section
// header. Two records, one chain: an author editing a faction gauge and a world gauge in
// the same second is exactly as capable of racing as two edits to one of them.
var _ceStateChain: Promise<any> = Promise.resolve();
function ceStateOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceStateChain.then(fn);
    _ceStateChain = run.catch(function() { return null; });
    return run;
}

// -- Address resolution -------------------------------------------------------
// The ONE place a scope becomes a concrete owner. A 'protagonist' ref ignores whatever
// ownerId it was handed, which is what lets a caller build the ref from the def alone.
// Returns '' when the scope needs an owner and there is none -- a story with no
// protagonist is a working state (ceProtagonistId's own contract), so every verb below
// treats '' as "no such owner" and falls to the default rather than reporting a fault.
async function _ceStateOwner(scope: string, ownerId: string): Promise<string> {
    if (scope === 'world') return '';
    if (scope === 'protagonist') return await ceProtagonistId();
    return String(ownerId || '');
}

// [SEC:STATE] DOES THIS DEF APPLY TO THIS CHARACTER? THE ONE ANSWER, and every
// per-character filter reads it rather than re-deriving the branch. Three sites had already
// copied `if (scope === 'protagonist') { if (!isProt) continue; } else if (scope !== 'char')`
// verbatim, which is exactly how a fourth scope comes to be visible on two surfaces and
// invisible on the third.
// 'npc' IS THE EXACT COMPLEMENT OF 'protagonist'. It stores like 'char' -- see the type's
// comment -- so nothing below the address layer changes; only who is offered the row.
function ceStateAppliesToChar(def: any, isProtagonist: boolean): boolean {
    if (!def) return false;
    var sc = String(def.scope || '');
    if (sc === 'char') return true;
    if (sc === 'protagonist') return !!isProtagonist;
    if (sc === 'npc') return !isProtagonist;
    return false;
}

// -- THE THREE VERBS ----------------------------------------------------------

async function stateRead(ref: StateRef): Promise<number> {
    try {
        var cfg = await loadConfig();
        var def = ceStateDef(cfg, ref.defId);
        if (!def) return 0;
        var owner = await _ceStateOwner(def.scope, ref.ownerId);
        if (def.scope === 'world') {
            var w = await loadWorldStates();
            return (w[def.id] === undefined) ? ceStateStart(def) : ceStateClamp(def, w[def.id]);
        }
        if (def.scope === 'faction') {
            if (!owner) return ceStateStart(def);
            var f = await loadFactionStates();
            var row = f[owner] || {};
            return (row[def.id] === undefined) ? ceStateStart(def) : ceStateClamp(def, row[def.id]);
        }
        // [EVENT] An owner with no row yet reads as `start`, which is what makes beginning
        // an encounter a pure write of the MILESTONE and nothing else -- the track exists
        // the moment something names it and needs no seeding pass.
        if (def.scope === 'event') {
            if (!owner) return ceStateStart(def);
            var ev = await loadEventStates();
            var erow = ev[owner] || {};
            return (erow[def.id] === undefined) ? ceStateStart(def) : ceStateClamp(def, erow[def.id]);
        }
        if (!owner) return ceStateStart(def);
        var c: any = await loadCharacter(owner);
        if (!c) return ceStateStart(def);
        var sv: any = c.stateValues || {};
        return (sv[def.id] === undefined) ? ceStateStart(def) : ceStateClamp(def, sv[def.id]);
    } catch (e) { api.v1.error('[AE:state] read:', e); return 0; }
}

// The shared clamp-and-assign for a character record ALREADY IN HAND. This is the door a
// verb inside ceProfileOp uses instead of stateSet -- see the section header's one rule.
// Mutates and returns the stored value; the caller owns the save.
function _ceStateApply(def: StateDef, char: any, value: number): number {
    if (!char) return ceStateStart(def);
    if (!char.stateValues) char.stateValues = {};
    var v = ceStateClamp(def, value);
    char.stateValues[def.id] = v;
    return v;
}

// Returns the value now in storage. On a failure to write it returns the value that was
// there before, never the value it was asked to store -- a caller must not be told a
// write landed when it did not.
async function stateSet(ref: StateRef, value: number): Promise<number> {
    var prev = 0;
    try {
        var cfg = await loadConfig();
        var def = ceStateDef(cfg, ref.defId);
        if (!def) return 0;
        prev = await stateRead(ref);
        var owner = await _ceStateOwner(def.scope, ref.ownerId);
        var next = ceStateClamp(def, value);
        if (next === prev) return prev;

        if (def.scope === 'world') {
            return await ceStateOp(async function() {
                var w = await loadWorldStates();
                w[def!.id] = next;
                await saveWorldStates(w);
                return next;
            });
        }
        if (def.scope === 'faction') {
            if (!owner) return prev;
            return await ceStateOp(async function() {
                var f = await loadFactionStates();
                if (!f[owner]) f[owner] = {};
                f[owner][def!.id] = next;
                await saveFactionStates(f);
                return next;
            });
        }
        // [EVENT] THE ONE NON-CHARACTER SCOPE THAT FIRES TERMINALS, and the asymmetry is
        // deliberate rather than an oversight inherited from the two above it: world and
        // faction values return from inside their write chain and have never fired one, so
        // teaching them to would change what every existing story injects. An event's
        // per-band directive IS the feature, so this scope fires and those two are left
        // exactly as they were.
        //   FIRST-TERMINAL-WINS DOES NOT ARBITRATE HERE. That rule exists because a
        //   character can bottom out two states in one turn; an encounter has exactly one
        //   def, so the terminal it just crossed is the only candidate and asking a record
        //   which one is authoritative would be asking a question with one answer.
        if (def.scope === 'event') {
            if (!owner) return prev;
            var evStored = await ceStateOp(async function() {
                var m = await loadEventStates();
                if (!m[owner]) m[owner] = {};
                m[owner][def!.id] = next;
                await saveEventStates(m);
                return next;
            });
            try {
                var evNow = ceStateTerminalIndexOf(def, Number(evStored));
                var evWas = ceStateTerminalIndexOf(def, prev);
                if (evNow >= 0 && evNow !== evWas) {
                    var evT: any = (def.terminal as any[])[evNow];
                    if (evT && String(evT.note || '').trim()) await ceQueueImperative(String(evT.note));
                }
            } catch (eEv) { api.v1.error('[AE:state] event terminal:', eEv); }
            return evStored;
        }
        if (!owner) return prev;
        var stored = await ceProfileOp(async function() {
            var c: any = await loadCharacter(owner);
            if (!c) return prev;
            var v = _ceStateApply(def!, c, next);
            await saveCharacter(c);
            return v;
        });

        // [F-12a] TERMINALS FIRE ON CROSSING, at the write, for every write. Not only on a
        // roll: a terminal is a fact about the value reaching a bound, and which verb pushed
        // it there does not change what happened. Putting it here rather than in the
        // resolution path is what stops F-12 needing its own copy of the rule -- and what
        // makes a terminal testable before any roll exists.
        //
        // CROSSING, NOT OCCUPANCY: it fires when the value ARRIVES and not again while it
        // sits there, so nudging 0 -> 0 does not re-announce a death.
        // [EVT-BAND] ARRIVAL AT A DIFFERENT ONE COUNTS AS AN ARRIVAL. The test compares WHICH
        // terminal, because band-addressed terminals let a value step from one directly into
        // another and "terminal before, terminal after" would swallow the second.
        // OUTSIDE THE ceProfileOp CLOSURE on purpose -- ceQueueImperative writes tempStorage,
        // which shares no chain with the profile, and calling it inside would hold the
        // profile lock for a write that has nothing to do with the record.
        try {
            var tiNow = ceStateTerminalIndexOf(def, stored);
            if (tiNow >= 0 && tiNow !== ceStateTerminalIndexOf(def, prev)) {
                var owner2: any = await loadCharacter(owner);
                var win = ceStateTerminalFor(cfg, owner2);
                // FIRST TERMINAL WINS: ask the record which terminal is authoritative rather
                // than assuming it is the one just crossed. Two states bottoming out on the
                // same turn is exactly the case that makes those different answers.
                if (win) await ceQueueImperative(win.term.note);
            }
        } catch (eTm) { api.v1.error('[AE:state] terminal:', eTm); }
        return stored;
    } catch (e) { api.v1.error('[AE:state] set:', e); return prev; }
}

// A DELTA, NOT A SET, and it re-reads inside the same call rather than taking the
// caller's idea of the current value. That is the difference that makes "-1 stamina" safe
// to fire from two places in one turn.
async function stateNudge(ref: StateRef, delta: number): Promise<number> {
    var d = Number(delta);
    if (!isFinite(d) || d === 0) return await stateRead(ref);
    var cur = await stateRead(ref);
    return await stateSet(ref, cur + Math.round(d));
}


// [F-11b] Rows bucketed by category. ROWS INSIDE A GROUP ARE ALWAYS CATALOG ORDER -- so
// reordering a def in Settings reorders it everywhere, and there is no second sort to
// disagree with the first. Uncategorised rows land in one trailing group with an empty name,
// which every caller renders as a plain list rather than as a section called "Other": a
// category the author never typed should not appear as though they did.
//
// [G-03] THE GROUPS THEMSELVES ARE AUTHORED NOW, per author. First-appearance order meant a
// category's position was decided by which def happened to be created first and could only
// be changed by deleting and retyping defs. `cfg.stateCategoryOrder` is an optional list of
// names; anything in it sorts by its index, anything not sorts after in first-appearance
// order, and the unnamed group is still last.
//   AN ORDER LIST, NOT A CATEGORY RECORD. There is no category object to create, rename or
//   delete -- a category is still just a string on a def, exactly as it was. That is what
//   makes this need NO MIGRATION and NO SYNC: a stale name in the list matches nothing and
//   costs nothing, a new category appends itself, and a renamed one is a new name that falls
//   to the tail until the author moves it. A reconciler here would be a second source of
//   truth for a fact the defs already hold.
//   ONE SORT POINT. Every surface that groups states calls this, so the editor, the profile
//   drill and the faction panel cannot disagree about the order -- which is the same
//   invariant this function was written for and the reason the order argument is threaded
//   rather than read from a module global.
function ceStateGrouped(rows: any[], cfg?: any): any[] {
    var order: string[] = [];
    var byCat: any = {};
    for (var i = 0; i < (rows || []).length; i++) {
        var cat = String((rows[i] && rows[i].category) || '');
        if (!byCat[cat]) { byCat[cat] = []; order.push(cat); }
        byCat[cat].push(rows[i]);
    }
    var authored: any[] = (cfg && Array.isArray((cfg as any).stateCategoryOrder))
        ? (cfg as any).stateCategoryOrder : [];
    var rank: any = {};
    for (var a = 0; a < authored.length; a++) {
        var an = String(authored[a] || '').trim();
        if (an && rank[an] === undefined) rank[an] = a;
    }
    // A STABLE SORT BY (authored rank, first appearance), unnamed always last. Written as an
    // explicit key rather than leaned on Array.sort's stability, which is only guaranteed
    // for the engines this runs on by convention.
    var seq: any = {};
    for (var q = 0; q < order.length; q++) seq[order[q]] = q;
    order.sort(function(x, y) {
        if ((x === '') !== (y === '')) return x === '' ? 1 : -1;
        var rx = (rank[x] === undefined) ? (authored.length + seq[x]) : rank[x];
        var ry = (rank[y] === undefined) ? (authored.length + seq[y]) : rank[y];
        if (rx !== ry) return rx - ry;
        return seq[x] - seq[y];
    });
    var out: any[] = [];
    for (var g = 0; g < order.length; g++) out.push({ category: order[g], rows: byCat[order[g]] });
    return out;
}

// -- Modifiers  [F-11][D-33] ---------------------------------------------------
// A modifier is a CONTRIBUTION TO A ROLL AND NOTHING ELSE. No lifetime, no expiry, no
// modifier record, no add/remove verbs. AE shipped add_modifier/remove_modifier as
// permanent entries with no defined purpose and what authors actually used them for was
// skill bonuses and while-equipped bonuses -- so those are the two sources here and there
// is no third.
//
// CARRYING IS NOT WEARING. Only equippedItemIds contribute; a sword in a chest modifies
// nobody, which is also what makes the total cheap to recompute rather than cache.

// The def a modifier reads, or null. Only a def that DECLARES attach:'modifier' can feed a
// roll -- the attachment list is the permission, checked here so no caller re-decides it.
function ceStateIsModifier(def: StateDef | null): boolean {
    if (!def || !def.attach) return false;
    for (var i = 0; i < def.attach.length; i++) { if (def.attach[i] === 'modifier') return true; }
    return false;
}

// -- Spending  [F-20] ----------------------------------------------------------
// THE ATTACHMENT IS THE PERMISSION, exactly as it is for a modifier, and this predicate is
// deliberately the modifier one's twin rather than a generalised has-attach helper: the two
// answer different questions about the same array and a shared helper would invite a caller
// to ask the wrong one.
function ceStateIsSpendable(def: StateDef | null): boolean {
    if (!def || !def.attach) return false;
    for (var i = 0; i < def.attach.length; i++) { if (def.attach[i] === 'spendForBonus') return true; }
    return false;
}

// Every spendable def in catalog order. Returns [] in a story whose author has marked none,
// and that is a working state -- the composer renders no Spending row at all rather than an
// empty control, the same way the preset rows only exist once there is a preset.
function ceStateSpendables(cfg: GlobalConfig | null): StateDef[] {
    var out: StateDef[] = [];
    var list: StateDef[] = ceStateDefs(cfg);
    for (var i = 0; i < list.length; i++) { if (ceStateIsSpendable(list[i])) out.push(list[i]); }
    return out;
}

// The approaches this world actually has. Returns [] if an author deleted all four AND
// marked nothing else, which is a working state: a Move with no approach rolls flat.
//
// [F-29] EVERY MODIFIER DEF, NOT FOUR IDS. Author-reported: a newly authored state marked
// "Feeds rolls" never appeared in the Move panel's approach list the way Force and Finesse
// do. CE_APPROACH_IDS was doing two jobs -- ORDER and MEMBERSHIP -- and membership was never
// its to hold. NO NEW FLAG IS NEEDED: attach:'modifier' already IS the flag, ceStateIsModifier
// already IS the permission ("the attachment list is the permission, checked here so no
// caller re-decides it"), and this loop re-decided it by never asking about anything outside
// the seeded four. The toggle in Settings was writing a bit with one reader too few.
//   THE FOUR KEEP THE HEAD OF THE LIST. cePublishActions offers appRows in this order and a
//   composer's default is its first entry, so appending the seeds after author-defined ones
//   would silently move the default approach in every existing story on upgrade.
//   SCOPE IS A REAL GATE, NOT TIDINESS. ceStateModifier reads the rating off the ACTOR'S OWN
//   RECORD (char.stateValues[def.id]); a world- or faction-scoped def has no value there, so
//   it would contribute its `start` on every roll -- a wrong number with no surface showing
//   it is wrong. Only the two scopes a character actually holds are offerable.
//   A MANAGED DEF IS NEVER OFFERED. Standings are regenerated from their faction with
//   attach:['target'], so they fail the modifier test already; the explicit check is here so
//   that an author who toggles "Feeds rolls" onto one is not offered a choice that the next
//   config load silently rebuilds away.
function ceStateApproaches(cfg: GlobalConfig | null): StateDef[] {
    var out: StateDef[] = [];
    var seen: any = {};
    var ok = function(d: any): boolean {
        if (!d || !ceStateIsModifier(d)) return false;
        if (d.managed) return false;
        return d.scope === 'char' || d.scope === 'protagonist' || d.scope === 'npc';
    };
    var i = 0;
    for (i = 0; i < CE_APPROACH_IDS.length; i++) {
        var d: any = ceStateDef(cfg, CE_APPROACH_IDS[i]);
        if (!ok(d)) continue;
        out.push(d); seen[String(d.id)] = true;
    }
    var list: StateDef[] = ceStateDefs(cfg);
    for (i = 0; i < list.length; i++) {
        var e: any = list[i];
        if (!ok(e) || seen[String(e.id)]) continue;
        out.push(e);
    }
    return out;
}

// Every item bonus one character is wearing for one def. Takes PRE-LOADED equipped records
// rather than ids: the only caller that matters already holds them, and loading inside a
// summation would make the cost of a roll depend on how much the actor is carrying.
function ceStateItemBonus(items: any[], defId: string): number {
    var total = 0;
    for (var i = 0; i < (items || []).length; i++) {
        var bl: any[] = (items[i] && items[i].bonuses) || [];
        for (var j = 0; j < bl.length; j++) {
            if (!bl[j] || String(bl[j].defId) !== String(defId)) continue;
            var n = Number(bl[j].amount);
            if (isFinite(n)) total += Math.round(n);
        }
    }
    return total;
}

// The full modifier total for one character on one def, with its parts kept separate so a
// surface can SHOW THE ARITHMETIC. A roll the player cannot check is a roll they have to
// trust, and this system is meant to be inspectable.
async function ceStateModifier(cfg: GlobalConfig | null, char: any, defId: string): Promise<{ total: number; rating: number; gear: number; parts: string[] }> {
    var out = { total: 0, rating: 0, gear: 0, parts: [] as string[] };
    var def = ceStateDef(cfg, defId);
    if (!def || !char || !ceStateIsModifier(def)) return out;

    var sv: any = char.stateValues || {};
    out.rating = ceStateClamp(def, (sv[def.id] === undefined) ? ceStateStart(def) : sv[def.id]);
    if (out.rating) out.parts.push(String(def.name) + ' ' + (out.rating > 0 ? '+' : '') + out.rating);

    var worn: any[] = [];
    for (var i = 0; i < ((char.equippedItemIds || []) as string[]).length; i++) {
        try {
            var it = await loadEntity(char.equippedItemIds[i]);
            if (it) worn.push(it);
        } catch (e) { /* non-fatal: an unreadable item contributes nothing */ }
    }
    for (var w = 0; w < worn.length; w++) {
        var b = ceStateItemBonus([worn[w]], def.id);
        if (!b) continue;
        out.gear += b;
        out.parts.push(String(worn[w].name || 'item') + ' ' + (b > 0 ? '+' : '') + b);
    }

    out.total = out.rating + out.gear;
    return out;
}

// -- Terminals  [F-11] ---------------------------------------------------------
// FIRST TERMINAL WINS, TOTALLY. Not "all effects fire and the first note wins" -- the first
// one preempts everything. At 0 Health the outcome is a death, not a partial success that
// also happened to kill somebody, and running a second terminal's effects underneath would
// let two mutually exclusive endings both be true.
//
// ORDER IS CATALOG ORDER, which makes it an authoring decision rather than a race: a def
// higher in Settings > States wins ties, and moving it is how you change that.

// [EVT-BAND] WHICH terminal, not WHETHER. The index is what the crossing test compares, and
// that is the whole reason this function exists beside the one below it: with band-addressed
// terminals a value can move from one terminal straight into another -- an encounter
// stepping from "blooded" to "broken" -- and a boolean "was it terminal / is it terminal"
// reads both as true and announces neither. Comparing indices announces the arrival at each.
// The bound form is unaffected: min and max cannot both hold, so it answered the same either
// way, and moving from a min terminal to a max one always SHOULD re-announce.
//
// -1 means no terminal is reached. A terminal with an empty note is skipped rather than
// matched, so blanking the text is how an author turns one off without deleting the row.
function ceStateTerminalIndexOf(def: StateDef, value: number): number {
    var list: any[] = (def && Array.isArray(def.terminal)) ? def.terminal : [];
    if (!list.length) return -1;
    var b = _ceStateBounds(def);
    var v = ceStateClamp(def, value);
    var bi = ceStateBand(def, v).index;
    for (var i = 0; i < list.length; i++) {
        if (!list[i] || !String(list[i].note || '').trim()) continue;
        var bd = Number(list[i].band);
        if (isFinite(bd) && bd >= 0) {
            // AN INDEX PAST THE END NEVER MATCHES, on purpose -- see the type. A def with no
            // bands at all reports index -1, which matches nothing here either.
            if (bi >= 0 && Math.round(bd) === bi) return i;
            continue;
        }
        if (list[i].at === 'min' && v <= b.lo) return i;
        if (list[i].at === 'max' && v >= b.hi) return i;
    }
    return -1;
}

// The terminal a value has reached on one def, or null.
function ceStateTerminalOf(def: StateDef, value: number): StateTerminal | null {
    var ti = ceStateTerminalIndexOf(def, value);
    if (ti < 0) return null;
    return ((def.terminal as any[]) || [])[ti] || null;
}

// The one terminal a character has reached, in catalog order, or null. Pure over cfg plus
// the loaded record, so a resolution path can ask after applying transfers without a read.
function ceStateTerminalFor(cfg: GlobalConfig | null, char: any): { def: StateDef; term: StateTerminal; value: number } | null {
    if (!char) return null;
    var defs = ceStateDefs(cfg);
    var sv: any = char.stateValues || {};
    var isProt = !!(cfg && String((cfg as any).protagonistCharId || '') === String(char.id || ''));
    for (var i = 0; i < defs.length; i++) {
        var def = defs[i];
        if (!def) continue;
        if (!ceStateAppliesToChar(def, isProt)) continue;
        var v = ceStateClamp(def, (sv[def.id] === undefined) ? ceStateStart(def) : sv[def.id]);
        var t = ceStateTerminalOf(def, v);
        if (t) return { def: def, term: t, value: v };
    }
    return null;
}


// -- Resolution  [F-12] --------------------------------------------------------
// THE ROLL, AND ONLY THE ROLL. Dice, the modifier total, the band it lands in, and the one
// directive that reaches the model. It applies NOTHING -- no transfer, no move, no state
// write -- because a resolution can touch several states and several things that are not
// states, and building the roll and its consequences as one function is how AE ended up
// with six effect buckets nobody could keep straight.
//
// PURE EXCEPT FOR THE DICE. ceRollBand, ceRollTotal and the band table are all pure and
// testable; the randomness is isolated to ceRollDice so a caller can hand in its own faces.

function ceResolutionDefs(cfg: GlobalConfig | null): ResolutionDef[] {
    var list: any = (cfg as any) ? (cfg as any).resolutionDefs : null;
    return Array.isArray(list) ? (list as ResolutionDef[]) : [];
}

function ceResolutionDef(cfg: GlobalConfig | null, id: string): ResolutionDef | null {
    var l = ceResolutionDefs(cfg);
    for (var i = 0; i < l.length; i++) { if (l[i] && String(l[i].id) === String(id)) return l[i]; }
    return l.length ? l[0] : null;   // a missing id falls to the first def rather than refusing to roll
}

// [I-04] WHICH TABLE A ROLL IS JUDGED BY, ANSWERED IN ONE PLACE. The composer no longer
// carries a resolution control, so this is the whole of that decision: the id stored on the
// config if it still names a live def, else the first def, else nothing at all.
// ABSENT AND DANGLING RESOLVE IDENTICALLY, and deliberately -- see the field's own note.
function ceDefaultResolutionId(cfg: GlobalConfig | null): string {
    var l = ceResolutionDefs(cfg);
    var want = String((cfg as any) ? ((cfg as any).defaultResolutionId || '') : '');
    for (var i = 0; i < l.length; i++) { if (l[i] && String(l[i].id) === want) return want; }
    return l.length ? String(l[0].id) : '';
}

// The faces. Bounded hard: an author can type anything into a number field, and a
// count of 5000 would hang the loop it feeds.
// [F-15c] ZERO DICE IS A NO-ROLL RESOLUTION, and it needed no new concept -- which is the
// argument for doing it this way. Sleeping, paying, resting and travelling are moves whose
// outcome is not in doubt; what they need is the CONSEQUENCE machinery, not the dice. With
// count 0 the total is the modifiers alone (usually nothing), a single band with a low
// threshold always hits, and its note and its stake fire exactly as any other outcome's do.
// A separate "actions without rolls" subsystem would have been a second way to do a thing
// the first way already does.
function ceRollDice(def: ResolutionDef): number[] {
    var n = Math.max(0, Math.min(20, Math.round(Number(def.count) || 0)));
    var s = Math.max(2, Math.min(1000, Math.round(Number(def.sides) || 6)));
    var out: number[] = [];
    for (var i = 0; i < n; i++) out.push(1 + Math.floor(Math.random() * s));
    return out;
}

// Which band a modified total lands in. SAME FLOOR RULE AS ceStateBand: the first band owns
// everything below the second, whatever its own `at` says, so a heavily negative modifier
// can never fall through the table into no band at all.
function ceRollBand(def: ResolutionDef, total: number): { index: number; band: RollBand | null } {
    var bands: any[] = (def && Array.isArray(def.bands)) ? def.bands : [];
    if (!bands.length) return { index: -1, band: null };
    var idx = 0;
    for (var i = 0; i < bands.length; i++) {
        if (!bands[i]) continue;
        var at = Number(bands[i].at);
        if (!isFinite(at)) continue;
        if (i === 0 || total >= at) idx = i;
    }
    return { index: idx, band: bands[idx] };
}

// One check, start to finish, with EVERY PART KEPT. The parts are not diagnostics -- a roll
// the player cannot check is a roll they have to trust, and the composer shows this back.
// [F-20] BUY THE BONUS. The reader `attach: 'spendForBonus'` shipped without in 3.0.65 and
// was still missing at 3.1.0 -- seeded on Luck in every new story, which made it the one
// broken promise in this file rather than an ordinary parked declaration.
//
// IT RETURNS WHAT IT TOOK, NEVER WHAT IT WAS ASKED FOR. stateNudge clamps at the floor, so
// an author who asks to spend two while holding one gets +1 and is charged 1. That is the
// F-14u rule applied one function earlier: reversing, reporting or crediting the ASK rather
// than the movement is how a ledger comes to mint value.
//
// THE ADDRESS IS _ceStakeRef's, NOT A SECOND ONE. Luck is protagonist-scoped and the actor
// is always the protagonist, but a spendable def may equally be char- or world-scoped, and
// that function already knows which scopes have a side and which refuse. Two derivations of
// one address is precisely how a surface comes to promise one thing and charge another.
// A faction-scoped spendable therefore cannot be spent, and says so rather than failing
// quietly -- the same gap the faction value door is queued to close.
async function ceSpendForBonus(cfg: GlobalConfig | null, actorId: string,
                               defId: string, amount: number): Promise<any> {
    var out: any = { spent: 0, bonus: 0, label: '', defName: '', reason: '' };
    var want = Math.max(0, Math.min(CE_SPEND_MAX, Math.round(Number(amount) || 0)));
    if (!defId || !want) return out;
    var def = ceStateDef(cfg, String(defId));
    if (!def) { out.reason = 'that resource no longer exists'; return out; }
    if (!ceStateIsSpendable(def)) { out.reason = String(def.name || 'it') + ' can no longer be spent'; return out; }
    out.defName = String(def.name || def.id);
    // [F-3] The spend charges whoever is ROLLING, which is the same rule the stake cells
    // follow one function down -- a party member buys their bonus out of their own pocket.
    var ref = _ceStakeRef(def, String(actorId || ''), true, String(await ceProtagonistId(cfg) || ''));
    if (!ref) { out.reason = out.defName + ' has no address on this side of a Move'; return out; }
    try {
        var before = await stateRead(ref);
        var after = await stateNudge(ref, -want);
        var took = before - after;
        if (took <= 0) { out.reason = 'no ' + out.defName + ' left to spend'; return out; }
        out.spent = took;
        out.bonus = took;
        out.label = out.defName;
        return out;
    } catch (e) {
        api.v1.error('[AE:spend] charge failed:', e);
        out.reason = 'the charge failed to write';
        return out;
    }
}

// [F-20] THE FOURTH ARGUMENT IS A PURCHASE, NOT A FREE NUMBER. It was `situational` and it
// was whatever the author typed; it is now what ceSpendForBonus ACTUALLY CHARGED, which is
// why the label rides beside it -- the modifier line has to be able to say where the points
// came from, and a receipt reading "+2" with nothing to attribute it to is the unauditable
// roll this whole surface exists to avoid. THE CALLER SPENDS AND THEN RESOLVES; this
// function charges nothing and must not start, or a re-roll would re-charge.
async function ceResolve(cfg: GlobalConfig | null, char: any, approachDefId: string, resolutionId: string, bonus?: number, bonusLabel?: string): Promise<any> {
    var rdef = ceResolutionDef(cfg, resolutionId);
    if (!rdef) return null;
    var faces = ceRollDice(rdef);
    var raw = 0;
    for (var i = 0; i < faces.length; i++) raw += faces[i];

    var mod = { total: 0, rating: 0, gear: 0, parts: [] as string[] };
    if (approachDefId) {
        try { mod = await ceStateModifier(cfg, char, approachDefId); }
        catch (e) { api.v1.error('[AE:roll] modifier:', e); }
    }
    var sit = Math.round(Number(bonus) || 0);
    if (sit) mod.parts.push(String(bonusLabel || 'spent') + ' ' + (sit > 0 ? '+' : '') + sit);

    var total = raw + mod.total + sit;
    var hit = ceRollBand(rdef, total);
    return {
        resolutionId: String(rdef.id), resolutionName: String(rdef.name),
        faces: faces, raw: raw, modifier: mod.total + sit, modParts: mod.parts, total: total,
        bandIndex: hit.index,
        label: hit.band ? String(hit.band.label || '') : '',
        note: hit.band ? String(hit.band.note || '') : ''
    };
}

// [F-12] THE ONE PLACE A RESOLUTION BECOMES A DIRECTIVE, and the one place terminal
// preemption is decided.
//
// ORDERING IS THE WHOLE FUNCTION. Consequences land FIRST -- and stateSet queues a terminal
// note of its own the moment a value crosses a bound -- so by the time this asks, the answer
// already exists. If any character involved sits at a terminal, THAT note stands and the
// band's note is discarded entirely: at 0 health the outcome is a death, not a partial
// success that also killed somebody, and sending both would let the model choose.
//
// TERMINALS ARE NOT RE-QUEUED HERE. stateSet already did it, on crossing, with
// ceStateTerminalFor picking the winner across every def. This function only decides whether
// the band note is allowed to overwrite that, which is why it checks and returns rather than
// writing twice.
async function ceCommitResolution(cfg: GlobalConfig | null, result: any, involvedIds: string[]): Promise<any> {
    if (!result) return null;
    var preempted: any = null;
    try {
        for (var i = 0; i < (involvedIds || []).length; i++) {
            if (!involvedIds[i]) continue;
            var c: any = await loadCharacter(involvedIds[i]);
            if (!c) continue;
            var t = ceStateTerminalFor(cfg, c);
            if (t) { preempted = { charId: String(c.id), name: String(c.name || ''), note: t.term.note, defName: String(t.def.name || '') }; break; }
        }
    } catch (e) { api.v1.error('[AE:roll] preempt check:', e); }

    if (preempted) {
        // stateSet already queued it. Saying so is the whole point of returning it -- the
        // composer shows the author that the roll's own outcome was overridden.
        // [IMP-TRACE] RECORDED AS A DISTINCT OUTCOME. This branch returns WITHOUT calling
        // ceQueueImperative, on the stated assumption that stateSet already did. If that
        // assumption is ever wrong the symptom is an empty slot after a successful roll --
        // indistinguishable from every other cause without this line.
        _ceImpFire = { at: Date.now(), band: String(result.label || ''), noteLen: 0, readBack: 0,
                       queued: false, preemptedBy: String(preempted.name || '') };
        result.preempted = preempted;
        result.sent = preempted.note;
        return result;
    }
    // [IMP-TRACE] A BAND WITH NO NOTE QUEUES NOTHING, and that is correct behaviour with a
    // silent failure mode: the roll fires, the receipt shows an outcome, the stake is
    // charged, and the model is told nothing at all. It looks exactly like a broken
    // injection. Logged at the source and reported on the receipt so the two are never
    // confused again -- `+ Add resolution` seeds real notes for the same reason.
    if (result.note) {
        await ceQueueImperative(result.note);
        var vfy = '';
        try { vfy = String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
        catch (eV) { vfy = '(read failed)'; }
        // READ BACK IMMEDIATELY. If the write does not survive its own function, that is a
        // storage problem and no amount of hook reordering will fix it -- and it is the one
        // possibility the drain-side trace can never distinguish from a race.
        _ceImpFire = { at: Date.now(), band: String(result.label || ''),
                       noteLen: String(result.note).length, readBack: vfy.length, queued: true };
        aeLog('[AE:imp] queued ' + String(result.note).length + ' chars for band "'
            + String(result.label || '') + '", read back ' + vfy.length);
    } else {
        _ceImpFire = { at: Date.now(), band: String(result.label || ''), noteLen: 0, readBack: 0, queued: false };
        aeLog('[AE:imp] band "' + String(result.label || '') + '" has no note \u2014 nothing queued.');
    }
    result.preempted = null;
    result.sent = result.note || '';
    return result;
}

// -- Stakes  [F-14] ------------------------------------------------------------
// WHAT IS ON THE LINE, AND WHO PAYS IT PER OUTCOME. The roll says how well it went; the
// stake says what that costs. They are separate on purpose -- ceResolve applies nothing,
// so a world can run entirely on band directives with no ledger at all, and turning stakes
// on is adding rows rather than changing how anything resolves.
//
// THE ORDERING BELOW IS THE PLAN'S SS3 AND IS LOAD-BEARING: consequences apply FIRST (which
// is what lets stateSet queue a terminal note the moment a value crosses a bound), and
// ceCommitResolution then asks whether anyone is standing at a terminal and discards the
// band's own note if so. Applying after the commit would mean a death that happened this
// turn could not preempt the partial-success directive describing it.

// [F-15d] The preset catalog. Shaped exactly like ceStakeDefs and ceStateDefs because it
// answers the same question about the neighbouring list, and defensive in the same way: a
// config from before the field existed returns [] rather than undefined, so no caller needs
// a shape check even if migrateConfig has somehow not run against it yet.
function ceActionPresets(cfg: GlobalConfig | null): CeActionPreset[] {
    var list: any = (cfg as any) ? (cfg as any).actionPresets : null;
    return Array.isArray(list) ? (list as CeActionPreset[]) : [];
}

function ceStakeDefs(cfg: GlobalConfig | null): StakeDef[] {
    var list: any = (cfg as any) ? (cfg as any).stakeDefs : null;
    return Array.isArray(list) ? (list as StakeDef[]) : [];
}

function ceStakeDef(cfg: GlobalConfig | null, id: string): StakeDef | null {
    var l = ceStakeDefs(cfg);
    for (var i = 0; i < l.length; i++) { if (l[i] && String(l[i].id) === String(id)) return l[i]; }
    return null;   // NO fall-to-first: a missing stake means nothing is risked, which is safe.
}

// The standing wager for an approach, or null. FIRST MATCH IN CATALOG ORDER, so reordering
// the list in Settings is how an author breaks a tie -- the same rule ceStateTerminalFor
// uses, and for the same reason: a race is not an answer.
// A stake bound to the SAME resolution wins over one that merely names the approach, so a
// d20 table and a 2d6 table can both claim Force without shadowing each other.
function ceStakeForApproach(cfg: GlobalConfig | null, approachId: string, resolutionId: string): StakeDef | null {
    if (!approachId) return null;
    var l = ceStakeDefs(cfg);
    var loose: StakeDef | null = null;
    for (var i = 0; i < l.length; i++) {
        var s: any = l[i];
        if (!s || !Array.isArray(s.defaultForApproach)) continue;
        var hit = false;
        for (var j = 0; j < s.defaultForApproach.length; j++) {
            if (String(s.defaultForApproach[j]) === String(approachId)) { hit = true; break; }
        }
        if (!hit) continue;
        if (String(s.resolutionId || '') === String(resolutionId)) return s;
        if (!loose) loose = s;
    }
    return loose;
}

// THE ONE PLACE "which stake applies to this move" IS ANSWERED. Three-state, per
// CeArmedAction.stakeId: the sentinel follows the approach, '' is a deliberate nothing, and
// an id is an override. Every surface and the fire path read this rather than re-deriving
// it, so the panel cannot promise one wager and the roll apply another.
function ceStakeForMove(cfg: GlobalConfig | null, armed: any): StakeDef | null {
    if (!armed) return null;
    var sid = String(armed.stakeId === undefined ? CE_STAKE_AUTO : armed.stakeId);
    if (sid === CE_STAKE_AUTO) return ceStakeForApproach(cfg, String(armed.approachDefId || ''), String(armed.resolutionId || ''));
    if (!sid) return null;
    return ceStakeDef(cfg, sid);
}

// The address a cell writes to, or null when it has none. FOUR SCOPES AND ONLY TWO OF THEM
// HAVE A SIDE: a world value is one number and is written once whichever side names it; a
// faction value needs a faction id, which a character-shaped side does not carry, so it is
// SKIPPED AND REPORTED rather than guessed at. Reporting is the point -- a cell that
// silently does nothing is indistinguishable from one that is not authored.
// [F-3] WHO IS ROLLING. Falls back to the protagonist, and VALIDATES rather than trusting:
// a stored actor who has left the scene, been deactivated, or lost their follow flag is not
// an actor any more, and silently rolling as them would be the worst outcome -- a roll that
// charges a character the author has forgotten is even in the party.
async function ceActorId(cfg: GlobalConfig | null): Promise<string> {
    var pid = String(await ceProtagonistId(cfg) || '');
    try {
        var raw = String(await api.v1.historyStorage.getOrDefault(STORAGE_ACTOR, '') || '');
        if (!raw || raw === pid) return pid;
        var c: any = await loadCharacter(raw);
        if (!c || c.active === false || !c.scenePresent || !(c as any).followCamera) return pid;
        return String(c.id);
    } catch (e) { return pid; }
}

async function ceActorSet(id: string): Promise<void> {
    try { await api.v1.historyStorage.set(STORAGE_ACTOR, String(id || '')); }
    catch (e) { api.v1.error('[AE:actor] set:', e); }
}

// [F-3] protagId IS THE FOURTH ARGUMENT AND IT IS THE WHOLE OF PARTY MODE. Everything else
// in the stake chain was already parameterised on actorId; this was the one place that threw
// it away.
// [F-31] facId IS THE SIXTH ARGUMENT AND IT IS ALREADY RESOLVED FOR THIS SIDE. The caller
// works out the actor's faction and the target's faction ONCE PER ROW and hands each cell the
// one that belongs to it, which is exactly the shape sideId already has -- this function does
// no lookups, and it must not start, because it is synchronous and a faction resolution is
// two storage reads.
function _ceStakeRef(def: StateDef, sideId: string, isActor: boolean, protagId?: string,
                     eventId?: string, facId?: string): StateRef | null {
    if (!def) return null;
    if (def.scope === 'world') return { scope: 'world', ownerId: '', defId: def.id };
    // [EVENT] THE LIVE ENCOUNTER, SIDE-INDEPENDENT -- exactly like 'world' one line up, and
    // for the same reason: there is one track and both cells name the same one, so which
    // side wrote the cell decides nothing. A row that names it from BOTH sides charges it
    // twice, which is the world scope's long-standing behaviour and is left alone here
    // rather than special-cased into a guard that only this scope has.
    //   THE ID IS STORED, NOT RESOLVED LATER, and this is the trap the fifth argument
    //   exists to close -- the same one the protagonist branch below documents at length.
    //   The ledger outlives the roll: "put this back" sits on the receipt and can be pressed
    //   long after the encounter concluded, and a ref that resolved "whatever event is live"
    //   AT THAT MOMENT would refund into the NEXT fight, silently, with a receipt saying it
    //   worked. Naming the milestone permanently makes reversal land right with no extra
    //   machinery and no ordering to get wrong.
    //   NO LIVE EVENT MEANS NO ADDRESS. Refused and REPORTED by the caller, never guessed --
    //   an encounter stake fired outside an encounter is an authoring gap, and a cell that
    //   silently does nothing is indistinguishable from one that is not authored.
    if (def.scope === 'event') {
        if (!eventId) return null;
        return { scope: 'event', ownerId: String(eventId), defId: def.id };
    }
    // A PROTAGONIST-SCOPED DEF IS REFUSED ON THE TARGET SIDE, and this is the trap the
    // signature exists to close. StateRef IGNORES ownerId for that scope by design (it
    // resolves through ceProtagonistId), so a target cell naming Currency -- which the seed
    // library ships as protagonist-scoped -- would have charged THE PLAYER for what the
    // target was supposed to lose, silently, with a receipt line saying it worked. The
    // actor IS the protagonist today, so the actor side is exact.
    if (def.scope === 'protagonist') {
        if (!isActor) return null;
        // [F-3] A PARTY MEMBER PAYS FROM THEIR OWN SHEET. Per author: the stake is the
        // ACTOR's, so a protagonist-scoped def fired by a party member resolves to a CHAR ref
        // on that character -- their Luck, their Currency, their bonuses.
        //
        // AND THIS IS WHY THE ACTOR IS NOT DONE BY MOVING THE PROTAGONIST FLAG. The swap was
        // considered and is cheaper to write; it fails on the one requirement it has to meet.
        // A { scope:'protagonist' } ref stores NO owner -- it resolves through ceProtagonistId
        // WHEN IT IS READ. ceReverseStake reads it from the ledger, and the ledger outlives
        // the roll: "put this back" sits on the receipt and can be pressed a dozen turns
        // later, long after any restore. Under the swap, reversal would resolve the flag as
        // it stands THEN and refund the wrong character -- silently, with a receipt saying it
        // worked. An explicit char ref names the owner permanently, so reversal lands right
        // with no extra machinery, no restore window, and no ordering to get wrong.
        // BYTE-IDENTICAL WHEN THE ACTOR IS THE PROTAGONIST, so every existing story and every
        // existing ledger entry behaves exactly as before.
        if (sideId && protagId && String(sideId) !== String(protagId)) {
            return { scope: 'char', ownerId: String(sideId), defId: def.id };
        }
        return { scope: 'protagonist', ownerId: '', defId: def.id };
    }
    // AN npc-SCOPED DEF IS REFUSED ON THE PROTAGONIST, which is the mirror of the block
    // above and closes the same trap from the other end: without it a stake naming an
    // NPC-only state would charge the player a value they are not supposed to carry, and
    // the receipt would say it worked. Stored as a plain char ref -- the scope decides WHO
    // may hold one, never WHERE it lives.
    if (def.scope === 'npc') {
        if (!sideId) return null;
        if (protagId && String(sideId) === String(protagId)) return null;
        return { scope: 'char', ownerId: String(sideId), defId: def.id };
    }
    // [F-31] A FACTION IS AN ADDRESS ON BOTH SIDES NOW, and it is stored rather than resolved
    // later for the trap the event branch above documents at length: the ledger outlives the
    // roll, so "Put this back" pressed three scenes later must refund the faction that was
    // charged and not whichever one the protagonist has fallen in with by then.
    //   WHICH faction is NOT decided here. The actor side is the actor's own (ceCharFactionId,
    //   falling back to cfg.protagonistFactionId) and the target side is an explicit faction
    //   target or the target character's own -- both worked out by the caller, both passed in.
    //   NO FACTION ON THIS SIDE MEANS NO ADDRESS. Refused and REPORTED, never guessed: a
    //   faction cell fired at a scene with no faction in it is an aiming problem the author
    //   fixes in the Target control, and a cell that silently did nothing is indistinguishable
    //   from one that is not authored.
    if (def.scope === 'faction') {
        if (!facId) return null;
        return { scope: 'faction', ownerId: String(facId), defId: def.id };
    }
    if (def.scope === 'char') {
        if (!sideId) return null;
        return { scope: 'char', ownerId: sideId, defId: def.id };
    }
    return null;
}

// Apply one stake row. RETURNS A LEDGER, one entry per cell that had a def, INCLUDING the
// ones that could not be written -- the receipt shows this back, and "target absent" is
// exactly the kind of near-miss an author needs told rather than left to infer from a
// number that did not move.
async function ceApplyStake(cfg: GlobalConfig | null, stake: StakeDef | null, bandIndex: number,
                            actorId: string, target: CeTargetRef | null): Promise<any[]> {
    var out: any[] = [];
    if (!stake) return out;
    var rows: any[] = Array.isArray(stake.rows) ? stake.rows : [];
    if (!rows.length) return out;
    // CLAMPED, NOT MATCHED. A stake authored against a three-band table and fired on a
    // five-band one still pays something rather than nothing, which is the working state.
    var idx = Math.max(0, Math.min(rows.length - 1, Math.round(Number(bandIndex) || 0)));
    var row: any = rows[idx] || {};
    // [F-3] Resolved ONCE for the whole row rather than per cell: it is a config read, and
    // both sides ask the same question.
    var _asProtag = String(await ceProtagonistId(cfg) || '');
    // [EVENT] Same rule, and it costs at most two storyStorage reads on a turn where no
    // encounter is running -- ceLiveEventId short-circuits on an empty loose slot and an
    // unset active thread, so a story that never begins one pays for the miss and nothing
    // else. Resolved here rather than inside the cell loop so both sides address the same
    // encounter even if one of them somehow outlives it mid-row.
    var _evId = '';
    try { _evId = await ceLiveEventId(); } catch (eEv) { _evId = ''; }

    // [F-31] THE TWO FACTION ADDRESSES, RESOLVED ONCE FOR THE ROW like _asProtag and _evId
    // above and for the same reason -- both sides must be answering about the same moment.
    //   THE ACTOR ACTS FOR THEIR OWN FACTION AND FALLS BACK TO OURS. F-3's rule is that a
    //   party member pays from their OWN sheet, and this is that rule one record out: a
    //   character with a warm standing acts for that faction. Most party members have no
    //   standing set at all, and for them the protagonist's faction is what "our side" means,
    //   so the fallback is the common path rather than the exception.
    //   THE TARGET SIDE PREFERS THE EXPLICIT AIM. A Move aimed at a faction charges that
    //   faction; a Move aimed at a person reaches the faction they act for. Aiming at nobody
    //   leaves it empty, and an empty address is refused and reported below.
    var _acFac = '';
    try {
        _acFac = await ceCharFactionId(cfg, String(actorId || ''));
        if (!_acFac && cfg) _acFac = String((cfg as any).protagonistFactionId || '');
    } catch (eAf) { _acFac = ''; }
    var _tgFac = '';
    try {
        var _tk = String((target && target.kind) || '');
        if (_tk === 'faction') _tgFac = String((target as any).id || '');
        else if (_tk === 'char') _tgFac = await ceCharFactionId(cfg, String((target as any).id || ''));
    } catch (eTf) { _tgFac = ''; }

    var sides = [
        { key: 'actor', cell: row.actor, id: String(actorId || ''), label: 'actor',
          isActor: true, fac: _acFac },
        { key: 'target', cell: row.target,
          id: (target && target.kind === 'char') ? String(target.id) : '',
          label: (target && target.name) ? String(target.name) : 'target',
          isActor: false, fac: _tgFac }
    ];

    for (var s = 0; s < sides.length; s++) {
        var cell: any = sides[s].cell;
        if (!cell) continue;
        var amt = Math.round(Number(cell.amount) || 0);
        if (!amt) continue;

        // [T-20] TIME IS THE WORLD'S, NOT A SIDE'S, so like pressure it fires ONCE from
        // whichever cell names it -- two cells both naming time would otherwise advance the
        // clock twice for one move.
        // THE CLOCK ONLY GOES FORWARD. A negative amount is refused rather than clamped to
        // zero: rewinding would re-cross every schedule window between here and there and
        // ceSchedResolve would physically move the cast backwards. Undo is the way back, and
        // the clock is in historyStorage precisely so Undo works on it.
        if (String(cell.kind || 'state') === 'time') {
            if (amt <= 0) {
                out.push({ side: 'time', applied: false,
                    text: 'Time ' + String(amt) + ' \u2014 a stake can only cost time, never give it back' });
                continue;
            }
            try {
                var tkBefore = await ceClockLoad();
                // ceClockNudge, not a raw set: it re-reads inside the call and runs schedule
                // resolution across the crossing, which is the whole point of spending time.
                var tkAfter = await ceClockNudge(amt);
                var tkMoved = tkAfter - tkBefore;
                out.push({ side: 'time', applied: tkMoved !== 0, time: true, delta: tkMoved,
                    text: (tkMoved >= 60
                            ? (String(Math.round(tkMoved / 60 * 10) / 10) + 'h')
                            : (String(tkMoved) + ' min'))
                        + ' passes \u2014 it is now ' + ceClockTimeOfDay(tkAfter) });
            } catch (eT) {
                api.v1.error('[AE:stake] time apply:', eT);
                out.push({ side: 'time', text: 'Time: the clock did not move', applied: false });
            }
            continue;
        }

        // [F-17] PRESSURE MOVES THE PAIRING, NOT A SIDE, so it fires once from whichever
        // cell names it and reads the ACTOR's Position toward the target either way. A
        // Position is a thing between two people and there is no second copy of it to
        // charge separately.
        if (String(cell.kind || 'state') === 'pressure') {
            var pTid = (target && target.id) ? String(target.id) : '';
            if (!pTid) {
                out.push({ side: sides[s].label, applied: false,
                    text: 'Position ' + (amt > 0 ? '+' : '') + amt + ' \u2014 no target to have one with' });
                continue;
            }
            // [F-14p2] ASK WHICH SIDE HOLDS THE RECORD. See _cePositionAxisFor.
            var pOwn: any = await _cePositionAxisFor(String(actorId || ''), target);
            if (!pOwn) {
                // NAMED, NOT SILENT. This is an authoring gap the author can close in one
                // edit, and reporting it as "applied: false" with the reason is the whole
                // difference between a stake that looks broken and one that tells you the
                // counterpart has no Position written yet.
                out.push({ side: 'position', applied: false,
                    text: 'Position ' + (amt > 0 ? '+' : '') + amt + ' \u2014 neither of them has a Position '
                        + 'written with the other, so there is no standing to move' });
                continue;
            }
            try {
                var pAx = String(pOwn.axis);
                var pOwnerId = String(pOwn.charId);
                var pBefore = await _ceReadPressure(pOwnerId, pAx);
                var pAfter = Math.max(_ceAxisFloor(pAx), Math.min(4, pBefore + amt));
                if (pAfter !== pBefore) await api.v1.historyStorage.set(_cePressureKey(pOwnerId, pAx), pAfter);
                out.push({ side: 'position', applied: (pAfter !== pBefore), pressure: { charId: pOwnerId, axis: pAx },
                    delta: (pAfter - pBefore),
                    text: 'Position with ' + String((target && target.name) || 'them') + ' '
                        + (amt > 0 ? 'strained' : 'eased') + ' (' + _ceFramePressureWord(pBefore)
                        + ' \u2192 ' + _ceFramePressureWord(pAfter) + ')'
                        + ((pAfter === pBefore) ? ' \u2014 already at its bound' : '') });
            } catch (eP) {
                api.v1.error('[AE:stake] pressure apply:', eP);
                out.push({ side: 'position', text: 'Position: write failed', applied: false });
            }
            continue;
        }

        if (!cell.defId) continue;
        var def = ceStateDef(cfg, String(cell.defId));
        if (!def) { out.push({ side: sides[s].label, text: 'unknown state ' + String(cell.defId), applied: false }); continue; }
        var ref = _ceStakeRef(def, sides[s].id, sides[s].isActor, _asProtag, _evId,
                              String(sides[s].fac || ''));
        if (!ref) {
            // TWO DIFFERENT MISSES, NAMED APART. "Nobody to charge" is a scene problem the
            // author fixes by aiming the move; "cannot be charged to anyone but the
            // protagonist" is an authoring problem in the stake table itself, and reporting
            // both as the same line would send them hunting the wrong one.
            // [EVENT] A THIRD MISS WITH ITS OWN SENTENCE, by the rule the two below it
            // already follow: "no encounter is running" is a pacing problem the author fixes
            // by starting one, and folding it into "nobody to charge" would send them
            // looking at the target picker for a cell that never had a target.
            if (def.scope === 'event') {
                out.push({ side: sides[s].label, applied: false,
                    text: String(def.name) + ' ' + (amt > 0 ? '+' : '') + amt
                        + ' \u2014 no encounter is running, so there is no track to move' });
                continue;
            }
            var why = (def.scope === 'protagonist')
                ? ' \u2014 ' + String(def.name) + ' belongs to the protagonist only'
                : (def.scope === 'npc')
                    ? ' \u2014 ' + String(def.name) + ' belongs to everyone but the protagonist'
                    : (def.scope === 'faction')
                        // [F-31] AN AIMING PROBLEM, AND SAID AS ONE. The actor side is empty
                        // when the story has no faction of its own; the target side is empty
                        // when the Move is aimed at nobody, or at somebody who stands nowhere
                        // with anyone. Both are one control away from being fixed.
                        ? (sides[s].isActor
                            ? ' \u2014 nobody on this side acts for a faction. Set one in Settings, '
                              + 'or give the actor a standing'
                            : ' \u2014 aim this at a faction, or at somebody who stands with one')
                        : ' \u2014 no ' + sides[s].key + ' to charge';
            out.push({ side: sides[s].label,
                text: String(def.name) + ' ' + (amt > 0 ? '+' : '') + amt + why, applied: false });
            continue;
        }
        try {
            var before = await stateRead(ref);
            var after = await stateNudge(ref, amt);
            // [F-14u] THE REF AND THE REAL DELTA ARE KEPT, which is what makes the receipt's
            // Undo possible at all. `delta` is (after - before), NOT the authored amount:
            // a clamp at a bound means less moved than was asked for, and reversing the ask
            // rather than the movement would CREATE value out of a floor.
            out.push({ side: sides[s].label, applied: (after !== before),
                ref: ref, delta: (after - before),
                text: String(def.name) + ' ' + (amt > 0 ? '+' : '') + amt
                    + ' (' + before + ' \u2192 ' + after + ')'
                    + ((after === before) ? ' \u2014 already at its bound' : '') });
        } catch (e) {
            api.v1.error('[AE:stake] apply failed:', e);
            out.push({ side: sides[s].label, text: String(def.name) + ': write failed', applied: false });
        }
    }
    return out;
}


// [F-17] A POSITION AT EITHER TERMINUS IS A RELATIONSHIP THAT HAS CHANGED, AND THE AUTHOR
// IS ASKED TO SAY SO. This closes the gap that made Flair pointless: Standing is authored
// prose with no track, so nothing could ever move it, and pressure could grind to its floor
// with the written relationship still describing two strangers.
//
// ASKED, NOT WRITTEN. The engine will not rewrite Standing itself -- it has no idea what
// changed between these two people, and a model-authored Standing is exactly the
// self-referential drift D-21 exists to prevent. What it can do is notice the moment and
// hand the author the field, prefilled, on a surface they are already looking at.
//
// IT IS A PANEL SECTION, NOT A MODAL, and not because a modal would be ugly: there IS no
// prompt-for-text call on this API. api.v1.ui.modal.open takes UIParts and returns a
// handle; there is no getInput and nothing that resolves to a typed string. Asking on the
// Actions panel costs no new API surface, obeys CE-STYLE like every other field, and does
// not steal the screen from someone mid-sentence.
//
// IT IS ONLY POSSIBLE BECAUSE THE ROLL LEFT THE GENERATION LIFECYCLE (F-15d). Nothing can
// be asked of an author in the middle of a context build.
//
// BOTH ENDS, NOT ONLY THE FLOOR. The author named -4, and +4 is the same event told the
// other way: a relationship at breaking point has changed as surely as one that settled,
// and offering only the warm one would quietly say that souring does not count. Raised ONCE
// per crossing -- the tier sits at its bound for many turns afterwards, and re-asking every
// time is how a prompt becomes something people dismiss unread.
async function _cePositionTerminus(actorId: string, target: CeTargetRef | null, ledger: any[]): Promise<void> {
    if (!target || !target.id) return;
    var moved: any = null;
    for (var i = 0; i < (ledger || []).length; i++) {
        if (ledger[i] && ledger[i].pressure && ledger[i].applied) moved = ledger[i];
    }
    if (!moved) return;

    // [F-14p2] THE LEDGER SAYS WHOSE TIER MOVED, SO ASK IT RATHER THAN ASSUMING THE ACTOR.
    // This read used actorId while ceApplyStake had just written under the RECORD OWNER'S
    // key, so whenever the counterpart held the Position -- the ordinary case -- this read a
    // different, untouched key, saw tier 0, and returned. The record it then loaded was the
    // actor's, and the targetId comparison below rejected it for the same reason.
    // ONE SOURCE OF TRUTH: moved.pressure.charId and moved.pressure.axis are exactly what
    // was written, so nothing here can drift from what happened.
    var ownerId = String((moved.pressure && moved.pressure.charId) || actorId);
    var ownerAxis = String((moved.pressure && moved.pressure.axis) || '');
    if (!ownerAxis) return;
    await _cePositionTerminusRaise(ownerId, ownerAxis);
}

// [F-17b] THE RAISE ITSELF, SPLIT OUT BECAUSE A ROLL IS NOT THE ONLY WAY TO GET THERE.
// It lived inside the roll path, so a Position driven to a bound by the PROFILE'S OWN TIER
// STEPPER crossed the threshold and nothing happened -- which is how it was reported, and
// it is the same asymmetry F-11 already resolved for states: stateSet raises a terminal for
// ANY writer, deliberately, "a terminal is a fact about the value reaching a bound, and
// which verb pushed it there does not change what happened". Position now follows that rule.
// CALLERS PASS THE OWNER'S id AND THE FULL AXIS, never an actor and a target, because those
// two disagreed once already (F-14p2) and one address is what stops them disagreeing again.
async function _cePositionTerminusRaise(ownerId: string, ownerAxis: string): Promise<void> {
    if (!ownerId || !ownerAxis) return;

    var tier = await _ceReadPressure(ownerId, ownerAxis);
    if (tier > -4 && tier < 4) return;

    // ONE ASK PER CROSSING. tempStorage, so a later session may raise it again about a
    // relationship still standing at its bound -- which is correct: that is a new sitting
    // at the desk, not the same one being nagged twice.
    // KEYED BY THE OWNER AND THE AXIS, not by actor+target: those two named the same
    // crossing twice when the counterpart held the record, so a warm terminal on the NPC's
    // Position and one on the protagonist's could collide.
    var seenKey = 'ce_pos_term_' + ownerId + '_' + ownerAxis + '_' + (tier <= -4 ? 'lo' : 'hi');
    try {
        if (await api.v1.tempStorage.getOrDefault(seenKey, false)) return;
        await api.v1.tempStorage.set(seenKey, true);
    } catch (eK) { /* if the guard cannot be read, asking once too often beats never */ }

    var owner: any = await loadCharacter(ownerId);
    if (!owner || !owner.position) return;
    // The pressure axis outlives a repointed Position on purpose (evidence about one person
    // is not evidence about another). Compared against the axis the write used, so a Position
    // repointed since the roll is correctly rejected and a ref-stored target is not.
    if (('position_' + String(owner.position.targetId || '')) !== ownerAxis) return;

    // WHO IS ASKED TO REWRITE, AND ABOUT WHOM. The rewrite belongs to the character holding
    // the record, and the name shown is the OTHER party from that character's point of view
    // -- which is position.targetName, not the Move's target.name. Those differ precisely in
    // the case this patch fixes: an NPC's Position names the protagonist, while the Move's
    // target was the NPC.
    try {
        await api.v1.tempStorage.set(STORAGE_POS_TERMINUS, {
            charId: ownerId, targetId: String(owner.position.targetId || ''),
            // THE OTHER PARTY FROM THE RECORD HOLDER'S POINT OF VIEW, read off the record
            // rather than off the Move that moved it -- the raiser has no Move to consult
            // when the stepper is what crossed the bound, and those two names differ exactly
            // in the case F-14p2 fixed (the NPC's Position names the protagonist, while the
            // Move's target was the NPC).
            targetName: String(owner.position.targetName || ''),
            ownerName: String(owner.name || ''),
            warm: (tier <= -4),
            // [F-21] SHAPE RIDES ALONG because the panel now offers it for editing at a
            // threshold. Carried as the value AT THE MOMENT OF CROSSING, like standing has
            // always been -- the drafts are separate keys, so the record still knows what it
            // was before the author touched anything.
            shape: String(owner.position.shape || ''),
            standing: String(owner.position.standing || '')
        } as any);
    } catch (e) { api.v1.error('[AE:position] terminus record:', e); }
}

// Accept or dismiss the pending rewrite. DISMISSAL IS A REAL ANSWER and clears the record
// without writing -- "leave it as it is" must be one tap, or the section becomes something
// to work around rather than use.
// [F-21] STAGED, NOT WRITTEN. The rewrite is now part of the move: the author edits Shape
// and Standing beside the outcome sentence and ceWriteMoveToStory commits all of it in one
// press, so a move that is discarded takes its relationship edits with it.
// THE DRAFTS LIVE ON THE TERMINUS RECORD, not on the character. Writing through on every
// keystroke-commit would leave a half-edited relationship behind if the author then binned
// the move, and there would be nothing to bin it with.
async function ceTerminusDraft(field: string, text: string): Promise<void> {
    var pend: any = null;
    try { pend = await api.v1.tempStorage.getOrDefault(STORAGE_POS_TERMINUS, null); }
    catch (e) { pend = null; }
    if (!pend) return;
    if (field === 'shape') pend.draftShape = String(text == null ? '' : text);
    else pend.draftStanding = String(text == null ? '' : text);
    try { await api.v1.tempStorage.set(STORAGE_POS_TERMINUS, pend); } catch (e2) {}
    await cePublishActions();
}

// [F-21] COMMIT THE STAGED RELATIONSHIP EDITS. Called only from ceWriteMoveToStory, in the
// same press that puts the sentences in the document.
// IT RE-READS AND RE-CHECKS THE RECORD. The roll, the editing and the write are three
// separate moments and the Position could have been repointed in between; the axis
// comparison is the same one the raiser makes, so a repointed relationship is left alone
// rather than having somebody else's standing written into it.
async function ceTerminusCommit(): Promise<boolean> {
    var pend: any = null;
    try { pend = await api.v1.tempStorage.getOrDefault(STORAGE_POS_TERMINUS, null); }
    catch (e) { pend = null; }
    if (!pend) return false;
    try { await api.v1.tempStorage.remove(STORAGE_POS_TERMINUS); } catch (e1) {}
    var nShape = (typeof pend.draftShape === 'string') ? String(pend.draftShape).trim() : null;
    var nStand = (typeof pend.draftStanding === 'string') ? String(pend.draftStanding).trim() : null;
    if (nShape === null && nStand === null) return false;
    try {
        var fresh: any = await loadCharacter(String(pend.charId));
        if (!fresh || !fresh.position) return false;
        if (String(fresh.position.targetId || '') !== String(pend.targetId || '')) return false;
        var moved = false;
        if (nShape !== null && nShape !== String(fresh.position.shape || '').trim()) {
            fresh.position.shape = nShape; moved = true;
        }
        if (nStand !== null && nStand !== String(fresh.position.standing || '').trim()) {
            fresh.position.standing = nStand; moved = true;
        }
        if (!moved) return false;
        await saveCharacter(fresh);
        return true;
    } catch (e2) { api.v1.error('[AE:position] terminus commit:', e2); return false; }
}

// [F-21] ceStandingResolve DELETED, zero callers. It was the accept/dismiss pair's verb:
// one field, written through immediately, standing only. All three of those properties are
// now wrong -- the edit is staged rather than immediate (so a discarded move takes it with
// it), shape is editable beside standing, and both commit from the move's own button.
// ceTerminusDraft and ceTerminusCommit are the replacements and they are not a rename:
// the old verb both wrote AND cleared the record, which is why nothing here is salvaged.

// [F-14u] PUT BACK WHAT A STAKE TOOK. The author's answer to the standing problem that a
// resolution does not rewind: stateValues live on the character record in storyStorage and
// Undo rewinds historyStorage, so an undone turn keeps the damage.
//
// IT REVERSES THE MOVEMENT, NOT THE INTENT. Each ledger entry carries the delta that
// actually landed, so a cost clamped at 0 gives back what it took and not what it asked
// for -- otherwise undoing a killing blow would hand out health that never existed.
//
// IT IS NOT A TIME MACHINE AND DOES NOT PRETEND TO BE. Anything that happened downstream of
// the write -- a terminal note already queued, a story turn already generated from it --
// is not reversed, because those are not this function's to own. It is the "I did not mean
// to charge that" button, and it says so on the surface rather than promising more.
// ONE USE: the ledger is marked reversed and the button goes, so a second press cannot
// double-refund a value some other verb has moved since.
async function ceReverseStake(): Promise<boolean> {
    var last: any = await ceLastResolution();
    if (!last || last.stakeReversed) return false;
    var led: any[] = (last.stakeLedger && last.stakeLedger.length) ? last.stakeLedger : [];
    var done = 0;
    for (var i = 0; i < led.length; i++) {
        var e: any = led[i];
        if (!e || !e.delta) continue;
        try {
            if (e.time) {
                // [T-20] Reversed by nudging back, through the same verb that applied it, so
                // the schedule pass sees the crossing in both directions.
                await ceClockNudge(-Number(e.delta));
                done++;
            } else if (e.pressure) {
                // [F-17] Reversed the same way it was applied -- clamped read, clamped
                // write. historyStorage is Undo-safe, so this is belt and braces on a value
                // that may already have rewound; re-reading rather than assuming is what
                // stops the two corrections stacking.
                var rBefore = await _ceReadPressure(String(e.pressure.charId), String(e.pressure.axis));
                var rAfter = Math.max(_ceAxisFloor(String(e.pressure.axis)), Math.min(4, rBefore - Number(e.delta)));
                if (rAfter !== rBefore) await api.v1.historyStorage.set(_cePressureKey(String(e.pressure.charId), String(e.pressure.axis)), rAfter);
                done++;
            } else if (e.ref) {
                await stateNudge(e.ref as StateRef, -Number(e.delta));
                done++;
            }
        } catch (err) { api.v1.error('[AE:stake] reverse failed:', err); }
    }
    last.stakeReversed = true;
    last.stakeReversedCount = done;
    try { await api.v1.tempStorage.set(STORAGE_LAST_RESOLUTION, last); }
    catch (e2) { api.v1.error('[AE:stake] reverse record:', e2); }
    await cePublishActions();
    return done > 0;
}


// -- The armed move  [F-15a] ---------------------------------------------------
// [F-19] THE ARM CARRIES THE ATTEMPT NOW. The rule that stood here -- "there is no text
// field on the Actions panel, because the story box is already on screen beside it" -- is
// deleted rather than amended: it rested on the model reading the attempt from the document
// and the engine supplying only a verdict, and the verdict channel is gone. The panel writes
// BOTH sentences into the document itself, so the attempt has to live on the arm to get
// there. actionText is the field; ceWriteMoveToStory is where it lands.
//
// EXACTLY ONE ARM AT A TIME. Two primed moves cannot both describe one attempt, so arming
// again replaces rather than stacks. THE ATTEMPT IS CONSUMED ON WRITE AND THE SETTINGS ARE
// NOT: approach, resolution, target and wager survive, because repeating a move is the
// common case in play and re-picking four controls to do it is not.
//
// tempStorage: an arm is worth less than the memory of having made it. Surviving a reload
// would mean a roll firing against a turn the author no longer connects it to.

async function ceArmedLoad(): Promise<CeArmedAction | null> {
    try {
        var raw: any = await api.v1.tempStorage.getOrDefault(STORAGE_ARMED_ACTION, null);
        if (!raw || !raw.resolutionId) return null;
        return {
            approachDefId: String(raw.approachDefId || ''),
            resolutionId: String(raw.resolutionId || ''),
            // [F-20] An arm written before spending existed carries `situational` and no
            // spend, and reading that absence as "spend nothing" is exact: the free bonus is
            // gone, and quietly converting it into a charge against a resource the author
            // never agreed to spend would be the worse of the two readings by a distance.
            spendDefId: String(raw.spendDefId || ''),
            spendAmount: Math.max(0, Math.min(CE_SPEND_MAX, Math.round(Number(raw.spendAmount) || 0))),
            target: (raw.target && raw.target.id)
                ? { kind: String(raw.target.kind || 'char'), id: String(raw.target.id), name: String(raw.target.name || '') }
                : null,
            // [F-14] An arm written before stakes existed has no field, and the correct
            // reading of that is "follow the default" -- not "risk nothing", which would
            // silently disable the feature for one session after an upgrade.
            stakeId: (raw.stakeId === undefined || raw.stakeId === null) ? CE_STAKE_AUTO : String(raw.stakeId),
            // [F-19] An arm written before the attempt moved into this panel has no field,
            // and '' is the right reading of that: the roll refuses until something is
            // typed, which is the same answer a fresh arm gives.
            actionText: String(raw.actionText || ''),
            armedAt: Number(raw.armedAt) || 0
        };
    } catch (e) { api.v1.error('[AE:action] armed read:', e); return null; }
}

async function ceArmedSet(a: CeArmedAction | null): Promise<void> {
    try {
        if (a) await api.v1.tempStorage.set(STORAGE_ARMED_ACTION, a as any);
        else await api.v1.tempStorage.remove(STORAGE_ARMED_ACTION);
    } catch (e) { api.v1.error('[AE:action] armed write:', e); }
}

async function ceLastResolution(): Promise<any> {
    try { return await api.v1.tempStorage.getOrDefault(STORAGE_LAST_RESOLUTION, null); }
    catch (e) { return null; }
}

// [F-15a] THE ONE FIRE POINT. Called from onGenerationRequested -- the only generation hook
// with no `dryRun` flag on its params, so a costing pass cannot spend a roll. The two that
// do carry dryRun (onBeforeContextBuild, onContextBuilt) both run twice per turn with
// different continuityIds, which is documented at the DRYRUN-FIX block and is exactly the
// shape a roll must not sit in.
//
// IDEMPOTENT BY CONSUMPTION, not by a seen-set: the arm is cleared before anything else can
// ask, so a second call in the same turn finds nothing to fire. continuityId is recorded on
// the result for the panel to show, NOT used as a guard -- a guard would need a store and
// consumption already closes the hole.
//
// THE ACTOR IS THE PROTAGONIST, always. A Move is the player describing what THEY do; a
// character acting on their own is the auto-firing question the plan defers entirely.
// [F-19] STAGE ONE. THE BAND'S NOTE STOPS BEING A DIRECTIVE AND BECOMES A PROMPT.
//
// THE WHOLE POINT, and it is a fact about the models rather than a preference: per NAI's
// own devs, the story model does not want instructions -- instructing it degrades its prose
// toward the utility model's. Every earlier attempt (F-12a, F-18, F-18b) tried to hand it a
// bracketed directive anyway and argued only about WHERE. This hands the directive to
// glm-4-6, which is already this file's generator for the ephemeral pass, the hook scans,
// the architect and the journal verbs, and which wants instructions. What reaches the story
// model is not an instruction at all -- it is a SENTENCE OF STORY sitting in the document.
//   SO THE NOTES CAN GET MORE EXPLICIT, NOT LESS. "The attempt fails and the situation gets
//   worse -- name the new problem" is a poor thing to whisper at the story model and a
//   perfectly good thing to ask glm for. Nothing about the authored tables changes shape.
//
// TWO SENTENCES, NOT A COMPLETION. Per author. Grammatically finishing somebody else's
// clause is a much harder ask than writing an independent sentence after it, and the voice
// seam is far wider when it goes wrong. The composer writes ONE STANDALONE SENTENCE.
//
// IT SEES THE LEDGER. If the stake actually took a point of Health, the sentence is allowed
// to know that -- otherwise the prose and the numbers start disagreeing on the first turn
// and the receipt is the only place anyone can tell.
//
// [F-19b] ceComposeOutcome and _ceCleanOutcomeLine DELETED. They existed to turn the band
// directive into a sentence of STORY -- a glm-4-6 completion the author wrote to the
// document as prose. The pivot returns the directive to a SILENT injection: it reaches the
// story model as its own trailing user message (grep IMP-PIVOT), which is the register the
// model was trained on, rather than as a bracketed instruction that pushes its prose toward
// the utility model's. With no sentence to compose there is no composer, no restatement
// stripper (_ceStripRestatement / _ceIsWordChar, also gone), and no clean pass.

// [ATTEMPT-SCRATCH] The scratchpad the attempt field types into. `null` means "nothing
// uncommitted"; a string is text the field is holding that the arm has not seen yet. It is
// deliberately NOT '' for the empty case -- an author who clears the field and rolls means
// something different from one who never typed, and only a third value can say so.
var _ceAttemptDraft: string | null = null;

// DRAINED, NOT PEEKED AT. Reading it without clearing would leave a stale draft to
// overwrite the next preset the author loads, which is the bug this helper would otherwise
// have introduced in exchange for the one it fixes.
async function _ceFlushAttempt(armed: any): Promise<any> {
    if (_ceAttemptDraft === null) return armed;
    var draft = String(_ceAttemptDraft);
    _ceAttemptDraft = null;
    if (!armed || String(armed.actionText || '') === draft) return armed;
    await ceActionArm({ actionText: draft });
    return await ceArmedLoad();
}

// [F-19b] THE ROLL ARMS A SILENT DIRECTIVE; IT NO LONGER WRITES STORY. This reverses F-19,
// and the reversal is deliberate and measured, not a regression.
//   F-19 stopped handing the story model a bracketed instruction (which degrades its prose
//   toward glm's) by composing the directive into a SENTENCE the author wrote to the
//   document. That worked but cost a glm generation per roll and put words in the author's
//   mouth. /ce imp then measured (grep IMP-PIVOT) that the story is delivered to Xialong as
//   a chat MESSAGE ARRAY whose framing is applied below every hook -- so a directive placed
//   in its OWN trailing user message reaches the model in the exact register it was trained
//   on, with no bracket to read as an instruction and no sentence to compose.
//   SO THE ROLL NOW: applies consequences, queues the band/terminal directive into
//   STORAGE_PENDING_INJECT (ceCommitResolution already does this), writes the ATTEMPT to the
//   document as the author's own turn, and leaves the slot ARMED. onContextBuilt drains it
//   into a trailing user message on the next Send. The toolbar's disarm button is the
//   visible armed state.
//   THIS DELIBERATELY MOVES HALF THE FEATURE BACK INTO THE GENERATION LIFECYCLE, which
//   F-15d's invariant forbade after F-12a/F-18/F-18b were all broken there. The difference
//   is that those broke on WRITING the slot inside the lifecycle; this only READS a slot
//   filled a whole interaction earlier, on a press, which is the one ordering that has
//   always worked. Fail-closed: if the message array has no trailing user turn the drain
//   leaves the slot untouched rather than guessing (grep GUARD in the onContextBuilt drain).
async function ceRollNow(): Promise<boolean> {
    var armed = await ceArmedLoad();
    if (!armed) return false;
    // [ATTEMPT-SCRATCH] BEFORE ANYTHING READS actionText. See the field's own call site:
    // the click that got us here was delivered before the blur that would have armed the
    // text, so without this the first press of Roll refuses a move the author has plainly
    // written.
    armed = await _ceFlushAttempt(armed);
    if (!armed) return false;
    // [F-15d] THE SELECTION IS NOT CONSUMED. It was cleared on fire when firing happened
    // once per turn automatically; now the author presses the button, and clearing their
    // approach and stake underneath them every press would make repeat attempts -- the
    // common case in play -- four taps of re-picking. Rolling twice simply overwrites the
    // armed directive, which is ceQueueImperative's stated last-wins rule already.
    var ok = false;
    try { ok = await _ceRollInner(armed); }
    catch (e) { api.v1.error('[AE:action] roll failed:', e); }
    // ALWAYS, on every path including the early ones. The body's guard clauses used to
    // `return` out of a try and skip exactly this, which left the toolbar advertising a
    // queued outcome that no longer existed. Splitting the body out is what makes "always"
    // structurally true rather than a thing every future branch has to remember.
    try { await ceSyncToolbar(); } catch (eTb) {}
    try { await cePublishActions(); } catch (ePb) {}
    return ok;
}

async function _ceRollInner(armed: any): Promise<boolean> {
    {
        var cfg = await loadConfig();
        var pid = await ceProtagonistId(cfg);
        // [F-3] THE ACTOR, NOT NECESSARILY THE PROTAGONIST. ceActorId re-validates on every
        // roll, so a party member who left the room falls back to the protagonist here rather
        // than at the next surface repaint.
        var actorPick = await ceActorId(cfg);
        var actor: any = actorPick ? await loadCharacter(actorPick) : null;
        if (!actor) {
            try { api.v1.ui.toast('No protagonist is set, so there is nobody to roll for.', { type: 'warning', autoClose: 3500 }); } catch (e0) {}
            return false;
        }
        // [F-19] THE ATTEMPT IS REQUIRED NOW. The composer completes a sentence somebody
        // wrote; with nothing written there is nothing to complete, and an engine-authored
        // standalone action would be putting words in the player's mouth.
        if (!String(armed.actionText || '').trim()) {
            try { api.v1.ui.toast('Write what you are attempting first \u2014 the outcome is written to follow it.',
                { type: 'warning', autoClose: 4000 }); } catch (eNa) {}
            return false;
        }
        // [F-20] THE TABLE IS CHECKED BEFORE THE PURSE IS OPENED. ceResolve returns null
        // when the armed resolution has been deleted since, and spending first would burn
        // Luck for a roll that then never happened -- the one ordering mistake this feature
        // can make that the author cannot see and cannot undo.
        if (!ceResolutionDef(cfg, String(armed.resolutionId || ''))) {
            try { api.v1.ui.toast('That resolution no longer exists \u2014 pick another before rolling.',
                { type: 'warning', autoClose: 3500 }); } catch (eNr) {}
            return false;
        }
        var spend: any = await ceSpendForBonus(cfg, String(actor.id),
                                               String(armed.spendDefId || ''), Number(armed.spendAmount) || 0);
        // SPENT ONCE, THEN DISARMED. The rest of the arm deliberately survives a roll so a
        // second attempt is one tap (F-15d) -- but a spend that survived would charge again
        // on that second press, silently, for a bonus the author thought they had already
        // bought. The one part of the arm that is consumed is the one that costs something.
        if (spend.spent) {
            try { await ceActionArm({ spendDefId: '', spendAmount: 0 }); } catch (eDs) {}
        }
        var res: any = await ceResolve(cfg, actor, armed.approachDefId, armed.resolutionId,
                                        spend.bonus, spend.label);
        if (!res) return false;

        // [F-14] CONSEQUENCES FIRST, THEN THE COMMIT. Plan SS3, and the ordering is the whole
        // reason both exist as separate calls: stateSet queues a terminal note the instant a
        // value crosses a bound, so by the time ceCommitResolution asks, the answer already
        // exists and the band's own directive can be discarded in favour of it. Applying
        // after the commit would let a partial-success note describe a character who died
        // paying for it.
        var stake = ceStakeForMove(cfg, armed);
        var ledger = await ceApplyStake(cfg, stake, Number(res.bandIndex) || 0,
                                        String(actor.id), armed.target);

        // [EVENT] THE ENCOUNTER'S OWN WAGER, CHARGED AFTER THE ACTOR'S AND FROM ITS OWN
        // TABLE. Two tables because they answer two questions -- what the attempt cost the
        // actor, and whether the fight moved -- and index-aligned to the SAME band, so both
        // are judging the one roll rather than rolling twice.
        //   ALWAYS ON WHILE ONE IS RUNNING. An encounter that only advanced when the author
        //   remembered to pick a special stake is an encounter that quietly stops being one,
        //   which is exactly what shipping it as an ordinary stake row got wrong.
        //   ITS LINES JOIN THE ONE LEDGER, so "Put this back" reverses the fight's progress
        //   with the attempt that caused it. ceReverseStake walks `ref` and `delta` and an
        //   event ref carries both, so this needed no new reversal path.
        try {
            var evLiveR: any = await ceLiveEvent();
            if (evLiveR && evLiveR.ms && !armed.eventOff) {
                var evStake = ceStakeDef(cfg, String(evLiveR.ms.event.stakeId || ''));
                if (evStake) {
                    var evLed = await ceApplyStake(cfg, evStake, Number(res.bandIndex) || 0,
                                                   String(actor.id), armed.target);
                    for (var eli = 0; eli < evLed.length; eli++) ledger.push(evLed[eli]);
                    res.eventStakeName = String(evStake.name || '');
                } else if (String(evLiveR.ms.event.stakeId || '')) {
                    // NAMED, NOT SILENT -- ceApplyStake's own rule. A shape pointing at a
                    // deleted table is an authoring gap one edit wide, and a fight that
                    // silently stopped advancing looks identical to one nobody is rolling in.
                    ledger.push({ side: 'encounter', applied: false,
                        text: 'The encounter did not move \u2014 its wager has been deleted. '
                            + 'Point the shape at a table under Settings \u203a States.' });
                } else {
                    ledger.push({ side: 'encounter', applied: false,
                        text: 'The encounter did not move \u2014 its shape has no wager. '
                            + 'Give it one under Settings \u203a States.' });
                }
            }
        } catch (eEvS) { api.v1.error('[AE:action] encounter stake:', eEvS); }

        // [F-20] THE SPEND HEADS THE LEDGER, AND IT CARRIES NO `ref` AND NO `delta`, WHICH
        // IS WHAT MAKES IT IRREVERSIBLE. ceReverseStake walks exactly those two fields, so
        // omitting them is not an oversight: the points were converted into a bonus that has
        // already been rolled, and handing them back would leave the author holding both the
        // Luck and the outcome it bought. That is the mint F-14u refuses one field away.
        //   A REFUSED SPEND IS REPORTED, NOT SWALLOWED, for ceApplyStake's own reason -- an
        //   omitted line and a spend nobody asked for look identical from the receipt.
        if (spend.spent) {
            ledger.unshift({ side: 'spent', applied: true,
                text: String(spend.defName) + ' \u2212' + spend.spent + ' \u2192 +' + spend.bonus
                    + ' on the roll. Not reversible \u2014 the roll has already had it.' });
        } else if (spend.reason) {
            ledger.unshift({ side: 'spent', applied: false,
                text: 'Nothing spent \u2014 ' + String(spend.reason) + '.' });
        }

        // involvedIds is what ceCommitResolution checks for a terminal, so a target that is
        // a character belongs in it: at 0 health the DEFENDER's death preempts the band note
        // exactly as the actor's would.
        var involved: string[] = [String(actor.id)];
        if (armed.target && armed.target.kind === 'char' && armed.target.id) involved.push(String(armed.target.id));
        await ceCommitResolution(cfg, res, involved);

        var adef = armed.approachDefId ? ceStateDef(cfg, armed.approachDefId) : null;
        res.continuityId = '';
        res.at = Date.now();
        res.actorName = String(actor.name || '');
        res.approachName = adef ? String(adef.name || '') : '';
        res.target = armed.target;
        res.stakeName = stake ? String(stake.name || '') : '';
        res.stakeLedger = ledger;
        // [F-19b] THE SLOT IS LEFT ARMED, WHICH INVERTS F-19's GUARD. ceCommitResolution
        // has queued the band or terminal directive into STORAGE_PENDING_INJECT, and under
        // the pivot that IS the delivery -- onContextBuilt drains it into a trailing user
        // message on the next Send. Emptying it here (as F-19 did, because the directive was
        // about to become the composer's prompt) would now drop the injection entirely.
        // ONE SLOT, ONE DELIVERY POINT: a stepper terminal writes the same slot and rides
        // the same trailing message, so there is no second carrier to keep separate.

        // [F-21] THE THRESHOLD IS DETECTED AT THE ROLL, and the shift is FOLDED INTO THE
        // ARMED DIRECTIVE rather than into a composed sentence. Per author: by the time the
        // roll resolves the engine already knows whether this exchange broke or settled the
        // relationship, so the directive the model reads can say so.
        try { await _cePositionTerminus(String(actor.id), armed.target, ledger); }
        catch (eT) { api.v1.error('[AE:position] terminus:', eT); }
        var shifted: any = null;
        try { shifted = await api.v1.tempStorage.getOrDefault(STORAGE_POS_TERMINUS, null); }
        catch (eSh) { shifted = null; }
        if (shifted) {
            // The shift language that used to live in ceComposeOutcome, now appended to the
            // directive text itself. Re-queued through the one door so last-wins holds.
            try {
                var pend0 = String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || '');
                var shiftLine = 'This exchange is also the moment the relationship between them '
                    + (shifted.warm ? 'settles into something neither of them has to defend any more'
                                    : 'breaks in a way that will not be walked back') + '.';
                await ceQueueImperative(pend0 ? (pend0 + ' ' + shiftLine) : shiftLine);
            } catch (eShq) { api.v1.error('[AE:position] shift fold:', eShq); }
        }

        res.actionText = String(armed.actionText || '');
        res.sentToStory = false;
        try { await api.v1.tempStorage.set(STORAGE_LAST_RESOLUTION, res); }
        catch (eSt) { api.v1.error('[AE:action] result store:', eSt); }

        // [I-07] THE ROLL WRITES THE ATTEMPT. Per author: "we shouldn't need a second click
        // to commit what the author already clicked once for." The two-press shape came from
        // F-15d, where the second press was a real decision -- back then the roll COMPOSED a
        // sentence and the author was approving words the engine had put in their mouth.
        // F-19b deleted the composer: what gets written is now the author's own text,
        // unchanged, which they already wrote and already pressed Roll on. Approving your own
        // sentence back to yourself is not a decision, it is a receipt with a button on it.
        //   THE PRESS IS STILL SEPARATE FROM SEND. Nothing here generates -- the directive is
        //   armed and NAI's own Send delivers it, which is the invariant F-15d actually
        //   protects and this does not touch.
        //   AFTER THE RESULT IS STORED, NEVER BEFORE. ceWriteMoveToStory reads
        //   STORAGE_LAST_RESOLUTION and marks it sent; writing first would have it read the
        //   PREVIOUS roll's attempt.
        //   A FAILED WRITE IS NOT A FAILED ROLL. ceWriteMoveToStory toasts for itself and
        //   leaves sentToStory false, so the panel still offers the button and the dice are
        //   not thrown away for a document error.
        try { await ceWriteMoveToStory(); }
        catch (eWr) { api.v1.error('[AE:action] auto-write:', eWr); }
        return true;
    }
}

// [F-15d] Throw away a composed outcome without sending. The counterpart to rolling early:
// if you can roll before you commit, you must be able to decide not to use it.
// [F-19b] DISARM. Empties the pending-inject slot so the armed directive does not ride the
// next Send, and bins the staged relationship edits with it. There is no composed line to
// clear any more.
async function ceDiscardQueued(): Promise<void> {
    await ceQueueImperative('');
    // [F-21] The staged relationship edits belong to the move, so binning the move bins
    // them. The TIER is not reverted here -- ceApplyStake already wrote it and the receipt's
    // "Put this back" (F-14u) is the verb that reverses real deltas.
    try { await api.v1.tempStorage.remove(STORAGE_POS_TERMINUS); } catch (eTp) {}
    var last: any = await ceLastResolution();
    if (last) {
        last.discarded = true;
        try { await api.v1.tempStorage.set(STORAGE_LAST_RESOLUTION, last); } catch (e) {}
    }
    await ceSyncToolbar();
    await cePublishActions();
}

// [F-19] REWRITE THE PROSE, KEEP THE DICE. The roll is spent the moment it happens; the
// sentence describing it is not. Regenerating re-runs the composer against the SAME stored
// band and the SAME ledger, so no amount of pressing this button can improve the outcome --
// it can only change how the outcome reads. That split is the whole reason the composer
// takes a stored result rather than re-resolving.
// [F-19b] ceRegenerateOutcome and ceOutcomeEdit DELETED with the composer. There is no
// composed line to rewrite or hand-edit; the directive is fixed at the roll and delivered
// verbatim, and the receipt already shows what it says.

// [F-19] THE MOVE BECOMES DOCUMENT TEXT. One instruction paragraph holding both sentences,
// then an empty paragraph, and NOTHING ELSE -- this function does not generate.
//
// IT WRITES BARE TEXT WITH source:'instruction' AND NO LITERAL BRACES. NAI draws the brace
// around an instruction paragraph itself. CharChat wrote '{Nate: ...}' by hand and re-baked
// '{ {Nate: ...} }' on every reopen; WIZLIVE then repeated it and the correction is logged
// as WIZLIVE-BRACE-DOUBLE. This is the third site and it starts on the right side of it.
// Per author the story model reads a brace block as the user's turn in text-adventure mode
// as well as storytelling mode, so there is one form here rather than a mode branch.
//
// THE EMPTY PARAGRAPH IS NOT COSMETIC. Without a trailing break NAI glues its reply onto the
// tail of the last paragraph -- the merged-section bug _charchatSplitMergedSections and
// _wizliveSplitMergedSections both exist to repair. Appending one costs nothing and is the
// same fix _ceEnsureTrailingBreak's two named cousins already make.
//
// NAI'S OWN SEND STILL GENERATES. Per author. The engine does not call editor.generate():
// the author sees the composed paragraph land in their document, can edit it there like any
// other text, and presses Send when they mean it. That also keeps every part of this feature
// outside the generation lifecycle, which is the one rule three earlier delivery attempts
// were all broken by (grep F-15d).
async function ceWriteMoveToStory(): Promise<boolean> {
    var last: any = await ceLastResolution();
    if (!last || last.sentToStory) return false;
    var act = String(last.actionText || '').trim();
    if (!act) return false;
    // [F-19b] THE ATTEMPT ALONE. The outcome is no longer a sentence written beside it --
    // it is the armed directive, delivered silently as a trailing user message on Send. So
    // this writes ONLY the author's own words, as their turn, and the directive rides
    // underneath it invisibly.
    var bodyTxt = _ceEndSentence(act);
    try {
        await api.v1.document.appendParagraph({ text: bodyTxt, source: 'instruction' });
        await api.v1.document.appendParagraph({ text: '' });
    } catch (e) {
        api.v1.error('[AE:outcome] document write failed:', e);
        try { api.v1.ui.toast('Could not write to the story \u2014 nothing was sent.',
            { type: 'error', autoClose: 4000 }); } catch (e2) {}
        return false;
    }
    last.sentToStory = true;
    try { await api.v1.tempStorage.set(STORAGE_LAST_RESOLUTION, last); } catch (e3) {}
    // [F-21] THE RELATIONSHIP MOVES IN THE SAME PRESS. After the document write, never
    // before: if appendParagraph throws, the function has already returned and the staged
    // edits are still staged, so the author has not silently had a relationship rewritten
    // for a turn that never reached the story.
    var relMoved = false;
    try { relMoved = await ceTerminusCommit(); }
    catch (eRc) { api.v1.error('[AE:position] terminus commit:', eRc); }
    // The ATTEMPT is consumed; the approach, resolution, target and wager are not. Repeating
    // a move is the common case in play and re-picking four controls to do it is not.
    await ceActionArm({ actionText: '' });
    await ceSyncToolbar();
    await cePublishActions();
    try { api.v1.ui.toast(relMoved
        ? 'Attempt written and the relationship updated. The outcome is armed \u2014 press Send.'
        : 'Attempt written. The outcome is armed \u2014 press Send.',
        { type: 'success', autoClose: 3000 }); } catch (e4) {}
    return true;
}


// [F-19] Both halves are joined into one paragraph, so a missing stop makes the seam read as
// one run-on sentence. Only '.' is added, and only when the line ends on a word: an author
// who wrote '!' or '...' or a closing quote meant it.
function _ceEndSentence(s: string): string {
    var v = String(s || '').trim();
    if (!v) return v;
    // A STRING SCAN, NOT A CHARACTER CLASS. An escaped closing bracket inside a regex class
    // is invisible to the balance-delta gate this file verifies every patch with, and a
    // check that has to be hand-waived once stops being a check. indexOf counts clean.
    var CE_SENTENCE_END = '.!?\u2026\u201d\u2019"\')';
    return CE_SENTENCE_END.indexOf(v.charAt(v.length - 1)) >= 0 ? v : (v + '.');
}


// -- Projection for surfaces ---------------------------------------------------
// Every def visible to one owner, with its value, its band and its rest flag, in catalog
// order. ONE FUNCTION FOR EVERY SCOPE so a surface never filters the catalog itself --
// the protagonist rule in particular (a 'protagonist' def belongs to exactly one
// character) is decided here and nowhere else.
//
// Takes an ALREADY-LOADED character when it has one, because its only caller today is
// cePublishProfile, which has just loaded that record. Passing the record rather than the
// id keeps a publish that already costs one storage read at one storage read.
function ceStateRowsForChar(cfg: GlobalConfig | null, char: any, isProtagonist: boolean): any[] {
    var defs = ceStateDefs(cfg);
    var sv: any = (char && char.stateValues) || {};
    var rows: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        var def = defs[i];
        if (!def) continue;
        if (!ceStateAppliesToChar(def, isProtagonist)) continue;
        var raw = (sv[def.id] === undefined) ? ceStateStart(def) : sv[def.id];
        var v = ceStateClamp(def, raw);
        var band = ceStateBand(def, v);
        rows.push({
            defId: String(def.id), name: String(def.name || 'Unnamed'), scope: String(def.scope),
            min: _ceStateBounds(def).lo, max: _ceStateBounds(def).hi,
            value: v, label: band.label, atRest: band.atRest, banded: band.banded,
            speaks: ceStateSpeaks(def, v),
            // [F-11] Whether THIS def is at a bound with a terminal on it. Not whether it
            // is the WINNING terminal -- that is ceStateTerminalFor's job and depends on the
            // whole record. A surface showing "at a terminal" per row is telling the truth
            // about the row; only the resolution path needs to know which one fires.
            terminal: !!ceStateTerminalOf(def, v),
            modifier: ceStateIsModifier(def),
            category: String(def.category || ''),
            // [G-02] THE PROJECTION DECIDES, THE SURFACE FILTERS. Computing this here is
            // what stops the profile drill and the faction panel each deciding what "empty"
            // means and drifting apart on the day somebody changes it.
            hidden: !!def.hideAtStart && (v === ceStateStart(def))
        });
    }
    return rows;
}

// [G-02] SPLIT A PROJECTION INTO WHAT IS DRAWN AND WHAT IS OFFERED. One pass, two lists, so
// a surface cannot show a row in both -- which is what a filter plus a second filter written
// beside it eventually does. A revealed def moves to `shown` for the rest of the session.
function ceStateSplitHidden(rows: any[]): { shown: any[]; blank: any[] } {
    var shown: any[] = [];
    var blank: any[] = [];
    for (var i = 0; i < (rows || []).length; i++) {
        var r: any = rows[i];
        if (!r) continue;
        if (r.hidden && !_ceStateRevealed(String(r.defId))) blank.push(r); else shown.push(r);
    }
    return { shown: shown, blank: blank };
}

// [F-25] A STANDING'S DEF ID, DERIVED FROM THE FACTION AND NEVER STORED. Deterministic so
// nothing has to keep a mapping in sync, and prefixed so a managed def is recognisable in a
// storage dump without consulting the catalog.
function ceStandingDefId(factionId: string): string {
    return 'st_standing_' + String(factionId || '');
}

// [F-31] WHICH FACTION A CHARACTER ACTS FOR, DERIVED FROM STANDING AND NEVER STORED. F-27
// settled that membership is a QUESTION ABOUT STANDING rather than a list; this asks the same
// question of one character instead of one faction, so the roster and the stake chain cannot
// come to disagree about who belongs to what.
//   THE WARMEST STANDING WINS and ties go to catalog order. A character sworn to two factions
//   is a story rather than an error, but a stake has to charge exactly one, so it charges the
//   one they stand highest with.
//   AT REST IS NOT A MEMBER, exactly as the roster reads it -- the middle rung is where a
//   stranger stands. BELOW rest is not a member either, and that is the one place this
//   differs from the roster: a sworn enemy is a fact about a faction worth listing, and is
//   not somebody who acts for it.
//   ONLY MANAGED DEFS ARE CONSULTED, identified by `managed` exactly as ceSyncStandingDefs
//   identifies the rows it owns, so an author who happens to name a def "Standing" is not
//   read as a membership claim.
async function ceCharFactionId(cfg: GlobalConfig | null, charId: string): Promise<string> {
    var cid = String(charId || '');
    if (!cid) return '';
    var c: any = null;
    try { c = await loadCharacter(cid); } catch (e) { return ''; }
    if (!c) return '';
    var sv: any = c.stateValues || {};
    var defs: StateDef[] = ceStateDefs(cfg);
    var bestId = '';
    var bestMargin = 0;
    for (var i = 0; i < defs.length; i++) {
        var d: any = defs[i];
        if (!d || !d.managed) continue;
        var own = String(d.managed);
        if (own.indexOf('faction:') !== 0) continue;
        var raw = (sv[d.id] === undefined) ? ceStateStart(d) : sv[d.id];
        var idx = ceStateBand(d, ceStateClamp(d, raw)).index;
        var rest = Math.round(Number(d.restBand) || 0);
        var margin = idx - rest;
        if (margin > bestMargin) { bestMargin = margin; bestId = own.slice(8); }
    }
    return bestId;
}

// [F-31] AN ENCOUNTER'S OWN WAGER, RECOGNISED RATHER THAN FLAGGED. Every non-empty cell in
// one names an event-scoped def -- true of the ten seeded tables and of any an author writes,
// false of every ordinary wager. NO FIELD, for F-29's reason exactly: a flag and a table are
// two records that can disagree, and the table is the one that moves.
//   IT FILTERS EXACTLY ONE CONTROL, the BASE wager select on the Actions panel. Choosing one
//   there while an encounter runs would charge the track a SECOND time on top of the
//   always-on encounter wager -- a silent double, and not a choice anybody means to make.
//   Settings > Rolls still lists them, edits them and points shapes at them.
function ceStakeIsEvent(cfg: GlobalConfig | null, stake: StakeDef | null): boolean {
    if (!stake) return false;
    var rows: any[] = Array.isArray(stake.rows) ? stake.rows : [];
    var seen = false;
    for (var i = 0; i < rows.length; i++) {
        var r: any = rows[i];
        if (!r) continue;
        var cells: any[] = [r.actor, r.target];
        for (var ci = 0; ci < cells.length; ci++) {
            var cell: any = cells[ci];
            if (!cell || !cell.defId) continue;
            if (!Math.round(Number(cell.amount) || 0)) continue;
            var d2 = ceStateDef(cfg, String(cell.defId));
            if (!d2 || String(d2.scope || '') !== 'event') return false;
            seen = true;
        }
    }
    return seen;
}

// [EVT-POLARITY] WHICH WAY THE BAR READS, DERIVED FROM THE SHAPE'S OWN WAGER. A track is a
// progress bar and a progress bar fills, so nine of the ten seeded shapes count UP -- but
// Infiltration counts up toward being CAUGHT, and a full bar there means the opposite of what
// a full bar means everywhere else.
//   THE WAGER ALREADY KNOWS. Look at the BEST outcome's actor cell: if it moves the track,
//   its sign is the polarity. If the best outcome moves it nothing -- which is exactly what a
//   cost meter looks like -- take the WORST outcome and invert it.
//   NO FIELD ON THE SHAPE, because a declared polarity and a wager are two records that can
//   disagree and editing the wager is the thing an author actually does. Returns 0 when
//   neither row says anything, and 0 is the untinted gauge, which is what every shape written
//   before this looked like.
function ceEventPolarity(cfg: GlobalConfig | null, def: StateDef | null): number {
    if (!def) return 0;
    var stake = ceStakeDef(cfg, String((def as any).eventStakeId || ''));
    if (!stake) return 0;
    var rows: any[] = Array.isArray(stake.rows) ? stake.rows : [];
    if (!rows.length) return 0;
    var did = String(def.id);
    var pick = function(row: any): number {
        if (!row || !row.actor) return 0;
        if (String(row.actor.defId || '') !== did) return 0;
        var a = Math.round(Number(row.actor.amount) || 0);
        return (a > 0) ? 1 : ((a < 0) ? -1 : 0);
    };
    var best = pick(rows[rows.length - 1]);
    if (best) return best;
    var worst = pick(rows[0]);
    return worst ? -worst : 0;
}

// [F-25] REGENERATE EVERY STANDING DEF FROM ITS FACTION.// [F-25] REGENERATE EVERY STANDING DEF FROM ITS FACTION. Mutates the config in place and is
// IDEMPOTENT, which is what lets it run from migrateConfig on every load as well as from the
// two ladder editors -- there is no call site that can be forgotten, because the load path
// repairs whatever the edit path missed.
//   THE VALUE IS NOT TOUCHED. Values live in char.stateValues keyed by defId, so rebuilding
//   the def leaves every standing exactly where it was; a shortened ladder clamps on read
//   through ceStateClamp, which is the behaviour a shortened ladder should have.
//   A DELETED FACTION TAKES ITS DEF WITH IT. The orphaned stateValues entries are left --
//   harmless, unread, and cheaper than walking every character to strip them. If the author
//   recreates a faction with the same id the values come back, which is a feature.
//   ONLY defs THIS FUNCTION OWNS ARE TOUCHED, identified by `managed`, so an author who
//   happens to name a def "Standing" keeps it.
// [F-28] ASYNC NOW, BECAUSE A FACTION IS AN ENTITY. It read cfg.factions and could run
// inside migrateConfig; factions live in storyStorage and it cannot. THE IDEMPOTENT-REPAIR
// GUARANTEE SURVIVES -- it runs at boot after the migration and after every faction edit,
// so a missed edit-site call is still fixed by opening the story.
async function ceSyncStandingDefs(): Promise<void> {
    let metas: any[] = await ceFactionMetas();
    // ONE mutConfig, NOT ONE PER FACTION. Every ladder is resolved before the write opens,
    // because mutConfig is load-modify-save with no compare-and-swap and N of them racing
    // is exactly the discarded-write this file's lock-order note describes.
    let plan: any[] = [];
    for (let i = 0; i < metas.length; i++) {
        let fid = String(metas[i].id);
        let ent: any = null;
        try { ent = await loadEntity(fid); } catch (eL) { ent = null; }
        if (!ent) continue;
        plan.push({ id: fid, name: String(ent.name || 'this faction'), ladderSrc: ent });
    }
    await mutConfig(function(c: any) {
        if (!Array.isArray(c.stateDefs)) return;
        let live: any = {};
        for (let i = 0; i < plan.length; i++) {
            let did = ceStandingDefId(plan[i].id);
            live[did] = true;
            let ladder = ceStandingLadderFor(c, plan[i].ladderSrc);
            if (!ladder.length) continue;
            let facName = plan[i].name;
            let bands: any[] = [];
            for (let b = 0; b < ladder.length; b++) {
                // THE BAND LABEL IS A CLAUSE, NOT A WORD, because DEFAULT_STATE_LINE composes
                // "|name| |bandLabel|" -- the shape StateDef.line's own comment gives as the
                // example: "Marek is Hostile toward the Iron Circle".
                bands.push({ at: b, label: 'is ' + ladder[b] + ' toward ' + facName });
            }
            // [F-30] THE TWO RUNGS ARE READ, NOT ASSUMED. Both resolve to the middle when
            // nothing is set, which is the literal value this line used to compute -- so the
            // regeneration this function performs on every load is unchanged for a story that
            // never opened the controls. THE VALUES ARE STILL NOT TOUCHED: standings live in
            // char.stateValues keyed by defId, so moving rest or start re-describes the
            // ladder without moving anybody on it.
            let rungRest  = ceStandingRungFor(c, plan[i].ladderSrc, 'standingRest',  ladder.length);
            let rungStart = ceStandingRungFor(c, plan[i].ladderSrc, 'standingStart', ladder.length);
            let next: any = {
                id: did, name: 'Standing \u00b7 ' + facName, scope: 'char', category: 'Standing',
                min: 0, max: ladder.length - 1, start: rungStart, bands: bands, restBand: rungRest,
                attach: ['target'], managed: 'faction:' + plan[i].id
            };
            let found = -1;
            for (let s = 0; s < c.stateDefs.length; s++) {
                if (c.stateDefs[s] && String(c.stateDefs[s].id) === did) { found = s; break; }
            }
            if (found >= 0) c.stateDefs[found] = next; else c.stateDefs.push(next);
        }
        // A DELETED FACTION TAKES ITS DEF WITH IT. Orphaned stateValues are left -- unread,
        // and cheaper than walking every character; recreating the faction under the same id
        // restores them, which is a feature. ONLY defs THIS FUNCTION OWNS are touched.
        for (let i = c.stateDefs.length - 1; i >= 0; i--) {
            let def: any = c.stateDefs[i];
            if (!def || !def.managed) continue;
            if (String(def.managed).indexOf('faction:') !== 0) continue;
            if (!live[String(def.id)]) c.stateDefs.splice(i, 1);
        }
    });
}

// [F-24] THE ONE READ OF A STANDING LADDER. Absent, empty and all-blank all mean the same
// thing -- "this faction has not diverged" -- and collapsing them here is what stops three
// call sites from each picking a different one of the three. Returns a COPY, because the
// callers that will use this next are band-table builders that would otherwise be handed the
// config's own array to mutate.
function ceStandingLadderFor(cfg: GlobalConfig | null, fac: any): string[] {
    var own: any = fac ? fac.standingLadder : null;
    if (Array.isArray(own)) {
        var kept: string[] = [];
        for (var i = 0; i < own.length; i++) {
            var s = String(own[i] === undefined || own[i] === null ? '' : own[i]).trim();
            if (s) kept.push(s);
        }
        if (kept.length) return kept;
    }
    var world: any = (cfg as any) ? (cfg as any).standingLadder : null;
    if (Array.isArray(world) && world.length) return world.slice();
    return DEFAULT_STANDING_LADDER.slice();
}

// [F-30] THE RESTING RUNG AND THE STARTING RUNG. Three levels, one rule, and it is the SAME
// rule ceStandingLadderFor applies to the rungs themselves: the faction's own if it set one,
// otherwise the world's, otherwise the middle. The middle is what ceSyncStandingDefs
// hard-coded before this existed, so a story that never opens either control is unchanged.
//   CLAMPED ON READ, for StateDef.restBand's own stated reason: an index does not survive a
//   shortened list, and every reader clamping is what makes shortening one safe rather than
//   an error. Callers pass the length of the ladder ACTUALLY IN FORCE, not the config's.
//   REST AND START ARE SEPARATE FIELDS AND NOT ONE. A world where a stranger is already
//   distrusted is a real setting -- start cold, rest at neutral -- and collapsing them would
//   make that inexpressible. They are seeded to the same rung, so an author who does not care
//   never sees the difference.
function ceStandingMidRung(len: number): number {
    return Math.max(0, Math.floor((Math.max(1, len) - 1) / 2));
}

function ceStandingRungFor(cfg: GlobalConfig | null, fac: any, field: string, len: number): number {
    var raw: any = (fac && (fac as any)[field] !== undefined && (fac as any)[field] !== null)
        ? (fac as any)[field]
        : ((cfg as any) ? (cfg as any)[field] : undefined);
    if (raw === undefined || raw === null || raw === '') return ceStandingMidRung(len);
    var n = Math.round(Number(raw));
    if (!isFinite(n)) return ceStandingMidRung(len);
    return Math.max(0, Math.min(Math.max(0, len - 1), n));
}

// [F-23] THE FACTION SIBLING. Deliberately a separate function rather than a `scope`
// parameter on the one above: the char version reads values off a RECORD it was handed and
// the faction version is handed a BUCKET loaded from storage, so a merged signature would
// carry two mutually exclusive value sources and every caller would have to pass the null.
// The row shape is identical, because the surfaces that render it must not care.
// NO `speaks`, NO `terminal` FIELD DIFFERENCE -- a faction value bands, rests and terminates
// exactly as a character's does. Nothing about scope changes what a bounded number IS (D-19).
function ceStateRowsForFaction(cfg: GlobalConfig | null, bucket: any): any[] {
    var defs = ceStateDefs(cfg);
    var sv: any = bucket || {};
    var rows: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        var def = defs[i];
        if (!def || def.scope !== 'faction') continue;
        var raw = (sv[def.id] === undefined) ? ceStateStart(def) : sv[def.id];
        var v = ceStateClamp(def, raw);
        var band = ceStateBand(def, v);
        rows.push({
            defId: String(def.id), name: String(def.name || 'Unnamed'), scope: 'faction',
            min: _ceStateBounds(def).lo, max: _ceStateBounds(def).hi,
            value: v, label: band.label, atRest: band.atRest, banded: band.banded,
            speaks: ceStateSpeaks(def, v),
            terminal: !!ceStateTerminalOf(def, v),
            modifier: ceStateIsModifier(def),
            category: String(def.category || ''),
            // [G-02] The faction sibling gets it too. "Nothing about scope changes what a
            // bounded number IS" (D-19) is this function's own founding rule, and a
            // treasury nobody has touched is as uninteresting as an unhurt character.
            hidden: !!def.hideAtStart && (v === ceStateStart(def))
        });
    }
    return rows;
}

// ============================================================================
// SECTION 7c — CLOCK CORE   [SEC:CLOCK]
// The story's own time. ONE INTEGER AND A PILE OF DERIVATIONS, which is SECTION 7b's
// split exactly: the number is stored, every word is computed, and nothing derived is
// ever written back.
//
// ── WHAT LIVES WHERE ────────────────────────────────────────────────────────
//   the number     STORAGE_CLOCK, historyStorage        (T-03)
//   the calendar   cfg.calendar                         (Settings > Time)
// historyStorage AND NOT storyStorage, which is the one thing here worth getting wrong
// only once: this moves every turn and must rewind. Same tier as pressure, same reason.
//
// ── THE TWO CONSTANTS ───────────────────────────────────────────────────────
// Per author there is no control for minutes-per-hour or hours-per-day, so they are not
// on CalendarDef either -- a field with no door is the thing F-20's rate knob was dropped
// for. THE WEEK AND THE YEAR ARE STILL AUTHORED: the week is however many day names
// exist and the year is however many months do.
//
// ── STORY ZERO IS A FLOOR ───────────────────────────────────────────────────
// Every value is clamped at 0 on the way in. A story cannot run before it began, and the
// alternative is negative operands to `%`, which JavaScript answers with a negative
// remainder and every derivation below would then quietly disagree about what day it is.
//
// ── THE MODEL SEES ceClockBand AND NOTHING ELSE  [T-06] ─────────────────────
// The stamp, the date phrase and the raw count are author-facing. This is not a style
// preference: a raw magnitude in context is what the band ladder exists to prevent, and
// the clock is the largest magnitude in the file.
//
// ── READING NEVER WRITES ────────────────────────────────────────────────────
// Unlike loadProtagonistLocation, which persists its own fallback, ceClockLoad resolves
// an unset clock to the calendar's start and stores nothing. An author who has never
// touched the clock has no clock record, and that is a legible state rather than a
// bootstrap artefact.
// ============================================================================

// The two divisors. Not on CalendarDef and not in Settings -- see the header.
var CE_MINS_HOUR = 60;
var CE_HOURS_DAY = 24;
var CE_MINS_DAY  = CE_MINS_HOUR * CE_HOURS_DAY;

// [T-06] The shipped ladder. Five bands, because five is what a day divides into in
// prose -- and because these are the only words the model gets, so they are written as
// the model should say them rather than as clock ranges.
// SEEDED ON READ, NOT ON THE RECORD. ceCalendar substitutes these when `bands` is ABSENT
// and leaves an EMPTY array alone, so an author who deletes every band gets silence
// rather than the defaults handed back -- the absent/empty distinction ceStandingLadderFor
// deliberately collapses and this one deliberately does not.
var DEFAULT_TIME_BANDS: TimeBandDef[] = [
    { label: 'the small hours',       from: 0,  to: 5 },
    { label: 'early morning',         from: 5,  to: 9 },
    { label: 'the middle of the day', from: 9,  to: 16 },
    { label: 'the evening',           from: 16, to: 22 },
    { label: 'deep night',            from: 22, to: 0 }   // wraps midnight
];

// The seed a NEW story gets. THE REAL CALENDAR, and the earlier invented one was a
// mistake worth naming: a default is not neutral, it is what every author who does not
// open this screen actually ships with. Seeding Firstday/Thaw/Blackfrost meant a
// contemporary story had to DELETE twelve invented proper nouns to get back to the
// calendar it already wanted, and a secondary-world story has to write its own either way.
// The default is now the one calendar a reader already knows; inventing one is the
// interesting work and it stays with the author.
// FEBRUARY IS 28 AND THERE ARE NO LEAP YEARS. ceClockMonth walks a fixed month list, so a
// leap rule would be a second, conditional year length that every derivation would have to
// agree about. A story that needs one has a bigger calendar problem than this field.
var DEFAULT_CALENDAR: CalendarDef = {
    dayNames: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    months: [ { name: 'January', days: 31 }, { name: 'February', days: 28 },
              { name: 'March', days: 31 },   { name: 'April', days: 30 },
              { name: 'May', days: 31 },     { name: 'June', days: 30 },
              { name: 'July', days: 31 },    { name: 'August', days: 31 },
              { name: 'September', days: 30 }, { name: 'October', days: 31 },
              { name: 'November', days: 30 }, { name: 'December', days: 31 } ],
    bands: DEFAULT_TIME_BANDS.slice(),
    startAt: 8 * 60,
    advancePerGen: 0
};

// -- Resolution ---------------------------------------------------------------

// THE ONE READER OF cfg.calendar. Absent, partial and malformed all resolve to the same
// filled object; a direct read is how one call site comes to describe a day another one
// draws. Returns a COPY of the arrays, so a caller sorting or splicing a band list cannot
// reach into the config.
function ceCalendar(cfg: GlobalConfig | null): any {
    var raw: any = (cfg as any) ? (cfg as any).calendar : null;
    if (!raw || typeof raw !== 'object') raw = {};
    var days: string[] = [];
    if (Array.isArray(raw.dayNames)) {
        for (var i = 0; i < raw.dayNames.length; i++) {
            var dn = String(raw.dayNames[i] || '').trim();
            if (dn) days.push(dn);
        }
    } else {
        days = (DEFAULT_CALENDAR.dayNames || []).slice();
    }
    var months: any[] = [];
    if (Array.isArray(raw.months)) {
        for (var m = 0; m < raw.months.length; m++) {
            var mo: any = raw.months[m] || {};
            var nm = String(mo.name || '').trim();
            // A month with no length is one day rather than zero: a zero would make the
            // year-length sum divide by nothing and hang the day walk below.
            if (nm) months.push({ name: nm, days: Math.max(1, Math.round(Number(mo.days) || 1)) });
        }
    } else {
        months = JSON.parse(JSON.stringify(DEFAULT_CALENDAR.months || []));
    }
    var bands: TimeBandDef[] = [];
    if (Array.isArray(raw.bands)) {
        for (var b = 0; b < raw.bands.length; b++) {
            var bd: any = raw.bands[b] || {};
            var lb = String(bd.label || '').trim();
            if (!lb) continue;
            bands.push({ label: lb,
                         from: _ceHourSafe(bd.from),
                         to:   _ceHourSafe(bd.to) });
        }
    } else {
        bands = JSON.parse(JSON.stringify(DEFAULT_TIME_BANDS));
    }
    var start = Math.round(Number(raw.startAt));
    if (!isFinite(start) || start < 0) start = Number(DEFAULT_CALENDAR.startAt) || 0;
    var perGen = Math.round(Number(raw.advancePerGen));
    if (!isFinite(perGen) || perGen < 0) perGen = 0;
    return { dayNames: days, months: months, bands: bands, startAt: start, advancePerGen: perGen };
}

function _ceHourSafe(h: any): number {
    var n = Math.round(Number(h));
    if (!isFinite(n)) return 0;
    return ((n % CE_HOURS_DAY) + CE_HOURS_DAY) % CE_HOURS_DAY;
}

// Story zero is the floor -- see the header. Every entry point runs through this.
function _ceMinsSafe(t: any): number {
    var n = Math.round(Number(t));
    if (!isFinite(n) || n < 0) return 0;
    return n;
}

// -- Derivations (pure) -------------------------------------------------------

function ceClockDay(t: number): number { return Math.floor(_ceMinsSafe(t) / CE_MINS_DAY); }
function ceClockHour(t: number): number { return Math.floor((_ceMinsSafe(t) % CE_MINS_DAY) / CE_MINS_HOUR); }
function ceClockMinute(t: number): number { return _ceMinsSafe(t) % CE_MINS_HOUR; }

// -1 FOR A WORLD WITH NO WEEK, and callers branch on it rather than on the array length.
// A story with no named days is a working state -- most secondary-world fiction has one --
// and returning 0 would make every day Firstday.
function ceClockWeekday(cal: any, t: number): number {
    var names: string[] = (cal && cal.dayNames) || [];
    if (!names.length) return -1;
    return ceClockDay(t) % names.length;
}

// null FOR A WORLD WITH NO MONTHS. Walks the month list rather than dividing, because
// months may differ in length and the sum is the only thing that is a constant.
function ceClockMonth(cal: any, t: number): any {
    var ms: any[] = (cal && cal.months) || [];
    if (!ms.length) return null;
    var total = 0;
    var i: number;
    for (i = 0; i < ms.length; i++) total += Math.max(1, Number(ms[i].days) || 1);
    if (total <= 0) return null;
    var abs = ceClockDay(t);
    var d = abs % total;
    var year = Math.floor(abs / total) + 1;
    for (i = 0; i < ms.length; i++) {
        var len = Math.max(1, Number(ms[i].days) || 1);
        if (d < len) return { index: i, name: String(ms[i].name || ''), dayOfMonth: d, year: year };
        d -= len;
    }
    return null;
}

// [F-2] THE INVERSE OF ceClockMonth, and the two must round-trip or the month grid maps a
// tapped cell to the wrong day. year is 1-based and monthIndex/dayOfMonth are ZERO-based,
// matching exactly what ceClockMonth returns, so its output feeds straight back in.
// -1 FOR A WORLD WITH NO MONTHS, the same sentinel shape ceClockWeekday uses for no week:
// a monthless world has no grid to tap and the caller branches on it.
// EVERY OPERAND IS CLAMPED, because the callers are UI: a tapped cell is trustworthy but a
// month-nav that walks off the end of the year is not, and an out-of-range day silently
// wrapping would put an entry on a date the author never chose.
function ceClockDayOf(cal: any, year: number, monthIndex: number, dayOfMonth: number): number {
    var ms: any[] = (cal && cal.months) || [];
    if (!ms.length) return -1;
    var y = Math.max(1, Math.round(Number(year) || 1));
    var mi = Math.max(0, Math.min(ms.length - 1, Math.round(Number(monthIndex) || 0)));
    var total = 0;
    var i: number;
    for (i = 0; i < ms.length; i++) total += Math.max(1, Number(ms[i].days) || 1);
    var abs = (y - 1) * total;
    for (i = 0; i < mi; i++) abs += Math.max(1, Number(ms[i].days) || 1);
    var len = Math.max(1, Number(ms[mi].days) || 1);
    abs += Math.max(0, Math.min(len - 1, Math.round(Number(dayOfMonth) || 0)));
    return abs;
}

// [F-2] The first absolute day of the month containing absDay. Takes a DAY, not minutes --
// the grid works in whole days and converting at every call site is where an off-by-a-day
// gets in. Returns absDay unchanged in a monthless world, which is the one honest answer:
// with no months there is no month to find the start of.
function ceClockMonthStart(cal: any, absDay: number): number {
    var d = Math.max(0, Math.round(Number(absDay) || 0));
    var mo = ceClockMonth(cal, d * CE_MINS_DAY);
    if (!mo) return d;
    return d - mo.dayOfMonth;
}

// [T-06] THE ONLY DERIVATION AN INJECTION MAY READ. A band whose `from` is greater than
// its `to` wraps past midnight; one whose bounds are equal matches nothing, because a
// zero-width band is an authoring mistake and reading it as "always" would silently
// replace every other row in the table.
function ceClockBand(cal: any, t: number): string {
    var bands: TimeBandDef[] = (cal && cal.bands) || [];
    var h = ceClockHour(t);
    for (var i = 0; i < bands.length; i++) {
        var b = bands[i];
        if (!b || !b.label) continue;
        if (b.from < b.to) { if (h >= b.from && h < b.to) return String(b.label); }
        else if (b.from > b.to) { if (h >= b.from || h < b.to) return String(b.label); }
    }
    return '';
}

function _cePad2(n: number): string { return (n < 10 ? '0' : '') + String(n); }

// '14:20'. Author-facing, and rendered in ceMono everywhere it appears.
function ceClockTimeOfDay(t: number): string {
    return _cePad2(ceClockHour(t)) + ':' + _cePad2(ceClockMinute(t));
}

// 'Marketday 14:20', or 'Day 4 14:20' in a world with no week. AUTHOR-FACING ONLY.
function ceClockStamp(cal: any, t: number): string {
    var wd = ceClockWeekday(cal, t);
    var names: string[] = (cal && cal.dayNames) || [];
    var head = (wd >= 0 && names[wd]) ? String(names[wd]) : ('Day ' + String(ceClockDay(t) + 1));
    return head + ' ' + ceClockTimeOfDay(t);
}

function _ceOrdinal(n: number): string {
    var v = n % 100;
    if (v >= 11 && v <= 13) return String(n) + 'th';
    var last = n % 10;
    return String(n) + (last === 1 ? 'st' : (last === 2 ? 'nd' : (last === 3 ? 'rd' : 'th')));
}

// 'the 3rd of Harvest', or '' when the world has no months. AUTHOR-FACING ONLY -- it does
// not reach the model, because T-06 is about magnitudes and an ordinal is one.
function ceClockDatePhrase(cal: any, t: number): string {
    var mo = ceClockMonth(cal, t);
    if (!mo) return '';
    return 'the ' + _ceOrdinal(mo.dayOfMonth + 1) + ' of ' + mo.name;
}

// -- Storage ------------------------------------------------------------------
// Shaped after loadWorldStates: getOrDefault, coerce every field, never throw upward.

// READING NEVER WRITES. An unset clock resolves to the calendar's start and stores
// nothing -- see the header for why this differs from loadProtagonistLocation.
async function ceClockLoad(): Promise<number> {
    try {
        var raw: any = await api.v1.historyStorage.getOrDefault(STORAGE_CLOCK, null);
        if (raw && typeof raw === 'object' && isFinite(Number(raw.t))) return _ceMinsSafe(raw.t);
    } catch (e) { api.v1.error('[AE:clock] load:', e); }
    try {
        var cfg = await loadConfig();
        return _ceMinsSafe(ceCalendar(cfg).startAt);
    } catch (e2) { return 0; }
}

// The write chain. Separate from ceStateOp and ceProfileOp on purpose: the clock shares
// no record with either, and two rapid nudges from one thumb are exactly as capable of
// racing as two edits to one gauge.
var _ceClockChain: Promise<any> = Promise.resolve();
function ceClockOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceClockChain.then(fn);
    _ceClockChain = run.catch(function() { return null; });
    return run;
}

// -- THE TWO VERBS ------------------------------------------------------------

// THE ONE WRITE, AND EVERY PATH GOES THROUGH IT -- the manual nudges, the per-generation
// tick, and (when they land) the travel cost and the time stake. That is what makes the
// schedule pass one call site instead of four, and it is why this returns the value now
// in storage rather than the value it was asked for: a caller must not be told a write
// landed when it did not.
// IT HOLDS `before` AND `after`, AND THAT IS WHAT SCHEDULE RESOLUTION NEEDS. A stop fires on
// a window CROSSING (T-13), so it needs both ends of the move and this is the only place
// both are known.
// RESOLUTION RUNS AFTER THE WRITE AND OUTSIDE THE CHAIN, which is the placement stateSet's
// terminal check states for itself and for the same reason: it loads and saves entities, and
// that has nothing to do with the clock's own write. Holding the chain across it would let a
// second nudge queue behind a dozen entity saves.
// IT IS ALSO NON-FATAL. A schedule that cannot move somebody must not make the clock look
// like it failed to move -- the hour is already stored by then and reporting otherwise would
// be a lie the caller acts on.
async function ceClockSet(t: number): Promise<number> {
    var before = await ceClockLoad();
    var next = _ceMinsSafe(t);
    if (next === before) return before;
    var landed = await ceClockOp(async function() {
        try {
            await api.v1.historyStorage.set(STORAGE_CLOCK, { t: next } as ClockState);
            return next;
        } catch (e) { api.v1.error('[AE:clock] set:', e); return before; }
    });
    if (landed !== before) {
        try { await ceSchedResolve(before, landed); } catch (eS) { api.v1.error('[AE:clock] schedule:', eS); }
    }
    return landed;
}

// A DELTA, NOT A SET, and it re-reads inside the same call rather than trusting the
// caller's idea of the current time -- the difference that makes "+30 minutes" safe to
// fire from two places in one turn. stateNudge's own contract, for its own reason.
async function ceClockNudge(delta: number): Promise<number> {
    var d = Math.round(Number(delta));
    if (!isFinite(d) || d === 0) return await ceClockLoad();
    var cur = await ceClockLoad();
    return await ceClockSet(cur + d);
}


// ============================================================================
// SECTION 7d — SCHEDULES   [SEC:SCHED]
// Where somebody is when the story is not watching, and what they are doing there.
//
// ── TWO LAYERS  [T-10] ──────────────────────────────────────────────────────
// A character has PLANS (named days) and RULES (an ordered list of exceptions). AE tracked
// one day per character, so a market day meant editing the timetable twice a week by hand.
// The cost stays where it belongs: one place forever is one plan, one stop, zero rules.
//
// ── FIRST MATCH WINS, TOP DOWN  [T-11] ──────────────────────────────────────
// NOT a specificity cascade. A cascade decides by hidden precedence and the author cannot
// see why their rule lost; an ordered list shows its own answer, and the drill prints the
// rule that won beside the plan it chose. That printed line IS the audit, which is the same
// standard every receipt in this file is held to.
//
// ── A SCHEDULE IS A DEFAULT POSITION, NOT A DESTINATION  [T-12] ─────────────
// It answers "where would they be if nothing had happened to them", and something having
// happened to them is exactly "the story put them somewhere".
//
// ── CROSSING, NOT OCCUPANCY  [T-13] ─────────────────────────────────────────
// A stop asserts a position only at the TRANSITION INTO its window. Continuous
// reconciliation would teleport an NPC the author had deliberately dragged into a scene at
// the very next tick; AE patched that with "skip anyone co-present with the player", which
// is a special case rather than a rule. Firing on the edge gives a manual placement a
// natural expiry -- it survives until the next window boundary -- and it is the same rule
// stateSet's terminals already run on, one system over.
//
// ── RESOLVE TO THE DESTINATION, NEVER SIMULATE THE INTERVAL  [T-14] ─────────
// A three-day jump fires ONCE with the final answer. Walking the intermediate windows would
// move a body through four rooms nobody was looking at, to produce one visible result, and
// each of those writes is a real entity save.
//
// ── THE BODY IS AUTHORITATIVE ON CAMERA  [T-15] ─────────────────────────────
// Anyone scene-present is skipped outright. The schedule owns the off-camera world and
// nothing else; this is the one guard AE had and it is promoted from special case to rule.
//
// ── ceProfileSetLocation, NEVER A BARE parentId WRITE ───────────────────────
// See the KNOWN STALENESS note at the top of this file. A raw ceEntityWrite leaves
// CharacterMeta.currentLocationId pointing at the old room and takes two projections with
// it. This section is a new caller and would have walked straight into it.
// ============================================================================

// Absent means they keep none, which is most characters. THE ONE PLACE ABSENCE BECOMES AN
// ANSWER -- every reader below takes a resolved object or null and never re-derives this.
// [ATMO] TAKES ANY RECORD WITH A `schedule`, character or location. It never asked what it
// was reading; the parameter name is historical.
function ceSchedOf(char: any): CharSchedule | null {
    var s: any = char ? (char as any).schedule : null;
    if (!s || typeof s !== 'object') return null;
    var plans: DayPlan[] = [];
    var raw: any[] = Array.isArray(s.plans) ? s.plans : [];
    for (var i = 0; i < raw.length; i++) {
        var p: any = raw[i] || {};
        if (!p.id) continue;
        var rows: any[] = [];
        var rr: any[] = Array.isArray(p.rows) ? p.rows : [];
        for (var j = 0; j < rr.length; j++) {
            var r: any = rr[j] || {};
            rows.push({ fromHour: _ceHourSafe(r.fromHour),
                        locationId: String(r.locationId || ''),
                        doing: String(r.doing || '') });
        }
        plans.push({ id: String(p.id), name: String(p.name || 'Unnamed'), rows: rows });
    }
    if (!plans.length) return null;
    var rules: PlanRule[] = [];
    var rw: any[] = Array.isArray(s.rules) ? s.rules : [];
    for (var k = 0; k < rw.length; k++) {
        var ru: any = rw[k] || {};
        if (!ru.planId) continue;
        var w: any = ru.when || {};
        var when: any = {};
        // A FIELD IS CARRIED ONLY IF IT IS PRESENT. Coercing an absent field to 0 would turn
        // "any day" into "Sunday", which is the single worst way this could fail: the rule
        // would still fire, just on one seventh of the days it should.
        if (w.weekday !== undefined && w.weekday !== null && w.weekday !== '') when.weekday = Math.round(Number(w.weekday)) || 0;
        if (w.month !== undefined && w.month !== null && w.month !== '') when.month = Math.round(Number(w.month)) || 0;
        if (w.monthDay !== undefined && w.monthDay !== null && w.monthDay !== '') when.monthDay = Math.round(Number(w.monthDay)) || 0;
        if (w.fromDay !== undefined && w.fromDay !== null && w.fromDay !== '') when.fromDay = Math.round(Number(w.fromDay)) || 0;
        if (w.toDay !== undefined && w.toDay !== null && w.toDay !== '') when.toDay = Math.round(Number(w.toDay)) || 0;
        rules.push({ planId: String(ru.planId), when: when });
    }
    var out: CharSchedule = { enabled: s.enabled !== false, plans: plans, rules: rules };
    // [T-19] CARRIED ONLY IF IT NAMES A PLAN THAT STILL EXISTS. A pin outliving its plan
    // would otherwise beat every rule with a dangling id and resolve to nothing at all --
    // the one failure mode a pin can have, and it is cheaper to drop it here than to guard
    // it at the resolver. Deleting a plan therefore clears its pin as a side effect, which
    // is the correct behaviour and needs no code at the delete site.
    var ap = String(s.activePlanId || '');
    if (ap) {
        for (var q = 0; q < plans.length; q++) {
            if (plans[q].id === ap) { out.activePlanId = ap; break; }
        }
    }
    return out;
}

// A fresh schedule. plans[0] exists from the first moment, per the type's own rule.
function ceSchedBlank(): CharSchedule {
    return { enabled: true, rules: [],
             plans: [ { id: 'p_standing', name: 'Standing day', rows: [] } ] };
}

function ceSchedPlanById(sch: CharSchedule | null, id: string): DayPlan | null {
    if (!sch) return null;
    for (var i = 0; i < sch.plans.length; i++) { if (sch.plans[i].id === String(id)) return sch.plans[i]; }
    return null;
}

// [T-11] FIRST MATCH WINS. Returns the rule and its INDEX as well as the plan, because the
// index is what the drill prints -- "rule 2 of 3 matched" is the whole audit, and computing
// it a second time at the call site is how two answers to one question start.
function ceSchedResolvePlan(sch: CharSchedule | null, cal: any, t: number): any {
    if (!sch || !sch.plans.length) return null;
    // [T-19] THE PIN OUTRANKS EVERYTHING, and is checked before the rules rather than
    // beside them: it is not a better-matching rule, it is the author saying the calendar
    // does not decide today. `pinned` rides the result so the audit line can say WHICH of
    // the three answers it got -- pin, rule, or standing day -- which is the same standard
    // T-11 holds the rule list to. ceSchedOf has already guaranteed the id resolves.
    if (sch.activePlanId) {
        var pinned = ceSchedPlanById(sch, sch.activePlanId);
        if (pinned) return { plan: pinned, rule: null, index: -1, pinned: true };
    }
    var day = ceClockDay(t);
    var wd = ceClockWeekday(cal, t);
    var mo = ceClockMonth(cal, t);
    for (var i = 0; i < sch.rules.length; i++) {
        var ru = sch.rules[i];
        var w: any = ru.when || {};
        var ok = true;
        if (w.weekday !== undefined && w.weekday !== wd) ok = false;
        if (w.month !== undefined && (!mo || w.month !== mo.index)) ok = false;
        if (w.monthDay !== undefined && (!mo || w.monthDay !== mo.dayOfMonth)) ok = false;
        if (w.fromDay !== undefined && day < w.fromDay) ok = false;
        if (w.toDay !== undefined && day > w.toDay) ok = false;
        if (!ok) continue;
        var pl = ceSchedPlanById(sch, ru.planId);
        // A RULE POINTING AT A DELETED PLAN IS SKIPPED, NOT FATAL. Deleting a plan does not
        // hunt down its rules, so a dangling planId is an ordinary state -- and skipping it
        // lets the next rule, or the standing day, answer instead of nothing answering.
        if (pl) return { plan: pl, rule: ru, index: i };
    }
    return { plan: sch.plans[0], rule: null, index: -1 };
}

// [T-10] THE DAY AS SPANS RATHER THAN STARTS. Sorted here, never at the write. The last
// stop wraps back to cover the head of the day -- AE's one good rule, kept: somebody asleep
// from 23:00 is asleep at 01:00 without authoring a duplicate midnight row.
function ceSchedSegments(plan: DayPlan | null): any[] {
    if (!plan) return [];
    var rows = (plan.rows || []).slice().sort(function(a: any, b: any) { return a.fromHour - b.fromHour; });
    if (!rows.length) return [];
    var out: any[] = [];
    if (rows[0].fromHour > 0) {
        var last = rows[rows.length - 1];
        out.push({ from: 0, to: rows[0].fromHour, locationId: last.locationId,
                   doing: last.doing, wrapped: true });
    }
    for (var i = 0; i < rows.length; i++) {
        var to = (i + 1 < rows.length) ? rows[i + 1].fromHour : CE_HOURS_DAY;
        if (to > rows[i].fromHour) {
            out.push({ from: rows[i].fromHour, to: to, locationId: rows[i].locationId,
                       doing: rows[i].doing, wrapped: false });
        }
    }
    return out;
}

function ceSchedSegAt(segs: any[], hour: number): any {
    for (var i = 0; i < segs.length; i++) {
        if (hour >= segs[i].from && hour < segs[i].to) return segs[i];
    }
    return null;
}

// THE PROJECTION, and the one thing outside this section that should be asked. Returns the
// segment covering `t` for this character, or null for anyone off the timetable.
function ceSchedWhereIs(char: any, cal: any, t: number): any {
    var sch = ceSchedOf(char);
    if (!sch || !sch.enabled) return null;
    var res = ceSchedResolvePlan(sch, cal, t);
    if (!res) return null;
    return ceSchedSegAt(ceSchedSegments(res.plan), ceClockHour(t));
}

// [ATMO] WHAT THIS PLACE IS LIKE RIGHT NOW, and the ONLY derivation of it -- an.place
// reads through this and nothing else recomputes it. Returns '' when there is nothing to
// say, so the caller's bracket self-suppresses.
//
// THE FALLBACK IS `description`, AND IT IS WHAT MAKES THIS FREE TO UPGRADE INTO. Every
// story written before atmosphere existed has a description on its places and no schedule
// at all; without the fallback, all of them would silently lose the Author's Note line
// they have always had, and the feature would be a regression until somebody sat down and
// authored a timetable per room. With it, nothing changes until an atmosphere is written,
// and the first one written wins for its own hours only.
//
// THE SCHEDULE'S `enabled` SWITCH IS THEREFORE A REAL OFF, not a pause: turning it off
// falls back to description rather than to silence. ceSchedWhereIs already returns null for
// a disabled schedule, so that behaviour costs no branch here.
function ceAtmoFor(ent: any, cal: any, t: number): string {
    if (!ent) return '';
    try {
        var seg = ceSchedWhereIs(ent, cal, t);
        if (seg && String(seg.doing || '').trim()) return String(seg.doing).trim();
    } catch (eA) { /* a broken timetable must not cost the place its description */ }
    return String((ent as any).description || '').trim();
}

// [T-13][T-14][T-15] THE RESOLVER. Called from ceClockSet with both ends of the move.
// beforeT < 0 MAKES EVERY SEGMENT A CROSSING, which is what "Resolve now" passes -- one
// argument rather than a second function, and it is the escape hatch for any occasion the
// edge rule does not fire.
// RETURNS A COUNT so the button can say what it did. Non-fatal throughout: a schedule that
// cannot read one character must not stop it reading the rest.
async function ceSchedResolve(beforeT: number, afterT: number): Promise<number> {
    var moved = 0;
    try {
        var cfg = await loadConfig();
        var cal = ceCalendar(cfg);
        var chars: any[] = await loadAllCharacters();
        var hBefore = (beforeT < 0) ? -1 : ceClockHour(beforeT);
        var hAfter = ceClockHour(afterT);
        for (var i = 0; i < chars.length; i++) {
            var c: any = chars[i];
            if (!c || !c.id) continue;
            if (c.active === false) continue;
            if (c.isProtagonist) continue;
            // [T-15] The body is authoritative on camera.
            if (c.scenePresent) continue;
            var sch = ceSchedOf(c);
            if (!sch || !sch.enabled) continue;

            var segAfter = ceSchedSegAt(ceSchedSegments(ceSchedResolvePlan(sch, cal, afterT).plan), hAfter);
            if (!segAfter || !segAfter.locationId) continue;

            if (beforeT >= 0) {
                var resB = ceSchedResolvePlan(sch, cal, beforeT);
                var segBefore = ceSchedSegAt(ceSchedSegments(resB.plan), hBefore);
                // NOT A CROSSING IF THE SAME WINDOW STILL COVERS THEM. Compared on the
                // SEGMENT's own start hour and destination rather than on identity: the plan
                // may have changed underneath (a rule took) while the answer did not, and a
                // move nobody would notice is a write nobody should pay for.
                if (segBefore && segBefore.from === segAfter.from
                    && String(segBefore.locationId) === String(segAfter.locationId)) continue;
            }

            // Already there. The commonest case by far once a day settles, and it is checked
            // against the BODY rather than against a cached meta for the reason the staleness
            // note gives.
            var here = '';
            try {
                var body: any = await loadEntity(String(c.entityId || c.id));
                here = String((body && body.parentId) || '');
            } catch (eB) { here = ''; }
            if (here === String(segAfter.locationId)) continue;

            try {
                await ceProfileSetLocation(String(c.id), String(segAfter.locationId));
                moved++;
            } catch (eM) { api.v1.error('[AE:sched] move failed for ' + String(c.name || c.id), eM); }
        }
    } catch (e) { api.v1.error('[AE:sched] resolve:', e); }
    return moved;
}

async function ceSchedResolveNow(): Promise<number> {
    var t = await ceClockLoad();
    return await ceSchedResolve(-1, t);
}

// [T-11] The rule, in words, for the editor and the audit line. Reads the calendar so a
// weekday is a name and a month is a name -- the stored numbers are never shown.
function ceSchedRuleLabel(cal: any, rule: PlanRule): string {
    var w: any = (rule && rule.when) || {};
    var bits: string[] = [];
    var names: string[] = (cal && cal.dayNames) || [];
    var months: any[] = (cal && cal.months) || [];
    if (w.weekday !== undefined) {
        bits.push('every ' + (names[w.weekday] || ('day ' + String(w.weekday + 1))));
    }
    if (w.monthDay !== undefined) {
        bits.push('on the ' + _ceOrdinal(w.monthDay + 1));
    }
    if (w.month !== undefined) {
        bits.push('in ' + ((months[w.month] && months[w.month].name) || ('month ' + String(w.month + 1))));
    }
    if (w.fromDay !== undefined || w.toDay !== undefined) {
        bits.push('days ' + String((w.fromDay !== undefined ? w.fromDay : 0) + 1)
                  + '\u2013' + String((w.toDay !== undefined ? w.toDay : 0) + 1));
    }
    // AN EMPTY `when` IS "every day", and saying so out loud is the point: it is the one
    // rule shape that makes every rule below it dead, and an author needs to see that.
    if (!bits.length) return 'every day \u2014 nothing below this can ever match';
    return bits.join(', ');
}


// ============================================================================
// SECTION 8 — STORAGE: PARTY STATE, NPC WEB, QUICK ACTION PRESETS
// Three independent storyStorage records that don't fit in the character or
// entity systems but are story-persistent.
// ============================================================================


// ── NPC Web ───────────────────────────────────────────────────────────────────
// The bilateral dynamic relationship graph between NPCs (WebLink[]).
// Stored as a JSON string because it can grow large and benefits from direct
// string serialization rather than NAI's object storage path.

async function loadNpcWeb(): Promise<WebLink[]> {
    // [WEB-FLATTEN] Saved links from before the flattening still carry a
    // `priority` number. Nothing reads it, but it is stripped on load so the next
    // saveNpcWeb (or world-pack export) stops carrying a dead field forever.
    const raw = await api.v1.storyStorage.get(STORAGE_NPC_WEB) as string;
    try {
        let webParsed = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(webParsed)) return [];
        for (let wStrip of webParsed) { if (wStrip) delete wStrip.priority; }
        return webParsed as WebLink[];
    } catch (eWebLoad) { return []; }
}

async function saveNpcWeb(web: WebLink[]): Promise<void> {
    await api.v1.storyStorage.set(STORAGE_NPC_WEB, JSON.stringify(web));
}

// ============================================================================
// SECTION 9 — STORAGE: IMAGE SETTINGS
// Image generation presets and global image settings.
// Stored in api.v1.storage (global, not story-bound) so they persist across
// stories without being part of the adventure module export.
// ============================================================================

// [IMG-MODEL] THE MODEL VOCABULARY, AND IT IS ONE TABLE. The id is what crosses to the
// bridge and reaches NAI; the label is what the author reads. Kept here rather than beside
// the Presets surface that renders it because three things read it and only one of them is
// a surface: the select, the write validator, and the default below. [RATIO-COLLISION] is
// the standing warning against a second table of the same facts under a second name.
// ORDERED NEWEST-FIRST WITHIN EACH LINE, Full before Curated, because Full is what every
// existing config is already on and what an author picking a model almost always wants.
var CE_IMG_MODELS: any[] = [
    { id: 'nai-diffusion-5-full',      label: 'V5 Full' },
    { id: 'nai-diffusion-5-curated',   label: 'V5 Curated' },
    { id: 'nai-diffusion-4-5-full',    label: 'V4.5 Full' },
    { id: 'nai-diffusion-4-5-curated', label: 'V4.5 Curated' }
];

// V4.5 FULL, NOT V5, AND DELIBERATELY. This is what the bridge hard-coded before this
// setting existed, so an upgrade changes nothing until the author picks something -- a
// model swap alters the look of every image a story has been generating, which is not a
// thing to do to somebody on their behalf while they are not looking.
var CE_IMG_MODEL_DEFAULT = 'nai-diffusion-4-5-full';

// The value every generation payload stamps. A helper rather than six reads of the field
// because the fallback is part of the answer and six copies of a fallback is six places to
// get it wrong -- the same argument _ceImgSeed is a function for.
function ceImgModel(): string {
    return String(globalSettings.imageModel || CE_IMG_MODEL_DEFAULT);
}

// Is this id one this build knows? The select is the ONLY writer, so this can only fail on
// a malformed bridge message or a downgrade -- and the cost of letting an unknown id
// through is every generation failing with a bare API 400 and nothing on screen saying why.
function ceImgModelKnown(id: string): boolean {
    for (var i = 0; i < CE_IMG_MODELS.length; i++) {
        if (String(CE_IMG_MODELS[i].id) === String(id)) return true;
    }
    return false;
}

async function loadImageSettings(): Promise<void> {
    // [IMGFIELDS] No preset migration — starts empty on a fresh install
    // (user's explicit call), replacing the old 5-slot generateDefaultPresets().

    const sf = await api.v1.storage.get(STORAGE_KEY_PROMPT_FIELDS);
    imagePromptFields = Array.isArray(sf) ? sf : [];

    const sg = await api.v1.storage.get(STORAGE_KEY_GLOBAL);
    if (sg) globalSettings = Object.assign({}, globalSettings, sg);

    // Guard every globalSettings field so partial saves from older versions work
    if (globalSettings.contextSize        === undefined) globalSettings.contextSize        = DEFAULT_CTX;
    if (!globalSettings.architectPrompt)                  globalSettings.architectPrompt   = DEFAULT_ARCH;
    if (globalSettings.architectAutoSnap   === undefined) globalSettings.architectAutoSnap   = true;
    if (globalSettings.autoDownload        === undefined) globalSettings.autoDownload        = false;
    // [STORYIMG-DEFAULT-ON] Seed flipped to true -- see the DEFAULT_GLOBAL_SETTINGS
    // note. A NEW config gets true from the line below and needs nothing else.
    if (globalSettings.studioPlaceInStory  === undefined) globalSettings.studioPlaceInStory  = true;
    // AN EXISTING CONFIG NEEDS A ONE-SHOT RE-SEED, and this is the one migration in this
    // file that deliberately overwrites a stored value. THE JUSTIFICATION IS NARROW: every
    // config written between earlier and now carries `false` because the line above PUT it
    // there, not because anyone chose it -- the toggle defaulted off and its only visible
    // effect was the generation indicator, so nobody had a reason to find it. Re-seeding
    // once restores the intended default to configs that were opted out by a default.
    // GUARDED BY ITS OWN FLAG so it can only ever run once: a user who turns it back off
    // after this keeps that choice forever. This is the KIND-BACKFILL lesson applied in the
    // other direction -- a shape change that needs a backfill line, written at the same
    // time as the change rather than discovered eighteen versions later.
    if (!globalSettings.studioPlaceReseeded) {
        globalSettings.studioPlaceInStory = true;
        globalSettings.studioPlaceReseeded = true;
    }
    if (globalSettings.defaultWidth        === undefined) globalSettings.defaultWidth        = 832;
    if (globalSettings.defaultHeight       === undefined) globalSettings.defaultHeight       = 1216;
    if (globalSettings.defaultScale        === undefined) globalSettings.defaultScale        = 5.0;
    if (globalSettings.defaultSteps        === undefined) globalSettings.defaultSteps        = 28;
    // [IMG-MODEL] KIND-BACKFILL. A stored id this build does not recognise is reset rather
    // than kept: it can only have come from a newer build, and a config that survives a
    // downgrade by failing every generation is worse than one that quietly falls back.
    if (!globalSettings.imageModel || !ceImgModelKnown(globalSettings.imageModel)) {
        globalSettings.imageModel = CE_IMG_MODEL_DEFAULT;
    }
}

async function saveImageSettings(): Promise<void> {
    await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, imagePromptFields);
    await api.v1.storage.set(STORAGE_KEY_GLOBAL,        globalSettings);
}

// [IMGPRESET-JSX] THE ONE IMPLEMENTATION of every image-field mutation, lifted
// verbatim out of the AE_IMG_FIELD_ACTION case so the bridge message and the jsx Images
// surface cannot drift into two different rule sets. Both callers now do exactly
// `applyImgFieldOp(op, payload)` then `await saveImageSettings()`.
// SEMANTICS ARE UNCHANGED FROM earlier -- same six ops, same clamps, same defaults,
// same silent-ignore on an unknown id. The only thing that moved is where it lives.
// Returns false ONLY for an unrecognised op, so a caller can log it; every recognised op
// returns true even when it matched no field, because "update a field that is gone" is a
// stale-UI race, not a programming error, and the old inline version ignored it too.
function applyImgFieldOp(op: string, payload: any): boolean {
    var ifaOp = String(op || '');
    if (ifaOp === 'add') {
        imagePromptFields.push({
            id: generateId(),
            name: String(payload.name || 'New Field'),
            basePrompt: String(payload.basePrompt || ''),
            uc: String(payload.uc || ''),
            weight: 1,
            active: false
        });
    } else if (ifaOp === 'update') {
        var fU = imagePromptFields.find(function(x) { return x.id === payload.id; });
        if (fU) {
            if (payload.name       !== undefined) fU.name       = String(payload.name);
            if (payload.basePrompt !== undefined) fU.basePrompt = String(payload.basePrompt);
            if (payload.uc         !== undefined) fU.uc         = String(payload.uc);
            if (payload.weight     !== undefined) fU.weight     = Math.max(0.1, Math.min(10, Number(payload.weight) || 1));
        }
    } else if (ifaOp === 'toggle') {
        var fT = imagePromptFields.find(function(x) { return x.id === payload.id; });
        if (fT) fT.active = !fT.active;
    } else if (ifaOp === 'delete') {
        imagePromptFields = imagePromptFields.filter(function(x) { return x.id !== payload.id; });
    } else if (ifaOp === 'reorder' && Array.isArray(payload.orderedIds)) {
        var byId: { [k: string]: ImagePromptField } = {};
        imagePromptFields.forEach(function(f) { byId[f.id] = f; });
        imagePromptFields = payload.orderedIds.map(function(oid: string) { return byId[oid]; }).filter(Boolean);
    } else if (ifaOp === 'setDefaults') {
        if (payload.width  !== undefined) globalSettings.defaultWidth  = Number(payload.width)  || globalSettings.defaultWidth;
        if (payload.height !== undefined) globalSettings.defaultHeight = Number(payload.height) || globalSettings.defaultHeight;
        if (payload.scale  !== undefined) globalSettings.defaultScale  = Number(payload.scale)  || globalSettings.defaultScale;
        if (payload.steps  !== undefined) globalSettings.defaultSteps  = Number(payload.steps)  || globalSettings.defaultSteps;
        // [IMG-MODEL] VALIDATED, and an unknown id is IGNORED rather than stored. Same
        // silent-ignore rule the ops above this one already apply to a missing field id: a
        // stale UI is a race, not a programming error, and the surface repaints from the
        // stored value either way so the author sees the rejection as the option not moving.
        if (payload.model !== undefined && ceImgModelKnown(String(payload.model))) {
            globalSettings.imageModel = String(payload.model);
        }
    } else {
        return false;
    }
    return true;
}

// [IMGFIELDS] Compiles every currently-ACTIVE field into the final
// quality/negative prompt strings. A field's weight only wraps its contribution
// in NAI's N::text:: syntax when weight != 1 (unweighted fields stay plain text,
// keeping the compiled result readable). Same compiled pair feeds every
// generation path (Auto-Snap, manual Director's Cut, Snapshot) — there's no
// per-generation selection step; "active" is a standing toggle per field.
function _compileImageFieldsWhere(pred: (f: ImagePromptField) => boolean): { quality: string; negative: string } {
    const qualityParts: string[] = [];
    const negativeParts: string[] = [];
    for (const f of (imagePromptFields || [])) {
        if (!pred(f)) continue;
        const w = (typeof f.weight === 'number' && f.weight > 0) ? Math.max(0.1, Math.min(10, f.weight)) : 1;
        const bp = (f.basePrompt || '').trim();
        const uc = (f.uc || '').trim();
        if (bp) qualityParts.push(w !== 1 ? (w + '::' + bp + '::') : bp);
        if (uc) negativeParts.push(w !== 1 ? (w + '::' + uc + '::') : uc);
    }
    return { quality: qualityParts.join(', '), negative: negativeParts.join(', ') };
}
function compileActiveImageFields(): { quality: string; negative: string } {
    return _compileImageFieldsWhere(function(f) { return !!f.active; });
}
// [CEGAL-FIELDSEL] Same compile, different predicate: membership in an explicit
// id list rather than the standing `.active` flag. Used ONLY for a one-off Studio render
// override (submitDirectorPhoto's fieldIds param) -- it never reads or writes `.active`,
// so it cannot desync the Presets tab's own toggle state.
function compileImageFieldsSubset(ids: string[]): { quality: string; negative: string } {
    const idSet: { [k: string]: boolean } = {};
    for (const id of ids) { idSet[id] = true; }
    return _compileImageFieldsWhere(function(f) { return !!idSet[f.id]; });
}

// ============================================================================
// SECTION 9b — PER-CHARACTER IMAGE SLOTS  [IMG-SLOTS]
// Which image slots a character has (Avatar + Snapshot + 24 canonical emotions, plus
// any custom names added) and the per-slot tag TEXT OVERRIDE for each. This is the
// engine-side replacement for the bridge's ae_emo_slots_<charId> / ae_emo_tags_<charId>
// localStorage pair — ownership moved here because the Images drill (SECTION 30) is now
// where a person edits this, and per-user decision this landed WITHOUT a migration path:
// existing bridge-side per-character overrides reset to default on first engine read.
// The bridge's own copies (_getEmoSlots/_setEmoSlots/_getEmoTags/_setEmoTags/
// _AE_EMOTION_TAGS) are [DEAD] as of bridge earlier — not deleted, per the one-sweep rule.
//
// IMAGE BYTES ARE STILL NEVER HERE. This section is text only (which slots exist, what
// tag each carries) — the pixels stay bridge-side IndexedDB, unchanged from CE-IMG-ATTR.
//
// SOFT-PIN SEMANTICS ARE DELIBERATELY PRESERVED, per user, not simplified: Avatar can
// never be removed (no delete affordance at all — same as the bridge always enforced).
// Snapshot and any custom slot, once deleted, stay gone. The 24 canonical emotion words
// are SOFT-PINNED exactly like the bridge's own _getEmoSlots merge: deleting one removes
// its entry from the list (and its stored image, via the delete action), but the next
// time this state loads, every canonical word missing from the list is silently
// re-appended. This is a faithful port of existing behaviour, not a new design — the
// bridge has shipped it since EMOSTUDIO-24DEFAULT and nothing about moving the storage
// home should also change what it does.
// [SCENE-STAGE] `Standee` JOINS THAT SOFT-PIN SET and is its first member that is not an
// emotion word. It is soft-pinned rather than hard-pinned like Avatar because the stage is
// derived from the SLOT EXISTING: a character the author had deleted it from would leave
// the stage with no error and no clue why, and the next load quietly putting it back is a
// better failure than that. It is inserted directly after Avatar so its position in the
// drill is the same for a character made before this shipped and one made after.
// ============================================================================

// [IMG-SEED] `seeds` is the seed each slot was last RENDERED with, written at
// dispatch. Additive and unmigrated: absent means "no image generated since this shipped",
// which is exactly what the surface should show for one.
interface CharImageSlotState { slots: string[]; tags: Record<string, string>; seeds?: Record<string, number>; }

// [IMG-DEFAULT-TAGS] Canonical default tag text per slot, ported from the
// bridge's _AE_EMOTION_TAGS for the 24 emotion words and extended once since, for Standee.
// This is STATIC REFERENCE CONTENT, not mutable per-character
// state, so duplicating it here is the same category of duplication as ALL_EMOTIONS_LIST
// itself already is (declared on both sides on purpose) — not the MIRROR pattern CE-IMG-OPTS
// warns against, which is specifically about one side trying to track the OTHER side's
// live, per-character, frequently-changing state. A default tag string changes only when
// someone edits this table by hand.
var CE_IMG_DEFAULT_TAGS: Record<string, string> = {
    // [SCENE-STAGE] THE ONE ENTRY THAT IS NOT AN EMOTION WORD, and the only part of the
    // stage that touches generation at all. A standee is useless to the stage without a
    // transparent background, so the slot that exists to be composited carries the prompt
    // that makes compositing possible rather than making every author rediscover it.
    // THE WEIGHT IS THE SHAPE THAT WAS MEASURED WORKING ON V5, not a guess: 2.1:: :: rather
    // than a bare phrase. It is a DEFAULT, so charImgEffectiveTag hands a stored override
    // straight through and an author who wants something else edits the slot's tag once.
    // CANVAS SHAPE IS NOT SET HERE AND DELIBERATELY NOT: ceImgSlotGenerate sends the
    // character's own avatarWidth/avatarHeight, so a full-length frame is the author's to
    // choose on the character, the same place every other slot's shape already comes from.
    // [SCENE-STAGE-ROW] `facing right` IS PART OF THE CONTRACT, not decoration. The stage
    // mirrors whoever ends up past the middle, and it can only do that if the art has a known
    // direction. Right is the default because it is the default of the stageFacing setting;
    // change one and change the other.
    Standee: 'full body, standing, full length, feet visible, facing right, 2.1::transparent background::',
    neutral: 'neutral expression, calm, composed', happy: 'happy, bright smile, cheerful',
    sad: 'sad expression, downcast eyes, melancholy', angry: 'angry expression, furrowed brows, glaring',
    surprised: 'surprised, wide eyes, mouth slightly open', embarrassed: 'embarrassed, blushing cheeks, flustered',
    shy: 'shy, looking away bashfully', disgusted: 'disgusted expression, grimacing',
    laughing: 'laughing, big smile, eyes crinkled', tired: 'tired, heavy half-lidded eyes, exhausted',
    excited: 'excited, bright sparkling eyes, energetic', nervous: 'nervous, anxious, tense expression',
    confused: 'confused, head tilted, puzzled look', worried: 'worried, frowning slightly, concerned',
    scared: 'scared, wide fearful eyes, trembling', love: 'loving expression, soft smile, warm adoring eyes',
    smug: 'smug, self-satisfied smirk', bored: 'bored, disinterested, deadpan',
    irritated: 'irritated, annoyed, exasperated', determined: 'determined, focused, resolute',
    playful: 'playful, mischievous smile', hurt: 'hurt, pained emotional expression',
    aroused: 'flushed cheeks, heated gaze', thinking: 'thinking, finger to chin, contemplative'
};

// Load-modify-persist, same shape as loadCharJournal/saveCharJournal (SECTION 10c). The
// merge (ensure Avatar, ensure Standee, ensure every canonical word) runs on EVERY read,
// not just first creation — that is what makes the soft-pin behaviour work: a word
// removed by a delete
// action is simply absent from storage until the next load re-adds it.
async function loadCharImgSlots(charId: string): Promise<CharImageSlotState> {
    var out: CharImageSlotState = { slots: [], tags: {} };
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_IMG_PFX + charId, null);
        if (raw && typeof raw === 'object' && Array.isArray(raw.slots)) {
            out.slots = raw.slots.filter(Boolean).map(String);
            out.tags = (raw.tags && typeof raw.tags === 'object') ? raw.tags : {};
            out.seeds = (raw.seeds && typeof raw.seeds === 'object') ? raw.seeds : {};
        } else {
            out.slots = [CE_IMG_SLOT_AVATAR, CE_IMG_SLOT_STANDEE, 'Snapshot'].concat(CE_IMG_EMOTION_SLOTS);
        }
    } catch (e) { api.v1.error('[AE:imgslots] loadCharImgSlots:', e); out.slots = [CE_IMG_SLOT_AVATAR, CE_IMG_SLOT_STANDEE, 'Snapshot'].concat(CE_IMG_EMOTION_SLOTS); }

    var changed = false;
    if (out.slots.indexOf(CE_IMG_SLOT_AVATAR) === -1) { out.slots = [CE_IMG_SLOT_AVATAR].concat(out.slots); changed = true; }
    // [KIND-BACKFILL] A CHARACTER THAT ALREADY HAS A STORED `slots` ARRAY NEVER GROWS A NEW
    // NAME ON ITS OWN, so the fresh-install list above reaches new characters only. Spliced
    // after Avatar (guaranteed present by the line above) rather than pushed, so the drill
    // shows it in the same place for every character regardless of when it was made.
    if (out.slots.indexOf(CE_IMG_SLOT_STANDEE) === -1) {
        out.slots.splice(out.slots.indexOf(CE_IMG_SLOT_AVATAR) + 1, 0, CE_IMG_SLOT_STANDEE);
        changed = true;
    }
    for (var i = 0; i < CE_IMG_EMOTION_SLOTS.length; i++) {
        if (out.slots.indexOf(CE_IMG_EMOTION_SLOTS[i]) === -1) { out.slots.push(CE_IMG_EMOTION_SLOTS[i]); changed = true; }
    }
    if (changed) { try { await saveCharImgSlots(charId, out); } catch (e2) { api.v1.error('[AE:imgslots] merge-save failed:', e2); } }
    return out;
}

async function saveCharImgSlots(charId: string, state: CharImageSlotState): Promise<void> {
    try {
        // [v3.0.54 IMG-SEED-DROP] `seeds` WAS BEING DISCARDED HERE, which is why no slot
        // ever showed one. charImgSetSeed loaded the state, wrote the number and handed the
        // object to this function, which then persisted a literal built from two of the
        // three fields -- so every seed round-tripped to nothing and the `seed > 0` branch
        // on the slot card was unreachable in every build since IMG-SEED landed. The
        // interface, the reader and the writer were all correct; only the persist was not.
        await api.v1.storyStorage.set(STORAGE_CHAR_IMG_PFX + charId,
            { slots: state.slots || [], tags: state.tags || {}, seeds: state.seeds || {} });
    } catch (e) { api.v1.error('[AE:imgslots] saveCharImgSlots:', e); }
}

// Effective tag for a slot: a stored override wins, else the canonical default, else empty
// (a custom slot has no default — there is nothing to fall back to).
function charImgEffectiveTag(state: CharImageSlotState, slot: string): string {
    var t = (state.tags || {})[slot];
    if (t !== undefined && t !== null) return String(t);
    return CE_IMG_DEFAULT_TAGS[slot] || '';
}

async function charImgSetTag(charId: string, slot: string, tag: string): Promise<CharImageSlotState> {
    var state = await loadCharImgSlots(charId);
    state.tags = state.tags || {};
    state.tags[slot] = String(tag || '');
    await saveCharImgSlots(charId, state);
    return state;
}

// [IMG-SEED] Written by ceImgSlotGenerate at dispatch, not on arrival: the engine
// is what chose the number, and waiting for the bridge would mean a failed render left the
// slot claiming a seed it never used.
async function charImgSetSeed(charId: string, slot: string, seed: number): Promise<void> {
    var state = await loadCharImgSlots(charId);
    state.seeds = state.seeds || {};
    state.seeds[slot] = Number(seed) || 0;
    await saveCharImgSlots(charId, state);
}

async function charImgAddSlot(charId: string, name: string): Promise<CharImageSlotState> {
    var n = String(name || '').trim();
    var state = await loadCharImgSlots(charId);
    if (n && state.slots.indexOf(n) === -1) {
        state.slots.push(n);
        await saveCharImgSlots(charId, state);
    }
    return state;
}

// Removes a slot from the list (and its tag override, if any). Does NOT touch the stored
// image — that is bridge-side and this file has no path to it; the drill's Delete action
// sends a separate AE_CHAR_IMAGE_ACTION so the bridge can drop the actual bytes. Avatar is
// refused here as a second guard even though the drill never offers Delete for it.
async function charImgRemoveSlot(charId: string, name: string): Promise<CharImageSlotState> {
    var n = String(name || '').trim();
    var state = await loadCharImgSlots(charId);
    if (n && n !== CE_IMG_SLOT_AVATAR) {
        state.slots = state.slots.filter(function(s: string) { return s !== n; });
        if (state.tags) { delete state.tags[n]; }
        await saveCharImgSlots(charId, state);
    }
    return state;
}

// ============================================================================
// SECTION 10 — LOREBOOK HELPERS
// Functions that build, create, and sync NAI lorebook entries for characters,
// factions, and species. Lorebook entries are how static character profiles
// get injected into context via NAI's native keyword-matching system.
//
// PATTERN NOTE: All three record types (character, faction, species) share an
// identical four-function family: getKeys / buildContent / createLinked / sync.
// This is a future candidate for a generalized syncLorebookRecord<T>(spec) helper
// once the refactor stabilizes. Not changing now — the calls are simple enough
// that the abstraction would add indirection without immediate benefit.
// ============================================================================

// ── Character Lorebook ────────────────────────────────────────────────────────

function getLorebookKeys(char: CharacterRecord): string[] {
    // Returns the name + all nicknames as lorebook trigger keys.
    return [char.name, ...char.nicknames.filter(Boolean)].filter(Boolean);
}

// [CC-AETHER] `aether` is an OUTPUT STYLE, not a second builder. CharChat needs this
// record under AetherRoom's field names (Gender/Species/Personality/Appearance/Voice, one
// per line) because that is the shape xialong reads as a character card; every other
// caller needs the collapsed dossier header and CE's own configurable labels. A second
// projection of the same record would drift from this one the first time a field was
// added -- which is the whole reason the CharChat card no longer derives its own.
// The STORED lorebook entry is unaffected: nothing passes 'aether' except the chat.
async function buildLorebookContent(char: CharacterRecord, style?: string): Promise<string> {
    // Assembles the lorebook entry text from a character's static fields.
    // showFieldHeaders controls whether field labels are prepended.
    // This is the single authoritative builder — used by both create and sync.
    const cfg = await loadConfig();
    const aether = (style === 'aether');
    const showHeaders = aether ? true : cfg.showFieldHeaders;
    const lines: string[] = [];

    function addField(label: string, value: string | undefined | null) {
        if (!value || value.trim() === '') return;
        lines.push(showHeaders ? `${label}: ${value.trim()}` : value.trim());
    }

    // [earlier] Identity line — collapsed from five separate Name/Age/Species/
    // Gender/Role fields into a single dossier header, e.g. "Gareth — human male,
    // 34, blacksmith". Header-agnostic by design (it reads as a header itself).
    // [PASS-B DECEASED] Death is `active === false` plus a Graveyard body -- there is no
    // deceased flag and there should not be one. The entry survives because the dead are
    // still spoken of; what cannot survive is the present tense. This leads so the model
    // reads it before the description it qualifies.
    if (char.active === false) lines.push('(Deceased. Everything below describes them as they were in life.)');

    if (aether) {
        // One field per line, AetherRoom's names. The NAME is deliberately absent: the card
        // has already written it as the block's own header, which is where AetherRoom puts
        // it, and repeating it here is the duplication this style exists to remove.
        addField('Gender', char.gender);
        addField('Age', char.age);
        addField('Species', char.species);
        addField('Role', char.occupationRole);
        addField('Appearance', char.physicalDescription);
        addField('Personality', char.personalityCore);
        addField('Voice', char.voiceAndMannerisms);
        addField('Background', char.background);
    } else {
        let idLeader = [char.species, char.gender].map(function(s) { return (s || '').trim(); }).filter(Boolean).join(' ');
        let idMid = [idLeader, (char.age || '').trim(), (char.occupationRole || '').trim()].filter(Boolean).join(', ');
        let identityLine = (char.name || '').trim();
        if (identityLine && idMid) identityLine += ' \u2014 ' + idMid;
        else if (!identityLine && idMid) identityLine = idMid;
        if (identityLine) lines.push(identityLine);

        // Core static fields — label keys are customisable via cfg.fieldLabels
        addField(cfg.fieldLabels['physicalDescription'] || 'Physical Description', char.physicalDescription);
        addField(cfg.fieldLabels['personalityCore']     || 'Personality Core',     char.personalityCore);
        addField(cfg.fieldLabels['voiceAndMannerisms']  || 'Voice & Mannerisms',   char.voiceAndMannerisms);
        addField(cfg.fieldLabels['background']          || 'Background',           char.background);
    }

    // Core values
    if (char.coreValues && char.coreValues.length > 0) {
        addField('Core Values', char.coreValues.filter(Boolean).join(', '));
    }

    // Slots, facets, and author-defined custom static fields.
    // [FIELD-GROUPING] Emitted in slot-group order so each facet sits under the
    // slot it deepens instead of in a block after every slot. Ordering ONLY \u2014 no group
    // headings are inserted: this string is injected context, and adding six heading lines
    // would spend tokens on every build to restate what the field labels already say.
    if (cfg.customStaticFields && char.customFieldValues) {
        for (const cf of ceOrderStaticFields(cfg.customStaticFields)) {
            addField(cf.label, char.customFieldValues[cf.id]);
        }
    }

    // [LOREFOLD] Equipment (and the rest of the dynamic layer) is NOT in this
    // static builder. buildCharDynamicBlock() produces it fresh each generation and
    // buildSceneLorebookActivation() appends it onto this entry's content per-build, so
    // the STORED entry stays static identity (equip/unequip triggers no lorebook re-sync).
    return lines.join('\n');
}

// [CONDITIONS] ── Dynamic Lorebook (narrative prose, NOT the wiki-style
// dossier above) ──────────────────────────────────────────────────────────────
// Deliberately a separate builder from buildLorebookContent: that one is static
// identity (labeled fields, content-stable, cache-friendly); this one is dynamic
// state (conditions today), rebuilt fresh every generation like equipment, and
// reads as prose rather than a field list per user's explicit call.

// [F-10] THE FULL REACH OF STATE, so nobody mistakes narrow for unfinished. A state is a
// standing fact about a character -- an illness, a wound, a debt, a standing with a faction --
// that persists across turns and will not reliably be restated in prose, which is exactly why
// it cannot be inferred from the story window. FOUR READERS, all through this builder: the
// story turn (lorebook dynamic block), CharChat, the thought generator and the hook generator.
// The last two were added in PASS-D; before that a character's own thoughts could not see her
// own illness, and that stays fixed here.
//
// [D-30] THE LOREBOOK, NOT THE AUTHOR'S NOTE. State is a fact ABOUT a character and belongs in
// that character's entry beside the fields it qualifies. The AN slot the queue originally
// named would have been scene-present-only, which would have blinded three of the four readers
// above -- the generators run per character, not per scene.
//
// [D-21/D-22] WHAT REACHES HERE IS ALREADY DECIDED. ceStateLinesForChar drops any def with no
// bands and any value sitting at rest, so this builder does no filtering of its own and there
// is no second place for the injection rule to be stated differently.
// One line per speaking state (not combined into one sentence). Returns '' when nothing
// speaks, so callers can skip an empty append.
async function buildDynamicLorebookContent(char: CharacterRecord, cfg: GlobalConfig): Promise<string> {
    return ceStateLinesForChar(cfg, char).join('\n');
}

// [LOREFOLD] Composite dynamic block folded into a character's lorebook entry:
// equipment + conditions + relationship + mid-range. Each line is gated by
// cfg.lorebookFields and rendered as prose via cfg.lorebookTemplates. Returns '' when
// nothing is enabled/populated so callers can skip an empty append. Rebuilt fresh every
// generation (state, not identity) — same cadence the old ae_equip_/ae_dynamic_ temp
// entries had, just consolidated into one entry so ordering is deterministic.
// [F-5][WEB-FLATTEN, REVISED] ONE CHARACTER'S READING OF ANOTHER, as a line.
// THIS MOVED OUT OF THE AUTHOR'S NOTE AND INTO THE CHARACTER FOLD, which reverses the
// original WEB-FLATTEN placement -- so here is why that is safe now and was not then.
// The objection was that a Position is a TWO-PARTY fact while a lorebook entry activates on
// ONE party's keys, so folding it flattens a relationship into a one-sided assertion made
// in a scene the other party may not even be in.
//   WHAT CHANGED IS NOT THE OBJECTION, IT IS WHERE THE GATE SITS. `position` has always had
//   exactly one OWNER -- the record it is stored on -- so it is a one-party-owned fact about
//   a pair, and the both-parties-present test that used to guard the AN row guards the fold
//   instead. The line cannot appear in a scene its subject is absent from, which was the
//   whole of the original risk.
//   THE ASYMMETRY IS STILL THE FEATURE. Two characters positioned on each other produce two
//   lines, in two entries, and they are allowed to disagree.
// RETURNS '' FOR EVERY ABSENT CASE, so the caller has one branch and not five.
async function _ceCharPositionLine(char: any, cfg: GlobalConfig, charIndex: any[]): Promise<string> {
    try {
        const wpPos: any = (char as any).position;
        const wpTid = wpPos ? String(wpPos.targetId || '') : '';
        if (!wpPos || !wpTid || !(wpPos.shape || wpPos.standing)) return '';
        // '__player__' is always present by definition -- the protagonist is who the scene is
        // being written for and is deliberately excluded from the index's present set -- so
        // it short-circuits rather than failing the lookup.
        const wpTgtHere = ceIsProtagonistRef(wpTid)
            || (charIndex || []).some(function(m: any) { return m && m.id === wpTid && m.active && m.scenePresent; });
        if (!wpTgtHere) return '';
        const wpTier = await _ceReadPressure(String(char.id), 'position_' + wpTid);
        // Stored name first (it is what the author typed or picked), index name only as a
        // fallback for a record whose targetName was cleared but whose targetId survived.
        let wpName = ceIsProtagonistRef(wpTid)
            ? String(cfg.protagonistName || 'the protagonist')
            : String(wpPos.targetName || '');
        if (!wpName) {
            const wpMeta = (charIndex || []).find(function(m: any) { return m && m.id === wpTid; });
            wpName = wpMeta ? String((wpMeta as any).name || '') : '';
        }
        if (!wpName) return '';
        return parseMacroTemplate((cfg.contextTemplates as any).position || '', {
            name: String(char.name || ''),
            targetName: wpName,
            positionShape: String(wpPos.shape || ''),
            positionStanding: String(wpPos.standing || ''),
            positionPressure: _ceFramePosition(wpTier)
        }).trim();
    } catch (ePos) { api.v1.error('[AE:context] position line:', ePos); return ''; }
}

async function buildCharDynamicBlock(char: CharacterRecord, cfg: GlobalConfig): Promise<string> {
    const lines: string[] = [];
    const tpl = cfg.lorebookTemplates || ({} as LorebookTemplates);
    const inc = cfg.lorebookFields || ({} as LorebookFieldToggles);
    const data = Object.assign({}, char);

    // Equipment — resolve each worn item to "name (detail)".
    if (inc.equipment && char.equippedItemIds && char.equippedItemIds.length > 0) {
        const worn: string[] = [];
        for (const itemId of char.equippedItemIds) {
            try {
                const item = await loadEntity(itemId);
                if (!item) continue;
                // [ENT-AUDIT] The atmosphere fallback is gone. An item's atmosphere
                // standing in as its description was one of that field's two accidental jobs.
                const detail = (item.description || '').trim();
                worn.push(detail ? (item.name + ' (' + detail + ')') : item.name);
            } catch (eItem) { /* non-fatal: skip unreadable item */ }
        }
        if (worn.length > 0) {
            const line = parseMacroTemplate(tpl.equipment, Object.assign({}, data, { equipList: worn.join(', ') })).trim();
            if (line) lines.push(line);
        }
    }

    // [F-10] States — one line per speaking state (reuses the existing builder).
    // Still gated by lorebookFields.conditions, whose KEY IS NOT RENAMED on purpose: it is a
    // persisted toggle in every existing save, and renaming it would silently re-enable the
    // channel for anyone who had turned it off. The label the author sees is "States".
    if (inc.conditions) {
        const condBlock = await buildDynamicLorebookContent(char, cfg);
        if (condBlock.trim()) lines.push(condBlock.trim());
    }

    // [MIDRANGE-RETIRE] The goal / socialMask / shiftedView fold lived here.
    // [POSITION] So did the three relationship lines, and Position did NOT take
    // the slot back. It is a two-party statement, and this block runs whenever its owner
    // is scene-present regardless of where the other party is — which would have injected
    // one character's private reading of someone who is not in the scene. Position is
    // therefore an Author's-Note line under a both-parties-present gate, exactly like
    // npcWeb (see _ceSceneLines). The per-character FACET positions in the design
    // are the thing that eventually folds here; they do not exist yet, so this stays empty
    // rather than being filled with the nearest available substitute.

    // Journal — [CHARJOURNAL] this character's own running notes, folded in
    // exactly like conditions: active (non-archived) bubbles only, joined as prose.
    // Unbounded on purpose (user's call) — archiving/merge-down are the user's own
    // tools for keeping this from growing unbounded, same as the main journal.
    // [T-10] What the schedule says they are doing. ONE-PARTY, so it folds into this
    // character's own entry with no gate beyond the one this whole function already runs
    // under -- the same treatment equipment gets, and deliberately NOT Position's
    // both-parties treatment, which exists because a Position names somebody else.
    // SCENE-PRESENT CHARACTERS ARE SKIPPED. If they are on camera the story is showing what
    // they are doing, and the timetable's guess about it is at best redundant and at worst
    // a flat contradiction of the prose directly above.
    if (inc.activity && !char.scenePresent) {
        try {
            const actCal = ceCalendar(cfg);
            const actSeg = ceSchedWhereIs(char, actCal, await ceClockLoad());
            if (actSeg && actSeg.doing) {
                const actLine = parseMacroTemplate((tpl as any).activity,
                    Object.assign({}, data, { activity: String(actSeg.doing) })).trim();
                if (actLine) lines.push(actLine);
            }
        } catch (eAct) { /* non-fatal: a schedule must not cost the entry its other lines */ }
    }

    // [F-5] Position, folded into its OWNER's entry. Sits after activity and before the
    // journal: what they are doing, then how they read the room, then what they think about
    // it. SKIPPED WHEN THEY ARE OFF CAMERA -- the gate inside the helper needs the TARGET
    // present, and this one needs the subject present, which is what a fold already implies
    // but is not guaranteed by (a dynamic entry can activate on a key alone).
    if (inc.position) {
        try {
            const posLine = await _ceCharPositionLine(char, cfg, await loadIndex());
            if (posLine) lines.push(posLine);
        } catch (ePf) { /* non-fatal: a position must not cost the entry its other lines */ }
    }

    if (inc.journal) {
        const jState = await loadCharJournal(char.id);
        const activeBubbles = (jState.bubbles || []).filter(function(b) { return !b.archived; });
        const journalBody = activeBubbles.map(function(b) { return (b.text || '').trim(); }).filter(Boolean).join('\n\n');
        if (journalBody) {
            const line = parseMacroTemplate(tpl.journal, Object.assign({}, data, { journalBody: journalBody })).trim();
            if (line) lines.push(line);
        }
    }

    return lines.join('\n');
}

// [CHAR-CAT] Character lorebook entries were the one entry family created with no
// category (faction/species/entity families already file under a named one — see
// ensureLorebookCategory below, the shared find-or-create helper this reuses as-is). Own
// name, distinct from the entity system's "AE Characters" (entityLorebookCategoryName) —
// that family covers EntityRecord-typed characters (a different record shape from
// CharacterRecord), so the two are deliberately not merged into one category.
var CHAR_CAT_NAME = 'CE Characters';

// [v3.0.54 LB-STALE] A STORED lorebookEntryId CAN OUTLIVE ITS ENTRY -- the author
// deletes the entry in NAI, or an imported record carries an id minted in another story.
// updateEntry then throws "Entry with ID <id> not found" on EVERY write, and the profile
// surface writes on every field blur, so one dead id produces one console error per edited
// field forever. Nothing but the sync-all sweep ever re-checked a stored id.
// PROBED ONLY IN THE FAILURE PATH, so the happy path costs no extra API call, and the
// answer decides between two very different responses: a MISSING entry is healed (clear the
// dead id, mint a fresh one), any other failure is logged and left alone. Healing on every
// failure would mint a duplicate entry the first time a write failed for an unrelated
// reason. api.v1.lorebook.entry resolves to null for a missing id per the typings; the
// catch covers an implementation that throws instead.
async function _ceLoreEntryAlive(entryId?: string | null): Promise<boolean> {
    if (!entryId) return false;
    try { return !!(await api.v1.lorebook.entry(String(entryId))); }
    catch (_eLa) { return false; }
}

// ── [F-6] ADOPT NON-CE LOREBOOK ENTRIES ─────────────────────────────────────────
// An author with an existing lorebook drops those entries into the CE Characters category
// and presses one button; each becomes a CE character record that OWNS that entry.
//
// ADOPT, NEVER DUPLICATE. The record takes the existing entry as its lorebookEntryId, so the
// author's keys, placement, insertion order and activation settings survive untouched --
// which is the part of a hand-built lorebook that actually took work. Minting a second entry
// would also double-inject every one of them.
//
// THE PROSE MOVES INTO THE RECORD FIRST, AND THAT ORDER IS THE WHOLE SAFETY OF THIS FEATURE.
// syncLorebookEntry OVERWRITES entry text wholesale from the record. Adopt an entry without
// copying its text out and the author's first field edit silently erases their lorebook.
//
// KEYS BECOME NICKNAMES. getLorebookKeys builds keys from name + nicknames and sync
// overwrites the entry's keys with that list -- so a twelve-key entry adopted naively would
// be down to one key at the next sync and would quietly stop firing. Seeding nicknames from
// the original keys preserves activation exactly.
//
// NOTHING IS INFERRED. Species, age, role and the rest stay empty. A guessed field is worse
// than a blank one because it reads as authored.
//
// THE PROSE LANDS IN A CUSTOM FIELD, NOT IN conceptDump. conceptDump is WIZARD INPUT -- it
// feeds generation and is expected to be consumed and superseded. Imported canon is neither.
// One shared CE_IMPORT_FIELD_ID def is found-or-created ONCE PER RUN (a second import must
// not mint a second field), given the standard 150-token budget, and written per record.
// It carries slot 'custom', so ceStaticFieldGroup returns '' and ceOrderStaticFields trails
// it after the grouped fields -- which is what puts it in buildLorebookContent's output and
// on the profile's \u201cCustom fields\u201d section, both by the ordinary path.
//
// IDEMPOTENT WITH NO BOOKKEEPING: an entry is a candidate only if no record already claims
// it, and lorebookEntryId IS the claim.
// The one field every adopted entry writes into. A CONSTANT id, because find-or-create keys
// on it: a label lookup would mint a second field the first time an author renamed this one.
var CE_IMPORT_FIELD_ID = 'cf_imported';

// Found-or-created once per import run. Returns nothing -- the id is the constant above, and
// a failure here is not fatal to the import: the value still lands in customFieldValues and
// appears the moment a def with that id exists.
async function _ceEnsureImportField(): Promise<void> {
    try {
        await mutConfig(function(c: any) {
            if (!Array.isArray(c.customStaticFields)) c.customStaticFields = [];
            var found = c.customStaticFields.filter(function(f: any) {
                return f && String(f.id) === CE_IMPORT_FIELD_ID;
            })[0];
            if (!found) {
                c.customStaticFields.push({
                    id: CE_IMPORT_FIELD_ID, slot: 'custom', kind: 'custom',
                    label: 'Imported Notes', placeholder: '',
                    instructions: 'Canon carried over from an existing lorebook entry.'
                });
            }
            if (!c.fieldBudgets) c.fieldBudgets = {};
            // A def with no budget can compile to nothing downstream; 150 is the same
            // default a hand-added custom field gets from Settings.
            if (!c.fieldBudgets[CE_IMPORT_FIELD_ID]) c.fieldBudgets[CE_IMPORT_FIELD_ID] = 150;
        });
    } catch (eIf) { api.v1.error('[AE:adopt] import field:', eIf); }
}

// [F-6b] TWO FAMILIES, ONE BUTTON, AND THE OLD CATEGORY NAMES STILL COUNT. Characters come
// in as CharacterRecords (unchanged from F-6); locations come in as EntityRecords, which is
// the cheaper half of the two because an EntityRecord ALREADY HAS A PROSE FIELD --
// lorebookText, which buildEntityLorebookContent emits verbatim. No import custom-field is
// needed on that side and none is created.
//   THE CLAIM IS STILL THE POINTER, per family: char.lorebookEntryId for a person,
//   ent.lorebookEntryId for a place. Idempotent with no bookkeeping, exactly as before.
//   THE LOCATION SWEEP LOADS RECORDS, the character sweep does not. EntityMeta carries no
//   lorebookEntryId (CharacterMeta's roster read is a single index), so the claim set for
//   places costs one read per location -- paid ONLY when there is something to adopt, which
//   is why the whole block sits behind a length check.
async function ceAdoptLorebookEntries(): Promise<any> {
    const out: any = { scanned: 0, adopted: 0, skipped: 0, names: [] as string[],
                       charAdopted: 0, locAdopted: 0 };

    // [CAT-CE] Current name first, legacy second, find-only. A story with neither category
    // gets an empty list here and every loop below is a no-op.
    const charCats = await ceFindLorebookCategoryIds(ceLoreCategoryNames(CHAR_CAT_NAME));
    const locCats  = await ceFindLorebookCategoryIds(ceLoreCategoryNames('CE Locations'));

    const readCats = async function(ids: string[]): Promise<any[]> {
        var acc: any[] = [];
        for (var i = 0; i < ids.length; i++) {
            try { acc = acc.concat((await api.v1.lorebook.entries(ids[i])) || []); } catch (e) { /* one unreadable category must not lose the other */ }
        }
        return acc;
    };
    const charEntries: any[] = await readCats(charCats);
    const locEntries:  any[] = await readCats(locCats);
    out.scanned = charEntries.length + locEntries.length;
    if (!out.scanned) return out;

    // Keys minus the entry's own name, which is a key both families re-emit from `name`.
    const spareKeys = function(ent: any, disp: string): string[] {
        const keys: string[] = Array.isArray(ent.keys) ? ent.keys.map(String) : [];
        const spare: string[] = [];
        for (let k = 0; k < keys.length; k++) {
            const kk = keys[k].trim();
            if (kk && kk.toLowerCase() !== disp.toLowerCase() && spare.indexOf(kk) < 0) spare.push(kk);
        }
        return spare;
    };

    // ── Characters ──────────────────────────────────────────────────────────
    if (charEntries.length) {
        await _ceEnsureImportField();
        const claimed: any = {};
        try {
            const all: any[] = await loadAllCharacters();
            for (let i = 0; i < all.length; i++) {
                if (all[i] && (all[i] as any).lorebookEntryId) claimed[String((all[i] as any).lorebookEntryId)] = 1;
            }
        } catch (eI) { /* an unreadable roster means nothing is claimed; the guards below still hold */ }

        for (let e = 0; e < charEntries.length; e++) {
            const ent: any = charEntries[e];
            if (!ent || !ent.id) { out.skipped++; continue; }
            if (claimed[String(ent.id)]) { out.skipped++; continue; }
            const text = String(ent.text || '').trim();
            const disp = String(ent.displayName || '').trim();
            // A nameless or empty entry is not a character. Skipped rather than imported as
            // "Unnamed" with no content, which would be a record the author has to hunt down.
            if (!disp || !text) { out.skipped++; continue; }
            try {
                const _adCfg: any = await loadConfig();
                const rec: any = makeDefaultCharacter(disp, _adCfg);
                // Keys minus the name become nicknames -- see the header on why this matters.
                rec.nicknames = spareKeys(ent, disp);
                // THE PROSE, VERBATIM, IN ONE FIELD. Splitting it into CE's structured fields is
                // the author's job and the wizard's, not an importer's.
                if (!rec.customFieldValues) rec.customFieldValues = {};
                rec.customFieldValues[CE_IMPORT_FIELD_ID] = text;
                rec.lorebookEntryId = String(ent.id);
                await saveCharacter(rec);
                out.adopted++; out.charAdopted++;
                out.names.push(disp);
            } catch (eC) { api.v1.error('[AE:adopt] failed on ' + disp, eC); out.skipped++; }
        }
    }

    // ── Locations ───────────────────────────────────────────────────────────
    if (locEntries.length) {
        const locClaimed: any = {};
        try {
            const eIdx: any[] = await loadEntityIndex();
            for (let i = 0; i < eIdx.length; i++) {
                const em: any = eIdx[i];
                if (!em || String(em.type || '') !== 'location') continue;
                const full: any = await loadEntity(String(em.id));
                if (full && (full as any).lorebookEntryId) locClaimed[String((full as any).lorebookEntryId)] = 1;
            }
        } catch (eLi) { /* same trade as the roster above */ }

        for (let e = 0; e < locEntries.length; e++) {
            const lent: any = locEntries[e];
            if (!lent || !lent.id) { out.skipped++; continue; }
            if (locClaimed[String(lent.id)]) { out.skipped++; continue; }
            const ltext = String(lent.text || '').trim();
            const ldisp = String(lent.displayName || '').trim();
            if (!ldisp || !ltext) { out.skipped++; continue; }
            try {
                const lrec: any = makeDefaultEntity(ldisp);
                lrec.type = 'location';
                // THE PROSE LANDS IN lorebookText AND NOWHERE ELSE. That field is what
                // buildEntityLorebookContent writes back out, so the author's canon survives
                // the first sync -- which is the same safety the character path buys with a
                // custom field, bought here with a field that already existed.
                lrec.lorebookText = ltext;
                // Keys minus the name become trigger tags: getEntityLorebookKeys re-emits
                // name + lorebookTags, so activation is preserved exactly.
                lrec.lorebookTags = spareKeys(lent, ldisp);
                lrec.lorebookEntryId = String(lent.id);
                // NO PARENT IS INVENTED. An adopted place sits at the root of the graph until
                // the author says where it is; guessing a parent from prose would be a claim
                // about the world that reads as authored.
                await saveEntity(lrec);
                out.adopted++; out.locAdopted++;
                out.names.push(ldisp);
            } catch (eL) { api.v1.error('[AE:adopt] failed on ' + ldisp, eL); out.skipped++; }
        }
    }

    return out;
}

async function createLinkedLorebookEntry(charId: string, silent?: boolean): Promise<void> {
    const char = await loadCharacter(charId);
    if (!char) return;
    try {
        const content  = await buildLorebookContent(char);
        const keys     = getLorebookKeys(char);
        const catId    = await ensureLorebookCategory(CHAR_CAT_NAME);
        const entrySpec: any = { displayName: char.name, text: content, keys, enabled: true };
        if (catId) entrySpec.category = catId;
        const entryId  = await api.v1.lorebook.createEntry(entrySpec);
        char.lorebookEntryId = entryId;
        await saveCharacter(char);
        if (!silent) api.v1.ui.toast(`Lorebook entry created for ${char.name}.`, { type: 'success' });
    } catch (e) {
        if (!silent) api.v1.ui.toast('Failed to create lorebook entry.', { type: 'error' });
        if (silent) throw e;
    }
}

async function syncLorebookEntry(charId: string, silent?: boolean): Promise<void> {
    const char = await loadCharacter(charId);
    if (!char?.lorebookEntryId) return;
    try {
        const content = await buildLorebookContent(char);
        // [CHAR-CAT] Re-stamp category on every sync too, not just at creation —
        // entries made before this patch have none, and this is the cheapest place to
        // backfill them without a one-off migration pass.
        const catId = await ensureLorebookCategory(CHAR_CAT_NAME);
        const updateSpec: any = {
            text: content,
            keys: getLorebookKeys(char),
            displayName: char.name
        };
        if (catId) updateSpec.category = catId;
        await api.v1.lorebook.updateEntry(char.lorebookEntryId, updateSpec);
        if (!silent) api.v1.ui.toast('Lorebook entry synced.', { type: 'success' });
    } catch (e) {
        // [v3.0.54 LB-STALE] Reloaded before clearing rather than reusing `char`: this
        // function is called from the profile commit path, where the record on disk may
        // already be one field ahead of the copy loaded at the top.
        if (!(await _ceLoreEntryAlive(char.lorebookEntryId))) {
            let fresh = await loadCharacter(charId);
            if (fresh) { fresh.lorebookEntryId = undefined; await saveCharacter(fresh).catch(function() {}); }
            await createLinkedLorebookEntry(charId, true).catch(function() {});
            if (!silent) api.v1.ui.toast('Lorebook entry was missing \u2014 recreated.', { type: 'info' });
            return;
        }
        api.v1.error('[AE] syncLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to sync lorebook entry.', { type: 'error' });
    }
}

// [earlier] Builds the per-generation lorebook activation package for the current
// scene. For every active, scene-present character (and the protagonist):
//   - permanent entry present  -> force-activate it ([id, {active:true}])
//   - permanent entry absent    -> emit its static identity as an ephemeral temp
//                                  entry (no permanent lorebook needed, no regression)
//   - equipped items present    -> emit a separate ephemeral equipment temp entry
// Returned from onBeforeContextBuild so static identity lives in the lorebook block
// while the Author's Note carries only the dynamic layer.
// [LOREFOLD] paramLoreEntries is onBeforeContextBuild's params.lorebookEntries
// ([id, {active, content}][]) — used to APPEND the dynamic block onto a linked entry's
// CURRENT content (preserving any hand-edits) rather than rebuilding identity. Folding
// equipment + conditions + relationship + mid-range into the one character entry (per
// user's call) makes ordering deterministic: the dynamic layer can no longer land as a
// stray temp entry before its own character (the old ae_equip_/ae_dynamic_ ordering bug).
async function buildSceneLorebookActivation(paramLoreEntries?: any[]): Promise<{ lorebookEntries: any[]; temporaryLorebookEntries: any[] }> {
    const lorebookEntries: any[] = [];
    const temporaryLorebookEntries: any[] = [];
    try {
        const slaCfg = await loadConfig();
        const slaIdx = await loadIndex();
        const slaLoreMap = new Map<string, string>();
        for (const _pt of (paramLoreEntries || [])) {
            if (Array.isArray(_pt) && _pt.length >= 2 && _pt[0]) slaLoreMap.set(_pt[0], (_pt[1] && _pt[1].content) || '');
        }
        for (const meta of slaIdx.filter(Boolean)) {
            if (!meta.active) continue;
            if (!meta.scenePresent && !meta.isProtagonist) continue;
            const slaChar = await loadCharacter(meta.id);
            if (!slaChar) continue;

            // The full dynamic layer for this character, as one prose block.
            const slaDyn = (await buildCharDynamicBlock(slaChar, slaCfg)).trim();

            if (slaChar.lorebookEntryId) {
                // Linked: force-activate the permanent identity entry. If there's a
                // dynamic layer, override its content = current entry text + dynamic
                // block (append, don't clobber). Otherwise activate it untouched.
                if (slaDyn) {
                    let slaBase = slaLoreMap.has(slaChar.lorebookEntryId)
                        ? slaLoreMap.get(slaChar.lorebookEntryId)!
                        : await buildLorebookContent(slaChar);
                    slaBase = (slaBase || '').replace(/\s+$/, '');
                    lorebookEntries.push([slaChar.lorebookEntryId, { active: true, content: slaBase ? (slaBase + '\n\n' + slaDyn) : slaDyn }]);
                } else {
                    lorebookEntries.push([slaChar.lorebookEntryId, { active: true }]);
                }
            } else {
                // Unlinked: emit ONE ephemeral temp entry = identity + dynamic block.
                let slaStatic = (await buildLorebookContent(slaChar)).trim();
                let slaCombined = [slaStatic, slaDyn].filter(Boolean).join('\n\n');
                if (slaCombined) {
                    temporaryLorebookEntries.push({
                        id: 'ae_static_' + slaChar.id,
                        name: slaChar.name || 'Character',
                        content: slaCombined,
                        active: true,
                        appearWithPermanent: true
                    });
                }
            }
        }

        // [LOC-LORE] Force-activate the player's CURRENT room's own dossier entry
        // the same way a scene-present character's entry is activated above. If the player
        // is in the Haunted House, the Haunted House's own lorebook entry activates. This
        // is immediate/single-location only — no ancestor walking up the location tree.
        try {
            const slaRoomId = await aeGetProtagonistRoomId();
            if (slaRoomId) {
                const slaRoom = await loadEntity(slaRoomId);
                if (slaRoom && (slaRoom as any).lorebookEntryId) {
                    lorebookEntries.push([(slaRoom as any).lorebookEntryId, { active: true }]);
                }
            }
        } catch (eSlaLoc) { api.v1.error('[AE:context] current-location activation:', eSlaLoc); }
    } catch (eSla) { api.v1.error('[AE:context] buildSceneLorebookActivation:', eSla); }
    return { lorebookEntries: lorebookEntries, temporaryLorebookEntries: temporaryLorebookEntries };
}

// ── Faction Lorebook ──────────────────────────────────────────────────────────

// [F-28] FIVE FACTION LOREBOOK FUNCTIONS DELETED (69 lines): getFactionLorebookKeys,
// buildFactionLorebookContent, createLinkedFactionLorebookEntry, syncFactionLorebookEntry,
// unlinkFactionLorebookEntry. Every one had an entity twin fifty lines below doing the same
// job better -- the entity version compiles the lens answers in the author's own fieldOrder,
// handles a stale entry id, and respects the Classic/Builder split. A faction is an entity
// now, so it uses them. Deleted rather than left as a fallback: two lorebook writers for one
// record is how an entry comes to be written twice with different text.
//   THE ONE THING THAT DID NOT CARRY ACROSS is the standing-ladder line the faction builder
//   appended ("Relationship standings: Hostile -> Wary -> ..."). That was a schema dump aimed
//   at the model and it is not missed; a faction's rungs are visible on Diplomacy and in
//   every standing band label, both of which are prose.


// ── Species Lorebook ──────────────────────────────────────────────────────────

function getSpeciesLorebookKeys(sp: SpeciesDef): string[] {
    return [sp.name].concat(sp.lorebookTags || []).filter(Boolean);
}

function buildSpeciesLorebookContent(sp: SpeciesDef): string {
    const lines: string[] = [];
    if (sp.name) lines.push(sp.name);
    if (sp.description?.trim()) lines.push(sp.description.trim());
    return lines.join('\n');
}

async function createLinkedSpeciesLorebookEntry(speciesId: string, silent?: boolean): Promise<void> {
    const cfg  = await loadConfig();
    const sIdx = (cfg.species || []).findIndex(function(s) { return s.id === speciesId; });
    if (sIdx < 0) return;
    const sp = cfg.species[sIdx];
    try {
        let catId = await ensureLorebookCategory('CE Species');
        let entry: any = {
            displayName: sp.name,
            text: buildSpeciesLorebookContent(sp),
            keys: getSpeciesLorebookKeys(sp),
            enabled: true
        };
        if (catId) entry.category = catId;
        const entryId = await api.v1.lorebook.createEntry(entry);
        cfg.species[sIdx].lorebookEntryId = entryId;
        await saveConfig(cfg);
        if (!silent) api.v1.ui.toast(`Lorebook entry created for ${sp.name}.`, { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to create species lorebook entry.', { type: 'error' }); if (silent) throw e; }
}

async function syncSpeciesLorebookEntry(speciesId: string, silent?: boolean): Promise<void> {
    const cfg = await loadConfig();
    const sp  = (cfg.species || []).find(function(s) { return s.id === speciesId; });
    if (!sp?.lorebookEntryId) return;
    try {
        await api.v1.lorebook.updateEntry(sp.lorebookEntryId, {
            text: buildSpeciesLorebookContent(sp),
            keys: getSpeciesLorebookKeys(sp),
            displayName: sp.name
        });
        if (!silent) api.v1.ui.toast('Species lorebook synced.', { type: 'success' });
    } catch (e) { if (!silent) api.v1.ui.toast('Failed to sync species lorebook.', { type: 'error' }); if (silent) throw e; }
}

async function unlinkSpeciesLorebookEntry(speciesId: string): Promise<void> {
    const cfg = await loadConfig();
    const sIdx = (cfg.species || []).findIndex(function(s) { return s.id === speciesId; });
    if (sIdx < 0) return;
    if (cfg.species[sIdx].lorebookEntryId) {
        try { await api.v1.lorebook.removeEntry(cfg.species[sIdx].lorebookEntryId!); } catch(e) {}
        cfg.species[sIdx].lorebookEntryId = undefined;
        await saveConfig(cfg);
        api.v1.ui.toast('Species lorebook unlinked.', { type: 'info' });
    }
}
// ── Entity Lorebook (locations / items / narratives) ────────────────────────
// New in [WP-1]. Same getKeys/buildContent/create/sync family as the character
// lorebook above, but for world entities, filed under an "AE <Type>s" category.
// ensureLorebookCategory() is the shared find-or-create helper (reusable by the
// character/faction/species families on a later unification pass).

async function ensureLorebookCategory(name: string): Promise<string> {
    // Returns the id of the named lorebook category, creating it if absent.
    // Returns '' on failure — callers then create the entry uncategorised.
    try {
        let cats = await api.v1.lorebook.categories();
        let found = (cats || []).find(function(c) { return c.name === name; });
        if (found) return found.id;
        let newId = await api.v1.lorebook.createCategory({ id: api.v1.uuid(), name: name, enabled: true });
        return newId || '';
    } catch (e) { api.v1.error('[AE:lore] ensureLorebookCategory:', e); return ''; }
}

// [CAT-CE] EVERY CATEGORY THIS ENGINE CREATES IS NAMED "CE <something>". Four of them said
// 'AE' and the character family said 'CE', which an author reads as two systems writing into
// one lorebook. THE OLD NAMES ARE RETIRED, NOT FORGOTTEN: ceLoreCategoryNames() returns the
// current name AND its predecessor, every SCAN goes through it, and every CREATE uses the
// current name alone. That is the whole compatibility story -- existing 'AE Locations'
// entries are still found, and the first sync of any one of them re-stamps it into
// 'CE Locations' (see syncEntityLorebookEntry, which now carries the category the way the
// character path has since CHAR-CAT).
//   NOT A MIGRATION PASS. Renaming the category record itself would move entries the author
//   put there by hand as well as ours, and there is no way to tell those apart -- so the
//   entries WE own move themselves, one at a time, as they sync.
var CE_LORE_CAT_LEGACY: { [current: string]: string } = {
    'CE Locations':  'AE Locations',
    'CE Items':      'AE Items',
    'CE Narratives': 'AE Narratives',
    'CE Factions':   'AE Factions',
    'CE Species':    'AE Species',
    'CE Characters': 'AE Characters'
};

// [CAT-CE] The names a SCAN must cover, current first. A name with no predecessor answers
// with itself, so callers never branch on whether an alias exists.
function ceLoreCategoryNames(current: string): string[] {
    var legacy = CE_LORE_CAT_LEGACY[String(current)];
    return legacy ? [String(current), legacy] : [String(current)];
}

// [CAT-CE] FIND-ONLY, AND IT NEVER CREATES. ensureLorebookCategory is the CREATE door and
// is used at every write; this is the READ door, used by the adopter. The difference is not
// cosmetic: creating 'AE Locations' in a story that never had one would hand the author an
// empty legacy category to drop entries into, which is the opposite of retiring the name.
// Returns ids in the order the names were given -- current first -- and de-duplicates,
// because a story can legitimately hold both.
async function ceFindLorebookCategoryIds(names: string[]): Promise<string[]> {
    var out: string[] = [];
    try {
        var cats: any[] = (await api.v1.lorebook.categories()) || [];
        for (var n = 0; n < names.length; n++) {
            for (var c = 0; c < cats.length; c++) {
                if (cats[c] && String(cats[c].name) === String(names[n])
                    && out.indexOf(String(cats[c].id)) < 0) out.push(String(cats[c].id));
            }
        }
    } catch (e) { api.v1.error('[AE:lore] ceFindLorebookCategoryIds:', e); }
    return out;
}

function entityLorebookCategoryName(ent: EntityRecord): string {
    if (ent.type === 'item')      return 'CE Items';
    if (ent.type === 'narrative') return 'CE Narratives';
    // [CAT-CE] FACTIONS HAD NO BRANCH AND HAVE BEEN FILING UNDER LOCATIONS. F-28 made a
    // faction an entity and this function was never told, so every faction entry created
    // since has sat in the locations category. One line; the next sync of each moves it.
    if (ent.type === 'faction')   return 'CE Factions';
    // [CAT-CE] DEAD BRANCH, KEPT AND NAMED SO IT CANNOT COLLIDE. A character BODY is an
    // EntityRecord of type 'character' (ENT-ID1). It has no Lorebook launcher
    // (_ceEntityLaunchers gates on type !== 'character') and no syncAllLorebooks pass (that
    // loop filters to 'location' plus factions), so nothing can reach this line today.
    // It must NOT return CHAR_CAT_NAME: ceAdoptLorebookEntries scans that category and
    // claims by char.lorebookEntryId, so a body's entry appearing there would be adopted as
    // a second character of the same name.
    if (ent.type === 'character') return 'CE Character Bodies';
    return 'CE Locations';
}

function getEntityLorebookKeys(ent: EntityRecord): string[] {
    // Entity name is always a key; lorebookTags add extra trigger words.
    // [LOC-PROFILE6] THE OWNER IS NOT A KEY. An earlier reading of this feature
    // made the owner's name trigger this entry, which is a different and much heavier
    // claim than the field makes: every mention of a character who happens to own three
    // buildings would pull all three into context, and none of that was asked for. What
    // the owner is FOR is generation context -- see _ceEntityGenShim.
    return [ent.name].concat(ent.lorebookTags || []).filter(Boolean);
}

// [LOC-PROFILE5] Resolve the owner's display name from whichever table owns it.
// SYNCHRONOUS AND SOURCE-FED: the caller supplies the entity index and the config it
// already has in hand, so this adds no read on any path. Returns '' for an owner that no
// longer exists, which renders as unset rather than as a dangling id -- deleting a faction
// or a character should not leave a place claiming an owner nobody can look up.
function ceOwnerName(ent: any, entIndex: any[], cfg: any): string {
    var oid = String((ent && ent.ownerId) || '');
    if (!oid) return '';
    // [F-28] THE ownerKind BRANCH IS GONE. It existed because a faction lived in the config
    // and a place lived in the index, so resolving an owner meant knowing which table to
    // look in. Both are entities now and the index holds both, so one loop answers for
    // either -- and ownerKind survives as a label on the record rather than as a router.
    var idx: any[] = entIndex || [];
    for (var j = 0; j < idx.length; j++) {
        if (idx[j] && String(idx[j].id) === oid) return String(idx[j].name || '');
    }
    return '';
}

// [LOC-PROFILE] "<name> is a <locationType> inside <parentName>." Cheap, true at
// every scale, and the single highest-value line in a location's entry -- four of them
// live together as a nest descends and the whole chain reads without any of them saying
// so. Degrades rather than dangling: no parent gives "<name> is a <type>.", no type gives
// nothing at all rather than "<name> is a  inside X."
// [LOC-PROFILE6] THE OWNER'S RECORD, AS A GENERATION BRIEF. This is the whole
// point of the owner field: "Jax's room" and "the kingdom's capital" are not questions the
// model should have to guess the influences of. Given an owner, every Generate button on
// the place is written knowing whose it is -- what they are like, what they care about,
// what the faction wants -- without the author restating it in each steer.
//
// TRUNCATED HARD AND DELIBERATELY. This is CONTEXT, not the subject: a character's full
// profile is longer than the answer being generated and would drown the actual question.
// The identity line plus the two most characterising fields is what a person would say if
// asked "whose place is this?" in one breath, and that is the right length.
//
// EQUIPPED-TO IS NOT CONSULTED, and that is deliberate rather than an omission. An item's
// equippedToCharId is a FUNCTIONAL field -- it says the thing is being worn or wielded
// right now -- and possession in that sense is not authorship. A sword taken off a corpse
// does not become characterised by whoever is holding it this turn. Only ownerId feeds
// this.
async function ceOwnerContext(ent: any, cfg: any): Promise<string> {
    var oid = String((ent && ent.ownerId) || '');
    if (!oid) return '';
    try {
        // [F-28] A faction owner is loaded like any other entity owner. The branch is kept
        // rather than merged into the one below because the BRIEF differs: a faction is
        // summarised by what it is, a place by its identity line -- and the field that
        // carries a faction's character is now its lens answers, which the entity brief
        // below already knows how to read. This shorter form stays for a migrated faction
        // that has answered none of them and has only a description.
        if (String((ent && ent.ownerKind) || '') === 'faction') {
            var fEnt: any = await loadEntity(oid);
            if (!fEnt) return '';
            var fLines: string[] = [String(fEnt.name || '')];
            var fd = String(fEnt.description || '').trim();
            if (fd) fLines.push(fd.length > 400 ? fd.slice(0, 400) + '\u2026' : fd);
            return fLines.filter(Boolean).join(' \u2014 ');
        }
        // A character. Post-ENT-ID1 the owner id IS the character id, so this is one read
        // with nothing to resolve -- the door that opened when the two ids became one.
        var c: any = await loadCharacter(oid);
        if (!c) return '';
        var idLeader = [c.species, c.gender].map(function(x: any) { return String(x || '').trim(); }).filter(Boolean).join(' ');
        var idMid = [idLeader, String(c.age || '').trim(), String(c.occupationRole || '').trim()].filter(Boolean).join(', ');
        var out: string[] = [];
        var head = String(c.name || '').trim();
        if (head && idMid) head = head + ' \u2014 ' + idMid;
        else if (!head) head = idMid;
        if (head) out.push(head);
        function clip(v: any): string {
            var t = String(v || '').trim();
            return t ? (t.length > 300 ? t.slice(0, 300) + '\u2026' : t) : '';
        }
        var pc = clip(c.personalityCore);
        if (pc) out.push(pc);
        var bg = clip(c.background);
        if (bg) out.push(bg);
        return out.join(' ');
    } catch (e) { api.v1.error('[AE:locprofile] owner context failed:', e); return ''; }
}

function ceEntityIdentityLine(ent: any, parentName: string): string {
    var n = String((ent && ent.name) || '').trim();
    var t = String((ent && ent.locationType) || '').trim();
    if (!n || !t) return '';
    var p = String(parentName || '').trim();
    var article = ('aeiouAEIOU'.indexOf(t.charAt(0)) >= 0) ? 'an ' : 'a ';
    return n + ' is ' + article + t + (p ? (' inside ' + p) : '') + '.';
}

// [LOC-PROFILE] The chain from root down to (not including) this entity, as
// identity lines. THIS IS WHAT MAKES NESTED GENERATION BEAT GENERATING PLACES IN
// ISOLATION: generating a room that can see its tavern, its district and its city does
// not put a fireplace in a desert caravanserai by accident.
//
// IT IS ALSO THE CONTEXT-COST ARGUMENT. Forty rooms in one city do not each carry the
// city's climate line -- the child's entry says nothing about climate, and the city's
// entry, which is live whenever you are inside it, says it once.
//
// Depth-capped at 6 and cycle-guarded by a seen-set: parentId is author-editable through
// a picker, and while ceMapWouldCycle refuses to CREATE a loop, a record imported from
// elsewhere carries no such promise.
async function ceEntityAncestorLines(ent: any): Promise<string[]> {
    var out: string[] = [];
    try {
        var metas: any[] = await loadEntityIndex();
        var byId: any = {};
        for (var i = 0; i < (metas || []).length; i++) { if (metas[i] && metas[i].id) byId[String(metas[i].id)] = metas[i]; }
        var seen: any = {};
        var curId: any = (ent && ent.parentId) ? String(ent.parentId) : null;
        var guard = 0;
        while (curId && !seen[curId] && guard < 6) {
            seen[curId] = true; guard++;
            var m: any = byId[curId];
            if (!m) break;
            var pName = (m.parentId && byId[String(m.parentId)]) ? String(byId[String(m.parentId)].name || '') : '';
            var line = ceEntityIdentityLine({ name: m.name, locationType: (m as any).locationType }, pName);
            if (line) out.push(line);
            curId = m.parentId ? String(m.parentId) : null;
        }
    } catch (e) { api.v1.error('[AE:locprofile] ancestor walk failed:', e); }
    return out.reverse();
}

function buildEntityLorebookContent(ent: EntityRecord): string {
    // [WP-1] The dedicated extended-lore body, injected when a key (the entity
    // name or an added key) appears in the story.
    // [ATMO] DESCRIPTION IS EXCLUDED FOR LOCATIONS AND CARRIED FOR EVERYTHING ELSE, and the
    // asymmetry is the whole point rather than an oversight. The exclusion's reason is the
    // gazetteer: buildWorldLoreText emits a location's description verbatim in an entry that
    // is always on, so repeating it here would double it.
    // THAT ENTRY IS PLACES ONLY. A faction's, an item's or a thread's description reaches
    // context through NOTHING -- the cast entry is characters, the world entry is locations,
    // and this one refused it -- so every word an author wrote in the description box of a
    // faction has been inert since the type existed. Two channels, and a record belongs to
    // exactly one of them; the type is the test.
    //
    // [LOC-PROFILE] THE IDENTITY LINE AND THE FACETS COMPILE IN, in catalog order.
    // Same projection contract CastLore states: the RECORD is the source of truth and the
    // lorebook entry is a VIEW of it, so nothing here is stored and a hand-edited entry is
    // overwritten on next sync rather than merged.
    //
    // THE PARENT NAME IS NOT RESOLVED HERE and the identity line degrades to
    // "<name> is a <type>." without it. This function is SYNCHRONOUS and is called from
    // four places; making it async to win one clause would have made every caller async.
    // syncEntityLorebookEntry, which is already async, passes the name in.
    //
    // EMPTY FACETS SELF-SUPPRESS, exactly as character facets do. A place with a name and
    // a type compiles two lines and that is a complete entry.
    var parts: string[] = [];
    var idLine = ceEntityIdentityLine(ent, String((ent as any)._ceParentName || ''));
    if (idLine) parts.push(idLine);
    // [LOC-PROFILE5] Resolved by syncEntityLorebookEntry onto the in-memory copy,
    // for the same reason _ceParentName is: this function is synchronous and has four
    // callers. An owner whose record has gone resolves to '' and the line is simply absent.
    var ownName = String((ent as any)._ceOwnerName || '').trim();
    if (ownName) parts.push('Owned by ' + ownName + '.');
    if (String((ent as any).type || '') !== 'location') {
        var desc = String((ent as any).description || '').trim();
        if (desc) parts.push(desc);
    }
    var body = (ent.lorebookText || '').trim();
    if (body) parts.push(body);
    // [LOC-PROFILE4] IN THE AUTHOR'S ORDER, through the same resolver the surface
    // renders from -- see ceEntityOrderedDefs. Custom fields are carried on the record copy
    // as `_ceCustomDefs` by both async lorebook paths, for the same reason `_ceParentName`
    // is: this function is SYNCHRONOUS and has three callers, and making it async to reach
    // loadConfig would make every one of them async too.
    // [ITEM-CAT] The cfg argument is null here BECAUSE of that. The resolver prefers
    // `_ceCustomDefs` when the record carries it, which replaced the synthetic
    // `{ customLocationFields: ... }` object this used to fabricate -- a shape that named
    // one type's config key and would have had to become a computed key to serve two.
    var cfv: any = (ent as any).customFieldValues || {};
    var defs: any[] = ceEntityOrderedDefs(ent, null);
    for (var i = 0; i < defs.length; i++) {
        var fd = defs[i];
        var v = String(cfv[fd.id] || '').trim();
        if (!v) continue;
        parts.push(fd.label + ': ' + v);
    }
    return parts.join('\n');
}

// [LORE-PROJECT] THE THREE INPUTS buildEntityLorebookContent CANNOT RESOLVE ITSELF,
// stamped on the IN-MEMORY COPY ONLY and never saved: these are projection inputs, not
// record state, and a stored copy of a resolved name goes stale the moment the thing it
// names is renamed.
// FACTORED OUT, AND THE OLD COMMENT SAYING IT DELIBERATELY WAS NOT IS WRONG NOW. That call
// was made when there were two copies ("four statements, and a helper is harder to read
// than the reason"). There are three sites -- create, sync and the ensure pass that decides
// whether either is worth running -- and the third one exists precisely to ask the same
// question the other two answer, so a copy that drifts makes the gate disagree with the
// writer it is gating.
// NON-FATAL BY CONSTRUCTION. Every clause degrades to an absent line rather than a thrown
// entry: the identity line loses "inside X", the ownership line disappears, custom fields
// compile to nothing.
async function ceEntityLoreProject(ent: any): Promise<void> {
    if (!ent) return;
    var lpCfg: any = null;
    try { lpCfg = await loadConfig(); } catch (eC) { lpCfg = null; }
    (ent as any)._ceCustomDefs = ceEntityCustomDefsFor(ent, lpCfg);
    try {
        if (ent.parentId) {
            var lpPar: any = await loadEntity(String(ent.parentId));
            if (lpPar && lpPar.name) (ent as any)._ceParentName = String(lpPar.name);
        }
        (ent as any)._ceOwnerName = ceOwnerName(ent, await loadEntityIndex(), lpCfg);
    } catch (eR) { /* non-fatal -- the identity and ownership lines degrade, the entry stands */ }
}

// [ITEM-CAT] THE GATE, AND IT IS THE WRITER ITSELF. "Is there anything to say" was stated
// as the rule and then implemented as a hand-kept list of fields that might say something --
// lorebookText, plus the custom answers -- which is a second source of truth that silently
// disagreed with the writer the moment the writer learned a new line. It had: an identity
// line compiles from name + locationType alone, so a room with a type and no prose was
// refused an entry it would have filled correctly.
// ASK THE FUNCTION THAT BUILDS IT. Requires the projection inputs to be stamped first, which
// is why this takes a record rather than an id -- the caller has already done that work and
// must not do it twice.
function ceEntityLoreText(ent: any): string {
    if (!ent) return '';
    return String(buildEntityLorebookContent(ent) || '').trim();
}

// [ITEM-CAT] The one lookup both lorebook paths need, so neither spells the config
// key. Returns [] for a type with no catalog, which compiles to no field lines.
function ceEntityCustomDefsFor(ent: any, cfg: any): any[] {
    var cat = ceEntityCatalog(String((ent && ent.type) || ''));
    if (!cat) return [];
    return (cfg && cfg[cat.cfgKey]) || [];
}

// [ITEM-CAT] THE GATE IS "IS THERE ANYTHING TO SAY", NOT "IS lorebookText WRITTEN".
// It was the second, which made the deprecated free-text field a hard prerequisite for
// linking -- so a record authored entirely through the profile questions, which is the
// authoring model the catalog exists to provide, could not get an entry at all. That was
// survivable for locations only because the wizard writes lorebookText behind their backs;
// an item has no such path and would have been unlinkable from the day it got fields.
//
// AND THE PROJECTION INPUTS ARE RESOLVED HERE TOO, through ceEntityLoreProject. This path
// built the entry without them, so a first link produced a body missing its parent clause,
// its owner line and every custom field, and only the NEXT sync was correct.
async function createLinkedEntityLorebookEntry(entId: string, silent?: boolean): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent) return;
    await ceEntityLoreProject(ent);
    // [ITEM-CAT] ONE DERIVATION: the gate asks the writer, and the text it answers with is
    // the text that gets stored. Building it twice is how a gate comes to pass on a record
    // the writer then compiles to nothing.
    let clText = ceEntityLoreText(ent);
    if (!clText) { if (!silent) api.v1.ui.toast('Give this a type, a description or an answer first, then link.', { type: 'info' }); return; }
    try {
        let catId = await ensureLorebookCategory(entityLorebookCategoryName(ent));
        let entry: any = { id: api.v1.uuid(), displayName: ent.name, text: clText, keys: getEntityLorebookKeys(ent), enabled: true };
        if (catId) entry.category = catId;
        let newId = await api.v1.lorebook.createEntry(entry);
        ent.lorebookEntryId = newId;
        await saveEntity(ent);
        if (!silent) api.v1.ui.toast('Lorebook entry created for ' + ent.name + '.', { type: 'success' });
    } catch (e) {
        api.v1.error('[AE:lore] createLinkedEntityLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to create lorebook entry.', { type: 'error' });
        if (silent) throw e;
    }
}

// [LORE-EVERY] SYNC CREATES. It used to return silently when the record had no entry,
// which made "a field edit resyncs the entry" true only for records that had already been
// linked by hand -- and the one door to that link was a button on a screen most entities
// never get opened on. An entity authored entirely through its profile questions therefore
// answered every question into a lorebook that had never heard of it.
// THE GATE HAS NOT MOVED, only the trigger. createLinkedEntityLorebookEntry still refuses a
// record with nothing to say, so this does not mint an empty entry for a place called "New
// location" -- it mints one at the first commit that gives the record a line, and resyncs
// every commit after that. "Every entity has an entry" and "no entry is empty" are the same
// rule read from two ends.
// [LOC-PROFILE5] The owner's name is resolved by ceEntityLoreProject and used TWICE: as the
// ownership line, and as a TRIGGER KEY. The key is the part worth having -- a scene that
// talks about the owner now pulls in the place they hold. Derived rather than saved onto
// lorebookTags, because renaming the owner must move the key and a stored copy would leave
// the old name triggering forever.
async function syncEntityLorebookEntry(entId: string, silent?: boolean): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent) return;
    if (!ent.lorebookEntryId) {
        await createLinkedEntityLorebookEntry(entId, true).catch(function() {});
        return;
    }
    await ceEntityLoreProject(ent);
    try {
        // [CAT-CE] THE CATEGORY IS RE-STAMPED ON EVERY SYNC, exactly as CHAR-CAT does for
        // characters and for the same two reasons: entries made before their family had a
        // category have none, and entries made under the old 'AE ' names need a door out of
        // them that costs no migration pass. An author who filed one of OUR entries into a
        // category of their own does lose that placement on the next field edit -- which is
        // the trade the character path already makes, and the entry text is overwritten from
        // the record on that same sync anyway, so the placement was never the durable part.
        var seUpd: any = { text: ceEntityLoreText(ent), keys: getEntityLorebookKeys(ent), displayName: ent.name };
        var seCat = await ensureLorebookCategory(entityLorebookCategoryName(ent));
        if (seCat) seUpd.category = seCat;
        await api.v1.lorebook.updateEntry(ent.lorebookEntryId, seUpd);
        if (!silent) api.v1.ui.toast('Lorebook entry synced.', { type: 'success' });
    } catch (e) {
        // [v3.0.54 LB-STALE] Same heal as the character path, for the same reason: the
        // entity surface also syncs on every field commit. FACTIONS AND SPECIES ARE
        // DELIBERATELY NOT GIVEN THIS -- their sync runs only from a button the author
        // presses, so a stale id there reports itself once and syncAllLorebooks already
        // repairs it.
        if (!(await _ceLoreEntryAlive(ent.lorebookEntryId))) {
            let entFresh = await loadEntity(entId);
            if (entFresh) { entFresh.lorebookEntryId = undefined; await saveEntity(entFresh).catch(function() {}); }
            await createLinkedEntityLorebookEntry(entId, true).catch(function() {});
            if (!silent) api.v1.ui.toast('Lorebook entry was missing \u2014 recreated.', { type: 'info' });
            return;
        }
        api.v1.error('[AE:lore] syncEntityLorebookEntry:', e);
        if (!silent) api.v1.ui.toast('Failed to sync lorebook entry.', { type: 'error' });
    }
}

async function unlinkEntityLorebookEntry(entId: string): Promise<void> {
    let ent = await loadEntity(entId);
    if (!ent || !ent.lorebookEntryId) return;
    try { await api.v1.lorebook.removeEntry(ent.lorebookEntryId); }
    catch (e) { api.v1.error('[AE:lore] unlinkEntityLorebookEntry:', e); }
    ent.lorebookEntryId = undefined;
    await saveEntity(ent);
    api.v1.ui.toast('Lorebook entry unlinked.', { type: 'info' });
}

// ── Sync-All Lorebooks ──────────────────────────────────────────────────────
// [vNEXT] The individual sync helpers all early-return when a record has no
// lorebookEntryId, and none of them notice when a stored id points at an entry the
// user has since deleted in NAI. syncAllLorebooks fixes both: it never assumes an
// entry exists. It pulls the full live entry-id set ONCE (single API call), then per
// record decides create-vs-sync from that set in memory — so a run over the whole
// world costs one entries() call plus one update/create per record, no per-record
// existence probing. A record is (re)created when it has no id OR its id is stale
// (missing from the live set); otherwise it is synced. Returns per-type tallies.
//
// liveIds: pass the prebuilt Set so a single sync-all shares one snapshot across all
// four families. _ensure* helpers below are also individually callable.
async function _liveLorebookIdSet(): Promise<Set<string>> {
    let set = new Set<string>();
    try {
        let all = await api.v1.lorebook.entries();
        (all || []).forEach(function(e: any) { if (e && e.id) set.add(e.id); });
    } catch (e) { api.v1.error('[AE:lore] _liveLorebookIdSet:', e); }
    return set;
}

async function ensureCharacterLorebook(charId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let char = await loadCharacter(charId);
    if (!char) return 'skipped';
    let hasLive = !!(char.lorebookEntryId && liveIds.has(char.lorebookEntryId));
    if (hasLive) { await syncLorebookEntry(charId, true).catch(function() {}); return 'synced'; }
    // No id, or a stale id whose entry was deleted in NAI: clear + recreate.
    if (char.lorebookEntryId && !hasLive) { char.lorebookEntryId = undefined; await saveCharacter(char).catch(function() {}); }
    await createLinkedLorebookEntry(charId, true).catch(function() {});
    return 'created';
}

// [F-28] ensureFactionLorebook DELETED. ensureEntityLorebook already does exactly this for
// any entity, including the stale-id clear -- and a faction is one now. The syncAll loop
// below calls that instead.

async function ensureSpeciesLorebook(speciesId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let cfg = await loadConfig();
    let s = (cfg.species || []).find(function(x) { return x.id === speciesId; });
    if (!s) return 'skipped';
    let hasLive = !!(s.lorebookEntryId && liveIds.has(s.lorebookEntryId));
    if (hasLive) { await syncSpeciesLorebookEntry(speciesId, true).catch(function() {}); return 'synced'; }
    if (s.lorebookEntryId && !hasLive) {
        let cfg2 = await loadConfig();
        let s2i = (cfg2.species || []).findIndex(function(x) { return x.id === speciesId; });
        if (s2i >= 0) { cfg2.species[s2i].lorebookEntryId = undefined; await saveConfig(cfg2).catch(function() {}); }
    }
    await createLinkedSpeciesLorebookEntry(speciesId, true).catch(function() {});
    return 'created';
}

async function ensureEntityLorebook(entId: string, liveIds: Set<string>): Promise<'created' | 'synced' | 'skipped'> {
    let ent = await loadEntity(entId);
    if (!ent) return 'skipped';
    // [ITEM-CAT] THE SAME GATE THE CREATE PATH USES, asked the same way. This used to test
    // lorebookText alone -- a NARROWER question than the one it was gating -- so a record
    // authored through the profile questions was reported 'skipped' by a sync-all that
    // would have linked it happily had anybody pressed the button by hand.
    await ceEntityLoreProject(ent);
    if (!ceEntityLoreText(ent)) return 'skipped';
    let hasLive = !!(ent.lorebookEntryId && liveIds.has(ent.lorebookEntryId));
    if (hasLive) { await syncEntityLorebookEntry(entId, true).catch(function() {}); return 'synced'; }
    if (ent.lorebookEntryId && !hasLive) { ent.lorebookEntryId = undefined; await saveEntity(ent).catch(function() {}); }
    await createLinkedEntityLorebookEntry(entId, true).catch(function() {});
    return 'created';
}

interface SyncAllTally { created: number; synced: number; skipped: number; }
async function syncAllLorebooks(): Promise<{ characters: SyncAllTally; locations: SyncAllTally; species: SyncAllTally; factions: SyncAllTally }> {
    let mk = function(): SyncAllTally { return { created: 0, synced: 0, skipped: 0 }; };
    let out = { characters: mk(), locations: mk(), species: mk(), factions: mk() };
    let bump = function(t: SyncAllTally, r: 'created' | 'synced' | 'skipped') { if (r === 'created') t.created++; else if (r === 'synced') t.synced++; else t.skipped++; };

    // One live snapshot shared by every family — the only lorebook read of the run.
    let liveIds = await _liveLorebookIdSet();

    try {
        // Characters (from the lightweight index).
        let cIdx = await loadIndex();
        for (let m of cIdx.filter(Boolean)) {
            bump(out.characters, await ensureCharacterLorebook(m.id, liveIds));
        }
    } catch (e) { api.v1.error('[AE:lore] syncAll characters:', e); }

    try {
        // Locations (location-type entities).
        let eIdx = await loadEntityIndex();
        for (let em of eIdx.filter(function(x) { return x && x.type === 'location'; })) {
            bump(out.locations, await ensureEntityLorebook(em.id, liveIds));
        }
    } catch (e) { api.v1.error('[AE:lore] syncAll locations:', e); }

    try {
        let cfg = await loadConfig();
        for (let sp of (cfg.species || [])) { bump(out.species, await ensureSpeciesLorebook(sp.id, liveIds)); }
    } catch (e) { api.v1.error('[AE:lore] syncAll species:', e); }

    // [F-28] Factions ride the ENTITY sweep now, in their own tally so the report still
    // distinguishes them -- an author who syncs everything wants to know a faction was
    // touched, not that "entities: 31" happened.
    try {
        let fMetas: any[] = await ceFactionMetas();
        for (let fm of fMetas) { bump(out.factions, await ensureEntityLorebook(String(fm.id), liveIds)); }
    } catch (e) { api.v1.error('[AE:lore] syncAll factions:', e); }

    return out;
}



// ============================================================================
// SECTION 10b — PLAYER JOURNAL  [JOURNAL]
// A player-authored running record ("The story so far") that survives context
// pressure by living in the lorebook. Bubbles are the source of truth in
// storyStorage; two lorebook entries are a *projection* of them:
//   - Active  entry: Always-On, keyless — non-archived bubbles, injected every turn.
//   - Archive entry: keyless + disabled — archived bubbles, retained but NEVER
//                    injected; unarchiving moves a bubble back to the active set.
// Renderer (native HUD) lives in Section 27; this section is pure state + lore +
// generation so the bridge can later drive the same verbs over a message pair.
// ============================================================================

async function loadJournal(): Promise<JournalState> {
    try {
        const raw = await api.v1.storyStorage.getOrDefault(STORAGE_JOURNAL, null);
        if (raw && typeof raw === 'object' && Array.isArray((raw as any).bubbles)) {
            const s = raw as JournalState;
            // [JRNL-CHRONO] The single sort point for the story journal.
            s.bubbles = _ceJournalChrono(s.bubbles) as JournalBubble[];
            return s;
        }
    } catch (e) { api.v1.error('[AE:journal] loadJournal:', e); }
    return { bubbles: [] };
}

async function saveJournal(state: JournalState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_JOURNAL, {
            bubbles: (state.bubbles || []).filter(Boolean),
            activeLoreId: state.activeLoreId,
            archiveLoreId: state.archiveLoreId
        });
    } catch (e) { api.v1.error('[AE:journal] saveJournal:', e); }
}

// [JOURNAL] Stamp reflects the STORY's in-world calendar at the moment the
// entry was written (captured as storyHours at creation), not wall-clock time.
// Formatted via the same clockFormatStamp the calendar/Author's-Note use.

// [JRNL-CHRONO] CHRONOLOGY IS A PROPERTY OF createdAt, NOT OF
// ARRAY POSITION, and every reader of a bubble list assumed the opposite. journalMergeDown
// rebuilds the array as [merged].concat(archived), so a merge MOVES EVERY ARCHIVED BUBBLE
// TO THE END -- and an entry unarchived after a merge therefore came back at the bottom of
// the list instead of where it was written. That was the reported bug, but the UI was only
// the visible face of it: the same array order drives buildJournalBody (both lorebook
// entries), the character lorebook fold, and buildHookStateContext's "most recent 4"
// slice, so a merged story was quietly feeding the MODEL out-of-order recaps too.
// Sorting at the READ (loadJournal / loadCharJournal) rather than at any one consumer is
// what makes merge's reordering harmless forever: nothing downstream has to know. Storage
// is untouched -- the next save simply writes the sorted order back.
// The id tiebreak matters: two bubbles can share a millisecond, and an unstable comparator
// would let them swap places between renders.
function _ceJournalChrono(bubbles: any[]): any[] {
    var out: any[] = (bubbles || []).filter(Boolean).slice();
    out.sort(function(a: any, b: any) {
        var da = Number(a.createdAt || 0);
        var db = Number(b.createdAt || 0);
        if (da !== db) return da - db;
        var ia = String(a.id || '');
        var ib = String(b.id || '');
        return ia < ib ? -1 : (ia > ib ? 1 : 0);
    });
    return out;
}

// Ordered prose body from a bubble list. Stamped bubbles carry their in-story stamp
// inline (the only place a stamp reaches context), so a merge preserves them.
function buildJournalBody(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    // [CE-STRIP v2.0.x] In-story stamps removed — Clock cut. Plain text join only.
    return (bubbles || []).map(function(b) {
        return (b.text || '').trim();
    }).filter(Boolean).join('\n\n');
}

function buildActiveJournalText(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    const body = buildJournalBody(bubbles, cfg);
    return body ? ('The story so far:\n\n' + body) : '';
}

function buildArchiveJournalText(bubbles: JournalBubble[], cfg: GlobalConfig): string {
    const body = buildJournalBody(bubbles, cfg);
    return body ? ('The story so far (archived):\n\n' + body) : '';
}

// Update an existing lore entry, or (re)create it if the id is missing/stale
// (e.g. the user deleted it in NAI's lorebook UI). Returns the live entry id.
async function ensureJournalEntry(existingId: string | undefined, spec: Partial<LorebookEntry>): Promise<string> {
    if (existingId) {
        try {
            const cur = await api.v1.lorebook.entry(existingId);
            if (cur) { await api.v1.lorebook.updateEntry(existingId, spec); return existingId; }
        } catch (e) { /* fall through and recreate */ }
    }
    return await api.v1.lorebook.createEntry(spec);
}

// Re-project bubbles onto the two lorebook entries. Best-effort: never throws,
// mutates state.activeLoreId / state.archiveLoreId in place. Does NOT save —
// persistJournal() owns the single authoritative save after ids settle.
async function syncJournalLore(state: JournalState): Promise<void> {
    try {
        const cfg = await loadConfig();
        const active   = (state.bubbles || []).filter(function(b) { return !b.archived; });
        const archived = (state.bubbles || []).filter(function(b) { return b.archived; });

        const activeText = buildActiveJournalText(active, cfg);
        const hasActive  = activeText.trim().length > 0;

        // The Always-On entry only force-activates when it has content; empty, it
        // is disabled so a lone "The story so far:" header never enters context.
        state.activeLoreId = await ensureJournalEntry(state.activeLoreId, {
            displayName: 'The story so far',
            keys: [],
            text: activeText,
            forceActivation: hasActive,
            enabled: hasActive
        });

        // Archive entry is created lazily — only once something is archived (or it
        // already exists) — so untouched stories don't accrue an empty keyless entry.
        if (archived.length > 0 || state.archiveLoreId) {
            state.archiveLoreId = await ensureJournalEntry(state.archiveLoreId, {
                displayName: 'Journal — Archived (unarchive to restore)',
                keys: [],
                text: buildArchiveJournalText(archived, cfg),
                forceActivation: false,
                enabled: false
            });
        }
    } catch (e) {
        api.v1.error('[AE:journal] syncJournalLore:', e);
    }
}

// Single persistence path for every mutator: project to lore, then one save.
async function persistJournal(state: JournalState): Promise<JournalState> {
    await syncJournalLore(state);
    await saveJournal(state);
    return state;
}



// [JRNL-STAMP] STAMPED AT THE WRITE, in all three add paths, because the in-world clock
// at the moment of writing is the only moment it can be known -- a stamp derived later
// would be the time the author happened to open the surface. One historyStorage read per
// added entry, which is a verb the author invoked, not a per-turn cost.
async function journalAddBubble(text: string): Promise<JournalState> {
    const state = await loadJournal();
    const t = (text || '').trim();
    if (!t) return state;
    let jaT = 0;
    try { jaT = await ceClockLoad(); } catch (eJa) { jaT = 0; }
    state.bubbles.push({ id: api.v1.uuid(), text: t, createdAt: Date.now(), archived: false, storyT: jaT });
    return await persistJournal(state);
}

async function journalUpdateBubble(id: string, text: string): Promise<JournalState> {
    const state = await loadJournal();
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.text = (text || '').trim();
    return await persistJournal(state);
}

async function journalDeleteBubble(id: string): Promise<JournalState> {
    const state = await loadJournal();
    state.bubbles = state.bubbles.filter(function(x) { return x.id !== id; });
    return await persistJournal(state);
}


async function journalSetArchived(id: string, archived: boolean): Promise<JournalState> {
    const state = await loadJournal();
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.archived = !!archived;
    return await persistJournal(state);
}

// Merge-down: append all non-archived bubbles (in order) into a single bubble.
// Archived bubbles are untouched. Inline stamps survive via buildJournalBody.
async function journalMergeDown(): Promise<JournalState> {
    const state = await loadJournal();
    const active = state.bubbles.filter(function(b) { return !b.archived; });
    if (active.length <= 1) return state;
    const mergedText = buildJournalBody(active, await loadConfig());
    const earliest = active.reduce(function(m, b) { return b.createdAt < m ? b.createdAt : m; }, active[0].createdAt);
    const merged: JournalBubble = { id: api.v1.uuid(), text: mergedText, createdAt: earliest, archived: false };
    const archived = state.bubbles.filter(function(b) { return b.archived; });
    state.bubbles = [merged].concat(archived);
    return await persistJournal(state);
}

// ── Generation verbs (story-aware, so voice matches the current model/style) ──
// Both run in 'background' mode and suppress this script's own context hooks so
// the journal doesn't re-inject itself while being rewritten.

async function journalGenerateRewrite(text: string): Promise<string | null> {
    const src = (text || '').trim();
    if (!src) return null;
    try {
        const cfg = await loadConfig();
        const sys = [
            (cfg.generalStyle || '').trim(),
            '',
            'Rewrite the player\'s journal note below in the narrative voice of this story.',
            'Absolute priority: preserve every fact, name, event, number, and decision exactly as written \u2014 invent nothing, omit nothing.',
            'Be token-efficient: tighten wording and cut filler while keeping all content.',
            'Past tense, third-person recap voice. Output ONLY the rewritten note \u2014 no preamble, no quotes, no commentary.'
        ].filter(Boolean).join('\n');
        const maxTok = Math.max(120, Math.min(700, Math.ceil(src.length / 3) + 80));
        const resp = await api.v1.generateWithStory(
            [ { role: 'system', content: sys }, { role: 'user', content: src } ],
            { model: 'glm-4-6', max_tokens: maxTok, temperature: 0.7 },
            { suppressScriptHooks: 'self', contextLimitReduction: 600 },
            undefined,
            'background'
        );
        if (resp && resp.choices && resp.choices.length > 0) return (resp.choices[0].text || '').trim() || null;
        return null;
    } catch (e) { api.v1.error('[AE:journal] rewrite:', e); return null; }
}

async function journalGenerateCompress(text: string): Promise<string | null> {
    const src = (text || '').trim();
    if (!src) return null;
    try {
        const cfg = await loadConfig();
        const sys = [
            (cfg.generalStyle || '').trim(),
            '',
            'Compress the player\'s journal note below into a shorter recap for long-term memory.',
            'Keep the load-bearing details: names, places, relationships, commitments, and outcomes. Drop atmosphere and repetition.',
            'Aim for roughly half the length or less. Past tense, plain and dense.',
            'Output ONLY the compressed recap \u2014 no preamble, no quotes, no commentary.'
        ].filter(Boolean).join('\n');
        const maxTok = Math.max(60, Math.min(400, Math.ceil(src.length / 6) + 40));
        const resp = await api.v1.generateWithStory(
            [ { role: 'system', content: sys }, { role: 'user', content: src } ],
            { model: 'glm-4-6', max_tokens: maxTok, temperature: 0.5 },
            { suppressScriptHooks: 'self', contextLimitReduction: 600 },
            undefined,
            'background'
        );
        if (resp && resp.choices && resp.choices.length > 0) return (resp.choices[0].text || '').trim() || null;
        return null;
    } catch (e) { api.v1.error('[AE:journal] compress:', e); return null; }
}

// ============================================================================
// SECTION 10c — PER-CHARACTER JOURNAL  [CHARJOURNAL]
// Same bubble shape and verb set as Section 10b's player journal, scoped to one
// character instead of the whole story. The key difference: NO dedicated lorebook
// entry pair. Active bubbles fold straight into that character's OWN lorebook
// entry via buildCharDynamicBlock (see LOREFOLD, Section 6-ish) as one more
// toggleable field — same "rebuilt fresh every generation" treatment equipment/
// conditions already get, gated by cfg.lorebookFields.journal. Rewrite/compress
// reuse journalGenerateRewrite/journalGenerateCompress directly (pure text
// transforms with no journal-identity dependency — nothing to duplicate).
// Renderer lives in Section 27 (openCharJournalModal) so the bridge can drive the
// same verbs over the AE_CHAR_JOURNAL_* message pair.
// ============================================================================

async function loadCharJournal(charId: string): Promise<CharJournalState> {
    try {
        const raw = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_JOURNAL_PFX + charId, null);
        if (raw && typeof raw === 'object' && Array.isArray((raw as any).bubbles)) {
            const s = raw as CharJournalState;
            // [JRNL-CHRONO] The single sort point for every character journal.
            s.bubbles = _ceJournalChrono(s.bubbles) as CharJournalBubble[];
            return s;
        }
    } catch (e) { api.v1.error('[AE:charjournal] loadCharJournal:', e); }
    return { bubbles: [] };
}

async function saveCharJournal(charId: string, state: CharJournalState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_CHAR_JOURNAL_PFX + charId, {
            bubbles: (state.bubbles || []).filter(Boolean)
        });
    } catch (e) { api.v1.error('[AE:charjournal] saveCharJournal:', e); }
}

// Single persistence path for every mutator. No lorebook-lore sync step (unlike
// the main journal's persistJournal) — buildCharDynamicBlock reads storage fresh
// every generation, same as conditions/equipment, so there's nothing to pre-sync.
async function persistCharJournal(charId: string, state: CharJournalState): Promise<CharJournalState> {
    await saveCharJournal(charId, state);
    return state;
}



// -- Faction journal  [F-26] --------------------------------------------------
// CharJournalState's shape reused verbatim rather than a parallel type: a bubble is a
// bubble, and a second interface saying the same four fields is how two journals come to
// disagree about what archived means. _ceJournalChrono is the same single sort point.
async function loadFacJournal(factionId: string): Promise<CharJournalState> {
    try {
        const raw = await api.v1.storyStorage.getOrDefault(STORAGE_FAC_JOURNAL_PFX + factionId, null);
        if (raw && typeof raw === 'object' && Array.isArray((raw as any).bubbles)) {
            const s = raw as CharJournalState;
            s.bubbles = _ceJournalChrono(s.bubbles) as CharJournalBubble[];
            return s;
        }
    } catch (e) { api.v1.error('[AE:facjournal] load:', e); }
    return { bubbles: [] };
}

async function saveFacJournal(factionId: string, state: CharJournalState): Promise<void> {
    try {
        await api.v1.storyStorage.set(STORAGE_FAC_JOURNAL_PFX + factionId, {
            bubbles: (state.bubbles || []).filter(Boolean)
        });
    } catch (e) { api.v1.error('[AE:facjournal] save:', e); }
}

async function facJournalAdd(factionId: string, text: string): Promise<CharJournalState> {
    let st = await loadFacJournal(factionId);
    let t = (text || '').trim();
    if (!t) return st;
    let faT = 0;
    try { faT = await ceClockLoad(); } catch (eFa) { faT = 0; }
    st.bubbles.push({ id: api.v1.uuid(), text: t, createdAt: Date.now(), archived: false, storyT: faT });
    await saveFacJournal(factionId, st);
    return st;
}

async function facJournalUpdate(factionId: string, id: string, text: string): Promise<CharJournalState> {
    let st = await loadFacJournal(factionId);
    let b = st.bubbles.find(function(x) { return x.id === id; });
    if (b) b.text = (text || '').trim();
    await saveFacJournal(factionId, st);
    return st;
}

async function facJournalDelete(factionId: string, id: string): Promise<CharJournalState> {
    let st = await loadFacJournal(factionId);
    st.bubbles = st.bubbles.filter(function(x) { return x.id !== id; });
    await saveFacJournal(factionId, st);
    return st;
}

async function facJournalSetArchived(factionId: string, id: string, archived: boolean): Promise<CharJournalState> {
    let st = await loadFacJournal(factionId);
    let b = st.bubbles.find(function(x) { return x.id === id; });
    if (b) b.archived = !!archived;
    await saveFacJournal(factionId, st);
    return st;
}

async function charJournalAddBubble(charId: string, text: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const t = (text || '').trim();
    if (!t) return state;
    let cjT = 0;
    try { cjT = await ceClockLoad(); } catch (eCj) { cjT = 0; }
    state.bubbles.push({ id: api.v1.uuid(), text: t, createdAt: Date.now(), archived: false, storyT: cjT });
    return await persistCharJournal(charId, state);
}

async function charJournalUpdateBubble(charId: string, id: string, text: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.text = (text || '').trim();
    return await persistCharJournal(charId, state);
}

async function charJournalDeleteBubble(charId: string, id: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    state.bubbles = state.bubbles.filter(function(x) { return x.id !== id; });
    return await persistCharJournal(charId, state);
}

async function charJournalSetArchived(charId: string, id: string, archived: boolean): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const b = state.bubbles.find(function(x) { return x.id === id; });
    if (b) b.archived = !!archived;
    return await persistCharJournal(charId, state);
}

async function charJournalMergeDown(charId: string): Promise<CharJournalState> {
    const state = await loadCharJournal(charId);
    const active = state.bubbles.filter(function(b) { return !b.archived; });
    if (active.length <= 1) return state;
    const mergedText = active.map(function(b) { return (b.text || '').trim(); }).filter(Boolean).join('\n\n');
    const earliest = active.reduce(function(m, b) { return b.createdAt < m ? b.createdAt : m; }, active[0].createdAt);
    const merged: CharJournalBubble = { id: api.v1.uuid(), text: mergedText, createdAt: earliest, archived: false };
    const archived = state.bubbles.filter(function(b) { return b.archived; });
    state.bubbles = [merged].concat(archived);
    return await persistCharJournal(charId, state);
}


// ============================================================================
// SECTION 10d — CAST & WORLD LOREBOOKS
// Two always-on keyless entries the engine composes: a DRAMATIS PERSONAE (who exists in
// this story) and a WORLD outline (the geography, with the descriptions the author already
// wrote). Shape copied from syncJournalLore (10b): forceActivation gated on content, entry
// id persisted, silently recreated if deleted in NAI's own lorebook UI.
//
// [D-07] THE ROSTER IS EVERYONE, protagonist first and labelled, absent characters carrying
// a description and a place, present characters carrying a bare name. It was absent-only
// until v3.0.56; buildSceneLorebookActivation does force-activate every present character's
// FULL dossier, which is why their row here is thin rather than why they were omitted.
// It is ordered LAST among lorebook entries (onBeforeContextBuild, the only
// lorebookEntryOrder writer in the file) because it changes faster than the identity
// entries around it.
//
// THE GEOGRAPHY CLOSES A REAL GAP -- three holes, all verified in code:
//   1. buildEntityLorebookContent returns lorebookText ONLY. Its comment excludes
//      `description` because it "already injects via the world-state block" -- but CTX-CUT
//      deleted that block in earlier. The description has reached context nowhere since.
//   2. createLinkedEntityLorebookEntry REFUSES to create an entry without lorebookText, so
//      a place with a description and no lore text has nothing to activate.
//   3. Activation is IMMEDIATE-ROOM-ONLY, no ancestor walk. A room says nothing about the
//      building, district or city containing it.
// This entry is the only thing that will ever inject a location description.
//
// A PROJECTION, NOT A SECOND COPY. Editing the entry by hand is pointless -- the next sync
// overwrites it -- which the displayName says out loud. Options and exclusions live on the
// state record; see CastLoreState for why they are not on the records they name.
// ============================================================================

async function loadCastLore(): Promise<CastLoreState> {
    var d: CastLoreState = { castOn: true, locOn: true, castTier: 0, locDepth: 0,
                             castExclude: [], locExclude: [] };
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_CAST_LORE, null);
        if (raw && typeof raw === 'object') {
            // `!== false` on both switches: a record written before a switch existed
            // means ON, which is the documented default. Same rule cfg.lorebookFields
            // readers already use.
            d.castOn = raw.castOn !== false;
            d.locOn = raw.locOn !== false;
            d.castTier = Number(raw.castTier) || 0;
            d.locDepth = Number(raw.locDepth) || 0;
            d.castExclude = (raw.castExclude || []).filter(Boolean).map(String);
            d.locExclude = (raw.locExclude || []).filter(Boolean).map(String);
            d.castLoreId = raw.castLoreId;
            d.locLoreId = raw.locLoreId;
            d.lastCastText = raw.lastCastText;
            d.lastLocText = raw.lastLocText;
        }
    } catch (e) { api.v1.error('[AE:castlore] load:', e); }
    return d;
}

async function saveCastLore(st: CastLoreState): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_CAST_LORE, st); }
    catch (e) { api.v1.error('[AE:castlore] save:', e); }
}

// Ancestor at a given depth from the ROOT, walking up the location tree. Returns '' when
// the chain is shorter than `tier` -- a character standing at the top of the world has no
// tier-2 ancestor, and comparing '' to '' would wrongly match every other such character,
// so callers treat '' as \"cannot answer\" and include rather than exclude. Laziness fails
// toward stability: a filter that cannot decide does not drop anyone.
function _ceAncestorAtTier(byId: any, startId: string, tier: number): string {
    if (tier <= 0) return '';
    var chain: string[] = [];
    var cur = String(startId || '');
    var guard = 0;
    while (cur && guard++ < 1000) {
        chain.unshift(cur);
        var m: any = byId[cur];
        if (!m) break;
        cur = String(m.parentId || '');
    }
    return (chain.length >= tier) ? chain[tier - 1] : '';
}

// One line per character: name, then whatever identifies them, then where they are.
// briefDescription FIRST, occupationRole as the fallback -- brief is the field the
// author wrote for exactly this purpose and the one this whole entry exists to give a
// destination to. A character with neither still gets their name and their location,
// which is more than the model had before.
// [D-07] LINES, NOT BULLETS. A bullet is a document convention, and every convention that
// reaches context gets imitated -- the same lesson CHARCHAT-CTX-BRACE cost a version to
// learn from braces. This entry sits near a prose Author's Note in a prose story; a list
// marker teaches the model it is reading a document rather than knowing a cast.
//
// THE ROSTER IS NOW EVERYONE, not only the absent. The protagonist heads it, labelled.
// PRESENT CHARACTERS GET A BARE NAME and this is the deliberate half: their full dossier
// is already force-activated by buildSceneLorebookActivation and the Author's Note names
// them again, so a third description here would be the same person at three fidelities in
// one prompt. The bare name still does this entry's actual job, which is telling the model
// that person EXISTS. (CE-AE-PLAN open question 3 -- provisional, revisit with live text.)
function buildCastLoreText(rows: any[]): string {
    if (!rows.length) return '';
    var out: string[] = ['The people of this story:'];
    for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var line = String(r.name || 'Unnamed');
        // The protagonist's label rides the SAME em-dash shape as everyone else's rather
        // than getting a sentence of its own: two grammars in one block is a second
        // convention for the model to notice, and the whole point of D-07 is that this
        // entry reads as a list of people rather than as a document.
        if (r.isProtagonist) line += ', the protagonist';
        else if (r.present) { out.push(line); continue; }
        if (r.what) line += ' \u2014 ' + String(r.what);
        if (r.where) line += ' (' + String(r.where) + ')';
        out.push(line);
    }
    return out.join('\n');
}

// The geography as an indented outline. Indentation carries containment, which is
// cheaper in tokens than repeating \"inside X\" on every line and reads the way a model
// already expects a hierarchy to read.
// GAZETTEER, NOT ORG CHART  [GAZETTEER]
// WAS an indented bullet outline with the description hung off the name as ": desc". That
// shape communicates hierarchy TYPOGRAPHICALLY, which is how a person reads a file tree and
// not how a model reads a place, and it demoted the description -- the only part carrying
// any actual information -- to a trailing fragment.
//
// HIERARCHY IS DELIBERATELY DROPPED, and this is the sharp decision rather than an
// oversight. The map's parent link is a LAYOUT relation, not a semantic one: a live world
// has every court parented under the Abyssal Churn because the author wanted the Churn
// encircling everything on the graph, while that world's own memory text says the Churn is
// "not a political court" and borders the realm rather than containing it. Indentation is
// vague enough to survive being wrong. A containment SENTENCE is not -- "Within the Churn
// stand the Crimson Hall and the Platinum Choir" is a claim, and it would be false.
// So: parentId stays a layout channel and DESCRIPTION is the semantic channel. An author
// whose nesting means something writes it in the description, where it is a fact they
// stated rather than one we inferred. One fact, one place.
//
// A PLACE WITH NO DESCRIPTION CONTRIBUTES ONLY A NAME, which is fine in a bullet list and
// awkward as a stub paragraph. Those fold into a single closing enumeration instead of each
// getting a line of their own. That makes the description field earn its keep: describe a
// place and it gets a paragraph, leave it blank and it gets three words in a list. On the
// world that motivated this, where no location has a description yet, the whole entry
// collapses from seven indented lines to one sentence.
function buildWorldLoreText(rows: any[]): string {
    if (!rows.length) return '';
    var described: string[] = [];
    var bare: string[] = [];
    var i = 0;
    for (i = 0; i < rows.length; i++) {
        var r = rows[i];
        var nm = String((r && r.name) || '').trim() || 'Unnamed';
        var ds = String((r && r.desc) || '').trim();
        if (ds) {
            // Name as a sentence lead-in rather than a heading: it reads as reference prose,
            // which is what the lorebook tier is for, and it keeps the description as the
            // body of the entry instead of an appendix to a label.
            described.push(nm + '. ' + (/[.!?\u2026]$/.test(ds) ? ds : (ds + '.')));
        } else {
            bare.push(nm);
        }
    }
    var out: string[] = [];
    if (described.length) out.push('Places in this world.');
    for (i = 0; i < described.length; i++) out.push(described[i]);
    if (bare.length) {
        out.push((described.length ? 'Also in this world: ' : 'Places in this world: ')
            + _ceJoinList(bare) + '.');
    }
    return out.join('\n');
}

// Oxford-comma list join. Small, but it is the difference between prose and a dump, and
// this is the second place that wanted one -- kept here as the single copy so a third
// caller does not write its own.
function _ceJoinList(items: string[]): string {
    if (!items.length) return '';
    if (items.length === 1) return items[0];
    if (items.length === 2) return items[0] + ' and ' + items[1];
    return items.slice(0, items.length - 1).join(', ') + ', and ' + items[items.length - 1];
}

// Build the requested texts from live records. Pure read + compose -- no lorebook calls,
// so it is safe to call from a preview path as well as from the sync.
//
// `want` IS NOT AN OPTIMISATION FLAG, IT IS THE COST MODEL, and getting this wrong is
// what the first draft of this section did. The two halves have completely different
// inputs and completely different prices:
//   CAST  -- depends on PRESENCE, and is built entirely from loadIndex + loadEntityIndex.
//            Two reads, no per-record loads, and it must be rebuilt whenever anyone moves.
//   WORLD -- depends on EntityRecord.description, which is NOT on EntityMeta, so it costs
//            one loadEntity per surviving location. It does NOT depend on presence at all
//            and does not change when the camera walks through a room.
// Rebuilding both on the presence choke point therefore meant N entity reads every time
// the scene moved, to produce a string that could not possibly have changed. The world
// half is driven off saveEntity instead -- see queueCastLoreSync.
// A half that is not requested returns its LAST WRITTEN text, so the dirty check below
// compares like with like and a cast-only run cannot blank the world entry.
async function buildCastLoreTexts(st: CastLoreState, want?: string): Promise<{ cast: string; world: string }> {
    var doCast = (want !== 'world');
    var doWorld = (want !== 'cast');
    var castText = doCast ? '' : String(st.lastCastText || '');
    var worldText = doWorld ? '' : String(st.lastLocText || '');
    try {
        var metas: any[] = await loadEntityIndex();
        var byId: any = {};
        var i = 0;
        for (i = 0; i < (metas || []).length; i++) {
            if (metas[i] && metas[i].id) byId[String(metas[i].id)] = metas[i];
        }

        if (st.castOn && doCast) {
            var camLoc: any = '';
            try { camLoc = await loadProtagonistLocation(); } catch (eC) { camLoc = ''; }
            var camAnchor = _ceAncestorAtTier(byId, String(camLoc || ''), st.castTier);
            var cIdx: any[] = await loadIndex();
            var exC: any = {};
            for (i = 0; i < (st.castExclude || []).length; i++) exC[String(st.castExclude[i])] = 1;
            // [D-07] THE PRESENT AND THE PROTAGONIST ARE NO LONGER SKIPPED. The old rule
            // was absent-cast-only, on the reasoning that a present character's dossier is
            // already in context; that is still true, and is why their row is a bare name
            // (see buildCastLoreText) rather than why they are omitted. A roster that
            // silently drops whoever is standing in the room is not a roster.
            // THE REGION FILTER STILL APPLIES, and the protagonist and the present are
            // exempt from it: the camera defines the region, so the character it belongs
            // to and everyone in the room with it are in it by construction.
            var rows: any[] = [];
            var protagRow: any = null;
            for (i = 0; i < (cIdx || []).length; i++) {
                var cm: any = cIdx[i];
                if (!cm || !cm.id) continue;
                if (cm.active === false) continue;      // archived and dead stay out
                if (exC[String(cm.id)]) continue;
                var loc = String(cm.currentLocationId || '');
                var exempt = !!cm.isProtagonist || !!cm.scenePresent;
                if (!exempt && st.castTier > 0 && camAnchor) {
                    var anch = _ceAncestorAtTier(byId, loc, st.castTier);
                    // '' means the chain was too short to answer -- include, per
                    // _ceAncestorAtTier's own note.
                    if (anch && anch !== camAnchor) continue;
                }
                var row: any = {
                    name: String(cm.name || 'Unnamed'),
                    isProtagonist: !!cm.isProtagonist,
                    present: !!cm.scenePresent,
                    what: String(cm.briefDescription || '').trim() || String(cm.occupationRole || '').trim(),
                    where: loc ? String((byId[loc] || {}).name || '') : ''
                };
                // Collected separately rather than sorted afterwards: there is at most one
                // (setProtagonist enforces it) and it goes first regardless of index order.
                if (row.isProtagonist) { protagRow = row; continue; }
                rows.push(row);
            }
            if (protagRow) rows.unshift(protagRow);
            castText = buildCastLoreText(rows);
        }

        if (st.locOn && doWorld) {
            var exL: any = {};
            for (i = 0; i < (st.locExclude || []).length; i++) exL[String(st.locExclude[i])] = 1;
            // Depth is computed by walking to the root rather than trusted from anywhere:
            // EntityMeta carries no depth, and the map's own tree is not built here.
            function depthOf(id: string): number {
                var d = 0; var cur = String(id || ''); var guard = 0;
                while (cur && guard++ < 1000) {
                    var m: any = byId[cur];
                    if (!m || !m.parentId) break;
                    cur = String(m.parentId); d++;
                }
                return d;
            }
            // Depth-first from each root so the outline reads as a tree rather than as
            // index order. Children of an excluded parent are still emitted -- excluding a
            // place means \"do not list this one\", not \"hide everything inside it\", which
            // would make one checkbox silently delete a subtree from context.
            var kidsOf: any = {};
            var roots: any[] = [];
            for (i = 0; i < (metas || []).length; i++) {
                var em: any = metas[i];
                if (!em || em.type !== 'location') continue;
                // Hidden places are functional, not geography. The Graveyard is not a
                // location the story is set in and listing it would be a spoiler about
                // the engine rather than a fact about the world.
                if (ceMapKindOf(em.mapKind) === 'hidden') continue;
                var pid = String(em.parentId || '');
                if (pid && byId[pid] && byId[pid].type === 'location') {
                    if (!kidsOf[pid]) kidsOf[pid] = [];
                    kidsOf[pid].push(em);
                } else { roots.push(em); }
            }
            var lrows: any[] = [];
            function walk(node: any): void {
                var d = depthOf(String(node.id));
                if (st.locDepth > 0 && d >= st.locDepth) return;
                if (!exL[String(node.id)]) {
                    // `id` RIDES ALONG BECAUSE THE DESCRIPTION IS NOT ON THE META. EntityMeta
                    // carries no description field, so the row is completed by a record read
                    // below and needs to know which record.
                    lrows.push({ id: String(node.id), name: String(node.name || 'Unnamed'),
                                 depth: d, desc: '' });
                }
                var kids: any[] = kidsOf[String(node.id)] || [];
                for (var k = 0; k < kids.length; k++) walk(kids[k]);
            }
            for (i = 0; i < roots.length; i++) walk(roots[i]);
            // ONE READ PER SURVIVING ROW, and only for rows that survived the depth cap and
            // the exclusions -- which is why the walk runs first. A place with no
            // description still earns its line: the NAME and the NESTING are the geography.
            for (i = 0; i < lrows.length; i++) {
                var rec: any = null;
                try { rec = await loadEntity(String(lrows[i].id)); } catch (eR) { rec = null; }
                if (rec) lrows[i].desc = String(rec.description || '').trim();
            }
            worldText = buildWorldLoreText(lrows);
        }
    } catch (e) { api.v1.error('[AE:castlore] build:', e); }
    return { cast: castText, world: worldText };
}

// Project both texts onto their entries. ensureJournalEntry is reused rather than
// reimplemented: it is exactly \"update this id, or make a new one if it is gone\", which
// is the same self-healing both of these need and the same one the journal needed.
// MUTATES st IN PLACE and does NOT save -- syncCastLore owns the single save, matching
// syncJournalLore/persistJournal's split.
async function projectCastLore(st: CastLoreState, texts: { cast: string; world: string }): Promise<void> {
    try {
        var hasCast = !!(st.castOn && texts.cast.trim());
        if (hasCast || st.castLoreId) {
            st.castLoreId = await ensureJournalEntry(st.castLoreId, {
                displayName: 'Dramatis Personae (built by Character Engine)',
                keys: [], text: texts.cast,
                forceActivation: hasCast, enabled: hasCast
            });
        }
        var hasLoc = !!(st.locOn && texts.world.trim());
        if (hasLoc || st.locLoreId) {
            st.locLoreId = await ensureJournalEntry(st.locLoreId, {
                displayName: 'The World (built by Character Engine)',
                keys: [], text: texts.world,
                forceActivation: hasLoc, enabled: hasLoc
            });
        }
    } catch (e) { api.v1.error('[AE:castlore] project:', e); }
}

// THE DIRTY CHECK IS THE POINT. This runs off recalculateScenePresence, which fires on
// every scene move, every travel, every add/remove and once at the end of every dynamic
// pass. Without the comparison, a camera walking through five rooms would rewrite two
// lorebook entries five times for identical content.
// `force` skips the check for the Settings surface, whose whole job is to change the
// options the text is built FROM -- the text can be identical after an option change
// (turning a list off, for instance, empties it and the previous empty matches) and the
// ENTRY still has to be re-projected to pick up enabled/forceActivation.
async function syncCastLore(want?: string, force?: boolean): Promise<void> {
    try {
        var st = await loadCastLore();
        var texts = await buildCastLoreTexts(st, want);
        if (!force && texts.cast === String(st.lastCastText || '')
                   && texts.world === String(st.lastLocText || '')) return;
        await projectCastLore(st, texts);
        st.lastCastText = texts.cast;
        st.lastLocText = texts.world;
        await saveCastLore(st);
    } catch (e) { api.v1.error('[AE:castlore] sync:', e); }
}

// COALESCED, NOT AWAITED, on an in-flight/pending pair rather than a timer. A timer is
// wrong here for a measured reason: api.v1.timers.setTimeout returns a Promise<number>
// whose id arrives AFTER the callback is scheduled, so cancel races are unwriteable. The
// work is naturally bursty anyway -- commitTravel alone recalculates presence more than
// once.
// NOT BRIDGE-GATED. This writes the lorebook, which is the engine's own; gating it on a
// bridge would mean a bridge-less user silently got no roster.
// THE PENDING SLOT ACCUMULATES HALVES, IT DOES NOT OVERWRITE THEM. A cast request landing
// while a world run is in flight must not be answered by re-running world only; the two
// collapse to 'all'. A boolean would be enough only if there were one kind of work.
var _ceCastLoreInFlight = false;
var _ceCastLorePending = '';
function queueCastLoreSync(want?: string): void {
    var w = (want === 'cast' || want === 'world') ? want : 'all';
    if (_ceCastLoreInFlight) {
        _ceCastLorePending = (_ceCastLorePending && _ceCastLorePending !== w) ? 'all' : w;
        return;
    }
    _ceCastLoreInFlight = true;
    syncCastLore(w)
        .catch(function(e: any) { aeLog('[AE:castlore] queued sync err:', e); })
        .then(function() {
            _ceCastLoreInFlight = false;
            if (_ceCastLorePending) {
                var next = _ceCastLorePending;
                _ceCastLorePending = '';
                queueCastLoreSync(next);
            }
        });
}

// ============================================================================
// SECTION 12 — CHARACTER SNAPSHOT GENERATION
//
// CHARACTER SNAPSHOT (GLM-backed — AI generation)
//    generateCharacterSnapshot: writes a present-tense appearance description
//    of a character as the protagonist encounters them. Used as scene flavor
//    text for the entity system's character-type nodes.
//
// NOTE — CONTEXT BUILDER SEPARATION:
// The injection sub-builders that feed into the Author's Note (buildCharInjection,
// buildMidRangeInjection, buildEphemeralInjection, charIsRelevant,
// buildEntityContextBlock, buildProtagonistInjection, buildDramatisPersonae)
// are NOT in this section. They live in Section 13 (Context Injection Builders)
// because they are pipeline components — the output of this section feeds them
// but they are architecturally distinct.
// ============================================================================

// ── Character Snapshot (AI generation) ───────────────────────────────────────

async function generateCharacterSnapshot(charRec: CharacterRecord, ent: EntityRecord, cfg: GlobalConfig): Promise<string | null> {
    // Generates a brief present-tense appearance description for a character
    // as encountered in their current location. Used by the entity system
    // for character-type nodes when a snapshot hasn't been generated yet.
    //
    // Uses api.v1.generateWithStory in 'background' mode so it runs without
    // surfacing a visible generation progress indicator.
    try {
        // Resolve location name for scene grounding
        let locationName = 'Unknown';
        let locationDesc = '';
        if (ent.parentId) {
            const locEnt = await loadEntity(ent.parentId);
            if (locEnt) { locationName = locEnt.name; locationDesc = locEnt.description || ''; }
        }

        // Resolve equipped item names for appearance context
        const equippedItems: string[] = [];
        for (const itemId of (charRec.equippedItemIds || [])) {
            try {
                const itemEnt = await loadEntity(itemId);
                if (itemEnt) equippedItems.push(itemEnt.name);
            } catch (ignoredErr) { /* non-fatal */ }
        }

        const idParts  = [charRec.gender, charRec.species, charRec.age, charRec.occupationRole].filter(Boolean);
        const idLine   = idParts.length > 0 ? ' (' + idParts.join(', ') + ')' : '';

        const sysPrompt = [
            cfg.generalStyle || '',
            '',
            `Write a brief present-tense description of ${charRec.name} as the protagonist notices them.`,
            '1 short paragraph. No internal thoughts, no dialogue, no summary statements.',
            '',
            'Capture:',
            '- Physical appearance including anything worn or carried',
            `- What they appear to be doing in ${locationName} (work here? live here? passing through? with the protagonist?)`,
            '- One behavioral or expressive detail reflecting their current state',
            '',
            'Concrete and specific. Show rather than tell.'
        ].join('\n');

        const userPrompt = [
            charRec.name + idLine,
            charRec.briefDescription         ? 'Brief: '     + charRec.briefDescription : '',
            charRec.physicalDescription      ? 'Appearance: ' + charRec.physicalDescription : '',
            charRec.background               ? 'Background: ' + charRec.background.slice(0, 100) : '',
            equippedItems.length > 0         ? 'Wearing/Carrying: ' + equippedItems.join(', ') : '',
            'Location: ' + locationName,
            locationDesc                     ? 'Setting: '    + locationDesc.slice(0, 80) : '',
            // [ENT-AUDIT] 'Thoughts: ' + ent.atmosphere REMOVED. It fed the body
            // entity's atmosphere to the emotion pass as if it were the character's inner
            // state -- a second accidental job for a field nothing wrote. Nothing replaces
            // it here: the emotion pass has the character's own record, which is where an
            // inner state would come from if one is wanted.
            charRec.ephemeral?.compressedLine ? 'State: '     + charRec.ephemeral.compressedLine : ''
        ].filter(Boolean).join('\n');

        const response = await api.v1.generateWithStory(
            [
                { role: 'system', content: sysPrompt },
                { role: 'user',   content: userPrompt }
            ],
            { model: 'glm-4-6', max_tokens: 200 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );

        if (response && response.choices && response.choices.length > 0) {
            return response.choices[0].text || null;
        }
        return null;
    } catch (e) {
        api.v1.error('[AE:knowledge] generateCharacterSnapshot:', e);
        return null;
    }
}

// ============================================================================
// SECTION 13 — CONTEXT INJECTION BUILDERS   [SEC:INJECTION]
// Everything that constructs content injected into the model's context window.
//
// ── THE INJECTION PIPELINE, END TO END ──────────────────────────────────────
// onBeforeContextBuild  ->  ceRunInjections() -> CE_INJECTIONS, the whole map. [D-17]
//   The table is the pipeline; read it, not this list. Rows today:
//     scene.lore    per scene-present character, their FULL dossier, force-activated
//     cast.order    Dramatis Personae ordered last among lorebook entries
//     an.arc        OFF -- no arc structure exists yet (CE-AE-PLAN open Q2)
//     an.place / an.present / an.thoughts / an.position / an.web / an.hooks
//   Row order IS the Author's Note order: D-08's arc, place, present, thoughts, hooks.
//
// onContextBuilt  ->  spliced before player input (highest recency weight)
//   Imperative block: pending GM note, pending knowledge query (each fires once)
//
// onContextBuilt  ->  replaces player input
//   #tagname -> 1d6 + skill modifier -> outcome line
//
// NOT IN THE MAP: runCharChatContextOverride replaces the whole prompt for a different
// mode rather than contributing to a slot.
//
// ── WHERE A LOCATION'S PROSE GOES  [ATMO] ───────────────────────────────────
// TWO FIELDS, TWO DESTINATIONS, AND THEY ARE NOT THE SAME TIER.
//   description  -- the gazetteer line. Feeds buildWorldLoreText (the World entry) and
//                   the generators. It reaches the Author's Note ONLY as ceAtmoFor's
//                   fallback, which exists so a story written before atmosphere did not
//                   silently lose the line it always had.
//   atmosphere   -- the location's own schedule, resolved at the current hour. THIS is
//                   what an.place injects once one is authored.
// THE FALLBACK DOUBLES THE CAMERA'S DESCRIPTION while it is in force: the World entry
// already lists that place, so the same sentence lands twice. That is unchanged from
// before this feature and is not a regression -- and authoring one hour of atmosphere
// ends it, which is the incentive the arrangement is meant to create.
//
// ── STILL WITHOUT A DESTINATION (flagged, not silently dropped) ─────────────
// Urgent hooks (tier 1-2) and background NPC web links. They lost their home when
// buildDramaContextBlock was deleted and have not been rehoused.
//
// ── DEFINED BUT NOT CALLED FROM THE PIPELINE ────────────────────────────────
// buildProtagonistInjection, buildEntityContextBlock, buildCharInjection,
// buildMidRangeInjection, buildEphemeralInjection. Preserved as utilities.
// ============================================================================

// [SEC:STATE] buildCharMacroExtras PHYSICALLY DELETED, with its two call sites'
// Object.assign arguments. It produced exactly two keys and BOTH WERE ALWAYS EMPTY:
// `res` and `conditionStates` were built by iterating char.charResourceDefs, an array
// with no writer anywhere in the file (see migrateCharacter's deletion note). The
// |conditionStates| macro therefore resolved to '' for every character since the day it
// shipped, and the only place its name survives is OLD_NPC_TEMPLATE_V28 -- a legacy
// string kept for migration DETECTION, never rendered.
// A real |states| macro, resolved from cfg.stateDefs and CharacterRecord.stateValues,
// lands with the conditions migration; it needs the config in hand, which is the one
// thing this function's signature could not carry.

function parseMacroTemplate(template: string, data: any): string {
    if (!template) return '';
    return template.replace(/\[([^\[\]]+)\]/g, function(match, inner) {
        let isValid = true;
        
        // Globally find and evaluate all |macro.path| tokens inside this specific bracket block
        const evaluatedInner = inner.replace(/\|([^\|]+)\|/g, function(macroMatch, path) {
            let val: any = data;
            const keys = path.trim().split('.');
            for (const k of keys) {
                if (val === undefined || val === null) break;
                val = val[k];
            }
            
            // If any token evaluates to empty/null, flag the entire bracket block for deletion
            if (val === undefined || val === null || String(val).trim() === '') {
                isValid = false;
                return '';
            }
            
            return String(val);
        });
        
        if (!isValid) return '';
        
        // Finalize block formatting
        return evaluatedInner.replace(/\\n/g, '\n');
    });
}


// NOTE FOR ASSEMBLY: STORAGE_RETRY_CHARS = 'ae_retry_chars' (used in Section 15's
// runDynamicEngine) was declared mid-file at line 8039 in the original alongside
// STORAGE_ENGINE_SKIP. Both belong in Section 2 constants. Add:
//   var STORAGE_RETRY_CHARS = 'ae_retry_chars';

// ── Per-character sub-builders ────────────────────────────────────────────────
// Legacy freeform injection helpers (buildProtagonistInjection, buildDramatisPersonae,
// buildCharInjection, buildMidRangeInjection, buildEphemeralInjection) retired.
// Dynamic prose values now consolidated cleanly in buildCharDynamicBlock and _ceSceneLines.

function charIsRelevant(c: CharacterRecord, activeEntryIds: Set<string>): boolean {
    // Returns true if a character should receive dynamic engine updates this turn.
    // A character is relevant if they are scene-present OR their lorebook entry fired.
    return c.active && c.scenePresent; // [E2] removed lorebook-entry clause
}

// [vNEXT] Dynamic-priority cap. Given the already-loaded character index and the
// configured cap, returns the Set of character ids permitted to run as dynamic this
// turn. Pure in-memory over the index metas — NO storage reads, so it costs nothing
// on the generation path beyond a sort of the present-dynamic subset.
//
// Eligible pool = active, scene-present, non-protagonist, non-static (static chars
// are already excluded from dynamics by their own gate; excluding them here too means
// they never occupy a cap slot). Ordering: ranked characters first by ascending rank
// (1 = highest priority), then unranked characters by name. Unranked present-dynamic
// characters DO consume slots, after all ranked ones. cap <= 0 means no cap — every
// eligible id is returned.
function computeDynamicAllowedSet(index: CharacterMeta[], cap: number): Set<string> {
    const eligible = (index || []).filter(function(m) {
        return m && m.active && m.scenePresent && !m.isProtagonist && !(m as any).isStatic;
    });
    if (!(cap > 0) || eligible.length <= cap) {
        // No cap, or everyone fits — allow all eligible.
        return new Set(eligible.map(function(m) { return m.id; }));
    }
    eligible.sort(function(a, b) {
        const ar = (typeof (a as any).dynamicPriorityRank === 'number' && (a as any).dynamicPriorityRank > 0) ? (a as any).dynamicPriorityRank : Infinity;
        const br = (typeof (b as any).dynamicPriorityRank === 'number' && (b as any).dynamicPriorityRank > 0) ? (b as any).dynamicPriorityRank : Infinity;
        if (ar !== br) return ar - br;                       // ranked ascending; unranked (Infinity) last
        return String(a.name || '').localeCompare(String(b.name || '')); // stable tiebreak
    });
    return new Set(eligible.slice(0, cap).map(function(m) { return m.id; }));
}

// [vNEXT] Assign (or clear) a character's dynamic-priority rank, enforcing "one
// character per rank" by swapping. If another character already holds newRank, they
// inherit the assignee's OLD rank (which may be undefined -> they become unranked).
// Pass newRank <= 0 or undefined to simply clear the assignee's rank (no swap).
// Writes only the (at most) two affected records. Returns nothing; callers refresh UI.
async function assignDynamicPriorityRank(charId: string, newRank: number | undefined): Promise<void> {
    try {
        const target = await loadCharacter(charId);
        if (!target) return;
        const oldRank = (typeof (target as any).dynamicPriorityRank === 'number' && (target as any).dynamicPriorityRank > 0) ? (target as any).dynamicPriorityRank : undefined;
        const wantRank = (typeof newRank === 'number' && newRank > 0) ? Math.floor(newRank) : undefined;

        if (wantRank === oldRank) return; // no change

        // Clear case: just drop the rank.
        if (wantRank === undefined) {
            (target as any).dynamicPriorityRank = undefined;
            await saveCharacter(target);
            return;
        }

        // Find whoever currently holds wantRank (excluding the target) via the index
        // (cheap — no full character loads for the scan).
        const idx = await loadIndex();
        const holderMeta = idx.find(function(m) { return m && m.id !== charId && (m as any).dynamicPriorityRank === wantRank; });

        if (holderMeta) {
            const holder = await loadCharacter(holderMeta.id);
            if (holder) {
                // Swap: holder takes the target's old rank (may be undefined -> unranked).
                (holder as any).dynamicPriorityRank = oldRank;
                await saveCharacter(holder);
            }
        }
        (target as any).dynamicPriorityRank = wantRank;
        await saveCharacter(target);
    } catch (e) {
        api.v1.error('[AE:dynrank] assignDynamicPriorityRank:', e);
    }
}

// [PICKER-ONE] openDynamicRankPicker WAS HERE AND IS DELETED. It was the last
// caller of openPickerModal (deleted in SECTION 4b this patch) and had had no door of its
// own since earlier, which RE-IMPLEMENTED it as CE_PICKER_DEFS.dynamicRank rather than
// calling it. The file header listed it as a deletion candidate; this is that deletion.
// assignDynamicPriorityRank, the verb it wrapped, is untouched and is what the picker def
// commits through.

// ── Primary builders ──────────────────────────────────────────────────────────

// [D-08] The four per-character line groups, computed in ONE roster pass and returned
// separately so CE_INJECTIONS can order them. Hooks are their own group because the Scene
// block puts them last; they used to be concatenated onto each thought line.
// Memoized on ctx by _ceSceneLinesFor -- four rows read this and the pass is expensive.
async function _ceSceneLines(ctx: any): Promise<{ thoughts: string[]; position: string[]; web: string[]; hooks: string[] }> {
    const cfg: GlobalConfig = ctx.cfg;
    const charIndex: any[] = ctx.charIndex;
    const presentMetas: any[] = ctx.presentMetas;
    const _wsHookLines: string[] = [];
    const _wsWebLines: string[] = [];
    const _wsOut: any = { thoughts: [], position: [], web: [], hooks: [] };
    const _wsDynCap = Number((cfg as any).maxDynamicCharacters) || 0;
    const _wsDynAllowed = computeDynamicAllowedSet(charIndex as any, _wsDynCap);

    // ── PER-CHARACTER THOUGHTS + CRITICAL HOOK ────────────────────────────────
    try {
        const presentChars: string[] = [];
        // [INJECT-TRACE] Per-character record of what was built and why, for the
        // summary log below. Built regardless of log-channel state (string ops only, no
        // storage/generation), so enabling the channel needs no re-run to become useful.
        const _wsTrace: string[] = [];
        // [POSITION] Emitted as its own group after the thought lines rather than
        // interleaved with them, matching how npcWeb is grouped below. Each entry is one
        // character's private reading of another, so two characters positioned on each
        // other produce TWO lines here, deliberately — that asymmetry is the feature.
        const _wsPosLines: string[] = [];

        for (const meta of presentMetas) {
            // [vNEXT] Under a dynamic cap, only inject for characters within the cap.
            if (_wsDynCap > 0 && !_wsDynAllowed.has(meta.id)) continue;
            const char = await loadCharacter(meta.id);
            if (!char) continue;

            // [HOOK-BAND] THREE BANDS, NO GAP. 1-2 ambient: available through the
            // |hookDescription| macro for a hand-edited npc template, absent from the
            // default. 3 and 4 inject their own line below. The percentage this replaced
            // put the ambient ceiling at 60 and the critical floor at 85, so tier 3 matched
            // neither and injected nothing at all -- a hook one rung from the cap was less
            // present in context than a fresh one.
            let hookDesc = '';
            if (char.hook && char.hook.pressureLevel < 3) hookDesc = char.hook.description;

            // [F-5] THE POSITION PASS THAT STOOD HERE IS GONE, not disabled. It fed
            // an.position; an.position is deleted, and a producer with no consumer is one
            // historyStorage read per present character per turn spent on a string nothing
            // reads. The logic moved WHOLE to _ceCharPositionLine, which the character fold
            // calls -- one implementation, living where it is used.

            // `any` because two non-record fields (reactionLine/intentLine) are assigned
            // onto it below. It was widened implicitly by buildCharMacroExtras'
            // Record<string, any> return until that function was deleted; stating the type
            // is what that deletion cost, and it is the honest shape -- this is a macro
            // data bag, not a character.
            const npcData: any = Object.assign({}, char, { hookDescription: hookDesc });
            // [BUGFIX earlier WORLDSTATE-STALE-THOUGHTS, per user's report] A character
            // with auto-thoughts turned OFF must not leak a snapshot
            // that's just sitting on the record from before the toggle was flipped, or
            // from an import/migration — char.ephemeral is NOT cleared when
            // the toggle goes off, they just stop being refreshed. Omitting the field
            // here (rather than special-casing the template string) is enough:
            // parseMacroTemplate already self-suppresses a bracket block whose
            // referenced macro resolves to undefined/empty (see its own comment above).
            // Mirrors the exact same per-character gate the retry queue already uses
            // (_rcType === 'eph' && autoThoughtsEnabled).
            // Object.assign above already made npcData a fresh object, so this cannot
            // mutate the loaded character record.
            if (!char.autoThoughtsEnabled) npcData.ephemeral = null;
            // [EPHEMERAL-REWIRE] Computed from npcData.ephemeral (post null-out
            // above, not char.ephemeral directly) so a character with auto-thoughts OFF
            // gets these blanked out too -- the same earlier stale-snapshot guard this
            // block already enforces for the rest of ephemeral, now covers the two new
            // fields rather than bypassing it.
            const _wsEph = npcData.ephemeral as EphemeralSnapshot | null;
            const _wsReaction = (_wsEph && _wsEph.emotionalResponse) ? _wsEph.emotionalResponse : '';
            const _wsRawIntent = (_wsEph && _wsEph.immediateDesire) ? _wsEph.immediateDesire : '';
            const _wsPursuitTier = _wsRawIntent ? await _ceReadPressure(char.id, 'pursuit') : 0;
            npcData.reactionLine = _wsReaction;
            npcData.intentLine = _wsRawIntent ? _ceFrameIntent(_wsRawIntent, _wsPursuitTier) : '';
            let thoughtsLine = parseMacroTemplate(cfg.contextTemplates.npc, npcData).trim();
            // Drop a thoughts line that rendered to nothing but the bare name.
            if (thoughtsLine === (char.name || '').trim()) thoughtsLine = '';

            // [CE-STRIP earlier CTX-CUT] Critical (85%+, unresolved) hook — now built
            // here instead of the onContextBuilt Imperative block. Urgent (60-84%)
            // hooks have no injection destination this pass (see Section 13 header).
            let hookLine = '';
            const topHook = char.hook;
            // [HOOK-BAND] >= 3, not >= 4. Tier 3 is injected and not critical; the
            // difference between them is |hookPressure|, which _ceFrameHookPressure leaves
            // empty until 4 and the template bracket then self-suppresses.
            if (topHook && topHook.pressureLevel >= 3 && topHook.description && topHook.description.trim()) {
                hookLine = parseMacroTemplate(cfg.contextTemplates.criticalHook, {
                    name: char.name,
                    hookDescription: topHook.description,
                    hookPressure: _ceFrameHookPressure(topHook.pressureLevel)
                }).trim();
            }

            // [D-08] Two groups, not one line. A character with a hook and no thought
            // still contributes the hook, which the old concatenation also allowed --
            // what changes is where it lands.
            if (thoughtsLine) presentChars.push(thoughtsLine);
            if (hookLine) _wsHookLines.push(hookLine);
            const combined = thoughtsLine || hookLine;
            // [INJECT-TRACE] Name the reason a character contributed nothing —
            // 'thoughts-off' and 'no-snapshot' look identical downstream but mean very
            // different things (a toggle vs. a generator that has not run or has failed).
            _wsTrace.push(char.name + '='
                + (combined ? ('ok'
                    + (npcData.intentLine ? '+intent(t' + _wsPursuitTier + ')' : '')
                    + (hookLine ? '+hook' : ''))
                  : (!char.autoThoughtsEnabled ? 'SKIP(thoughts-off)'
                     : (!char.ephemeral ? 'SKIP(no-snapshot)' : 'SKIP(empty-render)'))));
        }

        _wsOut.thoughts = presentChars;
        // [POSITION] Own group, after the thought lines. Kept out of presentChars
        // so a character whose thought line was suppressed (auto-thoughts off, no snapshot)
        // still injects their Position — the two are independent statements and one being
        // absent is not a reason to withhold the other.
        // [F-5] Kept as an empty list rather than removed from the shape: _ceSceneLines'
        // return type is read by _ceSceneLinesFor's four callers, and a missing key would be
        // a runtime undefined at each of them for no gain. The producer is gone; the slot
        // stays until the type is next revised.
        _wsOut.position = _wsPosLines;
        // [INJECT-TRACE] Until now NOTHING logged what actually reached the
        // Author's Note — '[AE:context]' appeared only inside error catches, so a
        // character silently omitted (static, over the dynamic cap, auto-thoughts off,
        // scene-absent, or simply never updated) was indistinguishable from one whose
        // line was injected and ignored by the model. Those two failures have completely
        // different fixes, which is exactly why this needs to be observable. Gated on the
        // 'context' log channel (/log context on) so it costs nothing when off.
        if (_wsTrace.length > 0) {
            aeLog('[AE:context] AN injection — ' + _wsTrace.length + ' present char(s): ' + _wsTrace.join(' | ')
                + ' | position lines=' + _wsPosLines.length);
        } else {
            aeLog('[AE:context] AN injection — no character lines built this turn.');
        }
    } catch (e) { api.v1.error('[AE:context] scene lines:', e); }

    // [LOREFOLD] NPC web — bilateral dynamics between two scene-present
    // characters, bundled into the AN alongside thoughts (user's call). Injected only
    // when BOTH parties are present, so the shared fact appears exactly once (no
    // per-character double injection) and only when contextually relevant. Sorted by
    // [WEB-FLATTEN] Unranked and unsorted: every qualifying link renders one
    // line via cfg.contextTemplates.npcWeb, in storage order. This is now the ONLY
    // npcWeb injection anywhere in the engine.
    try {
        const wsWeb = await loadNpcWeb();
        if (wsWeb && wsWeb.length > 0) {
            const wsPresentIds = new Set(presentMetas.map(function(m) { return m.id; }));
            const wsNameById = new Map<string, string>();
            for (const m of presentMetas) wsNameById.set(m.id, (m as any).name || '');
            const wsTpl = (cfg.contextTemplates as any).npcWeb || '';
            const wsLines: string[] = [];
            for (const wl of wsWeb) {
                if (!wsPresentIds.has(wl.charA_id) || !wsPresentIds.has(wl.charB_id)) continue;
                if (!wl.dynamic || !wl.dynamic.trim()) continue;
                const wsLine = parseMacroTemplate(wsTpl, {
                    nameA: wsNameById.get(wl.charA_id) || '',
                    nameB: wsNameById.get(wl.charB_id) || '',
                    dynamic: wl.dynamic
                }).trim();
                if (wsLine) wsLines.push(wsLine);
            }
            for (let wsI = 0; wsI < wsLines.length; wsI++) _wsWebLines.push(wsLines[wsI]);
        }
    } catch (eWeb) { api.v1.error('[AE:context] npc web injection:', eWeb); }

    _wsOut.web = _wsWebLines;
    _wsOut.hooks = _wsHookLines;
    return _wsOut;
}

// One computation per context build, shared by the four line rows.
async function _ceSceneLinesFor(ctx: any): Promise<any> {
    // The PROMISE is memoized, not its result: four rows call this, and caching after the
    // await would let a thrown pass be retried four times.
    if (!ctx._lines) ctx._lines = _ceSceneLines(ctx);
    return await ctx._lines;
}

// ════════════════════════════════════════════════════════════════════════════
// [SEC:INJECTION] THE INJECTION MAP  [D-17]
// ────────────────────────────────────────────────────────────────────────────
// EVERY WRITE INTO THE STORY-TURN CONTEXT IS A ROW HERE. One assignment site per
// slot, so the whole map is readable in one place and a new injection cannot be
// added anywhere else without showing up in this table.
//
// Two kinds:
//   'an'     build returns a string; the strings are joined, sentinel-wrapped and
//            appended to the Author's Note in row order.
//   'result' build returns a partial merged onto the hook's return value.
//
// Row order IS the Author's Note order, and the Scene block's order is D-08:
// arc, place, present, thoughts, hooks.
//
// NOT IN THE MAP, deliberately: runCharChatContextOverride. It REPLACES the whole
// prompt for a different mode rather than contributing to a slot, so listing it
// here would make the table describe something it does not control.
//
// `module` is reserved for CE_MODULES (D-16) and unread today. `off` marks a row
// declared but not wired -- see arc.
// ════════════════════════════════════════════════════════════════════════════
interface CeInjectionDef {
    id: string;
    // [F-12a] 'imperative' added. THREE KINDS, THREE SLOT LIFETIMES, which is the whole
    // point of D-06's sort: 'result' writes lorebook/context state that persists; 'an' writes
    // the Author's Note, true now and re-derived every turn; 'imperative' writes one bracketed
    // message beside the last user turn and is CONSUMED, true for one generation only.
    // The runner differs by kind because the platform hook differs -- see ceRunImperatives.
    kind: 'an' | 'result' | 'imperative';
    order: number;
    module?: string;
    off?: boolean;
    build: (ctx: any) => Promise<any>;
}

var CE_INJECTIONS: CeInjectionDef[] = [
    {
        id: 'scene.lore', kind: 'result', order: 10,
        build: async function(ctx: any) {
            const sa = await buildSceneLorebookActivation(ctx.params.lorebookEntries);
            const out: any = {};
            if (sa.lorebookEntries.length > 0) out.lorebookEntries = sa.lorebookEntries;
            if (sa.temporaryLorebookEntries.length > 0) out.temporaryLorebookEntries = sa.temporaryLorebookEntries;
            return out;
        }
    },
    {
        // [D-07] The roster goes LAST among lorebook entries: it changes fastest.
        // THE WHOLE ORDER MUST BE ENUMERATED -- unlisted entries append at the end, so
        // naming only the roster would put it first. An order set by a previous script is
        // honoured and only reordered.
        id: 'cast.order', kind: 'result', order: 20,
        build: async function(ctx: any) {
            const clSt = await loadCastLore();
            const castId = String(clSt.castLoreId || '');
            if (!castId) return null;
            const prev = ctx.params && (ctx.params as any).lorebookEntryOrder;
            const base: string[] = (prev && prev.length)
                ? prev.slice()
                : (await api.v1.lorebook.entries()).map(function(e: any) { return String(e.id); });
            const out: string[] = [];
            for (let i = 0; i < base.length; i++) {
                const id = String(base[i]);
                if (id && id !== castId) out.push(id);
            }
            out.push(castId);
            return { lorebookEntryOrder: out };
        }
    },
    // [F-18] [DEAD] imp.pending stood here -- the only row of kind 'imperative', and its
    // whole mechanism (ceRunImperatives splicing a synthetic user message at onContextBuilt)
    // is deleted along with it. It never delivered once in CE across three placements of the
    // write. The directive now rides storyText from onBeforeContextBuild; see
    // ceDrainImperative. Nothing filters this table for 'imperative' any more.
    {
        // [MILESTONE] THE SLOT D-08 RESERVED, NOW FILLED. It was declared `off` because
        // there was no arc structure to read; the active thread's current milestone is that
        // structure, and it lands here rather than in a new row because order 10 -- ahead of
        // place, present, thoughts and hooks -- is exactly where D-08 said an arc belongs.
        //   THE MILESTONE TEXT ALONE, per user. Not the thread name, not its kind, not its
        //   five lenses: those are the thread's lorebook entry and reach the story on a key
        //   match. This line is the one thing that should happen next, said once.
        //   ONE THREAD. There is one pointer, so there is one line -- the arrangement AE's
        //   own INJ2 note records the cost of getting wrong: listing every live thread
        //   leaked several competing objectives into one Author's Note.
        //   THREE READS AND ONLY WHEN THERE IS ONE. ceArcMilestone returns null for an unset
        //   OR dangling pointer and for an empty loose slot, so a story that never made
        //   either pays for one storyStorage miss per turn and nothing else.
        //   [EVENT] A LIVE ENCOUNTER OWNS THIS SLOT WHILE IT RUNS, resolved inside
        //   ceArcMilestone rather than branched here -- one derivation, so the panel and the
        //   Author's Note cannot disagree about which milestone the story is on.
        id: 'an.arc', kind: 'an', order: 10,
        build: async function(ctx: any) {
            var arcCur: any = null;
            try { arcCur = await ceArcMilestone(); } catch (eA) { arcCur = null; }
            if (!arcCur) return '';
            var arcText = String((arcCur.text) || '').trim();
            if (!arcText) return '';

            // [EVENT] THE SITUATION UNDER THE OBJECTIVE, and it is a SECOND SENTENCE rather
            // than a rewrite of the first. `text` is what the author wrote about this
            // encounter and never moves; the band label is where it stands right now and
            // moves every time the track does. Stating the state as a FACT is what enforces
            // the pacing -- a model told "they are blooded but still standing" continues
            // that, where one told not to end the fight yet is being argued with.
            //   SELF-SUPPRESSING at every step: no event, a deleted shape, a bandless shape
            //   or an empty label all leave the objective standing alone.
            var arcState = '';
            try { arcState = await ceEventStateLine(ctx.cfg, arcCur); } catch (eS) { arcState = ''; }
            if (arcState) {
                arcText = arcText + (/[.!?\u2026]$/.test(arcText) ? '' : '.') + ' ' + arcState
                        + (/[.!?\u2026]$/.test(arcState) ? '' : '.');
            }

            // THE PROXIMITY CLAUSE IS OPTIONAL AND SELF-SUPPRESSING. It needs a target, a
            // protagonist standing somewhere, and a route between them; any of the three
            // missing leaves the milestone standing alone, which is the sentence that
            // matters. A distance the map cannot justify is worse than no distance.
            var arcTail = '';
            var arcTid = String((arcCur && arcCur.targetId) || '');
            if (arcTid && ctx.locEnt && String(ctx.locEnt.id || '') !== arcTid) {
                try {
                    var arcMetas: any[] = await loadEntityIndex();
                    var arcQ: any = ceTravelQuote(ceTravelTiers(ctx.cfg), arcMetas,
                                                  String(ctx.locEnt.id || ''), arcTid);
                    if (arcQ && arcQ.ok && arcQ.mins > 0) {
                        var arcName = '';
                        for (var aq = 0; aq < arcMetas.length; aq++) {
                            if (String(arcMetas[aq].id) === arcTid) { arcName = String(arcMetas[aq].name || ''); break; }
                        }
                        var arcDur = ceTravelDuration(arcQ.mins);
                        if (arcName && arcDur) { arcTail = ' ' + arcName + ' is ' + arcDur + ' away.'; }
                    }
                } catch (eQ) { arcTail = ''; }
            }
            return arcText + arcTail;
        }
    },
    {
        // [T-06] WHEN, ABOVE WHERE. The band and nothing else -- no stamp, no ordinal, no
        // count. The template's bracket self-suppresses when no band resolves, so a world
        // whose bands the author deleted goes quiet instead of emitting a bare sentence.
        // ONE historyStorage READ PER TURN and no ctx field: nothing else in the map wants
        // the clock, and putting it on ctx would pay for a read on every context build in a
        // story that never authored a band.
        // [T-18] WHAT IS ON THE CALENDAR TODAY. Its notes, joined, and nothing else fires --
        // an entry that DID something would be F-16's authored effect tier arriving early.
        // Matched on the absolute day, so it needs no calendar arithmetic and cannot
        // disagree with the clock.
        id: 'an.dated', kind: 'an', order: 16,
        build: async function(ctx: any) {
            var dList: any[] = ((ctx.cfg as any).datedEntries || []);
            if (!dList.length) return '';
            var dToday = ceClockDay(await ceClockLoad());
            var dOut: string[] = [];
            for (var di = 0; di < dList.length; di++) {
                var de: any = dList[di];
                if (!de || Math.round(Number(de.day)) !== dToday) continue;
                var dn = String(de.note || '').trim();
                if (dn) dOut.push(dn);
            }
            return dOut.join(' ');
        }
    },
    {
        // [SCENEBLOCK] TIME AND PLACE ARE ONE PART NOW. The an.time row is retired -- its
        // band leads the place template on its own line -- so the two never emit as separate
        // '\n\n'-joined parts. order 20 keeps this where an.place always sat.
        id: 'an.place', kind: 'an', order: 20,
        build: async function(ctx: any) {
            // [T-19] Time is OPT-IN. Absent reads as off (Settings > Time switch); when off,
            // |band| is passed empty and its bracket self-suppresses, leaving the place lines.
            var plCal = ceCalendar(ctx.cfg);
            var plT = await ceClockLoad();
            var tBand = '';
            if ((ctx.cfg as any).timeInject === true) {
                try { tBand = String(ceClockBand(plCal, plT) || ''); } catch (eTb) { tBand = ''; }
            }
            // With no location the place lines drop, but the time line may still stand alone.
            var plAtmo = '';
            var plName = '';
            if (ctx.locEnt) {
                // [ATMO] THE PLACE AS IT IS RIGHT NOW, not as the gazetteer describes it.
                // ceAtmoFor falls back to the description, so a story with no timetable reads
                // exactly as it did before this existed.
                try { plAtmo = ceAtmoFor(ctx.locEnt, plCal, plT); }
                catch (ePl) { plAtmo = String(ctx.locEnt.description || '').trim(); }
                plName = String(ctx.locEnt.name || '');
            }
            return parseMacroTemplate((ctx.cfg.contextTemplates as any).place || '', {
                band: tBand,
                protagonist: ctx.protagName || 'The scene',
                locationName: plName,
                atmosphere: plAtmo
            }).trim();
        }
    },
    {
        // [SCENEBLOCK] ITS OWN PARAGRAPH. This is a separate an part, so anParts.join('\n\n')
        // puts one blank line between the time/place header above and this present block --
        // which is the paragraph break the author asked for. The schedule-note leads and the
        // named tail are composed by _ceScenePresentPara; the template only chooses whether a
        // space sits between them.
        id: 'an.present', kind: 'an', order: 30,
        build: async function(ctx: any) {
            var para: any = await _ceScenePresentPara(ctx);
            if (!para.scheduleLead && !para.presentTail) return '';
            return parseMacroTemplate((ctx.cfg.contextTemplates as any).present || '', {
                scheduleLead: para.scheduleLead,
                presentTail: para.presentTail
            }).trim();
        }
    },
    {
        id: 'an.thoughts', kind: 'an', order: 40,
        build: async function(ctx: any) { return (await _ceSceneLinesFor(ctx)).thoughts.join('\n'); }
    },
    // [F-5] an.position IS DELETED, NOT DISABLED. Position now folds into the owning
    // character's lorebook entry (_ceCharPositionLine), and two carriers for one fact is
    // precisely what this table exists to prevent -- a row left here "for now" would have
    // doubled every position line in context the moment the fold shipped.
    {
        id: 'an.web', kind: 'an', order: 60,
        build: async function(ctx: any) { return (await _ceSceneLinesFor(ctx)).web.join('\n'); }
    },
    {
        // [D-08] Hooks last, closest to the generation point.
        id: 'an.hooks', kind: 'an', order: 70,
        build: async function(ctx: any) { return (await _ceSceneLinesFor(ctx)).hooks.join('\n'); }
    }
];

// ── [F-4] SUMMON ON MENTION ──────────────────────────────────────────────────────
// When a character is named in the turn's prose, put them in the room.
//
// THE MATCH IS OURS, AFTER THREE ATTEMPTS AT BORROWING NAI'S. Each earlier version tried
// to read activation out of the platform and each failed differently:
//   v1 read params.lorebookEntries in onBeforeContextBuild. That hook runs BEFORE the
//   context is built and key matching happens DURING it, so `active` there is the entry's
//   ENABLED flag. Nothing was ever true.
//   v2 scanned the document and matched keys itself. The matcher was sound; its text source
//   was not -- api.v1.document.scan() returns rows shaped { sectionId, section, index }, so
//   `row.text` is undefined and the haystack was always ''.
//   v3 read STORAGE_LORE_IDS, filled by onLorebookEntrySelected. Two faults at once. The
//   typings say that hook fires on selection IN THE LOREBOOK MODAL, so the set is empty on
//   a story turn; and the loop gated on CharacterMeta.lorebookEntryId, a field the interface
//   never declared and buildCharMeta never wrote, so `named` was structurally always zero.
// So the trigger is now v2 done correctly: the turn's own text, read through
// row.section.text, matched against getLorebookKeys() -- the SAME list syncLorebookEntry
// writes to the entry, so this agrees with the author's keys by construction rather than by
// a second private notion of "mentioned". An adopted entry's keys are its nicknames, so
// those match too.
// STORAGE_LORE_IDS IS STILL READ, as a second source of evidence, and its hits are COUNTED
// SEPARATELY in the summary line. That is the cheapest way to settle whether
// onLorebookEntrySelected ever reports a key activation: if byEntry is forever 0 while
// byKey moves, it does not, and the dynamic pass's `activeEntryIds` read has the same
// latent hole.
//
// THE WINDOW IS ONE TURN. STORAGE_SUMMON_ANCHOR is the last section id at context-build
// time; the reader takes the document tail from there. Without it a name mentioned chapters
// ago would summon again on every turn.
//
// AFTER GENERATION, NOT DURING. Moving someone mid-build would race the injections being
// assembled in the same pass, and onBeforeContextBuild fires on dryRun -- a write there
// moves people during token counting. Landing after the turn is also the right causal
// order: they walk in because they were named.
//
// IT IS RULE-FIRED, NOT MODEL-DRIVEN. The standing rule is that the LLM never moves discrete
// state; a key match is a deterministic test against text, the same class of trigger as a
// schedule window. The per-character opt-out is what keeps it a rule and not a surprise.
//
// UNDO DOES NOT REWIND IT, BY DECISION. parentId is entity storage, not history-scoped, so a
// summon on a turn later undone leaves that character moved.
//
// IT LOGS ITS COUNTS ON THE `summon` CHANNEL, which is registered in AE_LOG_DEFAULT_ON.
// Three fixes shipped into silence because it was not.

// A name is matched whole. 'Ana' must not fire on 'analysis' and 'Ren' must not fire on
// 'Renaissance', so a hit needs a non-word character on both sides. An apostrophe is not a
// word character, which is what lets "Ana's" match.
function _ceSummonWordChar(ch: string): boolean {
    return /[0-9a-z_\u00c0-\u024f]/.test(ch);
}
function _ceSummonMentions(hay: string, key: string): boolean {
    if (!hay || !key) return false;
    var from = 0;
    while (from <= hay.length - key.length) {
        var at = hay.indexOf(key, from);
        if (at < 0) return false;
        var before = at > 0 ? hay.charAt(at - 1) : ' ';
        var after  = (at + key.length < hay.length) ? hay.charAt(at + key.length) : ' ';
        if (!_ceSummonWordChar(before) && !_ceSummonWordChar(after)) return true;
        from = at + 1;
    }
    return false;
}

// The fallback window when no anchor is stored -- a turn that began before this version, or
// an undo that removed the anchored section. Short on purpose: the whole document would
// re-summon every name the story has ever used.
var CE_SUMMON_TAIL = 4;

// Lowercased once here, so the per-character loop never re-cases the haystack.
async function _ceSummonWindowText(): Promise<string> {
    var out = '';
    try {
        var ids: any[] = await api.v1.document.sectionIds();
        if (!ids || !ids.length) return '';
        var anchor = String(await api.v1.tempStorage.getOrDefault(STORAGE_SUMMON_ANCHOR, '') || '');
        var start = -1;
        var i = 0;
        if (anchor) {
            for (i = 0; i < ids.length; i++) { if (String(ids[i]) === anchor) { start = i; break; } }
        }
        if (start < 0) start = Math.max(0, ids.length - CE_SUMMON_TAIL);
        var secs: any[] = await api.v1.document.scan(undefined, { from: ids[start] });
        for (i = 0; i < secs.length; i++) {
            // row.section.text, NOT row.text -- see the v2 note above.
            var t = (secs[i] && secs[i].section && secs[i].section.text) || '';
            if (t) out += String(t) + '\n';
        }
    } catch (eW) { api.v1.error('[AE:summon] window:', eW); return ''; }
    return out.toLowerCase();
}

async function _ceSummonRun(): Promise<number> {
    let moved = 0;
    try {
        // UNCONDITIONAL, AND FIRST. Three early returns sit between onGenerationEnd's top
        // and this call; without this line "never ran" and "ran and found nothing" are the
        // same observation.
        aeLog('[AE:summon] run.');
        const cfg: any = await loadConfig();
        if ((cfg as any).summonOnMention === false) { aeLog('[AE:summon] off in Settings.'); return 0; }

        const camera = String(await loadProtagonistLocation() || '');
        if (!camera || camera === AE_ROOT_LOCATION_ID) {
            aeLog('[AE:summon] no camera location, so there is no room to summon into.');
            return 0;
        }

        const hay = await _ceSummonWindowText();

        let loreIds: string[] = [];
        try {
            const smRaw = await api.v1.tempStorage.getOrDefault(STORAGE_LORE_IDS, '[]') as string;
            loreIds = JSON.parse(smRaw || '[]') || [];
        } catch (eP) { loreIds = []; }
        const smActive: any = {};
        for (let a = 0; a < loreIds.length; a++) smActive[String(loreIds[a])] = 1;

        if (!hay && !loreIds.length) {
            aeLog('[AE:summon] nothing to read this turn: empty window and no active entries.');
            return 0;
        }

        const cast: any[] = await loadAllCharacters();
        let named = 0, byKey = 0, byEntry = 0, skipped = 0;
        for (let i = 0; i < cast.length; i++) {
            const c: any = cast[i];
            if (!c || !c.id) continue;
            if (c.active === false || c.isProtagonist) continue;
            let keyHit = false;
            if (hay) {
                const smKeys: string[] = getLorebookKeys(c);
                for (let k = 0; k < smKeys.length; k++) {
                    if (_ceSummonMentions(hay, String(smKeys[k] || '').trim().toLowerCase())) { keyHit = true; break; }
                }
            }
            const entryHit = !!(c.lorebookEntryId && smActive[String(c.lorebookEntryId)]);
            if (keyHit) byKey++;
            if (entryHit) byEntry++;
            if (!keyHit && !entryHit) continue;
            named++;
            if ((c as any).summonOnMention === false) { skipped++; continue; }
            // ALREADY IN THE ROOM IS NOT A SUMMON. scenePresent first because it costs no
            // read; the body is re-checked after it because followCamera or a schedule may
            // have put them here since presence was last recalculated.
            if (c.scenePresent) { skipped++; continue; }
            let here = '';
            try {
                const body: any = await loadEntity(String(c.entityId || c.id));
                here = String((body && body.parentId) || '');
            } catch (eB) { here = ''; }
            if (here === camera) { skipped++; continue; }
            try {
                await ceProfileSetLocation(String(c.id), camera);
                moved++;
                aeLog('[AE:summon] ' + String(c.name || c.id) + ' \u2192 ' + camera);
            } catch (eC) { api.v1.error('[AE:summon] move:', eC); }
        }
        aeLog('[AE:summon] window ' + String(hay.length) + ' chars, ' + String(loreIds.length)
              + ' entries active | cast ' + String(cast.length) + ' \u2192 ' + String(named)
              + ' mentioned (' + String(byKey) + ' by key, ' + String(byEntry) + ' by entry), '
              + String(skipped) + ' skipped, ' + String(moved) + ' moved.');
    } catch (e) { api.v1.error('[AE:summon] run:', e); }
    return moved;
}

// The shared read every row draws on, so a roster or camera lookup is paid once.
// [SCENEBLOCK] THE PRESENT PARAGRAPH. Replaces the "Present: A, B, C." header with prose:
// each scene-present character who has a schedule note for the current hour leads with it,
// and everyone else is named in a single "X, Y and Z are present." tail. Per author's
// example: a lead reads "<Name> <note>." with the note's initial LOWERCASED and exactly one
// trailing period, and the named tail Oxford-joins the remainder.
//   THE NOTE IS THE CHARACTER'S OWN `doing` FOR THIS HOUR, read exactly as an.place reads a
//   location's atmosphere (ceSchedWhereIs -> seg.doing). A scene-present body is authoritative
//   on camera and its schedule is NOT resolved to move it, but the text of what it is doing is
//   still meaningful here -- it is the one place that note reaches the model at all.
//   NO FALLBACK TO DESCRIPTION. ceAtmoFor falls back to a location's description because a
//   place always has one; a character's description is their static appearance, not what they
//   are doing, so a character with no schedule note simply joins the named tail instead of
//   inventing a lead sentence from the wrong field.
// RETURNS { scheduleLead, presentTail } for the template, both possibly ''. The template's
// two self-suppressing brackets then drop whichever is empty.
function _ceLowerFirst(s: string): string {
    var v = String(s || '');
    if (!v) return v;
    return v.charAt(0).toLowerCase() + v.slice(1);
}
// ONE TRAILING PERIOD, NEVER TWO. A note ending in . ! ? or an ellipsis keeps its own mark;
// anything else gets a single '.'. Mirrors _ceEndSentence's rule so the two cannot disagree.
function _ceOnePeriod(s: string): string {
    var v = String(s || '').replace(/\s+$/, '');
    if (!v) return v;
    var END = '.!?\u2026';
    return END.indexOf(v.charAt(v.length - 1)) >= 0 ? v : (v + '.');
}
async function _ceScenePresentPara(ctx: any): Promise<any> {
    var metas: any[] = ctx.presentMetas || [];
    if (!metas.length) return { scheduleLead: '', presentTail: '' };
    var cal = ceCalendar(ctx.cfg);
    var clockT = 0;
    try { clockT = await ceClockLoad(); } catch (eC) { clockT = 0; }
    var leads: string[] = [];
    var plain: string[] = [];
    for (var i = 0; i < metas.length; i++) {
        var m: any = metas[i];
        var nm = String((m && m.name) || '').trim();
        if (!nm) continue;
        var note = '';
        // The schedule read needs the full record, not the meta -- ceSchedOf reads
        // record.schedule. loadCharacter is the same call an.thoughts already makes per
        // present character, so this adds no new per-turn record read class.
        try {
            var rec: any = await loadCharacter(String(m.id));
            var seg: any = rec ? ceSchedWhereIs(rec, cal, clockT) : null;
            if (seg && String(seg.doing || '').trim()) note = String(seg.doing).trim();
        } catch (eS) { note = ''; }
        if (note) {
            leads.push(nm + ' ' + _ceOnePeriod(_ceLowerFirst(note)));
        } else {
            plain.push(nm);
        }
    }
    var scheduleLead = leads.join(' ');
    var presentTail = '';
    if (plain.length === 1) {
        presentTail = plain[0] + ' is present.';
    } else if (plain.length > 1) {
        presentTail = _ceJoinList(plain) + ' are present.';
    }
    return { scheduleLead: scheduleLead, presentTail: presentTail };
}

async function ceBuildInjectCtx(params: any): Promise<any> {
    const cfg = await loadConfig();
    const charIndex = await loadIndex();
    const protagId = await ceProtagonistId(cfg);
    const protagMeta = protagId ? charIndex.find(function(m: any) { return m && m.id === protagId; }) : null;
    let locEnt: EntityRecord | null = null;
    try {
        const locId = await loadProtagonistLocation();
        // AE_ROOT_LOCATION_ID is a sentinel with no record behind it, so it is skipped
        // rather than loaded and the place row self-suppresses on a world with no places.
        // NOTE: loadProtagonistLocation can WRITE (it persists its own fallback), so this
        // is the one storage write in the context path -- one-time bootstrap only.
        if (locId && locId !== AE_ROOT_LOCATION_ID) locEnt = await loadEntity(String(locId));
    } catch (eLoc) { api.v1.error('[AE:context] camera:', eLoc); }
    return {
        params: params,
        cfg: cfg,
        charIndex: charIndex,
        protagId: protagId,
        protagName: String((protagMeta && (protagMeta as any).name) || cfg.protagonistName || ''),
        locEnt: locEnt,
        presentMetas: charIndex.filter(function(m: any) { return m && m.active && m.scenePresent && !m.isProtagonist; })
    };
}

// Run the map. A row that throws is logged and skipped -- one bad injection must not
// cost the turn every other row would have contributed.
// [F-12a] THE IMPERATIVE RUNNER. Second runner, ONE TABLE -- D-17 says CE_INJECTIONS is
// the map of every story-turn slot write, and that stays true; what forced the split is the
// platform, not the design. 'an'/'result' rows need onBeforeContextBuild (they write the
// Author's Note and lorebook into `result`); an imperative row needs onContextBuilt, which
// is the only place the ASSEMBLED MESSAGE ARRAY exists. Two hooks, two payloads, one table
// to audit.
//
// WHY A MESSAGE SPLICE AND NOT AN AN ROW. D-06 sorts slots by rate of change, and this is a
// THIRD rate the AN does not serve: the AN carries what is true NOW (scene, mood, standing
// state), which persists across turns; an imperative is true for EXACTLY ONE GENERATION and
// then never again. Rolling it into the sentinel-wrapped AN block would make a one-shot
// directive look, to every later turn, exactly like a standing one.
//
// POSITION IS IMMEDIATELY BEFORE THE LAST USER MESSAGE, which is the highest-recency slot
// available and puts the directive adjacent to the input it qualifies.
//
// NO 'GM:' PREFIX. NovelAI's own convention already reads a [bracketed] line as
// out-of-narrative instruction, so the prefix was labelling what the bracket had labelled --
// and it named a speaker the story does not have.
//
// THE TWO DOUBLE-INJECTIONS THIS TABLE EXISTS TO PREVENT both happened HERE, in the
// hand-written block this replaces: the critical-hook loop and the priority>=70 npcWeb
// splice each reached the model twice per generation because the AN emitted the same fact
// and no single place listed both writes. Rows in one table cannot hide from each other.
// [IMP-TRACE] THE DELIVERY RECORD, AND WHY IT EXISTS. The imperative path failed twice in
// a row -- once from onGenerationRequested (a real race, fixed) and once more after the fix
// -- and both times the only available evidence was "the author did not see it in context".
// That is not a measurement: the drain happens on the REAL pass and NAI's context viewer is
// the dryRun pass, so a working splice and a broken one look identical from outside.
// SESSION-ONLY, IN MEMORY, NO STORAGE KEY, exactly like _ceCtxCur: what matters is the last
// few turns of the session you are debugging, and a record surviving a story switch would
// be answering about a story you are no longer in.
interface CeImpTrace {
    at: number;
    continuityId: string;
    lines: string[];
    insertedAt: number;   // [F-19b] message index the directive was pushed at (was: char offset)
    msgCount: number;     // vestigial, always -1 since the message splice was deleted
    // [F-18b] THE LAST N CHARACTERS ACTUALLY HANDED TO NAI, whitespace included. The
    // paragraph fence is invisible in every other report, so without this the question
    // "did the blank lines survive" can only be argued. Rendered through JSON.stringify by
    // `/ce imp` so a stripped '\n\n' is visible rather than inferred.
    tail?: string;
}
var _ceImpLast: CeImpTrace | null = null;
var _ceImpRuns = 0;      // drains that found the slot FULL. The empty-slot early return
                         // above is NOT counted -- this is a delivery count, not a call count.

// [IMP-TRACE] THE OTHER END OF THE WIRE. 3.0.70 instrumented only the DRAIN, and its first
// reading was ambiguous for exactly that reason: "ran once, found nothing" is equally
// consistent with a broken queue and with no roll having happened yet that session. A
// timestamp at each end settles the race question by subtraction rather than argument.
var _ceImpFire: any = null;

// [IMP-PIVOT] THE MEASUREMENT THE POSITION CHANGE DEPENDS ON, AND IT ONLY READS.
// The ask is to move the directive out of the assistant's half of the prompt and into
// the user's own turn -- wanted:
//     <|user|> / User message. / Directive here. / /nothink<|assistant|> / <think></think>
// against what the append produces today, which is the directive AFTER <think></think>.
// Whether the wanted position is reachable at all turns on three facts nothing in this
// file records:
//   1. is '/nothink' inside params.storyText.content, or added downstream of this hook?
//   2. is the <|user|> / <|assistant|> framing in that string, or applied after we return?
//   3. is '/nothink' Xialong's, or every preset's?
// EVERY ONE OF THOSE IS A GUESS TODAY, and a guess here is a splice at a wrong offset --
// which is a silently corrupted prompt, not a visible failure. So both ends of the
// assembly are recorded and `/ce imp` prints them; NOTHING acts on the reading until the
// author has run one real turn against it.
// THE ARRAY IS THE INTERESTING END. onContextBuilt hands over role-tagged messages, and
// _aeYoink already returns a replaced array through that same hook on every wizard and
// CharChat generation -- so the return channel F-18 blamed is demonstrably live. If the
// framing turns out to be applied below onBeforeContextBuild, appending to the last
// user-role MESSAGE is the position that exists, and F-18's diagnosis needs rewriting
// rather than working around.
// SESSION-ONLY AND IN MEMORY, same reasoning as _ceImpLast above: what matters is the
// turn you are debugging, and a record surviving a story switch answers about a story
// you are no longer in.
interface CeImpShape {
    at: number;
    storyLen: number;
    storyTail: string;
    storyMarks: string;
    roles: string;      // 'user:412  assistant:88', in array order
    lastUser: number;   // index of the last user-role message, -1 if there is none
    userTail: string;
    afterUser: string;
    msgMarks: string;
}
var _ceImpShape: CeImpShape | null = null;

// LAST index, not first: the question is where the FINAL user turn ends, and an early
// occurrence in a long story tells us nothing about the boundary we would splice at.
function _ceImpMarkerScan(s: string): string {
    var probes: string[] = ['<|user|>', '<|assistant|>', '<|system|>', '/nothink', '<think>', '</think>'];
    var hits: string[] = [];
    var i = 0;
    for (i = 0; i < probes.length; i++) {
        var at = s.lastIndexOf(probes[i]);
        if (at >= 0) hits.push(probes[i] + '@' + at);
    }
    return hits.length ? hits.join('  ') : '(none)';
}

function _ceImpNoteStory(params: any): void {
    var s = '';
    try { s = String((params && params.storyText && params.storyText.content) || ''); }
    catch (e) { s = ''; }
    _ceImpShape = {
        at: Date.now(),
        storyLen: s.length,
        storyTail: s.slice(s.length - Math.min(s.length, 220)),
        storyMarks: _ceImpMarkerScan(s),
        roles: '', lastUser: -1, userTail: '', afterUser: '', msgMarks: ''
    };
}

// Called from the later hook, so it FILLS the record the earlier one opened. It builds its
// own if that one never ran, because "onBeforeContextBuild returned early" is itself an
// answer worth being able to read.
function _ceImpNoteMessages(msgs: any[]): void {
    if (!_ceImpShape) _ceImpNoteStory(null);
    var sh: any = _ceImpShape;
    var parts: string[] = [];
    var joined = '';
    var lastU = -1;
    var i = 0;
    for (i = 0; i < msgs.length; i++) {
        var m: any = msgs[i] || {};
        var c = String(m.content || '');
        parts.push(String(m.role || '?') + ':' + c.length);
        if (String(m.role || '') === 'user') lastU = i;
        joined += c;
    }
    sh.at = Date.now();
    sh.roles = parts.join('  ');
    sh.lastUser = lastU;
    sh.msgMarks = _ceImpMarkerScan(joined);
    if (lastU >= 0) {
        var uc = String((msgs[lastU] || {}).content || '');
        sh.userTail = uc.slice(uc.length - Math.min(uc.length, 220));
        if (lastU + 1 < msgs.length) {
            var nx: any = msgs[lastU + 1] || {};
            sh.afterUser = String(nx.role || '?') + ' \u2192 ' + String(nx.content || '').slice(0, 220);
        } else {
            sh.afterUser = '(the last message in the array)';
        }
    }
}

// Printed on EVERY `/ce imp`, including the three early returns below, because the position
// question is answerable on a turn with nothing queued -- which is the only kind of turn
// there is until a roll has fired.
function _ceImpShapeLines(): string[] {
    var out: string[] = ['\u2014 context shape, last real story turn [IMP-PIVOT] \u2014'];
    if (!_ceImpShape) {
        out.push('  NEVER captured. No non-dryRun story turn has reached the AE path this session.');
        return out;
    }
    var sh: CeImpShape = _ceImpShape;
    out.push('  storyText:   ' + sh.storyLen + ' chars   markers: ' + sh.storyMarks);
    out.push('  story tail:  ' + JSON.stringify(sh.storyTail));
    out.push('  messages:    ' + (sh.roles || '(onContextBuilt returned before the AE path)'));
    if (sh.roles) out.push('  markers now: ' + sh.msgMarks);
    if (sh.lastUser >= 0) {
        out.push('  last user turn is message ' + sh.lastUser);
        out.push('  its tail:    ' + JSON.stringify(sh.userTail));
        out.push('  after it:    ' + JSON.stringify(sh.afterUser));
    } else if (sh.roles) {
        out.push('  NO user-role message in the array. The wanted position does not exist in');
        out.push('  this preset and the pivot needs a different carrier entirely.');
    }
    out.push('  READ IT AS: markers in storyText mean NAI hands us the framing and a splice');
    out.push('  can find it there. Markers ONLY in the message array mean the framing is');
    out.push('  applied after onBeforeContextBuild returns, and the directive belongs on the');
    out.push('  last user MESSAGE at onContextBuilt. Markers in neither mean they are added');
    out.push('  below every hook and no splice reaches them -- the pivot stops there.');
    var noneStory = (sh && sh.storyMarks === '(none)');
    var noneMsgs  = (sh && sh.roles && sh.msgMarks === '(none)');
    if (noneStory && noneMsgs) {
        // NEITHER carrier holds a marker -- the measured Xialong case. [IMP-PIVOT]
        out.push('  >> THIS STORY: markers in neither. The framing is downstream of every hook.');
        out.push('     A position splice is unreachable; the append already sits inside the last');
        out.push('     user turn. Any change here is WORDING, not placement.');
    }
    return out;
}

// [F-19b] ceDrainImperative DELETED. It bracketed the directive and cleared the slot for
// the storyText append; delivery now drains inline at onContextBuilt (grep F-19b there) and
// sends the text BARE, with no bracket -- the bracket was the instruction token the pivot
// exists to drop.

// [IMP-TRACE] `/ce imp` -- did the directive reach the model, and if not, where did it stop?
// FOUR DISTINGUISHABLE ANSWERS, which is the whole point: nothing queued, queued but never
// drained, drained and spliced, or the drain ran and found the slot empty. Free, read-only.
async function _ceImpReport(): Promise<string> {
    const out: string[] = ['/ce imp \u2014 the one-shot directive slot'];
    const shp: string[] = _ceImpShapeLines();
    for (let si = 0; si < shp.length; si++) out.push(shp[si]);
    out.push('');
    let pend = '';
    try { pend = String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
    catch (e) { pend = ''; }
    out.push('queued now:   ' + (pend ? ('\u201c' + pend.substring(0, 160) + '\u201d') : '(empty)'));
    out.push('drains hit:   ' + _ceImpRuns + ' this session (drains that found the slot full)');
    if (!_ceImpFire) {
        out.push('last roll:    NEVER this session. No armed move has fired since the script loaded.');
        out.push('');
        out.push('THIS REPORT CANNOT ANSWER ANYTHING YET. Arm a move, send a real story turn, '
            + 'then run this again \u2014 a drain that ran before any roll happened is expected to '
            + 'find nothing.');
        return out.join('\n');
    }
    var fAgo = Math.round((Date.now() - _ceImpFire.at) / 1000);
    if (_ceImpFire.preemptedBy) {
        out.push('last roll:    ' + fAgo + 's ago, band "' + _ceImpFire.band + '", PREEMPTED by '
            + _ceImpFire.preemptedBy + ' \u2014 queued nothing itself.');
    } else if (!_ceImpFire.queued) {
        out.push('last roll:    ' + fAgo + 's ago, band "' + _ceImpFire.band
            + '" had NO NOTE \u2014 queued nothing. Settings \u203a Rolls \u203a "The model reads".');
    } else {
        out.push('last roll:    ' + fAgo + 's ago, band "' + _ceImpFire.band + '", queued '
            + _ceImpFire.noteLen + ' chars, read straight back as ' + _ceImpFire.readBack + '.');
        if (_ceImpFire.readBack === 0) {
            out.push('              THE WRITE DID NOT SURVIVE ITS OWN FUNCTION. That is a storage '
                + 'problem, not a hook-ordering one.');
        }
    }
    if (!_ceImpLast) {
        out.push('last delivery: NEVER. Nothing has been appended to story text this session.');
        out.push('');
        out.push('The slot was never found full at onBeforeContextBuild. Either no story turn has '
            + 'run since the roll, or that hook is returning before the delivery block \u2014 the '
            + 'probe/yoink/WIZLIVE/CharChat branches and the dryRun gate all return above it.');
        return out.join('\n');
    }
    const ago = Math.round((Date.now() - _ceImpLast.at) / 1000);
    out.push('last delivery: ' + ago + 's ago, spliced as user message #' + _ceImpLast.insertedAt
        + (_ceImpLast.msgCount > 0 ? (' of ' + _ceImpLast.msgCount) : '')
        + ' (before the generation point)'
        + (_ceImpLast.continuityId ? ('  [' + _ceImpLast.continuityId + ']') : ''));
    for (let i = 0; i < _ceImpLast.lines.length; i++) out.push('  ' + _ceImpLast.lines[i]);
    // [F-19b] The content, verbatim, BARE. If this prints with a leading '[' the pivot has
    // regressed to a bracketed directive -- the exact instruction token it exists to drop.
    if (typeof _ceImpLast.tail === 'string') {
        out.push('sent as:      ' + JSON.stringify(_ceImpLast.tail));
    }
    out.push('');
    out.push('A delivery recorded here went out on the same return value that carries Memory and '
        + 'the Author\u2019s Note. If the model still ignores it, the question stops being delivery '
        + 'and becomes wording.');
    return out.join('\n');
}

// [F-12a] The door F-12's resolution writes through. ONE DIRECTIVE AT A TIME, LAST WINS:
// two rolls cannot resolve inside one turn, so a queue would only ever hold a directive
// that a crashed turn left behind, and serving that on the next turn would be worse than
// dropping it.
async function ceQueueImperative(text: string): Promise<void> {
    const s = String(text || '').trim();
    try {
        if (s) await api.v1.tempStorage.set(STORAGE_PENDING_INJECT, s);
        else await api.v1.tempStorage.remove(STORAGE_PENDING_INJECT);
    } catch (e) { api.v1.error('[AE:context] queue imperative:', e); }
}

// [G-04] The last Author's Note region this engine built, held for display only. Reset to
// empty by nothing: a turn that produces no block leaves the previous one standing, which is
// honest (it IS the last one sent) and is what the Scene panel's timestamp is for.
var _ceLastAnBlock: any = { text: '', at: 0, parts: 0 };

async function ceRunInjections(params: any, result: any): Promise<void> {
    const ctx = await ceBuildInjectCtx(params);
    const rows = CE_INJECTIONS.slice().sort(function(a, b) { return a.order - b.order; });
    const anParts: string[] = [];
    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        if (row.off) continue;
        try {
            const built = await row.build(ctx);
            if (!built) continue;
            if (row.kind === 'an') {
                const s = String(built).trim();
                if (s) anParts.push(s);
            } else {
                const keys = Object.keys(built);
                for (let k = 0; k < keys.length; k++) result[keys[k]] = built[keys[k]];
            }
        } catch (eRow) { api.v1.error('[AE:context] injection ' + row.id + ':', eRow); }
    }
    if (!anParts.length) return;
    // [AN-IDEMPOTENT] Strip any prior AE region before re-appending. Our block is always
    // last and sentinel-prefixed, so the sentinel (or the '\n\n'+sentinel join before it)
    // marks the trailing AE region. N hook passes converge on one copy.
    const existing = (params.authorsNote && params.authorsNote.content) ? params.authorsNote.content : '';
    const marker = '\n\n' + AE_AN_SENTINEL;
    const mIdx = existing.lastIndexOf(marker);
    let base = (mIdx >= 0)
        ? existing.substring(0, mIdx)
        : ((existing.indexOf(AE_AN_SENTINEL) === 0) ? '' : existing);
    base = base.replace(/\s+$/, '');
    const wrapped = AE_AN_SENTINEL + '\n' + anParts.join('\n\n');
    // [G-04] THE BLOCK IS KEPT, VERBATIM, FOR THE SCENE SURFACE TO SHOW, per author. What
    // the engine puts in the Author's Note was previously only inspectable through a
    // diagnostic command, so an author tuning templates was reading the model's behaviour to
    // infer the text -- which is guessing at something the engine knows exactly.
    //   `wrapped`, NOT `base + wrapped`: this is OUR region and the sentinel marks it. The
    //   author's own note above it is theirs and already visible in NAI's own editor.
    //   A MODULE VAR, NOT STORAGE. It is a projection of the last build and is worthless
    //   after a reload; writing it to storage would put a per-turn write in the context path
    //   for a value only a surface reads. cePublishScene picks it up on its next run.
    _ceLastAnBlock = { text: wrapped, at: Date.now(), parts: anParts.length };
    result.authorsNote = { active: true, content: base ? (base + '\n\n' + wrapped) : wrapped };
}

// [CE-STRIP earlier CTX-CUT] buildTrackedNarrativeBlock and buildDramaContextBlock
// PHYSICALLY DELETED — each had exactly one caller (onBeforeContextBuild's
// questLine/dramaBlock locals), verified zero-referenced after those calls were
// removed. See CE-INDEX PASS 9 for full rationale.

// ============================================================================
// SECTION 14 — [RETIRED] legacy freeform #tag 1d6 skill-check system.
// Removed [vNEXT]: typing #force etc. directly in the story box no longer rolls.
// All skill checks now run through the Quick Action composer (2d6 fail-forward +
// the Stakes library below). UNIVERSAL_OUTCOMES / DEFAULT_OUTCOME_BANDS / rollD6 /
// getUniversalOutcome / getConsumedRoll / markRollConsumed removed with it.
// ============================================================================

// ============================================================================
// SECTION 15 — DYNAMIC ENGINE
//
// All AI generation that runs AFTER a story generation completes. This is the
// "background engine" — it updates character states (ephemeral thoughts,
// mid-range dynamics, arcs, hooks) based on the new story content.
//
// Execution order in runDynamicEngine (per character, per turn):
//   1. Retry queue — flushes characters deferred from previous budget-limited turn
//   2. Per character (active, non-protagonist, non-static):
//      a. Ephemeral thoughts, aka THE BEAT PASS (interval: thoughtIntervalTokens, ~600)
//         — also carries the pursuitState and positionState classifications
//      b. Hook update or spawn (interval: hookIntervalTokens, ~1800)
//      Two generators, and only two. The mid-range and relationship steps are retired.
//
// Budget gates: checks api.v1.script.getAllowedOutput() before dispatching.
// If budget < threshold, the character is queued in STORAGE_RETRY_CHARS for
// the next generation rather than blocking this one.
//
// HELPERS IN THIS SECTION:
//   extractJSON, extractJSONArray     — GLM output parsers
//   ceStoryBlockGet / ceStoryBlockText — shared front-anchored story block,
//                                        one per dynamic pass, FIRST in every auto-gen
//                                        prompt. grep STORY-BLOCK.
//   getRecentStoryText                — story context reader (chat + wizard paths only
//                                        now; tail-anchored, shares no prefix)
//   generateFieldContent              — character field AI generator
//   buildHookStateContext             — the hook prompt's tail. ONE consumer: generateHookUpdates
//     now async — also folds in active charJournal bubbles (Section 10c) as a
//     directed input, not just the passive lorebook fold buildCharDynamicBlock already did
//   generateArcMilestones             — milestone generator (called from UI)
// ============================================================================

// ── GLM Output Parsers ────────────────────────────────────────────────────────

function extractJSON(text: string): any {
    // Attempts multiple strategies to parse a JSON object from model output.
    // GLM sometimes omits the outer braces or wraps output in markdown fences.
    if (!text) return null;
    let clean = text.trim();

    // Fallback: model responded with key-value pairs missing the opening brace
    if (clean.startsWith('"') && !clean.includes('{')) {
        clean = '{' + clean;
        if (!clean.endsWith('}')) clean += '}';
    }

    try { return JSON.parse(clean); } catch {}
    try { const stripped = clean.replace(/```json\s*/gi, '').replace(/```\s*/gi, '').trim(); return JSON.parse(stripped); } catch {}
    try {
        const s = clean.indexOf('{'); const e = clean.lastIndexOf('}');
        if (s !== -1 && e !== -1 && e > s) return JSON.parse(clean.substring(s, e + 1));
    } catch (e) {}

    aeLog('[AE:engine] extractJSON failed on:', text.slice(0, 80));
    return null;
}

// ── Story Context Reader ──────────────────────────────────────────────────────


// SHARED STORY BLOCK  [STORY-BLOCK]
// ONE story excerpt per dynamic pass, FRONT-ANCHORED, placed FIRST in every
// auto-generation prompt so they share a cacheable prefix.
//
// MEASURED, /ce cache, two agreeing runs: this runtime does real PREFIX caching across
// separate api.v1.generate() calls. A 1157-token payload billed 1167 cold, 15 on a repeat,
// and 15 again with the same prefix and a DIFFERENT TAIL. A shared prefix is worth ~99% of
// its tokens on every call after the first.
//
// getRecentStoryText CANNOT SERVE THIS. It reads backward from the end of the document, so
// it is TAIL-anchored: every new beat shifts its front, and a window whose front moves has
// no stable prefix. It stays for the chat and wizard paths, which are not in a shared pass.
//
// PEEK, NEVER READ, AFTER THE FIRST CALL OF A PASS. RolloverHelper.read() trims and
// advances the start position; peek() does not. A read() per auto-generation would shift
// the window between two calls of the same pass and destroy the prefix identity this
// mechanism exists to create. ceStoryBlockGet() does the single read().
//
// Two re-anchor triggers, layered rather than competing: overflow is a size constraint,
// scene change is a relevance choice. A script unload costs one re-anchor and that is
// accepted — the alternative is trusting a serialised window against a document that may
// have been edited underneath it.

// Window sizing. Deliberately NOT api.v1.maxTokens(model) -- that is the STORY context
// budget (tens of thousands) and this is a probe prompt asking what one person thinks
// right now. Trims from 4000 back to 2500, so roughly 1500 tokens' worth of story beats
// pass between forced re-anchors. Raising CE_SB_ROLL buys longer cache-stable runs at the
// cost of carrying more text; that is the dial.
const CE_SB_MAX  = 2500;
const CE_SB_ROLL = 1500;

var _ceSBHelper: any = null;
var _ceSBAnchor  = '';   // scene identity the live helper is anchored to
var _ceSBLastSec = -1;   // highest document section id already added
var _ceSBText    = '';   // last assembled block, reused for every call in a pass

// Scene identity. A change in ANY of these means the anchor is stale: a different camera
// location is the user's chosen trigger, and a different story file must never inherit
// another story's window.
async function _ceSBSceneKey(): Promise<string> {
    var loc = '';
    try { loc = String((await loadProtagonistLocation()) || ''); } catch (eSk) { loc = ''; }
    return 'loc:' + loc;
}

// Rebuilds from scratch. Bounded by section COUNT before any tokenising happens, because
// the tokeniser is one async call per section and an unbounded scan over a long story
// would cost more than the block saves.
async function _ceSBRebuild(): Promise<void> {
    _ceSBHelper = api.v1.createRolloverHelper({
        maxTokens: CE_SB_MAX, rolloverTokens: CE_SB_ROLL, model: await wizActiveModel()
    });
    _ceSBLastSec = -1;
    var ids: any[] = await api.v1.document.sectionIds();
    if (!ids || !ids.length) { _ceSBText = ''; return; }
    // Ceiling of (max+roll)/10 sections plus slack, mirroring getRecentStoryText's own
    // heuristic: paragraphs average well over ten tokens, so this over-collects rather
    // than starving the window, and the helper trims whatever does not fit.
    var span = Math.ceil((CE_SB_MAX + CE_SB_ROLL) / 10) + 20;
    var si = Math.max(0, ids.length - span);
    var secs: any[] = await api.v1.document.scan(undefined, { from: ids[si] });
    var i = 0;
    for (i = 0; i < secs.length; i++) {
        var t = (secs[i] && secs[i].section && secs[i].section.text) || '';
        if (!String(t).trim()) continue;
        await _ceSBHelper.add(String(t));
        if (secs[i].id !== undefined && secs[i].id !== null) _ceSBLastSec = Number(secs[i].id);
    }
}

// Appends only what is new since the last call. THIS is the cheap path and the one that
// runs on almost every turn: the block's front is untouched, so the prefix already sitting
// in the backend's cache stays valid and only the appended tail is billed.
async function _ceSBAppendNew(): Promise<void> {
    var ids: any[] = await api.v1.document.sectionIds();
    if (!ids || !ids.length) return;
    var start = -1;
    var i = 0;
    for (i = 0; i < ids.length; i++) { if (Number(ids[i]) > _ceSBLastSec) { start = i; break; } }
    if (start < 0) return;
    var secs: any[] = await api.v1.document.scan(undefined, { from: ids[start] });
    for (i = 0; i < secs.length; i++) {
        var sid = (secs[i] && secs[i].id !== undefined) ? Number(secs[i].id) : -1;
        if (sid <= _ceSBLastSec) continue;
        var t = (secs[i] && secs[i].section && secs[i].section.text) || '';
        if (String(t).trim()) await _ceSBHelper.add(String(t));
        if (sid >= 0) _ceSBLastSec = sid;
    }
}

// THE ONLY ENTRY POINT, and it must be called exactly once per dynamic pass, before the
// per-character loop. Every generator in that pass then reads ceStoryBlockText().
async function ceStoryBlockGet(): Promise<string> {
    try {
        var key = await _ceSBSceneKey();
        if (!_ceSBHelper || key !== _ceSBAnchor) {
            _ceSBAnchor = key;
            await _ceSBRebuild();
        } else {
            await _ceSBAppendNew();
        }
        // THE SINGLE read() OF THE PASS. It performs the overflow trim and advances the
        // start position; everything downstream reads the string this produced.
        var items: any[] = _ceSBHelper.read();
        var parts: string[] = [];
        var i = 0;
        for (i = 0; i < items.length; i++) {
            var c = String((items[i] && items[i].content) || '');
            if (c) parts.push(c);
        }
        _ceSBText = parts.join('\n\n').trim();
        return _ceSBText;
    } catch (eSb) {
        aeLog('[AE:sb] story block failed, falling back to getRecentStoryText:', eSb);
        // FALL BACK TO THE OLD READER RATHER THAN TO NOTHING. A cache optimisation that can
        // starve a generator of its story context is worse than no optimisation.
        try { _ceSBText = await getRecentStoryText(CE_SB_MAX); } catch (eSb2) { _ceSBText = ''; }
        return _ceSBText;
    }
}

// Cached read for the second and subsequent generators in a pass. Never rebuilds.
function ceStoryBlockText(): string { return _ceSBText; }

// Forces a re-anchor. Exposed for /ce and for any future caller that knows the window is
// stale for a reason the scene key cannot see (a document edit, an undo past the anchor).
function ceStoryBlockReset(): void { _ceSBHelper = null; _ceSBAnchor = ''; _ceSBLastSec = -1; _ceSBText = ''; }

async function getRecentStoryText(maxTokens: number): Promise<string> {
    // Returns the most recent story text fitting within maxTokens.
    // Reads backward from the end so the freshest content is always included.
    try {
        const ids = await api.v1.document.sectionIds();
        if (ids.length === 0) return '';
        const si       = Math.max(0, ids.length - Math.ceil(maxTokens / 10) - 20);
        const sections = await api.v1.document.scan(undefined, { from: ids[si] });
        let text = ''; let used = 0;
        for (let i = sections.length - 1; i >= 0; i--) {
            const t = sections[i].section?.text || '';
            if (!t.trim()) continue;
            const enc = await api.v1.tokenizer.encode(t, 'glm-4-6');
            if (used + enc.length > maxTokens) break;
            text = t + '\n\n' + text;
            used += enc.length;
        }
        return text.trim();
    } catch { return ''; }
}

// [CHARCHAT-THINK-FIRST] getRecentStoryText() reads the document tail backwards.
// During a chat the document tail IS the transcript, so that function cannot see the story
// at all — it returns chat text under a "Recent Story:" header, which is precisely the bug
// generateChatEphemeral() exists to stop feeding the model. This reads the story that sits
// ABOVE the chat marker instead: same backwards-from-the-newest, same token budget, just
// starting from the marker rather than from the end of the document.
// When no marker is present (no chat open) this is exactly getRecentStoryText's behaviour.
async function _charchatStoryTextAboveMarker(maxTokens: number): Promise<string> {
    try {
        let ccRows = await api.v1.document.scan();
        if (!ccRows || !ccRows.length) return '';
        let ccCut = ccRows.length;
        for (let ccI = 0; ccI < ccRows.length; ccI++) {
            let ccSec = ccRows[ccI] && ccRows[ccI].section;
            if (!ccSec) continue;
            if (String(ccSec.text || '').indexOf(_ccMarkerText()) >= 0) { ccCut = ccI; break; }   // [CCINT] mode-correct marker
        }
        let ccText = '';
        let ccUsed = 0;
        for (let ccJ = ccCut - 1; ccJ >= 0; ccJ--) {
            let ccSec2 = ccRows[ccJ] && ccRows[ccJ].section;
            let ccT = (ccSec2 && ccSec2.text) ? String(ccSec2.text) : '';
            if (!ccT.trim()) continue;
            let ccEnc = await api.v1.tokenizer.encode(ccT, 'glm-4-6');
            if (ccUsed + ccEnc.length > maxTokens) break;
            ccText = ccT + '\n\n' + ccText;
            ccUsed += ccEnc.length;
        }
        return ccText.trim();
    } catch (eSm) {
        api.v1.error('[AE:charchat] story-above-marker read failed (thinking loses background context, not fatal):', eSm);
        return '';
    }
}

// ── Character Field Generator ─────────────────────────────────────────────────

// [FIELD-CONTEXT] Shared character context for BOTH single-field generation
// and option generation. Before this, both generators saw only name, briefDescription
// and conceptDump — so a field was written without knowing the character's species,
// gender, age or role, and without seeing any SIBLING field that was already filled.
// The second half of that is the serious one: the slot instructions carry explicit
// anti-bleed clauses telling the model not to restate what belongs to another field,
// while the model had no way to see what the other fields actually said. This closes
// that: established siblings are shown, and shown as constraints.
//
// excludeLabel is matched case-insensitively against the field being written so the
// generator never sees its own current value as an established fact. Matching by LABEL
// rather than key is deliberate — neither generator takes a key, and threading one
// through would change two public signatures and every caller. The cost is that two
// fields sharing an identical label would exclude each other; labels are author-set and
// duplicates would already be confusing in the UI, so that is accepted, not overlooked.
async function buildFieldGenContext(char: CharacterRecord, excludeLabel: string): Promise<string> {
    const lines: string[] = [];
    const skip = (excludeLabel || '').trim().toLowerCase();

    // Identity line — same shape buildLorebookContent uses, so context and lorebook agree.
    const idLeader = [char.species, char.gender].map(function(s) { return (s || '').trim(); }).filter(Boolean).join(' ');
    const idMid    = [idLeader, (char.age || '').trim(), (char.occupationRole || '').trim()].filter(Boolean).join(', ');
    let identityLine = (char.name || '').trim();
    if (identityLine && idMid) identityLine += ' \u2014 ' + idMid;
    else if (!identityLine && idMid) identityLine = idMid;
    if (identityLine) lines.push('Identity: ' + identityLine);

    const nicks = (char.nicknames || []).filter(Boolean);
    if (nicks.length) lines.push('Also called: ' + nicks.join(', '));

    // Established siblings. Truncated per entry — these are meant to be short by design,
    // and a runaway hand-written field must not crowd out the rest of the context.
    const estab: string[] = [];
    function addEstab(label: string, value: string): void {
        const v = (value || '').trim();
        if (!v) return;
        if (label.trim().toLowerCase() === skip) return;
        estab.push(label + ': ' + (v.length > 240 ? v.slice(0, 240) + '\u2026' : v));
    }

    let ctxCfg: GlobalConfig | null = null;
    try { ctxCfg = await loadConfig(); } catch (eCtxCfg) { ctxCfg = null; }

    for (const fd of STATIC_FIELD_DEFS) {
        const fdLabel = (ctxCfg && ctxCfg.fieldLabels && ctxCfg.fieldLabels[fd.key]) || fd.label;
        addEstab(fdLabel, String((char as any)[fd.key] || ''));
    }
    if (char.coreValues && char.coreValues.length) addEstab('Core Values', char.coreValues.filter(Boolean).join('; '));
    // [FIELD-GROUPING] Same read-time ordering as the lorebook entry. Not a
    // cosmetic change here: this list is what a generator is told is already fixed, and
    // related lines sitting together is the difference between a coherent brief and a
    // shuffled one.
    if (ctxCfg && ctxCfg.customStaticFields) {
        for (const cf of ceOrderStaticFields(ctxCfg.customStaticFields.filter(Boolean))) {
            addEstab(cf.label || cf.id, (char.customFieldValues || {})[cf.id] || '');
        }
    }

    if (estab.length) {
        lines.push('Already established about this character. Treat every line as fixed: do not contradict it, and do not restate it — each of these belongs to its own field.');
        for (const e of estab) lines.push('  - ' + e);
    }
    return lines.join('\n');
}

async function generateFieldContent(
    char: CharacterRecord,
    fieldLabel: string,
    instructions: string,
    generalStyle: string,
    hint: string,
    maxTokens: number,
    fcOpts?: { includeStory?: boolean }
): Promise<string | null> {
    // Generates content for a single character field using GLM.
    // Used by the character editor's auto-generate buttons.
    // NOTE: waitForAllowedOutput is intentionally absent — this runs from modal
    // button callbacks where the signal never fires (deadlock risk).
    // [FIELD-CONTEXT] includeStory defaults TRUE here, unlike generateSlotOptions
    // where it defaults false. Not an inconsistency left lying: this function is reached
    // from the native editor's generate buttons, which have always been story-aware, and
    // flipping that default would silently change behaviour every existing user relies
    // on. Composition surfaces pass false explicitly.
    const fcStory     = !fcOpts || fcOpts.includeStory !== false;
    const recentText  = fcStory ? await getRecentStoryText(2000) : '';
    const fcContext   = await buildFieldGenContext(char, fieldLabel);
    const targetWords = Math.max(20, Math.floor(maxTokens * 0.75));

    const sys = [
        generalStyle,
        `You are writing the "${fieldLabel}" field for a character. This field has specific scope — stay inside it.`,
        instructions,
        `CONSTRAINT: Strictly under ~${targetWords} words. Finish your thought completely. ` +
        `Your output must be the content itself — do not begin with a label, header, or category name. ` +
        `Outputs that begin with words like "Voice:", "Appearance:", "Core Drive:", or any descriptor of what follows are invalid. ` +
        `Your first word must be content.`
    ].filter(Boolean).join('\n\n');

    const usrParts: string[] = [
        `Character: ${char.name}`,
        fcContext    ? fcContext : '',
        char.briefDescription ? `Anchor (do not contradict): ${char.briefDescription}` : '',
        char.conceptDump?.trim()
            ? `Reference notes (extract only what is directly relevant to the ${fieldLabel} field — ignore the rest):\n${char.conceptDump.trim()}`
            : '',
        hint?.trim() ? `Focus constraint: ${hint.trim()}` : '',
        recentText   ? `Recent story context:\n${recentText}` : '',
        `\nNow write the ${fieldLabel} field for ${char.name}.`
    ];

    try {
        const resp = await aeDiagGenerate(
            'field:' + fieldLabel + ':' + char.name,
            [{ role: 'system', content: sys }, { role: 'user', content: usrParts.filter(Boolean).join('\n\n') }],
            { model: 'glm-4-6', max_tokens: maxTokens + 30, temperature: 0.8 }
        );
        return (resp.choices[0]?.text || '').trim() || null;
    } catch (e) {
        api.v1.error('[AE:engine] generateFieldContent:', e);
        return null;
    }
}

// [SLOT-OPTIONS] Generate N DIVERGENT candidate values for one field in a
// single call, for a pick-from-three UI. Deliberately NOT N calls to
// generateFieldContent: identical prompts at the same temperature mode-collapse into
// three rewordings of one idea, which is the specific failure that makes an option
// picker worthless. One call can see its own earlier options and be told to differ
// from them, and costs a third as much.
//
// Two further departures from generateFieldContent, both intentional:
//   - temperature defaults HIGHER (0.95 vs 0.8). Options want spread; a single
//     committed value wants fidelity. Same field, opposite sampling.
//   - recent story context is OFF by default. generateFieldContent always pulls 2000
//     chars of story, which is right when tuning an existing character mid-scene and
//     wrong when composing a new one — every character authored during a tense chapter
//     comes out tense. Callers opt IN via opts.includeStory.
//
// Returns null on failure or unparseable output; never throws to the caller. A short
// list is returned as-is rather than discarded — two good options beat an error.
async function generateSlotOptions(
    char: CharacterRecord,
    fieldLabel: string,
    instructions: string,
    generalStyle: string,
    hint: string,
    maxTokens: number,
    count: number,
    divergenceAxis: string,
    // [SLOT-YOINK-TEST] method is an A/B test knob, not a permanent fork. 'yoink'
    // routes the single-candidate ask through executeYoinkGeneration (the editor.generate
    // hijack CharChat/the Wizard already use) instead of aeDiagGenerate (api.v1.generate).
    // The point of the test: does the SAME script-level budget (confirmed shared as far
    // back as earlier) actually behave differently in practice for this call shape, and
    // does an independently-sampled single draw — repeated on demand — produce candidates
    // that diverge from each other MORE than one call self-differentiating three at once.
    // Both paths land in the same diagGenRecord ring buffer (Config modal's Generation
    // Diagnostics), tagged by method, so the two are directly comparable without any new
    // instrumentation.
    opts?: { temperature?: number; includeStory?: boolean; method?: 'direct' | 'yoink' | 'auto' }
): Promise<string[] | null> {
    // [SLOT-COUNT] Floor lowered from 2 to 1. A single candidate is roughly a
    // third of the cost of three (see max_tokens below, which multiplies by wantCount),
    // and on a long character record that difference is the whole reason the author
    // hesitates to use the picker at all. wantCount === 1 takes a different prompt shape
    // and a different parse path — a "make them differ from each other" instruction is
    // incoherent for one candidate and actively degrades it.
    // [SLOT-YOINK-TEST] yoink mode is ALWAYS wantCount 1, regardless of what count
    // was asked for. The self-differentiation instruction below ('candidates must differ
    // from each other') only means anything when one call can see its own other answers —
    // three separate yoink calls cannot see each other, so asking for three-in-one-call
    // framing across independent generations would be incoherent, not just wasteful.
    // "Unlimited regen" is the intended substitute: each click is one independent draw.
    // [SLOT-YOINK-AUTO] 'auto' resolves HERE, not at the call site, because the
    // decision depends on the live run counter and must be read as late as possible --
    // another generator finishing between the handler's pre-flight and this point changes
    // the right answer. The handler still sizes its budget check for the pessimistic case
    // (see its gsoCount note), so a resolve-to-yoink after a direct-sized pre-flight is
    // safe; the reverse would not be, which is why the handler never resolves 'auto' itself.
    const _soAuto     = opts?.method === 'auto';
    const _soRun      = _soAuto ? await _ceYoinkRunGet() : 0;
    // [YOINK-UNCAP] AE_YOINK_RUN_MAX <= 0 means "do not gate on the counter";
    // auto then always tries the free path first and lets an empty response, not an
    // arithmetic guess, decide that the run is over.
    const _soYoink    = opts?.method === 'yoink' ||
        (_soAuto && (AE_YOINK_RUN_MAX <= 0 || _soRun < AE_YOINK_RUN_MAX));
    const wantCount   = _soYoink ? 1 : Math.max(1, Math.min(5, count || 3));
    const targetWords = Math.max(20, Math.floor(maxTokens * 0.75));
    const temp        = (opts && typeof opts.temperature === 'number') ? opts.temperature : 0.95;
    const useStory    = !!(opts && opts.includeStory);

    const sys = [
        generalStyle,
        `You are writing the "${fieldLabel}" field for a character. This field has specific scope — stay inside it.`,
        instructions,
        wantCount > 1
            ? `You are producing ${wantCount} SEPARATE CANDIDATE VERSIONS of this field, not one answer and not a list of parts of one answer. ` +
              `Each candidate must independently satisfy everything above and be usable on its own.`
            : `You are producing ONE version of this field. It must satisfy everything above and be usable on its own.`,
        wantCount > 1
            ? (divergenceAxis
                ? `The candidates must differ from each other in kind, not in phrasing. ${divergenceAxis} ` +
                  `If two candidates could be edits of the same sentence, replace one of them.`
                : `The candidates must differ from each other in kind, not in phrasing. If two candidates could be edits of the same sentence, replace one of them.`)
            : '',
        wantCount > 1
            ? `FORMAT: separate the candidates with a line containing only three hyphens. ` +
              `Each candidate strictly under ~${targetWords} words and finishing its thought completely. ` +
              `Do not number, label, rank, introduce, or comment on the candidates. ` +
              `Do not begin any candidate with a label, header, or category name — the first word of each must be content. ` +
              `Output nothing but the ${wantCount} candidates and the separator lines between them.`
            : `FORMAT: output the field text and nothing else. ` +
              `Strictly under ~${targetWords} words, finishing the thought completely. ` +
              `Do not number, label, rank, introduce, or comment on it. ` +
              `Do not begin with a label, header, or category name — the first word must be content.`
    ].filter(Boolean).join('\n\n');

    const soContext = await buildFieldGenContext(char, fieldLabel);
    const usrParts: string[] = [
        `Character: ${char.name}`,
        soContext    ? soContext : '',
        char.briefDescription ? `Anchor (do not contradict): ${char.briefDescription}` : '',
        char.conceptDump?.trim()
            ? `Reference notes (extract only what is directly relevant to the ${fieldLabel} field — ignore the rest):\n${char.conceptDump.trim()}`
            : '',
        hint?.trim() ? `Steer toward this — the author has already written it into the field, so treat it as direction rather than as text to reuse verbatim: ${hint.trim()}` : '',
        useStory ? await getRecentStoryText(2000).then(function(t) { return t ? `Recent story context:\n${t}` : ''; }).catch(function() { return ''; }) : '',
        wantCount > 1
            ? `\nNow write ${wantCount} candidate versions of the ${fieldLabel} field for ${char.name}.`
            : `\nNow write the ${fieldLabel} field for ${char.name}.`
    ];

    // [SLOT-BUSY] Retry on NAI's concurrency rejection. This is the failure
    // earlier already root-caused for CHARCHAT-FRESH-THOUGHTS: NAI rejects a generate while
    // another is in progress, and isBlocked() is NOT trustworthy — it has been observed
    // returning false immediately before generate() throws. So the remedy is the same one
    // used elsewhere in this file: try, back off, try again.
    //
    // Only 'already in progress' is retried. Every other error is a real failure and
    // retrying it just burns budget and makes the user wait for the same answer.
    //
    // Rethrows once retries are exhausted, rather than returning null as before. That
    // change is the point: a swallowed error became an indistinguishable "nothing came
    // back", which is exactly why the reported failure gave no reason.
    const soAttempts = 3;
    let soLastErr: any = null;
    for (let soTry = 0; soTry < soAttempts; soTry++) {
        try {
            // [SLOT-YOINK-TEST] executeYoinkGeneration is ITSELF already retried,
            // watchdog-bounded, and drift/validator-checked internally (see its own header
            // comment) — this outer soAttempts loop only exists here to catch a genuine
            // '_aeYoink already in progress' collision (WIZLIVE/CharChat/classic wizard
            // holding the slot) and back off, exactly like the direct path's own
            // 'already in progress' handling below. Both throw that same substring, so
            // one shared retry shell covers both paths without duplicating the logic.
            const soMsgs = [{ role: 'system', content: sys }, { role: 'user', content: usrParts.filter(Boolean).join('\n\n') }];
            let soRawText: string;
            if (_soYoink) {
                soRawText = await executeYoinkGeneration(soMsgs, { tag: 'slotopts-yoink:' + fieldLabel + ':' + char.name });
                // Count the attempt, not the success. A yoink that came back empty still
                // consumed one of the run -- treating it as free would keep re-attempting a
                // path NAI has already stopped serving and turn a soft cap into a hang.
                if (_soAuto) await _ceYoinkRunSet(_soRun + 1);
                // [SLOT-YOINK-AUTO] The cap is observed, not contractual, so auto
                // mode must not trust it. An empty yoink means the run ended earlier than
                // AE_YOINK_RUN_MAX predicted; fall through to a metered call rather than
                // surfacing a failure the author would have fixed by pressing More again.
                // Only in 'auto' -- explicit 'yoink' is a test setting and must stay honest
                // about what it did, or the diagnostics comparison is worthless.
                if (_soAuto && !soRawText.trim()) {
                    aeLog('[AE:engine] slotopts auto: yoink run exhausted at ' + _soRun + ', falling back to metered');
                    soRawText = String((await aeDiagGenerate(
                        'slotopts:' + fieldLabel + ':' + char.name,
                        soMsgs,
                        { model: 'glm-4-6', max_tokens: (maxTokens + 30) * wantCount + 40, temperature: temp }
                    )).choices[0]?.text || '');
                }
            } else {
                soRawText = String((await aeDiagGenerate(
                    'slotopts:' + fieldLabel + ':' + char.name,
                    soMsgs,
                    { model: 'glm-4-6', max_tokens: (maxTokens + 30) * wantCount + 40, temperature: temp }
                )).choices[0]?.text || '');
            }
            return parseSlotOptions(soRawText, wantCount);
        } catch (e) {
            soLastErr = e;
            const soMsg = String((e && (e as any).message) || e || '');
            if (soMsg.indexOf('already in progress') < 0) break;
            if (soTry < soAttempts - 1) {
                aeLog('[AE:engine] generateSlotOptions busy, retry ' + (soTry + 1) + '/' + (soAttempts - 1));
                await api.v1.timers.sleep(1200 * (soTry + 1));
            }
        }
    }
    api.v1.error('[AE:engine] generateSlotOptions:', soLastErr);
    throw soLastErr;
}

// [SLOT-OPTIONS] Split a candidate block on separator lines and clean each
// entry. Tolerant on purpose — the model reliably produces the separator but is less
// reliable about NOT labelling entries, so leading "Option 2:" / "2." / "-" / "**"
// noise is stripped rather than treated as a parse failure. Falls back to blank-line
// splitting when no separator survived at all.
// Near-duplicates are dropped: two candidates opening identically are the exact
// mode-collapse this whole function exists to avoid, so returning both would be worse
// than returning fewer.
function parseSlotOptions(raw: string, wantCount: number): string[] | null {
    let txt = (raw || '').trim();
    if (!txt) return null;
    txt = txt.replace(/^```[a-zA-Z]*\s*/, '').replace(/```\s*$/, '').trim();

    // [SLOT-COUNT] Single-candidate path returns the whole reply as one option.
    // Splitting first would be actively wrong here: a legitimate multi-paragraph answer
    // has no separator, so the blank-line fallback below would silently truncate it to
    // its first paragraph. The label-noise strip is kept (the model still occasionally
    // prefixes one), minus the enumeration pattern, which cannot apply to a lone answer.
    if (wantCount <= 1) {
        let solo = txt.replace(/^(?:\*\*|__)?\s*(?:option|candidate|version)\s*\d*\s*[:.\-\u2014]\s*/i, '');
        solo = solo.replace(/^[-*\u2022]\s+/, '');
        solo = solo.replace(/^(?:\*\*|__)\s*/, '').replace(/\s*(?:\*\*|__)$/, '').trim();
        return solo ? [solo] : null;
    }

    let parts = txt.split(/^[ \t]*-{3,}[ \t]*$/m);
    if (parts.length < 2) parts = txt.split(/\n[ \t]*\n[ \t]*\n+/);

    const out: string[] = [];
    const seen: Record<string, boolean> = {};
    for (let p of parts) {
        let s = (p || '').trim();
        if (!s) continue;
        // Strip enumeration / emphasis / label noise the format instruction asked for but may not get.
        // NOTE: the close-paren in this character class is written \u0029 rather than
        // literally. Written literally it is a lone unmatched closing bracket in source
        // text, and this file's only structural safety net is a bracket balance-delta
        // pass against the prior trunk — one literal character here silently poisons
        // that check for every future patch. Same reason this comment spells it out in
        // words instead of showing the character.
        s = s.replace(/^(?:\*\*|__)?\s*(?:option|candidate|version)?\s*\d+\s*[.\u0029:\-\u2014]\s*/i, '');
        s = s.replace(/^[-*\u2022]\s+/, '');
        // Emphasis is stripped from each end INDEPENDENTLY, not as a matched pair. A
        // paired unwrap fails on the common '**1. text.**' shape: the enumeration strip
        // above has already eaten the opening marker, so the pair no longer matches and
        // the trailing one survives into the option text. Caught in test, not in review.
        s = s.replace(/^(?:\*\*|__)\s*/, '');
        s = s.replace(/\s*(?:\*\*|__)$/, '');
        s = s.trim();
        if (!s) continue;
        const key = s.slice(0, 40).toLowerCase().replace(/[^a-z0-9]/g, '');
        if (seen[key]) continue;
        seen[key] = true;
        out.push(s);
        if (out.length >= wantCount) break;
    }
    return out.length ? out : null;
}

// ── Character State Context Builder ──────────────────────────────────────────

// [HOOK-TAIL] The hook prompt's tail. ONE consumer: generateHookUpdates, both
// branches. generateEphemeral builds its own inline.
//
// ORDER IS THE POINT OF THIS FUNCTION, and all three rules are load-bearing:
//   • CONDITIONS LEAD [PASS-D COND-REACH]. An illness or a pregnancy qualifies everything
//     under it, and a model that meets it after the judgement is framed will not go back.
//   • THE EPHEMERAL BEAT SITS IN THE MIDDLE and is stated ONCE, as three labelled lines.
//     Last, it was the strongest thing in the prompt and spawn paraphrased it instead of
//     judging it; quoted AND arrowed out, it said two thirds of itself twice.
//   • THE AUTHORED SLOTS SIT AGAINST THE JSON FENCE. Core, Pursuit, Resistance, Conduct and
//     Position are what say whether something would even COUNT as a tension for this
//     person, which is what the strongest position should hold.
//
// Conditions render through buildDynamicLorebookContent, the same builder the lorebook
// entry uses, so this is byte-identical to what the story turn reads.
async function buildHookStateContext(char: CharacterRecord, cfg?: GlobalConfig): Promise<string> {
    const lines: string[] = [];

    lines.push(`Character: ${char.name}`);
    if (char.personalityCore)    lines.push(`Personality: ${char.personalityCore}`);
    if (char.voiceAndMannerisms) lines.push(`Voice/manner: ${char.voiceAndMannerisms}`);

    // cfg is optional only because the signature was not; every caller passes it.
    if (cfg) {
        try {
            const condCtx = (await buildDynamicLorebookContent(char, cfg)).trim();
            if (condCtx) lines.push(`Currently true of ${char.name} (holds regardless of the scene): ${condCtx}`);
        } catch (eCond) { api.v1.error('[AE:engine] buildHookStateContext conditions:', eCond); }
    }

    // ONE BEAT, AND SAID TO BE ONE. The header does the demotion that the position alone
    // used to have to do, so the beat can still seed a hook without being mistaken for the
    // whole of what this character is.
    if (char.ephemeral && (char.ephemeral.eventAnchor || char.ephemeral.emotionalResponse
                           || char.ephemeral.immediateDesire || char.ephemeral.compressedLine)) {
        lines.push(`Most recent beat (${char.name}) — one moment, not the whole picture:`);
        if (char.ephemeral.eventAnchor)       lines.push(`  Reacting to: ${char.ephemeral.eventAnchor}`);
        if (char.ephemeral.emotionalResponse) lines.push(`  Thinking: ${char.ephemeral.emotionalResponse}`);
        if (char.ephemeral.immediateDesire)   lines.push(`  About to: ${char.ephemeral.immediateDesire}`);
        // Only when the three parts are absent, which is a snapshot from the chat path or
        // a pre-split record. Never alongside them, or the beat is doubled again.
        if (!char.ephemeral.eventAnchor && !char.ephemeral.emotionalResponse
            && !char.ephemeral.immediateDesire && char.ephemeral.compressedLine) {
            lines.push(`  ${char.ephemeral.compressedLine}`);
        }
    }

    // [CHARJOURNAL-WEIGHT] Active (non-archived) journal bubbles are a directed
    // generator input, not just passive lorebook filler (buildCharDynamicBlock still folds
    // them into the lorebook separately — this is additive, not a replacement).
    // Read failures here must never break a dynamic-update cycle, so they're swallowed.
    try {
        const journal = await loadCharJournal(char.id);
        const activeBubbles = (journal.bubbles || []).filter(function(b) { return !b.archived && (b.text || '').trim(); });
        if (activeBubbles.length > 0) {
            lines.push(`${char.name}'s own journal notes (weigh these — they reflect what the character considers significant):`);
            activeBubbles.slice(-4).forEach(function(b) { lines.push(`  - ${b.text.trim()}`); });
        }
    } catch (e) { api.v1.error('[AE:engine] buildHookStateContext journal read:', e); }

    // [HOOK-TAIL] THE AUTHORED SLOTS, LAST. generateEphemeral has read these since
    // EPHEMERAL-REWIRE and the hook prompt never has, which is the substantive half of why
    // its output read like a scene recap: it was asked what stands between two people while
    // knowing nothing about what either of them will not let go of. Resistance and Conduct
    // in particular ARE the definition of a tension for this character -- what holding Core
    // costs them, and what they do when it costs.
    const _hkPat = _ceCharPatternSlots(char);
    const _hkCfv: any = char.customFieldValues || {};
    if (_hkCfv['ce_slot_core'])    lines.push(`Core (won't let go of): ${_hkCfv['ce_slot_core']}`);
    if (_hkCfv['ce_slot_pursuit']) lines.push(`Pursuit (going after now): ${_hkCfv['ce_slot_pursuit']}`);
    if (_hkPat.resistance) lines.push(`Resistance (what holding Core costs): ${_hkPat.resistance}`);
    if (_hkPat.conduct)    lines.push(`Conduct (their standing move when it costs them): ${_hkPat.conduct}`);

    // Position is a READ OF ANOTHER PARTY and is the closest existing record to a hook, so
    // it is the last thing said. NOT scene-gated the way generateEphemeral gates its
    // positionState ask: nothing here asks the model to classify Position, only to know it.
    const _hkPos: any = (char as any).position;
    if (_hkPos && (_hkPos.shape || _hkPos.standing)) {
        const _hkPosName = String(_hkPos.targetName || '')
            || (ceIsProtagonistRef(_hkPos.targetId) ? (String(cfg && cfg.protagonistName || '') || 'the protagonist') : '');
        if (_hkPosName) {
            if (_hkPos.shape)    lines.push(`Position on ${_hkPosName} — what it is: ${_hkPos.shape}`);
            if (_hkPos.standing) lines.push(`Position on ${_hkPosName} — where it stands: ${_hkPos.standing}`);
        }
    }

    return lines.join('\n');
}

// ── Generators ────────────────────────────────────────────────────────────────

// [EPHEMERAL-REWIRE] The pattern ids, hardcoded here to match BUILTIN_FACETS'
// ce_slot_resist_<id> / ce_slot_conduct_<id> pairs exactly.
//
// [PATTERN-8] Six became eight: 'collateral' and 'obligation'. FOUR PLACES MOVE
// TOGETHER OR THE PATTERN IS HALF-REAL -- this list, CE_PATTERN_ORDER, CE_PATTERN_DEFS,
// and the matching ce_slot_resist_<id>/ce_slot_conduct_<id> pair in BUILTIN_FACETS.
// Miss the DEFS entry and the picker renders a blank card; miss the BUILTIN_FACETS pair
// and the card is pickable but its two slots never appear, which reads to the author as
// a pattern that silently does nothing. The bridge no longer mirrors any of this (the
// Studio that needed a copy is deleted) -- do not re-mirror it there.
//
// [PATTERN-STORED] Through earlier there was
// no stored "which pattern" field -- identity was purely implicit in which
// ce_slot_resist_<id> pair held text, on the grounds that a second field could drift from
// it. Per user direction that reasoning is retired, not the mechanism: CharacterRecord.pattern
// is now authoritative when present (see _ceResolveCharPattern), with the OLD scan kept as
// the fallback for any record saved before this version. Nothing here still assumes there
// is no stored field -- if you are reading old comments elsewhere that say otherwise, this
// note is the correction.
const CE_PATTERN_IDS: string[] = ['contradiction', 'wantneed', 'defense', 'ruleset', 'appetite', 'mask', 'collateral', 'obligation'];

// [PATTERN-DEFS] The pattern display table, ported from the bridge's CE_PATTERNS
// (bridge SECTION 18) and now ENGINE-AUTHORITATIVE. It was bridge-only because the Studio
// was the only surface that rendered it; the jsx profile needs it, and the bridge Studio is
// on the deletion keep-list, so the copy moves rather than being duplicated. Do not
// re-mirror it bridge-side.
//
// `resist` and `conduct` are not decoration: they ARE the prompts for the two slots the
// pattern gates (ce_slot_resist_<id> / ce_slot_conduct_<id>), which is precisely why the
// pattern choice sits between Drive and Resistance in the build order and nowhere else.
//
// `c` is the pattern's hue. AURA ONLY -- junction dot, gated-group rail, card edge, meter
// fill, primary-action ground. It must never be applied to body text, on either artifact.
//
// [THEME-HUE] EACH ONE IS NOW A THEME TOKEN, `--ce-pat-<id>`, with the literal it replaced
// as the fallback. Setting none changes nothing. This is the token set that closes the one
// gap a theme could not reach any other way: CE-STYLE SS6.3 spends the pattern hue on the
// PRIMARY ACTION GROUND, so until these had names the single filled button on every surface
// was the one element a .naitheme could not paint. Six of the surfaces SS6.3 ranks by area
// move with these names.
// SPELLED OUT RATHER THAN THROUGH ceVar(), for the same reason CE_T spells its own out:
// this table is declared thousands of lines above that function. Same contract.
// AURA ONLY STILL HOLDS. A token does not license painting text with it.
const CE_PATTERN_ORDER: string[] = ['contradiction', 'wantneed', 'defense', 'ruleset', 'appetite', 'mask', 'collateral', 'obligation'];
const CE_PATTERN_DEFS: { [k: string]: any } = {
    contradiction: { c: 'var(--ce-pat-contradiction, #5fc0a0)', sub: 'Contradiction',
        name: 'They\u2019re one thing, and also the opposite',
        blurb: 'Two true things pulling against each other',
        resist: 'What is the second thing that is also true, and pulls the other way?',
        conduct: 'Which side shows normally, and what brings the other one out?' },
    wantneed: { c: 'var(--ce-pat-wantneed, #e09a4f)', sub: 'Want / Need',
        name: 'They\u2019re chasing the wrong thing',
        blurb: 'Convinced the substitute will fix it',
        resist: 'What do they believe will settle it, that cannot?',
        conduct: 'How do they chase it, and who ends up paying?' },
    defense: { c: 'var(--ce-pat-defense, #5aa6de)', sub: 'Defense',
        name: 'They\u2019re guarding a sore spot',
        blurb: 'Something they cannot afford to have seen',
        resist: 'What would it cost them to be seen clearly?',
        conduct: 'How do they steer away from it, and what leaks anyway?' },
    ruleset: { c: 'var(--ce-pat-ruleset, #9aa8b8)', sub: 'Rule set',
        name: 'They live by rules',
        blurb: 'A private code, and the day it breaks',
        resist: 'What are their rules, and which one will have to give?',
        conduct: 'How do they keep them, and what happens when someone else does not?' },
    appetite: { c: 'var(--ce-pat-appetite, #d55a72)', sub: 'Appetite',
        name: 'They want what they want',
        blurb: 'A hunger, and the one line they hold',
        resist: 'What can they not refuse \u2014 and what will they not touch?',
        conduct: 'How do they go after it: openly, patiently, or sideways?' },
    mask: { c: 'var(--ce-pat-mask, #9e7ade)', sub: 'Function mask',
        name: 'The role isn\u2019t the person',
        blurb: 'A part they play that forbids something',
        resist: 'What does the role forbid them from wanting?',
        conduct: 'How do they perform it, and when does the person slip through?' },

    // [PATTERN-8] Two patterns the first six could not carry. Every one of the
    // original six locates the cost INSIDE the character -- a competing truth, a
    // substitute, a sore spot, a code, a hunger, a role. That is the right model for a
    // protagonist and the wrong one for the two shapes authors kept trying to force into
    // it: the character whose pursuit costs OTHER people (collateral), and the character
    // who does not get to choose at all (obligation). Both were being filed under
    // 'ruleset' or 'wantneed' and generating slot text that argued against itself.
    collateral: { c: 'var(--ce-pat-collateral, #c2563f)', sub: 'Collateral',
        name: 'They break what is in the way',
        blurb: 'Damage they will not call damage',
        resist: 'Who pays for this, and what do they tell themselves?',
        conduct: 'How do they step over someone, and what happens when they have to look?' },
    obligation: { c: 'var(--ce-pat-obligation, #6d76b5)', sub: 'Obligation',
        name: 'They do not get to choose',
        blurb: 'A chain they cannot break, and one private rebellion',
        resist: 'What binds them to it, and what have they kept for themselves?',
        conduct: 'How do they carry out the duty, and where do they drag their feet?' }
};

// Stored value wins when it is one of the two known shapes; otherwise scan. A record with
// any slot value written is a studio character, a record with any core narrative prose is a
// classic one, and a record with neither is new -- which resolves to 'studio' because that
// is the guided path and a blank character benefits most from being walked.
function _ceResolveShape(char: any, cfg: any): string {
    var stored = String((char && char.uiShape) || '');
    if (stored === 'studio' || stored === 'classic') return stored;
    // [earlier SHAPE-CLASSIC-FIRST, per user: "the default view is the new style which
    // hides their fields and shows blank slots"] THE CLASSIC SCAN NOW RUNS FIRST.
    //
    // The old order asked "is there a slot value?" before "is there sheet prose?", which
    // is the wrong question for a record written before the studio model existed. Slot
    // values arrive on such a record by accident -- one tap in the pattern picker, one
    // Generate pressed while the surface happened to be in studio shape -- and a SINGLE
    // stray slot outvoted four fully written sheet fields. The reverse mistake is not
    // symmetric: a studio character has no path that writes physicalDescription /
    // personalityCore / voiceAndMannerisms / background behind the author's back, because
    // those fields are only reachable from the sheet renderer itself.
    //
    // coreValues counts as classic evidence too. It is a sheet-only field and a record
    // with values in it and nothing else was resolving to studio, i.e. to a screen that
    // showed none of what had been written.
    //
    // Either way this is only a GUESS for records that have never chosen. The moment the
    // author uses the switch, uiShape is stored and neither scan runs again -- and
    // the toggle at the top of the Profile makes a wrong guess correctable in one tap.
    try {
        var vals = (char && char.customFieldValues) || {};
        var j = 0;
        for (j = 0; j < STATIC_FIELD_DEFS.length; j++) {
            if (String((char as any)[STATIC_FIELD_DEFS[j].key] || '').trim() !== '') return 'classic';
        }
        if (Array.isArray((char as any).coreValues) && (char as any).coreValues.length > 0) return 'classic';
        var defs = (cfg && cfg.customStaticFields) || [];
        for (var i = 0; i < defs.length; i++) {
            var d: any = defs[i];
            if (!d || String(d.kind || '') !== 'slot') continue;
            if (String(vals[d.id] || '').trim() !== '') return 'studio';
        }
    } catch (eShape) { api.v1.error('[AE:shape] resolve failed:', eShape); }
    // [SHAPE-CLASSIC-DEFAULT] A record with NO evidence either way now
    // resolves to 'classic', not 'studio'. earlier had already made the classic scan run
    // first; this closes the remaining case, which is the one a brand-new character hits.
    // The old default existed because studio was "the guided path" -- but Classic now
    // carries Core and Pursuit itself (see _ceProfileClassic), so the guided extras are
    // one tap away on the shape toggle rather than something a new record is opted into.
    return 'classic';
}

// [PATTERN-STORED] Resolve which pattern is active for this character. Stored
// char.pattern wins when it validates against CE_PATTERN_IDS; otherwise falls back to the
// earlier scan (first customFieldValues resist slot with content), which is what makes
// every record saved before this version keep working with no migration step. A record
// that has never had a pattern touched at all correctly resolves to ''.
//
// This is now the ONE place pattern identity is resolved. _ceCharPatternSlots and the
// Generation Diagnostics dump (~line 1780) both call this rather than re-deriving it, so
// there is exactly one scan to keep in sync with CE_PATTERN_IDS, not two.
function _ceResolveCharPattern(char: CharacterRecord): string {
    const stored = String((char as any).pattern || '');
    if (stored && CE_PATTERN_IDS.indexOf(stored) >= 0) return stored;
    const cfv = (char as any).customFieldValues || {};
    for (const pid of CE_PATTERN_IDS) {
        const r = cfv['ce_slot_resist_' + pid];
        if (r && String(r).trim()) return pid;
    }
    return '';
}

// [PATTERN-STORED] Reads resist/conduct text for the RESOLVED pattern rather than
// scanning for text directly. Behaviourally identical to the earlier version for every
// existing record (the scan _ceResolveCharPattern falls back to is the same scan this
// function used to run inline) -- the only change in outcome is for a record whose stored
// pattern has been switched to one with empty resist/conduct text, which correctly now
// reports empty rather than falling through to whichever OTHER pair happens to have text.
function _ceCharPatternSlots(char: CharacterRecord): { resistance: string; conduct: string } {
    const pid = _ceResolveCharPattern(char);
    if (!pid) return { resistance: '', conduct: '' };
    const cfv = (char as any).customFieldValues || {};
    const r = cfv['ce_slot_resist_' + pid] || '';
    const c = cfv['ce_slot_conduct_' + pid] || '';
    return { resistance: String(r).trim(), conduct: String(c).trim() };
}

// [EPHEMERAL-REWIRE] Grades the SAME model-authored immediateDesire by rule,
// never by asking the model to re-author urgency — the pressure tier changes the verb
// framing (want -> seek -> commit), the character's own words never change. This is
// the mechanism that gives a narrative-trained model an actual push toward agency: by
// tier 4 the line reads as near-future fact ("is going to X — now"), not a feeling, and
// a model conditioned on narrative prose is far more likely to carry a stated upcoming
// action into the next beat than an interior "wants X". desire arrives as a bare verb
// phrase (see the prompt's instruction) — normalized defensively here in case older
// saved data or model drift still capitalizes/punctuates it as a standalone sentence.
function _ceFrameIntent(desire: string, tier: number): string {
    let d = String(desire || '').trim().replace(/\.+$/, '');
    if (d) d = d.charAt(0).toLowerCase() + d.slice(1);
    if (!d) return '';
    // [NPC-TPL-1LINE] Capitalized, because this is now a SECOND SENTENCE on the
    // same line as the reaction rather than its own line: "Name — thinking: <reaction>.
    // Wants to <desire>." Sentence separation is what keeps the intent from reading as
    // more interior monologue (the earlier em-dash join was the failure) while still
    // costing only one Author's Note line per character. It stays LAST on the line
    // deliberately — closest to the generation point is where a stated near-future
    // action has the most pull on what the model writes next.
    if (tier >= 4)      return 'Is going to ' + d + ' — now.';
    if (tier >= 2)      return 'Is looking for a way to ' + d + '.';
    return 'Wants to ' + d + '.';
}

// [POSITION] The Position half of the same idea, and the same discipline: the
// model never rewrites shape or standing, it only classifies, and this turns the
// resulting tier into one short clause appended to the author's own words.
//
// The axis is OBJECTIVE, so it runs the full signed -4..+4 that _ceAxisFloor gives every
// non-hook axis. Positive is friction (the relationship is getting harder), negative is
// progress (it is getting easier) — the SAME polarity convention as pursuit, which is why
// 'blocked' and 'advanced' can mean the obvious thing here without a sign flip anywhere.
//
// Returns '' across the middle band (-1..1) on purpose. A relationship where nothing has
// moved should say nothing extra rather than assert stability it has not earned, and an
// empty macro lets the template bracket self-suppress instead of rendering a limp clause
// on every single line.
// [HOOK-BAND] The tier-graded clause on the hook line, and the exact counterpart of
// _ceFrameIntent: the model never rewrites the line, the tier grades it. Empty below 4 --
// tier 3 injects the tension itself and says nothing about what to do with it, which is
// the difference between "present" and "critical". At 4 it asks for the scene, because a
// hook parked at the cap with no instruction is a fact the story keeps not using.
function _ceFrameHookPressure(tier: number): string {
    return (Number(tier) || 0) >= 4
        ? 'This should surface between them now, out loud and in the open.'
        : '';
}

// [F-17] REWRITTEN TO SAY WHAT TO DO, NOT ONLY WHAT IS TRUE. The old strings were four
// weather reports -- "This is under strain." -- which a model can read and then write the
// scene it was going to write anyway. A Position line is the ONLY place the engine tells
// the model how an established relationship should be played, so each tier now names a
// behaviour: what shows, and what it costs them to hide it. Still no proper nouns and no
// events; it grades prose the author wrote and must not invent facts to sit beside it.
// STILL EMPTY AT -1..1. A relationship with nothing moving should say nothing at all --
// that is what keeps the line meaningful when it does appear.
function _ceFramePosition(tier: number): string {
    if (tier >= 4)  return 'This is at breaking point. Let it show in what they refuse to say '
        + 'as much as in what they do. Politeness here should read as a held breath.';
    if (tier >= 2)  return 'This is under strain. They are guarding something \u2014 give them a '
        + 'moment of friction they have to work to smooth over.';
    if (tier <= -4) return 'This has settled into something steady. They can be unguarded here, '
        + 'and should be: assume trust rather than earning it again.';
    if (tier <= -2) return 'This is easing. Let them offer something small they would not have '
        + 'offered before.';
    return '';
}

// [F-17] The same ladder as one word, for receipts and prompts. NOT the model-facing text:
// that one instructs and this one merely names, and collapsing them would either put stage
// directions in the author's receipt or a bare adjective in the model's context.
function _ceFramePressureWord(tier: number): string {
    if (tier >= 4)  return 'breaking';
    if (tier >= 2)  return 'strained';
    if (tier <= -4) return 'settled';
    if (tier <= -2) return 'easing';
    return 'level';
}

async function generateEphemeral(
    char: CharacterRecord,
    cfg: GlobalConfig,
    genCount: number = 0 // [E1] was tokenCount
): Promise<boolean> {
    try {
        // [STORY-BLOCK] WAS getRecentStoryText(1500), a tail-anchored window that
        // shared no prefix with anything -- not with the previous turn's call, and not with
        // generateHookUpdates in the same pass, which asked for 4000 and therefore got a
        // strictly different string. Now the pass-wide block, read from memory.
        const recentText = ceStoryBlockText();
        // [EPHEMERAL-REWIRE] This IS the beat pass now — the pursuitState ask
        // rides the same call rather than adding a second one (cost-neutral: same
        // context, same moment, ~5 extra output tokens for one enum word).
        const _cePatSlots = _ceCharPatternSlots(char);

        // [POSITION] The positionState ask is gated TWO ways, not one. Pursuit is
        // an internal objective and is always askable if it exists; a Position is a read
        // of another party, so asking the model to classify what the beat did to it while
        // that party is nowhere in the scene invites an answer invented out of nothing —
        // and an invented classification moves a real tier, which is precisely the kind of
        // fabricated evidence the whole model is built to refuse. Absent target, no ask,
        // no tier movement, and the beat costs the same as it did before.
        const _cePos: any = (char as any).position;
        let _cePosOn = false;
        let _cePosName = '';
        const _cePosTid = _cePos ? String(_cePos.targetId || '') : '';
        if (_cePosTid && (_cePos.shape || _cePos.standing)) {
            if (ceIsProtagonistRef(_cePosTid)) {
                _cePosOn = true;
                _cePosName = String(_cePos.targetName || '') || cfg.protagonistName || 'the protagonist';
            } else {
                try {
                    const _cePosIdx = await loadIndex();
                    const _cePosHit = _cePosIdx.find(function(m: any) {
                        return m && m.id === _cePosTid && m.active && m.scenePresent;
                    });
                    if (_cePosHit) {
                        _cePosOn = true;
                        _cePosName = String(_cePos.targetName || '') || String((_cePosHit as any).name || '');
                    }
                } catch (ePosGate) {
                    api.v1.error('[AE:engine] position gate index read:', ePosGate);
                    _cePosOn = false;
                }
            }
        }

        const sys = [
            // [STYLE-SCOPE] cfg.generalStyle REMOVED, closing the
            // PICKER-SPLIT against buildChatThoughtSystemPrompt, which cut it in earlier.
            // an earlier STATED reason was wrong -- it called the field "a story-PROSE style
            // guide", and the shipped default is a DOSSIER-voice guide ("...concise
            // psychological dossier"), which would have been defensible here. The real
            // reason is that the field is free text with no schema and it DRIFTS: a live
            // story had it holding second-person story-prose directives, which then sat
            // first in a prompt whose output is strict JSON. An output shape must not
            // depend on what a user happened to type in an unrelated box. The UI copy that
            // invited that drift is fixed in the same patch (SECTION 34).
            `Generate an internal snapshot for ${char.name} based on the current moment.`,
            // [AIR1] Explicit isolation: when multiple characters are present,
            // each generation call must produce only this character's perspective.
            `Focus exclusively on ${char.name}. Do not generate, reference, or echo the internal states, reactions, or thoughts of any other character present in the scene.`,
            // [GENESIS] Examples describe SHAPE ONLY — no sample story content to
            // copy (observed failure: output lifted the old worked examples verbatim).
            `Return ONLY valid JSON with these exact keys:`,
            `  "eventAnchor": The one concrete, observable thing in the latest story beat ${char.name} is reacting to — a specific action, object, line, or silence, never a mood or abstraction. One sentence, normal sentence case, ending with a period. This is scaffolding for you, the writer — it grounds the next two fields in something real. It is NOT shown to the reader.`,
            `  "emotionalResponse": ${char.name}'s own unspoken reaction, written as a first-person internal thought in ${char.name}'s own voice and cadence — not a third-person description of an emotion, and not an emotion-label word ('felt', 'angry', 'sad'). Do not use ${char.name}'s name. One sentence, normal sentence case, ending with a period.`,
            `  "immediateDesire": The single action ${char.name} intends right now — a bare verb phrase, under 10 words, no name/subject prefix, NO capital letter, NO trailing period (e.g. "get out before he says it", not "Get out before he says it."). This will be inserted into a sentence, so it must read as a lowercase clause fragment, not a standalone sentence.`,
            char.customFieldValues?.['ce_slot_pursuit'] ? `  "pursuitState": Given ${char.name}'s current objective (Pursuit, below), classify what the recent story just did to it. Exactly one of: "blocked" (thwarted, made harder, or closed off an easy route), "advanced" (real progress, or ground gained), "untouched" (this beat did not meaningfully touch it).` : '',
            // [POSITION] Same three words as pursuitState, deliberately: _ceApplyPressure
            // takes exactly this enum, and the sign convention is shared (positive tier is
            // friction, negative is progress), so 'blocked'/'advanced' mean the obvious thing
            // on both axes and no call site anywhere needs to special-case a flip.
            _cePosOn ? `  "positionState": Given where ${char.name} stands with ${_cePosName} (Position, below), classify what the recent story just did to it. Judge it from ${char.name}'s side only. Exactly one of: "blocked" (strained it, cost trust, or pushed them further apart), "advanced" (closed distance, or ground gained between them), "untouched" (this beat did not meaningfully touch it).` : '',
            // [THOUGHT-VOICE-CASE] Was three separate "Capitalized." cues, one per
            // field — that repetition is what was pushing the model to all-caps output
            // instead of sentence case. One explicit instruction, stated once, below.
            `Write emotionalResponse and eventAnchor in normal sentence case — a capital letter only at the very start, never the whole field in capitals. immediateDesire is the one exception: it stays fully lowercase per its own instruction above, since it is a fragment, not a sentence. Every detail must come from the story and character context below, never from the wording of these instructions. No markdown fences. No extra keys. Return nothing but the JSON object.`
        ].filter(Boolean).join('\n');

        // [EPHEMERAL-REWIRE] Repetition guard now checks the last 2 INTENTS, not
        // the last 2 full compressedLines. A stuck character restates the same immediate
        // desire, not the same eventAnchor+reaction+desire triple — checking the whole
        // line wasted budget re-feeding old story recap to prevent an echo it wasn't
        // actually the source of. The real anti-repetition mechanism is structural: three
        // 'blocked' beats escalates the FRAMING (see _ceFrameIntent), so a character who
        // keeps wanting the same thing moves toward acting on it instead of repeating the
        // want verbatim.
        // [PASS-D COND-REACH] Same builder as the lorebook and the hook prompt -- see
        // buildHookStateContext. Placed with the character facts in the TAIL of the
        // user turn, never above `Story so far`, so the shared story prefix stays
        // byte-identical across the two calls in this pass (earlier STORY-BLOCK).
        let _ceCondCtx = '';
        try { _ceCondCtx = (await buildDynamicLorebookContent(char, cfg)).trim(); }
        catch (eEphCond) { api.v1.error('[AE:engine] ephemeral conditions:', eEphCond); }
        const ephHistLines = (char.ephemeralHistory || []).slice(0, 2)
            .map(function(h: any) { return h.immediateDesire || ''; }).filter(Boolean);

        const usr = [
            // [STORY-BLOCK] STORY FIRST, AND THIS ORDER IS THE WHOLE POINT. The block
            // is byte-identical across every generator in this pass and across every turn
            // until the scene changes, so as a PREFIX it is billed once and cached
            // thereafter -- measured at ~99% off, /ce cache run. As a suffix, which is where
            // it used to sit, it was billed in full on every call.
            // It also puts the per-character material LAST, immediately before the ```json
            // fence, which is the position this file's own CHARCHAT-INSTRUCTION and
            // WIZLIVE-INSTRUCTION lessons found steers most reliably. That is a hypothesis
            // here, not a measurement: those were observed on story-mode context swaps, not
            // on an isolated JSON probe. If snapshot quality drops, this is the change.
            recentText ? `Story so far:\n${recentText}` : '',
            `Character: ${char.name}`,
            char.personalityCore       ? `Personality: ${char.personalityCore}` : '',
            char.voiceAndMannerisms    ? `Voice/manner: ${char.voiceAndMannerisms}` : '',
            // [EPHEMERAL-REWIRE] midRange.currentDesire/socialMask/shiftedView
            // replaced with the schema v0.2 slots: Core (constant, threshold-only) and
            // Pursuit (the concrete objective now) are pattern-independent; Resistance
            // and Conduct are resolved from whichever pattern this character's slots were
            // authored under (_ceCharPatternSlots). Conduct in particular is new and
            // high-value here — "what they do when Drive meets Resistance" is exactly
            // what should shape an immediate desire, which is the whole point of pulling
            // it in even though it costs a few hundred bytes of input (no input budget
            // constraint, per user — only output tokens and story context are limited).
            char.customFieldValues?.['ce_slot_core']    ? `Core (won't let go of): ${char.customFieldValues['ce_slot_core']}` : '',
            char.customFieldValues?.['ce_slot_pursuit'] ? `Pursuit (going after now): ${char.customFieldValues['ce_slot_pursuit']}` : '',
            _cePatSlots.resistance ? `Resistance (what holding Core costs): ${_cePatSlots.resistance}` : '',
            _cePatSlots.conduct    ? `Conduct (their standing move when it costs them): ${_cePatSlots.conduct}` : '',
            // [POSITION] Two lines instead of the old one-line relationship digest,
            // and both are the AUTHOR's text verbatim. shape is what the relationship is;
            // standing is where it currently sits. The model reads them to classify and to
            // colour the snapshot, and never to rewrite them.
            _cePosOn ? `Position on ${_cePosName} — what it is: ${_cePos.shape || 'unstated'}` : '',
            _cePosOn && _cePos.standing ? `Position on ${_cePosName} — where it stands: ${_cePos.standing}` : '',
            _ceCondCtx ? `Currently true of ${char.name} (holds regardless of the scene): ${_ceCondCtx}` : '',
            ephHistLines.length > 0    ? `Already intended recently (do not repeat verbatim): ${ephHistLines.join(' / ')}` : '',
            // [STORY-BLOCK] Kept in place; the block is hoisted to the FRONT of the
            // user turn below, and this slot is now empty. See the usr assembly.
            '',
            '\n```json\n'
        ].filter(Boolean).join('\n');

        // [EPHEMERAL-REWIRE] max_tokens nudged 220->240. Not a budget cut — output
        // tokens are the one real constraint here — this is headroom so the new
        // pursuitState key can never be the thing that gets truncated off the end.
        // [POSITION] 240 -> 260 for positionState, the second enum key on this same
        // call. THIS LITERAL AND AE_BUDGET_EPH MUST MOVE TOGETHER — the dispatch gate is
        // that constant, so if it stays behind, the gate admits a call this request cannot
        // fit, the JSON truncates mid-object, extractJSON returns nothing, and the beat is
        // skipped with no error anywhere. Silent, not loud. Grep AE_BUDGET_EPH first.
        const resp   = await aeDiagGenerate('ephemeral:' + char.name, [{ role: 'system', content: sys }, { role: 'user', content: usr }],
            { model: 'glm-4-6', max_tokens: 260, temperature: 0.85 }
        );
        const parsed = extractJSON(resp.choices[0]?.text || '');
        if (!parsed || (!parsed.eventAnchor && !parsed.emotionalResponse && !parsed.immediateDesire)) return false;

        // [PRESSURE-AXIS] Pursuit pressure is its own axis, separate from hook
        // pressure (user: "Separate pressure") — each can fire its own prompt card
        // without the two competing for one slot in a beat. Applied here, in the story
        // path only; generateChatEphemeral (CharChat's separate transport) is deliberately
        // untouched by this pass and does not feed or read this axis.
        const pursuitEvidence = ['blocked', 'advanced', 'untouched'].indexOf(parsed.pursuitState) !== -1
            ? parsed.pursuitState : 'untouched';
        await _ceApplyPressure(char.id, 'pursuit', pursuitEvidence);

        // [POSITION] Second axis off the same reply. The key is per-TARGET
        // ('position_<targetId>'), which _cePressureKey already supports without change
        // since it takes an arbitrary axis string. Repointing a Position at someone else
        // therefore starts that pairing at tier 0 and orphans the old key in
        // historyStorage, which is the correct outcome and needs no reset code: evidence
        // gathered about one person is not evidence about another.
        // Only applied when the ask was actually made — otherwise every beat with an
        // absent target would coerce to 'untouched' and quietly hold the tier's decay
        // story open on a relationship nobody was in the room for.
        if (_cePosOn) {
            const positionEvidence = ['blocked', 'advanced', 'untouched'].indexOf(parsed.positionState) !== -1
                ? parsed.positionState : 'untouched';
            await _ceApplyPressure(char.id, 'position_' + _cePosTid, positionEvidence);
        }

        return await _persistEphemeralSnapshot(char.id, parsed, cfg, genCount);
    } catch (e) {
        api.v1.error('[AE:engine] generateEphemeral:', e);
        return false;
    }
}

// [CHARCHAT-THINK-FIRST] Extracted verbatim from generateEphemeral's tail so
// generateChatEphemeral can share it. This is the ONLY thing the two generators have in
// common and the only thing worth sharing: they differ entirely in what they ask for and
// what context they ask it against, but a snapshot is a snapshot once it comes back, and
// two copies of the persistence rules (compose, cap, history push, sidebar) is how the
// two drift apart. Behaviour is unchanged from earlier for the story path.
async function _persistEphemeralSnapshot(charId: string, parsed: any, cfg: GlobalConfig, genCount: number): Promise<boolean> {
    const fresh = await loadCharacter(charId);
    if (!fresh) return false;

    const _ea = String(parsed.eventAnchor       || '').trim();
    const _er = String(parsed.emotionalResponse || '').trim();
    const _id = String(parsed.immediateDesire   || '').trim();
    const _composed: string = (_ea || _er || _id)
        ? [_ea, _er, _id].filter(Boolean).join(' — ')
        : String(parsed.compressedLine || '').trim();

    // [EVIDENCE-STAMP] Recorded only when it is one of the three known values, so
    // the stamp can never claim the model answered when it did not. An absent stamp on a
    // story-path snapshot therefore means "no usable classification came back" and is
    // itself the diagnostic. The chat path never sends one and is unaffected.
    const _ps = String(parsed.pursuitState || '').trim();
    const _psOk = (_ps === 'blocked' || _ps === 'advanced' || _ps === 'untouched');
    // [POSITION] Same rule, same reason. The chat path never sends either key and
    // is unaffected: both stamps stay undefined there, which is honest — generateChatEphemeral
    // does not classify.
    const _pos = String(parsed.positionState || '').trim();
    const _posOk = (_pos === 'blocked' || _pos === 'advanced' || _pos === 'untouched');

    const snapshot: EphemeralSnapshot = {
        eventAnchor: _ea, emotionalResponse: _er, immediateDesire: _id,
        compressedLine: _composed, generatedAtGen: genCount, // [E1]
        pursuitState: _psOk ? _ps : undefined, // [EVIDENCE-STAMP]
        positionState: _posOk ? _pos : undefined // [POSITION]
    };

    fresh.ephemeral        = snapshot;
    fresh.ephemeralHistory = [snapshot, ...(fresh.ephemeralHistory || [])].slice(0, Number(cfg.ephemeralCap) || 3);
    fresh.lastEphemeralGen = genCount; // [E1]
    fresh.lastEphemeralTokens = await _aeCurrentTokenCount(); // token-mode stamp companion
    await saveCharacter(fresh);
    // [SWEEP] Was refreshSidebar(). The snapshot it repainted is on the jsx
    // Profile now, and this is the one former call site with no publish beside it.
    try { await cePublishProfile(fresh.id); } catch (ePub) {}
    return true;
}

// The chat-aware thinking generator. Called from onGenerationEnd's CHARCHAT branch AFTER
// the reply lands; produces the "right now" line the NEXT reply carries.
//
// THIS IS generateEphemeral WITH A DIFFERENT PROMPT. A clean two-message array through
// api.v1.generate(): no story context, no onBeforeContextBuild, and therefore none of NAI's
// turn scaffold ('<|assistant|><think></think>', 'Write./nothink'), which was measured
// contaminating the native route twice per build.
//
// WHY NOT LITERALLY generateEphemeral: it feeds getRecentStoryText(1500), which reads the
// document tail BACKWARDS. During a chat the tail IS the transcript, so it handed the model
// a text conversation under the header "Recent Story:" while the actual story fell out of
// the window. Here the two are separated and labelled honestly -- story-above-marker as
// background, transcript as the thing being replied to (buildChatThoughtBody) -- with the
// transcript explicitly terminated so the model does not simply continue it.
async function _charchatPrimeSlot(): Promise<void> {
    let ccpSig: any = null;
    try {
        try { ccpSig = await api.v1.createCancellationSignal(); }
        catch (_ecpSig) { ccpSig = null; }
        _ccThoughtSignal = ccpSig;
        await aeDiagGenerate('chatPrime',
            [{ role: 'user', content: 'ok' }],
            { model: 'glm-4-6', max_tokens: 1, temperature: 0 },
            ccpSig, 'background');
        aeLog('[AE:charchat:prime] slot primed (Fresh Thoughts off) \u2014 a 1-token throwaway '
            + 'generation to settle NAI\u2019s generation slot after this turn\u2019s document edits, so the '
            + 'NEXT native Send does not come back empty. See CHARCHAT-SLOT-PRIME.');
    } catch (e) {
        // Identical failure posture to the thought pass: doing nothing is a safe fallback. The
        // only cost of a failed prime is that this specific turn keeps the two-press behaviour.
        aeLog('[AE:charchat:prime] slot prime failed (this turn may still need a second Send):', e);
    } finally {
        if (_ccThoughtSignal === ccpSig) _ccThoughtSignal = null;
        if (ccpSig && ccpSig.dispose) { try { ccpSig.dispose(); } catch (_ecpD) {} }
    }
}

async function generateChatEphemeral(char: CharacterRecord, cfg: GlobalConfig, genCount: number = 0): Promise<boolean> {
    let ccteSig: any = null;
    try {
        try { ccteSig = await api.v1.createCancellationSignal(); }
        catch (_ecteSig) { ccteSig = null; }
        _ccThoughtSignal = ccteSig;

        let ccteSys = buildChatThoughtSystemPrompt(char, cfg);
        let ccteUsr = await buildChatThoughtBody(char);
        let ccteT0 = Date.now();
        let ccteResp: any = await aeDiagGenerate('chatEph:' + char.name,
            [{ role: 'system', content: ccteSys }, { role: 'user', content: ccteUsr }],
            { model: 'glm-4-6', max_tokens: 220, temperature: 0.85 },
            ccteSig, 'background');

        if (ccteSig && ccteSig.cancelled) {
            aeLog('[AE:charchat:thought] cancelled mid-flight (a Send arrived) \u2014 discarded, previous thought stands.');
            return false;
        }
        let ccteText = String((ccteResp && ccteResp.choices && ccteResp.choices[0]
            && (ccteResp.choices[0].text || (ccteResp.choices[0].message && ccteResp.choices[0].message.content))) || '');
        aeLog('[AE:charchat:thought] direct call returned ' + ccteText.length + ' chars in '
            + (Date.now() - ccteT0) + 'ms. This is the post-reply thought: it informs the NEXT reply, '
            + 'not the one that just landed.');
        if (!ccteText) return false;

        let ccteParsed = _charchatParseThought(ccteText);
        if (!ccteParsed || (!ccteParsed.eventAnchor && !ccteParsed.emotionalResponse && !ccteParsed.immediateDesire)) {
            aeLog('[AE:charchat:thought] no usable thought \u2014 keeping the previous one, silently, as designed.');
            return false;
        }
        let ccteOk = await _persistEphemeralSnapshot(char.id, ccteParsed, cfg, genCount);
        aeLog('[AE:charchat:thought] ' + (ccteOk
            ? 'persisted \u2014 the next reply\'s tail will carry it.'
            : 'persist failed \u2014 previous thought stands.'));
        return ccteOk;
    } catch (e) {
        api.v1.error('[AE:charchat:thought] generateChatEphemeral failed (previous thought stands):', e);
        return false;
    } finally {
        // Identity-checked, not a blind clear. A cancelled call can settle AFTER the next
        // reply has already started its own thought, and a blind `= null` here would wipe the
        // NEW signal, silently making that one uncancellable \u2014 the exact class of bug
        // earlier removed from the hand-rolled _diagProbeActive pairs. Only the owner clears.
        if (_ccThoughtSignal === ccteSig) _ccThoughtSignal = null;
        if (ccteSig && ccteSig.dispose) { try { ccteSig.dispose(); } catch (_ecteD) {} }
    }
}

// [BUGFIX earlier CHARCHAT-THOUGHT-PARSE] The chat thought's OWN parser. Deliberately local:
// the shared extractJSON is load-bearing for the wizard, entity batch and imgArchitect, all
// of which currently work, and the shape this has to handle is created by THIS subsystem's
// own prompt (buildChatThoughtBody ends with an open json fence to prime the model, so
// the completion legitimately arrives with no opening brace). Fixing the shared parser for a
// shape only this caller produces would put five working subsystems at risk for no gain.
//
// Order matters. Fence-strip BEFORE any brace reasoning: the fence is the reason the brace is
// missing, so repairing braces first just slices from the wrong one (extractJSON's third
// strategy does exactly that and is why this failed on every single run).
// Falls through to the shared extractJSON last, so anything that parsed before still parses.
// [CHARCHAT-THOUGHT-SHAPE] THE parser for the thought pass. Labelled lines first,
// JSON second.
//
// WHY THE WIRE FORMAT CHANGED, and the answer to "why was it JSON at all": nothing downstream
// wants JSON. _persistEphemeralSnapshot wants three named strings and reads nothing else. JSON
// was one way to carry three labels and a fragile one in this position — a single unescaped
// apostrophe or a trailing comma loses the WHOLE object (both observed live: "eventAnchor":
// Nate's defensive question about being fun.), and, sitting under a chat transcript, a json
// fence reads to the model as "write a code block in the chat" rather than "stop chatting."
// Three labelled lines cannot be broken by the character's own punctuation, degrade one field
// at a time instead of all-or-nothing, and look nothing like a chat message.
//
// SCOPE: chat thoughts ONLY, per user. This has one call site (onGenerationEnd's thought
// branch). generateEphemeral and the shared extractJSON still speak JSON and are untouched.
function _charchatParseThought(raw: string): any {
    if (!raw) return null;
    let ccR = String(raw);

    // Labelled lines. Tolerant on purpose: optional markdown bold/bullets, any case, and a
    // value that may run to the end of its line. Anchored to line starts so a label MENTIONED
    // inside a value cannot hijack the parse.
    let ccPick = function(ccLabel: string): string {
        // The trailing \\**? matters and is not padding: a model that bolds the label writes
        // **EVENT:** ..., where the closing asterisks sit AFTER the colon. Consuming only the
        // leading pair leaks '**' into the value (caught by test, not by reading).
        let ccRx = new RegExp('^[ \\t>*-]*\\**[ \\t]*' + ccLabel + '[ \\t]*\\**[ \\t]*[:\\uff1a][ \\t]*\\**[ \\t]*(.+?)[ \\t]*\\**[ \\t]*$', 'im');
        let ccM = ccR.match(ccRx);
        if (!ccM || !ccM[1]) return '';
        // Strip wrapping quotes if the model quoted the value anyway, and a trailing comma if
        // it half-remembered JSON. Both are harmless to strip and common in practice.
        let ccV = ccM[1].trim().replace(/,\s*$/, '').trim();
        if (ccV.length > 1 && ccV.charAt(0) === '"' && ccV.charAt(ccV.length - 1) === '"') ccV = ccV.substring(1, ccV.length - 1);
        return ccV.trim();
    };

    let ccEa = ccPick('EVENT');
    let ccEr = ccPick('RESPONSE');
    let ccId = ccPick('DESIRE');

    if (ccEa || ccEr || ccId) {
        // [DIAG earlier CHARCHAT-THOUGHT-CONTENT] Was y/n presence only -- confirmed the pass
        // ran but hid the one thing worth seeing: session 4 found a live case of the thought
        // misattributing NIX'S OWN prior line to the POV character ("The last message from
        // Ramis was Wrong question, old man." -- that line was Nix's, not Ramis's), immediately
        // before an empty-reply turn. Untraceable without the actual text; y/n told us nothing.
        // Not gated separately -- fires once per turn (Fresh Thoughts on), same volume as the
        // line it extends.
        aeLog('[AE:charchat:thought] parsed via labelled-lines'
            + ' (EVENT=' + (ccEa ? 'y' : 'n') + ' RESPONSE=' + (ccEr ? 'y' : 'n') + ' DESIRE=' + (ccId ? 'y' : 'n') + ').'
            + ' EVENT=' + JSON.stringify(ccEa) + ' RESPONSE=' + JSON.stringify(ccEr) + ' DESIRE=' + JSON.stringify(ccId));
        return { eventAnchor: ccEa, emotionalResponse: ccEr, immediateDesire: ccId };
    }

    // JSON fallback. A model that still emits the old shape must keep working — no flag day,
    // and this is also what catches a run where the prompt cache still holds the old form.
    let ccJ = _charchatExtractThoughtJSON(raw);
    if (ccJ) {
        aeLog('[AE:charchat:thought] parsed via JSON-fallback (the model used the old wire format).'
            + ' EVENT=' + JSON.stringify(ccJ.eventAnchor) + ' RESPONSE=' + JSON.stringify(ccJ.emotionalResponse)
            + ' DESIRE=' + JSON.stringify(ccJ.immediateDesire));
        return ccJ;
    }
    return null;
}

function _charchatExtractThoughtJSON(raw: string): any {
    if (!raw) return null;
    let ccJ = String(raw).trim();
    if (!ccJ) return null;

    // 1. Drop markdown fences, opening and closing, wherever they landed. The body primed an
    //    OPEN fence, so the model's own closing fence is usually the only one present.
    ccJ = ccJ.replace(new RegExp(String.fromCharCode(96, 96, 96) + '[a-zA-Z]*', 'g'), '').trim();

    // 2. Trim anything before the first key and after the last value. The strip pass joins
    //    every new section with a newline, so stray blank lines and any prose the model added
    //    after the JSON both arrive attached.
    let ccFirstKey = ccJ.search(/"(eventAnchor|emotionalResponse|immediateDesire)"/);
    if (ccFirstKey > 0 && ccJ.lastIndexOf('{', ccFirstKey) === -1) ccJ = ccJ.substring(ccFirstKey);

    let ccTry = function(s: string, how: string): any {
        try {
            let ccP = JSON.parse(s);
            if (ccP && typeof ccP === 'object') {
                aeLog('[AE:charchat:thought] parsed via ' + how + '.');
                return ccP;
            }
        } catch (_e) {}
        return null;
    };

    let ccOut = ccTry(ccJ, 'as-is');
    if (ccOut) return ccOut;

    // 3. Brace repair, WITHOUT extractJSON's fatal not-includes-brace gate. That gate is what
    //    made this unreachable: any nested brace, or the model's own closing brace, made it
    //    false while the OPENING brace was still missing. Test what is actually true -- does
    //    it START with a brace -- not whether one exists somewhere.
    let ccBraced = ccJ;
    if (!ccBraced.startsWith('{')) ccBraced = '{' + ccBraced;
    if (!ccBraced.endsWith('}')) ccBraced = ccBraced.replace(/,\s*$/, '') + '}';
    ccOut = ccTry(ccBraced, 'brace repair');
    if (ccOut) return ccOut;

    // 4. UNQUOTED VALUE repair, for the second observed failure:
    //        "eventAnchor": Nate's defensive question about being fun.,
    //    Conservative on purpose -- only the three known string keys, only when the value is
    //    clearly bare (does not start with a quote/brace/bracket/digit), and the value is
    //    taken to the last comma-or-end on its own line. A general JSON relaxer would be a
    //    far bigger blast radius to fix a case the prompt example should now prevent anyway.
    let ccUq = ccBraced.replace(
        /("(?:eventAnchor|emotionalResponse|immediateDesire)"\s*:\s*)([^"\{\[\d\s][^\n]*?)(,?\s*)$/gm,
        function(_m: string, ccK: string, ccV: string, ccTail: string) {
            let ccClean = String(ccV).trim().replace(/,$/, '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
            return ccK + '"' + ccClean + '"' + (ccTail.indexOf(',') >= 0 ? ',' : '');
        });
    if (ccUq !== ccBraced) {
        ccOut = ccTry(ccUq, 'unquoted-value repair');
        if (ccOut) return ccOut;
    }

    // 5. Last resort: the shared parser, unchanged. If it can do something we cannot, take it.
    ccOut = extractJSON(raw);
    if (ccOut) { aeLog('[AE:charchat:thought] parsed via shared extractJSON fallback.'); return ccOut; }

    api.v1.error('[AE:charchat:thought] ALL parse strategies failed. Raw text follows -- if this '
        + 'looks like valid JSON to a human, the repair chain has a gap worth closing; if it looks '
        + 'like prose, the model ignored the prompt and the fix is upstream, not here:\n'
        + String(raw).substring(0, 300));
    return null;
}

function buildChatThoughtSystemPrompt(char: CharacterRecord, cfg: GlobalConfig): string {
    let ccPov = _aeCharChat.povName || 'the person they are texting';
    return [
        // [CHARCHAT-THOUGHT-NOSTYLE] cfg.generalStyle REMOVED. It is a
        // story-PROSE style guide (voice/tense/formatting for narrative writing) and this task
        // is the opposite of narrative writing: three short labelled lines in a fixed shape
        // (see CHARCHAT-THOUGHT-SHAPE below). Sitting first in the prompt, ahead of every actual
        // instruction for this task, it cost tokens and competed with the format constraint for
        // no benefit — nothing about a story's prose style should shape a private internal
        // snapshot line. Cut, not conditioned off: no config path resurrects it here.
        char.name + ' is in a live text-message conversation with ' + ccPov + '. Generate a three-part internal snapshot for ' + char.name + ' as they read the newest message and decide how to answer it.',
        'Focus exclusively on ' + char.name + '. Do not generate, reference, or echo the internal states, reactions, or thoughts of anyone else.',
        'This is a text conversation, not a scene. ' + char.name + ' is reacting to what was SAID to them \u2014 the words, the tone, the ask, or the silence. The story context below is background: who they are and what has happened to them. It is not what they are responding to.',
        // [CHARCHAT-THOUGHT-SHAPE] Was "Return ONLY valid JSON with these exact keys".
        // The model does not obey it: handed a chat transcript it writes the next chat message,
        // because the SHAPE of the context outvotes the instruction every time (the same root
        // cause as the earlier brace bug). JSON also broke on the character's own apostrophes.
        // Three labelled lines instead — nothing downstream ever wanted JSON, only three named
        // strings (see _persistEphemeralSnapshot).
        // [THOUGHT-VOICE-CASE] Was 'Do not write anything in char's voice' — that
        // directly fought the desired outcome (a natural internal thought in the
        // character's own voice) and, combined with 'each starting with its label in
        // capitals' plus three separate 'Capitalized.' cues below, is what was pushing the
        // model to render the whole line in capitals rather than just the label. The
        // distinction that actually matters — this is a private thought, not a reply that
        // gets sent — is kept; the voice restriction is not.
        'This is NOT a message and will never be sent to ' + ccPov + ' \u2014 it is ' + char.name + '\u2019s own private internal thought as they decide how to answer. Do not continue the conversation. Write RESPONSE the way ' + char.name + ' would actually think it: first person, in their own voice and cadence.',
        'Write EXACTLY three lines and nothing else. Each line starts with its label and a colon (only the label word itself is capitals, e.g. "EVENT:" \u2014 the rest of the line is normal sentence case, never written in all capitals):',
        'EVENT: The specific thing in the most recent message from ' + ccPov + ' that ' + char.name + ' is reacting to \u2014 an actual phrase, question, or refusal, never a mood or abstraction. One sentence, normal sentence case, ending with a period.',
        'RESPONSE: ' + char.name + '\u2019s own unspoken first-person thought \u2014 not a third-person description of an emotion, and not an emotion-label word (\u2018felt\u2019, \u2018angry\u2019, \u2018sad\u2019). Do not use ' + char.name + '\u2019s name. One sentence, normal sentence case, ending with a period.',
        'DESIRE: What ' + char.name + ' intends to do with their reply right now \u2014 a bare verb phrase, under 10 words, no name/subject prefix. Normal sentence case, ending with a period.',
        // [earlier/earlier] A worked example. Retained through the format change because it is
        // the cheapest possible lever on shape adherence, and re-cast into the labelled form.
        // RESPONSE line re-cast first-person to match the instruction above.
        'Example of the exact shape required (content is illustrative only \u2014 never reuse these words):',
        'EVENT: She asked if he was still coming on Friday.',
        'RESPONSE: Here we go again \u2014 like I haven\u2019t already blown this once.',
        'DESIRE: Deflect until the plan firms up.',
        'No quotes around the values. No JSON. No code blocks. No speaker name. No fourth line. Never write a line in all capitals \u2014 sentence case only. Every detail must come from the context below, never from the wording of these instructions.'
    ].filter(Boolean).join('\n');
}

async function buildChatThoughtBody(char: CharacterRecord): Promise<string> {
    let ccPov = _aeCharChat.povName || 'the person they are texting';
    let ccStory = await _charchatStoryTextAboveMarker(AE_CHATEPH_STORY_TOKENS);
    let ccChat = '';
    try { ccChat = await _charchatCanonicalChatText(); }
    catch (eCe) { api.v1.error('[AE:charchat] thought body: transcript read failed, story-only context:', eCe); ccChat = ''; }
    if (ccChat.length > AE_CHATEPH_CHAT_CHARS) ccChat = '\u2026' + ccChat.substring(ccChat.length - AE_CHATEPH_CHAT_CHARS);

    let ccEphHist = (char.ephemeralHistory || []).slice(0, 2)
        .map(function(h: any) { return (h && h.compressedLine) || ''; }).filter(Boolean);

    return [
        'Character: ' + char.name,
        char.personalityCore    ? 'Personality: ' + char.personalityCore : '',
        char.voiceAndMannerisms ? 'Voice/manner: ' + char.voiceAndMannerisms : '',
        // [POSITION] Position, folded in as flat persona colour. Deliberately NOT
        // gated on scene-presence the way the story path is: a chat is not a scene, the
        // person being texted may well BE the target, and nothing here classifies or moves
        // a tier — it is context for voice only, so the fabrication risk the story-path
        // gate exists to close does not arise.
        ((char as any).position && ((char as any).position.shape || (char as any).position.standing))
            ? 'Where they stand with ' + (String((char as any).position.targetName || '') || 'their closest tie') + ': '
              + [String((char as any).position.shape || ''), String((char as any).position.standing || '')].filter(Boolean).join(' ') : '',
        'Texting with: ' + ccPov,
        ccEphHist.length > 0 ? 'Previous thoughts (do not repeat): ' + ccEphHist.join(' / ') : '',
        ccStory ? '\nStory context \u2014 background only, NOT what they are replying to:\n' + ccStory : '',
        // [CHARCHAT-THOUGHT-SHAPE] THE FIX, and it is about ORDER, not wording.
        // This body used to END with the transcript, dangling on a speaker cue ('Sara:'),
        // followed by an open json fence. A transcript ending on a speaker's name is the
        // strongest continuation cue there is, so the model did the obvious thing and wrote
        // the next chat message \u2014 confirmed verbatim in the RAW diag ('Sara: really?
        // somehow I\u2019m not convinced / Emotion: smug'). The system prompt's 'return only
        // JSON' never stood a chance: the SHAPE of a context beats an instruction about it.
        // So: the transcript is explicitly TERMINATED with a sentinel (nothing is left
        // dangling to continue), and the request for the three lines is what sits at the
        // true bottom \u2014 the most present position, which is exactly where the thing we
        // actually want asked belongs. The open fence is GONE: under a chat transcript it
        // reads as 'write a code block in the chat', which is very plausibly where the
        // literal fence wrapping a chat reply came from in the first live log.
        ccChat  ? '\nText conversation so far \u2014 THIS is what ' + char.name + ' is reacting to. It is FINISHED; do not add to it:\n'
                  + ccChat + '\n[ END OF CONVERSATION \u2014 nothing follows this line ]' : '',
        '\nThe conversation above is complete. Do NOT write the next message.',
        'Write ' + char.name + '\u2019s private internal snapshot as they read that last message, as exactly three labelled lines (EVENT / RESPONSE / DESIRE) and nothing else:'
    ].filter(Boolean).join('\n');
}

// [MIDRANGE-RETIRE] generateMidRange DELETED (~115 lines). It ran a two-mode
// (genesis / ongoing) free rewrite of currentDesire, socialMask and shiftedView every
// cfg.dynamicIntervalGens generations, change-gated into midRangeHistory. Nothing
// replaces it: the whole point of the pressure model is that a classifier moves a
// NUMBER and only the author rewrites prose. Its budget constant AE_BUDGET_MID, its
// 'mid' retry type, its Dynamic-tab rows and its three lorebook templates went with it.
// The relationship generator below is retired next, in step 4b.

// [POSITION] generateRelationshipUpdate DELETED (~90 lines), and with it the
// last free-writing prose generator on a character record. It re-authored currentStatus,
// trajectory and summary every cfg.arcIntervalGens generations against a change gate,
// trailing every change into relationshipHistory.
//
// Nothing replaces it, and that is the whole of step 4b. A generator that rewrites the
// author's description of a relationship is a generator that will eventually disagree
// with the author about what the relationship IS — and since it re-read its own last
// output as the previous value, it also drifted against itself with no fixed point. The
// pressure model inverts that: the beat pass classifies what the story did to the
// Position (blocked / advanced / untouched), _cePressureKey banks a tier, and
// _ceFramePosition grades the FRAMING of prose only the author ever wrote.
//
// Its budget constant AE_BUDGET_REL, its 'rel' retry type, its cadence config
// (arcIntervalGens / arcIntervalTokens), its stamps (lastArcGen / lastArcTokens) and its
// Dynamic-tab Regenerate button went with it.

// [PRESSURE] The generic pressure integrator (schema v0.2 §5). One counter
// PER CHARACTER (fork decision: hooks ride it, bonds will read it later rather than
// keeping a separate counter — one prompt card per beat, not several). Lives in
// historyStorage, NOT storyStorage: pressure is volatile evidence about the current
// story path, and historyStorage resolves from the closest ancestor history node, so
// an Undo naturally reverts it with zero rollback code (verified in script-types.txt).
//
// The model NEVER sets this number and NEVER rewrites prose because of it — it only
// classifies (blocked / advanced / untouched). This function does the arithmetic.
// That split is principle 1 held structurally: there is no code path by which a
// generation call can set the magnitude directly.
//
// Tiers are 0–4, not 0–100: "a layman should read the field and know what it does"
// is the standard the Change toggle set (v0.1 §3) and this follows it. Cap behaviour
// is NO DECAY (per user) — tier 4 parks until a human resolves it; nothing here ever
// walks it back down except an 'advanced' classification.
// [PRESSURE-AXIS] Retrofitted to take an axis so independent pressure tracks
// never collide or share a counter. Fork decision stands (one counter per axis, not
// per bond/target) — but "hooks and Pursuit share one card" was never the design; the
// user's later call was explicit: hook-pressure and Pursuit-pressure are SEPARATE axes,
// each free to fire its own card. Only same-axis sources compete for one slot.
function _cePressureKey(charId: string, axis: string): string {
    return 'ce_pressure_' + axis + '_' + charId;
}

// [PRESSURE-BIDIR] Pressure is signed for OBJECTIVE axes: positive is friction,
// negative is progress. No call site special-cases the sign.
//
// 'hook' floors at 0 on a MEASUREMENT argument and no other. A hook measures a TENSION,
// and a tension's zero already means "noticed, and nothing has moved" -- there is nothing
// below it. This note has twice been caught justifying the floor by naming readers that
// had since been deleted, so it names none: if the floor ever needs defending, defend it
// from what a tension is.
//
// The ceiling stays +4 everywhere, and there is NO DECAY at either end -- both bounds park
// until something resolves them.
function _ceAxisFloor(axis: string): number {
    return (axis === 'hook') ? 0 : -4;
}

async function _ceReadPressure(charId: string, axis: string): Promise<number> {
    const v = await api.v1.historyStorage.getOrDefault(_cePressureKey(charId, axis), 0);
    return Math.max(_ceAxisFloor(axis), Math.min(4, Number(v) || 0));
}

async function _ceApplyPressure(charId: string, axis: string, evidence: 'blocked' | 'advanced' | 'untouched'): Promise<{ prevTier: number; tier: number }> {
    const prevTier = await _ceReadPressure(charId, axis);
    let tier = prevTier;
    if (evidence === 'blocked') tier = Math.min(4, prevTier + 1);
    else if (evidence === 'advanced') tier = Math.max(_ceAxisFloor(axis), prevTier - 1); // [PRESSURE-BIDIR]
    // 'untouched' — no change, and no write, since the ancestor value already reads correct.
    if (tier !== prevTier) await api.v1.historyStorage.set(_cePressureKey(charId, axis), tier);
    return { prevTier: prevTier, tier: tier };
}

// [ATTENTION] "Does this character need the author right now?" — derived from the
// banked tiers, stored NOWHERE. It is a READ, which is why it may be computed rather than
// declared: principle 1 ("the LLM never moves discrete state") is about writes. Nothing
// here writes, so nothing here can drift.
//
// 'ask' fires on an axis parked at +4, ahead of the unbuilt prompt cards, because the
// integrator has NO DECAY at either bound — a +4 axis is already a state only a human can
// move. ONLY POSITIVE TERMINAL RAISES IT: -4 is the far end of PROGRESS on a bidirectional
// axis, and red-flagging a relationship for going well trains the author to ignore the dot.
// Fails toward 'calm' on any error — a degraded read must never invent an alarm.
//
// COST: 2-3 historyStorage reads per character per payload build, and
// buildSceneStatePayload runs on every state change. If a crowded scene ever makes that
// bite, the fix is a per-broadcast memo keyed on charId, NOT a stored field.
async function _ceDramaAttention(char: any): Promise<CharAttention> {
    const calm: CharAttention = { level: 'calm', reason: '' };
    try {
        if (!char || !char.id) return calm;
        // A static character's dynamics never run, so its tiers cannot move. Whatever is
        // banked is frozen history, not a pending decision.
        if ((char as any).isStatic) return calm;

        const axes: { key: string; label: string; tier: number }[] = [
            { key: 'pursuit', label: 'What they want', tier: await _ceReadPressure(char.id, 'pursuit') },
            { key: 'hook',    label: 'Their top hook', tier: await _ceReadPressure(char.id, 'hook') }
        ];
        // Position is the one axis that can be absent — its tier is keyed per-target, so a
        // character with no position, or an unresolved one, has no axis to read. Same rule
        // buildEntityDetailPayload already applies for positionTier.
        const pos: any = (char as any).position;
        const posTid = pos ? String(pos.targetId || '') : '';
        if (posTid) {
            axes.push({
                key: 'position',
                label: 'Where they stand with ' + (pos.targetName || 'the other party'),
                tier: await _ceReadPressure(char.id, 'position_' + posTid)
            });
        }

        for (const ax of axes) {
            if (ax.tier >= 4) {
                return { level: 'ask', axis: ax.key,
                         reason: ax.label + ' is at the top of its range and parked there. Nothing moves it back on its own.' };
            }
        }
        for (const ax of axes) {
            if (Math.abs(ax.tier) >= 2) {
                return { level: 'building', axis: ax.key,
                         reason: ax.label + (ax.tier > 0 ? ' is under real friction.' : ' has moved a long way toward settling.') };
            }
        }
        return calm;
    } catch (eAtt) {
        return calm;
    }
}

// One-time migration for a hook that predates the integrator: it has a model-authored
// record tier and no historyStorage entry yet. Seed the tier from it so
// escalation continues from roughly where the story left off instead of resetting to
// 0. Idempotent — does nothing once the key exists.
// [PRESSURE-AXIS] Also checks the pre-axis earlier key ('ce_pressure_<charId>',
// no axis segment) so any pressure state accumulated during that one-patch window
// migrates forward instead of silently resetting to a legacy-derived guess.
// [HOOK-TIER] NO LONGER DIVIDES BY 25. The record field IS the tier now, so the
// seed is a clamp rather than a conversion -- the 0-100 -> 0-4 rescale happens once, in
// ceMigrateHookTiers, and a second conversion here would divide an already-converted value
// and floor every hook to 0.
async function _ceSeedPressureFromRecord(charId: string, axis: string, recordTier: number): Promise<void> {
    const key = _cePressureKey(charId, axis);
    if (await api.v1.historyStorage.has(key)) return;
    const preAxisKey = 'ce_pressure_' + charId;
    if (await api.v1.historyStorage.has(preAxisKey)) {
        const carried = await api.v1.historyStorage.get(preAxisKey);
        await api.v1.historyStorage.set(key, Math.max(0, Math.min(4, Number(carried) || 0)));
        await api.v1.historyStorage.remove(preAxisKey);
        return;
    }
    await api.v1.historyStorage.set(key, Math.max(0, Math.min(4, Number(recordTier) || 0)));
}

// [HOOK-GATE] THE GATE ONLY GATES WHAT IT CAN RESOLVE, and that scoping is the
// whole design, per user: "if it did not have a valid id a presence gate would always
// block it." The model picks a NAME out of prose. It may pick a name the cast does not
// contain -- a person the story mentions but no record exists for, or the right person
// under the wrong spelling. A gate that demanded an id would therefore refuse every hook
// it could not identify, which is the exact opposite of what a presence gate is for.
//
// So three answers, not two:
//   'present'    the target resolved to a character who is in the scene (or is the
//                protagonist, who always is). Ask the model.
//   'absent'     the target resolved to a real character who is NOT in the scene. Do not
//                ask. This is the case Position's own gate exists for: classifying what
//                just happened to a tension with someone who is nowhere near it invites an
//                answer invented out of nothing, and an invented classification moves a
//                real tier.
//   'unknown'    the target did not resolve at all. Ask anyway. We cannot say where a
//                person with no record is, and pretending the answer is "absent" would
//                silently freeze every legacy hook and every hook naming an off-record
//                person. FAILS TOWARD ASKING, matching the file's standing rule that a
//                degraded read must not invent a refusal.
//
// A read failure returns 'unknown' for the same reason.
async function _ceHookTargetPresence(hook: any): Promise<string> {
    const tid = String((hook && hook.targetId) || '');
    if (!tid) return 'unknown';
    if (ceIsProtagonistRef(tid)) return 'present';
    try {
        const idx = await loadIndex();
        const hit = idx.find(function(m: any) { return m && m.id === tid; });
        if (!hit) return 'unknown';   // a record that has since been deleted
        return (hit.active && (hit as any).scenePresent) ? 'present' : 'absent';
    } catch (ePres) {
        api.v1.error('[AE:engine] hook presence read:', ePres);
        return 'unknown';
    }
}

async function generateHookUpdates(
    char: CharacterRecord,
    cfg: GlobalConfig,
    genCount: number // [E1] was tokenCount
): Promise<boolean> {
    // [STORY-BLOCK] The pass-wide block, read from memory and hoisted to the front
    // of the user turn so it is a shared cacheable prefix with the ephemeral call.
    const recentText = ceStoryBlockText();
    if (!recentText) return false;
    const charState = await buildHookStateContext(char, cfg);

    // SCENARIO 1: Update existing hook (the escalator)
    if (char.hook) {
        const hook = char.hook;

        // [HOOK-TARGETID] BACKFILL for hooks spawned before targets resolved, which
        // stored a name and no id. Written back only on a hit: resolveHookTargetRef
        // returning { id: '' } is a working state (an off-record person), not a retry.
        if (!String(hook.targetId || '') && String(hook.targetName || '').trim()) {
            try {
                const bfAll = await loadAllCharacters();
                const bfRef = resolveHookTargetRef(String(hook.targetName), bfAll);
                if (bfRef.id) {
                    const bf = await loadCharacter(char.id);
                    if (bf && bf.hook) {
                        bf.hook.targetId = bfRef.id;
                        // '__player__' carries no name of its own -- _ceHookTargetLabel
                        // resolves it against cfg.protagonistName, and a stored copy would
                        // go stale the moment the author renamed the protagonist.
                        bf.hook.targetName = ceIsProtagonistRef(bfRef.id) ? '' : bfRef.name;
                        await saveCharacter(bf);
                        hook.targetId = bf.hook.targetId;
                        hook.targetName = bf.hook.targetName;
                    }
                }
            } catch (eBf) { api.v1.error('[AE:engine] hook target backfill:', eBf); }
        }

        // [HOOK-GATE] The dispatcher already refused an absent target before
        // spending a slot; this covers the one turn on which the backfill above first
        // resolves an id, which the dispatcher had seen as 'unknown'. Not stamped -- the
        // dispatcher owns the interval.
        if (await _ceHookTargetPresence(hook) === 'absent') return false;

        await _ceSeedPressureFromRecord(char.id, 'hook', hook.pressureLevel);
        // [HOOK-LIFE] escalate +1 / simmer 0 / ease -1 / explode. NEITHER ENDING IS
        // A JUDGEMENT ABOUT WHETHER ANYTHING IS "OVER": ease to 0 is arithmetic, and
        // explode asks only whether the conflict is IN the story, not whether the story
        // settled it. 'ease' is 'advanced' on the shared verb, which is why _ceAxisFloor
        // floors this axis at 0 -- below 0 there is no hook to measure.
        // EVIDENCE IS ASKED FOR BEFORE THE VERDICT because JSON keys generate in the order
        // requested, so the reverse had the evidence written to justify a verdict already
        // chosen. 'simmers' is named as the usual answer because the tier is arithmetic and
        // does not forgive a wrong one. Side is stated, or a setback for the other party
        // moves this character's tier.
        // ESCALATION REWRITES THE DESCRIPTION, against the genesis-text rule. Narrowed:
        // only on a real tier move, same two people and same matter, spawn wording kept in
        // genesisDescription so the drift is measurable.
        const _hkTier = await _ceReadPressure(char.id, 'hook');
        const _hkNext = Math.min(4, _hkTier + 1);
        const _hkVoice = ['', 'it is simmering', 'it is pressing on them',
                          'it is urgent', 'it is at breaking point'][_hkNext];
        const sys = [
            // [HOOK-TARGETID] WAS ${hook.targetName}, which rendered the literal
            // token '__player__' into the prompt whenever the target was the protagonist.
            `${char.name} carries an unresolved tension toward ${_ceHookTargetLabel(hook, cfg)}.`,
            `The tension, as it stands: "${hook.description}"`,
            ``,
            `Decide what the recent story did to it. Judge from ${char.name}'s side only — a setback for the other person is not automatically a setback for ${char.name}.`,
            ``,
            `Return ONLY valid JSON with these exact keys, in this order:`,
            `  "evidence": ONE short phrase (under 12 words) naming the specific thing in the recent story that bears on this tension — an action, a line, a refusal. Evidence, not a verdict. Write this FIRST and decide from it. Leave empty if nothing in the story bears on it.`,
            `  "outcome": Exactly one of:`,
            `      "simmers"   — the recent story did not meaningfully move THIS tension. This is usually the correct answer: most of what happens in a story is about something else. Choose it whenever your own evidence is thin, general, or about a different matter.`,
            `      "escalates" — something forced this tension closer to confrontation, raised the cost of leaving it alone, or closed off an easy way out.`,
            `      "eases"     — pressure came off it. Ground was given, part of it was settled, or the reason it mattered got smaller.`,
            `      "explodes"  — it CAME OUT. The tension is in the story now: said aloud, acted on, or forced into the open between them. Judge only whether it surfaced, NOT whether it was settled — a confrontation that solves nothing still counts.`,
            _hkTier >= 4 ? `      This tension is at breaking point and the story has been told to bring it out. Look hard for "explodes" before anything else — if it has been spoken, acted on, or forced into the open at all, that is the answer.` : '',
            `  "description": ONLY when outcome is "escalates". Rewrite the tension above so the wording carries more imperative, as ${_hkVoice}. Same two people and the SAME underlying matter — do not swap the subject, do not add a new grievance, do not summarise the scene. One punchy sentence, and it must still read as a standing charge ${char.name} carries. Leave empty for every other outcome.`,
            ``,
            `No markdown fences. No extra keys. Return nothing but the JSON object.`
        ].filter(Boolean).join('\n');

        const usr = [
            `Story so far:\n${recentText}`,
            charState ? `${char.name}'s current state:\n${charState}` : '',
            '\n```json\n'
        ].filter(Boolean).join('\n\n');

        try {
            const resp   = await aeDiagGenerate('hookUpdate:' + char.name + ':escalate', [{ role: 'system', content: sys }, { role: 'user', content: usr }],
                { model: 'glm-4-6', max_tokens: AE_BUDGET_HOOK, temperature: 0.6 }
            );
            const update = extractJSON(resp.choices[0]?.text || '');
            if (!update) return false;
            // Anything unrecognised coerces to 'simmers', the no-op. A malformed reply
            // must never move a tier and must never end a hook: the failure directions are
            // not symmetric, and only one of them destroys an author's record.
            const _hkOut = ['escalates', 'simmers', 'eases', 'explodes'].indexOf(String(update.outcome || '')) !== -1
                ? String(update.outcome) : 'simmers';

            const f = await loadCharacter(char.id);
            if (!f || !f.hook) return false;

            const targetHook = f.hook;

            // [PRESSURE] Word-overlap "surface detection" -- matching hook words
            // against story prose to auto-clear a hook -- was removed and is not what
            // 'explodes' reinstates. That one was a string compare with no evidence and no
            // author involvement; this is a classified outcome on a named quote, journalled
            // and toasted.
            const { prevTier, tier } = await _ceApplyPressure(char.id, 'hook',
                (_hkOut === 'escalates') ? 'blocked'
                : (_hkOut === 'eases')   ? 'advanced'
                : 'untouched');
            targetHook.pressureLevel = tier;   // the tier itself, not a percentage

            // [HOOK-LIFE] THE TWO ENDINGS, AND THE ORDER MATTERS. `explodes` is
            // checked against the outcome; fading is checked against the ARITHMETIC, so a
            // hook sitting at 0 clears on its next scan rather than parking forever at a
            // tier the ladder has no rung for. resolveCharHook is the author's own verb and
            // is called rather than a second removal path being minted. Journalled and
            // toasted, so nothing leaves silently.
            if (_hkOut === 'explodes' || tier <= 0) {
                const _hkGone = String(targetHook.description || '').substring(0, 200);
                const _hkWho  = _ceHookTargetLabel(targetHook, cfg);
                const _hkWhy  = (_hkOut === 'explodes') ? 'Surfaced' : 'Faded';
                f.lastHookGen = genCount; // [E1]
                f.lastHookTokens = await _aeCurrentTokenCount();
                await saveCharacter(f);
                try {
                    await charJournalAddBubble(char.id,
                        _hkWhy + ' — tension with ' + _hkWho + ': ' + _hkGone
                        + (update.evidence && String(update.evidence).trim()
                            ? (' (' + String(update.evidence).trim().substring(0, 120) + ')') : ''));
                } catch (eJ) { api.v1.error('[AE:engine] hook close journal:', eJ); }
                await resolveCharHook(char.id);
                return true;
            }

            // The rewrite lands only when the tier actually moved. Guarding on the
            // arithmetic rather than the outcome word keeps a hook parked at 4 from having
            // its wording churned on every further escalation with no rung left to climb.
            if (_hkOut === 'escalates' && tier !== prevTier && String(update.description || '').trim()) {
                if (!targetHook.genesisDescription) targetHook.genesisDescription = String(targetHook.description || '').substring(0, 300);
                targetHook.description = String(update.description).trim().substring(0, 300);
            }

            // Evidence is banked only when the tier moved. A 'simmers' turn's evidence is
            // by definition about something else, and banking three of those would push the
            // real evidence out of a three-slot array.
            if (tier !== prevTier && update.evidence && String(update.evidence).trim()) {
                if (!Array.isArray(targetHook.developmentNotes)) targetHook.developmentNotes = [];
                targetHook.developmentNotes = [String(update.evidence).trim().substring(0, 120), ...targetHook.developmentNotes].slice(0, 3);
            }
            if (tier >= 4 && prevTier < 4) {
                // [HOOK-LIFE] Reaching the cap is no longer a dead end waiting on the
                // author. The injected line now asks the story to bring it out and the next
                // scan looks for exactly that, so the toast says what will happen rather
                // than only that something is stuck.
                api.v1.ui.toast('🔥 ' + char.name + '’s tension with ' + _ceHookTargetLabel(targetHook, cfg) + ' is at breaking point — it will surface, or resolve it in the Drama tab.', { type: 'warning', autoClose: 5000 });
            }
            f.lastHookGen = genCount; // [E1]
                        f.lastHookTokens = await _aeCurrentTokenCount(); // token-mode stamp companion
            await saveCharacter(f);
            return true;
        } catch (e) {
            aeLog('[AE:engine] generateHookUpdates escalator error:', e);
            return false;
        }

    // SCENARIO 2: Spawn a new hook
    } else {
        // [HOOK-TARGETID] THE CAST LIST IS IN SCOPE NOW. The old note here said this
        // path "has no cast list in scope, so it resolves to no id... the documented
        // working state, not a gap to paper over with a guess" -- and the second half of
        // that is still right: nothing below guesses. What changed is that the list is one
        // await away and was never fetched, so the model was picking names out of prose
        // with no idea which people the story actually has records for. Naming the roster
        // in the prompt is what makes the reply resolvable, and resolveHookTargetRef --
        // the wizard path's resolver, not a second one -- is what resolves it.
        //
        // PRESENT PEOPLE ARE MARKED, NOT FILTERED. A tension can point at someone who has
        // left the room; the recent story is the evidence and it may be about an absence.
        // Marking lets the model prefer the people in front of it without the prompt
        // forbidding the other case.
        let _hkAll: CharacterRecord[] = [];
        let _hkRoster = '';
        try {
            _hkAll = await loadAllCharacters();
            const _hkIdx = await loadIndex();
            const _hkPresent: any = {};
            for (const _hkM of (_hkIdx || [])) {
                if (_hkM && _hkM.active && (_hkM as any).scenePresent) _hkPresent[_hkM.id] = true;
            }
            const _hkNames: string[] = [];
            const _hkProt = _hkAll.find(function(c) { return c.isProtagonist; });
            if (_hkProt) _hkNames.push(String(_hkProt.name || 'the player') + ' (the protagonist, always here)');
            for (const _hkC of _hkAll) {
                if (!_hkC || _hkC.isProtagonist || _hkC.id === char.id) continue;
                _hkNames.push(String(_hkC.name || 'Unnamed') + (_hkPresent[_hkC.id] ? ' (here now)' : ''));
            }
            if (_hkNames.length) _hkRoster = _hkNames.join(', ');
        } catch (eRoster) {
            // A roster read failure must not cost the spawn. Without it the prompt is
            // exactly what it was before this version and the reply simply resolves to no
            // id, which resolveHookTargetRef already treats as a working state.
            api.v1.error('[AE:engine] hook roster read:', eRoster);
        }

        // [HOOK-PROMPT] BUILT ON generateEphemeral's SHAPE. A SCAFFOLD FIELD IS
        // ASKED FOR FIRST, so the verdict is read off a named concrete event rather than
        // assembled from the prompt's own vocabulary. THE ESCAPE HATCH IS AN ENUM VALUE and
        // is named as the preferred answer -- "None" in a field whose job is a name read as
        // the call failing, the same way 'untouched' works and a sentinel does not.
        // THE DEFINITION EXCLUDES COOPERATION: the old "a threat that demands response, or
        // an urgent unfulfilled need" swallowed being tested, hunted or invited, which is
        // most of an adventure. Observed once: an ACCEPTED offer of partnership came back
        // as a tension, and it passed both old examples because they contrasted vague
        // against concrete and never tested that axis. It is the first Wrong example now.
        // DIRECTION IS STATED, or the answer arrives as third-person scene recap.
        const sys = [
            `Read the recent story and decide whether ${char.name} now carries a specific, unresolved tension toward ONE other person.`,
            ``,
            `A tension means their wants are OPPOSED to that person's, or that something is owed, withheld, or at risk BETWEEN them.`,
            `Working toward the same thing together is NOT a tension, however dangerous the thing is. Being tested, hunted, invited or led somewhere is NOT a tension unless ${char.name} wants something the other person is refusing them. Passive feelings and general mood are NOT tensions.`,
            `Judge from ${char.name}'s side only. Do not report what some other character is feeling or planning.`,
            ``,
            `Return ONLY valid JSON with these exact keys:`,
            `  "whatHappened": The one concrete thing in the recent story your judgement rests on — a specific action, line, refusal or silence, never a mood or a summary of the scene. One sentence. Write this FIRST and judge from it. This is scaffolding, not prose for a reader.`,
            `  "finding": Exactly one of:`,
            `      "conflict" — ${char.name} wants something that another named person is opposed to, and it is unsettled.`,
            `      "owed"     — something is owed, withheld, or at risk between ${char.name} and another named person.`,
            `      "none"     — nothing qualifies. This is usually the correct answer, and always the correct answer when the recent story is cooperative, exploratory, or has simply not created a tension yet. Prefer it over a weak finding.`,
            `  "targetName": The other person's name. Set to "None" when finding is "none".`,
            _hkRoster ? `      Use a name from this list exactly as written, without the bracketed note: ${_hkRoster}. Only name someone outside the list if the story clearly involves a person who is not on it.` : '',
            `  "description": One punchy sentence naming what stands between them, written as a standing charge ${char.name} carries — not a recap of what just happened. Concrete: what happened, what is owed, what is at stake. Leave empty when finding is "none".`,
            `      Wrong (a recap of a scene, with nobody opposed): "Kaelia has offered Ramis a partnership on a dangerous hunt, and he just accepted, now she must see if he can handle her steed."`,
            `      Wrong (vague, no concrete event): "feels betrayed by the situation"`,
            `      Right: "Cassius read the letter — he knows, and hasn't said anything yet"`,
            ``,
            `No markdown fences. No extra keys. Return nothing but the JSON object.`
        ].filter(Boolean).join('\n');

        const usr = [
            `Story so far:\n${recentText}`,
            charState ? `${char.name}'s current state:\n${charState}` : '',
            '\n```json\n'
        ].filter(Boolean).join('\n\n');

        try {
            const resp  = await aeDiagGenerate('hookUpdate:' + char.name + ':spawn', [{ role: 'system', content: sys }, { role: 'user', content: usr }],
                { model: 'glm-4-6', max_tokens: AE_BUDGET_HOOK, temperature: 0.65 }
            );
            const spawn = extractJSON(resp.choices[0]?.text || '');
            if (!spawn) return false;
            // [HOOK-PROMPT] THREE WAYS TO SAY NOTHING, ALL HONOURED, per user: a
            // hook that says "none" is not a hook, so it is dropped whatever else came
            // back with it. The finding is the primary gate; the targetName sentinel is
            // kept because a model that ignores the enum may still fill the name field
            // with the word it was given, and a description-only reply with no target is
            // not a hook either. A model that answers 'none' and then writes a paragraph
            // of description anyway costs nothing here -- it is discarded unread.
            const _hkFinding = String(spawn.finding || '').trim().toLowerCase();
            if (_hkFinding === 'none') return false;
            if (!spawn.targetName || String(spawn.targetName).trim().toLowerCase() === 'none') return false;
            if (!String(spawn.description || '').trim()) return false;

            // [HOOK-TARGETID] Resolved through the wizard path's own resolver, which
            // already knows the protagonist's aliases, matches nicknames, and returns
            // { id: '', name: <what the model said> } for a name the cast does not contain.
            // THAT MISS IS KEPT, NOT DISCARDED: a hook toward an off-record person is a real
            // hook, it simply earns no id -- and _ceHookTargetPresence answers 'unknown' for
            // it, so the gate lets it through rather than freezing it forever.
            const _hkRef = resolveHookTargetRef(String(spawn.targetName), _hkAll);
            if (_hkRef.id === '' && _hkRef.name === '') return false;   // 'none' / 'n/a' spellings

            const f = await loadCharacter(char.id);
            if (!f) return false;
            // [HOOK-ONE] RE-CHECKED ON THE FRESH RECORD, not just on `char`. The
            // model call above takes seconds and the Profile surface can write a hook
            // during them; this is a single field, so proceeding would overwrite whatever
            // the author just typed with something they never asked for.
            if (f.hook) return false;

            // [HOOK-LIFE] TIER 1, AND 0 IS RESERVED. 0 is not "a new hook", it is
            // "no hook": the escalator resolves anything that reaches it, which is what
            // makes fading out mechanical instead of a judgement call. A hook enters the
            // ladder at 1 and can leave it in one ease. Both halves of the mirror are
            // written here, per [HOOK-MIRROR].
            await api.v1.historyStorage.set(_cePressureKey(char.id, 'hook'), 1);
            f.hook = {
                id:           api.v1.uuid(),
                targetId:     _hkRef.id,
                // '__player__' carries no name of its own — _ceHookTargetLabel resolves it
                // against cfg.protagonistName, and a stored copy would go stale the moment
                // the author renamed the protagonist. Every other case stores the CAST'S
                // spelling when it resolved, not the model's, so a nickname in the story
                // does not become the hook's display name.
                targetName:   ceIsProtagonistRef(_hkRef.id) ? '' : String(_hkRef.name || '').substring(0, 50),
                description:  String(spawn.description || '').substring(0, 300),
                pressureLevel: 1,
                // [HOOK-PROMPT] THE SCAFFOLD IS KEPT, as the hook's first
                // development note, per user. It costs nothing to store (it was generated
                // either way) and it gives the hook a concrete ORIGIN the escalator's own
                // evidence notes can later contradict -- which is the one thing a
                // description alone cannot provide, since description is genesis text and
                // is never rewritten. Same 120-char cap and same array the escalator
                // writes into, so nothing downstream distinguishes them; if it should be
                // dropped later, delete this line and nothing else changes.
                developmentNotes: String(spawn.whatHappened || '').trim()
                    ? [String(spawn.whatHappened).trim().substring(0, 120)] : []
            };
            f.lastHookGen = genCount; // [E1]
                        f.lastHookTokens = await _aeCurrentTokenCount(); // token-mode stamp companion
            await saveCharacter(f);
            return true;
        } catch (e) {
            aeLog('[AE:engine] generateHookUpdates spawn error:', e);
            return false;
        }
    }
}

// ── Engine Orchestrator ───────────────────────────────────────────────────────

// ── AUTO-TRIGGERS ───────────────────────────────────────────────────────────
// Scans scene-present entities for ActionInstances flagged autoTrigger, evaluates
// their conditions, and fires the ones that pass. Runs post-generation (onGenerationEnd)
// so it never recurses into the active generation. Auto-triggered actions always run
// silently (no nested api.v1.editor.generate) to avoid generation-in-generation.

// [CE-STRIP earlier] Auto-trigger scanning always found zero candidates once
// getTagSubscribedActions became a stub (above) — the scan body is gone, callers
// (Schedule tick, travel/teleport, native toolbar) keep calling this harmlessly.
async function runAutoTriggers(): Promise<void> {
    return;
}

// Current persistent story token count, NaN-safe with a 0 fallback. Read by the
// generators at persist time to stamp the *Tokens companion fields, and by runDynamicEngine
// in token mode as the progress value.
async function _aeCurrentTokenCount(): Promise<number> {
    try { return Number(await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0)) || 0; }
    catch (eTc) { return 0; }
}

// [TURN-CAP] Single enqueue path. The two inline copies this replaces differed
// only in variable names, and the two new cap-exhausted call sites would have made four.
// Types: 'eph' | 'mid' | 'rel' | 'hook'. Deduped, so a character due on the same
// generator two turns running queues once.
async function _ceEnqueueRetry(charId: string, kind: string): Promise<void> {
    try {
        const rqRaw = await api.v1.tempStorage.getOrDefault(STORAGE_RETRY_CHARS, '[]') as string;
        const rq: string[] = JSON.parse(rqRaw);
        const entry = charId + ':' + kind;
        if (rq.indexOf(entry) === -1) {
            rq.push(entry);
            await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, JSON.stringify(rq));
        }
    } catch (eEq) { aeLog('[AE:engine] _ceEnqueueRetry error:', eEq); }
}

async function runDynamicEngine(): Promise<void> {
    // [E1] Generation-based intervals; optional token-based cadence.
    // genCount always advances per generation (the load guard below rides it regardless of
    // mode); tokenCount is only consulted when dynamicIntervalMode === 'tokens'.
    let genCount = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
    genCount = Number(genCount) || 0;
    if (genCount < 1) {
        aeLog('[AE:engine] genCount=0, skipping dynamic engine');
        return;
    }

    ae_lock = true; // [LOCK1] block travel generates while background gen runs
    aeLog('[AE:TRACE] dynamic engine ACQUIRED ae_lock');
    const index = await loadIndex();
    const cfg   = await loadConfig();
    // Cadence unit + the progress value each per-character check compares against.
    const _dynMode: string = ((cfg as any).dynamicIntervalMode === 'tokens') ? 'tokens' : 'gens';
    const _dynTokenCount = (_dynMode === 'tokens') ? await _aeCurrentTokenCount() : 0;
    const _dynProgress = (_dynMode === 'tokens') ? _dynTokenCount : genCount;
    // [STORY-BLOCK] THE SINGLE READ OF THE PASS. Built here, before the per-character
    // loop, so every generator below shares one byte-identical story prefix and pays for it
    // once. Awaited rather than fired alongside the loads above: it calls read() on the
    // rollover helper, which mutates the window, and two overlapping calls would interleave.
    await ceStoryBlockGet();

    const raw   = await api.v1.tempStorage.get(STORAGE_LORE_IDS) as string | undefined;
    const activeEntryIds = new Set<string>(raw ? JSON.parse(raw) : []);

    // [TURN-CAP] Hard cap on generations dispatched in ONE pass. NAI permits a
    // single generation at a time and rejects the rest outright -- generateSlotOptions
    // already carries a three-attempt backoff for exactly that rejection -- so multiple
    // generators firing in one turn were already colliding and losing SILENTLY. Default 1.
    const _dynCapTurn = Math.max(0, Number((cfg as any).maxGenerationsPerTurn ?? 1) || 0);
    let   _dynSpent   = 0;
    // Characters that already generated this pass, from EITHER the queue drain or the
    // main loop. This is the fix for the drain defect: the queue is drained FIRST (that
    // is what "starved characters get priority next turn" means) but a drained character
    // was then still eligible in the main dispatch below, so it could generate twice in
    // one pass -- an unbudgeted extra call, which is precisely what a turn cap exists to
    // prevent. Draining first and excluding here preserves the priority AND closes the
    // double-dispatch, which moving the drain after the loop would not have done.
    const _dynDone = new Set<string>();
    const _ceTurnLeft = function(): boolean { return _dynCapTurn === 0 || _dynSpent < _dynCapTurn; };

    // ── Retry queue ───────────────────────────────────────────────────────────
    const _retryRaw = await api.v1.tempStorage.getOrDefault(STORAGE_RETRY_CHARS, '[]') as string;
    const _retryQ: string[] = JSON.parse(_retryRaw);
    if (_retryQ.length > 0) {
        await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, '[]');
        const _reQueue: string[] = [];
        for (const entry of _retryQ) {
            // [TURN-CAP] Anything the cap will not let run this pass goes straight
            // back on the queue rather than being dropped -- it stays due, and it is still
            // ahead of the main loop next turn.
            if (!_ceTurnLeft()) { _reQueue.push(entry); continue; }
            // [BUDGET-GATE] Was a flat 220 for a queue holding BOTH eph and mid
            // entries, so the gate took the larger of the two budgets. [earlier
            // MIDRANGE-RETIRE] 'mid' is gone; the gate is now just the ephemeral budget.
            // [POSITION] 'rel' is gone too, and AE_BUDGET_EPH rose 240 -> 260, so
            // this gate is now the LARGEST of the two surviving budgets rather than the
            // smallest. Still correct, just for the opposite reason: a pass that clears
            // 260 trivially clears hook's 200, so no queued entry can be admitted and
            // then truncated.
            if (api.v1.script.getAllowedOutput() < AE_BUDGET_EPH) { _reQueue.push(entry); break; }
            const [_rcId, _rcType] = entry.split(':');
            const _rc = await loadCharacter(_rcId);
            if (!_rc || _rc.isProtagonist) continue;
            let _rcRan = false;
            if (_rcType === 'eph' && _rc.autoThoughtsEnabled) {
                _dynSpent++; _rcRan = true;
                const _ok = await generateEphemeral(_rc, cfg, genCount).catch(function() { return false; });
                if (_ok) api.v1.ui.toast('💭 ' + _rc.name + ': thoughts updated', { type: 'info', autoClose: 2000 });
            } else if (_rcType === 'hook' && _rc.hooksEnabled) {
                _dynSpent++; _rcRan = true;
                const _ok4 = await generateHookUpdates(_rc, cfg, genCount).catch(function() { return false; });
                if (_ok4) api.v1.ui.toast('🎯 ' + _rc.name + ': hook updated', { type: 'info', autoClose: 2000 });
            }
            // [MIDRANGE-RETIRE] A 'mid' entry left in tempStorage by a earlier
            // session matches no branch above: _rcRan stays false, nothing is dispatched,
            // and the entry is simply consumed rather than requeued (requeue only happens
            // on the cap/budget paths). Unknown types are tolerated by construction here --
            // do NOT add an else-throw. [POSITION] 'rel' entries left by a
            // earlier session are now in exactly the same position and need exactly
            // the same nothing done about them.
            if (_rcRan) _dynDone.add(_rcId);
        }
        if (_reQueue.length > 0) await api.v1.tempStorage.set(STORAGE_RETRY_CHARS, JSON.stringify(_reQueue));
        aeLog('[AE:engine] Retry queue processed. spent=' + _dynSpent + ' requeued=' + _reQueue.length);
    }

    aeLog('[AE:engine] genCount=' + genCount + ', active chars=' + index.filter(function(m: any) { return m.active; }).length);

    // [vNEXT] Dynamic-priority cap. Compute the permitted id set ONCE from the index
    // (no storage reads). When a cap is set, characters outside the top-N by rank are
    // skipped this turn without touching their records — the user's manual Static
    // toggle is untouched; they simply aren't processed while over the cap.
    const _dynCap = Number((cfg as any).maxDynamicCharacters) || 0;
    const _dynAllowed = computeDynamicAllowedSet(index as any, _dynCap);
    if (_dynCap > 0) aeLog('[AE:engine] dynamic cap=' + _dynCap + ', allowed=' + _dynAllowed.size);

    // ── Per-character dispatch ────────────────────────────────────────────────
    for (const meta of index.filter(Boolean)) {
        if (!meta.active) continue;
        if (meta.isProtagonist) continue;
        // [PERF1] Skip storage read for chars flagged static in the index
        // (propagated there by saveCharacter since earlier). Avoids a DB load per
        // static character per generation end.
        if ((meta as any).isStatic) { aeLog('[AE:engine] Static (index), skipping: ' + meta.name); continue; }
        // [vNEXT] Enforce the dynamic cap from the index before any storage read, so
        // a capped-out character costs nothing this turn.
        if (_dynCap > 0 && !_dynAllowed.has(meta.id)) { aeLog('[AE:engine] Over dynamic cap, skipping: ' + meta.name); continue; }
        // [TURN-CAP] Already generated in the queue drain above -- skipping here
        // is what stops a dequeued character updating twice in one pass.
        if (_dynDone.has(meta.id)) { aeLog('[AE:engine] Already ran (queue), skipping: ' + meta.name); continue; }
        const char = await loadCharacter(meta.id);
        if (!char) continue;
        if ((char as any).isStatic) { aeLog('[AE:engine] Static, skipping: ' + char.name); continue; }

        const relevant = charIsRelevant(char, activeEntryIds);

        // NaN-safe — old saves without stamps default to 0 (triggers update immediately).
        // In token mode the *Tokens stamps/intervals are read instead of the *Gen
        // ones; _dynProgress (set above) is the matching progress value. Both stamp units
        // are written on every update (see the generators), so a mode switch never compares
        // a stamp against the wrong unit.
        const _tokMode = (_dynMode === 'tokens');
        const lastEph  = Number(_tokMode ? char.lastEphemeralTokens : char.lastEphemeralGen) || 0;
        const lastHook = Number(_tokMode ? char.lastHookTokens      : char.lastHookGen)      || 0;
        const intEph   = Number(_tokMode ? (cfg as any).thoughtIntervalTokens : cfg.thoughtIntervalGens) || (_tokMode ? 500  : 2);
        const intHook  = Number(_tokMode ? (cfg as any).hookIntervalTokens    : cfg.hookIntervalGens)    || (_tokMode ? 1500 : 6);
        const _unit    = _tokMode ? 'tok' : 'gen';

        aeLog('[AE:engine] ' + char.name
            + ' rel=' + relevant
            + ' eph=' + char.autoThoughtsEnabled + '(' + (_dynProgress - lastEph) + '/' + intEph + _unit + ')'
            + ' budget=' + api.v1.script.getAllowedOutput());


        // [CHAREDIT-TABS] Toggle semantics split, backing the Dynamic Profile
        // tab's "Enabled" bar. Previously Midrange/Relationship/Hooks all shared ONE
        // autoUpdateEnabled flag (Ephemeral was already independent); hooksEnabled
        // (declared on every CharacterRecord since day one, serialized to the bridge, but
        // never actually read by any dispatch condition here) now genuinely gates Hooks.
        // [MIDRANGE-RETIRE] autoUpdateEnabled was Midrange's sole gate and retired
        // with it. [POSITION] The Relationship gate went the same way: Position has
        // no generator and therefore no dispatch condition and no toggle. Two buttons.
        if (char.autoThoughtsEnabled && relevant && (_dynProgress - lastEph) >= intEph) {
            // [TURN-CAP] Cap first, budget second. A character due but capped out
            // is QUEUED, not dropped -- next pass it is ahead of this loop.
            if (!_ceTurnLeft()) {
                await _ceEnqueueRetry(char.id, 'eph');
            } else if (api.v1.script.getAllowedOutput() >= AE_BUDGET_EPH) {
                _dynSpent++; _dynDone.add(char.id);
                const ephOk = await generateEphemeral(char, cfg, genCount).catch(function(e) { aeLog('[AE:engine] Eph err:', e); return false; });
                if (ephOk) api.v1.ui.toast('💭 ' + char.name + ': thoughts updated', { type: 'info', autoClose: 2000 });
            } else {
                await _ceEnqueueRetry(char.id, 'eph');
            }
        }
        // [HOOK-GATE] THE GATE IS IN THE DISPATCH CONDITION, NOT ONLY INSIDE THE
        // GENERATOR, and the placement is load-bearing rather than tidy. _dynSpent++ and
        // _dynDone.add fire BEFORE the call below, so a generator that opens, decides the
        // target is not in the scene and returns false has already spent a turn-cap slot --
        // and with maxGenerationsPerTurn defaulting to 1, one character with an absent
        // target would starve every other character's thoughts, every turn, forever.
        // Deciding here costs one index read and spends nothing.
        //
        // 'absent' ONLY. 'unknown' -- an unresolved target, which is every hook stored
        // before HOOK-TARGETID and every hook naming an off-record person -- passes, and
        // must: the generator is where the backfill runs, so blocking it here would be the
        // one thing guaranteed to keep the id unresolved forever.
        let _hkGateOk = true;
        if (char.hooksEnabled && char.hook) {
            _hkGateOk = (await _ceHookTargetPresence(char.hook) !== 'absent');
        }
        if (char.hooksEnabled && _hkGateOk && relevant && (_dynProgress - lastHook) >= intHook) {
            if (!_ceTurnLeft()) {
                await _ceEnqueueRetry(char.id, 'hook');
            } else if (api.v1.script.getAllowedOutput() >= AE_BUDGET_HOOK) {
                _dynSpent++; _dynDone.add(char.id);
                const hookOk = await generateHookUpdates(char, cfg, genCount).catch(function(e) { aeLog('[AE:engine] Hook err:', e); return false; });
                if (hookOk) api.v1.ui.toast('🎯 ' + char.name + ': hook updated', { type: 'info', autoClose: 2000 });
            } else {
                await _ceEnqueueRetry(char.id, 'hook');
            }
        }
    }

    await recalculateScenePresence();
    aeLog('[AE:TRACE] dynamic engine RELEASING ae_lock');
    ae_lock = false; // [LOCK1] release after all background generates complete
}

// ============================================================================
// SECTION 16 — IMAGE PROMPT GENERATION
// Assembles image prompts for auto-snap and Director's Cut, and dispatches
// generation requests to the bridge via EVT_GENERATE_IMAGE.
//
// NOTE FOR ASSEMBLY: Add to Section 2 Bridge Event constants:
//   const EVT_DIRECTOR_ENHANCE_RESULT = 'DIRECTOR_ENHANCE_RESULT'; // engine→bridge
// ============================================================================

// [IMG-SEED] THE SEED IS MINTED HERE, ALWAYS, AND NEVER LEFT TO THE BRIDGE.
// buildRequestBody randomises a missing/zero seed locally and does not write the result
// back, so dbSave stored the settings as SENT — seed 0 or absent. Every image the engine
// dispatched without a seed therefore rendered with a number nobody could ever recover,
// which is why "what seed was this?" had no answer. Minting engine-side makes the seed a
// fact of the request rather than of the render, so the record carries it and the bridge's
// fallback branch simply never fires. `pref` is a stored preference (0 = none).
function _ceImgSeed(pref?: number): number {
    var pv = Number(pref) || 0;
    if (pv > 0) return pv;
    return Math.floor(Math.random() * 4294967295);
}

// ── Character Data Lookup ─────────────────────────────────────────────────────

// [earlier] Whole-word presence test. Substring matching caused short names
// (e.g. "Nev") to fire inside longer words ("never"). Boundary = anything that
// is not an ASCII letter/digit/underscore, or string start/end. Multi-word names
// match on their outer boundaries; internal spaces are unaffected.
function _nameAppearsAsWord(hayLower: string, needleLower: string): boolean {
    if (!needleLower) return false;
    let esc = needleLower.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    let re = new RegExp('(?:^|[^a-z0-9_])' + esc + '(?:[^a-z0-9_]|$)');
    return re.test(hayLower);
}

// [IMG-AUDIT] baseSceneVisuals/baseSceneUC dropped. Both were hardcoded to ''
// here and threaded through extractBaseAdditions, whose own comment admitted it could only
// ever return two empty strings. The payload field extraBaseVisuals survives — the entity
// image path sends a real value through it.
function getCharacterData(promptText: string): { id: string; name: string; visuals: string; uc: string; }[] {
    // Returns an array of matched character visual records for characters mentioned in promptText.
    if (!promptText || !cachedCharVisuals.length) return [];
    const lower = promptText.toLowerCase();
    return cachedCharVisuals
        .filter(function(c) {
            if (!c.name || !c.name.trim()) return false;
            if (_nameAppearsAsWord(lower, c.name.trim().toLowerCase())) return true;
            return (c.nicknames || []).some(function(nick) {
                return nick && nick.trim() && _nameAppearsAsWord(lower, nick.trim().toLowerCase());
            });
        })
        .map(function(c) {
            return {
                id:               c.id || '',
                name:             c.name,
                // Combine core visuals + scene-specific additions for character captions
                visuals:          [c.visuals, c.sceneVisuals].filter(Boolean).join(', '),
                uc:               c.uc || ''
            };
        });
}

// ── Auto-Snap ─────────────────────────────────────────────────────────────────

async function getCurrentLocationPromptLine(): Promise<string> {
    // [WP-img] Returns "Location: <name> — <resolved description>" for the
    // protagonist's current location, or '' if none. Feeds the image architect so
    // generated scenes reflect where the player is. Uses the (state-resolved)
    // description, NOT locationVisuals — locationVisuals is reserved for renders
    // that are specifically about a location.
    try {
        let locId = await loadProtagonistLocation();
        if (!locId) return '';
        let loc = await loadEntity(locId);
        if (!loc) return '';
        // [ENT-AUDIT] The state-dependent branch is gone with the fields. It could
        // never be taken: state was defaulted to 'default' and nothing could change it.
        let desc = (loc.description || '').trim();
        if (!loc.name && !desc) return '';
        return 'Location: ' + (loc.name || '') + (desc ? ' — ' + desc : '');
    } catch (e) { api.v1.error('[AE:img] getCurrentLocationPromptLine:', e); return ''; }
}

// [earlier] Reusable architect pass over the recent story. Reads the last
// `paragraphs` sections, detects characters (whole-word), runs the GLM architect,
// and returns the raw prompt plus the resolved character records. Shared by
// executeAutoSnap (generate now) and the AUTO_SNAP_PROMPT path (fill the Image
// Studio composer for the user to review/edit before generating).
async function buildArchitectPromptFromStory(paragraphs?: number): Promise<{ prompt: string; matchedChars: { id: string; name: string; visuals: string; uc: string; }[]; } | null> {
    await loadImageSettings();
    const nodeId = await api.v1.document.history.currentNodeId();
    const node   = await api.v1.document.history.nodeState(nodeId);
    if (!node || !node.sections) { api.v1.ui.toast('Error: Could not read document.'); return null; }

    const ctxSize = (typeof paragraphs === 'number' && paragraphs > 0) ? paragraphs : (globalSettings.contextSize || DEFAULT_CTX);
    let asContextText = '';
    const asStartIndex = Math.max(0, node.sections.length - ctxSize);
    for (let i = asStartIndex; i < node.sections.length; i++) {
        if (node.sections[i].section && node.sections[i].section.text) asContextText += node.sections[i].section.text + '\n';
    }

    const asMatched   = getCharacterData(asContextText);
    const asNames     = asMatched.map(function(c) { return c.name; }).join(', ');
    const asLocLine   = await getCurrentLocationPromptLine();
    const asCharCtx   = asNames ? '\n\nCharacters identified in scene: ' + asNames + '. Apply their specific visual tags.' : '';

    try {
        const asResp = await aeDiagGenerate('imgArchitect:manual',
            [
                { role: 'system', content: globalSettings.architectPrompt || DEFAULT_ARCH },
                { role: 'user',   content: 'Current Scene:\n' + asContextText.trim() + asCharCtx + (asLocLine ? '\n\n' + asLocLine : '') + '\n\nGenerate the image prompt:' }
            ],
            { model: 'glm-4-6', max_tokens: 300 }
        );
        const asPrompt = ((asResp.choices && asResp.choices[0] &&
            (asResp.choices[0].message && asResp.choices[0].message.content || asResp.choices[0].text)) || asResp.text || '').trim();
        if (!asPrompt) return null;
        return { prompt: asPrompt, matchedChars: asMatched };
    } catch (asErr) {
        aeLog('[AE:img] buildArchitectPromptFromStory failed:', asErr);
        return null;
    }
}

async function executeAutoSnap(): Promise<void> {
    api.v1.ui.toast('📸 Architect Pass: Analysing scene…');
    await loadImageSettings();

    if (!isBridgeReady) {
        api.v1.ui.toast('⚠️ Bridge not connected — auto-snap requires bridge.', { type: 'warning', autoClose: 3000 });
        return;
    }

    // [IMG-AUDIT] ONE ARCHITECT PASS. This function carried a verbatim second copy
    // of buildArchitectPromptFromStory -- same document read, same window arithmetic, same
    // character match, same location line, same system prompt, same model call, differing
    // only in the diagnostic tag. Two copies of one prompt is how the composer's preview
    // and the image it actually generates drift apart.
    try {
        const built = await buildArchitectPromptFromStory();
        if (!built) throw new Error('GLM returned an empty prompt.');
        const rawPrompt = built.prompt;
        const matchedChars = built.matchedChars;

        const compiled = compileActiveImageFields();
        await ceBroadcastImageGen({
            uuid:             api.v1.uuid(),
            prompt:           rawPrompt,
            characters:       matchedChars.map(function(c) { return { name: c.name, visuals: c.visuals, uc: c.uc }; }),
            extraBaseVisuals: '',
            extraBaseUC:      '',
            settings: {
                width:    globalSettings.defaultWidth,
                height:   globalSettings.defaultHeight,
                steps:    Math.min(globalSettings.defaultSteps || 28, 28),
                scale:    globalSettings.defaultScale || 5.0,
                model:    ceImgModel(),
                seed:     _ceImgSeed(0),
                quality:  compiled.quality,
                negative: compiled.negative
            },
            autoDownload: globalSettings.autoDownload
        });
        api.v1.ui.toast('📸 Auto-Snap complete! Image generating in bridge…');
    } catch (err) {
        api.v1.ui.toast('Architect Error: ' + ((err as any).message || String(err)));
    }
}

// ── Director's Cut — Enhance & Submit ─────────────────────────────────────────

async function enhanceDirectorPrompt(
    prompt: string,
    chars: { name: string; visuals: string; uc?: string }[]
): Promise<{ enhancedPrompt: string; charVisuals: { name: string; visuals: string }[] } | null> {
    // [IMGFIELDS] Generalized from hardcoded char1/char2 (2-slot) to up to 4
    // characters, matching the new click-to-add picker's cap. No more fuzzy
    // getCharacterData(name) lookup here -- the bridge's picker already resolved
    // c.visuals from its own synced character cache before the user could edit it
    // (and per user's call, those edits are one-off, never written back), so
    // c.visuals IS the "known visuals" context; nothing left to re-look-up by name.
    if (!prompt.trim()) return null;

    const capped = (chars || []).slice(0, 4);
    const locLine = await getCurrentLocationPromptLine();

    const charContextLines: string[] = capped.map(function(c, i) {
        const label = 'Character ' + (i + 1) + (c.name && c.name.trim() ? ' (' + c.name.trim() + ')' : ' (unnamed)');
        return c.visuals && c.visuals.trim()
            ? '\n' + label + ': Known visuals are "' + c.visuals.trim() + '". Enhance and adapt for the scene.'
            : '\n' + label + ': No known visuals. Generate appropriate tags.';
    });

    const sysPrompt = 'You are an uncompromising art director. Output ONLY a valid JSON object, no markdown:\n{\n  "enhanced_prompt": "5-10 core tags + 1-2 sentences of observational prose. No quality tags or negative weights.",\n  "char_visuals": ["Tags for character 1 if present, else empty string", "...character 2...", "...character 3...", "...character 4..."]\n}\nThe char_visuals array must have exactly ' + capped.length + ' entries, in the same order as the characters listed below.';

    try {
        const response = await aeDiagGenerate('imgDirectorEnhance',
            [
                { role: 'system', content: sysPrompt },
                { role: 'user',   content: 'Rough Concept: ' + prompt + charContextLines.join('') + (locLine ? '\n' + locLine : '') + '\n\nOutput the JSON:' }
            ],
            // [IMG-AUDIT] SCALES WITH THE ASK. A flat 350 covered the prose plus ONE
            // character's tags; at the picker's cap of four it truncated mid-array and the
            // parse failed, which reads to the author as "enhance is flaky". Same drift
            // AE_BUDGET_EPH's note warns about -- a request the budget cannot fit.
            { model: 'glm-4-6', max_tokens: 200 + (capped.length * 80), temperature: 0.7 }
        );
        let rawOutput = ((response.choices && response.choices[0] &&
            (response.choices[0].message && response.choices[0].message.content || response.choices[0].text)) || response.text || '').trim();
        // [IMG-AUDIT] extractJSON, not a second brace-match. This site hand-rolled
        // /\{[\s\S]*\}/ + a bare JSON.parse, so a fenced reply or one missing its opening
        // brace -- both documented GLM habits extractJSON exists to absorb -- threw and the
        // whole enhance reported failure.
        const parsed = extractJSON(rawOutput);
        if (!parsed) throw new Error('No JSON found in the enhance response.');
        const cv: string[] = Array.isArray(parsed.char_visuals) ? parsed.char_visuals : [];

        const enhancedChars = capped.map(function(c, i) {
            return { name: c.name, visuals: (cv[i] && String(cv[i]).trim()) ? String(cv[i]).trim() : c.visuals };
        });

        return {
            enhancedPrompt: parsed.enhanced_prompt || prompt,
            charVisuals:    enhancedChars
        };
    } catch (err) {
        aeLog('[AE:img] enhanceDirectorPrompt failed:', err);
        return null;
    }
}

// [CEGAL-EQUIP] Equipped-item tags for one character, description-first (falls
// back to name when an item has no description written yet) -- same rule the retired
// bridge widget used (EQUIP-DESC-NOT-NAME), ported rather than re-derived. No round trip:
// this file already owns charRec.equippedItemIds and loadEntity.
async function ceStudioEquipTags(charId: string): Promise<string> {
    if (!charId) return '';
    try {
        const c = await loadCharacter(charId);
        const ids: string[] = (c && c.equippedItemIds) || [];
        if (!ids.length) return '';
        const names: string[] = [];
        for (const itemId of ids) {
            try {
                const it = await loadEntity(itemId);
                if (it) names.push((it.description && String(it.description).trim()) || it.name);
            } catch (e) { /* non-fatal, matches generateCharacterSnapshot's own tolerance */ }
        }
        return names.filter(Boolean).join(', ');
    } catch (e) {
        api.v1.error('[AE:jsxstudio] equip lookup failed:', e);
        return '';
    }
}

// Toggles the append for one slot. Idempotent by construction -- re-entrant taps while a
// lookup is in flight are checked against the CURRENT store state before writing, not the
// state captured when the async call started, so a toggle-off during the round trip wins.
function ceStudioToggleEquip(idx: number): void {
    var cur: any = null;
    try { var st0: any = ceImagesStore ? ceImagesStore.get() : null; cur = st0 && _ceStudioSlots(st0)[idx]; } catch (e) { cur = null; }
    if (!cur || !cur.id) return;

    if (cur._equipOn) {
        var stripped = cur._equipAppended
            ? String(cur.visuals || '').split(cur._equipAppended).join('')
            : String(cur.visuals || '');
        ceStudioPatch(function(s: any) {
            var next = _ceStudioSlots(s).slice();
            if (!next[idx]) return {};
            var row: any = {}; var k: string;
            for (k in next[idx]) { row[k] = next[idx][k]; }
            row.visuals = stripped; row._equipOn = false; row._equipAppended = '';
            next[idx] = row;
            return { slots: next };
        });
        return;
    }

    ceStudioPatch(function(s: any) {
        var next = _ceStudioSlots(s).slice();
        if (!next[idx]) return {};
        var row: any = {}; var k: string;
        for (k in next[idx]) { row[k] = next[idx][k]; }
        row._equipOn = true;
        next[idx] = row;
        return { slots: next };
    });

    ceStudioEquipTags(cur.id).then(function(tags: string) {
        var st1: any = null;
        try { st1 = ceImagesStore ? ceImagesStore.get() : null; } catch (e) { st1 = null; }
        var live = st1 && _ceStudioSlots(st1)[idx];
        // Toggled off again, removed, or replaced before this resolved -- do nothing.
        if (!live || !live._equipOn || live.id !== cur.id) return;
        if (!tags) {
            try { api.v1.ui.toast('No equipped items found.', { type: 'warning', autoClose: 2500 }); } catch (e2) {}
            return;
        }
        var base = String(live.visuals || '').trim();
        var appended = (base ? ', ' : '') + tags;
        ceStudioPatch(function(s: any) {
            var next = _ceStudioSlots(s).slice();
            if (!next[idx] || next[idx].id !== cur.id || !next[idx]._equipOn) return {};
            var row: any = {}; var k: string;
            for (k in next[idx]) { row[k] = next[idx][k]; }
            row.visuals = base + appended; row._equipAppended = appended;
            next[idx] = row;
            return { slots: next };
        });
    }).catch(function(e: any) { api.v1.error('[AE:jsxstudio] equip append failed:', e); });
}

// [IMG-STORYID] EVERY
// EVT_GENERATE_IMAGE GOES THROUGH HERE. It exists for one reason: to stamp the story id
// ENGINE-SIDE, at send time, on every image the bridge is about to store.
//
// ROOT CAUSE OF THE REPORT. dbSave stamps each gallery record with the bridge's
// `activeStoryId`, which is a COPY of a value this engine sent it -- and the engine sends
// it in exactly two places, both of them handshake paths (EVT_HANDSHAKE and the legacy
// EVT_CHAR_SYNC_PUSH). Nothing re-sends it when the story changes. So a bridge that was
// loaded under story A and is now sitting in story B stamps B's images with A's id, or
// with '' if no handshake has landed at all. The gallery then asks api.v1.story.id()
// DIRECTLY (ceGalleryReceive already refuses to trust the bridge's copy, and its own
// comment says why) and filters on equality -- so every image is stored, and none of them
// match. Which is precisely the report: nothing in the gallery, and avatars unaffected,
// because portraits are keyed by character and never story-scoped.
//
// The fix is to stop having two copies rather than to refresh the second one faster. The
// engine knows the story id at the moment it asks for an image; that is the only moment
// that can possibly be right, since the answer is about THIS image.
//
// FAILS OPEN, NOT CLOSED: a story id that cannot be read sends '' and the bridge falls
// back to activeStoryId, i.e. exactly today's behaviour. A read failure must never be able
// to stop an image being generated.
async function ceBroadcastImageGen(payload: any): Promise<void> {
    var sid = '';
    try { sid = String(await api.v1.story.id() || ''); } catch (e) { sid = ''; }
    var out: any = {};
    for (var k in payload) { out[k] = payload[k]; }
    out.storyId = sid;
    await broadcastToTM(EVT_GENERATE_IMAGE, out);
}

async function submitDirectorPhoto(
    prompt: string,
    uc: string,
    chars: { name: string; visuals: string; uc?: string }[],
    // [CEGAL-FIELDSEL] undefined/null = unchanged behaviour, compile the standing
    // active set (compileActiveImageFields). A real array -- including an EMPTY one, a
    // deliberate "fold in nothing" choice -- overrides it for this call only and never
    // touches any field's own `.active` flag. Checked with `!= null` rather than truthiness
    // specifically so [] is not treated the same as "no override".
    fieldIds?: string[] | null,
    // [PHASE-H] Same contract as fieldIds one line up: null/undefined leaves the
    // globalSettings default alone, a {width,height} pair overrides THIS CALL ONLY. Every
    // other caller (Auto-Snap, Snapshot, avatar and chat-photo paths) omits it and is
    // unaffected -- verified by grep before this parameter was added.
    sizeOverride?: { width: number; height: number } | null
// [STORYIMG] RETURNS THE UUID IT WAS ALREADY MINTING. This function has always
// called api.v1.uuid() and thrown the result away; the story-image anchor needs it, and
// the widget must be placed the moment Generate fires rather than after a round trip that
// never comes back. Purely additive -- every existing caller ignores the return and is
// unaffected (verified by grep before the signature changed). '' means nothing was sent.
): Promise<string> {
    // [IMGFIELDS] No more fuzzy getCharacterData(name) re-resolution here —
    // the bridge's click-to-add picker already resolved {name, visuals, uc} from its
    // own synced character cache (or left them blank for a one-off unnamed slot) and
    // the user could edit any of it; those edits are one-off, per user's call, never
    // written back to the character record, so what the bridge sends IS final. Cap
    // raised from 2 to 4 (matching the picker's own cap). A blank/unnamed slot is a
    // legitimate one-off figure now — no longer filtered out for lacking a name.
    const rawPrompt = prompt.trim();
    if (!rawPrompt) return '';

    if (!isBridgeReady) {
        api.v1.ui.toast('⚠️ Bridge not connected — Director\'s Cut requires bridge.', { type: 'warning', autoClose: 3000 });
        return '';
    }

    const compiled = (fieldIds != null) ? compileImageFieldsSubset(fieldIds) : compileActiveImageFields();
    const finalUC = uc || compiled.negative;

    const cappedChars: { name: string; visuals: string; uc: string }[] = (chars || []).slice(0, 4).map(function(c) {
        return { name: c.name || '', visuals: c.visuals || '', uc: c.uc || '' };
    }).filter(function(c) { return c.name.trim() || c.visuals.trim() || c.uc.trim(); });

    const sdpUuid = api.v1.uuid();
    await ceBroadcastImageGen({
        uuid:             sdpUuid,
        prompt:           rawPrompt,
        characters:       cappedChars,
        extraBaseVisuals: '',
        extraBaseUC:      '',
        settings: {
            width:    (sizeOverride && Number(sizeOverride.width) > 0)
                          ? Number(sizeOverride.width) : globalSettings.defaultWidth,
            height:   (sizeOverride && Number(sizeOverride.height) > 0)
                          ? Number(sizeOverride.height) : globalSettings.defaultHeight,
            steps:    Math.min(globalSettings.defaultSteps || 28, 28),
            scale:    globalSettings.defaultScale || 5.0,
            model:    ceImgModel(),
            seed:     _ceImgSeed(0),
            quality:  compiled.quality,
            negative: finalUC
        },
        autoDownload: globalSettings.autoDownload
    });
    api.v1.ui.toast('📸 Manual Snap dispatched!');
    return sdpUuid;
}


// ---- Snapshot Image (callable: button or future actions) -------------------
// Reads the stored GLM appearance snapshot for charId, resolves the character's
// cached visuals and any location visuals, and broadcasts a tagged
// EVT_GENERATE_IMAGE { entityId, kind:'snapshot' } so the bridge can land the
// result in the snapshot gallery section and the entity's top pane.
async function assembleSnapshotImage(charId: string): Promise<void> {
    try {
        if (!isBridgeReady) {
            api.v1.ui.toast('Bridge not connected - image generation requires bridge.', { type: 'warning', autoClose: 3000 });
            return;
        }
        let aChar = await loadCharacter(charId);
        if (!aChar) { aeLog('[AE:img] assembleSnapshotImage: char not found'); return; }
        let aEntId = (aChar as any).entityId || null;
        let aEnt = aEntId ? await loadEntity(aEntId) : null;
        let snapText = await api.v1.storyStorage.getOrDefault(STORAGE_CHAR_SNAP_PFX + charId, '') as string;
        if (!snapText) {
            api.v1.ui.toast('Generate a text snapshot first.', { type: 'warning', autoClose: 3000 });
            return;
        }
        let locVisuals = '';
        if (aEnt && aEnt.parentId) {
            let aLoc = await loadEntity(aEnt.parentId);
            if (aLoc && (aLoc as any).visuals) locVisuals = String((aLoc as any).visuals);
        }
        let basePrompt = [snapText, locVisuals].filter(Boolean).join(', ');
        let found = getCharacterData(aChar.name);
        let charVisuals = found.length ? found[0].visuals : '';
        let charUC = found.length ? found[0].uc : '';
        let compiled = compileActiveImageFields();
        await ceBroadcastImageGen({
            uuid:             api.v1.uuid(),
            prompt:           basePrompt,
            characters:       charVisuals ? [{ name: aChar.name, visuals: charVisuals, uc: charUC }] : [],
            extraBaseVisuals: '',
            extraBaseUC:      '',
            charId:           aChar.id,
            entityId:         aEntId,
            kind:             'snapshot',
            settings: {
                width:    globalSettings.defaultWidth,
                height:   globalSettings.defaultHeight,
                steps:    Math.min(globalSettings.defaultSteps || 28, 28),
                scale:    globalSettings.defaultScale || 5.0,
                model:    ceImgModel(),
                seed:     _ceImgSeed(0),
                quality:  compiled.quality,
                negative: compiled.negative
            },
            autoDownload: globalSettings.autoDownload
        });
        api.v1.ui.toast('Generating snapshot image for ' + aChar.name + '...', { type: 'info', autoClose: 2500 });
    } catch (snapImgGenErr) {
        api.v1.error('[AE:img] assembleSnapshotImage:', snapImgGenErr);
    }
}

// [CE-STRIP earlier] aeGenerateActionImage removed — action-triggered image gen
// (the 'generate_image' effect type) was only reachable through the Actions
// effects pipeline, which is gone. Auto-Snap, Snapshot, and Director's Cut image
// generation are separate paths and are untouched.


// ============================================================================
// SECTION 16b — STORY IMAGE WIDGETS  [STORYIMG]
// Roadmap H2. Studio images landed in the gallery and nowhere else; this puts
// them in the story editor on the same widget channel character-chat photos
// already use, with the same card and the same three verbs.
//
// THE H2 BLOCKER WAS HANDLE-TRACKED CLEARING, AND IT IS CONSTRUCTIBLE.
// refreshCharChatImageWidgets calls a blanket clearWidgets() and its own comment
// states the condition this patch meets: "clearWidgets() is scoped to widgets
// created BY THIS SCRIPT ... If a second widget feature ever lands, this must
// become handle-tracked instead." createWidgets returns DecorationWidgetHandle[]
// with .id and .dispose() (script-types_d.txt ~2430/1793), so both features now
// dispose their OWN handles and neither can wipe the other's.
//
// ANCHORING IS DURABLE, AND THAT IS A MEASURED FACT, not an assumption:
// insertParagraphAfter's own doc comment says "section IDs are not indexes."
// A sectionId therefore survives insertions and deletions elsewhere in the
// document and only dies with its own paragraph -- so { uuid, sectionId } in
// storyStorage is a real anchor, and _ceStoryImgPrune drops the entries whose
// paragraph is gone. This is why there is NO document text tag here. Character
// chat needs one because the tag IS the character's line; a studio image is not
// something anybody said, and writing "[Image#...]" into the author's prose to
// hold a position it does not need would be pollution.
//
// PLACEMENT, per user: end of the story, followed by a fresh empty paragraph so
// typing or generating can continue immediately. The empty paragraph is inserted
// FIRST and the widget anchors on the section above it, so the image lands
// between the last prose and the new blank line.
//
// PENDING NEEDS NO NEW MESSAGE. The engine mints the uuid (submitDirectorPhoto
// always did -- it just discarded it, which is the one change made to that
// function) and anchors the widget the instant Generate fires. The bridge paints
// a placeholder while that uuid is not yet in IndexedDB and swaps in the picture
// when it lands. "Is it generating" is therefore answered by the same fact that
// answers "is it there", and there is nothing to keep in sync.
//
// WHICH ALSO MEANS A FAILED GENERATION LEAVES A PLACEHOLDER STANDING, on purpose
// -- it is true, the image never arrived. ceStoryImgClearAll is the escape
// hatch, and it is also the recovery path for the case no handle can reach: the
// script is unloaded on story switch, so handles from a previous load are gone
// while their widgets are not. That is exactly what the blanket clearWidgets()
// is still good for, and why it is kept as the second half of Clear rather than
// deleted.
//
// OPT-IN, DEFAULT OFF (per user). Nothing is emitted into the story until the
// author turns it on in the Studio, which is also what keeps this safe against
// an older bridge: no toggle, no sentinel, no stray 1px text node.
// ============================================================================

// MUST MATCH the bridge constant of the same name -- FLAG DAY if changed, same
// rule as AE_CHARCHAT_IMG_SENTINEL and AE_CHARCHAT_AVA_SENTINEL before it.
// Payload is the bare 8-hex short id, exactly like the chat sentinel: the widget
// content carries no model prose, so noTemplate is not needed and the createWidgets
// validator stays happy (see CHARCHAT-IMGWIDGET-FIX for what a richer payload cost).
var AE_STORY_IMG_SENTINEL = 'ce-storyimg:';

// The live widget handles for THIS feature. Module state, deliberately: it cannot
// survive a script unload and is not meant to -- _ceStoryImgRefresh rebuilds from
// storyStorage on load, and the stale widgets a previous load left behind are
// cleared by the blanket sweep inside ceStoryImgClearAll.
var _ceStoryImgHandles: any[] = [];

async function loadStoryImgAnchors(): Promise<any[]> {
    try {
        var raw: any = await api.v1.storyStorage.getOrDefault(STORAGE_STORY_IMGS, []);
        return (raw && raw.length) ? raw : [];
    } catch (e) { api.v1.error('[AE:storyimg] load failed:', e); return []; }
}

async function saveStoryImgAnchors(list: any[]): Promise<void> {
    try { await api.v1.storyStorage.set(STORAGE_STORY_IMGS, (list || []).filter(Boolean)); }
    catch (e) { api.v1.error('[AE:storyimg] save failed:', e); }
}

// The 8-hex prefix the bridge prefix-resolves against its gallery index. Identical
// derivation to the bridge's _ccimgBuildIndex, which is what makes the two agree.
function _ceStoryImgShort(uuid: string): string {
    return String(uuid || '').replace(/-/g, '').substring(0, 8).toLowerCase();
}

// Drop anchors whose paragraph no longer exists. A section can be deleted; a
// sectionId cannot drift, so this is the ONLY way an anchor goes stale.
async function _ceStoryImgPrune(anchors: any[]): Promise<any[]> {
    var rows: any[] = [];
    try { rows = await api.v1.document.scan(); } catch (eScan) { return anchors || []; }
    var live: any = {};
    var i = 0;
    for (i = 0; i < (rows || []).length; i++) { live[String(rows[i].sectionId)] = 1; }
    var kept: any[] = [];
    for (i = 0; i < (anchors || []).length; i++) {
        var a: any = anchors[i];
        if (!a || !a.uuid) continue;
        if (live[String(a.sectionId)]) kept.push(a);
    }
    return kept;
}

// Dispose only OUR handles. Never clearWidgets() -- that would take the chat's
// photos and avatars with it, which is the whole point of this being handle-tracked.
async function _ceStoryImgDispose(): Promise<void> {
    var hs = _ceStoryImgHandles;
    _ceStoryImgHandles = [];
    var i = 0;
    for (i = 0; i < hs.length; i++) {
        try { if (hs[i] && hs[i].dispose) await hs[i].dispose(); }
        catch (eDisp) { aeLog('[AE:storyimg] handle dispose failed (already gone?)'); }
    }
}

// Rebuild every story-image widget from the anchor store. Cheap and idempotent:
// dispose ours, prune dead anchors, re-create. Called after a placement, after a
// removal, and once on load.
async function refreshStoryImageWidgets(): Promise<void> {
    await _ceStoryImgDispose();

    var anchors = await loadStoryImgAnchors();
    if (!anchors.length) return;
    var pruned = await _ceStoryImgPrune(anchors);
    if (pruned.length !== anchors.length) { await saveStoryImgAnchors(pruned); }
    if (!pruned.length) return;

    var opts: any[] = [];
    var i = 0;
    for (i = 0; i < pruned.length; i++) {
        opts.push({
            type: 'node',
            sectionId: Number(pruned[i].sectionId),
            content: [{
                type: 'text',
                text: AE_STORY_IMG_SENTINEL + _ceStoryImgShort(pruned[i].uuid),
                style: { fontSize: '1px', color: 'transparent', lineHeight: '0' }
            }]
        });
    }
    try {
        var handles: any = await api.v1.editor.decorations.createWidgets(opts);
        _ceStoryImgHandles = (handles && handles.length) ? handles : [];
    } catch (eW) {
        aeLog('[AE:storyimg] widget create failed (images will not appear in the story):', eW);
    }
}

// Place one image at the end of the story. Returns false when it could not, which
// the caller states rather than swallowing.
//
// ORDER IS LOAD-BEARING: the blank continuation paragraph is inserted BEFORE the
// widget is anchored, and the widget anchors on the section ABOVE it. A widget
// inserts after its section (sectionId's own doc comment), so this lands the image
// between the last prose paragraph and the new blank one -- which is what "add a
// paragraph after so it is easy to continue typing" asks for.
async function ceStoryImgPlace(uuid: string): Promise<boolean> {
    if (!uuid) return false;
    var rows: any[] = [];
    try { rows = await api.v1.document.scan(); } catch (eScan) { return false; }
    if (!rows || !rows.length) return false;
    var lastId = Number(rows[rows.length - 1].sectionId);

    // A trailing blank paragraph already there is reused rather than stacking a
    // second one -- generating three images in a row should not leave three empty
    // paragraphs behind.
    var lastTxt = String((rows[rows.length - 1].section && rows[rows.length - 1].section.text) || '');
    if (lastTxt.trim()) {
        try { await api.v1.document.insertParagraphAfter(lastId, { text: '' }); }
        catch (eIns) { aeLog('[AE:storyimg] continuation paragraph failed; anchoring anyway'); }
    } else if (rows.length > 1) {
        // The document already ends blank: anchor above that blank line instead of
        // below it, so the image still sits between prose and the place the cursor
        // wants to be.
        lastId = Number(rows[rows.length - 2].sectionId);
    }

    var anchors = await loadStoryImgAnchors();
    anchors.push({ uuid: String(uuid), sectionId: lastId, createdAt: Date.now() });
    await saveStoryImgAnchors(anchors);
    await refreshStoryImageWidgets();
    return true;
}

// Drop ONE image's anchor. Called by the bridge after a delete from the card
// (AE_STORY_IMG_DROP) -- per user, the widget goes with the image. This is the
// opposite of the chat photo rule, and correctly so: there the document tag is
// the character's own line and outlives the picture, and here there is no line.
async function ceStoryImgDrop(uuid: string): Promise<void> {
    if (!uuid) return;
    var want = String(uuid);
    var wantShort = _ceStoryImgShort(want);
    var anchors = await loadStoryImgAnchors();
    var kept: any[] = [];
    var i = 0;
    for (i = 0; i < anchors.length; i++) {
        var a: any = anchors[i];
        if (!a || !a.uuid) continue;
        // Matched on EITHER form: the card knows the full uuid, but a caller that
        // only ever saw the sentinel knows the short one.
        if (String(a.uuid) === want || _ceStoryImgShort(a.uuid) === wantShort) continue;
        kept.push(a);
    }
    await saveStoryImgAnchors(kept);
    await refreshStoryImageWidgets();
}

// The escape hatch, per user: "in case there is any issue with generation, we need
// to be able to clear the widgets from the story editor."
//
// TWO SWEEPS, AND BOTH ARE NEEDED. Disposing our handles clears what THIS load
// created. The blanket clearWidgets() then catches widgets orphaned by a previous
// load of the script -- a story switch unloads the script and takes its handles
// with it, and nothing else can reach those. That blanket call also takes the
// chat's widgets, which is acceptable ONLY because refreshCharChatImageWidgets
// rebuilds them on its own next tick; it is a repaint for the chat and a real
// clear for us.
async function ceStoryImgClearAll(): Promise<number> {
    var anchors = await loadStoryImgAnchors();
    var n = anchors.length;
    await _ceStoryImgDispose();
    try { api.v1.editor.decorations.clearWidgets(); } catch (eClr) {}
    await saveStoryImgAnchors([]);
    // Give the chat its widgets straight back rather than waiting for its next turn.
    try { await refreshCharChatImageWidgets(); } catch (eCc) {}
    return n;
}


// ============================================================================
// SECTION 18 — BRIDGE MESSAGING LAYER
// All communication between the engine (Web Worker) and bridge (Tampermonkey
// page-context script). Engine→Bridge via api.v1.messaging.broadcast().
// Bridge→Engine via the onMessage listener registered in initMessaging().
//
// Broadcast functions queue and debounce to avoid redundant round-trips when
// multiple storage writes fire in rapid succession (e.g., during runDynamicEngine).
//
// buildSceneStatePayload() is the most complex new function. It loads the
// protagonist's location + one-hop entity graph and packages the data the bridge
// needs to render the Scene HUD. Capped to one-hop range for performance (<200ms).
//
// handleBridgeMessage() is the inbound message router. New event handlers:
//   EVT_DIRECTOR_SUBMIT — bridge submitted Director's Cut (enhance or generate)
//   EVT_REQ_SCENE_STATE — bridge requests immediate SCENE_STATE_UPDATE push
// On EVT_HANDSHAKE_ACK: immediately push char data then scene state, then AE_IMG_FIELDS_SYNC.
// ============================================================================

// ── Broadcast Primitives ──────────────────────────────────────────────────────


async function broadcastToTM(event: string, data?: Record<string, any>): Promise<void> {
    // Preserved verbatim from AI engine.
    data = data || {};
    try {
        await api.v1.messaging.broadcast(
            { type: 'MESSAGE', sid: api.v1.script.id, payload: Object.assign({ event: event }, data) },
            'hypebot'
        );
    } catch (e) {
        aeLog('[AE:bridge] broadcastToTM failed:', e);
    }
}

// [ENGINE-THINKING-SIGNAL] Reference count, not a boolean — onGenerationRequested
// and onGenerationEnd fire for EVERY api.v1.generate() call including nested ones (ephemeral
// thoughts, the image architect's own probe), per the existing _diagProbeActive guard comment
// elsewhere in this file ("it now fires every ephemeral/architect call"). If a main story
// generation is still in flight when a nested ephemeral call finishes, that call's onGenerationEnd
// must not turn the indicator off out from under the still-running outer one. Only broadcasts on
// the 0->1 and 1->0 transitions, not every call, so the bridge doesn't get spammed for the length
// of a busy scene.
let _aeThinkingRefs = 0;
async function _aeThinkingPulse(on: boolean): Promise<void> {
    let before = _aeThinkingRefs;
    _aeThinkingRefs = Math.max(0, _aeThinkingRefs + (on ? 1 : -1));
    if ((before === 0) === (_aeThinkingRefs === 0)) return; // no 0<->nonzero transition, nothing to say
    // [DIAG earlier CHARCHAT-RACE-DIAG] Gated to an active chat so ordinary story play (where
    // this pulse fires constantly and harmlessly) doesn't get spammed. This is the GHOST GLYPH's
    // real on/off timing, which is a SEPARATE signal from busyStage's send-button badge — if the
    // user is watching the glyph specifically, this is what tells us whether IT clears before the
    // underlying generation slot is actually free, independent of what the badge says.
    if (_aeCharChat.active) _ccRaceDiagMark('ghost signal -> ' + (_aeThinkingRefs > 0 ? 'ON' : 'OFF'));
    try { await broadcastToTM(EVT_ENGINE_THINKING, { on: _aeThinkingRefs > 0 }); }
    catch (eEt) { aeLog('[AE:engine-thinking] pulse broadcast failed:', eEt); }
}

// ── Character Data Broadcast ──────────────────────────────────────────────────

async function buildCharacterDataPayload(): Promise<CharacterVisualRecord[]> {
    // Reads all active characters and packages their visual + persona fields into
    // CharacterVisualRecord[]. Also updates cachedCharVisuals in-memory so
    // getCharacterData() stays current without a round-trip on the next call.
    try {
        const chars = await loadAllCharacters();
        const result: CharacterVisualRecord[] = chars
            .filter(function(c) { return c.active !== false; })
            .map(function(c): CharacterVisualRecord {
                return {
                    id:                  c.id,
                    name:                c.name,
                    nicknames:           c.nicknames           || [],
                    visuals:             c.visuals             || '',
                    uc:                  c.uc                  || '',
                    sceneVisuals:        c.sceneVisuals        || '',
                    avatarVisuals:       c.avatarVisuals       || '',
                    avatarWidth:         c.avatarWidth         || 832,
                    avatarHeight:        c.avatarHeight        || 1216,
                    avatarSeed:          c.avatarSeed          || 0,
                    species:             c.species             || '',
                    age:                 c.age                 || '',
                    gender:              c.gender              || '',
                    briefDescription:    c.briefDescription    || '',
                    physicalDescription: c.physicalDescription || '',
                    personalityCore:     c.personalityCore     || '',
                    voiceAndMannerisms:  c.voiceAndMannerisms  || '',
                    background:          c.background          || ''
                };
            });
        cachedCharVisuals = result; // keep in-memory cache current
        return result;
    } catch (e) {
        aeLog('[AE:bridge] buildCharacterDataPayload error:', e);
        return [];
    }
}



// ── Scene State Broadcast ─────────────────────────────────────────────────────

// [earlier] Scan library templates (cheap, in-memory) for time conditions so the
// calendar can mark actions tied to times. One entry per template; the first time
// condition found provides the placement hint, the summary lists them all.

// Extracted from buildSceneStatePayload so the clock is readable without a
// resolved player location/protagonist. buildSceneStatePayload (and therefore
// getSceneState()) returns null on a fresh scenario before any location is set — that's a
// location precondition, not a clock precondition. openCalendarModal was piggybacking on the
// full scene-state payload just to reach `.clock`, which meant the calendar reported "no clock"
// on every brand-new scenario even though loadClock() itself has always been location-independent
// (it seeds from cfg.timeStartHours).

async function buildSceneStatePayload(): Promise<SceneStatePayload | null> {
    // Assembles the full HUD payload. Reads the current camera location, present
    // characters, party resources, and one-hop entity actions. Capped to one hop for
    // performance. Calls evaluateFieldCondition (Section 19) — forward reference, safe
    // at runtime.
    try {

        // 2. Current location entity — the camera. [earlier ROOT-LOCATION-HUD, per
        // user: "the HUD still shows No scene state available"] FIXES a gap earlier
        // left: loadProtagonistLocation() was fixed to return AE_ROOT_LOCATION_ID instead
        // of null when no location exists, but this function still did
        // loadEntity(locId) unconditionally right after — and the root sentinel is
        // DELIBERATELY not a real entity (see its own comment), so that load always
        // returned undefined and this function still bailed to null every time,
        // reproducing the exact same "No scene state available" the earlier patch was
        // meant to fix. This was the actual gap, not a regression in the sentinel
        // logic itself, which was and is correct — recalculateScenePresence's
        // cRoom===camRoom match already works fine with it.
        // FIX: when locId IS the root sentinel, skip loadEntity entirely and
        // synthesize a minimal stand-in with the fields this function actually reads
        // (name/description/state/parentId) — a location-less world's "scene" is just
        // "wherever everyone's unplaced bodies already are," so this describes that
        // literally rather than pretending a real location exists.
        const locId  = await loadProtagonistLocation();
        if (!locId) return null;
        let locEnt: any;
        if (locId === AE_ROOT_LOCATION_ID) {
            locEnt = { id: AE_ROOT_LOCATION_ID, name: 'Unplaced', description: 'No location has been created yet.', parentId: null, type: 'location' };
        } else {
            locEnt = await loadEntity(locId);
            if (!locEnt) return null;
        }
        aeLog('[AE:TRACE] buildSceneState cameraLoc=' + locEnt.name + '(' + locId + ')');

        // 3. The description. [ENT-AUDIT] Was "resolve state-dependent
        // description" and resolved nothing -- see the interface.
        const locDesc = locEnt.description || '';

        // 4. Present characters → SceneCharacterInfo[]. [CE-STRIP vNEXT] No longer
        // force-includes the protagonist via an isProtagonist OR-clause — presence is
        // now purely "co-located with the camera" (recalculateScenePresence), same rule
        // for everyone, protagonist included.
        const allChars = await loadAllCharacters();
        // [ATTENTION] Was a synchronous .map(). _ceDramaAttention reads
        // historyStorage, so this became a sequential for-loop rather than a Promise.all:
        // the reads are already serialized inside the helper, and a parallel fan-out over a
        // crowded scene would buy nothing while making a partial failure harder to read.
        const presentCharacters: SceneCharacterInfo[] = [];
        for (const c of allChars.filter(function(c2) { return c2.scenePresent; })) {
            presentCharacters.push({
                id:              c.id,
                name:            c.name,
                entityId:        c.entityId || '',
                briefDescription: c.briefDescription || '',
                compressedLine:  (c.ephemeral && c.ephemeral.compressedLine) || '',
                isProtagonist:   !!c.isProtagonist,
                attention:       await _ceDramaAttention(c)
            });
        }

        // [CE-STRIP earlier] Action scope / available actions / available ActionInstances /
        // follow-state annotation removed — Actions system cut. allEntityMeta is still
        // needed below by the (simplified, awareness-only) location graph.
        const allEntityMeta = await loadEntityIndex();

        // 8. Location graph — parent (up), children (down), explicit connections (side)
        // [FIX Bug3] Added currentIcon + parentIcon so bridge can render entity icons on map nodes.
        // [CE-STRIP earlier] Travel-cost annotations (resourceTag/resourceCost/resourceIcon/
        // timeCost/gated/requiresVehicle) removed — this is now awareness/adjacency only.
        const locationGraph = {
            currentName:    locEnt.name,
            currentType:    'location',
            currentIcon:    (locEnt as any).icon || undefined,
            parentId:    locEnt.parentId || null,
            parentName:  '',
            parentType:  '',
            parentIcon:  undefined as string | undefined,
            children:    [] as { id: string; name: string; type: string; hasChildren: boolean; icon?: string; }[],
            connections: [] as { id: string; name: string; label: string; oneWay: boolean; icon?: string; }[],
            siblings:    [] as { id: string; name: string; type: string; icon?: string; }[]
        };

        if (locEnt.parentId) {
            const parentMeta = allEntityMeta.find(function(m) { return m.id === locEnt.parentId; });
            if (parentMeta) { locationGraph.parentName = parentMeta.name; locationGraph.parentType = parentMeta.type; locationGraph.parentIcon = (parentMeta as any).icon || undefined; }
        }
        for (const childMeta of allEntityMeta) {
            if (childMeta.parentId === locId && childMeta.type === 'location') {
                const lgHasGrandchildren = allEntityMeta.some(function(m) { return m.parentId === childMeta.id && m.type === 'location'; });
                locationGraph.children.push({
                    id: childMeta.id, name: childMeta.name, type: childMeta.type,
                    hasChildren: lgHasGrandchildren, icon: childMeta.icon || undefined
                });
            }
        }
        for (const lgConn of (locEnt.connectedEntityIds || [])) {
            const lgConnMeta = allEntityMeta.find(function(m) { return m.id === lgConn.targetId; });
            if (lgConnMeta) {
                locationGraph.connections.push({
                    id: lgConn.targetId, name: lgConnMeta.name,
                    label: (lgConn as any).label || '', oneWay: (lgConn as any).oneWay || false,
                    icon: lgConnMeta.icon || undefined
                });
            }
        }

        // Lateral siblings: location-type entities sharing this location's parentId
        // (null parentId = shared world root, so top-level locations are mutually reachable).
        // [CE-STRIP earlier] awareness only — no travel cost.
        for (const sibMeta of allEntityMeta) {
            if (sibMeta.type !== 'location' || sibMeta.id === locId) continue;
            if (sibMeta.parentId !== locEnt.parentId) continue;
            locationGraph.siblings.push({
                id: sibMeta.id, name: sibMeta.name, type: sibMeta.type,
                icon: sibMeta.icon || undefined
            });
        }

        // 8b. Present items — item-type entities whose parent is the current location
        const presentItems = allEntityMeta
            .filter(function(m) { return m.type === 'item' && m.parentId === locId; })
            .map(function(m) { return { id: m.id, name: m.name, icon: (m as any).icon || undefined }; });

        const cfg = await loadConfig();

        return {
            locationId:           locId,
            locationName:         locEnt.name,
            // [ENT-AUDIT] locationState REMOVED FROM THE PAYLOAD -- it shipped
            // 'default' on every turn and nothing read it. AND locationDescription ADDED,
            // WHICH IS A LIVE BUG FIX: the field is REQUIRED on SceneStatePayload,
            // cePublishScene reads it into ceSceneStore.locationDesc, and this builder has
            // never set it. locDesc was computed three lines up and thrown away, so the
            // Scene surface has been showing an empty location description for as long as
            // it has had one.
            //
            // IT WAS MASKED BY locationState. TypeScript reports ONE property error per
            // object literal, and the excess-property complaint about locationState came
            // first -- so removing a dead field is what surfaced a missing live one. Same
            // masking that hid knowledgeString behind notes; second time this pattern has
            // paid out in this cycle, and it is an argument for reading the whole error
            // list on a literal rather than the first line of it.
            locationDescription:  locDesc,
            presentCharacters:    presentCharacters,
            locationGraph:        locationGraph,
            presentItems:         presentItems,
            // [CE-STRIP v2.1.x] presentMinorNpcs removed — minor-NPC tier retired, everyone is a normal character now.
            // [CE-STRIP earlier] npcArchetypes/itemArchetypes removed from scene payload — Bestiary + Item Templates cut.
            defaultBgUrl:         (cfg as any).defaultBackgroundUrl || ''
        };
    } catch (e) {
        aeLog('[AE:bridge] buildSceneStatePayload error:', e);
        return null;
    }
}


// [REACH] THE FOUR RECEIVERLESS BROADCASTERS WERE HERE AND ARE DELETED:
//   broadcastSceneState / queueSceneStateBroadcast   -> SCENE_STATE_UPDATE
//   broadcastCharacterData / queueCharacterDataBroadcast -> CHARACTER_DATA_SYNC
//
// THE BRIDGE HAS NO CASE FOR EITHER TYPE. Its inbound switch carries fourteen cases and a
// `default:` that console-logs; both of these landed in the default. So the engine was
// building a 140-line scene payload -- which reads every present character's record and
// two or three historyStorage entries apiece -- and a full character-visual payload, on
// every entity save, every presence recalculation and every travel, and shipping them to
// a log line. 40 call sites, none of them free, none of them observable.
//
// buildSceneStatePayload SURVIVES AND IS NOT AFFECTED: cePublishScene (SECTION 29) is its
// real consumer and always was. cePublishScene's own header predicted this deletion in as
// many words -- "what makes each surface's AE_* message pair deletable later: the builder
// gets re-pointed at a store instead of at broadcastToTM". This is that later.
//
// CONSEQUENCE WORTH ACTING ON: SceneStatePayload is no longer a cross-artifact contract,
// so the reason cePublishScene keeps its jsx projection SEPARATE from the builder (stated
// in its own comment: widening a shared payload for one surface's display needs) has
// dissolved. Folding the two together is now a legal simplification. Phase 1 work.


// ── Messaging Init ────────────────────────────────────────────────────────────

async function initMessaging(): Promise<void> {
    // [HSK1] onMessage registration is awaited so the handler is in place
    // before onScriptsLoaded continues (fast ACKs won't be missed).
    // The handshake itself is then retried in a detached loop so story init is not
    // blocked if the bridge proxy installed after our worker was constructed.
    try {
        await api.v1.messaging.onMessage(handleBridgeMessage);
    } catch (e) {
        aeLog('[AE:bridge] initMessaging onMessage error:', e);
        return;
    }

    // Fire-and-forget retry loop. Sends the full handshake sequence (IN + OUT + REQ)
    // every 1.5 s until the bridge ACKs (isBridgeReady) or 20 attempts are exhausted.
    // Using an anonymous IIFE avoids the named-async-in-sync-body NAI sandbox constraint.
    (async function() {
        let _hsAttempts = 0;
        while (!isBridgeReady && _hsAttempts < 20) {
            try {
                await api.v1.messaging.broadcast(
                    { type: 'HANDSHAKE', sid: api.v1.script.id, payload: { handshake: 'NAI_SCRIPT:IN' } }
                );
                await api.v1.messaging.broadcast(
                    { type: 'HANDSHAKE', sid: api.v1.script.id, payload: { handshake: 'NAI_SCRIPT:OUT' } }
                );
                await broadcastToTM(EVT_HANDSHAKE_REQ, { scriptId: api.v1.script.id });
            } catch (e2) {
                aeLog('[AE:bridge] handshake attempt', _hsAttempts, 'error:', e2);
            }
            _hsAttempts++;
            if (isBridgeReady) break;
            aeLog('[AE:bridge] Handshake attempt', _hsAttempts, '— waiting for ACK…');
            await api.v1.timers.sleep(1500);
        }
        if (isBridgeReady) {
            aeLog('[AE:bridge] Bridge connected after', _hsAttempts, 'attempt(s).');
        } else {
            aeLog('[AE:bridge] Bridge did not ACK after', _hsAttempts, 'attempts. Running engine-only.');
        }
    })().catch(function(e3) { aeLog('[AE:bridge] initMessaging loop error:', e3); });
}

// [CE-CULL v3.0.30] buildEntityDetailPayload WAS HERE AND IS DELETED. It projected a
// character, its entity, its children, hooks, equipment and per-child attention into
// one payload for AE_ENTITY_DETAIL_RESPONSE, a message the bridge has never had a case
// for. Its two senders were resolveCharHook and setItemEquip -- both of which are
// reached from native rows that repaint themselves. The Entity surface (SECTION 36)
// builds its own projection from ceEntityStore and did not use this.

// [CE-STRIP earlier] performTravelRequest removed — Travel cut.


// [CE-STRIP earlier] toggleCharFollow removed — travel/follow cut.


// [earlier] Shared hook resolution. Extracted from AE_RESOLVE_HOOK so the native
// character inspection view can resolve a hook without a message round-trip.
// [HOOK-ONE] THE ONE WAY A HOOK ENDS, from the escalator, the profile and the
// wizard alike. Both halves go together: the record field is nulled AND the pressure key is
// removed, so the next hook starts at tier 1 instead of inheriting whatever this one capped
// out at. Any caller that cleared only one of them left a blank hook that opened at
// Breaking point on its first scan.
async function resolveCharHook(charId: string, quiet?: boolean): Promise<void> {
    try {
        if (!charId) return;
        const fresh = await loadCharacter(charId);
        if (!fresh) return;
        const hkDesc = fresh.hook ? String(fresh.hook.description || '').substring(0, 50) : '';
        fresh.hook = null;
        await api.v1.historyStorage.remove(_cePressureKey(charId, 'hook'));
        await saveCharacter(fresh);
        if (!quiet && hkDesc) api.v1.ui.toast('✓ Resolved: ' + hkDesc, { type: 'success', autoClose: 3000 });
    } catch (e) { aeLog('[AE:bridge] resolveCharHook error:', e); }
}

// [CE-STRIP earlier] toggleNarrativeTracking removed — quest-tracker cut.


// [earlier] Shared equip/unequip. Extracted from AE_EQUIP_ITEM / AE_UNEQUIP_ITEM
// (merged via the equip flag) so native item rows can toggle equip state without a
// message round-trip. Rule preserved exactly: the toggle only ever targets the
// item's own owner/parent character id passed in as charId -- callers resolve which
// character that is (owner for equip, equippedToCharId for unequip); there is no
// character picker.
async function setItemEquip(charId: string, itemId: string, equip: boolean): Promise<void> {
    try {
        if (!charId || !itemId) return;
        const char = await loadCharacter(charId);
        const item = await loadEntity(itemId);
        if (!char || !item) return;
        await aeSetEquip(item, char, equip);
        api.v1.ui.toast(equip ? ('🎒 Equipped: ' + item.name) : ('🎒 Unequipped: ' + item.name), { type: equip ? 'success' : 'info', autoClose: 2000 });

    } catch (e) { aeLog('[AE:bridge] setItemEquip error:', e); }
}

// ── Inbound Message Router ────────────────────────────────────────────────────

// [ENTITIES] Normalize a kind's entities (memory sections / species / factions)
// into a uniform shape for the HUD. Reads the SAME cfg stores the engine wizard writes.

// [WIZHUD] Build the wizard snapshot for the HUD: topic registry, chat list
// (lightweight), and the active chat in full (messages + context selection).
async function buildWizardStatePayload(): Promise<any> {
    let wcfg = await loadConfig();
    let topicsSrc = ((wcfg as any).wizardTopics && (wcfg as any).wizardTopics.length) ? (wcfg as any).wizardTopics : DEFAULT_WIZARD_TOPICS;
    let topics = topicsSrc.map(function(t: WizardTopic) { return { id: t.id, label: t.label, commitKind: t.commitKind }; });
    let chats = await loadWizardChats();
    let list = chats.map(function(c: WizardChat) {
        return { id: c.id, topicId: c.topicId, title: c.title, updatedAt: c.updatedAt, msgCount: (c.messages || []).length };
    }).sort(function(a: any, b: any) { return b.updatedAt - a.updatedAt; });
    let activeId = await api.v1.tempStorage.getOrDefault(STORAGE_WIZ_ACTIVE_CHAT, '') as string;
    let active = null;
    if (activeId) {
        let ac = await loadWizardChat(activeId);
        if (ac) {
            active = {
                id: ac.id, topicId: ac.topicId, title: ac.title,
                messages: ac.messages || [],
                contextChatIds: ac.contextChatIds || [],
                lorebookEntryIds: ac.lorebookEntryIds || [],
                includeStory: !!ac.includeStory
            };
        } else { activeId = ''; }
    }
    return { topics: topics, chats: list, activeChatId: activeId, activeChat: active, project: { name: wcfg.projectName || '', genre: wcfg.projectGenre || '', concept: wcfg.projectConcept || '' } };
}

// [WIZHUD] List selectable context sources for a chat: other wizard chats,
// lorebook entries, and characters (each flagged whether it already has a lore entry,
// so the picker can show 'will create on add'). Mirrors buildWizardContext's sources.
async function buildWizardSourcesPayload(chatId: string): Promise<any> {
    let chats = await loadWizardChats();
    let otherChats = chats.filter(function(c: WizardChat) { return c.id !== chatId; })
        .map(function(c: WizardChat) { return { id: c.id, title: c.title, topicId: c.topicId }; });
    let lbEntries: any[] = [];
    try {
        let entries = await api.v1.lorebook.entries();
        lbEntries = (entries || []).map(function(e: any) {
            let label = e.displayName || (e.keys && e.keys.length ? e.keys[0] : 'Untitled');
            let preview = (e.text || '').slice(0, 80);
            return { id: e.id, label: label, preview: preview };
        });
    } catch (eWlb) { lbEntries = []; }
    let chars = await loadAllCharacters();
    let charSources = chars.map(function(ch: CharacterRecord) {
        return { id: ch.id, name: ch.name, hasLoreEntry: !!ch.lorebookEntryId, lorebookEntryId: ch.lorebookEntryId || '' };
    });
    let active = chatId ? await loadWizardChat(chatId) : null;
    return {
        chatId: chatId,
        chats: otherChats,
        lorebookEntries: lbEntries,
        characters: charSources,
        selected: active ? {
            contextChatIds: active.contextChatIds || [],
            lorebookEntryIds: active.lorebookEntryIds || [],
            characterIds: active.characterIds || [],
            includeStory: !!active.includeStory
        } : { contextChatIds: [], lorebookEntryIds: [], characterIds: [], includeStory: false }
    };
}

// [PROFILE] Build the full editable character profile for the profile surface.
// ONE CALLER: cePublishProfile. It was written to serve the bridge's character tab as
// well; that tab was removed with the HUD, so a key nothing on SECTION 30 reads is dead
// weight computed on every commit. Check the surface before adding one.
async function buildCharProfilePayload(char: CharacterRecord, cfg: GlobalConfig): Promise<any> {
    // Custom static fields: pair each def with its current value.
    // [FIELD-GROUPING] Ordered by slot group, and each entry now carries `group`
    // (the machine key) and `groupLabel` (the display name). The bridge draws a divider
    // whenever groupLabel changes rather than one 'Dynamic fields' heading over the whole
    // run, so a facet appears under the slot it deepens on this surface too.
    //
    // The label is computed HERE, not on the bridge, for the same reason CE_FACET_HINTS is
    // computed there: the group->name mapping is engine config territory (an author can add
    // a slot value), and a second hand-maintained copy would drift silently \u2014 the
    // symptom being a divider that says the wrong thing, which nobody reports as a bug.
    let pCustom: any[] = [];
    for (let pCf of ceOrderStaticFields(cfg.customStaticFields || [])) {
        let pGrp = ceStaticFieldGroup(pCf);
        // [PROFILE-SHAPE] `kind` added. It was always present on the def and always
        // dropped here, so every consumer had to guess whether an entry was a card-driven
        // slot or a freely-addable facet -- the jsx profile cannot render the slot-first
        // ordering ceOrderStaticFields already guarantees without being told which is which.
        pCustom.push({ id: pCf.id, key: 'custom.' + pCf.id, kind: String((pCf as any).kind || 'facet'), label: pCf.label, instructions: pCf.instructions || '', value: (char.customFieldValues || {})[pCf.id] || '', group: pGrp, groupLabel: ceStaticFieldGroupLabel(pGrp) });
    }

    let pPos = (char as any).position || ({} as CharPosition);
    let pCp = char.chatPersona || {};

    return {
        id: char.id,
        name: char.name,
        isProtagonist: !!char.isProtagonist,
        hasLoreEntry: !!char.lorebookEntryId,
        conceptDump: char.conceptDump || '',
        nicknames: char.nicknames || [],
        species: char.species || '',
        age: char.age || '',
        gender: char.gender || '',
        occupationRole: char.occupationRole || '',
        briefDescription: char.briefDescription || '',
        physicalDescription: char.physicalDescription || '',
        personalityCore: char.personalityCore || '',
        voiceAndMannerisms: char.voiceAndMannerisms || '',
        background: char.background || '',
        coreValues: char.coreValues || [],
        // [IMG-FIELDS] Visual identity + avatar generation settings. Exported so
        // the Profile's Images drill can render them; the bridge's own Visuals tab reads
        // the record directly and is unaffected by their presence here.
        // [PROJECTION-ALLOWLIST] REPORTED LIVE AS "Start a schedule does nothing". The write
        // landed every time -- _ceSchedMut loaded, mutated and saved the record correctly --
        // and THIS PAYLOAD NEVER CARRIED THE FIELD, so ceSchedOf(prof.p) read undefined on
        // every render and the drill re-offered the button it had just honoured.
        // THE LESSON IS THE SHAPE OF THIS FUNCTION. It is an explicit ALLOWLIST, not a spread
        // of the record, which is deliberate (JSXKIT-STORE-SPLIT: a projection ships what the
        // surface draws). The cost of that choice is that ANY NEW CharacterRecord FIELD A
        // SURFACE READS MUST BE ADDED HERE, and forgetting it fails silently and looks
        // exactly like a broken write. Check this payload before debugging a write that
        // "does nothing".
        schedule: (char as any).schedule || null,
        // [PROJECTION-ALLOWLIST] Added here in the SAME patch that adds the field. This is
        // the allowlist that made "Start a schedule" look broken; a surface-read field that
        // is not listed here is invisible and the failure looks like a broken write.
        summonOnMention: (char as any).summonOnMention,
        visuals: char.visuals || '',
        uc: char.uc || '',
        sceneVisuals: char.sceneVisuals || '',
        avatarVisuals: char.avatarVisuals || '',
        avatarWidth: char.avatarWidth || 1024,
        avatarHeight: char.avatarHeight || 1024,
        avatarSeed: char.avatarSeed || 0,
        customFields: pCustom,
        // [POSITION] The tier is deliberately NOT exported. It is volatile evidence
        // about one story path, it lives in historyStorage so Undo owns it, and carrying it
        // into another story would import a conclusion without the beats that earned it.
        position: {
            targetId: pPos.targetId || '',
            targetName: pPos.targetName || '',
            shape: pPos.shape || '',
            standing: pPos.standing || ''
        },
        // [PATTERN-STORED] Always the RESOLVED id (stored if valid, else the legacy
        // scan). The picker edits this one value and does not need to know which source it
        // came from; resolving here is what makes its first write on a legacy record a
        // confirm-or-change rather than a blind guess.
        pattern: _ceResolveCharPattern(char),
        uiShape: _ceResolveShape(char, cfg),
        hook: char.hook || null,   // [HOOK-ONE]
        flags: {
            // [CHAR-ACTIVE] `!== false` rather than truthiness, matching every other
            // reader of this field in the file (cePublishScene, cePublishChat): an absent
            // key on a record written before the field existed means ACTIVE, not archived.
            active: char.active !== false,
            autoThoughtsEnabled: !!char.autoThoughtsEnabled,
            hooksEnabled: !!char.hooksEnabled,
            followCamera: !!(char as any).followCamera,
            // [F-4] Carried as the RAW value, not coerced: the surface has to tell absent
            // (on by default) from an explicit false, and !! collapses exactly that.
            summonOnMention: (char as any).summonOnMention
        },
        // `enabled` is the RESOLVED state, matching buildChatPersonaSection's own `on`
        // expression: record absent OR enabled===false reads as off. There is no third
        // "never configured" state, because applyCharFieldValue creates the object with the
        // same defaults on the first write either way.
        // `preview` is buildCharChatPersonaClause's real return value -- the exact string
        // that reaches the model, from the same call the context builder makes, so the
        // readout cannot drift from what is sent.
        chatPersona: {
            enabled: !!char.chatPersona && (char.chatPersona.enabled !== false),
            style: pCp.style || 'auto',
            verbosity: pCp.verbosity || 'auto',
            emoji: pCp.emoji || 'auto',
            notes: pCp.notes || '',
            preview: buildCharChatPersonaClause(char)
        },
        // The option lists ship rather than being restated in the surface: adding an option
        // to any of the three arrays appears in the picker with no UI change. Only id+label
        // travel -- `clause` and the verbosity `tokens` cap are model-facing.
        chatPersonaOpts: {
            style:     CHARCHAT_STYLE_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; }),
            verbosity: CHARCHAT_VERBOSITY_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; }),
            emoji:     CHARCHAT_EMOJI_OPTS.map(function(o: CharChatOpt) { return { id: o.id, label: o.label }; })
        }
    };
}

// [STUDIO-COMMIT-ATOMIC] Shared field-key router, extracted out of AE_SAVE_CHAR_FIELD
// so AE_STUDIO_COMMIT can apply a whole batch of fields in ONE load->mutate->save cycle
// instead of duplicating this routing logic a second time. Two call sites reading the same
// list here is the whole point -- see the CE-INDEX note on why the old commit flow raced.
// fieldKey routing: direct string fields | coreValues | nicknames | pattern | position.<sub> |
// chatPersona.<sub> | custom.<id> | sheet.<cat>.<fld> | flag.<name>. Returns false for an
// unrecognized key so callers can log it.
function applyCharFieldValue(char: any, key: string, value: any): boolean {
    // [IMG-FIELDS] The four visual-tag fields join the direct list. They are
    // plain strings on the record already (declared since the bridge roster was retired)
    // and have simply never had an engine-side editor -- the bridge's Visuals tab was the
    // only way to reach them. Nothing about the write path is new.
    const CFV_DIRECT: string[] = ['name','conceptDump','species','age','gender','occupationRole','briefDescription','physicalDescription','personalityCore','voiceAndMannerisms','background','visuals','uc','sceneVisuals','avatarVisuals'];
    // [IMG-FIELDS] The three numeric avatar-generation settings. Kept OUT of
    // CFV_DIRECT because that branch stringifies, and width/height/seed must stay numbers:
    // the bridge feeds them straight into buildRequestBody's settings object, where a
    // string silently produces a bad request rather than an error. A blank or unparseable
    // value reads as 0, which is already this record's "unset" for seed and is corrected
    // to a default by makeDefaultCharacter's own guards for the dimensions.
    const CFV_NUM: string[] = ['avatarWidth','avatarHeight','avatarSeed'];
    if (CFV_DIRECT.indexOf(key) >= 0) {
        char[key] = String(value === undefined || value === null ? '' : value);
        return true;
    } else if (CFV_NUM.indexOf(key) >= 0) {
        var cfvN = parseInt(String(value === undefined || value === null ? '' : value).replace(/[^0-9-]/g, ''), 10);
        (char as any)[key] = isNaN(cfvN) ? 0 : Math.max(0, cfvN);
        return true;
    } else if (key === 'pattern') {
        // [PATTERN-STORED] Validated against the same whitelist
        // _ceResolveCharPattern trusts -- an invalid or unknown id is stored as '' (not
        // silently coerced to some other value and not rejected outright), which is
        // "no pattern chosen", the same state a character in progress is already in.
        const pStr = String(value || '');
        (char as any).pattern = (CE_PATTERN_IDS.indexOf(pStr) >= 0) ? pStr : '';
        return true;
    } else if (key === 'uiShape') {
        // [PROFILE-SHAPE] Same whitelist discipline as `pattern`: an unknown
        // value stores as '' ("never chosen"), which falls through to _ceResolveShape's
        // scan rather than pinning the surface to a shape nothing can render.
        const cfvShape = String(value || '');
        (char as any).uiShape = (cfvShape === 'studio' || cfvShape === 'classic') ? cfvShape : '';
        return true;
    } else if (key === 'coreValues') {
        if (Array.isArray(value)) char.coreValues = value.map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        else char.coreValues = String(value || '').split(';').map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        return true;
    } else if (key === 'nicknames') {
        if (Array.isArray(value)) char.nicknames = value.map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        else char.nicknames = String(value || '').split(',').map(function(x: any) { return String(x).trim(); }).filter(Boolean);
        return true;
    } else if (key.indexOf('position.') === 0) {
        // [STUDIO-2] Position routed through the SAME helper as every other field
        // rather than getting a message pair of its own. Both AE_SAVE_CHAR_FIELD and
        // AE_STUDIO_COMMIT already funnel through here, so one route gives the Studio and
        // the Profile tab Position editing at once and keeps the "exactly one write path"
        // property intact -- a second path would have been a second place for the lorebook
        // sync and roster refresh to be forgotten.
        //
        // Unknown sub-keys are REJECTED (return false) rather than written. char.position is
        // a fixed four-field record, not a bag: silently accepting 'position.wharever' would
        // store a field nothing reads and that no migration knows to clean up.
        const cfvPosKey = key.slice(9);
        if (['targetId', 'targetName', 'shape', 'standing'].indexOf(cfvPosKey) < 0) return false;
        if (!char.position) char.position = { targetId: '', targetName: '', shape: '', standing: '' };
        char.position[cfvPosKey] = String(value === undefined || value === null ? '' : value);
        return true;
    } else if (key.indexOf('chatPersona.') === 0) {
        // [PERSONA-BRIDGE] Same shape, and the same reasoning, as the position.*
        // branch above: ONE write path shared by AE_SAVE_CHAR_FIELD and AE_STUDIO_COMMIT,
        // and unknown sub-keys REJECTED rather than stored. chatPersona is a fixed record,
        // not a bag -- accepting 'chatPersona.whatever' would store a field nothing reads
        // and no migration knows to clean up.
        //
        // The object is created with the SAME defaults buildChatPersonaSection’s toggle uses
        // (engine ~19021). If those two default sets are ever allowed to diverge, a persona
        // first enabled from the bridge and one first enabled from the engine modal would
        // behave differently with nothing on screen to explain why. Change them together.
        //
        // The three enum axes are validated through _charchatOpt -- the engine’s OWN
        // resolver, not a copied whitelist that could fall out of step with the arrays.
        // It returns opts[0] on a miss, and opts[0].id is 'auto' in all three lists, so an
        // unrecognised id degrades to "let the rubric decide". That direction matters: a bad
        // id stored RAW would still resolve to opts[0] at read time, but would do it silently
        // on every single turn forever, and the stored record would keep lying about it.
        const cfvCpKey = key.slice(12);
        if (['enabled', 'style', 'verbosity', 'emoji', 'notes'].indexOf(cfvCpKey) < 0) return false;
        if (!char.chatPersona) char.chatPersona = { enabled: true, style: 'auto', verbosity: 'auto', emoji: 'auto' };
        if (cfvCpKey === 'enabled') { char.chatPersona.enabled = !!value; return true; }
        if (cfvCpKey === 'notes') { char.chatPersona.notes = String(value === undefined || value === null ? '' : value); return true; }
        const cfvCpOpts: CharChatOpt[] = cfvCpKey === 'style' ? CHARCHAT_STYLE_OPTS
            : (cfvCpKey === 'verbosity' ? CHARCHAT_VERBOSITY_OPTS : CHARCHAT_EMOJI_OPTS);
        char.chatPersona[cfvCpKey] = _charchatOpt(cfvCpOpts, String(value || 'auto')).id;
        return true;
    } else if (key.indexOf('custom.') === 0) {
        let cfvCfId = key.slice(7);
        if (!char.customFieldValues) char.customFieldValues = {};
        char.customFieldValues[cfvCfId] = String(value === undefined ? '' : value);
        return true;
    } else if (key.indexOf('sheet.') === 0) {
        let cfvRef = key.slice(6);
        let cfvParts = cfvRef.split('.');
        if (cfvParts.length === 2) {
            let cfvDot = cfvParts[0] + '.' + cfvParts[1];
            let cfvUnd = cfvParts[0] + '_' + cfvParts[1];
            if (!char.sheetValues) char.sheetValues = {};
            char.sheetValues[cfvDot] = String(value === undefined ? '' : value);
            char.sheetValues[cfvUnd] = char.sheetValues[cfvDot];
            return true;
        }
        return false;
    } else if (key.indexOf('flag.') === 0) {
        let cfvFlag = key.slice(5);
        let cfvBool = !!value;
        if (cfvFlag === 'autoThoughtsEnabled') char.autoThoughtsEnabled = cfvBool;
        else if (cfvFlag === 'hooksEnabled') char.hooksEnabled = cfvBool;
        else if (cfvFlag === 'followCamera') char.followCamera = cfvBool; // [FOLLOW-CAM]
        else if (cfvFlag === 'summonOnMention') (char as any).summonOnMention = cfvBool; // [F-4]
        // [D-01] NOT WRITTEN ONTO THE RECORD HERE. isProtagonist is a projection of
        // cfg.protagonistCharId and setProtagonist is its only writer -- assigning it here
        // would set a second protagonist without clearing the first, which is the exact
        // state the pointer exists to make unrepresentable. Handled by the caller, which
        // has to await a roster sweep rather than mutate the record in hand.
        // [CHAR-ACTIVE] `active` gates recalculateScenePresence, the dynamic
        // dispatch, _ceSceneLines' roster, buildSceneLorebookActivation and the
        // chat roster. Two writers: this flag and killCharacter.
        else if (cfvFlag === 'active') char.active = cfvBool;
        else return false;
        return true;
    }
    return false;
}

async function handleBridgeMessage(msg: any): Promise<void> {
    try {
        const payload: any = (msg.data && msg.data.payload) ? msg.data.payload : (msg.data || {});
        const event: string = payload.event;

        switch (event) {

            case EVT_HANDSHAKE_ACK:
                isBridgeReady = true;
                aeLog('[AE:bridge] Bridge handshake confirmed.');
                api.v1.ui.toast('🔗 Bridge connected!', { type: 'success', autoClose: 2000 });
                // [CHAT-LANE] A bridge that just connected has no bubble tokens and is
                // painting from its own literal fallbacks. Pushed on EVERY handshake, not
                // just the first: a page reload is the common case, not an edge.
                try { await broadcastChatBubbleStyle(); }
                catch (eCbs) { aeLog('[AE:chatstyle] handshake token push failed:', eCbs); }
                // Story ID scopes the bridge's image gallery. Without it activeStoryId
                // stays empty and every story sees every image.
                try {
                    const hsStoryId = await api.v1.story.id();
                    await broadcastToTM(EVT_STORY_ID_SYNC, { storyId: hsStoryId });
                } catch (_) {}
                break;

            // [CHARCHAT-HUD] ONE dispatcher for every chat verb, per the bridge's
            // own CE-INDEX convention ("add new verbs as new 'op' values, not new
            // sendToEngine event names, unless the payload shape genuinely differs") —
            // the same shape AE_JOURNAL_ACTION already uses.
            //   op:'stage'   { text }        append a POV turn and STOP — the
            //                                user's own tap on NAI's native Send is what
            //                                generates. This is what the bridge sends;
            //                                see CHARCHAT-NATIVE-SEND in the CE-INDEX.
            //   op:'send'    { text }        append a POV turn, then generate (native
            //                                path only — budget-capped from a postMessage)
            //   op:'nudge'   {}              generate with no new message
            //   op:'regen'   {}              drop the last contact turn, generate again
            //   op:'edit'    { ids, text }   rewrite a turn in place
            //   op:'remove'  { ids }         delete a turn
            case 'AE_CHARCHAT_ACTION': {
                try { await handleCharChatAction(payload || {}); }
                catch (e) { aeLog('[AE:bridge] AE_CHARCHAT_ACTION error:', e); }
                break;
            }

            case 'AE_DIAG_CMD': {
                try {
                    const dcRaw: string = String((payload && payload.cmd) || '').trim();
                    const dcLower = dcRaw.toLowerCase();
                    let dcOut = await aeHandleDiagCommand(dcRaw, dcLower);
                    if (dcOut === null) dcOut = 'Not a recognized command: "' + dcRaw + '". Try /ce status, /log list or /diag list.';
                    await broadcastToTM(EVT_DIAG_REPLY, { cmd: dcRaw, out: dcOut });
                } catch (eDc) {
                    aeLog('[AE:bridge] AE_DIAG_CMD error:', eDc);
                    try { await broadcastToTM(EVT_DIAG_REPLY, { cmd: (payload && payload.cmd) || '', out: 'Command failed \u2014 see engine console.' }); } catch (eDc2) {}
                }
                break;
            }

            case 'AE_STORY_IMG_DROP': {
                try { await ceStoryImgDrop(String((payload && payload.uuid) || '')); }
                catch (eSiD) { aeLog('[AE:storyimg] drop failed:', eSiD); }
                break;
            }

            case 'AE_GALLERY_INDEX_RESP':
                // [CEGAL] The bridge's answer to AE_GALLERY_INDEX_REQ. Metadata
                // only, newest-first already (sorted bridge-side, where the ts field lives).
                await ceGalleryReceive(payload);
                break;

            // [IMG-EDIT-SURFACE] The three legs of SECTION 35b that cross the
            // boundary. AE_IMG_EDIT_OPEN is the only one that ORIGINATES bridge-side: a
            // card corner in the story or the chat asks this file to open the surface,
            // because navigation is a value in ceUiStore and nothing over there can set it.
            case 'AE_IMG_EDIT_OPEN': {
                try { await ceImgEditOpen(String((payload && payload.uuid) || '')); }
                catch (eIeO) { api.v1.error('[AE:imgedit] open failed:', eIeO); }
                break;
            }

            // [v3.0.54 PHOTO-PROV] The return leg of AE_CHAR_IMAGE_ACTION op 'meta' --
            // one portrait record's stored generation settings, for the full-screen viewer.
            // A NEW NAME RATHER THAN A NEW OP because this travels the other way and the
            // protocol note's "prefer an op" rule is about the outbound message; the reply
            // needs somewhere to land. Answered even on a miss, so the surface can say so.
            case 'AE_CHAR_IMAGE_META': {
                try { cePhotoMetaReceive(payload); }
                catch (eCiM) { api.v1.error('[AE:photo] meta receive failed:', eCiM); }
                break;
            }

            // [IMG-UPLOAD] The bridge finished writing an uploaded image to a slot.
            // IT IS NOT ENOUGH THAT THE BRIDGE REPAINTS ITS OWN ANCHORS. _ceSurfImgSweep
            // refreshes an anchor that is ALREADY ON SCREEN; whether a card draws an
            // anchor at all is an engine decision, made from cePublishImgSlots' `has`
            // projection and from ceEntityStore. A slot that was empty when the surface
            // rendered has no anchor to sweep, so without this the first upload into an
            // empty slot lands in storage and shows nothing until the author navigates
            // away and back.
            //
            // Republished UNCONDITIONALLY rather than routed by which surface is open:
            // both publishes are cheap projections, the id may be a character or an
            // entity and this message does not say which, and guessing wrong is a blank
            // frame over a file that exists. Both are no-ops when the id is not theirs.
            case 'AE_CHAR_IMAGE_UPLOADED': {
                var upId = String((payload && payload.charId) || '');
                if (upId) {
                    try { await cePublishImgSlots(upId); } catch (eUp1) {}
                    try { await cePublishEntity(upId); } catch (eUp2) {}
                    try { await cePublishScene(); } catch (eUp3) {}
                }
                break;
            }

            case 'AE_IMG_META_RESP':
                ceImgEditReceive(payload);
                break;

            case 'AE_IMG_REGEN_DONE':
                ceImgEditRegenDone(payload);
                break;

            case 'AE_SET_PLAYER_FLAVOR': {
                // [E5] Bridge sends player flavor before firing an action.
                // Empty string clears any pending flavor.
                try {
                    let flavorTxt = String(payload.text || '').trim();
                    if (flavorTxt) {
                        await api.v1.tempStorage.set(STORAGE_PENDING_FLAVOR, flavorTxt).catch(function(_e: any) {});
                    } else {
                        await api.v1.tempStorage.remove(STORAGE_PENDING_FLAVOR).catch(function(_e: any) {});
                    }
                } catch (e) { aeLog('[AE:bridge] AE_SET_PLAYER_FLAVOR error:', e); }
                break;
            }

            // [CE-STRIP v2.0.x] AE_HOLDING_REQ / AE_HOLDING_ACTION removed — Holding cut.

            default:
                aeLog('[AE:bridge] Unhandled bridge message, event:', event, payload);
        }
    } catch (e) {
        aeLog('[AE:bridge] handleBridgeMessage error:', e);
    }
}


// ============================================================================
// SECTION 18b — LOREBOOK WORLD-PACK  [earlier]
// packConfigToLorebook(): serialises the full AE world into a single hidden,
// disabled lorebook entry (AE_LOREBOOK_PACK_NAME). The entry travels with the
// story's .scenario export, so any user who imports the scenario gets the
// world pre-configured. The entry is NEVER injected into context (enabled:false,
// no keys, forceActivation:false). It can be re-packed at any time; the engine
// finds the existing entry by displayName and updates it in place.
//
// loadConfigFromLorebook(): called from onScriptsLoaded. If the sentinel entry
// exists AND storyStorage has no config yet (fresh story from scenario), imports
// the full world automatically and logs a summary. Non-destructive — existing
// stories are never overwritten.
// ============================================================================

async function packConfigToLorebook(): Promise<void> {
    aeLog('[AE:pack] Packing world config to lorebook...');
    try {
        // -- Gather storyStorage data -----------------------------------------
        const pkCfg   = await api.v1.storyStorage.get(STORAGE_CONFIG);
        const pkIdx   = await api.v1.storyStorage.getOrDefault(STORAGE_INDEX, []) as CharacterMeta[];
        const pkEntIdx = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_INDEX, []) as EntityMeta[];
        const pkParty  = await api.v1.storyStorage.getOrDefault(STORAGE_PARTY, null);
        const pkWebRaw = await api.v1.storyStorage.get(STORAGE_NPC_WEB) as string | undefined;
        const pkQI     = await api.v1.storyStorage.getOrDefault('ae_quick_instances', []);
        const pkWizRaw = await api.v1.storyStorage.getOrDefault(STORAGE_WIZ_CHATS, '[]') as string;

        // -- Characters (sequential load) -------------------------------------
        let pkCharRecs: Record<string, any> = {};
        for (const pkCm of pkIdx) {
            try {
                const pkCh = await api.v1.storyStorage.get(STORAGE_CHAR_PFX + pkCm.id);
                if (pkCh) pkCharRecs[pkCm.id] = pkCh;
            } catch (eChPk) { aeLog('[AE:pack] char load skip:', pkCm.id, eChPk); }
        }

        // -- Entities (sequential load) ---------------------------------------
        let pkEntRecs: Record<string, any> = {};
        for (const pkEm of pkEntIdx) {
            try {
                const pkEnt = await api.v1.storyStorage.getOrDefault(STORAGE_ENTITY_PFX + pkEm.id, null);
                if (pkEnt) pkEntRecs[pkEm.id] = pkEnt;
            } catch (eEntPk) { aeLog('[AE:pack] entity load skip:', pkEm.id, eEntPk); }
        }

        // -- Image settings (in-memory, from global api.v1.storage) ----------
        // imagePromptFields/globalSettings are module-level; re-read to be safe.
        const pkImgFields = await api.v1.storage.get(STORAGE_KEY_PROMPT_FIELDS);
        const pkImgGlob   = await api.v1.storage.get(STORAGE_KEY_GLOBAL);

        // -- Assemble package -------------------------------------------------
        const pkPayload = JSON.stringify({
            v:            1,
            aeVersion:    '0.9.7.9',
            packedAt:     Date.now(),
            config:       pkCfg     || null,
            charIndex:    pkIdx,
            charRecords:  pkCharRecs,
            entIndex:     pkEntIdx,
            entRecords:   pkEntRecs,
            party:        pkParty   || null,
            npcWeb:       pkWebRaw  || null,
            quickInstances: pkQI,
            wizChats:     pkWizRaw,
            imageFields:  pkImgFields || null,
            imageGlobal:  pkImgGlob   || null
        });

        const pkBytes = pkPayload.length; // character count; JSON is mostly ASCII so ~= bytes
        aeLog('[AE:pack] Payload size:', pkBytes, 'bytes;', pkIdx.length, 'chars,', pkEntIdx.length, 'entities.');

        // -- Find existing sentinel entry or create new -----------------------
        let pkExisting: any = null;
        try {
            const pkAllEntries = await api.v1.lorebook.entries();
            pkExisting = pkAllEntries.find(function(pkE: any) { return pkE.displayName === AE_LOREBOOK_PACK_NAME; });
        } catch (eEntries) { aeLog('[AE:pack] entries() error:', eEntries); }

        if (pkExisting) {
            await api.v1.lorebook.updateEntry(pkExisting.id, { text: pkPayload });
            aeLog('[AE:pack] Updated existing lorebook entry id:', pkExisting.id);
        } else {
            const pkNewId = api.v1.uuid();
            await api.v1.lorebook.createEntry({
                id:              pkNewId,
                displayName:     AE_LOREBOOK_PACK_NAME,
                text:            pkPayload,
                keys:            [],
                enabled:         false,
                hidden:          true,
                forceActivation: false
            });
            aeLog('[AE:pack] Created new lorebook entry id:', pkNewId);
        }
        api.v1.ui.toast('World packed to lorebook (' + Math.round(pkBytes / 1024) + ' KB). Export scenario to share.', { type: 'success', autoClose: 4000 });
    } catch (ePack) {
        api.v1.error('[AE:pack] packConfigToLorebook error:', ePack);
        api.v1.ui.toast('Pack failed - see engine log.', { type: 'error', autoClose: 3000 });
    }
}

// Returns true if config was imported, false if skipped (entry missing or
// config already present). Called from onScriptsLoaded.
// Pass forced=true to import even when storyStorage already has a config.
async function loadConfigFromLorebook(forced?: boolean): Promise<boolean> {
    try {
        // -- Find sentinel entry ----------------------------------------------
        let lcEntry: any = null;
        try {
            const lcAll = await api.v1.lorebook.entries();
            lcEntry = lcAll.find(function(lcE: any) { return lcE.displayName === AE_LOREBOOK_PACK_NAME; });
        } catch (eLcList) { aeLog('[AE:pack] loadConfigFromLorebook entries() error:', eLcList); return false; }
        if (!lcEntry || !lcEntry.text) return false;

        // -- Only import if storyStorage has no config yet (fresh scenario) ---
        const lcExistingCfg = await api.v1.storyStorage.get(STORAGE_CONFIG);
        if (!forced && lcExistingCfg !== null && lcExistingCfg !== undefined) {
            aeLog('[AE:pack] Lorebook pack found but storyStorage already has config; skipping auto-import.');
            return false;
        }

        // -- Parse ------------------------------------------------------------
        let lcData: any;
        try { lcData = JSON.parse(lcEntry.text); }
        catch (eLcParse) { api.v1.error('[AE:pack] loadConfigFromLorebook: JSON parse failed:', eLcParse); return false; }

        aeLog('[AE:pack] Importing from lorebook pack v' + (lcData.v || '?') + ' packed at', lcData.packedAt, 'aeVersion', lcData.aeVersion);

        // -- Restore storyStorage: config -------------------------------------
        if (lcData.config) await api.v1.storyStorage.set(STORAGE_CONFIG, lcData.config);

        // -- Restore storyStorage: character index + records ------------------
        if (Array.isArray(lcData.charIndex) && lcData.charIndex.length > 0) {
            await api.v1.storyStorage.set(STORAGE_INDEX, lcData.charIndex);
            let lcCharCount = 0;
            const lcCharRecs = lcData.charRecords || {};
            for (const lcCharId in lcCharRecs) {
                try { await api.v1.storyStorage.set(STORAGE_CHAR_PFX + lcCharId, lcCharRecs[lcCharId]); lcCharCount++; }
                catch (eLcChar) { aeLog('[AE:pack] char restore skip:', lcCharId, eLcChar); }
            }
            aeLog('[AE:pack] Restored', lcCharCount, 'character records.');
        }

        // -- Restore storyStorage: entity index + records ---------------------
        if (Array.isArray(lcData.entIndex) && lcData.entIndex.length > 0) {
            await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, lcData.entIndex);
            let lcEntCount = 0;
            const lcEntRecs = lcData.entRecords || {};
            for (const lcEntId in lcEntRecs) {
                try { await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + lcEntId, lcEntRecs[lcEntId]); lcEntCount++; }
                catch (eLcEnt) { aeLog('[AE:pack] entity restore skip:', lcEntId, eLcEnt); }
            }
            aeLog('[AE:pack] Restored', lcEntCount, 'entity records.');
        }

        // -- Restore storyStorage: ancillary data -----------------------------
        if (lcData.party)          await api.v1.storyStorage.set(STORAGE_PARTY,         lcData.party);
        if (lcData.npcWeb)         await api.v1.storyStorage.set(STORAGE_NPC_WEB,        lcData.npcWeb);
        if (lcData.quickInstances) await api.v1.storyStorage.set('ae_quick_instances',   lcData.quickInstances);
        if (lcData.wizChats)       await api.v1.storyStorage.set(STORAGE_WIZ_CHATS,      lcData.wizChats);

        // -- Restore global api.v1.storage: image settings -------------------
        if (lcData.imageFields) await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, lcData.imageFields);
        if (lcData.imageGlobal) await api.v1.storage.set(STORAGE_KEY_GLOBAL,        lcData.imageGlobal);

        const lcCharLen  = Object.keys(lcData.charRecords || {}).length;
        const lcEntLen   = Object.keys(lcData.entRecords  || {}).length;
        aeLog('[AE:pack] Import complete:', lcCharLen, 'chars,', lcEntLen, 'entities.');
        api.v1.ui.toast('World imported from lorebook pack (' + lcCharLen + ' chars, ' + lcEntLen + ' locations). Reload to activate.', { type: 'success', autoClose: 5000 });
        return true;
    } catch (eLcMain) {
        api.v1.error('[AE:pack] loadConfigFromLorebook error:', eLcMain);
        return false;
    }
}

// Takes already-parsed lorebook pack data (packConfigToLorebook format: charIndex/
// charRecords/entIndex/entRecords) and restores the full world into storyStorage
// and api.v1.storage. 
// Distinct from importPayload(), which handles the plain-JSON export format.
async function importFromLorebookPack(data: any): Promise<void> {
    if (data.config) await api.v1.storyStorage.set(STORAGE_CONFIG, data.config);

    if (Array.isArray(data.charIndex) && data.charIndex.length > 0) {
        await api.v1.storyStorage.set(STORAGE_INDEX, data.charIndex);
        let ifpCharRecs = data.charRecords || {};
        for (let ifpCId in ifpCharRecs) {
            try { await api.v1.storyStorage.set(STORAGE_CHAR_PFX + ifpCId, ifpCharRecs[ifpCId]); } catch (eIfpC) {}
        }
    }

    if (Array.isArray(data.entIndex) && data.entIndex.length > 0) {
        await api.v1.storyStorage.set(STORAGE_ENTITY_INDEX, data.entIndex);
        let ifpEntRecs = data.entRecords || {};
        for (let ifpEId in ifpEntRecs) {
            try { await api.v1.storyStorage.set(STORAGE_ENTITY_PFX + ifpEId, ifpEntRecs[ifpEId]); } catch (eIfpE) {}
        }
    }

    if (data.party)          await api.v1.storyStorage.set(STORAGE_PARTY,         data.party);
    if (data.npcWeb)         await api.v1.storyStorage.set(STORAGE_NPC_WEB,        data.npcWeb);
    if (data.quickInstances) await api.v1.storyStorage.set('ae_quick_instances',   data.quickInstances);
    if (data.wizChats)       await api.v1.storyStorage.set(STORAGE_WIZ_CHATS,      data.wizChats);

    if (data.imageFields) await api.v1.storage.set(STORAGE_KEY_PROMPT_FIELDS, data.imageFields);
    if (data.imageGlobal) await api.v1.storage.set(STORAGE_KEY_GLOBAL,        data.imageGlobal);
}

// Scans all lorebook entries for AE world packs (any entry whose text parses to
// JSON containing an aeVersion field), presents a modal picker, and calls
// importFromLorebookPack on the selected entry. Entry-point for the Import button
// in Settings → Adventure Module Management and the Characters tab header.
async function pickAndImportFromLorebook(): Promise<void> {
    let pklPacks: { entry: any; data: any }[] = [];
    try {
        let pklAll = await api.v1.lorebook.entries();
        for (let pklE of pklAll) {
            if (!pklE.text) continue;
            try {
                let pklD = JSON.parse(pklE.text);
                if (pklD && pklD.aeVersion) pklPacks.push({ entry: pklE, data: pklD });
            } catch (ePklParse) {}
        }
    } catch (ePklScan) {
        api.v1.ui.toast('Failed to scan lorebook entries.', { type: 'error' });
        return;
    }

    if (pklPacks.length === 0) {
        api.v1.ui.toast('No AE world packs found in the lorebook. Use "Pack to Lorebook" first.', { type: 'warning', autoClose: 4000 });
        return;
    }

    let pklContent: any[] = [
        { type: 'text', text: 'Select a world pack to import. This will overwrite the current world data.', style: { marginBottom: '14px', fontSize: '12px', lineHeight: '1.5' } }
    ];
    let pklModal: any;

    for (let pklI = 0; pklI < pklPacks.length; pklI++) {
        (function(pklEnt: any, pklDat: any) {
            let pklCC  = Object.keys(pklDat.charRecords || {}).length;
            let pklEC  = Object.keys(pklDat.entRecords  || {}).length;
            let pklLbl = (pklEnt.displayName || '[AE World]') + ' — ' + pklCC + ' chars, ' + pklEC + ' locations';
            pklContent.push({
                type: 'button',
                text: '📥 Import: ' + pklLbl,
                style: { width: '100%', marginBottom: '8px', backgroundColor: 'rgba(136,204,255,0.15)', border: '1px solid rgba(136,204,255,0.4)', color: '#88ccff', fontWeight: 'bold' },
                disabledWhileCallbackRunning: true,
                callback: async function() {
                    try {
                        await importFromLorebookPack(pklDat);
                        if (pklModal) pklModal.close();
                        api.v1.ui.toast('World imported. Reload the sidebar to activate.', { type: 'success', autoClose: 4000 });
                    } catch (ePklImp) {
                        api.v1.error('[AE] pickAndImportFromLorebook import failed:', ePklImp);
                        api.v1.ui.toast('Import failed — see engine log.', { type: 'error' });
                    }
                }
            });
        })(pklPacks[pklI].entry, pklPacks[pklI].data);
    }

    pklContent.push({ type: 'button', text: 'Cancel', style: { width: '100%', marginTop: '8px' }, callback: function() { if (pklModal) pklModal.close(); } });
    pklModal = await openEngineModal({ id: 'ae-pick-import', title: '📥 Import from Lorebook', size: 'small', content: pklContent });
}

// ============================================================================
// SECTION 19 — SCENE PRESENCE, LOCATION & EQUIP HELPERS
// [CE-STRIP earlier] Was ACTION EXECUTION ENGINE. The AERule/ActionInstance effects
// engine (aeApplyEffects/aeCheckConditions/runActionInstance/runQuickInstance/
// aeRollResolution/aePickTarget/aeBindStakeDef/evaluateFieldCondition/etc — ~40
// functions, the AERule/ActionInstance/AEScope/AEResolution/ActionBranch/
// AEOutcomeBand/AEResOutcome interfaces, and the Travel executors executeTravelTo/
// findTravelPath/findVehicleAncestor/executeVehicleTravel/executeDestinationTravel)
// is fully removed — every remaining external call site was traced and fixed or
// confirmed unreachable (grep "CE-STRIP earlier" across the file for each one).
// What's left is genuinely still needed: scene presence, location resolution,
// item equip, the equip/faction-resource read-write helpers still used from Holding,
// Schedule's NPC positioning, and commitTravel (still used for World-Build Wizard
// intro placement and the native Map's Teleport button — NOT reachable from any
// player-facing travel/action UI any more).
// ============================================================================


function composeActionPrompt(base: string, flavor: string): string {
    let b = base.trim();
    let f = flavor.trim();
    if (!f) return b;
    if (!b) { return f.charAt(0).toUpperCase() + f.slice(1); }
    let flavorComplete = /[.!?]$/.test(f);
    if (flavorComplete) { return b + ' ' + f; }
    let stripped = b.replace(/[.!?]\s*$/, '');
    return stripped + ', ' + f + '.';
}

async function aeSetEquip(itemEnt: EntityRecord | null, charRec: CharacterRecord | null, equip: boolean): Promise<void> {
    if (!itemEnt) return;
    let freshItem = await loadEntity(itemEnt.id);
    if (!freshItem) return;
    freshItem.isEquipped = equip;
    freshItem.equippedToCharId = (equip && charRec) ? charRec.id : undefined;
    await saveEntity(freshItem);
    if (charRec) {
        let freshChar = await loadCharacter(charRec.id);
        if (freshChar) {
            if (!freshChar.equippedItemIds) freshChar.equippedItemIds = [];
            if (equip) { if (freshChar.equippedItemIds.indexOf(freshItem.id) < 0) freshChar.equippedItemIds.push(freshItem.id); }
            else { freshChar.equippedItemIds = freshChar.equippedItemIds.filter(function(id) { return id !== freshItem.id; }); }
            await saveCharacter(freshChar);
            // [earlier] No lorebook re-sync — equipment now rides an ephemeral temp entry.
        }
    }
}

// [ROOT-LOCATION] Sentinel id for "the top of the entity
// graph" — every character's body starts here (parentId: null, see
// createWizardCharacter/spawnSceneNpc) and stays here until something moves it to a
// real location. Ungrouped and grouped-by-nothing used to mean the same thing as
// "unresolvable" (null), which is why a story with characters but NO location
// entities ever computed scene presence at all (loadProtagonistLocation had nothing to
// fall back to but null, and recalculateScenePresence bails out entirely on a null
// camera room — see both below). Treating root as a real, comparable id instead of a
// dead end fixes that: a world with no locations now has exactly one implicit place,
// and every unplaced character is correctly co-located there together. Deliberately
// NOT a real entity — nothing should ever loadEntity() this id, which is also why it
// is namespaced away from api.v1.uuid()'s format rather than risking a collision.
var AE_ROOT_LOCATION_ID = '__ce_root__';

async function loadProtagonistLocation(): Promise<string | null> {
    // [CE-STRIP vNEXT] The "camera" — what the HUD/context treats as the current
    // scene — is now independent of any character. STORAGE_PROTAGONIST_LOC (declared long
    // ago but never actually written until now) is the single source of truth, set by
    // commitTravel/AE_SILENT_TELEPORT (the Map's Teleport action = "select a location").
    // Falls back to a protagonist's physical room if one exists and no camera has been
    // set yet (back-compat for worlds still using a protagonist), then to the first
    // location in the world so a fresh/no-protagonist world isn't permanently stuck on
    // "No scene state available." Each fallback persists into STORAGE_PROTAGONIST_LOC so it
    // stays stable once resolved, rather than re-deriving every call.
    // [ROOT-LOCATION] FINAL fallback below no longer returns null when there is
    // no location entity anywhere in the world — it returns AE_ROOT_LOCATION_ID, also
    // persisted, so this function can no longer return null at all. commitTravel still
    // overwrites STORAGE_PROTAGONIST_LOC unconditionally the moment a real location exists
    // and gets selected, so this is a one-time bootstrap, not a permanent ceiling.
    const camLoc = await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, null) as string | null;
    if (camLoc === AE_ROOT_LOCATION_ID) return AE_ROOT_LOCATION_ID;
    if (camLoc) {
        const camEnt = await loadEntity(camLoc);
        if (camEnt) return camLoc;
        // Stale pointer (location was deleted) — fall through and re-resolve.
    }

    const idx = await loadIndex();
    const pMeta = idx.find(function(m) { return !!m.isProtagonist; });
    if (pMeta) {
        const protag = await loadCharacter(pMeta.id);
        if (protag && protag.entityId) {
            const protagBody = await loadEntity(protag.entityId);
            if (protagBody && protagBody.parentId) {
                await api.v1.storyStorage.set(STORAGE_PROTAGONIST_LOC, protagBody.parentId);
                return protagBody.parentId;
            }
        }
    }

    const allNodes = await loadEntityIndex();
    const firstLoc = allNodes.find(function(n) { return n.type === 'location'; });
    if (firstLoc) {
        await api.v1.storyStorage.set(STORAGE_PROTAGONIST_LOC, firstLoc.id);
        return firstLoc.id;
    }
    await api.v1.storyStorage.set(STORAGE_PROTAGONIST_LOC, AE_ROOT_LOCATION_ID);
    return AE_ROOT_LOCATION_ID;
}

function getEffectiveRoomId(entityId: string, allNodes: EntityMeta[]): string | null {
    // Walks up the entity tree until a 'location' node is found.
    // Preserved verbatim from AE source, EXCEPT the final line — [ROOT-LOCATION]
    // walking all the way to the top (parentId chain ends in null) with no 'location'
    // ancestor used to return null here, indistinguishable from "entityId doesn't exist
    // at all." Now returns AE_ROOT_LOCATION_ID instead, a real comparable id meaning
    // "this body sits at the top of the graph, ungrouped" — see that constant's own
    // comment for why this matters (recalculateScenePresence's camRoom comparison).
    // A genuinely missing node (!node) still returns null — that is a real error case
    // (a deleted/dangling entityId), not "unplaced," and stays distinguishable from it.
    if (!entityId) return null;
    let currentId: string | null = entityId;
    let sanity = 0;
    while (currentId && sanity < 10) {
        const node = allNodes.find(function(n) { return n.id === currentId; });
        if (!node) return null;
        if (node.type === 'location') return node.id;
        currentId = node.parentId || null;
        sanity++;
    }
    return currentId === null ? AE_ROOT_LOCATION_ID : currentId;
}

async function aeGetProtagonistRoomId(): Promise<string | null> {
    // [CE-STRIP vNEXT] Delegates to loadProtagonistLocation() — the camera already resolves
    // to a location-type node (walking up from a protagonist's body if needed), so a
    // separate walk here is redundant now that "current room" means "camera location"
    // rather than "wherever the protagonist's body specifically sits."
    try {
        return await loadProtagonistLocation();
    } catch (e) { aeLog('[AE] aeGetProtagonistRoomId:', e); return null; }
}

async function aeSetCharScenePresent(charId: string, present: boolean): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c) return;
        c.scenePresent = !!present;
        await saveCharacter(c);
    } catch (e) { aeLog('[AE] aeSetCharScenePresent:', e); }
}

async function aeMoveCharToScene(charId: string): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c || !c.entityId) return;
        const room = await aeGetProtagonistRoomId();   // co-locate in the player's actual room
        const body = await loadEntity(c.entityId);
        if (body) { body.parentId = room; await saveEntity(body); }
        await saveCharacter(c);
        await recalculateScenePresence();
    } catch (e) { aeLog('[AE] aeMoveCharToScene:', e); }
}

// [PHASE-G] THE MIRROR OF aeMoveCharToScene, AND IT HAD TO BE WRITTEN.
// The verification pass for this phase found aeSetCharScenePresent already sitting right
// above -- and it is NOT the exclude verb, despite looking exactly like one.
// WHY: scenePresent IS A DERIVED FLAG, NOT A STORED INTENT. recalculateScenePresence
// recomputes it for every active character from body-vs-camera co-location and has ten
// call sites, including the generation path. Setting the flag to false while the body is
// still standing in the room means the next recalculation flips it back, so an "exclude"
// built on aeSetCharScenePresent would appear to work and then silently undo itself the
// next time the story generated. That is the worst failure shape available here.
// SO EXCLUDE MOVES THE BODY, exactly the way Add does. Detaching the body from every room
// (parentId = null) makes getEffectiveRoomId return null, which makes shouldBePresent
// false on every future recalculation -- the state survives because it is expressed in the
// same terms presence is DERIVED from. This is the "No Location" path the retired bridge
// inspection view already used; it is not a new concept, only a new door to it.
// NOTE THE ASYMMETRY THAT REMAINS: Add puts them in the camera's room, Exclude puts them
// nowhere rather than in the room they came from. There is no stored "previous location"
// to restore, and inventing one would be a second source of truth about where a body is.
async function aeRemoveCharFromScene(charId: string): Promise<void> {
    try {
        const c = await loadCharacter(charId);
        if (!c || !c.entityId) return;
        const body = await loadEntity(c.entityId);
        if (body) { body.parentId = null; await saveEntity(body); }
        await saveCharacter(c);
        await recalculateScenePresence();
    } catch (e) { aeLog('[AE] aeRemoveCharFromScene:', e); }
}

async function aeRefreshPresence(): Promise<void> {
    try {
        await recalculateScenePresence();
    } catch (e) { aeLog('[AE] aeRefreshPresence:', e); }
}

async function recalculateScenePresence(): Promise<void> {
    // [CE-STRIP vNEXT] Updates scenePresent for all active characters based on
    // co-location with the CAMERA location (loadProtagonistLocation()) instead of the
    // protagonist's body. Previously this returned immediately if no protagonist
    // existed, so presence was never computed at all without one — root cause of
    // "No scene state available." A protagonist, if one exists, is now just another
    // character for presence purposes: present if co-located, absent otherwise, no
    // longer the anchor everyone else is measured against.
    try {
        // [ROOT-LOCATION] loadProtagonistLocation can no longer return null (its
        // final fallback is now AE_ROOT_LOCATION_ID, not null — see both of their own
        // comments), so this guard is believed unreachable now. Left in place as
        // defense-in-depth rather than removed — a null here would mean something
        // deeper broke, and silently proceeding with a null camRoom would make every
        // cRoom === camRoom comparison below false in a way that would look identical
        // to "nobody's present," not "something's wrong."
        const camRoom = await loadProtagonistLocation();
        if (!camRoom) return;

        const allChars = await loadAllCharacters();
        const freshEntIdx = await loadEntityIndex();
        for (const c of allChars) {
            if (!c.active) continue;
            if (!c.entityId) {
                // No body in the world graph — cannot be co-located with anyone.
                if (c.scenePresent) { c.scenePresent = false; await saveCharacter(c); }
                continue;
            }
            const cRoom = getEffectiveRoomId(c.entityId, freshEntIdx);
            const shouldBePresent = (cRoom !== null) && (cRoom === camRoom);
            if (c.scenePresent !== shouldBePresent) {
                c.scenePresent = shouldBePresent;
                await saveCharacter(c);
            }
        }
        // [CASTLORE] THE CHOKE POINT. Presence is what decides who belongs on the
        // Dramatis Personae entry (it lists the cast who are NOT present), so this is the
        // one function that always runs when that answer can have changed -- ten call
        // sites including travel, add/remove, the profile's own location verb and the tail
        // of every dynamic pass. Queued rather than awaited: the caller is often mid-verb
        // and a lorebook round trip is not something a body-move should wait on. The sync
        // dirty-checks, so the common case of "presence recomputed, nothing moved" costs
        // one string compare and no write.
        queueCastLoreSync('cast');
    } catch (e) {
        aeLog('[AE] recalculateScenePresence error:', e);
    }
}


async function commitTravel(targetId: string, isSilent: boolean): Promise<void> {
    try {
        const ctTarget = await loadEntity(targetId);
        if (!ctTarget) return;
        aeLog('[AE:TRACE] commitTravel ENTER target=' + ctTarget.name + '(' + targetId + ') isSilent=' + isSilent + ' ae_lock=' + ae_lock);
        const ctIsSpatial = ctTarget.type === 'location';
        await api.v1.tempStorage.set(STORAGE_LAST_TRAVEL, Date.now());

        // [CE-STRIP vNEXT] Camera: set unconditionally, no protagonist required — this
        // IS the "select a location from the Map" action. Previously the whole function
        // bailed out here if no protagonist existed.
        if (ctIsSpatial) { await api.v1.storyStorage.set(STORAGE_PROTAGONIST_LOC, targetId); }

        const ctChars  = await loadAllCharacters();
        const ctProtag = ctChars.find(function(c) { return c.isProtagonist; });
        if (ctProtag && ctProtag.entityId) {
            // Move body
            if (ctIsSpatial) {
                const ctBody = await loadEntity(ctProtag.entityId);
                if (ctBody && ctBody.id !== targetId) { aeLog('[AE:TRACE] commitTravel body move ' + ctBody.parentId + ' -> ' + targetId); ctBody.parentId = targetId; await saveEntity(ctBody); }
                else { aeLog('[AE:TRACE] commitTravel body NOT moved (ctBody=' + (ctBody ? ctBody.id : 'null') + ' target=' + targetId + ')'); }
            }

            // Legacy per-character camera field — kept in sync for any code still
            // reading it, but STORAGE_PROTAGONIST_LOC above is the actual source of truth now.
            const ctFreshProtag = await loadCharacter(ctProtag.id);
            if (ctFreshProtag) { ctFreshProtag.currentLocationId = targetId; await saveCharacter(ctFreshProtag); }
        }

        // [FOLLOW-CAM] Generalises the protagonist body-move above to any
        // character flagged followCamera. Placement ONLY: scenePresent is still derived
        // by recalculateScenePresence below (camera-anchored since CE-STRIP vNEXT), so
        // this writes a body position and lets the existing presence pass draw its own
        // conclusion rather than asserting presence directly. Skips the protagonist (the
        // block above already moved that body) and anyone with no body to move. Reuses
        // ctChars — already loaded — so the common case of zero followers costs one
        // in-memory filter and no storage reads.
        if (ctIsSpatial) {
            for (const fcChar of ctChars) {
                if (!fcChar.active || !(fcChar as any).followCamera || !fcChar.entityId) continue;
                if (ctProtag && fcChar.id === ctProtag.id) continue;
                try {
                    const fcBody = await loadEntity(fcChar.entityId);
                    if (fcBody && fcBody.id !== targetId && fcBody.parentId !== targetId) {
                        aeLog('[AE:TRACE] followCamera move ' + fcChar.name + ' ' + fcBody.parentId + ' -> ' + targetId);
                        fcBody.parentId = targetId;
                        await saveEntity(fcBody);
                    }
                } catch (eFc) { aeLog('[AE] followCamera move failed for ' + fcChar.name + ':', eFc); }
            }
        }

        // Pre-generation auto-triggers
        if (ctIsSpatial) { await runAutoTriggers(); }

        // [earlier] Position offstage NPCs per their hourly schedule for the current
        // hour before computing who is scene-present at the destination.
        // [CE-STRIP v2.0.x] resolveSchedules() call removed — Schedule cut.

        // Scene presence — camera-anchored (recalculateScenePresence), no longer a
        // protagonist-room loop duplicated inline here.
        if (ctIsSpatial) { await recalculateScenePresence(); }

        // History
        const ctHist = await loadEntityHistory();
        ctHist.unshift(targetId);
        await saveEntityHistory(ctHist);

        // [CE-SWEEP] Quest arrival check removed. Walking into a tracked
        // narrative's target location cleared the flag and fired a '🎯 Reached:' toast --
        // an objective-completion trigger, which is the game-mechanics half of the
        // narrative tree rather than the storytelling half.

        // [E4] Encounter roll removed from commitTravel


        if (!isSilent) {
            // [DEFER1] Do NOT generate inline. move_player_to_self can sit in the
            // MIDDLE of an effects list (e.g. before inject_narrative); generating here
            // blocks the editor so any later inject_narrative/inject_message throws
            // 'editor is currently blocked' and the narrative never lands. Set a pending
            // flag; the top-level handler generates ONCE after every effect completes.
            aeLog('[AE:TRACE] commitTravel DEFER generate (target=' + targetId + ')');
            ae_pendingGenerate = true;
        } else {
            aeLog('[AE:TRACE] commitTravel SILENT SKIP generate (target=' + targetId + ')');
        }
    } catch (e) {
        aeLog('[AE] commitTravel error:', e);
    }
}


// ============================================================================
// TRAVEL  [SEC:TRAVEL]
// ============================================================================
// WHAT A JOURNEY COSTS AND WHICH WAY IT GOES. Pure and synchronous throughout, over an
// EntityMeta[]-shaped list and nothing else. THAT PURITY IS THE POINT, not a stylistic
// preference: the Map reprices on every tap, and the only safe thing to call from a render
// path is a function that touches no storage. Same property ceStateBand has, same reason.
//
// THE ROUTE IS THE TREE, AND ONLY THE TREE. Parent, child and sibling. connectedEntityIds
// are NOT traversed and that is a decision, not an omission: parentId rides on the index
// while connections ride on the bodies, so counting explicit routes would turn every quote
// into one loadEntity per node. The tree already reaches everywhere -- siblings share a
// parent, top-level places share the root -- so no location is unreachable from any other
// and there is no "no route" state to design around.
//
// NO PATHFINDER, BECAUSE THERE IS NOTHING TO FIND. In a tree with sibling edges the route
// between two nodes is FORCED: up to the child of their lowest common ancestor, one
// lateral hop, down the far side. A BFS would spend a queue per repaint rediscovering
// that. Walking the two ancestor chains is O(depth), gives the identical answer, and hands
// back the path as a by-product -- and the path is the deliverable, because a tiered price
// cannot be explained by its total.
//
// \u2500\u2500 WHICH END PRICES A HOP  [TRAVEL-TIER] \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
// A hop has two ends at two tiers and exactly one price, so one end has to win. THE END
// BEING ENTERED WINS, EXCEPT WHERE IT IS THE PARENT OF THE END BEING LEFT, in which case
// the end being left wins.
//     Kitchen -> House      backing out; priced as the Kitchen
//     House   -> Kitchen    priced as the Kitchen
//     Kitchen -> Bedroom    priced as the Bedroom
//     Erd     -> Vaeling    two top-level places; priced at the top tier
// WITHOUT THE PARENT CLAUSE THE ORDINARY CASE IS THE BROKEN ONE. Any journey out of a
// nested place climbs through every container it sits in, and each of those climbs would
// be charged at the container's coarse rate -- walking out of a bedroom would cost what
// crossing the world costs. With it, the climb is priced at the fine scale it actually
// happens at and only the lateral hop at the top pays the top rate, which is how distance
// behaves.
// IT IS ALSO WHAT MAKES AN OVERRIDE MEAN ANYTHING. A moon parked at tier 0 among tier-1
// siblings is expensive to reach and ordinary to leave. That asymmetry is correct -- what
// makes it far is where it is, not which way you are facing -- and every leg is shown, so
// nothing about it is hidden.

// -- Catalog lookups (pure) ---------------------------------------------------

function ceTravelDef(cfg: any): any {
    var t: any = cfg ? (cfg as any).travel : null;
    return (t && typeof t === 'object') ? t : {};
}

function ceTravelTiers(cfg: any): any[] {
    var rows: any = ceTravelDef(cfg).tiers;
    return Array.isArray(rows) ? rows : [];
}

// The paying state, or null. THE ONLY READER OF stateId -- see TravelDef.
function ceTravelState(cfg: any): StateDef | null {
    var id = String(ceTravelDef(cfg).stateId || '');
    if (!id) return null;
    return ceStateDef(cfg, id);
}

// A TIER WITH NO ROW COSTS NOTHING, and it deliberately does NOT fall through to the
// nearest priced tier. An author who priced 0 and 1 and left 2 alone has said that hops
// inside a building are free; inheriting tier 1's rate down the tree would charge them for
// a decision they did not make. Absent means free everywhere else in this file and it
// means free here.
function ceTravelRateFor(tiers: any[], tier: number): any {
    var i: number;
    for (i = 0; i < (tiers || []).length; i++) {
        if (!tiers[i]) continue;
        if (Number(tiers[i].tier) === Number(tier)) {
            return { mins: Math.max(0, Math.round(Number(tiers[i].mins) || 0)),
                     cost: Math.max(0, Math.round(Number(tiers[i].cost) || 0)) };
        }
    }
    return { mins: 0, cost: 0 };
}

// -- The graph (pure, index-shaped) -------------------------------------------

// LOCATIONS ONLY, and a node whose parent is absent from the set is a ROOT rather than an
// orphan dropped on the floor. That is ceMapBuildTree's own rule, copied verbatim on
// purpose: the map must not be able to draw one shape while this prices another.
function ceTravelGraph(metas: any[]): any {
    var byId: any = {};
    var i: number;
    for (i = 0; i < (metas || []).length; i++) {
        var m: any = metas[i];
        if (!m || !m.id || m.type !== 'location') continue;
        var raw: any = m.travelTier;
        byId[String(m.id)] = {
            id: String(m.id),
            name: String(m.name || 'Unnamed'),
            parentId: m.parentId ? String(m.parentId) : null,
            // [MAP-VEHICLE] THE FIFTH FIELD, and it is here rather than in a second graph
            // built beside this one. ceTravelVehicleOf walks the SAME ancestor chain the
            // pricing walks and has to reach the same answer about which nodes exist; two
            // graphs over the same list is two chances to disagree about a world where a
            // hidden container sits between a ship and the sea.
            kind: ceMapKindOf(m.mapKind),
            tier: (raw === undefined || raw === null || !isFinite(Number(raw)))
                    ? null : Math.max(0, Math.round(Number(raw)))
        };
    }
    return byId;
}

// GUARDED, AND THE GUARD IS NOT DEFENSIVE PROGRAMMING. The world graph permits cycles at
// rest -- ceMapWouldCycle only blocks them at the picker -- so an unguarded walk here
// hangs a render rather than mis-pricing one node, which is the worse of the two failures
// by a distance.
function _ceTravelChain(byId: any, id: string): string[] {
    var out: string[] = [];
    var seen: any = {};
    var cur: any = byId[String(id || '')];
    var guard = 0;
    while (cur && guard++ < 1000) {
        if (seen[cur.id]) break;
        seen[cur.id] = true;
        out.push(cur.id);
        cur = (cur.parentId && byId[cur.parentId]) ? byId[cur.parentId] : null;
    }
    return out;
}

function ceTravelDepth(byId: any, id: string): number {
    return Math.max(0, _ceTravelChain(byId, id).length - 1);
}

function ceTravelTierOf(byId: any, id: string): number {
    var n: any = byId[String(id || '')];
    if (!n) return 0;
    return (n.tier === null) ? ceTravelDepth(byId, n.id) : n.tier;
}

// [MAP-VEHICLE] IS `id` THE CONTAINER ITSELF, OR SOMEWHERE INSIDE IT. INCLUSIVE AT BOTH
// ENDS, and that is the point rather than a shortcut: the two refusals the vehicle verbs
// need -- do not sail a ship into its own hold, do not sail it into itself -- are one
// question, so they get one function and cannot drift apart.
// Built on _ceTravelChain, so it inherits that walk's cycle guard. A world graph permits
// cycles at rest and an unguarded containment test over one hangs a render.
function ceTravelInside(byId: any, id: string, containerId: string): boolean {
    var c = String(containerId || '');
    if (!c) return false;
    var chain = _ceTravelChain(byId, String(id || ''));
    var i: number;
    for (i = 0; i < chain.length; i++) { if (chain[i] === c) return true; }
    return false;
}

// [MAP-VEHICLE] THE VEHICLE CARRYING THE CAMERA, or ''.
//
// INNERMOST WINS. A launch in the hangar of a carrier answers "the launch": the thing you
// are aboard is the thing that takes you, and the carrier is scenery until you step out
// into it. The walk is the ancestor chain, so this falls out of the order it already
// returns rather than needing a depth comparison.
//
// INCLUSIVE OF `fromId`, because standing on the deck is being aboard. A camera sitting on
// the vehicle node itself is the commonest case there is -- a ship with no rooms mapped is
// one node -- and excluding it would make the feature invisible for exactly the worlds
// least likely to have modelled their way around it.
function ceTravelVehicleOf(byId: any, fromId: string): string {
    var chain = _ceTravelChain(byId, String(fromId || ''));
    var i: number;
    for (i = 0; i < chain.length; i++) {
        var n: any = byId[chain[i]];
        if (n && n.kind === 'vehicle') return String(n.id);
    }
    return '';
}

// [TRAVEL-TIER] The rule, stated once, so that no caller re-derives it. It returns the
// END rather than the tier because TWO questions are now asked of that end -- what scale it
// sits at, and whether it is a room -- and answering them from two walks is how a surface
// comes to price one end and exempt the other.
function ceTravelHopEnd(byId: any, fromId: string, toId: string): string {
    var f: any = byId[String(fromId || '')];
    if (f && f.parentId && String(f.parentId) === String(toId)) return String(fromId || '');
    return String(toId || '');
}

function ceTravelHopTier(byId: any, fromId: string, toId: string): number {
    return ceTravelTierOf(byId, ceTravelHopEnd(byId, fromId, toId));
}

// [MAP-KIND] AN INTERIOR HOP IS FREE, and this is the third value in CE_MAP_KINDS to carry
// a rule rather than paint -- declared at its entry in that table as the register requires.
// Stepping between two rooms of one building, or through a doorway, is not a journey: it
// happens inside the beat the author is already writing, and charging a day's ration for it
// is the complaint this answers.
// THE TEST IS THE PRICED END, not either end, so the exemption is exactly as wide as the
// pricing rule and no wider. Walking Bedroom -> House is priced as the Bedroom (TRAVEL-TIER's
// parent clause) and is therefore free; House -> City above it still pays. A route out of a
// mapped interior is priced from the front door, which is where the travelling starts.
// IT IS NOT travelTier AND DOES NOT TOUCH IT. An interior can still carry a tier -- a cabin
// on a ship halfway across the world sits at whatever scale its author gave it -- and that
// tier is what prices every hop INTO the thing that holds it. This zeroes the hop, not the
// place.
function ceTravelHopFree(byId: any, fromId: string, toId: string): boolean {
    var n: any = byId[ceTravelHopEnd(byId, fromId, toId)];
    return !!n && n.kind === 'interior';
}

// [from, ...via, to], or null if either end is not a location in this world. Two ends with
// NO common ancestor are separate roots, which the graph permits and which is ONE lateral
// hop apart -- top-level places are siblings, so this returns a route rather than null.
function ceTravelPath(byId: any, fromId: string, toId: string): string[] | null {
    var a = String(fromId || ''), b = String(toId || '');
    if (!byId[a] || !byId[b]) return null;
    if (a === b) return [a];
    var ca = _ceTravelChain(byId, a);
    var cb = _ceTravelChain(byId, b);
    var idxB: any = {};
    var i: number;
    for (i = 0; i < cb.length; i++) idxB[cb[i]] = i;
    var lcaA = -1, lcaB = -1;
    for (i = 0; i < ca.length; i++) {
        if (idxB[ca[i]] !== undefined) { lcaA = i; lcaB = idxB[ca[i]]; break; }
    }
    if (lcaA < 0) return ca.concat(cb.slice().reverse());
    if (lcaA === 0) return [a].concat(cb.slice(0, lcaB).reverse());   // a is b's ancestor
    if (lcaB === 0) return ca.slice(0, lcaA + 1);                     // b is a's ancestor
    return ca.slice(0, lcaA).concat(cb.slice(0, lcaB).reverse());
}

// -- The quote ----------------------------------------------------------------

// THE WHOLE ANSWER FOR ONE JOURNEY, AND IT RETURNS THE LEGS RATHER THAN ONLY THE TOTALS.
// A tiered price that cannot be broken down is a number the author has to take on trust,
// which is the exact standard the roll composer is held to one system over: show the
// parts, because a total nobody can check is a total nobody can argue with.
// `ok` false means one end is not a location. It does NOT mean unreachable -- see
// ceTravelPath.
function ceTravelQuote(tiers: any[], metas: any[], fromId: string, toId: string): any {
    var out: any = { ok: false, steps: 0, mins: 0, cost: 0, legs: [] as any[] };
    var byId = ceTravelGraph(metas);
    var path = ceTravelPath(byId, fromId, toId);
    if (!path) return out;
    out.ok = true;
    var i: number;
    for (i = 1; i < path.length; i++) {
        // ONE WALK PER LEG. The end is resolved once and both questions are asked of it,
        // rather than calling ceTravelHopTier and ceTravelHopFree and trusting them to agree.
        var end = ceTravelHopEnd(byId, path[i - 1], path[i]);
        var endN: any = byId[end];
        var tier = ceTravelTierOf(byId, end);
        var free = !!endN && endN.kind === 'interior';
        var rate = free ? { mins: 0, cost: 0 } : ceTravelRateFor(tiers, tier);
        out.legs.push({
            fromId: path[i - 1], toId: path[i],
            name: byId[path[i]] ? byId[path[i]].name : path[i],
            // [MAP-KIND] CARRIED ON THE LEG so the breakdown can say WHY a hop cost nothing.
            // A row reading "tier 3 \u00b7 free" in a priced world reads as an unpriced tier
            // the author forgot, which is a bug report waiting to be filed.
            tier: tier, free: free, mins: rate.mins, cost: rate.cost
        });
        out.mins += rate.mins;
        out.cost += rate.cost;
    }
    out.steps = path.length - 1;
    return out;
}

// -- Words --------------------------------------------------------------------

// Minutes as a duration a person would say. Uses the clock's own divisors rather than a
// second set of them, so a day here is a day there.
function ceTravelDuration(mins: number): string {
    var m = Math.max(0, Math.round(Number(mins) || 0));
    if (!m) return '';
    if (m < CE_MINS_HOUR) return String(m) + 'm';
    var h = Math.floor(m / CE_MINS_HOUR), rm = m % CE_MINS_HOUR;
    if (h < CE_HOURS_DAY) return String(h) + 'h' + (rm ? ' ' + String(rm) + 'm' : '');
    var d = Math.floor(h / CE_HOURS_DAY), rh = h % CE_HOURS_DAY;
    return String(d) + 'd' + (rh ? ' ' + String(rh) + 'h' : '');
}

// EMPTY WHEN NOTHING IS CHARGED, so a world that has priced nothing gets no cost furniture
// at all rather than a row of zeroes. The difference between "free" and "not priced yet"
// is not one an author needs drawn for them on every tap.
// [SEC:TRAVEL] THE ENTRY SPLIT, and its inverse. The stored value is ONE INTEGER OF
// MINUTES and these two are the only place it is ever taken apart -- so a tier that costs a
// day and a half is authored as 1 / 12 / 0 and stored as 2160, with no third representation
// anywhere in between.
// THE FIELDS NORMALISE AND THAT IS THE INTENDED BEHAVIOUR, not a rounding artefact: 90
// typed into Minutes is stored as 90 and redisplays as 1h 30m, and 99 into Hours comes back
// as 4d 3h. The author sees the engine agreeing with them in its own units rather than a
// field silently refusing what they typed. It is also the reason the clamp is per FIELD and
// not on the total: a per-field ceiling that rejected 90 minutes would make the split a
// worse control than the single box it replaced.
// TWO DIGITS EACH, per author. 99/99/99 is a little over 147 days, which is longer than any
// single hop in a world anybody is going to sit and play.
function ceTravelDHM(mins: number): any {
    var m = Math.max(0, Math.round(Number(mins) || 0));
    return { d: Math.floor(m / CE_MINS_DAY),
             h: Math.floor((m % CE_MINS_DAY) / CE_MINS_HOUR),
             m: m % CE_MINS_HOUR };
}

function ceTravelMinsOf(d: any, h: any, m: any): number {
    function two(v: any): number {
        var n = Math.round(Number(v) || 0);
        if (!isFinite(n)) n = 0;
        return Math.max(0, Math.min(99, n));
    }
    return two(d) * CE_MINS_DAY + two(h) * CE_MINS_HOUR + two(m);
}

function ceTravelCostPhrase(q: any, resName: string): string {
    var bits: string[] = [];
    if (q && q.mins > 0) bits.push(ceTravelDuration(q.mins));
    if (q && q.cost > 0) bits.push('\u2212' + String(q.cost) + (resName ? ' ' + resName : ''));
    return bits.join(' \u00b7 ');
}

// -- The charge, and the move -------------------------------------------------

// WHO PAYS FOR A JOURNEY. This is NOT _ceStakeRef and must not be routed through it: that
// function answers "which SIDE of a Move holds this state", and a journey has no sides. It
// has a traveller, and the traveller is whoever the camera is following.
// A faction- or npc-scoped def RETURNS NULL rather than guessing an owner. Faction values
// have no door in this file yet -- Settings > States says so out loud -- and an NPC-scoped
// def names a state the player is not supposed to carry. Both refuse here for the same
// reason _ceStakeRef refuses them one system over: a charge landing on the wrong owner is
// worse than a charge that does not land, because the receipt says it worked.
async function ceTravelRef(cfg: any, def: StateDef): Promise<StateRef | null> {
    if (!def) return null;
    if (def.scope === 'world') return { scope: 'world', ownerId: '', defId: def.id };
    if (def.scope === 'protagonist') return { scope: 'protagonist', ownerId: '', defId: def.id };
    if (def.scope === 'char') {
        var pid = String(await ceProtagonistId(cfg) || '');
        if (!pid) return null;
        return { scope: 'char', ownerId: pid, defId: def.id };
    }
    return null;
}

// THE ONE ORDER THIS FUNCTION EXISTS TO GET RIGHT: CLOCK, THEN CAMERA, THEN CHARGE.
//
// The clock moving is not a cosmetic side-effect of travel -- ceClockSet fires
// ceSchedResolve, which physically repositions every off-camera character. And
// ceSchedResolve skips anyone who is scenePresent [T-15], deliberately, because the body
// is authoritative on camera.
// SO THE ORDER IS LOAD-BEARING. Move the camera first and the destination's occupants are
// marked present at the DEPARTURE hour; the clock then advances, ceSchedResolve reaches
// them, sees scenePresent, and skips them -- an NPC whose shift ended two hours into the
// journey is frozen in that room, permanently, with nothing on the console. Advancing the
// clock while the camera is still at the origin resolves them to their ARRIVAL positions
// and then commitTravel computes presence against the world as it will actually be.
// FOLLOWERS ARE SAFE EITHER WAY: they are scene-present at the origin when the clock
// moves, so their own schedules skip them, and commitTravel carries them across after.
//
// THE CHARGE IS LAST AND NEVER BLOCKS. There is no can-afford gate anywhere in this
// system, on purpose -- see TravelDef. stateNudge clamps at the floor, so asking for five
// with two in hand takes two, and this REPORTS THE MOVEMENT RATHER THAN THE ASK, which is
// the same rule ceSpendForBonus is written to one system over. A traveller who could not
// pay still arrives; the receipt says how far short they were.
//
// AN UNQUOTABLE JOURNEY IS FREE, NOT REFUSED. A camera sitting on AE_ROOT_LOCATION_ID is
// not in the location graph at all, so no path exists and no price can be computed. That
// is a fresh world with nowhere in it yet, and the right answer is to move.
async function ceTravelGo(targetId: string): Promise<any> {
    var out: any = { moved: false, steps: 0, mins: 0, cost: 0, spent: 0, short: 0,
                     name: '', resName: '' };
    try {
        var tgt = await loadEntity(String(targetId || ''));
        if (!tgt) return out;
        out.name = String(tgt.name || '');

        var cfg = await loadConfig();
        var metas = await loadEntityIndex();
        var from = await loadProtagonistLocation();
        var q = ceTravelQuote(ceTravelTiers(cfg), metas, String(from || ''), String(targetId));
        if (q.ok) { out.steps = q.steps; out.mins = q.mins; out.cost = q.cost; }

        // 1. CLOCK
        if (out.mins > 0) {
            try { await ceClockNudge(out.mins); }
            catch (eCk) { api.v1.error('[AE:travel] clock advance failed:', eCk); }
        }

        // 2. CAMERA. Silent: the injection layer already tells the story where it is
        // (getCurrentLocationPromptLine) and what time it is (ceClockBand), so a prose stub
        // dropped into the editor would be a second source of truth about both.
        await commitTravel(String(targetId), true);
        out.moved = true;

        // 3. CHARGE
        if (out.cost > 0) {
            var def = ceTravelState(cfg);
            if (def) {
                out.resName = String(def.name || '');
                var ref = await ceTravelRef(cfg, def);
                if (ref) {
                    var before = await stateRead(ref);
                    var after = await stateNudge(ref, -out.cost);
                    out.spent = Math.max(0, before - after);
                    out.short = Math.max(0, out.cost - out.spent);
                }
            }
        }
        return out;
    } catch (e) {
        api.v1.error('[AE:travel] ceTravelGo:', e);
        return out;
    }
}

// [MAP-VEHICLE] THE HULL MOVE, AND IT IS THE ONLY THING IN THIS FILE THAT WRITES A
// VEHICLE'S POSITION. Both vehicle verbs on the Map end here -- the priced one through
// ceTravelVehicleGo, the free override directly -- for the same reason both camera verbs
// end at commitTravel: one writer, so the free path cannot quietly diverge from the paid
// one about what "the ship is now there" means.
//
// ONE LINE DOES THE WORK AND THE REST IS THE GUARD. parentId IS containment, so changing
// the hull's carries every cabin, crate and body under it with no manifest to walk. That is
// the whole of "keeping its contents with it".
//
// THE CAMERA IS NOT TOUCHED, DELIBERATELY. The traveller is aboard; a voyage that ends by
// putting them on the dock has decided something the author did not ask for, and stepping
// off is one ordinary tap away once the ship has arrived. It also means presence needs no
// help from here -- presence is exact-room co-location and nobody changed rooms.
//
// THE GUARD IS A CYCLE GUARD, NOT A RULE. This system does not gate travel and is not
// starting now; what it refuses is a graph that cannot exist. Sailing a ship into its own
// hold makes the hull its own ancestor, and a cycle in the location tree is not a limit the
// author set on themselves -- it is a world the map cannot draw and the pricer cannot walk.
// REPEATED HERE EVEN THOUGH THE SURFACE ALREADY HIDES THE OFFER. A primitive that trusts
// its callers is a primitive that is one new call site away from being wrong.
async function ceVehicleMove(vehicleId: string, targetId: string): Promise<boolean> {
    try {
        var vmV = String(vehicleId || ''), vmT = String(targetId || '');
        if (!vmV || !vmT || vmV === vmT) return false;
        var vmMetas = await loadEntityIndex();
        if (ceTravelInside(ceTravelGraph(vmMetas), vmT, vmV)) return false;
        var vmEnt = await loadEntity(vmV);
        if (!vmEnt) return false;
        if (String(vmEnt.parentId || '') === vmT) return true;
        // saveEntity, not ceEntityWrite: this is the travel core, the same place
        // commitTravel moves a body from, and ceEntityWrite is the Entity SURFACE's write
        // path. saveEntity is what queues the World-outline resync, which is the one
        // downstream effect a moved hull actually has -- the geography entry encodes
        // containment, so a ship that changed ports has changed the outline.
        vmEnt.parentId = vmT;
        await saveEntity(vmEnt);
        // Cheap and dirty-checked. The camera did not move, so the common answer is "nothing
        // changed" for one string compare per character -- but the clock may have moved
        // scheduled NPCs on the way here, and this is where that lands.
        await recalculateScenePresence();
        return true;
    } catch (e) {
        api.v1.error('[AE:travel] ceVehicleMove:', e);
        return false;
    }
}

// [MAP-VEHICLE] THE VOYAGE. ceTravelGo's twin, and deliberately the same three steps in the
// same order -- CLOCK, THEN THE MOVE, THEN THE CHARGE -- for the reasons written out in
// full at ceTravelGo. Nothing about a vehicle changes that argument.
//
// PRICED FROM THE HULL, NOT FROM THE CAMERA, and this is the one real difference between
// the two functions. The camera may be three decks down; those three hops are not part of
// the journey because nobody walks them -- the ship carries them. Quoting from the camera
// would charge the traveller for crossing a vessel they are standing still inside, and it
// would charge them again in the other direction the moment they came back up.
//
// THE GUARD RUNS BEFORE THE CLOCK. ceVehicleMove refuses a cycle on its own, but by then
// the clock has already advanced and the schedules have already resolved against a journey
// that is not going to happen. A refusal has to cost nothing.
async function ceTravelVehicleGo(vehicleId: string, targetId: string): Promise<any> {
    var out: any = { moved: false, steps: 0, mins: 0, cost: 0, spent: 0, short: 0,
                     name: '', vehName: '', resName: '' };
    try {
        var tvV = String(vehicleId || ''), tvT = String(targetId || '');
        var tvVeh = await loadEntity(tvV);
        var tvTgt = await loadEntity(tvT);
        if (!tvVeh || !tvTgt) return out;
        out.name = String(tvTgt.name || '');
        out.vehName = String(tvVeh.name || '');

        var tvCfg = await loadConfig();
        var tvMetas = await loadEntityIndex();
        if (ceTravelInside(ceTravelGraph(tvMetas), tvT, tvV)) return out;

        var tvQ = ceTravelQuote(ceTravelTiers(tvCfg), tvMetas, tvV, tvT);
        if (tvQ.ok) { out.steps = tvQ.steps; out.mins = tvQ.mins; out.cost = tvQ.cost; }

        // 1. CLOCK
        if (out.mins > 0) {
            try { await ceClockNudge(out.mins); }
            catch (eTvC) { api.v1.error('[AE:travel] clock advance failed:', eTvC); }
        }

        // 2. THE HULL
        out.moved = await ceVehicleMove(tvV, tvT);
        if (!out.moved) return out;

        // 3. CHARGE. Same state, same clamp, same no-gate posture as ceTravelGo -- a
        // traveller who could not pay still arrives and the receipt says how far short.
        if (out.cost > 0) {
            var tvDef = ceTravelState(tvCfg);
            if (tvDef) {
                out.resName = String(tvDef.name || '');
                var tvRef = await ceTravelRef(tvCfg, tvDef);
                if (tvRef) {
                    var tvBefore = await stateRead(tvRef);
                    var tvAfter = await stateNudge(tvRef, -out.cost);
                    out.spent = Math.max(0, tvBefore - tvAfter);
                    out.short = Math.max(0, out.cost - out.spent);
                }
            }
        }
        return out;
    } catch (e) {
        api.v1.error('[AE:travel] ceTravelVehicleGo:', e);
        return out;
    }
}

// ============================================================================
// SECTION 20 — SHARED ENTITY, CONFIG & IMPORT OPERATIONS
//
// Survivors of the earlier native-UI sweep. Every function here was declared
// inside a deleted native surface (the sidebar, the workspace shell, the
// worldbuilding/config modals) but is called from outside it — SECTION 18
// bridge handlers and the jsx surfaces — so it was moved rather than cut.
// Nothing in this section renders a native sidebar or workspace; the only
// api.v1.ui use left is openLorebookImportPicker's dialog and the toasts.
//
//   mutConfig                     — load/mutate/save GlobalConfig (73 call sites)
//   aeExpandAlternations          — {a|b} pick-one expansion, used by all three spawns
//   spawnSceneNpc / spawnItem / spawnLocation
//                                 — create a character/item/location body from a
//                                   name + brief. Reached from AE_HUD_SPAWN_ENTITY,
//                                   AE_HUD_SPAWN_LOCATION and AE_STUDIO_CREATE.
//   generateSceneNpc / generateSceneItem / generateSceneLocation
//                                 — generate a scene-fitting DRAFT without creating
//                                   anything. [REACH] Its two bridge cases are
//                                   deleted; the Scene surface's spawn path is the door.
//   importPayload + merge helpers — the smart importer. Settings surface import path.
// ============================================================================

// -- Config mutation ---------------------------------------------------------

async function mutConfig(fn: (c: GlobalConfig) => void): Promise<void> {
    const c = await loadConfig(); fn(c); await saveConfig(c);
}

// -- Scene spawns & drafts ---------------------------------------------------

function aeExpandAlternations(txt: string): string {
    let outAlt = String(txt || '');
    let guardAlt = 0;
    while (guardAlt < 24) {
        let mAlt = outAlt.match(/\{([^{}|]*(?:\|[^{}|]*)+)\}/);
        if (!mAlt) break;
        let optsAlt = mAlt[1].split('|');
        let idxAlt = 0;
        try { idxAlt = api.v1.random.roll('1d' + optsAlt.length).total - 1; } catch (eAlt) { idxAlt = 0; }
        if (idxAlt < 0 || idxAlt >= optsAlt.length) idxAlt = 0;
        let posAlt = (typeof mAlt.index === 'number') ? mAlt.index : 0;
        outAlt = outAlt.substring(0, posAlt) + optsAlt[idxAlt].trim() + outAlt.substring(posAlt + mAlt[0].length);
        guardAlt++;
    }
    return outAlt;
}

async function spawnSceneNpc(name: string, brief: string, locId: string | null, quiet?: boolean): Promise<{ id: string; name: string } | null> {
    try {
        const cfg = await loadConfig();
        if (!locId) { locId = await aeGetProtagonistRoomId(); }   // [vNEXT] default to the player's actual room
        let baseName = aeExpandAlternations(name || 'Someone').trim();
        if (!baseName) baseName = 'Someone';
        let finalBrief = aeExpandAlternations(brief || '').trim();

        // Numbered suffix on collision with any active character (Skeleton, Skeleton 2...).
        const nsIdx = await loadIndex();
        let finalName = baseName;
        let nsN = 2;
        while (nsIdx.some(function(m) { return !!m && m.active && (m.name || '') === finalName; }) && nsN < 50) {
            finalName = baseName + ' ' + nsN;
            nsN++;
        }

        // [ENT-ID1] Character first; body takes its id. See createWizardCharacter.
        const rec = makeDefaultCharacter(finalName, cfg);
        const body = makeDefaultEntity(finalName);
        body.id = rec.id;
        body.type = 'character';
        body.parentId = locId ? locId : null;
        body.description = finalBrief;
        await saveEntity(body);

        rec.entityId = body.id;
        rec.briefDescription = finalBrief;
        rec.active = true;
        rec.scenePresent = true;
        await saveCharacter(rec);

        await recalculateScenePresence();
        if (!quiet) api.v1.ui.toast('Character "' + finalName + '" added.', { type: 'success', autoClose: 2000 });
        return { id: rec.id, name: finalName };
    } catch (e) {
        api.v1.error('[AE] spawnSceneNpc:', e);
        api.v1.ui.toast('Failed to add character.', { type: 'error' });
        return null;
    }
}

// [vNEXT] Scene-grounded NPC generator. Uses generateWithStory in 'background' mode
// (same path as generateCharacterSnapshot) so the model sees the live story +
// location and invents someone who fits the moment. Returns a {name, brief} for
// review/spawn; does NOT create anything itself.
async function generateSceneNpc(): Promise<{ name: string; brief: string } | null> {
    try {
        let gsLocName = 'the current location';
        let gsLocDesc = '';
        let gsLocId = await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, null) as string | null;
        if (gsLocId) {
            let gsLocEnt = await loadEntity(gsLocId);
            if (gsLocEnt) { gsLocName = gsLocEnt.name || gsLocName; gsLocDesc = gsLocEnt.description || ''; }
        }
        let gsCfg = await loadConfig();
        let gsSys: string[] = [
            gsCfg.generalStyle || '',
            '',
            'You invent ONE background character who would plausibly be present in the current scene.',
            'Base them on what is actually happening in the story right now and on the location.',
            'Output EXACTLY two lines and nothing else, no preamble:',
            'NAME: <a short name or label, e.g. Gate Guard, Mara, Hooded Vendor>',
            'DOING: <one present-tense sentence describing what they are doing here and why>'
        ];
        let gsUsr: string[] = [
            'Location: ' + gsLocName,
            gsLocDesc ? 'Setting: ' + gsLocDesc.slice(0, 160) : '',
            'Invent a fitting NPC now. Two lines only.'
        ].filter(Boolean);

        let gsResp = await api.v1.generateWithStory(
            [{ role: 'system', content: gsSys.join('\n') }, { role: 'user', content: gsUsr.join('\n') }],
            { model: 'glm-4-6', max_tokens: 120 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );
        let gsTxt = (gsResp && gsResp.choices && gsResp.choices.length > 0) ? String(gsResp.choices[0].text || '') : '';
        if (!gsTxt.trim()) return null;

        let gsName = '';
        let gsBrief = '';
        gsTxt.split('\n').forEach(function(ln) {
            let t = ln.trim();
            let up = t.toUpperCase();
            if (up.indexOf('NAME:') === 0) gsName = t.substring(5).trim();
            else if (up.indexOf('DOING:') === 0) gsBrief = t.substring(6).trim();
        });
        if (!gsName || !gsBrief) {
            let gsLines = gsTxt.split('\n').map(function(s) { return s.trim(); }).filter(Boolean);
            if (!gsName && gsLines.length > 0) gsName = gsLines[0].replace(/^NAME:\s*/i, '');
            if (!gsBrief && gsLines.length > 1) gsBrief = gsLines.slice(1).join(' ').replace(/^DOING:\s*/i, '');
        }
        gsName = gsName.replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        gsBrief = gsBrief.replace(/^["'\s\-]+/, '').slice(0, 240);
        if (!gsName) return null;
        return { name: gsName, brief: gsBrief };
    } catch (e) {
        api.v1.error('[AE] generateSceneNpc:', e);
        api.v1.ui.toast('Scene generation failed.', { type: 'error' });
        return null;
    }
}

// [CE-STRIP earlier] NPC Archetype editor (aeMutateArchetype/buildArchetypeEditContent/refreshArchetypeEditModal/openArchetypeEditModal), Bestiary modal (buildBestiaryContent/refreshBestiaryModal/openBestiaryModal), and Item Template mutator (aeMutateItemArchetype) all removed — Bestiary + Item Templates cut.

// Spawn one item from a template. Target defaults to the player's inventory (parented
// to the protagonist's body); a template may instead choose the current room, where the
// loose item becomes pick-up-able via the library Pick Up action. {a|b|c} alternations
// in name/description are rolled once, here, and baked into the copy.
async function spawnItem(name: string, desc: string, quiet?: boolean, explicitParentId?: string | null): Promise<{ id: string; name: string } | null> {
    try {
        // Target resolution: an explicit entity id (e.g. the inspected room) wins; the
        // sentinels '__room__' / '__inventory__' force a mode; default is inventory (the
        // protagonist's body).
        // [FIX earlier] spTarget used to be declared inside the `else` below, so the
        // explicit-parent-id branch (the exact path AE_HUD_SPAWN_ENTITY takes) skipped
        // its declaration entirely -- saveEntity succeeded but the toast line threw a
        // ReferenceError, surfacing as "Failed to add item." on a spawn that actually
        // worked. Hoisted to outer scope; explicit parent counts as 'room' (a place in
        // the world, not the protagonist's body).
        let target: string | null = null;
        let spTarget: string;
        if (explicitParentId && explicitParentId !== '__inventory__' && explicitParentId !== '__room__') {
            target = explicitParentId;
            spTarget = 'room';
        } else {
            if (explicitParentId === '__room__') spTarget = 'room';
            else spTarget = 'inventory';
            if (spTarget === 'room') {
                target = await aeGetProtagonistRoomId();
            } else {
                const spChars = await loadAllCharacters();
                const spProtag = spChars.find(function(c) { return c.isProtagonist; });
                target = (spProtag && spProtag.entityId) ? spProtag.entityId : await aeGetProtagonistRoomId();
            }
        }

        let baseName = aeExpandAlternations(name || 'Item').trim();
        if (!baseName) baseName = 'Item';
        let finalDesc = aeExpandAlternations(desc || '').trim();

        // Numbered suffix on collision with any item already in the same container.
        const siIdx = await loadEntityIndex();
        let finalName = baseName;
        let siN = 2;
        while (siIdx.some(function(m) { return !!m && m.type === 'item' && m.parentId === target && (m.name || '') === finalName; }) && siN < 50) {
            finalName = baseName + ' ' + siN;
            siN++;
        }

        const body = makeDefaultEntity(finalName);
        body.type = 'item';
        body.parentId = target ? target : null;
        body.description = finalDesc;
        await saveEntity(body);

        if (!quiet) api.v1.ui.toast('Item \u201c' + finalName + '\u201d added' + (spTarget === 'room' ? ' to the room.' : ' to inventory.'), { type: 'success', autoClose: 2000 });
        return { id: body.id, name: finalName };
    } catch (e) {
        api.v1.error('[AE] spawnItem:', e);
        api.v1.ui.toast('Failed to add item.', { type: 'error' });
        return null;
    }
}

// Scene-grounded item generator. Same background path as generateSceneNpc: reads the
// live location, invents an item that fits the moment, returns {name, desc} for
// review/spawn. Creates nothing itself.
async function generateSceneItem(): Promise<{ name: string; desc: string } | null> {
    try {
        let giLocName = 'the current location';
        let giLocDesc = '';
        let giLocId = await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, null) as string | null;
        if (giLocId) {
            let giLocEnt = await loadEntity(giLocId);
            if (giLocEnt) { giLocName = giLocEnt.name || giLocName; giLocDesc = giLocEnt.description || ''; }
        }
        let giCfg = await loadConfig();
        let giSys: string[] = [
            giCfg.generalStyle || '',
            '',
            'You invent ONE item that would plausibly be found in the current scene.',
            'Base it on what is actually happening in the story right now and on the location.',
            'Output EXACTLY two lines and nothing else, no preamble:',
            'NAME: <a short item name, e.g. Rusted Key, Silk Scarf, Hunting Knife>',
            'DESC: <one sentence describing what it is and its notable qualities>'
        ];
        let giUsr: string[] = [
            'Location: ' + giLocName,
            giLocDesc ? 'Setting: ' + giLocDesc.slice(0, 160) : '',
            'Invent a fitting item now. Two lines only.'
        ].filter(Boolean);

        let giResp = await api.v1.generateWithStory(
            [{ role: 'system', content: giSys.join('\n') }, { role: 'user', content: giUsr.join('\n') }],
            { model: 'glm-4-6', max_tokens: 120 },
            { suppressScriptHooks: 'self', contextLimitReduction: 450 },
            undefined,
            'background'
        );
        let giTxt = (giResp && giResp.choices && giResp.choices.length > 0) ? String(giResp.choices[0].text || '') : '';
        if (!giTxt.trim()) return null;

        let giName = '';
        let giDesc = '';
        giTxt.split('\n').forEach(function(ln) {
            let t = ln.trim();
            let up = t.toUpperCase();
            if (up.indexOf('NAME:') === 0) giName = t.substring(5).trim();
            else if (up.indexOf('DESC:') === 0) giDesc = t.substring(5).trim();
        });
        if (!giName || !giDesc) {
            let giLines = giTxt.split('\n').map(function(s2) { return s2.trim(); }).filter(Boolean);
            if (!giName && giLines.length > 0) giName = giLines[0].replace(/^NAME:\s*/i, '');
            if (!giDesc && giLines.length > 1) giDesc = giLines.slice(1).join(' ').replace(/^DESC:\s*/i, '');
        }
        giName = giName.replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        giDesc = giDesc.replace(/^["'\s\-]+/, '').slice(0, 240);
        if (!giName) return null;
        return { name: giName, desc: giDesc };
    } catch (e) {
        api.v1.error('[AE] generateSceneItem:', e);
        api.v1.ui.toast('Scene generation failed.', { type: 'error' });
        return null;
    }
}

// ============================================================================
// [LOCGEN] IN-PLAY LOCATION AUTHORING
// The spatial sibling of spawnItem / generateSceneItem, directly above. Same two-step
// shape: generate a draft from live story context, hand it back for review, then create.
//
// RELATION is the whole model. There is no third case:
//   'sibling'  same tier, adjacent      -> parentId = reference location's parentId
//   'child'    contained within here    -> parentId = reference location's id
// Sibling adjacency is implicit (shared parentId); no connectedEntityIds edge is written.
//
// >>> PAIRED CODE, three ways. Change one, check the others:
// >>>   generateLocationBatch()  — the wizard's chat-context twin of the prompt below.
// >>>   createLocationEntity()   — the shared entity+lorebook birth helper both use.
// >>>   spawnItem/spawnNpc       — the popup/round-trip pattern this mirrors, and the
// >>>                              AE_HUD_GEN_ENTITY / AE_HUD_SPAWN_ENTITY message pair
// >>>                              that AE_HUD_GEN_LOCATION / AE_HUD_SPAWN_LOCATION copy.
// ============================================================================

// Scene-grounded location generator. Background generation (NOT executeYoinkGeneration —
// that hijacks the foreground editor call, which is right for an interactive wizard chat
// and wrong for a HUD button). Reads the reference location and an optional author
// suggestion; returns {name, description, lore} for review. Creates nothing itself.
async function generateSceneLocation(relation: string, refLocId?: string | null, suggestion?: string): Promise<{ name: string; description: string; lore: string } | null> {
    try {
        let glRel = (relation === 'child') ? 'child' : 'sibling';
        let glRefId = refLocId ? refLocId : (await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, null) as string | null);
        let glRefEnt = glRefId ? await loadEntity(glRefId) : null;
        let glRefName = (glRefEnt && glRefEnt.name) ? glRefEnt.name : 'the current location';
        let glRefDesc = (glRefEnt && glRefEnt.description) ? glRefEnt.description : '';
        let glParentId = (glRel === 'child') ? (glRefId || null) : (glRefEnt ? (glRefEnt.parentId || null) : null);
        let glParentEnt = (glRel === 'sibling' && glParentId) ? await loadEntity(glParentId) : null;

        let glIdx = await loadEntityIndex();
        let glExisting = glIdx
            .filter(function(m) { return m.type === 'location' && m.parentId === (glParentId || null); })
            .map(function(m) { return m.name; })
            .filter(Boolean);

        let glCfg = await loadConfig();
        let glScope = (glRel === 'child')
            ? 'a NEW place contained INSIDE \u201c' + glRefName + '\u201d \u2014 one scale-step smaller than it (a room within a house, a district within a city, a glade within a forest).'
            : 'a NEW place standing ALONGSIDE \u201c' + glRefName + '\u201d at the SAME scale' + (glParentEnt ? ', both contained within \u201c' + glParentEnt.name + '\u201d' : ', both at the top level of the world') + '.';

        let glSys: string[] = [
            glCfg.generalStyle || '',
            '',
            'You invent exactly ONE new location for a story world: ' + glScope,
            'Ground it in what is actually happening in the story right now, and in the reference location below.',
            'CRITICAL RULE: DO NOT use any markdown. DO NOT bold headers or names. Output plain text only.',
            'FORMAT: output exactly these three labelled blocks and nothing else, no preamble:',
            'NAME: <short place name>',
            'DESC: <1-2 sentences capturing ONLY what a camera physically senses on arrival (light, texture, scale). No history.>',
            'LORE: <a full, comprehensive entry (roughly 5-8 sentences) covering history, significance, culture, and tensions. Never restate the DESC line.>'
        ];
        if (glExisting.length) {
            glSys.push('');
            glSys.push('These places ALREADY EXIST at that same level \u2014 do NOT recreate or duplicate them:\n' + glExisting.map(function(gn) { return '- ' + gn; }).join('\n'));
        }

        let glUsr: string[] = [
            'Reference location: ' + glRefName,
            glRefDesc ? 'Setting: ' + glRefDesc.slice(0, 240) : '',
            (glParentEnt && (glParentEnt.description || '').trim()) ? 'Containing place \u2014 ' + glParentEnt.name + ': ' + glParentEnt.description.trim().slice(0, 240) : '',
            (suggestion || '').trim() ? 'The author asks specifically for: ' + String(suggestion).trim().slice(0, 400) : '',
            'Invent the location now. Three labelled blocks only.'
        ].filter(Boolean);

        let glResp = await api.v1.generateWithStory(
            [{ role: 'system', content: glSys.join('\n') }, { role: 'user', content: glUsr.join('\n\n') }],
            { model: 'glm-4-6', max_tokens: 420 },
            { suppressScriptHooks: 'self', contextLimitReduction: 700 },
            undefined,
            'background'
        );
        let glTxt = (glResp && glResp.choices && glResp.choices.length > 0) ? String(glResp.choices[0].text || '') : '';
        if (!glTxt.trim()) return null;

        // Same three regexes generateLocationBatch uses per chunk (see PAIRED PROMPT note there).
        let glNmM = glTxt.match(/NAME:\s*(.+)/i);
        let glDeM = glTxt.match(/DESC:\s*([\s\S]+?)(?:\nLORE:|$)/i);
        let glLoM = glTxt.match(/LORE:\s*([\s\S]+)/i);
        if (!glNmM) return null;
        let glName = glNmM[1].trim().replace(/^["'\s\-]+/, '').replace(/["'\s]+$/, '').slice(0, 60);
        let glDesc = glDeM ? glDeM[1].replace(/\nLORE:[\s\S]*$/i, '').replace(/\nNAME:[\s\S]*$/i, '').trim() : '';
        let glLore = glLoM ? glLoM[1].replace(/\n-{3,}[\s\S]*$/, '').replace(/\nNAME:[\s\S]*$/i, '').trim() : '';
        if (!glName) return null;
        return { name: glName, description: glDesc, lore: glLore };
    } catch (e) {
        api.v1.error('[AE] generateSceneLocation:', e);
        api.v1.ui.toast('Location generation failed.', { type: 'error' });
        return null;
    }
}

// Create one location relative to a reference location (default: the player's current
// one). Depth decides the tier travel template, exactly as the wizard batch path does.
// {a|b|c} alternations in the name/description are rolled once, here.
async function spawnLocation(name: string, description: string, lore: string, relation: string, refLocId?: string | null, quiet?: boolean): Promise<{ id: string; name: string } | null> {
    try {
        let slRel = (relation === 'child') ? 'child' : 'sibling';
        let slRefId = refLocId ? refLocId : (await api.v1.storyStorage.getOrDefault(STORAGE_PROTAGONIST_LOC, null) as string | null);

        // [ROOT-ADDLOC] At the world root there is no reference ENTITY to
        // anchor to: AE_ROOT_LOCATION_ID is a sentinel (deliberately never a real entity, so
        // loadEntity() on it always returns undefined), and a location-less world has no
        // STORAGE_PROTAGONIST_LOC target either. Both bailed here before — the sentinel hit the
        // "Reference location not found." dead end, a null ref hit "No current location..." —
        // which is exactly why a new location could not be created at root from either the
        // native map or the bridge round-trip (both funnel through this one function). At the
        // root, 'sibling' and 'child' collapse to the same result: a new TOP-LEVEL location
        // (parentId null). Handle that directly instead of loading the sentinel.
        let slIsRoot = (!slRefId) || (slRefId === AE_ROOT_LOCATION_ID);
        let slRefEnt: any = null;
        let slParentId: string | null;
        if (slIsRoot) {
            slParentId = null;
        } else {
            slRefEnt = await loadEntity(slRefId);
            if (!slRefEnt) {
                if (!quiet) api.v1.ui.toast('Reference location not found.', { type: 'error' });
                return null;
            }
            slParentId = (slRel === 'child') ? slRefId : (slRefEnt.parentId || null);
        }

        let slBase = aeExpandAlternations(name || '').trim();
        if (!slBase) slBase = 'New Location';

        // Numbered suffix on collision with any location already sharing the new parent.
        let slIdx = await loadEntityIndex();
        let slFinal = slBase;
        let slN = 2;
        while (slIdx.some(function(m) { return !!m && m.type === 'location' && m.parentId === (slParentId || null) && (m.name || '') === slFinal; }) && slN < 50) {
            slFinal = slBase + ' ' + slN;
            slN++;
        }

        let slDesc = aeExpandAlternations(description || '').trim();
        let slId = await createLocationEntity(slFinal, slDesc, (lore || '').trim(), slParentId);

        if (!quiet) {
            let slWhere = slIsRoot
                ? 'at the top level of the world'
                : ((slRel === 'child')
                    ? 'inside ' + (slRefEnt.name || 'here')
                    : 'beside ' + (slRefEnt.name || 'here'));
            api.v1.ui.toast('Location \u201c' + slFinal + '\u201d created ' + slWhere + '.', { type: 'success', autoClose: 2600 });
        }
        return { id: slId, name: slFinal };
    } catch (e) {
        api.v1.error('[AE] spawnLocation:', e);
        api.v1.ui.toast('Failed to create location.', { type: 'error' });
        return null;
    }
}

// [CE-STRIP earlier] Item Template editor (buildItemArchetypeEditContent/refreshItemArchetypeEditModal/openItemArchetypeEditModal/buildItemTemplateRows) removed — Item Templates cut along with Bestiary.


// ── [vNEXT] Add-NPC modal (freeform, scene-grounded) ──────────────────────────
// [LOCGEN] >>> PAIRED with openAddLocationModal() (near killCharacter, below):
// >>> same three-part shape (module state / build.../ open...), spatial instead of
// -- Destructive confirm -----------------------------------------------------

// [REACH] confirmDeleteChar DELETED with case AE_DELETE_CHAR, its only caller.
// The jsx Profile has its own two-step confirm (_ceProfileDangerBlock) and calls
// deleteCharacter directly, so this was a second confirm dialog for the same verb.

// SMART IMPORTER
// ============================================================================
// importPayload(data) — accepts a parsed JSON object and imports whatever
// recognizable blocks it finds. Returns a summary of what was imported.
// All import entry-points (module button, config modal, new-story prompt)
// funnel through this single function so behaviour is always identical.
//
// Recognised top-level blocks (any combination, all optional):
//   config          — GlobalConfig object  → [IMPORT-MERGE] merged field-by-
//                                            field over the CURRENT config, not the
//                                            engine defaults. Every id-keyed array
//                                            (actionTemplates, factions, species,
//                                            resources, characterResourceDefs,
//                                            relationshipArchetypes, factionResourceDefs,
//                                            stakeDefs, npcArchetypes, itemArchetypes,
//                                            customStaticFields, sheetCategories,
//                                            wizardSections) is upserted by `id` —
//                                            matched items are updated in place, new
//                                            ones appended, anything not mentioned in
//                                            the import is left alone. tierTravelDefaults
//                                            upserts by `templateId`. fieldLabels /
//                                            fieldInstructions / fieldBudgets do a
//                                            shallow key merge. Everything else
//                                            (scalars, contextTemplates, holdingDef,
//                                            time settings) only overwrites when the
//                                            key is actually present in the import, so
//                                            a hand-trimmed partial config (e.g. just
//                                            2 new action templates) merges safely
//                                            instead of resetting the rest to defaults.
//                                            totalGenerations is never imported — it's
//                                            live per-story runtime state.
//   characters      — CharacterRecord[]    → merged into character index
//   character       — CharacterRecord      → single character (not bundle)
//   entities        — EntityRecord[]       → merged into entity index
//   locations       — EntityRecord[]       → backwards-compat alias for entities
//   entity          — EntityRecord         → single entity node
//   npcWeb          — NpcWebEntry[]        → [IMPORT-MERGE] upserted by `id`,
//                                            same as config arrays (was: full replace)
//   partyState      — PartyState           → [IMPORT-MERGE] resourceValues is
//                                            a shallow key merge (was: full replace)
//
// Special typed wrappers (detected first, return early):
//   { type: 'character_bundle', character, entity? }
//
// Bare root-level records (no top-level array key):
//   { id, name, ...CharacterRecord }  — no `type` field  → single character
//   { id, name, type, ... }           — has `type` field → single entity
// ============================================================================

// ImportResult interface defined in Section 1 (types block).

// [IMPORT-MERGE] Generic upsert-by-key merge for GlobalConfig's id-keyed
// arrays — the config-level analogue of what saveCharacter/saveEntity already do
// per-record. Matched items (by keyFn) are replaced in place with the incoming
// version; unmatched incoming items are appended; existing items absent from the
// incoming array are left untouched. Returns the merged array plus tallies so
// callers can report what actually changed.
function mergeArrayById(existing: any[] | undefined, incoming: any, keyFn: (item: any) => string | undefined): { merged: any[]; counts: ImportMergeCounts } {
    const base: any[] = Array.isArray(existing) ? existing.slice() : [];
    const counts: ImportMergeCounts = { added: 0, updated: 0 };
    if (!Array.isArray(incoming)) return { merged: base, counts: counts };
    for (const item of incoming.filter(Boolean)) {
        const key = keyFn(item);
        if (key === undefined || key === null || key === '') continue;
        const idx = base.findIndex(function(x) { return keyFn(x) === key; });
        if (idx >= 0) { base[idx] = item; counts.updated++; }
        else { base.push(item); counts.added++; }
    }
    return { merged: base, counts: counts };
}

// [IMPORT-MERGE] Shallow key-merge for Record<string, any> config fields
// (fieldLabels, fieldInstructions, fieldBudgets, partyState.resourceValues) —
// incoming keys overwrite matching existing keys; every other key is preserved.
function mergeRecordShallow(existing: any, incoming: any): any {
    const base: any = (existing && typeof existing === 'object') ? { ...existing } : {};
    if (incoming && typeof incoming === 'object' && !Array.isArray(incoming)) {
        for (const k of Object.keys(incoming)) base[k] = incoming[k];
    }
    return base;
}

// [IMPORT-MERGE] Builds the merged config that replaces `existing`, plus a
// per-category count summary. Deliberately starts from `existing` (the CURRENT
// story's config, already migrated) rather than a fresh default config — a partial
// import that only sets a few fields must never reset the rest to engine defaults.
function mergeConfigForImport(existing: GlobalConfig, incoming: any): { cfg: GlobalConfig; counts: { [category: string]: ImportMergeCounts } } {
    const merged: any = { ...existing };
    const counts: { [category: string]: ImportMergeCounts } = {};
    const byId = function(x: any) { return x && x.id; };

    const idArrayFields: string[] = [
        'sheetCategories', 'customStaticFields', 'customLocationFields', 'customItemFields',
        'customFactionFields', 'customNarrativeFields', 'relationshipArchetypes',
        // [F-28] 'factions' REMOVED. It is not a config array any more, so merging it here
        // would resurrect the key ceMigrateFactionsToEntities deletes -- and an import file
        // from before the migration carries one. Ignoring it is correct and matches how
        // 'conditions' was handled: the LOAD path converts an old shape, the import path
        // does not need to know the old shape existed.
        'species', 'wizardSections', 'stateDefs',
        // [LEAN] FOUR CATALOGS THAT EXIST AND WERE NOT BEING IMPORTED. resolutionDefs and
        // stakeDefs were never added when F-12/F-14 created them; actionPresets and
        // datedEntries never were either. All four are id-keyed and upsert exactly like the
        // rest, so an import that carries one merges and an import that does not is silent --
        // which is what every other line in this list already promises.
        // KEPT IN STEP WITH CE_LEAN_ID_ARRAYS BY HAND, same list, same order.
        'resolutionDefs', 'stakeDefs', 'actionPresets', 'datedEntries'
        // [F-09] 'conditions' -> 'stateDefs'. Same id-keyed upsert; the category it names
        // is the one that still exists. An import file carrying the old key is ignored, and
        // that is correct -- migrateConfig converts a LOADED config's conditions, not an
        // arbitrary import payload, and converting on two paths would be two migrations.
        // [CE-SWEEP] resources / characterResourceDefs / factionResourceDefs /
        // stakeDefs / actionTemplates removed from this allowlist. All five were deleted from
        // GlobalConfig by earlier CE-STRIP passes, so merging them wrote keys no reader has
        // ever looked at and inflated the per-category import summary with categories the
        // build no longer has. An import file that still carries them is simply ignored now,
        // which is the correct outcome -- there is nothing left to import them INTO.
    ];
    for (const field of idArrayFields) {
        if (incoming[field] === undefined) continue;
        const r = mergeArrayById((existing as any)[field], incoming[field], byId);
        merged[field] = r.merged;
        counts[field] = r.counts;
    }

    // [CE-SWEEP] tierTravelDefaults merge block removed — Travel was cut at
    // CE-STRIP earlier and the field no longer exists on GlobalConfig. It was keyed by
    // templateId rather than id, which is why it had its own block down here and why the
    // allowlist prune above did not catch it.

    // Record<string,*> fields — shallow key merge rather than whole-object replace.
    if (incoming.fieldLabels !== undefined)       merged.fieldLabels       = mergeRecordShallow(existing.fieldLabels, incoming.fieldLabels);
    if (incoming.fieldInstructions !== undefined) merged.fieldInstructions = mergeRecordShallow(existing.fieldInstructions, incoming.fieldInstructions);
    if (incoming.fieldBudgets !== undefined)      merged.fieldBudgets      = mergeRecordShallow(existing.fieldBudgets, incoming.fieldBudgets);

    // factionResourceSections is an ordered string[], not id-keyed — union, existing
    // order first, then append any section names the import introduces.
    if (Array.isArray(incoming.factionResourceSections)) {
        const cur: string[] = Array.isArray(existing.factionResourceSections) ? existing.factionResourceSections.slice() : [];
        for (const sec of incoming.factionResourceSections) { if (cur.indexOf(sec) < 0) cur.push(sec); }
        merged.factionResourceSections = cur;
    }

    // Everything else: scalar/object fields only overwrite when the import actually
    // sets them, so an import that never mentions (say) projectGenre can't blank it.
    const passthroughFields: string[] = [
        'contextTemplates', 'lorebookTemplates', 'lorebookFields', 'interfaceMode', 'thoughtIntervalGens',
        'hookIntervalGens', 'ephemeralCap', 'maxDynamicCharacters',
        'autoThoughtsDefault', 'showFieldHeaders', 'generalStyle',
        'defaultBackgroundUrl',
        'projectName', 'projectGenre', 'projectConcept',
        // [LEAN] THE WORLD'S TIME AND ITS STANDINGS WERE NOT CROSSING THE IMPORT AT ALL.
        // An exported world arrived without its calendar, without its ladder and without its
        // resolution default -- three of the most authored things in a module, silently
        // dropped, because this list was written before any of them existed. Each is a whole
        // value rather than an id-keyed array (half a ladder is not a ladder), so each only
        // overwrites when the import actually sets it, exactly like every other line here.
        'calendar', 'standingLadder', 'standingRest', 'standingStart', 'timeInject',
        'defaultResolutionId', 'dynamicIntervalMode', 'thoughtIntervalTokens',
        'hookIntervalTokens', 'maxGenerationsPerTurn'
        // graveyardEntityId is DELIBERATELY ABSENT: it names an entity in the story that
        // wrote it, so importing it points this story's graveyard at somebody else's node or
        // at nothing. Same reasoning as totalGenerations below.
    ];
    for (const field of passthroughFields) {
        if (incoming[field] !== undefined) merged[field] = incoming[field];
    }

    // totalGenerations is live per-story runtime state, never imported — always keep
    // whatever the destination story already has, regardless of what the import carries.
    merged.totalGenerations = existing.totalGenerations;

    return { cfg: merged as GlobalConfig, counts: counts };
}

// [IMPORT-MERGE] Totals added/updated across every category in a
// configCategoryCounts map — used for the compact one-line import summary toast.
function sumMergeCounts(map: { [k: string]: ImportMergeCounts } | undefined): ImportMergeCounts {
    const out: ImportMergeCounts = { added: 0, updated: 0 };
    if (!map) return out;
    for (const k of Object.keys(map)) { out.added += map[k].added; out.updated += map[k].updated; }
    return out;
}

// ── Import Payload (full module importer) ────────────────────────────────────
async function importPayload(data: any): Promise<ImportResult> {
    const result: ImportResult = {
        charCount: 0, entityCount: 0,
        configImported: false, npcWebImported: false, partyStateImported: false
    };

    // 1. Config block — [IMPORT-MERGE] merged field-by-field over the
    //    CURRENT config (id-keyed arrays upserted, everything else only touched
    //    when the import actually sets it) rather than replaced wholesale — see
    //    the Smart Importer comment block above for the full field-by-field rules.
    if (data.config && typeof data.config === 'object' && !Array.isArray(data.config)) {
        const priorCfg = await loadConfig();
        const mergeRes = mergeConfigForImport(priorCfg, data.config);
        const newCfg = migrateConfig(mergeRes.cfg);
        await saveConfig(newCfg);
        result.configImported = true;
        result.configCategoryCounts = mergeRes.counts;
    }

    const activeCfg = await loadConfig();

    // 2. Character bundle — typed single-export format (char + optional entity)
    //    Detected first and returns early so its keys don't fall through to the
    //    generic `character` / `entity` checks below.
    if (data.type === 'character_bundle' && data.character) {
        // [ENT-ID1] THE BUNDLE IS THE EASY CASE and the only one where the pairing
        // survives the file: char and body arrive together, so the body is simply re-homed
        // at the character's id on the way in. Without this, importing a pre-ENT-ID1 bundle
        // into a migrated story would reinstate a split pair silently -- migrateCharacter
        // and migrateEntity each see one record and neither can notice.
        var cbChar = migrateCharacter(data.character, activeCfg);
        if (data.entity && typeof data.entity === 'object') {
            var cbBody = migrateEntity(data.entity);
            cbBody.id = cbChar.id;
            await saveEntity(cbBody);
            result.entityCount = 1;
        }
        cbChar.entityId = cbChar.id;
        await saveCharacter(cbChar);
        result.charCount = 1;
        await ceProfileEnsureBody(cbChar.id);
        return result;
    }

    // 3. Characters — array, singular block, or bare root record
    // [ENT-ID1] THE ARRAY FORM CANNOT PRESERVE THE LINK AND DOES NOT TRY. In a
    // separated characters[]/entities[] payload the pairing exists only as entityId, and
    // the body it names may be absent from the file, already taken in this story, or
    // present but attached to a graph that did not come with it. Chasing that produces a
    // pointer that is right in the file and wrong in the destination, which is precisely
    // the class of bug ENT-ID1 exists to end. So the pointer is dropped and the body is
    // minted locally at the character's id -- AUTOMATICALLY, via the repair verb, not by
    // leaving a broken record for the author to discover.
    var impFixIds: string[] = [];
    if (data.characters && Array.isArray(data.characters)) {
        for (const c of data.characters.filter(Boolean)) {
            var mc = migrateCharacter(c, activeCfg);
            mc.entityId = mc.id;
            await saveCharacter(mc);
            impFixIds.push(mc.id);
            result.charCount++;
        }
    } else if (data.character && typeof data.character === 'object' && !Array.isArray(data.character)) {
        var mc1 = migrateCharacter(data.character, activeCfg);
        mc1.entityId = mc1.id;
        await saveCharacter(mc1);
        impFixIds.push(mc1.id);
        result.charCount = 1;
    } else if (data.id && data.name && !data.type && !data.entities && !data.locations && !data.characters) {
        // Bare root-level CharacterRecord — no `type` field distinguishes it from entity
        var mc2 = migrateCharacter(data, activeCfg);
        mc2.entityId = mc2.id;
        await saveCharacter(mc2);
        impFixIds.push(mc2.id);
        result.charCount = 1;
    }

    // 4. Entities — array (with backwards-compat alias), singular block, or bare root record
    const rawNodes: any[] = Array.isArray(data.entities) ? data.entities
                          : Array.isArray(data.locations) ? data.locations   // pre-v0.9 exports
                          : [];
    if (rawNodes.length > 0) {
        for (const n of rawNodes.filter(Boolean)) {
            await saveEntity(migrateEntity(n));
            result.entityCount++;
        }
    } else if (data.entity && typeof data.entity === 'object' && !Array.isArray(data.entity)) {
        await saveEntity(migrateEntity(data.entity));
        result.entityCount = 1;
    } else if (data.id && data.name && data.type && !data.characters && !data.entities && !data.locations) {
        // Bare root-level EntityRecord — presence of `type` (entity kind) is the signal
        await saveEntity(migrateEntity(data));
        result.entityCount = 1;
    }

    // [ENT-ID1] Body repair runs AFTER the entity block, not inside the character
    // block: an import that carries both arrays may well contain the character's own body
    // under its own id already, in which case ceProfileEnsureBody sees it and does nothing.
    // Running earlier would mint a duplicate that the entity block then overwrote.
    for (var ifI = 0; ifI < impFixIds.length; ifI++) {
        try { await ceProfileEnsureBody(impFixIds[ifI]); } catch (e) { /* non-fatal */ }
    }

    // [F-30] REGENERATE THE STANDINGS ONCE THE FACTIONS ARE IN. ceSyncStandingDefs reads
    // faction ENTITIES (F-28), so it cannot run in the config block above -- the factions it
    // needs arrive in the entity block that just finished. Before this, an imported faction
    // produced no standing def until the story was next opened, and an imported standingRest
    // did not take effect until then either. Non-fatal: a failure here is repaired by the
    // boot-time call, which is the same guarantee that function's own header claims.
    try { await ceSyncStandingDefs(); } catch (eSs) { api.v1.error('[AE:import] standing sync:', eSs); }

    // 5. NPC Web — [IMPORT-MERGE] upserted by `id`, same as the config
    //    arrays (was: full replace, which silently dropped any web link the
    //    import didn't happen to include).
    if (data.npcWeb && Array.isArray(data.npcWeb)) {
        if (typeof loadNpcWeb === 'function' && typeof saveNpcWeb === 'function') {
            const priorWeb = await loadNpcWeb();
            const webRes = mergeArrayById(priorWeb, data.npcWeb, function(x: any) { return x && x.id; });
            await saveNpcWeb(webRes.merged);
            result.npcWebCounts = webRes.counts;
        }
        result.npcWebImported = true;
    }

    return result;
}

// ============================================================================
// PLAIN-JSON IMPORT / EXPORT
// Uses api.v1.file.save() and api.v1.file.prompt() — no bridge required.
// Produces a human-readable, tool-friendly JSON file using the importPayload()
// schema, fully compatible with the existing smart importer.
// ============================================================================

// ── [LEAN] PRUNE TO THE DEFAULT, WHICH IS LOSSLESS BY CONSTRUCTION ──────────────────────
// migrateCharacter is `{ ...makeDefaultCharacter(cfg), ...raw }` and migrateEntity defaults
// every absent field, so ANY field omitted from an export is restored on import. That is what
// makes this a pruner and not an allowlist -- and an allowlist is exactly what it must not be:
// buildCharProfilePayload is the standing lesson in this file about what a hand-maintained
// field list costs, and an export that dropped a field somebody added last week would be the
// same failure with a slower fuse. Nothing here names a field. It names DEFAULTS, and the
// factories are the defaults.
//
// WHAT IT BUYS, on the author's own export: the 58-entry customStaticFields seed block, every
// untouched wizard section, every unmodified state def, and avatarWidth 1024 on every
// character -- most of the file, none of the world.
//
// THE ONE ASYMMETRY, AND IT IS REAL. Records are REPLACED on import (saveCharacter/saveEntity)
// so a pruned record restores exactly. The config is MERGED (mergeConfigForImport), so a
// pruned config key leaves the destination's value standing rather than resetting it to the
// default. Into a fresh story those are the same thing. Into a story whose author has already
// changed that key they are not, and lean is the friendlier of the two behaviours: it says
// "here is what I changed", not "here is everything, including the parts I never touched".
// Export the full file when you mean to overwrite.
//
// VERSION-COUPLED, DELIBERATELY UNGUARDED. Pruning is lossless only while the reader's
// defaults match the writer's; a changed default silently changes what a pruned file means.
// schemaVersion rides in the payload for a reader that ever needs to care. Nothing warns
// today because nothing yet CAN care, and a check that only prints a number is not a check.
function ceDeepEq(a: any, b: any): boolean {
    if (a === b) return true;
    if (a === null || b === null || a === undefined || b === undefined) return false;
    if (typeof a !== typeof b) return false;
    if (typeof a !== 'object') return false;   // primitives were settled by === above
    var aArr = Array.isArray(a), bArr = Array.isArray(b);
    if (aArr !== bArr) return false;
    var i: number;
    if (aArr) {
        if (a.length !== b.length) return false;
        for (i = 0; i < a.length; i++) { if (!ceDeepEq(a[i], b[i])) return false; }
        return true;
    }
    var ka = Object.keys(a), kb = Object.keys(b);
    if (ka.length !== kb.length) return false;
    for (i = 0; i < ka.length; i++) {
        if (!Object.prototype.hasOwnProperty.call(b, ka[i])) return false;
        if (!ceDeepEq(a[ka[i]], b[ka[i]])) return false;
    }
    return true;
}

// A record minus every field that already equals the factory's. `keep` is the identity a
// reader needs before it can do anything at all -- id and name, plus type for an entity,
// which importPayload's bare-record detection reads to tell a character from a node.
function ceLeanRecord(rec: any, def: any, keep: string[]): any {
    var out: any = {};
    for (var k in rec) {
        if (!Object.prototype.hasOwnProperty.call(rec, k)) continue;
        if (keep.indexOf(k) >= 0) { out[k] = rec[k]; continue; }
        if (Object.prototype.hasOwnProperty.call(def, k) && ceDeepEq(rec[k], def[k])) continue;
        out[k] = rec[k];
    }
    return out;
}

// [LEAN] THE ID-KEYED CONFIG ARRAYS ARE PRUNED PER ELEMENT, not whole. This is the entire
// size win and it is only correct because the importer UPSERTS THEM BY id
// (mergeArrayById): a config carrying two of fifty-eight static fields merges as two, and
// the other fifty-six are already there. A non-id array (standingLadder, calendar.months)
// is all-or-nothing and falls to the whole-value comparison below, correctly -- half a
// ladder is not a ladder.
// KEPT IN STEP WITH mergeConfigForImport BY HAND, and that is a real coupling: an array
// pruned here but not upserted there would export as a fragment and import as a
// replacement. The list below is the same list, in the same order.
var CE_LEAN_ID_ARRAYS: string[] = [
    'sheetCategories', 'customStaticFields', 'customLocationFields', 'customItemFields',
    'customFactionFields', 'customNarrativeFields', 'relationshipArchetypes', 'species', 'wizardSections',
    'stateDefs', 'resolutionDefs', 'stakeDefs', 'actionPresets', 'datedEntries'
];

function ceLeanConfig(cfg: any): any {
    var def: any = makeDefaultConfig();
    var out: any = {};
    for (var k in cfg) {
        if (!Object.prototype.hasOwnProperty.call(cfg, k)) continue;
        // LIVE STORY STATE, NEVER EXPORTED. importPayload already refuses totalGenerations;
        // graveyardEntityId names an entity in THIS story and would point at nothing (or at
        // something else) anywhere else.
        if (k === 'totalGenerations' || k === 'graveyardEntityId') continue;
        var v: any = cfg[k];
        if (CE_LEAN_ID_ARRAYS.indexOf(k) >= 0 && Array.isArray(v)) {
            var dl: any[] = Array.isArray(def[k]) ? def[k] : [];
            var kept: any[] = [];
            for (var i = 0; i < v.length; i++) {
                var it: any = v[i];
                if (!it) continue;
                // [F-25] A MANAGED DEF IS A DERIVATION AND IS NOT SHIPPED. ceSyncStandingDefs
                // rebuilds every standing from its faction on load, so exporting one exports
                // a copy that the destination will overwrite from ITS factions anyway -- and
                // a standing whose faction did not come with the file would be a def naming
                // an owner that does not exist until the next sync deletes it.
                if (k === 'stateDefs' && it.managed) continue;
                var match: any = null;
                for (var d = 0; d < dl.length; d++) {
                    if (dl[d] && String(dl[d].id) === String(it.id)) { match = dl[d]; break; }
                }
                // [LEAN-SEED] THE DEFAULT ARRAY IS NOT ALWAYS THE DEFAULT STATE.
                // makeDefaultConfig returns customStaticFields: [], but migrateConfig
                // re-seeds it from BUILTIN_FACETS on EVERY load -- so the comparison above
                // finds nothing to match and ships all of the engine's own facet defs as if
                // the author had written them. That is the whole of this array in a virgin
                // export. Same reasoning as [F-25]: a def the destination rebuilds for
                // itself is not shipped. An author who TUNED a builtin (label, instructions,
                // placeholder) differs from the seed and still ships, which is the half that
                // matters -- migrateConfig's upsert-if-missing will not overwrite it.
                // The other entity catalogs need no such clause: customLocationFields,
                // customItemFields, customFactionFields and customNarrativeFields are
                // defaulted to [] and never seeded (LOCATION_FACETS / FACTION_FACETS /
                // NARRATIVE_FACETS are the catalog `base`, a separate channel), so
                // everything in them is genuinely author-minted.
                if (!match && k === 'customStaticFields') {
                    var bseed: any = null;
                    for (var b = 0; b < BUILTIN_FACETS.length; b++) {
                        if (String(BUILTIN_FACETS[b].id) === String(it.id)) { bseed = BUILTIN_FACETS[b]; break; }
                    }
                    // Compared on the fields migrateConfig actually writes, not on the whole
                    // object: the seed row it builds carries exactly these six, so a deep
                    // compare against the catalog entry (which also has `budget` and friends)
                    // would never match and the prune would do nothing.
                    if (bseed
                        && String(it.slot || '') === String(bseed.slot || '')
                        && String(it.label || '') === String(bseed.label || '')
                        && String(it.placeholder || '') === String(bseed.placeholder || '')
                        && String(it.instructions || '') === String(bseed.instructions || '')
                        && String(it.kind || 'facet') === String(bseed.kind || 'facet')) continue;
                }
                if (match && ceDeepEq(it, match)) continue;
                kept.push(it);
            }
            if (kept.length) out[k] = kept;
            continue;
        }
        if (Object.prototype.hasOwnProperty.call(def, k) && ceDeepEq(v, def[k])) continue;
        out[k] = v;
    }
    return out;
}

// [LEAN] `lean` defaults TRUE. The button that says "Export JSON" is the one people press,
// and the lean file is the one that is readable, diffable and small enough to paste into a
// conversation -- which is what an export is mostly for. The full file stays one button
// along for the case lean cannot serve: overwriting a destination that has already been
// customised (see the asymmetry note above).
async function exportAll(lean?: boolean): Promise<void> {
    const xaLean = (lean !== false);
    try {
        const xaCfg    = await loadConfig();
        const xaChars  = await loadAllCharacters();
        const xaEntIdx = await loadEntityIndex();
        const xaEnts: EntityRecord[] = [];
        for (const xaM of xaEntIdx.filter(Boolean)) {
            const xaE = await loadEntity(xaM.id);
            if (xaE) xaEnts.push(xaE);
        }
        const xaNpcWeb    = typeof loadNpcWeb    === 'function' ? await (loadNpcWeb as any)().catch(function() { return []; })    : [];

        // [LEAN] Built from the SAME loaded records either way -- the prune is a projection
        // over what was read, never a second read with different rules.
        let xaOutCfg: any   = xaCfg;
        let xaOutChars: any = xaChars;
        let xaOutEnts: any  = xaEnts;
        if (xaLean) {
            xaOutCfg = ceLeanConfig(xaCfg);
            xaOutChars = xaChars.map(function(xaC: any) {
                let xaLc: any = ceLeanRecord(xaC, makeDefaultCharacter(String(xaC.name || ''), xaCfg), ['id', 'name']);
                // [ENT-ID1] entityId IS the id and the importer re-derives it unconditionally
                // (mc.entityId = mc.id) -- so shipping it ships a fact the reader ignores.
                // Dropped only when it actually matches; a record that somehow disagrees keeps
                // its pointer and stays diagnosable.
                if (String(xaLc.entityId || '') === String(xaC.id)) delete xaLc.entityId;
                // A blank schedule is not built by makeDefaultCharacter (loadCharacter fills
                // it), so the factory comparison cannot see it. ceSchedBlank IS its default.
                if (xaLc.schedule && ceDeepEq(xaLc.schedule, ceSchedBlank())) delete xaLc.schedule;
                return xaLc;
            });
            xaOutEnts = xaEnts.map(function(xaE2: any) {
                return ceLeanRecord(xaE2, makeDefaultEntity(String(xaE2.name || '')), ['id', 'name', 'type']);
            });
        }

        const xaData = {
            _ae:        true,
            // [ENT-ID1] schemaVersion is what an importer compares against; aeVersion
            // is a fossil ('0.9.9.2' was hardcoded here for the whole 2.x and 3.x line) and
            // is kept ONLY so an older reader still recognises the file. Nothing reads it.
            schemaVersion: CE_SCHEMA_VERSION,
            aeVersion:  '0.9.9.2',
            exportedAt: new Date().toISOString(),
            config:     xaOutCfg,
            characters: xaOutChars,
            entities:   xaOutEnts,
            npcWeb:     xaNpcWeb
        };

        const xaSafeName = ((xaCfg as any).projectName || 'ae_world').replace(/[^a-z0-9]/gi, '_').toLowerCase();
        const xaText = JSON.stringify(xaData, null, 2);
        await api.v1.file.save(xaSafeName + (xaLean ? '_export.json' : '_export_full.json'), xaText);
        // THE RECEIPT NAMES THE SAVING, because "lean" is a claim and a percentage is the
        // evidence. Costs one extra stringify of the unpruned payload, on a button press,
        // once -- and it is the only way an author can tell the prune ran at all.
        let xaNote = '';
        if (xaLean) {
            try {
                const xaFullLen = JSON.stringify({ _ae: true, schemaVersion: CE_SCHEMA_VERSION,
                    aeVersion: '0.9.9.2', exportedAt: xaData.exportedAt, config: xaCfg,
                    characters: xaChars, entities: xaEnts, npcWeb: xaNpcWeb }).length;
                const xaCut = xaFullLen > 0 ? Math.round((1 - (JSON.stringify(xaData).length / xaFullLen)) * 100) : 0;
                if (xaCut > 0) xaNote = ' (lean \u2014 ' + xaCut + '% smaller)';
                else xaNote = ' (lean)';
            } catch (eSz) { xaNote = ' (lean)'; }
        }
        api.v1.ui.toast('Exported: ' + xaChars.length + ' characters, ' + xaEnts.length + ' nodes' + xaNote + '.', { type: 'success', autoClose: 3000 });
    } catch (e) {
        api.v1.error('[AE] exportAll failed:', e);
        api.v1.ui.toast('Export failed — see engine log.', { type: 'error' });
    }
}

async function importData(): Promise<void> {
    try {
        const raw = await api.v1.file.prompt({ accept: '.json,application/json,text/plain,*/*', readAs: 'text' });
        if (!raw || typeof raw !== 'string') return;

        const data = JSON.parse(raw);
        const result = await importPayload(data);

        const parts: string[] = [];
        if (result.configImported) {
            const cc = sumMergeCounts(result.configCategoryCounts);
            parts.push((cc.added + cc.updated) > 0 ? `settings (${cc.added} added, ${cc.updated} updated)` : 'settings');
        }
        if (result.charCount > 0)      parts.push(result.charCount + ' character' + (result.charCount !== 1 ? 's' : ''));
        if (result.entityCount > 0)    parts.push(result.entityCount + ' node' + (result.entityCount !== 1 ? 's' : ''));
        if (result.npcWebImported) {
            const wc = result.npcWebCounts || { added: 0, updated: 0 };
            parts.push((wc.added + wc.updated) > 0 ? `NPC web (${wc.added} added, ${wc.updated} updated)` : 'NPC web');
        }
        if (result.partyStateImported) parts.push('party state');

        if (!parts.length) {
            api.v1.ui.toast('File loaded but no recognisable AE data found.', { type: 'warning', autoClose: 3500 });
            return;
        }
        api.v1.ui.toast('Imported: ' + parts.join(', ') + '.', { type: 'success', autoClose: 3500 });
    } catch (e) {
        api.v1.error('[AE] importData failed:', e);
        api.v1.ui.toast('Import failed — check that the file is valid JSON.', { type: 'error' });
    }
}

// ============================================================================
// SECTION 26 — HOOK REGISTRATIONS
// All api.v1.hooks.register() calls.
//
//    ADVENTURE ENGINE PIPELINE:
//    onBeforeContextBuild  → world-state AN injection (AE context builder S13)
//    onLorebookEntrySelected → lore ID tracking
//    onContextBuilt        → imperative block (GM note + knowledge query) + probability
//    onGenerationEnd       → token count + runDynamicEngine (S15)
//    onHistoryNavigated    → retry/undo skip flag
//
// ============================================================================

const AE_AN_SENTINEL = '[ Scene State ]';
// [earlier AN-FIX] Sentinel bracketing the wizard-owned region of the persisted AN.
// Final layout of the AN slot at generation time:
//   [user manual content, if any]
//   \n\n[ World Style ]          <- AE_WIZ_AN_SENTINEL (persisted by commitWizardMemory)
//   [wizard style/tone AN sections]
//   \n\n[ Scene State ]          <- AE_AN_SENTINEL (ephemeral, appended per-generation)
//   [quest line + world state + drama]
// Style first so the model frames itself before reading the immediate scene.
// Scene last so it carries the highest recency weight inside the AN slot.
const AE_WIZ_AN_SENTINEL = '[ World Style ]';

// [WIZMODE] Hard switch: block any user/story-initiated generation while the
// wizard mode is on. Our own yoink call sets _aeYoink.active BEFORE it calls
// api.v1.editor.generate() (see executeYoinkGenerationAttempt), so by the time this
// hook fires for that call, _aeYoink.active is already true and it passes through.
api.v1.hooks.register('onGenerationRequested', async function(params: any) {
    // [ENGINE-THINKING-SIGNAL] Deliberately BEFORE the probe guard below --
    // "any of our thinking" per the user's own framing covers ephemeral/architect probes too,
    // not just user-visible story generation. If that turns out too noisy live (rapid flicker
    // across a busy scene's nested calls), move this after the guard instead.
    try { await _aeThinkingPulse(true); } catch (eEtS) { aeLog('[AE:engine-thinking] start pulse failed:', eEtS); }
    if (_diagProbeActive) return; // [DIAG] api.v1.generate() probe call — not a story generation

    // [CHARCHAT-DOM-INJECT] an earlier commit-on-Send block is REMOVED from this hook.
    // It appended the draft here on the reading that onGenerationRequested fires "before
    // context is built" and therefore in time. Live test falsified that: the model replied
    // "..." to what was effectively an empty prompt. Rather than chase whether the hook fired
    // or whether NAI snapshots the document before it, the design stopped needing to know --
    // the bridge now writes the turn into NAI's editor at pointerdown on NAI's Send, so the
    // turn is ordinary typed document text before NAI's own click handler even runs and this
    // hook has no job in the chat send path at all. See the CE-INDEX CHARCHAT-DOM-INJECT
    // entry and op 'povclaim' in handleCharChatAction.
    //
    // NOTHING replaces it here deliberately: the whole lesson of earlier is that this hook is
    // the wrong place to put the user's turn into the document. Do not add it back.

    // [WIZ-TRAILBREAK] PREVENTION, WHICH WIZLIVE NEVER HAD. The merge-split
    // machinery is the CURE for NAI continuing a reply directly into the Director paragraph
    // the author just typed; CharChat also has the prevention, _charchatEnsureTrailingBreak,
    // which appends an empty paragraph so there is nowhere to glue. WIZLIVE could not port
    // it with the rest of WIZLIVE-MERGE because CharChat calls it from its own fire point
    // and WIZLIVE rides NAI's native Send. THIS hook is the equivalent moment: the turn is
    // already ordinary typed text, nothing is generated yet, and the hook is otherwise idle
    // for a wizard turn. Non-fatal by design — a failure here just leaves the old
    // behaviour, which the split pass still tries to rescue.
    if (_aeLiveWiz.active && !_aeYoink.active) {
        try { await _wizliveEnsureTrailingBreak(); }
        catch (eTb) { aeLog('[AE:wizlive] trailing-break ensure failed (reply may glue):', eTb); }
    }

    // [F-15b] THE ARMED MOVE IS NOT FIRED HERE, AND THIS BLOCK RECORDS WHY SO IT IS NOT
    // MOVED BACK. 3.0.66/67 fired it here on the typings' own wording -- this hook runs
    // "before context is built" and its params carry no `dryRun`, so it looked like the one
    // hook a costing pass could not reach. It rolled correctly every time and the directive
    // reached the model NEVER: the roll's own await chain (config, character, modifier,
    // every worn item, the commit's terminal check) was still in flight when onContextBuilt
    // drained the queue and found it empty.
    // CHARCHAT-DOM-INJECT, six lines up, is the SAME FINDING about the same hook and should
    // have been read as one: work started here is not guaranteed to have landed by the time
    // context is assembled. The fire now sits in onBeforeContextBuild, whose async work
    // demonstrably does reach context, and whose ordering before onContextBuilt is
    // guaranteed within one generation. DO NOT PUT GENERATION-CRITICAL ASYNC WORK HERE.
});

api.v1.hooks.register('onBeforeContextBuild', async function(params: any) {

    // [CHARCHAT-OVERRIDE-LEAK] Nested-generate guard. One of OUR OWN
    // api.v1.generate() calls is in flight (budget probe, generateEphemeral, the image
    // architect — aeDiagGenerate sets this for all of them now). api.v1.generate() fires
    // the full hook lifecycle, so without this the call inherits whatever override the
    // branches below apply and stops being the isolated prompt its caller built. That is
    // exactly what leaked buildCharChatInstruction's bracket block into the document and
    // broke the ephemeral/architect JSON parses. The old log line here fired on every such
    // call once the guard actually covered them all; the question it was asking
    // ("does api.v1.generate build story context?" — yes, it does) is answered and settled
    // in the CE-INDEX, so it is gone rather than left to spam the console every turn.
    if (_diagProbeActive) return;

    // [vNEXT] Yoink hijack active — leave the context alone; our prompt is swapped
    // in at onContextBuilt. Returning nothing means no world-state AN injection.
    if (_aeYoink.active) return;

    // [WIZLIVE] In-document wizard chat turn. The story prefix (system prompt,
    // memory, lorebook) is left completely untouched — prefix caching must survive the
    // chat — and the Author's Note is deactivated (a tail-of-context change only), per
    // the design: story style directives must not steer chat replies. No world-state
    // injection, no scene lorebook activation. Applied on the dryRun pass too so the
    // cost estimate matches the real turn.
    // [WIZLIVE-BRACE-WRAP-T1] Wrap any still-unwrapped Director turn so the first
    // message is presented correctly instead of reaching the model raw for one turn.
    // [WIZLIVE-CTX-STRIP] Two structural fixes ported from
    // CharChat's hardened pipeline: (1) Director turns now have their "Director:" header
    // stripped in the model's view — the model sees plain instruction-brace text, removing
    // the prefix it was imitating (mirrors CHARCHAT-CTX-BRACE earlier). (2) A true-bottom
    // instruction (buildWizardChatInstruction) is appended to storyText, immediately before
    // the generation point — mirrors buildCharChatInstruction. These are the two structural
    // decisions CharChat received across earlier-earlier that WIZLIVE had never gotten.
    if (_aeLiveWiz.active) {
        let wlResult: any = { authorsNote: { active: false, content: '' } };
        // [WIZLIVE-INSTRUCTION] Two changes to storyText:
        // (1) _wizliveCanonicalStoryOverride now strips the "Director:" header from the
        //     model's view (document keeps it), so the model sees plain instruction-brace
        //     text with no prefix to imitate — mirrors CHARCHAT-CTX-BRACE earlier.
        // (2) buildWizardChatInstruction is appended at the TRUE BOTTOM of storyText,
        //     immediately before the generation point — mirrors buildCharChatInstruction.
        //     This is the structural fix for both "model writes as the Director" and
        //     "user input not recognised as instruction": the only reliable position for
        //     a steering directive is the last thing the model reads before generating.
        //     The protocol text (setup paragraph) is still valuable as user-facing
        //     framing, but the model's actual constraint now comes from here.
        try {
            let wlStory = await _wizliveCanonicalStoryOverride(params);
            let wlBase = (wlStory !== null) ? wlStory
                       : ((params && params.storyText && params.storyText.content) ? params.storyText.content : '');
            if (wlBase) {
                wlBase = wlBase.replace(/\s+$/, '');
                wlBase += '\n\n' + buildWizardChatInstruction();
                // [BUGFIX earlier WIZLIVE-USERTOKEN, mirrors CHARCHAT-USERTOKEN earlier] Same root
                // cause, same fix. buildWizardChatInstruction's last line is a CLOSED bracket block
                // ('[ Write in pure prose... ]'), so the model reads a complete, well-formed thing at
                // the generation point and the likely next token is the chat-template end-of-turn
                // control token \u2014 a zero-length completion with a perfectly normal lifecycle
                // around it, indistinguishable from CharChat's bug until the user's own NAI
                // token-probability capture proved it there. End on a dangling speaker cue instead.
                // UNLIKE CharChat, no companion strip is needed: _wizliveNormalizeDocument already
                // never stamps a 'Wizard:' header on Wizard's replies (only Director turns get
                // header/brace treatment \u2014 see its own comment, "Wizard replies pass through
                // untouched"), and onResponse's WIZLIVE branch does no cleanup at all (early
                // return, raw passthrough). storyText is INPUT context only, never written to the
                // document \u2014 the model's own completion continues PAST 'Wizard:' rather than
                // regenerating it, so the written document stays exactly the header-less prose it
                // always was. Nothing downstream needed to change.
                if (!CE_DIAG.wlNoPrefill) {
                    wlBase += '\n\nWizard:';
                } else {
                    aeLog('[AE:diag] wlNoPrefill ON \u2014 context ends on a closed block (pre-v2.70.0 shape).');
                }
                wlResult.storyText = { active: true, content: wlBase };
            }
        } catch (eWl) { api.v1.error('[AE:wizlive] context override failed \u2014 story text left raw this turn:', eWl); }
        _ceCtxCapture(params, wlResult, 'wizlive');   // [CTX-CENSUS]
        return wlResult;
    }

    // [CHARCHAT] In-story character chat turn. The OPPOSITE trade to WIZLIVE
    // above: we take the whole prompt (system prompt, lorebook activation, Author's
    // Note, story text) rather than protecting the prefix cache. Story generation
    // cannot run while a chat is open, so every generation reaching this line IS a
    // chat turn — which is what makes applying the override unconditionally safe.
    // Applied on the dryRun pass too, deliberately: that makes NAI's own context
    // viewer the debugging window for the whole subsystem. See the CHARCHAT section.
    if (_aeCharChat.active) {
        // [DIAG CE-DIAG-FLAGS] ccRawContext — leave NAI's context completely untouched for
        // this chat turn. DIAGNOSTIC ONLY, not a real mode: no system prompt swap, no
        // lorebook suppression, no chat-region rebuild, no instruction tail. Isolates
        // whether the override itself (rather than anything downstream of it) is
        // implicated in the empty-reply bug.
        if (CE_DIAG.ccRawContext) { aeLog('[AE:diag] ccRawContext ON \u2014 context override skipped for this chat turn.'); return undefined; }
        var ccOverride: any = await runCharChatContextOverride(params);
        _ceCtxCapture(params, ccOverride, 'charchat');   // [CTX-CENSUS]
        return ccOverride;
    }

    // ── AE path: Authors Note world-state injection ──────────────────────────
    if (params.dryRun) return;
    _ceImpNoteStory(params);   // [IMP-PIVOT] read-only, unconditional -- a turn with nothing queued still answers the position question
    diagBudgetSnapshot('STORY', (params && params.continuityId) || null);   // [DIAG] pre-read for a real story turn
    await api.v1.tempStorage.set(STORAGE_LORE_IDS, '[]').catch(function() {});
    // [F-4] THE SUMMON WINDOW OPENS HERE. The last section that exists before generation is
    // the author's own input, so the window is "your line plus whatever the model wrote
    // after it" -- a name you typed summons as readily as a name the model produced.
    // A SECTION ID, NOT A COUNT: ids are not indexes and are not ordered, so the reader
    // locates this id in sectionIds() and takes the tail from there. A stale id (undo past
    // the anchor) simply is not found and the reader falls back to a short tail.
    try {
        let _smIds: any[] = await api.v1.document.sectionIds();
        await api.v1.tempStorage.set(STORAGE_SUMMON_ANCHOR,
            (_smIds && _smIds.length) ? String(_smIds[_smIds.length - 1]) : '');
    } catch (_eSmA) { /* no anchor means the short tail, which is a working window */ }

    // [F-15d] NO ROLL FIRES FROM ANY GENERATION HOOK. THIS IS THE THIRD PLACEMENT AND THE
    // LAST, because the third attempt is where guessing stops being engineering.
    // 3.0.66 fired at onGenerationRequested: rolled on time, queued too late.
    // 3.0.68 fired here, one hook earlier: /ce imp then measured it end to end and returned
    //   "queued 69 chars, read straight back as 69, drain ran, nothing spliced, slot now
    //   empty" -- the write landed and the drain consumed it WITHOUT splicing. Whatever the
    //   remaining mechanism is, two different in-lifecycle placements failed and the one
    //   architecture that provably works does not sit in the lifecycle at all.
    // AE QUEUED FROM A BUTTON HANDLER, outside the generation entirely, and then triggered
    // generation itself. The roll now does the same: ceRollNow runs on a press, writes the
    // slot, and is finished long before NAI is asked for anything. The drain reads a slot
    // that was filled a whole interaction earlier, which is the only ordering that has ever
    // been observed to work here.
    // IT ALSO BUYS SOMETHING THE OLD FLOW COULD NOT HAVE: a terminal that needs the author
    // to CHOOSE (death or merely down) can ask them, because a button press is a place a
    // question can be asked and mid-generation is not.

    // [D-17] Every slot write for a story turn is a row in CE_INJECTIONS; this is the
    // only call site. Do not assign onto aeResult here -- add a row.
    let aeResult: any = {};
    await ceRunInjections(params, aeResult);

    // [F-19b] THE storyText APPEND IS DELETED. It drained STORAGE_PENDING_INJECT here and
    // fenced the directive onto the tail of storyText -- the F-18 mechanism. The pivot moves
    // delivery to a trailing USER MESSAGE at onContextBuilt (grep IMP-PIVOT), because the
    // measured Xialong context is a role-tagged message array and a user turn is the register
    // the story model wants. The slot is NOT drained here any more; it is drained one hook
    // later. Nothing is appended to storyText on the story path.
    _ceCtxCapture(params, aeResult, 'story');   // [CTX-CENSUS]
    return Object.keys(aeResult).length > 0 ? aeResult : undefined;
});

api.v1.hooks.register('onLorebookEntrySelected', async function(params: any) {
    try {
        if (!params.entryId) return;
        const raw = await api.v1.tempStorage.getOrDefault(STORAGE_LORE_IDS, '[]') as string;
        const ids: string[] = JSON.parse(raw);
        if (!ids.includes(params.entryId)) {
            ids.push(params.entryId);
            await api.v1.tempStorage.set(STORAGE_LORE_IDS, JSON.stringify(ids));
        }
    } catch (e) { api.v1.error('[AE] LoreTracking error:', e); }
});


api.v1.hooks.register('onResponse', async function(params: any) {
    // [DIAG] Probe guard — do not swallow; api.v1.generate returns text via its own value.
    if (_diagProbeActive) return;   // nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.
    // [vNEXT] While a yoink generation is active, buffer the streamed chunks and
    // swallow them so nothing reaches the user's document. Inert otherwise.
    // Discriminate by continuityId when we have one: a response belonging to a
    // DIFFERENT generation is either a story turn or a late chunk from a generation the
    // watchdog abandoned, and must not be swallowed into the wizard's buffer.
    //
    // FAIL-SAFE: if we never captured a continuityId (older NAI build, or the field is
    // absent), fall back to the earlier behavior of swallowing while active. Leaking
    // wizard prose into the user's story is far worse than over-swallowing.
    // [WIZMODE] Swallow ALL output unconditionally while wizard mode is on, and
    // for any zombie continuityId left over from a watchdog-abandoned generation, even
    // after mode has since exited. This replaces the old "leave someone else's text
    // untouched" branch — that was the exact gap that let mismatched/abandoned yoink
    // output leak into the story. Only genuinely-ours chunks get buffered; everything
    // else is swallowed silently rather than passed through.
    const ygZombie = !!(params && params.continuityId && _wizZombieIds[params.continuityId]);
    if (_aeYoink.active || ygZombie) {
        let ygMine = _aeYoink.active && (!_aeYoink.continuityId || !params || !params.continuityId || params.continuityId === _aeYoink.continuityId);
        if (ygMine && params && params.text && Array.isArray(params.text)) {
            _aeYoink.responseText += params.text.join('');
        }
        return { text: [''] };
    }

    // [CHARCHAT] Clean the reply before it lands in the document. Native
    // generation exposes no per-turn stop sequences, so this regex net plus native
    // turn alternation is the whole anti-impersonation defence.
    //
    // STREAMING: this hook can fire many times per generation with partial chunks, and
    // a cleanup pass cannot run correctly across a chunk boundary (an impersonation
    // marker can straddle two chunks). Returning { seenData: false } while !final tells
    // NAI to re-deliver the same data plus anything new on the next call, so the final
    // call carries the entire reply and we clean it once, whole. On the final call
    // seenData has no effect, per the hook contract.
    // [UNVERIFIED — watch this in P1 testing] whether deferring seenData this way also
    // defers the streamed text appearing in the editor. If replies visibly land all at
    // once instead of streaming in, this is why, and the fix is to clean only on final
    // without the seenData deferral (accepting cross-chunk misses).
    if (_aeCharChat.active) {
        // [CHARCHAT-THOUGHT-POST] an earlier thoughtPass passthrough is DELETED with the
        // flag it read. It existed because the thought used to arrive through THIS hook (it was
        // NAI's own generation) and was being cleaned as if it were a reply — header stamped,
        // truncated at the first POV name, emotion-parsed. That cannot happen now: the thought
        // is a direct api.v1.generate() call, aeDiagGenerate sets _diagProbeActive around it,
        // and this hook's own probe guard returns before reaching here. Everything below is a
        // reply again, unconditionally, exactly as in earlier.

        // [DIAG earlier CHARCHAT-RESP-DIAG] Record every call before any early-out. The three
        // early-outs below (!final, text-not-an-array, whitespace-only) were ALL silent, which
        // is why an empty-looking turn has been indistinguishable from a lost one for five
        // versions. See the _ccRespCid declaration for what the counts mean.
        let ccRespCid = String((params && params.continuityId) || '');
        if (ccRespCid !== _ccRespCid) { _ccRespCid = ccRespCid; _ccRespCalls = 0; _ccRespBest = ''; _ccRespFinalSeen = false; }
        _ccRespCalls++;
        let ccRespChunk = (params && Array.isArray(params.text)) ? params.text.join('') : '';
        if (ccRespChunk.length > _ccRespBest.length) _ccRespBest = ccRespChunk;
        aeLog('[AE:charchat:resp] call#' + _ccRespCalls
            + ' final=' + !!(params && params.final)
            + ' isArray=' + (!!(params && Array.isArray(params.text)))
            + ' len=' + ccRespChunk.length + ' bestLen=' + _ccRespBest.length
            + ' head=' + JSON.stringify(ccRespChunk.substring(0, 60)));

        if (!params || !params.final) {
            // [DIAG CE-DIAG-FLAGS] ccNoSeenDefer — do not request re-delivery. The chunk is
            // left untouched (no seenData override) instead of asking NAI to replay it plus
            // future chunks on the next call. _ccRespBest above still tracks the longest chunk
            // seen for the diag summary either way; this only changes what NAI does with the
            // data, not what we observe. Accepts cross-chunk impersonation-marker misses in
            // exchange for testing whether the deferral itself is implicated in the empty-reply
            // failure (CE-INDEX flags this contract behaviour as unverified — see the deferral's
            // own header comment above).
            if (CE_DIAG.ccNoSeenDefer) return;
            return { seenData: false };
        }
        _ccRespFinalSeen = true;

        // [BUGFIX earlier CHARCHAT-RESP-RESCUE] The deferral safety net. seenData:false asks NAI
        // to re-deliver everything on the next call, and script-types confirms that is the
        // contract ("the same data in addition to any new data" / "if this is the final call,
        // this has no effect"). What the contract does NOT promise is that the FINAL call
        // re-delivers a buffer that was deferred by the call before it. If it does not, the
        // reply is destroyed here, silently, with a perfectly normal generation lifecycle
        // around it — which is exactly the reported symptom. So: if the final call arrives
        // without usable text but we watched real text go past on an earlier call, use what we
        // saw instead of dropping the turn. When the contract behaves as documented this branch
        // never fires and behaviour is byte-identical to earlier.
        let ccFinalRaw = (params.text && Array.isArray(params.text)) ? params.text.join('') : '';
        let ccRawReply = ccFinalRaw;
        if (!ccRawReply.trim() && _ccRespBest.trim()) {
            aeLog('[AE:charchat:resp] RESCUE — the final call carried '
                + (params.text && Array.isArray(params.text) ? 'an empty text array' : 'no text array')
                + ' but ' + _ccRespBest.length + ' chars were delivered earlier this turn and deferred with '
                + 'seenData:false. Using the deferred text. THIS CONFIRMS THE DEFERRAL LOSES REPLIES — '
                + 'see CHARCHAT-RESP-DIAG; the deferral itself should now be removed rather than patched.');
            ccRawReply = _ccRespBest;
        }
        if (!ccRawReply.trim()) {
            aeLog('[AE:charchat:resp] final call and nothing was ever delivered this turn ('
                + _ccRespCalls + ' call(s), longest 0 chars). The model genuinely returned no text — '
                + 'this is NOT a document or cleanup problem, do not look downstream.');
            return;
        }
        let ccEmo = charChatParseEmotion(ccRawReply);
        if (ccEmo) { _aeCharChat.lastEmotion = ccEmo; }
        // No thought to parse out of the reply anymore — CHARCHAT-THINK is
        // gone. Whatever this contact is thinking now lives in char.ephemeral (updated
        // after each reply by onGenerationEnd's CHARCHAT branch when
        // charChatFreshThoughts is on — moved from a pre-reply call),
        // which is already persisted and already has readers, unlike the old log-only
        // stopgap this replaced.
        // [DIAG earlier CHARCHAT-OVERRUN-DIAG] Every diagnostic upstream of this point
        // truncates (60 chars in the per-call resp log above, 80 in empty-reply-diag's
        // document dump) -- so nothing in this file has ever shown the FULL raw text the
        // model actually returned. Session 4 theory: charChatCleanReply's anti-impersonation
        // guard only truncates when it finds the POV NAME as a literal header/trailing token;
        // a run-on completion that drifts into a new, UNLABELLED sentence after the Emotion
        // line sails through uncaught and gets written verbatim, leaving a dangling fragment
        // that may be poisoning the NEXT turn's context. This channel is OFF by default
        // (/log charchat:rawfull on) -- it's verbose and single-purpose, meant to be off again
        // once CHARCHAT-OVERRUN-DIAG is closed one way or the other.
        aeLog('[AE:charchat:rawfull] RAW (pre-clean), ' + ccRawReply.length + ' chars: ' + JSON.stringify(ccRawReply));
        let ccCleaned = charChatCleanReply(ccRawReply, _aeCharChat.contactName, _aeCharChat.povName);
        aeLog('[AE:charchat:rawfull] CLEANED, ' + ccCleaned.length + ' chars: ' + JSON.stringify(ccCleaned)
            + (ccCleaned.length === ccRawReply.length ? ' -- cleaning removed NOTHING, raw text was written as-is.' : ''));
        return { text: [ccCleaned] };
    }

    // STORY-TURN TOKEN ACCUMULATION (token-mode dynamic cadence). Only reached for
    // genuine story turns — every probe / yoink / wizard-mode / charchat path above has
    // already returned. onResponse streams, so sum tokenIds across the chunks of the SAME
    // generation; a change of continuityId self-resets the running total, so no separate
    // start-of-turn reset is needed. Banked once per turn by onGenerationEnd's story path.
    // Returns nothing, so native streaming behaviour is untouched. Wrapped so a counting
    // failure can never disturb a story turn.
    try {
        if (params && params.continuityId && params.continuityId !== _aeStoryTurnCid) {
            _aeStoryTurnCid = params.continuityId;
            _aeStoryTurnTokens = 0;
        }
        if (params && Array.isArray(params.tokenIds)) {
            for (let _ti = 0; _ti < params.tokenIds.length; _ti++) {
                let _row = params.tokenIds[_ti];
                if (_row && typeof _row.length === 'number') _aeStoryTurnTokens += _row.length;
            }
        } else if (params && Array.isArray(params.text)) {
            // Fallback estimate (~4 chars/token, same ratio wizCountTokens uses) if this
            // build does not populate tokenIds.
            _aeStoryTurnTokens += Math.ceil(params.text.join('').length / 4);
        }
    } catch (eTokAcc) { aeLog('[AE] story-turn token accumulation failed (non-fatal):', eTokAcc); }
});

api.v1.hooks.register('onContextBuilt', async function(params: any) {

    // [DIAG] Probe guard — leave a probe generation's context untouched (no hijack, no injection).
    if (_diagProbeActive) return;   // nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.

    // [CTX-CENSUS] Read-only, before every branch below, because this is the one
    // place the ASSEMBLED message array is visible and the yoink/wizlive/charchat branches
    // all return early. Matched on continuityId internally, so a branch that never captured
    // cannot seal someone else's turn. SECTION 3j.
    _ceCtxSeal(params);

    // [vNEXT] Yoink hijack — replace the whole context with our prompt. Runs before
    // the dryRun gate and all normal injection so the wizard gen is fully isolated.
    // [DRYRUN-FIX] onContextBuilt fires TWICE: once with dryRun:true (a costing/
    // preview pass) and once for the real generation, and the two carry DIFFERENT
    // continuityIds. earlier latched the dryRun's id, so the real generation's
    // onGenerationEnd never matched, was discarded as "foreign", and the yoink promise
    // stranded until the 90s watchdog fired. Every wizard call therefore took 90s and
    // returned nothing. Capture ONLY on the real pass; still hijack the context on both
    // so the dryRun cost estimate reflects our prompt rather than the user's story.
    if (_aeYoink.active) {
        if (!params.dryRun && !_aeYoink.continuityId && params && params.continuityId) {
            _aeYoink.continuityId = params.continuityId;
        }
        return { messages: _aeYoink.messages };
    }

    // [WIZLIVE] Chat turns get no imperative/GM/knowledge injection — they are
    // conversation, not story. The pending-inject queue stays queued for the next
    // real story turn instead of being consumed here.
    if (_aeLiveWiz.active) return;

    // [CHARCHAT] Same reasoning as WIZLIVE above: a text message is not a story
    // turn, so no imperative/GM/knowledge injection. The pending-inject queue stays
    // queued for the next real story turn rather than being consumed by a chat reply.
    if (_aeCharChat.active) return;

    // ── AE normal path: gate on dryRun ────────────────────────────────────────
    if (params.dryRun) return;
    const { messages } = params;
    if (!messages || messages.length === 0) return;
    _ceImpNoteMessages(messages);   // [IMP-PIVOT] read-only; the assembled array is the only place role boundaries exist

    // ── [F-19b] IMPERATIVE DELIVERY: A USER TURN AT THE GENERATION POINT ──────
    // The armed directive reaches the story model here, as its own user turn spliced in just
    // before the empty assistant turn the model is about to fill. This is the pivot /ce imp
    // measured: Xialong's framing is applied below every hook, so there is no boundary in
    // storyText to splice before -- but the message ARRAY is ours to edit, exactly as
    // _aeYoink does above, and a user turn is the register the model was trained on. BARE
    // TEXT, no bracket: a bracket is the instruction-shaped token that turns the story model
    // into the utility model, which is the whole thing F-19 was avoiding.
    //   THE ARRAY DOES NOT END ON THE USER TURN. NAI appends an EMPTY ASSISTANT turn as the
    //   generation point -- /ce imp measured `... user:258  assistant:0`, the assistant:0
    //   being the slot the model fills. My first cut required messages[last].role==='user'
    //   and so never fired: the last role is always 'assistant'. The directive must be
    //   inserted as a user turn IMMEDIATELY BEFORE that trailing empty assistant, so it is
    //   the last thing the model reads before it generates.
    //   FOUND, NOT ASSUMED. The generation point is the last message with empty content --
    //   an empty assistant on a fresh turn, absent on some continuations. If one is found we
    //   splice before it; if not (the array ends on real content) we append. Either way the
    //   directive lands as the final USER turn before generation, which is the position the
    //   register argument depends on. A splice into the array preserves every other turn.
    //   Fail-closed only on an empty array (handled by the length guard above).
    try {
        var impPend = '';
        try { impPend = String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
        catch (eIp) { impPend = ''; }
        // [EVENT] THE ARC LINE LEADS THE SPLICED TURN. Read here rather than folded in at
        // the roll, because the slot is also filled by a stepper terminal crossed outside
        // the panel -- prefixing at the queue site would carry the encounter on some
        // deliveries and not others, and which ones would depend on where the value moved.
        var impEv = '';
        try { impEv = await ceEventTurnLine(); } catch (eIe) { impEv = ''; }
        if (impEv && impPend.trim()) impPend = impEv + '\n' + impPend.trim();
        if (impPend.trim()) {
            // The generation point: the trailing empty-content turn. Scanning from the end
            // stops at the first non-empty turn, so a legitimately empty turn earlier in the
            // history cannot be mistaken for it.
            var genAt = messages.length;
            for (var gi = messages.length - 1; gi >= 0; gi--) {
                var gm: any = messages[gi] || {};
                if (String(gm.content || '') === '') { genAt = gi; } else { break; }
            }
            try { await api.v1.tempStorage.remove(STORAGE_PENDING_INJECT); }
            catch (eIr) { api.v1.error('[AE:imp] drain remove:', eIr); }
            _ceImpRuns++;
            var impMsg: any = { role: 'user', content: impPend.trim() };
            // splice(genAt, 0, impMsg): insert BEFORE the generation point. When genAt is
            // messages.length (no trailing empty turn) this is a plain append.
            messages.splice(genAt, 0, impMsg);
            _ceImpLast = {
                at: Date.now(), continuityId: String((params && params.continuityId) || ''),
                lines: [impPend.trim()], insertedAt: genAt, msgCount: messages.length,
                tail: impPend.trim().slice(0, 120)
            };
            aeLog('[AE:imp] delivered as user message #' + genAt + ' of ' + messages.length
                + ' (before the generation point): ' + impPend.trim());
            return { messages: messages };
        }
    } catch (eImpD) { api.v1.error('[AE:imp] trailing-message delivery:', eImpD); }

    // ── BACKGROUND DRAMA ─────────────────────────────────────────────────────
    // [WP-0] Background drama moved to the Author's Note block in

    // ── EQUIPMENT DESCRIPTIONS ────────────────────────────────────────────────
    // [WP-0] Removed. Full equipped-item descriptions now live on each character's
    // lorebook entry (buildLorebookContent "Wearing/Carrying" section), activating
    // with the character's keys instead of loading on every generation.

    // [RETIRED vNEXT] Legacy freeform #tag 1d6 probability engine removed — all skill
    // checks now run through the Quick Action composer (2d6 fail-forward + Stakes).
    return { messages };
});

// ── onGenerationEnd ───────────────────────────────────────────────────────────
api.v1.hooks.register('onGenerationEnd', async function(params: any) {
    try {
        // [ENGINE-THINKING-SIGNAL] First line, deliberately outside every branch
        // below (yoink/orphaned/probe/normal) so it fires exactly once per onGenerationEnd call
        // no matter which of those paths the rest of this handler takes -- pairs 1:1 with the
        // start pulse in onGenerationRequested regardless of how this particular generation ends.
        try { await _aeThinkingPulse(false); } catch (eEtE) { aeLog('[AE:engine-thinking] end pulse failed:', eEtE); }
        // [F-18] Re-sync the tray, on the same reasoning as the pulse above: a generation
        // consumed the queued directive and NOTHING ELSE WILL NOTICE. The author reported
        // exactly this -- Send went out, the outcome was used, and "Discard outcome" stayed
        // on the toolbar advertising something that no longer existed. Outside every branch
        // so a yoink or probe turn re-syncs too; ceSyncToolbar's own change detector makes
        // the no-op case free.
        try { await ceSyncToolbar(); } catch (eTs) {}
        try { await cePublishActions(); } catch (ePs) {}
        // [DIAG] Probe guard — a probe api.v1.generate() must never advance story state.
        if (_diagProbeActive) return;   // nested api.v1.generate() in flight — see onBeforeContextBuild's guard. Log removed: it now fires every ephemeral/architect call.
        // [vNEXT] Yoink generation finished — hand the captured text back to the
        // awaiting caller and STOP. Must return before the gen counter, auto-triggers,
        // and dynamic engine so a wizard gen never advances story state.
        // Only if this end event belongs to OUR generation. A late end event
        // from a watchdog-abandoned generation must not resolve the newer call that has
        // since taken the slot. Same fail-safe as onResponse: with no continuityId
        // captured, behave exactly as before.
        if (_aeYoink.active) {
            let ygEndMine = !_aeYoink.continuityId || !params || !params.continuityId || params.continuityId === _aeYoink.continuityId;
            if (ygEndMine) {
                ae_genInFlight = false;
                if (_aeYoink.resolve) _aeYoink.resolve(_aeYoink.responseText);
                _aeYoink.active = false;
                _aeYoink.resolve = null;
                _aeYoink.reject = null;
                _aeYoink.continuityId = null;
                diagBudgetClose((params && params.continuityId) || null);   // [DIAG] close the YOINK reading
                return;
            }
            // An orphaned generation ended. Do not touch _aeYoink; also do not run the
            // story-advancing logic below on its behalf.
            if (params && params.continuityId && _wizZombieIds[params.continuityId]) {
                delete _wizZombieIds[params.continuityId]; // [WIZMODE] zombie finally resolved — stop tracking it
                aeLog('[AE:wizard] zombie generation ' + params.continuityId + ' ended \u2014 cleaned up.');
            } else {
                aeLog('[AE:wizard] ignoring generation-end from an abandoned/foreign generation.');
            }
            return;
        }

        // [WIZLIVE] A finished chat turn is not a story turn: release the gen
        // guard, retint the freshly grown chat region, and skip the counter, auto-
        // triggers, and dynamic engine entirely.
        if (_aeLiveWiz.active) {
            ae_genInFlight = false;
            diagBudgetClose((params && params.continuityId) || null);
            // [WIZLIVE-BRACE-WRAP] Runs BEFORE the decoration refresh so
            // the tint is computed against the paragraphs that actually survive the pass —
            // same ordering CharChat's normalize-then-decorate already uses.
            try { await _wizliveNormalizeDocument(); } catch (eWn) { aeLog('[AE:wizlive] brace-wrap pass failed (chat still usable, formatting may be off):', eWn); }
            try { await refreshLiveWizDecorations(); } catch (eLd) { aeLog('[AE:wizlive] decoration refresh failed:', eLd); }
            return;
        }

        // [CHARCHAT] A finished text message is not a story turn either: release
        // the gen guard, retint the freshly grown chat region, and skip the gen counter,
        // auto-triggers, and the dynamic engine entirely. Letting the dynamic engine run
        // here would let chat turns silently drive ephemeral/mid-range updates — exactly
        // the context poisoning this design promises not to do.
        if (_aeCharChat.active) {
            ae_genInFlight = false;
            diagBudgetClose((params && params.continuityId) || null);
            // [DIAG earlier CHARCHAT-RACE-DIAG] t0 for this turn's timeline — see the mark
            // helper's own header comment near _ccThoughtSignal for what this whole trace is for.
            _ccRaceDiagMark('main reply landed (outer onGenerationEnd start)');
            // [DIAG earlier CHARCHAT-RESP-DIAG] The one line that settles "did NAI produce
            // anything at all this turn". Compared by continuityId so a silent turn reports
            // zero rather than reprinting the previous turn's numbers.
            try {
                let ccEndCid = String((params && params.continuityId) || '');
                if (ccEndCid && ccEndCid !== _ccRespCid) {
                    aeLog('[AE:charchat:resp] turn summary \u2014 onResponse NEVER FIRED for this '
                        + 'generation (cid ' + ccEndCid + '). NAI ran a full generation lifecycle and '
                        + 'delivered no response callback at all. Nothing downstream of here can be at '
                        + 'fault; look at the prompt or the generation slot.');
                } else {
                    aeLog('[AE:charchat:resp] turn summary \u2014 calls=' + _ccRespCalls
                        + ' finalSeen=' + _ccRespFinalSeen + ' longestChunk=' + _ccRespBest.length + ' chars.');
                }
            } catch (_eRs) {}

            // [earlier, per user: "maybe we handle it after generation?"] This is that
            // "after". The scaffold-append that used to live here is gone; instead the
            // whole chat region is re-canonicalised now that both this turn's POV message
            // and the reply are in the document — headers applied, stray blank paragraphs
            // dropped, unclosed braces closed. Runs BEFORE the decoration refresh so the
            // tint is computed against the paragraphs that actually survive the pass.
            try { await _charchatNormalizeDocument(); } catch (eNz) { aeLog('[AE:charchat] turn normalisation failed (chat still usable, formatting may be off):', eNz); }
            // [DIAG CE-DIAG-FLAGS] ccSkipDecorations — skips BOTH the bubble-styling pass and
            // the widget clear/rebuild nested inside it (refreshCharChatImageWidgets is only
            // ever called from here). Use ccSkipWidgets instead if only the widget half needs
            // isolating.
            if (CE_DIAG.ccSkipDecorations) {
                aeLog('[AE:diag] ccSkipDecorations ON \u2014 decoration + widget refresh skipped this turn.');
            } else {
                try { await refreshCharChatDecorations(); } catch (eCd) { aeLog('[AE:charchat] decoration refresh failed:', eCd); }
            }
            _ccRaceDiagMark('normalisation + decoration refresh settled');
            let ccCfgEnd = await loadConfig();
            // [CHARCHAT-THOUGHT-POST] THE THOUGHT FIRES HERE — after the reply, on the
            // transport that never stopped working. This is where earlier put it, and after
            // earlier-earlier spent four versions failing to do better, it is where it belongs.
            // Read the CE-INDEX earlier block before moving it again.
            //   ORDER: after normalisation (the transcript this reads must be settled and
            //   un-merged first) and BEFORE the image pass, so the two nested api.v1.generate()
            //   calls are serialised and _diagProbeActive's scope stays unambiguous — the same
            //   reason the image pass's own comment gives for sitting last.
            //   ONE TURN STALE, BY DESIGN: this describes the reply that just landed and informs
            //   the NEXT one, via buildCharChatInstruction's ccEph read. That is the accepted
            //   trade, not a bug. [CORRECTED earlier] It is NO LONGER "pinned last in context by
            //   earlier CHARCHAT-TAIL-ORDER" — the Emotion directive is the unconditional final
            //   block now (CHARCHAT-TAIL-TERMINAL); the thought sits directly above it.
            //   AWAITED, not fire-and-forget: the reply is already in the document and
            //   normalised before this starts, so nothing this call does can corrupt it. What it
            //   can still race is the user's NEXT Send — nothing gates NAI's Send button — and
            //   that race is handled by op 'arm' cancelling this call at pointerdown (grep
            //   CHARCHAT-ARM-CANCEL), not by assuming it cannot happen.
            //   Fresh Thoughts OFF is the control: it restores the plain earlier path exactly.
            if (ccCfgEnd && ccCfgEnd.charChatFreshThoughts && !CE_DIAG.ccNoThought) {
                await _charchatSetBusy('thinking');
                // [DIAG earlier CHARCHAT-RACE-DIAG, per user's "the thinking indicator might be
                // ending too quickly" hypothesis] This mark is the moment the UI is FIRST told
                // "busy — thinking". Compare its gap from the previous mark (should be near-zero:
                // nothing async happens between normalisation settling and this call) against the
                // gap the NEXT mark shows once the thought call actually returns.
                _ccRaceDiagMark('busyStage=thinking set, calling generateChatEphemeral');
                try {
                    let ccEndThChar = await loadCharacter(_aeCharChat.contactId);
                    if (ccEndThChar) {
                        let ccEndThGen = 0;
                        try { ccEndThGen = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number; }
                        catch (_eEndThG) { ccEndThGen = 0; }
                        await generateChatEphemeral(ccEndThChar, ccCfgEnd, ccEndThGen);
                    } else {
                        aeLog('[AE:charchat:thought] contact could not be loaded \u2014 no thought this turn, previous one stands.');
                    }
                } catch (eEndTh) {
                    // Non-fatal by design, same rule the image pass follows: a failed thought must
                    // never take down a chat whose reply has already landed correctly.
                    api.v1.error('[AE:charchat:thought] post-reply thought failed (chat unaffected, previous thought stands):', eEndTh);
                }
                // [DIAG earlier CHARCHAT-RACE-DIAG] The gap this mark reports is the thought
                // call's real wall-clock duration — compare against the [AE:gendiag] ms field
                // for the same call to confirm they agree (they should; this is measuring the
                // same await from the outside).
                _ccRaceDiagMark('generateChatEphemeral settled (cancelled, errored, or completed)');
            } else {
                // [DIAG CE-DIAG-FLAGS] This branch is now reached two ways: Fresh Thoughts is
                // genuinely OFF, or ccNoThought forced a skip of the thought call above while
                // Fresh Thoughts is ON. Either way ccNoPrime independently controls whether THIS
                // call fires, so the two flags combine cleanly: ccNoThought+ccNoPrime together
                // isolate a turn with neither nested generate() running at all.
                // [BUGFIX earlier CHARCHAT-SLOT-PRIME] Fresh Thoughts OFF was the turn that always
                // needed a second Send. With no thought firing between turns, NAI's generation slot
                // was never exercised after this turn's document edits, and the next native Send
                // came back empty. Prime it with a 1-token throwaway on the same cancellable
                // background transport the thought uses. This runs ONLY in the OFF branch: when
                // thoughts are on, generateChatEphemeral above has already exercised the slot, and
                // priming again would just be a second redundant call. See _charchatPrimeSlot.
                if (CE_DIAG.ccNoPrime) {
                    aeLog('[AE:diag] ccNoPrime ON \u2014 slot-prime call skipped this turn.');
                } else {
                    _ccRaceDiagMark('Fresh Thoughts off \u2014 priming the generation slot instead');
                    try { await _charchatPrimeSlot(); }
                    catch (eEndPr) { aeLog('[AE:charchat:prime] prime pass threw (chat unaffected):', eEndPr); }
                }
                _ccRaceDiagMark('slot prime settled (cancelled, errored, or completed)');
            }
            // [CHARCHAT-IMG] Attachment pass. AFTER normalisation (the text it
            // rewrites must be settled and un-merged first) and after the ephemeral
            // refresh (both make nested api.v1.generate() calls; serialising them keeps
            // the _diagProbeActive guard's scope unambiguous). Non-fatal by design — a
            // failed photo must never take down a working chat.
            if (ccCfgEnd && ccCfgEnd.charChatImages && !CE_DIAG.ccNoImages) {
                // [CHARCHAT-THINK-FIRST] Staged, so the panel says "sending photo…"
                // instead of sitting silent through an architect call plus a bridge image
                // generation.
                // [BUGFIX earlier CHARCHAT-IMG-BUSY-FLASH] The busyStage='image' flip moved
                // INTO _charchatProcessImages itself (only once it confirms a real job exists)
                // — this call site used to flip it unconditionally just because the FEATURE
                // was on, flashing "sending photo…" on every turn even when nothing was
                // actually being sent.
                _ccRaceDiagMark('calling _charchatProcessImages (may or may not find a job)');
                try {
                    let ccImgN = await _charchatProcessImages();
                    if (ccImgN > 0) {
                        try { await refreshCharChatDecorations(); } catch (_eccId) {}
                    }
                } catch (eccImg) { api.v1.error('[AE:charchat] image attachment pass failed (chat unaffected):', eccImg); }
                _ccRaceDiagMark('_charchatProcessImages settled');
            }
            // [CHARCHAT-THINK-FIRST] Idle again — set before the final broadcast so
            // that repaint carries it. _charchatSetBusy broadcasts too, but its
            // no-op-on-same-value guard makes the redundant push free.
            await _charchatSetBusy('');
            // [DIAG earlier CHARCHAT-RACE-DIAG] The gap from the last checkpoint to HERE, plus
            // the arm handler's own mark (see op 'arm' below), is the number that answers the
            // user's question directly: how long after the UI says "safe to send" does the
            // NEXT Send's arm signal actually arrive, and was anything still in flight when it did.
            _ccRaceDiagMark('busyStage cleared \u2014 turn fully idle, next Send is expected to be safe now');
            // [CHARCHAT-HUD] Push the grown transcript to the bridge panel. Last,
            // so the payload includes this turn's reply, its normalisation, and any
            // image tag the pass above just resolved.
            try { await broadcastCharChatState(); } catch (_eccBc) {}
            return;
        }

        ae_genInFlight = false; // generation finished — release the generate guard
        diagBudgetClose((params && params.continuityId) || null);   // [DIAG] close the STORY reading (no-op if none pending)
        // Skip on inline generations (tooltips, etc.) and retry/undo flagged turns
        if (params?.inlineGeneration) return;
        const skipFlag = await api.v1.tempStorage.get(STORAGE_ENGINE_SKIP) as string | undefined;
        if (skipFlag === 'true') {
            await api.v1.tempStorage.remove(STORAGE_ENGINE_SKIP);
            aeLog('[AE] Engine skipped this turn (retry/undo).');
            return;
        }

        // [E1] Increment persistent generation count (replaces token estimation).
        try {
            let _genC = await api.v1.storyStorage.getOrDefault(STORAGE_GEN_COUNT, 0) as number;
            _genC = (Number(_genC) || 0) + 1;
            await api.v1.storyStorage.set(STORAGE_GEN_COUNT, _genC);
            aeLog('[AE] Generation count: ' + _genC);
        } catch (e) { api.v1.error('[AE] Gen count increment error:', e); }

        // Bank this story turn's tokens onto the persistent counter (token-mode
        // dynamic cadence). _aeStoryTurnTokens was summed across this generation's onResponse
        // chunks; reset both accumulators after banking so the next turn starts clean. The
        // counter advances every turn regardless of mode — cheap, and it means switching to
        // token mode mid-story has a meaningful counter already in place.
        try {
            let _tokAdd = Number(_aeStoryTurnTokens) || 0;
            if (_tokAdd > 0) {
                let _tokC = await api.v1.storyStorage.getOrDefault(STORAGE_TOKEN_COUNT, 0) as number;
                _tokC = (Number(_tokC) || 0) + _tokAdd;
                await api.v1.storyStorage.set(STORAGE_TOKEN_COUNT, _tokC);
                aeLog('[AE] Token count: ' + _tokC + ' (+' + _tokAdd + ')');
            }
        } catch (eTokBank) { api.v1.error('[AE] Token count bank error:', eTokBank); }
        _aeStoryTurnTokens = 0;
        _aeStoryTurnCid = null;

        // [T-08] THE OPTIONAL TICK, AND IT IS OFF UNLESS THE AUTHOR SAYS OTHERWISE. Read
        // from the calendar every turn rather than cached, so a Settings change reaches the
        // very next generation. PLACED AFTER THE COUNTERS AND BEFORE THE AUTO-TRIGGERS,
        // which is where the schedule pass will want it when it lands: the hour has to have
        // moved before anything is asked where people are.
        // NON-FATAL. A clock that fails to advance must not cost the turn its dynamic pass.
        try {
            let _tkCfg = await loadConfig();
            let _tkCal = ceCalendar(_tkCfg);
            let _tkAdd = Math.round(Number(_tkCal.advancePerGen) || 0);
            if (_tkAdd > 0) {
                let _tkNow = await ceClockNudge(_tkAdd);
                aeLog('[AE:clock] +' + _tkAdd + ' min \u2192 ' + ceClockStamp(_tkCal, _tkNow));
                try { await cePublishScene(); } catch (_eTkP) {}
            }
        } catch (eTk) { api.v1.error('[AE:clock] auto-advance:', eTk); }

        // [F-4] THE SUMMON, AFTER THE TURN. Placed after the clock tick so anyone walking in
        // arrives at the hour the story has just reached, and before the auto-triggers so a
        // trigger that reads presence sees the room as it now is.
        try {
            const _smN = await _ceSummonRun();
            if (_smN > 0) {
                try { await cePublishScene(); } catch (_eSp) {}
                try { await cePublishMap(); } catch (_eSm) {}
            }
        } catch (eSm) { api.v1.error('[AE:summon] end-of-turn:', eSm); }

        aeLog('[AE] Generation complete — running auto-triggers...');
        await runAutoTriggers();
        aeLog('[AE] Generation complete — engaging dynamic engine...');
        await runDynamicEngine();
    } catch (e) {
        api.v1.error('[AE] onGenerationEnd error:', e);
        // [vNEXT] Failsafe — never leave the yoink lock stuck on error.
        if (_aeYoink.active) {
            if (_aeYoink.reject) _aeYoink.reject(e);
            _aeYoink.active = false;
            _aeYoink.resolve = null;
            _aeYoink.reject = null;
            _aeYoink.continuityId = null;
        }
    }
});

// Skip engine on retry and undo — token stamps shouldn't update when story reverts
api.v1.hooks.register('onHistoryNavigated', async function(params: any) {
    ae_genInFlight = false; // safety release if a generation was aborted/navigated
    if (params?.cause === 'retry' || params?.cause === 'undo') {
        await api.v1.tempStorage.set(STORAGE_ENGINE_SKIP, 'true');
    }
});


// [E5] Intercepts direct player TA-box input and composes any pending
// player flavor into inputText before it is written to the story document.
// Only fires for actual player key-submissions; not triggered by generate().
api.v1.hooks.register('onTextAdventureInput', async function(params: any) {
    try {
        let taFlavor = await api.v1.tempStorage.get(STORAGE_PENDING_FLAVOR) as string | undefined;
        if (taFlavor && taFlavor.trim()) {
            await api.v1.tempStorage.remove(STORAGE_PENDING_FLAVOR);
            let taInput = String((params && params.inputText) || '');
            return { inputText: composeActionPrompt(taInput, taFlavor.trim()) };
        }
    } catch (_e) {}
});

// ============================================================================
// SECTION 27 — UI REGISTRATION & STARTUP
//
// registerEngineUI is the ONLY api.v1.ui.register() call in the file. It builds
// the toolbar button set: one icon-only button per CE_SHELL_ROUTES entry that has
// not opted out with tray:false, plus the three chat-active controls. There is no
// sidebar panel and no native tray (earlier SWEEP). register() replaces the whole
// set, so ceSyncToolbar re-registers only when the chat-active group needs to
// appear or disappear rather than on every chat turn.
//
// The onScriptsLoaded hook below is the startup sequence, in order:
//   1. registerEngineUI            toolbar buttons
//   2. permissions                 file, lorebook, story, document, decorations
//   3. loadImageSettings           imagePromptFields[] + globalSettings
//   3b. loadConfigFromLorebook     world-pack auto-import, fresh stories only
//   4. buildCharacterDataPayload   seeds cachedCharVisuals before the bridge connects
//   5. initMessaging               HANDSHAKE_REQUEST to the bridge
//   5b-5d. three rehydrations      WIZLIVE, CharChat, story image widgets — each
//                                  re-verified against the live document
// ============================================================================

async function registerEngineUI(): Promise<void> {
    // [SWEEP] cfg.interfaceMode IS NOW VESTIGIAL EVERYWHERE, not just here. It
    // gated which HUD renderer mounted (bridge / native / both); the native renderer is
    // deleted and setInterfaceMode went with it, so nothing reads the field any more. The
    // GlobalConfig field and its migration default are DELIBERATELY LEFT IN PLACE -- they
    // are persisted record shape, and dropping them would rewrite every stored config for
    // no gain. Do not add a new reader without deciding what the second mode would be.
    // [SWEEP] THE ce-panel sidebarPanel IS GONE. It mounted buildSidebar,
    // which is deleted with SECTION 20; leaving the registration would have re-registered
    // a panel whose only content was the literal 'Loading' placeholder forever.
    let ext: any[] = [];
    // ONE TRAY BUTTON PER SURFACE, built from CE_SHELL_ROUTES so a new surface costs one
    // line. Icon only, per user -- no `text`, so nothing renders but the glyph. A route
    // opts out with `tray: false` (Settings does; see the array's own comment).
    //
    // THE TRAY AND ceShellNav ARE NOT REDUNDANT: the tray gets you IN from the story, the
    // nav row moves you AROUND without closing the shell. Different jobs, same words.
    //
    // KNOWN GAP, not closed: there is no path to an OFF-SCENE character from the toolbar.
    // Scene's own "show all characters" toggle is what closes it and is not built yet.
    for (let ceTbI = 0; ceTbI < CE_SHELL_ROUTES.length; ceTbI++) {
        if (CE_SHELL_ROUTES[ceTbI].tray === false) continue;
        ext.push((function(rt: any) {
            return { type: 'toolbarButton', id: 'ce-tb-' + rt.id, iconId: rt.icon,
                callback: function() { ceOpenShell(rt.id).catch(function(e) { api.v1.error('[AE:jsxshell] open ' + rt.id + ':', e); }); } };
        })(CE_SHELL_ROUTES[ceTbI]));
    }

    // [CC-TRAY] Chat-active controls. The tray is the right home specifically
    // because it is the only chrome reachable WITHOUT opening a modal, which is exactly
    // what "close the chat I am looking at" needs -- and for WIZLIVE it is the only chrome
    // at all, since _ceWizChatCloseShell deliberately closes the modal on start so the
    // marker it just wrote into the document is not hidden behind it.
    //
    // [WIZ-TRAY] ONE TRIPLE, DISPATCHED, not two sets of three. The two chat modes
    // are MUTUALLY EXCLUSIVE by guard -- startLiveWizardChat refuses while a CharChat is
    // live and startCharChat refuses the reverse -- so a second set would be three more
    // button ids that can never be visible at the same time as the first three, and
    // api.v1.ui.register rebuilds the whole set anyway. The verbs differ, the buttons do
    // not, so the dispatch lives in the callback.
    //
    // DELETE IS DELIBERATELY NOT A ONE-TAP TRAY BUTTON. It opens the owning surface with
    // the confirm ARMED, so the confirmed action renders as a control that did not exist at
    // the moment of the first press -- DESTRUCTIVE-NEVER-IN-PLACE, which governs every
    // destructive action in this file and not only the jsx ones. The bridge used
    // window.confirm(); there is none in this sandbox, and a second confirm idiom for the
    // tray would be worse than routing to the one that already exists on each surface.
    // [F-15a] THE ACTIONS PANEL IS A scriptPanel, NOT A ROUTE AND NOT A MODAL, and that is
    // the whole design rather than a placement preference. A scriptPanel opens BELOW the
    // editor, so NAI's do/say field and its Send button stay on screen -- which is what
    // lets the composer prime a move the author then fires with their own typed sentence.
    // A modal (the shell) covers both and would force the composer to grow a text field
    // and a send button of its own, i.e. a second story input.
    // NOT ON CE_SHELL_ROUTES for the same reason: a route is a screen in the shell modal.
    //
    // [PANEL-SUBSTRATE] ceStoresInit() IS CALLED HERE AND THE PANEL DOES NOT WORK WITHOUT
    // IT. Measured, not theorised: in 3.0.66 the panel rendered, its selects populated, and
    // NOTHING ARMED. ceAction -- which every control in the kit routes through -- opens with
    // `if (!ceUiStore) return;` and returns BEFORE calling fn, so a missing ceUiStore does
    // not throw and does not log; it makes every control on the surface silently inert.
    // ceUiStore was created only by ceOpenShell, and this panel mounts WITHOUT the shell
    // ever having been opened.
    // THE LESSON GENERALISES: ceUiStore is KIT SUBSTRATE (the busy latch, and therefore
    // every button, toggle, select and stepper), not shell state. Any surface mounted
    // outside ceOpenShell must initialise it. ceStoresInit is idempotent, so calling it
    // from both doors costs nothing and is why the fix is a call rather than a refactor.
    ceStoresInit();
    ceActionsStoreInit();
    ext.push({ type: 'scriptPanel', id: 'ce-actions-panel', name: 'CE Actions', iconId: 'target',
        content: [ceJsxPart('ce-actions-jsx', ceActionsRoot, CE_ACTIONS_MIN_PX)] });

    // [F-15a] CANCEL IS ONLY EVER PRESENT WHILE SOMETHING IS ARMED, which makes the button
    // do two jobs with one control: it disarms, and its mere existence is the reminder that
    // the next Send will roll. An always-present Cancel would be a dead control most of the
    // time AND would say nothing about state. Same appear/disappear mechanism the chat
    // triple uses, through the same change detector -- see ceSyncToolbar.
    // [F-18] READ DIRECTLY, NOT FROM A MIRROR. _ceTrayArmed was a module var kept in step by
    // ceSyncToolbar, and it produced exactly the two faults the author reported: the button
    // survived a Send that consumed the directive (nothing re-synced after a generation),
    // and it vanished while one WAS queued (any other caller of registerEngineUI rebuilt the
    // tray from a stale mirror). registerEngineUI is async, so there was never a reason to
    // mirror -- the slot itself is the answer and cannot drift from itself.
    var tbQueued = false;
    try { tbQueued = !!String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
    catch (eQ) { tbQueued = false; }
    if (tbQueued) {
        ext.push({ type: 'toolbarButton', id: 'ce-tb-action-cancel', text: 'Disarm outcome', iconId: 'x-circle',
            callback: function() { ceTrayActionCancel().catch(function(e) { api.v1.error('[AE:tray] discard outcome:', e); }); } });
    }

    if (_ceAnyChatActive()) {
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-close', text: 'Close chat', iconId: 'close',
            callback: function() { ceTrayChatClose().catch(function(e) { api.v1.error('[AE:tray] close:', e); }); } });
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-summ', text: 'Summarize', iconId: 'align-left',
            callback: function() { ceTrayChatSummarize().catch(function(e) { api.v1.error('[AE:tray] summarize:', e); }); } });
        ext.push({ type: 'toolbarButton', id: 'ce-tb-cc-del', text: 'Delete chat', iconId: 'trash',
            callback: function() { ceTrayChatDelete().catch(function(e) { api.v1.error('[AE:tray] delete:', e); }); } });
    }
    await api.v1.ui.register(ext);
}

// [CC-TRAY] Re-register the UI extension set ONLY when the chat-active button
// group needs to appear or disappear. api.v1.ui.register replaces the whole set, so there
// is no way to add three buttons without rebuilding all of them -- and the one choke point
// that reliably sees every chat transition (broadcastCharChatState) also fires on every
// turn. Hence a change detector rather than an unconditional call: the set changes twice
// per chat, not twice per message. Seeded null so the FIRST sync after startup registers
// once regardless of which state the restored chat is in.
var _ceTrayChatActive: boolean | null = null;
// [F-15a] THE ARMED FLAG IS A MIRROR OF tempStorage, NOT A SECOND TRUTH. registerEngineUI
// is synchronous in its body and the arm lives behind an await, so the read happens in
// ceSyncToolbar (which is async) and the builder reads what it left here. Every writer of
// the arm calls ceSyncToolbar, so the mirror cannot drift for longer than one call.
var _ceTrayArmed = false;
async function ceSyncToolbar(): Promise<void> {
    try {
        let tbWant = _ceAnyChatActive();
        // [F-15d] TRACKS THE QUEUED DIRECTIVE, NOT THE SELECTION. The selection persists
        // between turns by design, so its presence says nothing; what the author needs
        // warning about is an outcome sitting in the slot waiting to ride their next Send.
        // [F-18] The mirror is now ONLY a change detector -- registerEngineUI reads the slot
        // itself, so a stale value here can cost one redundant re-register and can no longer
        // draw the wrong tray.
        let tbArm = false;
        try { tbArm = !!String(await api.v1.tempStorage.getOrDefault(STORAGE_PENDING_INJECT, '') || ''); }
        catch (eArm) { tbArm = _ceTrayArmed; }
        if (_ceTrayChatActive === tbWant && _ceTrayArmed === tbArm) return;
        _ceTrayChatActive = tbWant;
        _ceTrayArmed = tbArm;
        await registerEngineUI();
    } catch (e) { aeLog('[AE:hud] tray sync failed:', e); }
}

// [F-15a] Disarm from the tray. Toasts rather than failing silently: the button vanishing
// is the confirmation, and a control that disappears with no word looks like a misfire.
async function ceTrayActionCancel(): Promise<void> {
    await ceDiscardQueued();
    try { api.v1.ui.toast('Outcome disarmed. Your next turn rides clean.', { type: 'info', autoClose: 2500 }); } catch (e) {}
}

// [WIZ-TRAY] The three dispatchers. Each reads the live mode at PRESS time rather
// than closing over which mode was live when the button was registered: the set is
// re-registered on every transition, but a press racing an end would otherwise fire the
// wrong verb, and a chat that has already closed must say so rather than throw.
function _ceAnyChatActive(): boolean {
    return !!_aeCharChat.active || !!_aeLiveWiz.active;
}

async function ceTrayChatClose(): Promise<void> {
    if (_aeCharChat.active) { await endCharChat('save'); return; }
    if (_aeLiveWiz.active)  { await _ceWizChatEnd('save'); return; }
    try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
}

async function ceTrayChatSummarize(): Promise<void> {
    if (_aeCharChat.active) { await ceChatSummarize(); return; }
    // The wizard's summarize PROPOSES into the store and the preview only exists on its
    // own surface, so the tray opens that surface after generating -- the CharChat verb
    // does exactly the same thing internally (ceOpenShell('chat') at its tail).
    if (_aeLiveWiz.active) {
        await _ceWizChatSummarize();
        await ceOpenShell('wizard');
        return;
    }
    try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
}

async function ceTrayChatDelete(): Promise<void> {
    if (_aeCharChat.active) { await ceOpenChatConfirmDelete(); return; }
    if (_aeLiveWiz.active)  { await ceOpenWizChatConfirmDiscard(); return; }
    try { api.v1.ui.toast('No chat is open.', { type: 'warning', autoClose: 2500 }); } catch (_e) {}
}

api.v1.hooks.register('onScriptsLoaded', async function() {
    try {
        // 1. Register NAI UI: one toolbar button per jsx shell route. There is no
        //    sidebar panel and no native tray any more (earlier SWEEP).
        await registerEngineUI();

        // 2. Permissions
        await api.v1.permissions.request(['fileInput', 'fileDownload', 'lorebookEdit', 'storyEdit', 'documentEdit', 'editorDecorations']);
        await api.v1.timers.sleep(300);

        // 2b. [FACETS] The earlier abandoned-draft sweep was REMOVED here. It walked
        //     and loaded every character on every startup to catch a case an ordinary delete
        //     button already handles, and an earlier lazy creation had already reduced that
        //     case to near nothing — a draft now only exists once the author has generated
        //     into it or committed, at which point it is a real character in the roster with
        //     a real delete control. Do not reinstate it: a startup pass over the full cast
        //     is a real cost, and the thing it guarded against is now visible and removable.

        // 2c. [ENT-ID1] SCHEMA MIGRATIONS, BEFORE ANY READ OF A CHARACTER OR ENTITY.
        //     Position is load-bearing: step 4 below seeds the visual cache off the full
        //     cast, and a half-migrated store read there would cache pointers this pass is
        //     about to rewrite. Gated on a version stamp, so the cost on an already-current
        //     story is one storyStorage read.
        try { await ceRunSchemaMigrations(); } catch (eMig) { api.v1.error('[AE] schema migration error:', eMig); }

        // 2d. [F-28] cfg.factions -> entities, then the standing defs those entities own.
        //     BOTH ARE ASYNC AND NEITHER CAN LIVE IN migrateConfig, which is sync. Order is
        //     load-bearing twice over: the migration must precede the sync (the sync reads
        //     the entity index the migration writes), and both must precede every surface
        //     read below. Idempotent, so the cost on a current story is two index reads.
        try { await ceMigrateFactionsToEntities(); } catch (eFm) { api.v1.error('[AE] faction migration error:', eFm); }
        try { await ceSyncStandingDefs(); } catch (eSs) { api.v1.error('[AE] standing sync error:', eSs); }

        // 3. [CHANGE] Load image settings before bridge connects so auto-snap is ready.
        await loadImageSettings();

        // 3b. [earlier] Lorebook world-pack auto-import. Runs only when storyStorage
        //     has no config (fresh story created from a packed scenario). Non-destructive:
        //     existing stories are always skipped.
        try { await loadConfigFromLorebook(); } catch (eLcInit) { aeLog('[AE:pack] init import error:', eLcInit); }

        // 4. Pre-seed cachedCharVisuals from storage so getCharacterData() works on the
        //    first generation. [REACH] This is now the ONLY caller of
        //    buildCharacterDataPayload -- the broadcaster that was the other one is deleted,
        //    but the cache it filled is read by the image path and still needed.
        await buildCharacterDataPayload();

        // 5. initMessaging() — sends HANDSHAKE_REQUEST to bridge.
        await initMessaging();

        // 5b. [WIZLIVE] Rehydrate an in-document wizard chat left open in this
        //     story (marker re-verified against the live document; stale state cleared).
        try { await restoreLiveWizOnStartup(); } catch (eLw) { aeLog('[AE:wizlive] startup restore error:', eLw); }

        // 5c. [CHARCHAT] Same rehydration contract for an in-story character chat
        //     (marker re-verified against the live document; stale state cleared and the
        //     pinned max_tokens restored — a stranded 120-token cap would otherwise
        //     silently truncate every story generation).
        try { await restoreCharChatOnStartup(); } catch (eCc) { aeLog('[AE:charchat] startup restore error:', eCc); }

        // 5d. [STORYIMG] Third rehydration on the same contract: widgets do not
        //     survive a script unload but their anchors do, so the story images are rebuilt
        //     from storyStorage here. _ceStoryImgPrune drops any whose paragraph is gone.
        try { await refreshStoryImageWidgets(); } catch (eSi) { aeLog('[AE:storyimg] startup rebuild error:', eSi); }

        // 6. Story init path
        const rawIndex = await api.v1.storyStorage.get(STORAGE_INDEX);
        const isFreshStory = !rawIndex || (Array.isArray(rawIndex) && (rawIndex as any[]).length === 0);

        if (isFreshStory) {
        }

        aeLog('[AE] Adventure Engine initialized.');
    } catch (e) {
        api.v1.error('[AE] Init error:', e);
    }
});


// ============================================================================
// SECTION 28 — CE UI FOUNDATION (jsx)
// Stores, the idempotency latch, and the primitive kit every jsx surface is built from.
// Purely additive: nothing in Sections 1-27 reads anything here.
//
// FOUR MEASURED FACTS ABOUT THIS RUNTIME. Each cost a probe; none is re-derivable by
// reading the typings, and every rule below exists because of one of them.
//   1. NO jsx part may trigger api.v1.ui.update() of a tree containing itself. Panel and
//      modal content is registered ONCE; every repaint after that happens inside Preact via
//      store subscription. Violating this is an infinite mount loop, not a slow render.
//   2. onClick FIRES TWICE PER PHYSICAL TAP. Every pointer handler goes through ceTap().
//      ceAction is NOT interchangeable: it holds its latch only for the duration of fn(),
//      so it covers a slow write and covers nothing at all for an instant one.
//   3. onInput FIRES THREE TIMES at word boundaries, twice carrying a STALE pre-keystroke
//      value. Every text input is UNCONTROLLED and deduped on value. Binding value= to
//      state re-enters that race; accumulating in an input handler over-counted by 32%.
//   4. THE MOUNT ELEMENT HAS NO ownerDocument, so getComputedStyle is unreachable and NAI's
//      --theme-* names CANNOT BE READ at runtime. That is a constraint on READING, and the
//      kit still honours it: no NAI theme variable is ever named here, and every default
//      derives from inherited currentColor, which works on light and dark alike without the
//      kit knowing which is active. WRITING is a different question and the answer is the
//      opposite -- the kit declares ~92 --ce-* names of its own, because a custom property
//      is the one thing that crosses a shadow boundary. See THE THEME CONTRACT below.
//      Unsupported color-mix drops the declaration, yielding no border rather than a wrong one.
//
// THREE CORRECTIONS TO CE-STYLE v2.0 ITSELF, verified against the typings:
//   - onPointerCancel DOES NOT EXIST (SS2 and SS9.1 both assume it). The family is
//     Down/Up/Move/Over/Out/Enter/Leave. Press release is Up + Leave + onTouchCancel.
//   - SS8's 44px hit wrapper is VERTICAL ONLY. Four-sided expansion overlaps adjacent hit
//     boxes in an s2-gap row by 4px. See _ceHit.
//   - SS10.1's progressive busy label is a per-call-site argument, not mechanical -ing
//     conversion, which produces garbage on most of the 113 real labels here.
//
// ceBtn / ceToggle ARE COMPONENTS (_ceBtnC / _ceToggleC) BEHIND UNCHANGED WRAPPERS. SS9
// requires press and focus states; there are no CSS interaction pseudo-classes here, so
// state means a hook, and a hook inside a bare helper joins its CALLER's hook list --
// fatal, because surfaces render buttons conditionally and in loops.
//
// ceGroup/ceRow/ceChip/ceMeter/ceCard/ceIcon MAY HAVE ZERO CALL SITES. They are what the
// re-skin migrates INTO. DO NOT DELETE THEM IN A DEAD-CODE SWEEP.
//
// 'ce_reduce_motion' lives on api.v1.storage (ACCOUNT-global, not story) -- it is a
// property of the reader, not the story file. ceMotionApply MUTATES CE_T's duration tokens
// rather than exposing an accessor: mutation is total and cannot miss a call site.
// ============================================================================

// -- Tokens: sizes only. There is deliberately no color token. ---------------
// [STYLE2] REBUILT against CE-STYLE v2.0. Two things changed for a
// real reason, not a refresh:
//   fs 13->14, fsSm 11->12.5 -- both were failing legibility in practice ("headers are
//   tiny and dim"), and both are load-bearing enough (fs: 19 call sites: fsSm: 88) that
//   fixing the TOKEN fixes every surface at once, which is the entire point of a token.
//   fsXs is GONE, not renamed -- every one of its 14 call sites got a real role (fsSm,
//   fsKey, or fsMono) in this same patch. See CE-INDEX STYLE2-SWEEP for the reasoning
//   per site; nothing here approximates "small metadata" as a bare pixel value anymore.
// s5/rCard/rPill/ctl/fsD1/fsD2/fsH/fsKey/fsMono/mFast/mBase/mSlow/ease are NEW and
// ADDITIVE -- nothing before this line depended on them, so nothing broke by adding them.
var CE_T = {
    s1: '4px', s2: '8px', s3: '12px', s4: '16px', s5: '24px',
    tap: '44px',        // MINIMUM HIT AREA. Not the same thing as visual size -- see ceIconBtn.
    ctl: '32px',        // standard VISUAL height of an icon control, inside a 44px hit area
    // [THEME-VAR] Spelled out rather than through ceVar() only because CE_T is
    // declared above it. Same contract; see the block on CE_LINE.
    r: 'var(--ce-radius, 4px)', rCard: 'var(--ce-radius-card, 10px)', rPill: '999px',
    fs: '14px', fsSm: '12.5px',
    // named roles for the new primitives (SS5) -- ceD1/ceD2/ceH/ceKey/ceMono read these
    fsD1: '25px', fsD2: '19px', fsH: '15px', fsKey: '10.5px', fsMono: '11.5px',
    // line-height (SS3). MISSING from the earlier CE_T rebuild -- added here because
    // ceGroup/ceRow (Field density, SS7.2) need lhTight and ceSection prose (SS7.1) needs
    // lhProse, and neither existed as a token before this pass.
    lhProse: '1.6', lhTight: '1.35',
    // motion (SS9). NO LONGER A STRANDED COPY: the worker still cannot READ the active
    // theme, but a theme can now PUSH its timing in through these names, which is the same
    // outcome from the other direction. 80ms is NovelAI's own default transitions.interactive.
    mFast: 'var(--ce-motion-fast, 80ms)', mBase: 'var(--ce-motion-base, 140ms)',
    mSlow: 'var(--ce-motion-slow, 240ms)', ease: 'var(--ce-motion-ease, ease-in-out)'
};
// The opacity ladder (SS4). THREE VALUES. A fourth anywhere in SECTIONS 28-35 is a bug --
// see CE-STYLE v2.0 SS12 check 2. Kept as a real object (not just documented literals)
// so ceMeter/future primitives can reference it directly; existing call sites
// still write the literal ('0.74'/'0.58') per the audit's own grep pattern, and that is
// unchanged and intentional, not a second, competing convention.
var CE_OP = { t1: '1', t2: '0.74', t3: '0.58' };

// ── HOST THEME INHERITANCE — the contract  [THEME-INHERIT] ──────────────────
// CE TAKES COLOUR AND BACKGROUND FROM THE HOST, AND PINS ITS OWN TYPE METRICS.
//
// The first half was not designed, it fell out of the sandbox: there is no colour token
// here to paint an opaque surface with, so CE_LINE/CE_FILL are derived from currentColor
// and panels are background:'inherit'. The consequence is worth naming, because it is a
// property worth protecting -- every hairline, fill, divider and button in CE tracks the
// active .naitheme's textMain/bg automatically, INCLUDING POLARITY. 6%-of-currentColor is
// dark ink on a light theme and light ink on a dark one with no branch anywhere. Do not
// introduce a literal surface colour; it would be the one element that stops following.
//
// The second half IS a decision. font-family also inherits, so a theme's `fonts.default`
// reaches every CE label that does not set one -- and that is mostly desirable. It is NOT
// desirable at the two micro-label roles: ceKey and ceH3 are 10.5px, uppercase, and
// tracked ~0.1em, metrics tuned against a normal UI stack. A wide display face (Orbitron
// in the themes that prompted this) overflows or wraps them while every other role is
// fine. So those two pin CE_UI_FONT and nothing else does.
//
// THE CONTENT HUES DO NOT FOLLOW THE HOST AND ARE NOT MEANT TO -- a pattern hue says whose
// screen this is, and a hue that moved with the theme would stop saying it. They were the
// last thing a theme could not reach at all; they are now NAMED instead (--ce-pat-<id>,
// --ce-sem-<level>), which is the same outcome by the honest route: the author decides,
// rather than a hue-rotation deciding for them. The shipped values are still fixed hex
// tuned for a dark host (#ff6b6b is ~2.9:1 on a light theme), so a light-host theme that
// wants contrast now has somewhere to say so.
// THE CHAT-LANE PALETTE IS SEPARATE AND STILL DOES NOT FOLLOW. It is computed from a hex
// the author picked per story (see the CE_CB_PALETTE block), which a var() cannot carry.
var CE_UI_FONT = 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
var CE_DISP = 'Eczar, Georgia, "Times New Roman", serif';   // display face stack, SS5
var CE_MONO_FONT = '"Source Code Pro", Menlo, Consolas, monospace';

// -- Reduced motion (SS9.2) --------------------------------------------------
// `prefers-reduced-motion` IS NOT DETECTABLE HERE -- there is no matchMedia in the worker
// sandbox -- so the switch is an explicit preference, and CE-STYLE v2.0 SS9.2 specifies the
// mechanism precisely: "drops every duration to 0ms by swapping one token. Because
// durations are tokens, that switch is a one-line change and cannot miss a call site."
//
// IT IS IMPLEMENTED AS A MUTATION OF CE_T RATHER THAN A ceDur() ACCESSOR, deliberately.
// An accessor is the tidier shape but it is OPT-IN: every future primitive has to remember
// to call it, and the one that forgets animates through the switch. Mutating the token
// object is TOTAL -- every reader of CE_T.mFast/mBase/mSlow, written before or after this
// line, past or future, gets '0ms' with no call site aware that anything happened. That is
// the property SS9.2 is actually asking for, and it is worth the mild ugliness.
// Safe because every read is at RENDER time (a style object is built per render), never
// captured once at module load, and flipping the switch patches a store, which repaints.
var CE_MOTION = { mFast: '80ms', mBase: '140ms', mSlow: '240ms' };   // the real durations
var CE_REDUCE_MOTION = false;
function ceMotionApply(reduce: boolean): void {
    CE_REDUCE_MOTION = !!reduce;
    CE_T.mFast = reduce ? '0ms' : CE_MOTION.mFast;
    CE_T.mBase = reduce ? '0ms' : CE_MOTION.mBase;
    CE_T.mSlow = reduce ? '0ms' : CE_MOTION.mSlow;
}
// ACCOUNT-LEVEL, not story-level: this is a property of the person reading the screen, not
// of the story file, so it rides api.v1.storage (global script settings) rather than
// GlobalConfig/storyStorage like every other Settings row. Same load/save shape as CE_DIAG
// above -- module var, IIFE loader, async setter -- which is this file's established
// pattern for exactly this tier.
var CE_MOTION_STORAGE_KEY = 'ce_reduce_motion';
(async function _ceMotionInit() {
    try {
        var raw = await api.v1.storage.getOrDefault(CE_MOTION_STORAGE_KEY, '');
        if (String(raw) === '1') ceMotionApply(true);
    } catch (_eMoInit) { /* keep motion on -- the default is the unmodified behaviour */ }
})();
async function ceMotionSet(reduce: boolean): Promise<void> {
    ceMotionApply(reduce);
    try { await api.v1.storage.set(CE_MOTION_STORAGE_KEY, reduce ? '1' : '0'); }
    catch (_eMoSet) { api.v1.error('[AE:jsxkit] reduce-motion persist failed'); }
}

// [SHELL-WINDOW] WHICH CONTAINER THE SHELL OPENS IN: NAI's full-size modal
// (default, unchanged) or a floating, resizable window. ACCOUNT-LEVEL, same tier and same
// load/save shape as CE_REDUCE_MOTION above and for the same reason -- it is a property of
// the person and the screen they are on, not of the story file.
//
// IT IS TWO THINGS AT ONCE and both are wanted. First, the feature: a full-size modal
// covers the document, which is why _ceWizChatCloseShell has to close the whole shell
// before WIZLIVE writes its marker into the story, and why Chat's contact rows do the
// same. A window makes that hand-off unnecessary rather than merely tolerable.
// Second, the diagnostic: the window swaps NAI's modal content wrapper for a different
// one, so if the ghost-header duplication is happening ABOVE our jsx host it should change
// character or disappear entirely in window mode. That is a cleaner discriminator than any
// probe we can write from inside the host.
//
// TAKES EFFECT ON THE NEXT OPEN, not immediately. The toggle lives on the Settings surface
// INSIDE the shell, so applying it live would mean destroying the container the switch is
// painted in mid-tap; the row says so and the setter toasts it.
//
// THE ONE THING TO WATCH is the height chain. ceJsxPart hard-codes height:100%/minHeight:0
// and ceScreen is a height:100% grid; a modal gives that a definite height to resolve
// against and a resizable window may not. `minPx` on ceJsxPart is the floor that keeps a
// surface from collapsing to nothing if it does not -- it is passed ONLY in window mode, so
// modal behaviour is byte-identical to earlier.
var CE_SHELL_WINDOW = false;
var CE_SHELL_WINDOW_KEY = 'ce_shell_window';
var CE_SHELL_WINDOW_MIN_PX = 420;
(async function _ceShellWindowInit() {
    try {
        var rawW = await api.v1.storage.getOrDefault(CE_SHELL_WINDOW_KEY, '');
        CE_SHELL_WINDOW = (String(rawW) === '1');
    } catch (_eWinInit) { /* keep the modal -- the default is the unmodified behaviour */ }
})();
async function ceShellWindowSet(useWindow: boolean): Promise<void> {
    CE_SHELL_WINDOW = !!useWindow;
    try { await api.v1.storage.set(CE_SHELL_WINDOW_KEY, useWindow ? '1' : '0'); }
    catch (_eWinSet) { api.v1.error('[AE:jsxkit] shell-window persist failed'); }
}

// -- Type scale --------------------------------------------------------------
// [STYLE2] REBUILT against CE-STYLE v2.0, and this is the one primitive change
// in this patch that is NOT purely additive -- read the whole comment before touching it.
//
// ceH1 and ceH2 are UPGRADED IN PLACE, same name, same call sites, new values -- safe
// because their DOCUMENTED ROLE never changed ("surface title, once per surface" IS
// ceD1's role; "the load-bearing line of a card" IS ceH's role). Every existing caller
// gets the fix for free, which is the point of a token system, and there was no per-site
// judgment call to make: the role was already correct, only the treatment was dated.
//
// ceH3 is DELIBERATELY LEFT ALONE beyond the opacity-ladder sweep already applied to it.
// CE-STYLE v2.0 splits its one job into TWO roles that render differently -- ceD2 (a
// Read-density section head, 19px serif, no uppercase) and ceKey (a Field-density group
// label, 10.5px uppercase, exactly what ceH3 already does). Every existing ceSection()
// call site uses ceH3 for BOTH jobs today, and nothing in the code says which is which --
// that is a per-surface density call (CE-STYLE v2.0 SS7's own test: "is this prose, or
// fields, or records?"), not a mechanical one. Reclassifying these call sites into a
// density is the re-skin sweep (roadmap Phase D), not this pass. ceD2 and ceKey are
// built below as NEW, independently callable primitives so that work has something to
// migrate TO -- they are not wired into ceSection, and ceSection's behaviour is
// unchanged apart from the opacity fix everything else in SECTION 28-35 already got.
// [STYLE2-D] CORRECTED COUNT: an earlier pass wrote "281 call sites"
// here without grep-verifying it -- exactly the failure this project's own "read before
// patching" rule exists to catch. The real, verified number going into Phase D was 38 real
// call sites. A raw grep for the bare token returns a higher number because it also
// matches this function's own definition and any comment that mentions it by name --
// including this one -- so the count that matters is call SHAPES: a bare invocation, a
// return statement, a body.push, or an assignment, each ending in an open paren the way an
// actual call site does. That is what was actually counted here.
// (Note for future edits: do not quote an unmatched fragment like the ones above, verbatim,
// inside a comment in this file. This exact mistake broke the balance-delta gate once
// already this patch -- see the ceIconBtn note nearby -- and a comment counts exactly as
// much as code for that gate.)
// Left as a record of the mistake rather than silently corrected, since a wrong number
// that was never checked is worth knowing happened at all.
function ceH1(text: any): any {
    return h('div', { style: { fontFamily: CE_DISP, fontSize: CE_T.fsD1, fontWeight: '600',
        letterSpacing: '-0.01em', lineHeight: '1.1' } }, text);
}
function ceH2(text: any): any {
    return h('div', { style: { fontSize: CE_T.fsH, fontWeight: '600', letterSpacing: '-0.005em', lineHeight: '1.3' } }, text);
}
function ceH3(text: any): any {
    return h('div', { style: { fontFamily: CE_UI_FONT, fontSize: CE_T.fsKey, fontWeight: '500',
        letterSpacing: '0.09em', textTransform: 'uppercase', opacity: CE_OP.t3 } }, text);
}
// -- NEW roles, additive. Not yet consumed by any existing surface -- see the comment
// above. ceD1/ceH are aliases for the (unchanged-role) primitives above, so new code can
// use either the historical name or the CE-STYLE v2.0 name and get the same function.
var ceD1 = ceH1;
var ceH = ceH2;
// ceD2 -- a Read-density section head (CE-STYLE v2.0 SS5, SS7.1). Serif, no uppercase, no
// tracking: this is a HEADING over prose, not an eyebrow labelling fields.
// [THEME-VAR2] A SECTION HEAD IS THE MOST THEMEABLE THING ON A CE SURFACE and had no name
// of its own -- it inherited `color` and was indistinguishable from prose to a stylesheet.
// Three names now: the ink, the face, and the weight. `inherit` keeps today's behaviour.
function ceD2(text: any): any {
    return h('div', { style: { fontFamily: 'var(--ce-head-font, ' + CE_DISP + ')',
        fontSize: 'var(--ce-head-size, ' + CE_T.fsD2 + ')',
        fontWeight: 'var(--ce-head-weight, 600)', lineHeight: '1.2',
        color: 'var(--ce-head, inherit)' } }, text);
}
// ceKey -- a Field-density group label (CE-STYLE v2.0 SS5, SS7.2). Identical treatment to
// ceH3 today by construction (ceH3 already had this exact job for half its call sites);
// declared as its own function so a call site can say what density it means rather than
// inheriting whichever job ceH3 happened to be doing that day.
// [THEME-VAR2] The CATEGORY label -- every group head, every eyebrow. Its own ink and its
// own tracking, because an uppercase eyebrow is where a display face earns its keep and
// 0.1em is right for a grotesque and wrong for a condensed one.
function ceKey(text: any): any {
    return h('div', { style: { fontFamily: 'var(--ce-key-font, ' + CE_UI_FONT + ')',
        // [THEME-VAR3] SIZE AND TRANSFORM, because a family token alone is a trap. This
        // label is 10.5px uppercase with 0.1em tracking -- correct for a grotesque eyebrow
        // and ILLEGIBLE for a brush or blackletter face, which is exactly the kind of face
        // a theme wants here. A theme that changes the family must be able to change the
        // two things that make the family readable, or the honest advice is "don't".
        fontSize: 'var(--ce-key-size, ' + CE_T.fsKey + ')', fontWeight: '600',
        letterSpacing: 'var(--ce-key-track, 0.1em)',
        textTransform: 'var(--ce-key-transform, uppercase)',
        opacity: 'var(--ce-key-opacity, ' + CE_OP.t3 + ')',
        color: 'var(--ce-key, inherit)' } }, text);
}
// ceMono -- numbers, ids, counts, timestamps (CE-STYLE v2.0 SS5). Never prose.
// [STYLE2] `opts` is NEW and additive -- every existing bare
// ceMono(text) call is unaffected. Added because three Settings call sites (the
// condition/lorebook macro-hint lines, the diagnostics log dump) needed opacity and/or
// whiteSpace on top of the monospace treatment and had started hand-writing
// `fontFamily: 'monospace'` + `fontSize: CE_T.fsMono` at the call site instead -- the
// generic 'monospace' fallback (not CE_MONO_FONT's Source Code Pro stack) was itself
// drift. SS1's own rule ("A surface composes primitives. It does not write style. If a
// surface needs a value that isn't a token, either the token set is incomplete or the
// primitive is.") says the fix belongs here, not as a comment excusing three call sites.
// [THEME-VAR4] SIZE, for the reason ceKey's own note already gives: a family token without a
// size token is a trap. This role is 11.5px, and it is the role that carries clock readouts
// and counts -- a condensed face sets loose at that size and a wide one overflows the row it
// shares. head and key both had a size token from the start; this one was the gap.
function ceMono(text: any, opts?: { opacity?: string; style?: any }): any {
    var style: any = { fontFamily: 'var(--ce-mono-font, ' + CE_MONO_FONT + ')',
        fontSize: 'var(--ce-mono-size, ' + CE_T.fsMono + ')', color: 'var(--ce-mono, inherit)' };
    if (opts && opts.opacity) { style.opacity = opts.opacity; }
    if (opts && opts.style) { for (var k in opts.style) { style[k] = opts.style[k]; } }
    return h('div', { style: style }, text);
}
// ── THE THEME CONTRACT  [THEME-VAR] ─────────────────────────────────────────
// EVERY COLOUR, RADIUS AND DURATION BELOW IS var(--ce-<name>, <what it was>).
// Set nothing and the engine looks exactly as it did; set a name and every call
// site follows, because these tokens are DEFINED once and READ ~160 times.
//
// WHY A CUSTOM PROPERTY IS THE ONLY MECHANISM. This surface mounts in an OPEN
// SHADOW ROOT. A stylesheet in document.head -- which is what a NovelAI theme is
// -- DOES NOT APPLY inside one, so no class, id or data-attribute a theme could
// name would ever match, and an inline style would beat it anyway. Custom
// properties INHERIT ACROSS THE BOUNDARY. That is the whole of it.
//
// HOW AN AUTHOR SETS THEM: a `:root{...}` block in the theme's `global` string.
// Settings > Appearance > Theme tokens lists every name with a live swatch, so a
// name that is not taking effect is visible rather than guessed at.
//
// ADDING A TOKEN: define it here with the literal it replaces as the fallback,
// then add it to CE_THEME_TOKENS so the probe lists it. A token missing from
// that list is a name no author will ever discover.
//
// NINE GROUPS, 92 NAMES, AND THE LIST IS THE INDEX -- read CE_THEME_TOKENS, not this
// comment, for what exists. Chrome, Map, Icons and Type are structure and paint; Hue is
// content identity (eight patterns, the attention family); Switch, Bubble and Shape are
// component vocabularies; Effect is the two slots that paint NOTHING until asked.
//
// WHAT A THEME STILL CANNOT REACH, and why each is deliberate rather than pending:
//   ceD1 / ceH / ceBody / ceSm carry no ink token. They INHERIT, which is the correct
//     default and the reason a page's textMain already repaints most CE ink for free. The
//     cost is real and accepted: a theme cannot separate a surface title from body copy.
//   --ce-sem-calm does not exist. See the CE_SEM block -- 'calm' is the absence of a hue.
//   Bubble GEOMETRY is structure, not paint. Which edges close the head/tail seam is not
//     an author's choice and is not exposed.
//
// THREE LEADS FROM THE 2026-08-16 SURFACE PROBE, CLOSED HERE SO NONE IS RETRIED. Each was
// reported as a split needing a merge; each was measured against the source and is not one.
//   "Section heads are split, one of them is not ceSection." They are not. ceSection is the
//     only head+rule shape in this file -- one definition, one hairline construction, 42
//     call sites -- so Scene, Journal and the Theme-tokens panel take --ce-head together or
//     not at all. A head that looked untokened was a head the theme's --ce-head did not
//     reach, which is a theme-side question.
//   "Write surfaces are split, --ce-well versus --ce-fill-2." Neither half holds. The
//     Presence field is ceFilterField over a plain ceField, whose ground is --ce-fill, not
//     --ce-fill-2. And it is a FILTER, not a composer: ceField's three-state ladder
//     (transparent read / CE_FILL editable / CE_WELL compose-here) is the documented design
//     right above inputStyle, and collapsing it would lose the distinction it exists to draw.
//   "--ce-gauge arrives but is not used." It is used, as the fill for every gauge carrying
//     no identity hue -- ceMeter, ceTrack and three ceDayStrip sites all read `hue ||
//     CE_GAUGE`, and hue is empty on an ordinary state row. A probe that saw no change was
//     looking at a row that had one.
function ceVar(name: string, fallback: string): string {
    return 'var(--ce-' + name + ', ' + fallback + ')';
}

var CE_LINE = ceVar('line', 'color-mix(in srgb, currentColor 14%, transparent)');
// A second, heavier hairline. Needed because the accordion's expanded rail and
// a selected card edge have to read as stronger than a divider, and opacity cannot do it --
// the rail sits on the same background as the divider it must out-weigh.
var CE_LINE2 = ceVar('line-2', 'color-mix(in srgb, currentColor 30%, transparent)');
var CE_FILL = ceVar('fill', 'color-mix(in srgb, currentColor 6%, transparent)');
// [STYLE2] The pressed/hover ground (SS3, 12%). NEW, and it is what makes SS9.1's
// press state possible at all: a press has to read as a step ABOVE CE_FILL on a control
// whose rest ground may ALREADY be CE_FILL (every 'primary' ceBtn), so a press cannot be
// expressed by reusing the same fill and cannot be expressed by opacity either -- SS4
// reserves opacity for text tiers and this is a ground, not text.
var CE_FILL2 = ceVar('fill-2', 'color-mix(in srgb, currentColor 12%, transparent)');
// [STYLE2] The focus ring (SS9.1: "boxShadow: 0 0 0 2px <hue> -- a real ring,
// never a colour swap"; SS11: "Focus is always visible"). NEW.
// SS9.1 writes the ring colour as "<hue>", which is right for a control that HAS an
// identity hue -- but most controls in the kit have none (SS6.3: "A character with no
// pattern has no hue. That is information; do not fill it with grey."). A focus ring is
// chrome, not identity, so borrowing a character's pattern hue for it would be saying
// something false. 45% currentColor is the neutral answer: heavier than CE_LINE2 so it
// reads as a ring rather than a border thickening, and theme-independent like everything
// else derived from currentColor. A control that DOES own a hue may pass its own.
var CE_RING = ceVar('ring', 'color-mix(in srgb, currentColor 45%, transparent)');
// [I-05] CE_GAUGE -- THE ONE DERIVED FILL THAT IS CONTENT RATHER THAN CHROME, and the reason
// it needs its own value rather than reusing one above. Every other mix here (6%, 12%, 14%,
// 30%, 45%) is a hairline or a ground: something you are meant to look PAST. A gauge fill is
// the thing being read -- it has to carry a value at a glance against a CE_LINE track, on both
// theme polarities, and CE_RING at 45% is still visibly translucent when it is the only mark
// on the row. SS6.3 #4 already rules that a meter fill is never dimmed by opacity, so the
// weight has to come from the mix and nowhere else.
// DO NOT REACH FOR IT AS A GROUND. It is the one value in this file loud enough to be wrong
// everywhere except inside a gauge.
var CE_GAUGE = ceVar('gauge', 'color-mix(in srgb, currentColor 62%, transparent)');
// [EVT-POLARITY] THE GAUGE'S TWO POLARITIES. Both are named because CE-STYLE requires both
// states of a paired control to exist as tokens -- naming only the bad one would leave a
// theme able to say "danger" and unable to say "not danger".
// THEY FALL BACK TO THE PLAIN GAUGE, so a theme that sets neither renders exactly as every
// meter in the file rendered before this: an unset token is a no-op, never a blank bar.
var CE_GAUGE_UP = ceVar('gauge-good', CE_GAUGE);
var CE_GAUGE_DOWN = ceVar('gauge-ill', CE_GAUGE);
// [WRITE-WELL] THE ONE BLACK IN THE KIT, and it is a deliberate
// exception to "no color token" rather than a slip. Every other surface treatment derives
// from currentColor, which TINTS TOWARD THE TEXT -- on a dark theme CE_FILL is LIGHTER
// than its background, so it cannot express a recess at all. A well has to read as depth,
// and depth is black on every theme in existence: a translucent black inset darkens a
// light surface and deepens a dark one, which is exactly the one behaviour needed here.
// USE IT ONLY FOR A DEDICATED WRITE SURFACE -- an input the author composes INTO, as
// opposed to stored prose that happens to be editable. If it starts appearing on read
// surfaces it has stopped meaning anything. 0.14 is tuned for a dark theme; if it reads
// as a grey slab on light, drop it, do not add a second value.
var CE_WELL = ceVar('well', 'rgba(0,0,0,0.14)');
// The attention family. Semantic colour is content identity, not chrome -- same standing as
// the pattern hues, and like them each is now a theme token carrying its old literal as the
// fallback. A theme that sets nothing looks exactly as it did.
// [SEM-KEY-FIX] 'watch' renamed to 'building'. _ceDramaAttention returns
// 'ask' | 'building' | 'calm', and ceSceneRoot passes att.level straight into ceDot, so
// CE_SEM['building'] was an undefined lookup falling through to 'transparent' -- the amber
// mid-state had never rendered on any surface. The key now matches the vocabulary the engine
// already produces, rather than the kit draft's private synonym.
//
// 'calm' IS A LITERAL ON PURPOSE AND MUST STAY ONE. It is the ABSENCE of a hue, which
// SS6.3 rules is itself information ("do not fill it with grey"), so there is nothing for a
// theme to paint. It is also load-bearing as a literal: ceDot and the Scene avatar ring both
// decide whether to draw a hairline ring by testing the resolved value against 'transparent',
// and a var() expression is never equal to its own fallback. Tokenising 'calm' silently
// deletes the ring on every calm character. Do not.
//
// [SEM-OK] 'ok' EXISTED AS A CALL SITE BEFORE IT EXISTED AS A KEY. The chat card's
// "in story" label reads CE_SEM.ok, which was undefined -- an inline `color: undefined` is
// dropped, so the label has always painted in inherited ink. It is declared here with
// `inherit` as its fallback, which renders byte-identically to what shipped and gives the
// label a name a theme can reach. Picking a literal hue for it is a design decision nobody
// has made; this does not make it.
var CE_SEM: { [k: string]: string } = {
    ask: ceVar('sem-ask', '#ff6b6b'),
    building: ceVar('sem-building', '#e8c07d'),
    ok: ceVar('sem-ok', 'inherit'),
    calm: 'transparent'
};

// -- The image anchor ---------------------------------------------------------
// [earlier CE-IMG-ATTR, earlier relocated here from SECTION 30 -- Scene needs this too,
// which makes it kit-level, not Profile-specific, same status as ceField itself] A jsx
// surface names its own elements, so an image anchor here is an ATTRIBUTE, not hidden
// text. jsx-typings_d.txt declares
//     [key: `data-${string}`]: string | number | boolean | undefined
// on ScriptHTMLAttributes — arbitrary data-* attributes are whitelisted on every element.
// THAT IS WHY THIS IS NOT THE CHAT PAINTER'S MECHANISM. AE_CHARCHAT_IMG_SENTINEL and
// AE_CHARCHAT_AVA_SENTINEL hide a magic string in a text node because their anchors are
// NAI DOCUMENT WIDGETS, where the engine can put text inside an element but cannot label
// one. Nothing about that constraint applies in here, and porting it anyway would have
// shipped a bug: the bridge's bounded-climb heuristic ("climb while the ancestor's text is
// only the sentinel") stops on the 1px wrapper the sentinel sat in, because the frame
// above it also holds the '+' placeholder. It would have painted a portrait into a
// one-pixel square.
//
// FLAG-DAY LITERAL, and now there is exactly one: 'data-ce-img' is duplicated bridge-side
// as CE_IMG_ATTR. Change it in one file only and every surface image silently stops
// binding, with no error anywhere.
//
// PAYLOAD IS 'charId|slotName', AND slotName IS A STORAGE SLOT, NOT A RATIO. The earlier
// draft carried the box ratio ('portrait' / 'avatar' / 'scene'), which says which BOX to
// fill but never which IMAGE goes in it. Slot names are the bridge's own vocabulary
// (Avatar, Snapshot, and the 24 canonical emotions — the same 24 the Emotion contract
// pins) and they are already the IndexedDB key suffix, so 'Avatar' or 'Joy' resolves with
// no translation table. GEOMETRY STAYS HERE: this file draws the box, the bridge covers
// it. Ratios are a sizing decision for the surface, not a lookup key.
const CE_IMG_ATTR = 'data-ce-img';
const CE_IMG_SLOT_AVATAR = 'Avatar';
// [SCENE-STAGE] ITS OWN SLOT, NOT A TREATMENT OF THE AVATAR. Avatar and the 24 emotion
// slots are 2:3 portraits generated WITH a background and framed at the bust; standing one
// of those on a floor line is a floating head and shoulders. A standee is full-body, framed
// to the feet and generated on a transparent background -- a different picture, so a
// different slot. It needs no bridge change and no new storage convention: the painter's
// resolver sends every non-Avatar slot to charId + '_em_' + slot already.
const CE_IMG_SLOT_STANDEE = 'Standee';

// [CEGAL] THE SECOND ANCHOR FORM, and the reason the Gallery was blocked until
// now: every anchor before this one was 'charId|slot', and a GALLERY RECORD HAS NEITHER --
// it is keyed by uuid in the bridge's IndexedDB. The KIND therefore rides the charId
// position as an opaque sentinel ('ce-gallery|<uuid>'), which keeps ONE attribute, ONE
// query per root per tick, and leaves the options field working unchanged. Same shape as
// CC_POV_INTERVIEW riding the povId position.
// FLAG-DAY LITERAL: also declared bridge-side as CE_IMG_GAL (bridge earlier). It is
// deliberately not a possible character id.
const CE_IMG_GAL = 'ce-gallery';

// [CE-IMG-OPTS] A third, optional payload field: 'charId|slot|k=v,k=v'. The
// bridge ignores tokens it does not know, so a fourth option later is additive and needs
// no flag day — only the ATTRIBUTE NAME is a flag-day literal.
//   CE_IMG_COLLAPSE     when the slot is EMPTY, the anchor leaves layout entirely
//   CE_IMG_SHRINK       when the slot is EMPTY, the anchor sheds its box onto its fallback
//   CE_IMG_CONTAIN      show the whole image rather than cover-cropping it
//   CE_IMG_POS_BOTTOM   sit the image on the box's bottom edge instead of centring it
//
// WHY EMPTINESS IS THE BRIDGE'S CALL AND NOT A GATE AT EMISSION HERE. The plan of record
// was for this file to withhold the anchor for a character with no avatar, so no space is
// reserved for a picture that does not exist. THIS FILE CANNOT KNOW THAT. Image bytes live
// only in the bridge's IndexedDB and nothing has ever told the engine what is in there.
// Keeping a record here of "who has an image" would be a MIRROR of that store, and the
// mirror's failure mode is silent and points the wrong way: an image that exists but is
// missing from the record NEVER PAINTS, because the anchor is never emitted. The drift is
// not hypothetical — every portrait already made in the bridge's Portrait Studio predates
// any such record, bridge-side deletes and AE_DELETE_PORTRAIT_CASCADE bypass it, and
// IndexedDB is per-browser-profile while storyStorage follows the account.
// So: ALWAYS EMIT THE ANCHOR, and pass CE_IMG_COLLAPSE when an empty box would waste
// space. display:none removes the element from flex layout INCLUDING its gap, so the
// result is identical to withholding it — decided by the party that actually knows.
// A COSMETIC hint (a launcher cell's weight, a "7 of 26" count) may still be kept
// engine-side if it is ever worth it; a LOAD-BEARING gate may not.
const CE_IMG_COLLAPSE = 'collapse=1';
// Same intent as CE_IMG_COLLAPSE for the opposite contents. COLLAPSE is for an
// anchor with nothing inside it (remove the element). SHRINK is for an anchor that WRAPS A
// FALLBACK -- it drops the anchor's own box (size, border, background, radius) and leaves
// the child standing, so an empty avatar frame becomes exactly the glyph it was wrapping.
const CE_IMG_SHRINK = 'shrink=1';
const CE_IMG_CONTAIN = 'fit=contain';
// [SCENE-STAGE] CONTAIN ALONE LEAVES A STANDEE FLOATING. object-fit and object-position are
// two properties and the painter only ever set the first, so a contained image sits at the
// 50% 50% default -- vertically centred, with a band of empty box under the feet. Bottom is
// the only value any surface has wanted, so it is a flag rather than a coordinate.
// CROSS-ARTIFACT: the bridge's _ceSurfImgPaintOne is the only reader, and _ceSurfImgParse
// drops tokens it does not know, so an older bridge draws the standee centred rather than
// failing the anchor.
const CE_IMG_POS_BOTTOM = 'pos=bottom';
// [SCENE-STAGE-ROW] WHICH WAY THE SOURCE ART LOOKS, so the bridge can mirror whoever ends up
// facing out of the picture. THE VALUE IS THE ART'S DIRECTION, NOT AN INSTRUCTION TO FLIP:
// this file cannot name who to mirror, because under flex it knows neither who painted nor
// where they landed, and that is exactly the fact the bridge has for free. Emitted with its
// leading comma or as '' so a call site can concatenate it unconditionally.
// CROSS-ARTIFACT: read only by _ceSurfImgFace. An older bridge drops the token and draws
// every standee as-is, which is the layer-off look rather than a broken one.
function ceImgFaceOpt(facing: string): string {
    if (facing === 'right' || facing === 'left') return ',face=' + facing;
    return '';
}

// Folds the anchor onto a props object so every call site (26 Profile slots, Scene's
// present-roster thumbs, and whatever comes after) spells the attribute the same way.
// Returns the SAME object it was handed — call it around the props literal, never on a
// shared one. `opts` is a comma-joined list of the CE_IMG_* tokens above, or omitted.
// [SS-BOX LOC-PROFILE3] THE ANCHORED IMAGE FRAME, AS A PRIMITIVE. Two surfaces
// want the same thing -- a fixed box the bridge paints an <img> into, with a placeholder
// glyph underneath and a tap that opens the image editor -- and the second one (SECTION
// 36) has a raw-style budget of ZERO. That is SS1's own escape clause firing exactly as
// written: the rule was not that the second surface should go without a picture, it was
// that a value the surface needs and the kit does not have means THE KIT IS INCOMPLETE.
//
// ASPECT IS A PARAMETER BECAUSE A PLACE IS NOT A PERSON. A portrait is 2:3 and a location
// is usually wider than it is tall -- the same asymmetry EntityRecord.imgWidth/imgHeight
// already encodes as a landscape default. 'portrait' | 'landscape' | 'square'.
//
// THE FRAME IS THE ANCHOR. The '+' is the empty state and stays in the tree: the bridge
// paints its <img> absolutely OVER this node when the slot has an image and leaves it
// alone when it does not, so "no picture yet" needs no second branch on either side.
// The glyph carries its own opacity rather than the frame carrying it, because CSS opacity
// applies to the whole subtree and the bridge's <img> is a CHILD of this exact node --
// the HERO-DIM-FIX bug, which is easy to reintroduce and impossible to see in review.
// 'banner' IS FULL-WIDTH WITH A FIXED HEIGHT, not an aspect ratio. The painter appends
// its <img> as position:absolute with height:100%, so the anchor needs a real height of
// its own -- _ceEntityImage's own note already settled this and the reasoning is not
// re-litigated here: `aspectRatio` has no precedent anywhere in this file and nothing is
// built on a CSS property this environment has not been observed handling. 200px against
// a full-width column is close enough to 1216x832 on a phone.
var CE_IMG_FRAME_DIMS: any = {
    portrait:  { w: '84px', h: '126px' },
    landscape: { w: '126px', h: '84px' },
    square:    { w: '96px',  h: '96px' },
    banner:    { w: '100%',  h: '200px' }
};
function ceImgFrame(recId: string, slot: string, aspect: string, opId: string, onTap: any, glyph?: string): any {
    var d: any = CE_IMG_FRAME_DIMS[String(aspect || 'portrait')] || CE_IMG_FRAME_DIMS.portrait;
    return h('div', ceImgAnchor(recId, slot, {
        onClick: onTap ? function() { ceTap(String(opId || 'imgframe'), function() { onTap(); }); } : undefined,
        role: onTap ? 'button' : undefined, tabIndex: onTap ? 0 : undefined,
        style: {
            flex: '0 0 auto', width: d.w, height: d.h, borderRadius: CE_T.r,
            background: CE_FILL, cursor: onTap ? 'pointer' : 'default',
            position: 'relative', overflow: 'hidden',
            display: 'flex', alignItems: 'center', justifyContent: 'center'
        }
    }),
        h('div', { style: { fontSize: '20px', opacity: CE_OP.t3 } }, String(glyph || '+'))
    );
}

function ceImgAnchor(charId: string, slot: string, props: any, opts?: string): any {
    var out: any = props || {};
    var v = String(charId || '') + '|' + String(slot || '');
    if (opts) { v = v + '|' + String(opts); }
    out[CE_IMG_ATTR] = v;
    return out;
}

// -- Stores ------------------------------------------------------------------
// Split by CHANGE FREQUENCY, not by feature: ScriptStore.subscribe takes a
// zero-argument listener and useStoreValue returns the whole value, so there is
// no selector layer - every subscriber of a store repaints on any change to it.
// One monolithic store would mean a keystroke in Settings repaints the Map.
//
// These are READ PROJECTIONS. Views never write them; actions write storage and
// then publish. They die with the engine on story switch, which is correct -
// nothing lives only here.
var ceUiStore: any = null;
var ceSceneStore: any = null;

function ceStoresInit(): void {
    if (ceUiStore) return;
    try {
        // [earlier, RENAMED earlier OPEN-MAP-RENAME] open / profileDrill / profileStep
        // are pure session UI, the same call tempStorage-vs-storyStorage already makes for
        // the field reveal list. They live here rather than in ceProfileStore because
        // navigating must not repaint the record.
        // [NAV-BACK] `back` is a ONE-DEEP return address, not a history stack:
        // { surface, entityId, label }. It exists because the Journal surface is the first
        // one reachable from two places (Scene and a Profile launcher), so no surface can
        // hard-code where its own Back goes any more. One deep is enough while every
        // screen in this shell is one step from the shell root, and a real stack is not
        // worth its bugs until something is three deep.
        // [PICKER] `picker` is the SEVENTH-SURFACE SLOT and it lives here, not on
        // profileDrill, because a reference field is chosen from more than one surface --
        // see the block above _cePickerSurface for the full argument. Shape:
        // { kind, ctx } | null, where kind indexes CE_PICKER_DEFS.
        // [PHOTO-VIEW] `photo` is the EIGHTH-SURFACE-SLOT, shaped and handled
        // exactly like `picker` (see the block above CE_PICKER_DEFS): a full swap over
        // whatever is underneath, intercepted in ceRoot, cleared by ceNav. { charId, slot,
        // label } | null.
        // [GEN-INLINE] `slotOpts` is the OPEN FIELD GENERATOR, and it is NOT a
        // surface slot -- it renders INLINE under the field it writes to (_ceGenBtn), not
        // as a swap over whatever is underneath. It is still cleared by ceNav for the same
        // reason `picker` is: nothing is written until a candidate is tapped. Shape:
        // { charId, fieldKey, label, instructions, budget, count, method, status,
        //   options[], note } | null. One open at a time, keyed by (charId, fieldKey).
        ceUiStore = createStore({ surface: 'scene', entityId: '', tab: '', sheet: null, busy: {},
                                  open: {}, profileDrill: '', profileStep: 0, back: null,
                                  picker: null, photo: null, slotOpts: null, stShow: {} });
        // [PHASE-G-PRIME] locationImgW/H are the PROJECTED render shape of the
        // location's own image (EntityRecord.imgWidth/imgHeight). 0 means "not read yet or
        // never set" and the view falls back to the same landscape default the Entity
        // surface uses -- absence is the default in both places, stored in neither.
        // [G-04] anBlock/anAt are a PROJECTION of _ceLastAnBlock, refreshed by
        // cePublishScene. Held on the store rather than read from the module var in the
        // renderer so the panel repaints on the same subscription as everything else.
        // [SEC:CLOCK] STORE-BEFORE-HOOK: the four clock fields are in the INITIAL shape,
        // not only after the first publish, or the strip's first render reads undefined off
        // a store the surface is already subscribed to.
        ceSceneStore = createStore({ ready: false, locationId: '', locationName: '', locationDesc: '',
                                     locationImgW: 0, locationImgH: 0, present: [], away: [],
                                     anBlock: '', anAt: 0,
                                     clockT: 0, clockStamp: '', clockBand: '', clockDate: '' });
    } catch (e) {
        api.v1.error('[AE:jsxkit] store init failed:', e);
    }
}

// -- The idempotency latch ---------------------------------------------------
// opId is PER TARGET, not per verb - 'save:char:'+id, never 'save' - or an
// action on one record blocks the same action on a different one.
// Lives in the store rather than a module var because the button that fired
// must render disabled while in flight, and that is the same fact. Two copies
// of one fact drift.
// SHALLOW MERGE, not reconstruction. Every earlier setter rebuilt the
// whole uiStore object by listing its keys, which meant adding one key (`sheet`)
// silently dropped it on the next action. A merge cannot have that bug.
function ceUiPatch(fn: (u: any) => any): void {
    if (!ceUiStore) return;
    try {
        ceUiStore.set(function(u: any) {
            var next: any = {}; var k: string;
            for (k in u) { next[k] = u[k]; }
            var partial = fn(u) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxkit] ui patch failed:', e); }
}

async function ceAction(opId: string, fn: () => Promise<void>): Promise<void> {
    // [PANEL-SUBSTRATE] LOUD, because this exact early return cost a version. It is the
    // busy latch's store, so without it there is nowhere to record in-flight -- but the
    // consequence is that fn NEVER RUNS, which from the surface looks like a control that
    // does nothing at all rather than a missing store. Returning stays correct; returning
    // in silence did not. Anything mounting a kit surface must call ceStoresInit first.
    if (!ceUiStore) {
        api.v1.error('[AE:jsxkit] ' + opId + ' dropped: ceUiStore is not initialised. '
            + 'Call ceStoresInit() before mounting a surface outside ceOpenShell.');
        return;
    }
    try {
        var cur = ceUiStore.get();
        if (cur && cur.busy && cur.busy[opId]) return;       // second fire: drop
        ceUiPatch(function(u: any) {
            var b: any = {}; for (var k in u.busy) { b[k] = u.busy[k]; }
            b[opId] = true;
            return { busy: b };
        });
    } catch (e) { api.v1.error('[AE:jsxkit] latch acquire failed:', e); return; }

    try { await fn(); }
    catch (e) { api.v1.error('[AE:jsxkit] action ' + opId + ' failed:', e); }
    finally {
        try {
            ceUiPatch(function(u: any) {
                var b: any = {}; for (var k in u.busy) { if (k !== opId) { b[k] = u.busy[k]; } }
                return { busy: b };
            });
        } catch (e2) { api.v1.error('[AE:jsxkit] latch release failed:', e2); }
    }
}

// -- The generation rail: the ticker and its store ----------------------------
// [STYLE2] CE-STYLE v2.0 SS10 states the requirement bluntly: "it must always be
// obvious when the engine is spending a generation. These are metered calls -- the user is
// paying for them -- and a silent one is the worst failure mode on the surface."
//
// SS10.1 asks for three scopes. TWO OF THEM ALREADY EXIST: control scope is ceBtn's busy
// state (rebuilt this patch to keep the label rather than saying "Working..."), and
// surface scope is each surface's own placeholder. THIS IS THE THIRD, SHELL SCOPE, and
// [GEN-RAIL-OUT] THE SHELL-SCOPE GENERATION RAIL WAS HERE AND IS DELETED.
// ceGenStore, _ceGenTick, ceGenBegin, ceGenEnd and ceBusy all went together.
//
// Its own header argued it was the indicator that mattered most because a generation
// outlives the surface that started it. That was true, and the rail still failed at it:
// living above the ROUTER is not living above the SHELL, so it died on shell close, and
// being inside the Preact tree meant HOST-ORPHAN (earlier) could leave it painting on an
// abandoned render root -- a bar stuck under the menu tab with no generation behind it,
// which is what the user reported during Auto-Snap.
//
// The bridge generation pill (bridge earlier, SECTION 7b) is fixed-position, outside the
// shell, survives both navigation AND close, and can be dismissed if its count ever leaks.
// It is a strict superset, so keeping both would be two copies of one fact.
//
// SS10.2's RULE SURVIVES ITS EXAMPLE: if anything here ever needs indeterminate motion
// again, it owns its own store and no surface subscribes to it -- that is the difference
// between an indicator and a performance bug, and it was not what was wrong with this one.

// -- The physical-tap guard --------------------------------------------------
// [TAP-GUARD] ceAction is an IN-FLIGHT latch, not a duplicate-tap
// guard, and earlier shipped conflating the two. It acquires busy[opId], then
// awaits fn(). For a storage write or a generation the second fire lands while
// fn is still running and is correctly dropped. For an instant handler -- a
// synchronous store patch returning Promise.resolve() -- the latch is released
// on the very next microtask, long before the duplicate arrives, so the
// duplicate runs in full. ceAction's protection was never idempotency; it was
// the duration of the work, and instant work has none.
//
// That is the whole earlier surface bug. Every accordion head toggled open and
// then shut again on one tap (ceToggleOpen is its own inverse). Worse, the
// drill Back button left the character entirely: between the two fires Preact
// re-rendered and, because both headers render a ceBtn into the same slot of
// ceHeader, PATCHED THE onClick PROP ON THE REUSED <button> NODE. Fire one ran
// 'clear the drill'; fire two ran 'go to Scene' off the same physical element.
// Handlers that happened to be idempotent (a drill set to a fixed value) came
// through unharmed, which is exactly why the launcher grid looked fine and hid
// how general the fault was.
//
// Two properties of that failure fix the shape of the guard:
//   - IT CANNOT BE KEYED ON opId. The back button's opId differs between the
//     two fires ('nav:profileback' then 'nav:scene'), so a per-op guard misses
//     the worst case. One physical tap is one action, whatever that action
//     turns out to be. The guard is global.
//   - IT BELONGS AT THE EVENT BOUNDARY AND NOWHERE ELSE. Never nest it. An
//     outer ceTap that accepts stamps the clock, so an inner ceTap sees dt~0
//     and drops the real work. Guard where the event enters (ceBtn, ceListRow,
//     a raw onClick), never inside the state function it calls.
//
// CE_TAP_MS IS PROVISIONAL AND DELIBERATELY INSTRUMENTED. Probe earlier recorded
// THAT onClick fires twice, never how far apart -- the only measured number in
// this family is the sibling onInput probe's ~10ms machine-speed gap. 120ms is
// ~10x that and still under a deliberate double-tap (~150ms+), so the +/-
// pressure steppers stay usable. `/log tapguard on` -- WITH THE VERB; the channel
// is off by default and a bare `/log tapguard` only prints the usage line -- then
// reproduce, read the real gap off the accept/drop lines, and tighten this to
// evidence. Do not leave it inferred forever.
var CE_TAP_MS = 120;
var _ceTapAt = 0;
var _ceTapLastOp = '';

// [earlier TAP-FLIP, per user report + a second author's independent finding: "JSX tends to
// send duplicate click events on touch devices"] A SECOND, LONGER, PER-OP GUARD -- OPT-IN,
// LAYERED ON TOP OF THE GLOBAL ONE, NEVER A REPLACEMENT FOR IT.
//
// The global guard's own header explains why it cannot be keyed on opId: the back button's
// two fires carry DIFFERENT opIds, so a per-op guard misses that case entirely. That
// argument is correct and unchanged. But it is an argument for why per-op cannot be the
// ONLY guard, not for why it cannot exist alongside one.
//
// What 120ms misses: a touch device that synthesises a click from a touch sequence can
// deliver the pair far further apart than the ~10ms machine-speed gap the sibling onInput
// probe measured. Raising CE_TAP_MS itself is not the fix -- the pressure steppers depend
// on being able to fire faster than a deliberate double-tap, and a global 400ms window
// would make holding +/- unusable.
//
// So the longer window is opt-in and applies ONLY to controls where a second fire inside
// it is never something a person meant: a scope toggle, a tab switch, a nav. USE ceTap FOR
// ANYTHING REPEATABLE -- steppers, counters, "add another" -- or you will drop taps the
// author intended. Everything _ceFlipGuard guards must also be safe under the global
// guard, which still runs first and still stamps the shared clock.
// [REACH] ceTapOnce, the wrapper this text used to name, is DELETED -- zero call
// sites. _ceFlipGuard, the predicate underneath it, is what the reasoning is actually
// about and is kept for the next flip-shaped control.
//
// WHY A FLIP NEEDS THIS AND IDEMPOTENCE IS NOT ENOUGH: the gallery scope toggle already
// captures its target at render time (CEGAL-IDEMP) so a fast duplicate is harmless. That
// only covers the fast case. A duplicate that lands AFTER Preact has re-rendered gets a
// FRESH closure holding the already-flipped value, computes the opposite target, and
// flips it back -- which is the reported "switches back almost immediately". No amount of
// care inside the handler can fix that, because the second handler is a legitimately
// correct handler for a state that legitimately changed. It has to not run.
var CE_TAP_FLIP_MS = 450;
var _ceTapFlipAt: { [k: string]: number } = {};

// THE CHECK, SPLIT OUT FROM THE WRAPPER, because the two are needed in different places.
// A raw onClick can take the wrapper (ceTapOnce). A ceBtn handler CANNOT -- ceBtn already
// routes through ceTap, so wrapping its callback would NEST ceTap inside ceTap, which the
// global guard's own header names as the one thing never to do (the outer accept stamps
// the clock, the inner sees dt~0 and drops the real work). Such a handler calls this
// predicate directly instead: a separate clock the global guard never touches, so there is
// no nesting and nothing to get wrong.
//
// Returns true to PROCEED. Stamps on every call that is not itself a drop, including calls
// the global guard will go on to reject -- a rejected fire is still a physical event for
// this op, and the next one inside the window is still the duplicate.
function _ceFlipGuard(opId: string): boolean {
    var now = Date.now();
    var prev = Number(_ceTapFlipAt[opId] || 0);
    if (prev && (now - prev) >= 0 && (now - prev) < CE_TAP_FLIP_MS) {
        aeLog('[AE:tapguard] FLIP-DROP ' + opId + ' ' + (now - prev) + 'ms after itself');
        return false;
    }
    _ceTapFlipAt[opId] = now;
    return true;
}

// For a RAW onClick only. Anything already inside a ceBtn/ceIconBtn/ceListRow callback
// must use _ceFlipGuard instead -- see above.

function ceTap(opId: string, fn: () => void): void {
    var now = Date.now();
    var dt = now - _ceTapAt;
    if (_ceTapAt && dt >= 0 && dt < CE_TAP_MS) {
        aeLog('[AE:tapguard] DROP ' + opId + ' ' + dt + 'ms after ' + _ceTapLastOp);
        return;
    }
    aeLog('[AE:tapguard] pass ' + opId + ' +' + (_ceTapAt ? dt : 0) + 'ms');
    _ceTapAt = now;
    _ceTapLastOp = opId;
    try { fn(); }
    catch (e) { api.v1.error('[AE:jsxkit] tap ' + opId + ' failed:', e); }
}

// [TAB-SCOPED] ceUiStore.tab IS SHELL-GLOBAL -- one slot shared by
// every surface -- so a raw tab id is ambiguous the moment a SECOND surface wants tabs.
// Left as-is, leaving Settings on 'system' and then opening Images would hand Images a
// tab id it does not own; Settings degrades safely today only because it falls back on an
// unrecognised value, which is luck, not design.
// THE FIX IS THE CHEAP ONE, taken while there is still exactly one consumer: the stored
// value is NAMESPACED as '<surface>:<tabId>', and a surface only ever sees its own.
// Chosen over moving `tab` per-surface-store because it is two helpers rather than a new
// field on every future surface store, and it keeps ceNav's existing optional `tab`
// argument meaningful (a nav can still deep-link straight to a tab).
// A stored value with no prefix, or one belonging to another surface, reads as the
// fallback -- so no migration is needed and a stale value can never cross surfaces.
function ceTabGet(surface: string, fallback: string): string {
    var raw = '';
    try { var u: any = ceUiStore ? ceUiStore.get() : null; raw = String((u && u.tab) || ''); } catch (e) { raw = ''; }
    if (!raw) return fallback;
    var cut = raw.indexOf(':');
    if (cut < 0) return fallback;
    if (raw.slice(0, cut) !== String(surface)) return fallback;
    var id = raw.slice(cut + 1);
    return id || fallback;
}
function ceTabSet(surface: string, id: string): void {
    if (!ceUiStore) return;
    try { ceUiPatch(function() { return { tab: String(surface) + ':' + String(id || '') }; }); }
    catch (e) { api.v1.error('[AE:jsxkit] tab set failed:', e); }
}

// [G-02] THE REVEAL, AND IT IS DELIBERATELY NOT STORED. Unhiding a row is a decision about
// THIS LOOK AT THIS SCREEN, not about the character: if the author sets a value the row stays
// visible on its own merit (it is off `start`), and if they do not, there is nothing worth
// remembering. Storing it would put a per-character UI array in the record, which is the
// field-reveal list's own settled argument for living in session state.
//   CLEARED BY ceNav, exactly as `picker` and `slotOpts` are, and for the same reason:
//   nothing is written until a value is committed, so leaving loses nothing.
function _ceStateReveal(defId: string): void {
    if (!ceUiStore) return;
    try {
        ceUiPatch(function(u: any) {
            var m: any = {}; var k: string;
            for (k in (u.stShow || {})) { m[k] = u.stShow[k]; }
            m[String(defId)] = true;
            return { stShow: m };
        });
    } catch (e) { api.v1.error('[AE:jsxkit] state reveal failed:', e); }
}
function _ceStateRevealed(defId: string): boolean {
    try {
        var u: any = ceUiStore ? ceUiStore.get() : null;
        return !!(u && u.stShow && u.stShow[String(defId)]);
    } catch (e) { return false; }
}

// [G-02] THE SHARED "not in play" FOOTER. Both surfaces that draw state rows render it, so
// the wording and the reveal verb cannot drift between them -- the same argument
// ceStateRowsForFaction's header makes for sharing the row shape.
function _ceStateBlankFooter(blank: any[], keyPfx: string): any {
    if (!blank.length) return null;
    var kids: any[] = [
        ceSub('t3', 'Hidden while they sit at their starting value. Adding one shows its row '
            + 'for this visit; set it and it stays on its own.')
    ];
    var btns: any[] = [];
    for (var i = 0; i < blank.length; i++) {
        btns.push((function(r: any) {
            return ceBtn('+ ' + String(r.name), keyPfx + ':add:' + String(r.defId), function() {
                _ceStateReveal(String(r.defId));
                return Promise.resolve();
            });
        })(blank[i]));
    }
    kids.push(ceInline({ gap: CE_T.s2 }, btns));
    return ceGroup('Not in play (' + blank.length + ')', ceStack(CE_T.s2, kids));
}

function ceNav(surface: string, entityId?: string, tab?: string, back?: any): void {
    // Routing is a VALUE, not a call stack. Any card action navigates by setting
    // this, which is what replaces DOM-host focus hacks.
    // [NAV-BACK] `back` is OPTIONAL and clearing: a nav that does not pass one
    // is a nav to a top-level place, and it must wipe the previous return address rather
    // than inherit it, or Back eventually points at a screen nobody came from.
    if (!ceUiStore) return;
    try {
        ceUiPatch(function() {
            // [PICKER] A nav CLOSES an open picker, same clearing reason `sheet`
            // has: the picker commits on the tap that chooses, so there is no staged state
            // to lose and leaving is identical to Cancel. A picker left set across a nav
            // would re-open over the destination surface.
            // slotOpts clears for the same reason and with the same guarantee: nothing is
            // written until a candidate is tapped, so leaving loses only generated
            // candidates, never authored text.
            // [G-02] stShow CLEARS TOO. A row revealed on one character must not arrive
            // already revealed on the next -- the map is keyed by defId, which is shared.
            return { surface: surface, entityId: entityId || '', tab: tab || '',
                     sheet: null, picker: null, photo: null, slotOpts: null, stShow: {},
                     back: back || null };
        });
    } catch (e) { api.v1.error('[AE:jsxkit] nav failed:', e); }
}

// -- The shell nav ------------------------------------------------------------
// ONE ROUTE = ONE NAV ITEM + ONE TRAY BUTTON + ONE ceRoot BRANCH. That is the whole cost of
// a new surface, and the whole point of this array.
//
// ORDER HERE DRIVES BOTH the in-shell tab row (ceShellNav, every route) and the native
// toolbar tray (registerEngineUI, filtered on `tray`). Reordering here reorders both.
// `tray: false` keeps a route on the nav row but off the native tray; omit the key
// otherwise rather than writing `tray: true` everywhere.
//
// `icon` is consumed by registerEngineUI ONLY. The nav row is deliberately iconless
// (CE-STYLE 10.2: "six abstract nouns do not have six unambiguous glyphs"), but a native
// toolbarButton takes an iconId and looks broken without one. Every value is checked
// against the IconId union in script-types_d.txt -- do not invent an icon name.
//
// UNRESOLVED, FLAGGED NOT SILENTLY DECIDED: CE-STYLE 4 makes 44px "a hard floor for
// anything tappable", while 10.2 decides the launcher is a compact text-link row (~19px at
// fsSm). Both cannot hold. This follows 10.2 -- closer precedent, more recent, and a 44px
// nav plus a 44px header spends a quarter of a phone's vertical budget on chrome before any
// content. THE AUTHOR SHOULD SETTLE WHICH RULE GOVERNS, and it must govern the launcher and
// this row together: they are now visibly the same component rendered twice.
var CE_SHELL_ROUTES: any[] = [
    // [TAB-WORLD] "World", not "Map". The surface stopped being only a map when the
    // calendar moved onto it (T-07/F-2), and a tab named for one of its two halves is
    // a tab an author does not think to open for the other. THE ID STAYS 'map' -- it is
    // the surface key that ceNav, ceTabRow and every stored breadcrumb use, and renaming
    // an id to match a label is how a rename becomes a migration.
    { id: 'map',      label: 'World',    icon: 'map' },
    { id: 'scene',    label: 'Scene',    icon: 'users' },
    // [TAB-STORY] "Story", not "Journal", and the SAME reasoning TAB-WORLD wrote out
    // one entry up: the surface stopped being only the journal when threads joined it, and
    // a tab named for one of its two halves is a tab an author does not think to open for
    // the other. THE ID STAYS 'journal' -- ceNav, ceTabRow and every stored breadcrumb use
    // it as the surface key, and renaming an id to match a label is how a rename becomes a
    // migration.
    { id: 'journal',  label: 'Story',    icon: 'book' },
    // [F-26] SECTION 36b. Replaces the Settings > Factions tab, which is deleted -- who
    // exists in this world and where everyone stands is a map of the story's politics, not
    // a preference, and it does not belong in the same drawer as the token budget.
    { id: 'diplomacy', label: 'Diplomacy', icon: 'flag' },
    { id: 'chat',     label: 'Chat',     icon: 'message-circle' },
    { id: 'images',   label: 'Images',   icon: 'image' },
    // [JSXWIZARD] SECTION 37. Placed before Settings because that is the surface
    // list's own order. `tray: false` is surface_list line 43 verbatim -- nav row only.
    { id: 'wizard',   label: 'Wizard',   icon: 'star', tray: false },
    // [SETTINGS-JSX] Fifth route. Off the tray, on the nav row -- see
    // the note above this array. Last in the list per the surface list's own ordering,
    // which puts Settings after Wizard; Wizard is not a CE_SHELL_ROUTES entry (still
    // native, see registerEngineUI), so this is simply last among the jsx routes.
    // [GLYPH-SWAP] `glyph` is read ONLY by ceShellNav and ONLY to decide whether
    // this cell paints an icon instead of its word. `label` stays and is still the
    // aria-label/title, so the route is never nameless to a screen reader or a long-press.
    // `icon` is the NATIVE tray's IconId and is a different registry -- do not merge them.
    { id: 'settings', label: 'Settings', icon: 'settings', tray: false, glyph: 'settings' }
];

function ceShellNav(active: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_SHELL_ROUTES.length; i++) {
        kids.push((function(rt: any) {
            var on = (rt.id === active);
            var glyph = (String(rt.glyph || '') === 'settings');
            return h('div', {
                key: 'shellnav_' + rt.id,
                role: 'button', tabIndex: 0,
                'aria-label': rt.label,
                'aria-current': on ? 'page' : undefined,
                // The word cells carry their own label, so a title there is redundant
                // chrome; the glyph cell has no visible word and needs one.
                title: glyph ? rt.label : undefined,

                onClick: function() {
                    // ceTap at the event boundary, per TAP-GUARD -- never nested inside.
                    ceTap('shellnav:' + rt.id, function() {
                        // Re-navigating to the surface you are already on would wipe
                        // entityId/back for no reason; a no-op is the honest response.
                        if (!on) { ceNav(rt.id); }
                    });
                },
                style: {
                    // [earlier NAV-ONELINE, per user "the main header menu tabs has started
                    // to wrap"] flexShrink 0 + nowrap on the label is what makes the row's
                    // overflow behaviour PREDICTABLE: without it the flex items squash and
                    // hyphenate before the container ever scrolls, which is the ugly middle
                    // state between one line and two.
                    cursor: 'pointer', fontSize: CE_T.fsSm, letterSpacing: '0.01em',
                    display: 'flex', alignItems: 'center',
                    flex: '0 0 auto', whiteSpace: 'nowrap',
                    padding: CE_T.s1 + ' 0',
                    // Opacity ladder (CE-STYLE v2.0 SS4): full for the active
                    // destination, t3 for the rest -- SS4 names "inactive tabs" as the
                    // literal example of t3. 0.42 was v1.2's `faint`, which SS4 measured
                    // at 3.9:1 and failed outright.
                    opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, glyph ? ceIconSettings() : rt.label);
        })(CE_SHELL_ROUTES[i]));
    }
    // [NAV-ONELINE] THE ROW WRAPPED BECAUSE IT GREW, not because it was
    // badly built: it was five routes at earlier and is seven now (Wizard landed in
    // earlier), and seven words at gap s4 measure past a portrait phone. Three changes,
    // each doing a measurable share and none of them shrinking the type -- "compact while
    // legible" rules out the one lever that would have been easiest:
    //   gap s4 -> s3            six gaps, 24px back
    //   letterSpacing .04 -> .01em   ~20px back across 39 characters
    //   Settings word -> gear   ~38px back, and see ceIconSettings for why the gear is the
    //                           one label allowed to become a glyph here
    // TOGETHER THOSE FIT SEVEN ROUTES ON ONE LINE at a nominal 360px surface. nowrap +
    // overflowX is the SAFETY NET, not the fix -- an eighth route, a wider word, or a large
    // system font scrolls rather than silently going back to two rows, and a row that
    // scrolls is a state the author can SEE and act on. A wrapped row is not.
    // [F-27] THE ROW SCROLLS, THE SHELL DOES NOT. overflowX:auto was already here and was
    // not enough: in a shrink-to-fit column the row's INTRINSIC width still sets the
    // container's, so an eighth route (Diplomacy) widened the whole surface and put a
    // horizontal bar under every screen instead of under this row. minWidth:0 is what lets a
    // flex child be narrower than its content; width/maxWidth 100% stops it claiming more
    // than the shell has. Reported live -- this is the failure the note above predicted and
    // the safety net it named was one property short of catching.
    return h('div', {
        style: {
            display: 'flex', flexWrap: 'nowrap', gap: CE_T.s3,
            alignItems: 'center', overflowX: 'auto',
            padding: CE_T.s2 + ' ' + CE_T.s3,
            borderBottom: '1px solid ' + CE_LINE,
            flex: '0 0 auto',
            width: '100%', maxWidth: '100%', minWidth: '0'
        }
    }, kids);
}

// buildSceneStatePayload IS NOW ENGINE-ONLY. It was shared with the bridge broadcast until
// earlier deleted that broadcast for having no receiver, so this is its only consumer.
async function cePublishScene(): Promise<void> {
    if (!ceSceneStore) return;
    try {
        var p: any = await buildSceneStatePayload();
        // [SEC:CLOCK] READ ONCE, BEFORE THE BRANCH. The clock is a fact about the story and
        // not about the camera, so it is carried through the no-payload path too -- a world
        // with nowhere to be still has a time, and dropping it there would blank the strip
        // exactly when the surface is already at its least informative.
        var clkT = 0; var clkStamp = ''; var clkBand = ''; var clkDate = '';
        // [SCENE-STAGE-TUNE] Resolved from the SAME config read the clock already makes, and
        // carried through both branches below for the reason the clock is: a world with
        // nowhere to be still has a stage setting, and publishing the store without one
        // would make the surface fall back to defaults for exactly one repaint.
        var stageSet: any = ceStageSettings(null);
        try {
            var clkCfg: any = await loadConfig();
            stageSet = ceStageSettings(clkCfg);
            var clkCal = ceCalendar(clkCfg);
            clkT = await ceClockLoad();
            clkStamp = ceClockStamp(clkCal, clkT);
            clkBand = ceClockBand(clkCal, clkT);
            clkDate = ceClockDatePhrase(clkCal, clkT);
        } catch (eClk) { api.v1.error('[AE:jsxkit] scene clock read:', eClk); }
        if (!p) {
            ceSceneStore.set(function(s: any) {
                return { ready: true, locationId: '', locationName: '', locationDesc: '',
                         locationImgW: 0, locationImgH: 0,
                         clockT: clkT, clockStamp: clkStamp, clockBand: clkBand, clockDate: clkDate,
                         present: s.present, away: s.away || [], stage: stageSet,
                         // [G-04] Carried through the no-payload branch too. The Author's
                         // Note does not stop existing because the camera has nowhere to be.
                         anBlock: String(_ceLastAnBlock.text || ''),
                         anAt: Number(_ceLastAnBlock.at || 0) };
            });
            return;
        }
        // THE AWAY LIST AND THE CARD FIELDS ARE BUILT HERE, not in buildSceneStatePayload.
        // The original reason was that SceneCharacterInfo was a cross-artifact contract;
        // that dissolved in earlier when the broadcast went. The split now stands on a
        // smaller but still real footing: the builder answers "what is the scene", this
        // answers "what does this surface draw", and merging them would put display fields
        // on a payload three other things read. MERGING IS NOW LEGAL if it ever pays --
        // nothing outside this file would notice.
        var chars: any[] = [];
        try { chars = await loadAllCharacters(); } catch (eA) { chars = []; }
        var byId: any = {};
        for (var ci = 0; ci < (chars || []).length; ci++) {
            if (chars[ci] && chars[ci].id) { byId[String(chars[ci].id)] = chars[ci]; }
        }
        // Present: the payload's own list (it carries the attention read), enriched.
        var pres: any[] = [];
        var rawPres: any[] = p.presentCharacters || [];
        for (var pi = 0; pi < rawPres.length; pi++) {
            var rp: any = rawPres[pi];
            var src0: any = byId[String(rp.id)] || {};
            pres.push({
                id: rp.id, name: rp.name, entityId: rp.entityId || '',
                briefDescription: rp.briefDescription || '',
                isProtagonist: !!rp.isProtagonist,
                attention: rp.attention || { level: 'calm', reason: '' },
                role: String(src0.occupationRole || ''),
                pattern: String(src0.pattern || ''),
                // [SCENE-STAGE-TUNE] Projection-only, same standing as role and pattern
                // above: the stage sorts on it, and widening SceneStatePayload to carry it
                // would put a jsx surface's need onto a payload three other things read.
                rank: Number(src0.dynamicPriorityRank) || 0
            });
        }
        // Away: every ACTIVE character who is not present. Archived characters stay out --
        // "show all" means all of the cast, not all of the history.
        var away: any[] = [];
        for (var ai = 0; ai < (chars || []).length; ai++) {
            var ac: any = chars[ai];
            if (!ac || !ac.id) continue;
            if (ac.active === false) continue;
            if (ac.scenePresent) continue;
            away.push({
                id: String(ac.id), name: String(ac.name || 'Unnamed'),
                entityId: String(ac.entityId || ''),
                briefDescription: String(ac.briefDescription || ''),
                isProtagonist: !!ac.isProtagonist,
                attention: { level: 'calm', reason: '' },
                role: String(ac.occupationRole || ''),
                pattern: String(ac.pattern || '')
            });
        }
        // [PHASE-G-PRIME] THE LOCATION'S IMAGE SHAPE, READ HERE AND NOWHERE ELSE.
        // Projection-only for exactly the reason role/pattern above are: EntityMeta does not
        // carry imgWidth/imgHeight, and widening SceneStatePayload to reach them would put a
        // jsx surface's display need into the payload the bridge also consumes.
        // WHY THE SHAPE AT ALL RATHER THAN A FIXED LANDSCAPE BOX: the frame is drawn here and
        // the image is painted over it by the bridge with object-fit:cover, so a frame that
        // disagrees with the stored shape does not letterbox -- it CROPS, silently, and the
        // user's only clue is that the picture they generated is missing its edges.
        // THE ROOT SENTINEL IS SKIPPED, NOT LOADED. AE_ROOT_LOCATION_ID deliberately has no
        // entity behind it (buildSceneStatePayload synthesises a stand-in), so loadEntity
        // would be a guaranteed miss on every publish in a location-less world.
        var locImgW = 0; var locImgH = 0;
        try {
            if (p.locationId && p.locationId !== AE_ROOT_LOCATION_ID) {
                var locEntRec: any = await loadEntity(String(p.locationId));
                if (locEntRec) {
                    locImgW = Number(locEntRec.imgWidth) || 0;
                    locImgH = Number(locEntRec.imgHeight) || 0;
                }
            }
        } catch (eLI) { locImgW = 0; locImgH = 0; }
        ceSceneStore.set({
            ready: true,
            locationId: p.locationId || '',
            locationImgW: locImgW,
            locationImgH: locImgH,
            locationName: p.locationName || '',
            locationDesc: p.locationDescription || '',
            present: pres,
            away: away,
            stage: stageSet,
            clockT: clkT,
            clockStamp: clkStamp,
            clockBand: clkBand,
            clockDate: clkDate,
            anBlock: String(_ceLastAnBlock.text || ''),
            anAt: Number(_ceLastAnBlock.at || 0)
        });
    } catch (e) {
        // Failure leaves the PREVIOUS value in place. Laziness fails toward
        // stability - a stale view beats a blank one.
        api.v1.error('[AE:jsxkit] scene publish failed:', e);
    }
}

// -- Kit primitives ----------------------------------------------------------

// [GHOST-HEADER-PROBE] DIAGNOSTIC ONLY -- remove once the ghost-header bug is
// closed. Reported symptom: Profile -> Images drill -> drill's own back button leaves the
// drill's '\u2190 Profile' header rendered UNDER the real header, unclickable, and it
// COMPOUNDS -- re-entering Images stacks a second ghost. Nothing in ceUiPatch /
// _ceProfileDrill touches ceUiStore.back, and that '\u2190 Profile' string exists at
// exactly one call site (ceProfileRoot's dBack), so what is on screen is a STALE RENDER of
// the drill header, not a second live one. A null-vs-element diff at a fixed tree position
// is something Preact removes cleanly, and a ghost that ACCUMULATES is not reconciliation
// behaviour at all -- it is the signature of render() being called into a NEW host element
// while the previous host is still in the DOM (the old tree is then orphaned from Preact's
// diff but still painted).
//
// This probe answers exactly that, and nothing else: how many times onMount fires per part
// id, whether it is handed the SAME element each time, whether that element already had
// children before we rendered into it, and whether the PREVIOUS element is still connected.
// Off by default (aeLog channel); turn on with `/log jsxmount on`, reproduce, read the log.
//
// READING IT: one mount per id per shell open is correct. A second mount for 'ce-shell-jsx'
// with same=false and prevConnected=true is the bug, and the count will track the number of
// ghosts on screen.
var _ceMountCount: { [id: string]: number } = {};
var _ceMountElem: { [id: string]: any } = {};

// [HOST-ORPHAN] NAI CALLS onMount AGAIN PER DRILL TRANSITION, WITH A NEW HOST ELEMENT, and
// leaves the previous host in the document still painting the tree we last rendered into
// it. `/ce ghost` measured six mounts for one shell open, each host's own tree correct and
// single. Nothing is wrong with what we render; Preact cannot help, because each host is a
// separate render root and unmounting one is not something another's diff will ever do.
// This is also why the ghost was unclickable, why it compounded one per cycle, and why
// window mode did not change it.
//
// THE FIX IS TO OWN THE TEARDOWN, because nobody else can. Every host this id has been
// handed is kept here; on each remount every earlier one gets `render(null, host)` -- the
// documented unmount call -- and is then hidden, so an emptied host cannot hold layout
// either. The registry then collapses to the live host: O(1) per mount, not a leak.
//
// DO NOT TRUST isConnected HERE. It read false for hosts that were demonstrably still
// painting, so the teardown is unconditional rather than filtered on it.
var _ceMountHosts: { [id: string]: any[] } = {};

function _ceReleaseStaleHosts(id: string, elem: any): number {
    var freed = 0;
    var hosts: any[] = _ceMountHosts[id] || [];
    for (var i = 0; i < hosts.length; i++) {
        var host: any = hosts[i];
        if (!host || host === elem) continue;
        try { render(null, host); freed++; } catch (_eRel) { /* a dead host must not break the live mount */ }
        try { host.style.display = 'none'; } catch (_eHide) {}
    }
    _ceMountHosts[id] = [elem];
    return freed;
}

function ceJsxPart(id: string, Root: any, minPx?: number): UIPart {
    // Scroll containment boilerplate, verified working. Without the minHeight
    // pair the shadow host grows to content instead of scrolling, and the
    // element assignments must happen BEFORE render(), not after.
    return {
        type: 'jsx',
        id: id,
        // [SHELL-WINDOW] minPx is the WINDOW-MODE FLOOR and is undefined in modal
        // mode, where the style below is byte-identical to every version before it. See the
        // CE_SHELL_WINDOW block for why a resizable container may not give height:100%
        // anything to resolve against.
        // [H-04] gridTemplateColumns IS THE INLINE-AXIS TWIN OF THE ROW TRACK ABOVE, and its
        // absence is what let the nav widen the whole app. An implicit `auto` column takes its
        // MINIMUM from the item's min-content, so one wide child (the nav row, a states grid)
        // grew the track past the container and every ancestor scrolled sideways to follow it.
        // minmax(0,1fr) is the same fix `minmax(0,1fr)` already performs vertically.
        style: { display: 'grid', gridTemplateRows: 'minmax(0,1fr)',
                 gridTemplateColumns: 'minmax(0,1fr)', height: '100%',
                 minHeight: minPx ? (String(minPx) + 'px') : '0' },
        onMount: function(elem: any) {
            try {
                // [GHOST-HEADER-PROBE] see the block above this function.
                try {
                    _ceMountCount[id] = (_ceMountCount[id] || 0) + 1;
                    var _gpPrev: any = _ceMountElem[id] || null;
                    var _gpSame = (_gpPrev === elem);
                    var _gpPrevConn = 'n/a';
                    if (_gpPrev && !_gpSame) {
                        try { _gpPrevConn = String(!!_gpPrev.isConnected); } catch (_e1) { _gpPrevConn = '?'; }
                    }
                    var _gpKids = '?';
                    try { _gpKids = String((elem.childNodes && elem.childNodes.length) || 0); } catch (_e2) {}
                    aeLog('[AE:jsxmount] id=' + id
                        + ' mount#' + _ceMountCount[id]
                        + ' sameElem=' + (_gpPrev ? String(_gpSame) : 'first')
                        + ' kidsBeforeRender=' + _gpKids
                        + ' prevStillConnected=' + _gpPrevConn);
                    _ceMountElem[id] = elem;
                } catch (_eGp) { /* a probe must never break the mount */ }
                // [HOST-ORPHAN] BEFORE the style writes and BEFORE render(), for
                // the same ordering reason the original boilerplate note gives: nothing
                // touches the live host until every dead one is off the board.
                try {
                    var _hoFreed = _ceReleaseStaleHosts(id, elem);
                    if (_hoFreed > 0) {
                        aeLog('[AE:jsxmount] id=' + id + ' released ' + _hoFreed + ' orphaned host(s)');
                    }
                } catch (_eHo) { api.v1.error('[AE:jsxkit] host release failed:', _eHo); }
                elem.style.height = '100%';
                elem.style.minHeight = minPx ? (String(minPx) + 'px') : '0';
                render(h(Root, null), elem);
            } catch (e) { api.v1.error('[AE:jsxkit] mount failed:', e); }
        }
    } as UIPart;
}

// [SCREEN-KEYED] THE GHOST IS HERE, AND THE PAGE-SIDE DUMP FINALLY SHOWED IT.
// window.aeBridge.ghost() (bridge earlier) on a Profile drill printed THIS under the body:
//
//     DIV h=562                       <- this function's root
//       DIV h=49  "\u2190 Profile"     <- header
//       DIV h=17  "\u2190 Profile"     <- header
//       DIV h=49  "\u2190 Profile"     <- header
//       DIV h=465 "+Johnny Test..."   <- the scroller
//
// FOUR CHILDREN, and five on the Images drill. This function emits EXACTLY TWO. So the
// stacked headers are real children of this element, they are in the engine's own tree as
// well as the page's, and the earlier /ce ghost runs were reporting them all along -- the
// "kids=3 / kids=4 / kids=5" line at [0.0.1.0] that got read as varying body content was
// the header stack. The engine-side walk was never blind; it was misread.
//
// SO: the diff INSERTS a new header and does not remove the old one, and it can only do
// that if this child list is UNKEYED -- which it was, and which is the one property every
// previous attempt left alone. earlier made the header a component and still ghosted
// because a component in an unkeyed list is matched BY POSITION exactly like an element is.
// The key is the missing half, not the component.
//
// BOTH CHILDREN ARE NOW KEYED and the header slot is always occupied (ceHeader returns a
// component that renders null rather than a bare null -- an earlier change, reinstated here
// because keys need a stable vnode to sit on). Preact matches keyed children by key across
// the whole list instead of by index, so slot 0 can never be filled twice.
//
// IF THIS STILL GHOSTS, stop: it means removals are being dropped in NAI's marshalling and
// no arrangement of our vdom will help. The fallback is structural and already agreed --
// delete the submenu header entirely and carry the back affordance some other way.
function ceScreen(header: any, children: any): any {
    // [HEADER-INFLOW] gridTemplateRows drops from 'auto minmax(0,1fr)' to one
    // track, because there is no longer a second thing to place. The header is prepended to
    // the scroller's own child list -- and only when it exists, so an absent header changes
    // the list LENGTH rather than leaving a hole in it, which is the arrangement the body
    // list has always used without ghosting.
    var kids: any[] = (children === null || children === undefined) ? []
        : (Array.isArray(children) ? children.slice() : [children]);
    if (header) kids.unshift(header);
    // [H-04] THE INLINE AXIS IS CONSTRAINED THE SAME WAY THE BLOCK AXIS ALREADY WAS. Every
    // surface renders inside this, so a single wide child anywhere below could set the grid's
    // implicit column min-content and push the shell past the viewport. The scroller carries
    // overflowX:'hidden' as the second half: a surface that genuinely overflows sideways clips
    // HERE, where it is visible and local, instead of scrolling the whole app.
    return h('div', { style: { display: 'grid', gridTemplateRows: 'minmax(0,1fr)',
                               gridTemplateColumns: 'minmax(0,1fr)', height: '100%',
                               minHeight: '0', minWidth: '0' } },
        h('div', { style: { overflowY: 'auto', overflowX: 'hidden', minHeight: '0', minWidth: '0',
                            padding: CE_T.s3, display: 'flex', flexDirection: 'column', gap: CE_T.s3 } }, kids)
    );
}

// THE HEADER IS NOT A ROW. It renders as the FIRST ORDINARY ITEM of the scroller's child
// list, not into a grid track of its own. That is structural, not cosmetic -- see
// GHOST-HEADER below for what it cost to learn.
//
// It returns null when there is nothing to put in it, which removes the row rather than
// emptying it. There is no surface title: SHELL-NAV already names the current surface
// directly above, and a drill's own body is self-evident from its fields.
//
// COST, accepted knowingly: the back button scrolls with the content. If that matters, the
// fix is `position:sticky; top:0` plus a solid background -- NOT a return to a grid track.
//
// [GHOST-HEADER] FIVE FALSIFIED FIXES, RECORDED SO NONE IS RETRIED: bare null, a component
// rendering null, a keyed component, host teardown, container swap. Every one left the same
// thing standing -- a dedicated grid slot whose occupant toggled between something and
// nothing across drill transitions. Deleting the slot is what fixed it. The scroller's
// children have been swapped wholesale since the JSX pivot and have never ghosted; the
// working list is where the affordance belongs.
function ceHeader(actions: any): any {
    if (!actions) return null;
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s2, paddingBottom: CE_T.s2, borderBottom: '1px solid ' + CE_LINE } },
        actions
    );
}

// [STYLE2-D] REBUILT to SS7.1's actual spec: "ceD2 head + a hairline rule running
// to the right edge. No box." Previously routed through ceH3 -- the Field-density eyebrow
// -- which meant every Read-density surface (Journal entries, Scene's location text,
// Profile's own concept notes) carried the exact same tiny uppercase micro-label as a
// Settings toggle row, with nothing distinguishing the two densities visually at all.
// Flat vocabulary preserved: still no border, no background, no box-in-box -- the rule
// trails the heading rather than wrapping the section.
// [THEME-FX] THE RULE HAS ITS OWN NAME. It is the only full-width painted band on a Read
// surface and it repeats at every section head, which makes it the cheapest place in the kit
// to put an effect: a gradient, a double line, a dotted rail all fit in one `background`
// value with no node added and no call site touched. Defaulting to CE_LINE keeps today's
// hairline. This is the ONE head+rule shape in the file -- verified, 42 call sites, no
// second hand-rolled copy -- so a theme setting it moves every section head at once.
function ceSection(label: string, children: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3 } },
            ceD2(label),
            h('div', { style: { flex: '1 1 auto', height: '1px',
                background: 'var(--ce-head-rule, ' + CE_LINE + ')' } })
        ),
        children
    );
}

// ceGroup -- the Field-density counterpart to ceSection (CE-STYLE v2.0 SS7.2, SS8): a
// ceKey group head with a full-width rule under it, then rows -- as opposed to
// ceSection's bare label with no rule. Same "flat vocabulary, no box" spirit; the rule
// under the head is what stands in for ceSection's row underline at this density.
function ceGroup(label: string, children: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s2 } },
        h('div', { style: { paddingBottom: CE_T.s1, borderBottom: '1px solid ' + CE_LINE } }, ceKey(label)),
        children
    );
}

// -- Interaction state, and why these are components now ----------------------
// [STYLE2] SS9 requires every control to carry press and focus states, and SS9's
// own framing is the important part: "This belongs in the primitive, never at a call site
// -- that is the difference between a system and 200 hand-wired buttons." There is no
// `style` element in this environment, so there is no `:active` and no `:focus-visible`;
// every state is JS state driving an inline style, and JS state means a hook.
//
// THAT IS THE WHOLE REASON FOR THE WRAPPER SHAPE BELOW, and it is worth stating plainly
// because it looks like indirection for its own sake. `useState` inside a bare
// `ceBtn(...)` helper would join the hook list of whatever Root happened to call it, and
// surfaces render buttons CONDITIONALLY and IN LOOPS -- exactly the two things ceField's
// own header warns are fatal to hook order. So the state lives in a real component
// (_ceBtnC) with its own hook scope, where the order is trivially stable, and `ceBtn`
// stays a plain function that returns `h(_ceBtnC, props)`.
//
// THE PAYOFF IS THAT ALL 113 ceBtn CALL SITES ARE UNCHANGED. Not one surface knows this
// happened. The same shape applies to ceToggle (9 call sites) below.
//
// TAP-GUARD IS UNAFFECTED. Its autopsy is about Preact reusing one <button> node across
// two different logical buttons in ceHeader's action slot and patching onClick between the
// two fires of one physical tap. Component form does not change that -- the same node is
// still reused at the same tree position -- and ceTap is still the global boundary guard
// that catches it. Nothing here is a substitute for ceTap.
function _ceBtnC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    var variant = p.variant;
    var col = variant === 'danger' ? CE_SEM.ask : 'inherit';
    var restBg = variant === 'primary' ? CE_FILL : 'transparent';
    return h('button', {
        onClick: function() { ceTap('btn:' + p.opId, function() { ceAction(p.opId, p.fn); }); },
        // SS9.1's point stands -- "without them a press that slides off the control stays
        // visually stuck down forever" -- but its ROSTER IS WRONG, and this is a correction
        // to CE-STYLE v2.0 verified against jsx-typings_d.txt this patch, not a shortcut.
        // SS2 lists "onPointerDown/Up/Cancel" as available. THERE IS NO onPointerCancel in
        // ScriptDOMAttributes: the pointer family is Down/Up/Move/Over/Out/Enter/Leave and
        // stops there. onTouchCancel DOES exist and covers the case that actually matters
        // on a phone -- a press interrupted by a system gesture, an incoming call, a scroll
        // taking over the touch -- so the release set is Up + Leave + TouchCancel, which
        // closes every path a press can end on without inventing an API.
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        disabled: busy,
        // SS10.1 control scope + SS11: a busy control announces itself rather than only
        // looking faded.
        'aria-busy': busy ? 'true' : undefined,
        style: {
            // [BTN-SHRINK] flexShrink and whiteSpace are NOT cosmetic here. Every
            // ceBtn that lives in a flex ROW next to a growing label -- ceSettingRow's
            // control slot, ceHeader's action slot, the empty-state action -- is a flex item
            // with default flex-shrink:1, so the row's text takes the space and the button
            // wraps its own label mid-word. Settings' shape button was the visible case;
            // it was never a Settings bug. Fixed in the kit so no call site has to know.
            //
            // [STYLE2] HEIGHT IS NOW ctl (32px), NOT tap (44px). This is SS8's
            // headline correction -- "v1.2 set minHeight: 44px on the button itself, which
            // is why a row of buttons dominates every screen" -- and the 44px hit area it
            // gives up is restored by the wrapper below, not lost.
            minHeight: CE_T.ctl, padding: CE_T.s1 + ' ' + CE_T.s3,
            flexShrink: '0', whiteSpace: 'nowrap',
            fontSize: CE_T.fs, color: col,
            // SS9.1 press: ground to CE_FILL2 + scale(0.97). The ground steps ABOVE whatever
            // rest is, which is why CE_FILL2 had to exist -- a 'primary' button already
            // rests on CE_FILL and would otherwise have no press state at all.
            background: pressed ? CE_FILL2 : restBg,
            transform: pressed ? 'scale(var(--ce-press-scale, 0.97))' : 'none',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
            // SS9.1 focus: a real ring, never a colour swap.
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            // SS4: busy sits on the ladder at t3 like any other label-about-content, and
            // carries aria-busy above rather than relying on the dimming to communicate.
            opacity: busy ? CE_OP.t3 : CE_OP.t1, cursor: 'pointer',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    },
        // [STYLE2] SS10.1: "Never a generic 'Working...' -- the label must still
        // say WHICH thing is running." The old code replaced every busy label with the
        // literal string 'Working...', which is the exact failure SS10.1 names.
        // THE DEFAULT IS `label + ellipsis`, NOT A DERIVED PROGRESSIVE FORM, and that is a
        // deliberate narrowing of SS10.1's own example. Mechanically converting a verb to
        // its -ing form works for the single-word case the doc cites (Enhance -> Enhancing)
        // and produces garbage for most of the 113 real labels in this file ("Reset to
        // default", "Run A/B probe (yoink vs direct)", "Copy log"). An ellipsis satisfies
        // the actual REQUIREMENT -- the label still names the thing -- and cannot produce
        // broken English. A call site with a clean single verb may pass `busyLabel` to get
        // the nicer progressive form; the generation buttons are where that is worth it.
        busy ? (p.busyLabel ? p.busyLabel : (p.label + '\u2026')) : p.label);
}

// The wrapper that restores the 44px hit area SS8/SS11 require around a 32px control.
// SS8 specifies "padding: 6px; margin: -6px" on all four sides. THIS IS VERTICAL-ONLY,
// deliberately, and the deviation is a correctness fix rather than a preference: buttons
// in this kit sit in flex ROWS at gap s2 (8px), so a 6px horizontal expansion on each of
// two neighbours overlaps their hit boxes by 4px and a tap in the seam lands on whichever
// happens to paint on top. Vertically there is no such neighbour -- rows are stacked at
// s3 (12px) or more, so 6px each side closes exactly to touching and never overlaps.
// The horizontal shortfall is also the one that does not exist in practice: s3 padding
// plus a word already carries every button in the file well past 44px wide.
function _ceHit(child: any): any {
    return h('div', { style: { display: 'inline-flex', flexShrink: '0', padding: '6px 0', margin: '-6px 0' } }, child);
}

// UNCHANGED SIGNATURE. All 113 existing call sites keep working verbatim; the only new
// thing is the optional 5th argument for SS10.1's progressive busy label.
function ceBtn(label: string, opId: string, fn: any, variant?: string, busyLabel?: string): any {
    return _ceHit(h(_ceBtnC, { label: label, opId: opId, fn: fn, variant: variant, busyLabel: busyLabel }));
}

// ceIconBtn -- an action with no room for a word (CE-STYLE v2.0 SS6.4, SS8). 17px glyph,
// 32px visual control, 44px hit area.
// `ariaLabel` IS THE FIRST POSITIONAL ARGUMENT ON PURPOSE. SS12 check 6 greps every
// ceIconBtn call site for a missing aria label, and says outright that the primitive
// "should make the label a required positional argument so this check can only fail by
// deliberate edit". An options bag with an optional `ariaLabel` key would let an
// unlabelled icon button be written by accident; this shape cannot.
// (Note for future edits: the audit's grep pattern is deliberately NOT quoted verbatim
// here -- it carries an unbalanced parenthesis, and this file is verified by a brace and
// paren balance-delta pass in which a comment counts exactly as much as code.)
function _ceIconBtnC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    return h('button', {
        onClick: function() { ceTap('ibtn:' + p.opId, function() { ceAction(p.opId, p.fn); }); },
        // See _ceBtnC for why there is no onPointerCancel here.
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        disabled: busy,
        'aria-label': p.ariaLabel,
        'aria-busy': busy ? 'true' : undefined,
        title: p.ariaLabel,
        style: {
            width: CE_T.ctl, height: CE_T.ctl, flexShrink: '0',
            display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            padding: '0', color: p.variant === 'danger' ? CE_SEM.ask : 'inherit',
            background: pressed ? CE_FILL2 : 'transparent',
            transform: pressed ? 'scale(var(--ce-press-scale, 0.97))' : 'none',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            opacity: busy ? CE_OP.t3 : CE_OP.t1, cursor: 'pointer',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, p.icon);
}
function ceIconBtn(ariaLabel: string, icon: any, opId: string, fn: any, variant?: string): any {
    return _ceHit(h(_ceIconBtnC, { ariaLabel: ariaLabel, icon: icon, opId: opId, fn: fn, variant: variant }));
}

// ceIcon -- the one stroke weight for the whole set (SS6.4): stroke currentColor, no fill,
// 1.7 weight, round caps and joins, 17px in a 32px control. Every icon in the kit is built
// through this so a mixed-weight set is not possible by accident.
// `paths` is an array of SVG child elements (h('path', { d: ... }) and friends) -- the
// primitive owns the frame and the stroke contract, the caller owns the shape only.
function ceIcon(paths: any): any {
    return h('svg', {
        width: '17', height: '17', viewBox: '0 0 24 24',
        fill: 'none', stroke: 'currentColor', 'stroke-width': '1.7',
        'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true'
    }, paths);
}

// [STYLE2-F] THE FIRST THREE ICONS. ceIcon has been a zero-call-site forward
// dependency since earlier; these are its first real consumers (the portrait slot card's
// row verbs). SS6.4 is the reason they exist at all: "a row/section-level verb (edit,
// delete, add, download) -- Icon only", which is what frees a portrait card from carrying
// four full-width word buttons under a 96px image. They are declared HERE, beside ceIcon,
// rather than at the call site, so a second surface needing "delete" cannot draw a second
// trash can at a different stroke weight -- the mixed-weight set SS6.4 warns about is only
// possible if the shapes live at call sites.
function ceIconEdit(): any {
    return ceIcon([
        h('path', { key: 'e1', d: 'M12 20h9' }),
        h('path', { key: 'e2', d: 'M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z' })
    ]);
}
function ceIconDownload(): any {
    return ceIcon([
        h('path', { key: 'd1', d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4' }),
        h('path', { key: 'd2', d: 'M7 10l5 5 5-5' }),
        h('path', { key: 'd3', d: 'M12 15V3' })
    ]);
}
// [IMG-UPLOAD] Download's mirror: same tray, arrow reversed. Deliberately NOT a
// plus or a paperclip -- an author reading the row should be able to tell at a glance that
// these two are the same verb in opposite directions, and only a mirrored glyph says that.
function ceIconUpload(): any {
    return ceIcon([
        h('path', { key: 'u1', d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4' }),
        h('path', { key: 'u2', d: 'M7 8l5-5 5 5' }),
        h('path', { key: 'u3', d: 'M12 3v12' })
    ]);
}
// [PHASE-G] The scene roster's two verbs. Same stroke contract as the other
// three; declared here for the same reason they were.
function ceIconUserPlus(): any {
    return ceIcon([
        h('path', { key: 'up1', d: 'M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' }),
        h('circle', { key: 'up2', cx: '8.5', cy: '7', r: '4' }),
        h('path', { key: 'up3', d: 'M19 8v6' }),
        h('path', { key: 'up4', d: 'M22 11h-6' })
    ]);
}
function ceIconUserMinus(): any {
    return ceIcon([
        h('path', { key: 'um1', d: 'M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' }),
        h('circle', { key: 'um2', cx: '8.5', cy: '7', r: '4' }),
        h('path', { key: 'um3', d: 'M22 11h-6' })
    ]);
}
// [PICKER] The picker's selected-row lead. Same stroke contract, declared here
// for the same reason the other five are.
function ceIconCheck(): any {
    return ceIcon([
        h('path', { key: 'ck1', d: 'M20 6L9 17l-5-5' })
    ]);
}
// [GLYPH-SWAP]
// ONE RULE DECIDES WHICH DELETE BUTTONS BECOME THIS ICON, and it is the file's own existing
// DESTRUCTIVE-NEVER-IN-PLACE split, not a new one:
//   ASK / row-level verb  -> ceIconBtn + ceIconTrash. It is a verb in a row of verbs, it is
//                            not destructive on its own, and SS6.4 names exactly this case:
//                            "a row/section-level verb (edit, delete, add, download) --
//                            Icon only". The entity avatar's delete already shipped this
//                            way in earlier; this generalises that precedent.
//   CONFIRM               -> STAYS THE WORD "Delete". A confirm strip exists to be read: it
//                            carries a sentence saying what is about to be lost, a Keep, and
//                            the irreversible one. Reducing the irreversible one to an
//                            unlabelled 17px glyph beside a full-width Keep inverts the
//                            weight of the choice, which is the opposite of what a confirm
//                            is for. Do not "finish the job" by swapping these later.
// [STYLE2] Stepper and list-order glyphs. These four are why ceIndexedStates and the
// States drill were reaching for bare ceBtn('\u2191') text buttons: SS6.4 says a row-level
// verb is icon-only with a mandatory aria-label, and the icon set had no arrows, no plus
// and no minus to build one from. Adding them here is the SS1 fix; retyping a glyph at
// four call sites was the drift.
function ceIconPlus(): any {
    return ceIcon([ h('path', { d: 'M12 5v14' }), h('path', { d: 'M5 12h14' }) ]);
}
function ceIconMinus(): any {
    return ceIcon([ h('path', { d: 'M5 12h14' }) ]);
}
function ceIconUp(): any {
    return ceIcon([ h('path', { d: 'M12 19V5' }), h('path', { d: 'M5 12l7-7 7 7' }) ]);
}
function ceIconDown(): any {
    return ceIcon([ h('path', { d: 'M12 5v14' }), h('path', { d: 'M19 12l-7 7-7-7' }) ]);
}
// [F-2] Month nav. A BARE CHEVRON, not an arrow: the arrows above MOVE a thing in a list,
// these PAGE a view, and the two reading the same would be the one ambiguity in the set.
function ceIconLeft(): any {
    return ceIcon([ h('path', { d: 'M15 19l-7-7 7-7' }) ]);
}
function ceIconRight(): any {
    return ceIcon([ h('path', { d: 'M9 5l7 7-7 7' }) ]);
}

function ceIconTrash(): any {
    return ceIcon([
        h('path', { key: 't1', d: 'M3 6h18' }),
        h('path', { key: 't2', d: 'M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2' }),
        h('path', { key: 't3', d: 'M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6' })
    ]);
}
// [GLYPH-SWAP] The gear. It is declared here with the rest of the set,
// for the reason stated above ceIconEdit: a second surface wanting "settings" must not
// draw its own at a different stroke weight.
// WHY A GEAR IS ALLOWED ON THE NAV ROW AND THE OTHER SIX LABELS ARE NOT. CE-STYLE 10.2's
// argument is "six abstract nouns do not have six unambiguous glyphs" -- that is an
// argument about AMBIGUITY, not an argument against icons, and the gear is the single
// exception the whole convention rests on: it is the one control in this kit whose glyph
// is more universally read than its word. Map/Scene/Chat/Journal/Images/Wizard stay words
// because none of them clears that bar. Do not read this as permission to icon the rest.
function ceIconSettings(): any {
    return ceIcon([
        h('circle', { key: 'g1', cx: '12', cy: '12', r: '3' }),
        h('path', { key: 'g2', d: 'M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z' })
    ]);
}

// [NAV-BACK] The back control, so that no surface hand-writes its own return
// address. Reads ceUiStore.back -- set by whoever navigated here -- and falls back to the
// label passed in when there is none (arrived at top level). It is a ceBtn, so it inherits
// the physical-tap guard, and that matters more here than anywhere else on the surface:
// TAP-GUARD's autopsy is specifically about two DIFFERENT back buttons sharing one reused
// <button> node in ceHeader's action slot.
// [NOHEADER] RETURNS null WHEN THERE IS NO RETURN ADDRESS, and the fallback label
// is gone with it. A surface reached from the nav has no "back" — the nav IS how you got
// there and it is still on screen — so the old '\u2190 Scene' fallback was a second door
// beside an identical first one. What survives is the case NAV-BACK was actually built
// for: Journal reached FROM a Profile launcher, where Profile is not on the nav and the
// return address is the only way back to it.
function ceBack(): any {
    var b: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; b = (u && u.back) || null; } catch (e) {}
    if (!b || !b.surface) return null;
    // [F-29] `tab` IS FORWARDED. A return address may now name a tab (the faction's
    // Resources tab hands one to Settings), and ceNav has always taken one -- Back was the
    // only consumer of an address that dropped it. Additive: an address without `tab` sends
    // '', which is the value ceNav already writes for a tab-less nav.
    return ceBtn('\u2190 ' + String(b.label || 'Back'), 'nav:back', function() {
        ceNav(String(b.surface), String(b.entityId || ''), String(b.tab || ''));
        return Promise.resolve();
    });
}

// [TOGGLE] A boolean was rendered as a button reading "Toggle" or
// "Switch" -- the control named the verb instead of showing the state, so the row said
// "Context injection / On" and then offered a button whose label was the same for both
// directions. This is a switch: the state IS the control. ceBtn stays for actions that
// are not booleans.
// [STYLE2] Component form, same wrapper reasoning as _ceBtnC above -- all 9 call
// sites are unchanged.
// SS9.1 gives ceToggle a feedback contract the other controls do not have: OPTIMISTIC.
// A boolean is the one control where the user already knows what the result will be, so
// waiting for a storage round-trip before moving the knob makes the control feel broken
// even when it is working. `optimistic` holds the pending value and is what the knob
// renders from while the write is in flight; it clears the moment the real prop catches
// up, so a FAILED write snaps the knob back rather than lying about the stored state.
// Note it is keyed off `p.on` changing, not off the busy latch clearing -- ceAction
// releases the latch when the write RESOLVES, which for a rejected write is also when it
// failed, and reading the latch would leave the knob showing the value that did not save.
function _ceToggleC(p: any): any {
    var optState = useState(null); var optimistic = optState[0]; var setOptimistic = optState[1];
    var focusState = useState(false); var focused = focusState[0]; var setFocused = focusState[1];
    var busy = false;
    try { var u = ceUiStore ? ceUiStore.get() : null; busy = !!(u && u.busy && u.busy[p.opId]); } catch (e) {}
    // The real value has landed (or reverted) -- drop the optimistic overlay.
    useEffect(function() { setOptimistic(null); }, [p.on]);
    var on = (optimistic === null) ? !!p.on : !!optimistic;
    return h('div', {
        onClick: function() {
            // CAPTURED AT RENDER TIME, per CEGAL-IDEMP: an instant handler that inverts
            // state must not read the live value at fire time.
            var next = !p.on;
            ceTap('tgl:' + p.opId, function() { setOptimistic(next); ceAction(p.opId, p.fn); });
        },
        onFocus: function() { setFocused(true); },
        onBlur: function() { setFocused(false); },
        // SS11: "State is never colour alone." aria-pressed makes the boolean readable to
        // anything that is not looking at the knob's position.
        role: 'switch', tabIndex: 0,
        'aria-pressed': on ? 'true' : 'false',
        'aria-label': p.ariaLabel,
        'aria-busy': busy ? 'true' : undefined,
        style: {
            // [THEME-VAR2] THE SWITCH IS THE CONTROL NOVELAI DOES NOT HAVE, so it is the
            // one a theme can invent a treatment for rather than match one. Track, edge and
            // knob are separately named per state: an ON track that is only a fill cannot
            // read as lit, and a theme that wants it to needs all three.
            flex: '0 0 auto', width: '40px', height: '24px',
            borderRadius: 'var(--ce-toggle-radius, ' + CE_T.rPill + ')',
            border: '1px solid ' + (on ? 'var(--ce-toggle-line-on, ' + CE_LINE2 + ')'
                                       : 'var(--ce-toggle-line-off, ' + CE_LINE + ')'),
            background: on ? 'var(--ce-toggle-track-on, ' + CE_FILL + ')'
                           : 'var(--ce-toggle-track-off, transparent)',
            display: 'flex', alignItems: 'center',
            justifyContent: on ? 'flex-end' : 'flex-start',
            // SS12 check 4's own allowlist names this exact value: "the toggle track's
            // '0 3px'". It is the knob's inset, not a spacing decision.
            padding: '0 3px', cursor: 'pointer',
            boxShadow: focused ? '0 0 0 2px ' + CE_RING : 'none',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    },
        h('div', { style: {
            width: '16px', height: '16px', borderRadius: '50%',
            // SS4: the knob is NON-TEXT, so its on/off weight is a color-mix, not an
            // opacity rung -- that is the whole reason the two vocabularies are kept
            // apart. Previously this was opacity 0.9/0.35, two values on no ladder at all.
            background: on ? 'var(--ce-toggle-knob-on, currentColor)'
                           : 'var(--ce-toggle-knob-off, ' + CE_LINE2 + ')',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        } })
    );
}
function ceToggle(on: boolean, opId: string, fn: any, ariaLabel?: string): any {
    return h(_ceToggleC, { on: on, opId: opId, fn: fn, ariaLabel: ariaLabel });
}

// A labelled settings line: heading, optional explanation, control on the right.
// One shape for every row on every settings surface, so spacing cannot drift per row.
// ceStepperRow -- a NUMBER YOU CAN NUDGE, with a full-width sub-line under it.
// [SS8b] THE PRIMITIVE THAT FIXES THE COLUMN-COLLAPSE CLASS. ceRow is key | value | trail
// on one line, and its value slot carries `minWidth: 0` so it can shrink rather than force
// a horizontal scroll. That is correct for a trail of icon verbs (~44px each) and WRONG the
// moment the trail contains an input: minus + a 76px field + plus is ~180px, against a key
// that does not shrink, and on a 360px viewport the value column resolves to a handful of
// pixels. `minWidth: 0` then does exactly what it was asked to -- the text wraps at every
// character and renders as a vertical column of single letters.
//
// TWICE REPORTED, TWICE PATCHED AT THE CALL SITE, TWICE WRONG. The first fix moved the band
// label out of the value slot and left the range in it; the range collapsed instead. The
// class of bug is structural, so the fix is structural: NOTHING TEXT-BEARING SITS BETWEEN
// THE KEY AND THE CONTROLS. The middle is an empty spacer that absorbs all slack, and every
// word the row wants to say goes on its own full-width line beneath.
//
// `sub` IS THE ONLY PLACE THIS ROW PUTS PROSE. If a caller finds itself wanting a second
// text slot, it wants two rows.
function ceStepperRow(p: any): any {
    var zebra = (typeof p.zebraIndex === 'number') && (p.zebraIndex % 2 === 1);
    var line1 = h('div', { style: {
        display: 'flex', alignItems: 'center', gap: CE_T.s2,
        padding: CE_T.s2 + ' ' + CE_T.s3, lineHeight: CE_T.lhTight
    } },
        h('div', { style: { flex: '0 0 auto' } }, ceKey(p.label || '')),
        // THE SPACER. Absorbs every pixel the key and controls do not want, so neither of
        // them is ever asked to shrink and no text lives here to be crushed.
        h('div', { style: { flex: '1 1 auto', minWidth: CE_T.s2 } }, null),
        h('div', { style: { flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: CE_T.s1 } },
            p.onNudge ? ceIconBtn('Lower ' + (p.label || 'value'), ceIconMinus(), p.k + ':dn', function() {
                return p.onNudge(-1);
            }) : null,
            h('div', { style: { flex: '0 0 ' + (p.width || '76px') } }, [
                ceNumField({ k: p.k + ':v', label: '', value: p.value,
                             min: p.min, max: p.max, onCommit: p.onCommit })
            ]),
            p.onNudge ? ceIconBtn('Raise ' + (p.label || 'value'), ceIconPlus(), p.k + ':up', function() {
                return p.onNudge(1);
            }) : null
        )
    );
    return h('div', { key: p.k, style: { background: zebra ? CE_FILL : 'transparent' } },
        line1,
        p.sub ? h('div', { style: { padding: '0 ' + CE_T.s3 + ' ' + CE_T.s2 + ' ' + CE_T.s3 } }, p.sub) : null
    );
}

// ============================================================================
// GAUGES  [I-05] -- HOW A BOUNDED NUMBER LOOKS.
// Author: "the states tabs for profiles are an ugly mess". They were, and the cause is
// structural rather than cosmetic: ceStepperRow is a KEY + SPACER + CONTROLS line built for a
// number with no shape of its own, and a state has a shape -- it sits somewhere between two
// bounds. Drawing it as a bare figure in a 76px box throws that away and then spends two
// further lines of prose putting it back in words ("0-5", "resting, says nothing").
//
// THE GAUGE IS THE SENTENCE. One glance answers how full it is; the words underneath only have
// to say what the words on the band ARE, and only when they add something the bar cannot.
//
// TWO SHAPES, CHOSEN BY SPAN, AND THE SPLIT IS ABOUT WHAT THE NUMBER MEANS. Health 0-5 is
// FIVE THINGS -- each step is a band you can name and losing one is an event, so it draws as
// discrete pips you can count without reading. Currency 0-99 is a QUANTITY: no one cares that
// it is 63 rather than 62, only roughly where it sits, so it draws as a continuous bar and the
// exact figure stays legible as text. CE_GAUGE_PIP_MAX is where counting stops being possible
// at a glance; past it, pips are just a noisy bar.
// THIS IS NOT A THIRD STATE TYPE. D-19 is unchanged -- one primitive, a bounded integer. The
// gauge is a PROJECTION decision made at draw time from min and max, and nothing is stored.
//
// THE NUMBER FIELD SURVIVES ONLY WHERE TYPING IS FASTER THAN NUDGING, which is exactly the
// wide case: walking Currency from 12 to 63 with a plus button is not a control. On a track,
// minus and plus reach every value in the range in a few taps and the field is removed rather
// than kept "for consistency" -- that is SS8b's own finding about what a field in a row costs.
//
// LAYOUT IS THREE LINES AND SS8b's RULE STILL HOLDS: nothing text-bearing sits between the key
// and the controls. Line 1 is name / band / readout, line 2 is gauge + steppers (the gauge is
// the flexible middle and it carries no text, so it can shrink to nothing without wrapping a
// single character), line 3 is the one sub-line, present only when it has something to say.
// ============================================================================

// Past this span, pips stop being countable at a glance and become a noisy bar.
var CE_GAUGE_PIP_MAX = 12;
var CE_GAUGE_H = '8px';

// ceMeter -- the continuous bar, built at last to the spec written beside ceCard (SS8, Field
// density). `hue` is a CE_SEM / CE_PATTERN_DEFS value passed IN rather than looked up: this
// primitive does not know which axis it is drawing, only how to draw one. The track is CE_LINE
// and the fill is never dimmed by opacity (SS6.3 #4), so fill/track stays the vocabulary SS4
// keeps separate from the opacity ladder.
function ceMeter(frac: number, hue?: string): any {
    var f = Math.max(0, Math.min(1, Number(frac) || 0));
    return h('div', { style: {
        flex: '1 1 auto', minWidth: '24px', height: CE_GAUGE_H,
        borderRadius: CE_T.rPill, background: CE_LINE, overflow: 'hidden'
    } },
        h('div', { style: {
            width: (Math.round(f * 1000) / 10) + '%', height: '100%',
            borderRadius: CE_T.rPill, background: hue || CE_GAUGE,
            transition: 'width ' + CE_T.mBase + ' ' + CE_T.ease
        } }, [])
    );
}

// ceTrack -- the discrete counterpart. ONE PIP PER STEP, NOT PER BAND: a band is a range of
// steps and drawing bands would make Health 0-5 with three bands render as three pips, which
// is a different number from the one the author is holding. Pips are keyed because the count
// changes when an author edits the def's bounds.
// EACH PIP IS flex 1 1 0 SO THEY SHARE THE ROW EQUALLY at any width; minWidth keeps a 12-step
// track from vanishing on a narrow phone rather than letting it overflow.
function ceTrack(value: number, min: number, max: number, hue?: string): any {
    var lo = Math.round(Number(min) || 0);
    var hi = Math.round(Number(max) || 0);
    var v = Math.round(Number(value) || 0);
    var n = Math.max(1, hi - lo);
    var pips: any[] = [];
    for (var i = 0; i < n; i++) {
        var lit = (lo + i + 1) <= v;
        pips.push(h('div', { key: 'pip' + i, style: {
            flex: '1 1 0', minWidth: '2px', height: CE_GAUGE_H, borderRadius: '2px',
            background: lit ? (hue || CE_GAUGE) : CE_LINE,
            transition: 'background ' + CE_T.mFast + ' ' + CE_T.ease
        } }, []));
    }
    return h('div', { style: {
        flex: '1 1 auto', minWidth: '24px', display: 'flex', gap: '3px', alignItems: 'center'
    } }, pips);
}

// ── ceDayStrip  [SEC:SCHED] ──────────────────────────────────────────────────────
// A DAY, DRAWN. ceTrack's sibling and it belongs beside it: one segment per stop rather
// than one pip per step. A plan is a bounded thing with a shape (I-05's own argument about
// states, applied to a day), and a list of start times is the shape spelled out instead.
//
// PROPORTIONAL FLEX IS THE WHOLE IMPLEMENTATION. `flex: <minutes> 1 0` needs no width
// arithmetic and no media query -- the same trick ceGaugeGrid's `flex: 1 1 240px` uses as
// its breakpoint. Nothing here reads a pixel, so it is correct at every shell width.
//
// LABELS SELF-SUPPRESS ON A NARROW SEGMENT, they are not truncated to a stub. A two-hour
// stop on a phone has room for about four characters, and four characters of a place name
// is noise pretending to be information. Below the threshold the segment is a coloured
// block with a title -- its shape and position still say when, which is what the strip is
// for. The label is a bonus, and the readout below the strip is where the words live.
//
// EVERY SEGMENT IS KEYED, on its start hour. The array length moves whenever a stop is
// added or removed, and this is the H-01 family -- third time, so it is not a judgement
// call any more.
// [ATMO] WHAT A SEGMENT IS CALLED IS THE CALLER'S QUESTION. `nameOf` resolves a
// locationId, which is the only answer a character's day has; a location's own timetable
// has no place to resolve and labels each segment with its atmosphere text instead.
// `labelOf` takes the whole segment and defaults to the old behaviour, so every existing
// call site renders identically and neither owner needs a second strip.
function ceDayStrip(segs: any[], opts: any): any {
    var o: any = opts || {};
    var nameOf: any = o.nameOf || function(id: string) { return String(id || ''); };
    var labelOf: any = o.labelOf || function(sg: any) { return nameOf(sg.locationId); };
    var nowHour = (o.nowHour === undefined || o.nowHour === null) ? -1 : Number(o.nowHour);
    var h1 = o.compact ? '22px' : '30px';
    var kids: any[] = [];
    if (!segs || !segs.length) {
        kids.push(h('div', { key: 'ds_empty', style: {
            flex: '1 1 0', minWidth: '0', display: 'flex', alignItems: 'center',
            padding: '0 ' + CE_T.s2, fontSize: CE_T.fsSm, opacity: CE_OP.t3,
            whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis'
        } }, o.emptyLabel || 'Nothing set'));
    } else {
        for (var i = 0; i < segs.length; i++) {
            (function(sg: any, idx: number) {
                var span = Math.max(1, sg.to - sg.from);
                var live = (nowHour >= sg.from && nowHour < sg.to);
                var nm = labelOf(sg);
                // The threshold is in HOURS, not pixels, because hours is the only unit this
                // primitive has. Four of twenty-four is about a sixth of the strip, which is
                // where a short place name stops fitting on the narrowest shell.
                var wide = span >= 4;
                kids.push(h('div', {
                    key: 'ds_' + String(sg.from) + '_' + String(idx),
                    title: _cePad2(sg.from) + ':00 \u2013 ' + _cePad2(sg.to % CE_HOURS_DAY) + ':00 \u00b7 '
                           + (nm || o.emptyTitle || 'nowhere')
                           + ((sg.doing && sg.doing !== nm) ? (' \u00b7 ' + sg.doing) : '')
                           + (sg.wrapped ? ' (carried from the night before)' : ''),
                    style: {
                        flex: String(span * CE_MINS_HOUR) + ' 1 0',
                        minWidth: '0', display: 'flex', alignItems: 'center',
                        padding: '0 4px', overflow: 'hidden',
                        whiteSpace: 'nowrap', textOverflow: 'ellipsis',
                        fontSize: CE_T.fsMono,
                        borderRight: (idx === segs.length - 1) ? 'none' : ('1px solid ' + CE_LINE),
                        // SEMANTIC COLOUR TAKES NO OPACITY (CE-STYLE 2.2), so the un-lit
                        // segment dims by using a WEAKER FILL rather than by fading the lit
                        // one. Both are currentColor mixes; neither is a literal.
                        background: live ? (o.hue || CE_GAUGE) : CE_FILL,
                        transition: 'background ' + CE_T.mFast + ' ' + CE_T.ease
                    }
                }, wide ? (nm || '') : ''));
            })(segs[i], i);
        }
    }
    return h('div', { style: {
        display: 'flex', width: '100%', height: h1, minWidth: '0',
        borderRadius: CE_T.r, overflow: 'hidden',
        border: '1px solid ' + CE_LINE, background: CE_WELL
    } }, kids);
}

// THE NOW MARKER IS A RULE, NOT A LIT SEGMENT, and that choice is what makes a STACK of
// strips readable: one line drawn across six of them reads six positions against one
// instant, where a per-strip highlight would make you check six separate places for the
// same fact. It is absolutely positioned over a relative host the caller supplies.
// paddingTop ON THE HOST is what gives the flag its room -- stated here because a caller
// that forgets it gets a flag clipped by the strip above, not an error.
function ceDayNow(t: number, opts: any): any {
    var o: any = opts || {};
    var mins = _ceMinsSafe(t) % CE_MINS_DAY;
    return h('div', {
        key: 'ds_now',
        style: {
            position: 'absolute', top: '0', bottom: '0', zIndex: '3',
            left: 'calc(' + String(mins / CE_MINS_DAY * 100) + '% - 1px)',
            width: '2px', background: o.hue || CE_GAUGE, pointerEvents: 'none',
            transition: 'left ' + CE_T.mBase + ' ' + CE_T.ease
        }
    }, o.flag === false ? [] : [
        // THE FLAG IS NOT INVERTED, AND IT CANNOT BE. Inverting would need the theme's
        // background colour as a text colour, and the worker cannot read the active theme --
        // that is the same wall CE_T's motion note records. CE_WELL (the one legitimate
        // colour literal, per CE-STYLE) as the ground and currentColor as the text works in
        // every theme without a branch: translucent black darkens a dark theme and greys a
        // light one, and currentColor is legible on both by construction. The hue border is
        // what ties the flag to the rule below it.
        h('div', { key: 'ds_flag', style: {
            position: 'absolute', top: '0', left: '50%', transform: 'translateX(-50%)',
            fontFamily: CE_MONO_FONT, fontSize: '9.5px', lineHeight: '1.3',
            padding: '0 3px', borderRadius: '2px', whiteSpace: 'nowrap',
            background: CE_WELL, border: '1px solid ' + (o.hue || CE_GAUGE)
        } }, ceClockTimeOfDay(t))
    ]);
}

// The hour ruler that sits under a strip. Six marks, because twenty-four labels do not fit
// on a phone and four-hour steps are what a reader actually scans for.
function ceDayRuler(): any {
    var marks: any[] = [];
    for (var hMark = 0; hMark <= CE_HOURS_DAY; hMark += 4) {
        marks.push(h('div', { key: 'dr' + hMark, style: {
            flex: (hMark === CE_HOURS_DAY) ? '0 0 auto' : '1 1 0',
            fontFamily: CE_MONO_FONT, fontSize: '9.5px', opacity: CE_OP.t3
        } }, _cePad2(hMark % CE_HOURS_DAY)));
    }
    return h('div', { style: { display: 'flex', width: '100%', paddingTop: '3px' } }, marks);
}


// ── ceMonthGrid — the calendar family's second member  [F-2] ─────────────────────────
// ceDayStrip draws one day as segments; this draws one month as cells. Same argument: a
// bounded thing with a shape is drawn rather than spelled out.
//
// COLUMNS = cal.dayNames.length, NEVER 7. A ten-day week gets ten columns, and the grid is
// `repeat(N, 1fr)` so nothing reads a pixel and it is correct at every shell width. At ten
// columns on a 360px shell a cell is ~32px, which is CE_T.ctl -- the same visual size an
// icon control has, sitting inside a 44px row height that carries the hit area (SS8b).
//
// NO WEEK MEANS NO GRID, and the caller gets null rather than a fallback. With dayNames: []
// there are no columns to project onto; inventing a seven-day week for a world that has
// none would draw a calendar the story does not use. The Time tab renders its dated list
// instead, which is the honest answer.
//
// THREE CELL STATES, AND THEY COMPOSE: today (hue ring), selected (filled), has entries (a
// dot under the number). Today AND selected is the common case on open, so selected is a
// fill and today is a border -- two channels, so neither hides the other.
//
// EVERY CELL IS KEYED ON ITS ABSOLUTE DAY. The array length moves on every month change and
// on every month of a different length -- H-01's family, and the leading blanks move too.
function ceMonthGrid(cells: any[], cols: number, dayNames: string[], onPick: (day: number) => void): any {
    var n = Math.max(1, Math.round(Number(cols) || 0));
    var heads: any[] = [];
    var i = 0;
    for (i = 0; i < n; i++) {
        heads.push(h('div', {
            key: 'mgh' + String(i),
            style: {
                textAlign: 'center', fontSize: CE_T.fsKey, letterSpacing: '0.06em',
                textTransform: 'uppercase', opacity: CE_OP.t3, fontFamily: CE_UI_FONT,
                overflow: 'hidden', whiteSpace: 'nowrap'
            }
        // ONE LETTER, because ten columns on a phone cannot hold 'Wednesday' and a
        // four-character stub is noise pretending to be information (SS8d's rule).
        }, String(dayNames[i] || '').slice(0, 1)));
    }
    var kids: any[] = [];
    for (i = 0; i < cells.length; i++) {
        (function(c: any) {
            if (c.blank) {
                kids.push(h('div', { key: 'mgb' + String(c.key), style: { minHeight: CE_T.tap } }));
                return;
            }
            kids.push(h('div', {
                key: 'mg' + String(c.day),
                role: 'button', tabIndex: 0,
                'aria-label': String(c.label) + (c.marked ? ' (has entries)' : ''),
                title: String(c.title || ''),
                onClick: function() { ceTap('map:cal:' + String(c.day), function() { onPick(c.day); }); },
                style: {
                    display: 'flex', flexDirection: 'column', alignItems: 'center',
                    justifyContent: 'center', gap: CE_T.s1,
                    minHeight: CE_T.tap, cursor: 'pointer', borderRadius: CE_T.r,
                    fontSize: CE_T.fsSm, fontFamily: CE_MONO_FONT,
                    border: '1px solid ' + (c.today ? CE_GAUGE : 'transparent'),
                    background: c.selected ? CE_FILL2 : 'transparent',
                    opacity: c.selected || c.today || c.marked ? CE_OP.t1 : CE_OP.t2,
                    transition: 'background ' + CE_T.mFast + ' ' + CE_T.ease
                }
            }, [
                h('div', { key: 'n' }, String(c.label)),
                // A DOT, NOT A COUNT. The number of entries on a day is not readable at
                // 32px and the list below says it exactly; the cell only has to say
                // "something is here".
                h('div', {
                    key: 'd',
                    style: {
                        // Allowlisted glyph sizing (CE-STYLE SS12 check 1's convention):
                        // a 4px dot is a mark, not a box, and has no spacing token.
                        width: '4px', height: '4px', borderRadius: CE_T.rPill,
                        background: c.marked ? CE_GAUGE : 'transparent'
                    }
                })
            ]));
        })(cells[i]);
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        h('div', { key: 'mgheads', style: { display: 'grid', gridTemplateColumns: 'repeat(' + String(n) + ', 1fr)', gap: CE_T.s1 } }, heads),
        h('div', { key: 'mgcells', style: { display: 'grid', gridTemplateColumns: 'repeat(' + String(n) + ', 1fr)', gap: CE_T.s1 } }, kids)
    );
}

// THE ONE CHOOSER. Every consumer calls this, never ceTrack or ceMeter directly, so the
// threshold is one number in one place rather than a comparison copied to each surface.
function ceGauge(value: number, min: number, max: number, hue?: string): any {
    var lo = Math.round(Number(min) || 0);
    var hi = Math.round(Number(max) || 0);
    var span = hi - lo;
    // A def whose bounds have collapsed draws nothing rather than a full or empty bar -- both
    // of those would be a claim about a value that has no room to move.
    if (span <= 0) return null;
    if (span <= CE_GAUGE_PIP_MAX) return ceTrack(value, lo, hi, hue);
    var v = Math.max(lo, Math.min(hi, Math.round(Number(value) || 0)));
    return ceMeter((v - lo) / span, hue);
}

// ceGaugeRow -- the row. Replaces ceStepperRow at the two STATE surfaces; ceStepperRow itself
// stays for the item-bonus editor, which is an UNBOUNDED number and therefore has no gauge to
// draw (that is the honest test for which primitive a caller wants).
// THE READOUT IS "3 / 5" WHEN THE FLOOR IS ZERO AND "3  (-5...5)" OTHERWISE, which is what
// retires the dedicated range sub-line the old row carried on every single state.
// THE TILE FILL IS A GROUPING DEVICE, NOT A CARD. SS7.2 names CE_FILL on alternating rows as
// the one legitimate use of a fill at Field density; a wrapping grid has no stable notion of
// "alternating", so the same 6% goes on every tile instead. It is deliberately NOT ceCard --
// these are fields, not objects, and SS7.3 says a card inside a group means the content was
// fields all along.
function ceGaugeRow(p: any): any {
    var lo = Math.round(Number(p.min) || 0);
    var hi = Math.round(Number(p.max) || 0);
    var v = Math.round(Number(p.value) || 0);
    var wide = (hi - lo) > CE_GAUGE_PIP_MAX;
    var readout = (lo === 0)
        ? (String(v) + ' / ' + String(hi))
        : (String(v) + '  (' + String(lo) + '\u2026' + String(hi) + ')');
    var ctl: any[] = [];
    if (p.onNudge) {
        ctl.push(ceIconBtn('Lower ' + (p.label || 'value'), ceIconMinus(), p.k + ':dn', function() {
            return p.onNudge(-1);
        }));
    }
    // ONLY THE WIDE FORM KEEPS A FIELD -- see the block header for why.
    if (wide && p.onCommit) {
        ctl.push(h('div', { key: 'gnum', style: { flex: '0 0 62px' } }, [
            ceNumField({ k: p.k + ':v', label: '', value: v, min: lo, max: hi, onCommit: p.onCommit })
        ]));
    }
    if (p.onNudge) {
        ctl.push(ceIconBtn('Raise ' + (p.label || 'value'), ceIconPlus(), p.k + ':up', function() {
            return p.onNudge(1);
        }));
    }
    return h('div', { key: p.k, style: {
        flex: '1 1 ' + (p.basis || '240px'), minWidth: '0', maxWidth: '100%',
        display: 'flex', flexDirection: 'column', gap: CE_T.s1,
        padding: CE_T.s2 + ' ' + CE_T.s3, borderRadius: CE_T.r, background: CE_FILL
    } },
        // [SS8c] THE BADGE IS PROSE AND HAS ITS OWN LINE. It sat in a ceFixed beside a
        // ceGrow'd label, and a band label is not a word -- a standing band reads "is
        // Friendly toward The Crimson Hall", ~230px that will not shrink. Against a
        // 240px tile the label column was handed single-digit pixels and rendered as the
        // vertical one-letter column SS8b/SS8c are named for. Observed on Standing rows,
        // where BOTH the label and the band are long.
        // The header keeps only the label and the readout: the readout is short, mono and
        // fixed, so the label has the whole tile minus ~40px and wraps like prose.
        ceBar({ gap: CE_T.s2 }, [
            ceGrow(null, [ ceKey(p.label || '') ]),
            ceFixed(null, [ ceMono(readout, { opacity: CE_OP.t2 }) ])
        ]),
        p.badge ? h('div', { key: 'gbadge', style: { minWidth: '0' } }, p.badge) : null,
        ceBar({ gap: CE_T.s2 }, [
            ceGauge(v, lo, hi, p.hue),
            ctl.length
                ? h('div', { style: { flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: CE_T.s1 } }, ctl)
                : null
        ]),
        p.sub ? p.sub : null
    );
}

// ceGaugeGrid -- ONE COLUMN ON A PHONE, TWO OR MORE ON A DESKTOP SHELL, WITH NO MEDIA QUERY.
// There is no stylesheet in this environment, so a responsive column count has to fall out of
// flex arithmetic: `flex: 1 1 240px` per tile means two fit at 500px and only one at 360px,
// and the survivors grow to fill whatever is left. A story with eight states was eight
// full-width rows and a lot of scrolling on every screen; now it is eight on a phone and four
// on a window that has the room.
function ceGaugeGrid(kids: any[]): any {
    return h('div', { style: {
        display: 'flex', flexWrap: 'wrap', gap: CE_T.s2,
        minWidth: '0', paddingTop: CE_T.s2
    } }, kids);
}

// [I-05] THE STATE ROW, DRAWN ONCE FOR BOTH SURFACES. The profile drill and the faction
// resources panel had two copies of this logic, and the faction copy's own comment already
// admitted the risk ("two renderers for one row shape is how two surfaces come to disagree
// about what a resting band looks like") while being the second renderer it warned about.
// They share ceStateRowsForChar/ceStateRowsForFaction's ROW SHAPE, so they now share the
// drawing too and the two can only diverge by someone deleting this function.
// THE BADGE IS THE BAND AND THE SUB IS THE EXCEPTION. The old row said the band twice -- once
// as a label and once as a sentence about the label -- and then added the range and the scope
// underneath. Here the band is one word on line 1, and line 3 exists only when there is
// something the gauge and the badge together cannot say.
function _ceStateBadge(r: any): any {
    // A TERMINAL OUTRANKS THE BAND (F-11's rule, unchanged): a value at a bound is about to
    // rewrite the next roll's outcome, which matters more than which band it sits in.
    if (r.terminal) return ceChip('Terminal', true);
    if (r.banded && r.label) return ceSub(r.atRest ? 't3' : 't2', String(r.label));
    return null;
}

function _ceStateSubText(r: any): string {
    var bits: string[] = [];
    if (r.terminal) {
        bits.push('At a terminal \u2014 this replaces the next roll\u2019s outcome.');
    } else if (r.modifier && !r.banded) {
        // An unbanded modifier is silent BY DESIGN, not unfinished -- saying "the story never
        // sees it" without saying why would read as a warning about a working feature.
        bits.push((r.modParts && r.modParts.length)
            ? (r.modParts.join('  ') + '  =  ' + ((r.modTotal > 0 ? '+' : '') + r.modTotal) + ' on a roll')
            : 'Feeds rolls \u2014 mechanical, never shown to the story.');
    } else if (!r.banded) {
        bits.push('No bands \u2014 a number only; the story never sees it.');
    } else if (r.atRest) {
        bits.push('Resting \u2014 the story is told nothing.');
    } else if (!r.label) {
        bits.push('Off its resting band, but this band has no words.');
    } else if (!r.speaks) {
        bits.push('Not carried into the story at this value.');
    }
    // Kept because it is a fact the gauge cannot show: a protagonist-scoped def is not a fact
    // about this character so much as about whoever is holding the story.
    if (String(r.scope || '') === 'protagonist') bits.push('Protagonist only.');
    if (String(r.scope || '') === 'npc') bits.push('Everyone but the protagonist.');
    return bits.join('  \u00b7  ');
}

// `onSet` and `onNudge` both take (defId, n). The two surfaces build completely different
// StateRefs -- one from a character record, one from a faction bucket -- so the ADDRESS stays
// with the caller and only the drawing is shared. That is the same split ceStateRowsForChar
// and ceStateRowsForFaction already made and for the same reason.
function ceStateGaugeRow(r: any, keyPfx: string, onSet: any, onNudge: any): any {
    var sub = _ceStateSubText(r);
    return ceGaugeRow({
        k: keyPfx + ':' + String(r.defId),
        label: String(r.name || ''),
        value: r.value, min: r.min, max: r.max,
        // THREE HUES AND NO MORE. Terminal borrows CE_SEM.ask, which is the same red the
        // attention dot already uses for "this needs answering"; a banded value sitting on its
        // resting band drops to CE_LINE2 so a settled row reads as quiet without opacity
        // touching the fill (SS6.3 #4); everything else is CE_GAUGE.
        hue: r.terminal ? CE_SEM.ask : ((r.banded && r.atRest) ? CE_LINE2 : ''),
        badge: _ceStateBadge(r),
        sub: sub ? ceSub(r.terminal ? 't2' : 't3', sub) : null,
        onCommit: function(n: number) { return onSet(String(r.defId), n); },
        onNudge: function(d: number) { return onNudge(String(r.defId), d); }
    });
}

// [ROW-STACK] THE FOURTH INSTANCE OF THE INLINE-AXIS COLLAPSE (CE-STYLE SS8b, SS8c) and
// the first one inside a kit primitive rather than at a call site. Reported live as "the
// stakes instruction text is squeezed by the button in its row".
//   THE TRIGGER IS THE CONTROL, NOT THE HINT'S LENGTH. A <select>'s intrinsic width is set
//   by its WIDEST OPTION LABEL, and ceSelect carries flexShrink:'0' on purpose so the value
//   it displays is never truncated. 'Default \u2014 none for this approach' is 33
//   characters, so the control claimed most of a 360px shell and refused to give any of it
//   back; the label column beside it carries minWidth:'0' and absorbed the entire
//   shortfall, which is SS8b's one-letter column exactly.
//   A LENGTH THRESHOLD ON THE HINT WOULD HAVE BEEN THE WRONG SENSOR -- it stacks rows that
//   were never squeezed, and it un-stacks a squeezed row the moment a catalog grows a
//   longer NAME. The defect would come back through the data, with nothing in the code
//   having changed.
// DETECTED, NOT DECLARED. An opt would have to be remembered by forty existing call sites
// and by every future one; SS8b's own position on this class is that removing the
// possibility beats sizing around it. A preact vnode carries its own `type`, so the row can
// read whether it was handed something that holds text and cannot be squeezed.
// A ROW WITH NO HINT NEVER STACKS. There is no prose to crush, and a lone label degrades to
// a truncated word rather than to a column of letters.
function _ceRowStacks(control: any): boolean {
    if (!control || typeof control !== 'object') return false;
    var ty: any = control.type;
    // The element forms. ceSelect composed into a control slot returns the bare <select>.
    if (typeof ty === 'string') return (ty === 'select' || ty === 'input' || ty === 'textarea');
    // The component forms, by identity rather than by name -- a renamed component that
    // still holds text must not silently fall out of this test.
    return (ty === ceField || ty === ceNumField);
}

function ceSettingRow(label: string, hint: string, control: any): any {
    var stack = !!hint && _ceRowStacks(control);
    // ONE text block, built once and placed by the container's direction. Building a second
    // copy for the stacked case would fork the label/hint spacing, which is the drift
    // ceTapRow was deliberately built on this function to avoid.
    var text = h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '3px' } },
        h('div', { style: { fontSize: CE_T.fs } }, label),
        hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.5' } }, hint) : null
    );
    return h('div', { style: { display: 'flex',
        flexDirection: stack ? 'column' : 'row',
        // stretch, so a stacked <select> spans the row: maxWidth:'100%' already caps it and
        // a full-width control on its own line reads as belonging to the label above it.
        alignItems: stack ? 'stretch' : 'center',
        gap: stack ? CE_T.s2 : CE_T.s3,
        minHeight: CE_T.tap, padding: CE_T.s2 + ' 0', borderBottom: '1px solid ' + CE_LINE } },
        text,
        control || null
    );
}

// [F-27] ceTapRow -- a ceSettingRow whose WHOLE ROW is the verb. A list of destinations
// wants the row to be the button: a trailing "Open" beside a label that does nothing when
// tapped is two affordances for one action, and the smaller one is the only one that works.
// ceTap rides the event boundary here, same as ceShellNav's cells, never nested inside.
// Built on ceSettingRow rather than beside it so label/hint spacing cannot drift between a
// row you can tap and one you cannot.
function ceTapRow(key: string, label: string, hint: string, tapKey: string, onTap: () => void): any {
    return h('div', {
        key: key,
        role: 'button', tabIndex: 0, 'aria-label': label,
        style: { cursor: 'pointer' },
        onClick: function() { ceTap(tapKey, onTap); }
    }, ceSettingRow(label, hint, ceChev()));
}

// The affordance ceTapRow ends with. A chevron, not a button: a control inside a row that is
// itself a control would be a second tap target for the same action.
function ceChev(): any {
    return h('div', { style: { flex: '0 0 auto', opacity: CE_OP.t3, fontSize: CE_T.fs } }, '\u203a');
}

// ceRow -- a Field-density row: key . value . trailing verbs (CE-STYLE v2.0 SS7.2, SS8).
// Distinct from ceSettingRow (a Settings-shaped label+hint+control line): this is the
// dense per-field row a Profile slot / pressure readout / preset list wants, three flex
// slots instead of two, key column always ceKey and never bespoke.
// zebra (optional): CE_STYLE SS7.2 names CE_FILL-on-even-rows as "the one legitimate use
// of a fill as a grouping device" at this density. Pass the row's own index (0-based) and
// ceRow applies it on every odd index; omit it and the row renders with no fill, which is
// correct for a lone row or a list that doesn't want zebra banding.
function ceRow(key: string, value: any, trail: any, zebraIndex?: number): any {
    var zebra = (typeof zebraIndex === 'number') && (zebraIndex % 2 === 1);
    return h('div', { style: {
        display: 'flex', alignItems: 'center', gap: CE_T.s3,
        padding: CE_T.s2 + ' ' + CE_T.s3, lineHeight: CE_T.lhTight,
        background: zebra ? CE_FILL : 'transparent'
    } },
        h('div', { style: { flex: '0 0 auto' } }, ceKey(key)),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fsSm } }, value),
        trail ? h('div', { style: { flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: CE_T.s1 } }, trail) : null
    );
}

// [PASS-C KIT-ELSEWHERE] THREE KIT PRIMITIVES ARE NOT IN THIS SECTION. They live in
// SECTION 30 for historical reasons -- Profile was the first surface that needed a
// collapsible -- and they are kit, not profile-local:
//   ceAccordion    section that opens in place  -> S31 Journal, S33 Chat x2, S35 Images,
//                                                  S37 Wizard x2.  ZERO callers in S30.
//   ceExpandRow    row that opens in place      -> S34 Settings x6, S37 Wizard x2.
//                                                  ZERO callers in S30.
//   ceToggleOpen / _ceSetOpen / _ceOpenIs       the open-state helpers both run on;
//                                                  ceToggleOpen also serves S29 Scene.
// BEFORE YOU WRITE A COLLAPSIBLE, USE ONE OF THOSE TWO. They are the reason there is no
// third. Moving them here is a ~200-line relocation with no functional change and has
// been deliberately not done; if you move them, move all five together.

// ceChip -- a STATE label, not a verb (CE-STYLE v2.0 SS8). Read/Object density. Distinct
// from ceToggle (a boolean whose state IS the control) and from the profile flag chip
// this kit already had inline (SECTION 30's `chip()` closure) -- that one is a per-surface
// helper wired to ceProfileWrite and stays put; this is the general-purpose primitive for
// anywhere else a state label is needed. Press feedback deliberately NOT wired -- see the
// SS9.1/SS14 note on ceIconBtn below; this primitive is in the same boat.
// [THEME-VAR3] THE RETICLE, AND WHY IT IS ENGINE CODE AND NOT THEME CODE.
// A theme cannot draw this. Corner marks need pseudo-elements, and a stylesheet in
// document.head reaches nothing inside this shadow root -- and CSS @keyframes are resolved
// in the TREE SCOPE OF THE ELEMENT, so a document-level animation name does not exist here
// either. Two of the three ways to build a framing effect are unavailable by construction.
// THE THIRD IS A TRANSITION ON AN INLINE STYLE, which is what this is: four corner marks
// that sit wide and invisible while the chip is off and settle onto its corners when it
// comes on. The zoom is the transition; the paint and the timing are the theme's.
// INVISIBLE UNTIL A THEME ASKS. --ce-reticle-opacity defaults to 0, so an unthemed CE
// renders four zero-opacity divs and looks exactly as it did. That is four nodes per chip
// spent on nothing, which is the price of the effect being reachable at all -- a theme has
// no other way to add an element to this tree.
function _ceChipReticle(on: boolean): any[] {
    var marks: any[] = [];
    // Off: pushed out and transparent. On: framing the chip. Nothing else moves.
    var out = on ? '-3px' : '-11px';
    var corners = [
        { k: 'tl', top: out, left: out, borderTop: 1, borderLeft: 1 },
        { k: 'tr', top: out, right: out, borderTop: 1, borderRight: 1 },
        { k: 'bl', bottom: out, left: out, borderBottom: 1, borderLeft: 1 },
        { k: 'br', bottom: out, right: out, borderBottom: 1, borderRight: 1 }
    ];
    for (var i = 0; i < corners.length; i++) {
        var c: any = corners[i];
        var st: any = {
            position: 'absolute', pointerEvents: 'none',
            width: 'var(--ce-reticle-size, 7px)', height: 'var(--ce-reticle-size, 7px)',
            opacity: on ? 'var(--ce-reticle-opacity, 0)' : '0',
            transition: 'all var(--ce-reticle-motion, ' + CE_T.mBase + ') '
                + 'var(--ce-motion-ease, ' + CE_T.ease + ')'
        };
        if (c.top !== undefined) st.top = c.top;
        if (c.bottom !== undefined) st.bottom = c.bottom;
        if (c.left !== undefined) st.left = c.left;
        if (c.right !== undefined) st.right = c.right;
        var line = '1px solid var(--ce-reticle, currentColor)';
        if (c.borderTop) st.borderTop = line;
        if (c.borderBottom) st.borderBottom = line;
        if (c.borderLeft) st.borderLeft = line;
        if (c.borderRight) st.borderRight = line;
        marks.push(h('div', { key: 'ret_' + c.k, style: st }));
    }
    return marks;
}

function ceChip(label: string, on: boolean, onTap?: () => void): any {
    return h('div', {
        onClick: onTap ? function() { ceTap('chip:' + label, onTap); } : undefined,
        style: {
            display: 'inline-flex', alignItems: 'center', minHeight: '26px', padding: '0 ' + CE_T.s2,
            fontSize: CE_T.fsKey, letterSpacing: '0.06em', textTransform: 'uppercase',
            // The marks are positioned against the chip, and OUTSIDE it: the container must
            // not clip them, which is why nothing here sets overflow.
            position: 'relative',
            cursor: onTap ? 'pointer' : 'default',
            // [THEME-VAR2] A chip is a selected/unselected pair and reads as one thing or
            // the other, so both states are named rather than derived from one.
            borderRadius: 'var(--ce-chip-radius, ' + CE_T.rPill + ')',
            border: '1px solid ' + (on ? 'var(--ce-chip-line-on, ' + CE_LINE2 + ')'
                                       : 'var(--ce-chip-line-off, ' + CE_LINE + ')'),
            background: on ? 'var(--ce-chip-fill-on, ' + CE_FILL + ')'
                           : 'var(--ce-chip-fill-off, transparent)',
            opacity: on ? CE_OP.t1 : CE_OP.t3,
            transition: 'all var(--ce-motion-fast, ' + CE_T.mFast + ') '
                + 'var(--ce-motion-ease, ' + CE_T.ease + ')'
        }
    }, h('span', { key: 'lbl' }, label), _ceChipReticle(on));
}

// [I-05] ceMeter's SPECIFICATION LIVED HERE FOR EIGHT VERSIONS WITH NO FUNCTION UNDER IT.
// The paragraph describing a 0-100 bar ran straight into ceCard's, so the header list above
// ("ceGroup/ceRow/ceChip/ceMeter/ceCard/ceIcon MAY HAVE ZERO CALL SITES") was protecting a
// primitive that did not exist from a dead-code sweep that could never have found it. It is
// BUILT NOW, in the gauge block above ceSettingRow, to the spec that was written here: hue
// passed in rather than looked up, never dimmed by opacity, CE_LINE as the track.
// A DOC COMMENT WITH NO CODE UNDER IT IS WORSE THAN NO COMMENT -- it reads as a call site's
// contract and answers grep. Check for the function, not the paragraph.
// ceCard -- the Object-density container (CE-STYLE v2.0 SS7.3, SS8). THE ONE DENSITY THAT
// DRAWS A BOX, and the reason is stated in SS7.3: the records are distinct THINGS, so the
// box is grouping rather than chrome.
//
// THE LEFT BORDER IS THE IDENTITY HUE, 3px, AND IT REPLACES THE DOT (SS6.3 #2). Scene
// character cards previously carried an 8px ceDot for pattern identity; that dot is now
// wrong on two counts -- SS8 says ceDot is "Not for pattern identity any more", and the
// dot cost a whole row of vertical space that the card's own padding now pays for.
// A card whose subject has NO pattern gets NO hue (SS6.3: "A character with no pattern has
// no hue. That is information; do not fill it with grey"), so the left border falls back
// to the same CE_LINE as the other three edges rather than to a neutral accent.
//
// THE INSET TOP HIGHLIGHT is what makes one container read correctly on both theme
// polarities: a 1px lit edge on a dark ground, a soft bevel on a light one. It is the only
// place in the kit that mixes a highlight into a shadow, and it belongs to this primitive
// alone -- a call site reaching for it means it wanted a card.
//
// DO NOT NEST. SS7.3: "Object density containers never nest. A card inside a card means
// the inner content was fields (Field) or prose (Read)."
function _ceCardC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var tappable = !!p.onClick;
    return h('div', {
        onClick: tappable ? function() { ceTap('card:' + String(p.opId || p.key || ''), p.onClick); } : undefined,
        onPointerDown: tappable ? function() { setPressed(true); } : undefined,
        onPointerUp: tappable ? function() { setPressed(false); } : undefined,
        onPointerLeave: tappable ? function() { setPressed(false); } : undefined,
        onTouchCancel: tappable ? function() { setPressed(false); } : undefined,
        style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s1,
            padding: CE_T.s3, borderRadius: CE_T.rCard,
            background: pressed ? CE_FILL2 : CE_WELL,
            border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + (p.hue || CE_LINE),
            // [THEME-FX] A SECOND, THEME-OWNED SHADOW LAYER. The inset highlight above is
            // structure and stays fixed; --ce-glow is the slot a theme paints a bloom,
            // an outer rim or a drop into. It defaults to a zero-size transparent shadow,
            // which paints nothing and costs nothing, so an unthemed card is unchanged.
            // THE WHOLE DECLARATION IS AT RISK, and that is the accepted price: an
            // unparseable value here drops the inset highlight with it. Same trade the
            // reticle makes -- a theme has no other way to add a layer to this tree.
            boxShadow: 'inset 0 1px 0 color-mix(in srgb, currentColor 9%, transparent), '
                + 'var(--ce-glow, 0 0 0 transparent)',
            transform: pressed ? 'scale(var(--ce-press-scale-lg, 0.99))' : 'none',
            cursor: tappable ? 'pointer' : 'default',
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, p.children);
}
// `hue` is a CE_PATTERN_DEFS[id].c value or empty. `children` is the card's contents --
// ceH for the record's name, ceSm for its sub-line (SS7.3).
// [STYLE2-F] `key` IS FORWARDED NOW. The first two consumers (chat contacts,
// portrait slots) both render N cards from an array, and without a key Preact reuses one
// component instance across two logical cards at the same tree position -- the exact node
// reuse TAP-GUARD's autopsy is about. Additive: every keyless call site is unaffected.
function ceCard(opts: any): any {
    return h(_ceCardC, { key: opts.key, hue: opts.hue, onClick: opts.onClick,
                         opId: opts.opId, children: opts.children });
}

function ceDot(level: string): any {
    var c = CE_SEM[level] || 'transparent';
    // 'calm' renders transparent rather than absent so rows do not reflow when
    // a character settles.
    return h('div', { style: {
        width: '8px', height: '8px', borderRadius: '50%', flex: '0 0 auto',
        background: c, border: c === 'transparent' ? '1px solid ' + CE_LINE : 'none'
    } });
}

// [TABROW] THE ONE TAB STRIP. Three surfaces had hand-rolled this — Settings,
// Images and the Wizard — and the copies had already drifted: Images had been moved onto
// ceInline({ rule: 'bottom' }) while the other two still hand-rolled the container div, so
// two of the three were writing style a primitive already owned. Same shape, same opacity
// ladder rung (SS4 names inactive tabs as its own example of t3), one implementation.
//
// `scope` is the ceTabGet/ceTabSet key AND the opId prefix, so a strip cannot set one tab
// store and guard taps against another. `after` runs post-set for a surface that must
// republish on a tab change (the Wizard does; Settings and Images read the tab straight
// out of ceUiStore and do not).
function ceTabRow(scope: string, tabs: any[], active: string, after?: () => void): any {
    var kids: any[] = [];
    for (var i = 0; i < tabs.length; i++) {
        kids.push((function(t: any) {
            var on = t.id === active;
            return h('div', {
                key: 'tab_' + scope + '_' + t.id,
                onClick: function() {
                    ceTap(scope + ':tab:' + t.id, function() {
                        if (on) return;
                        ceTabSet(scope, t.id);
                        if (after) after();
                    });
                },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fs, fontWeight: on ? '600' : 'normal',
                    padding: CE_T.s2 + ' ' + CE_T.s3, opacity: on ? CE_OP.t1 : CE_OP.t3,
                    borderBottom: '2px solid ' + (on ? CE_LINE2 : 'transparent')
                }
            }, t.label);
        })(tabs[i]));
    }
    return ceInline({ rule: 'bottom' }, kids);
}

function ceListRow(opts: any): any {
    // [TABROW] `key` and `opId` forwarded, exactly as ceCard's [STYLE2-F] note
    // describes and for the same reason: these render N rows from an array, and without a
    // key Preact reuses one instance across two logical rows at the same tree position.
    // opId defaults to the old label-derived id, so every existing call site is unchanged
    // — but two rows sharing a label shared a tap guard, which is why it is now settable.
    return h('div', {
        key: opts.key,
        onClick: opts.onClick ? function() { ceTap(String(opts.opId || ('row:' + String(opts.label || ''))), function() { opts.onClick(); }); } : undefined,
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: CE_T.tap, padding: CE_T.s2 + ' 0',
            borderBottom: '1px solid ' + CE_LINE,
            cursor: opts.onClick ? 'pointer' : 'default'
        }
    },
        opts.lead || null,
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '2px' } },
            h('div', { style: { fontSize: CE_T.fs } }, opts.label),
            opts.sub ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, opts.sub) : null
        ),
        opts.trail ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74', flex: '0 0 auto' } }, opts.trail) : null
    );
}

// ── [SS-BOX] LAYOUT AND TEXT PRIMITIVES ─────────────────────────────────────
//
// SS1's rule -- "A surface composes primitives. It does not write style." -- was true and
// unenforceable, because the primitives a surface needed most did not exist. A census of
// SECTIONS 29-37 found 595 hand-rolled h('div', { style: {...} }) calls against 3 uses of
// ceCard, 2 of ceRow and 2 of ceH3. They are not a long tail: TWELVE shapes cover 74% of
// them and twenty cover 84%. This block is those twelve.
//
// WHAT THE CENSUS ACTUALLY FOUND, and why this is a correctness fix rather than tidying:
//     opacity '0.58' hand-typed .... 63     lineHeight CE_T.lhProse ...... 47
//     opacity CE_OP.t3 (= '0.58') .. 35     lineHeight '1.5' ............. 16
//     opacity '0.74' hand-typed .... 15     lineHeight '1.6' ............. 6
//     opacity CE_OP.t2 (= '0.74') .. 26     lineHeight 1.4/1.45/1.55/1.65  15
// Sixty-three sites typed a token's VALUE instead of the token, and seven distinct
// line-heights are doing one job. That is the whole of "the UI is subtly inconsistent",
// measured. A primitive taking tone 't1'|'t2'|'t3' makes the drift UNREPRESENTABLE, which
// is the only enforcement that survives contact with a hurry.
//
// CHILDREN ARE PASSED AS AN ARRAY, not as rest arguments: nothing else in this file uses
// spread or rest, preact flattens an array child, and several existing call sites already
// hand h() an array (ceEmpty, the Chat contact list). Matching that costs nothing and
// keeps the transpile surface identical.
//
// THE FIRST ARGUMENT IS A TOKEN OR AN OPTS OBJECT. `ceStack(CE_T.s2, kids)` for the common
// case; `ceStack({ gap: CE_T.s2, key: 'row_' + id }, kids)` when the node is in a keyed
// list. KEY PASSTHROUGH IS THE ONE THING THAT CAN BREAK A CONVERSION: 158 of the 595 carry
// a key, and a primitive that swallowed one would turn a keyed list into a positional one
// silently -- the symptom being a card inheriting its neighbour's DOM node (TABBODY-KEY,
// and the conditional-child hazard _ceChatBubbleBlock documents). Every primitive below
// routes props through _ceBoxProps, which is the only place key is handled.

interface CeBoxOpts {
    gap?: string;
    key?: string;
    tone?: string;      // 't1' | 't2' | 't3' — never a literal opacity
    grow?: boolean;     // flex: '1 1 auto' + minWidth: 0
    center?: boolean;   // alignItems: 'center'
    // [SS-BOX-2] The five below are what the first conversion pass proved were MISSING.
    // Eight calls in SECTION 36 survived the converter, and seven of them were a plain
    // layout shape with ONE extra decision hung off it -- a separating rule, an alignment
    // that was not centre, a flex basis. Adding those as options is right where adding a
    // thirteenth primitive would have been wrong: they are modifiers of the same box, and
    // a `ceBarWithATopRule` would be the beginning of the combinatorial explosion the kit
    // exists to prevent.
    rule?: string;      // 'top' | 'bottom' — a 1px CE_LINE separator on that edge
    padTop?: string;    // paddingTop. Named per-side rather than one `pad` because a rule
    padBottom?: string; // and its breathing room are always on the SAME side, and one
                        // ambiguous `pad` would have to guess which.
    align?: string;     // 'center' | 'start' | 'end' — maps to alignItems. Omit for stretch.
    basis?: string;     // flex-basis for ceGrow/ceFixed and the text primitives
    size?: string;      // 'sm' (default, CE_T.fsSm) | 'base' (CE_T.fs)
    style?: any;        // escape hatch. If you reach for this twice, the primitive is wrong.
}

// alignItems, from the short names. 'start'/'end' rather than 'flex-start'/'flex-end':
// the call sites were split between both spellings of the same intent.
function _ceAlign(a?: string): string {
    if (a === 'center') return 'center';
    if (a === 'start') return 'flex-start';
    if (a === 'end') return 'flex-end';
    return '';
}

// Rule + padding, applied together. They are one decision -- a separator with no room
// around it reads as a mistake -- so they are written in one place.
function _ceEdge(o: CeBoxOpts, st: any): void {
    if (o.rule === 'top')    st.borderTop    = '1px solid ' + CE_LINE;
    if (o.rule === 'bottom') st.borderBottom = '1px solid ' + CE_LINE;
    if (o.padTop)    st.paddingTop    = o.padTop;
    if (o.padBottom) st.paddingBottom = o.padBottom;
}

function _ceFontSize(s?: string): string {
    return (s === 'base') ? CE_T.fs : CE_T.fsSm;
}

// Normalises the shorthand. A bare string is a gap; anything else is an opts object.
function _ceBoxOpts(o: any): CeBoxOpts {
    if (o === null || o === undefined) return {};
    if (typeof o === 'string') return { gap: o };
    return o as CeBoxOpts;
}

// THE ONLY PLACE `key` IS READ. Every box primitive goes through here, so key handling is
// one line rather than twelve chances to forget it.
function _ceBoxProps(o: CeBoxOpts, base: any): any {
    var bp: any = { style: base };
    if (o.grow) { base.flex = '1 1 ' + (o.basis || 'auto'); base.minWidth = 0; }
    _ceEdge(o, base);
    if (o.style) { for (var bk in o.style) { if (Object.prototype.hasOwnProperty.call(o.style, bk)) base[bk] = o.style[bk]; } }
    if (o.key !== undefined && o.key !== null && o.key !== '') bp.key = o.key;
    return bp;
}

// Opacity by ROLE. Anything not on the ladder lands on t3 rather than passing through:
// silently accepting '0.58' would leave the exact drift this block exists to end.
function _ceTone(t?: string): string {
    if (t === 't1') return CE_OP.t1;
    if (t === 't2') return CE_OP.t2;
    return CE_OP.t3;
}

// 1. ceStack — vertical flex. 172 of the 595 (29%), the single biggest shape by a factor
//    of three. Pass gap 0 (or omit it) for the 30 sites that stack with no gap at all.
function ceStack(o: any, kids: any[]): any {
    var so = _ceBoxOpts(o);
    var st: any = { display: 'flex', flexDirection: 'column' };
    if (so.gap) st.gap = so.gap;
    if (so.center) st.alignItems = 'center';
    else if (_ceAlign(so.align)) st.alignItems = _ceAlign(so.align);
    return h('div', _ceBoxProps(so, st), kids);
}

// 2. ceInline — horizontal flex that WRAPS. 43 sites. The wrap is the point: this is the
//    button-row / chip-row shape, and a row of controls that cannot wrap is a row that
//    overflows the drill on a narrow window.
function ceInline(o: any, kids: any[]): any {
    var io = _ceBoxOpts(o);
    var st: any = { display: 'flex', flexWrap: 'wrap' };
    if (io.gap) st.gap = io.gap;
    st.alignItems = _ceAlign(io.align) || 'center';
    return h('div', _ceBoxProps(io, st), kids);
}

// 3. ceBar — horizontal flex, centred, NO wrap. 21 sites. Distinct from ceInline on
//    purpose: this is the label-and-trailing-control shape where wrapping would break the
//    alignment that is the whole reason the row exists.
function ceBar(o: any, kids: any[]): any {
    var bo = _ceBoxOpts(o);
    var st: any = { display: 'flex' };
    st.alignItems = _ceAlign(bo.align) || 'center';
    if (bo.gap) st.gap = bo.gap;
    return h('div', _ceBoxProps(bo, st), kids);
}

// 4. ceWrap — a plain div. 53 sites carry NO style at all and exist only to give a group
//    of children one parent (or one key). Named rather than left as raw h() so that a
//    styleless wrapper is a deliberate choice on the page instead of the thing everyone
//    reaches for first.
function ceWrap(o: any, kids: any[]): any {
    var wo = _ceBoxOpts(o);
    return h('div', _ceBoxProps(wo, {}), kids);
}

// 5. ceGrow — the flexible cell in a row. 31 sites across three near-identical spellings
//    (`flex`, `flex + minWidth`, `flex + flexDirection + gap + minWidth`). minWidth: 0 is
//    NOT optional and is why those sites exist in three forms: without it a flex child
//    will not shrink below its content and long names blow the row out.
function ceGrow(o: any, kids: any[]): any {
    var go = _ceBoxOpts(o);
    var st: any = { flex: '1 1 ' + (go.basis || 'auto'), minWidth: 0 };
    if (go.gap) { st.display = 'flex'; st.flexDirection = 'column'; st.gap = go.gap; }
    return h('div', _ceBoxProps(go, st), kids);
}

// 6. ceFixed — the cell that must NOT grow or shrink. Its counterpart; the two are always
//    written together and were always written by hand.
function ceFixed(o: any, kids: any[]): any {
    var fo = _ceBoxOpts(o);
    var st: any = { flex: '0 0 ' + (fo.basis || 'auto') };
    if (fo.size) st.fontSize = _ceFontSize(fo.size);
    return h('div', _ceBoxProps(fo, st), kids);
}

// 7. ceProse — small body text with prose line-height. 67 sites, and the worst offender in
//    the census: seven different line-heights and both spellings of every opacity.
function ceProse(tone: any, text: any, o?: any): any {
    var po = _ceBoxOpts(o);
    var st: any = { fontSize: _ceFontSize(po.size), lineHeight: CE_T.lhProse,
                    opacity: _ceTone(typeof tone === 'string' ? tone : po.tone) };
    return h('div', _ceBoxProps(po, st), text);
}

// 8. ceSub — small text, tight, no prose line-height. 55 sites. The sub-label / count /
//    caption shape. Split from ceProse because the two ARE different decisions: one is a
//    sentence to read, the other is a word to glance at.
function ceSub(tone: any, text: any, o?: any): any {
    var uo = _ceBoxOpts(o);
    var st: any = { fontSize: _ceFontSize(uo.size), opacity: _ceTone(typeof tone === 'string' ? tone : uo.tone) };
    return h('div', _ceBoxProps(uo, st), text);
}

// 9. ceIndent — the railed sub-block. 12 sites, and every one of them picked its own rail
//    width and colour. One decision now: CE_LINE at 1px, CE_T.s3 of padding.
function ceIndent(o: any, kids: any[]): any {
    var no = _ceBoxOpts(o);
    var st: any = { display: 'flex', flexDirection: 'column',
                    borderLeft: '1px solid ' + CE_LINE, paddingLeft: CE_T.s3 };
    if (_ceAlign(no.align)) st.alignItems = _ceAlign(no.align);
    if (no.gap) st.gap = no.gap;
    return h('div', _ceBoxProps(no, st), kids);
}

// 10. ceTruncate — one line, ellipsised. 6 sites, all spelled slightly differently, and
//     every one of them ALSO needed minWidth: 0 on its flex parent to work at all. Use
//     inside a ceGrow, which supplies it.
function ceTruncate(tone: any, text: any, o?: any): any {
    var to = _ceBoxOpts(o);
    var st: any = { fontSize: _ceFontSize(to.size), opacity: _ceTone(typeof tone === 'string' ? tone : to.tone),
                    overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' };
    return h('div', _ceBoxProps(to, st), text);
}

// 11. ceRule — a horizontal divider. The 3 borderBottom-only sites plus every future one.
//     Takes no children by design: a rule with content is a ceBar with a border, and that
//     is a different thing that should look different in the source.
function ceRule(o?: any): any {
    var ro = _ceBoxOpts(o);
    return h('div', _ceBoxProps(ro, { borderBottom: '1px solid ' + CE_LINE }), []);
}

// 12. ceGap — vertical space with nothing in it. The paddingTop/paddingBottom-only divs.
//     Exists so that "I need more room here" is a token rather than a number typed into a
//     div, which is how s1 through s5 stopped being the whole vocabulary in the first place.
function ceGap(size?: string): any {
    return h('div', { style: { paddingTop: size || CE_T.s3 } }, []);
}

// [GEN-RAIL-OUT] ceBusy was here. See the note where ceGenBegin/ceGenEnd were.

function ceEmpty(msg: string, action: any): any {
    return h('div', { style: { display: 'flex', flexDirection: 'column', alignItems: 'center', gap: CE_T.s2, padding: CE_T.s4, opacity: '0.74', fontSize: CE_T.fsSm, textAlign: 'center' } },
        h('div', null, msg),
        action || null
    );
}

// [FIELD-LIVE] WHAT IS ACTUALLY IN THE BOX RIGHT NOW, asked of the ELEMENT rather than
// waited for as an event. FIELD-SEED measured the two facts this rests on: the ref proxy is
// read-through on `value`, and a later read returns TEXT THE USER HAS SINCE TYPED.
// IT REPLACES THE onType SCRATCHPAD FOR BUTTONS, and the reason is that a scratchpad is a
// CACHE OF AN EVENT and inherits every question about whether that event fires. The list
// editors' fix shipped on onInput and did not work; the JSX layer's own event set is being
// revised (the delivered list names click/keydown/input/change and does NOT name blur or
// focusout), and a fix whose correctness depends on which side of that revision we are on is
// not a fix. Reading the element asks nothing of the event system at all.
// KEYED ON p.k, WHICH IS ALREADY THE FIELD'S IDENTITY -- ceAction stamps 'field:' + p.k, so
// a k that is not unique on a surface was already a bug one system over.
// REGISTERED FROM THE ref CALLBACK, which fires exactly once per mount and once with null on
// unmount, so the table cannot leak a dead proxy. The unmount branch deletes only if the
// entry is still the element it registered -- a remount that lands before its predecessor's
// unmount would otherwise delete the LIVE one.
var CE_FIELD_ELS: any = {};

// null means "no live element", which is NOT the same as ''. A caller must fall back to the
// stored value on null and must not treat it as an empty box.
function ceFieldLive(k: string): string | null {
    var key = String(k || '');
    if (!key) return null;
    var el: any = CE_FIELD_ELS[key];
    if (!el) return null;
    try {
        var v: any = el.value;
        return (v == null) ? '' : String(v);
    } catch (e) { return null; }
}

// [FIELD-LIVE] THE NUMERIC READ, AND ITS FALLBACK RULE IS ceNumField'S OWN COMMIT RULE rather
// than a new one. That commit does `if (!isFinite(n)) n = Number(p.value) || 0`, so an empty
// or half-typed box ('-', '1.') commits the value the field already had. A live read that
// answered 0 for those would make a NEIGHBOUR's verb do something this field's own blur never
// would, which is the whole class of failure this family exists to remove.
// NO CLAMP AND NO ROUNDING HERE: min/max/decimals live on the ceNumField props, and every
// caller runs its own row normaliser over the result anyway.
function ceFieldLiveNum(k: string, fallback: number): number {
    var raw = ceFieldLive(k);
    if (raw === null) return fallback;
    var s = String(raw).trim();
    if (!s) return fallback;
    var n = Number(s);
    return isFinite(n) ? n : fallback;
}

// [JSXKIT] DELIBERATELY UNUSED THIS PASS. The Scene surface is
// read-only, so nothing renders a field yet - but this primitive carries the
// most hard-won constraints in the kit and lands with them rather than being
// reinvented under deadline by the first authoring surface. DO NOT DELETE in a
// dead-code sweep; it is a forward dependency, not an orphan.
//
// TWO SHARP EDGES, both consequences of it calling useRef:
//   (a) it MUST be invoked during a component render (as ceField(p) inside a
//       Root, or via h(ceField, p)) - never outside one;
//   (b) hook order must be stable, so it must NOT be called conditionally or in
//       a variable-length loop. If a surface ever needs a dynamic field list,
//       convert it to a real component first: h(ceField, props) with a key.
function ceField(p: any): any {
    // UNCONTROLLED, and every clause below is now MEASURED rather than inherited.
    // Probe earlier mounted ten fields at once; see FIELD-SEED in the CE-INDEX.
    //
    // [FIELD-SEED] `defaultValue` DOES NOTHING IN THIS ENVIRONMENT. It is not a
    // whitelisted prop -- script-types_d.txt states outright that only specific attributes
    // are allowed on a jsx tree, and neither ScriptInputAttributes nor
    // ScriptTextareaAttributes declares it. Every name in those interfaces is the HTML
    // ATTRIBUTE spelling (`readonly`, `maxlength`, `spellcheck`), which is what a
    // props-to-attributes serializer across the worker boundary looks like, and
    // `defaultValue` has no attribute form for such a serializer to emit. Probe A1 (input)
    // and A4 (textarea) both rendered BLANK. So the field was never showing a stale value;
    // it was never showing ANY value, and an earlier staleness fix addressed a real second
    // problem while leaving the first one untouched.
    //
    // THE SEED IS NOW AN IMPERATIVE WRITE THROUGH A ref CALLBACK. `el` is a proxy across
    // the worker boundary (probe A3 -- nodeName INPUT but tagName undefined, no
    // ownerDocument, no focus method), so nothing about this was safe to assume. What was
    // measured: `el.value = x` followed by an immediate read returns x (READBACK-OK), and
    // a later read returns TEXT THE USER HAS SINCE TYPED. The proxy is read-through and
    // write-through on `value`.
    //
    // THREE PROPERTIES OF THE ref THAT THE SHAPE OF THIS FUNCTION DEPENDS ON:
    //   (1) A STABLE ref FIRES EXACTLY ONCE PER MOUNT. Probe A3 stayed at fire #1 across
    //       repeated re-renders. cbRef therefore holds ONE function for the life of the
    //       component -- an inline `ref: function(el){...}` is a new identity every render,
    //       which Preact re-invokes every render (probe A6), and that would overwrite
    //       whatever the user was mid-way through typing.
    //   (2) BECAUSE IT ONLY FIRES ON MOUNT, IT CANNOT SEE A CHANGED VALUE ON ITS OWN.
    //       Probe: changing the seed did not update A3. earlier closed that gap by bumping
    //       the ELEMENT KEY to force a remount; [FIELD-KEYLESS] closes it with an
    //       imperative write through the ref instead, and the key bump is GONE. See the
    //       block above the useEffect below for why.
    //   (3) THE CALLBACK MUST READ REFS, NEVER CLOSURE VARIABLES. It is created on the
    //       first render and never again, so anything captured by value is frozen at that
    //       render forever. The probe demonstrated the trap directly: its own A7 log line
    //       printed `key=k0` after three key bumps because it closed over `gen` instead of
    //       reading a ref. lastRef.current is read at call time and cannot go stale.
    //
    // AND `value=` IS NOW RULED OUT ON EVIDENCE, not on inference. Probe A8 bound value= to
    // a store field; text typed into it and not yet blurred was DESTROYED by an unrelated
    // re-render, while A3 under the ref seed survived the same re-render intact. That is
    // the controlled-render race of JSX-PROBE-RESULTS (2), observed directly. Do not
    // "simplify" this back to value=.
    //
    // COMMIT READS THE ELEMENT, NOT THE EVENT. e.target is a serialized ScriptEventTarget
    // snapshot, and this environment is already on record for delivering stale values in
    // one (probe earlier, onInput at word boundaries). The live proxy read is strictly more
    // trustworthy; the event stays as a fallback for the case where the ref never landed.
    // [FIELD-KEYLESS] THE ELEMENT KEY NO LONGER BUMPS. It used to
    // bump on every external value change -- which is every commit, on every surface -- and
    // the Journal is simply the first surface where the cost was VISIBLE: adding an entry
    // left the old composer standing and mounted a fresh one beside it, one more per add,
    // until leaving the surface remounted the part and swept them. A leaked node inside a
    // collapsed accordion is invisible, which is why the Profile never reported it.
    // WHAT REPLACES IT: an imperative write through elRef, which FIELD-SEED already measured
    // to be retained and write-through on `value`. No remount, so nothing can leak.
    // THE OBJECTION THAT BLOCKED THIS BEFORE was that the key bump was only safe because a
    // commit fires on blur, so the replaced element is never the focused one -- and there is
    // no way to check focus here (no el.focus, no ownerDocument, no activeElement).
    // THE ANSWER IS THAT FOCUS WAS NEVER THE QUESTION. What must not be destroyed is
    // UNCOMMITTED TEXT, and that is directly readable: if el.value has drifted from
    // lastRef.current, the author has typed something this field has not committed yet, and
    // the incoming external value loses. A focus test would get both edges wrong -- a
    // focused field with nothing typed is safe to overwrite, an unfocused one holding
    // uncommitted text is not.
    var incoming = (p.value == null) ? '' : String(p.value);
    // `seed` is an EXPLICIT RESET TOKEN and the one case the value comparison cannot cover:
    // a field whose `value` prop never changes (the Journal composer is always '') has
    // nothing for this function to detect. Bump it and the field is force-cleared to
    // `value`, uncommitted text included -- that is the point, it means "the surface has
    // consumed what was in here."
    var seedSig = (p.seed == null) ? '' : String(p.seed);
    var lastRef = useRef(incoming);
    var seenRef = useRef(incoming);
    var seedRef = useRef(seedSig);
    var elRef = useRef(null as any);
    var wantRef = useRef(null as any);
    // [FIELD-LIVE] Read at CALL time by the ref callback, never closed over: that callback is
    // built on the first render and never again, so a captured p.k would be frozen at
    // whatever this field was called the first time it mounted.
    var kRef = useRef('');
    kRef.current = (p.k == null) ? '' : String(p.k);
    if (seedSig !== seedRef.current) {
        seedRef.current = seedSig;
        seenRef.current = incoming;
        wantRef.current = { text: incoming, force: true };
    } else if (incoming !== seenRef.current) {
        seenRef.current = incoming;
        wantRef.current = { text: incoming, force: false };
    }
    var cbRef = useRef(null as any);
    if (!cbRef.current) {
        cbRef.current = function(el: any) {
            // Preact calls this with null on unmount, element on mount. Now that the key is
            // stable this fires exactly once for the life of the component, which is what
            // makes lastRef the only seed path.
            var fk = String(kRef.current || '');
            if (!el) {
                // [FIELD-LIVE] Deregister, but only if the table still holds OUR element.
                if (fk && CE_FIELD_ELS[fk] === elRef.current) delete CE_FIELD_ELS[fk];
                elRef.current = null;
                return;
            }
            elRef.current = el;
            if (fk) CE_FIELD_ELS[fk] = el;
            try { el.value = lastRef.current; }
            catch (e) { api.v1.error('[AE:jsxkit] field seed failed:', e); }
        };
    }
    // The re-seed. Deliberately runs AFTER render (the element must exist and the props
    // must already be applied) and deliberately has NO dependency array -- the decision was
    // made during render and parked on wantRef, so this only has to drain it.
    useEffect(function() {
        var want: any = wantRef.current;
        if (!want) return;
        wantRef.current = null;
        var el: any = elRef.current;
        if (!el) { lastRef.current = String(want.text); return; }
        var cur = '';
        var ok = false;
        try { cur = (el.value == null) ? '' : String(el.value); ok = true; }
        catch (e1) { ok = false; }
        // Uncommitted typing wins. lastRef is NOT advanced here on purpose: leaving it
        // stale is what makes the eventual blur still look like a change and commit.
        if (ok && !want.force && cur !== lastRef.current) return;
        if (ok && cur === String(want.text)) { lastRef.current = String(want.text); return; }
        try { el.value = String(want.text); lastRef.current = String(want.text); }
        catch (e2) { api.v1.error('[AE:jsxkit] field reseed failed:', e2); }
    });
    function commit(e: any) {
        var v = '';
        var read = false;
        var el = elRef.current;
        if (el) {
            try { v = (el.value == null) ? '' : String(el.value); read = true; }
            catch (e1) { read = false; }
        }
        if (!read) { v = (e && e.target && e.target.value != null) ? String(e.target.value) : ''; }
        if (v === lastRef.current) return;
        lastRef.current = v;
        ceAction('field:' + p.k, function() { return p.onCommit(v); });
    }
    // [FIELD-SCRATCH] onType is a SCRATCHPAD TAP, not a second commit path, and
    // it exists because CLICK IS DELIVERED BEFORE BLUR IN THIS ENVIRONMENT -- measured, see
    // CLICK-BEFORE-BLUR. A button that reads a value the field commits on blur reads the
    // PREVIOUS value on its first press, which is precisely the Journal "Add" bug.
    // [FIELD-LIVE] A NEW BUTTON SHOULD USE ceFieldLive INSTEAD. This tap caches an EVENT, so
    // it is only as reliable as the delivery of that event, and the list editors' first fix
    // shipped on it and did not work. ceFieldLive asks the element and cannot miss. onType
    // stays for the surfaces already built on it and for anything that genuinely wants to
    // react per keystroke rather than read on demand.
    // THE HARD RULE: an onType handler may write a MODULE VARIABLE and nothing else. It may
    // not touch a store. The original reason -- a store write re-renders, a
    // re-render changes p.value, and a changed p.value remounted the input -- no longer
    // applies, because FIELD-KEYLESS skips the re-seed whenever the element holds
    // uncommitted text. The rule stands anyway on the OTHER two grounds, which were always
    // the stronger ones: a store write repaints every subscriber of that store on every
    // keystroke, and onInput also multi-fires with
    // stale values at word boundaries (JSX-PROBE-RESULTS 2), which is harmless for a
    // scratchpad -- the last event carries the truth -- and would be corrupting for state.
    function scratch(e: any) {
        if (!p.onType) return;
        var v = '';
        var el = elRef.current;
        if (el) { try { v = (el.value == null) ? '' : String(el.value); } catch (e1) { el = null; } }
        if (!el) { v = (e && e.target && e.target.value != null) ? String(e.target.value) : ''; }
        try { p.onType(v); } catch (e2) { api.v1.error('[AE:jsxkit] field onType failed:', e2); }
    }
    // [WRITE-WELL] A read surface that happens to be editable and a
    // dedicated write box are different objects and must not look identical. The underline
    // is the editable-prose treatment; the well is "compose here".
    // [STYLE2-E] THE DEFAULT PATH NOW CARRIES A GROUND. The comment
    // directly above stated the rule -- a read surface that happens to be editable and a
    // dedicated write box must not look identical -- but only the `well` branch ever acted
    // on it. The default was `background: transparent` over a CE_LINE borderBottom, and
    // CE_LINE is the SAME 14% hairline every plain divider on every surface uses, so an
    // unfocused non-well field was indistinguishable from static text sitting above a rule.
    // WHAT DISTINGUISHES THEM NOW is a two-part treatment, and both parts are needed:
    // a faint CE_FILL ground (this is a surface you type ON) and a CE_LINE2 underline
    // (heavier than any divider, so the writing line still reads as a writing line). The
    // top corners round and the bottom two do not -- the underline stays the anchor.
    // THE WELL IS STILL A DIFFERENT OBJECT: CE_WELL is translucent BLACK (a recess, on
    // either theme polarity), where CE_FILL is currentColor-derived and tints toward the
    // text. A ground is "editable"; a recess is "compose here". Three states, not two.
    var inputStyle: any = {
        width: '100%', boxSizing: 'border-box', minHeight: CE_T.tap,
        fontSize: CE_T.fs, color: 'inherit', background: CE_FILL,
        border: 'none', borderBottom: '1px solid ' + CE_LINE2,
        borderRadius: CE_T.r + ' ' + CE_T.r + ' 0 0',
        padding: CE_T.s2 + ' ' + CE_T.s2
    };
    if (p.well) {
        inputStyle.background = CE_WELL;
        inputStyle.border = '1px solid ' + CE_LINE;
        inputStyle.borderBottom = '1px solid ' + CE_LINE;
        inputStyle.borderRadius = CE_T.r;
        inputStyle.padding = CE_T.s3;
        inputStyle.lineHeight = '1.6';
    }
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        // An empty label renders nothing rather than an empty row. The profile's
        // slot card supplies its own heading, so a second blank one would open a gap.
        p.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, p.label) : null,
        h(p.multiline ? 'textarea' : 'input', {
            ref: cbRef.current,
            onBlur: commit,
            onInput: p.onType ? scratch : undefined,
            rows: p.multiline ? (p.rows || 3) : undefined,
            placeholder: p.placeholder || '',
            style: inputStyle
        }),
        p.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, p.hint) : null
    );
}

// [SELECT] The kit's missing enum control. CE-UI-KIT v0.1 section 2.7 specified it and
// nothing built it, which is the whole reason the three texting-persona axes shipped
// unwired -- the data has been in buildCharProfilePayload since earlier (chatPersona +
// chatPersonaOpts, id/label pairs shipped from the engine's own option arrays so a new
// option appears in every UI with no per-surface edit).
//
// UNLIKE ceField THIS BINDS value= AND THAT IS CORRECT, not an inconsistency. The reason
// value= is forbidden on a text field is that a re-render mid-typing destroys uncommitted
// keystrokes (probe earlier A8). A select has no uncommitted intermediate state: it is
// either showing the stored option or a newly chosen one, so a re-render resetting it to
// the store is the DESIRED behaviour rather than data loss. Probe A9 confirmed value=
// preselects correctly; A10 confirmed the option-level `selected` attribute also works,
// and value= is preferred because it keeps one source of truth instead of pushing the
// current selection down into the options loop.
//
// HOOK-FREE BY CONTRACT. ceField cannot be called in a loop because it calls useRef and
// hook order must be stable; this deliberately calls nothing, so a surface may render N of
// them from an array -- which is exactly what the persona block does. ADDING A HOOK HERE IS
// A BREAKING CHANGE, not a refactor.
//
// The guard is ceTap, not ceAction. onChange has never been measured in this environment,
// but onClick is on record for double-firing (JSX-PROBE-RESULTS 1) and ceAction demonstrably
// does not cover an instant handler (TAP-GUARD). One physical selection is one action, so
// the global event-boundary guard is the right shape and the value dedupe backs it up.
// [SEC:STATE, promoted from SECTION 34] A CLAMPED, BLUR-COMMIT NUMERIC FIELD.
// Renders through ceField (uncontrolled, blur-commit) rather than value=, exactly like
// every text field on this shell; the only addition is numeric coercion and min/max
// clamping on commit. A malformed or out-of-range entry silently clamps rather than
// rejecting outright — matching sliderInput's own behaviour, which could never produce an
// out-of-range value in the first place. THERE IS STILL NO LIVE SLIDER anywhere in the
// shell; see SECTION 34's header for the measured reasons why.
// [NUMFIELD-DECIMALS] `decimals` IS REQUIRED IN PRACTICE
// FOR ANY CONTINUOUS VALUE. earlier rounded EVERY committed number with a bare
// Math.round, which was right for the eight integer call sites it was written against
// (intervals, caps, token budgets, steps) and silently wrong for the two continuous ones
// that arrived later: image Scale and field Weight both accept 0.1-10 and both had every
// decimal destroyed on commit -- typing 5.5 stored 6, typing 0.5 stored 1 (and 0.4 stored
// 0, which the min clamp then pushed back to 0.1).
// THE ROUNDING IS STILL DELIBERATE, not removed: it is what stops a pasted 3.7 becoming a
// token budget of 3.7, and float input in a text field otherwise accepts anything. What
// changed is that the PRECISION is now stated per call site instead of assumed to be zero.
//   decimals omitted / 0 -> integer (unchanged behaviour for every existing caller)
//   decimals: 1          -> one decimal place, which is what a 0.1 step means
// CLAMP ORDER MATTERS AND IS UNCHANGED: clamp first, quantise second. Quantising first
// could push a value back outside the range it was just clamped into.
function ceNumField(p: any): any {
    var curStr = (p.value == null) ? '' : String(p.value);
    var dp = Number(p.decimals) || 0;
    return h(ceField, {
        k: p.k, label: p.label || '', hint: p.hint || '',
        // [LIST-SWEEP] `seed` IS FORWARDED. It was not, and a numeric box inside a reorderable
        // row therefore had no force path: FIELD-KEYLESS lets uncommitted text win over an
        // incoming value, which is right for a field standing still and wrong for one whose
        // row has just moved underneath it -- the store is correct and the box shows the
        // number that used to be there. Undefined here is the same '' signature as before, so
        // no existing call site changes behaviour.
        seed: p.seed,
        value: curStr, placeholder: p.placeholder || '',
        onCommit: function(v: string) {
            var n = Number(v);
            if (!isFinite(n)) n = Number(p.value) || 0;
            if (p.min != null) n = Math.max(p.min, n);
            if (p.max != null) n = Math.min(p.max, n);
            if (dp > 0) {
                // toFixed then back through Number, so 0.30000000000000004 does not reach
                // storage and the value that redisplays is the value that was stored.
                var q = Math.pow(10, dp);
                n = Number((Math.round(n * q) / q).toFixed(dp));
            } else {
                n = Math.round(n);
            }
            return p.onCommit(n);
        }
    });
}

function ceSelect(p: any): any {
    var cur = (p.value == null) ? '' : String(p.value);
    var list: any[] = p.options || [];
    var opts: any[] = [];
    var i = 0;
    for (i = 0; i < list.length; i++) {
        var o: any = list[i];
        var oid = String((o && o.id != null) ? o.id : o);
        var olab = String((o && o.label != null) ? o.label : oid);
        // [SELECT-SELECTED] `selected` ON THE OPTION, not only `value` on the select.
        // Reported live as "the first time you try to select an option it doesn't
        // register", and the mechanism is FIELD-SEED's finding one element over: props
        // cross the worker boundary as ATTRIBUTES, and `value` HAS NO ATTRIBUTE FORM ON A
        // <select> -- setting it cannot move the selection the way it can on an <input>.
        // Nothing marked the chosen option at all, so the element showed option[0]
        // whatever the store held. What the author saw: pick "Force", the commit lands,
        // the repaint snaps the display back to "No approach", and picking Force a second
        // time hits the `v === cur` guard below and does nothing at all -- so a control
        // that had in fact worked looked stuck.
        // `value` IS KEPT on the select. It is declared in ScriptSelectAttributes, it is
        // free, and if the host does honour it the two agree.
        // [SELECT-DIRTY] CONFIRMED LIVE, and this is the step SELECT-SELECTED reserved. The
        // `selected` attribute is not enough on its own: a <select> the user has touched is
        // "dirty", the host PATCHES the standing element rather than honouring the new
        // attribute, and the display does not move. Reported as "the first click of approach
        // doesn't select it, just closes the picker" -- the native menu closes, the commit
        // lands in the store, the repaint patches a dirty element and shows the old value, and
        // the SECOND pick of the same option hits the `v === cur` guard and does nothing.
        // THE FIX IS ON THE <select> BELOW: it is KEYED ON `cur`, so a changed value makes
        // preact discard the dirty element and mount a fresh one whose selection is set from
        // scratch. This is safe here and would not be on an <input>: a select holds nothing
        // in progress, so a remount per commit destroys no half-typed text (FIELD-KEYLESS is
        // the opposite rule for the opposite reason). `selected` and `value` both stay -- on a
        // fresh element they now agree, and a host that DOES honour them costs one needless
        // remount, never a wrong value.
        // [MENU-INVISIBLE] REPORTED LIVE AS "I can't tell what I'm looking at without
        // hovering", on the default theme, with the whole option list rendering blank.
        //
        // THE MECHANISM: the closed <select> below composites over a CE surface, so
        // `color: inherit` on a dark theme is white text over the panel and reads correctly.
        // THE OPEN POPUP IS PAINTED BY THE BROWSER, OUTSIDE OUR STACKING CONTEXT, on its own
        // canvas. `background: transparent` cannot reach it and every option inherited the
        // white text with nothing behind it -- white on white, with only the hovered row
        // legible because the browser's own highlight was the only paint on the screen.
        // This is a whole class, not a select bug: ANY BROWSER-CHROME SURFACE (option lists,
        // datalists, native pickers) is outside the compositing this file's colour system
        // assumes, so a currentColor mix cannot describe it and a translucent ground
        // composites against the browser's default rather than against ours.
        //
        // Canvas / CanvasText ARE THE FIX, AND THEY ARE NOT A COLOUR LITERAL. They are CSS
        // system colours DEFINED AS A LEGIBLE PAIR against the active colour-scheme, which is
        // exactly the guarantee needed and exactly the thing this file cannot compute -- the
        // worker cannot read the theme (see CE_T's motion note for the same wall). A literal
        // would have been a guess about light-vs-dark that is wrong for half the users.
        // colorScheme IS DELIBERATELY NOT SET for that same reason: forcing 'dark' would
        // hardcode the guess back in. Unset, the popup follows the host page and stays
        // legible either way, which is the property that matters.
        // LIVE-UNCONFIRMED IN ONE RESPECT: some engines drop the selected-row highlight once
        // an option carries its own background. The closed control still shows the current
        // value, so the worst case is a menu that does not mark which row you are on -- an
        // annoyance where the reported bug was a menu you could not read at all.
        opts.push(h('option', {
            key: 'o' + oid, value: oid, selected: (oid === cur),
            style: { color: 'CanvasText', backgroundColor: 'Canvas' }
        }, olab));
    }
    var sel = h('select', {
        // [SELECT-DIRTY] KEYED ON THE CURRENT VALUE. A commit changes `cur`, which changes
        // the key, which remounts the element clean instead of patching a dirty one. p.k
        // scopes it so two selects on one surface never collide.
        key: 'sel:' + String(p.k) + ':' + cur,
        value: cur,
        onChange: function(e: any) {
            var v = (e && e.target && e.target.value != null) ? String(e.target.value) : '';
            if (v === cur) return;
            ceTap('sel:' + p.k, function() { ceAction('sel:' + p.k, function() { return p.onCommit(v); }); });
        },
        style: {
            minHeight: CE_T.tap, padding: CE_T.s2 + ' ' + CE_T.s3,
            flexShrink: '0', maxWidth: '100%',
            fontSize: CE_T.fs, color: 'inherit', background: 'transparent',
            border: '1px solid ' + CE_LINE, borderRadius: CE_T.r, cursor: 'pointer'
        }
    }, opts);
    // Bare control when unlabelled, so a call site can compose it into ceSettingRow's
    // control slot without a second heading fighting the row's own label.
    if (!p.label && !p.hint) return sel;
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        p.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.74' } }, p.label) : null,
        sel,
        p.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: '0.58' } }, p.hint) : null
    );
}



// -- Filtering ---------------------------------------------------------------
// EXTRACTED OUT OF _cePickerSurface so it is not the picker's private property: the Scene
// roster and the World Map both want a filter, and three copies of a matching rule is three
// places for it to drift.
//
// THE HOOK STAYS IN THE CALLER. ceFilterField is a plain function returning a ceField, not
// a component: it takes a setter the caller already owns. A component with its own useState
// could not tell the caller what the query IS, and a store would repaint every subscriber
// per keystroke.
//
// value:'' IS PERMANENT AND IS NOT A BUG. A field whose `value` prop never changes never
// sets wantRef, so FIELD-KEYLESS's re-seed path cannot reach into the element being typed
// in. Do NOT "fix" this to value:q.
//
// ceFilterMatch TESTS EVERY FIELD, not just the first. [PICKER-SPLIT] The jsx picker tested
// `label` alone for four versions while the deleted native one tested both, so filtering by
// a TYPE or by WHERE AN ITEM IS matched nothing though both were on the row.

// -- Filtering  [FILTER-KIT] ------------------------------------------
// EXTRACTED OUT OF _cePickerSurface SO IT IS NOT THE PICKER'S PRIVATE PROPERTY. The
// picker had the only search field in the file, and the Scene roster and the World Map
// both want one; three hand-rolled copies of a filter is three places for the matching
// rule to drift, which is the same argument that just cost the file its second picker.
//
// THE HOOK STAYS IN THE CALLER, DELIBERATELY. ceFilterField is a plain function returning
// a ceField, not a component: it takes the setter a caller already owns. A component with
// its own useState could not tell the caller what the query IS, and lifting the state into
// a store would repaint every subscriber on every keystroke -- the exact thing
// FIELD-SCRATCH forbids. useState repaints one component; that component is the list.
//
// value:'' IS PERMANENT AND IS NOT A BUG. A field whose `value` prop never changes never
// sets wantRef, so FIELD-KEYLESS's re-seed path never runs and a per-keystroke re-render
// cannot reach into the element being typed in. The query lives only in the caller's
// useState. Do NOT "fix" this to value:q.
function ceFilterField(k: string, placeholder: string, setQ: any): any {
    return h(ceField, {
        key: 'flt_' + String(k), k: 'flt:' + String(k), label: '',
        value: '', multiline: false,
        placeholder: String(placeholder || 'Filter\u2026'),
        onType: function(v: string) { setQ(String(v || '')); },
        onCommit: function(v: string) { setQ(String(v || '')); return Promise.resolve(); }
    });
}

// Normalised once by the caller, per render, rather than per candidate.
function ceFilterNeedle(q: any): string {
    return String(q || '').trim().toLowerCase();
}

// EVERY field is matched, not just the first. This is the bug the deleted native picker
// did not have: _cePickerSurface tested `label` alone, so filtering entityParent by a
// TYPE, or equipAdd by WHERE AN ITEM IS, silently matched nothing even though both are
// rendered right there on the row. A filter that ignores half of what it is showing you
// reads as broken data, not as a narrow filter.
function ceFilterMatch(needle: string, fields: any[]): boolean {
    if (!needle) return true;
    for (var i = 0; i < (fields || []).length; i++) {
        var f = String(fields[i] || '').toLowerCase();
        if (f && f.indexOf(needle) >= 0) return true;
    }
    return false;
}

// Below this many options a search field is noise, so it does not render. A def may
// override with its own `searchMin` (0 forces it always on). The hook that backs it is
// called unconditionally regardless -- only the rendering is conditional.
var CE_PICK_SEARCH_MIN = 10;

// The free-text draft. A MODULE VAR because a button reads it, and in this environment a
// click is delivered BEFORE the blur it causes (CLICK-BEFORE-BLUR) -- a commit-on-blur
// value would be one keystroke stale on the button's first press, every time.
var _cePickDraft = '';

// Cast options, shared by every picker whose referent is a person.
// INCLUDES THE PROTAGONIST as '__player__'. CharPosition's own interface comment names
// that id as a first-class legal target ("'__player__' for the protagonist"), and the chip
// list this replaces offered only the roster -- so a Position against the player, the
// model's most common case, was literally unreachable from the UI. That is a fix, not a
// feature: nothing downstream needed changing, the id was already the supported one.
function _cePickCast(src: any): any[] {
    var out: any[] = [];
    var cfg: any = (src && src.profile && src.profile.cfg) || null;
    out.push({ id: CE_PROTAGONIST_REF, label: String((cfg && cfg.protagonistName) || 'You'),
               sub: 'the protagonist' });
    var roster: any[] = (src && src.profile && src.profile.roster) || [];
    for (var i = 0; i < roster.length; i++) {
        if (!roster[i]) continue;
        out.push({ id: String(roster[i].id), label: String(roster[i].name || 'Unnamed'), sub: '' });
    }
    return out;
}

// Each def:
//   title            surface heading
//   hint             one line under it, or ''
//   freeLabel        heading of the "not in the list" block ('' suppresses it entirely)
//   freePlaceholder  its field placeholder
//   clearLabel       label of the "unset" row ('' suppresses it)
//   options(ctx,src) -> [{ id, label, sub }] evaluated at RENDER time
//   current(ctx,src) -> the currently-chosen OPTION ID, or '' for none/free text
//   commit(ctx,id,label) -> Promise. ONE commit, both halves. id is '' for free text.
//   group(o)         -> optional. A heading string an option is filed under. Options keep
//                       their own order; a heading appears the first time one of its
//                       members does, so a def controls grouping purely by how it emits.
//                       Returning '' files an option ungrouped, above the first heading.
//   searchMin        -> optional. Overrides CE_PICK_SEARCH_MIN for this def; 0 forces the
//                       filter on. A def whose list is short but whose LABELS are long
//                       (locations) wants a lower number than one over a fixed vocabulary.
var CE_PICKER_DEFS: { [k: string]: any } = {

    // A VOCABULARY REFERENCE, not an entity one: there is no species record anywhere, so
    // the id IS the label and there is nothing to denormalize. It is still a reference by
    // SS13's test -- the value names something the world already knows about -- and it is
    // one of the two standing check-5 violations the rule was written to close.
    species: {
        title: 'Species',
        hint: 'Drawn from what the cast already uses, so two characters of the same kind read as the same kind.',
        freeLabel: 'Something else',
        freePlaceholder: 'Name it\u2026',
        clearLabel: 'Leave unset',
        options: function(ctx: any, src: any): any[] {
            var list: any[] = (src && src.profile && src.profile.vocabSpecies) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                out.push({ id: String(list[i]), label: String(list[i]), sub: '' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            return String((p && p.species) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileWrite(String(ctx.charId || ''), 'species', label);
        }
    },

    // THE REFERENCE IMPLEMENTATION SS13 CITES, now actually written as one. The chip list
    // this replaces wrote targetId and targetName through TWO sequential ceProfileWrite
    // calls -- two load/apply/save/publish round trips -- so a failure between them left
    // an id with the wrong name beside it. ceProfileWritePair makes it one commit, which
    // is what SS13 asked for in the first place.
    positionTarget: {
        title: 'Positioned against',
        hint: 'One primary counterpart. Secondaries and factions are static lorebook facets, not positions \u2014 a second primary would mean two answers to the same question.',
        freeLabel: 'Someone not in the cast',
        freePlaceholder: 'Their name\u2026',
        clearLabel: 'No position',
        options: function(ctx: any, src: any): any[] { return _cePickCast(src); },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            var pos: any = (p && p.position) || {};
            return String(pos.targetId || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileWritePair(String(ctx.charId || ''), [
                { k: 'position.targetId', v: id },
                { k: 'position.targetName', v: label }
            ]);
        }
    },

    // [PROFILE-DOORS] NOT A REFERENCE FIELD -- the only entry in this table whose
    // value is an ORDINAL rather than the id of something the world knows about. It is
    // here anyway because the picker surface is the shape, not the semantics: a list of
    // mutually exclusive options, one current, commit-on-tap, no staged state. The
    // alternative was openDynamicRankPicker's UIPart modal opened from a jsx surface,
    // which JSXPROFILE-NO-OVERLAY forbids.
    //
    // ASSIGNMENT SWAPS, IT DOES NOT DISPLACE -- assignDynamicPriorityRank hands the
    // previous holder this character's old rank rather than unranking them. The `sub`
    // line names the holder for exactly that reason: the tap has a second consequence and
    // the author should be able to see whose before making it.
    dynamicRank: {
        title: 'Dynamic priority',
        hint: 'Under a dynamic cap, lower rank is processed first. One character per rank \u2014 taking a held rank swaps the two.',
        clearLabel: 'Unranked',
        options: function(ctx: any, src: any): any[] {
            var dr: any = (src && src.profile && src.profile.dynRank) || { rank: 0, max: 0, holders: {} };
            var self: string = String((src && src.profile && src.profile.p && src.profile.p.name) || '');
            var out: any[] = [];
            var max = Number(dr.max) || 0;
            for (var r = 1; r <= max; r++) {
                var holder = String((dr.holders || {})[String(r)] || '');
                out.push({ id: String(r), label: 'Rank ' + r,
                           sub: (holder && holder !== self) ? 'Held by ' + holder : '' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var dr: any = (src && src.profile && src.profile.dynRank) || null;
            var r = Number(dr && dr.rank) || 0;
            return r > 0 ? String(r) : '';
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            var cid = String(ctx.charId || '');
            var want = parseInt(String(id || ''), 10);
            return Promise.resolve(assignDynamicPriorityRank(cid, (isFinite(want) && want > 0) ? want : undefined))
                .then(function() { return cePublishProfile(cid); });
        }
    },

    // [HOOK-TARGETID] Now a FULL reference, id and all — UnresolvedHook gained
    // targetId in the same patch. `current` reads the id directly instead of the earlier
    // label match, so a target whose name was later edited elsewhere still reads as chosen.
    hookTarget: {
        title: 'Toward',
        hint: 'Who the tension is directed at.',
        freeLabel: 'Someone not in the cast',
        freePlaceholder: 'Their name\u2026',
        clearLabel: 'Leave unset',
        options: function(ctx: any, src: any): any[] { return _cePickCast(src); },
        current: function(ctx: any, src: any): string {
            var p: any = (src && src.profile && src.profile.p) || null;
            return String((p && p.hook && p.hook.targetId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileHookOp(String(ctx.charId || ''), 'target', { id: id, name: label });
        }
    },

    // [JSXENTITY] The world graph's three references. All read ceEntityStore's
    // published `index` (id/name/type, already resolved at publish time) rather than
    // calling loadEntityIndex from a render path -- options() is synchronous by contract.
    // SELF IS ALWAYS EXCLUDED: an entity nested under itself is the one input
    // ceMapWouldCycle exists to reject, and offering it is offering a mistake.
    // [LOC-PROFILE5] CHARACTERS AND FACTIONS IN ONE LIST, grouped by which they
    // are. Post-ENT-ID1 a character IS an entity at the character's own id, so the cast
    // comes out of the same world index the parent picker already reads -- no second
    // source and no id translation. Factions come from config, which is where they live.
    //
    // FREE TEXT IS SUPPRESSED. Every other reference picker offers "not in the list"
    // because a story can mention someone it has no record for; here the whole value of
    // the field is that the engine can REACH THE OWNER'S RECORD and hand it to the
    // generator. A free-text owner has no record to read, so it would be prose -- and prose
    // about ownership already has a home in the Control answer.
    entityOwner: {
        title: 'Owned by',
        hint: 'Whoever holds this place. Their record is read by every Generate button here, so a room in a captain\u2019s house or a capital of a kingdom is written knowing whose it is.',
        freeLabel: '',
        clearLabel: 'Nobody in particular',
        options: function(ctx: any, src: any): any[] {
            var out: any[] = [];
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            for (var i = 0; i < idx.length; i++) {
                if (!idx[i] || String(idx[i].type || '') !== 'character') continue;
                if (String(idx[i].id) === String(ctx.id)) continue;
                out.push({ id: String(idx[i].id), label: String(idx[i].name || 'Unnamed'),
                           sub: '', where: 'People' });
            }
            // [F-28] ONE SOURCE FOR BOTH GROUPS. This read the config for factions and the
            // index for people, which is exactly the two-table lookup that made ownerKind a
            // router; both are entity metas now and the same array answers for either.
            for (var j = 0; j < (idx || []).length; j++) {
                if (!idx[j] || String(idx[j].type || '') !== 'faction') continue;
                out.push({ id: String(idx[j].id), label: String(idx[j].name || 'Unnamed'),
                           sub: '', where: 'Factions' });
            }
            return out;
        },
        group: function(o: any): string { return String((o && o.where) || ''); },
        searchMin: 8,
        current: function(ctx: any, src: any): string {
            var e: any = (src && src.entity && src.entity.ent) || null;
            return String((e && e.ownerId) || '');
        },
        // The KIND is derived here rather than carried on the option, because the option
        // list is rebuilt every render and the commit is the only moment the answer is
        // needed. An id present in the entity index is a character; anything else is a
        // faction, which is also the right answer for the empty (cleared) case, where
        // ownerId is '' and kind is never read.
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            var kind = 'faction';
            var idx: any[] = [];
            try { var st: any = ceEntityStore ? ceEntityStore.get() : null; idx = (st && st.index) || []; }
            catch (e) { idx = []; }
            for (var i = 0; i < idx.length; i++) {
                if (idx[i] && String(idx[i].id) === String(id)) { kind = 'character'; break; }
            }
            var oid = String(id || '');
            return ceEntityWritePair(String(ctx.id || ''), [
                { k: 'ownerId', v: oid },
                { k: 'ownerKind', v: oid ? kind : '' }
            ]);
        }
    },

    // [ITEM-HOLD] entityEquip DELETED. It asked one question ("who is this on") and
    // wrote two facts, which is what made the equip state unreachable except by naming a
    // person and unsettable except by naming nobody. Its two halves are now the holder
    // picker (entityParent, below -- one def for every "where does this sit" question in
    // the file) and a switch. Its only call site was _ceEntityEquipped, deleted with it.

    entityParent: {
        title: 'Nest inside',
        hint: 'A child sits physically inside its parent. Entering a room moves the scene down the tree.',
        freeLabel: '',
        clearLabel: 'Top of the world',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var out: any[] = [];
            // Built ONCE, not per candidate: this runs on every render of the picker and
            // rebuilding the map inside the loop is O(n^2) over the whole world index.
            var byId: any = {};
            for (var k = 0; k < idx.length; k++) { byId[idx[k].id] = idx[k]; }
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id) continue;
                // A parent that is one of this node's own descendants would close a loop.
                // The map's guard is the authority on that question, so it is the one asked.
                if (ceMapWouldCycle(byId, String(ctx.id), String(idx[i].id))) continue;
                // [PICK-GROUP] `where` rides along for grouping. Resolved HERE, off
                // the byId map already built above, rather than in group() -- group() is
                // called once per surviving option per render and has no index in scope.
                var pm: any = idx[i].parentId ? byId[String(idx[i].parentId)] : null;
                out.push({ id: idx[i].id, label: idx[i].name, sub: idx[i].type,
                           where: pm ? String(pm.name || '') : '' });
            }
            return out;
        },
        // Grouped by CONTAINER, not by type: the question this picker asks is "where does
        // this sit", and the answer a world index gives is a tree. The type is still on the
        // row (and still searchable) -- it is what an option IS, not where it lives.
        group: function(o: any): string { return String((o && o.where) || ''); },
        searchMin: 8,
        current: function(ctx: any, src: any): string {
            var e: any = (src && src.entity && src.entity.ent) || null;
            return String((e && e.parentId) || '');
        },
        // [ITEM-HOLD] AN ITEM THAT CHANGES HANDS IS RELEASED FIRST. Equip state
        // names a PERSON (the item's equippedToCharId AND that person's equippedItemIds);
        // parentId names WHERE THE THING IS. Move a worn item to a new parent without
        // releasing it and the old holder's list still names it -- EQUIP-STATE-SYNC,
        // reached through the placement picker rather than through the equip verb.
        // Releasing is the honest default besides: a thing that has just changed hands is
        // not still being worn by whoever used to have it. Guarded on type so the branch
        // costs nothing for the locations and bodies this def mostly serves.
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            var entId = String(ctx.id || '');
            var next = String(id || '');
            var est: any = null;
            try { est = ceEntityStore ? ceEntityStore.get() : null; } catch (e) { est = null; }
            var cur: any = (est && est.ent && String(est.ent.id) === entId) ? est.ent : null;
            var release = !!(cur && String(cur.type || '') === 'item' && cur.isEquipped
                             && String(cur.equippedToCharId || '') !== next);
            var chain: Promise<any> = release ? ceEntitySetEquip(entId, false) : Promise.resolve();
            return chain.then(function() { return ceEntityWrite(entId, 'parentId', next); });
        }
    },

    // Narrative nesting is a SECOND, PARALLEL tree on the same records (plot inside plot),
    // which is why narrativeParentId exists beside parentId at all. Only narratives are
    // offered -- nesting a plot under a room would be a category error the graph has no
    // reader for.
    // [MILESTONE] THE MILESTONE'S TARGET, and it commits into the milestone document
    // rather than onto the record -- the one picker whose commit does not end in an
    // entityWrite. Any entity may be one: a place to reach, a person to find, a thing to
    // take. ctx.id is the THREAD, because that is what addresses the document.
    milestoneTarget: {
        title: 'Target',
        hint: 'What the next step is aimed at. If it is somewhere on the map, the scene block can say how far off it is.',
        freeLabel: '',
        clearLabel: 'Nothing in particular',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var out: any[] = [];
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id) continue;
                if (idx[i].type === 'narrative') continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: String(idx[i].type || '') });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var m: any = (src && src.entity && src.entity.ms) || null;
            return String((m && m.current && m.current.targetId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceMilestoneOp(String(ctx.id || ''), 'target', id);
        }
    },

    narrativeParent: {
        title: 'Part of',
        hint: 'Plots nest inside plots. This is separate from where the entity physically sits.',
        freeLabel: '',
        clearLabel: 'A root plot',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var out: any[] = [];
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id) continue;
                if (idx[i].type !== 'narrative') continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: '' });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            var e: any = (src && src.entity && src.entity.ent) || null;
            return String((e && e.narrativeParentId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceEntityWrite(String(ctx.id || ''), 'narrativeParentId', id);
        }
    },

    // [PHASE-F] The SECOND picker that adds rather than sets -- see
    // entityConnection below for the shape's own reasoning, which is identical here: an
    // inventory is a list, not a field, so there is no `current` and no clear row.
    // NO FREE TEXT, DELIBERATELY, and this is the one place SS13's "not in the list is not
    // optional" does not apply: a typed name here could only mean "make a new item", and
    // an item made from a bare string would be a record with nothing on it and no way
    // back to it. The drill's own "New item" button does that job properly -- it creates
    // AND LANDS ON the record, which is the whole premise of Phase E.
    equipAdd: {
        title: 'Add an item',
        hint: 'Moves an existing item into this character\u2019s hands. Anything currently worn by someone else is taken off them first.',
        freeLabel: '',
        clearLabel: '',
        options: function(ctx: any, src: any): any[] {
            var eq: any = (src && src.profile && src.profile.equip) || null;
            var list: any[] = (eq && eq.candidates) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                out.push({ id: list[i].id, label: list[i].name,
                           sub: list[i].where ? ('in ' + list[i].where) : 'loose in the world' });
            }
            return out;
        },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceProfileEquipAdd(String(ctx.charId || ''), id);
        }
    },

    // THE ONE PICKER THAT ADDS RATHER THAN SETS, and so the one with no `current` selection
    // and no clear row: routes are a list, not a field. Targets already routed to are
    // filtered out, which is what makes a second tap on the same place impossible rather
    // than merely idempotent.
    entityConnection: {
        title: 'Route to',
        hint: 'Somewhere the parent/child tree does not already reach \u2014 a road, a door, a teleporter.',
        freeLabel: '',
        clearLabel: '',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.entity && src.entity.index) || [];
            var conns: any[] = (src && src.entity && src.entity.conns) || [];
            var taken: any = {};
            for (var c = 0; c < conns.length; c++) { taken[conns[c].targetId] = 1; }
            var out: any[] = [];
            for (var i = 0; i < idx.length; i++) {
                if (idx[i].id === ctx.id || taken[idx[i].id]) continue;
                out.push({ id: idx[i].id, label: idx[i].name, sub: idx[i].type });
            }
            return out;
        },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceEntityConnOp(String(ctx.id || ''), 'add', id, 'Go to ' + label);
        }
    },

    // [CHAR-PLACE] WHERE A CHARACTER STANDS. Until now the only doors to this were
    // the Scene surface's two verbs -- into the camera's room, or out to nowhere -- so
    // putting someone in a specific place they were not already in was unreachable from any
    // surface. Commits through ceProfileSetLocation, which moves the BODY; nothing here
    // writes a location onto the character record, because no such field exists.
    // NO FREE TEXT, on the equipAdd precedent and for the same reason: a typed name could
    // only mean "make a new place", and a place made from a bare string is a record with
    // nothing on it. The Map's "New place" button does that job properly.
    charLocation: {
        title: 'Where they are',
        hint: 'Moves their body. Whether they are in the scene follows from this \u2014 anyone standing where the camera is, is present.',
        freeLabel: '',
        clearLabel: 'Nowhere \u2014 out of the world',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var pl: any = (src && src.profile && src.profile.places) || null;
            var list: any[] = (pl && pl.list) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                out.push({ id: String(list[i].id), label: String(list[i].name || 'Unnamed'),
                           sub: list[i].where ? ('in ' + list[i].where) : 'top of the world',
                           where: String(list[i].where || '') });
            }
            return out;
        },
        group: function(o: any): string { return String((o && o.where) || ''); },
        current: function(ctx: any, src: any): string {
            return String((src && src.profile && src.profile.places && src.profile.places.locId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceProfileSetLocation(String(ctx.charId || ''), String(id || ''));
        }
    },

    // [SELECT-LENGTH] OUR FACTION. WAS a ceSelect and is now a picker, on the report that its
    // explanation was being crushed beside it and that the control itself carried a sentence.
    // BOTH COMPLAINTS HAD ONE CAUSE: a <select>'s intrinsic width is set by its LONGEST
    // OPTION, and the longest option was the explanatory 'Nobody -- we have no side'. That
    // pushed the row's only flexible cell to nothing (CE-STYLE 8c) and put a sentence inside
    // a control at the same time. SS13's own test settles which primitive this is: 22
    // factions is an OPEN list read off records, not a closed vocabulary, so it was never a
    // ceSelect's job -- and the picker brings filtering, grouping and a full-width surface.
    // 'NOBODY' IS clearLabel, NOT AN OPTION. The picker has a dedicated affordance for the
    // real answer "none of these", which is exactly what this is; as an option it had to
    // explain itself, and as the clear row it does not.
    // OPTIONS RIDE IN ctx, NOT IN A STORE. _cePickerSurface would otherwise need a SIXTH
    // unconditional store init, and PANEL-PICK-BLANK is the record of what that list costs
    // when one line of it goes missing. The opener already has the rows in hand.
    ourFaction: {
        title: 'Our faction',
        hint: 'Which side the protagonist answers to. A Move can then be framed as this faction against another.',
        freeLabel: '',
        clearLabel: 'Nobody \u2014 we have no side',
        searchMin: 8,
        options: function(ctx: any): any[] {
            var rws: any[] = (ctx && ctx.rows) || [];
            var out: any[] = [];
            for (var i = 0; i < rws.length; i++) {
                if (!rws[i]) continue;
                out.push({ id: String(rws[i].id), label: String(rws[i].name || 'Unnamed'),
                           sub: String(rws[i].standing || '') });
            }
            return out;
        },
        current: function(ctx: any): string { return String((ctx && ctx.ourId) || ''); },
        commit: function(ctx: any, id: string): Promise<any> {
            return ceSettingsOp(function() {
                return mutConfig(function(c: any) {
                    var fid = String(id || '');
                    if (fid) (c as any).protagonistFactionId = fid;
                    else if ((c as any).protagonistFactionId !== undefined) delete (c as any).protagonistFactionId;
                });
            }).then(cePublishDiplo);
        }
    },

    // [F-3] WHO ROLLS. Options ride in ctx for the reason ourFaction's do -- the Actions
    // panel mounts OUTSIDE the shell (PANEL-PICK), so its picker uses the panel-local slot
    // and must not depend on a store _cePickerSurface would have to init unconditionally.
    // NO clearLabel: there is no "nobody rolls". The protagonist is the default and is a real
    // row in the list, not an absence.
    actionActor: {
        title: 'Who is rolling',
        hint: 'The protagonist, or anyone following the camera who is in this scene. Stakes are charged to whoever acts.',
        freeLabel: '', clearLabel: '', searchMin: 99,
        options: function(ctx: any): any[] {
            var ps: any[] = (ctx && ctx.party) || [];
            var out: any[] = [];
            for (var i = 0; i < ps.length; i++) {
                out.push({ id: String(ps[i].id), label: String(ps[i].label || ''),
                           sub: (String(ps[i].id) === String((ctx && ctx.protagId) || '')) ? 'the protagonist' : 'following' });
            }
            return out;
        },
        current: function(ctx: any): string { return String((ctx && ctx.actorId) || ''); },
        commit: function(ctx: any, id: string): Promise<any> {
            return ceActorSet(String(id || '')).then(function() { return cePublishActions(); });
        }
    },

    // [SEC:SCHED] WHERE A STOP IS. A picker rather than free text, on charLocation's rule
    // and for CE-STYLE 13's reason: a location is REFERENTIAL, and a typed name here could
    // only mean "make a new one", which is a record with nothing on it.
    // IT COMMITS DIRECTLY rather than handing an id back, because ctx already carries
    // everything the write needs -- the character, the plan, and which row. moveWhat's
    // hand-off shape exists because its SECOND picker's options depend on the first answer;
    // nothing here depends on the answer, so a hand-off would be ceremony.
    // THE ROW IS FOUND BY (fromHour, locationId), never by index. Rows sort on read, so an
    // index captured at render time points at a different row the moment an hour changes.
    schedStop: {
        title: 'Where they are',
        hint: 'Where this stop puts them. They stay here until the next stop starts.',
        freeLabel: '',
        clearLabel: 'Nowhere \u2014 off the timetable',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var pl: any = (src && src.profile && src.profile.places) || null;
            var lst: any[] = (pl && pl.list) || [];
            var out: any[] = [];
            for (var i = 0; i < lst.length; i++) {
                out.push({ id: String(lst[i].id), label: String(lst[i].name || 'Unnamed'),
                           sub: lst[i].where ? ('in ' + lst[i].where) : 'top of the world',
                           where: String(lst[i].where || '') });
            }
            return out;
        },
        group: function(o: any): string { return String((o && o.where) || ''); },
        current: function(ctx: any): string { return String((ctx && ctx.locationId) || ''); },
        commit: function(ctx: any, id: string): Promise<any> {
            var cFrom = _ceHourSafe(ctx.fromHour);
            var cLoc = String(ctx.locationId || '');
            // [ATMO] 'char' IS NOT A DEFAULT HERE, IT IS THE TYPE OF THIS PICKER. A stop's
            // location is a character question; a location's timetable renders no place row
            // at all, so this def is unreachable from loc mode and hard-codes the owner
            // rather than carrying a mode through a picker context that has no use for it.
            return _ceSchedMut('char', String(ctx.charId || ''), function(s: any) {
                var pl = ceSchedPlanById(s, String(ctx.planId || ''));
                if (!pl) return;
                for (var q = 0; q < pl.rows.length; q++) {
                    if (pl.rows[q].fromHour === cFrom && String(pl.rows[q].locationId) === cLoc) {
                        pl.rows[q].locationId = String(id || ''); return;
                    }
                }
            });
        }
    },

    // ── The Actions panel's own four  [F-15e][F-15d] ────────────────────────────────
    // ALL FOUR READ ceActionsStore AND NOTHING ELSE. options() is synchronous by contract,
    // so every list they offer is built by cePublishActions and published ahead of them.
    // They cannot read ceEntityStore the way entityParent does: that index is populated by
    // cePublishEntity, which only runs when somebody opens an entity in the shell -- and
    // from a scriptPanel sitting below the editor, that may be never.

    // [F-15e] THE FIRST HALF OF MOVE. TWO PICKERS RATHER THAN ONE, because the destination
    // list DEPENDS on what was chosen: a character goes to a place, an item goes to a place
    // or into a pair of hands. One flat list of everything-to-everywhere is the surface that
    // makes you read every row to find the two that are legal.
    //
    // WHAT SHARES THE PROTAGONIST'S ROOM COMES FIRST, AND IT IS A GROUP, NOT A SORT. The
    // surface buckets on first sight (see _cePickerSurface's PICK-GROUP note), so emitting
    // the co-located ones first IS the implementation. That ordering is the feature -- the
    // thing you are about to move is nearly always the thing standing next to you.
    //
    // NO FREE TEXT, on the equipAdd and charLocation precedent and for their reason: a typed
    // name here could only mean "make a new one", and a record made from a bare string is a
    // record with nothing on it. The Map and the Entity surface both do that job properly.
    moveWhat: {
        title: 'Move something',
        hint: 'A character or an item. Whatever is here with you is listed first.',
        freeLabel: '',
        clearLabel: '',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var st: any = (src && src.actions) || null;
            var list: any[] = (st && st.movables) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                if (!list[i]) continue;
                out.push({ id: String(list[i].id), label: String(list[i].name || 'Unnamed'),
                           sub: String(list[i].sub || ''),
                           where: String(list[i].group || '') });
            }
            return out;
        },
        group: function(o: any): string { return String((o && o.where) || ''); },
        current: function(): string { return ''; },
        // COMMITS NOTHING AND WRITES NOTHING -- it hands the choice to the second picker.
        // THAT IS WHY THE PANEL'S CLOSE IS KEYED TO A KIND: _cePickerSurface closes after
        // every commit resolves, so an unkeyed close would shut the very picker this just
        // opened. See ceActionsPickClose.
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            var kind = 'char';
            var st: any = null;
            try { st = ceActionsStore ? ceActionsStore.get() : null; } catch (e) { st = null; }
            var list: any[] = (st && st.movables) || [];
            for (var i = 0; i < list.length; i++) {
                if (list[i] && String(list[i].id) === String(id)) kind = String(list[i].kind || 'char');
            }
            ceActionsPickOpen('moveWhere', { id: String(id), name: String(label), kind: kind });
            return Promise.resolve();
        }
    },

    // [F-15e] THE SECOND HALF. The list is what the SUBJECT can legally be inside: a
    // character stands in a place; an item sits in a place OR in a pair of hands. Per
    // author, an item gets both -- dropping a thing on the floor is the commonest move
    // there is, and a people-only destination would route every drop through the Map.
    // The People block simply is not emitted for a character, so the same def answers both
    // questions without a second entry in this table.
    moveWhere: {
        title: 'Move it where',
        hint: 'Somewhere it can be. An item can also go straight into somebody\u2019s hands.',
        freeLabel: '',
        clearLabel: '',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var st: any = (src && src.actions) || null;
            var out: any[] = [];
            var i = 0;
            var places: any[] = (st && st.places) || [];
            for (i = 0; i < places.length; i++) {
                if (!places[i]) continue;
                out.push({ id: String(places[i].id), label: String(places[i].name || 'Unnamed'),
                           sub: String(places[i].where ? ('in ' + places[i].where) : 'top of the world'),
                           where: 'Places' });
            }
            if (String(ctx.kind || '') === 'item') {
                var people: any[] = (st && st.people) || [];
                for (i = 0; i < people.length; i++) {
                    if (!people[i]) continue;
                    // The thing cannot be handed to itself, and an item's holder is a
                    // person, so the only self-match possible here is the no-op one.
                    if (String(people[i].id) === String(ctx.id)) continue;
                    out.push({ id: String(people[i].id), label: String(people[i].name || 'Unnamed'),
                               sub: String(people[i].where || ''), where: 'People' });
                }
            }
            return out;
        },
        group: function(o: any): string { return String((o && o.where) || ''); },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceActionMoveApply(String(ctx.kind || 'char'), String(ctx.id || ''),
                                     String(ctx.name || ''), String(id), String(label));
        }
    },

    // [F-15d] LOADING A SAVED ACTION. A picker rather than a ceSelect even though most authors
    // will have four of these: SS13's test is whether the list is a closed self-describing
    // vocabulary or an open one, and presets are as open as a list gets -- one story played
    // for a month has thirty. The filter is what makes that survivable.
    actionPreset: {
        title: 'Load a saved action',
        hint: 'Fills the approach, resolution, stake and attempt. Your target and anything you are spending are left alone \u2014 they belong to this turn, not to the preset.',
        freeLabel: '',
        clearLabel: '',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var st: any = (src && src.actions) || null;
            var list: any[] = (st && st.presets) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                if (!list[i]) continue;
                out.push({ id: String(list[i].id), label: String(list[i].name || 'Unnamed'),
                           sub: String(list[i].sub || '') });
            }
            return out;
        },
        // NO `current`. A preset is not a field with a value -- it is applied and then the
        // arm is the author's own again, free to diverge on the next keystroke. Showing one
        // as "selected" would claim a link that stops being true immediately.
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceActionPresetApply(String(id));
        }
    },

    // [F-15d] DELETION, AND THE SURFACE IS THE CONFIRMATION. Everywhere else in the file a
    // destructive verb gets a two-tap confirm row, because it sits on a list you were
    // browsing for some other reason and one stray tap would take something away. This is
    // the other shape: you cannot arrive here except by pressing a control that says
    // "Forget a saved action", the heading and hint say it again, and Cancel is on screen the
    // whole time. A confirm row inside it would be a third statement of the same fact.
    actionPresetForget: {
        title: 'Forget a saved action',
        hint: 'Tapping one deletes it. This cannot be undone \u2014 but it only forgets the preset, never the action you already made with it.',
        freeLabel: '',
        clearLabel: '',
        searchMin: 8,
        options: function(ctx: any, src: any): any[] {
            var st: any = (src && src.actions) || null;
            var list: any[] = (st && st.presets) || [];
            var out: any[] = [];
            for (var i = 0; i < list.length; i++) {
                if (!list[i]) continue;
                out.push({ id: String(list[i].id), label: String(list[i].name || 'Unnamed'),
                           sub: String(list[i].sub || '') });
            }
            return out;
        },
        current: function(): string { return ''; },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            if (!id) return Promise.resolve();
            return ceActionPresetDelete(String(id), String(label));
        }
    },

    // [PICKER-ONE] THE LAST REFERENCE FIELD THAT WAS NOT A PICKER. Text-as picked a
    // CHARACTER OUT OF THE CAST through a ceSelect -- a value that names something the world
    // already knows about, chosen from a dropdown, which is SS13's rule broken in the one
    // place a filter helps most: a phone's contacts list is exactly the list you scroll.
    // ceSelect stays correct for the fixed enums it was built for (ratios, avatar shapes,
    // condition stages); the test is whether the option list is a VOCABULARY or a CAST.
    //
    // READS ceChatStore, which is why _cePickerSurface subscribes to it -- see the
    // unconditional-subscription note there. The two sentinels are not characters and are
    // rendered as what they are: '' is the clear row, CC_POV_INTERVIEW is a pinned first
    // option with its own sub-line.
    // [CC-MODES] The kind of conversation. A VOCABULARY, not a cast -- four fixed
    // options built FROM CC_MODES so a fifth mode is one edit in one place and this picker
    // can never offer an id the prompt builders do not know. Interview is filtered out: it
    // is chosen on the POV row, and two rows that can both set it would disagree.
    chatMode: {
        title: 'Kind of conversation',
        hint: 'What this is: a text thread, people talking in person, a scene played one turn at a time, or an interview. It sets the register, the length and how the model is asked to write.',
        freeLabel: '',
        clearLabel: '',
        options: function(ctx: any, src: any): any[] {
            var out: any[] = [];
            var k: string;
            for (k in CC_MODES) {
                if (!Object.prototype.hasOwnProperty.call(CC_MODES, k)) continue;
                if (k === 'interview') continue;
                out.push({ id: k, label: CC_MODES[k].label, sub: CC_MODES[k].channel });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            return String((src && src.chat && src.chat.mode) || 'text');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceChatSetMode(String(id || 'text'));
        }
    },

    chatPov: {
        title: 'Talk as',
        hint: 'Whose phone this is. The contact list filters this person out of itself \u2014 you cannot text as and to the same person.',
        freeLabel: '',
        clearLabel: 'No POV \u2014 text as yourself',
        options: function(ctx: any, src: any): any[] {
            var out: any[] = [{ id: CC_POV_INTERVIEW, label: 'Interview', sub: 'out of story' }];
            var roster: any[] = (src && src.chat && src.chat.roster) || [];
            for (var i = 0; i < roster.length; i++) {
                if (!roster[i]) continue;
                out.push({ id: String(roster[i].id), label: String(roster[i].name || 'Unnamed'),
                           sub: String(roster[i].role || '') });
            }
            return out;
        },
        current: function(ctx: any, src: any): string {
            return String((src && src.chat && src.chat.povId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return ceChatSetPov(String(id || ''));
        }
    },

    // [JSXWIZARD] The intro tab's opening-location choice. Reads the WIZARD
    // store's index, not the Entity surface's: this picker opens with no entity loaded, so
    // ceEntityStore.index is empty every time it matters. Commit writes tempStorage rather
    // than a record because the choice is staging state for a generation, not world data --
    // the same tier the native branch used.
    wizIntroLoc: {
        title: 'Opening location',
        hint: 'Where the first scene happens. The draft is written from this place.',
        freeLabel: '',
        clearLabel: 'No location yet',
        options: function(ctx: any, src: any): any[] {
            var idx: any[] = (src && src.wiz && src.wiz.entIndex) || [];
            var byId: any = {};
            var k = 0;
            for (k = 0; k < idx.length; k++) { byId[idx[k].id] = idx[k]; }
            var out: any[] = [];
            var i = 0;
            for (i = 0; i < idx.length; i++) {
                if (idx[i].type !== 'location') continue;
                var par: any = idx[i].parentId ? byId[idx[i].parentId] : null;
                out.push({ id: idx[i].id, label: idx[i].name,
                           sub: par ? ('in ' + par.name) : 'top of the world',
                           where: par ? String(par.name || '') : '' });
            }
            return out;
        },
        // [PICK-GROUP] The heading now carries the containment, so the sub-line
        // stops repeating it for every row under the same parent. Both stay: `sub` is what
        // the filter matches on, and a filtered list has no headings in view.
        group: function(o: any): string { return String((o && o.where) || ''); },
        searchMin: 8,
        current: function(ctx: any, src: any): string {
            return String((src && src.wiz && src.wiz.introLocId) || '');
        },
        commit: function(ctx: any, id: string, label: string): Promise<any> {
            return Promise.resolve(api.v1.tempStorage.set(STORAGE_WIZ_INTRO_LOC, String(id || '')))
                .catch(function(e: any) { api.v1.error('[AE:jsxwizard] intro loc write failed:', e); })
                .then(cePublishWiz);
        }
    }
};

function cePickerOpen(kind: string, ctx: any): void {
    if (!CE_PICKER_DEFS[kind]) {
        api.v1.error('[AE:jsxpick] unknown picker kind: ' + String(kind));
        return;
    }
    ceUiPatch(function() { return { picker: { kind: String(kind), ctx: ctx || {} } }; });
}

function cePickerClose(): void {
    ceUiPatch(function() { return { picker: null }; });
}

// [PHOTO-VIEW] Opens the full-screen viewer for one image slot. No `kind`
// registry the way pickers have one -- there is exactly one thing to view (an anchored
// image), not a family of referential fields, so a table would describe nothing a
// parameter does not already say.
// [v3.0.54 PHOTO-PROV] `opts` carries what the OPENER already knows -- the seed this
// slot was last rendered with and the character's standing avatarSeed -- so the viewer needs
// no store of its own for them. canPin is a separate flag rather than being inferred from
// `pinned`, because the Use-for-all verb writes CharacterRecord.avatarSeed and an entity id
// in the charId position (which the image layer accepts everywhere else) has no such field.
function cePhotoOpen(charId: string, slot: string, label: string, opts?: any): void {
    var pChar = String(charId || ''); var pSlot = String(slot || '');
    var o: any = opts || {};
    ceUiPatch(function() { return { photo: { charId: pChar, slot: pSlot,
                                            label: String(label || slot || 'Image'),
                                            seed: Number(o.seed) || 0, pinned: Number(o.pinned) || 0,
                                            canPin: !!o.canPin, metaReady: false, meta: null } }; });
    // THE BYTES KNOW BETTER THAN THE RECORD. The slot's stored seed is what the engine
    // ASKED for at dispatch; the portrait record is what was actually rendered, and it is
    // also the only source for anything generated before IMG-SEED-DROP was fixed. Asked
    // here rather than at generate time because it is one round trip per full-screen open
    // and nothing else on this surface needs it.
    if (!isBridgeReady) {
        ceUiPatch(function(s: any) {
            var ph = (s && s.photo) || null;
            if (!ph) return {};
            var nb: any = {}; var kb: string;
            for (kb in ph) { nb[kb] = ph[kb]; }
            nb.metaReady = true;
            return { photo: nb };
        });
        return;
    }
    broadcastToTM('AE_CHAR_IMAGE_ACTION', { charId: pChar, slot: pSlot, op: 'meta' })
        .catch(function(eM: any) { api.v1.error('[AE:photo] meta request failed:', eM); });
}

// [v3.0.54 PHOTO-PROV] The bridge's answer. IGNORED WHEN IT IS FOR A DIFFERENT PICTURE
// than the one now open -- same rule ceImgEditReceive follows, and the same failure it
// prevents: two quick opens would otherwise let the first answer land on the second image.
function cePhotoMetaReceive(payload: any): void {
    var mChar = String((payload && payload.charId) || '');
    var mSlot = String((payload && payload.slot) || '');
    if (!mChar) return;
    ceUiPatch(function(s: any) {
        var ph = (s && s.photo) || null;
        if (!ph || String(ph.charId || '') !== mChar || String(ph.slot || '') !== mSlot) return {};
        var next: any = {}; var k: string;
        for (k in ph) { next[k] = ph[k]; }
        next.metaReady = true;
        next.meta = (payload && payload.found) ? {
            fp: String(payload.fp || ''), fu: String(payload.fu || ''),
            settings: (payload && payload.settings) || {},
            source: String(payload.source || ''), createdAt: Number(payload.createdAt) || 0
        } : null;
        return { photo: next };
    });
}

function cePhotoClose(): void {
    ceUiPatch(function() { return { photo: null }; });
}

// -- Slot options  [SLOT-OPTIONS-JSX] --------------------------------
// THE STATE BEHIND THE INLINE GENERATOR STRIP. The renderer is _ceGenBtn; these five
// verbs are the whole surface area (Open / Close / Patch / Run / Commit).
//
// IT CALLS generateSlotOptions DIRECTLY, no message round trip. The bridge only ever
// reached that function by posting AE_GEN_SLOT_OPTIONS and waiting for EVT_SLOT_OPTIONS
// back; the engine is where it lives, so this just calls it.
//
// _ceGenSpec RESOLVES instructions + the DEFAULT budget, the same way the
// AE_GEN_SLOT_OPTIONS handler does, and the call site passes what it resolved. From there
// the author can change the budget on the strip; the resolution policy itself stays in
// one place.
//
// METHOD IS NO LONGER 'auto'. It defaults to 'direct' and is a control on the strip. See
// ceSlotOptsRun for why 'auto' had to go: it resolved against a tempStorage run counter
// that resets on every story load, so the free-yoink branch won nearly every time and
// forced wantCount to 1 no matter what the author asked for.
var _ceSlotOptsHint = '';   // CLICK-BEFORE-BLUR: draft steer text is a module var, never store state

// [ENTGEN] `scope` is 'char' (default, every pre-existing call site) or 'entity'.
// It selects WHICH RECORD IS READ for context and WHICH RECORD IS WRITTEN on commit --
// nothing else. Deliberately a field on this record rather than a second parallel store:
// only one generator is open at a time by design ("One open at a time, keyed by (charId,
// fieldKey)" -- ceUiStore's own note), and two stores would mean two ways for two to be
// open at once.
//
// `useStory` is the recent-story-context toggle, and it applies to CHARACTERS TOO. It has
// always been a parameter of generateSlotOptions and this path has always hardcoded it
// false, so the capability existed with no control -- the same shape as a capability
// without a door, one layer down.
// [MS-GEN] The one slot a thread generates into, so a constant rather than a field id --
// nothing addresses a second one and a computed key would suggest otherwise.
var CE_MS_FIELDKEY = 'milestone';

// [MS-GEN] The axis, as prose the generator splices into its own "must differ in kind"
// sentence. NAMED SHAPES OF BEAT rather than degrees of one beat: a complication, a chance,
// something learned, something forced. Three candidates off this are three different next
// scenes; three off an escalation axis are one next scene at three volumes.
var CE_MS_DIVERGE = 'Each candidate must be a DIFFERENT KIND OF NEXT BEAT \u2014 for example one where something goes wrong, one where an opportunity opens, one where something is discovered, one where somebody forces the issue, one where a cost comes due. Do not offer the same event at different intensities.';

var CE_MS_INSTRUCTIONS = 'Write the next milestone for this story thread: the single most immediate objective or challenge, as one thing that should happen next. One or two sentences, under 35 words. It must be OBSERVABLE \u2014 something a scene could show landing \u2014 and it must be reachable from where the story stands now rather than from where the thread ends. Present tense, concrete, naming who or what is involved. Follow the author\u2019s steer above closely. Do not resolve the thread, do not summarise what the thread is about, do not describe the protagonist\u2019s feelings, and do not write more than one objective.';

// The three above are DECLARED HERE rather than beside _ceThreadGenShim, which is where
// they were first written: ceSlotOptsRun reads CE_MS_DIVERGE and the milestone strip reads
// the other two, and `var` hoists a declaration without its assignment. Function
// declarations do not have this problem, which is why the shim itself may stay below.
function ceSlotOptsOpen(charId: string, fieldKey: string, label: string,
                        instructions: string, budget: number, scope?: string): void {
    _ceSlotOptsHint = '';
    ceUiPatch(function() {
        return { slotOpts: {
            charId: String(charId || ''), fieldKey: String(fieldKey || ''),
            // [MS-GEN] THREE NAMED SCOPES, resolved once. It read `=== 'entity' ? ... : 'char'`,
            // which silently turned any new scope into 'char' -- a milestone generation would
            // have gone looking for a CharacterRecord under a thread id and written the
            // result into a character profile.
            // [EVT-MIRROR] A FOURTH NAMED SCOPE. Enumerated rather than defaulted, for the
            // reason the third one's note gives: an unlisted scope silently becomes 'char'
            // and goes looking for a CharacterRecord under a shape id.
            scope: (String(scope || '') === 'entity' || String(scope || '') === 'milestone'
                    || String(scope || '') === 'event')
                   ? String(scope) : 'char',
            // [EVT-MIRROR] STORY CONTEXT IS ON FOR AN ENCOUNTER AND OFF FOR EVERYTHING
            // ELSE. Every other scope generates from a RECORD -- a profile, a thread's five
            // questions -- and the recent prose is at best background. An encounter is
            // about what is in the room at this moment, and the prose is where that is
            // written down.
            useStory: (String(scope || '') === 'event'),
            label: String(label || fieldKey || 'Field'),
            instructions: String(instructions || ''), budget: Number(budget) || 150,
            // [GEN-INLINE] method DEFAULTS TO 'direct', not 'auto'. See
            // ceSlotOptsRun's note: 'auto' silently collapsed the count to 1 while free
            // yoink runs remained, so the count select was decorative most of the time.
            count: 3, method: 'direct', status: 'idle', options: [], note: ''
        } };
    });
}

// TRUE when the strip belongs to THIS field. Reads the store directly rather than taking
// a parameter, the same hook-free shape _ceGuideOpen uses and for the same reason: the
// Root that renders it subscribes, so a patch repaints and this is re-invoked.
function _ceSlotOptsFor(charId: string, fieldKey: string): any {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; }
    catch (e) { st = null; }
    if (!st) return null;
    if (String(st.charId) !== String(charId) || String(st.fieldKey) !== String(fieldKey)) return null;
    return st;
}

function ceSlotOptsClose(): void {
    _ceSlotOptsHint = '';
    ceUiPatch(function() { return { slotOpts: null }; });
}

function ceSlotOptsPatch(partial: any): void {
    ceUiPatch(function(u: any) {
        var cur: any = (u && u.slotOpts) || null;
        if (!cur) return {};
        var next: any = {}; var k: string;
        for (k in cur) { next[k] = cur[k]; }
        for (k in (partial || {})) { next[k] = partial[k]; }
        return { slotOpts: next };
    });
}

// Laziness fails toward stability: a failed or empty generation leaves the field alone and
// says so. Nothing here writes the character record -- only ceSlotOptsCommit does.
async function ceSlotOptsRun(): Promise<void> {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; } catch (e) { st = null; }
    if (!st || !st.charId) return;
    ceSlotOptsPatch({ status: 'running', note: '', options: [] });
    try {
        // [ENTGEN] The entity path builds a SHIM in the shape generateSlotOptions
        // reads, rather than getting a generator of its own. That function only ever
        // touches four things on the record it is handed -- name, briefDescription,
        // conceptDump, and buildFieldGenContext(record, label) -- so a shim carrying those
        // four reuses the entire generator: prompt construction, the one-vs-many fork, the
        // separator parse, the busy-retry loop, the yoink/direct branch and the candidate
        // cards. A parallel generateEntityOptions would have been a second copy of all of
        // it, drifting from the first the moment either was tuned.
        //
        // buildFieldGenContext is fed an EMPTY customFieldValues and no static fields, so
        // it returns effectively nothing and the entity's own material arrives through
        // conceptDump instead -- which is exactly what that field is for, and which the
        // prompt already describes to the model as "reference notes (extract only what is
        // directly relevant)". An entity has no six-slot model to summarise, so there is
        // no structured context to lose here.
        // [MS-GEN] A THIRD SCOPE, NOT A THIRD GENERATOR. The entity shim's argument holds
        // exactly here: generateSlotOptions only ever reads name, briefDescription,
        // conceptDump and buildFieldGenContext off what it is handed, so a milestone shim
        // buys the whole strip -- steer, count, draw method, candidate cards, the parse and
        // the retry loop. `charId` carries the THREAD id; `fieldKey` is the constant
        // CE_MS_FIELDKEY, since a thread has exactly one slot to generate into.
        // [EVT-MIRROR] A FOURTH SHIM ON THE SAME ARGUMENT. `charId` carries the SHAPE id
        // here, which is the one scope where it is not a record id at all -- and the shim
        // is a separate function rather than _ceThreadGenShim with a fallback because that
        // one returns null without a narrative entity, and having no thread is the ordinary
        // way an encounter starts.
        var soScope = String(st.scope || 'char');
        var c: any = (soScope === 'entity')
            ? await _ceEntityGenShim(String(st.charId), String(st.fieldKey))
            : ((soScope === 'milestone')
                ? await _ceThreadGenShim(String(st.charId))
                : ((soScope === 'event')
                    ? await _ceEventGenShim(String(st.charId))
                    : await loadCharacter(st.charId)));
        if (!c) {
            ceSlotOptsPatch({ status: 'error',
                note: (soScope === 'char') ? 'Character not found.'
                    : ((soScope === 'event') ? 'That shape is gone.' : 'That record is gone.') });
            return;
        }
        var cfg: any = await loadConfig();
        // [GEN-INLINE] METHOD IS THE AUTHOR'S, NOT 'auto'. Passing 'auto' let
        // generateSlotOptions resolve to a single-candidate yoink draw whenever free runs
        // remained (AE_YOINK_RUN_MAX, a tempStorage counter that resets on every story
        // load) -- so asking for three candidates produced one, nearly every time, and the
        // count select apologised for itself in its own hint. The knob is now on the
        // strip: 'direct' is a metered call that honours the count, 'yoink' is a free draw
        // and is ALWAYS one candidate (three separate draws cannot see each other, so
        // asking one call for three differing answers is incoherent there).
        var soMethod = (String(st.method || 'direct') === 'yoink') ? 'yoink' : 'direct';
        var out: any = await generateSlotOptions(
            c, String(st.label || ''), String(st.instructions || ''),
            (cfg && cfg.generalStyle) || '', _ceSlotOptsHint || '',
            Number(st.budget) || 150, Number(st.count) || 3,
            // [MS-GEN] THE AXIS IS THE KIND OF BEAT, NOT ITS SIZE, per user: \"the user
            // wants different ideas, not variations of the same idea.\" An escalation axis
            // returns one next scene at three volumes, which is variations wearing the
            // costume of choices. Empty for every other scope -- their fields have no
            // natural axis and the generator's own default framing is right there.
            (soScope === 'milestone') ? CE_MS_DIVERGE
                                      : ((soScope === 'event') ? CE_EV_DIVERGE : ''),
            { includeStory: !!st.useStory, method: soMethod,
              // A LOOSER DRAW FOR THIS ONE SLOT. The whole point of asking is that the
              // author does not already know what happens next, so converging on the
              // likeliest continuation is the failure mode rather than the goal.
              // [EVT-MIRROR] THE SAME LOOSE DRAW, FOR THE SAME REASON. An author who
              // already knew what was about to happen would have typed it.
              temperature: (soScope === 'milestone' || soScope === 'event') ? 1.05 : undefined }
        );
        if (!out || !out.length) {
            ceSlotOptsPatch({ status: 'error', note: 'Came back empty \u2014 try again, or lower the count.' });
            return;
        }
        ceSlotOptsPatch({ status: 'done', options: out, note: '' });
    } catch (e) {
        var msg = String((e as any) && ((e as any).message || e) || '');
        // Same classification the AE_GEN_SLOT_OPTIONS handler makes: a concurrency refusal
        // is not a retry-harder failure and needs different advice.
        var busy = msg.indexOf('already in progress') >= 0;
        api.v1.error('[AE:jsxprofile] slot options failed:', e);
        ceSlotOptsPatch({ status: 'error',
            note: busy ? 'Another generation is running \u2014 wait for it to finish.'
                       : ('Generation error. ' + msg) });
    }
}

async function ceSlotOptsCommit(text: string): Promise<void> {
    var st: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; st = (u && u.slotOpts) || null; } catch (e) { st = null; }
    if (!st || !st.charId || !st.fieldKey) return;
    // [MS-GEN] The milestone lives in its own document, so it commits through its own
    // verb. ceMilestoneOp republishes, exactly as ceEntityWrite does for the branch below.
    if (String(st.scope || '') === 'milestone') {
        await ceMilestoneOp(String(st.charId), 'set', String(text || ''));
        ceSlotOptsClose();
        return;
    }
    // [EVT-MIRROR] THE ONE SCOPE THAT COMMITS TO A DRAFT RATHER THAN A DOCUMENT. The
    // encounter does not exist yet -- there is nothing to `set` -- so the chosen line lands
    // in the panel's own start form and the author still has to press Begin. That is not a
    // missing step: choosing a candidate and starting an encounter are two decisions, and a
    // generator that started one would be F-19's tool that has begun driving.
    if (String(st.scope || '') === 'event') {
        _ceActionsEvDraft({ evDraft: String(text || '') });
        ceSlotOptsClose();
        return;
    }
    if (String(st.scope || 'char') === 'entity') {
        // ceEntityWrite, not ceProfileWrite: different storage, different chain
        // (ceEntityOp), and different publish. The republish is ceEntityWrite's own job,
        // so there is nothing extra to do here.
        await ceEntityWrite(String(st.charId), String(st.fieldKey), String(text || ''));
        ceSlotOptsClose();
        return;
    }
    await ceProfileWrite(st.charId, String(st.fieldKey), String(text || ''));
    ceSlotOptsClose();
}

// [EVT-MIRROR] THE ENCOUNTER SLOT, and the fourth scope. `charId` carries the SHAPE id
// rather than a record id -- the shape is the only thing this generation has to go on when
// the story is thin, and it is also what keys the strip, so two shapes cannot share one
// open picker.
//   THERE IS NO RECORD BEHIND IT YET. Every other scope generates INTO something that
//   exists; this one generates the line an encounter will be STARTED from, so the commit
//   target is the panel's own draft field and not a document.
var CE_EV_FIELDKEY = 'encounter';

// [EVT-MIRROR] THE AXIS IS WHO OR WHAT IS CONTENDING, NOT HOW BADLY. The milestone axis is
// the KIND of beat because a thread can turn any direction; a shape has already fixed the
// kind -- an Infiltration candidate is an infiltration in all three -- so varying intensity
// here would return one situation at three volumes, which is MS-GEN's own failure mode
// wearing a different costume.
var CE_EV_DIVERGE = 'Each candidate must put a DIFFERENT SORT OF OPPOSITION in the way \u2014 for example one where it is a named person acting on their own reasons, one where it is a group, a body or a crowd, and one where it is circumstance with nobody to blame. Do not offer the same opposition at different intensities.';

// [EVT-MIRROR] SHORTER THAN A MILESTONE'S, and deliberately. A milestone says what should
// happen next; this says what IS happening, right now, as the thing everyone in the room is
// already inside of. The shape supplies the grading, so nothing here should describe how it
// will go.
var CE_EV_INSTRUCTIONS = 'Write the one line that starts this encounter: what is happening, right now, in the room. One sentence, under 25 words. Name who or what is contending and what they want. Present tense, concrete, and already underway \u2014 not a thing that is about to begin. Follow the author\u2019s steer above closely. Do not describe how it turns out, do not grade its difficulty, do not name odds, and do not write more than one sentence.';

// [EVT-MIRROR] WHAT A GENERATION HAS TO GO ON WHEN THERE IS NO THREAD, and the reason this
// is not _ceThreadGenShim with a fallback. That shim starts by loading a narrative entity
// and returns null without one, which is the COMMON case here -- most encounters are begun
// loose, from the panel, in a scene the author is already in.
//   THE SHAPE IS THE STEER AND IT COSTS NOTHING TO PASS. Its name and its band ladder are
//   already written, already read by a model every turn, and cannot drift from what the
//   encounter will actually do -- which is why no genHint field was added beside them.
//   THE THREAD IS FOLDED IN WHEN THERE IS ONE, and skipped in silence when there is not.
async function _ceEventGenShim(shapeDefId: string): Promise<any> {
    var cfgEv: any = null;
    try { cfgEv = await loadConfig(); } catch (e) { cfgEv = null; }
    var defEv: any = ceStateDef(cfgEv, String(shapeDefId || ''));
    if (!defEv || String(defEv.scope || '') !== 'event') return null;

    var notesEv: string[] = [];
    function addEv(label: string, v: any): void {
        var s = String(v || '').trim();
        if (!s) return;
        notesEv.push(label + ': ' + (s.length > 600 ? s.slice(0, 600) + '\u2026' : s));
    }

    // THE LADDER, WORST TO BEST, AS ONE LINE. This is the whole description of what an
    // encounter of this kind IS, written for a model to read, and it is the same text the
    // Author's Note will quote back once one is running.
    var bandsEv: any[] = (defEv.bands && defEv.bands.length) ? defEv.bands : [];
    var ladderEv: string[] = [];
    for (var bi = 0; bi < bandsEv.length; bi++) {
        var bl = String((bandsEv[bi] && bandsEv[bi].label) || '').trim();
        if (bl) ladderEv.push(bl);
    }
    if (ladderEv.length) addEv('How an encounter of this kind reads at each step, worst to best',
                               ladderEv.join(' | '));

    // WHERE AND WHO. The camera line and the people actually in the room -- an encounter is
    // about what is in front of the protagonist, which is the one thing a thread's own
    // logic cannot supply.
    try {
        var whereEv = await getCurrentLocationPromptLine();
        if (whereEv) addEv('Where the story stands', whereEv);
    } catch (eW) { /* non-fatal */ }
    try {
        var idxEv: any[] = await loadIndex();
        var castEv: string[] = [];
        for (var ci = 0; ci < (idxEv || []).length; ci++) {
            var mEv: any = idxEv[ci];
            if (!mEv || !mEv.scenePresent) continue;
            castEv.push(String(mEv.name || 'Unnamed')
                + (mEv.briefDescription ? (': ' + _ceTrim(String(mEv.briefDescription), 140)) : ''));
        }
        if (castEv.length) addEv('Who is in the scene', castEv.join('\n'));
    } catch (eC) { /* non-fatal */ }

    // THE THREAD, IF THERE IS ONE. Its description and its standing milestone, so an
    // encounter begun while an arc is running is about that arc. ABSENT IS NOT AN ERROR --
    // it is the ordinary case, and it is exactly what reusing the thread shim got wrong.
    try {
        var tidEv = await loadActiveThread();
        if (tidEv) {
            var entEv: any = await loadEntity(tidEv);
            if (entEv && String(entEv.type || '') === 'narrative') {
                addEv('The thread this is happening inside', entEv.description || entEv.name);
                var docEv: any = await loadMilestones(String(tidEv));
                var curEv = String((docEv && docEv.current && docEv.current.text) || '').trim();
                if (curEv) addEv('What the thread is pushing toward', curEv);
            }
        }
    } catch (eT) { /* non-fatal: a loose encounter is the common case */ }

    return {
        id: String(defEv.id),
        name: String(defEv.name || 'Encounter'),
        briefDescription: 'An encounter of this kind: ' + String(defEv.name || ''),
        conceptDump: notesEv.join('\n'),
        // Present and EMPTY, exactly as the entity and thread shims leave them:
        // buildFieldGenContext walks both and an absent value throws there.
        customFieldValues: {},
        nicknames: [],
        hook: null
    };
}

// [MS-GEN] The same four things the entity shim assembles, from a thread. THE CURRENT// [MS-GEN] The same four things the entity shim assembles, from a thread. THE CURRENT
// MILESTONE IS EXCLUDED for the reason the entity shim excludes its target field: hand a
// regenerate its own previous answer as reference and it converges on it.
//   THE RESOLVED ARCHIVE IS THE MOST VALUABLE INPUT HERE and is what the whole separate
//   storage key exists to serve -- it is what this thread has already done, which is the
//   only way to ask for something that has not happened yet.
async function _ceThreadGenShim(threadId: string): Promise<any> {
    var ent: any = null;
    try { ent = await loadEntity(threadId); } catch (e) { ent = null; }
    if (!ent || String(ent.type || '') !== 'narrative') return null;

    var notes: string[] = [];
    function addMs(label: string, v: any): void {
        var s = String(v || '').trim();
        if (!s) return;
        notes.push(label + ': ' + (s.length > 600 ? s.slice(0, 600) + '\u2026' : s));
    }

    var kindMs: any = ceNarrativeKind(String(ent.narrativeKind || ''));
    addMs('Kind of thread', String(kindMs.label || '') + ' \u2014 ' + String(kindMs.blurb || ''));
    addMs('What it is', ent.description);

    // The five lenses, through the same resolver the profile column renders from, so a
    // steered label here is the label the author is looking at.
    var cfgMs: any = null;
    try { cfgMs = await loadConfig(); } catch (eC) { cfgMs = null; }
    var cfvMs: any = ent.customFieldValues || {};
    var defsMs: any[] = ceEntityOrderedDefs(ent, cfgMs);
    for (var di = 0; di < defsMs.length; di++) { addMs(defsMs[di].label, cfvMs[defsMs[di].id]); }

    // WHERE THE THREAD HAS ALREADY BEEN, newest first, capped. The whole log would crowd
    // out the lenses on a long thread, and the recent beats are the ones the next one has
    // to follow from.
    var msDocG: any = null;
    try { msDocG = await loadMilestones(threadId); } catch (eM) { msDocG = null; }
    var arcG: any[] = (msDocG && msDocG.archive) || [];
    if (arcG.length) {
        var doneLines: string[] = [];
        for (var ai = 0; ai < arcG.length && ai < 6; ai++) {
            var at = String(arcG[ai].text || '').trim();
            if (at) doneLines.push(at);
        }
        if (doneLines.length) addMs('Already resolved in this thread, most recent first', doneLines.join(' | '));
    }

    // [MS-GEN] THE AUTHOR'S CHOSEN CONTEXT RECORDS. Brief lines only -- a name and a
    // description each -- for the same reason the entity shim uses ancestor identity lines:
    // the point is that the generator can SEE the cast and the places without paying for
    // their full entries.
    var ctxIds: string[] = (ent as any).contextIds || [];
    if (ctxIds.length) {
        var ctxLines: string[] = [];
        for (var ci = 0; ci < ctxIds.length; ci++) {
            var rid = String(ctxIds[ci]);
            var got = false;
            try {
                var ch: any = await loadCharacter(rid);
                if (ch) {
                    ctxLines.push(String(ch.name || 'Unnamed') + ': ' + _ceTrim(String(ch.briefDescription || ''), 160));
                    got = true;
                }
            } catch (eCh) { got = false; }
            if (got) continue;
            try {
                var ce2: any = await loadEntity(rid);
                if (ce2) ctxLines.push(String(ce2.name || 'Unnamed') + ': ' + _ceTrim(String(ce2.description || ''), 160));
            } catch (eE) { /* a record the author selected and then deleted \u2014 skip it */ }
        }
        if (ctxLines.length) addMs('People, places and things this thread involves', ctxLines.join('\n'));
    }

    // WHERE THE STORY IS RIGHT NOW. Without it the generator proposes a next step from the
    // thread's own logic and ignores that the protagonist is three rooms away from it.
    try {
        var whereNow = await getCurrentLocationPromptLine();
        if (whereNow) addMs('Where the story stands', whereNow);
    } catch (eW) { /* non-fatal \u2014 a milestone without the camera is worse, not broken */ }

    return {
        id: String(ent.id || threadId),
        name: String(ent.name || 'This thread'),
        briefDescription: 'A story thread: ' + String(ent.description || ent.name || '').trim(),
        conceptDump: notes.join('\n'),
        // Present and EMPTY on purpose, exactly as the entity shim leaves them:
        // buildFieldGenContext walks both and absent values throw there.
        customFieldValues: {},
        nicknames: [],
        hook: null
    };
}

// [ENTGEN] The four things generateSlotOptions reads, assembled from an entity.
// `excludeField` is the field being written: its current text is kept OUT of the notes, or
// a regenerate would be handed its own previous answer as reference and converge on it.
async function _ceEntityGenShim(id: string, excludeField: string): Promise<any> {
    var ent: any = null;
    try { ent = await loadEntity(id); } catch (e) { ent = null; }
    if (!ent) return null;

    var kindWord = String(ent.locationType || ent.type || 'location');
    var where = '';
    try {
        if (ent.parentId) {
            var par: any = await loadEntity(String(ent.parentId));
            if (par && par.name) where = String(par.name);
        }
    } catch (eP) { where = ''; }

    var notes: string[] = [];
    function add(label: string, v: any): void {
        var s = String(v || '').trim();
        if (!s) return;
        notes.push(label + ': ' + (s.length > 600 ? s.slice(0, 600) + '\u2026' : s));
    }

    // [LOC-PROFILE] THE ANCESTOR CHAIN GOES IN FIRST AND IS THE FRAME, NOT THE
    // SUBJECT. Identity lines only -- short by construction -- so generating a room can
    // see its tavern, its district and its city without paying for their full entries.
    // This is the whole reason nested generation beats generating places in isolation.
    try {
        var chain: string[] = await ceEntityAncestorLines(ent);
        if (chain.length) add('Where this sits', chain.join(' '));
    } catch (eA) { /* non-fatal — generation without the frame is worse, not broken */ }

    if (excludeField !== 'description')   add('Description', ent.description);
    if (excludeField !== 'lorebookText')  add('Lorebook entry', ent.lorebookText);
    add('Visual tags', ent.locationVisuals);
    if (where) add('Located inside', where);
    // [LOC-PROFILE] Every WRITTEN facet except the one being generated. Excluding
    // the target is the same rule the two record fields above already follow: hand a
    // regenerate its own previous answer as reference and it converges on it.
    var cfvG: any = ent.customFieldValues || {};
    var cfgG: any = null;
    try { cfgG = await loadConfig(); } catch (eG) { cfgG = null; }
    var defsG: any[] = ceEntityOrderedDefs(ent, cfgG);
    for (var fi = 0; fi < defsG.length; fi++) {
        var fdG = defsG[fi];
        if (excludeField === ('cfv:' + fdG.id)) continue;
        add(fdG.label, cfvG[fdG.id]);
    }
    // [LOC-PROFILE5] The owner by NAME, resolved from the index and config
    // the shim already loaded. The Control generator is the obvious consumer, but every
    // field benefits: who holds a place changes what it offers and what it costs.
    try {
        var ownBrief = await ceOwnerContext(ent, cfgG);
        if (ownBrief) add('Held by', ownBrief);
    } catch (eO) { /* non-fatal — a generation without the owner is worse, not broken */ }
    // [ADVENTURE-RELIC] `atmosphere` IS NO LONGER FED TO THE GENERATOR. It is the
    // remains of the state-switching mechanism, not authored lore, and feeding a relic
    // into every generation taught the model to write more of it.
    var keys: string[] = ent.lorebookTags || [];
    if (keys.length) add('Trigger keys', keys.join(', '));

    return {
        id: String(ent.id || id),
        name: String(ent.name || 'Unnamed'),
        briefDescription: 'A ' + kindWord + (where ? (' in ' + where) : '') + '.',
        // [LOC-PROFILE4] THE AUTHOR'S OWN NOTES GO FIRST, ahead of the derived
        // ones. Same contract as a character's conceptDump: not injected into the story,
        // read by every generator, and the place raw material goes before it is a field
        // answer. The generator prompt already frames this whole block as "reference notes
        // (extract only what is directly relevant)", so the two mix without a second header.
        conceptDump: (String(ent.conceptDump || '').trim()
                        ? (String(ent.conceptDump).trim() + '\n') : '') + notes.join('\n'),
        // Present and EMPTY on purpose. buildFieldGenContext walks both; absent values
        // would throw there, and non-empty ones would inject a character's structure onto
        // something that has none.
        customFieldValues: {},
        nicknames: [],
        hook: null
    };
}

// [ENTGEN] BROAD ON PURPOSE, per user: "locations can be so many things and people
// could have such different expectations... items can literally be anything." A tight
// instruction is right for a character slot, where the question is genuinely the same
// every time; it is wrong here, where a location may be a room, a city, a ship or a state
// of mind. So each of these names the JOB and the LENGTH, refuses the two or three
// failure modes that are universal, and otherwise leans on the author's steer -- which is
// the field directly above the Generate button and the thing that actually knows.
//
// The four entries are not symmetric, because the two record fields do not do the same
// work for the two kinds:
//   LOCATION description  -- currently injects NOWHERE. It is an author's working note and
//                            a seed for the lorebook entry, and is written as such rather
//                            than pretending to be prose the model will read.
//   LOCATION lorebookText -- the one that actually reaches the story, on a key match.
//   ITEM description      -- THE HIGH-VALUE ONE. This is the text that folds into a
//                            character's own lorebook entry while the item is equipped, so
//                            it is read in the second person of that character's entry and
//                            must be short, present-tense and free of standalone framing.
//   ITEM lorebookText     -- the item's own entry, for when it is talked about rather than
//                            carried.
// Keyed '<type>:<field>'. A type with no entry simply renders no Generate button, which is
// the honest default for a kind nobody has written a prompt for yet.
var CE_ENTITY_GEN_DEFS: { [k: string]: any } = {
    'location:description': {
        label: 'Description', budget: 60,
        guide: 'The one-line gazetteer entry \u2014 what this place IS. It feeds the World lorebook entry and every generator below. What the place is LIKE right now is Atmosphere, not this.',
        instructions: 'Write ONE sentence naming what this place is and the single thing that distinguishes it. Under 25 words. A gazetteer line, not a scene: it is read in a list beside every other place in the world, so it must survive being skimmed. Concrete and specific to THIS place rather than to its category \u2014 a detail that would be wrong for any other tavern, any other throne room. Do NOT describe light, sound, weather, mood, or who is currently there \u2014 that is the Atmosphere field, and stating it here would put the same fact in context twice. Follow the author\u2019s steer above closely; it outranks any assumption about genre or scale. Avoid opening with \u201cnestled\u201d or \u201csteeped in,\u201d and do not describe the player arriving.'
    },
    'location:lorebookText': {
        label: 'Lorebook entry', budget: 220,
        guide: 'This is what reaches the story when the name or a key appears. Facts, not atmosphere.',
        instructions: 'Write the lorebook entry for this place: what a narrator needs to KNOW about it that is not already obvious from the description. Who controls it, what happens there, what the rules are, what it is known for, who to expect. Three to five sentences, under 130 words. Standing facts in present tense, not a scene and not a story. Follow the author\u2019s steer above closely; it outranks any assumption about genre or scale. Avoid restating the physical description, avoid inventing a named ruler or faction unless the steer or notes give you one, and avoid prophecy, ancient evil and anything the story has not earned.'
    },
    'item:description': {
        label: 'Description', budget: 110,
        guide: 'Folded into the carrier\u2019s own lorebook entry while equipped \u2014 so it is read as part of THEIR entry, not as its own.',
        instructions: 'Describe this item as it appears while someone is carrying or wearing it. One to three sentences, under 60 words. Present tense, physical and immediate: what it looks like, how it sits on them, what it does when used. THIS TEXT IS FOLDED INTO THE CARRIER\u2019S LOREBOOK ENTRY, so do not name the item as a heading, do not open with \u201cThis is a\u2026\u201d, and do not refer to a specific owner by name. Follow the author\u2019s steer above closely; it outranks any assumption about genre or power level. Avoid glowing runes, unspecified ancient power, and stating a rarity tier.'
    },
    'narrative:description': {
        label: 'Description', budget: 60,
        guide: 'The one-line answer to \u201cwhat is this thread?\u201d \u2014 it feeds every generator below and is what you read in a list of threads.',
        instructions: 'Write ONE sentence naming what this story thread is and what is at stake in it. Under 25 words. It is read in a list beside every other thread, so it must survive being skimmed. Name the concrete situation rather than the theme. Follow the author\u2019s steer above closely; it outranks any assumption about genre. Do not open with \u201cA story about\u2026\u201d, do not state how it ends, and do not describe the protagonist\u2019s feelings about it.'
    },
    'narrative:lorebookText': {
        label: 'Lorebook entry', budget: 200,
        guide: 'What reaches the story when this thread\u2019s name or a key appears. The five questions compile beneath it, so write only what they do not cover.',
        instructions: 'Write the standing background this thread needs the narrator to know: the history behind it, who is already involved, and what is common knowledge about it. Two to four sentences, under 120 words. Present tense, standing facts, not a scene and not a plan. THE FIVE QUESTIONS BELOW THIS FIELD ARE COMPILED INTO THE SAME ENTRY, so do not restate the pressure, the objective, the opposition, the cost or the consequence. Follow the author\u2019s steer above closely. Avoid prophecy and anything the story has not earned.'
    },
    'item:lorebookText': {
        label: 'Lorebook entry', budget: 180,
        guide: 'The item\u2019s own entry \u2014 injected when it is talked about, whether or not anyone is holding it.',
        instructions: 'Write the lorebook entry for this item: where it came from, who wants it, what it costs to use, what is known and what is rumoured. Two to four sentences, under 110 words. Standing facts in present tense. Follow the author\u2019s steer above closely; it outranks any assumption about genre or power level. Avoid restating the physical description, avoid inventing a named maker or civilisation unless the steer or notes give you one, and avoid making it the key to anything.'
    }
};

// [LOC-PROFILE] 'cfv:<facetId>' resolves against the record's own facet catalog
// instead of the table above. One resolver, two sources: the table answers for the two
// record fields, the catalog answers for every facet, and the call-site wrapper below
// cannot tell the difference. A facet with no instructions would return null and render
// no button, the same honest default a kind with no prompt already gets.
// UNSTEERED, and the difference is invisible today: this branch has no caller
// ([NARR-KIND] steers through ceEntityOrderedDefs, which is what the profile column's own
// Generate buttons read). If a caller appears, steer it there.
function _ceEntityGenDef(type: string, field: string): any {
    var f = String(field || '');
    if (f.indexOf('cfv:') === 0) {
        var fd: any = ceEntityFacetById(String(type || ''), f.slice(4));
        if (!fd) return null;
        return { label: fd.label, budget: fd.budget || 100,
                 guide: 'Compiles into this place\u2019s lorebook entry under \u201c' + fd.label + '\u201d.',
                 instructions: fd.instructions };
    }
    return CE_ENTITY_GEN_DEFS[String(type || '') + ':' + f] || null;
}

// The call-site wrapper. Returns null when no prompt is defined for this (type, field),
// so a character entity simply shows no button rather than an inert one.
//
// [GUIDE-BODY] THE '?' SHOWS THE INSTRUCTION, not only the placement line. Every
// other Generate button in the file reveals the literal text the model is sent
// (_ceSlotCard, _ceFacetField, the hook fields), and this one revealed a one-sentence
// summary of where the field lands -- a different question from the one a glyph beside a
// Generate button is read as asking. Both, guide first, because where the answer lands is
// the context the instruction is read in. Blank line between them; see _ceGuide's pre-wrap.
function _ceEntGenBtn(id: string, ent: any, field: string): any {
    var def: any = _ceEntityGenDef(String(ent && ent.type || ''), field);
    if (!def) return null;
    var gd = String(def.guide || '');
    var inst = String(def.instructions || '');
    var help = gd ? (inst ? (gd + '\n\n' + inst) : gd) : inst;
    return _ceGenBtn(null, id, field, String(def.label || field),
                     inst, Number(def.budget) || 150, help, 'entity');
}

// THE CALL-SITE HALF, and the reason SS12 check 5 becomes auditable rather than a
// judgement call: a referential field renders THIS, never a ceField, so the two shapes are
// distinguishable by grep and by eye. HOOK-FREE BY CONTRACT, same as ceSelect -- it is
// rendered inside the hooks loop and inside CE_IDENTITY_FIELDS' loop, so adding a hook
// here is a breaking change, not a refactor.
function cePickerRow(opts: any): any {
    var def: any = CE_PICKER_DEFS[opts.kind] || null;
    var shown = String(opts.value || '');
    var title = String(opts.label || (def && def.title) || 'Choose');
    return h('div', { style: { display: 'flex', flexDirection: 'column', gap: CE_T.s1 } },
        opts.label ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, opts.label) : null,
        h('div', {
            onClick: function() {
                ceTap('pick:open:' + String(opts.kind), function() {
                    // [PANEL-PICK] `open` NAMES WHICH SLOT THIS ROW WRITES INTO, and it is
                    // the whole of what makes one row primitive serve two hosts. The shell
                    // owns ceUiStore.picker; the Actions scriptPanel owns a slot on its own
                    // store, because ceRoot -- the only thing that renders the shell's slot
                    // -- may never have been mounted below the editor. Omitting it keeps
                    // every existing call site byte-identical in behaviour.
                    if (opts.open) { opts.open(String(opts.kind), opts.ctx || {}); return; }
                    cePickerOpen(String(opts.kind), opts.ctx || {});
                });
            },
            role: 'button', tabIndex: 0,
            // SS11: the row states what it is AND what is in it, because the chevron alone
            // means nothing to anything that is not looking at it.
            'aria-label': title + ': ' + (shown || 'not set') + '. Choose.',
            style: {
                display: 'flex', alignItems: 'center', gap: CE_T.s2,
                minHeight: CE_T.tap, padding: CE_T.s2 + ' ' + CE_T.s3, cursor: 'pointer',
                // Same two-part editable-ground treatment ceField's default path carries
                // (STYLE2-E): a CE_FILL ground says "this is a surface you act on".
                background: CE_FILL, borderRadius: CE_T.r,
                border: '1px solid ' + CE_LINE, fontSize: CE_T.fs
            }
        },
            h('div', { style: { flex: '1 1 auto', minWidth: '0',
                                opacity: shown ? CE_OP.t1 : CE_OP.t3 } },
              shown || String(opts.placeholder || 'Choose\u2026')),
            h('div', { style: { flex: '0 0 auto', opacity: CE_OP.t3, fontSize: CE_T.fsSm } }, '\u203a')
        ),
        opts.hint ? h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                                        lineHeight: CE_T.lhProse } }, opts.hint) : null
    );
}

// A REAL COMPONENT, mounted via h() from ceRoot -- it holds four hooks of its own, and the
// same reasoning _ceProfileImagesDrill's header sets out applies: hooks belong in their own
// scope, never folded into a caller's sequence by a bare function call.
function _cePickerSurface(props: any): any {
    // Straight-line and idempotent, so it adds no hook and cannot shift the sequence below
    // it -- same construction _ceProfileImagesDrill uses for ceImgSlotStoreInit.
    ceProfileStoreInit();
    // [JSXENTITY] A def reading a store adds ONE unconditional subscription here.
    // Over-subscription is cheap in this component specifically -- the picker is a full
    // surface swap, so nothing else is mounted while it is up -- but it must stay
    // unconditional or the hook sequence shifts between kinds.
    ceEntityStoreInit();
    // [JSXWIZARD] Third store, same unconditional-subscription rule as the note
    // above: wizIntroLoc reads the entity index the WIZARD published, not the one the
    // Entity surface publishes, because the intro picker is reachable with no entity open.
    ceWizStoreInit();
    // [PICKER-ONE] Fourth store, for chatPov. Same rule again: UNCONDITIONAL, or the
    // hook sequence shifts between kinds. Over-subscription stays cheap here for the reason
    // the earlier note gives -- the picker is a full surface swap, so while it is up
    // nothing else is mounted to be repainted.
    ceChatStoreInit();
    // [PANEL-PICK] Fifth store, for the move and preset defs. Same unconditional rule as
    // the four above -- and the init call is also what makes this component mountable from
    // the Actions scriptPanel, where ceOpenShell has never run (PANEL-SUBSTRATE).
    //
    // [PANEL-PICK-BLANK] THE LINE ABOVE THIS ONE WAS DELETED BY ACCIDENT IN 3.0.82 AND THE
    // WHOLE SURFACE WENT BLANK. Recorded rather than quietly restored, because the failure
    // MODE is the lesson and it will recur: these five inits look like defensive
    // boilerplate, so losing one looks like tidying. It is not -- ceStoresInit creates
    // ceUiStore and NOTHING ELSE, so outside ceOpenShell every other store here is null
    // until its own init runs, useStoreValue(null) throws, and a throw during render
    // produces an EMPTY SURFACE rather than an error anyone sees. No rows, no hint, and no
    // Cancel button, which is why it read as "a menu you cannot back out of" rather than as
    // a crash. Any future store added here carries the same rule and the same blast radius.
    ceActionsStoreInit();
    var ui: any = useStoreValue(ceUiStore);
    var prof: any = useStoreValue(ceProfileStore);
    var entSrc: any = useStoreValue(ceEntityStore);
    var wizSrc: any = useStoreValue(ceWizStore);
    var chatSrc: any = useStoreValue(ceChatStore);
    var actSrc: any = useStoreValue(ceActionsStore);
    var qS: any = useState(''); var q = String(qS[0] || ''); var setQ = qS[1];
    var dS: any = useState(''); var setDraft = dS[1];
    // The free-text draft is read by a BUTTON, so it cannot live in the state the button
    // renders from -- CLICK-BEFORE-BLUR. It is a module var written by onType, exactly as
    // STUDIO-DRAFTS does. setDraft exists only to force the repaint that reveals the
    // commit button once something has been typed.
    var draft = String(_cePickDraft || '');

    // [PANEL-PICK] `local` MAKES props WIN OVER THE SHELL SLOT, and it has to be a flag
    // rather than a fallback: reading ceUiStore.picker first would let a picker left open
    // in the shell modal render itself inside the Actions panel instead of the one the
    // panel actually asked for. A local host passes its own kind, ctx and onClose.
    var pk: any = props.local ? null : ((ui && ui.picker) || null);
    var kind = String((pk && pk.kind) || props.kind || '');
    var ctx: any = (pk && pk.ctx) || props.ctx || {};
    var def: any = CE_PICKER_DEFS[kind];
    // AFTER every hook, never before: an early return that skips a hook is the one thing
    // this environment's own header calls fatal.
    if (!def) return null;

    var src: any = { profile: prof, entity: entSrc, wiz: wizSrc, chat: chatSrc, actions: actSrc };
    var all: any[] = [];
    try { all = def.options(ctx, src) || []; }
    catch (e) { api.v1.error('[AE:jsxpick] options failed:', e); all = []; }
    var cur = '';
    try { cur = String(def.current(ctx, src) || ''); }
    catch (e2) { api.v1.error('[AE:jsxpick] current failed:', e2); }

    // [PANEL-PICK] ONE CLOSE, WHICHEVER SLOT HOLDS THE PICK. A host that owns its own slot
    // passes onClose; everything else gets the shell's, unchanged.
    function pkClose() {
        if (props.onClose) { props.onClose(); return; }
        cePickerClose();
    }

    function choose(id: string, label: string) {
        ceAction('pick:' + kind, function() {
            return Promise.resolve(def.commit(ctx, String(id || ''), String(label || '')))
                .then(function() { _cePickDraft = ''; pkClose(); });
        });
    }

    // [FILTER-KIT] Matches label AND sub, via the kit helper -- see ceFilterMatch
    // for why matching the label alone was a real bug rather than a narrow filter.
    // [PICK-GROUP] Grouping is BUCKET-ON-FIRST-SIGHT, not a sort: the def's own
    // emission order is preserved inside every bucket AND between buckets, so a def that
    // already emits in a meaningful order (the world index is depth-first) does not have
    // that order destroyed by being grouped. A heading whose every member was filtered out
    // never renders, because the bucket is only created when something lands in it.
    var needle = ceFilterNeedle(q);
    var grouped = !!(def.group);
    var gOrder: string[] = [];
    var gRows: any = {};
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) {
        var o: any = all[i];
        var lab = String((o && o.label) || '');
        if (!lab) continue;
        if (!ceFilterMatch(needle, [lab, String((o && o.sub) || '')])) continue;
        var gName = '';
        if (grouped) {
            try { gName = String(def.group(o) || ''); } catch (eG) { gName = ''; }
        }
        var bucket: any[];
        if (!grouped || !gName) { bucket = rows; }
        else {
            if (!gRows[gName]) { gRows[gName] = []; gOrder.push(gName); }
            bucket = gRows[gName];
        }
        bucket.push((function(oo: any, ll: string) {
            var on = (String(oo.id) === cur) && !!cur;
            return ceListRow({
                // The check is the ONLY selection signal that survives a colour-blind
                // reading (SS11: state is never colour alone). The ground reinforces it.
                lead: h('div', { style: { width: '17px', height: '17px', flex: '0 0 auto',
                                          display: 'flex', alignItems: 'center',
                                          opacity: on ? CE_OP.t1 : CE_OP.t3 } },
                        on ? ceIconCheck() : null),
                label: ll,
                sub: String(oo.sub || ''),
                onClick: function() { choose(String(oo.id), ll); }
            });
        })(o, lab));
    }

    // Ungrouped rows first (they are the ones the def filed under no heading), then each
    // heading with its own. ceKey is the heading primitive every other list in the file
    // uses for this, so a grouped picker reads as the same kind of list as a grouped
    // profile group rather than as a picker-specific invention.
    var shown = rows.length;
    if (grouped && gOrder.length) {
        for (i = 0; i < gOrder.length; i++) {
            var gn = gOrder[i];
            shown += gRows[gn].length;
            rows.push(h('div', { key: 'pkg_' + gn, style: {
                paddingTop: CE_T.s3, paddingBottom: CE_T.s1
            } }, ceKey(gn)));
            rows.push(h('div', { key: 'pkgr_' + gn, style: {
                display: 'flex', flexDirection: 'column'
            } }, gRows[gn]));
        }
    }

    var body: any[] = [];

    if (def.hint) {
        body.push(h('div', { key: 'pk_hint', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t3,
                                                      lineHeight: CE_T.lhProse } }, String(def.hint)));
    }

    // [FILTER-KIT] The field is the kit's now, and the threshold is the def's when
    // it states one. `!= null` rather than truthiness so a def can say 0 and mean it.
    var searchMin = (def.searchMin != null) ? Number(def.searchMin) : CE_PICK_SEARCH_MIN;
    if (all.length >= searchMin) {
        body.push(h('div', { key: 'pk_q' }, ceFilterField('pick:' + kind, 'Filter\u2026', setQ)));
    }

    // `shown` COUNTS OPTIONS, not child nodes. rows[] now carries heading wrappers as well
    // as option rows when the def groups, so rows.length would report "something matched"
    // for a list whose every match was filtered out and whose only survivors were headings
    // -- except headings are only created when a member lands, so it would in fact report
    // the opposite. Either way it is no longer the number this question is asking about.
    if (shown) {
        body.push(h('div', { key: 'pk_rows', style: { display: 'flex', flexDirection: 'column' } }, rows));
    } else {
        body.push(h('div', { key: 'pk_none' },
            ceEmpty(all.length ? 'Nothing matches that.' : 'Nothing to choose from yet.', null)));
    }

    if (def.clearLabel) {
        body.push(h('div', { key: 'pk_clear' },
            ceBtn(String(def.clearLabel), 'pick:clear:' + kind, function() {
                choose('', '');
                return Promise.resolve();
            })));
    }

    // "NOT IN THE LIST" IS NOT OPTIONAL (SS13). A world half-built must not be a wall, and
    // for a vocabulary picker like species it is the ONLY way the first value ever gets in.
    if (def.freeLabel) {
        body.push(h('div', { key: 'pk_free', style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s2,
            paddingTop: CE_T.s3, borderTop: '1px solid ' + CE_LINE
        } },
            ceKey(String(def.freeLabel)),
            h(ceField, {
                key: 'pk_free_f', k: 'pick:free:' + kind, label: '',
                value: '', multiline: false,
                placeholder: String(def.freePlaceholder || 'Type it\u2026'),
                onType: function(v: string) { _cePickDraft = String(v || ''); setDraft(_cePickDraft); },
                onCommit: function(v: string) { _cePickDraft = String(v || ''); setDraft(_cePickDraft); return Promise.resolve(); }
            }),
            draft.trim()
                ? ceBtn('Use \u201c' + _ceTrim(draft.trim(), 24) + '\u201d', 'pick:free:' + kind, function() {
                    choose('', draft.trim());
                    return Promise.resolve();
                  })
                : null
        ));
    }

    return ceScreen(
        // [NOHEADER] The picker's title goes with every other one. What a picker
        // is choosing is already stated by the row that opened it and by def.hint, which
        // renders as the first thing in the body.
        ceHeader(
            ceBtn('Cancel', 'pick:cancel', function() {
                _cePickDraft = '';
                pkClose();
                return Promise.resolve();
            })),
        body
    );
}

// -- Full-screen photo viewer  [PHOTO-VIEW] -------------------------
// surface_list line 16: "avatars should be larger and open full screen when clicked. They
// are too small to see their quality." Scoped to the Images drill's 26 slot thumbnails
// (64x96px) -- sizing was already fixed in the STYLE2-F pass; this is the other half.
//
// A FULL SURFACE SWAP, NOT AN OVERLAY, for the same reason the picker is one: there is no
// color token in this environment to paint an opaque floating panel with (see the
// ceSheetOpen [DEAD] note). HOOK-FREE, so it is called bare rather than through h() --
// same rule every other drill follows.
//
// CE_IMG_CONTAIN, NOT THE DEFAULT COVER-CROP. The whole point is seeing the image's own
// quality, and a cover-cropped frame hides exactly the edges a cropped thumbnail already
// hid. Frame height is fixed px, not aspect-ratio, same constraint _ceEntityImage's own
// note gives (the painter's <img> is position:absolute height:100%); the number is bigger
// than Scene's/Entity's because this surface has nothing else competing for room.
// [v3.0.54 PHOTO-PROV] THIS IS WHERE A PICTURE'S PROVENANCE LIVES NOW, per user:
// "portrait images should show their seed when clicked to view full screen". It takes the
// whole `photo` value rather than three strings because it now reads six fields off it and
// a fourth positional argument was already one too many.
// SEED PRECEDENCE: the portrait record's own settings.seed first (what was RENDERED),
// the slot's recorded seed second (what was ASKED for). They agree for anything generated
// since IMG-SEED-DROP; only the first exists for anything older.
// STILL HOOK-FREE -- called bare from ceRoot, so every value it shows must arrive on the
// photo object, which is exactly why the meta answer patches ceUiStore.photo.
function _cePhotoSurface(photo: any): any {
    var charId = String((photo && photo.charId) || '');
    var slot = String((photo && photo.slot) || '');
    var label = String((photo && photo.label) || slot || 'Image');
    var meta: any = (photo && photo.meta) || null;
    var mset: any = (meta && meta.settings) || {};
    var seed = Number(mset.seed) || Number(photo && photo.seed) || 0;
    var pinned = Number(photo && photo.pinned) || 0;
    var ready = !!(photo && photo.metaReady);

    // [H-03] flexShrink 0. Same class as the Scene frame: a fixed-height image anchor in a
    // flex column is crushed rather than scrolled the moment the column overflows, and 520px
    // overflows a phone on its own.
    var frame = h('div', ceImgAnchor(charId, slot, {
        style: { flexShrink: 0, width: '100%', height: '520px', borderRadius: CE_T.r,
            background: CE_WELL, border: '1px solid ' + CE_LINE,
            position: 'relative', overflow: 'hidden' }
    }, CE_IMG_CONTAIN));
    var labelNode = h('div', { style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2,
        textAlign: 'center', paddingTop: CE_T.s2 } }, label);

    var rows: any[] = [];
    if (seed > 0) {
        rows.push(ceBar({ gap: CE_T.s2, key: 'photo:seed' }, [
            ceSub('t2', 'Seed ' + String(seed)),
            (photo && photo.canPin && seed === pinned)
                ? ceSub('t3', '\u00b7 in use for every portrait')
                : ((photo && photo.canPin)
                    ? ceBtn('Use for all', 'photo:seeduse', function() {
                        return ceProfileWrite(charId, 'avatarSeed', String(seed));
                      })
                    : null)
        ]));
    } else if (ready) {
        rows.push(ceSub('t3', 'No seed recorded for this image.', { key: 'photo:noseed' }));
    }
    if (meta) {
        var dims = (Number(mset.width) || 0) && (Number(mset.height) || 0)
            ? String(mset.width) + '\u00d7' + String(mset.height) : '';
        var bits: string[] = [];
        if (dims) bits.push(dims);
        if (Number(mset.steps)) bits.push(String(mset.steps) + ' steps');
        if (Number(mset.scale)) bits.push('scale ' + String(mset.scale));
        if (meta.source === 'upload') bits.push('uploaded');
        if (bits.length) rows.push(ceSub('t3', bits.join(' \u00b7 '), { key: 'photo:set' }));
        if (meta.fp) rows.push(ceProse('t3', meta.fp, { key: 'photo:fp' }));
    } else if (ready) {
        rows.push(ceSub('t3', 'Nothing is stored about how this image was made.', { key: 'photo:nometa' }));
    }

    return ceScreen(
        ceHeader(ceBtn('Close', 'photo:close', function() { cePhotoClose(); return Promise.resolve(); })),
        [frame, labelNode, rows.length ? ceStack({ gap: CE_T.s2, padTop: CE_T.s3, key: 'photo:prov' }, rows) : null]
    );
}


// ============================================================================
// SECTION 29 — SCENE SURFACE (jsx)  [JSXSCENE]
// First surface built on SECTION 28. Renders the same SceneStatePayload the
// bridge HUD consumes: current location plus the present roster with attention
// dots. Read-only in this pass, by design - the point of landing it now is to
// evaluate the kit on a real screen before any authoring affordances are built
// on top of it.
//
// PUBLISHES ON OPEN, not on state change. Wiring automatic publish into the
// scene-change choke point is deferred deliberately: queueSceneStateBroadcast()
// is bridge-gated and re-pointing its call sites is a separate, non-additive
// change that should land after the layout is settled.
// ============================================================================

// [SCENE-STAGE] THE VISUAL-NOVEL LAYER. A TEST, AND SCOPED LIKE ONE: no storage key, no
// migration, no bridge message, and one session-only flag that dies with the engine.
//
// THE STRUCTURE IS THE WHOLE DESIGN. scene_img works today because it is an anchor with
// ZERO engine children -- the bridge appends its <img> into a node Preact does not index.
// Giving that node engine-managed children is exactly the CESURF-RECYCLE shape. So the
// stage is a WRAPPER that owns no anchor of its own, and the place and every standee are
// LEAF SIBLINGS inside it, each one still exclusively the bridge's. The invariant is
// preserved rather than tested.
//
// ENGINE INLINE STYLE WINS, which is what makes absolute positioning legal at all: the
// bridge's per-root sheet declares [data-ce-img]{position:relative} WITHOUT !important
// (it reaches for that only on .ce-surf-empty / .ce-surf-shrink), so an inline
// position:absolute here overrides it. GEOMETRY STAYS HERE is ceImgAnchor's own contract.
//
// THE LAYOUT IS DERIVED FROM THE PRESENT COUNT AND NOTHING ELSE. It cannot be derived from
// who actually owns a Standee -- CE-IMG-OPTS states at length why this file must not mirror
// the bridge's IndexedDB -- so N slots are reserved for N present characters and a character
// with no standee COLLAPSES OUT OF THE SLOT THAT WAS ALREADY RESERVED. Two of three present
// therefore stand off-centre, and that is the honest failure: the alternative is a gate
// built on a mirror that is wrong in the direction that never paints.
//
// [SCENE-STAGE-FLIP] scaleX(-1) ON THE LEFT HALF, so a pair face each other. The handoff
// flagged transform as unprecedented in this file; it is not -- ceBtn and ceIconBtn press
// with scale(), the map group translates and scales, and one absolute label already carries
// translateX(-50%). The unverified part is only whether MIRRORING A STANDEE reads as facing
// rather than as a wrong-handed character, which is a look question and not a support one.
// One function decides it so inverting the rule is one edit.
//
// THE DERIVATION'S OWN CONSTANTS. These are the shape of the rule, not preferences: they
// say how a slot's width falls as the cast grows and how much headroom a standee gets. What
// an author actually reaches for -- bigger, closer together, further up, fewer of them --
// is CE_STAGE_SETTINGS below, which scales the results of this arithmetic rather than
// replacing it, so one tuning vocabulary sits on top of one geometry.
// CE_STAGE_FRAME_H IS DELETED, not parked. It was a fixed '340px' and it is what put a
// 1216x832 room on screen cropped to a square: the shell's column is about 340px on a
// phone, so a 340px-tall frame is 1:1 and cover threw away nearly half the picture's width.
// A height cannot be chosen here at all -- this file does not know the column's width. The
// stage states a RATIO instead (see ceSceneStage) and has no height of its own.
var CE_STAGE_FILL    = 88;        // percent of the stage's height a standee's box may use
var CE_STAGE_W_MAX   = 46;        // percent of the frame, the widest one standee may grow to
// [SCENE-STAGE-ROW] CE_STAGE_W_SPAN, CE_STAGE_W_MIN AND _ceStageWidth ARE DELETED. They
// divided the frame by the number of PRESENT characters, which was never the number of
// characters who paint. `flex: 1 1 0` replaces the division outright: a slot's size follows
// how many slots SURVIVED display:none, which is a count only the browser has.
// An unranked character sorts behind every ranked one. A LARGE FINITE rather than Infinity:
// the z comparator subtracts two of these and Infinity - Infinity is NaN, which a sort
// treats as "equal" on some engines and as garbage on others.
var CE_STAGE_UNRANKED = 9999;

// [SCENE-STAGE-TUNE] THE TABLE OWNS EVERY STRING, BOUND AND DEFAULT THAT DIFFERS. Four rows
// with the same shape, so the Settings group (34) is a loop rather than four hand-written
// blocks that drift, and adding a fifth knob is a row here plus a field on GlobalConfig.
// `k` IS THE CONFIG FIELD NAME, deliberately: the resolver returns an object keyed the same
// way, so there is no second vocabulary mapping a label to a stored field.
// `step` is the nudge, not a granularity -- the box still accepts any integer in range.
var CE_STAGE_SETTINGS: any[] = [
    { k: 'stageScale', type: 'num', def: 100, lo: 40, hi: 200, step: 5, label: 'Standee size',
      sub: 'The largest a standee may get, as a percent of the picture\u2019s width. It is '
         + 'a ceiling rather than a size: one or two on screen reach it, and more than that '
         + 'share the room and come out smaller on their own.' },
    { k: 'stageSpread', type: 'num', def: 100, lo: 20, hi: 100, step: 5, label: 'Spread',
      sub: 'How much of the picture\u2019s width the standees stand across. 100 reaches both '
         + 'edges; lower gathers everyone toward the middle. One or two keep their size; a '
         + 'full row has less room to share, so it comes out smaller too.' },
    { k: 'stageFloor', type: 'num', def: 0, lo: 0, hi: 40, step: 1, label: 'Floor line',
      sub: 'Percent of the picture\u2019s height to lift the standees\u2019 feet off the '
         + 'bottom edge. Use it when the front of the location image is a table or a wall '
         + 'rather than the floor people would stand on.' },
    { k: 'stageMaxChars', type: 'num', def: 0, lo: 0, hi: 12, step: 1, label: 'Most standees at once',
      sub: '0 draws everyone in the scene. Above 0, the slots go to the characters with a '
         + 'dynamic priority rank first, lowest number first, then to whoever else is here. '
         + 'Standees share the room evenly however many of them turn out to have a picture, '
         + 'so this is for taste rather than for crowding.' },
    // The one row that is not a number. It rides the same table because it is the same kind
    // of thing -- a stage preference with a default and a stored field -- and splitting it
    // into a hand-written row beside the loop is how the four above would start to drift.
    { k: 'stageFacing', type: 'choice', def: 'right', label: 'Standee art faces',
      options: [{ id: 'right', label: 'Right' },
                { id: 'left',  label: 'Left' },
                { id: 'none',  label: 'Do not mirror' }],
      sub: 'Which way your standee art looks. Anyone standing on the far side of the picture '
         + 'is mirrored, so the whole cast turns inward. The Standee slot\u2019s default tag '
         + 'asks for right-facing art.' }
];

// [SCENE-STAGE-TUNE] ONE DERIVATION PER ADDRESS. The stage and the Settings group both ask
// this, never the config directly, so an absent field and a field someone typed 9000 into
// resolve to the same number on both surfaces. A config written before these existed is not
// migrated and does not need to be: absence resolves to the shipped constant.
function ceStageSettings(cfg: any): any {
    var c: any = cfg || {};
    var out: any = {};
    for (var i = 0; i < CE_STAGE_SETTINGS.length; i++) {
        var d: any = CE_STAGE_SETTINGS[i];
        if (d.type === 'choice') {
            // An id absent from the row's own option list resolves to the default, which is
            // the same treatment an out-of-range number gets below: a stored value the
            // surface cannot honour is not a value.
            var s = String(c[d.k] || '');
            var ok = false;
            for (var j = 0; j < d.options.length; j++) { if (d.options[j].id === s) ok = true; }
            out[d.k] = ok ? s : d.def;
            continue;
        }
        var v = Number(c[d.k]);
        if (!isFinite(v)) v = d.def;
        if (v < d.lo) v = d.lo;
        if (v > d.hi) v = d.hi;
        out[d.k] = Math.round(v);
    }
    return out;
}

// Rank as a sortable number. 0 / absent / nonsense all mean unranked, which sorts last --
// the same reading computeDynamicAllowedSet already applies to the same field.
function _ceStageRank(row: any): number {
    var r = Number(row && row.rank);
    if (!isFinite(r) || r <= 0) return CE_STAGE_UNRANKED;
    return r;
}

// [SCENE-STAGE-TUNE] WHO GETS A SLOT WHEN THERE ARE NOT ENOUGH. Ranked characters first by
// ascending rank, then everyone else in scene order. THE SURVIVORS ARE THEN PUT BACK INTO
// SCENE ORDER: rank decides membership and depth, not where someone stands, because a stage
// that reshuffles left-to-right every time a rank changes reads as people teleporting.
// cap <= 0 means everyone, which is the default and the case the handoff shipped.
function _ceStagePick(rows: any[], cap: number): any[] {
    var all: any[] = rows || [];
    if (!(cap > 0) || all.length <= cap) return all;
    var idx: number[] = [];
    var i: number;
    for (i = 0; i < all.length; i++) { idx.push(i); }
    idx.sort(function(a: number, b: number) {
        var ra = _ceStageRank(all[a]); var rb = _ceStageRank(all[b]);
        if (ra !== rb) return ra - rb;
        return a - b;
    });
    var keep = idx.slice(0, cap);
    keep.sort(function(a: number, b: number) { return a - b; });
    var out: any[] = [];
    for (i = 0; i < keep.length; i++) { out.push(all[keep[i]]); }
    return out;
}

// [SCENE-STAGE-TUNE] Z-ORDER IS RANK, NOT PAINT ORDER. A ranked character stands in front of
// an unranked one wherever the two happen to be standing, which is the whole point of the
// author having set a rank. Returns one z per row, parallel to `rows`.
// WORST FIRST, so the last index assigned is the highest z. An all-unranked cast ties on
// every comparison and falls through to scene order, which is byte-identical to the paint
// order this replaced -- the fallback is the old behaviour, not an approximation of it.
function _ceStageZ(rows: any[]): number[] {
    var all: any[] = rows || [];
    var order: number[] = [];
    var z: number[] = [];
    var i: number;
    for (i = 0; i < all.length; i++) { order.push(i); z.push(2); }
    order.sort(function(a: number, b: number) {
        var ra = _ceStageRank(all[a]); var rb = _ceStageRank(all[b]);
        if (ra !== rb) return rb - ra;
        return a - b;
    });
    for (i = 0; i < order.length; i++) { z[order[i]] = 2 + i; }
    return z;
}

// [SCENE-STAGE-ROW] _ceStageFlip IS DELETED. It took (index, count) and mirrored the left
// half -- the wrong half for right-facing art, and, more fundamentally, a question this file
// can no longer answer at all: under flex an index says nothing about where anyone stands.
// The decision moved to the bridge behind ceImgFaceOpt. Nothing here mirrors anything.

// ALL-KEYED [H-01]. The child count moves with the cast and with the skip below, so every
// child carries a key -- a mixed list here would be matched partly by position and the
// bridge-painted <img> inside a rebuilt div is exactly what H-01 was written about.
// Z-ORDER IS PAINT ORDER, first present character leftmost and lowest. Attention-driven
// ordering is deliberately not attempted in this pass.
function ceSceneStage(locId: string, present: any[], padPct: string, sg: any): any {
    var kids: any[] = [];
    // The place. Inset 0 rather than width/height 100% so it cannot disagree with the
    // wrapper, and z-index 1 so every standee is above it without a per-standee base.
    kids.push(h('div', ceImgAnchor(locId, CE_IMG_SLOT_AVATAR, {
        key: 'stage_loc',
        style: { position: 'absolute', left: '0', top: '0', right: '0', bottom: '0', zIndex: '1' }
    }, CE_IMG_COLLAPSE)));
    // [SCENE-STAGE-ROW] The cap picks the cast; the browser does the rest.
    var shown: any[] = _ceStagePick(present || [], Number(sg.stageMaxChars) || 0);
    var n = shown.length;
    var zs: number[] = _ceStageZ(shown);
    var k = (Number(sg.stageScale) || 100) / 100;
    var spread = (Number(sg.stageSpread) || 100) / 100;
    var floor = Number(sg.stageFloor) || 0;
    var faceOpt = ceImgFaceOpt(String(sg.stageFacing || 'right'));

    // THE BAND the row occupies: floor% up from the base, as tall as the size ceiling allows,
    // and never taller than the room the floor left behind -- a lifted standee that kept its
    // full height would be clipped at the head instead of standing higher.
    var band = CE_STAGE_FILL * k;
    if (band > (100 - floor)) band = 100 - floor;
    var topPct = 100 - floor - band;
    var edge = (100 - (spread * 100)) / 2;

    // The size ceiling, converted from percent-of-FRAME (how the author thinks about it, and
    // how CE_STAGE_W_MAX is written) into percent-of-ROW, which is what a flex item's
    // maxWidth resolves against. WITHOUT THE CONVERSION THE CEILING WOULD MOVE WITH `spread`,
    // and a lone standee in a narrowed row would come out smaller for no reason the author
    // asked for. It does NOT make the two settings independent, and cannot: once the row is
    // full, its share is what binds, so narrowing the row really does shrink a crowd. That
    // is geometry, not a bug -- the only alternative is overlap.
    var rowW = spread * 100;
    var maxRow = ((CE_STAGE_W_MAX * k) / rowW) * 100;
    if (maxRow > 100) maxRow = 100;

    var items: any[] = [];
    for (var i = 0; i < n; i++) {
        var c: any = shown[i];
        if (!c || !c.id) continue;
        var cid = String(c.id);
        var cname = String(c.name || 'this character');
        items.push(h('div', ceImgAnchor(cid, CE_IMG_SLOT_STANDEE, {
            key: 'stage_' + cid,
            // The tap costs nothing: the painter sets pointerEvents:none on its <img>, so a
            // tap lands on this anchor. Same door the roster card below already offers, and
            // SS8 is satisfied because these are siblings -- no ceTap is nested in another.
            onClick: (function(id) { return function() {
                ceTap('scene:stage:' + id, function() { ceNav('profile', id); });
            }; })(cid),
            role: 'button', tabIndex: 0,
            'aria-label': cname,
            style: {
                // flex 1 1 0 SHARES THE ROW EVENLY AMONG WHOEVER IS LEFT. A slot the bridge
                // hid is display:none and takes no share at all, so both the size and the
                // spacing follow the standees that actually painted -- the one fact this
                // file cannot compute, and now does not have to.
                flex: '1 1 0', minWidth: '0', maxWidth: maxRow.toFixed(2) + '%',
                height: '100%', zIndex: String(zs[i]), cursor: 'pointer'
            }
        }, CE_IMG_CONTAIN + ',' + CE_IMG_POS_BOTTOM + ',' + CE_IMG_COLLAPSE + faceOpt)));
    }
    // NO zIndex ON THE ROW, deliberately. A positioned element WITH one opens a stacking
    // context, which would seal the items' z-indices inside it and make the rank order
    // meaningless. Left as auto, every standee competes in the wrapper's own context and
    // still clears the location anchor's z-index 1.
    kids.push(h('div', {
        key: 'stage_row',
        style: {
            position: 'absolute', left: edge.toFixed(2) + '%', right: edge.toFixed(2) + '%',
            top: topPct.toFixed(2) + '%', bottom: floor.toFixed(2) + '%',
            display: 'flex', alignItems: 'flex-end', justifyContent: 'space-around'
        }
    }, items));
    // The wrapper carries NO data-ce-img. That is the point: nothing the bridge appends into
    // has engine-managed children, and nothing with engine-managed children is ever painted.
    //
    // [SCENE-STAGE-ASPECT] height 0 PLUS paddingBottom AS A PERCENTAGE. A percentage padding
    // resolves against the element's own WIDTH, in every engine, on both axes -- which makes
    // this the one way to state "as tall as this picture is, whatever the column turns out to
    // be" from a file that never learns the column's width. THE STAGE THEN CANNOT CROP: the
    // frame is exactly the location image's ratio, so the painter's cover behaves as contain
    // and the whole room is on screen. A fixed height could not do this and the previous one
    // did the opposite.
    //   ABSOLUTE CHILDREN RESOLVE AGAINST THE PADDING BOX, so `bottom: 0` is still the floor
    //   and inset 0 still fills the frame. Nothing inside this function needed changing.
    //   flexShrink 0 IS STILL LOAD-BEARING and for a subtler reason than [H-03]'s: flex
    //   shrinks the CONTENT box, and this element's content box is already zero, so a
    //   shrinking column would leave the padding standing and the frame would stop tracking
    //   its own width. Pinning it keeps height and width one fact.
    // [SS-BOX] ceWrap WITH THE style ESCAPE HATCH rather than a hand-rolled h('div',{style}):
    // this is a positioned frame, not a layout shape, which is the reach the hatch is for.
    return ceWrap({
        key: 'scene_stage',
        style: {
            flexShrink: 0, width: '100%', height: '0', paddingBottom: padPct,
            borderRadius: CE_T.r,
            background: CE_WELL, border: '1px solid ' + CE_LINE,
            position: 'relative', overflow: 'hidden'
        }
    }, kids);
}

function ceSceneRoot(): any {
    var scene = useStoreValue(ceSceneStore);
    var ui = useStoreValue(ceUiStore);
    // [SCENE-FILTER] UNCONDITIONAL AND ABOVE THE !ready EARLY RETURN,
    // which is the only placement that is legal: a hook skipped on the loading render is
    // a shifted sequence, and this component has one of those returns a few lines down.
    // The state persists across the show-all toggle on purpose -- typing a name, hiding
    // the list and showing it again should not silently drop the filter.
    var qS: any = useState(''); var q = String(qS[0] || ''); var setQ = qS[1];

    useEffect(function() {
        // Fires once per mount. Does NOT call api.v1.ui.update - see rule 1.
        cePublishScene();
    }, []);

    var refreshBtn = ceBtn('Refresh', 'scene:refresh', function() { return cePublishScene(); });

    // [JSXJOURNAL] The story journal's only engine-side door. Both header
    // branches below render this SAME node, so the loading state is not a dead end and
    // so Preact never patches a Journal handler onto a Refresh button.
    // [NOHEADER] The 'Journal' button is DELETED. Journal is on the shell nav,
    // rendered directly above this row -- it was a second door beside an identical first
    // one, and the only thing it added was a return address that ceBack now correctly
    // renders nothing for when arriving via the nav instead.
    // [SCENE-STAGE] OFF BY DEFAULT AND SESSION-ONLY. ceUiStore.open is the same map every
    // disclosure in the shell uses; a persisted setting would be a migration to undo when
    // this test either graduates or is deleted. Read here rather than below the !ready
    // return so BOTH header branches render the identical node -- the reason sceneActions
    // is one variable in the first place.
    // ANNOTATED READ, the remedy the sceneAny note below already settled: useStoreValue
    // types as `unknown`, so a raw field access off it adds to an error baseline this patch
    // is measured against. A local `any` moves it by nothing in either direction.
    var uiAny: any = ui;
    var stageOn = !!(uiAny && uiAny.open && uiAny.open['scene:stage']);
    var sceneActions = ceBar({ gap: CE_T.s2, grow: true }, [
        ceGrow(null, [refreshBtn]),
        ceFixed(null, [ceSub('t2', 'Stage')]),
        ceFixed(null, [ceToggle(stageOn, 'scene:stage', function() {
            ceToggleOpen('scene:stage'); return Promise.resolve();
        }, 'Show the scene as a stage with character standees')])
    ]);

    // [SCENE-NEWCHAR] Reuses createWizardCharacter, which is the one
    // function that does the whole job: makeDefaultEntity + saveEntity, makeDefaultCharacter
    // + saveCharacter, then createLinkedLorebookEntry. Passing fields=null makes a blank
    // record rather than a generated one -- generation belongs to the profile's own
    // Generate buttons now, and a character created from nothing has no seed to generate
    // from anyway. Navigates straight into the new profile, because an empty character
    // created and then left on a list is a character nobody finishes.
    var newBtn = ceBtn('New character', 'scene:newchar', function() {
        return (async function() {
            try {
                var newId: string = await createWizardCharacter('New character', '', null);
                await cePublishScene();
                if (newId) { ceNav('profile', newId); }
            } catch (e) {
                api.v1.error('[AE:jsxscene] create character failed:', e);
                try { api.v1.ui.toast('Could not create character.', { type: 'error', autoClose: 2000 }); } catch (e2) {}
            }
        })();
    }, 'primary');

    if (!scene || !scene.ready) {
        return ceScreen(ceHeader(sceneActions), ceEmpty('Loading scene...', null));
    }

    var body: any[] = [];

    // ── The clock strip  [SEC:CLOCK] ────────────────────────────────────────────────
    // WHEN, BESIDE WHERE. Time is a scene fact in exactly the sense the block below it is,
    // so it goes here rather than onto a route of its own -- the nav row has already been
    // asked to carry one cell too many once (H-04), and a clock is two lines and two verbs.
    // PUSHED UNCONDITIONALLY AND KEYED. This list mixes a keyed child (scene_img) with
    // unkeyed ones and already has one conditional push in it, which is the H-01 shape; a
    // second conditional would make the length move on two independent facts. The sub-line
    // is computed to a variable that may be null, so the inner stack's length is fixed too.
    // ceMono FOR THE STAMP, per CE-STYLE 5: it is a number, and numbers are mono here.
    var clkStampTxt = String(scene.clockStamp || '');
    var clkBandTxt = String(scene.clockBand || '');
    var clkDateTxt = String(scene.clockDate || '');
    var clkLine = '';
    if (clkBandTxt && clkDateTxt) clkLine = 'It is ' + clkBandTxt + ' \u00b7 ' + clkDateTxt;
    else if (clkBandTxt) clkLine = 'It is ' + clkBandTxt;
    else if (clkDateTxt) clkLine = clkDateTxt;
    body.push(ceBar({ key: 'scene_clock', gap: CE_T.s2, rule: 'bottom', padBottom: CE_T.s2 }, [
        ceGrow(null, [ ceStack(CE_T.s1, [
            ceMono(clkStampTxt, { style: { fontSize: CE_T.fs, fontWeight: '600' } }),
            clkLine ? ceSub('t2', clkLine) : null
        ])]),
        ceFixed(null, [ ceInline(CE_T.s1, [
            // MINUS AND PLUS RATHER THAN A FIELD. An hour either way reaches anywhere worth
            // reaching in a few taps, and SS8b's finding is what a field in a row costs the
            // row. The bigger jumps and a Set control belong to the Map's Time tab.
            ceIconBtn('An hour earlier', ceIconMinus(), 'scene:clk:dn', function() {
                return ceClockNudge(-CE_MINS_HOUR).then(function() { return cePublishScene(); });
            }),
            ceIconBtn('An hour later', ceIconPlus(), 'scene:clk:up', function() {
                return ceClockNudge(CE_MINS_HOUR).then(function() { return cePublishScene(); });
            })
        ])])
    ]));

    // [PHASE-G-PRIME] SCENE IMAGE AT THE TOP,
    // AN EDIT BUTTON BESIDE THE NAME, THE DESCRIPTION UNDER THE IMAGE. All three are the
    // LOCATION's, which is precisely why CE-ROADMAP SS3 moved them out of Phase G and behind
    // Phase E: there was nothing to point at until a location had its own image slot and its
    // own edit surface. Both exist now (earlier JSXENTITY, earlier ENT-IMAGE) and this adds
    // NO storage, NO verb and NO bridge message -- it is a second VIEW of the same
    // '<entityId>|Avatar' anchor the Entity surface already draws.
    //
    // "UNLESS BLANK" IS TWO DIFFERENT MISSES AND THEY ARE ANSWERED IN TWO DIFFERENT PLACES.
    //   - SLOT IS EMPTY -> CE_IMG_COLLAPSE. This file cannot know what is in the bridge's
    //     IndexedDB and must not keep a mirror of it; CE-IMG-OPTS states that argument in
    //     full and it is unchanged here. Collapse hands the question to the party that knows
    //     and removes the element from flex layout INCLUDING its gap, which is identical to
    //     never emitting it.
    //   - THERE IS NO BRIDGE -> gated here, on isBridgeReady. That fact IS engine-known: it
    //     is the handshake, not a guess about storage contents. Without this gate a
    //     bridge-less user gets a permanently empty box at the top of their main surface,
    //     because nothing is ever going to run the collapse that would have hidden it.
    // The two are NOT redundant and neither one covers the other's case.
    //
    // ROOT IS NOT AN ENTITY. AE_ROOT_LOCATION_ID is a deliberate sentinel with no record
    // behind it, so it gets neither frame nor edit button -- navigating to 'entity' with that
    // id would land on "That entity is no longer in the world."
    //
    // THE FRAME IS NOT TAPPABLE, for the same reason the roster card below is built from
    // siblings: the edit button is the door (line 28 asked for a button), and an onClick on
    // the frame would put a second target on one element. SS8: ceTap is never nested.
    var locId = String(scene.locationId || '');
    var locReal = !!locId && locId !== AE_ROOT_LOCATION_ID;
    // Hoisted above the frame because the stage lays out from it. One name, one read.
    var present = scene.present || [];
    // Same three heights as _ceEntityImage, and deliberately COPIED rather than shared: the
    // painter needs a real height (its <img> is position:absolute, height:100%), aspectRatio
    // has no precedent in this file, and two surfaces that currently agree about a box are
    // not yet one fact. Extract it if a third asks.
    var locImgW = Number(scene.locationImgW) || 1216;
    var locImgH = Number(scene.locationImgH) || 832;
    var locFrameH = (locImgH > locImgW) ? '320px' : ((locImgH === locImgW) ? '260px' : '200px');
    // [SCENE-STAGE] ONE PUSH EITHER WAY, so the body list's length does not move on a second
    // independent fact (H-01's own argument, made two comments above about the clock strip).
    // The two nodes carry DIFFERENT keys on purpose: patching a painted anchor into a
    // wrapper would leave the bridge's <img> riding a node that is no longer an anchor, and
    // while _ceSurfImgSweep does clean that up, a frame of stale picture is not worth
    // saving a remount.
    // [SCENE-STAGE-ASPECT] THE SAME TWO NUMBERS, ASKED A DIFFERENT QUESTION. locFrameH turns
    // the location's stored shape into one of three heights and accepts the crop that
    // follows; the stage turns it into the RATIO ITSELF and has no crop to accept. Both read
    // locImgW/locImgH, which is why the fallback pair is stated once above and not again
    // here. Clamped because a degenerate stored shape (a 4000x40 banner, a zero that slipped
    // past the || guard) would otherwise render a frame the whole surface has to scroll past.
    if (locReal && isBridgeReady) {
        var stagePad = (locImgH / locImgW) * 100;
        if (!(stagePad > 20)) stagePad = 20;
        if (stagePad > 150) stagePad = 150;
        body.push(stageOn
            ? ceSceneStage(locId, present, stagePad.toFixed(2) + '%',
                           (scene as any).stage || ceStageSettings(null))
            : h('div', ceImgAnchor(locId, CE_IMG_SLOT_AVATAR, {
            key: 'scene_img',
            style: {
                // [H-03] flexShrink 0, AND THIS IS WHAT "SQUISHED ON MOBILE" WAS. H-01 stopped
                // the frame being REBUILT when the Author's Note panel appeared; it did not stop
                // it being CRUSHED. ceScreen's scroller is a flex column and a flex item's
                // default shrink is 1, so a fixed height is only honoured while the column
                // fits. Desktop fitted and phone did not -- one bug, two symptoms, and the
                // second only shows on the narrower screen. A frame the bridge paints an
                // absolutely-positioned img into has no min-content height to stop at, so it
                // shrinks toward zero rather than toward its picture.
                flexShrink: 0,
                width: '100%', height: locFrameH, borderRadius: CE_T.r,
                background: CE_WELL, border: '1px solid ' + CE_LINE,
                position: 'relative', overflow: 'hidden'
            }
        }, CE_IMG_COLLAPSE)));
    }

    body.push(ceSection('Location',
        ceStack(CE_T.s1, [
            ceBar(CE_T.s2, [
                h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fs } },
                    scene.locationName || 'Nowhere'),
                locReal
                    ? ceIconBtn('Edit ' + (scene.locationName || 'this location'), ceIconEdit(),
                        'scene:locedit', function() {
                            // One-deep return address, the shape NAV-BACK defines. Scene is a
                            // top-level route so entityId is deliberately blank.
                            ceNav('entity', locId, '', { surface: 'scene', entityId: '', label: 'Scene' });
                            return Promise.resolve();
                        })
                    : null
            ]),
            scene.locationDesc
                ? ceProse('t2', scene.locationDesc)
                : null
        ])
    ));

    // [PHASE-G] ONE CARD RENDERER, BOTH
    // LISTS. Present and away differ by exactly two things -- which verb the trailing
    // control offers, and whether attention is meaningful -- so they are one function with
    // a flag rather than two that drift apart.
    //
    // THE CARD IS NOT TAPPABLE, AND THAT IS DELIBERATE. It holds TWO targets (open the
    // profile; add/exclude), and CE-STYLE SS8 says ceTap is "Never nested" -- a ceCard with
    // an onClick wraps its whole box in one, so an icon button inside it would fire the
    // button's handler AND the card's on a single physical tap. So the card draws the box
    // and the hue, and the two targets are SIBLINGS inside it: a tappable identity region
    // and a ceIconBtn. The chat contact card stays tappable because it has no inner control.
    //
    // WHAT LEFT THE CARD (surface_list line 27): compressedLine -- the recent thought -- and
    // the attention WORD trail. The sub-line is identity now (the one-liner, else the role),
    // which is what the list asked for and is also the only thing on a roster row that says
    // who a person IS rather than what they last did.
    // WHAT STAYED: the attention ring + ceDot inside the avatar frame (earlier, whose own
    // reasoning is preserved verbatim below). It is not the "ephemeral status" the list
    // asked to drop -- that was the text -- and SS11 requires state to be shape AND colour,
    // which the dot-inside-ring already satisfies.
    // TWO HUES ON ONE CARD, ON PURPOSE: the left border is PATTERN (identity, SS6.3 #2) and
    // the avatar ring is CE_SEM (attention). Different vocabularies, never the same pixel,
    // and collapsing them would make "who this is" and "do they need you" indistinguishable.
    function sceneCard(c: any, inScene: boolean): any {
        var att = c.attention || { level: 'calm', reason: '' };
        // [SCENE-AVATAR-RING] THE DOT LIVES INSIDE THE AVATAR FRAME AND
        // THE ATTENTION HUE BECOMES THE FRAME'S RING. WHY THIS WORKS WITHOUT THE ENGINE
        // KNOWING WHETHER AN AVATAR EXISTS -- which it still does not, and still must not
        // mirror: the dot is the anchor's OWN CHILD, so it is the empty state, exactly like
        // the hero frame's '+'. A painted image is absolutely positioned over the whole
        // frame and simply covers it. CE_IMG_SHRINK then handles the miss. One anchor, both
        // states, no second attribute and no inventory.
        // 'calm' has no hue by design (CE_SEM.calm is transparent), so the ring falls back
        // to the hairline rather than drawing attention a calm character has not earned.
        var attCol = CE_SEM[att.level || 'calm'] || 'transparent';
        var pat = CE_PATTERN_DEFS[String(c.pattern || '')] || null;
        var sub = String(c.briefDescription || '').trim() || String(c.role || '').trim();
        return ceCard({
            key: 'sc_' + c.id,
            hue: pat ? pat.c : '',
            children: ceBar(CE_T.s3, [
                h('div', {
                    onClick: (function(cid) { return function() {
                        ceTap('scene:prof:' + cid, function() { ceNav('profile', cid); });
                    }; })(c.id),
                    style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                        alignItems: 'center', gap: CE_T.s3, cursor: 'pointer' }
                },
                    // surface_list line 30: "avatars default square with rounded corners",
                    // and larger. 30px circle -> 48px rounded square.
                    h('div', ceImgAnchor(c.id, CE_IMG_SLOT_AVATAR, {
                        style: {
                            flex: '0 0 auto', width: '48px', height: '48px', borderRadius: CE_T.r,
                            background: CE_FILL, overflow: 'hidden', position: 'relative',
                            border: '2px solid ' + (attCol === 'transparent' ? CE_LINE : attCol),
                            display: 'flex', alignItems: 'center', justifyContent: 'center'
                        }
                    }, CE_IMG_SHRINK),
                        ceDot(att.level || 'calm')
                    ),
                    ceGrow(null, [
                        ceH(c.name + (c.isProtagonist ? ' (you)' : '')),
                        sub ? ceTruncate('t3', sub) : null
                    ])
                ),
                inScene
                    ? ceIconBtn('Take ' + c.name + ' out of the scene', ceIconUserMinus(),
                        'scene:out:' + c.id, (function(cid) { return function() {
                            return aeRemoveCharFromScene(cid).then(function() { return cePublishScene(); });
                        }; })(c.id))
                    : ceIconBtn('Bring ' + c.name + ' into the scene', ceIconUserPlus(),
                        'scene:in:' + c.id, (function(cid) { return function() {
                            return aeMoveCharToScene(cid).then(function() { return cePublishScene(); });
                        }; })(c.id))
            ])
        });
    }

    var awayList = scene.away || [];
    var showAll = !!(ui && ui.open && ui.open['scene:showall']);
    var rows: any[] = [];
    for (var i = 0; i < present.length; i++) { rows.push(sceneCard(present[i], true)); }
    // [SCENE-FILTER] THE FILTER APPLIES TO THE AWAY LIST ONLY, and that is the whole
    // design rather than an omission. Present is the SCENE -- it is short by definition, it
    // is what this surface is for, and filtering it would hide people who are standing in
    // the room. Away is the rest of the cast, which is the list that grows without bound
    // and the one the user asked for a search on.
    // Matches the same two things the card SHOWS (name, and the one-liner-or-role sub) via
    // the shared kit helper, so nothing on screen is invisible to the filter.
    var needle = ceFilterNeedle(q);
    var awayRows: any[] = [];
    var awayShown = 0;
    if (showAll) {
        for (var ax = 0; ax < awayList.length; ax++) {
            var aw: any = awayList[ax];
            if (!aw) continue;
            var awSub = String(aw.briefDescription || '').trim() || String(aw.role || '').trim();
            if (!ceFilterMatch(needle, [String(aw.name || ''), awSub])) continue;
            awayShown++;
            awayRows.push(sceneCard(aw, false));
        }
    }

    body.push(ceSection('Present (' + present.length + ')',
        ceStack(CE_T.s2, [
            rows.length
                ? ceStack(CE_T.s2, rows)
                : ceEmpty('Nobody is in the scene.', null),
            // [PHASE-G] "show all characters" REPLACES THE
            // DEDICATED ROSTER, whose toolbar button was removed AHEAD of its replacement in
            // earlier -- the roadmap's own SS0 flagged that gap, and this closes it.
            // State is ceUiStore.open, the same map every disclosure in the shell uses; a
            // dedicated store field would be a second mechanism for one boolean.
            awayList.length
                ? ceSettingRow('Show all characters',
                    awayList.length + (awayList.length === 1 ? ' character is' : ' characters are')
                        + ' not in this scene',
                    ceToggle(showAll, 'scene:showall', function() {
                        ceToggleOpen('scene:showall'); return Promise.resolve();
                    }, 'Show characters who are not in this scene'))
                : null,
            // The field renders with the list it filters and disappears with it. Threshold
            // is the same judgement CE_PICK_SEARCH_MIN encodes: below it, a search box is
            // one more control above a list you can already read in full.
            (showAll && awayList.length >= 8)
                ? ceWrap({ key: 'scene_flt' }, [ ceFilterField('scene:away', 'Find a character\u2026', setQ)])
                : null,
            (showAll && awayShown)
                ? ceStack(CE_T.s2, awayRows)
                : null,
            (showAll && !awayShown && awayList.length)
                ? ceEmpty('Nobody matches that.', null)
                : null,
            newBtn
        ])
    ));

    // [G-04] WHAT THE ENGINE ACTUALLY PUT IN THE AUTHOR'S NOTE, per author. Last, under the
    // roster, because it is a receipt and not a control -- the same placement argument the
    // Move panel's own receipt block settled.
    //   ONLY WHEN THERE IS ONE. A story with no protagonist and no scene block gets no
    //   panel rather than an empty box saying nothing was sent; absence here is the normal
    //   state of a world that has not generated yet.
    //   ceProse WITH THE SENTINEL INCLUDED, because "as it is injected" is the whole request:
    //   showing the parts without the wrapper would be a tidied version of the thing the
    //   author is trying to debug.
    // ANNOTATED READ. useStoreValue types as `unknown` to tsc, so every field access off
    // it is an error this file already carries ~180 of; a local `any` is the remedy the
    // [LOC-PROFILE] note settled, applied here rather than to `scene` itself so the error
    // baseline moves by nothing in either direction.
    var sceneAny: any = scene;
    // [H-01] PUSHED UNCONDITIONALLY, null WHEN EMPTY, AND THAT IS THE FIX -- author
    // reported the scene's header image disappearing the moment this panel first had
    // something to show. G-04 pushed this section only when a block existed, so `body` grew
    // by one the first time a generation landed. THE SCENE BODY MIXES KEYED AND UNKEYED
    // CHILDREN (`scene_img` carries a key, the sections below it do not), and this file's own
    // LOC-PROFILE3 note states what a length change does to that mix: Preact matches the
    // keyed ones by key and the rest by POSITION, and the anchor div gets rebuilt. A rebuilt
    // anchor loses the <img> THE BRIDGE PAINTED INTO IT -- painted outside Preact's
    // knowledge, so nothing puts it back until the next bridge scan.
    //   null RATHER THAN AN EMPTY ceWrap: a wrapper with no children is still a flex item
    //   and would leave a stray gap at the foot of every scene that has not generated yet.
    //   A null child holds its index without rendering a node.
    var anHas = !!String(sceneAny.anBlock || '');
    if (anHas) {
        var anAge = '';
        var anAtN = Number(sceneAny.anAt || 0);
        if (anAtN) {
            var secs = Math.max(0, Math.round((Date.now() - anAtN) / 1000));
            anAge = (secs < 60) ? (secs + 's ago')
                  : ((secs < 3600) ? (Math.round(secs / 60) + 'm ago')
                                   : (Math.round(secs / 3600) + 'h ago'));
        }
        body.push(ceSection('Author\u2019s Note as sent',
            ceStack(CE_T.s2, [
                ceSub('t3', 'The block this engine appended on the last generation'
                    + (anAge ? (', ' + anAge) : '') + '. Refresh to re-read it.'),
                ceProse('t2', String(sceneAny.anBlock)),
                ceSub('t3', 'Anything you typed in NAI\u2019s own Author\u2019s Note sits above this '
                    + 'and is untouched. Edit what lands here from Settings \u203a Context.')
            ])
        ));
    } else {
        body.push(null);
    }

    return ceScreen(ceHeader(sceneActions), body);
}

var _ceSceneHandle: any = null;

function ceRoot(): any {
    // ONE jsx tree for the whole shell. Surfaces are a VALUE (uiStore.surface),
    // not separate modals - so navigation never opens or updates a modal, which
    // is what keeps us clear of the self-update loop.
    var ui = useStoreValue(ceUiStore);
    var surface = ui ? ui.surface : 'scene';
    var body: any;
    // [PICKER] INTERCEPTED BEFORE THE SURFACE SWITCH, exactly as a seventh surface
    // would be. It renders INSTEAD of the surface (a full swap, not an overlay -- overlays
    // remain non-constructible here, see the ceSheetOpen [DEAD] note) while SHELL-NAV below
    // stays visible, which is legal only because the picker has no staged state to lose.
    var pick: any = (ui && ui.picker) || null;
    // [PHOTO-VIEW] Checked alongside the picker, same precedence reasoning:
    // both are full swaps with nothing staged to lose, so which one wins when (in
    // practice never, since nothing opens both) is not a real question.
    var photo: any = (ui && ui.photo) || null;
    // [GEN-INLINE] slotOpts IS NO LONGER INTERCEPTED HERE. It used to be the
    // third member of the picker/photo full-swap family; it is now an INLINE strip that
    // renders under the field it writes to (see _ceGenBtn). The store slot is unchanged
    // and ceNav still clears it -- only the rendering location moved.
    if (pick && pick.kind && CE_PICKER_DEFS[pick.kind]) {
        body = h(_cePickerSurface, { kind: pick.kind, ctx: pick.ctx || {} });
    }
    else if (photo && photo.charId) {
        body = _cePhotoSurface(photo);
    }
    else if (surface === 'profile') { body = h(ceProfileRoot, null); }
    // [JSXENTITY] SECTION 36. Hangs off Map exactly as Profile hangs off Scene:
    // a surface VALUE with an entityId, deliberately absent from CE_SHELL_ROUTES because
    // it is a detail view reached FROM a surface, not a destination of its own.
    else if (surface === 'entity') { body = h(_ceEntityRoot, null); }
    // [F-29] THE 'faction' SURFACE VALUE IS RETIRED, not re-pointed at the entity root.
    // A faction IS an entity, so 'entity' with the faction's id is the address -- a second
    // surface value resolving to one renderer is the duplicate this patch removes, one
    // indirection later. An unknown value falls through to Scene, which is what a stale
    // in-flight nav gets and is the same degradation every retired route already has.
    // [F-26] SECTION 36b. A shell route, unlike 'entity' above it.
    else if (surface === 'diplomacy') { body = h(_ceDiploRoot, null); }
    else if (surface === 'journal') { body = h(ceJournalRoot, null); }
    // [earlier, per user] Map was WRONGLY given its own separate modal in earlier --
    // exactly the pattern this comment already warns against. Consequence, reported live:
    // the map's "Scene" back button called ceNav('scene'), which only patches
    // ceUiStore.surface -- a value nothing inside the Map's own standalone modal was
    // subscribed to, so the button did nothing and the map modal never closed. Fixed by
    // routing Map through this SAME switch, exactly like Profile and Journal.
    else if (surface === 'map') { body = h(_ceMapRoot, null); }
    // [JSXCHAT] SECTION 33. One line here plus one in CE_SHELL_ROUTES -- the
    // whole point of SHELL-NAV, and the first surface added since it landed.
    else if (surface === 'chat') { body = h(_ceChatRoot, null); }
    // [SETTINGS-JSX] SECTION 34.
    else if (surface === 'settings') { body = h(_ceSettingsRoot, null); }
    // [IMGPRESET-JSX] SECTION 35.
    else if (surface === 'images') { body = h(_ceImagesRoot, null); }
    // [JSXWIZARD] SECTION 37.
    else if (surface === 'wizard') { body = h(_ceWizRoot, null); }
    // [IMG-EDIT-SURFACE] SECTION 35b. Deliberately absent from CE_SHELL_ROUTES,
    // for the same reason Profile and Entity are: it is a detail view of one record,
    // reached FROM somewhere (a gallery cell, a story card, a chat photo), not a
    // destination you would pick off a nav bar with nothing selected.
    else if (surface === 'imgedit') { body = h(_ceImgEditRoot, null); }
    else { body = h(ceSceneRoot, null); }

    // [earlier ROUTE-KEY, per user: "you either have to implement the parts in another way
    // that won't carry over, or we have to disconnect the menus in some fashion"] THIS IS
    // THE DISCONNECT, AND IT IS ONE LINE BECAUSE IT IS THE SAME FIX AS TABBODY-KEY ONE
    // LEVEL UP. earlier keyed each surface's TAB body and that closed the recycle path
    // WITHIN a surface; the slot below is the identical unkeyed-fixed-position shape
    // BETWEEN surfaces, and it had the identical hole.
    //
    // WHY IT BITES EVEN THOUGH THE ROUTER SWAPS COMPONENT TYPES. Most swaps here do change
    // vnode type (h(_ceImagesRoot) -> h(_ceImgEditRoot)) and Preact unmounts correctly for
    // those. TWO OF THE FIVE BRANCHES DO NOT: _cePhotoSurface(...) is CALLED, not wrapped,
    // so it contributes a bare h('div') -- and every ceScreen returns a bare h('div') too.
    // Any transition between two of those is div-to-div at a fixed index, which is reuse,
    // not replacement. The key makes the whole family behave like the typed branches.
    //
    // entityId IS IN THE KEY DELIBERATELY. Profile-to-Profile for a different character and
    // imgedit-to-imgedit for a different record both keep `surface` constant while changing
    // everything on screen, and both mount a ceImgAnchor -- the exact node the bridge
    // appends a foreign <img> into (CESURF-RECYCLE). ceNav is the ONLY writer of entityId
    // (verified by grep this pass), so nothing can bump this key mid-surface and remount a
    // screen out from under a user's typing.
    //
    // THIS IS NOT A SEVENTH RUN AT THE HEADER GHOST (v2.167-v2.172). That one lived inside
    // ceScreen's own child list and was settled by HEADER-INFLOW; this is the router's slot,
    // one level above it, and it has never been keyed at all.
    var routeKey: string = (pick && pick.kind && CE_PICKER_DEFS[pick.kind])
        ? ('picker:' + String(pick.kind))
        : ((photo && photo.charId)
            ? ('photo:' + String(photo.charId) + ':' + String(photo.slot || ''))
            : ('surf:' + String(surface || 'scene') + ':' + String((ui && ui.entityId) || '')));

    // [SHELL-NAV] The nav lives HERE, in the router, and not in ceScreen or in
    // each surface's own header. Three reasons, in order of weight:
    //   1. ONE PLACE. Surface number five cannot forget to include it. A per-surface
    //      call site is a rule you have to remember; this is a rule you cannot break.
    //   2. It is app chrome, and the router is what owns app chrome. ceScreen is a
    //      LAYOUT primitive used by drills too, and a drill must not offer a way out
    //      that skips its own commit path.
    //   3. Profile and the drills sit UNDER this, so the nav stays visible at depth --
    //      the way out of anywhere is always on screen. No nav item highlights while on
    //      Profile, which is correct: Profile is a detail view reached FROM a surface,
    //      not a destination of its own (CE-SURFACE-COLLAPSE 2, "not a seventh surface").
    // minHeight:'0' on both the column and the body slot is load-bearing: ceScreen below
    // is a height:100% grid, and without it a flex child refuses to shrink and the
    // surface's own scroll container never engages.
    // [STYLE2] The generation rail mounts HERE, above the nav, for the same
    // reason the nav itself lives in the router (SS10.1 #3): a generation outlives the
    // surface that started it, so the one indicator that must survive navigation cannot
    // live inside anything this switch can replace. It is `flex: 0 0 auto` and renders
    // null when idle, so it costs no layout at rest.
    // [H-04] THE ROUTER COLUMN IS THE LAST GATE BEFORE NAI'S OWN CONTAINER. Author-reported:
    // "the top navbar stretches past the mobile window and forces the whole screen to scroll".
    // F-27 gave the nav row minWidth/width/maxWidth and that was correct and insufficient --
    // the row's own overflow zeroes ITS min-content, but nothing zeroed this column's or the
    // grid track's above it, so the width still climbed the chain. Three elements now say the
    // same thing (ceJsxPart's column track, this column, ceScreen's grid + scroller) and a
    // future wide child cannot escape through any of them.
    return h('div', { style: { display: 'flex', flexDirection: 'column', height: '100%',
                               minHeight: '0', minWidth: '0',
                               width: '100%', maxWidth: '100%', overflowX: 'hidden' } },
        // [GEN-RAIL-OUT] The generation rail was the first child here.
        ceShellNav(surface),
        h('div', { key: routeKey, style: { flex: '1 1 auto', minHeight: '0', minWidth: '0' } }, body)
    );
}

// [SHELL-TRAY] THE ONE MODAL OPENER. ceOpenScene and ceOpenMap were two
// near-identical copies of this body, and with a tray button per surface a third and
// fourth copy were about to be written; they would not have stayed in sync (MAP-NAV-FIX is
// the record of what a second opener costs). Both survive below as one-line wrappers
// because they have named callers.
// EVERYTHING TRUE OF BOTH ORIGINALS IS TRUE HERE:
//   - ONE modal id. A second call while the shell is open only patches the store and lets
//     ceRoot re-render in place; opening another would stack two shells. ceOpenScene did
//     NOT have this guard and ceOpenMap did -- the guard is correct and is now universal.
//   - The full store-init list runs FIRST, even for a surface that keeps no state of its
//     own, because the kit's primitives have a hard dependency on ceUiStore
//     (STORE-BEFORE-HOOK, third variant: ceAction's first line is `if (!ceUiStore) return;`
//     and every ceBtn on the surface silently no-ops without it).
//   - Registered ONCE with a single jsx part. The tree repaints from its own store
//     subscriptions; nothing here ever calls handle.update().
async function ceOpenShell(surface: string, entityId?: string): Promise<void> {
    ceStoresInit();
    ceProfileStoreInit();
    ceJournalStoreInit();
    ceImgSlotStoreInit();
    ceMapStoreInit();
    ceChatStoreInit();
    ceSettingsStoreInit();
    ceImagesStoreInit();
    ceEntityStoreInit();
    ceDiploStoreInit();
    ceWizStoreInit();
    if (!ceUiStore || !ceSceneStore) {
        try { api.v1.ui.toast('CE jsx UI failed to initialise.', { type: 'error' }); } catch (e) {}
        return;
    }
    ceNav(String(surface || 'scene'), entityId || '');
    if (_ceSceneHandle) return;
    try {
        // [SHELL-WINDOW] ONE BRANCH, TWO CONTAINERS. The two APIs return the SAME
        // handle shape ({ update, close, isClosed, closed }), so everything downstream --
        // the _ceSceneHandle guard, the .closed reset, _ceWizChatCloseShell -- is untouched
        // and does not know or care which one it got. The jsx part is the same part; only
        // the floor differs (see ceJsxPart's minPx).
        if (CE_SHELL_WINDOW) {
            _ceSceneHandle = await api.v1.ui.window.open({
                id: 'ce-scene-surface',
                title: 'Character Engine',
                defaultWidth: '46%',
                defaultHeight: '82%',
                minWidth: 360,
                minHeight: CE_SHELL_WINDOW_MIN_PX,
                resizable: true,
                content: [ceJsxPart('ce-shell-jsx', ceRoot, CE_SHELL_WINDOW_MIN_PX)]
            });
        } else {
            _ceSceneHandle = await api.v1.ui.modal.open({
                id: 'ce-scene-surface',
                title: 'Character Engine',
                size: 'full',
                content: [ceJsxPart('ce-shell-jsx', ceRoot)]
            });
        }
        if (_ceSceneHandle && _ceSceneHandle.closed && typeof _ceSceneHandle.closed.then === 'function') {
            _ceSceneHandle.closed.then(function() { _ceSceneHandle = null; });
        }
    } catch (e) {
        _ceSceneHandle = null;
        api.v1.error('[AE:jsxshell] open failed:', e);
        try { api.v1.ui.toast('Could not open the engine UI. ' + String(e), { type: 'error' }); } catch (e2) {}
    }
}

// [SHELL-TRAY] ceOpenScene is DELETED, not kept as a wrapper. Its only caller was
// the 'ce-tb-shell' toolbar button, which this patch replaced with the per-route loop; a
// zero-caller wrapper sitting beside ceOpenMap (which '/ce map' genuinely still calls)
// would read as a live entry point on the next audit. Verified zero callers in this file,
// zero references in the bridge, and not on the window.aeBridge console surface.
// Anything that wants it calls ceOpenShell('scene').


// ============================================================================
// SECTION 30 — PROFILE SURFACE (jsx)
// The character editor. Everything about one character is authored here.
//
// NO OVERLAY SHEETS. There is no color token in this environment to paint an
// opaque floating panel with: `background:'inherit'` resolves to nothing
// through an absolutely-positioned parent, and color-mix is translucent by
// construction. A "sheet" here is a FULL SURFACE SWAP driven by
// ceUiPatch({profileDrill}), a value on the store exactly like `surface` is.
// No z-index, no backdrop. This constraint is measured, not stylistic.
//
// SECTIONS EXPAND IN PLACE AND MORE THAN ONE CAN BE OPEN AT ONCE. Authoring one
// field while unable to see the field it must agree with is the failure any
// modal shape guarantees. That is the argument for the accordion.
//
// THE GROUPS ARE NOT INVENTED HERE. They are CE_FIELD_GROUP_ORDER /
// CE_FIELD_GROUP_LABELS — Presence, Drive, Resistance, Conduct, Position,
// Background, Aspects — which are the Studio's own steps, in display order
// rather than in the order the walk asks them. ceOrderStaticFields
// already guarantees the slot card sorts before its facets inside a group, so
// this surface renders that order rather than re-deriving it.
//
// PATTERN IS A JUNCTION, NOT A GROUP. It sits between Drive and Resistance
// because that is where it does its work: CE_PATTERN_DEFS[id].resist and
// .conduct ARE the prompts for the two steps after it. Its hue is aura only —
// junction dot, and the rail of the two groups it gates. Never body text, same
// rule the bridge's STUDIO-2 set.
//
// TWO SHAPES, NEVER MIXED. `uiShape` selects between the classic character
// sheet (STATIC_FIELD_DEFS + coreValues) and the studio slot/facet model. They
// describe the same person by different means, so rendering both would hand
// the model two answers to every question. Resolution mirrors
// _ceResolveCharPattern: a stored value wins, otherwise the record is scanned.
//
// EDIT IS NOT A SEPARATE DENSITY. An expanded section is editable; touching a
// field commits on blur. The read/edit mode switch the draft implied never had
// a reason to exist.
//
// ceField CALLS useRef, so every dynamic list here goes through
// h(ceField, props) with a key — never a bare ceField(p) inside a loop. This
// is the conversion SECTION 28's own comment predicted would be forced by the
// first surface with a variable-length field list. It was.
// ============================================================================

var ceProfileStore: any = null;

function ceProfileStoreInit(): void {
    if (ceProfileStore) return;
    // [PHASE-F] `equip` is the equipment projection:
    //   { entityId, bodyOk, carried[], candidates[] }
    // It is a PROJECTION for the same reason roster and vocabSpecies are, and for one
    // more that is specific to it: char.entityId is not on buildCharProfilePayload and
    // must not be added there, because that payload is the BRIDGE's too.
    // [PROFILE-DOORS] `dynRank` is the dynamic-priority projection:
    //   { rank, max, holders: { <rank>: <name> } }
    // rank 0 means unranked. It exists because CE_PICKER_DEFS.options() is SYNCHRONOUS by
    // contract and the answer needs the whole cast's ranks plus cfg.maxDynamicCharacters --
    // neither of which is on buildCharProfilePayload, and neither of which may be fetched
    // from a render path. Computed off the loadAllCharacters() pass cePublishProfile
    // already runs for roster/vocabSpecies, so it costs no extra storage read.
    // [SEC:STATE] `states` is the per-character half of the STATE CORE:
    //   { rows: [{ defId, name, scope, min, max, value, label, atRest, banded, speaks }],
    //     hasDefs: bool, isProtag: bool }
    // Built by ceStateRowsForChar off the record this publish has already loaded, so it
    // costs no storage read. `hasDefs` is the WHOLE catalog's emptiness, not this
    // character's -- the drill needs to tell "nothing defined in this world" apart from
    // "nothing scoped to this person", and those want different empty states.
    // [STORE-BEFORE-HOOK] `places` WAS ALREADY MISSING FROM THIS SHAPE before the schedule
    // work -- cePublishProfile sets it but the initial object never declared it, and the
    // charLocation picker only survived because it reads through a `|| null` guard. Declared
    // now alongside the clock rather than left as a latent one, since the schedule drill
    // reads both on its first render.
    try { ceProfileStore = createStore({ ready: false, charId: '', p: null, tiers: null, cfg: null,
                                         roster: [], vocabSpecies: [],
                                         equip: { entityId: '', bodyOk: false, carried: [], candidates: [] },
                                         states: { rows: [], hasDefs: false, isProtag: false },
                                         places: { locId: '', locName: '', list: [] },
                                         clockT: 0,
                                         dynRank: { rank: 0, max: 0, holders: {} } }); }
    catch (e) { api.v1.error('[AE:jsxprofile] store init failed:', e); }
}

// Pressure tiers are read at publish time rather than exported from
// buildCharProfilePayload, deliberately. That payload also serves the bridge
// and the earlier note there is still correct: the tier is volatile evidence
// belonging to historyStorage, and baking it into a portable payload would
// carry a conclusion without the beats that earned it. Reading it into a UI
// projection is a different act from exporting it.
async function _ceReadProfileTiers(char: any): Promise<any> {
    var out: any = { hook: 0, pursuit: 0, position: 0, hasPosition: false, targetName: '',
                      hookNotes: [], pursuitHist: [], positionHist: [] };
    try {
        out.hook = await _ceReadPressure(char.id, 'hook');
        out.pursuit = await _ceReadPressure(char.id, 'pursuit');
        var pos: any = char.position || {};
        var tid = String(pos.targetId || '');
        if (tid) {
            out.hasPosition = true;
            out.targetName = String(pos.targetName || 'them');
            out.position = await _ceReadPressure(char.id, 'position_' + tid);
        }
        // [earlier PROFILE-THOUGHT-HIST, per user: "hooks, pursuit, position menu missing
        // thoughts history that showed blocking, etc for each"] Read projections only --
        // both sources already live on the loaded record, so this is zero new storage and
        // zero new bridge messages.
        //
        // Hook: generateHookUpdates' own evidence phrases (SECTION 12) -- the exact array
        // the retired native modal rendered (SECTION 20, hk.developmentNotes bullet list)
        // with no jsx counterpart until now.
        var topHook: any = char.hook || null;
        out.hookNotes = (topHook && Array.isArray(topHook.developmentNotes))
            ? topHook.developmentNotes.filter(Boolean).slice(0, 3) : [];
        // Pursuit/Position: char.ephemeralHistory (EVIDENCE-STAMP, SECTION 12) carries a
        // classification per beat alongside the intent that earned it. An entry with no
        // stamp means no usable classification came back that beat -- filtered out rather
        // than shown as an 'untouched' guess, same honesty rule EVIDENCE-STAMP states.
        var eh: any[] = char.ephemeralHistory || [];
        var pu: any[] = []; var po: any[] = [];
        for (var ehI = 0; ehI < eh.length && (pu.length < 3 || po.length < 3); ehI++) {
            var snap: any = eh[ehI]; if (!snap) continue;
            var desire = String(snap.immediateDesire || '').trim();
            if (!desire) continue;
            if (pu.length < 3 && snap.pursuitState) { pu.push({ state: snap.pursuitState, note: desire }); }
            if (po.length < 3 && snap.positionState) { po.push({ state: snap.positionState, note: desire }); }
        }
        out.pursuitHist = pu;
        out.positionHist = po;
    } catch (e) { api.v1.error('[AE:jsxprofile] tier read failed:', e); }
    return out;
}

async function cePublishProfile(charId: string): Promise<void> {
    // buildCharProfilePayload takes a LOADED RECORD, not an id — earlier
    // passed the bare charId and threw on char.customStaticFields. Every real
    // call site resolves first; so does this one.
    ceProfileStoreInit();
    if (!ceProfileStore || !charId) return;
    try {
        var char: any = await loadCharacter(charId);
        if (!char) { ceProfileStore.set({ ready: true, charId: charId, p: null, tiers: null }); return; }
        var cfg: any = await loadConfig();
        var payload: any = await buildCharProfilePayload(char, cfg);
        var tiers: any = await _ceReadProfileTiers(char);
        // cfg is carried so the classic sheet can resolve fieldInstructions /
        // fieldBudgets without a second loadConfig per render, and roster so Position can
        // offer a target. Roster is id+name ONLY -- the whole cast's records would make
        // this store repaint every profile on any character's edit, which is exactly the
        // change-frequency split JSXKIT-STORE-SPLIT exists to prevent.
        var roster: any[] = [];
        // [PICKER] vocabSpecies is harvested from the WHOLE cast including this
        // character, unlike roster which excludes self -- the species picker's job is to
        // show the vocabulary in use, and a character's own current value is part of it.
        // Still id+name-scale data (a short string list), so JSXKIT-STORE-SPLIT's reason
        // for keeping whole records out of this store is untouched.
        var vocabSpecies: string[] = [];
        var seenSp: any = {};
        // [PROFILE-DOORS] Ranks are harvested in the SAME pass, from the same
        // records. openDynamicRankPicker read them off loadIndex() instead; the index
        // mirrors the field (see loadIndex's dynamicPriorityRank propagation) but the full
        // records are already in hand here, so a second read would only be a second thing
        // to keep in sync.
        var dynRank: any = { rank: 0, max: 0, holders: {} };
        var dynEligible = 0;
        try {
            var all: any[] = await loadAllCharacters();
            for (var ri = 0; ri < (all || []).length; ri++) {
                if (!all[ri]) continue;
                var sp = String(all[ri].species || '').trim();
                if (sp && !seenSp[sp.toLowerCase()]) { seenSp[sp.toLowerCase()] = 1; vocabSpecies.push(sp); }
                var rkV: any = (all[ri] as any).dynamicPriorityRank;
                var rk = (typeof rkV === 'number' && rkV > 0) ? rkV : 0;
                if (rk) { dynRank.holders[String(rk)] = String(all[ri].name || 'Unnamed'); }
                if (all[ri].active && !all[ri].isProtagonist) { dynEligible++; }
                if (all[ri].id === charId) { dynRank.rank = rk; continue; }
                roster.push({ id: all[ri].id, name: all[ri].name || 'Unnamed' });
            }
        } catch (eR) { api.v1.error('[AE:jsxprofile] roster read failed:', eR); }
        vocabSpecies.sort();
        // How many rank slots to offer -- openDynamicRankPicker's rule, kept verbatim so
        // the two doors cannot disagree about how many ranks exist: exactly the cap when
        // one is set, otherwise as many as there are eligible present characters, floored
        // at 4 so the control still means something in a two-hander.
        try {
            var dynCap = Number((cfg as any).maxDynamicCharacters) || 0;
            dynRank.max = dynCap > 0 ? dynCap : Math.max(4, dynEligible);
        } catch (eDR) { dynRank.max = 4; }

        // [PHASE-F] THE EQUIPMENT PROJECTION. One loadEntityIndex, one pass, both
        // lists -- what this character carries and what could be moved to them.
        //
        // AN ITEM IS "CARRIED" WHEN ITS parentId IS THE CHARACTER'S BODY ENTITY. That is the
        // world graph's own answer and it is the one buildEquipmentRows has always used;
        // char.equippedItemIds is a different question (WORN, not held) and is read only for
        // the per-row flag. Two questions, two reads, and conflating them is what
        // EQUIP-STATE-SYNC was the autopsy of.
        //
        // bodyOk IS NOT `!!entityId`, AND THE DIFFERENCE IS A REAL STATE, not defensiveness.
        // A character can hold an entityId whose entity no longer exists -- the native
        // diagnostics have a named blocker for exactly that ("body id set but entity
        // MISSING") -- and parenting an item to a dangling id would file it somewhere
        // nothing can ever list. The index is already loaded here, so the check is a lookup
        // rather than a second storage read.
        // [CHAR-PLACE] THE PLACE PROJECTION, FOLDED INTO THE EQUIP PASS RATHER THAN
        // GIVEN ITS OWN. Both questions are answered by one loadEntityIndex and this one is
        // already paid for; a second read per profile publish to learn a parent name would
        // be a storage round trip bought for nothing.
        // `list` IS id + name + where ONLY -- JSXKIT-STORE-SPLIT's rule, same as `roster`
        // above: whole entity records in this store would repaint the profile on any
        // unrelated world edit.
        var places: any = { locId: '', locName: '', list: [] };
        var equip: any = { entityId: String(char.entityId || ''), bodyOk: false, carried: [], candidates: [] };
        try {
            var eqIdx: any[] = await loadEntityIndex();
            var eqNames: any = {};
            var eqBodyParent = '';
            var eqi = 0;
            for (eqi = 0; eqi < (eqIdx || []).length; eqi++) {
                if (!eqIdx[eqi]) continue;
                eqNames[String(eqIdx[eqi].id)] = String(eqIdx[eqi].name || 'Unnamed');
                if (equip.entityId && String(eqIdx[eqi].id) === equip.entityId) {
                    equip.bodyOk = true;
                    // Read off the BODY, not off meta.currentLocationId. The index field is
                    // a mirror maintained by saveCharacter and this is the thing it mirrors;
                    // one of them has to be the source and it is this one.
                    eqBodyParent = String(eqIdx[eqi].parentId || '');
                }
            }
            for (eqi = 0; eqi < (eqIdx || []).length; eqi++) {
                var pm: any = eqIdx[eqi];
                if (!pm || pm.type !== 'location') continue;
                places.list.push({ id: String(pm.id), name: String(pm.name || 'Unnamed'),
                                   where: pm.parentId ? (eqNames[String(pm.parentId)] || '') : '' });
            }
            places.locId = eqBodyParent;
            places.locName = eqBodyParent ? (eqNames[eqBodyParent] || '') : '';
            if (equip.bodyOk) {
                var eqWorn: any = {};
                var eqIds: any[] = char.equippedItemIds || [];
                for (eqi = 0; eqi < eqIds.length; eqi++) { eqWorn[String(eqIds[eqi])] = 1; }
                for (eqi = 0; eqi < (eqIdx || []).length; eqi++) {
                    var em: any = eqIdx[eqi];
                    if (!em || em.type !== 'item') continue;
                    if (String(em.parentId || '') === equip.entityId) {
                        equip.carried.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                                             icon: String(em.icon || ''),
                                             worn: !!eqWorn[String(em.id)] });
                    } else {
                        // `where` is not decoration. Adding an item MOVES it, so an author
                        // about to take the tavern's only lantern should be able to see that
                        // is what they are doing before they tap.
                        equip.candidates.push({ id: String(em.id), name: String(em.name || 'Unnamed'),
                                                icon: String(em.icon || ''),
                                                where: em.parentId ? (eqNames[String(em.parentId)] || '') : '' });
                    }
                }
            }
        } catch (eEq) { api.v1.error('[AE:jsxprofile] equipment read failed:', eEq); }

        // [SEC:STATE] The state projection. Pure over cfg + the loaded record: no
        // storage read, no verb call, and every number already clamped and banded so the
        // renderer does arithmetic on nothing.
        var states: any = { rows: [], hasDefs: false, isProtag: false };
        try {
            var stIsProtag = !!(cfg && String((cfg as any).protagonistCharId || '') === String(charId));
            states = {
                rows: ceStateRowsForChar(cfg, char, stIsProtag),
                hasDefs: ceStateDefs(cfg).length > 0,
                isProtag: stIsProtag
            };
            // [F-11] THE ARITHMETIC, RESOLVED HERE AND NOT IN THE RENDERER. ceStateModifier
            // loads equipped entities, so it is async and a render path cannot call it --
            // the same constraint that put conds.lines on the projection before it. Showing
            // the parts rather than the total is the point: a roll the player cannot check
            // is a roll they have to trust, and this system is meant to be inspectable.
            for (var smi = 0; smi < states.rows.length; smi++) {
                if (!states.rows[smi].modifier) continue;
                try {
                    var mres = await ceStateModifier(cfg, char, states.rows[smi].defId);
                    states.rows[smi].modTotal = mres.total;
                    states.rows[smi].modParts = mres.parts;
                } catch (eMod) { /* non-fatal: the row falls back to its bare value */ }
            }
            // [F-11] Which terminal would actually fire. Per-row `terminal` says a row is AT
            // one; this says which of them WINS, and they are different questions the moment
            // two states bottom out together.
            var twin = ceStateTerminalFor(cfg, char);
            states.terminal = twin ? { defId: twin.def.id, name: twin.def.name, note: twin.term.note } : null;
        } catch (eSt) { api.v1.error('[AE:jsxprofile] states read failed:', eSt); }

        ceProfileStore.set({ ready: true, charId: charId, p: payload || null, tiers: tiers,
                             cfg: cfg || null, roster: roster, vocabSpecies: vocabSpecies,
                             equip: equip, states: states,
                             dynRank: dynRank, places: places,
                             // [SEC:SCHED] The schedule drill resolves "which plan is today"
                             // against this. Published rather than read in the renderer
                             // because a renderer cannot await.
                             clockT: await ceClockLoad() });
    } catch (e) {
        // Previous value survives a failed publish — stale beats blank.
        api.v1.error('[AE:jsxprofile] publish failed:', e);
    }
}

// -- The character-storage chain  [PROFILE-CHAIN-GAP] ---------------
// CharacterRecord storage had NO equivalent of ceEntityOp (SECTION 36): every writer
// on it was a bare load-modify-save, and two commits landing close together could
// silently discard one -- the identical failure ceEntityOp already prevents for
// entities. This is that same chain for character storage. ONE FIXED GLOBAL ORDER
// where a verb needs both: ceEntityOp OUTER, ceProfileOp INNER, never the reverse --
// see ceProfileEquipSet/EquipAdd/EnsureBody below, the only three that do.
//
// A GENERATION MUST NEVER RUN INSIDE THIS CHAIN. ceProfileScanHook holds a model call
// between its load and its save; only its tail (from the second load onward) is
// wrapped. ceProfileGenField needs no change at all -- it already delegates its write
// to ceProfileWrite, so it is chained for free.
var _ceProfChain: Promise<any> = Promise.resolve();
function ceProfileOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceProfChain.then(fn);
    _ceProfChain = run.catch(function() { return null; });
    return run;
}

// -- The single write path from this surface ---------------------------------
// Load, route through applyCharFieldValue, save, republish. One function so the
// lorebook sync and roster refresh saveCharacter performs cannot be forgotten
// by a second caller, which is the same reason AE_SAVE_CHAR_FIELD and
// AE_STUDIO_COMMIT both funnel through applyCharFieldValue rather than writing
// the record themselves.
// [PROFILE-LORE] EVERY PROFILE COMMIT NOW RE-WRITES THE LOREBOOK ENTRY, which
// it did not before and which is the whole bug. saveCharacter writes the index, the story
// storage record and a bridge broadcast, AND NOTHING ELSE -- it has never touched the
// lorebook. syncLorebookEntry exists and is correct, but every one of its callers is a
// bridge message handler or the sync-all sweep; the jsx profile surface, which is now the
// only way anyone edits a character, was not among them. So edits landed on the record and
// the lorebook kept serving whatever it was built with, indefinitely.
//
// COMMIT-SCOPED, which is the granularity asked for: ceField commits on blur, so this
// fires when a field is left, not per keystroke. Both write paths go through here.
//
// SILENT AND NON-FATAL. `silent` is true because a toast per field would be unusable, and
// the catch is deliberate -- a lorebook that cannot be written must not lose the character
// edit that was already saved a line above. syncLorebookEntry no-ops on an unlinked
// character by itself (it returns early on a missing lorebookEntryId), so the guard here is
// belt-and-braces rather than the real check.
// [PASS-B LORE-SCOPE] WHY ONLY THE TWO GENERIC WRITE PATHS CALL THIS. buildLorebookContent
// reads exactly: name, species, gender, age, occupationRole, physicalDescription,
// personalityCore, voiceAndMannerisms, background, coreValues, customFieldValues -- plus
// name + nicknames as the trigger keys. Every one of those is reachable ONLY through
// applyCharFieldValue, so ceProfileWrite and ceProfileWritePair are the only verbs that
// can invalidate an entry. Equipment, location, conditions, hooks, tiers and image slots
// touch nothing the entry contains and correctly do not call this. THE RULE: if you add a
// field to buildLorebookContent, check whether a verb outside those two can write it.
async function _ceSyncProfileLore(c: any): Promise<void> {
    try {
        if (c && c.id && c.lorebookEntryId) await syncLorebookEntry(c.id, true);
    } catch (eLore) { aeLog('[AE:jsxprofile] lorebook sync failed (non-fatal):', eLore); }
}

// [PASS-B SCENE-STALE] THE FOUR KEYS THAT ALSO LIVE ON ANOTHER SURFACE. cePublishScene
// projects name, briefDescription, occupationRole (as `role`) and pattern onto every
// scene card; all four are writable from this surface and neither write path republished
// Scene, so an identity edit left the card stale until an unrelated event repainted it.
// A LIST, NOT A BLANKET REPUBLISH: Scene is the most expensive publish reachable from
// here and thirty of the writable keys do not appear on it. Add to this list when you
// add a field to cePublishScene's character projection -- that is the pairing.
var CE_SCENE_KEYS: string[] = ['name', 'briefDescription', 'occupationRole', 'pattern'];
async function _ceRepublishScene(key: string): Promise<void> {
    if (CE_SCENE_KEYS.indexOf(key) < 0) return;
    try { await cePublishScene(); } catch (eS) { aeLog('[AE:jsxprofile] scene republish failed:', eS); }
}

async function ceProfileWrite(charId: string, key: string, value: any): Promise<void> {
    // [D-01] INTERCEPTED BEFORE THE RECORD IS LOADED. Every other flag is a field on the
    // character in hand; this one is a story-wide pointer whose write has to sweep the
    // whole roster to clear the previous holder, so it cannot be expressed as
    // applyCharFieldValue's "mutate this record, save it" shape. Routed here rather than
    // given its own verb because the chip that calls it is an ordinary flag chip and
    // should stay one.
    if (key === 'flag.isProtagonist') {
        await setProtagonist(value ? String(charId) : '');
        await cePublishProfile(charId).catch(function() {});
        await _ceRepublishScene(key).catch(function() {});
        return;
    }
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            var ok = applyCharFieldValue(c, key, value);
            if (!ok) { api.v1.error('[AE:jsxprofile] unrouted field key: ' + key); return; }
            await saveCharacter(c);
            await _ceSyncProfileLore(c);
            await cePublishProfile(charId);
            await _ceRepublishScene(key);
        } catch (e) { api.v1.error('[AE:jsxprofile] write failed:', e); }
    });
}

// [PICKER] THE PAIRED WRITE. CE-STYLE SS13 requires a reference's id and its
// denormalized name to be written IN THE SAME COMMIT, and until now Position wrote them
// through two sequential ceProfileWrite calls -- two full load/apply/save/publish round
// trips, with a window between them where the record held an id and the previous name.
// This is that same act done once. It is NOT a general batch helper and should not grow
// into one: it exists because a reference is two fields of ONE fact.
async function ceProfileWritePair(charId: string, pairs: any[]): Promise<void> {
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            for (var i = 0; i < (pairs || []).length; i++) {
                var ok = applyCharFieldValue(c, pairs[i].k, pairs[i].v);
                if (!ok) { api.v1.error('[AE:jsxprofile] unrouted field key: ' + pairs[i].k); return; }
            }
            await saveCharacter(c);
            await _ceSyncProfileLore(c);
            await cePublishProfile(charId);
            for (var j = 0; j < (pairs || []).length; j++) await _ceRepublishScene(pairs[j].k);
        } catch (e) { api.v1.error('[AE:jsxprofile] paired write failed:', e); }
    });
}

async function ceProfileSetTier(charId: string, axis: string, tier: number): Promise<void> {
    // Takes the BARE axis word. Position resolves to position_<targetId> here,
    // engine-side, exactly as the AE_SET_PRESSURE handler does — the UI never
    // sends a resolved key, because it has no business knowing the target id.
    //
    // [HOOK-MIRROR] HOOK WRITES BOTH HALVES. This function's old note said it
    // "never calls saveCharacter" because the write lands in historyStorage. True for
    // pursuit and position, whose injection builders read historyStorage directly — and
    // wrong for hook, which is the one axis with a RECORD MIRROR (UnresolvedHook
    // .pressureLevel) and the one the injection builders read from the record. Moving only
    // the key made the stepper cosmetic: the bar moved, the tier label moved, and what
    // actually reached context did not change until the next escalator pass happened to
    // rewrite the mirror. So the mirror moves here too, in the same load/save.
    // [F-17b] SET INSIDE THE LOCK, ACTED ON OUTSIDE IT. Raising the terminus reads a
    // character and writes tempStorage, and holding the profile lock across that is what
    // stateSet's own terminal block already refuses to do for the same reason.
    var _ptRaise = '';
    await ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            var ax = axis;
            if (axis === 'position') {
                var pos: any = c ? c.position : null;
                var tid = pos ? String(pos.targetId || '') : '';
                if (!tid) return;
                ax = 'position_' + tid;
            }
            var prevTier = await _ceReadPressure(charId, ax);
            var clamped = Math.max(_ceAxisFloor(ax), Math.min(4, Number(tier) || 0));
            await api.v1.historyStorage.set(_cePressureKey(charId, ax), clamped);
            // CROSSING, NOT OCCUPANCY, word for word the rule stateSet states: it fires when
            // the value ARRIVES at the bound and not again while it sits there, so nudging
            // +4 -> +4 does not re-raise a question already asked.
            if (axis === 'position' && clamped !== prevTier && (clamped <= -4 || clamped >= 4)) {
                _ptRaise = ax;
            }
            if (ax === 'hook' && c && c.hook) {
                c.hook.pressureLevel = clamped;
                await saveCharacter(c);
            }
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] tier write failed:', e); }
    });
    if (_ptRaise) {
        try {
            await _cePositionTerminusRaise(charId, _ptRaise);
            // THE QUESTION IS ASKED ON THE ACTIONS PANEL, which the author is not looking at
            // -- they are on this profile. Without the toast the crossing is silent from
            // here, which is indistinguishable from the bug this patch fixes.
            try { api.v1.ui.toast('That standing has reached its limit \u2014 the Actions panel is '
                + 'asking whether to rewrite it.', { type: 'info', autoClose: 5000 }); } catch (eTs) {}
            await cePublishActions();
        } catch (ePt) { api.v1.error('[AE:position] stepper terminus:', ePt); }
    }
}

// -- Equipment verbs  [PHASE-F] --------------------------------------
// ALL THREE RUN INSIDE ceEntityOp, WHICH LIVES IN SECTION 36 AND IS NOT A LAYERING
// MISTAKE. That chain serialises ENTITY STORAGE, not the Entity surface. Entity records
// are load-modify-save with no compare-and-swap, so a second, surface-local chain here
// would be two queues over one store -- which is not serialisation at all, it is two
// writers that happen to each be orderly. The Profile is simply the second surface that
// writes entities; it joins the existing queue rather than starting a rival one.
//
// aeSetEquip IS THE ONLY EQUIP VERB, here as everywhere. It moves BOTH halves of the fact
// (the item's isEquipped/equippedToCharId AND the character's equippedItemIds), and
// EQUIP-STATE-SYNC is the autopsy of what writing only one of them cost: equipping from
// the character sheet never reached the bridge's "append equipped items" prompt feature,
// silently, for several versions.
//
// [PROFILE-CHAIN-GAP] ALSO ENTERS ceProfileOp NOW, NESTED INSIDE ceEntityOp --
// entity outer, profile inner, never the reverse. All three write a character record
// too (aeSetEquip saves the owner it is given; EnsureBody saves the character
// directly), so once ceProfileOp existed, leaving these three outside it would be a
// second writer bypassing the new chain -- exactly what having two chains was supposed
// to prevent. Fixed order everywhere is what makes this safe: nothing anywhere ever
// acquires profile-then-entity, so the two chains cannot deadlock against each other.
// [PASS-B EQUIP-SPLIT] THE BOUNDARY, stated once. aeSetEquip is the DURABLE write and owns
// both sides of the fact -- the item's isEquipped/equippedToCharId and the character's
// equippedItemIds -- reloading each record fresh so it is safe from any caller. This is the
// SURFACE wrapper: it adds the lock order (entity outer, profile inner) and the republish,
// and owns no state of its own. Anything that equips outside a surface calls aeSetEquip
// directly and is correct to.
async function ceProfileEquipSet(charId: string, itemId: string, on: boolean): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                var it: any = await loadEntity(itemId);
                if (!c || !it) return;
                await aeSetEquip(it, c, !!on);
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] equip set failed:', e); }
        });
    });
}

// ADDING AN ITEM IS A MOVE, AND A MOVE CAN STEAL. surface_list line 20 asks for "ability
// to select items to add", and the item picked may currently be WORN BY SOMEONE ELSE.
// Reparenting it without taking it off them first leaves the previous owner's
// equippedItemIds still listing it and the item's own equippedToCharId still naming them
// -- the exact shape of EQUIP-STATE-SYNC, arrived at from the other direction. So the
// unequip runs FIRST, through aeSetEquip with the PREVIOUS owner passed, and the record is
// re-read afterwards because aeSetEquip loads and saves its own copy.
// IT LANDS CARRIED, NOT WORN. Moving a thing into someone's hands and putting it on them
// are two decisions, and the toggle is right there.
async function ceProfileEquipAdd(charId: string, itemId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                if (!c || !c.entityId) return;
                var it: any = await loadEntity(itemId);
                if (!it) return;
                var prevId = String(it.equippedToCharId || '');
                if (prevId && prevId !== charId) {
                    var prev: any = await loadCharacter(prevId);
                    if (prev) {
                        await aeSetEquip(it, prev, false);
                        it = await loadEntity(itemId);
                        if (!it) return;
                    }
                }
                it.parentId = String(c.entityId);
                await saveEntity(it);
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] equip add failed:', e); }
        });
    });
}

// -- Where a character stands  [CHAR-PLACE] --------------------------
// A CHARACTER'S LOCATION IS THEIR BODY'S parentId AND NOTHING ELSE. buildCharMeta's own
// comment says so ('This is the single source of truth for character location \u2014 not a
// stored field'), so this moves the body and lets everything downstream re-derive.
//
// saveCharacter IS CALLED EVEN THOUGH NO CHARACTER FIELD CHANGED, and that is the whole
// point of it being here rather than a bare ceEntityWrite on the body. buildCharMeta reads
// the body's parentId to fill meta.currentLocationId, and it runs inside saveCharacter --
// so moving a body WITHOUT saving the character leaves the index claiming the old room.
// Two readers already depend on that field (the Entity surface's presentChars, and the Map
// readout added this pass), and both would have gone quietly stale. This is also a latent
// bug in ceEntityWrite(bodyId, 'parentId') from the Entity surface, which is recorded in
// CE-INDEX rather than fixed here: fixing it means teaching the entity chain that some
// entities are bodies, which is a bigger change than this verb.
//
// recalculateScenePresence AFTER, NOT scenePresent DIRECTLY. aeRemoveCharFromScene's header
// is the reference for why: scenePresent is DERIVED from body-vs-camera co-location and is
// recomputed on ten paths, so asserting it here would be undone by the next recalculation.
// Moving the body expresses the intent in the terms presence is derived from.
async function ceProfileSetLocation(charId: string, locId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                if (!c || !c.entityId) return;
                var body: any = await loadEntity(String(c.entityId));
                if (!body) return;
                // '' means nowhere -- the same detached state aeRemoveCharFromScene uses,
                // and the same one getEffectiveRoomId reads as null.
                body.parentId = String(locId || '') || null;
                await saveEntity(body);
                await saveCharacter(c);
                await recalculateScenePresence();
                await cePublishProfile(charId);
                try { await cePublishScene(); } catch (eS) {}
                try { await cePublishMap(); } catch (eM) {}
            } catch (e) { api.v1.error('[AE:jsxprofile] set location failed:', e); }
        });
    });
}

// -- Death  [KILL] ----------------------------------------------------
// killCharacter RESTORED. It was lost in a strip pass and its bridge door (AE_DELETE_CHAR,
// labelled "Kill Character") had meanwhile been repointed at confirmDeleteChar -- so the
// engine's only remaining verb for a death was a DELETION, which is a different act with a
// different outcome and no way back from it.
//
// FOUR THINGS HAPPEN, IN THIS ORDER, AND THE ORDER IS THE CONTRACT:
//   1. INVENTORY DROPS IN THE ROOM THEY DIED IN. Read the body's parentId BEFORE the body
//      moves, or every possession follows the corpse to the graveyard. Falling back to the
//      camera room covers a character killed while detached from the world.
//   2. equippedItemIds CLEARED. The items have new parents now; leaving the id list behind
//      would have a corpse still wielding things it is not holding, which is exactly the
//      EQUIP-STATE-SYNC split (worn vs held) getting out of step again.
//   3. active = false, scenePresent = false. Same flag the Settings toggle writes -- there
//      is deliberately NO separate `deceased` field. Death is expressible in what already
//      exists (inactive + body in the graveyard), and a second boolean would be a second
//      answer to "is this character in play" for the five readers of the first one.
//   4. BODY TO THE GRAVEYARD, created lazily and found by STORED ID. The old version
//      matched name === 'Graveyard', which made a second graveyard the moment anyone
//      renamed the first; cfg.graveyardEntityId cannot drift. mapKind 'hidden' keeps it off
//      the map and out of every parent's size (see CE_MAP_KINDS).
//
// THE GRAVEYARD IS THE WAY BACK, and that is why this is not a deletion. An inactive
// character is dropped from the Scene roster and the chat contacts, so without a place to
// stand they would be unreachable from any surface. _ceEntityContents does NOT filter on
// active, so Map > Hidden places > Graveyard lists them and their profiles are one tap
// away -- where the Active toggle undoes this.
//
// WRAPPED IN THE CHAIN. It writes entity storage and character storage in one act, so it
// takes the fixed global order this file already settled: ceEntityOp OUTER, ceProfileOp
// INNER, the same as ceProfileEquipAdd above.
async function killCharacter(charId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var char: any = await loadCharacter(charId);
                if (!char) return;
                var name = String(char.name || 'They');

                if (char.entityId) {
                    var allEnts: any[] = await loadEntityIndex();
                    var body: any = await loadEntity(String(char.entityId));
                    if (body) {
                        // Step 1 -- read the death room off the body BEFORE it moves.
                        var dropRoomId: any = body.parentId;
                        if (!dropRoomId) {
                            try { dropRoomId = await loadProtagonistLocation(); } catch (eL) { dropRoomId = null; }
                        }
                        // AE_ROOT_LOCATION_ID is a sentinel with no record behind it, so
                        // parenting loot to it would file items somewhere nothing can list.
                        if (dropRoomId === AE_ROOT_LOCATION_ID) dropRoomId = null;
                        // [PASS-B KILL-ORPHAN] Clearing the list is conditional on the items
                        // having somewhere to go. It was not, so a body with no resolvable drop
                        // room left items parented to the corpse and absent from the equip list:
                        // neither carried nor dropped, and invisible once the body was filed.
                        // The item's OWN equip state is unset here too -- aeSetEquip writes both
                        // sides and this path only ever wrote one.
                        if (dropRoomId) {
                            for (var li = 0; li < (allEnts || []).length; li++) {
                                var lm: any = allEnts[li];
                                if (!lm || String(lm.parentId || '') !== String(char.entityId)) continue;
                                var lit: any = await loadEntity(String(lm.id));
                                if (lit) {
                                    lit.parentId = String(dropRoomId);
                                    lit.isEquipped = false;
                                    lit.equippedToCharId = undefined;
                                    await saveEntity(lit);
                                }
                            }
                            char.equippedItemIds = [];   // step 2
                        }
                    }
                }

                char.active = false;                 // step 3
                char.scenePresent = false;
                await saveCharacter(char);

                if (char.entityId) {                 // step 4
                    var gyId = await ceEnsureGraveyard();
                    if (gyId) {
                        var gyBody: any = await loadEntity(String(char.entityId));
                        if (gyBody) { gyBody.parentId = gyId; await saveEntity(gyBody); }
                        // saveCharacter AGAIN, deliberately: the body moved after the first
                        // one, so meta.currentLocationId still points at the death room.
                        // See ceProfileSetLocation for why that field cannot be left stale.
                        var fresh: any = await loadCharacter(charId);
                        if (fresh) await saveCharacter(fresh);
                    }
                }

                // [PASS-B DECEASED] The one write on this surface outside ceProfileWrite that
                // invalidates the lorebook entry: `active` is now a field buildLorebookContent
                // reads. Without this the entry keeps serving a living description keyed on a
                // dead character's name.
                await _ceSyncProfileLore(char);
                await recalculateScenePresence();
                try { await cePublishScene(); } catch (eS) { aeLog('[AE] kill: scene publish failed:', eS); }
                try { await cePublishMap(); } catch (eM) { aeLog('[AE] kill: map publish failed:', eM); }
                await cePublishProfile(charId);
                try { api.v1.ui.toast('\ud83d\udc80 ' + name + ' \u2014 deceased.', { type: 'warning', autoClose: 2600 }); } catch (eT) {}
            } catch (e) { api.v1.error('[AE] killCharacter:', e); }
        });
    });
}

// The graveyard, resolved or made. Returns '' only if creation itself failed.
// NOT wrapped in ceEntityOp -- its only caller is already inside one, and re-entering a
// chain from inside itself is the deadlock ceChatOp's own hazard note warns about.
async function ceEnsureGraveyard(): Promise<string> {
    try {
        var cfg: any = await loadConfig();
        var gid = String(cfg.graveyardEntityId || '');
        if (gid) {
            var exists: any = await loadEntity(gid);
            // A stored id whose entity the author deleted falls through and is remade,
            // the same self-healing ensureJournalEntry does for a deleted lore entry.
            if (exists) return gid;
        }
        var gy: any = makeDefaultEntity('Graveyard');
        gy.type = 'location';
        gy.parentId = null;
        gy.mapKind = 'hidden';
        gy.description = 'Where the dead are kept. Not a place in the world \u2014 a place the engine files bodies into so nothing is ever lost.';
        await saveEntity(gy);
        await mutConfig(function(c: any) { c.graveyardEntityId = String(gy.id); });
        return String(gy.id);
    } catch (e) {
        api.v1.error('[AE] ceEnsureGraveyard:', e);
        return '';
    }
}

// THE BODY REPAIR, PORTED. The native Settings tab has had this since earlier and the jsx
// Profile never got it, which was survivable only while the native modal was still
// reachable. It is not a nicety: without a body entity a character cannot hold anything at
// all, and the Equipment drill would otherwise be a dead end whose only exit is a surface
// this collapse is retiring. Same three writes the native button makes, in the same order.
async function ceProfileEnsureBody(charId: string): Promise<void> {
    return ceEntityOp(function() {
        return ceProfileOp(async function() {
            try {
                var c: any = await loadCharacter(charId);
                if (!c) return;
                // [ENT-ID1] THE BODY LIVES AT THE CHARACTER'S OWN ID, so this asks one
                // question where it used to ask two. The old "id set but entity gone" and
                // "no id at all" cases collapse further than they already had: there is
                // exactly one address a body can be at, so either it is there or it is not.
                //
                // THE POINTER-REPAIR CASE SURVIVES ANYWAY and is the reason this is not a
                // one-liner: a record imported from a pre-ENT-ID1 bundle can arrive with
                // entityId naming some other id. That is not a body to keep -- the graph
                // that gave it meaning did not come with it -- so it is dropped, not chased.
                var existing: any = await loadEntity(charId);
                if (existing) {
                    if (String(c.entityId || '') !== charId) {
                        c.entityId = charId;
                        await saveCharacter(c);
                        await cePublishProfile(charId);
                    }
                    return;
                }
                var body: any = makeDefaultEntity(c.name || 'Unnamed');
                body.id = charId;
                body.type = 'character';
                body.parentId = null;
                await saveEntity(body);
                var fresh: any = await loadCharacter(charId);
                if (!fresh) return;
                fresh.entityId = charId;
                await saveCharacter(fresh);
                await cePublishProfile(charId);
            } catch (e) { api.v1.error('[AE:jsxprofile] body repair failed:', e); }
        });
    });
}

// -- States drill  [SEC:STATE] ------------------------------------------------
// THE DISPLAY DOOR of the two the state core needs. Shows every def scoped to this
// character with its number and its band label, editable.
//
// [D-20] THE NUMBER IS ALWAYS SHOWN AND THERE IS NO SWITCH TO HIDE IT. The engine needs
// numbers, the author needs numbers, and the model must never see one because a number
// visible to the model gets imitated. That is settled by WHERE each is rendered, not by a
// per-def visibility flag -- so there is no such flag to get wrong.
//
// ONE CONTROL FOR EVERY DEF, deliberately, and it is a number field rather than a select
// over bands. A select can only address band floors, so it cannot express 43 out of 100,
// and Currency has no bands at all -- one control that works for both beats two controls
// chosen by a shape test, which is the gauge/track split reappearing in the UI. The
// -/+ pair beside it commits through stateNudge rather than reading the field and adding:
// a delta re-reads inside the verb, so two taps landing together cannot lose one.
//
// THE BAND LABEL IS SHOWN AS PROSE UNDER THE FIELD and is dimmed at rest. A resting value
// says nothing to the model (D-22) and the surface says so quietly rather than hiding the
// label, because "unhurt" is still the true reading of 100 health.
//
// TWO EMPTY STATES, NOT ONE. A world with no defs at all is sent to Settings; a world with
// defs none of which are scoped here is told that, because those are different problems
// and one message for both would be wrong half the time.
// ── PROFILE DRILL: Schedule  [SEC:SCHED] ─────────────────────────────────────────
// WHERE THEY ARE WHEN THE STORY IS NOT WATCHING. A drill and not a tab, because Profile has
// no tabs -- Equipment, States and Images are all drills and this is their sibling.
//
// THREE BLOCKS, AND THE ORDER IS THE ORDER SOMEBODY CHECKS THEM IN:
//   1. TODAY. The resolved plan, the current stop, and WHICH RULE WON. That last line is the
//      audit for first-match-wins (T-11) and is the reason the model can be ordered rather
//      than a cascade -- an author who can read the answer does not need to reason about
//      precedence.
//   2. THE PLANS, each one a day drawn with ceDayStrip and a list of stops under it.
//   3. THE RULES, ordered, with the matching one marked.
//
// EVERY WRITE GOES THROUGH _ceSchedMut, which loads, mutates and saves in ceProfileOp -- the
// chain every other character write on this surface already runs on.
//
// [ATMO] TWO OWNERS, ONE MUTATOR. `kind` is 'char' or 'loc' and decides which pair of
// load/save verbs runs; everything between them is identical, which is the whole reason
// this is one function. A location writes through saveEntity DIRECTLY and that is correct
// here even though the file's KNOWN STALENESS note warns against bare entity writes: that
// warning is about parentId on a character's BODY, where CharacterMeta.currentLocationId
// is a second copy that goes stale. `schedule` on a location has no meta mirror and no
// second reader, so there is nothing for a save to desynchronise.
function _ceSchedMut(kind: string, ownerId: string, fn: (sch: CharSchedule) => void): Promise<any> {
    var isLoc = (String(kind) === 'loc');
    // EACH OWNER WRITES ON ITS OWN SURFACE'S CHAIN. These are two independent serialisers,
    // and putting a location edit on the profile chain would make it queue behind character
    // writes it shares no record with -- correct by accident today, wrong the moment either
    // chain grows a latch the other does not have.
    var op: any = isLoc ? ceEntityOp : ceProfileOp;
    return op(async function() {
        try {
            var rec: any = isLoc ? await loadEntity(ownerId) : await loadCharacter(ownerId);
            if (!rec) return;
            // MATERIALISED ON FIRST EDIT AND NEVER ON LOAD, the rule cfg.calendar follows one
            // system over: a load-time default is what resurrects a key after anything
            // removes it.
            var sch: any = ceSchedOf(rec) || ceSchedBlank();
            fn(sch);
            rec.schedule = sch;
            if (isLoc) {
                await saveEntity(rec);
                await cePublishEntity(ownerId);
                // NO MAP REPUBLISH. The map draws where bodies are; an atmosphere moves
                // nobody, so there is nothing on it that could have changed.
            } else {
                await saveCharacter(rec);
                await cePublishProfile(ownerId);
                try { await cePublishMap(); } catch (eM) {}
            }
        } catch (e) { api.v1.error('[AE:sched] write failed:', e); }
    });
}

function _ceSchedNewId(pfx: string): string {
    return pfx + '_' + String(Date.now()) + '_' + String(Math.floor(Math.random() * 1000));
}

// [ATMO] CE_SCHED_MODES OWNS EVERY STRING THAT DIFFERS, and nothing else in this function
// forks on mode -- the same rule CC_MODES is held to, for the same reason: two timetables
// that differ by a dozen words are one editor with a vocabulary, and the moment a second
// `if (isLoc)` appears in the body they have started becoming two editors again.
// `place` IS THE ONE STRUCTURAL DIFFERENCE and it is a flag here rather than a branch
// elsewhere: a character's stop names where they are, a location's does not, because a
// place cannot travel to itself.
var CE_SCHED_MODES: any = {
    char: {
        kind: 'char',
        place: true,
        none: 'This character keeps no schedule. A schedule says where they are when the story '
            + 'is not watching \u2014 and what they are doing there, which their lorebook entry '
            + 'will say for them. Nothing here ever moves somebody who is in the scene.',
        start: 'Start a schedule',
        onLabel: 'Keep a schedule',
        onHint: 'Where they are off camera. Nothing here moves them while they are in the scene.',
        rowHint: 'doing what\u2026',
        addRow: '+ Add a stop',
        rowWord: ' stops',
        noRows: 'No stops. A plan with none is legal \u2014 it is how you say "off the timetable today".',
        stripEmpty: 'No stops on this plan \u2014 nothing is asserted',
        stripNone: 'No stops',
        offRow: 'Off the timetable right now.',
        nowhere: 'Nowhere in particular'
    },
    loc: {
        kind: 'loc',
        place: false,
        none: 'This place has no atmosphere. Atmosphere is what it is LIKE at a given hour '
            + '\u2014 what is heard, who is about, how it feels \u2014 and it is the one thing '
            + 'about a place that reaches the story. Until one is set the description is used '
            + 'instead, which is exactly how this worked before atmosphere existed.',
        start: 'Give it an atmosphere',
        onLabel: 'Use atmosphere',
        onHint: 'When this is off the place falls back to its description, not to silence.',
        rowHint: 'what it is like at this hour\u2026',
        addRow: '+ Add an hour',
        rowWord: ' hours',
        noRows: 'No hours set. A plan with none is legal \u2014 the description answers instead.',
        stripEmpty: 'No hours on this plan \u2014 the description answers',
        stripNone: 'No hours',
        offRow: 'Nothing set for this hour \u2014 the description is used.',
        nowhere: 'Nothing in particular'
    }
};

// [ATMO] ONE EDITOR, TWO OWNERS. `mode` is a CE_SCHED_MODES key; `ownerId` is a character
// id or an entity id and is only ever handed straight back to _ceSchedMut, which owns the
// load/save pair. `p` is whichever record carries the schedule -- ceSchedOf never asked
// what it was reading. `places` is unused in loc mode and is passed null there.
function _ceProfileScheduleDrill(mode: string, ownerId: string, p: any, cfg: any, places: any, clockT: number, openMap: any): any {
    var M: any = CE_SCHED_MODES[String(mode)] || CE_SCHED_MODES.char;
    var kind: string = M.kind;
    var cal = ceCalendar(cfg);
    var sch = ceSchedOf(p);
    var list: any[] = (places && places.list) || [];
    var nameOf = function(id: string): string {
        for (var i = 0; i < list.length; i++) { if (String(list[i].id) === String(id)) return String(list[i].name || ''); }
        return '';
    };
    // A CHARACTER'S SEGMENT IS LABELLED BY PLACE, A LOCATION'S BY WHAT IT SAYS. Passed to
    // every ceDayStrip below so the strip is legible in both modes -- see its labelOf note.
    var labelOf = function(sg: any): string {
        return M.place ? nameOf(sg.locationId) : String(sg.doing || '');
    };

    if (!sch) {
        return ceStack(CE_T.s3, [
            ceProse('t2', M.none),
            ceBtn(M.start, 'sch:start:' + ownerId, function() {
                return _ceSchedMut(kind, ownerId, function() { /* ceSchedBlank does the work */ });
            }, 'primary')
        ]);
    }

    var res = ceSchedResolvePlan(sch, cal, clockT) || { plan: sch.plans[0], rule: null, index: -1 };
    var segs = ceSchedSegments(res.plan);
    var nowH = ceClockHour(clockT);
    var nowSeg = ceSchedSegAt(segs, nowH);
    var nextFrom = -1;
    for (var si = 0; si < segs.length; si++) { if (segs[si].from > nowH) { nextFrom = segs[si].from; break; } }

    var kids: any[] = [];

    kids.push(ceSettingRow(M.onLabel, M.onHint,
        ceToggle(!!sch.enabled, 'sch:en:' + ownerId, function() {
            return _ceSchedMut(kind, ownerId, function(s: any) { s.enabled = !s.enabled; });
        })));

    // ── 1. Today ────────────────────────────────────────────────────────────────
    // THE `why` LINE IS THE AUDIT and is not decoration. It is what lets the rule list be an
    // ordered list rather than a precedence system nobody can check.
    kids.push(ceSection('Today', ceStack(CE_T.s2, [
        h('div', { style: { fontSize: CE_T.fs, fontWeight: '600' } }, String(res.plan.name || '')),
        // THE READOUT IS THE SEGMENT IN WORDS. In char mode that is a place and then what
        // they are doing in it; in loc mode there is no place, so the atmosphere text IS
        // the readout and doubling it would print the same sentence twice.
        ceSub('t2', nowSeg
            ? ((M.place
                    ? ((nameOf(nowSeg.locationId) || M.nowhere)
                       + (nowSeg.doing ? (' \u2014 ' + nowSeg.doing) : ''))
                    : (String(nowSeg.doing || '').trim() || M.nowhere))
               + (nextFrom >= 0 ? ('  \u00b7  until ' + _cePad2(nextFrom) + ':00')
                                : '  \u00b7  for the rest of the day'))
            : M.offRow),
        // [T-19] THREE ANSWERS, NOT TWO. The pin is checked before the rules, so the audit
        // has to be able to say so -- a pinned day that printed "no rule matched" would
        // read as the standing day and send the author hunting through a rule list that
        // never ran.
        ceMono(res.pinned
            ? ('pinned \u2014 ' + String(res.plan.name || '') + ' answers every hour until cleared')
            : (res.rule
                ? ('rule ' + String(res.index + 1) + ' of ' + String(sch.rules.length)
                   + ' matched \u2014 ' + ceSchedRuleLabel(cal, res.rule))
                : 'no rule matched \u2014 falls to the standing day'), { opacity: CE_OP.t3 }),
        // THE STRIP AND ITS MARKER SHARE ONE RELATIVE HOST, and the host carries the
        // paddingTop that gives the marker's flag room -- see ceDayNow.
        h('div', { style: { position: 'relative', paddingTop: '14px' } },
            ceDayStrip(segs, { nameOf: nameOf, labelOf: labelOf, nowHour: nowH,
                               emptyTitle: M.nowhere, emptyLabel: M.stripEmpty }),
            ceDayRuler(),
            ceDayNow(clockT, {})
        )
    ])));

    // ── 2. The plans ────────────────────────────────────────────────────────────
    var planKids: any[] = [];
    for (var pi = 0; pi < sch.plans.length; pi++) {
        (function(plan: DayPlan, idx: number) {
            var accId = 'sch:plan:' + ownerId + ':' + plan.id;
            var pSegs = ceSchedSegments(plan);
            var stopKids: any[] = [];
            var hourOpts: any[] = [];
            for (var hh = 0; hh < CE_HOURS_DAY; hh++) {
                hourOpts.push({ id: String(hh), label: _cePad2(hh) + ':00' });
            }
            var sorted = (plan.rows || []).slice().sort(function(a: any, b: any) { return a.fromHour - b.fromHour; });
            for (var ri = 0; ri < sorted.length; ri++) {
                (function(row: any) {
                    // KEYED ON THE ROW'S OWN START HOUR AND PLACE, not on its index. Rows sort
                    // on read, so an index is a moving target the moment somebody changes an
                    // hour -- and a moving key on a stack of identical shapes is
                    // TABBODY-RECYCLE with different furniture.
                    var rowKey = 'sch:stop:' + plan.id + ':' + String(row.fromHour) + ':' + String(row.locationId);
                    stopKids.push(ceStack({ gap: CE_T.s1, key: rowKey }, [
                        // [ROW-PROSE / CE-STYLE 8c] THE `doing` FIELD IS ITS OWN ROW. An hour
                        // select, a place picker, a text field and a delete verb in one row is
                        // the shape that produced a column of single letters on a phone.
                        ceBar({ gap: CE_T.s2 }, [
                            ceFixed({ basis: '92px' }, [ ceSelect({
                                k: rowKey + ':h', value: String(row.fromHour), options: hourOpts,
                                onCommit: function(v: string) {
                                    return _ceSchedMut(kind, ownerId, function(s: any) {
                                        var pl = ceSchedPlanById(s, plan.id); if (!pl) return;
                                        for (var q = 0; q < pl.rows.length; q++) {
                                            if (pl.rows[q].fromHour === row.fromHour
                                                && pl.rows[q].locationId === row.locationId) {
                                                pl.rows[q].fromHour = _ceHourSafe(v); return;
                                            }
                                        }
                                    });
                                } })]),
                            // [ATMO] THE PLACE CELL IS THE ONE STRUCTURAL FORK, and it is
                            // absent rather than disabled in loc mode: a row that offers to
                            // move a place somewhere is a question with no answer. The hour
                            // select then grows into the space on its own, because ceBar
                            // distributes what is actually there.
                            M.place
                                ? ceGrow(null, [ ceBtn(nameOf(row.locationId) || 'Somewhere\u2026',
                                    rowKey + ':where', function() {
                                        cePickerOpen('schedStop', { charId: ownerId, planId: plan.id,
                                                                    fromHour: row.fromHour,
                                                                    locationId: row.locationId });
                                        return Promise.resolve();
                                    }) ])
                                : ceGrow(null, []),
                            ceIconBtn('Remove this row', ceIconTrash(), rowKey + ':rm', function() {
                                return _ceSchedMut(kind, ownerId, function(s: any) {
                                    var pl = ceSchedPlanById(s, plan.id); if (!pl) return;
                                    for (var q = 0; q < pl.rows.length; q++) {
                                        if (pl.rows[q].fromHour === row.fromHour
                                            && pl.rows[q].locationId === row.locationId) {
                                            pl.rows.splice(q, 1); return;
                                        }
                                    }
                                });
                            }, 'danger')
                        ]),
                        h(ceField, {
                            k: rowKey + ':doing', label: '', placeholder: M.rowHint,
                            value: String(row.doing || ''),
                            seed: rowKey + ':' + String(row.doing || ''),
                            onCommit: function(v: string) {
                                return _ceSchedMut(kind, ownerId, function(s: any) {
                                    var pl = ceSchedPlanById(s, plan.id); if (!pl) return;
                                    for (var q = 0; q < pl.rows.length; q++) {
                                        if (pl.rows[q].fromHour === row.fromHour
                                            && pl.rows[q].locationId === row.locationId) {
                                            pl.rows[q].doing = v; return;
                                        }
                                    }
                                });
                            }
                        })
                    ]));
                })(sorted[ri]);
            }
            if (!sorted.length) {
                stopKids.push(ceSub('t3', M.noRows, { key: 'sch:nostops:' + plan.id }));
            }
            stopKids.push(ceWrap({ key: 'sch:addstop:' + plan.id }, [
                ceBtn(M.addRow, 'sch:addstop:' + plan.id, function() {
                    return _ceSchedMut(kind, ownerId, function(s: any) {
                        var pl = ceSchedPlanById(s, plan.id); if (!pl) return;
                        var lastH = pl.rows.length ? _ceHourSafe(pl.rows[pl.rows.length - 1].fromHour + 1) : 8;
                        pl.rows.push({ fromHour: lastH, locationId: '', doing: '' });
                    });
                })
            ]));

            // [T-19] THE PIN, AND IT SITS ON EVERY PLAN INCLUDING THE STANDING DAY. Pinning
            // the standing day is not a no-op -- it means "ignore every rule below" -- and
            // excluding it would have been a special case for no gain.
            // ONE FIELD, SO ONE PIN. Turning this on for a second plan moves the pin rather
            // than adding to it, which is why there is no clearing verb anywhere else: the
            // storage shape makes two pins unrepresentable, and T-11 refused to build the
            // precedence rule a second one would need.
            var body: any[] = [
                ceWrap({ key: 'sch:pin:' + plan.id }, [
                    ceSettingRow('Force this on',
                        'Ignores the clock and every rule below until you turn it off. One plan at a time.',
                        ceToggle(String(sch.activePlanId || '') === plan.id,
                                 'sch:pin:' + ownerId + ':' + plan.id, function() {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                if (String(s.activePlanId || '') === plan.id) delete s.activePlanId;
                                else s.activePlanId = plan.id;
                            });
                        }))
                ]),
                h('div', { key: 'sch:strip:' + plan.id, style: { position: 'relative' } },
                    ceDayStrip(pSegs, { nameOf: nameOf, labelOf: labelOf, compact: true,
                                        emptyTitle: M.nowhere, emptyLabel: M.stripNone })),
                ceStack({ gap: CE_T.s3, key: 'sch:stops:' + plan.id }, stopKids)
            ];
            // THE STANDING DAY CANNOT BE RENAMED OR DELETED. plans[0] is the guarantee that
            // resolution terminates; making it editable would put a null check in every reader.
            if (idx > 0) {
                body.push(ceBar({ gap: CE_T.s2, key: 'sch:planverbs:' + plan.id }, [
                    ceGrow(null, [ h(ceField, {
                        k: 'sch:planname:' + plan.id, label: 'Called', value: String(plan.name || ''),
                        seed: 'sch:planname:' + plan.id + ':' + String(plan.name || ''),
                        onCommit: function(v: string) {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                var pl = ceSchedPlanById(s, plan.id); if (pl) pl.name = v;
                            });
                        }
                    })]),
                    // DELETING A PLAN DOES NOT HUNT DOWN ITS RULES. A rule pointing at a plan
                    // that is gone is skipped by ceSchedResolvePlan, so the list stays legible
                    // and the author can see what they orphaned rather than having it vanish.
                    ceIconBtn('Delete ' + (plan.name || 'this plan'), ceIconTrash(),
                        'sch:planrm:' + plan.id, function() {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                for (var q = 0; q < s.plans.length; q++) {
                                    if (s.plans[q].id === plan.id) { s.plans.splice(q, 1); return; }
                                }
                            });
                        }, 'danger')
                ]));
            }

            planKids.push(ceWrap({ key: accId }, [ ceAccordion({
                id: accId, open: !!openMap[accId], label: plan.name || 'Unnamed',
                // [T-19] A PINNED PLAN SAYS SO ON ITS COLLAPSED ROW. It is the one plan
                // whose state cannot be worked out from the rule list below, so the row
                // that is visible without opening anything is where it has to be said.
                meta: (sch.activePlanId === plan.id ? 'PINNED \u00b7 ' : '')
                    + String((plan.rows || []).length) + M.rowWord
                    + (idx === 0 ? ' \u00b7 default' : ''),
                summary: pSegs.length
                    ? pSegs.slice(0, 3).map(function(s2: any) {
                        return _cePad2(s2.from) + ':00 ' + (labelOf(s2) || M.nowhere);
                      }).join('  \u00b7  ')
                    : 'Nothing set yet',
                children: body
            }) ]));
        })(sch.plans[pi], pi);
    }
    planKids.push(ceWrap({ key: 'sch:addplan' }, [
        ceBtn('+ Add a plan', 'sch:addplan:' + ownerId, function() {
            return _ceSchedMut(kind, ownerId, function(s: any) {
                s.plans.push({ id: _ceSchedNewId('pl'), name: 'New plan', rows: [] });
            });
        })
    ]));
    kids.push(ceSection('Plans', ceStack(CE_T.s2, planKids)));

    // ── 3. The rules ────────────────────────────────────────────────────────────
    var ruleKids: any[] = [];
    var planOpts: any[] = [];
    for (var po = 0; po < sch.plans.length; po++) {
        planOpts.push({ id: sch.plans[po].id, label: sch.plans[po].name || 'Unnamed' });
    }
    var wdOpts: any[] = [{ id: '', label: 'Any day' }];
    for (var wi = 0; wi < cal.dayNames.length; wi++) {
        wdOpts.push({ id: String(wi), label: String(cal.dayNames[wi]) });
    }
    var moOpts: any[] = [{ id: '', label: 'Any month' }];
    for (var mi = 0; mi < cal.months.length; mi++) {
        moOpts.push({ id: String(mi), label: String(cal.months[mi].name) });
    }
    for (var qi = 0; qi < sch.rules.length; qi++) {
        (function(rule: PlanRule, idx: number) {
            var rk = 'sch:rule:' + ownerId + ':' + String(idx);
            var matched = (idx === res.index);
            ruleKids.push(ceStack({ gap: CE_T.s2, key: rk }, [
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ ceSelect({
                        k: rk + ':plan', value: String(rule.planId), options: planOpts,
                        onCommit: function(v: string) {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                if (s.rules[idx]) s.rules[idx].planId = String(v);
                            });
                        } })]),
                    ceIconBtn('Move this rule up', ceIconUp(), rk + ':up', function() {
                        return _ceSchedMut(kind, ownerId, function(s: any) {
                            if (idx === 0 || !s.rules[idx]) return;
                            var t = s.rules[idx - 1]; s.rules[idx - 1] = s.rules[idx]; s.rules[idx] = t;
                        });
                    }),
                    ceIconBtn('Move this rule down', ceIconDown(), rk + ':dn', function() {
                        return _ceSchedMut(kind, ownerId, function(s: any) {
                            if (idx >= s.rules.length - 1 || !s.rules[idx]) return;
                            var t = s.rules[idx + 1]; s.rules[idx + 1] = s.rules[idx]; s.rules[idx] = t;
                        });
                    }),
                    ceIconBtn('Delete this rule', ceIconTrash(), rk + ':rm', function() {
                        return _ceSchedMut(kind, ownerId, function(s: any) { s.rules.splice(idx, 1); });
                    }, 'danger')
                ]),
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ ceSelect({
                        k: rk + ':wd',
                        value: (rule.when.weekday === undefined) ? '' : String(rule.when.weekday),
                        options: wdOpts,
                        onCommit: function(v: string) {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                if (!s.rules[idx]) return;
                                // DELETED, NOT SET TO ZERO. "Any day" has to remove the field --
                                // coercing it to 0 would silently narrow the rule to Sunday and
                                // it would still fire, which is the worst way this can fail.
                                if (v === '') delete s.rules[idx].when.weekday;
                                else s.rules[idx].when.weekday = Math.round(Number(v)) || 0;
                            });
                        } })]),
                    ceGrow(null, [ ceSelect({
                        k: rk + ':mo',
                        value: (rule.when.month === undefined) ? '' : String(rule.when.month),
                        options: moOpts,
                        onCommit: function(v: string) {
                            return _ceSchedMut(kind, ownerId, function(s: any) {
                                if (!s.rules[idx]) return;
                                if (v === '') delete s.rules[idx].when.month;
                                else s.rules[idx].when.month = Math.round(Number(v)) || 0;
                            });
                        } })])
                ]),
                ceBar({ gap: CE_T.s2 }, [
                    ceGrow(null, [ ceSub(matched ? 't1' : 't3', ceSchedRuleLabel(cal, rule)) ]),
                    matched ? ceFixed(null, [ ceMono('matched', { opacity: CE_OP.t1 }) ]) : null
                ])
            ]));
        })(sch.rules[qi], qi);
    }
    if (!sch.rules.length) {
        ruleKids.push(ceSub('t3', 'No exceptions. The standing day applies every day.',
                            { key: 'sch:norules' }));
    }
    ruleKids.push(ceWrap({ key: 'sch:addrule' }, [
        ceBtn('+ Add an exception', 'sch:addrule:' + ownerId, function() {
            return _ceSchedMut(kind, ownerId, function(s: any) {
                // SEEDED POINTING AT THE STANDING DAY AND MATCHING NOTHING. A new rule with an
                // empty `when` would match EVERY day and make every rule under it dead the
                // moment it was created, so it is seeded with the first weekday instead.
                s.rules.push({ planId: s.plans.length > 1 ? s.plans[1].id : s.plans[0].id,
                               when: { weekday: 0 } });
            });
        })
    ]));
    kids.push(ceSection('When each applies', ceStack(CE_T.s3, ruleKids)));
    kids.push(ceSub('t3', 'First match wins, top down. Anything not matched falls to the standing day '
        + '\u2014 unless a plan is forced on, which beats all of this.'));

    return ceStack(CE_T.s5, kids);
}

// ── PROFILE DRILL: Schedule ends ─────────────────────────────────────────────────
function _ceProfileStatesDrill(charId: string, p: any, cfg: any, sd: any): any {
    var st: any = sd || { rows: [], hasDefs: false, isProtag: false };
    var rows: any[] = st.rows || [];

    if (!st.hasDefs) {
        return ceStack(CE_T.s3, [
            ceProse('t2',
                'No states exist in this world yet. A state is a bounded number with words '
                + 'attached \u2014 health, coin, standing, how drunk somebody is. They are defined '
                + 'once and then held per character, so the list lives in Settings rather than here.'),
            ceBtn('Define states', 'st:tosettings:' + charId, function() {
                ceNav('settings', '', 'settings:states',
                      { surface: 'profile', entityId: charId, label: p.name || 'Profile' });
                return Promise.resolve();
            }, 'primary')
        ]);
    }

    if (!rows.length) {
        return ceStack(CE_T.s3, [
            ceProse('t2',
                'Every state in this world is scoped to the world, to a faction, or to the '
                + 'protagonist \u2014 none of them is a fact about this character.'),
            ceBtn('Open States settings', 'st:tosettings2:' + charId, function() {
                ceNav('settings', '', 'settings:states',
                      { surface: 'profile', entityId: charId, label: p.name || 'Profile' });
                return Promise.resolve();
            })
        ]);
    }

    // [I-05] ONE SHARED RENDERER. The band prose, the range line and the zebra all moved into
    // ceStateGaugeRow; what stays here is the only thing that is actually this surface's -- the
    // address a value is written to, and the publish that follows it.
    var mkRow = (function(r: any) {
        var did = String(r.defId);
        var refOf = function(): StateRef {
            // scope rides from the projection so this never re-derives it. A 'protagonist' row
            // ignores ownerId inside the verb; passing charId anyway keeps one call shape.
            return { scope: r.scope, ownerId: charId, defId: did };
        };
        var commit = function(): Promise<any> { return cePublishProfile(charId); };
        return ceStateGaugeRow(r, 'st:' + charId,
            function(_d: string, n: number) { return stateSet(refOf(), n).then(commit); },
            function(_d: string, d: number) { return stateNudge(refOf(), d).then(commit); });
    });

    var head: any[] = [];
    if (st.terminal) {
        // [F-11] Stated at the top of the drill rather than only on its row, because a
        // terminal is a fact about the CHARACTER, not about one number: the next roll they
        // make resolves differently and the author should not have to scroll to find out.
        head.push(ceGroup('Terminal reached', ceStack(CE_T.s1, [
            ceSub('t2', String(st.terminal.name) + ' is at a bound. The next roll\u2019s outcome '
                + 'directive is replaced by this:'),
            ceProse('t1', String(st.terminal.note))
        ])));
    }

    // [STYLE2] ceGroup wraps the rows. SS7.2: Field density is a ceKey group head with a
    // full-width rule, then rows.
    // [F-11b] ONE GROUP PER CATEGORY, DERIVED. The surface does not know what categories
    // exist and never needs to: an author who invents "Wounds" gets a Wounds section for
    // free, and one who uses none gets a single "States" group exactly as before.
    // [G-02] SPLIT BEFORE GROUPING. Grouping a hidden row and then dropping it would leave
    // a category heading counting rows nobody can see -- "Wounds (4)" over an empty box.
    var split = ceStateSplitHidden(rows);
    var groups = ceStateGrouped(split.shown, cfg);
    var body: any[] = [];
    for (var gi = 0; gi < groups.length; gi++) {
        (function(grp: any) {
            var kids: any[] = [];
            for (var i = 0; i < grp.rows.length; i++) kids.push(mkRow(grp.rows[i]));
            body.push(ceGroup(grp.category
                ? (grp.category + ' (' + grp.rows.length + ')')
                : ('States (' + grp.rows.length + ')'), ceGaugeGrid(kids)));
        })(groups[gi]);
    }
    var blankFoot: any = _ceStateBlankFooter(split.blank, 'st:' + charId);
    if (blankFoot) body.push(blankFoot);

    return ceStack(CE_T.s3, head.concat(body).concat([
        ceProse('t3',
            'Numbers and bars are shown here and never in the story. What the model can be told '
            + 'is the band\u2019s words \u2014 and only when a value has moved off its resting one.')
    ]));
}

// -- Condition verbs  [PHASE-COND] -----------------------------------
// THESE WRITE THE CHARACTER RECORD, NOT AN ENTITY, so they are shaped like
// ceProfileHookOp (one load, one mutate, one save, one publish) and NOT like the
// equipment verbs -- ceEntityOp would be the wrong queue, not merely an unnecessary one.
// [PROFILE-CHAIN-GAP] Now serialised through ceProfileOp, same as every other
// plain character write.
// -- Image slot actions -------------------------------------------------------
// [IMG-ACTIONS] Four ops, TWO different transports, on purpose:
//   generate  rides the EXISTING EVT_GENERATE_IMAGE channel with kind:'charSlot' —
//             assembleSnapshotImage (a few hundred lines above) is the proven precedent
//             for "engine assembles a prompt from character fields, broadcasts, bridge
//             generates and saves." Reusing it is the handoff's own "match what the
//             bridge already ships rather than reinventing it" rule, applied to itself.
//   delete / download / edit  have no existing inbound-message equivalent (nothing before
//             this touched a SINGLE already-saved slot image from the engine side), so
//             they get one new small message: AE_CHAR_IMAGE_ACTION { charId, slot, op }.
// Bridge already has every implementation these four need — _generateAvatarImage's
// pipeline (via generateCommentImage, the same function 'snapshot' already calls),
// _deletePortrait, _downloadAsPng, openPromptEditor. This is wiring, not new capability.
async function ceImgSlotGenerate(charId: string, slot: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected \u2014 image generation requires bridge.', { type: 'warning', autoClose: 3000 }); } catch (e0) {}
        return;
    }
    try {
        var c: any = await loadCharacter(charId);
        if (!c) return;
        var slotState = await loadCharImgSlots(charId);
        var tag = charImgEffectiveTag(slotState, slot);
        // Same composition _generateAvatarImage already uses bridge-side: base visuals +
        // avatar-only visuals + this slot's tag, one string, one character entry. fp/fu
        // carry ONLY the global preset (compileActiveImageFields) -- character-specific
        // description belongs in the characters[] array, never folded into the base prompt,
        // same rule buildRequestBody's v4.5 per-character captions already depend on.
        var charVisuals = [c.visuals || '', c.avatarVisuals || '', tag || ''].filter(Boolean).join(', ');
        var chars = charVisuals ? [{ name: c.name, visuals: charVisuals, uc: c.uc || '' }] : [];
        var seed = _ceImgSeed(c.avatarSeed);
        try { await charImgSetSeed(charId, slot, seed); } catch (eSd) { api.v1.error('[AE:imgslots] seed stamp failed:', eSd); }
        var compiled = compileActiveImageFields();
        await ceBroadcastImageGen({
            uuid: api.v1.uuid(),
            prompt: '',
            characters: chars,
            extraBaseVisuals: '',
            extraBaseUC: '',
            charId: c.id,
            entityId: null,
            kind: 'charSlot',
            slot: slot,
            settings: {
                width: c.avatarWidth || 1024,
                height: c.avatarHeight || 1024,
                steps: Math.min(globalSettings.defaultSteps || 28, 28),
                scale: globalSettings.defaultScale || 5.0,
                model: ceImgModel(),
                seed: seed,
                quality: compiled.quality,
                negative: compiled.negative
            },
            autoDownload: false
        });
        try { api.v1.ui.toast('Generating ' + slot + '\u2026', { type: 'info', autoClose: 2000 }); } catch (e1) {}
    } catch (e) { api.v1.error('[AE:imgslots] generate failed:', e); }
}

// [IMG-UPLOAD] `op` gained 'upload'. IT IS THE ONLY OP ON THIS MESSAGE WITH A
// RETURN LEG: delete/download/edit either finish bridge-side or fail bridge-side, and the
// engine has nothing to repaint either way, but an upload puts BYTES IN A SLOT THE ENGINE
// BELIEVED WAS EMPTY. So the bridge answers with AE_CHAR_IMAGE_UPLOADED { charId, slot }
// on success only, handled in SECTION 18. Both halves must move together -- the button
// without the bridge op does nothing, and the bridge op without the inbound case stores
// the image and never shows it.
// [PASS-B FIRE-FORGET] THE ONE VERB HERE THAT IS NEITHER CHAINED NOR PUBLISHING, and that
// is correct: it mutates no engine state. The bridge owns image bytes, performs the op,
// and reports back through its own message -- chaining a request that writes nothing would
// hold the profile lock across a round trip for no gain.
async function ceImgSlotAction(charId: string, slot: string, op: string): Promise<void> {
    if (!isBridgeReady) {
        try { api.v1.ui.toast('Bridge not connected.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
        return;
    }
    try { await broadcastToTM('AE_CHAR_IMAGE_ACTION', { charId: charId, slot: slot, op: op }); }
    catch (e) { api.v1.error('[AE:imgslots] action ' + op + ' failed:', e); }
}

// -- Field-catalog projection ------------------------------------------------
// p.customFields already arrives ordered by group with slot-before-facet inside
// each group (ceOrderStaticFields) and now carries `kind`. This only buckets;
// it does not re-sort, so the two surfaces cannot disagree about order.
function _ceGroupFields(p: any, group: string): any[] {
    var out: any[] = [];
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && list[i].group === group) out.push(list[i]);
    }
    return out;
}
function _ceHasValue(f: any): boolean {
    return String((f && f.value) || '').trim() !== '';
}
function _ceCountWritten(list: any[]): number {
    var n = 0;
    for (var i = 0; i < list.length; i++) { if (_ceHasValue(list[i])) n = n + 1; }
    return n;
}
function _ceTrim(text: string, max: number): string {
    var t = String(text || '').replace(new RegExp('\\s+', 'g'), ' ').trim();
    if (!t) return '';
    if (t.length <= max) return t;
    return t.slice(0, max - 1) + '\u2026';
}

// -- Local UI state ----------------------------------------------------------
// Which accordion rows are open, and which drill is showing. Both are pure
// session UI, so they live on ceUiStore rather than anywhere persistent — the
// same call tempStorage-vs-storyStorage already makes for the field reveal
// list. `open` is a plain map so a future key cannot be dropped, for the
// same reason ceUiPatch shallow-merges.
// [OPEN-MAP-RENAME] RENAMED. The kit's own item said
// this was the shell's generic open-map wearing the name of the only surface that had one
// when it was written, and named the trigger: rename when a THIRD surface uses it.
// Settings is that third surface (Profile, Journal, now Settings), so the rename lands
// here rather than adding a fourth caller to the old name. Mechanical: two symbols, every
// call site updated in the same patch, no behaviour change.
function ceToggleOpen(id: string): void {
    ceUiPatch(function(u: any) {
        var open: any = {}; var k: string;
        for (k in (u.open || {})) { open[k] = u.open[k]; }
        if (open[id]) { delete open[id]; } else { open[id] = true; }
        return { open: open };
    });
}
// [OPEN-SET] ceToggleOpen flips; these two SET and READ. A picker that must
// close on choice cannot use a toggle, because a toggle re-opens it when the tapped value
// was already the current one. Direct store read for the same reason _ceGuideOpen does it:
// no hook, so it stays legal inside the loops the profile column runs in.
function _ceSetOpen(id: string, on: boolean): void {
    ceUiPatch(function(u: any) {
        var open: any = {}; var k: string;
        for (k in (u.open || {})) { open[k] = u.open[k]; }
        if (on) { open[id] = true; } else { delete open[id]; }
        return { open: open };
    });
}
function _ceOpenIs(id: string): boolean {
    var o: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; o = (u && u.open) || null; }
    catch (e) { o = null; }
    return !!(o && o[id]);
}
var CE_PAT_OPEN: string = 'pat:pick';

function _ceProfileDrill(kind: string, step: number): void {
    ceUiPatch(function() { return { profileDrill: kind, profileStep: step || 0 }; });
}

// -- Pattern gating ----------------------------------------------------------
// [SLOT-GATE] Resistance and Conduct exist ONCE PER PATTERN in
// BUILTIN_FACETS (ce_slot_resist_<pattern> / ce_slot_conduct_<pattern>), and the
// library's own header says so: "the bridge resolves ce_slot_resist_<pattern> /
// ce_slot_conduct_<pattern> from the character's chosen pattern." an earlier
// profile never did that resolution — it rendered every slot in the group, so a
// character showed six Resistance cards and six Conduct cards and was invited to
// answer all twelve. That is not a display bug alone: filling more than one
// hands the model competing answers to the same question, which is the exact
// failure `uiShape` exists to prevent between the two shapes.
//
// The gate is a SUFFIX MATCH on the slot id, not a new field, because the
// library already encodes the pattern in the id and adding a `pattern:` key
// would be a second source of truth for the same fact.
function _ceGatedGroup(groupId: string): boolean {
    return groupId === 'resistance' || groupId === 'conduct';
}
function _ceSlotsFor(rows: any[], groupId: string, patternId: string): any[] {
    var out: any[] = [];
    var gated = _ceGatedGroup(groupId);
    var suffix = '_' + String(patternId || '');
    for (var i = 0; i < rows.length; i++) {
        if (String(rows[i].kind || '') !== 'slot') continue;
        if (gated) {
            if (!patternId) continue;
            var id = String(rows[i].id || '');
            if (id.length <= suffix.length) continue;
            if (id.slice(id.length - suffix.length) !== suffix) continue;
        }
        out.push(rows[i]);
    }
    return out;
}
function _ceFacetsFor(rows: any[]): any[] {
    var out: any[] = [];
    for (var i = 0; i < rows.length; i++) {
        if (String(rows[i].kind || '') === 'slot') continue;
        out.push(rows[i]);
    }
    return out;
}
// [SLOT-GATE] Takes the pattern now. Without it a studio character read
// as permanently unfinished: the five UNUSED pattern variants in each gated group
// are empty by design and can never be filled, so the old "every slot has a value"
// test could not return true for Resistance or Conduct on any character at all.
// DEAD -- its only caller was _ceProfileGroup's accordion summary, which the
// condensed rewrite removed. Retained un-deleted this pass rather than removed blind.

// -- Accordion ---------------------------------------------------------------
// [PASS-C KIT-ELSEWHERE] THIS AND ceExpandRow BELOW ARE KIT, NOT PROFILE-LOCAL, and they
// are the only two collapsibles in the file. Six surfaces call them and Profile calls
// neither -- it outgrew both and the declarations stayed. Do not narrow either one to a
// Profile assumption. Cross-referenced from SECTION 28 so they can be found from the kit.
// Collapsed, this row carries exactly what the earlier spine row carried:
// label, one-line summary, filled indicator. Nothing was lost by making it open
// in place rather than open a sheet.
function ceAccordion(opts: any): any {
    var open = !!opts.open;
    var head = h('div', {
        onClick: function() { ceTap('acc:' + opts.id, function() { ceToggleOpen(opts.id); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s3,
            minHeight: CE_T.tap, padding: CE_T.s2 + ' 0', cursor: 'pointer',
            borderBottom: open ? 'none' : '1px solid ' + CE_LINE
        }
    },
        // Optional leading visual, additive -- no existing call site sets it,
        // so every prior ceAccordion call renders exactly as before. Added for the Images
        // drill's per-slot rows, where the row's own thumbnail belongs in the header, not
        // buried inside the expanded content where a collapsed row could never show it.
        opts.lead || null,
        // [CARET-HUE] The caret carries the character's pattern hue when
        // the group HAS one -- CE-STYLE section 2.3's own proposal, which said the hue is
        // available for more than an 8px dot and named the accordion rail as a place to
        // spend it. The rail only exists while OPEN; the caret is visible in both states,
        // so this is where the colour actually earns something. Semantic colour takes no
        // opacity (section 2.2), so a tinted caret drops to t3 (0.58) rather than dimming a
        // hue. [STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): the
        // 8px caret triangle is a control glyph, not a text heading.
        h('div', { style: { flex: '0 0 auto', width: '10px', fontSize: '8px',
            color: opts.rail ? opts.rail : 'inherit',
            opacity: opts.rail ? '1' : '0.58',
            transform: open ? 'rotate(90deg)' : 'none' } }, '\u25B6'),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '2px' } },
            h('div', { style: { fontSize: CE_T.fsSm, fontWeight: '500', letterSpacing: '0.09em',
                textTransform: 'uppercase', opacity: open ? '1' : '0.58' } }, opts.label),
            (!open && opts.summary)
                ? ceTruncate('t2', opts.summary)
                : null
        ),
        opts.meta ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: '0.58' } }, opts.meta) : null
    );
    if (!open) return h('div', null, head);
    return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } },
        head,
        h('div', { style: {
            borderLeft: '2px solid ' + (opts.rail || CE_LINE2),
            paddingLeft: CE_T.s4, margin: '0 0 ' + CE_T.s4 + ' 4px',
            display: 'flex', flexDirection: 'column', gap: CE_T.s4
        } }, opts.children)
    );
}

// -- Expand row  [PHASE-D-PRIME] -------------------------------------
// CE-ROADMAP Phase D'. ceAccordion is Field-density (SS7.2/7.3: one record's own
// fields disclosing under an eyebrow label) and every Settings list -- Species,
// Archetypes, Conditions, Factions, static-field instructions -- was reusing it for
// SS7.3's OTHER case instead: "many distinct records", which the Chat surface's own
// STYLE2-LIST-SPLIT note already named as the misuse ceAccordion should not be doing.
// This is the object-density counterpart: ceCard's box/hue treatment (SS7.3's own
// prescription -- ceH for the record's name, not an uppercase eyebrow) with
// ceAccordion's open/toggle mechanics underneath, so every list row still expands in
// place exactly as it does today.
//
// SAME CONTRACT AS ceAccordion ON PURPOSE: id/label/open/summary/children mean what
// they already mean, so every call site becomes a rename, not a rewrite. `hue`
// replaces `rail` (ceCard's own name for the same idea) since nothing here has
// ceAccordion's other two fields (`lead`, `meta`) to carry forward -- none of the six
// call sites this lands on used them.
//
// A REAL COMPONENT, same shape as _ceCardC/_ceBtnC (SS9: press state lives in the
// primitive), because every call site is inside a list loop and needs its own hook
// scope there for the same reason ceCard's already does.
function _ceExpandRowC(p: any): any {
    var pressState = useState(false); var pressed = pressState[0]; var setPressed = pressState[1];
    var open = !!p.open;
    var head = h('div', {
        onClick: function() { ceTap('exp:' + p.id, function() { ceToggleOpen(p.id); }); },
        onPointerDown: function() { setPressed(true); },
        onPointerUp: function() { setPressed(false); },
        onPointerLeave: function() { setPressed(false); },
        onTouchCancel: function() { setPressed(false); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap,
                 cursor: 'pointer' }
    },
        p.lead || null,
        h('div', { style: { flex: '0 0 auto', width: '10px', fontSize: '8px',
            color: p.hue ? p.hue : 'inherit', opacity: p.hue ? '1' : CE_OP.t3,
            transform: open ? 'rotate(90deg)' : 'none' } }, '\u25B6'),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                            flexDirection: 'column', gap: '2px' } },
            ceH(p.label || 'Unnamed'),
            (!open && p.summary)
                ? ceTruncate('t3', p.summary)
                : null
        ),
        p.meta ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: CE_OP.t2 } }, p.meta) : null
    );
    return h('div', {
        style: {
            display: 'flex', flexDirection: 'column', gap: open ? CE_T.s3 : '0',
            padding: CE_T.s2 + ' ' + CE_T.s3, borderRadius: CE_T.rCard,
            background: pressed ? CE_FILL2 : CE_WELL,
            border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + (p.hue || CE_LINE),
            marginBottom: CE_T.s2,
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, head, open ? p.children : null);
}
function ceExpandRow(opts: any): any {
    return h(_ceExpandRowC, { key: opts.key || opts.id, id: opts.id, label: opts.label,
        summary: opts.summary, open: opts.open, hue: opts.hue, lead: opts.lead,
        meta: opts.meta, children: opts.children });
}

// -- Guidance ----------------------------------------------------------------
// [GUIDE-FROM-INSTRUCTIONS] The earlier build drill carried a
// hand-written `why` line per step. Those were invented for the mockup and read as
// filler. BUILTIN_FACETS already carries a real, argued instruction string for every
// slot and facet — task, length, and the specific cliche that slot attracts — and
// buildCharProfilePayload already exports it as `instructions`. That IS the guide;
// writing a second one alongside it means two descriptions of one field that can
// drift. This renders the real one.
// [STYLE2-E] COLLAPSED BY DEFAULT. Every one of these
// strings is a real, argued instruction (60-70 words for Presence), and rendering six of
// them permanently open on a phone buried the six fields they describe. The text is still
// worth having -- it is the only place the task, the length, and the specific cliche to
// avoid are written down -- so this hides it behind an affordance rather than truncating
// it, which would put a second, shorter description of one field into the world and let
// the two drift. That was the exact failure GUIDE-FROM-INSTRUCTIONS (earlier) was created
// to end, and it is not being reintroduced as an ellipsis.
//
// THE OPEN STATE IS ceUiStore.open, the same map every accordion already uses. No new
// storage key, no new store, and the guide's open/closed state is session-scoped for the
// same reason accordion state is -- it is UI, not record.
//
// THE KEY IS DERIVED FROM THE TEXT, which is why no call site had to change its signature.
// A guide is identified by its own content; two fields sharing an instruction string share
// an open state, which is correct rather than a collision. djb2 over the string, base36 --
// this is a UI key, not a checksum, and it never leaves the session.
function _ceGuideKey(text: string): string {
    return 'gd:' + _ceDjb2(text);
}
// Reads the store DIRECTLY rather than taking an openMap parameter. That is the same shape
// _ceBtnC/_ceIconBtnC already use for their busy state (ceUiStore.get() inside render), and
// it is safe for the same reason: the Root that renders this subscribes via useStoreValue,
// so a toggle repaints the tree and this function is re-invoked with the new value. It
// calls NO hook, so it stays legal inside the loops _ceSlotCard/_ceFacetField run in.
function _ceGuideOpen(text: string): boolean {
    var o: any = null;
    try { var u: any = ceUiStore ? ceUiStore.get() : null; o = (u && u.open) || null; }
    catch (e) { o = null; }
    return !!(o && o[_ceGuideKey(text)]);
}
// The bar: an optional Field-density key, and the '?' affordance on the right.
// THE WHOLE ROW IS THE HIT TARGET, not the 18px glyph. A 44px-square icon button would
// out-weigh the field it labels at this density, and a glyph-sized one would fail SS11's
// hit-area floor; a full-width row at CE_T.ctl height satisfies both and is the more
// discoverable affordance on a phone besides.
// `label` MAY BE EMPTY -- that is the duplicate-heading case (see _ceSlotCard), and the
// bar then renders as the affordance alone rather than reserving a blank heading row.
// [earlier GUIDE-NO-ORPHAN, per user "the ? button that shows instructions shouldn't have
// its own line -- it should either be inline with header or generate button"] THE GLYPH IS
// EXTRACTED so it has two homes instead of one.
//
// THE ORPHAN CASE IS EXACTLY ONE CALLER, and it was already documented as a special case
// elsewhere: _ceSlotCard suppresses its heading when the slot's label duplicates the group's
// (earlier STYLE2-E correction 1). _ceGuideBar's own note says "label MAY BE EMPTY -- the
// bar then renders as the affordance alone" -- and that is the line the user is looking at:
// a full-width row containing nothing but an 18px '?' floated right, above a textarea.
//
// `standalone` DECIDES WHO OWNS THE TAP, and it is not decoration. Inside the bar, the ROW
// is the hit target (see the note below on why), so the glyph must be inert -- a second
// onClick there bubbles into the row's and fires the toggle twice, surviving only on
// ceTap's inferred CE_TAP_MS window. Outside the bar there is no row, so the glyph carries
// its own handler and its own 44px vertical hit area via _ceHit, the same wrapper every
// ceBtn/ceIconBtn already gets.
function _ceGuideChip(text: string, standalone: boolean): any {
    var t = String(text || '').trim();
    if (!t) return null;
    var open = _ceGuideOpen(t);
    var id = _ceGuideKey(t);
    var glyph = h('div', {
        role: standalone ? 'button' : undefined,
        tabIndex: standalone ? 0 : undefined,
        'aria-label': standalone ? (open ? 'Hide guidance' : 'Show guidance') : undefined,
        'aria-expanded': standalone ? (open ? 'true' : 'false') : undefined,
        'aria-hidden': standalone ? undefined : 'true',
        onClick: standalone
            ? function() { ceTap(id, function() { ceToggleOpen(id); }); }
            : undefined,
        style: {
            flex: '0 0 auto', width: '18px', height: '18px',
            display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
            fontSize: CE_T.fsKey, fontWeight: '600', lineHeight: '1',
            cursor: standalone ? 'pointer' : 'inherit',
            borderRadius: CE_T.rPill,
            border: '1px solid ' + (open ? CE_LINE2 : CE_LINE),
            background: open ? CE_FILL : 'transparent',
            opacity: open ? CE_OP.t1 : CE_OP.t3,
            transition: 'all ' + CE_T.mFast + ' ' + CE_T.ease
        }
    }, '?');
    return standalone ? _ceHit(glyph) : glyph;
}
function _ceGuideBar(label: string, text: string): any {
    var lab = String(label || '').trim();
    var t = String(text || '').trim();
    if (!lab && !t) { return null; }
    if (!t) { return ceKey(lab); }
    var open = _ceGuideOpen(t);
    var id = _ceGuideKey(t);
    return h('div', {
        role: 'button', tabIndex: 0,
        'aria-label': (open ? 'Hide guidance' : 'Show guidance') + (lab ? (' for ' + lab) : ''),
        'aria-expanded': open ? 'true' : 'false',
        onClick: function() { ceTap(id, function() { ceToggleOpen(id); }); },
        style: {
            display: 'flex', alignItems: 'center', gap: CE_T.s2,
            minHeight: CE_T.ctl, cursor: 'pointer'
        }
    },
        lab ? ceKey(lab) : null,
        ceGrow(null, []),
        _ceGuideChip(t, false)
    );
}
// The body. `inline` = the caller already rendered a bar (via _ceGuideBar) and wants only
// the text; the default is self-contained and supplies its own bar, which is what keeps the
// three Position call sites working verbatim -- they gain the collapse for free.
function _ceGuide(text: string, inline?: boolean): any {
    var t = String(text || '').trim();
    if (!t) return null;
    var open = _ceGuideOpen(t);
    // [GUIDE-BODY] pre-wrap, because a guide may now be TWO paragraphs: the entity
    // generators hand over their placement line and the literal instruction together, and
    // without this the blank line between them collapsed to a space and the two ran on.
    var body = open ? h('div', { style: {
        fontSize: CE_T.fsSm, opacity: CE_OP.t3, lineHeight: CE_T.lhProse,
        whiteSpace: 'pre-wrap',
        borderLeft: '1px solid ' + CE_LINE, paddingLeft: CE_T.s3
    } }, t) : null;
    if (inline) { return body; }
    return ceStack(CE_T.s1, [
        _ceGuideBar('', t), body]);
}


// [GEN-BUDGET] Budgets are NOT invented here. earlier guessed 120
// for facets and 150 for slots; the AE_GENERATE_SLOT handler already resolves both, and
// this now matches it literally: a custom field (slot OR facet -- they are the same
// record shape) takes cfg.fieldBudgets[<def id>] with a 150 floor, and a static sheet
// field takes cfg.fieldBudgets[<key>] else that def's own defaultBudget. Instructions
// resolve the same way. One resolution, two call sites.
function _ceGenSpec(cfg: any, f: any): any {
    var id = String(f.id || '');
    // [LOC-PROFILE2] A row may carry its OWN default budget. Character fields do
    // not -- they are all roughly one length, so the 150 floor is right for them -- but a
    // location's questions run from a two-clause constraint to a paragraph of society, and
    // one number for both would make the author retype it on the strip every time. Config
    // still outranks the catalog: an author who has set a budget for this id keeps it.
    return {
        instructions: String(f.instructions || ''),
        budget: (cfg && cfg.fieldBudgets && cfg.fieldBudgets[id]) || Number(f.budget) || 150
    };
}

// NO hasSeed GATE. Field generators are ALWAYS offered. An earlier version required a
// concept dump or brief description first, which punished exactly the wrong character:
// buildFieldGenContext already hands the generator the character's OWN written slots
// -- Core, Pursuit, Resistance, Conduct, pattern, identity -- so someone six slots into the
// walkthrough with no concept dump had more guidance available than at any earlier point,
// and got no generator at all.
//
// `instructions` is the only real condition: with none there is no field scope to generate
// against, which is what the generate handler's own 'noinstructions' branch says too.
// [PASS-C KIT-ELSEWHERE] CALLED FROM SECTION 28 as well as from this surface (the slot-
// options screen builds one with a null profile projection). It is therefore not free to
// assume a `p` -- the null-p path is a real call site, not defensive padding.
function _ceGenBtn(p: any, charId: string, writeKey: string, label: string,
                   instructions: string, budget: number, guide?: string, scope?: string): any {
    if (!instructions) return null;
    var st: any = _ceSlotOptsFor(charId, writeKey);
    var chip: any = _ceGuideChip(String(guide || ''), true);
    // [GUIDE-BODY] THE CHIP'S OWNER RENDERS THE CHIP'S BODY. This function mints the
    // only standalone '?' in the file and rendered no text behind it: the glyph toggled a
    // store flag nothing was reading, so every entity and item generator carried a control
    // that visibly did nothing. _ceSlotCard used to render the body for it from outside,
    // which is why the character surfaces looked correct and no other caller did. That
    // outside copy is gone and this owns both halves. One implementation.
    var gBody: any = _ceGuide(String(guide || ''), true);
    if (!st) {
        return ceStack({ gap: CE_T.s1, key: 'g_collapsed' }, [
            ceInline({ gap: CE_T.s2, key: 'g_row' }, [
                ceBtn('Generate', 'genopt:' + charId + ':' + writeKey, function() {
                    ceSlotOptsOpen(charId, writeKey, label, instructions, budget, scope);
                    return Promise.resolve();
                }),
                chip
            ]),
            gBody ? ceWrap({ key: 'g_guide' }, [ gBody]) : null
        ]);
    }

    var running = (st.status === 'running');
    var opts: any[] = st.options || [];
    var yoink = (String(st.method || 'direct') === 'yoink');
    var kids: any[] = [];

    // The steer. onType writes the module var on every keystroke with NO render -- the
    // same contract the Images Studio prompt drafts run on.
    kids.push(ceWrap({ key: 'g_hint' }, [ h(ceField, {
        key: 'g_hint_f', k: 'slotopt:hint:' + writeKey, label: 'Steer (optional)', value: '',
        seed: String(writeKey), multiline: true, rows: 2, well: true,
        placeholder: 'Push it in a direction \u2014 e.g. \u201cmake it about the debt, not the brother\u201d',
        onType: function(v: string) { _ceSlotOptsHint = String(v || ''); },
        // NOT optional decoration: ceField's commit() calls p.onCommit unguarded on blur,
        // so a field without one throws the moment focus leaves it.
        onCommit: function(v: string) { _ceSlotOptsHint = String(v || ''); return Promise.resolve(); }
    })]));

    var controls: any[] = [];
    controls.push(ceGrow({ key: 'g_m', basis: '140px' }, [ ceSelect({
        k: 'slotopt:method:' + writeKey,
        label: 'Draw',
        value: yoink ? 'yoink' : 'direct',
        options: [{ id: 'direct', label: 'Metered' }, { id: 'yoink', label: 'Free' }],
        onCommit: function(v: string) { ceSlotOptsPatch({ method: String(v || 'direct') }); return Promise.resolve(); }
    })]));
    // The count control is HIDDEN, not disabled, on a free draw. A disabled control that
    // still shows "3" is the same lie the old hint was written to apologise for.
    if (!yoink) {
        controls.push(h('div', { key: 'g_c', style: { flex: '0 1 100px', minWidth: '0' } }, ceSelect({
            k: 'slotopt:count:' + writeKey,
            label: 'How many',
            value: String(Number(st.count) || 3),
            options: [{ id: '1', label: '1' }, { id: '2', label: '2' }, { id: '3', label: '3' },
                      { id: '4', label: '4' }, { id: '5', label: '5' }],
            onCommit: function(v: string) { ceSlotOptsPatch({ count: Number(v) || 3 }); return Promise.resolve(); }
        })));
    }
    controls.push(h('div', { key: 'g_b', style: { flex: '0 1 120px', minWidth: '0' } }, ceNumField({
        k: 'slotopt:budget:' + writeKey,
        label: 'Tokens',
        value: Number(st.budget) || 150,
        min: 40, max: 600,
        onCommit: function(n: number) { ceSlotOptsPatch({ budget: Number(n) || 150 }); return Promise.resolve(); }
    })));
    kids.push(ceInline({ gap: CE_T.s2, key: 'g_ctl', align: 'end' }, controls));

    // [ENTGEN] The story-context toggle. generateSlotOptions has taken includeStory
    // since it was written and this strip hardcoded it false, so this is a control for a
    // capability that already worked -- not a new one. It costs INPUT tokens, not output,
    // which is why it is a plain switch with no budget arithmetic attached: the Tokens
    // field beside it governs the answer's length and is unaffected either way.
    kids.push(ceWrap({ key: 'g_story' }, [
        ceSettingRow('Use recent story',
            'Folds the last stretch of the story in as reference, so the answer fits what has actually happened rather than the record alone.',
            ceToggle(!!st.useStory, 'slotopt:story:' + writeKey, function() {
                ceSlotOptsPatch({ useStory: !st.useStory });
                return Promise.resolve();
            }))]));

    kids.push(ceProse('t3',
        yoink
            ? 'A free draw costs no allowance and always returns ONE candidate. Press again for another.'
            : 'A metered call spends allowance and returns the number you asked for, written to differ from each other.', { key: 'g_note0' }));

    // The chip rides the run row too, not just the collapsed one: expanding the generator
    // is when the field's own instructions are MOST worth re-reading, and losing the only
    // affordance on expand would be the same orphan bug in reverse.
    kids.push(ceInline({ gap: CE_T.s2, key: 'g_run' }, [
        ceBtn(running ? 'Generating\u2026' : (opts.length ? 'Again' : 'Generate'),
              'slotopt:run:' + writeKey, function() { return ceSlotOptsRun(); }, 'primary'),
        ceBtn('Cancel', 'slotopt:close:' + writeKey, function() { ceSlotOptsClose(); return Promise.resolve(); }),
        chip
    ]));
    // [GUIDE-BODY] The body follows the run row for the same reason the chip rides
    // it: expanding the generator is when the instruction is most worth reading, and the
    // text has to appear under the glyph that opened it rather than above the strip.
    if (gBody) kids.push(ceWrap({ key: 'g_guide' }, [ gBody]));

    if (st.note) {
        kids.push(h('div', { key: 'g_note', style: { fontSize: CE_T.fsSm, opacity: CE_OP.t2,
            lineHeight: CE_T.lhProse, color: CE_SEM.ask } }, String(st.note)));
    }

    if (opts.length) {
        var cards: any[] = [];
        for (var i = 0; i < opts.length; i++) {
            cards.push((function(text: string, idx: number) {
                return h('div', {
                    key: 'g_opt_' + idx,
                    role: 'button', tabIndex: 0,
                    'aria-label': 'Use candidate ' + (idx + 1),
                    onClick: function() {
                        ceTap('slotopt:pick:' + writeKey + ':' + idx, function() {
                            ceAction('slotopt:commit:' + writeKey + ':' + idx, function() { return ceSlotOptsCommit(text); });
                        });
                    },
                    style: {
                        cursor: 'pointer', border: '1px solid ' + CE_LINE, borderRadius: CE_T.rCard,
                        padding: CE_T.s3, background: CE_FILL, fontSize: CE_T.fs,
                        lineHeight: CE_T.lhProse, whiteSpace: 'pre-wrap'
                    }
                }, text);
            })(String(opts[i] || ''), i));
        }
        kids.push(ceWrap({ key: 'g_opts' }, [ ceSection('Tap one to use it \u00b7 ' + opts.length,
            ceStack(CE_T.s3, cards))]));
    }

    return h('div', {
        style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s3,
            padding: CE_T.s3, borderRadius: CE_T.rCard,
            background: CE_WELL, border: '1px solid ' + CE_LINE,
            borderLeft: '3px solid ' + CE_LINE2
        }
    }, kids);
}

// -- Slot card ---------------------------------------------------------------
// [SLOT-HEADING] The slot's name is now a real subheading, not a
// 9px uppercase eyebrow indistinguishable from every other label on the surface.
// A slot is the load-bearing line of its group and has to read as one. The library
// label for a gated slot is "Resistance \u00b7 Contradiction"; the group heading above it
// already says Resistance, so only the tail after the middle dot is shown here.
// [STYLE2-E] TWO CORRECTIONS, both reported from the live surface.
//
// (1) THE HEADING WAS PRINTED TWICE. A non-gated group renders exactly one slot whose
// label IS the group's label, so the accordion said "Presence" and the card under it said
// "Presence" again, with a paragraph wedged between them. `groupLabel` is now passed in and
// a heading identical to it is SUPPRESSED. A gated slot is unaffected and keeps its head:
// its short label is the pattern ("Contradiction") and the group's is "Resistance", so the
// two carry different information and both are worth the row. The test is equality, not a
// hard-coded list of which groups have one slot -- if a label is ever renamed, the
// suppression follows it instead of going stale.
//
// (2) THE BOX IS GONE. This is Field density (SS7.2: "many fields of one record"), and
// SS7.3 is explicit that the box belongs to Object density alone -- "a box that contains a
// section of one thing is chrome". It was also a box-in-box: _ceProfileGroup's accordion
// already draws a rail down the expanded content, and this drew a SECOND rail plus a
// CE_FILL ground inside it. The rail is retained here only for the caller that has no
// accordion around it (the build drill), and _ceProfileGroup now passes '' -- see there.
function _ceSlotCard(charId: string, p: any, cfg: any, f: any, rail: string, groupLabel?: string): any {
    var label = String(f.label || '');
    var dot = label.indexOf(' \u00b7 ');
    var shortLabel = dot > 0 ? label.slice(dot + 3) : label;
    var gl = String(groupLabel || '').trim();
    var head = (gl && shortLabel.toLowerCase() === gl.toLowerCase()) ? '' : shortLabel;
    // [GUIDE-NO-ORPHAN] THE HEADING SUPPRESSION ABOVE IS WHAT CREATED THE
    // ORPHAN ROW. With no head there is no label for the guide bar to sit beside, so the bar
    // rendered as a lone right-floated '?' occupying a full row of its own above the
    // textarea. When that happens the bar is skipped entirely and the glyph is handed to the
    // generate row instead (_ceGenBtn's `guide` argument).
    // THE GUIDANCE TEXT FOLLOWS ITS OWN TOGGLE, never the other one. A '?' at the bottom of
    // the card that opened a paragraph at the TOP of it would be worse than the orphan row.
    // [GUIDE-BODY] ONE TERNARY NOW, NOT TWO MIRRORED ONES. The bar-present case still
    // renders its own body here, under the bar; the handed-off case does not, because
    // _ceGenBtn renders the body for the chip it was handed. This block owning the body for
    // a glyph living in another function is what left every caller that was NOT _ceSlotCard
    // with a '?' that did nothing.
    var spec = _ceGenSpec(cfg, f);
    var bar = head ? _ceGuideBar(head, f.instructions) : null;
    // [LOC-PROFILE4] The one-line question, when the def carries one. Under the
    // label and above the field, so it reads as the prompt the box is answering.
    var hint = String(f.hint || '').trim() ? ceProse('t3', String(f.hint)) : null;
    return h('div', { style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s1,
        paddingLeft: rail ? CE_T.s3 : '0',
        borderLeft: rail ? ('2px solid ' + rail) : 'none'
    } },
        bar,
        hint,
        bar ? _ceGuide(f.instructions, true) : null,
        h(ceField, {
            key: 'slot_' + f.id, k: 'slot:' + charId + ':' + f.id,
            label: '', value: f.value, multiline: true, rows: 4,
            placeholder: 'Not written yet.',
            // [LOC-PROFILE2] The record this writes to is decided by the payload,
            // not by this renderer. See buildEntityProfilePayload.
            onCommit: function(v: string) { return _ceProfileWriteFor(p, charId, f.key, v); }
        }),
        _ceGenBtn(p, charId, f.key, shortLabel, spec.instructions, spec.budget,
                  bar ? '' : String(f.instructions || ''), _ceScopeOf(p))
    );
}

// -- One facet ---------------------------------------------------------------
// [STYLE2-E] Same two corrections as _ceSlotCard, minus the heading suppression:
// a facet's label never duplicates its group's, so it always keeps its head. The label
// moves from a bespoke 14px/500 line to ceKey, which is what SS7.2 says a Field-density key
// column is -- it was one of the hand-written type treatments SS1 exists to prevent.
function _ceFacetField(charId: string, p: any, cfg: any, f: any): any {
    return ceStack(CE_T.s1, [
        _ceGuideBar(String(f.label || ''), f.instructions),
        // [LOC-PROFILE4] See _ceSlotCard: the question, not the idea's name.
        String(f.hint || '').trim() ? ceProse('t3', String(f.hint)) : null,
        _ceGuide(f.instructions, true),
        h(ceField, {
            key: 'facet_' + f.id, k: 'facet:' + charId + ':' + f.id,
            label: '', value: f.value, multiline: true, rows: 2, placeholder: 'Empty',
            onCommit: function(v: string) { return _ceProfileWriteFor(p, charId, f.key, v); }
        }),
        _ceGenBtn(p, charId, f.key, String(f.label || ''), _ceGenSpec(cfg, f).instructions,
                  _ceGenSpec(cfg, f).budget, '', _ceScopeOf(p))
    ]);
}

// -- One group ---------------------------------------------------------------
function _ceProfileGroup(charId: string, p: any, cfg: any, g: any, extra: any[]): any {
    var patId = String(p.pattern || '');
    var pat = CE_PATTERN_DEFS[patId] || null;
    var gated = _ceGatedGroup(g.id);
    var rail = (gated && pat) ? pat.c : '';
    var rows = _ceGroupFields(p, g.id);
    var slots = _ceSlotsFor(rows, g.id, patId);
    var kids: any[] = [];

    // Position's record fields (targetId/shape/standing) arrive here as
    // `extra` rather than replacing this renderer, because the position GROUP also owns
    // five library facets. Replacing the group dropped them.
    for (var x = 0; x < (extra || []).length; x++) { kids.push(extra[x]); }

    for (var i = 0; i < slots.length; i++) {
        // [STYLE2-E] rail is '' HERE ON PURPOSE: the ceAccordion this group
        // returns already draws the pattern rail down its own expanded content, and a
        // second rail 12px inside the first is the box-in-box SS7.3 forbids. The card
        // keeps its rail parameter for the build drill, which has no accordion.
        kids.push(_ceSlotCard(charId, p, cfg, slots[i], '', g.label));
    }
    if (gated && !pat) {
        // [GATED-EMPTY] They
        // were not missing -- a gated group has NO slot until a pattern is chosen, so the
        // section rendered a head, one sentence, and nothing to write in. The sentence stays
        // and now carries the control that resolves it, instead of naming a fix that lives
        // two sections up the column.
        kids.push(ceStack(CE_T.s2, [
            ceProse('t3',
                'No field here yet \u2014 the pattern decides which question this step asks.'),
            ceBtn('Choose a pattern', 'gatepat:' + charId + ':' + g.id, function() {
                _ceSetOpen(CE_PAT_OPEN, true);
                return Promise.resolve();
            })
        ]));
    }

    // Facets with content. Empty ones stay behind the picker — the same
    // sparse rule buildCharStaticTab already runs (STATIC-SPARSE), not a
    // second policy invented here.
    var facets = _ceFacetsFor(rows);
    var shown: any[] = [];
    for (var j = 0; j < facets.length; j++) { if (_ceHasValue(facets[j])) shown.push(facets[j]); }
    for (var k = 0; k < shown.length; k++) { kids.push(_ceFacetField(charId, p, cfg, shown[k])); }

    var unwritten = facets.length - shown.length;
    if (unwritten > 0) {
        // [LOC-PROFILE3] THE DRILL STATE IS PER-SURFACE. _ceProfileDrill writes
        // ceUiStore.profileDrill, which only ceProfileRoot reads -- so on the Entity surface
        // this button set a value nobody rendered and the tap did nothing at all. The
        // payload already knows which surface it is on; the button asks it.
        kids.push(ceBtn('Add to ' + g.label + ' (' + unwritten + ')', 'addfacet:' + charId + ':' + g.id, function() {
            if (_ceScopeOf(p) === 'entity') { _ceEntDrill('addfacet:' + g.id); }
            else { _ceProfileDrill('addfacet:' + g.id, 0); }
            return Promise.resolve();
        }));
    }

    // [CONDENSED] ceSection, not ceAccordion. A group is a section of ONE
    // record, so CE-STYLE SS7.1 applies: a ceD2 head with a rule running to the edge, no box
    // and no disclosure triangle. The summary/meta/openMap machinery goes with the collapse
    // -- a summary line exists to describe content that is not on screen, and all of it is
    // now on screen. The pattern rail survives because it is SS6.3's identity rail, which is
    // the one thing the accordion was carrying that was never about disclosure.
    return ceSection(g.label, h('div', { style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s4,
        borderLeft: rail ? ('3px solid ' + rail) : 'none',
        paddingLeft: rail ? CE_T.s3 : '0'
    } }, kids));
}

// -- Add-facet picker --------------------------------------------------------
// [ADDFACET] Was a "no engine-side renderer yet" stub. There is no new data
// model here: the unwritten facets for a group ARE the library entries with no value,
// which _ceGroupFields already returns. A facet becomes "added" by acquiring content,
// so the picker renders each one as an editable field rather than as a button that
// writes a presence marker — a marker would be a second way for a facet to exist and
// _ceHasValue would then disagree with it.
function _ceProfileAddFacet(charId: string, p: any, cfg: any, groupId: string): any {
    var rows = _ceGroupFields(p, groupId);
    var facets = _ceFacetsFor(rows);
    var kids: any[] = [];
    for (var i = 0; i < facets.length; i++) {
        if (_ceHasValue(facets[i])) continue;
        kids.push(_ceFacetField(charId, p, cfg, facets[i]));
    }
    // [LOC-PROFILE3] THE LABEL COMES OFF THE ROW, not from the character group
    // table. Rows already carry groupLabel -- buildCharProfilePayload sets it and
    // buildEntityProfilePayload sets it -- so a location's drill said "Every Other fields
    // facet..." purely because this reached for the wrong lookup.
    var gLabel = String((rows[0] && rows[0].groupLabel) || ceStaticFieldGroupLabel(groupId));
    if (!kids.length) {
        return ceEmpty('Every ' + gLabel + ' facet already has something in it.', null);
    }
    return ceStack(CE_T.s4, [
        ceProse('t3',
            'Write into any of these and it joins the ' + gLabel
            + ' section. Leave the rest empty \u2014 an unused facet costs nothing.'),
        kids
    ]);
}

// -- Identity ----------------------------------------------------------------
// [IDENTITY] The hero row displayed name/role/species/gender and
// offered no way to change any of them. Every one of these is a CFV_DIRECT key, so
// they route through the existing ceProfileWrite with no new write path.
var CE_IDENTITY_FIELDS: any[] = [
    { k: 'name', label: 'Name', ml: false },
    // [PASS-A NICK] Comma-separated in, array out: applyCharFieldValue splits a string on
    // commas for this key, and getLorebookKeys returns name + nicknames, so what is typed
    // here becomes the entry's trigger keys on commit. `csv` renders the array back as a
    // string -- ceField takes a string value and the record holds string[].
    { k: 'nicknames', label: 'Also called', ml: false, csv: true },
    { k: 'occupationRole', label: 'Role', ml: false },
    // [PICKER] `pick` routes this row to cePickerRow instead of ceField. This is
    // one of SS13's two named standing violations; the descriptor-array form is why SS12
    // check 5 needed a second grep, and that grep now expects this line to carry `pick`.
    { k: 'species', label: 'Species', ml: false, pick: 'species' },
    { k: 'age', label: 'Age', ml: false },
    { k: 'gender', label: 'Gender', ml: false },
    { k: 'briefDescription', label: 'In one line', ml: true }
];
// [IDENTITY-INLINE] Was an accordion sitting above the body. Wrong on
// two counts: it duplicated the hero (which already displays exactly these values), and a
// section is the wrong affordance for "edit the thing you are looking at". The hero's
// identity block is now the control -- tapping the name or the lines under it opens this
// as a drill. Nothing is displayed twice, and the edit path is where the reader's eye
// already is.
function _ceProfileIdentityDrill(charId: string, p: any): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_IDENTITY_FIELDS.length; i++) {
        kids.push((function(fd: any) {
            // cePickerRow is hook-free by contract, so this branch is legal inside the
            // loop; ceField is a keyed h() child and keeps its own hook scope either way.
            if (fd.pick) {
                return cePickerRow({
                    label: fd.label, value: p[fd.k] || '',
                    kind: fd.pick, ctx: { charId: charId },
                    placeholder: 'Choose\u2026'
                });
            }
            var fdVal = fd.csv ? (p[fd.k] || []).join(', ') : (p[fd.k] || '');
            return h(ceField, {
                key: 'id_' + fd.k, k: 'ident:' + charId + ':' + fd.k,
                label: fd.label, value: fdVal, multiline: !!fd.ml, rows: 2,
                placeholder: fd.csv ? 'Nicknames, comma separated' : '\u2014',
                onCommit: function(v: string) { return ceProfileWrite(charId, fd.k, v); }
            });
        })(CE_IDENTITY_FIELDS[i]));
    }
    return ceStack(CE_T.s4, kids);
}

// -- Images --------------------------------------------------------------------
// [CE-IMG-GRID] Per-slot tag editing, add-slot,
// and the generate / edit / download / delete controls, replacing an earlier read-only
// grid. UPLOAD IS STILL NOT HERE AND NEVER WILL BE: a file picker is DOM and the worker
// has none, so that one control stays on the bridge's own Portraits screen however far the
// rest of this menu moves — noted again because it is the one gap a future pass could
// forget to route around.
//
// 26 SLOTS ON FIRST LOAD, USER-EXTENSIBLE AFTER: Avatar + Snapshot + the 24 canonical
// emotion words, derived from ALL_EMOTIONS_LIST rather than a second hand-typed list (same
// reasoning CANON_EMOTION_SLOTS uses bridge-side for the identical derivation). Storage-key
// casing is preserved exactly on purpose: 'Avatar' / 'Snapshot' capitalised, every emotion
// word lowercase, because the slot name is a literal IndexedDB key suffix with no
// normalisation on either side of the boundary. See SECTION 9b (loadCharImgSlots) for the
// storage and the soft-pin semantics: Avatar can never be removed; the 24 canonical words
// come back on the next load even if deleted; Snapshot and custom slots stay gone. That is
// a faithful port of behaviour the bridge already shipped, kept on purpose, not simplified.
//
// A ROW, NOT A GRID CELL. Per user: the thumbnail, the tag field, and the four controls
// belong together as one collapsible unit, so a 26-entry list stays scannable instead of
// showing 26 open textareas at once — same READ-FIRST reasoning the Journal already
// settled, applied to a list where the "read" state is a thumbnail instead of prose.
// EVERY CHILD IS KEYED, same discipline FIELD-KEYLESS and the Journal both paid for: a
// variable-length list of ceField instances with no key is exactly the shape that leaked a
// node before.
var CE_IMG_EMOTION_SLOTS: string[] = ALL_EMOTIONS_LIST.split(',').map(function(s: string) { return s.trim(); }).filter(Boolean);

// -- Store, publish, op-chain -------------------------------------------------
// Same three-part shape SECTION 31 (Journal) already settled for a variable-length,
// individually-editable list: a dedicated store (tag edits happen far more often than
// anything else on this surface, so this must not live on ceUiStore or a keystroke-commit
// repaints Scene and the rest of Profile too); a serialising op-chain (OP-CHAIN's reasoning
// applies unchanged -- storage here is also load-modify-persist with no compare-and-swap,
// so two tag commits landing close together would silently discard one without it); a
// draft module var for the add-slot composer (CLICK-BEFORE-BLUR's fix, not its cause --
// the fix generalises to any button reading a field's value, and this surface has one).
var ceImgSlotStore: any = null;
function ceImgSlotStoreInit(): void {
    if (ceImgSlotStore) return;
    try { ceImgSlotStore = createStore({ ready: false, charId: '', slots: [], tags: {}, seeds: {}, confirm: '', addGen: 0 }); }
    catch (e) { api.v1.error('[AE:imgslots] store init failed:', e); }
}
function ceImgSlotPatch(fn: (s: any) => any): void {
    if (!ceImgSlotStore) return;
    try {
        ceImgSlotStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:imgslots] patch failed:', e); }
}
var _ceImgSlotChain: Promise<any> = Promise.resolve();
function ceImgSlotOp(fn: () => Promise<any>): Promise<any> {
    var run = _ceImgSlotChain.then(fn);
    _ceImgSlotChain = run.catch(function() { return null; });
    return run;
}
var _ceImgSlotDraft: string = '';

async function cePublishImgSlots(charId: string): Promise<void> {
    ceImgSlotStoreInit();
    if (!ceImgSlotStore) return;
    try {
        var state = await loadCharImgSlots(charId);
        ceImgSlotPatch(function(s: any) {
            var fresh = (String(s.charId || '') !== charId);
            var conf = fresh ? '' : String(s.confirm || '');
            if (conf && state.slots.indexOf(conf) === -1) { conf = ''; }
            if (fresh) { _ceImgSlotDraft = ''; }
            return { ready: true, charId: charId, slots: state.slots, tags: state.tags || {},
                     seeds: state.seeds || {}, confirm: conf };
        });
    } catch (e) { api.v1.error('[AE:imgslots] publish failed:', e); }
}

// -- One slot row --------------------------------------------------------------
// [STYLE2-F] "Character portraits absolutely should not be drill down
// carrots. Each one is a single item and a write-only surface." BOTH HALVES OF THAT ARE
// STRUCTURAL, not cosmetic, and they land as one change:
//
// (1) NOT A DISCLOSURE. A caret is the right affordance for content you might not want to
// read. A portrait is not read -- it is looked at, and it is the one thing on this surface
// that cannot be summarised into a collapsed row. The old shape hid the image behind a
// 36px thumbnail beside a caret and put the only field that MAKES the image (its tags)
// behind a tap. So there is no `open` parameter any more, no ceUiStore.open entry, and no
// collapsed state to be in: every slot renders complete, always.
//
// (2) A SINGLE ITEM = OBJECT DENSITY (SS7.3: "many distinct records"). Each slot is a
// distinct thing with its own image, its own tags and its own verbs, which is exactly what
// ceCard is for and is the same call SS7.3 makes for the Scene roster. The 36px thumbnail
// becomes a 64x96 preview at the record's own 2:3 portrait frame -- the image is the
// record, so it gets the surface area.
//
// THE FOUR WORD-BUTTONS BECOME ONE WORD AND THREE ICONS, per SS6.4's row-verb rule.
// Generate is the primary action of the card and keeps its word; edit/download/delete are
// row verbs and are icon-only with mandatory aria-labels, which is what makes a card with
// a 96px image still fit on a phone. The labels name the SLOT, not just the verb, because
// there are N of these cards on one screen and "Delete" alone is ambiguous to a screen
// reader. Avatar still gets no delete -- unchanged rule, not a new one.
// [IMG-SEED] `seed` is what this slot was last rendered with, `pinned` is the
// character's standing avatarSeed. Shown as text rather than a field because it is not
// editable here — the editable one is the character's, and Use is what connects them.
function _ceImgSlotCard(charId: string, slot: string, tag: string, isAvatar: boolean, confirming: boolean, seed: number, pinned: number): any {
    // [PHOTO-VIEW] Tap opens the full-screen viewer. The click target is this
    // anchor alone (a sibling of the tag field and the action row below, never a
    // wrapping card with its own onClick), so there is no nested-tap question.
    var preview = h('div', ceImgAnchor(charId, slot, {
        onClick: function() { ceTap('imgslot:view:' + slot, function() {
            cePhotoOpen(charId, slot, slot, { seed: seed, pinned: pinned, canPin: true });
        }); },
        role: 'button', tabIndex: 0, 'aria-label': 'View the ' + slot + ' image full screen',
        style: { flex: '0 0 auto', width: '64px', height: '96px', borderRadius: CE_T.r,
            background: CE_WELL, border: '1px solid ' + CE_LINE, position: 'relative',
            overflow: 'hidden', cursor: 'pointer' }
    }));

    var kids: any[] = [];
    kids.push(h(ceField, {
        key: 'imgtag_' + slot, k: 'imgtag:' + charId + ':' + slot,
        label: 'Tags', value: tag, multiline: true, rows: 2,
        placeholder: isAvatar ? 'upper body, looking at viewer, plain background\u2026' : 'expression, pose\u2026',
        onCommit: function(v: string) {
            return ceImgSlotOp(function() { return charImgSetTag(charId, slot, v); })
                .then(function() { return cePublishImgSlots(charId); });
        }
    }));

    // [IMG-SEED] The seed this picture came from, and one tap to make every other
    // portrait of this character use it. Absent until the slot has been generated at least
    // once since seeds started being recorded — shown as nothing rather than as 0, which
    // already means "random" everywhere else on this surface.
    if (seed > 0) {
        kids.push(ceBar(CE_T.s2, [
            ceSub('t3', 'Seed ' + String(seed)),
            (seed === pinned)
                ? ceSub('t3', '\u00b7 in use for every portrait')
                : ceBtn('Use for all', 'imgslot:seeduse:' + slot, function() {
                    return ceProfileWrite(charId, 'avatarSeed', String(seed));
                  })
        ]));
    }

    var acts: any[] = [];
    acts.push(ceBtn('Generate', 'imgslot:gen:' + slot, function() { return ceImgSlotGenerate(charId, slot); }, 'primary'));
    // [v3.0.54 PHOTO-PROV] THE EDIT ICON IS GONE, per user: "the edit button for
    // portraits doesn't work". It never could: its op routed to a bridge branch whose modal
    // was deleted in bridge v2.103.0, so the button's whole effect was a toast telling the
    // author to use the surface they were already standing on. Both halves of what it
    // promised now have real doors -- the prompt is the Tags field ten pixels above it, and
    // the settings the picture was made with are in the full-screen view. Removing a button
    // that lies is the fix; re-pointing it would have given this card two doors onto one
    // field. The bridge's 'edit' branch went in the same patch.
    // [IMG-UPLOAD] Beside Download rather than beside Generate, because it is
    // Download's opposite and not Generate's alternative. NOT confirm-guarded: an upload
    // overwrites this slot's stored bytes, but the thing it overwrites is regenerable and
    // the file dialog is itself a confirmation step -- DESTRUCTIVE-NEVER-IN-PLACE is about
    // actions that destroy with one unrecoverable tap, and this one cannot complete
    // without the author picking a specific file first.
    acts.push(ceIconBtn('Upload an image for ' + slot, ceIconUpload(), 'imgslot:up:' + slot,
        function() { return ceImgSlotAction(charId, slot, 'upload'); }));
    acts.push(ceIconBtn('Download the ' + slot + ' image', ceIconDownload(), 'imgslot:dl:' + slot,
        function() { return ceImgSlotAction(charId, slot, 'download'); }));
    // [DESTRUCTIVE-NEVER-IN-PLACE] Same rule the Journal's delete button follows:
    // this button ASKS and never deletes, and keeps the same handler in both states, so the
    // double-fire that reuses the physical node (TAP-GUARD) can never land the confirmed
    // branch off the first tap. Avatar gets no Delete at all -- it is not a confirm-guarded
    // action, it is not offered, same as the bridge's own Portrait Studio.
    if (!isAvatar) {
        acts.push(ceIconBtn('Delete the ' + slot + ' slot', ceIconTrash(), 'imgslot:delask:' + slot, function() {
            ceImgSlotPatch(function() { return { confirm: slot }; });
            return Promise.resolve();
        }, 'danger'));
    }
    kids.push(ceInline({ gap: CE_T.s2, key: 'imga_' + slot }, acts));

    if (confirming) {
        kids.push(h('div', { key: 'imgc_' + slot, style: {
            display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3
        } },
            ceProse('t2',
                'Delete the \u201C' + slot + '\u201D slot and its saved image? This canonical slot ' +
                'will reappear empty the next time this screen loads \u2014 only its image and tag are removed.', { key: 'imgcm_' + slot, grow: true, basis: '180px' }),
            ceBtn('Delete', 'imgslot:del:' + slot, function() {
                return ceImgSlotOp(function() { return charImgRemoveSlot(charId, slot); })
                    .then(function() { return ceImgSlotAction(charId, slot, 'delete'); })
                    .then(function() { ceImgSlotPatch(function() { return { confirm: '' }; }); return cePublishImgSlots(charId); });
            }, 'danger'),
            ceBtn('Keep', 'imgslot:keep:' + slot, function() {
                ceImgSlotPatch(function() { return { confirm: '' }; });
                return Promise.resolve();
            })
        ));
    }

    // The preview sits BESIDE the authoring column, not above it: at 2:3 the image is taller
    // than it is wide, and stacking it would push the tag field -- the thing you are here to
    // write -- below the fold on every card.
    return ceCard({ key: 'imgcard_' + slot, children: ceBar({ gap: CE_T.s3, align: 'start' }, [
        preview,
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
            flexDirection: 'column', gap: CE_T.s2 } },
            ceH(slot),
            ceStack(CE_T.s3, kids)
        )
    ]) });
}

// -- Root component ------------------------------------------------------------
// A REAL COMPONENT, mounted via h(_ceProfileImagesDrill, {charId}) at the drill router --
// never called bare. It calls useStoreValue/useEffect, and those hooks must live in their
// OWN isolated instance (Preact gives h(Component, props) exactly that), not inlined into
// ceProfileRoot's own hook sequence the way a bare function call would. Every OTHER drill
// body is a plain function precisely because none of them holds hooks of their own --
// _ceProfileIdentityDrill's h(ceField, ...) calls are isolated the same way, one level
// deeper. This is the first drill whose OWN top level needs a hook, so it is the first one
// that has to be the component rather than the function.
function _ceProfileImagesDrill(props: any): any {
    var charId = String((props && props.charId) || '');
    // [STORE-BEFORE-HOOK] A STORE MUST EXIST BEFORE THE FIRST RENDER
    // OF ANYTHING THAT SUBSCRIBES TO IT, and useEffect IS TOO LATE TO CREATE IT. earlier
    // created ceImgSlotStore lazily inside cePublishImgSlots, which this component calls
    // from useEffect -- and an effect runs AFTER the render that scheduled it. So the very
    // first render reached useStoreValue(null), which throws inside the render pass:
    // the drill painted as a BLANK SURFACE with nothing in the console, because a throw
    // inside NAI's jsx marshalling is swallowed rather than reported.
    // TWO GUARDS, both cheap, because they fail differently: the shell opener now inits this
    // store alongside the others (the real fix -- the store simply exists before any
    // surface opens), and this call covers a future entry path that does not come through
    // it. [SHELL-TRAY] That opener is ceOpenShell now; ceOpenScene, which this
    // comment used to name, is deleted. It is STRAIGHT-LINE, NOT CONDITIONAL, so it adds no hook and cannot
    // shift the hook sequence below it; ceImgSlotStoreInit is idempotent by its own guard.
    // GENERAL RULE: every createStore in this file belongs in an init function called from
    // the surface opener. Lazy-create-on-first-publish is safe only for a store nothing
    // renders from.
    ceImgSlotStoreInit();
    // [STYLE2-F] THE ceUiStore SUBSCRIPTION IS GONE. Its only consumer here was
    // the per-slot openMap lookup, and portrait slots have no collapsed state any more.
    // Removing a hook from a component is safe -- hook order is per-instance and this is
    // unconditional, at the top, on every render -- and the surface still repaints on
    // ceUiStore changes because ceProfileRoot, which mounts this drill, subscribes to it
    // for the drill router itself. A subscription with no reader is not free: every
    // ceUiStore write (every accordion tap anywhere in the shell) was repainting this
    // component for nothing.
    var st = useStoreValue(ceImgSlotStore);
    // SUBSCRIBED, not a one-time .get(). _ceImgVisualFields writes through
    // ceProfileWrite -> cePublishProfile, same as every other field on this surface -- a
    // one-time read here would show the ratio select (ceSelect, CONTROLLED) its OWN prior
    // value forever after a commit, because nothing would ever tell this component to
    // re-render with the fresh record. The tag fields below are uncontrolled and would
    // have hidden this: a ceField shows what was just typed into it regardless of whether
    // its parent re-renders, so this gap would only have shown up on the ratio select and
    // easily have gone unnoticed in a quick pass.
    var prof = useStoreValue(ceProfileStore);

    useEffect(function() {
        cePublishImgSlots(charId);
    }, [charId]);

    if (!st || !st.ready || st.charId !== charId) {
        return ceEmpty('Loading\u2026', null);
    }

    var p = (prof && prof.p) || {};
    var slots: string[] = st.slots || [];
    var confirm = String(st.confirm || '');
    var rows: any[] = [];
    for (var i = 0; i < slots.length; i++) {
        var slot = slots[i];
        var isAvatar = (slot === CE_IMG_SLOT_AVATAR);
        var tag = charImgEffectiveTag({ slots: slots, tags: st.tags }, slot);
        var sdv = Number(((st as any).seeds || {})[slot]) || 0;
        rows.push(_ceImgSlotCard(charId, slot, tag, isAvatar, confirm === slot, sdv, Number(p.avatarSeed) || 0));
    }

    var addRow = ceStack(CE_T.s2, [
        h(ceField, {
            key: 'imgadd_' + String(st.addGen || 0), k: 'imgadd:' + charId,
            label: '', value: '', multiline: false, rows: 1, well: true,
            placeholder: 'New slot name \u2014 Combat, Formal, Injured\u2026',
            onType: function(v: string) { _ceImgSlotDraft = v; },
            onCommit: function(v: string) { _ceImgSlotDraft = v; return Promise.resolve(); }
        }),
        ceBtn('Add slot', 'imgslot:add:' + charId, function() {
            var name = _ceImgSlotDraft;
            if (!String(name || '').trim()) {
                try { api.v1.ui.toast('Name the slot first.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
                return Promise.resolve();
            }
            return ceImgSlotOp(function() { return charImgAddSlot(charId, name); }).then(function() {
                _ceImgSlotDraft = '';
                ceImgSlotPatch(function(s: any) { return { addGen: Number(s.addGen || 0) + 1 }; });
                return cePublishImgSlots(charId);
            });
        })
    ]);

    return ceStack(CE_T.s4, [
        _ceImgVisualFields(charId, p),
        ceGroup('Slots (' + slots.length + ')',
            // s2 between cards, per SS7.3. Was s1, which was correct for stacked accordion
            // rows sharing a hairline and is too tight for boxes.
            ceStack(CE_T.s2, rows)
        ),
        ceGroup('Add a slot', addRow)
    ]);
}

// -- The visual fields -------------------------------------------------------
// [IMG-FIELDS] These SEVEN fields have existed on CharacterRecord since
// the bridge roster was retired and have never had an engine-side editor -- the bridge's
// Visuals tab was the only way to reach any of them. Nothing here is new data and nothing
// here is a new write path: all four text fields are CFV_DIRECT keys and the three numeric
// ones go through applyCharFieldValue's CFV_NUM branch, so every one routes through the
// same ceProfileWrite every other field on this surface uses.
//
// THE FOUR TAG FIELDS ARE FOUR SCOPES, NOT FOUR STYLES, and the hints say so because
// getting them confused is what produces a character whose avatar and whose scene art
// disagree about their own hair colour:
//   visuals        every generation of this character, everywhere
//   uc             every generation of this character, everywhere (negative)
//   avatarVisuals  portraits and emotion slots only
//   sceneVisuals   scene illustrations only
//
// RATIO IS A SELECT, NOT TWO NUMBER FIELDS. The three shapes are the ones already settled
// in design and already used by every image surface in the project (portrait 832x1216,
// avatar 1024x1024, scene 1216x832) -- offering free-form width and height would invite
// dimensions NAI rejects and would be a fourth place the same three numbers are written
// down. A record carrying some other pair from an older bridge-side edit still renders:
// the current value is appended as its own option rather than being silently snapped to
// the nearest of the three.
// [RATIO-COLLISION] RENAMED FROM CE_IMG_RATIOS, WHICH WAS A LIVE BUG, NOT A
// tidy-up. SECTION 35 declares a SECOND top-level `var CE_IMG_RATIOS` with an incompatible
// shape ({label,w,h} rather than {id,label}). Two `var`s of one name in one script are one
// binding, and the LAST assignment at load time wins -- so this array never existed at
// runtime. The consequence was silent and shipped in earlier: the select below rendered
// three options with `undefined` ids, `known` could never become true so a bogus "Custom"
// row was always appended, and committing any option wrote undefined width/height.
// The two are NOT merged, because they are genuinely different objects: this one is a
// SELECT OPTION LIST keyed by the '<w>x<h>' string a record stores, SECTION 35's is a
// BUTTON SET carrying the numbers. Merging would make one of them derive its shape from
// the other's use, which is how they collided in the first place.
var CE_IMG_RATIO_OPTS: any[] = [
    { id: '832x1216', label: 'Portrait \u2014 832\u00d71216 (2:3)' },
    { id: '1024x1024', label: 'Square \u2014 1024\u00d71024 (1:1)' },
    { id: '1216x832', label: 'Landscape \u2014 1216\u00d7832 (3:2)' }
];

function _ceImgVisualFields(charId: string, p: any): any {
    var w = Number(p.avatarWidth || 1024);
    var hgt = Number(p.avatarHeight || 1024);
    var cur = String(w) + 'x' + String(hgt);
    var opts: any[] = [];
    var known = false;
    for (var i = 0; i < CE_IMG_RATIO_OPTS.length; i++) {
        opts.push(CE_IMG_RATIO_OPTS[i]);
        if (CE_IMG_RATIO_OPTS[i].id === cur) known = true;
    }
    if (!known) { opts.push({ id: cur, label: 'Custom \u2014 ' + String(w) + '\u00d7' + String(hgt) }); }

    return ceStack(CE_T.s4, [
        ceGroup('Look',
            ceStack(CE_T.s3, [
                h(ceField, {
                    key: 'img_visuals', k: 'img:' + charId + ':visuals',
                    label: 'Always', value: p.visuals || '', multiline: true, rows: 3,
                    placeholder: 'silver hair, green eyes, tall\u2026',
                    hint: 'Applied to every image of this character, everywhere.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'visuals', v); }
                }),
                h(ceField, {
                    key: 'img_avatarVisuals', k: 'img:' + charId + ':avatarVisuals',
                    label: 'Portraits only', value: p.avatarVisuals || '', multiline: true, rows: 2,
                    placeholder: 'upper body, looking at viewer, plain background\u2026',
                    hint: 'Added on top of Always, for the slots below only.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'avatarVisuals', v); }
                }),
                h(ceField, {
                    key: 'img_sceneVisuals', k: 'img:' + charId + ':sceneVisuals',
                    label: 'Scene art only', value: p.sceneVisuals || '', multiline: true, rows: 2,
                    placeholder: 'full body, in costume\u2026',
                    hint: 'Added on top of Always, for story illustrations only.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'sceneVisuals', v); }
                }),
                h(ceField, {
                    key: 'img_uc', k: 'img:' + charId + ':uc',
                    label: 'Never', value: p.uc || '', multiline: true, rows: 2,
                    placeholder: 'glasses, hat\u2026',
                    hint: 'Kept out of every image of this character.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'uc', v); }
                })
            ])
        ),
        ceGroup('Generation',
            ceStack(CE_T.s2, [
                ceSettingRow('Shape', 'The frame every slot below is generated at.',
                    ceSelect({
                        k: 'img:' + charId + ':ratio',
                        value: cur,
                        options: opts,
                        onCommit: function(v: string) {
                            var bits = String(v || '').split('x');
                            return (async function() {
                                await ceProfileWrite(charId, 'avatarWidth', bits[0] || '1024');
                                await ceProfileWrite(charId, 'avatarHeight', bits[1] || '1024');
                            })();
                        }
                    })
                ),
                h(ceField, {
                    key: 'img_seed', k: 'img:' + charId + ':seed',
                    label: 'Seed', value: String(p.avatarSeed || 0), multiline: false, rows: 1,
                    placeholder: '0',
                    hint: 'Zero picks a new seed each time. A fixed number keeps the same face across slots \u2014 set it once the look is right.',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'avatarSeed', v); }
                })
            ])
        )
    ]);
}

// -- Position ----------------------------------------------------------------
// [POSITION-WIRED] The Position group rendered as an empty
// accordion because position is NOT a customField — it is char.position, a fixed
// four-field record (targetId / targetName / shape / standing) written through the
// position.* branch of applyCharFieldValue.
//
// Both prose fields, per the locked design: `shape` is genesis-permanent (how this
// standing came to be), `standing` is threshold-rewritable (where it sits now).
// targetId and targetName are written TOGETHER and always as a pair, which is the
// CharPosition rule — an unresolved targetId is a working state, not an error, so
// the name travels with it rather than being looked up later.
// [PICKER] `roster` DROPPED FROM THE SIGNATURE. It fed the chip list only; the
// picker reads the cast from ceProfileStore at render time (_cePickCast), so a parameter
// still saying "this function needs the roster" would be a lie the next reader has to
// disprove. All three call sites updated in the same patch.
// [F-20] WHICH ARCHETYPE THIS SHAPE CAME FROM, DERIVED RATHER THAN STORED.
// The catalog is a one-shot seed that keeps no reference back, and adding an archetypeId to
// CharPosition to make the stage list work would quietly reintroduce the stored link the
// old ladder was torn out to remove. So the match is made on the TEXT: if shape is still
// byte-identical to a catalog entry's, that entry's standings are offered.
// IT DEGRADES THE RIGHT WAY. The moment the author edits the shape it stops matching and
// the standing list disappears -- which is correct, because they have made the relationship
// their own and a menu of generic standings is no longer the useful offer. Re-picking the
// archetype brings it back.
function _ceArchetypeForShape(cfg: any, shape: string): any {
    var s = String(shape || '').trim();
    if (!s) return null;
    var list: any[] = (cfg && cfg.relationshipArchetypes) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && String(list[i].shape || '').trim() === s) return list[i];
    }
    return null;
}

// [F-20a] cfg IS REQUIRED, NOT OPTIONAL, and the change is the actual fix rather than
// housekeeping. It shipped optional, one of the four call sites omitted it, and the failure
// was a control that quietly never appeared -- no error, no empty state, nothing to notice.
// A required parameter turns that exact mistake into a compile error at every future site.
function _ceProfilePositionKids(charId: string, p: any, cfg: any): any[] {
    var pos: any = p.position || {};
    var tid = String(pos.targetId || '');
    var kids: any[] = [];

    // [PICKER] WAS AN INLINE WRAPPING CHIP LIST. Replaced by the kit picker for
    // three reasons, in order of weight:
    //   1. It wrote targetId and targetName as TWO commits. SS13 requires one. See
    //      ceProfileWritePair.
    //   2. The list is UNBOUNDED -- SS13's own test for "full surface swap, not a
    //      dropdown, and never a wrapping row of chips that pushes the fields it must
    //      agree with off screen."
    //   3. It could not offer '__player__', so a Position against the protagonist -- the
    //      model's most common case, and named in CharPosition's own interface comment --
    //      had no route through the UI at all. _cePickCast puts it first.
    kids.push(ceStack(CE_T.s2, [
        h('div', { style: { fontSize: CE_T.fs, fontWeight: '500' } }, 'Who they are positioned against'),
        cePickerRow({
            label: '', value: String(pos.targetName || ''),
            kind: 'positionTarget', ctx: { charId: charId },
            placeholder: 'Choose a counterpart\u2026',
            hint: 'One primary counterpart. Secondaries and factions are static lorebook facets, not positions \u2014 a second primary would mean two answers to the same question.'
        })
    ]));

    if (tid) {
        // [F-20] THE DOOR THE SETTINGS BLURB HAS BEEN PROMISING. World Settings has told
        // authors for several versions that "the picker copies the chosen name into Position
        // as editable prose", and no such control existed anywhere on this surface -- the
        // catalog was editable and unreachable. These two selects are it.
        // ABOVE THE FIELDS, NOT INSIDE THEM. Seeding is something you do BEFORE writing, and
        // a control sitting under a textarea reads as an action on what is already there.
        // [F-20b] ceSelect's OWN label/hint, NOT ceSettingRow. ceSettingRow is a horizontal
        // flex row -- label and hint share the width with the control -- so a select holding
        // a full sentence crushed the words beside it into a two-word-per-line column. This
        // is CE-STYLE 8b's rule, the same one the Situational stepper cites: a row holding an
        // input is a second content column, and its explanatory words belong on a full-width
        // sub-line rather than in a slot the control is squeezing. ceSelect already renders
        // exactly that shape when given label and hint.
        var archList: any[] = (cfg && cfg.relationshipArchetypes) || [];
        var archOpts: any[] = [{ id: '', label: 'Write my own \u2014 clears the field' }];
        for (var ai = 0; ai < archList.length; ai++) {
            if (!archList[ai] || !String(archList[ai].shape || '').trim()) continue;
            archOpts.push({ id: String(archList[ai].id), label: String(archList[ai].name || archList[ai].id) });
        }
        var seeded: any = _ceArchetypeForShape(cfg, String(pos.shape || ''));
        if (archOpts.length > 1) {
            kids.push(ceSelect({
                k: 'pos:' + charId + ':arch',
                label: 'Start from an archetype',
                hint: 'Copies a shape in as ordinary prose. Nothing stays linked \u2014 edit it freely.',
                value: seeded ? String(seeded.id) : '',
                options: archOpts,
                onCommit: function(v: string) {
                    // [F-20b] BLANK CLEARS, and it could not before -- the empty option was a
                    // no-op, so once an archetype was chosen the control was stuck on it
                    // forever with no way back to a blank field.
                    //   CLEARING IS SAFE HERE BY CONSTRUCTION, which is the whole reason it is
                    //   allowed to be destructive: this select only READS as selected when the
                    //   shape still matches a catalog entry byte for byte (_ceArchetypeForShape).
                    //   So the text being cleared is provably untouched seed, never authored
                    //   prose. Edit one word and the control goes blank on its own, at which
                    //   point choosing blank again is a no-op ceSelect never even dispatches.
                    if (!v) return ceProfileWrite(charId, 'position.shape', '');
                    var pick: any = null;
                    for (var q = 0; q < archList.length; q++) {
                        if (archList[q] && String(archList[q].id) === v) pick = archList[q];
                    }
                    if (!pick) return Promise.resolve();
                    // SHAPE ONLY. Standing is a second, separate choice -- overwriting both
                    // from one tap would discard a standing the author may have written for a
                    // relationship whose shape they are only now naming.
                    return ceProfileWrite(charId, 'position.shape', String(pick.shape || ''));
                }
            }));
        }
        if (seeded && (seeded.stages || []).length) {
            var stgOpts: any[] = [{ id: '', label: 'Write my own \u2014 clears the field' }];
            for (var si = 0; si < seeded.stages.length; si++) {
                var stg = String(seeded.stages[si] || '');
                if (!stg.trim()) continue;
                // THE SENTENCE IS THE LABEL, TRUNCATED. A stage has no short name any more
                // (F-20) and inventing one for the dropdown would put a word on screen that
                // appears nowhere in the record it writes.
                stgOpts.push({ id: String(si),
                    label: (stg.length > 64 ? (stg.substring(0, 61) + '\u2026') : stg) });
            }
            var curStand = String(pos.standing || '').trim();
            var curIdx = '';
            for (var sj = 0; sj < seeded.stages.length; sj++) {
                if (String(seeded.stages[sj] || '').trim() === curStand) { curIdx = String(sj); break; }
            }
            kids.push(ceSelect({
                k: 'pos:' + charId + ':stage',
                label: 'Start from a stage',
                hint: 'Where along that shape these two currently sit. Coldest first.',
                value: curIdx, options: stgOpts,
                onCommit: function(v: string) {
                    // Same guarantee as the archetype control above: curIdx is '' unless the
                    // standing still matches a stage exactly, so blank can only clear a seed.
                    if (v === '') return ceProfileWrite(charId, 'position.standing', '');
                    var n = Math.round(Number(v));
                    var txt = String((seeded.stages || [])[n] || '');
                    if (!txt) return Promise.resolve();
                    return ceProfileWrite(charId, 'position.standing', txt);
                }
            }));
        }

        kids.push(ceStack(CE_T.s2, [
            ceH2('Shape'),
            _ceGuide('What this relationship IS \u2014 what holds these two in relation to each other. Written once at genesis and left alone; a threshold rewrites where they stand, never how it started.'),
            h(ceField, {
                key: 'pos_shape', k: 'pos:' + charId + ':shape',
                label: '', value: pos.shape || '', multiline: true, rows: 3,
                placeholder: 'What put these two in this relation to each other\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'position.shape', v); }
            })
        ]));
        kids.push(ceStack(CE_T.s2, [
            ceH2('Standing'),
            _ceGuide('Where it sits right now. This is the field a threshold rewrites, so keep it to the current state rather than the history.'),
            h(ceField, {
                key: 'pos_standing', k: 'pos:' + charId + ':standing',
                label: '', value: pos.standing || '', multiline: true, rows: 3,
                placeholder: 'Where the two of them stand as of this scene\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'position.standing', v); }
            })
        ]));
    }

    return kids;
}
// Summary line for the Position accordion head. Lives here rather than inline so the
// group renderer stays generic and does not learn about char.position.
// DEAD -- its only callers were _ceProfileGroup accordion summaries, removed
// by the condensed rewrite. Retained un-deleted this pass.

// -- Hooks -------------------------------------------------------------------
// [HOOKS-WIRED] A hook is not a field, so it cannot route through
// applyCharFieldValue — this is a second write path and it is deliberate, kept to ONE
// function so the saveCharacter/republish pair cannot be forgotten by a second caller.
// [PROFILE-CHAIN-GAP] Serialised through ceProfileOp.
//
// 'resolve' DELEGATES rather than clearing the field here. resolveCharHook is the one
// ending (record half + pressure key half) and a second one drifting apart from it is
// exactly the bug [HOOK-ONE] closed. It takes no lock of its own, so calling it from
// inside this chain is safe.
async function ceProfileHookOp(charId: string, op: string, value: any): Promise<void> {
    if (op === 'resolve') return resolveCharHook(charId).then(function() { return cePublishProfile(charId); });
    return ceProfileOp(async function() {
        try {
            var c: any = await loadCharacter(charId);
            if (!c) return;
            if (op === 'add') {
                if (c.hook) return;   // one per character
                c.hook = { id: api.v1.uuid(), targetId: '', targetName: '', description: '',
                           pressureLevel: 1, developmentNotes: [] };
                // [HOOK-MIRROR] The key is set, not left to _ceSeedPressureFromRecord,
                // which no-ops when a key already exists. A blank hook written after a
                // previous one ended used to inherit that one's tier and open at Breaking
                // point on its first scan.
                await api.v1.historyStorage.set(_cePressureKey(charId, 'hook'), 1);
            } else if (!c.hook) {
                return;
            } else if (op === 'desc') {
                c.hook.description = String(value || '').substring(0, 300);
            } else if (op === 'target') {
                // [HOOK-TARGETID] 'target' carries the REF, not a string, and writes
                // both halves inside the single load/save this function already owns —
                // CE-STYLE SS13's "same commit" rule, satisfied structurally rather than by
                // a caller remembering to make two calls in order.
                var tv: any = value || {};
                c.hook.targetId = String(tv.id || '');
                c.hook.targetName = String(tv.name || '');
            } else { return; }
            await saveCharacter(c);
            await cePublishProfile(charId);
        } catch (e) { api.v1.error('[AE:jsxprofile] hook op failed:', e); }
    });
}

// [PROFILE-CHAIN-GAP] Only the TAIL (from the second load onward) is chained.
// generateCharacterHook is a model call and must never sit inside ceProfileOp -- that
// would block every other field commit on the surface for as long as it runs.
async function ceProfileScanHook(charId: string): Promise<void> {
    try {
        var c: any = await loadCharacter(charId);
        if (!c) return;
        api.v1.ui.toast('Looking for a tension\u2026', { id: 'ce-hookscan', autoClose: false, type: 'info' });
        var gen: any = await generateCharacterHook(c, [], '');
        if (!gen) {
            api.v1.ui.toast('No clean tension found.', { id: 'ce-hookscan', type: 'error', autoClose: 2500 });
            return;
        }
        await ceProfileOp(async function() {
            var fresh: any = await loadCharacter(charId);
            if (!fresh) return;
            // [HOOK-ONE] Re-checked on the fresh record for the same reason the
            // engine's spawn branch is: the model call above ran outside this chain and the
            // author may have written one during it.
            if (fresh.hook) {
                api.v1.ui.toast('A hook is already set.', { id: 'ce-hookscan', type: 'info', autoClose: 2000 });
                return;
            }
            fresh.hook = { id: api.v1.uuid(), targetId: gen.targetId || '', targetName: gen.targetName || '',
                           description: String(gen.description || '').substring(0, 300),
                           pressureLevel: 1, developmentNotes: [] };
            await api.v1.historyStorage.set(_cePressureKey(charId, 'hook'), 1);
            await saveCharacter(fresh);
            api.v1.ui.toast('Hook added.', { id: 'ce-hookscan', type: 'success', autoClose: 1500 });
            await cePublishProfile(charId);
        });
    } catch (e) {
        api.v1.error('[AE:jsxprofile] hook scan failed:', e);
        try { api.v1.ui.toast('Scan failed.', { id: 'ce-hookscan', type: 'error', autoClose: 2000 }); } catch (e2) {}
    }
}

// [HOOK-ONE] ONE CARD OR AN EMPTY STATE, never a list. The list was the surface
// half of a lie the engine never told: every reader took hooks[0], so an author who added
// a second and a third was writing into nothing. `cfg` resolves a '__player__' target,
// which has no name in the record.
//
// ONE ENDING BUTTON. Resolve and Delete were the same act — null the field, clear the
// pressure key — wearing two labels and two toasts, and they now share resolveCharHook.
function _ceProfileHooks(charId: string, p: any, cfg: any): any {
    var hk: any = p.hook || null;
    var kids: any[] = [];
    if (hk) {
        kids.push(h(ceField, {
            key: 'hk_d_' + hk.id, k: 'hook:' + hk.id + ':desc',
            label: 'Tension', value: hk.description || '', multiline: true, rows: 2,
            placeholder: 'What is unresolved between them\u2026',
            onCommit: function(v: string) { return ceProfileHookOp(charId, 'desc', v); }
        }));
        kids.push(cePickerRow({
            label: 'Toward',
            value: ceIsProtagonistRef(hk.targetId)
                ? String((cfg && cfg.protagonistName) || 'the player')
                : String(hk.targetName || ''),
            kind: 'hookTarget', ctx: { charId: charId },
            placeholder: 'Who it is directed at\u2026'
        }));
        // The spawn wording, shown only once an escalation has rewritten the line above
        // it. Written since [HOOK-ESCALATE] and read by nothing until now, which made the
        // drift it exists to expose invisible.
        if (hk.genesisDescription && String(hk.genesisDescription) !== String(hk.description || '')) {
            kids.push(ceProse('t3', 'Started as: ' + String(hk.genesisDescription), { key: 'hk_gen' }));
        }
        kids.push(ceBar(CE_T.s2, [
            ceBtn('Resolve', 'hookres:' + hk.id, function() {
                return ceProfileHookOp(charId, 'resolve', null);
            })
        ]));
    } else {
        kids.push(ceProse('t3',
            'No hook. A hook is one directed, unresolved tension \u2014 something owed, '
            + 'threatened, hidden, or wanted from a specific person. It is what gives the character '
            + 'a reason to act before the story hands them one.'));
        kids.push(ceInline(CE_T.s2, [
            ceBtn('Scan for one', 'hookscan:' + charId, function() { return ceProfileScanHook(charId); }),
            ceBtn('Write one', 'hookadd:' + charId, function() { return ceProfileHookOp(charId, 'add', null); })
        ]));
    }
    return ceSection('Hooks', ceStack(CE_T.s4, kids));
}

// -- Pattern junction --------------------------------------------------------
// [CONDENSED] The
// pattern was a tappable row opening a full-surface drill to choose one of six. Six chips
// fit on the surface they belong to, so the drill is gone and the picker renders inline.
// _cePatternPicker is UNCHANGED and still serves the build flow, which does want a step.
function _ceProfilePatternSection(charId: string, p: any): any {
    var pat = CE_PATTERN_DEFS[String(p.pattern || '')] || null;
    var open = _ceOpenIs(CE_PAT_OPEN);
    var head = h('div', {
        role: 'button', tabIndex: 0,
        'aria-expanded': open ? 'true' : 'false',
        'aria-label': open ? 'Hide pattern choices' : 'Change pattern',
        onClick: function() { ceTap(CE_PAT_OPEN, function() { _ceSetOpen(CE_PAT_OPEN, !open); }); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3,
            minHeight: CE_T.ctl, cursor: 'pointer' }
    },
        h('div', { style: { flex: '0 0 auto', width: '10px', height: '10px', borderRadius: '50%',
            background: pat ? pat.c : 'transparent',
            border: pat ? 'none' : '1px solid ' + CE_LINE2 } }),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', fontSize: CE_T.fsSm,
            opacity: pat ? CE_OP.t2 : CE_OP.t3, overflow: 'hidden',
            textOverflow: 'ellipsis', whiteSpace: 'nowrap' } },
            pat ? (pat.sub + ' \u2014 ' + pat.blurb)
                : 'Not chosen \u2014 Resistance and Conduct stay generic until it is'),
        h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fsSm, opacity: CE_OP.t3 } },
            open ? 'Close' : (pat ? 'Change' : 'Choose'))
    );
    return ceSection('Pattern', ceStack(CE_T.s3, [
        head,
        open ? _cePatternPicker(charId, p, false, CE_PAT_OPEN) : null
    ]));
}

// -- Drills ------------------------------------------------------------------
// Full surface swaps, not overlays. See the header note on why an opaque
// floating panel is not constructible here.
function _cePatternPicker(charId: string, p: any, fromBuild: boolean, closeId?: string): any {
    var kids: any[] = [];
    for (var i = 0; i < CE_PATTERN_ORDER.length; i++) {
        kids.push((function(pid: string) {
            var d = CE_PATTERN_DEFS[pid];
            var on = String(p.pattern || '') === pid;
            return h('div', {
                onClick: function() {
                  ceTap('pick:pattern:' + pid, function() {
                    ceAction('pattern:' + charId, function() {
                        return ceProfileWrite(charId, 'pattern', pid).then(function() {
                            // [PAT-COLLAPSE] Choosing IS the dismissal.
                            // Six cards are worth the space while deciding and worth none
                            // afterwards, and the section head keeps showing the answer.
                            if (closeId) _ceSetOpen(closeId, false);
                            if (!fromBuild) _ceProfileDrill('', 0);
                        });
                    });
                  });
                },
                style: {
                    cursor: 'pointer', padding: CE_T.s3, borderRadius: CE_T.r,
                    background: on ? CE_FILL : 'transparent',
                    border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
                    borderLeft: '3px solid ' + d.c,
                    display: 'flex', flexDirection: 'column', gap: '3px'
                }
            },
                h('div', { style: { fontSize: CE_T.fsKey, letterSpacing: '0.09em', textTransform: 'uppercase', opacity: '0.58' } }, d.sub),
                h('div', { style: { fontSize: CE_T.fs, lineHeight: '1.45' } }, d.name),
                ceProse('t3', d.blurb)
            );
        })(CE_PATTERN_ORDER[i]));
    }
    return h('div', { style: {
        display: 'grid', gap: CE_T.s2,
        gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))'
    } }, kids);
}

// -- Pressure strip ----------------------------------------------------------
// Persistent, not behind a disclosure triangle. This is the highest-frequency
// control on the surface and burying it one tap deep is the exact failure the
// old Drama modal represented.
function _ceTierBar(axis: string, tier: number, tall: boolean): any {
    var floor = _ceAxisFloor(axis);
    var cells: any[] = [];
    for (var i = floor; i <= 4; i++) {
        var on = (tier >= 0) ? (i >= 0 && i <= tier) : (i <= 0 && i >= tier);
        cells.push(h('div', { style: {
            flex: '1 1 0', height: tall ? '3px' : '2px', borderRadius: '2px',
            // [STYLE2] These cells are NON-TEXT, so their weight is a color-mix,
            // not an opacity rung -- SS4: "Non-text dimming (rules, fills, decorative
            // glyphs) uses CE_LINE/CE_FILL, which are color-mix values, not opacity --
            // keeping the two vocabularies separate is what makes the audit able to tell a
            // dimmed label from a hairline." The old `opacity: 0.65` on a lit cell was the
            // one place a fill borrowed a text rung. The top-tier CE_SEM.ask cell is
            // untouched and still undimmed (SS6: semantic colours never take an opacity).
            background: on
                ? (tier >= 4 ? CE_SEM.ask : 'color-mix(in srgb, currentColor 65%, transparent)')
                : CE_LINE,
            outline: (i === 0 && floor < 0) ? '1px solid ' + CE_LINE2 : 'none'
        } }));
    }
    return ceBar('2px', cells);
}
function _ceTierStepper(charId: string, axis: string, label: string, tier: number): any {
    // [STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): this sizes
    // the +/- stepper button glyph, not a heading.
    var stepStyle = {
        width: '32px', height: '32px', fontSize: '15px', lineHeight: '1', color: 'inherit',
        background: 'transparent', border: '1px solid ' + CE_LINE, borderRadius: CE_T.r,
        cursor: 'pointer', flex: '0 0 auto'
    };
    function bump(d: number) {
        ceAction('tier:' + charId + ':' + axis, function() {
            return ceProfileSetTier(charId, axis, tier + d);
        });
    }
    return h('div', { style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, minHeight: CE_T.tap } },
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '5px' } },
            h('div', { style: { display: 'flex', fontSize: CE_T.fsSm } },
                h('div', { style: { flex: '1 1 auto', letterSpacing: '0.06em', textTransform: 'uppercase', opacity: '0.58' } }, label),
                h('div', { style: { opacity: '0.74' } }, (tier > 0 ? '+' : '') + tier)
            ),
            _ceTierBar(axis, tier, true),
            ceSub('t3',
                axis === 'hook' ? '0 clears it \u00b7 +4 breaking point'
                                : '\u22124 progress \u00b7 +4 friction')
        ),
        h('button', { onClick: function() { ceTap('step:' + axis + ':dn', function() { bump(-1); }); }, style: stepStyle }, '\u2212'),
        h('button', { onClick: function() { ceTap('step:' + axis + ':up', function() { bump(1); }); }, style: stepStyle }, '+')
    );
}
// -- Axis thought history -----------------------------------------------------
// [PROFILE-THOUGHT-HIST] Read-only trail under a pressure axis -- the same
// evidence the tier arithmetic consumed, so a flat tier reads as more than a number
// that moved for no visible reason. `list` is either hookNotes (bare phrases) or a
// pursuitHist/positionHist entry ({state, note}) from _ceReadProfileTiers. Renders
// nothing when empty rather than an empty heading -- same rule ceHeader follows.
function _ceAxisHistory(list: any[]): any {
    if (!list || !list.length) return null;
    var rows: any[] = [];
    for (var i = 0; i < list.length; i++) {
        var it: any = list[i];
        var line = (typeof it === 'string') ? it : (it.note || '');
        if (it && it.state) { line = '[' + it.state + '] ' + line; }
        if (!line) continue;
        rows.push(ceProse('t3',
            '\u2022 ' + line, { key: 'axhist_' + i }));
    }
    if (!rows.length) return null;
    return ceStack('2px', rows);
}

function _ceProfilePressure(charId: string, tiers: any, open: boolean): any {
    if (!tiers) return null;
    function mini(label: string, axis: string, tier: number) {
        return h('div', { style: { flex: '1 1 0', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '3px' } },
            h('div', { style: { display: 'flex', gap: CE_T.s1, fontSize: CE_T.fsSm, opacity: '0.58' } },
                h('div', { style: { flex: '1 1 auto', letterSpacing: '0.06em', textTransform: 'uppercase',
                    overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, label),
                h('div', null, (tier > 0 ? '+' : '') + tier)
            ),
            _ceTierBar(axis, tier, false)
        );
    }
    var level = 'calm';
    if (tiers.hook >= 4 || tiers.pursuit >= 4 || (tiers.hasPosition && tiers.position >= 4)) { level = 'ask'; }
    else if (Math.abs(tiers.hook) >= 2 || Math.abs(tiers.pursuit) >= 2 || (tiers.hasPosition && Math.abs(tiers.position) >= 2)) { level = 'building'; }

    var head = h('div', {
        onClick: function() { ceTap('acc:pressure', function() { ceToggleOpen('pressure'); }); },
        style: { display: 'flex', alignItems: 'center', gap: CE_T.s3, cursor: 'pointer', padding: CE_T.s3 + ' 0' }
    },
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', gap: CE_T.s3 } },
            mini('Hook', 'hook', tiers.hook),
            mini('Pursuit', 'pursuit', tiers.pursuit),
            tiers.hasPosition ? mini(tiers.targetName, 'position', tiers.position) : null
        ),
        ceDot(level)
    );
    if (!open) return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } }, head);
    return h('div', { style: { borderBottom: '1px solid ' + CE_LINE } }, head,
        ceStack({ gap: CE_T.s2, padBottom: CE_T.s3 }, [
            _ceTierStepper(charId, 'hook', 'Hook', tiers.hook),
            _ceAxisHistory(tiers.hookNotes),
            _ceTierStepper(charId, 'pursuit', 'Pursuit', tiers.pursuit),
            _ceAxisHistory(tiers.pursuitHist),
            tiers.hasPosition ? _ceTierStepper(charId, 'position', 'With ' + tiers.targetName, tiers.position) : null,
            tiers.hasPosition ? _ceAxisHistory(tiers.positionHist) : null
        ])
    );
}

// -- Portrait anchor ---------------------------------------------------------
// [PROFILE-IMG-ANCHOR] The engine does not and will not carry image bytes.
// It carries an ANCHOR the bridge paints onto — the same arrangement chat avatars
// already run in production (AE_CHARCHAT_AVA_SENTINEL, engine ~3065): the engine emits
// a sentinel string, the bridge finds it and floats the real image over it. This is the
// profile-surface member of that family.
//
// FLAG-DAY LITERAL, same rule as the other two: this string is duplicated in the bridge
// as a plain literal (the two files share no module). Change it in one place only and
// portraits silently stop binding, with no error anywhere.
//
// Payload is 'charId|slot' where slot is one of the three ratios settled in design:
//   portrait  832x1216 (2:3)   avatar  1024x1024 (1:1)   scene  1216x832 (3:2)
// The frame element carries the target box; the bridge is responsible for the
// arithmetic cover-crop, because the bridge has real DOM and can read intrinsic
// dimensions, and because object-fit is still unverified in this sandbox.
//
// -- Hero --------------------------------------------------------------------
// Identity, the three state chips, and the portrait frame. Active is NOT here:
// it is a rarely-touched master switch and lives in the settings drill. Follow
// camera takes that slot because it is the one that gets flipped mid-scene.
// -- Equipment drill  [PHASE-F] --------------------------------------
// CE-ROADMAP v0.2 Phase F, closing surface_list lines 19-22. Line 23 (the item entity
// edit modal) was E's and is already SECTION 36, which is why every row here is a door to
// it rather than a second item editor.
//
// TWO STATES PER ITEM AND THEY ARE NOT THE SAME STATE. CARRIED is a graph fact (the item's
// parentId is this character's body) and is what the list membership means. WORN is
// char.equippedItemIds and is what the toggle means. The native sheet has always drawn it
// this way; the mistake worth naming is treating the toggle as removal, which it is not --
// unequipping leaves the thing in their hands.
//
// NO "DROP" VERB, ON PURPOSE. Taking an item OUT of someone's hands is a reparent, and
// reparenting has one editor already: the Entity surface's own Placement picker, which
// every row here taps through to. A second control for the same write, on a surface that
// does not show the destination tree, is how two answers to one question start.
//
// THE ROW IS SIBLINGS, NOT A TAPPABLE CARD, for the reason SS8 gives and the scene roster
// settled: it holds two targets (open the item; wear it), and one ceTap around both would
// fire both handlers on a single physical tap.
//
// LEAVING FOR THE ITEM DOES NOT CLOSE THIS DRILL, and that is deliberate rather than
// incidental: ceNav patches surface/entityId/back and never touches profileDrill, so the
// Entity surface's Back lands here again instead of on the profile root. Equipping a
// character is a loop -- open a thing, read it, come back, wear it -- and the alternative
// costs a tap on every pass through it.
function _ceProfileEquipDrill(charId: string, p: any, eq: any): any {
    var backAddr: any = { surface: 'profile', entityId: charId, label: p.name || 'Profile' };
    var e: any = eq || {};

    if (!e.bodyOk) {
        // STATED, NOT DIMMED (SS4's disabled rule): the reason is on screen and the repair
        // is one tap, because "no body entity" is not a thing an author did wrong.
        return ceStack(CE_T.s3, [
            ceProse('t2',
                (p.name || 'This character') + ' has no physical body in the world yet, so there is '
                + 'nothing for an item to be inside. Everything else about them works; only '
                + 'carrying does not.'),
            ceBtn('Give them a body', 'eq:body:' + charId, function() {
                return ceProfileEnsureBody(charId);
            }, 'primary')
        ]);
    }

    var carried: any[] = e.carried || [];
    var rows: any[] = [];
    var wornCount = 0;
    for (var i = 0; i < carried.length; i++) {
        if (carried[i] && carried[i].worn) wornCount++;
        rows.push((function(it: any) {
            var worn = !!it.worn;
            return h('div', {
                key: 'eq_' + it.id,
                style: {
                    display: 'flex', alignItems: 'center', gap: CE_T.s2,
                    minHeight: CE_T.tap, padding: CE_T.s2 + ' 0',
                    borderBottom: '1px solid ' + CE_LINE
                }
            },
                h('div', {
                    onClick: function() {
                        ceTap('eq:open:' + it.id, function() {
                            ceNav('entity', it.id, '', backAddr);
                        });
                    },
                    style: { flex: '1 1 auto', minWidth: '0', display: 'flex',
                             alignItems: 'center', gap: CE_T.s2, cursor: 'pointer' }
                },
                    it.icon ? h('div', { style: { flex: '0 0 auto', fontSize: CE_T.fs } }, it.icon) : null,
                    ceGrow(null, [
                        h('div', { style: { fontSize: CE_T.fs, overflow: 'hidden',
                                            textOverflow: 'ellipsis', whiteSpace: 'nowrap' } }, it.name),
                        ceSub('t3',
                            worn ? 'Worn' : 'Carried')
                    ])
                ),
                ceToggle(worn, 'eq:worn:' + charId + ':' + it.id, function() {
                    return ceProfileEquipSet(charId, it.id, !worn);
                }, (worn ? 'Take off ' : 'Put on ') + it.name)
            );
        })(carried[i]));
    }

    var listNode: any = rows.length
        ? ceStack(null, rows)
        : ceEmpty('Carrying nothing.', null);

    return ceStack(CE_T.s4, [
        ceGroup('Carried (' + carried.length + (wornCount ? (', ' + wornCount + ' worn') : '') + ')',
            listNode),
        ceInline(CE_T.s2, [
            ceBtn('Add an item', 'eq:add:' + charId, function() {
                cePickerOpen('equipAdd', { charId: charId });
                return Promise.resolve();
            }),
            // Creation lands ON the new record (Phase E's premise), parented straight into
            // the body -- so the item is already carried by the time its editor opens and
            // there is no second trip to file it.
            ceBtn('New item', 'eq:new:' + charId, function() {
                return ceEntityCreate('item', String(e.entityId || ''), backAddr);
            }, 'primary')
        ]),
        ceProse('t3',
            'Worn items are the ones the story and the image prompt know about. '
            + 'To put something down, open it and change what it is inside.')
    ]);
}

function _ceProfileHero(p: any, charId: string): any {
    var sub: string[] = [];
    if (p.occupationRole) sub.push(p.occupationRole);
    if (p.age) sub.push(p.age);
    var idb: string[] = [];
    if (p.species) idb.push(p.species);
    if (p.gender) idb.push(p.gender);
    var flags = p.flags || {};

    function chip(label: string, on: boolean, key: string, next: any) {
        return h('div', {
            onClick: function() {
                ceTap('flag:' + charId + ':' + key, function() {
                    ceAction('flag:' + charId + ':' + key, function() { return ceProfileWrite(charId, key, next); });
                });
            },
            style: {
                display: 'inline-flex', alignItems: 'center', minHeight: '26px', padding: '0 ' + CE_T.s2,
                fontSize: CE_T.fsKey, letterSpacing: '0.06em', textTransform: 'uppercase', cursor: 'pointer',
                // [PASS-C] rPill, not r. CE-STYLE assigns rPill to chips and this helper is
                // deliberately a per-surface twin of ceChip (see ceChip's own note) -- a twin
                // that renders a different shape is just an inconsistency with a reason
                // attached to the wrong half.
                borderRadius: CE_T.rPill, border: '1px solid ' + (on ? CE_LINE2 : CE_LINE),
                background: on ? CE_FILL : 'transparent', opacity: on ? CE_OP.t1 : CE_OP.t3
            }
        }, label);
    }

    return ceBar({ gap: CE_T.s4, padBottom: CE_T.s3, align: 'start' }, [
        // [CE-IMG-ATTR] The frame IS the anchor. The '+' is the empty state and
        // stays in the tree: the bridge paints an absolutely-positioned <img> OVER it when
        // the Avatar slot has an image and leaves it alone when it does not, so "no
        // portrait yet" needs no second branch on either side.
        // [HERO-DIM-FIX] The
        // frame's own style carried opacity:'0.58' alongside its background/border. CSS
        // opacity applies to the whole subtree, and the bridge paints its <img> as a CHILD
        // of this exact node -- so every real portrait rendered at 58% opacity too, not
        // just the '+' it was written for. Moved onto the glyph's own div, which is what
        // every other avatar frame in this file already does (Images grid, Scene roster).
        h('div', ceImgAnchor(charId, CE_IMG_SLOT_AVATAR, {
            onClick: function() { ceTap('drill:images', function() { _ceProfileDrill('images', 0); }); },
            style: {
                flex: '0 0 auto', width: '84px', height: '126px', borderRadius: CE_T.r,
                background: CE_FILL, cursor: 'pointer', position: 'relative', overflow: 'hidden',
                display: 'flex', alignItems: 'center', justifyContent: 'center'
            }
        }),
            // [STYLE2] Allowlisted non-heading glyph sizing (CE-STYLE 12.1): this
            // sizes the '+' empty-avatar placeholder glyph, not a heading.
            h('div', { style: { fontSize: '20px', opacity: '0.58' } }, '+')
        ),
        h('div', { style: { flex: '1 1 auto', minWidth: '0', display: 'flex', flexDirection: 'column', gap: '6px' } },
            h('div', {
                onClick: function() { ceTap('drill:identity', function() { _ceProfileDrill('identity', 0); }); },
                style: { cursor: 'pointer', display: 'flex', flexDirection: 'column', gap: '4px' }
            },
                ceH1((p.name || 'Unnamed') + (p.isProtagonist ? ' (you)' : '')),
                sub.length ? ceSub('t3', sub.join(' \u00b7 ')) : null,
                idb.length ? ceSub('t3', idb.join(' \u00b7 ')) : null
            ),
            ceInline({ gap: CE_T.s1, padTop: CE_T.s1 }, [
                // [D-01] The protagonist's door. Tapping the chip on someone who is already
                // the protagonist CLEARS the pointer -- "no protagonist" is a supported
                // state, not a hole, so the control has to be able to reach it.
                chip('Protagonist', !!p.isProtagonist, 'flag.isProtagonist', !p.isProtagonist),
                chip('Follow', !!flags.followCamera, 'flag.followCamera', !flags.followCamera),
                // [F-4] ABSENT IS ON, so the chip reads the negation of an explicit false
                // rather than the truthiness of the field -- `!!undefined` would draw every
                // character as opted out on a story that has never touched this.
                chip('Summon', (flags as any).summonOnMention !== false,
                     'flag.summonOnMention', ((flags as any).summonOnMention === false)),
                // [DEAD-DYNAMIC] THIS CHIP WAS BOUND TO A FLAG NOTHING READS.
                // charContextEnabled is declared on CharacterRecord, defaulted, migrated,
                // serialized to the bridge and settable from two places -- and there is NOT
                // ONE dispatch condition, context builder or generator anywhere in this file
                // that reads it. Grep it: decl, default, migration, payload, setter, and
                // these two controls. Toggling Dynamic/Static did nothing at all, silently,
                // for as long as the chip has existed.
                //
                // REPOINTED TO autoThoughtsEnabled, which is the flag that already does
                // everything Dynamic/Static was believed to do, on both sides:
                //   GENERATION -- it gates generateEphemeral (the dispatch condition and the
                //     retry-queue branch), and generateEphemeral is what applies PURSUIT and
                //     POSITION pressure off its own reply. Off means those two axes stop
                //     moving; Hook is unaffected, since hooksEnabled gates that separately.
                //   INJECTION -- `if (!char.autoThoughtsEnabled) npcData.ephemeral = null`,
                //     which is what makes the trace read SKIP(thoughts-off). So a stale
                //     snapshot cannot sit in context behind a switched-off character.
                // Both halves were already correct and already wired. The only thing wrong
                // was which flag the visible switch moved.
                //
                // charContextEnabled IS NOW A CONFIRMED ORPHAN. It is left on the record --
                // it is persisted shape and dropping it would rewrite every stored character
                // for nothing -- but it has no control and no reader. Do not add one back
                // without deciding what the second gate would be for.
                chip(flags.autoThoughtsEnabled ? 'Thoughts on' : 'Thoughts off', !!flags.autoThoughtsEnabled,
                     'flag.autoThoughtsEnabled', !flags.autoThoughtsEnabled),
                chip(flags.hooksEnabled ? 'Hooks on' : 'Hooks off', !!flags.hooksEnabled,
                     'flag.hooksEnabled', !flags.hooksEnabled)
            ])
        )
    ]);
}

// -- Launcher grid -----------------------------------------------------------
// [LAUNCHER-QUIET] Was a 2x3 block of 42px filled cells that read as
// the loudest element on a surface where it is the least important — six doors, none of
// which is where the work happens. Now one wrapping row of quiet text links. Having
// content still shows as weight rather than a badge (there is still no color token to
// spend on state), but the whole strip sits at label scale instead of button scale.
// [POV-REMEMBERED] Takes `cfg` now, for one cell only: Chat reads the remembered
// pov out of it so a tap can start the thread instead of asking a question this surface
// already knows the answer to.
function _ceProfileLaunchers(p: any, cfg: any, eq: any, sd: any, shape: string): any {
    var sch: any = ceSchedOf(p);
    var cells: any[] = [
        // [earlier PROFILE-WALKTHROUGH, per user "the button that opened profile
        // walkthrough is gone"] It never left -- the guided build's only door (the
        // Continue bar) is CONDITIONAL on an unanswered step, so it disappears the moment
        // a build is finished, with nothing left to reopen it from. This is that door,
        // permanent, in the launcher row rather than an inline bar that can vanish.
        // Studio shape ONLY: _ceProfileBuild renders CE_FIELD_GROUP_ORDER slot cards and
        // patterns, which classic-shape characters do not have.
        (shape === 'studio')
            ? { id: 'build', label: 'Walkthrough', has: true, build: true }
            : null,
        // `has` flips false -> true on the SAME rule Settings already uses, not a
        // new one: this cell used to be false because "no engine-side renderer yet" (see
        // equipment/conditions below, still true for that reason). It now HAS a real
        // renderer -- _ceProfileImagesDrill always shows the full 26-slot grid -- so it is
        // unconditional the same way Settings is, not a data check. It CANNOT be a data
        // check: whether any slot is actually filled lives in the bridge's IndexedDB, not
        // here, and the withdrawn IMAGE-INDEX entry in the index is the record of why this
        // file must not try to mirror that to answer the question.
        { id: 'images', label: 'Images', has: true },
        // [JSXJOURNAL] `nav` makes this cell a route rather than a drill. The
        // journal is reachable from Scene too and carries its own scope, so it cannot be
        // a value on profileDrill without two places owning which journal is showing.
        { id: 'journal', label: 'Journal', has: true, nav: 'journal' },
        // [POV-REMEMBERED] Chat is a ONE-TAP START, not a drill and not
        // a trip through the Chat surface. The pov is remembered (cfg.charChatPovId), so
        // there is nothing left to ask: this goes straight to the thread for (this
        // character, that pov) and startCharChat resolves start-vs-resume itself from the
        // deterministic entry id. `has` is now whether texting is POSSIBLE rather than
        // whether a chatPersona was authored -- the engine has never required one to text
        // someone, so the old condition was dimming a door that always worked.
        { id: 'chat', label: 'Chat', has: true, chat: true },
        // [PHASE-F] `has` IS A REAL DATA CHECK HERE, unlike Images. Whether a
        // character is carrying anything is engine-known -- it is the entity graph -- so
        // this is the ladder's has/has-not doing the job it was described as doing, not a
        // stand-in for "a renderer exists". A body-less character reads has:false too,
        // which is honest: there is nothing there, and the drill says why.
        { id: 'equipment', label: 'Equipment', has: !!(eq && eq.carried && eq.carried.length) },
        // [PHASE-COND] Real data check, same as Equipment's: whether anything
        // is live on this character is a field on the record. A world with no condition
        // DEFS also reads has:false, which is honest -- the drill then explains that and
        // points at Settings.
        // [F-09] The Conditions cell WAS here and is now gone, not hidden -- conditions
        // became state defs, so the two cells became one and the scheduled overlap closed on
        // schedule. `has` is whether anything is scoped to THIS character, not whether a value
        // has moved off its start: a state at its starting value is still a state this person
        // has, unlike a condition, which was absent until switched on.
        { id: 'states', label: 'States', has: !!(sd && sd.rows && sd.rows.length) },
        // [SEC:SCHED] `has` IS A REAL DATA CHECK, Equipment's kind rather than Images'.
        // Whether this person keeps a timetable is a field on the record, and most people do
        // not -- so a dim cell here is honest rather than a stand-in for a missing renderer.
        { id: 'schedule', label: 'Schedule',
          has: !!(sch && sch.enabled && sch.plans && sch.plans.length
                  && sch.plans.some(function(pp: any) { return pp.rows && pp.rows.length; })) },
        // [LOC-PROFILE2] THE BODY HAD NO DOOR. A character's entity is where they
        // stand in the world and what connects to them, and post-ENT-ID1 it is at the
        // character's own id -- so this is a route, not a drill, and it lands on the
        // Entity surface with the graph drill already open. `has` is unconditional for
        // the same reason Images is: a body always exists (ceProfileEnsureBody), and
        // whether it is interesting is not a question this cell can answer.
        { id: 'entity', label: 'Entity', has: true, entity: true },
        { id: 'settings', label: 'Settings', has: true }
    ];
    var kids: any[] = [];
    for (var i = 0; i < cells.length; i++) {
        if (!cells[i]) continue;
        kids.push((function(c: any) {
            return h('div', {
                onClick: function() {
                    ceTap('drill:' + c.id, function() {
                        if (c.build) {
                            _ceProfileDrill('build', 0);
                        } else if (c.chat) {
                            // ceAction, not a bare call: starting a chat writes the document
                            // and handlers double-fire (JSX-PROBE-RESULTS 1), so without the
                            // in-flight latch one tap appends two markers.
                            ceAction('profile:chat:' + String(p.id || ''), function() {
                                return startCharChat(String(p.id || ''), ceChatSavedPov(cfg, String(p.id || '')))
                                    .then(function() {
                                        // Hand off to the story document, same as the Chat
                                        // surface's own contact rows: the conversation lives
                                        // in the story on native Send, never in a modal.
                                        try {
                                            if (_ceSceneHandle && _ceSceneHandle.close) { _ceSceneHandle.close(); }
                                        } catch (_eClP) {}
                                    });
                            });
                        } else if (c.entity) {
                            // [LOC-PROFILE2] A ROUTE, NOT A DRILL. The body's editor
                            // is the Entity surface, which owns its own store and its own
                            // op-chain; rendering it inside Profile would mean two surfaces
                            // writing the same record through different locks. Post-ENT-ID1
                            // the body is at the character's own id, so there is nothing to
                            // resolve -- this is why the door could not exist before.
                            ceNav('entity', String(p.id || ''), '',
                                  { surface: 'profile', entityId: String(p.id || ''),
                                    label: p.name || 'Profile' });
                        } else if (c.nav) {
                            ceNav(String(c.nav), String(p.id || ''), '',
                                  { surface: 'profile', entityId: String(p.id || ''),
                                    label: p.name || 'Profile' });
                        } else { _ceProfileDrill(c.id, 0); }
                    });
                },
                style: {
                    cursor: 'pointer', fontSize: CE_T.fsSm, letterSpacing: '0.04em',
                    // Ladder: these are labels ABOUT content, so a group holding
                    // something sits at t2 and an empty one at t3 -- presence is the
                    // difference between two tiers of equal importance, which is exactly
                    // what SS4 says opacity is still allowed to express.
                    padding: CE_T.s1 + ' 0', opacity: c.has ? CE_OP.t2 : CE_OP.t3,
                    borderBottom: '1px solid ' + (c.has ? CE_LINE2 : CE_LINE)
                }
            }, c.label);
        })(cells[i]));
    }
    return h('div', { style: {
        display: 'flex', flexWrap: 'wrap', gap: CE_T.s4,
        padding: CE_T.s3 + ' 0', borderBottom: '1px solid ' + CE_LINE
    } }, kids);
}

// -- Classic character sheet -------------------------------------------------
// [SHEET-GEN] The five static fields, each with a Generate button
// that fills from the concept dump. Instruction and budget resolution is cfg-override-
// else-def, the same order the AE_GENERATE_SLOT handler uses — not a second policy.
var CE_SHEET_FIELDS: any[] = [
    { k: 'physicalDescription', label: 'Physical Description' },
    { k: 'personalityCore', label: 'Personality Core' },
    { k: 'voiceAndMannerisms', label: 'Voice & Mannerisms' },
    { k: 'background', label: 'Background' }
];
function _ceSheetDef(key: string): any {
    for (var i = 0; i < STATIC_FIELD_DEFS.length; i++) {
        if (STATIC_FIELD_DEFS[i].key === key) return STATIC_FIELD_DEFS[i];
    }
    return null;
}
// [DRIVE-IN-CLASSIC] The two pattern-INDEPENDENT slots now live on the
// classic sheet. This is the whole reason the two shapes stopped being rivals.
//
// generateEphemeral reads ce_slot_core and ce_slot_pursuit by id, and pursuitState -- the
// classification that moves the pursuit tier, which is what _ceFrameIntent escalates on --
// is gated on ce_slot_pursuit existing at all. A sheet-only character therefore still
// THINKS (personalityCore, voiceAndMannerisms, position and story all still reach the beat
// prompt) but never escalates from wanting to acting, because the axis has nothing to
// classify. Two fields close that, and neither of them needs a pattern chosen.
//
// Presence is deliberately NOT here: it is a restatement of Physical Description and would
// be the one duplicated field on a surface whose entire redesign was about not showing the
// same writing twice.
var CE_DRIVE_SLOTS: string[] = ['ce_slot_core', 'ce_slot_pursuit'];
function _ceCustomById(p: any, id: string): any {
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && String(list[i].id || '') === id) return list[i];
    }
    return null;
}

// [CONDENSED] Was
// a single ceAccordion holding all five fields, so reaching Background meant one tap and a
// scroll past everything above it. Now two ceSections, everything on screen, each field a
// guide bar + textarea + generator. Read density, per CE-STYLE SS7.1: this is prose the
// author wrote, and the writing is the interface.
// [SHEET-BLOCK] Extracted from _ceProfileClassic so Profile Plus can render a
// sheet field too. `background` is the case that forced it: the history group is SLOTLESS
// (BUILTIN_FACETS defines no slot for it) and its facets self-suppress while empty, so the
// Background section in Plus was a heading with nothing under it -- while the record's own
// `background` prose, which every context builder already reads, sat unreachable on the
// other shape. Record prose is shape-independent; only the SLOT model is Plus-only.
function _ceSheetFieldBlock(charId: string, p: any, cfg: any, fd: any): any {
    var def = _ceSheetDef(fd.k);
    var inst = (cfg && cfg.fieldInstructions && cfg.fieldInstructions[fd.k])
        || (def ? def.defaultInstructions : '');
    var budget = (cfg && cfg.fieldBudgets && cfg.fieldBudgets[fd.k])
        || (def ? def.defaultBudget : 150);
    return ceStack(CE_T.s1, [
        _ceGuideBar(fd.label, inst),
        _ceGuide(inst, true),
        h(ceField, {
            key: 'sheet_' + fd.k, k: 'sheet:' + charId + ':' + fd.k,
            label: '', value: p[fd.k] || '', multiline: true, rows: 4,
            placeholder: def ? def.placeholder : '',
            onCommit: function(v: string) { return ceProfileWrite(charId, fd.k, v); }
        }),
        _ceGenBtn(p, charId, fd.k, fd.label, inst, budget)
    ]);
}
function _ceSheetFieldByKey(key: string): any {
    for (var i = 0; i < CE_SHEET_FIELDS.length; i++) {
        if (CE_SHEET_FIELDS[i].k === key) return CE_SHEET_FIELDS[i];
    }
    return null;
}
function _ceProfileClassic(charId: string, p: any, cfg: any): any {
    var sheetKids: any[] = [];
    var i = 0;
    for (i = 0; i < CE_SHEET_FIELDS.length; i++) {
        sheetKids.push(_ceSheetFieldBlock(charId, p, cfg, CE_SHEET_FIELDS[i]));
    }
    sheetKids.push(ceStack(CE_T.s1, [
        ceKey('Core Values'),
        h(ceField, {
            key: 'sheet_coreValues', k: 'sheet:' + charId + ':coreValues',
            label: '', value: (p.coreValues || []).join('\n'), multiline: true, rows: 3,
            placeholder: 'One value per line\u2026',
            onCommit: function(v: string) {
                return ceProfileWrite(charId, 'coreValues',
                    String(v || '').split('\n').map(function(s2: string) { return s2.trim(); })
                        .filter(function(s2: string) { return !!s2; }));
            }
        })
    ]));

    var driveKids: any[] = [];
    driveKids.push(ceProse('t3',
        'The two lines the per-beat pass reads. Without them a character still thinks \u2014 '
        + 'their intent just never escalates from wanting to acting.'));
    for (i = 0; i < CE_DRIVE_SLOTS.length; i++) {
        var df = _ceCustomById(p, CE_DRIVE_SLOTS[i]);
        if (df) driveKids.push(_ceSlotCard(charId, p, cfg, df, '', ''));
    }

    return ceStack(CE_T.s5, [
        ceSection('The sheet', ceStack(CE_T.s4, sheetKids)),
        (driveKids.length > 1)
            ? ceSection('Drive', ceStack(CE_T.s4, driveKids))
            : null
    ]);
}

// [SHAPE-TOGGLE] The shape switch moves OUT of the Settings drill and
// onto the profile, above the field column.
//
// It was buried because switching used to be a COMMITMENT: the two shapes were mutually
// exclusive renderings, so whichever was inactive rendered nothing and a wrong choice
// looked like data loss. That is what an earlier _ceShapeStrandedNote existed to warn
// about, and that note is DELETED here rather than fixed -- its slot count was correct,
// it was the exclusivity underneath it that was wrong. Classic now carries Core and
// Pursuit, so Profile Plus is strictly ADDITIVE (Presence, Pattern, and the pattern-gated
// Resistance/Conduct pair) and switching can no longer hide written work.
//
// PER-CHARACTER, per user. uiShape already lives on the record; this introduces no second
// home for it and no global default to fall out of step with.
// [LOC-PROFILE4] `defs` and `p` are optional and every pre-existing call site
// omits both, so the character behaviour is byte-identical. A location passes its own two
// labels and its payload; the write routes by scope like every other write on this pair of
// surfaces. One toggle, two records -- not a second toggle that looks the same.
function _ceShapeToggle(charId: string, shape: string, defs?: any[], p?: any): any {
    if (!defs) {
        defs = [
            { id: 'classic', label: 'Classic' },
            { id: 'studio',  label: 'Profile Plus' }
        ];
    }
    var kids: any[] = [];
    for (var i = 0; i < defs.length; i++) {
        kids.push((function(o: any) {
            var on = (shape === o.id);
            return ceBtn(o.label, 'shape:' + charId + ':' + o.id, function() {
                if (on) return Promise.resolve();
                return _ceProfileWriteFor(p, charId, 'uiShape', o.id);
            }, on ? 'primary' : '');
        })(defs[i]));
    }
    return h('div', { style: {
        display: 'flex', alignItems: 'center', gap: CE_T.s2, flexWrap: 'wrap',
        padding: CE_T.s3 + ' 0', borderBottom: '1px solid ' + CE_LINE
    } },
        ceGrow(null, [ ceKey('Profile')]),
        h('div', { style: { flex: '0 0 auto', display: 'flex', gap: CE_T.s2 } }, kids)
    );
}

// [PERSONA-WIRED] Split out rather than inlined so the loop is obvious and so a
// fourth axis is one array entry. Labels are the user's words, not the storage keys: the
// stored sub-key is `verbosity` and the row says Length, because nothing on this surface
// should make someone learn a field name to use it.
var CE_PERSONA_AXES: any[] = [
    { sub: 'style',     label: 'Style',  hint: 'How they phrase things.' },
    { sub: 'verbosity', label: 'Length', hint: 'How much they write per message.' },
    { sub: 'emoji',     label: 'Emoji',  hint: '' }
];

function _cePersonaAxisRows(charId: string, persona: any, opts: any): any {
    var rows: any[] = [];
    var i = 0;
    for (i = 0; i < CE_PERSONA_AXES.length; i++) {
        var ax: any = CE_PERSONA_AXES[i];
        var list: any[] = opts[ax.sub] || [];
        // An empty option list means the payload did not ship one; render nothing rather
        // than an empty control the user can neither read nor change.
        if (!list.length) continue;
        rows.push(ceSettingRow(ax.label, ax.hint,
            ceSelect({
                k: 'persona:' + charId + ':' + ax.sub,
                value: persona[ax.sub] || 'auto',
                options: list,
                onCommit: (function(sub: string) {
                    return function(v: string) { return ceProfileWrite(charId, 'chatPersona.' + sub, v); };
                })(ax.sub)
            })));
    }
    if (!rows.length) return null;
    return h('div', null, rows);
}

function _ceProfileSettings(charId: string, p: any): any {
    var flags = p.flags || {};
    var persona = p.chatPersona || {};
    var personaOpts = p.chatPersonaOpts || {};

    // [SETTINGS-REBUILD] Rebuilt on ceH3 / ceSettingRow / ceToggle
    // rather than three locally-invented row shapes. What was wrong, specifically:
    //   - booleans were BUTTONS LABELLED WITH A VERB ("Toggle", "Switch"), so the control
    //     never showed the state and read the same in both directions;
    //   - "Texting persona" was a dim uppercase eyebrow with a row labelled "Persona"
    //     directly beneath it at body size and full brightness, so the subhead outweighed
    //     the head, and the two words said the same thing;
    //   - spacing came from a different gap value in each of the three sections.
    // Every section here is ceSection (which is ceH3) and every line is ceSettingRow, so
    // there is exactly one spacing rule and one hierarchy on this surface. See TYPE-SCALE.
    return ceStack(CE_T.s4, [
        // [SHAPE-TOGGLE] The Authoring group lived here and is gone. The shape
        // switch is now _ceShapeToggle, on the profile itself -- see there for why it no
        // longer needs to be a deliberate, buried decision.
        // [CHAR-PLACE] FIRST, ABOVE BEHAVIOUR. Where someone stands is not a
        // preference about how the engine treats them -- it is a fact about the world, and
        // it decides scene presence, which decides everything in the group below it.
        ceGroup('Place', h('div', null,
            cePickerRow({
                label: 'Where they are',
                value: _cePlaceLabel(),
                kind: 'charLocation', ctx: { charId: charId },
                placeholder: 'Nowhere',
                hint: 'Anyone standing where the camera is counts as in the scene.'
            })
        )),
        ceGroup('Behaviour', h('div', null,
            // [CHAR-ACTIVE] THE MASTER SWITCH, and it goes first because the two
            // below only matter when it is on. Off is ARCHIVE, not delete: the record, the
            // body, the images and the lorebook entry all survive, and the character simply
            // stops being processed, injected, listed in the scene roster or textable.
            // WHERE THEY GO WHEN IT IS OFF, stated because it is not obvious: an inactive
            // character is dropped from the Scene roster and the chat contacts, so the way
            // back to them is their location -- Map, or Hidden places > Graveyard if they
            // were killed. _ceEntityContents does not filter on active, which is what makes
            // that route work.
            ceSettingRow('Active',
                'Off archives them: kept in full, but not processed, not injected, and not listed in the scene or in chat. Find them again through the place they are standing in.',
                ceToggle(flags.active !== false, 'active:' + charId, function() {
                    return ceProfileWrite(charId, 'flag.active', !(flags.active !== false));
                })),
            // [DEAD-DYNAMIC] The 'Context injection' row is GONE, not renamed. It
            // drove charContextEnabled, which nothing reads, and its hint ("off means this
            // character is never injected into context") described behaviour that has never
            // existed. Leaving a switch that lies is worse than having no switch: it is the
            // control someone reaches for when a character is over-injecting, and it would
            // have kept not working. The real gate is the row below. See the chip in
            // _ceProfileHero for the full grep.
            ceSettingRow('Auto thoughts',
                'Generate a per-beat internal state for them as the story runs, and inject it. Off also stops Pursuit and Position pressure from moving, since both are read off the same update, and keeps the last snapshot out of context rather than leaving it there stale.',
                ceToggle(!!flags.autoThoughtsEnabled, 'thoughts:' + charId, function() {
                    return ceProfileWrite(charId, 'flag.autoThoughtsEnabled', !flags.autoThoughtsEnabled);
                })),
            ceSettingRow('Hooks',
                'Let the dynamic engine escalate and spawn their unresolved tensions.',
                ceToggle(!!flags.hooksEnabled, 'hooks:' + charId, function() {
                    return ceProfileWrite(charId, 'flag.hooksEnabled', !flags.hooksEnabled);
                })),
            ceSettingRow('Lorebook entry', '',
                ceSub('t3',
                    p.hasLoreEntry ? 'Linked' : 'Not linked')),
            // [PROFILE-DOORS] Filed under Behaviour rather than in a group of its
            // own because that is what it is: which characters the dynamic engine gets to
            // this turn when it cannot get to all of them. It sits directly under the two
            // switches that decide WHETHER this character is processed, since this one
            // decides WHEN.
            h('div', { style: { paddingTop: CE_T.s3 } },
                cePickerRow({
                    label: 'Dynamic priority',
                    value: _ceDynRankLabel(),
                    kind: 'dynamicRank', ctx: { charId: charId },
                    placeholder: 'Unranked',
                    hint: 'Only matters when the cast is larger than the per-turn dynamic cap. Unranked characters are processed after every ranked one.'
                }))
        )),
        // [PERSONA-TO-SETTINGS] The texting persona is a chat SETTING, matching the
        // call the bridge profile tab already made in earlier PERSONA-MOVE.
        // [PERSONA-WIRED] The three enum axes are surfaced now. earlier left them
        // out because there was no Select primitive to render them with, and that absence
        // was recorded as a preference; it was not one. The payload has carried both the
        // values and the option lists since earlier. They are gated behind Enabled for the
        // same reason the notes field is -- a disabled persona compiles to nothing, so
        // offering three controls that change nothing would be a lie about what is live.
        //
        // The three rows are rendered from an array, which ceSelect permits and ceField does
        // not: ceField calls useRef, so a variable-length loop of them would break hook
        // order. That constraint is why this list is Selects and the notes field below it is
        // a single explicit call.
        ceGroup('Texting persona', h('div', null,
            ceSettingRow('Enabled',
                'Shapes how they write in Character Chat. Off compiles to nothing.',
                ceToggle(!!persona.enabled, 'persona:' + charId, function() {
                    return ceProfileWrite(charId, 'chatPersona.enabled', !persona.enabled);
                })),
            persona.enabled ? _cePersonaAxisRows(charId, persona, personaOpts) : null,
            persona.enabled ? h('div', { style: { paddingTop: CE_T.s3 } },
                h(ceField, {
                    key: 'persona_notes', k: 'persona:' + charId + ':notes',
                    label: '', value: persona.notes || '', multiline: true, rows: 3,
                    placeholder: 'Anything specific about how they text\u2026',
                    onCommit: function(v: string) { return ceProfileWrite(charId, 'chatPersona.notes', v); }
                })
            ) : null,
            // The exact clause the model receives, not a re-description of it -- `preview`
            // is buildCharChatPersonaClause's own return value, so this readout cannot drift
            // from what is actually sent. It is the only place on any surface that shows it.
            (persona.enabled && persona.preview) ? h('div', {
                style: { fontSize: CE_T.fsSm, opacity: '0.58', lineHeight: '1.55', paddingTop: CE_T.s2 }
            }, 'Sends: ' + persona.preview) : null
        )),
        // [CONCEPT-IN-SETTINGS] Raw seed material rather than authored profile
        // content, so it sits here rather than in a group. Every Generate button on this
        // surface reads from it, which is why a character with nothing here has none.
        ceSection('Concept notes', ceStack(CE_T.s2, [
            ceProse('t3',
                'Not injected into the story and not part of the profile. Every Generate button reads from here.'),
            h(ceField, {
                key: 'conceptDump', k: 'concept:' + charId,
                label: '', value: p.conceptDump || '', multiline: true, rows: 6,
                placeholder: 'Anything you know about them, in any order\u2026',
                onCommit: function(v: string) { return ceProfileWrite(charId, 'conceptDump', v); }
            })
        ])),
        // [PROFILE-DOORS] LAST ON THE SURFACE AND BEHIND A SECOND TAP. Confirms in
        // place rather than through confirmDeleteChar's native modal -- same rule and same
        // shape as ceEntityDelete's block (SECTION 36), which is the reference. The
        // confirm flag rides the existing `open` map (_ceSetOpen / _ceOpenIs) rather than
        // adding a store key: it is session UI keyed by target, which is precisely what
        // that map is.
        _ceProfileDangerBlock(charId, p)
    ]);
}

// [CHAR-PLACE] Same no-hook direct store read as _ceDynRankLabel below, and legal
// for the identical reason. A character whose body sits in a location the index has since
// lost reads as '' -- which renders the placeholder, not a stale name.
function _cePlaceLabel(): string {
    try {
        var s: any = ceProfileStore ? ceProfileStore.get() : null;
        return String((s && s.places && s.places.locName) || '');
    } catch (e) { return ''; }
}

// [PROFILE-DOORS] Reads the dynRank projection with NO HOOK, so it stays legal
// inside _ceProfileSettings' straight-line body -- the same direct-store-read licence
// _ceOpenIs and _ceGuideOpen already take, and for the same reason.
function _ceDynRankLabel(): string {
    try {
        var s: any = ceProfileStore ? ceProfileStore.get() : null;
        var r = Number(s && s.dynRank && s.dynRank.rank) || 0;
        return r > 0 ? ('Rank ' + r) : '';
    } catch (e) { return ''; }
}

// [KILL] TWO ENDINGS, AND THEY ARE NOT THE SAME ACT. This block used to offer one.
//   KILL     -- a story event. The record, the body, the images and the lorebook entry all
//               survive; possessions drop where they fell, the body goes to the Graveyard,
//               and Active goes off. Reversible from the Graveyard.
//   DELETE   -- an authoring act. deleteCharacter cascades to the entity body and every
//               saved image slot. Nothing survives.
// Both ask first, on the shape ceEntityDelete settled, and both confirm flags ride the
// existing `open` map keyed by target rather than adding store fields.
//
// KILL IS NOT 'danger' VARIANT AND DELETE IS. The colour is spent on irreversibility, not
// on gravity -- a killed character can be brought back with one toggle, and painting both
// the same red would make the one that cannot be undone indistinguishable from the one that
// can. SS11: the destructive signal has to mean one thing.
//
// KILL IS HIDDEN ONCE THEY ARE ALREADY INACTIVE. Killing an archived character is either a
// no-op or a body-move nobody asked for, and offering it would suggest there is a third
// state it reaches.
function _ceProfileDangerBlock(charId: string, p: any): any {
    var key = 'prof:delask:' + charId;
    var asking = _ceOpenIs(key);
    var kKey = 'prof:killask:' + charId;
    var kAsking = _ceOpenIs(kKey);
    var nm = String((p && p.name) || 'this character');
    var isActive = !((p && p.flags) ? (p.flags.active === false) : false);
    return ceInline({ gap: CE_T.s2, key: 'prof_danger', rule: 'top', padTop: CE_T.s4 }, [
        (isActive && kAsking)
            ? ceProse('t2',
                'Kill ' + nm + '? Anything they are carrying drops where they are standing, their body goes to the Graveyard, and they stop being active. Everything about them is kept, and the Active switch above brings them back.', { key: 'pk_ask', grow: true, basis: '160px' })
            : null,
        (isActive && kAsking)
            ? ceBtn('Kill', 'prof:kill:' + charId, function() {
                _ceSetOpen(kKey, false);
                return killCharacter(charId);
              })
            : null,
        (isActive && kAsking)
            ? ceBtn('Spare them', 'prof:killno:' + charId, function() {
                _ceSetOpen(kKey, false);
                return Promise.resolve();
              })
            : null,
        (isActive && !kAsking && !asking)
            ? ceBtn('Kill ' + nm, kKey, function() {
                _ceSetOpen(kKey, true);
                return Promise.resolve();
              })
            : null,
        asking
            ? ceProse('t2',
                'Delete ' + nm + '? Their physical body in the world, their saved images and their lorebook entry go too. This cannot be undone.', { grow: true, basis: '160px' })
            : null,
        asking
            ? ceBtn('Delete', 'prof:del:' + charId, function() { return _ceProfileDelete(charId); }, 'danger')
            : (kAsking ? null : ceIconBtn('Delete ' + nm, ceIconTrash(), key, function() {
                _ceSetOpen(key, true);
                return Promise.resolve();
              }, 'danger')),
        asking
            ? ceBtn('Keep them', 'prof:delno:' + charId, function() {
                _ceSetOpen(key, false);
                return Promise.resolve();
              })
            : null
    ]);
}

// Navigates FIRST-CLASS to Scene rather than Back: the return address may well be the
// profile of the character that no longer exists, and a Back that lands on a deleted
// record is the bug this avoids rather than handles.
async function _ceProfileDelete(charId: string): Promise<void> {
    try {
        await deleteCharacter(charId);
        _ceSetOpen('prof:delask:' + charId, false);
        ceUiPatch(function() { return { profileDrill: '', profileStep: 0 }; });
        ceNav('scene');
        try { await cePublishScene(); } catch (eS) {}
        // The bridge still caches character visuals for image generation, so it is told
        // on the same path confirmDeleteChar uses. Non-fatal: the record is already gone
        // and a failed broadcast must not read as a failed delete.
    } catch (e) {
        api.v1.error('[AE:jsxprofile] delete failed:', e);
    }
}

// -- The guided build --------------------------------------------------------
// [BUILD-REGROUP] Three changes, all corrections of invented
// structure rather than layout preference:
//
//   1. CORE AND PURSUIT ARE ONE STEP. They are both Drive — ceStaticFieldGroup already
//      maps both slots to the 'drive' group (engine ~9683) and the walk was the only
//      thing splitting them. Two fields, two prompts, one page. Drive counts as answered
//      when CORE is written: the Pursuit instruction explicitly says an empty Pursuit is
//      a complete character, so requiring it would mark finished characters unfinished.
//   2. THE DENOMINATOR IS DERIVED, not the literal 6. It is however many steps carry
//      counted:true, so merging or adding a step cannot leave a stale number behind.
//      Position and Background still mark their rail node without counting, per the
//      bridge Studio's STUDIO-2 UNIT-B rule.
//   3. THE `why` LINES ARE GONE. They were written for the mockup and read as filler.
//      Guidance now comes from the slot's own `instructions` (see _ceGuide) for every
//      step that has a slot. Only the two steps with NO single slot behind them —
//      Pattern and Position — keep a hand-written line, and those are stated in the
//      user's own terms rather than re-derived.
var CE_BUILD_STEPS: any[] = [
    { id: 'presence', group: 'presence', label: 'Presence', counted: true },
    { id: 'drive', group: 'drive', label: 'Drive', counted: true },
    // [ASPECTS] THIRD, AND THE POSITION IS THE POINT. Core is two lines when this step
    // is reached, and nothing has reinforced it yet — so a generator asked for an Aspect
    // here has almost nothing to derive one from, and the per-facet refusal clause does not
    // have to carry the whole weight. Asked last, after Resistance and Conduct have filled
    // the brief, these come back as commentary on the character instead of facts about them.
    //
    // DISPLAYED LAST ANYWAY: CE_BUILD_STEPS and CE_FIELD_GROUP_ORDER are independent
    // arrays and nothing joins them, so early-asked / late-shown needs no mechanism.
    //
    // counted:false, matching Position and Background: a character with no Aspects is
    // complete. _ceBuildAnswered's slotless path still marks the rail node once one facet
    // is written, which is the STUDIO-2 UNIT-B rule and not a progress claim.
    { id: 'aspects', group: 'aspects', label: 'Aspects', counted: false,
      addLabel: 'an Aspect',
      q: 'What is true about them that has nothing to do with any of this?',
      why: 'Optional. Every other step answers to the Core; this one answers to nothing, '
         + 'which is what keeps a character from reading as a set of symptoms. Anything '
         + 'that is interesting BECAUSE of who they are belongs in a different step.' },
    { id: 'pattern', group: '', label: 'Pattern', counted: true,
      q: 'What complicates them?',
      why: 'Not a personality type and not a summary of who they are. This picks HOW the '
         + 'next two steps push against the Core \u2014 by contradicting it, substituting for '
         + 'it, guarding it, ruling it, feeding it, or hiding it. It is the only step that '
         + 'changes the questions that follow.' },
    { id: 'resistance', group: 'resistance', label: 'Resistance', counted: true },
    { id: 'conduct', group: 'conduct', label: 'Conduct', counted: true },
    { id: 'position', group: 'position', label: 'Position', counted: false,
      q: 'Where do they stand with someone who matters?',
      why: 'Optional. Sets the third pressure axis, so it is worth doing if they already '
         + 'have a counterpart in the cast.' },
    { id: 'history', group: 'history', label: 'Background', counted: false }
];
function _ceBuildCounted(): number {
    var n = 0;
    for (var i = 0; i < CE_BUILD_STEPS.length; i++) { if (CE_BUILD_STEPS[i].counted) n = n + 1; }
    return n;
}
function _ceBuildAnswered(p: any, step: any): boolean {
    if (step.id === 'pattern') return !!String(p.pattern || '');
    if (step.id === 'position') return !!String((p.position || {}).targetId || '');
    if (!step.group) return false;
    var patId = String(p.pattern || '');
    var gRows = _ceGroupFields(p, step.group);
    var slots = _ceSlotsFor(gRows, step.group, patId);
    // [SLOTLESS-STEP] A slotless group (Background) is answered when ANY of its
    // facets is written. Testing slots for a group that has none returned false forever.
    if (!slots.length) {
        if (_ceGatedGroup(step.group)) return false;
        return _ceCountWritten(_ceFacetsFor(gRows)) > 0;
    }
    // Drive holds Core and Pursuit; CORE alone decides. Every other group has one
    // gated slot, so "the first one" and "all of them" are the same test there.
    if (step.id === 'drive') {
        for (var i = 0; i < slots.length; i++) {
            if (String(slots[i].id || '') === 'ce_slot_core') return _ceHasValue(slots[i]);
        }
        return _ceHasValue(slots[0]);
    }
    for (var j = 0; j < slots.length; j++) { if (!_ceHasValue(slots[j])) return false; }
    return true;
}
function _ceBuildProgress(p: any): number {
    var n = 0;
    for (var i = 0; i < CE_BUILD_STEPS.length; i++) {
        if (CE_BUILD_STEPS[i].counted && _ceBuildAnswered(p, CE_BUILD_STEPS[i])) n = n + 1;
    }
    return n;
}

function _ceProfileBuild(charId: string, p: any, cfg: any, roster: any[], idx: number): any {
    var i = Math.max(0, Math.min(CE_BUILD_STEPS.length - 1, Number(idx) || 0));
    var step = CE_BUILD_STEPS[i];
    var patId = String(p.pattern || '');
    var pat = CE_PATTERN_DEFS[patId] || null;
    var rail = (_ceGatedGroup(step.group) && pat) ? pat.c : '';

    var railKids: any[] = [];
    for (var r = 0; r < CE_BUILD_STEPS.length; r++) {
        railKids.push((function(s: any, si: number) {
            var cur = si === i;
            var ans = _ceBuildAnswered(p, s);
            var isPat = s.id === 'pattern';
            return h('div', {
                onClick: function() { ceTap('drill:build:' + si, function() { _ceProfileDrill('build', si); }); },
                style: {
                    flex: '1 1 0', height: isPat ? '6px' : '4px', borderRadius: '3px', cursor: 'pointer',
                    background: cur ? 'currentColor' : (ans ? ((isPat && pat) ? pat.c : CE_LINE2) : CE_LINE)
                }
            });
        })(CE_BUILD_STEPS[r], r));
    }

    // Body. A step with a group renders its gated slot cards plus that group's
    // written facets and its add-more button — the same content the group accordion
    // shows, so the walk and the profile never disagree about what a step contains.
    var body: any[] = [];
    var heading = step.q || '';
    if (step.id === 'pattern') {
        body.push(_cePatternPicker(charId, p, true));
    } else if (step.id === 'position') {
        var posKids = _ceProfilePositionKids(charId, p, cfg);
        for (var pk = 0; pk < posKids.length; pk++) { body.push(posKids[pk]); }
    } else if (step.group) {
        var rows = _ceGroupFields(p, step.group);
        var slots = _ceSlotsFor(rows, step.group, patId);
        if (!slots.length && _ceGatedGroup(step.group)) {
            body.push(ceProse('t2',
                'Choose a pattern first \u2014 it decides which question this step asks.', { size: 'base' }));
        }
        // [STYLE2-E] step.label is the drill's own heading, so it is the
        // duplicate to suppress against here -- same job g.label does in the profile.
        for (var sc = 0; sc < slots.length; sc++) { body.push(_ceSlotCard(charId, p, cfg, slots[sc], rail, step.label)); }
        var facets = _ceFacetsFor(rows);
        var written: any[] = [];
        for (var fw = 0; fw < facets.length; fw++) { if (_ceHasValue(facets[fw])) written.push(facets[fw]); }
        for (var fx = 0; fx < written.length; fx++) { body.push(_ceFacetField(charId, p, cfg, written[fx])); }
        // [SLOTLESS-STEP] Background rendered an EMPTY step with nothing
        // to type into. Not every group has a slot: BUILTIN_FACETS defines slots for
        // presence/core/pursuit and the twelve pattern variants only, so history (Background),
        // position and aspects own FACETS ALONE. The old body showed written facets and hid
        // the rest behind an add button, which for a slotless group means a brand-new
        // character sees a step with no field at all. When a group has no slot its facets
        // ARE the step and all of them render open --
        //
        // [ASPECTS-EXC] -- AND THAT RULE IS NO LONGER UNCONDITIONAL. Aspects carries
        // eight facets against Background's four, and eight open textareas stacked on one
        // page is a wall rather than a step, so it takes the button branch instead. The
        // empty step that normally produces is acceptable HERE and nowhere else, for two
        // reasons: the step is counted:false, so an author who walks past it is not marked
        // unfinished; and the button is a real action ON THIS SURFACE rather than a pointer
        // at a fix living two sections up the column, which is the [GATED-EMPTY] failure
        // and a different one.
        //
        // NAMED, NOT DERIVED FROM FACET COUNT. A ninth slotless group does not inherit the
        // exception by growing past some threshold — "how many fields is too many for one
        // page" is an authoring judgement, and a computed one would silently change the
        // shape of an existing step the next time someone added a facet to it.
        if (!slots.length && !_ceGatedGroup(step.group) && step.group !== 'aspects') {
            for (var fu = 0; fu < facets.length; fu++) {
                if (_ceHasValue(facets[fu])) continue;
                body.push(_ceFacetField(charId, p, cfg, facets[fu]));
            }
        } else {
            var left = facets.length - written.length;
            if (left > 0) {
                // [ASPECTS-EXC] `addLabel` is an OPTIONAL per-step override, so every
                // step that does not set one produces the byte-identical string it produced
                // before ("Add a Presence facet"). Aspects sets it because "Add a Aspects
                // facet" is wrong twice over, and because the group's own noun reads better
                // than the word `facet` on the one step whose fields deepen no slot.
                body.push(ceBtn('Add ' + (step.addLabel || ('a ' + step.label + ' facet')) + ' (' + left + ' available)',
                    'bfacet:' + charId + ':' + step.group, function() {
                        _ceProfileDrill('addfacet:' + step.group, 0);
                        return Promise.resolve();
                    }));
            }
        }
        if (!heading) { heading = step.label; }
    }

    // [earlier, per user] Next/Back at the BOTTOM. They were at the bottom of the
    // step body already, but above the facets and the add button, so on any step with
    // content they sat in the middle of the page. They are now the last thing in the
    // column, unconditionally.
    var nav: any[] = [];
    if (i > 0) {
        nav.push(ceBtn('\u2190 Back', 'build:back:' + i, function() {
            _ceProfileDrill('build', i - 1); return Promise.resolve();
        }));
    }
    if (i < CE_BUILD_STEPS.length - 1) {
        nav.push(ceBtn('Next \u2192', 'build:next:' + i, function() {
            _ceProfileDrill('build', i + 1); return Promise.resolve();
        }, 'primary'));
    } else {
        nav.push(ceBtn('Done', 'build:done', function() {
            _ceProfileDrill('', 0); return Promise.resolve();
        }, 'primary'));
    }

    return ceStack(CE_T.s4, [
        ceBar({ gap: '3px', padBottom: CE_T.s2 }, railKids),
        // [TYPE-AUDIT] Was a hand-written eyebrow at fsXs/0.45 with a 17px/600
        // heading under it -- a FIFTH type level, invented by accident, sitting one line
        // above an eyebrow that did not match the kit's own (fsSm/0.55). Both now route
        // through the scale. See CE-STYLE v1 section 6.
        ceH3('Step ' + (i + 1) + ' of ' + CE_BUILD_STEPS.length + (step.counted ? '' : ' \u00b7 optional') +
            ' \u2014 ' + _ceBuildProgress(p) + ' of ' + _ceBuildCounted() + ' answered'),
        heading ? ceH2(heading) : null,
        step.why ? ceProse('t3', step.why) : null,
        ceStack(CE_T.s4, body),
        ceInline({ gap: CE_T.s2, rule: 'top', padTop: CE_T.s3 }, nav)
    ]);
}

// -- Root --------------------------------------------------------------------
function ceProfileRoot(): any {
    var ui = useStoreValue(ceUiStore);
    // `: any` matching the other two useStoreValue(ceProfileStore) sites in this section.
    // useStoreValue is declared returning {} for an untyped store, so every projection read
    // off this local was a type error before this annotation and none of them was real.
    var prof: any = useStoreValue(ceProfileStore);
    var charId = ui ? ui.entityId : '';

    useEffect(function() {
        if (charId) { cePublishProfile(charId); }
    }, [charId]);

    // [NOHEADER] WAS a hard-coded '\u2190 Scene' that ignored ceUiStore.back
    // entirely — so a Profile opened from Chat or Map sent you to Scene instead of back
    // where you came from, which is the exact bug NAV-BACK exists to prevent. It now uses
    // the shared control like Journal does. With no return address it renders nothing and
    // the nav (which carries Scene) is the way out.
    var back: any = ceBack();

    if (!prof || !prof.ready || prof.charId !== charId) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }
    if (!prof.p) {
        return ceScreen(ceHeader(back), ceEmpty('Character not found.', null));
    }

    var p = prof.p;
    var cfg = prof.cfg || null;
    var roster = prof.roster || [];
    var openMap = (ui && ui.open) || {};
    var drill = (ui && ui.profileDrill) || '';
    var shape = p.uiShape || 'studio';
    var patId = String(p.pattern || '');

    // Drill: full surface swap with its own header. Back clears the value.
    if (drill) {
        var dBack = ceBtn('\u2190 Profile', 'nav:profileback', function() {
            _ceProfileDrill('', 0); return Promise.resolve();
        });
        var dTitle = 'Profile';
        var dBody: any = null;
        if (drill === 'build') { dTitle = 'Build'; dBody = _ceProfileBuild(charId, p, cfg, roster, (ui && ui.profileStep) || 0); }
        else if (drill === 'pattern') { dTitle = 'Pattern'; dBody = _cePatternPicker(charId, p, false); }
        else if (drill === 'settings') { dTitle = 'Settings'; dBody = _ceProfileSettings(charId, p); }
        else if (drill === 'identity') { dTitle = 'Identity'; dBody = _ceProfileIdentityDrill(charId, p); }
        // Mounted via h(), not called bare -- this drill's own top level uses
        // hooks (useStoreValue/useEffect) and needs Preact's isolated per-instance hook
        // space, which only h(Component, props) provides. See the component's own header
        // comment for why it is the exception among the drills.
        else if (drill === 'images') { dTitle = 'Images'; dBody = h(_ceProfileImagesDrill, { charId: charId }); }
        // [PHASE-F] Called BARE, not through h(): it uses no hooks, so it is a
        // plain renderer like every drill except Images. See that one's header for why it
        // is the exception rather than the rule.
        else if (drill === 'equipment') { dTitle = 'Equipment'; dBody = _ceProfileEquipDrill(charId, p, prof.equip); }
        // [PHASE-COND] Also hook-free, also called bare.
        // [SEC:STATE] Hook-free, called bare, same as Equipment and Conditions.
        else if (drill === 'states') { dTitle = 'States'; dBody = _ceProfileStatesDrill(charId, p, cfg, prof.states); }
        // [SEC:SCHED] Hook-free, called bare, same as Equipment and States.
        else if (drill === 'schedule') { dTitle = 'Schedule'; dBody = _ceProfileScheduleDrill('char', charId, p, cfg, prof.places, Number(prof.clockT) || 0, openMap); }
        else if (drill === 'addcustom') {
            dTitle = 'Add a custom field';
            dBody = _ceProfileAddCustomDrill(charId, p, cfg);
        }
        else if (drill.indexOf('addfacet:') === 0) {
            var gid2 = drill.slice(9);
            dTitle = 'Add to ' + ceStaticFieldGroupLabel(gid2);
            dBody = _ceProfileAddFacet(charId, p, cfg, gid2);
        } else {
            dTitle = drill.charAt(0).toUpperCase() + drill.slice(1);
            dBody = ceEmpty(dTitle + ' has no engine-side renderer yet.', null);
        }
        return ceScreen(ceHeader(dBack), [dBody]);
    }

    var body: any[] = [];
    body.push(_ceProfileHero(p, charId));
    body.push(_ceProfilePressure(charId, prof.tiers, !!openMap.pressure));
    body.push(_ceProfileLaunchers(p, cfg, prof.equip, prof.states, shape));
    body.push(_ceShapeToggle(charId, shape));

    var rows: any[] = [];
    if (shape === 'classic') {
        rows.push(_ceProfileClassic(charId, p, cfg));
    } else {
        // [earlier, per user] THE CONTINUE BAR IS GONE. It restated the walkthrough launcher
        // sitting a few pixels above it in _ceProfileLaunchers, and it did so in the one place
        // on the surface reserved for the character's own writing. Two doors to one drill, one
        // of them permanently marked "unanswered", is a nag rather than a route.
        // _ceBuildAnswered / _ceBuildProgress / _ceBuildCounted are untouched -- the build
        // drill itself still uses all three.
        for (var gi = 0; gi < CE_FIELD_GROUP_ORDER.length; gi++) {
            var gid = CE_FIELD_GROUP_ORDER[gi];
            if (gid === 'resistance') { rows.push(_ceProfilePatternSection(charId, p)); }
            var gExtra: any[] = [];
            // [F-20a] cfg PASSED. It was omitted here and nowhere else, and because the
            // parameter was optional nothing complained -- so on the STUDIO shape, which is
            // the default (p.uiShape || 'studio'), the archetype list came back empty and the
            // seed door silently did not render. That is why it is a required parameter now.
            if (gid === 'position') { gExtra = _ceProfilePositionKids(charId, p, cfg); }
            // [SHEET-BLOCK] Background's record prose, which the slot model never
            // had a home for. See _ceSheetFieldBlock.
            else if (gid === 'history') {
                var bgFd = _ceSheetFieldByKey('background');
                if (bgFd) gExtra = [_ceSheetFieldBlock(charId, p, cfg, bgFd)];
            }
            rows.push(_ceProfileGroup(charId, p, cfg, { id: gid, label: ceStaticFieldGroupLabel(gid) },
                                      gExtra));
        }
    }

    // [earlier, per user] Position and Hooks are shape-INDEPENDENT. They are story state
    // (a counterpart, an unresolved tension), not two competing ways of describing a
    // person, so the uiShape exclusivity rule that governs slots-vs-sheet does not apply
    // to them. A classic character gets both.
    if (shape === 'classic') {
        rows.push(_ceProfileGroup(charId, p, cfg, { id: 'position', label: 'Position' },
                                  _ceProfilePositionKids(charId, p, cfg)));
    }
    // [earlier CUSTOM-BEFORE-HOOKS, per user: "move 'Define a custom field' to under last
    // field before hooks"] CUSTOM FIELDS NOW SIT ABOVE HOOKS, NOT BELOW THEM. Everything
    // above this line describes WHO THE CHARACTER IS -- the seven groups, Position, and any
    // custom field the author defined, which is just one more group they wrote
    // themselves. Hooks are the odd one out: unresolved tensions the dynamic engine
    // escalates and spawns, i.e. story state rather than description. Putting the author's
    // own fields after them read as an appendix to a system feature instead of as the last
    // of their own material, and the "Define a custom field" door was the furthest thing
    // on the surface from every other field it belongs beside.
    rows.push(_ceProfileCustomGroup(charId, p, cfg));
    rows.push(_ceProfileHooks(charId, p, cfg));
    // [CONDENSED] s5 between sections is CE-STYLE SS7.1's Read-density spacing.
    // The old zero-gap column was correct for a stack of accordion HEADS and wrong the
    // moment every section renders its content.
    body.push(ceStack({ gap: CE_T.s5, padTop: CE_T.s4 }, rows));

    return ceScreen(ceHeader(back), body);
}

// [earlier CUSTOM-SLOT / REBUILT earlier CUSTOM-PICK, per user: "clicking to add a
// custom slot opens the settings tab instead of selecting from custom fields that have
// already been made"] TWO SEPARATE JOBS, AND earlier CONFLATED THEM.
//
// DEFINING a custom field is global and belongs on Settings. PUTTING ONE ON THIS
// CHARACTER is per-character and belongs here, and it is what was actually asked for.
// earlier built a button that did the first and called it the second.
//
// THE REAL BUG UNDERNEATH: a user-defined field is stored with slot:'custom', and
// ceStaticFieldGroup returns '' for any slot outside CE_FIELD_GROUP_ORDER. The profile
// body loops over the groups in that array only, so every custom field an author ever created was
// INVISIBLE ON THIS SURFACE -- there was nothing to pick from because nothing rendered.
// That is why the Settings blurb promising "a character's + Add field picker" read as
// stale copy: the picker it described had never existed here.
//
// SO: ungrouped custom fields get their own group at the foot of the column, written ones
// shown, and an Add button opening a drill of the EMPTY ones. Same shape as the per-group
// "Add a <group> facet" flow, which is the pattern this surface already uses for exactly
// this question -- writing into a field is what adds it, so there is no separate
// attach/detach state to keep and nothing to clean up when a def is deleted in Settings.
function _ceUngroupedCustom(p: any): any[] {
    var out: any[] = [];
    var list: any[] = (p && p.customFields) || [];
    for (var i = 0; i < list.length; i++) {
        if (list[i] && !String(list[i].group || '')) out.push(list[i]);
    }
    return out;
}

function _ceProfileCustomGroup(charId: string, p: any, cfg: any): any {
    var all = _ceUngroupedCustom(p);
    var written: any[] = [];
    var i = 0;
    for (i = 0; i < all.length; i++) { if (_ceHasValue(all[i])) written.push(all[i]); }
    // Nothing defined and nothing written: render the door alone rather than an empty
    // accordion, so a project with no custom fields still has one obvious way to get one.
    if (!all.length) {
        return h('div', { key: 'prof_customdoor', style: { paddingTop: CE_T.s3 } },
            ceBtn('Define a custom field\u2026', 'prof:cfdefine', function() {
                // ceNav writes `tab` itself (tab || ''), so a ceTabSet before it would be
                // wiped. The namespaced form ceTabGet parses goes in ceNav's third arg.
                ceNav('settings', '', 'settings:system');
                return Promise.resolve();
            }));
    }
    var kids: any[] = [];
    for (i = 0; i < written.length; i++) { kids.push(_ceFacetField(charId, p, cfg, written[i])); }
    var left = all.length - written.length;
    if (left > 0) {
        kids.push(ceBtn('Add a custom field (' + left + ' available)', 'prof:cfadd', function() {
            _ceProfileDrill('addcustom', 0);
            return Promise.resolve();
        }));
    } else {
        kids.push(ceBtn('Define another\u2026', 'prof:cfdefine2', function() {
            ceNav('settings', '', 'settings:system');
            return Promise.resolve();
        }));
    }
    return ceSection('Custom fields', ceStack(CE_T.s4, kids));
}

function _ceProfileAddCustomDrill(charId: string, p: any, cfg: any): any {
    var all = _ceUngroupedCustom(p);
    var kids: any[] = [];
    for (var i = 0; i < all.length; i++) {
        if (_ceHasValue(all[i])) continue;
        kids.push(_ceFacetField(charId, p, cfg, all[i]));
    }
    var toSettings = ceBtn('Define a new one in Settings\u2026', 'prof:cfdefine3', function() {
        ceNav('settings', '', 'settings:system');
        return Promise.resolve();
    });
    if (!kids.length) {
        return ceStack(CE_T.s4, [
            ceEmpty('Every custom field you have defined already has something in it.', null),
            toSettings]);
    }
    return ceStack(CE_T.s4, [
        ceProse('t3',
            'These are the custom fields defined for this project. Write into any of them '
            + 'and it joins this character\u2019s profile. Leave the rest empty \u2014 an unused '
            + 'field costs nothing.'),
        ceStack(CE_T.s4, kids),
        toSettings
    ]);
}


// ============================================================================
// SECTION 31 — STORY SURFACE (jsx)
// [TAB-STORY] TWO SUBTABS. Journal is the past tense, Threads the future one; see
// CE_STORY_TABS. Threads render only at story scope and force the tab back when a
// character or faction scope is set. Everything below this line is the journal half.
//
// ONE surface for both journals: the story journal and every character's own.
// They share the bubble record and all six verbs; the only real difference is
// where the active bubbles are injected from, which is one sentence of copy.
//
// SCOPE IS A ROUTE, NOT A MODE. ceUiStore.entityId carries it: '' is the story
// journal, a charId is that character's. The character journal is reached from
// the profile launcher, the story journal from the Scene header, and the picker
// at the top switches between them without either being "inside" the other.
// Nothing here holds a second copy of which journal is showing.
//
// THREE KIT-LEVEL RULES THIS SURFACE ESTABLISHED:
//   1. A VARIABLE-LENGTH LIST OF EDITABLE FIELDS. Every bubble is an in-place
//      textarea, so this is the dynamic field list SECTION 28's own comment
//      predicted. It goes through h(ceField, props) with a per-bubble key —
//      never a bare ceField(p) in a loop, which would break hook order.
//   2. A DESTRUCTIVE ACTION. See DESTRUCTIVE-NEVER-IN-PLACE below: the confirm
//      does NOT swap the Delete button's own handler, because the double-fire
//      would then run the confirmed branch off the first physical tap.
//   3. A REVIEWED GENERATION. Rewrite/Compress never overwrite. The result
//      lands in `pending` and the author accepts or discards it, which is the
//      same contract the legacy modal had (generate into an edit draft, commit
//      only on Save) and the same rule as everywhere else in this engine: the
//      model proposes, the author moves the state.
// ============================================================================

var ceJournalStore: any = null;

function ceJournalStoreInit(): void {
    if (ceJournalStore) return;
    try {
        // draft / pending / confirm are session UI and live HERE rather than on
        // ceUiStore, deliberately: they change on almost every interaction with this
        // surface and nothing else subscribes to them, so putting them on the shared
        // ui store would repaint Scene and Profile on every keystroke-commit. That is
        // the change-frequency split the two-store design exists to make.
        // `draft` is GONE from the store on purpose -- see _ceJrnlDraft below.
        // `editing` is the id of the one entry open for editing (READ-FIRST); `composerGen`
        // is bumped to clear the composer -- as ceField's `seed` prop, no longer
        // as its component key. `seq` guards against a slow publish landing on top of a
        // newer one.
        ceJournalStore = createStore({ ready: false, scope: '', title: 'Story',
                                       bubbles: [], roster: [], threads: [],
                                       editing: '', composerGen: 0, seq: 0,
                                       pending: null, confirm: '' });
    } catch (e) { api.v1.error('[AE:jsxjournal] store init failed:', e); }
}

// Shallow merge, same shape and same reason as ceUiPatch: a publish must not
// wipe a pending proposal, and a draft write must not wipe the bubble list.
function ceJournalPatch(fn: (s: any) => any): void {
    if (!ceJournalStore) return;
    try {
        ceJournalStore.set(function(s: any) {
            var next: any = {}; var k: string;
            for (k in s) { next[k] = s[k]; }
            var partial = fn(s) || {};
            for (k in partial) { next[k] = partial[k]; }
            return next;
        });
    } catch (e) { api.v1.error('[AE:jsxjournal] patch failed:', e); }
}

// [CLICK-BEFORE-BLUR] THE COMPOSER DRAFT IS A MODULE VARIABLE
// AND MUST STAY ONE. Measured behaviour: the first press of Add toasted "Nothing to add"
// and the second press worked, which means the click was delivered BEFORE the blur it
// caused, so Add read the draft one keystroke-session stale. Putting the draft in the
// store cannot fix that (the button still reads whatever landed first) and putting it in
// the store is independently forbidden: a store write re-renders, and a re-render on every
// keystroke repaints every subscriber of that store. The sharper original
// reason -- that a re-render bumped the field key and remounted the input mid-typing -- is
// retired with FIELD-KEYLESS; the repaint cost is not, and it is enough on its own.
// So: ceField.onType writes here on every keystroke with NO render, and Add reads here.
// The engine is unaffected by event ordering because nothing is waiting on an event any more.
var _ceJrnlDraft: string = '';

// [PUBLISH-SEQ] Every publish takes a ticket and a publish whose ticket is older
// than the one already applied is DROPPED. cePublishJournal reads the whole roster
// (loadAllCharacters) plus the journal, so it is slow enough that two of them overlap
// easily -- and when the slower, older one wins the race it writes a PRE-EDIT bubble list
// over a post-edit one. That is the shape of the reported ghost entry: an entry visible on
// screen, absent from the merge count, and gone after leaving and returning. This does not
// prove that was the mechanism, but it makes it impossible.
var _ceJrnlSeq: number = 0;

// [OP-CHAIN] Journal ops run one at a time. Each verb is load-modify-persist
// against storyStorage with no compare-and-swap underneath it, so two overlapping ops read
// the same list and the second silently discards the first's change. Serialising also
// means publishes cannot interleave. The chain never rejects -- a failed op must not
// poison every op after it.
var _ceJrnlChain: Promise<any> = Promise.resolve();

// Read projection. Reuses loadJournal / loadCharJournal rather than the two
// *PayloadForBridge builders — those exist to cross the worker boundary and
// this does not, but the projected shape is deliberately identical so the two
// can be unified when the bridge pair is retired.
// [F-27] A SCOPE IS A STORY, A CHARACTER OR A FACTION. The journal surface already had two
// scopes and a picker to choose between them; a faction is the third, NOT a second journal
// UI. The first cut of the faction screen grew its own bubble list, which was two editors
// for one shape -- the mistake this file's own "do not write a second chooser" rule names,
// applied to journals.
// A faction id is recognised by the RECORD's type, not by a prefix on the string: ids are
// author-visible in exports and a scheme that encodes type into them is one rename from lying.
// [F-28] Reads the entity index rather than cfg.factions.
async function _ceJrnlIsFaction(sc: string): Promise<boolean> {
    if (!sc) return false;
    try {
        var fl: any[] = await ceFactionMetas();
        for (var i = 0; i < fl.length; i++) { if (fl[i] && String(fl[i].id) === sc) return true; }
    } catch (e) {}
    return false;
}

// [TAB-STORY] THE THREAD LIST'S ONE READ. Full records rather than metas, because the
// row's second line is the thread's own Objective -- the single most useful thing to see
// in a list of threads -- and that lives in customFieldValues, which the index does not
// carry. Threads are few by construction; loadAllCharacters on the same publish is the
// same shape of cost and has never been the problem.
// SORTED HERE, NOT IN THE RENDERER, so the order does not depend on which of the three
// state buckets a row lands in.
var CE_NARR_OBJECTIVE_ID: string = 'ce_narr_objective';

async function _ceThreadRows(): Promise<any[]> {
    var out: any[] = [];
    var idx: any[] = await loadEntityIndex();
    // [MILESTONE] One pointer read for the whole list, not one per row.
    var actId = '';
    try { actId = await loadActiveThread(); } catch (eA) { actId = ''; }
    var names: any = {};
    var i = 0;
    for (i = 0; i < (idx || []).length; i++) {
        if (idx[i] && idx[i].id) names[String(idx[i].id)] = String(idx[i].name || 'Unnamed');
    }
    for (i = 0; i < (idx || []).length; i++) {
        var m: any = idx[i];
        if (!m || String(m.type || '') !== 'narrative') continue;
        var rec: any = null;
        try { rec = await loadEntity(String(m.id)); } catch (eL) { rec = null; }
        if (!rec) continue;
        var cfv: any = rec.customFieldValues || {};
        var line = String(cfv[CE_NARR_OBJECTIVE_ID] || '').trim() || String(rec.description || '').trim();
        var pid = String(rec.narrativeParentId || '');
        // [MILESTONE] THE ACTIVE THREAD'S ROW SHOWS ITS MILESTONE INSTEAD OF ITS OBJECTIVE,
        // because that is the line currently reaching the story and the one an author scans
        // this list to check. One extra read, for one row.
        var msLine = '';
        if (String(rec.id) === actId) {
            try {
                var mdoc: any = await loadMilestones(String(rec.id));
                msLine = String((mdoc && mdoc.current && mdoc.current.text) || '').trim();
            } catch (eM) { msLine = ''; }
        }
        out.push({
            id: String(rec.id),
            name: String(rec.name || 'Unnamed thread'),
            state: String(rec.storyState || 'locked'),
            kindLabel: String(ceNarrativeKind(String(rec.narrativeKind || '')).label || 'Custom'),
            line: msLine || line,
            active: String(rec.id) === actId,
            fromName: (pid && names[pid]) ? names[pid] : '',
            updatedAt: Number(rec.updatedAt || 0)
        });
    }
    out.sort(function(a: any, b: any) { return b.updatedAt - a.updatedAt; });
    return out;
}

// [TAB-STORY] A thread is minted ACTIVE. storyState's other two values mean "waiting on
// something" and "finished", and a thread the author just chose to create is neither --
// defaulting to 'locked' the way makeDefaultEntity does would put every new thread in the
// bucket the author has to go and empty by hand.
// It navigates straight into the record, carrying the return address, because the five
// questions are the whole point and there is nothing to do on the list.
function ceNarrativeNew(): Promise<any> {
    return ceEntityOp(async function() {
        try {
            var ent: any = makeDefaultEntity('New thread');
            ent.type = 'narrative';
            ent.storyState = 'active';
            ent.narrativeKind = 'custom';
            ent.narrativeParentId = null;
            await saveEntity(ent);
            ceNav('entity', String(ent.id), '',
                  { surface: 'journal', entityId: '', label: 'Story' });
        } catch (e) { api.v1.error('[AE:jsxjournal] new thread failed:', e); }
    });
}

async function cePublishJournal(scope: string): Promise<void> {
    ceJournalStoreInit();
    if (!ceJournalStore) return;
    var sc = String(scope || '');
    _ceJrnlSeq = _ceJrnlSeq + 1;
    var ticket = _ceJrnlSeq;
    try {
        // [JRNL-STAMP] One config read for the calendar, used only to format stamps.
        var jCal: any = null;
        try { jCal = ceCalendar(await loadConfig()); } catch (eCal) { jCal = null; }
        var roster: any[] = [];
        try {
            var all: any[] = await loadAllCharacters();
            for (var ri = 0; ri < (all || []).length; ri++) {
                if (!all[ri]) continue;
                roster.push({ id: all[ri].id, name: all[ri].name || 'Unnamed' });
            }
        } catch (eR) { api.v1.error('[AE:jsxjournal] roster read failed:', eR); }

        // [F-27] Factions join the picker below the cast, so one control reaches every
        // journal this story has. They carry `kind` so the title and the load both branch on
        // a resolved fact rather than re-deriving it.
        var facRoster: any[] = [];
        try {
            var fl2: any[] = await ceFactionMetas();   // [F-28]
            for (var fi = 0; fi < fl2.length; fi++) {
                if (!fl2[fi] || !fl2[fi].id) continue;
                facRoster.push({ id: String(fl2[fi].id), name: String(fl2[fi].name || 'Unnamed faction') });
            }
        } catch (eFR) { api.v1.error('[AE:jsxjournal] faction read failed:', eFR); }
        var scIsFac = false;
        for (var fj = 0; fj < facRoster.length; fj++) { if (facRoster[fj].id === sc) scIsFac = true; }

        // [TAB-STORY] THE THREAD LIST IS PART OF THIS SURFACE'S PUBLISH, not a second
        // store. One surface, one store is the rule the scope picker already lives by, and
        // a thread list with its own store would need its own init in ceOpenScene's list
        // [STORE-BEFORE-HOOK] to buy nothing.
        // STORY SCOPE ONLY. A character or faction journal has no threads, so the read is
        // skipped rather than performed and discarded.
        var threads: any[] = [];
        if (!sc) {
            try { threads = await _ceThreadRows(); }
            catch (eTh) { api.v1.error('[AE:jsxjournal] thread read failed:', eTh); }
        }

        var raw: any = !sc ? await loadJournal()
            : (scIsFac ? await loadFacJournal(sc) : await loadCharJournal(sc));
        var list: any[] = (raw && raw.bubbles) ? raw.bubbles : [];
        var bubbles: any[] = [];
        var seen: any = {};
        var i = 0;
        for (i = 0; i < list.length; i++) {
            var b: any = list[i];
            if (!b || !b.id) continue;
            seen[String(b.id)] = true;
            // [JRNL-STAMP] FORMATTED HERE, not in the renderer. ceClockStamp needs the
            // calendar and the renderer has no config; carrying the string keeps the bubble
            // renderer as dumb as it already is. An unstamped bubble carries '' and the
            // line self-suppresses.
            bubbles.push({ id: String(b.id), text: b.text || '',
                           archived: !!b.archived, createdAt: b.createdAt || 0,
                           stamp: (typeof b.storyT === 'number')
                                  ? ceClockStamp(jCal, Number(b.storyT)) : '' });
        }

        var title = 'Story';
        if (sc) {
            title = scIsFac ? 'Faction' : 'Character';
            var pool: any[] = scIsFac ? facRoster : roster;
            for (i = 0; i < pool.length; i++) {
                if (pool[i].id === sc) { title = pool[i].name; break; }
            }
        }

        ceJournalPatch(function(s: any) {
            // [PUBLISH-SEQ] An older snapshot never overwrites a newer one.
            if (Number(s.seq || 0) > ticket) {
                aeLog('[AE:jsxjournal] stale publish dropped (' + ticket + ' < ' + s.seq + ')');
                return {};
            }
            // A scope change resets the transient trio. Doing it here rather than at the
            // nav call site means EVERY route into this surface gets it, including a
            // future one that has not been written yet.
            var fresh = (String(s.scope || '') !== sc) || !s.ready;
            var pend = fresh ? null : (s.pending || null);
            // A proposal whose bubble no longer exists can never be accepted or
            // discarded — it would sit invisible and block the next one.
            if (pend && !seen[String(pend.id || '')]) { pend = null; }
            var conf = fresh ? '' : String(s.confirm || '');
            if (conf && !seen[conf]) { conf = ''; }
            var edit = fresh ? '' : String(s.editing || '');
            if (edit && !seen[edit]) { edit = ''; }
            if (fresh) { _ceJrnlDraft = ''; }
            return { ready: true, scope: sc, title: title, bubbles: bubbles, roster: roster,
                     threads: threads,
                     facRoster: facRoster, scopeIsFaction: scIsFac,
                     seq: ticket, pending: pend, confirm: conf, editing: edit,
                     composerGen: fresh ? 0 : Number(s.composerGen || 0) };
        });
    } catch (e) {
        // Previous value survives a failed publish — stale beats blank.
        api.v1.error('[AE:jsxjournal] publish failed:', e);
    }
}

// -- The single write path from this surface ---------------------------------
// One function, one scope branch, same discipline as ceProfileWrite: the
// story/character fork exists in exactly one place, so a seventh verb cannot be
// added to one half and forgotten in the other. Every branch ends in a
// republish, so the surface never renders a value it did not read back.
function ceJournalOp(scope: string, op: string, id: string, value: any): Promise<void> {
    // [OP-CHAIN] Queue, never run directly. The catch is on the chain itself so a
    // rejected op cannot break the link for everything after it.
    var run = _ceJrnlChain.then(function() { return _ceJournalOpRun(scope, op, id, value); });
    _ceJrnlChain = run.catch(function() { return null; });
    return run;
}

async function _ceJournalOpRun(scope: string, op: string, id: string, value: any): Promise<void> {
    var sc = String(scope || '');
    // [F-27] THREE SCOPES, RESOLVED ONCE. The fork stays in exactly one place, which is why
    // the third one could be added without a verb going missing from a branch -- the whole
    // reason this function's header gives for the fork living here at all.
    var isFac = await _ceJrnlIsFaction(sc);
    var isChar = !!sc && !isFac;
    var bid = String(id || '');
    try {
        if (op === 'add') {
            var t = String(value || '').trim();
            if (!t) {
                try { api.v1.ui.toast('Nothing to add.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
                return;
            }
            if (isFac) { await facJournalAdd(sc, t); }
            else if (isChar) { await charJournalAddBubble(sc, t); } else { await journalAddBubble(t); }
            // [FIELD-KEYLESS] Bumping composerGen bumps the composer's `seed`
            // prop, which force-clears the field through the ref it already holds. This
            // used to bump a component KEY and remount, which leaked the old node.
            _ceJrnlDraft = '';
            ceJournalPatch(function(st: any) { return { composerGen: Number(st.composerGen || 0) + 1 }; });
        } else if (op === 'update' || op === 'replace') {
            if (isFac) { await facJournalUpdate(sc, bid, String(value || '')); }
            else if (isChar) { await charJournalUpdateBubble(sc, bid, String(value || '')); }
            else { await journalUpdateBubble(bid, String(value || '')); }
            if (op === 'replace') { ceJournalPatch(function() { return { pending: null }; }); }
        } else if (op === 'archive') {
            if (isFac) { await facJournalSetArchived(sc, bid, !!value); }
            else if (isChar) { await charJournalSetArchived(sc, bid, !!value); }
            else { await journalSetArchived(bid, !!value); }
        } else if (op === 'delete') {
            if (isFac) { await facJournalDelete(sc, bid); }
            else if (isChar) { await charJournalDeleteBubble(sc, bid); } else { await journalDeleteBubble(bid); }
            ceJournalPatch(function() { return { confirm: '', editing: '' }; });
        } else if (op === 'merge') {
            // MERGE HAS NO FACTION FORM YET, and refusing loudly beats merging the wrong
            // record: facJournal* has no merge verb, so this would silently fall through to
            // the STORY journal and collapse it.
            if (isFac) { try { api.v1.ui.toast('Merge is not available for a faction journal yet.', { type: 'warning', autoClose: 3000 }); } catch (eM) {} return; }
            if (isChar) { await charJournalMergeDown(sc); } else { await journalMergeDown(); }
        } else {
            api.v1.error('[AE:jsxjournal] unknown op: ' + op);
            return;
        }
        await cePublishJournal(sc);
    } catch (e) { api.v1.error('[AE:jsxjournal] op ' + op + ' failed:', e); }
}

// -- Reviewed generation -----------------------------------------------------
// journalGenerateRewrite / journalGenerateCompress are shared by both journals
// already (they are pure text transforms with no journal identity), so there is
// nothing to fork here. The result is PROPOSED, never written: a rewrite that
// silently replaced the author's own words would be unrecoverable, since
// storyStorage has no undo.
async function ceJournalGen(scope: string, id: string, kind: string, src: string): Promise<void> {
    var s = String(src || '').trim();
    if (!s) {
        try { api.v1.ui.toast('Nothing to work with.', { type: 'warning', autoClose: 2000 }); } catch (e0) {}
        return;
    }
    try {
        api.v1.ui.toast(kind === 'rewrite' ? 'Rewriting\u2026' : 'Compressing\u2026',
                        { id: 'ce-jrnlgen', autoClose: false, type: 'info' });
    } catch (e1) {}
    var out: string | null = null;
    try {
        out = (kind === 'rewrite') ? await journalGenerateRewrite(s) : await journalGenerateCompress(s);
    } catch (e2) { api.v1.error('[AE:jsxjournal] gen failed:', e2); }
    if (!out || !String(out).trim()) {
        try { api.v1.ui.toast('Generation failed.', { id: 'ce-jrnlgen', type: 'error', autoClose: 2000 }); } catch (e3) {}
        return;
    }
    try { api.v1.ui.toast('Ready \u2014 review it.', { id: 'ce-jrnlgen', type: 'success', autoClose: 1500 }); } catch (e4) {}
    ceJournalPatch(function() {
        return { pending: { id: String(id || ''), kind: kind, text: String(out) } };
    });
}

// -- Sizing ------------------------------------------------------------------
// [FIELD-FITS-CONTENT] NO UPPER CAP. The earlier version capped at 14
// rows, which put a two-paragraph entry into a short scrolling well while a one-sentence
// entry got the same box -- the field dictating to the content instead of the reverse.
// THE RULE, now in CE-STYLE: a field is sized BY its content and the SURFACE scrolls, not
// the field. A nested scroller inside a scrolling surface is two scrollbars competing for
// the same gesture, and on touch the inner one wins by accident.
// Hard-wrapped lines are counted individually so paragraph breaks are not averaged away.
function _ceJrnlRows(text: string): number {
    var t = String(text || '');
    var lines = t.split('\n');
    var n = 0;
    for (var i = 0; i < lines.length; i++) {
        n = n + Math.max(1, Math.ceil(lines[i].length / 48));
    }
    return Math.max(3, n + 1);
}

// -- One entry ---------------------------------------------------------------
// [READ-FIRST] AN ENTRY IS PROSE UNTIL IT IS TAPPED. earlier rendered
// every entry as an always-live textarea with a row of buttons under each one, so a page of
// journal read as a stack of forms separated by chrome -- the controls were the loudest
// thing on a surface whose whole purpose is reading back what you wrote. Now: prose at full
// strength, one tap opens exactly ONE entry for editing, and the verbs appear below the open
// entry and nowhere else. A closed entry carries no controls at all.
// ONE OPEN AT A TIME is not a restriction, it is what makes the list read continuously: with
// N live textareas there is no visual difference between an entry and the gap after it.
// EVERY CHILD HERE IS KEYED. Mixing keyed and unkeyed siblings in one array is the standard
// way to get a node that survives a diff it should not have -- and an entry that stayed on
// screen after it left the data is exactly what was reported.
function _ceJournalBubble(scope: string, b: any, pending: any, confirmId: string, editingId: string): any {
    var id = String(b.id || '');
    var editing = (editingId === id);
    var text = String(b.text || '');
    var stamp = String(b.stamp || '');
    var kids: any[] = [];

    // [JRNL-STAMP] ABOVE THE WORDS, IN ceMono, and absent when there is none -- entries
    // written before the stamp existed and stories with no clock both fall through to
    // nothing rather than to 'Day 1 00:00', which would be a fact the engine invented.
    // ceWrap CARRIES THE KEY, not ceMono: ceMono's opts are {opacity, style} only, so a
    // `key` passed there is silently dropped -- and this list already mixes keyed children
    // and changes length when a bubble opens for editing, which is the exact arrangement
    // [LOC-PROFILE3] records as reordering by position.
    if (stamp) { kids.push(ceWrap({ key: 'jrs_' + id }, [ ceMono(stamp, { opacity: CE_OP.t3 }) ])); }

    if (!editing) {
        kids.push(h('div', {
            key: 'jr_' + id,
            onClick: function() {
                ceTap('jrnl:open:' + id, function() {
                    ceJournalPatch(function() { return { editing: id, confirm: '' }; });
                });
            },
            style: {
                fontSize: CE_T.fs, lineHeight: '1.65', whiteSpace: 'pre-wrap',
                // Ladder: the author's own words are t1 by definition; the empty-state
                // prompt is a label about content, t3. 0.24 measured 2.2:1 -- the prompt
                // telling a new user what to do was the least readable text on the screen.
                cursor: 'pointer', opacity: text.trim() ? CE_OP.t1 : CE_OP.t3
            }
        }, text.trim() ? text : 'Empty entry \u2014 tap to write'));
    } else {
        kids.push(h(ceField, {
            key: 'jb_' + id,
            k: 'jrnl:' + (scope || 'story') + ':' + id,
            label: '',
            value: text,
            multiline: true,
            rows: _ceJrnlRows(text),
            placeholder: 'Write this entry\u2026',
            onCommit: function(v: string) { return ceJournalOp(scope, 'update', id, v); }
        }));

        var acts: any[] = [];
        acts.push(ceBtn('Done', 'jrnl:done:' + id, function() {
            ceJournalPatch(function() { return { editing: '' }; });
            return Promise.resolve();
        }));
        acts.push(ceBtn(b.archived ? 'Unarchive' : 'Archive', 'jrnl:arch:' + id, function() {
            return ceJournalOp(scope, 'archive', id, !b.archived);
        }));
        acts.push(ceBtn('Rewrite', 'jrnl:rw:' + id, function() {
            return ceJournalGen(scope, id, 'rewrite', text);
        }));
        acts.push(ceBtn('Compress', 'jrnl:cp:' + id, function() {
            return ceJournalGen(scope, id, 'compress', text);
        }));
        // [DESTRUCTIVE-NEVER-IN-PLACE] This button ASKS and never deletes, and it
        // keeps the same handler in both states on purpose. Swapping it to a confirmed
        // Delete would put the destructive handler on the element the second fire of the
        // SAME physical tap lands on -- the reused-node path TAP-GUARD documents -- guarded
        // only by CE_TAP_MS, which is still an inferred number. Asking twice is idempotent.
        acts.push(ceIconBtn('Delete this entry\u2026', ceIconTrash(), 'jrnl:delask:' + id, function() {
            ceJournalPatch(function() { return { confirm: id }; });
            return Promise.resolve();
        }));
        kids.push(ceInline({ gap: CE_T.s2, key: 'ja_' + id }, acts));

        if (confirmId === id) {
            kids.push(h('div', { key: 'jc_' + id, style: {
                display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: CE_T.s2,
                borderLeft: '2px solid ' + CE_SEM.ask, paddingLeft: CE_T.s3
            } },
                ceProse('t2',
                    'Delete this entry? There is no undo for journal storage.', { key: 'jcm_' + id, grow: true, basis: '180px' }),
                ceBtn('Delete', 'jrnl:del:' + id, function() {
                    return ceJournalOp(scope, 'delete', id, null);
                }, 'danger'),
                ceBtn('Keep', 'jrnl:keep:' + id, function() {
                    ceJournalPatch(function() { return { confirm: '' }; });
                    return Promise.resolve();
                })
            ));
        }
    }

    // A proposal renders in BOTH states: a rewrite fired from the open entry stays visible
    // if the entry closes underneath it, and an unreviewed proposal must never be silent.
    if (pending && String(pending.id || '') === id) {
        kids.push(h('div', { key: 'jp_' + id, style: {
            display: 'flex', flexDirection: 'column', gap: CE_T.s2,
            borderLeft: '2px solid ' + CE_LINE2, paddingLeft: CE_T.s3
        } },
            ceH3((pending.kind === 'rewrite' ? 'Rewritten' : 'Compressed') + ' \u2014 not saved'),
            h('div', { key: 'jpt_' + id, style: { fontSize: CE_T.fs, lineHeight: '1.6',
                whiteSpace: 'pre-wrap' } }, String(pending.text || '')),
            ceInline({ gap: CE_T.s2, key: 'jpa_' + id }, [
                ceBtn('Replace', 'jrnl:acc:' + id, function() {
                    return ceJournalOp(scope, 'replace', id, String(pending.text || ''));
                }, 'primary'),
                ceBtn('Discard', 'jrnl:disc:' + id, function() {
                    ceJournalPatch(function() { return { pending: null }; });
                    return Promise.resolve();
                })
            ])
        ));
    }

    return h('div', { key: 'jw_' + id, style: {
        display: 'flex', flexDirection: 'column', gap: CE_T.s2,
        padding: (editing ? CE_T.s3 : CE_T.s2) + ' 0',
        borderBottom: '1px solid ' + CE_LINE,
        // Ladder: an archived bubble is still the author's own writing, just no longer
        // injected -- secondary content, t2, not a label.
        opacity: b.archived ? CE_OP.t2 : CE_OP.t1
    } }, kids);
}

// -- Root --------------------------------------------------------------------
// [TAB-STORY] TWO SUBTABS ON ONE SURFACE. The journal records what happened; a thread
// records what is pushing. They are the same story looked at from opposite ends of the
// clock, which is why they share a screen rather than each holding a route.
var CE_STORY_TABS: any[] = [
    { id: 'journal', label: 'Journal' },
    { id: 'threads', label: 'Threads' }
];

function _ceThreadRow(t: any, backAddr: any): any {
    var sub = String(t.line || '');
    if (t.fromName) { sub = (sub ? sub + ' ' : '') + '\u2014 from ' + t.fromName; }
    // [MILESTONE] A STAR ON THE NAME, not a second column. Exactly one row can carry it,
    // so a badge competing for the trail with the kind would cost every row a column to
    // say something about one of them.
    return ceListRow({
        key: 'thr_' + t.id,
        opId: 'story:thr:' + t.id,
        label: (t.active ? '\u2605 ' : '') + String(t.name || 'Unnamed thread'),
        sub: sub ? _ceTrim(sub, 96) : 'No objective written yet.',
        trail: String(t.kindLabel || ''),
        onClick: function() { ceNav('entity', String(t.id), '', backAddr); }
    });
}

// THE THREE BUCKETS ARE storyState AND NOTHING ELSE. There is no second liveness
// signal on a thread, so a row is exactly as live as the author last said it was.
function _ceThreadsBody(threads: any[], openMap: any): any[] {
    var live: any[] = [];
    var waiting: any[] = [];
    var done: any[] = [];
    var backAddr: any = { surface: 'journal', entityId: '', label: 'Story' };
    for (var i = 0; i < (threads || []).length; i++) {
        var st = String(threads[i].state || 'locked');
        if (st === 'active') { live.push(threads[i]); }
        else if (st === 'completed') { done.push(threads[i]); }
        else { waiting.push(threads[i]); }
    }
    var body: any[] = [];
    body.push(ceStack(CE_T.s2, [
        ceH1('Threads'),
        ceProse('t3',
            'What is pushing on the story, as opposed to what has already happened to it. A thread asks five questions \u2014 why now, what would end it, what resists, what it costs, and what is different afterwards \u2014 and the kind you pick re-words all five. \u2605 marks the active thread, whose current milestone opens the Author\u2019s Note every turn.'),
        ceWrap(null, [ ceBtn('+ New thread', 'story:newthread', ceNarrativeNew, 'primary') ])
    ]));

    if (!live.length && !waiting.length && !done.length) {
        body.push(ceEmpty('No threads yet. Start one when the story wants a direction.', null));
        return body;
    }

    var liveNodes: any[] = [];
    for (var a = 0; a < live.length; a++) { liveNodes.push(_ceThreadRow(live[a], backAddr)); }
    body.push(ceSection('Running (' + live.length + ')',
        live.length ? ceStack(null, liveNodes)
                    : ceEmpty('Nothing running. A thread set to Active shows here.', null)));

    if (waiting.length) {
        var waitNodes: any[] = [];
        for (var w = 0; w < waiting.length; w++) { waitNodes.push(_ceThreadRow(waiting[w], backAddr)); }
        body.push(ceAccordion({
            id: 'story:waiting',
            label: 'Waiting',
            open: !!openMap['story:waiting'],
            summary: String(waiting[0].name || ''),
            meta: String(waiting.length),
            children: ceStack(null, waitNodes)
        }));
    }
    if (done.length) {
        var doneNodes: any[] = [];
        for (var d = 0; d < done.length; d++) { doneNodes.push(_ceThreadRow(done[d], backAddr)); }
        body.push(ceAccordion({
            id: 'story:done',
            label: 'Finished',
            open: !!openMap['story:done'],
            summary: String(done[0].name || ''),
            meta: String(done.length),
            children: ceStack(null, doneNodes)
        }));
    }
    return body;
}

function ceJournalRoot(): any {
    var ui = useStoreValue(ceUiStore);
    var j = useStoreValue(ceJournalStore);
    var scope = ui ? String(ui.entityId || '') : '';

    useEffect(function() {
        // [LATCH-SWEEP] Clear any journal latch left standing by a previous visit.
        // ceAction releases in a `finally`, so a busy flag that outlives its action means
        // fn() NEVER SETTLED -- and the only candidate in this path is a hung await inside
        // the lorebook sync persistJournal performs. This does not fix that; it makes it
        // SELF-HEALING on navigation, which is the workaround the user found by hand
        // ("leaving the screen and returning causes it to disappear"). The log line is the
        // evidence trail: if it prints on a normal visit, something really is hanging.
        ceUiPatch(function(u: any) {
            var kept: any = {}; var k: string; var n = 0;
            for (k in (u.busy || {})) {
                if (k.indexOf('jrnl:') >= 0) { n = n + 1; continue; }
                kept[k] = u.busy[k];
            }
            if (n > 0) { aeLog('[AE:jsxjournal] swept ' + n + ' stale latch(es) on mount'); }
            return { busy: kept };
        });
        cePublishJournal(scope);
    }, [scope]);

    var back = ceBack();

    if (!j || !j.ready || String(j.scope || '') !== scope) {
        return ceScreen(ceHeader(back), ceEmpty('Loading\u2026', null));
    }

    var bubbles: any[] = j.bubbles || [];
    var active: any[] = [];
    var archived: any[] = [];
    var i = 0;
    for (i = 0; i < bubbles.length; i++) {
        if (bubbles[i].archived) { archived.push(bubbles[i]); } else { active.push(bubbles[i]); }
    }

    var body: any[] = [];
    // ceAccordion writes ceUiStore.open -- the shell's generic open-map [earlier
    // OPEN-MAP-RENAME] -- see ceToggleOpen's own comment. Resolved once here because
    // both this surface's accordions (Archived, and the thread buckets) read it.
    var openMapS: any = (ui && ui.open) || {};

    // [TAB-STORY] THE STRIP IS STORY-SCOPE ONLY, and the tab is FORCED back to the
    // journal when a scope is set rather than merely hidden. A character journal has no
    // threads, so a reader left on the Threads tab from a previous visit would arrive at a
    // list that is not about the character whose name is at the top of the screen.
    var storyTab = scope ? 'journal' : ceTabGet('story', 'journal');
    if (!scope) {
        body.push(ceWrap({ key: 'story_tabs' }, [ ceTabRow('story', CE_STORY_TABS, storyTab) ]));
    }
    if (storyTab === 'threads') {
        var thrKids: any[] = _ceThreadsBody(j.threads || [], openMapS);
        for (var tk = 0; tk < thrKids.length; tk++) { body.push(thrKids[tk]); }
        return ceScreen(ceHeader(back), body);
    }

    // Scope: the title IS the surface title (ceH1, once), and the picker sits under it
    // as a route control rather than a field. A roster select is legitimate here and
    // does NOT violate the referential-field rule: nothing is stored, the value is a
    // destination.
    var scopeOpts: any[] = [{ id: '', label: 'Story journal' }];
    var roster: any[] = j.roster || [];
    for (i = 0; i < roster.length; i++) {
        scopeOpts.push({ id: roster[i].id, label: roster[i].name });
    }
    // [F-27] Factions after the cast, prefixed so two entries never read as the same thing
    // when an author has named a faction after its founder.
    var facRoster: any[] = j.facRoster || [];
    for (i = 0; i < facRoster.length; i++) {
        scopeOpts.push({ id: facRoster[i].id, label: '\u2691 ' + facRoster[i].name });
    }
    body.push(ceStack(CE_T.s2, [
        ceH1(scope ? (j.title + '\u2019s journal') : 'The story so far'),
        ceProse('t3',
            !scope
                ? 'Active entries stay Always-On in the lorebook as \u201CThe story so far\u201D, so they survive context pressure. Archived entries are kept and never injected.'
                : (j.scopeIsFaction
                    // [F-27] SAID PLAINLY RATHER THAN BORROWED. A faction journal is stored
                    // and edited exactly like a character's, but nothing folds it into a
                    // lorebook entry yet -- and repeating the character sentence here would
                    // promise an injection that does not happen.
                    ? 'What this faction did, and what was done to it. Authored by hand \u2014 nothing stamps an entry until the story has a clock. Not injected yet.'
                    : 'Active entries fold into this character\u2019s own lorebook entry, alongside their conditions and equipment. Archived entries are kept and never injected.')),
        ceSelect({
            k: 'jrnl:scope',
            value: scope,
            options: scopeOpts,
            onCommit: function(v: string) {
                // Carries the return address forward, so switching scope does not strand
                // someone who arrived here from a profile.
                ceNav('journal', String(v || ''), '', (ui && ui.back) || null);
                return Promise.resolve();
            }
        })
    ]));

    // Composer. The draft is a MODULE VARIABLE written by onType, not store
    // state -- see CLICK-BEFORE-BLUR. Add reads it directly, so it no longer matters
    // whether the blur this click caused is delivered before or after the click itself.
    // The well marks it as a place to WRITE, distinct from the entries below it, which are
    // a place to READ that happens to accept edits.
    var tools: any[] = [];
    tools.push(ceBtn('Add entry', 'jrnl:add:' + (scope || 'story'), function() {
        return ceJournalOp(scope, 'add', '', _ceJrnlDraft);
    }, 'primary'));
    if (active.length > 1) {
        tools.push(ceBtn('Merge all (' + active.length + ')', 'jrnl:merge:' + (scope || 'story'), function() {
            return ceJournalOp(scope, 'merge', '', null);
        }));
    }
    body.push(ceSection('New entry',
        ceStack(CE_T.s2, [
            h(ceField, {
                // [FIELD-KEYLESS] `seed`, NOT a bumped component
                // key. This field's `value` is always '', so nothing inside ceField can
                // detect a change to re-seed from -- but remounting the whole component to
                // say so is what left one dead composer standing per Add. seed carries the
                // SCOPE as well as the generation, so switching journals clears the box too;
                // composerGen alone resets to 0 on a scope change and would not fire.
                seed: (scope || 'story') + ':' + String(j.composerGen || 0),
                k: 'jrnl:new:' + (scope || 'story'),
                label: '',
                value: '',
                multiline: true,
                rows: 3,
                well: true,
                placeholder: 'Write what just happened\u2026',
                onType: function(v: string) { _ceJrnlDraft = v; },
                onCommit: function(v: string) { _ceJrnlDraft = v; return Promise.resolve(); }
            }),
            ceInline(CE_T.s2, tools)
        ])
    ));

    var editingId = String(j.editing || '');
    var activeNodes: any[] = [];
    for (i = 0; i < active.length; i++) {
        activeNodes.push(_ceJournalBubble(scope, active[i], j.pending, String(j.confirm || ''), editingId));
    }
    body.push(ceSection('Entries (' + active.length + ')',
        active.length
            ? ceStack(null, activeNodes)
            : ceEmpty('Nothing written yet.', null)
    ));

    if (archived.length) {
        var archNodes: any[] = [];
        for (i = 0; i < archived.length; i++) {
            archNodes.push(_ceJournalBubble(scope, archived[i], j.pending, String(j.confirm || ''), editingId));
        }
        body.push(ceAccordion({
            id: 'jrnl:archived',
            label: 'Archived',
            open: !!openMapS['jrnl:archived'],
            summary: _ceTrim(String(archived[0].text || ''), 68),
            meta: String(archived.length),
            children: ceStack(null, archNodes)
        }));
    }

    return ceScreen(ceHeader(back), body);
}


// ============================================================================
// SECTION 31b — VECTOR ICON LIBRARY  [ICON-LIB]
// ============================================================================
// Scalable, theme-following icons for places. An entity's `icon` is still a
// plain string and STILL ACCEPTS AN EMOJI exactly as before -- this adds a
// second thing that string may be, distinguished by a prefix, so nothing
// already stored needs migrating and nothing already stored stops working.
//
//   ent.icon = '\ud83c\udff0'       -> emoji, drawn as <text> (unchanged since earlier)
//   ent.icon = 'svg:keep'   -> a library key, drawn as vector paths
//
// ── HOW TO ADD AN ICON ──────────────────────────────────────────────────────
// Add one entry to CE_ICON_LIB. Nothing else. It appears in the Entity picker
// and on the map automatically, because both read this table rather than
// listing keys of their own.
//
//   key      the storage value, minus the 'svg:' prefix. Never rename one --
//            an entity storing 'svg:keep' would silently lose its icon.
//   name     what the picker calls it. Sentence case, a thing not a category.
//   group    picker grouping only. 'built' | 'city' | 'wild' | 'water' | 'mark'.
//   vb       the source viewBox as [minX, minY, w, h]. Icons authored here use
//            0 0 24 24; an imported one keeps whatever it arrived with, and
//            both render identically because the renderers scale from vb.
//   parts    the drawing, in back-to-front order. Each is { t, d } plus an
//            optional { tf } transform.
//
// ── WHY PARTS CARRY A TIER AND NOT A COLOUR ─────────────────────────────────
// A found icon is shaded with a palette. Painting the whole thing currentColor
// so it matches the surface destroys that shading, and for anything built from
// overlapping panels the result is a featureless silhouette. So a part carries
// a TONE TIER instead: the renderer draws every part in currentColor and
// varies only fill-opacity, which keeps the internal shading while letting the
// icon take the colour of whatever is drawing it.
//
// The structure ramp IS the surface's own opacity ladder (SS4: 1 / 0.74 /
// 0.58), extended by two steps that only deep-shaded imports reach. That is
// deliberate rather than coincidental -- an icon obeying the ladder is not an
// exception to SS4 that has to be argued for, it is another thing that follows
// it. Accents are a SEPARATE, SHALLOWER ramp for the saturated colours a
// source used to mean something by (a lit window, a flame, a gem): they must
// not sink into the grey ramp or the meaning goes with them.
//
// ── THE IMPORT PATH ─────────────────────────────────────────────────────────
// Descriptors are produced by the Icon Forge (ce-svg-forge.html), a build-time
// browser tool that does the stripping, the shape flattening, the merge-by-
// colour and the tone assignment. It runs in a browser because THIS runtime
// has no DOM and therefore no DOMParser -- the engine can render SVG but it
// cannot read it. Paste the tool's output straight into this table.
// ============================================================================

// The two ramps. Keys are tier ids; the Forge emits the same ones.
// [THEME-SLOT] EVERY TIER IS ALSO A THEME SLOT. See _ceIconPaths for the mechanism and
// for why a custom property is the only thing that can reach in here.
// THE EXISTING FIVE VALUES ARE UNTOUCHED. s5 and a3 are additions for the deeper palettes
// a full-detail import carries; moving s1 would silently restyle every authored icon.
var CE_ICON_OP: { [k: string]: number } = {
    s0: 1, s1: 0.74, s2: 0.58, s3: 0.40, s4: 0.28, s5: 0.20,  // structure -- SS4's ladder, extended
    a0: 1, a1: 0.72, a2: 0.50, a3: 0.34                       // accents -- saturated source colours
};

var CE_ICON_PREFIX = 'svg:';

// Authored on a 24x24 grid, geometric rather than illustrative, and legible at
// the ~14px the map draws them at when zoomed out. Two or three tiers each:
// enough to read as shaded, few enough to survive being scaled down.
var CE_ICON_LIB: { [k: string]: any } = {

    // ── Built places ────────────────────────────────────────────────────────
    keep: { name: 'Keep', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M4 21V10h16v11Z' },
        { t: 's0', d: 'M3 10V6h2v2h2V6h2v2h2V6h2v2h2V6h2v4Z' },
        { t: 'a0', d: 'M10 21v-5a2 2 0 0 1 4 0v5Z' }
    ] },
    tower: { name: 'Tower', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M9 21V8h6v13Z' },
        { t: 's0', d: 'M8 8V5h1.6v1.6h1.6V5h1.6v1.6h1.6V5H16v3Z' },
        { t: 'a0', d: 'M11 11h2v3h-2Z' }
    ] },
    city: { name: 'City', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M2 21V11h5v10Z' },
        { t: 's0', d: 'M8 21V6h6v15Z' },
        { t: 's1', d: 'M15 21V13h7v8Z' },
        { t: 'a0', d: 'M10 9h2v2h-2ZM10 13h2v2h-2ZM17 16h2v2h-2Z' }
    ] },
    village: { name: 'Village', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M2 21v-6l4.5-3.5L11 15v6Z' },
        { t: 's0', d: 'M12 21v-8l5-4 5 4v8Z' },
        { t: 'a0', d: 'M15.4 21v-4h3.2v4Z' }
    ] },
    temple: { name: 'Temple', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's0', d: 'M12 3l10 6H2Z' },
        { t: 's2', d: 'M5 21V10h2.4v11ZM10.8 21V10h2.4v11ZM16.6 21V10H19v11Z' },
        { t: 's1', d: 'M3 21h18v-1.6H3Z' }
    ] },
    gate: { name: 'Gate', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M4 21V11a8 8 0 0 1 16 0v10h-3.6v-10a4.4 4.4 0 0 0-8.8 0v10Z' },
        { t: 's0', d: 'M3 11h18V9.2H3Z' }
    ] },
    ruin: { name: 'Ruin', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M3 21V10h3v11ZM15 21V8h3v13Z' },
        { t: 's1', d: 'M9 21v-7h3v7Z' },
        { t: 's3', d: 'M2 21h20v-1.8H2Z' }
    ] },
    camp: { name: 'Camp', group: 'built', vb: [0, 0, 24, 24], parts: [
        { t: 's2', d: 'M12 3l9.5 18h-19Z' },
        { t: 's4', d: 'M12 11l4.6 10H7.4Z' }
